  expiration_date date [note: 'Date when the obligation expires']
  external_audit_scope varchar [note: 'Indicates if the obligation is in scope for external audit']
  finding_count varchar [note: 'Number of findings related to this obligation']
  is_active boolean [note: 'Indicates if the obligation is currently active']
  last_audit_date date [note: 'Date of the most recent audit']
  last_audit_result varchar [note: 'Result of the most recent audit']
  modified_timestamp timestamp [note: 'When the record was last modified']
  next_review_date date [note: 'Date of the next scheduled review']
  notes varchar [note: 'Additional notes about the obligation']
  obligation_description varchar [note: 'Detailed description of the obligation']
  obligation_name varchar [note: 'Name of the obligation']
  obligation_number varchar [note: 'Unique number for the obligation']
  obligation_status varchar [note: 'Current status of the obligation']
  obligation_type varchar [note: 'Type or category of obligation']
  policy_reference varchar [note: 'Reference to related policy']
  priority_level varchar [note: 'Priority level of the obligation']
  procedure_reference varchar [note: 'Reference to related procedure']
  recurrence_pattern varchar [note: 'Pattern for recurring obligations']
  regulatory_authority varchar [note: 'Regulatory authority imposing the obligation']
  regulatory_citation varchar [note: 'Citation to the regulatory source']
  risk_rating varchar [note: 'Risk rating of the obligation']
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutation to ensure change']
  vibe_mutation_marker varchar [note: 'Marker added by VIBE mutator to indicate change']
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']

  Note: 'Specific compliance obligations derived from regulatory requirements, policies, and program mandates'
}

