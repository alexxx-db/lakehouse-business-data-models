    rdfs:comment 'Origin of the measurement data (e.g., internal sensor, external lab).' ;
    rdfs:domain ind:InspectionResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:measurementTemperatureC rdf:type rdf:Property ;
    rdfs:label 'Measurement Temperature C' ;
    rdfs:comment 'Ambient temperature in Celsius at time of measurement.' ;
    rdfs:domain ind:InspectionResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:measurementTool rdf:type rdf:Property ;
    rdfs:label 'Measurement Tool' ;
    rdfs:comment 'Tool or equipment used for the measurement.' ;
    rdfs:domain ind:InspectionResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:measurementUncertainty rdf:type rdf:Property ;
    rdfs:label 'Measurement Uncertainty' ;
    rdfs:comment 'Estimated uncertainty of the measurement.' ;
    rdfs:domain ind:InspectionResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:resultStatus rdf:type rdf:Property ;
    rdfs:label 'Result Status' ;
    rdfs:comment 'Pass/fail outcome of the measurement.' ;
    rdfs:domain ind:InspectionResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:defectRecordId rdf:type rdf:Property ;
    rdfs:label 'Defect Record Id' ;
    rdfs:comment 'System-generated unique identifier for the defect record.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DefectRecord .

ind:dealerRepairOrderId rdf:type rdf:Property ;
    rdfs:label 'Dealer Repair Order Id' ;
    rdfs:comment 'Foreign key linking to dealer.dealer_repair_order. Business justification: Warranty and field defect tracking requires linking defect records to the dealer repair order that identified or documented the defect. Enables warranty cost analysis, repeat-defect reporting, and fie' ;
    rdfs:domain ind:Automotive ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DealerRepairOrder .

ind:finishedVehicleStockId rdf:type rdf:Property ;
    rdfs:label 'Finished Vehicle Stock Id' ;
    rdfs:comment 'Foreign key linking to inventory.finished_vehicle_stock. Business justification: End-of-line and PDI defects are recorded against specific finished vehicles in stock. Quality disposition decisions (hold, rework, release) directly drive finished_vehicle_stock.hold_code and stock_st' ;
    rdfs:domain ind:Automotive ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FinishedVehicleStock .

ind:inventoryId rdf:type rdf:Property ;
    rdfs:label 'Inventory Id' ;
    rdfs:comment 'Foreign key linking to dealer.dealer_inventory. Business justification: PDI defect detection and pre-delivery quality holds require linking a defect record to the specific dealer inventory unit affected. Supports inventory hold workflows, PDI pass/fail reporting, and reca' ;
    rdfs:domain ind:Automotive ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DealerInventory .

ind:servicePartsStockId rdf:type rdf:Property ;
    rdfs:label 'Service Parts Stock Id' ;
    rdfs:comment 'Foreign key linking to inventory.service_parts_stock. Business justification: Defects in service parts stock (counterfeit parts, shelf-life violations, storage damage) require linking the defect record to the specific service_parts_stock entry for disposition and quarantine. Af' ;
    rdfs:domain ind:Automotive ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ServicePartsStock .

ind:telemetryEventId rdf:type rdf:Property ;
    rdfs:label 'Telemetry Event Id' ;
    rdfs:comment 'Foreign key linking to sales.telemetry_event. Business justification: Root cause analysis links each defect to the specific telemetry event that triggered it, required for the Defect Investigation Report.' ;
    rdfs:domain ind:Automotive ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TelemetryEvent .

ind:vehicleHandoverId rdf:type rdf:Property ;
    rdfs:label 'Vehicle Handover Id' ;
    rdfs:comment 'Foreign key linking to logistics.vehicle_handover. Business justification: Defects discovered at vehicle handover (damage noted on handover condition report, PDI failures at delivery) must link to the handover event for warranty start tracking, dealer claims, and customer sa' ;
    rdfs:domain ind:Automotive ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:VehicleHandover .

ind:vehicleTransportOrderId rdf:type rdf:Property ;
    rdfs:label 'Vehicle Transport Order Id' ;
    rdfs:comment 'Foreign key linking to logistics.vehicle_transport_order. Business justification: Transport damage claims and carrier liability attribution require linking defect records to the specific vehicle transport order. Automotive OEMs track transit-damage defects against VTOs for carrier ' ;
    rdfs:domain ind:Automotive ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:VehicleTransportOrder .

ind:containmentAction rdf:type rdf:Property ;
    rdfs:label 'Containment Action' ;
    rdfs:comment 'Immediate action taken to contain the defect and prevent further impact.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:correctiveAction rdf:type rdf:Property ;
    rdfs:label 'Corrective Action' ;
    rdfs:comment 'Planned or executed action to eliminate the root cause of the defect.' ;
    rdfs:domain ind:DefectRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:defectCategory rdf:type rdf:Property ;
    rdfs:label 'Defect Category' ;
    rdfs:comment 'Stage of the product lifecycle where the defect was detected.' ;
    rdfs:domain ind:DefectRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:defectRecordStatus rdf:type rdf:Property ;
    rdfs:label 'Defect Record Status' ;
    rdfs:comment 'Current lifecycle status of the defect record.' ;
    rdfs:domain ind:DefectRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:defectType rdf:type rdf:Property ;
    rdfs:label 'Defect Type' ;
    rdfs:comment 'Classification of the defect by its origin or nature.' ;
    rdfs:domain ind:DefectRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:detectedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Detected Timestamp' ;
    rdfs:comment 'Date and time when the defect was first observed.' ;
    rdfs:domain ind:DefectRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:detectionMethod rdf:type rdf:Property ;
    rdfs:label 'Detection Method' ;
    rdfs:comment 'Method or channel through which the defect was discovered.' ;
    rdfs:domain ind:DefectRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disposition rdf:type rdf:Property ;
    rdfs:label 'Disposition' ;
    rdfs:comment 'Final disposition of the defective item after evaluation.' ;
    rdfs:domain ind:DefectRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:investigationEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Investigation End Timestamp' ;
    rdfs:comment 'Timestamp when the investigation was concluded.' ;
    rdfs:domain ind:DefectRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:investigationStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Investigation Start Timestamp' ;
    rdfs:comment 'Timestamp when the root-cause investigation began.' ;
    rdfs:domain ind:DefectRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:isRepeatDefect rdf:type rdf:Property ;
    rdfs:label 'Is Repeat Defect' ;
    rdfs:comment 'Flag indicating whether this defect has been observed previously.' ;
    rdfs:domain ind:DefectRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:locationZone rdf:type rdf:Property ;
    rdfs:label 'Location Zone' ;
    rdfs:comment 'Vehicle zone or assembly area where the defect was identified (e.g., body, powertrain).' ;
    rdfs:domain ind:Automotive ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ppmRate rdf:type rdf:Property ;
    rdfs:label 'Ppm Rate' ;
    rdfs:comment 'Defect rate expressed in parts per million for quality metrics.' ;
