    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lastDispatchTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Dispatch Timestamp' ;
    rdfs:comment 'Timestamp of the most recent dispatch of the engineer.' ;
    rdfs:domain ind:Engineer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:maxTravelDistanceKm rdf:type rdf:Property ;
    rdfs:label 'Max Travel Distance Km' ;
    rdfs:comment 'Maximum distance (in km) the engineer is willing to travel.' ;
