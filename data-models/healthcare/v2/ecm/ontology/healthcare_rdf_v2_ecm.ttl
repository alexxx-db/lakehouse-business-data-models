    rdfs:comment 'Reference to the original intercompany transaction that this record reverses, if applicable.' ;
    rdfs:domain ind:IntercompanyTransaction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:IntercompanyTransaction .

ind:receivingEntityFinancialEntityId rdf:type rdf:Property ;
    rdfs:label 'Receiving Entity Financial Entity Id' ;
