  modified_timestamp timestamp [note: 'Last modified timestamp.']
  posted_to_inventory_flag boolean [note: 'Whether posted to inventory.']
  posted_to_inventory_timestamp timestamp [note: 'Timestamp when posted to inventory.']
  quality_inspection_result varchar [note: 'Result of quality inspection.']
  quality_notes varchar [note: 'Notes on quality.']
  receiving_location varchar [note: 'Location where goods were received.']
  receiving_number varchar [note: 'Receiving order number.']
  receiving_shift varchar [note: 'Shift during which goods were received.']
  receiving_status varchar [note: 'Status of the receiving order.']
  rejection_reason varchar [note: 'Reason for rejection if applicable.']
  seal_integrity_check varchar [note: 'Result of seal integrity check.']
  supplier_name varchar [note: 'Name of the supplier.']
  temperature_check_result varchar [note: 'Result of temperature check.']
  temperature_recorded decimal(5,2) [note: 'Temperature recorded at receiving.']
  total_items_ordered decimal(18,2) [note: 'Total items ordered.']
  total_items_received decimal(18,2) [note: 'Total items received.']
  total_received_value decimal(18,2) [note: 'Total monetary value received.']
  variance_flag boolean [note: 'Whether variance exists.']
  variance_reason varchar [note: 'Reason for variance.']

  Note: 'Records of goods received at a restaurant unit or facility, including quality checks and temperature verification.'
}

Table inventory.physical_count {
  physical_count_id varchar [pk, note: 'Primary key.']
