ind:nextRunDate rdf:type rdf:Property ;
    rdfs:label 'Next Run Date' ;
    rdfs:comment 'Date the next recurring entry will be posted.' ;
    rdfs:domain ind:RecurringEntryTemplate ;
    rdf:type owl:DatatypeProperty ;
