ind:sampleVolumeMl rdf:type rdf:Property ;
    rdfs:label 'Sample Volume Ml' ;
    rdfs:comment 'Volume of water sample collected for analysis in milliliters. Standard sample volumes ensure analytical accuracy and method compliance.' ;
    rdfs:domain ind:WaterUtilities ;
