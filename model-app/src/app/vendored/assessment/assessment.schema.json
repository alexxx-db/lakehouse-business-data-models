{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-schema-version": 1,
  "type": "object",
  "required": ["model_quality_score", "metamodel", "entities", "gaps", "pending_decisions", "next_vibes"],
  "properties": {
    "model_quality_score": {"type": ["number", "null"]},
    "metamodel": {"type": "object", "required": ["location", "version"],
                  "properties": {"location": {"type": "string"}, "version": {"type": "string"}}},
    "executive_summary": {"type": ["object", "null"], "properties": {
      "headline": {"type": ["string", "null"]},
      "verdict": {"type": ["string", "null"], "description": "ready_to_build | iterate_first | blocked"},
      "verdict_reason": {"type": ["string", "null"]},
      "key_findings": {"anyOf": [{"type": "string"}, {"type": "null"}, {"type": "array", "items": {"type": ["string", "number", "boolean"]}}]},
      "top_risks": {"anyOf": [{"type": "string"}, {"type": "null"}, {"type": "array", "items": {"type": ["string", "number", "boolean"]}}]},
      "recommended_next_step": {"type": ["string", "null"]}}},
    "entities": {"type": "array", "items": {
      "type": "object", "required": ["name", "grade", "columns"],
      "properties": {
        "name": {"type": "string"}, "grade": {"enum": ["full", "partial", "blocked"]},
        "coverage_pct": {"type": ["number", "null"]}, "primary_source": {"type": "string"},
        "row_count": {"type": ["integer", "null"]}, "net_new_candidate": {"type": "boolean"},
        "letter_grade": {"type": ["string", "null"], "description": "A, B, C, D or F, the letter in the S2T grade line"},
        "structure": {"type": ["string", "null"], "description": "sound | review | rework, the Structure in the S2T grade line"},
        "grade_reason": {"type": ["string", "null"]}, "row_filter": {"type": ["string", "null"]},
        "core_sourced": {"type": ["integer", "string", "null"]}, "core_total": {"type": ["integer", "string", "null"]},
        "enrichment_sourced": {"type": ["integer", "string", "null"]}, "enrichment_total": {"type": ["integer", "string", "null"]},
        "deferred_fk_count": {"type": ["integer", "string", "null"]},
        "columns": {"type": "array", "items": {
          "type": "object", "required": ["target", "status"],
          "properties": {
            "target": {"type": "string"},
            "status": {"enum": ["mapped", "derived", "gap", "null_source", "deferred_fk"]},
            "source_table": {"type": "string"}, "source_column": {"type": "string"},
            "transform": {"type": "string"}, "row_count": {"type": ["integer", "null"]},
            "null_pct": {"type": ["number", "null"]}, "distinct_count": {"type": ["integer", "null"]},
            "date_format": {"type": "string"}, "fk_orphans": {"type": ["integer", "null"]},
            "evidence": {"type": "string"},
            "tier": {"type": ["string", "null"], "description": "core | enrichment | deferred_fk | technical (S2T Class column)"},
            "profiles_by_source": {"type": ["array", "null"], "items": {"type": "object", "properties": {
              "system": {"type": ["string", "null"]}, "source_table": {"type": ["string", "null"]},
              "source_column": {"type": ["string", "null"]}, "role": {"type": ["string", "null"]},
              "rows": {"type": ["integer", "null"]}, "null_pct": {"type": ["number", "null"]},
              "distinct_count": {"type": ["integer", "null"]}, "fk_orphans": {"type": ["integer", "null"]},
              "note": {"type": ["string", "null"]}}}}}}}}}},
    "gaps": {"type": "array", "items": {"type": "object", "required": ["description"],
      "properties": {"entity": {"type": "string"}, "column": {"type": "string"}, "gap_type": {"type": "string"},
                     "description": {"type": "string"},
                     "status": {"enum": ["OPEN", "IN_PROGRESS", "DEFERRED", "ACCEPTED", "RESOLVED"]},
                     "ask": {"type": "string"}}}},
    "pending_decisions": {"type": "array", "items": {"type": "object", "required": ["question", "options", "default_taken"],
      "properties": {"gate": {"type": "string"}, "question": {"type": "string"},
                     "options": {"type": "array", "items": {"anyOf": [
                       {"type": "string"},
                       {"type": "object",
                        "properties": {"label": {"type": "string"},
                                       "pros": {"anyOf": [{"type": "string"}, {"type": "null"}, {"type": "array", "items": {"type": ["string", "number", "boolean"]}}]},
                                       "cons": {"anyOf": [{"type": "string"}, {"type": "null"}, {"type": "array", "items": {"type": ["string", "number", "boolean"]}}]},
                                       "impact": {"type": ["string", "null"]}}}]}},
                     "default_taken": {"type": "string"}, "evidence": {"type": "string"}, "entity": {"type": "string"},
                     "context": {"type": ["string", "null"]}, "why_it_matters": {"type": ["string", "null"]},
                     "recommended_option": {"type": ["string", "null"], "description": "must equal one option label"},
                     "recommendation_rationale": {"type": ["string", "null"]},
                     "kind": {"type": ["string", "null"], "description": "structure | source | scope"}, "blocks_build": {"type": ["boolean", "string", "number", "null"]},
                     "affected": {"type": ["array", "null"], "items": {"anyOf": [
                       {"type": "string"},
                       {"type": "object",
                        "properties": {"entity": {"type": "string"}, "column": {"type": ["string", "null"]}}}]}}}}},
    "next_vibes": {"type": "array", "items": {"type": "object", "required": ["text"],
      "properties": {"priority": {"type": ["integer", "null"]}, "category": {"type": "string"},
                     "text": {"type": "string"}, "confidence": {"type": ["number", "null"]},
                     "problem": {"type": ["string", "null"]}, "proposed_change": {"type": ["string", "null"]},
                     "impact_if_skipped": {"type": ["string", "null"]},
                     "urgency": {"type": ["string", "null"], "description": "before_build | during_build | later"},
                     "affected_entities": {"anyOf": [{"type": "string"}, {"type": "null"}, {"type": "array", "items": {"type": ["string", "number", "boolean"]}}]}}}}
  }
}
