  recount_of_count_id varchar [note: 'Self-FK for recount reference.']
  actual_end_timestamp timestamp [note: 'Actual end time of count.']
  actual_start_timestamp timestamp [note: 'Actual start time of count.']
  approval_timestamp timestamp [note: 'Timestamp of approval.']
  cancellation_reason varchar [note: 'Reason for cancellation.']
  cancellation_timestamp timestamp [note: 'Timestamp of cancellation.']
  count_date date [note: 'Date of the physical count.']
  count_method varchar [note: 'Method used for counting.']
  count_number varchar [note: 'Count reference number.']
  count_period varchar [note: 'Period of the count.']
  count_status varchar [note: 'Status of the count.']
  count_type varchar [note: 'Type of count (full, cycle, spot).']
  created_timestamp timestamp [note: 'Record creation timestamp.']
  is_period_end_count boolean [note: 'Whether this is a period-end count.']
  last_modified_timestamp timestamp [note: 'Last modified timestamp.']
  notes varchar [note: 'Free-text notes.']
  physical_inventory_value decimal(18,2) [note: 'Value of physical inventory counted.']
