  last_reviewed_timestamp timestamp [note: 'Last reviewed timestamp.']
  multi_sourcing_allowed boolean [note: 'Whether multi-sourcing is allowed.']
  notes varchar [note: 'Free-text notes.']
  primary_vendor_required boolean [note: 'Whether primary vendor is required.']
  procurement_lead_time_days varchar [note: 'Procurement lead time in days.']
  requires_expiration_tracking decimal(9,4) [note: 'Whether expiration tracking is required.']
  requires_lot_tracking boolean [note: 'Whether lot tracking is required.']
  requires_temperature_control boolean [note: 'Whether temperature control is required.']
  shelf_life_days varchar [note: 'Shelf life in days.']
  sort_order varchar [note: 'Sort order.']
  tax_category_code decimal(18,2) [note: 'Tax category code.']
  temperature_zone varchar [note: 'Temperature zone.']
  typical_waste_category varchar [note: 'Typical waste category.']
  typical_yield_percentage decimal(5,2) [note: 'Typical yield percentage.']
  updated_timestamp timestamp [note: 'Updated timestamp.']
  waste_tracking_enabled boolean [note: 'Whether waste tracking is enabled.']
  yield_management_enabled decimal(10,4) [note: 'Whether yield management is enabled.']

  Note: 'Hierarchical categorization of inventory items with associated management parameters and compliance requirements.'
}

Table inventory.inventory_ingredient_usage {
  inventory_ingredient_usage_id varchar [pk, note: 'Primary key.']
  franchisee_id varchar [note: 'FK to franchisee.']
  ingredient_id varchar [note: 'FK to ingredient.']
  restaurant_unit_id varchar [note: 'FK to restaurant unit.']
  stock_item_id varchar [note: 'FK to stock item.']
  actual_usage decimal(18,4) [note: 'Actual usage quantity.']
  average_monthly_usage decimal [note: 'Average monthly usage quantity.']
  cost_per_unit decimal(18,2) [note: 'Cost per unit.']
  created_at timestamp [note: 'Creation timestamp.']
  created_timestamp timestamp [note: 'Record creation timestamp.']
  order_ingredient_usage_id varchar [note: 'FK to order ingredient usage.']
  quantity_used varchar [note: 'Quantity used.']
  theoretical_quantity decimal(18,4) [note: 'Theoretical quantity.']
  theoretical_usage decimal(18,4) [note: 'Theoretical usage quantity.']
  total_usage_cost decimal(18,2) [note: 'Total cost of usage.']
  unit_of_measure varchar [note: 'Unit of measure.']
  uom varchar [note: 'Unit of measure.']
  usage_date date [note: 'Date of usage.']
  usage_period varchar [note: 'Usage period identifier.']
  usage_period_end date [note: 'End of usage period.']
  usage_period_start date [note: 'Start of usage period.']
  usage_type varchar [note: 'Type of usage.']
  variance decimal(18,4) [note: 'Variance between actual and theoretical.']
  variance_quantity decimal(18,4) [note: 'Variance quantity.']
  waste_quantity decimal(18,4) [note: 'Waste quantity.']

  Note: 'Aggregated ingredient usage records linking inventory consumption to orders, tracking actual vs theoretical usage and variances.'
}

Table restaurant.unit {
  unit_id varchar [pk, note: 'Unique identifier for the restaurant unit. Primary key for the unit master record.']
  brand_id varchar [note: 'Foreign key linking to restaurant.brand. Business justification: Unit should reference its brand via a foreign key rather than a free‑text code; brand_id provides referential integrity.']
  brand_standard_id varchar [note: 'Foreign key linking to restaurant.brand_standard. Business justification: Units must be linked to the applicable brand standard for compliance tracking.']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: Cost accounting reports allocate expenses per unit via a cost center; linking unit to cost_center enables accurate budgeting and variance analysis.']
  department_id varchar [note: 'Foreign key linking to restaurant.department. Business justification: Linking a unit to its department enables organizational reporting and eliminates the department table silo.']
  facility_id varchar [note: 'Foreign key linking to realestate.facility. Business justification: Facility‑to‑Unit link required for building‑level maintenance, energy‑rating compliance, and health‑inspection tracking.']
  franchisee_id varchar [note: 'Identifier of the franchisee entity that owns and operates this unit. Null for company-owned units.']
  landlord_id varchar [note: 'Foreign key linking to realestate.landlord. Business justification: Landlord‑to‑Unit link supports landlord contact management, rent negotiations, and compliance audits; each unit has a responsible landlord.']
  lease_id varchar [note: 'Foreign key linking to realestate.lease. Business justification: Lease‑to‑Unit association needed for lease‑expiry alerts, rent schedule generation, and financial reporting; each unit operates under a specific lease.']
  legal_entity_id varchar [note: 'Foreign key linking to finance.legal_entity. Business justification: Required for consolidated financial statements and tax compliance; each restaurant unit must be mapped to its legal entity for reporting.']
  program_id varchar [note: 'Foreign key linking to loyalty.program. Business justification: Program Assignment per Restaurant Unit: needed for reporting which loyalty program each unit runs, enabling rollout planning and performance tracking.']
  site_id varchar [note: 'Foreign key linking to realestate.site. Business justification: Site‑to‑Unit link required for property‑level rent, CAPEX, and compliance reporting; experts expect each restaurant unit to be tied to its real‑estate site.']
  trade_area_id varchar [note: 'Foreign key linking to realestate.trade_area. Business justification: Trade_Area‑to‑Unit mapping drives market‑share analysis, demographic targeting, and site‑selection KPI reporting.']
  address_line1 varchar [note: 'Primary street address of the restaurant unit including street number and name.']
  address_line2 varchar [note: 'Secondary address information such as suite number, building name, or floor.']
  average_cover_count varchar [note: 'Average number of guests (covers) served per day. Used for labor planning and revenue forecasting in table-service restaurants.']
  average_ticket_time_seconds varchar [note: 'Average time in seconds for a customer order to be completed from entry to fulfillment, tracked via KDS (Kitchen Display System).']
  average_unit_volume_usd decimal(18,2) [note: 'Average annual sales revenue for this unit in US dollars. Key performance metric for franchise valuation and benchmarking.']
  city varchar [note: 'City or municipality where the restaurant unit is located.']
  closure_date date [note: 'The date this restaurant unit permanently ceased operations. Null for active units.']
  concept_type varchar [note: 'The restaurant format classification. QSR (Quick-Service Restaurant) for fast food, casual dining for table service, fast casual for counter service with higher quality, fine dining for upscale full service, food court for mall locations, ghost kitchen for delivery-only.']
  country_code varchar [note: 'Three-letter ISO country code where the restaurant unit is located.']
  created_timestamp timestamp [note: 'Timestamp when this unit record was first created in the system.']
  daypart_schedule varchar [note: 'Structured schedule defining daypart time windows (breakfast, lunch, dinner, late night) for menu and pricing management.']
  drive_thru_lanes varchar [note: 'Number of drive-thru lanes available at this unit. Zero indicates no drive-thru capability.']
  email_address varchar [note: 'Primary email address for the restaurant unit used for operational communications.']
  haccp_certified boolean [note: 'Indicates whether this unit maintains current HACCP certification for food safety management.']
  has_online_ordering boolean [note: 'Indicates whether this unit supports online ordering through web or mobile app channels.']
  has_third_party_delivery boolean [note: 'Indicates whether this unit is enabled for third-party delivery services such as DoorDash, Uber Eats, or Grubhub.']
  health_inspection_score decimal(10,2) [note: 'Most recent health inspection score from local health department. Scale and passing thresholds vary by jurisdiction.']
  kds_station_count varchar [note: 'Number of KDS stations installed in the BOH for order routing and kitchen workflow management.']
  last_inspection_date date [note: 'Date of the most recent health and safety inspection by local regulatory authority.']
  last_modified_timestamp timestamp [note: 'Timestamp when this unit record was most recently updated.']
  latitude decimal(10,7) [note: 'Geographic latitude coordinate of the restaurant unit in decimal degrees.']
  longitude decimal(10,7) [note: 'Geographic longitude coordinate of the restaurant unit in decimal degrees.']
  opening_date date [note: 'The date this restaurant unit first opened for business to customers.']
  operating_hours varchar [note: 'Standard operating hours for the unit, typically formatted as day ranges with time windows (e.g., Mon-Fri 6:00-22:00, Sat-Sun 7:00-23:00).']
  operational_status decimal(10,4) [note: 'Current lifecycle state of the restaurant unit. Active indicates normal operations, temporarily closed for renovations or seasonal closure, permanently closed for shut down units, under construction for new builds, pending opening for units awaiting launch.']
  ownership_model varchar [note: 'The operating model for this unit: company-owned (corporate operated), franchised (independent franchisee), joint venture (shared ownership), or licensed (brand licensing agreement).']
  parking_spaces varchar [note: 'Number of dedicated parking spaces available for guest use at this location.']
  phone_number varchar [note: 'Primary contact phone number for the restaurant unit.']
  pos_system_version varchar [note: 'Version identifier of the POS system software deployed at this unit.']
  postal_code varchar [note: 'Postal or ZIP code for the restaurant unit location.']
  same_store_sales_pct decimal(5,2) [note: 'Year-over-year comparable store sales growth percentage. Measures organic growth for units open at least 12 months.']
  seating_capacity varchar [note: 'Maximum number of guest seats available in the FOH (Front of House) dining area.']
  sop_document_id varchar [note: 'Foreign key linking to foodsafety.sop_document. Business justification: Regulatory compliance tracks which SOP document each unit must follow for food safety procedures.']
  speed_of_service_seconds varchar [note: 'Average time in seconds from order placement to order delivery. Critical QSR operational metric for customer satisfaction.']
  square_footage varchar [note: 'Total interior floor space of the restaurant unit in square feet, including FOH and BOH (Back of House) areas.']
  state_province varchar [note: 'Two-letter state or province code where the restaurant unit is located.']
  table_turn_rate decimal(4,2) [note: 'Average number of times a table is occupied by different parties during a service period. Relevant for casual and fine-dining concepts.']
  throughput_capacity_orders_per_hour varchar [note: 'Maximum number of customer orders this unit can process per hour at peak efficiency, based on equipment and staffing design.']
  trade_name varchar [note: 'The customer-facing name of the restaurant unit as displayed on signage and marketing materials.']
  unit_number varchar [note: 'Business identifier for the restaurant unit. Externally-known unique code used across operational systems and franchise communications.']

  Note: 'Master record for every restaurant unit — company-owned and franchised. The authoritative identity of each physical location including unit number, brand, concept type (QSR/casual/fine-dining), ownership model (company-owned vs. franchised), legal entity name, trade name, opening date, closure date, current operational status, and geographic coordinates. This is the operational anchor for the entire restaurant domain and the primary FK target for all cross-domain joins (order, inventory, workforce, finance, franchise). One row per physical restaurant location. All other restaurant domain products reference this entity.'
}

Table restaurant.location_profile {
  location_profile_id varchar [pk, note: 'Unique identifier for the restaurant location profile. Primary key for this entity.']
  location_restaurant_unit_id varchar [note: 'Reference to the master restaurant unit record. Links this location profile to the operational restaurant entity.']
  location_unit_id varchar [note: 'Reference to the master restaurant unit record. Links this location profile to the operational restaurant entity.']
  address_line_1 varchar [note: 'Primary street address of the restaurant location including street number and name. Organizational contact data classified as confidential.']
  address_line_2 varchar [note: 'Secondary address information such as suite, unit, or building number. Organizational contact data classified as confidential.']
  building_ownership_type varchar [note: 'Type of ownership or lease arrangement for the restaurant building. Impacts financial reporting and CapEx decisions.']
  city varchar [note: 'City or municipality where the restaurant is located. Organizational contact data classified as confidential.']
  country_code varchar [note: 'Three-letter ISO country code identifying the country where the restaurant operates.']
  created_timestamp timestamp [note: 'Timestamp when this location profile record was first created in the system. Audit trail for data lineage.']
  delivery_radius_km decimal(6,2) [note: 'Maximum delivery radius in kilometers for online ordering and third-party delivery services. Configured per location based on geography and capacity.']
  dma_code varchar [note: 'Nielsen Designated Market Area code identifying the media market. Used for marketing campaign planning and regional media analysis.']
  drive_thru_lane_count varchar [note: 'Number of drive-thru lanes at the restaurant. Critical for throughput capacity planning and speed of service benchmarking.']
  email_address varchar [note: 'Primary email address for the restaurant location. Organizational contact data classified as confidential.']
  fax_number varchar [note: 'Fax number for the restaurant location if applicable. Organizational contact data classified as confidential.']
  has_accessible_parking boolean [note: 'Indicates whether the restaurant has ADA-compliant accessible parking spaces. Required for regulatory compliance.']
  has_drive_thru boolean [note: 'Indicates whether the restaurant has drive-thru service capability. Key differentiator for QSR format and operational model.']
  has_patio_seating boolean [note: 'Indicates whether the restaurant has outdoor patio seating available. Impacts cover count and seasonal capacity.']
  has_playground boolean [note: 'Indicates whether the restaurant has a children\'s playground. Differentiator for family-oriented locations.']
  has_restroom boolean [note: 'Indicates whether the restaurant has customer restroom facilities. Impacts guest experience and local health code compliance.']
  has_wheelchair_access boolean [note: 'Indicates whether the restaurant has wheelchair-accessible entrances and facilities. Required for ADA compliance.']
  has_wifi boolean [note: 'Indicates whether the restaurant offers guest WiFi service. Enhances guest experience and supports digital ordering.']
  last_remodel_date date [note: 'Date of the most recent major remodel or renovation. Used for CapEx tracking and brand standard compliance.']
  last_updated_timestamp timestamp [note: 'Timestamp when this location profile record was last modified. Audit trail for data lineage and change tracking.']
  latitude decimal(10,7) [note: 'Geographic latitude coordinate of the restaurant location in decimal degrees. Used for mapping, delivery radius calculation, and proximity analytics.']
  lease_expiration_date decimal(10,4) [note: 'Date when the current lease agreement expires. Critical for real estate planning and renewal negotiations.']
  locale varchar [note: 'Locale identifier for language and regional formatting preferences. Used for menu display, signage, and customer communications.']
  longitude decimal(10,7) [note: 'Geographic longitude coordinate of the restaurant location in decimal degrees. Used for mapping, delivery radius calculation, and proximity analytics.']
  lot_size_sqft varchar [note: 'Total lot size in square feet including building, parking, and landscaping. Used for site selection and property management.']
  parking_capacity varchar [note: 'Total number of parking spaces available at or near the restaurant location. Influences site selection and accessibility.']
  patio_seat_count varchar [note: 'Number of seats available on the outdoor patio. Used for capacity planning and table turn analysis.']
  phone_number varchar [note: 'Primary contact phone number for the restaurant location. Organizational contact data classified as confidential.']
  postal_code varchar [note: 'Postal or ZIP code for the restaurant location. Organizational contact data classified as confidential.']
  proximity_to_airport_km decimal(8,2) [note: 'Distance in kilometers from the restaurant to the nearest airport. Influences traveler traffic and site classification.']
  proximity_to_highway_km decimal(8,2) [note: 'Distance in kilometers from the restaurant to the nearest major highway. Used for site selection and trade area analysis.']
  proximity_to_mall_km decimal(8,2) [note: 'Distance in kilometers from the restaurant to the nearest shopping mall. Impacts foot traffic and co-location strategy.']
  restaurant_number varchar [note: 'Business identifier for the restaurant unit. Externally-known code used in operations, reporting, and franchise communications.']
  site_closed_date date [note: 'Date when the restaurant location permanently closed. Used for portfolio analysis and historical reporting.']
  site_opened_date date [note: 'Date when the restaurant location first opened for business. Used for NRO tracking, maturity analysis, and comp sales calculations.']
  site_status varchar [note: 'Current operational status of the restaurant site. Used for reporting, site portfolio management, and NRO tracking.']
  square_footage varchar [note: 'Total interior square footage of the restaurant building. Used for real estate valuation, CapEx planning, and operational benchmarking.']
  state_province varchar [note: 'State, province, or administrative region code. Organizational contact data classified as confidential.']
  timezone varchar [note: 'IANA timezone identifier for the restaurant location. Used for daypart scheduling, operating hours, and time-based reporting.']
  trade_area_classification varchar [note: 'Classification of the trade area type where the restaurant is located. Influences site selection, menu offerings, and operational strategies. [ENUM-REF-CANDIDATE: urban|suburban|rural|highway|airport|mall|downtown|neighborhood — 8 candidates stripped; promote to reference product]']

  Note: 'Physical and geographic attributes of each restaurant unit including full street address, city, state, province, postal code, country, DMA (Designated Market Area), trade area classification, latitude/longitude, timezone, locale, accessibility features, parking capacity, drive-thru lane count, patio seating availability, and proximity to key landmarks. Supports site analytics, delivery radius configuration, and regional reporting.'
}

Table restaurant.format_config {
  format_config_id varchar [pk, note: 'Unique identifier for the restaurant format configuration record. Primary key.']
  format_restaurant_unit_id varchar [note: 'Identifier of the restaurant unit to which this format configuration applies.']
  format_unit_id varchar [note: 'Identifier of the restaurant unit to which this format configuration applies.']
  alcohol_service_flag boolean [note: 'Indicates whether the restaurant format is licensed and configured to serve alcoholic beverages.']
  boh_cooking_line_count varchar [note: 'Number of cooking lines or production stations in the Back of House (BOH) kitchen.']
  boh_kitchen_sq_ft decimal(10,2) [note: 'Total square footage of the Back of House (BOH) kitchen and food preparation area.']
  boh_prep_station_count varchar [note: 'Number of food preparation stations in the Back of House (BOH) kitchen.']
  brand_standard_compliance_status varchar [note: 'Current compliance status of the format configuration against brand standards and Standard Operating Procedures (SOPs).']
  breakfast_daypart_flag boolean [note: 'Indicates whether the restaurant format operates during the breakfast daypart and serves breakfast menu items.']
  config_version varchar [note: 'Version identifier for this format configuration, used to track changes and updates over time.']
  cover_count_capacity_per_daypart varchar [note: 'Maximum number of covers (individual meals served) the restaurant can accommodate during a single daypart (breakfast, lunch, dinner) based on seating and throughput.']
  created_timestamp timestamp [note: 'Timestamp when this format configuration record was first created in the system.']
  curbside_pickup_enabled_flag boolean [note: 'Indicates whether the restaurant format supports curbside pickup service for online orders.']
  dining_format_type varchar [note: 'The primary dining format classification of the restaurant unit: Quick-Service Restaurant (QSR), fast-casual, casual dining, or fine-dining.']
  drive_thru_lane_config varchar [note: 'Drive-Thru (DT) lane configuration: none (no drive-thru), single lane, dual lane, or triple lane.']
  drive_thru_window_count varchar [note: 'Number of Drive-Thru (DT) service windows available for order pickup.']
  effective_date date [note: 'Date when this format configuration became or will become effective for the restaurant unit.']
  expiration_date decimal(10,4) [note: 'Date when this format configuration expires or is superseded by a new configuration. Null indicates current active configuration.']
  foh_bar_seating_count varchar [note: 'Number of bar seats available in the Front of House (FOH) area, if applicable.']
  foh_outdoor_seating_count varchar [note: 'Number of outdoor patio or sidewalk seats available in the Front of House (FOH) area.']
  foh_seating_capacity varchar [note: 'Total number of guest seats available in the Front of House (FOH) dining area, including indoor and outdoor seating.']
  foh_table_count varchar [note: 'Total number of dining tables in the Front of House (FOH) area.']
  format_name varchar [note: 'Human-readable name or label for this format configuration (e.g., \'Standard QSR with DT\', \'Urban Fast-Casual\').']
  kds_screen_count varchar [note: 'Number of Kitchen Display System (KDS) screens installed in the Back of House (BOH) for order routing and production management.']
  kiosk_count varchar [note: 'Number of self-service digital ordering kiosks installed in the restaurant.']
  last_modified_timestamp timestamp [note: 'Timestamp when this format configuration record was last updated or modified.']
  last_remodel_date date [note: 'Date of the most recent remodel or renovation that affected the format configuration of the restaurant.']
  late_night_daypart_flag boolean [note: 'Indicates whether the restaurant format operates during late-night hours (typically after 10 PM).']
  notes varchar [note: 'Free-text notes or comments regarding special considerations, exceptions, or unique characteristics of this format configuration.']
  olo_enabled_flag boolean [note: 'Indicates whether the restaurant format supports Online Ordering (OLO) through web or mobile app channels.']
  parking_space_count varchar [note: 'Number of parking spaces available for guest use at the restaurant location.']
  pos_terminal_count varchar [note: 'Number of Point of Sale (POS) terminals installed for order capture and payment processing.']
  service_model varchar [note: 'Primary service delivery model: counter service, table service, drive-thru, self-service kiosk, or hybrid combination.']
  sos_benchmark_seconds varchar [note: 'Target Speed of Service (SOS) benchmark in seconds from order placement to order delivery, based on format and service model.']
  table_turn_target_minutes varchar [note: 'Target table turn time in minutes for table-service formats, representing the average time from guest seating to table availability.']
  third_party_delivery_enabled_flag boolean [note: 'Indicates whether the restaurant format supports Third-Party Delivery (3PD) integration with external delivery platforms.']
  throughput_capacity_per_hour varchar [note: 'Maximum number of customer transactions the restaurant can process per hour under optimal conditions, based on format configuration.']
  twenty_four_hour_operation_flag decimal(10,4) [note: 'Indicates whether the restaurant operates 24 hours per day, 7 days per week.']

  Note: 'Defines the operational format, physical configuration, and total capacity of a restaurant unit. Includes dining format (QSR, fast-casual, casual, fine-dining), service model (counter, table, drive-thru, kiosk), FOH layout (total indoor seating capacity, outdoor/patio seating capacity, bar seating count, private dining room capacity, ADA-compliant seating count, table count, cover count), BOH layout (kitchen footprint sq ft, cooking lines, prep stations), drive-thru configuration (lane count, stacking capacity for vehicles), kiosk count, counter service positions, and maximum cover count per daypart. This is the single source of truth for all physical capacity and layout attributes of a unit — governs brand standard compliance, throughput benchmarking, labor staffing ratios, health department permit compliance, and fire marshal occupancy limits.'
}

Table restaurant.operating_hours {
  operating_hours_id varchar [pk, note: 'Unique identifier for the operating hours record. Primary key.']
  labor_scheduling_template_id varchar [note: 'Identifier of the labor scheduling template associated with these operating hours. Links to workforce scheduling system for Full-Time Equivalent (FTE) planning and shift assignment.']
  operating_approved_by_user_employee_id varchar [note: 'Identifier of the user who approved this operating hours schedule. Used for audit trail and compliance tracking.']
  operating_employee_id varchar [note: 'Identifier of the user who approved this operating hours schedule. Used for audit trail and compliance tracking.']
  operating_restaurant_unit_id varchar [note: 'Identifier of the restaurant unit to which these operating hours apply. Links to the restaurant master record.']
  operating_unit_id varchar [note: 'Identifier of the restaurant unit to which these operating hours apply. Links to the restaurant master record.']
  approved_timestamp timestamp [note: 'The date and time when this operating hours schedule was approved, in yyyy-MM-ddTHH:mm:ss.SSSXXX format. Used for audit trail and compliance tracking.']
  close_time timestamp [note: 'The time the restaurant closes for the specified day and daypart, in 24-hour HH:mm format (e.g., 22:00). May extend past midnight for late-night operations.']
  created_timestamp timestamp [note: 'The date and time when this operating hours record was first created in the system, in yyyy-MM-ddTHH:mm:ss.SSSXXX format. Used for audit trail and data lineage.']
  day_of_week varchar [note: 'The day of the week for which these operating hours are defined. [ENUM-REF-CANDIDATE: monday|tuesday|wednesday|thursday|friday|saturday|sunday — 7 candidates stripped; promote to reference product]']
  daypart varchar [note: 'The daypart segment (breakfast, lunch, dinner, late-night, all-day, overnight) for which these hours apply. Used for menu availability, labor scheduling, and Same-Store Sales (SSS) period alignment.']
  daypart_end_time timestamp [note: 'The end time of the specific daypart window (e.g., breakfast ends at 11:00), in 24-hour HH:mm format. Used for menu engineering and Product Mix (PMIX) analysis.']
  daypart_start_time timestamp [note: 'The start time of the specific daypart window (e.g., breakfast starts at 06:00), in 24-hour HH:mm format. Used for menu engineering and Product Mix (PMIX) analysis.']
  delivery_window_close_time timestamp [note: 'The time the restaurant stops accepting delivery orders (Online Ordering (OLO) and Third-Party Delivery (3PD)), in 24-hour HH:mm format. May differ from dine-in hours.']
  delivery_window_open_time timestamp [note: 'The time the restaurant begins accepting delivery orders (Online Ordering (OLO) and Third-Party Delivery (3PD)), in 24-hour HH:mm format. May differ from dine-in hours.']
  drive_thru_close_time timestamp [note: 'The time the Drive-Thru (DT) lane closes, in 24-hour HH:mm format. May differ from Front of House (FOH) close time for QSR (Quick-Service Restaurant) units.']
  drive_thru_open_time timestamp [note: 'The time the Drive-Thru (DT) lane opens, in 24-hour HH:mm format. May differ from Front of House (FOH) open time for QSR (Quick-Service Restaurant) units.']
  effective_end_date date [note: 'The date on which these operating hours expire, in yyyy-MM-dd format. Null for open-ended schedules. Used for temporary hour changes and seasonal adjustments.']
  effective_start_date date [note: 'The date from which these operating hours become effective, in yyyy-MM-dd format. Used for scheduling future hour changes and seasonal adjustments.']
  expected_cover_count varchar [note: 'The expected number of covers (individual diners served) during this daypart for casual and fine-dining establishments. Used for labor scheduling and inventory planning.']
  expected_table_turn_count decimal(5,2) [note: 'The expected number of table turns (times a table is occupied and vacated) during this daypart for casual and fine-dining establishments. Used for capacity planning and revenue forecasting.']
  holiday_name varchar [note: 'The name of the holiday for which this schedule override applies (e.g., Christmas, Thanksgiving, New Year\'s Day). Null if not a holiday override.']
  holiday_schedule_override_flag boolean [note: 'Indicates whether these operating hours represent a holiday schedule override. True if this is a holiday exception, False for regular schedule.']
  is_24_hour_operation decimal(10,4) [note: 'Indicates whether the restaurant operates 24 hours a day for the specified day. True if open continuously, False otherwise.']
  is_closed boolean [note: 'Indicates whether the restaurant is closed for the specified day and daypart. True if closed, False if open.']
  last_modified_timestamp timestamp [note: 'The date and time when this operating hours record was last modified, in yyyy-MM-ddTHH:mm:ss.SSSXXX format. Used for audit trail and change tracking.']
  last_order_cutoff_time timestamp [note: 'The time by which the last order must be placed before the restaurant stops accepting new orders, in 24-hour HH:mm format. Used for Online Ordering (OLO) and Third-Party Delivery (3PD) routing.']
  notes varchar [note: 'Free-text notes or comments about this operating hours schedule. May include reasons for schedule changes, special instructions, or operational context.']
  open_time timestamp [note: 'The time the restaurant opens for the specified day and daypart, in 24-hour HH:mm format (e.g., 06:00).']
  schedule_status varchar [note: 'The current lifecycle status of this operating hours record. Active schedules are in effect; pending schedules are future-dated; expired schedules are past their end date; suspended schedules are temporarily disabled.']
  schedule_type varchar [note: 'The type of operating hours schedule. Regular for standard weekly hours, holiday for holiday overrides, seasonal for seasonal adjustments, temporary for one-time changes, special_event for event-driven hours.']
  seasonal_adjustment_flag boolean [note: 'Indicates whether these operating hours represent a seasonal adjustment (e.g., extended summer hours, reduced winter hours). True if seasonal, False for standard schedule.']
  seasonal_period_name varchar [note: 'The name of the seasonal period for which this schedule adjustment applies (e.g., Summer, Winter, Back-to-School). Null if not a seasonal adjustment.']
  special_event_name varchar [note: 'The name of the special event for which these operating hours apply (e.g., Super Bowl Sunday, Local Festival, Grand Opening). Null if not a special event schedule.']
  target_speed_of_service_seconds varchar [note: 'The target Speed of Service (SOS) in seconds for this daypart. Represents the benchmark time from order placement to order fulfillment. Used for operational performance tracking.']
  target_ticket_time_seconds varchar [note: 'The target ticket time in seconds for this daypart. Represents the benchmark time from order entry to Kitchen Display System (KDS) completion. Used for Back of House (BOH) performance tracking.']
  throughput_capacity_per_hour varchar [note: 'The estimated number of customer transactions the restaurant can process per hour during this daypart. Used for labor scheduling and Speed of Service (SOS) benchmarking.']

  Note: 'Scheduled operating hours for each restaurant unit by day of week and daypart (breakfast, lunch, dinner, late-night, 24hr). Captures open time, close time, daypart start/end times, holiday schedule overrides, seasonal hour adjustments, drive-thru-specific hours, delivery window hours, and last-order cutoff times. Used for order routing, labor scheduling, and SSS (Same-Store Sales) period alignment.'
}

Table restaurant.equipment_asset {
  equipment_asset_id varchar [pk, note: 'Unique identifier for the equipment asset record. Primary key.']
  equipment_restaurant_unit_id varchar [note: 'Identifier of the restaurant unit where this equipment asset is installed.']
  equipment_unit_id varchar [note: 'Identifier of the restaurant unit where this equipment asset is installed.']
  fixed_asset_id varchar [note: 'Foreign key linking to finance.fixed_asset. Business justification: Asset depreciation and financial reporting require each physical equipment asset to be tied to a fixed‑asset record in finance.']
  procurement_supplier_id varchar [note: 'Identifier of the vendor or service provider responsible for maintenance and repair of this equipment asset.']
  acquisition_cost_usd decimal(18,2) [note: 'Original purchase price paid for the equipment asset in US dollars, used for CapEx (Capital Expenditure) tracking and depreciation calculations.']
  asset_condition_rating varchar [note: 'Current physical and operational condition assessment of the equipment asset based on inspection and performance criteria.']
  asset_tag_number varchar [note: 'Externally visible unique asset tag or barcode identifier affixed to the equipment for tracking and inventory purposes.']
  compliance_certification_expiry_date date [note: 'Date when the current compliance certification expires and recertification or inspection is required.']
  compliance_certification_number varchar [note: 'Certification or approval number from regulatory bodies (FDA, NSF, UL, OSHA) confirming the equipment meets safety and sanitation standards.']
  created_timestamp timestamp [note: 'Date and time when this equipment asset record was first created in the system.']
  depreciation_method varchar [note: 'Accounting method used to allocate the cost of the equipment asset over its useful life for financial reporting and tax purposes.']
  disposal_date date [note: 'Date when the equipment asset was decommissioned and removed from the restaurant, marking the end of its operational lifecycle.']
  disposal_method varchar [note: 'Method by which the equipment was disposed of at end of life, supporting asset lifecycle tracking and environmental compliance.']
  energy_rating varchar [note: 'Energy efficiency rating or certification (e.g., Energy Star rating) indicating the equipment\'s power consumption performance.']
  equipment_category varchar [note: 'High-level classification grouping equipment by operational domain (cooking, refrigeration, POS systems, etc.). [ENUM-REF-CANDIDATE: cooking|refrigeration|food_prep|beverage|pos_system|kitchen_display|sanitation|hvac — 8 candidates stripped; promote to reference product]']
  equipment_name varchar [note: 'Human-readable name or designation of the equipment asset (e.g., Fryer Station 1, POS Terminal 3, Walk-in Cooler).']
  equipment_type varchar [note: 'Category of equipment asset distinguishing its primary function within BOH (Back of House) or FOH (Front of House) operations. [ENUM-REF-CANDIDATE: fryer|grill|oven|refrigeration_unit|freezer|ice_machine|pos_terminal|kds_display|espresso_machine|beverage_dispenser|dishwasher|ventilation_hood|warming_cabinet|prep_table — 14 candidates stripped; promote to reference product]']
  installation_date date [note: 'Date when the equipment asset was installed and commissioned at the restaurant location.']
  last_modified_timestamp timestamp [note: 'Date and time when this equipment asset record was most recently updated.']
  last_service_date date [note: 'Most recent date when preventive maintenance or repair service was performed on this equipment asset.']
  last_temperature_check_timestamp timestamp [note: 'Most recent date and time when temperature was verified for temperature-critical equipment, supporting food safety audit trails.']
  lease_expiry_date date [note: 'Date when the lease or rental agreement for this equipment expires, requiring renewal or return of the asset.']
  location_zone varchar [note: 'Physical zone within the restaurant where the equipment is installed: BOH (Back of House), FOH (Front of House), Drive-Thru, Storage, or Outdoor.']
  maintenance_frequency_days varchar [note: 'Number of days between scheduled preventive maintenance services as defined by manufacturer guidelines or internal SOPs.']
  manufacturer_name varchar [note: 'Name of the company that manufactured the equipment asset.']
  model_number varchar [note: 'Manufacturer-assigned model number or designation for the equipment.']
  next_scheduled_maintenance_date date [note: 'Planned date for the next preventive maintenance service visit based on manufacturer recommendations and SOP (Standard Operating Procedure) schedules.']
  notes varchar [note: 'Free-text field for additional comments, special handling instructions, or historical context about the equipment asset.']
  operational_status decimal(10,4) [note: 'Current lifecycle status indicating whether the equipment is actively in use, under maintenance, or retired from service.']
  ownership_type varchar [note: 'Indicates whether the equipment is owned outright by the restaurant, leased under a capital or operating lease, or rented short-term.']
  power_consumption_watts varchar [note: 'Rated electrical power consumption of the equipment in watts under normal operating conditions, used for energy cost forecasting.']
  replacement_cost_usd decimal(15,2) [note: 'Estimated current market cost to replace this equipment asset with a comparable new unit, used for R&M (Repairs and Maintenance) budgeting and insurance valuation.']
  serial_number varchar [note: 'Unique serial number assigned by the manufacturer to this specific equipment unit for warranty and service tracking.']
  service_contract_number varchar [note: 'Reference number of the active service or maintenance contract covering this equipment asset, if applicable.']
  temperature_critical_flag boolean [note: 'Indicates whether this equipment maintains temperature-sensitive food products and requires continuous monitoring for HACCP (Hazard Analysis Critical Control Points) compliance.']
  temperature_max_f decimal(5,2) [note: 'Maximum safe operating temperature threshold in Fahrenheit for temperature-critical equipment, above which food safety is compromised.']
  temperature_min_f decimal(5,2) [note: 'Minimum safe operating temperature threshold in Fahrenheit for temperature-critical equipment, below which food safety is compromised.']
  useful_life_years varchar [note: 'Expected operational lifespan of the equipment asset in years, used for depreciation calculations and replacement planning.']
  warranty_expiry_date date [note: 'Date when the manufacturer or vendor warranty coverage ends, after which repairs and parts are at the restaurant\'s expense.']
  warranty_start_date date [note: 'Date when the manufacturer or vendor warranty coverage begins for this equipment asset.']

  Note: 'Inventory of all BOH and FOH equipment assets installed at each restaurant unit including all equipment types (fryer, grill, oven, KDS stations, POS terminals, refrigeration units, ice machines, espresso machines, drive-thru timers). Captures make, model, serial number, installation date, warranty expiry, last service date, next scheduled maintenance date, asset condition rating, replacement cost, software version (for digital equipment), and equipment-specific configuration attributes. Supports R&M (Repairs and Maintenance) planning, CapEx forecasting, PCI DSS compliance for payment terminals, and food safety compliance for temperature-critical equipment.'
}

Table restaurant.throughput_benchmark {
  throughput_benchmark_id varchar [pk, note: 'Unique identifier for the throughput benchmark record. Primary key for this entity.']
  daypart_id varchar [note: 'Identifier of the daypart (e.g., breakfast, lunch, dinner, late night) for which this benchmark applies. Links to the daypart reference table.']
  throughput_restaurant_unit_id varchar [note: 'Identifier of the restaurant unit to which this throughput benchmark applies. Links to the restaurant master record.']
  throughput_unit_id varchar [note: 'Identifier of the restaurant unit to which this throughput benchmark applies. Links to the restaurant master record.']
  approval_date date [note: 'Date when this throughput benchmark was formally approved for use in operational performance measurement.']
  approved_by varchar [note: 'Name or identifier of the operations manager, regional director, or executive who approved this throughput benchmark.']
  benchmark_source varchar [note: 'Source or origin of the benchmark definition. Corporate_standard = company-wide standard, franchise_agreement = defined in franchise contract, regional_target = regional operations target, unit_specific = customized for individual unit, industry_benchmark = derived from industry standards.']
  benchmark_type varchar [note: 'Classification of the benchmark: target = standard operational target, minimum = minimum acceptable performance, maximum = maximum achievable performance, stretch = aspirational goal for high-performing units.']
  created_timestamp timestamp [note: 'Timestamp when this throughput benchmark record was first created in the system.']
  effective_end_date date [note: 'Date until which this throughput benchmark remains effective. Null indicates the benchmark is currently active with no defined end date.']
  effective_start_date date [note: 'Date from which this throughput benchmark becomes effective. Supports temporal tracking of benchmark changes over time.']
  equipment_capacity_constraint varchar [note: 'Description of any equipment capacity constraints (e.g., grill capacity, fryer capacity, KDS screen count) that limit throughput for this service channel and daypart.']
  labor_fte_requirement decimal(6,2) [note: 'Number of Full-Time Equivalent (FTE) staff required to achieve the target throughput for this service channel and daypart. Used for workforce scheduling and labor planning.']
  last_review_date date [note: 'Date when this throughput benchmark was last reviewed by operations management or performance analysts.']
  modified_timestamp timestamp [note: 'Timestamp when this throughput benchmark record was last modified or updated.']
  next_review_date date [note: 'Scheduled date for the next review of this throughput benchmark. Calculated based on last_review_date and review_frequency_days.']
  notes varchar [note: 'Free-text notes providing additional context, rationale, or special considerations for this throughput benchmark. May include information about seasonal adjustments, promotional impacts, or facility-specific factors.']
  off_peak_multiplier decimal(5,2) [note: 'Multiplier applied to base throughput targets during off-peak hours for this service channel and daypart. Used to adjust capacity expectations during low-demand periods.']
  peak_hour_multiplier decimal(5,2) [note: 'Multiplier applied to base throughput targets during peak hours for this service channel and daypart. Used to adjust capacity expectations during high-demand periods.']
  queue_length_threshold varchar [note: 'Maximum acceptable queue length (number of waiting customers or orders) for this service channel and daypart before operational intervention is required.']
  restaurant_format varchar [note: 'Format classification of the restaurant for which this benchmark applies. QSR = Quick-Service Restaurant, casual = Casual dining, fine_dining = Fine-dining establishment. Benchmarks vary significantly by format.']
  review_frequency_days varchar [note: 'Frequency in days at which this throughput benchmark should be reviewed and potentially updated. Supports continuous improvement and operational excellence initiatives.']
  service_channel varchar [note: 'The service channel for which this benchmark is defined. DT = Drive-Thru, counter = Front counter service, OLO = Online Ordering, 3PD = Third-Party Delivery, dine_in = Dine-in service, curbside = Curbside pickup.']
  sos_compliance_threshold_pct decimal(5,2) [note: 'Percentage threshold for Speed of Service (SOS) compliance. Represents the minimum percentage of orders that must meet the target ticket time to be considered compliant.']
  target_acv decimal(10,2) [note: 'Target Average Check Value (ACV) in local currency for this service channel and daypart. Represents the expected revenue per transaction.']
  target_adt decimal(10,2) [note: 'Target Average Daily Transactions (ADT) for this service channel and daypart. Represents the expected number of transactions per day.']
  target_atc decimal(10,2) [note: 'Target Average Transaction Count (ATC) for this service channel and daypart. Represents the expected number of items per transaction.']
  target_cover_count_capacity varchar [note: 'Maximum number of covers (individual servings) that can be served simultaneously for this service channel and daypart, based on FOH (Front of House) and BOH (Back of House) capacity constraints.']
  target_table_turn_minutes varchar [note: 'Target time in minutes for a table turn (time from guest seating to table availability for next guest). Applicable primarily to dine-in service channels in casual and fine-dining formats.']
  target_throughput_covers_per_hour decimal(10,2) [note: 'Target number of customer covers (individual servings) that should be served per hour for this service channel and daypart. Used for capacity planning and performance benchmarking.']
  target_throughput_transactions_per_hour decimal(10,2) [note: 'Target number of transactions (orders) that should be processed per hour for this service channel and daypart. Used for operational performance benchmarking.']
  target_ticket_time_seconds varchar [note: 'Target time in seconds from order placement to order fulfillment for this service channel and daypart. Key Speed of Service (SOS) metric.']
  throughput_benchmark_status varchar [note: 'Current lifecycle status of the throughput benchmark record. Active = currently in use, inactive = temporarily disabled, draft = under review, archived = historical record.']

  Note: 'Defines throughput capacity benchmarks and speed-of-service (SOS) targets for each restaurant unit by service channel (DT drive-thru, counter, OLO online, 3PD third-party delivery) and daypart. Captures target ticket time (seconds), target throughput (covers/hour or transactions/hour), ADT (Average Daily Transactions) target, ATC (Average Transaction Count) target, ACV (Average Check Value) target, table turn target (minutes), and cover count capacity. Used for operational performance benchmarking and SOS compliance.'
}

Table restaurant.sos_measurement {
  sos_measurement_id varchar [pk, note: 'Unique identifier for each speed-of-service measurement event. Primary key for the SOS measurement transactional record.']
  daypart_id varchar [note: 'Identifier of the daypart during which this measurement occurred (breakfast, lunch, dinner, late-night). Links to daypart reference data.']
  guest_order_id varchar [note: 'Identifier of the guest order associated with this SOS measurement. Links to the order transaction record captured in the POS system.']
  sos_restaurant_unit_id varchar [note: 'Identifier of the restaurant unit where this SOS measurement was captured. Links to the restaurant master record.']
  sos_target_id varchar [note: 'Identifier of the applicable SOS target benchmark for this service channel and daypart combination. Links to the SOS target reference data for variance analysis.']
  sos_unit_id varchar [note: 'Identifier of the restaurant unit where this SOS measurement was captured. Links to the restaurant master record.']
  created_timestamp timestamp [note: 'Timestamp when this SOS measurement record was first created in the data system, in format yyyy-MM-ddTHH:mm:ss.SSSXXX. Audit trail for data lineage.']
  equipment_issue_flag boolean [note: 'Boolean indicator of whether any equipment malfunction or issue was reported during this service event. True if equipment issue was logged; False otherwise.']
  exception_reason varchar [note: 'Free-text description of any exceptional circumstances that impacted service time for this measurement. Examples include equipment failure, staff shortage, system outage, or unusual order requirements.']
  guest_satisfaction_rating varchar [note: 'Customer Satisfaction (CSAT) rating provided by the guest for this service event, typically on a scale of 1-5. Captured via receipt survey, mobile app feedback, or kiosk prompt.']
  measurement_quality_score decimal(3,2) [note: 'Data quality score for this measurement record, ranging from 0.00 to 1.00. Reflects completeness, accuracy, and reliability of the captured timing data. Lower scores indicate potential data quality issues.']
  measurement_source varchar [note: 'System or device that captured the SOS measurement. Point of Sale (POS) timer, Kitchen Display System (KDS), drive-thru sensor array, manual staff entry, Online Ordering (OLO) platform, or third-party delivery API.']
  measurement_timestamp timestamp [note: 'Precise date and time when the speed-of-service measurement was captured, in format yyyy-MM-ddTHH:mm:ss.SSSXXX. Represents the business event time of the service completion.']
  modified_timestamp timestamp [note: 'Timestamp when this SOS measurement record was last modified in the data system, in format yyyy-MM-ddTHH:mm:ss.SSSXXX. Audit trail for data lineage and change tracking.']
  nps_score decimal(10,2) [note: 'Net Promoter Score (NPS) rating provided by the guest for this service event, typically on a scale of 0-10. Measures guest loyalty and likelihood to recommend.']
  order_complexity_score decimal(5,2) [note: 'Calculated complexity score for the order based on item count, customizations, and preparation requirements. Higher scores indicate more complex orders that may require longer service times.']
  order_item_count varchar [note: 'Total number of menu items in the order associated with this SOS measurement. Used to analyze SOS performance relative to order complexity.']
  order_to_delivery_time_seconds varchar [note: 'Total elapsed time in seconds from order placement to order delivered to guest. Includes preparation time plus handoff time. End-to-end service time metric.']
  order_to_ready_time_seconds varchar [note: 'Elapsed time in seconds from order placement to order ready for pickup or delivery. Measured from POS order entry timestamp to Kitchen Display System (KDS) completion timestamp.']
  peak_period_flag boolean [note: 'Boolean indicator of whether the measurement occurred during a designated peak service period. True for peak hours; False for off-peak hours.']
  queue_depth_count varchar [note: 'Number of vehicles or guests in the service queue at the time of measurement. Indicates throughput capacity and congestion level.']
  queue_wait_time_seconds varchar [note: 'Time in seconds the guest or vehicle spent waiting in queue before placing order. Applicable primarily to Drive-Thru (DT) and counter service channels.']
  service_channel varchar [note: 'The channel through which the guest order was placed and fulfilled. Drive-Thru (DT), Front of House (FOH) counter, self-service kiosk, Online Ordering (OLO), Third-Party Delivery (3PD), or curbside pickup.']
  service_recovery_flag boolean [note: 'Boolean indicator of whether service recovery actions were taken for this order due to SOS delays or other service failures. True if recovery actions were applied; False otherwise.']
  staff_count_on_duty varchar [note: 'Number of Full-Time Equivalent (FTE) staff members on duty in the service area at the time of measurement. Used to correlate staffing levels with SOS performance.']
  target_met_flag boolean [note: 'Boolean indicator of whether the SOS measurement met or exceeded the target benchmark. True if actual time was at or below target; False if actual time exceeded target.']
  target_variance_seconds varchar [note: 'Difference in seconds between actual order-to-delivery time and the SOS target benchmark. Positive values indicate slower than target; negative values indicate faster than target.']
  ticket_time_seconds varchar [note: 'Total time in seconds the order ticket was active in the kitchen or service queue. Represents Back of House (BOH) processing duration from ticket creation to fulfillment.']
  weather_condition varchar [note: 'Weather condition at the restaurant location during the measurement period. Used to analyze external factors impacting drive-thru and curbside service times. [ENUM-REF-CANDIDATE: clear|rain|snow|fog|wind|extreme_heat|extreme_cold — 7 candidates stripped; promote to reference product]']

  Note: 'Transactional records of actual speed-of-service (SOS), throughput measurements, and table turn events captured per service event at each restaurant unit across all channels. For drive-thru/counter/kiosk/OLO: captures measurement timestamp, service channel, daypart, order-to-ready time, order-to-delivery time, ticket time, queue wait time, and measurement source (POS timer, KDS, sensor). For dine-in table service: captures table identifier, cover count, seating time, order-placed time, food-delivered time, check-presented time, table-cleared time, total turn time, server station, party size, and table status transitions. This is the single source of truth for all operational timing and throughput measurements across every service model. Enables unified SOS trend analysis, table turn rate optimization, cover count tracking, FOH throughput benchmarking, and benchmark gap identification.'
}

Table restaurant.brand_standard {
  brand_standard_id varchar [pk, note: 'Unique identifier for the brand standard record. Primary key.']
  brand_id varchar [note: 'Foreign key to restaurant.brand.brand_id']
  superseded_by_standard_brand_standard_id varchar [note: 'Reference to the brand_standard_id of the newer standard that replaces this one. Null if this standard is current and has not been superseded.']
  applicable_format varchar [note: 'Restaurant format(s) to which this brand standard applies. QSR (Quick-Service Restaurant) for fast food, casual for casual dining, fine_dining for upscale establishments, or combinations/all formats. [ENUM-REF-CANDIDATE: all|qsr|casual|fine_dining|qsr_casual|qsr_fine_dining|casual_fine_dining — 7 candidates stripped; promote to reference product]']
  applicable_ownership_model varchar [note: 'Ownership model(s) to which this standard applies: company-owned units, franchised units, or all units regardless of ownership.']
  audit_frequency varchar [note: 'Expected frequency at which compliance with this standard should be audited or inspected (e.g., daily temperature logs, monthly cleanliness audits, annual safety inspections). [ENUM-REF-CANDIDATE: daily|weekly|monthly|quarterly|semi_annual|annual|ad_hoc — 7 candidates stripped; promote to reference product]']
  brand_standard_status varchar [note: 'Current lifecycle status of the brand standard. Active standards are in force. Inactive standards are no longer enforced. Draft standards are under development. Under_review standards are being revised. Superseded standards have been replaced by a newer version.']
  certification_body varchar [note: 'Name of the external organization or authority that issues the required certification (e.g., National Restaurant Association ServSafe, OSHA, Local Health Department). Null if no certification is required.']
  certification_required_flag boolean [note: 'Indicates whether staff must obtain a formal certification to perform tasks related to this standard (e.g., ServSafe Food Handler certification for food safety standards). True if certification is mandatory, False otherwise.']
  compliance_requirement_level varchar [note: 'Enforcement level of the standard. Mandatory standards must be met for operational compliance and are subject to audit consequences. Recommended standards are best practices encouraged but not enforced. Aspirational standards represent future-state goals.']
  created_timestamp timestamp [note: 'Timestamp when this brand standard record was first created in the system.']
  effective_date date [note: 'Date on which this brand standard becomes active and enforceable. Standards are not applicable before this date.']
  expiry_date date [note: 'Date on which this brand standard is no longer active or enforceable. Null indicates an open-ended standard with no planned expiration.']
  governing_body_reference varchar [note: 'External regulatory or industry body that mandates or influences this standard (e.g., FDA, USDA, OSHA, NRA ServSafe, Local Health Department, ISO 22000). Null if the standard is purely internal.']
  guest_facing_flag boolean [note: 'Indicates whether this standard directly impacts the guest experience and is visible or perceptible to customers (e.g., FOH cleanliness, service speed, food presentation). True if guest-facing, False if back-of-house or internal only.']
  last_review_date date [note: 'Date on which this brand standard was last reviewed for accuracy, relevance, and compliance with current regulations. Used to track review cycles and ensure standards remain current.']
  measurement_method varchar [note: 'Method by which compliance with this standard is assessed: direct observation (visual inspection), checklist (structured audit form), measurement (thermometer, timer), testing (lab analysis, swab test), documentation review (log verification), or guest feedback (CSAT, NPS).']
  next_review_date date [note: 'Scheduled date for the next formal review of this brand standard. Ensures periodic reassessment to maintain relevance and regulatory alignment.']
  non_compliance_consequence varchar [note: 'Consequence or remediation action triggered when a unit fails to meet this standard. Ranges from warnings and corrective action plans to financial penalties, operational suspension, or franchise termination for critical violations.']
  owner_department varchar [note: 'Internal department or functional area responsible for defining, maintaining, and enforcing this brand standard (e.g., Food Safety, Operations, Quality Assurance, Franchise Development, Marketing).']
  priority_level varchar [note: 'Business priority level of the standard. Critical standards directly impact guest safety or regulatory compliance. High standards affect brand reputation or operational efficiency. Medium and low standards are important but less urgent.']
  sop_document_reference varchar [note: 'Reference identifier or URI to the detailed SOP document that operationalizes this brand standard. May be a document management system ID, SharePoint link, or file path.']
  standard_category varchar [note: 'High-level classification of the brand standard into operational domains: food quality (taste, temperature, freshness), food safety (HACCP compliance, contamination prevention), cleanliness (sanitation, hygiene), service excellence (guest interaction, speed of service), brand presentation (signage, uniforms, decor), workplace safety (OSHA compliance, injury prevention), or equipment maintenance (preventive maintenance, calibration). [ENUM-REF-CANDIDATE: food_quality|food_safety|cleanliness|service_excellence|brand_presentation|workplace_safety|equipment_maintenance — 7 candidates stripped; promote to reference product]']
  standard_code varchar [note: 'Unique business identifier code for the brand standard, typically following a category-number pattern (e.g., FS-001 for Food Safety standard 001, CL-042 for Cleanliness standard 042).']
  standard_description varchar [note: 'Detailed narrative description of the brand standard, including the specific requirement, rationale, and expected outcome. May reference specific procedures, thresholds, or quality criteria.']
  standard_name varchar [note: 'Full descriptive name of the brand standard (e.g., \'Proper Handwashing Protocol\', \'Drive-Thru Speed of Service Target\', \'Uniform and Appearance Guidelines\').']
  target_metric_unit varchar [note: 'Unit of measure for the target metric value (e.g., degrees Fahrenheit, seconds, percentage, count). Null if the standard does not have a quantitative metric.']
  target_metric_value decimal(18,2) [note: 'Specific quantitative or qualitative target that defines compliance with this standard (e.g., \'Food temperature >= 165°F\', \'Speed of Service <= 90 seconds\', \'Cleanliness score >= 95%\', \'Zero critical violations\'). Null if the standard is qualitative without a numeric threshold.']
  training_module_reference varchar [note: 'Reference identifier to the training module or course that covers this brand standard. May be an LMS (Learning Management System) course ID or training document reference. Null if no formal training module exists.']
  training_required_flag boolean [note: 'Indicates whether formal training is required for staff to understand and comply with this standard. True if training is mandatory, False otherwise.']
  updated_timestamp timestamp [note: 'Timestamp when this brand standard record was last modified in the system.']
  version_number varchar [note: 'Version identifier for the standard, following semantic versioning (e.g., 1.0, 2.1, 3.0). Incremented when the standard is revised or updated.']

  Note: 'Defines the brand standards and SOPs (Standard Operating Procedures) applicable to each restaurant unit by concept type and ownership model. Captures standard code, standard name, standard category (food quality, cleanliness, service, safety, brand presentation), applicable format (QSR/casual/fine-dining), compliance requirement level (mandatory/recommended), effective date, expiry date, governing body reference (NRA, FDA, OSHA), and linked SOP document reference. Operational anchor for audit and compliance workflows.'
}

Table restaurant.unit_performance {
  unit_performance_id varchar [pk, note: 'Unique identifier for the unit performance record. Primary key for this periodic operational and financial performance snapshot.']
  performance_period_id varchar [note: 'Foreign key linking to restaurant.performance_period. Business justification: Linking unit_performance to the master performance_period table provides a single source of period metadata and eliminates redundant date fields.']
  primary_restaurant_unit_id varchar [note: 'Identifier of the restaurant unit for which this performance record is captured. Links to the restaurant master record.']
  acv_amount decimal(10,2) [note: 'Average Check Value (ACV) - average revenue per customer transaction during the performance period. Calculated as total revenue divided by transaction count.']
  adt_count varchar [note: 'Average Daily Transactions (ADT) - average number of customer transactions processed per day during the performance period.']
  atc_count varchar [note: 'Average Transaction Count (ATC) - total number of customer transactions during the performance period.']
  auc_amount decimal(18,2) [note: 'Average Unit Volume (AUV) - total revenue generated by the restaurant unit during the performance period. Key metric for unit-level revenue performance.']
  cogs_amount decimal(18,2) [note: 'Cost of Goods Sold (COGS) - total cost of food and beverage inventory consumed during the performance period.']
  cogs_percent decimal(5,2) [note: 'Cost of Goods Sold (COGS) Percentage - COGS as a percentage of total revenue. Key metric for food cost management.']
  comp_sales_amount decimal(18,2) [note: 'Comparable Store Sales (Comp Sales) - revenue for the current period for units that were operational in both the current and prior comparison period.']
  comp_sales_variance_amount decimal(18,2) [note: 'Variance in Comparable Store Sales between current period and prior period, expressed as an absolute amount.']
  created_timestamp timestamp [note: 'Record created']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts in this performance record (e.g., USD, EUR, GBP).']
  ebitda_amount decimal(18,2) [note: 'Earnings Before Interest, Taxes, Depreciation, and Amortization (EBITDA) - key profitability metric for unit-level P&L management.']
  fiscal_month varchar [note: 'Fiscal month within the fiscal year (1-12) to which this performance period belongs.']
  fiscal_quarter varchar [note: 'Fiscal quarter within the fiscal year (1, 2, 3, or 4) to which this performance period belongs.']
  fiscal_week varchar [note: 'Fiscal week within the fiscal year (1-52 or 1-53) to which this performance period belongs.']
  fiscal_year varchar [note: 'Fiscal year to which this performance period belongs (e.g., 2024).']
  gross_revenue_amount decimal(18,2) [note: 'Gross revenue before any deductions (discounts, promotions, refunds, voids) during the performance period.']
  labor_cost_amount decimal(18,2) [note: 'Total labor cost including wages, benefits, and payroll taxes for the performance period.']
  labor_percent decimal(5,2) [note: 'Labor Cost Percentage - total labor cost as a percentage of total revenue. Key metric for workforce efficiency.']
  marketing_expense_amount decimal(18,2) [note: 'Marketing and promotional expenses allocated to this unit during the performance period, including local store marketing and national campaign contributions.']
  net_income_amount decimal(18,2) [note: 'Net income (profit after all expenses, taxes, interest, depreciation, and amortization) for the performance period.']
  net_revenue_amount decimal(18,2) [note: 'Net revenue after deducting discounts, promotions, refunds, and voids during the performance period.']
  notes varchar [note: 'Free-text notes or comments regarding this performance period, including explanations for anomalies, special events, or operational issues.']
  operating_income_amount decimal(18,2) [note: 'Operating income (revenue minus operating expenses) for the performance period. Excludes interest, taxes, depreciation, and amortization.']
  performance_status varchar [note: 'Status of the performance record indicating whether the data is draft, preliminary, final, revised, or archived.']
  record_created_timestamp timestamp [note: 'Timestamp when this performance record was first created in the system.']
  record_updated_timestamp timestamp [note: 'Timestamp when this performance record was last updated in the system.']
  rent_expense_amount decimal(18,2) [note: 'Rent or lease expense for the restaurant facility during the performance period. Includes base rent and Common Area Maintenance (CAM) charges for leased locations.']
  rm_expense_amount decimal(18,2) [note: 'Repairs and Maintenance (R&M) expense for equipment, facilities, and infrastructure during the performance period.']
  sss_growth_percent decimal(5,2) [note: 'Same-Store Sales (SSS) growth percentage comparing current period revenue to the same period in the prior year for units open at least 12 months. Excludes new restaurant openings.']
  total_operating_expenses_amount decimal(18,2) [note: 'Total operating expenses including COGS, labor, utilities, rent, repairs and maintenance, and other operational costs.']
  utility_expense_amount decimal(18,2) [note: 'Total utility expenses (electricity, gas, water, waste disposal) during the performance period.']
  waste_amount decimal(18,2) [note: 'Total cost of food waste (spoilage, preparation errors, expired inventory) during the performance period.']
  waste_percent decimal(5,2) [note: 'Food Waste Percentage - waste cost as a percentage of total COGS. Key metric for inventory and quality management.']

  Note: 'Periodic operational and financial performance record for each restaurant unit capturing AUV (Average Unit Volume), SSS (Same-Store Sales) growth %, comp sales (Comparable Store Sales) vs. prior period, ADT (Average Daily Transactions), ATC (Average Transaction Count), ACV (Average Check Value), COGS% (Cost of Goods Sold Percentage), Labor% (Labor Cost Percentage), Waste% (Food Waste Percentage), EBITDA, and net revenue. Sourced from Oracle MICROS POS and SAP S/4HANA. Primary performance scorecard for unit-level P&L management.'
}

Table restaurant.table_turn_log {
  table_turn_log_id varchar [pk, note: 'Unique identifier for each table turn event record. Primary key for the table turn log.']
  guest_order_id varchar [note: 'Identifier linking to the guest order record in the POS system. Enables correlation of table turn metrics with order details and revenue.']
  performance_period_id varchar [note: 'Identifier linking to the specific service period definition. Provides detailed service window context beyond daypart classification.']
  table_employee_id varchar [note: 'Identifier of the server or waiter assigned to this table. Used for server performance analysis and labor productivity metrics.']
  table_restaurant_unit_id varchar [note: 'Identifier of the restaurant unit where the table turn event occurred. Links to the restaurant location profile.']
  table_server_employee_id varchar [note: 'Identifier of the server or waiter assigned to this table. Used for server performance analysis and labor productivity metrics.']
  table_unit_id varchar [note: 'Identifier of the restaurant unit where the table turn event occurred. Links to the restaurant location profile.']
  check_presented_timestamp timestamp [note: 'Date and time when the check was presented to the guest. Indicates the end of the dining experience and start of payment processing.']
  check_to_cleared_minutes decimal(8,2) [note: 'Time in minutes from check presentation to table cleared. Measures payment processing and table reset efficiency.']
  check_total_amount decimal(12,2) [note: 'Total dollar amount of the check for this table turn. Used to calculate revenue per table turn and average check value (ACV) by turn time.']
  cover_count varchar [note: 'Number of guests seated at the table for this turn. Critical metric for capacity planning and revenue per available seat hour (RevPASH) analysis.']
  created_timestamp timestamp [note: 'Date and time when this table turn log record was created in the system. Used for data lineage and audit trail.']
  day_of_week varchar [note: 'Day of the week when the table turn occurred. Used for day-of-week table turn pattern analysis and staffing optimization. [ENUM-REF-CANDIDATE: monday|tuesday|wednesday|thursday|friday|saturday|sunday — 7 candidates stripped; promote to reference product]']
  daypart varchar [note: 'The service period or daypart during which the table turn occurred. Used for daypart-specific table turn benchmarking and capacity planning.']
  delivery_to_check_minutes decimal(8,2) [note: 'Time in minutes from food delivery to check presentation. Represents the dining and service interaction period.']
  food_delivered_timestamp timestamp [note: 'Date and time when food was delivered to the table. Used to calculate kitchen ticket time and overall speed of service (SOS) from order to delivery.']
  is_peak_period boolean [note: 'Indicates whether this table turn occurred during a peak service period (True) or off-peak (False). Used to benchmark turn times against service volume.']
  last_updated_timestamp timestamp [note: 'Date and time when this table turn log record was last modified. Used for change tracking and data quality monitoring.']
  notes varchar [note: 'Free-text notes or comments about the table turn event. May include service issues, guest requests, or operational exceptions.']
  order_placed_timestamp timestamp [note: 'Date and time when the guest order was placed with the server or entered into the POS (Point of Sale) system. Used to measure greeting and order-taking speed of service.']
  order_to_delivery_minutes decimal(8,2) [note: 'Time in minutes from order placement to food delivery. Measures BOH (Back of House) kitchen speed and KDS (Kitchen Display System) ticket time.']
  party_size varchar [note: 'The number of guests in the dining party. May differ from cover count if party splits across multiple tables or if seats remain empty.']
  payment_completed_timestamp timestamp [note: 'Date and time when payment was completed and processed. Marks the financial close of the table turn.']
  reservation_flag boolean [note: 'Indicates whether this table turn was for a reserved party (True) or walk-in (False). Used to analyze reservation vs walk-in turn time differences.']
  revenue_per_cover decimal(12,2) [note: 'Average revenue per guest cover for this table turn. Calculated as check_total_amount divided by cover_count. Key metric for per-guest revenue analysis.']
  seating_timestamp timestamp [note: 'Date and time when guests were seated at the table. Marks the start of the table turn cycle and is used to calculate total turn time.']
  seating_to_order_minutes decimal(8,2) [note: 'Time in minutes from guest seating to order placement. Measures FOH greeting and order-taking efficiency.']
  server_station varchar [note: 'The FOH station or section assignment for the server handling this table. Used for workload balancing and station performance analysis.']
  sos_target_minutes decimal(8,2) [note: 'Target table turn time in minutes for this daypart and restaurant format. Used to measure actual performance against SOS benchmarks.']
  sos_variance_minutes decimal(8,2) [note: 'Variance between actual total turn time and SOS target in minutes. Positive values indicate slower than target; negative values indicate faster than target.']
  special_occasion_flag boolean [note: 'Indicates whether this table turn was for a special occasion (birthday, anniversary, celebration). Special occasions may have longer turn times due to enhanced service.']
  table_capacity varchar [note: 'Maximum seating capacity of the table. Used to calculate table utilization percentage (cover_count / table_capacity).']
  table_cleared_timestamp timestamp [note: 'Date and time when the table was cleared and reset for the next party. Marks the end of the table turn cycle and availability for next seating.']
  table_number varchar [note: 'The unique identifier or number assigned to the table within the restaurant. Used for FOH (Front of House) table management and server station assignment.']
  table_section varchar [note: 'The physical section or zone of the restaurant where the table is located (e.g., main dining, patio, bar area). Used for section-level throughput analysis.']
  total_turn_time_minutes decimal(18,2) [note: 'Total elapsed time in minutes from seating to table cleared. Primary metric for table turn rate analysis and throughput optimization. Calculated as the difference between table_cleared_timestamp and seating_timestamp.']
  turn_date date [note: 'Business date on which the table turn occurred. Used for daily table turn rate reporting and trend analysis. May differ from seating_timestamp date for late-night service.']
  turn_sequence_number varchar [note: 'Sequential number indicating which turn this represents for the table during the service period (1st turn, 2nd turn, etc.). Used to track table utilization throughout the day.']
  turn_status varchar [note: 'Current status of the table turn event. Completed indicates normal turn cycle; incomplete indicates missing timestamps; voided indicates cancelled service; abandoned indicates guests left before service completion.']
  wait_time_minutes decimal(8,2) [note: 'Time in minutes that the party waited before being seated. Used to correlate wait times with table turn efficiency and guest satisfaction.']

  Note: 'Transactional log of table turn events at each restaurant unit capturing table identifier, cover count seated, seating time, order-placed time, food-delivered time, check-presented time, table-cleared time, total turn time (minutes), daypart, server station, and party size. Enables table turn rate analysis, cover count optimization, and FOH throughput benchmarking for casual and fine-dining formats.'
}

Table restaurant.capacity_config {
  capacity_config_id varchar [pk, note: 'Unique identifier for the capacity configuration record. Primary key.']
  capacity_restaurant_unit_id varchar [note: 'Identifier of the restaurant unit to which this capacity configuration applies.']
  capacity_unit_id varchar [note: 'Identifier of the restaurant unit to which this capacity configuration applies.']
  ada_compliant_seating_count varchar [note: 'Number of seating positions that meet ADA accessibility requirements for guests with disabilities.']
  avg_party_size decimal(5,2) [note: 'Average number of guests per dining party used for capacity planning and labor forecasting.']
  bar_seating_count varchar [note: 'Number of seats available at the bar or counter service area.']
  config_effective_date date [note: 'The date from which this capacity configuration becomes effective for the restaurant unit.']
  config_end_date date [note: 'The date on which this capacity configuration ceases to be effective. Null indicates the configuration is currently active.']
  config_notes varchar [note: 'Free-text notes documenting special considerations, constraints, or context for this capacity configuration.']
  config_status varchar [note: 'Current lifecycle status of the capacity configuration record.']
  counter_service_positions varchar [note: 'Number of staffed counter service positions available for order taking and guest interaction.']
  created_timestamp timestamp [note: 'Timestamp when this capacity configuration record was first created in the system.']
  curbside_pickup_spaces varchar [note: 'Number of designated parking spaces available for curbside pickup and online ordering (OLO) fulfillment.']
  delivery_staging_capacity varchar [note: 'Number of completed delivery orders that can be staged simultaneously in the designated pickup area for third-party delivery (3PD) drivers.']
  drive_thru_sos_target_seconds varchar [note: 'Target time in seconds for drive-thru order fulfillment from order point to pickup window.']
  drive_thru_stacking_capacity varchar [note: 'Maximum number of vehicles that can queue in the drive-thru lane before reaching the order point.']
  fire_code_occupancy_limit varchar [note: 'Maximum number of occupants (guests and staff) permitted in the facility as determined by local fire safety regulations.']
  health_permit_capacity varchar [note: 'Maximum seating capacity approved by the local health department on the restaurant operating permit.']
  indoor_seating_capacity varchar [note: 'Total number of indoor seats available for guest dining in the Front of House (FOH) area.']
  kiosk_count varchar [note: 'Number of self-service ordering kiosks available in the Front of House (FOH) for guest order placement.']
  kitchen_production_capacity_orders_per_hour varchar [note: 'Maximum number of orders the Back of House (BOH) kitchen can produce per hour at full operational capacity.']
  labor_staffing_ratio decimal(5,2) [note: 'Target ratio of Full-Time Equivalent (FTE) staff to seating capacity or covers, used for workforce scheduling and labor cost planning.']
  max_cover_count_breakfast varchar [note: 'Maximum number of guest covers (individual diners) that can be served during the breakfast daypart based on seating and throughput capacity.']
  max_cover_count_dinner varchar [note: 'Maximum number of guest covers that can be served during the dinner daypart based on seating and throughput capacity.']
  max_cover_count_late_night varchar [note: 'Maximum number of guest covers that can be served during the late night daypart based on seating and throughput capacity.']
  max_cover_count_lunch varchar [note: 'Maximum number of guest covers that can be served during the lunch daypart based on seating and throughput capacity.']
  outdoor_seating_capacity varchar [note: 'Total number of outdoor or patio seats available for guest dining.']
  peak_hour_throughput_capacity varchar [note: 'Maximum number of guest transactions or covers that can be processed during the busiest hour of operation.']
  private_dining_capacity varchar [note: 'Total seating capacity in private dining rooms or event spaces within the restaurant.']
  sos_target_seconds varchar [note: 'Target time in seconds from order placement to order delivery, used as a key operational performance metric.']
  table_turn_target_minutes varchar [note: 'Target time in minutes for a complete table turn cycle from guest seating to table reset for the next guest.']
  total_seating_capacity decimal(18,2) [note: 'Aggregate seating capacity across all dining areas including indoor, outdoor, bar, and private dining.']
  updated_timestamp timestamp [note: 'Timestamp when this capacity configuration record was last modified.']

  Note: 'Defines the seating and service capacity configuration for each restaurant unit including total indoor seating capacity, outdoor/patio seating capacity, bar seating count, private dining room capacity, drive-thru stacking capacity (number of vehicles), kiosk count, counter service positions, maximum cover count per daypart, and ADA-compliant seating count. Used for throughput planning, labor staffing ratios, and health department permit compliance.'
}

Table restaurant.unit_status_history {
  unit_status_history_id varchar [pk, note: 'Unique identifier for each unit status history record. Primary key for the unit status history tracking entity.']
  primary_restaurant_unit_id varchar [note: 'Identifier of the restaurant unit to which this status history record applies. Links to the master restaurant entity.']
  unit_employee_id varchar [note: 'System user identifier of the individual who recorded or approved the status change. Used for audit trail and accountability.']
  unit_initiated_by_user_employee_id varchar [note: 'System user identifier of the individual who recorded or approved the status change. Used for audit trail and accountability.']
  actual_reopen_date date [note: 'The actual date when the restaurant unit returned to active status. Used to measure variance against expected reopen date and assess project execution.']
  approval_date date [note: 'Date when the status change was formally approved by the appropriate authority. Null if no approval was required or approval is still pending.']
  approval_required boolean [note: 'Indicates whether the status change required formal approval from corporate leadership, franchise partner, or regulatory authority before implementation.']
  approved_by varchar [note: 'Name or identifier of the individual or role that approved the status change. Used for governance and audit trail purposes.']
  closure_type varchar [note: 'Classification of the closure event distinguishing between planned maintenance closures, emergency shutdowns, regulatory actions, and other closure scenarios. [ENUM-REF-CANDIDATE: planned|unplanned|emergency|seasonal|regulatory|voluntary|involuntary — 7 candidates stripped; promote to reference product]']
  compliance_notes varchar [note: 'Free-text field capturing compliance-related information associated with the status change, including regulatory requirements, corrective actions, or legal considerations.']
  created_timestamp timestamp
  effective_date date [note: 'The date on which this status became effective for the restaurant unit. Used to determine SSS eligibility windows and operational reporting periods.']
  end_date date [note: 'The date on which this status ceased to be effective, marking the transition to the next status. Null for the current active status record.']
  estimated_revenue_impact decimal(15,2) [note: 'Projected financial impact on unit revenue during the status period, expressed in local currency. Used for financial planning and P&L forecasting.']
  expected_reopen_date date [note: 'Anticipated date when the restaurant unit is expected to return to active status following a temporary closure or renovation. Null if not applicable or unknown.']
  grand_opening_date date [note: 'Official grand opening date for the restaurant unit. Marks the beginning of full operational status and SSS eligibility countdown.']
  health_department_case_number varchar [note: 'Official case or incident number assigned by the local health department if the status change was triggered by a health inspection failure or food safety violation.']
  impact_on_franchise_agreement varchar [note: 'Description of how this status change affects the franchise agreement terms, royalty obligations, or compliance requirements. Relevant for franchise partner relations and legal review.']
  initiated_by varchar [note: 'The party or department that initiated the status change. Identifies accountability and decision authority for lifecycle transitions. [ENUM-REF-CANDIDATE: corporate_operations|franchise_partner|health_department|real_estate|finance|legal|system — 7 candidates stripped; promote to reference product]']
  is_sss_eligible boolean [note: 'Indicates whether the restaurant unit is eligible for inclusion in Same-Store Sales (SSS) calculations during this status period. Typically requires 12+ months of continuous active operation.']
  notification_sent_date date [note: 'Date when formal notification of the status change was communicated to relevant stakeholders including franchise partners, corporate operations, and regulatory bodies.']
  nro_flag boolean [note: 'Indicates whether this status record is associated with a New Restaurant Opening (NRO) event. Used to track grand opening milestones and ramp-up performance.']
  previous_status varchar [note: 'The status of the restaurant unit immediately prior to this status change. Enables transition analysis and lifecycle pattern identification.']
  reason_code varchar [note: 'Standardized code indicating the reason for the status change. Examples include health_violation, lease_expiration, remodel, nro_launch, seasonal_closure, natural_disaster, underperformance, franchise_termination.']
  reason_description varchar [note: 'Detailed narrative explanation of the reason for the status change. Provides context beyond the standardized reason code for audit and operational review.']
  record_created_timestamp timestamp [note: 'System timestamp indicating when this status history record was first created in the data platform. Used for audit trail and data lineage tracking.']
  record_updated_timestamp timestamp [note: 'System timestamp indicating when this status history record was last modified. Used for audit trail and change tracking.']
  renovation_scope varchar [note: 'Classification of the renovation or remodel scope when the status change is related to facility improvements. Impacts expected duration and capital expenditure (CapEx) tracking.']
  restaurant_number varchar [note: 'Business identifier for the restaurant unit. Human-readable store number used in operational systems and reporting.']
  soft_open_start_date date [note: 'Date when the restaurant unit began soft-open operations prior to the official grand opening. Used to track pre-launch performance and operational readiness.']
  source_system_record_code varchar [note: 'Unique identifier of this status history record in the source operational system. Enables traceability and reconciliation with upstream systems.']
  unit_status_history_status varchar [note: 'Current operational status of the restaurant unit at this point in the lifecycle. Determines eligibility for Same-Store Sales (SSS) calculations and operational reporting.']

  Note: 'Tracks the full lifecycle status history of each restaurant unit including status transitions (active, temporarily closed, permanently closed, under renovation, pre-opening, soft-open, NRO new restaurant opening), effective date of each status change, reason code, change initiated by (franchise partner, corporate operations, health department), and expected reopen date where applicable. Provides audit trail for unit lifecycle management and SSS eligibility determination.'
}

Table restaurant.area_management {
  area_management_id varchar [pk, note: 'Unique identifier for the area management record. Primary key.']
  area_employee_id varchar [note: 'Identifier of the area manager or district manager responsible for this area. Links to workforce management system.']
  parent_area_area_management_id varchar [note: 'Identifier of the parent area in the management hierarchy. Null for top-level areas.']
  primary_area_manager_employee_id varchar
  area_code varchar [note: 'Business identifier code for the area or district. Used in operational reporting and area manager assignment.']
  area_name varchar [note: 'Descriptive name of the area or district (e.g., \'Northeast Metro\', \'Southern California Region\').']
  area_status varchar [note: 'Current operational status of the area management record.']
  area_type varchar [note: 'Classification of the area management level within the organizational hierarchy.']
  auv_target decimal(15,2) [note: 'Target Average Unit Volume (AUV) for restaurants in this area, representing expected annual sales per unit.']
  brand varchar [note: 'Restaurant brand or concept associated with this area (e.g., \'Quick-Service Brand A\', \'Casual Dining Brand B\').']
  cogs_percent_target decimal(5,2) [note: 'Target Cost of Goods Sold (COGS) as a percentage of sales for restaurants in this area.']
  company_owned_unit_count varchar [note: 'Number of company-owned restaurant units within this area.']
  country_code varchar [note: 'Three-letter ISO country code for the primary country in which this area operates.']
  created_timestamp timestamp [note: 'Timestamp when this area management record was first created in the system.']
  csat_target_score decimal(5,2) [note: 'Target Customer Satisfaction (CSAT) score for this area, typically measured on a scale of 0-100.']
  division varchar [note: 'Corporate division or business unit to which this area is assigned.']
  effective_date date [note: 'Date when this area management configuration became effective.']
  expiration_date decimal(10,4) [note: 'Date when this area management configuration expires or is superseded. Null for current configurations.']
  franchise_agreement_flag boolean [note: 'Indicates whether this area is governed by a franchise area development agreement.']
  franchise_unit_count varchar [note: 'Number of franchised restaurant units within this area.']
  geographic_region varchar [note: 'Broader geographic region to which this area belongs (e.g., \'West Coast\', \'Midwest\', \'Southeast\').']
  hierarchy_level varchar [note: 'Numeric level in the area management hierarchy, with 1 being the top level (e.g., national) and higher numbers representing more granular levels (e.g., region, district).']
  labor_percent_target decimal(5,2) [note: 'Target labor cost as a percentage of sales for restaurants in this area.']
  last_modified_timestamp timestamp [note: 'Timestamp when this area management record was last updated.']
  marketing_fund_contribution_percent decimal(5,2) [note: 'Percentage of sales contributed to the marketing fund by units in this area.']
  notes varchar [note: 'Additional notes or comments regarding this area management record.']
  nps_target_score decimal(5,2) [note: 'Target Net Promoter Score (NPS) for this area, measuring customer loyalty and likelihood to recommend.']
  nro_target_count varchar [note: 'Target number of New Restaurant Openings (NRO) planned for this area within the current fiscal year.']
  royalty_rate_percent decimal(5,2) [note: 'Standard royalty rate percentage applied to franchise units in this area.']
  sos_target_seconds varchar [note: 'Target Speed of Service (SOS) in seconds for restaurants in this area, measuring average transaction time.']
  sss_target_percent decimal(5,2) [note: 'Target Same-Store Sales (SSS) growth percentage for this area, used to measure year-over-year comparable store performance.']
  state_province varchar [note: 'Primary state or province for this area. May be null for multi-state areas.']
  territory_boundary_description varchar [note: 'Textual description of the geographic or operational boundaries defining this area (e.g., \'All units within 50 miles of downtown Chicago\').']
  unit_count varchar [note: 'Total number of restaurant units (company-owned and franchised) within this area.']

  Note: 'Defines the operational management hierarchy above the restaurant unit level. Captures area/district/region boundaries, area manager assignment (name, employee ID, assignment effective dates), number of units in area, geographic region, division, brand, and area performance targets (AUV target, SSS target, CSAT target, Labor% target). Supports multi-unit management accountability, area manager performance reviews, regional performance rollups, and franchise territory alignment. One row per area/district assignment period.'
}

Table restaurant.renovation_project {
  renovation_project_id varchar [pk, note: 'Unique identifier for the renovation project. Primary key.']
  franchisee_id varchar [note: 'Foreign key linking to franchise.franchisee. Business justification: Renovation projects are initiated, approved, and funded by the franchisee; linking enables franchise‑level renovation cost reporting and compliance tracking.']
  renovation_approved_by_user_employee_id varchar [note: 'Identifier of the user who approved the renovation project for execution.']
  renovation_employee_id varchar [note: 'Identifier of the user who approved the renovation project for execution.']
  renovation_restaurant_unit_id varchar [note: 'Identifier of the restaurant unit undergoing renovation. Links to the restaurant location being renovated.']
  renovation_unit_id varchar [note: 'Identifier of the restaurant unit undergoing renovation. Links to the restaurant location being renovated.']
  actual_auv_lift_percent decimal(5,2) [note: 'Actual measured percentage increase in Average Unit Volume (AUV) achieved post-renovation, typically measured 6-12 months after completion.']
  actual_capex_usd decimal(15,2) [note: 'Actual total capital expenditure incurred for the renovation project in US dollars.']
  actual_completion_date date [note: 'Actual date when the renovation project was completed and the restaurant was ready for operations.']
  actual_start_date date [note: 'Actual date when the renovation project work commenced.']
  ada_compliance_flag boolean [note: 'Indicates whether the renovation project includes ADA compliance upgrades to meet accessibility requirements.']
  approval_date date [note: 'Date when the renovation project was officially approved for execution.']
  architect_firm_name varchar [note: 'Name of the architectural firm that designed the renovation plans.']
  brand_standard_version varchar [note: 'Version of the brand standards and design guidelines being implemented in this renovation project.']
  budget_variance_usd decimal(15,2) [note: 'Difference between actual and estimated CapEx (actual minus estimated) in US dollars, indicating over or under budget performance.']
  building_permit_number varchar [note: 'Official building permit number issued by local authorities for the renovation work.']
  cancellation_reason varchar [note: 'Explanation for why the renovation project was cancelled, if applicable.']
  closure_duration_days decimal(10,4) [note: 'Number of days the restaurant was closed to customers during the renovation project.']
  contractor_license_number varchar [note: 'State or local license number of the contractor performing the renovation work.']
  contractor_name varchar [note: 'Name of the primary general contractor or construction firm responsible for executing the renovation project.']
  created_timestamp timestamp [note: 'Timestamp when the renovation project record was first created in the system.']
  energy_efficiency_upgrade_flag boolean [note: 'Indicates whether the renovation includes energy efficiency improvements such as LED lighting, HVAC upgrades, or insulation enhancements.']
  estimated_capex_usd decimal(18,2) [note: 'Estimated total capital expenditure budget for the renovation project in US dollars.']
  expected_auv_lift_percent decimal(5,2) [note: 'Expected percentage increase in Average Unit Volume (AUV) following completion of the renovation project.']
  final_inspection_date date [note: 'Date when the final building inspection was completed and the renovation was approved for occupancy.']
  financing_method varchar [note: 'Method used to finance the renovation project (corporate funds, franchise funded, loan, lease, mixed).']
  inspection_status varchar [note: 'Current status of the final building inspection (pending, passed, failed, conditional approval).']
  last_modified_timestamp timestamp [note: 'Timestamp when the renovation project record was last updated in the system.']
  notes varchar [note: 'Additional free-form notes and comments about the renovation project for internal reference.']
  partial_closure_flag boolean [note: 'Indicates whether the restaurant remained partially operational during renovation (True) or was fully closed (False).']
  permit_issue_date date [note: 'Date when the building permit was issued by local authorities.']
  planned_completion_date date [note: 'Originally scheduled date for the renovation project to be completed.']
  planned_start_date date [note: 'Originally scheduled date for the renovation project to begin.']
  project_manager_name varchar [note: 'Name of the internal project manager overseeing the renovation project.']
  project_name varchar [note: 'Descriptive name of the renovation project for easy identification and reporting.']
  project_number varchar [note: 'Externally-known unique business identifier for the renovation project, used for tracking and communication with contractors and stakeholders.']
  project_priority varchar [note: 'Business priority level assigned to the renovation project for resource allocation and scheduling decisions.']
  project_status varchar [note: 'Current lifecycle status of the renovation project (planned, approved, in-progress, completed, cancelled, on-hold).']
  project_type varchar [note: 'Classification of the renovation project type indicating the scope and nature of work (full remodel, refresh, equipment upgrade, ADA retrofit, brand reimaging, expansion).']
  roi_payback_period_months varchar [note: 'Estimated number of months required to recover the renovation investment through increased revenue and operational savings.']
  scope_description varchar [note: 'Detailed description of the renovation scope including specific areas, systems, and improvements included in the project.']
  warranty_expiration_date decimal(10,4) [note: 'Date when the contractor warranty for the renovation work expires.']
  warranty_period_months varchar [note: 'Duration in months of the contractor warranty covering workmanship and materials for the renovation.']

  Note: 'Tracks restaurant unit renovation, remodel, and refresh projects including project type (full remodel, refresh, equipment upgrade, ADA retrofit, brand reimaging), project status (planned, approved, in-progress, completed, cancelled), planned start date, actual start date, planned completion date, actual completion date, estimated CapEx, actual CapEx, contractor name, closure duration (days), and expected AUV lift post-renovation. Coordinates with realestate domain for facility management and finance domain for CapEx tracking.'
}

Table restaurant.ops_visit {
  ops_visit_id varchar [pk, note: 'Unique identifier for the operational field visit record. Primary key.']
  checklist_template_id varchar [note: 'Identifier of the standardized checklist or audit template used during the operational visit to ensure consistent evaluation criteria.']
  ops_employee_id varchar [note: 'Employee identifier of the manager or supervisor who reviewed and approved the operational visit report and findings.']
  ops_restaurant_unit_id varchar [note: 'Identifier of the restaurant unit where the operational visit was conducted.']
  ops_unit_id varchar [note: 'Identifier of the restaurant unit where the operational visit was conducted.']
  primary_ops_visitor_employee_id varchar [note: 'Employee identifier of the individual who conducted the operational visit, linking to the workforce management system.']
  approved_timestamp timestamp [note: 'Date and time when the operational visit report was officially approved by the reviewing manager or supervisor.']
  brand_standard_compliance_status varchar [note: 'Overall assessment of the restaurant units compliance with brand standards and Standard Operating Procedures (SOPs) based on the visit findings.']
  checklist_completion_percentage decimal(5,2) [note: 'Percentage of checklist items completed during the operational visit, indicating thoroughness of the inspection.']
  cleanliness_score decimal(5,2) [note: 'Sub-score assessing the cleanliness and sanitation of Front of House (FOH) and Back of House (BOH) areas, including dining areas, restrooms, and kitchen.']
  corrective_action_due_date date [note: 'Target date by which all corrective actions identified during the visit must be completed and verified.']
  corrective_action_required_flag boolean [note: 'Boolean indicator (True/False) specifying whether corrective actions are required as a result of findings from the operational visit.']
  created_timestamp timestamp [note: 'Date and time when the operational visit record was first created in the source system.']
  critical_findings_count varchar [note: 'Number of critical violations or findings identified during the operational visit that require immediate corrective action.']
  customer_count_observed varchar [note: 'Approximate number of customers served or present during the operational visit, providing context for throughput and service observations.']
  daypart_observed varchar [note: 'The daypart (e.g., breakfast, lunch, dinner, late night) during which the operational visit was conducted, relevant for assessing performance during specific service periods.']
  follow_up_visit_required_flag boolean [note: 'Boolean indicator (True/False) specifying whether a follow-up visit is required to verify corrective action completion.']
  follow_up_visit_scheduled_date date [note: 'Scheduled date for a follow-up operational visit to verify that corrective actions have been implemented and findings have been resolved.']
  food_quality_score decimal(5,2) [note: 'Sub-score evaluating the quality, freshness, preparation, and presentation of food items during the visit.']
  last_modified_timestamp timestamp [note: 'Date and time when the operational visit record was last updated or modified in the source system.']
  non_critical_findings_count varchar [note: 'Number of non-critical observations or minor violations identified during the visit that should be addressed but do not pose immediate risk.']
  overall_visit_score decimal(5,2) [note: 'Composite score representing the overall performance of the restaurant unit during the operational visit, typically on a 0-100 scale.']
  safety_score decimal(5,2) [note: 'Sub-score assessing food safety compliance, Hazard Analysis Critical Control Points (HACCP) adherence, and workplace safety standards during the visit.']
  service_score decimal(5,2) [note: 'Sub-score evaluating the quality of customer service, staff friendliness, order accuracy, and guest interaction during the visit.']
  speed_score decimal(5,2) [note: 'Sub-score measuring the Speed of Service (SOS), ticket time, and throughput efficiency during the visit, benchmarked against brand standards.']
  staff_count_observed varchar [note: 'Number of staff members (Full-Time Equivalent or FTE) observed working during the visit, relevant for labor efficiency and service quality assessment.']
  visit_category varchar [note: 'Broad category of the operational visit indicating whether it is routine, targeted at specific issues, driven by customer complaints, regulatory-mandated, or pre-opening inspection.']
  visit_date date [note: 'The calendar date on which the operational field visit was conducted at the restaurant unit.']
  visit_duration_minutes decimal(10,4) [note: 'Total duration of the operational visit in minutes, calculated from start to end timestamp.']
  visit_end_timestamp timestamp [note: 'The precise date and time when the operational visit concluded, marking the completion of the on-site inspection or audit.']
  visit_notes varchar [note: 'Free-text field capturing detailed observations, comments, recommendations, and contextual information from the operational visit.']
  visit_number varchar [note: 'Business-facing unique identifier for the operational visit, used for tracking and reference in operational compliance systems.']
  visit_priority_level varchar [note: 'Priority classification of the operational visit based on the severity of findings, risk level, or strategic importance of the restaurant unit.']
  visit_start_timestamp timestamp [note: 'The precise date and time when the operational visit began, capturing the start of the on-site inspection or audit.']
  visit_status varchar [note: 'Current lifecycle status of the operational visit indicating whether it is scheduled, in progress, completed, cancelled, or rescheduled.']
  visit_type varchar [note: 'Classification of the operational visit indicating whether it was scheduled, unannounced, a follow-up to previous findings, New Restaurant Opening (NRO) support, compliance audit, or quality inspection.']
  visitor_name varchar [note: 'Full name of the individual who conducted the operational visit, typically an area manager, brand consultant, or corporate operations team member.']
  visitor_role varchar [note: 'Job title or role of the individual who conducted the visit, such as Area Manager, Brand Consultant, Operations Director, or Quality Assurance Specialist.']
  weather_conditions varchar [note: 'Description of weather conditions during the visit, which may impact customer traffic, throughput, and operational performance observations.']

  Note: 'Records operational field visits conducted by area managers, brand consultants, or corporate operations teams at each restaurant unit. Captures visit date, visit type (scheduled, unannounced, follow-up, NRO opening support), visitor name and role, overall visit score, sub-scores by category (food quality, cleanliness, service, speed, safety), critical findings count, corrective actions required flag, and follow-up visit scheduled date. Sourced from Zenput operational compliance platform.'
}

Table restaurant.ops_visit_finding {
  ops_visit_finding_id varchar [pk, note: 'Unique identifier for the operational visit finding record. Primary key.']
  auditor_employee_id varchar [note: 'Employee identifier of the auditor who recorded this finding. Links to workforce management system for auditor credentials and certification tracking.']
  ops_restaurant_unit_id varchar [note: 'Reference to the restaurant unit where this finding was observed. Links to the restaurant product.']
  ops_unit_id varchar [note: 'Reference to the restaurant unit where this finding was observed. Links to the restaurant product.']
  ops_visit_id varchar [note: 'Reference to the parent operational field visit during which this finding was recorded. Links to the ops_visit product.']
  previous_finding_ops_visit_finding_id varchar [note: 'Reference to the ops_visit_finding_id of the prior occurrence if this is a repeat finding. Enables tracking of finding recurrence patterns and corrective action effectiveness.']
  primary_ops_employee_id varchar [note: 'Name of the manager or executive who approved the waiver. Populated only when status is waived. Used for accountability and audit trail.']
  auditor_name varchar [note: 'Name of the field auditor or inspector who recorded this finding during the operational visit. Used for auditor performance tracking and finding validation.']
  brand_standard_code varchar [note: 'Reference code for the specific brand standard or SOP (Standard Operating Procedure) that was violated or not met. Links to the brand standards repository for detailed requirement documentation.']
  brand_standard_name varchar [note: 'Human-readable name of the brand standard or SOP that was violated. Examples: Hand Washing Protocol, Temperature Log Maintenance, Uniform and Appearance Standard, Drive-Thru Speed of Service.']
  corrective_action_completed_flag boolean [note: 'Indicates whether the required corrective action has been completed and verified. True when action is complete and verified; False when pending or in progress.']
  corrective_action_completion_date date [note: 'Actual date when the corrective action was completed and verified. Populated when corrective_action_completed_flag is set to True. Used to calculate resolution time and track overdue items.']
  corrective_action_due_date date [note: 'Target date by which the corrective action must be completed. Set based on severity level: critical findings typically require same-day or next-day resolution, major findings within 7 days, minor findings within 30 days.']
  corrective_action_required boolean [note: 'Detailed description of the corrective action that must be taken to resolve the finding. Specifies what needs to be done, by whom, and any specific requirements or standards that must be met.']
  corrective_action_verification_method varchar [note: 'Method used to verify that the corrective action was completed satisfactorily. Options include on-site inspection by field manager, photographic evidence submitted by unit, document review, manager attestation, or scheduled follow-up visit.']
  created_timestamp timestamp [note: 'Date and time when this finding record was first created in the system. System-generated audit field for data lineage and compliance tracking.']
  escalation_level varchar [note: 'Organizational level to which this finding has been escalated. Unit: handled at restaurant level. Area: escalated to area manager. Region: escalated to regional director. Corporate: escalated to corporate compliance or executive leadership.']
  escalation_required_flag boolean [note: 'Indicates whether this finding requires escalation beyond the restaurant unit level to area management, regional leadership, or corporate compliance. True for critical findings, repeat major findings, or regulatory violations requiring senior leadership notification.']
  financial_impact_usd decimal(15,2) [note: 'Estimated financial impact of the finding in US dollars. May include cost of waste, potential fines, equipment repair costs, or revenue impact from service disruption. Used for prioritization and ROI analysis of corrective actions.']
  finding_category varchar [note: 'High-level classification of the finding type. Categories include food safety (HACCP violations, temperature control), cleanliness (sanitation, hygiene), equipment (maintenance, functionality), service (guest experience, speed of service), brand standard (SOP compliance, visual standards), labor (staffing, scheduling, training), and inventory (stock levels, waste management). [ENUM-REF-CANDIDATE: food_safety|cleanliness|equipment|service|brand_standard|labor|inventory — 7 candidates stripped; promote to reference product]']
  finding_description varchar [note: 'Detailed narrative description of the observed finding. Captures what was observed, where it was observed, and the specific condition or behavior that triggered the finding. Free-text field for auditor notes.']
  finding_sequence_number varchar [note: 'Sequential ordering of findings within the parent visit. Used to maintain the order in which findings were recorded during the field visit.']
  finding_subcategory varchar [note: 'Detailed sub-classification within the finding category. Examples: temperature_control, hand_washing, equipment_calibration, uniform_compliance, waste_tracking. Provides granular segmentation for trend analysis.']
  finding_timestamp timestamp [note: 'Date and time when the finding was observed and recorded during the field visit. Captures the precise moment of observation for time-sensitive findings such as temperature violations or service delays.']
  guest_impact_flag boolean [note: 'Indicates whether this finding has direct impact on guest experience, satisfaction, or safety. True if the finding affects FOH (Front of House) operations, service quality, food safety, or guest-facing brand standards; False if it is purely BOH (Back of House) or administrative.']
  last_modified_timestamp timestamp [note: 'Date and time when this finding record was last updated. System-generated audit field for change tracking and data quality monitoring.']
  notes varchar [note: 'Additional free-text notes, context, or observations related to the finding. May include mitigating circumstances, root cause analysis, or special instructions for corrective action.']
  ops_visit_finding_status varchar [note: 'Current lifecycle status of the finding. Open: newly recorded, awaiting action. In Progress: corrective action underway. Resolved: action completed, awaiting verification. Closed: verified and complete. Waived: finding acknowledged but action waived with justification.']
  photo_evidence_url varchar [note: 'URL or file path to photographic evidence documenting the finding. Used for visual verification, training purposes, and dispute resolution. Links to document management system or cloud storage.']
  regulatory_reference varchar [note: 'Citation of the specific regulatory code, section, or requirement that was violated. Examples: FDA Food Code 3-501.16, OSHA 1910.22, Local Health Code Section 12.4. Populated only when regulatory_violation_flag is True.']
  regulatory_violation_flag boolean [note: 'Indicates whether this finding constitutes a violation of regulatory requirements (FDA, OSHA, local health department). True if the finding violates a legal or regulatory standard; False if it is an internal brand standard deviation only.']
  repeat_finding_flag boolean [note: 'Indicates whether this finding is a repeat of a previously identified issue at this restaurant unit. True if the same or similar finding was recorded in a prior visit; False if this is the first occurrence. Used to identify systemic compliance gaps.']
  repeat_occurrence_count varchar [note: 'Number of times this specific finding has been recorded at this restaurant unit. Incremented each time the same finding is observed in subsequent visits. Used for escalation and intervention triggers.']
  responsible_party_name varchar [note: 'Name of the individual assigned responsibility for completing the corrective action. Typically the restaurant general manager, area manager, or specific department lead depending on the finding category.']
  responsible_party_role varchar [note: 'Job title or role of the individual responsible for the corrective action. Examples: General Manager, Kitchen Manager, Area Manager, Facilities Manager, Training Coordinator.']
  severity_level varchar [note: 'Classification of the finding\'s impact and urgency. Critical: immediate health/safety risk or major brand violation requiring immediate action. Major: significant compliance gap with potential regulatory or brand impact. Minor: deviation from standard with limited impact. Observation: opportunity for improvement without compliance violation.']
  waiver_approval_date date [note: 'Date when the waiver was approved. Populated only when status is waived.']
  waiver_reason varchar [note: 'Justification for waiving the corrective action requirement. Populated only when status is waived. Requires approval from authorized manager and documentation of business rationale.']

  Note: 'Line-item findings recorded during an operational field visit at a restaurant unit. Each record captures the parent visit reference, finding category (food safety, cleanliness, equipment, service, brand standard, labor), finding description, severity level (critical, major, minor, observation), brand standard violated, corrective action required, corrective action due date, corrective action completed flag, and completion date. Enables granular compliance gap tracking and repeat-finding trend analysis.'
}

Table restaurant.unit_ownership {
  unit_ownership_id varchar [pk, note: 'Unique identifier for each unit ownership record. Primary key for the unit ownership history table.']
  primary_restaurant_unit_id varchar [note: 'Reference to the restaurant unit for which this ownership record applies. Links to the restaurant master record.']
  primary_unit_employee_id varchar [note: 'The identifier of the user who created this ownership record. Used for audit trail and accountability.']
  unit_employee_id varchar [note: 'The identifier of the user who created this ownership record. Used for audit trail and accountability.']
  unit_franchise_partner_franchisee_id varchar [note: 'Reference to the franchise partner master record when ownership_type is franchised, licensed, joint_venture, master_franchise, or area_development. Null for company-owned units.']
  unit_franchisee_id varchar [note: 'Reference to the franchise partner master record when ownership_type is franchised, licensed, joint_venture, master_franchise, or area_development. Null for company-owned units.']
  unit_last_modified_by_user_employee_id varchar [note: 'The identifier of the user who last modified this ownership record. Used for audit trail and accountability.']
  area_development_agreement_flag boolean [note: 'Indicates whether this ownership is part of a multi-unit area development agreement. Used for franchise development tracking and compliance reporting.']
  compliance_status varchar [note: 'Current compliance status of this ownership arrangement with franchise agreement terms and brand standards. Used for franchise compliance reporting and risk management.']
  created_timestamp timestamp [note: 'The timestamp when this ownership record was first created in the system. Used for audit trail and data lineage tracking.']
  financial_reporting_entity_code varchar [note: 'The code identifying the financial reporting entity for P&L consolidation. Maps to the ERP system company code or business unit for financial reporting.']
  franchise_agreement_expiration_date decimal(10,4) [note: 'The expiration date of the franchise agreement. Used for renewal planning and compliance tracking.']
  franchise_agreement_number varchar [note: 'The legal agreement number governing this franchise ownership arrangement. Null for company-owned units. Used for compliance tracking and legal reference.']
  franchise_agreement_start_date date [note: 'The start date of the franchise agreement governing this ownership. May differ from ownership_effective_start_date if ownership transferred mid-agreement.']
  initial_franchise_fee_usd decimal(15,2) [note: 'The one-time initial franchise fee paid at the start of this ownership arrangement. Null for company-owned units. Used for revenue recognition and franchise economics analysis.']
  joint_venture_partner_name varchar [note: 'The name of the joint venture partner if ownership_type is joint_venture. Used for partnership management and financial reporting.']
  last_compliance_audit_date date [note: 'The date of the most recent compliance audit for this ownership arrangement. Used for audit scheduling and compliance tracking.']
  last_modified_timestamp timestamp [note: 'The timestamp when this ownership record was last modified. Used for audit trail and change tracking.']
  marketing_fee_percent decimal(5,2) [note: 'The percentage of gross sales contributed to the marketing fund under this ownership arrangement. Used for marketing fund accounting and campaign budget allocation.']
  master_franchise_flag boolean [note: 'Indicates whether this ownership operates under a master franchise arrangement with sub-franchising rights. Used for franchise hierarchy management and royalty flow tracking.']
  next_compliance_audit_due_date date [note: 'The scheduled date for the next compliance audit. Used for audit planning and compliance management.']
  operating_entity_legal_name varchar [note: 'The full legal name of the entity that owns and operates this restaurant unit. Used for legal compliance, tax reporting, and franchise agreement documentation.']
  operating_license_expiration_date decimal(10,4) [note: 'The expiration date of the operating license. Used for renewal tracking and compliance management.']
  operating_license_number varchar [note: 'The business operating license number issued by local authorities for this ownership entity. Used for regulatory compliance and legal documentation.']
  ownership_effective_end_date date [note: 'The date on which this ownership arrangement ended or will end. Null for current active ownership. Used to close out royalty periods and finalize P&L attribution.']
  ownership_effective_start_date date [note: 'The date on which this ownership arrangement became effective. Used to determine royalty calculation periods and P&L attribution windows.']
  ownership_notes varchar [note: 'Free-text notes capturing additional context about this ownership arrangement, including special terms, conditions, or historical information.']
  ownership_percentage decimal(5,2) [note: 'The percentage of ownership stake held by this entity in joint venture arrangements. 100% for sole ownership. Used for P&L attribution and profit distribution.']
  ownership_record_number varchar [note: 'Business-facing unique identifier for this ownership record, used in franchise agreements and legal documentation.']
  ownership_status varchar [note: 'Current lifecycle status of this ownership record. Active indicates current operational ownership; pending indicates ownership transfer in progress; transferred indicates completed ownership change; terminated indicates closure or reversion; suspended indicates temporary operational hold.']
  ownership_transfer_date date [note: 'The date on which ownership was transferred from a previous owner to the current owner. Used for historical tracking and transfer analysis.']
  ownership_type varchar [note: 'Classification of the ownership model for this restaurant unit. Determines royalty calculation, P&L attribution, and compliance reporting requirements.']
  previous_owner_name varchar [note: 'The name of the previous owner if this ownership record represents a transfer or resale. Used for historical tracking and franchise relationship management.']
  royalty_rate_percent decimal(5,2) [note: 'The percentage of gross sales paid as royalty fees under this ownership arrangement. Null for company-owned units. Used for royalty calculation and financial forecasting.']
  tax_identification_number decimal(18,2) [note: 'The tax identification number (EIN, VAT, or equivalent) of the operating entity. Used for tax reporting and regulatory compliance.']
  territory_code varchar [note: 'The geographic territory code assigned to this franchise ownership. Used for territory management, market planning, and franchise compliance.']
  transfer_approval_date date [note: 'The date on which the franchisor approved the ownership transfer. Used for compliance tracking and transfer timeline analysis.']
  transfer_approved_by varchar [note: 'The name or identifier of the franchisor representative who approved the ownership transfer. Used for audit trail and compliance documentation.']
  transfer_reason varchar [note: 'The business reason for this ownership record being created or terminated. Used for franchise compliance reporting, trend analysis, and strategic planning. [ENUM-REF-CANDIDATE: new_franchise_award|resale|corporate_acquisition|refranchising|closure|default|voluntary_termination|expiration — 8 candidates stripped; promote to reference product]']

  Note: 'Tracks the ownership and operational control history of each restaurant unit including ownership type (company-owned, franchised, licensed, joint-venture), franchise partner reference, ownership effective start date, ownership effective end date, transfer reason (new franchise award, resale, corporate acquisition, closure), and operating entity legal name. Provides the authoritative ownership timeline for royalty calculation, P&L attribution, and franchise compliance reporting. Complements the franchise domain without duplicating franchise partner master data.'
}

Table restaurant.performance_period {
  performance_period_id varchar [pk, note: 'Unique identifier for the performance period record. Primary key for the performance period entity.']
  performance_prior_period_id varchar [note: 'Reference to the immediately preceding performance period of the same type. Used for sequential period-over-period trending and variance analysis.']
  performance_prior_year_period_id varchar [note: 'Reference to the corresponding performance period from the prior fiscal year. Used for year-over-year variance analysis and SSS calculations.']
  primary_prior_performance_period_id varchar [note: 'Self-referencing FK on performance_period (prior_performance_period_id)']
  auv_calculation_window_months varchar [note: 'The number of trailing months used to calculate Average Unit Volume (AUV) for this period. Typically 12 months for annual AUV or 3 months for quarterly AUV. Defines the rolling window for revenue averaging.']
  business_day_count varchar [note: 'The number of operating days in this performance period, excluding holidays and closures. Used for calculating business-day-adjusted metrics.']
  calendar_month varchar [note: 'The calendar month number (1-12) in which the period starts. Used for month-over-month trending and seasonality analysis.']
  calendar_quarter varchar [note: 'The calendar quarter number (1-4) in which the period starts. Used for calendar-based quarterly comparisons.']
  calendar_year varchar [note: 'The calendar year in which the period starts. Used for calendar-based reporting and alignment with external benchmarks.']
  comp_sales_eligible_flag boolean [note: 'Indicates whether this period qualifies for comparable sales analysis. Synonymous with SSS eligibility; requires 12+ months of continuous operation for year-over-year performance comparison.']
  created_timestamp timestamp [note: 'The date and time when this performance period record was first created in the system. Used for audit trail and data lineage tracking.']
  day_count varchar [note: 'The total number of calendar days in this performance period. Used for normalizing metrics and calculating daily averages.']
  fiscal_month varchar [note: 'Month number (1‑12) of the fiscal year for the period.']
  fiscal_quarter varchar [note: 'The fiscal quarter number (1-4) within the fiscal year. Used for quarterly performance aggregation and reporting.']
  fiscal_week varchar [note: 'Week number (1‑53) of the fiscal year for the period.']
  fiscal_year varchar [note: 'The fiscal year to which this performance period belongs. Represents the 12-month accounting period used for financial reporting and performance measurement.']
  holiday_flag boolean [note: 'Indicates whether this period contains one or more major holidays that significantly impact restaurant traffic and sales patterns. Used for seasonality adjustments and forecasting.']
  holiday_list varchar [note: 'Comma-separated list of major holidays occurring within this performance period (e.g., \'Thanksgiving, Black Friday\'). Used for detailed seasonality analysis and promotional planning.']
  is_closed boolean [note: 'True when the period has been finalized and no further data edits are allowed.']
  is_current boolean [note: 'Indicates whether this period is the active reporting window.']
  is_leap_year boolean [note: 'Indicates whether the fiscal year for this period is a leap year (366 days). Used for accurate day-count adjustments in financial calculations.']
  last_modified_timestamp timestamp [note: 'The date and time when this performance period record was most recently updated. Used for change tracking and audit compliance.']
  notes varchar [note: 'Free-text field for capturing special circumstances, adjustments, or contextual information about this performance period (e.g., \'System outage on 3/15\', \'Major weather event impacted sales\').']
  performance_period_status varchar [note: 'Current lifecycle status of the period record.']
  period_category varchar [note: 'High‑level business domain the period is primarily used for.']
  period_close_date date [note: 'The date on which the performance period was officially closed for reporting. Represents when preliminary financial and operational results were finalized.']
  period_code varchar [note: 'Business-friendly code used to reference the period in reports and systems.']
  period_duration_days decimal(10,4) [note: 'Number of calendar days covered by the period (derived from start and end dates).']
  period_end_date date [note: 'The last calendar date included in this performance period. Defines the ending boundary for all transactions and metrics captured within this period.']
  period_lock_date date [note: 'The date on which the performance period was locked, preventing any further transactional or adjustment entries. Ensures data integrity for audited financial reporting.']
  period_name varchar [note: 'Human-readable name or label for the performance period (e.g., \'FY2024 Period 3\', \'Q1 2024\', \'Week 12\'). Used for reporting displays and user interfaces.']
  period_number varchar [note: 'Sequential number of the period within the fiscal year (e.g., Period 1, Period 2). Used for ordering and identification of periods within a fiscal year.']
  period_start_date date [note: 'The first calendar date included in this performance period. Defines the beginning boundary for all transactions and metrics captured within this period.']
  period_status varchar [note: 'Current lifecycle status of the performance period. Future indicates the period has not yet started; open indicates the period is in progress and transactions are being recorded; closed indicates the period has ended and preliminary results are available; locked indicates the period is finalized and no further changes are allowed; restated indicates the period has been reopened for corrections or adjustments.']
  period_type varchar [note: 'Classification of the reporting period granularity. Daily for day-level tracking, weekly for 7-day cycles, period for 4-week accounting periods, quarter for 13-week fiscal quarters, and annual for full fiscal year.']
  reporting_currency_code varchar [note: 'The three-letter ISO 4217 currency code used for financial reporting in this period (e.g., USD, EUR, GBP). All monetary metrics for this period are expressed in this currency.']
  seasonality_index decimal(5,2) [note: 'Statistical index representing the expected seasonal variation for this period relative to the annual average (1.00 = average, >1.00 = above average, <1.00 = below average). Used for demand forecasting and labor planning.']
  source_system_record_code varchar [note: 'Native identifier of the period record in the source system.']
  sss_eligible_flag boolean [note: 'Indicates whether this period is eligible for Same-Store Sales (SSS) / Comparable Store Sales (Comp Sales) calculations. True if the period is at least 12 months after the restaurant opening date, enabling year-over-year comparisons.']
  updated_timestamp timestamp [note: 'Date‑time of the most recent modification to the period record.']
  version_number varchar [note: 'Incremental version of the period definition for change‑tracking.']
  week_number varchar [note: 'The ISO week number (1-53) within the calendar year. Used for weekly performance tracking and labor scheduling alignment.']

  Note: 'Master reference table for performance_period. '
}

Table restaurant.pos_terminal {
  pos_terminal_id varchar [pk, note: 'Unique identifier for the POS terminal. Primary key.']
  pos_replacement_terminal_id varchar [note: 'Identifier of the POS terminal that replaced this unit, if applicable.']
  pos_restaurant_unit_id varchar [note: 'Identifier of the restaurant unit to which the terminal is assigned.']
  pos_unit_id varchar [note: 'Identifier of the restaurant unit where this POS terminal is deployed.']
  primary_replaced_pos_terminal_id varchar [note: 'Self-referencing FK on pos_terminal (replaced_pos_terminal_id)']
  assigned_station varchar [note: 'Physical station or service point where the terminal is deployed (e.g., FOH counter, DT window 1, DT window 2, bar, patio, expo).']
  cash_drawer_attached boolean [note: 'Indicates whether a cash drawer is attached to this POS terminal.']
  created_timestamp timestamp [note: 'Timestamp when this POS terminal record was first created in the system.']
  decommission_date date [note: 'Date when the POS terminal was decommissioned and removed from active service.']
  encryption_key_reference varchar [note: 'Identifier of the encryption key used to secure transaction data on the terminal.']
  firmware_version varchar [note: 'Version of the firmware currently running on the terminal.']
  floor_number varchar [note: 'Numeric floor level of the terminal location, useful for multi‑story venues.']
  hardware_model varchar [note: 'Manufacturer model number or designation of the physical POS terminal hardware.']
  installation_date date [note: 'Date when the POS terminal was first installed and commissioned at the restaurant location.']
  ip_address varchar [note: 'Network IP address assigned to the POS terminal for connectivity and remote management.']
  is_active boolean [note: 'Indicates whether the POS terminal is currently active and operational.']
  last_audit_timestamp timestamp [note: 'Timestamp of the most recent compliance or security audit performed on the terminal.']
  last_maintenance_date date [note: 'Date of the most recent maintenance or service performed on the terminal.']
  last_modified_timestamp timestamp [note: 'Timestamp when this POS terminal record was last updated.']
  last_pci_audit_date date [note: 'Date of the most recent PCI DSS compliance audit or assessment for this terminal.']
  last_software_update_date date [note: 'Date of the most recent software update or patch applied to the terminal.']
  location_description varchar [note: 'Free‑form description of where the terminal is situated within the restaurant (e.g., "Front Counter – Station 3").']
  mac_address varchar [note: 'Hardware MAC address of the POS terminal network interface.']
  maintenance_frequency_days varchar [note: 'Scheduled interval in days between routine maintenance activities.']
  manufacturer varchar [note: 'Company that produced the POS terminal hardware.']
  model_number varchar [note: 'Model identifier assigned by the manufacturer.']
  network_type varchar [note: 'Physical or logical network connection type used by the terminal.']
  next_maintenance_due_date date [note: 'Planned date for the next routine maintenance.']
  next_pci_audit_date date [note: 'Scheduled date for the next PCI DSS compliance audit or assessment.']
  next_scheduled_maintenance_date date [note: 'Scheduled date for the next preventive maintenance or service check.']
  notes varchar [note: 'Free-text notes for additional context, special configurations, or operational remarks about the terminal.']
  operational_status decimal(10,4) [note: 'Current lifecycle status of the POS terminal in the restaurant operations.']
  payment_methods_supported varchar [note: 'Comma‑separated list of payment method codes the terminal can accept (e.g., "credit,debit,cash,applepay").']
  payment_processing_capability varchar [note: 'Comma-separated list of payment methods supported by this terminal (e.g., credit, debit, NFC, gift_card, mobile_wallet).']
  payment_processing_vendor varchar [note: 'Name of the third‑party processor handling card authorizations for this terminal.']
  pci_compliance_status varchar [note: 'Current PCI DSS compliance status of the terminal for secure payment processing.']
  pos_terminal_status varchar [note: 'Current lifecycle status of the terminal.']
  printer_attached boolean [note: 'Indicates whether a receipt printer is attached to this POS terminal.']
  security_compliance varchar [note: 'Compliance certification applicable to the terminal\'s payment processing.']
  serial_number varchar [note: 'Manufacturer-assigned serial number for the POS terminal hardware unit.']
  service_channel varchar [note: 'Primary service channel that this terminal supports for order capture and fulfillment.']
  software_version varchar [note: 'Current version of the Oracle MICROS POS software installed on the terminal.']
  station_type varchar [note: 'Classification of the station area: Front of House (FOH), Back of House (BOH), Drive-Thru (DT), kiosk, or mobile.']
  supports_chip boolean [note: 'Indicates whether the terminal can read EMV chip cards.']
  supports_contactless boolean [note: 'Indicates whether the terminal can process contactless (NFC) payments.']
  supports_credit_card boolean [note: 'Indicates whether the terminal can process credit card payments.']
  supports_debit_card boolean [note: 'Indicates whether the terminal can process debit card payments.']
  supports_gift_card boolean [note: 'Indicates whether the terminal can process gift card payments.']
  supports_magstripe boolean [note: 'Indicates whether the terminal can read magnetic stripe cards.']
  supports_mobile_wallet boolean [note: 'Indicates whether the terminal supports mobile wallet payments.']
  supports_nfc boolean [note: 'Indicates whether the terminal supports contactless NFC payments (e.g., Apple Pay, Google Pay).']
  supports_olo boolean [note: 'Indicates whether the terminal can process online orders placed through digital channels.']
  supports_qr boolean [note: 'Indicates whether the terminal can scan QR codes for payment or ordering.']
  supports_third_party_delivery boolean [note: 'Indicates whether the terminal can process orders from third-party delivery platforms.']
  terminal_code varchar [note: 'Business identifier or asset tag used in inventory and reporting.']
  terminal_currency_code varchar [note: 'ISO 4217 currency code used for transactions processed by this terminal.']
  terminal_name varchar [note: 'Human‑readable name assigned to the terminal for operational identification.']
  terminal_number varchar [note: 'Business-facing terminal number or code used for operational identification and reporting.']
  terminal_type varchar [note: 'Classification of the POS terminal by its operational role and form factor.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the terminal record.']
  warranty_expiration_date decimal(10,4) [note: 'Date when the manufacturer warranty for the POS terminal hardware expires.']
  zone varchar [note: 'Area of the restaurant where the terminal operates.']

  Note: 'Master reference table for pos_terminal. Referenced by: loyalty.offer_redemption.pos_terminal_id, loyalty.payment_method_link.pos_terminal_id, loyalty.redemption.pos_terminal_id, loyalty.visit.pos_terminal_id, order.drive_thru_event.pos_terminal_id'
}

Table restaurant.store_campaign_assignment {
  store_campaign_assignment_id varchar [pk, note: 'Primary key for the store_campaign_assignment association']
  campaign_id varchar [note: 'Foreign key linking to the marketing campaign']
  store_restaurant_unit_id varchar
  store_sponsor_restaurant_unit_id varchar [note: 'Identifier of the sponsoring restaurant (if applicable)']
  store_unit_id varchar [note: 'Foreign key linking to the restaurant unit']
  actual_adt_lift_percent decimal [note: 'Measured lift in average daily transactions']
  actual_comp_sales_lift_percent decimal [note: 'Measured lift in comparable store sales']
  actual_spend decimal [note: 'Actual spend recorded for the unit on this campaign']
  approval_date date [note: 'Date when the assignment was approved']
  approval_status varchar [note: 'Approval status of the unit\'s participation']
  approved_by varchar [note: 'Name of approver for the unit\'s campaign assignment']
  assignment_status varchar
  channel varchar [note: 'Marketing channel(s) used for the unit']
  compliance_flag boolean [note: 'Indicates whether the unit complies with campaign guidelines']
  created_timestamp timestamp [note: 'Record created']
  effective_end_date date
  effective_start_date date
  end_date date [note: 'Planned end date of the campaign for the unit']
  execution_end_date date [note: 'Actual execution end date at the unit']
  execution_start_date date [note: 'Actual execution start date at the unit']
  expected_adt_lift_percent decimal [note: 'Planned lift in average daily transactions']
  expected_comp_sales_lift_percent decimal [note: 'Planned lift in comparable store sales']
  initiative_code varchar [note: 'Business code for the initiative']
  initiative_name varchar [note: 'Name of the initiative linking unit and campaign']
  lmf_fund_amount decimal [note: 'Local marketing fund amount allocated']
  lmf_fund_used decimal [note: 'Local marketing fund amount used']
  lmf_remaining_amount decimal [note: 'Remaining local marketing fund amount']
  market_dma varchar [note: 'Designated market DMA for the unit in this campaign']
  notes varchar [note: 'Free‑form notes about the unit\'s campaign execution']
  planned_spend decimal(18,2) [note: 'Budgeted spend for the unit on this campaign']
  start_date date [note: 'Planned start date of the campaign for the unit']
  store_campaign_assignment_status varchar [note: 'Current status of the unit\'s participation in the campaign']
  target_audience varchar [note: 'Target guest segment for the unit']
  updated_timestamp timestamp

  Note: 'Represents the assignment of a marketing campaign to a specific restaurant unit. Each record captures spend, performance, compliance, and other campaign‑specific attributes that exist only in the context of that unit‑campaign pairing.. Existence Justification: A restaurant unit can participate in multiple marketing campaigns, and each campaign is executed across many units. The business actively tracks per‑unit spend, performance metrics, compliance flags, and other campaign‑specific details, making the relationship a managed entity rather than a simple reference.'
}

Table restaurant.kitchen_station {
  kitchen_station_id varchar [pk, note: 'Primary key for kitchen_station']
  employee_id varchar [note: 'Identifier of the employee responsible for the station.']
  equipment_asset_id varchar
  kitchen_restaurant_unit_id varchar
  kitchen_unit_id varchar [note: 'Foreign key linking to restaurant.unit. Business justification: Kitchen stations belong to a specific restaurant unit; adding unit_id creates the necessary parent link and eliminates isolation.']
  location_profile_id varchar [note: 'Reference to the restaurant location where the station resides.']
  upstream_kitchen_station_id varchar [note: 'Self-referencing FK on kitchen_station (upstream_kitchen_station_id)']
  area_sqft decimal(8,2) [note: 'Physical floor area occupied by the station.']
  average_ticket_time_seconds varchar [note: 'Average time a ticket spends at this station.']
  capacity_dishes varchar [note: 'Maximum number of dishes the station can handle concurrently.']
  created_timestamp timestamp [note: 'Record created']
  daypart_schedule varchar [note: 'Meal periods during which the station is active.']
  effective_from date [note: 'Date when the station became operational.']
  effective_until date [note: 'Date when the station is scheduled to be retired or decommissioned (null if open‑ended).']
  equipment_list varchar [note: 'Comma‑separated list of major equipment assigned to the station.']
  health_inspection_date date [note: 'Date of the most recent health inspection.']
  health_inspection_status varchar [note: 'Result of the most recent health inspection for the station.']
  is_active boolean [note: 'Active flag']
  is_automated boolean [note: 'Indicates whether the station includes automated equipment.']
  kds_screen_count varchar
  kds_screen_number varchar [note: 'KDS screen']
  kds_screen_reference varchar
  kitchen_station_status varchar [note: 'Current operational status of the station.']
  last_maintenance_date date [note: 'Date when the station last underwent preventive maintenance.']
  last_modified_timestamp timestamp
  maintenance_interval_days varchar [note: 'Scheduled number of days between routine maintenance events.']
  max_capacity_orders_per_hour varchar
  notes varchar
  operational_hours decimal(18,6) [note: 'Standard daily operating window (e.g., "08:00-22:00").']
  power_rating_kw decimal(10,2) [note: 'Maximum electrical power consumption of the station.']
  record_audit_created timestamp [note: 'Timestamp when the kitchen station record was first created.']
  record_audit_updated timestamp [note: 'Timestamp of the most recent update to the kitchen station record.']
  routing_priority varchar
  speed_of_service_sos_seconds varchar [note: 'Target time in seconds to complete a dish at this station.']
  staffing_requirement varchar
  station_code varchar [note: 'Business identifier code used in operational systems and SOPs.']
  station_name varchar [note: 'Human‑readable name of the kitchen station (e.g., "Grill Station 1").']
  station_status varchar
  station_type varchar [note: 'Category of the station based on function (e.g., prep, cook, plating).']
  target_prep_time_seconds varchar
  temperature_control boolean [note: 'Indicates if the station has temperature‑control capabilities.']
  temperature_range_c varchar [note: 'Allowed temperature range for the station (e.g., "0-5").']
  temperature_zone varchar
  throughput_per_hour varchar [note: 'Average number of dishes processed by the station each hour.']
  updated_timestamp timestamp

  Note: 'Master reference table for kitchen_station. Referenced by station_id.'
}

Table restaurant.brand {
  brand_id varchar [pk, note: 'Primary key for brand']
  legal_entity_id varchar
  parent_brand_id varchar [note: 'Identifier of the parent brand in a brand hierarchy, if applicable.']
  average_annual_sales_usd decimal(15,2) [note: 'Typical yearly sales revenue per brand unit, expressed in US dollars.']
  average_check_amount_usd decimal(10,2) [note: 'Typical spend per guest (average ticket) in US dollars.']
  average_daily_customers varchar [note: 'Mean number of guests served per day across brand locations.']
  average_employee_count varchar [note: 'Typical number of staff employed per restaurant for the brand.']
  average_store_size_sqft decimal(10,2) [note: 'Mean square‑footage of restaurants operating under the brand.']
  brand_category varchar [note: 'High‑level category describing the brand\'s product focus.']
  brand_code varchar [note: 'External alphanumeric code used to reference the brand in corporate systems.']
  brand_description varchar [note: 'Narrative description of the brand\'s positioning and concept.']
  brand_name varchar [note: 'Human‑readable name of the brand.']
  brand_segment varchar [note: 'Target consumer segment for the brand.']
  brand_status varchar [note: 'Current lifecycle state of the brand.']
  brand_type varchar [note: 'Classification of the brand by service format.']
  color_hex varchar [note: 'Hexadecimal representation of the brand\'s primary color.']
  company_owned_unit_count varchar
  concept_type varchar
  created_timestamp timestamp [note: 'Date‑time when the brand record was first created in the system.']
  cuisine_type varchar
  established_date date [note: 'Date the brand was first launched.']
  founded_date date [note: 'Founded date']
  franchise_allowed boolean [note: 'Indicates whether the brand is offered as a franchise model.']
  franchise_fee_percent decimal(5,2) [note: 'Initial franchise fee expressed as a percent of initial investment.']
  franchise_unit_count varchar
  headquarters_city varchar [note: 'City where the brand\'s corporate headquarters is located.']
  headquarters_country_code varchar [note: 'Three‑letter ISO country code of the brand\'s headquarters.']
  headquarters_location varchar [note: 'HQ location']
  is_active boolean [note: 'Active flag']
  last_modified_timestamp timestamp
  launch_date date
  logo_url varchar [note: 'Link to the brand\'s primary logo image.']
  market_share_percent decimal(5,2) [note: 'Estimated share of the market segment held by the brand.']
  notes varchar
  parent_company varchar [note: 'Parent company']
  parent_company_name varchar
  positioning_segment varchar
  primary_market_region varchar [note: 'Geographic region where the brand has its strongest presence.']
  royalty_fee_percent decimal(5,2) [note: 'Ongoing royalty fee charged to franchisees, expressed as a percent of sales.']
  segment varchar
  service_model varchar
  social_media_handle varchar [note: 'Primary social media identifier (e.g., @brand) used for marketing.']
  sos_target_seconds varchar [note: 'Targeted service time from order to delivery for the brand.']
  tagline varchar [note: 'Short marketing slogan associated with the brand.']
  total_unit_count varchar
  updated_timestamp timestamp [note: 'Date‑time of the most recent modification to the brand record.']
  website_url varchar [note: 'Public website address for the brand.']

  Note: 'Master reference table for brand. Referenced by brand_id.'
}

Table restaurant.department {
  department_id varchar [pk, note: 'Primary key for department']
  cost_center_id varchar
  franchisee_id varchar [note: 'Identifier of the franchise to which the department belongs (null for company‑owned).']
  parent_department_id varchar [note: 'Identifier of the immediate parent department in the organizational hierarchy.']
  address_line1 varchar [note: 'Primary street address of the department.']
  address_line2 varchar [note: 'Secondary address information (suite, floor, etc.).']
  area_sqft decimal(10,2) [note: 'Square‑footage occupied by the department.']
  average_service_time_minutes varchar [note: 'Average time in minutes to complete a core service task for the department.']
  budget_amount decimal(12,2) [note: 'Annual budget allocated to the department (in USD).']
  city varchar [note: 'City in which the department is situated.']
  classification varchar [note: 'Higher‑level classification used for reporting and cost allocation.']
  closing_date date [note: 'Date the department was closed (null if still operating).']
  country_code varchar [note: 'ISO 3166‑1 alpha‑3 country code where the department is located.']
  created_timestamp timestamp [note: 'Timestamp when the department record was first created in the system.']
  department_code varchar [note: 'Business‑assigned short code that uniquely identifies the department within the enterprise.']
  department_description varchar [note: 'Free‑form text describing the department\'s purpose and responsibilities.']
  department_name varchar [note: 'Human‑readable name of the department.']
  department_status varchar [note: 'Current lifecycle status of the department.']
  department_type varchar [note: 'Categorizes the department by its functional area.']
  effective_date date
  effective_from date [note: 'Date when the department became operational.']
  effective_until date [note: 'Date when the department ceased operation (null if still active).']
  email varchar [note: 'Primary email address for department communications.']
  end_date date
  floor_number varchar [note: 'Physical floor on which the department is located.']
  headcount varchar [note: 'Number of full‑time equivalent staff assigned to the department.']
  is_active boolean [note: 'Active flag']
  is_franchise boolean [note: 'True if the department belongs to a franchised unit.']
  is_primary boolean [note: 'Indicates whether this department is the primary unit for its location.']
  last_modified_timestamp timestamp
  manager_name varchar
  notes varchar
  opening_date date [note: 'Date the department first opened for business.']
  operational_hours decimal(18,6) [note: 'Standard daily operating hours expressed as HH:MM‑HH:MM.']
  phone_number varchar [note: 'Primary contact telephone number for the department.']
  postal_code varchar [note: 'Postal code for the department\'s address.']
  region_code varchar [note: 'Three‑letter code representing the geographic region.']
  service_level varchar [note: 'Level of service the department is expected to deliver.']
  shift_schedule varchar [note: 'Primary shift schedule pattern used by the department.']
  turnover_rate decimal(5,2) [note: 'Annual percentage of staff turnover in the department.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the department record.']

  Note: 'Organizational departments within a restaurant unit (kitchen, front-of-house, drive-thru); used for operational management.'
}

Table restaurant.checklist_template {
  checklist_template_id varchar [pk, note: 'Primary key for checklist_template']
  brand_id varchar
  parent_checklist_template_id varchar [note: 'Self-referencing FK on checklist_template (parent_checklist_template_id)']
  applicable_format varchar
  applicable_restaurant_type varchar [note: 'Restaurant format(s) for which the checklist is intended.']
  approval_required boolean [note: 'True if the checklist must be approved before use.']
  checklist_template_code varchar [note: 'Business identifier or code used to reference the template in operational systems.']
  checklist_template_description varchar [note: 'Detailed free‑text description of the template purpose and scope.']
  checklist_template_name varchar [note: 'Human‑readable name of the checklist template.']
  checklist_template_status varchar [note: 'Current lifecycle status of the template.']
  checklist_template_type varchar [note: 'Category that defines the purpose of the checklist (e.g., safety, training).']
  created_timestamp timestamp [note: 'Date‑time when the template record was first created.']
  duration_minutes decimal(10,4) [note: 'Typical time required to complete the checklist, in minutes.']
  effective_date date [note: 'Effective date']
  effective_from date [note: 'Date when the checklist template becomes effective for use.']
  effective_until date [note: 'Date when the checklist template expires or is superseded (null if open‑ended).']
  expiration_date decimal(10,4)
  frequency varchar [note: 'How often the checklist should be executed.']
  is_active boolean [note: 'Active flag']
  is_mandatory boolean [note: 'Indicates whether completion of the checklist is mandatory.']
  item_count varchar [note: 'Number of items']
  language varchar [note: 'ISO 639‑1 language code of the template content.']
  last_modified_timestamp timestamp
  last_reviewed_timestamp timestamp [note: 'Date‑time when the template was last reviewed.']
  max_score decimal(9,4)
  notes varchar
  owner_role varchar [note: 'Organizational role responsible for maintaining the template (e.g., Operations Manager).']
  passing_score decimal(9,4)
  region varchar [note: 'Three‑letter ISO country/region code where the template is applicable.']
  review_cycle varchar [note: 'Scheduled interval for formal review of the template.']
  template_category varchar
  template_code varchar [note: 'Template code']
  template_description varchar [note: 'Description']
  template_file_path varchar [note: 'File system or storage path where the template document resides.']
  template_format varchar [note: 'File format of the stored template.']
  template_name varchar [note: 'Template name']
  template_status varchar
  template_type varchar [note: 'Template type']
  template_version varchar
  updated_timestamp timestamp [note: 'Date‑time of the most recent update to the template record.']
  version varchar [note: 'Version identifier for change control (e.g., v1.2).']
  version_number varchar
  created_by varchar

  Note: 'Master reference table for checklist_template. Referenced by checklist_template_id.'
}

Table workforce.employee {
  employee_id varchar [pk, note: 'Unique system-generated identifier for each employee.']
  employee_restaurant_unit_id varchar [note: 'Primary restaurant location to which the employee is assigned.']
  employee_unit_id varchar [note: 'Primary restaurant location to which the employee is assigned.']
  employee_work_location_unit_id varchar [note: 'Specific work site (e.g., kitchen, dining area) within the restaurant.']
  facility_id varchar [note: 'Specific work site (e.g., kitchen, dining area) within the restaurant.']
  manager_employee_id varchar [note: 'Identifier of the employee\'s direct manager.']
  address_line1 varchar [note: 'Primary street address of the employee\'s residence.']
  address_line2 varchar [note: 'Secondary address information (apartment, suite, etc.).']
  bank_account_number varchar [note: 'Bank account number used for direct deposit of payroll.']
  city varchar [note: 'City of the employee\'s residence.']
  country varchar [note: 'Three‑letter ISO country code of the employee\'s residence. [ENUM-REF-CANDIDATE: USA|CAN|MEX|GBR|FRA|DEU|JPN|CHN — 8 candidates stripped; promote to reference product]']
  date_of_birth date [note: 'Birth date of the employee, used for age‑based compliance and benefits.']
  department varchar [note: 'Organizational department or functional group.']
  email varchar [note: 'Primary email address used for employee communications.']
  emergency_contact_name varchar [note: 'Name of the person to contact in case of emergency.']
  emergency_contact_phone varchar [note: 'Phone number of the emergency contact.']
  employment_status varchar [note: 'Current lifecycle status of the employee within the organization.']
  employment_type varchar [note: 'Classification of employment relationship (Full‑Time, Part‑Time, Contractor).']
  first_name varchar [note: 'Legal first name of the employee.']
  full_name varchar [note: 'Concatenated first and last name for display purposes.']
  hire_date date [note: 'Date the employee started employment with the company.']
  job_title varchar [note: 'Official title or position held by the employee.']
  labor_percentage_target decimal(5,2) [note: 'Target labor cost as a percentage of sales for the employee\'s role.']
  last_name varchar [note: 'Legal last name of the employee.']
  overtime_eligible boolean [note: 'Indicates if the employee is eligible for overtime pay.']
  pay_grade decimal(18,2) [note: 'Internal pay grade code used for compensation planning.']
  phone_number varchar [note: 'Primary contact phone number for the employee.']
  postal_code varchar [note: 'Postal or ZIP code of the employee\'s residence.']
  record_audit_created timestamp [note: 'Timestamp when the employee record was first created in the system.']
  record_audit_updated timestamp [note: 'Timestamp of the most recent update to the employee record.']
  role_classification varchar [note: 'Primary functional area where the employee works: Back‑of‑House, Front‑of‑House, Administrative, Support.']
  salary_amount decimal(12,2) [note: 'Annual base salary amount before bonuses or overtime.']
  salary_currency varchar [note: 'Three‑letter ISO currency code for the salary amount.']
  servsafe_certified boolean [note: 'Indicates whether the employee holds a valid ServSafe food safety certification.']
  servsafe_expiration_date decimal(10,4) [note: 'Expiration date of the employee\'s ServSafe certification.']
  shift_pattern varchar [note: 'Standard shift pattern assigned to the employee.']
  state varchar [note: 'State or province of the employee\'s residence.']
  tax_identifier decimal(18,2) [note: 'Government‑issued tax identification number (e.g., SSN, SIN).']
  termination_date date [note: 'Date the employee\'s employment ended, if applicable.']
  union_member boolean [note: 'True if the employee is a member of a labor union.']
  work_schedule_type varchar [note: 'Scheduling model applied to the employee.']

  Note: 'Master record for every restaurant employee across company-owned and franchised locations. Captures full employee lifecycle data including personal details, employment type (FTE/PTE), BOH/FOH role classification, hire date, termination date, employment status, pay grade, home restaurant assignment, Workday HCM employee ID, declared availability windows (preferred dayparts, max weekly hours, blackout dates, cross-location availability), and current benefit enrollment summary. Single source of truth for workforce identity and worker profile across the enterprise.'
}

Table workforce.position {
  position_id varchar [pk, note: 'System-generated unique identifier for the job position.']
  reports_to_position_id varchar [note: 'Identifier of the supervisory position to which this role reports.']
  classification varchar [note: 'Primary classification indicating whether the role is Back‑of‑House (BOH), Front‑of‑House (FOH), or Support.']
  created_timestamp timestamp [note: 'Timestamp when the position record was first created.']
  department varchar [note: 'Organizational department to which the position belongs (e.g., Kitchen, Service, Maintenance).']
  effective_end_date date [note: 'Date when the position is retired or no longer available (nullable).']
  effective_start_date date [note: 'Date when the position becomes active for hiring.']
  flsa_exempt boolean [note: 'True if the position is exempt from Fair Labor Standards Act overtime rules.']
  fte_equivalency decimal(5,2) [note: 'Full‑time equivalent factor used for labor forecasting (e.g., 1.0 = full‑time, 0.5 = half‑time).']
  hourly_rate decimal(10,2) [note: 'Base hourly compensation for hourly‑paid positions.']
  is_manager boolean [note: 'True if the position includes managerial responsibilities.']
  labor_percentage_target decimal(5,2) [note: 'Target labor cost as a percentage of sales for this position.']
  minimum_age varchar [note: 'Minimum legal age required to be eligible for the position.']
  overtime_eligible boolean [note: 'Indicates whether the position is eligible for overtime pay.']
  pay_band decimal(18,2) [note: 'Compensation band used for salary or hourly rate determination.']
  position_code varchar [note: 'Business identifier code used to reference the position in HR and scheduling systems.']
  position_description varchar [note: 'Detailed description of duties, responsibilities, and scope of the position.']
  position_level varchar [note: 'Career level of the position within the organization hierarchy.']
  position_status varchar [note: 'Current lifecycle status of the position.']
  required_certifications varchar [note: 'Comma‑separated list of mandatory certifications (e.g., ServSafe, Food Handler).']
  required_experience_years varchar [note: 'Minimum years of relevant experience required for the position.']
  salary_max decimal(10,2) [note: 'Upper bound of the annual salary range for salaried positions.']
  salary_min decimal(10,2) [note: 'Lower bound of the annual salary range for salaried positions.']
  shift_type varchar [note: 'Typical shift pattern associated with the position.']
  title varchar [note: 'Human‑readable name of the job position (e.g., Crew Member, Shift Lead).']
  union_eligible boolean [note: 'Indicates whether the position is eligible for union representation.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the position record.']

  Note: 'Defines authorized job positions within the restaurant organization, including role title (e.g., Crew Member, Shift Lead, Kitchen Manager, FOH Supervisor), BOH/FOH classification, pay band, FLSA exemption status, required certifications (e.g., ServSafe), FTE equivalency factor, and whether the position is eligible for overtime. Serves as the job catalog for workforce planning and scheduling.'
}

Table workforce.shift {
  shift_id varchar [pk, note: 'Unique identifier for the shift record.']
  employee_id varchar [note: 'Identifier of the user who scheduled the shift.']
  facility_id varchar [note: 'Restaurant location where the shift occurs.']
  primary_shift_employee_id varchar [note: 'Identifier of the employee assigned to the shift.']
  unit_id varchar [note: 'Restaurant location where the shift occurs.']
  actual_end timestamp [note: 'Actual clock‑out timestamp recorded for the shift.']
  actual_hours decimal(5,2) [note: 'Actual worked hours for the shift (excluding breaks).']
  actual_start timestamp [note: 'Actual clock‑in timestamp recorded for the shift.']
  break_duration_minutes decimal(10,4) [note: 'Total break time in minutes allocated for the shift.']
  created_timestamp timestamp [note: 'Timestamp when the shift record was created.']
  daypart varchar [note: 'Part of the day the shift is scheduled for.']
  is_deleted boolean [note: 'Flag indicating soft deletion of the shift record.']
  labor_cost decimal(12,2) [note: 'Total labor cost for the shift (rate multiplied by actual hours).']
  labor_percentage decimal(5,2) [note: 'Labor cost expressed as a percentage of projected sales for the shift.']
  labor_rate_currency_code decimal(18,6) [note: 'Three‑letter ISO currency code for the labor rate.']
  labor_rate_per_hour decimal(8,2) [note: 'Pay rate per hour for the employee on this shift.']
  notes varchar [note: 'Free‑form notes or comments about the shift.']
  on_call_flag boolean [note: 'Indicates if the shift is an on‑call assignment.']
  overtime_flag boolean [note: 'Indicates if the shift includes overtime hours.']
  scheduled_end timestamp [note: 'Planned end timestamp of the shift.']
  scheduled_hours decimal(5,2) [note: 'Planned shift duration in hours (excluding breaks).']
  scheduled_start timestamp [note: 'Planned start timestamp of the shift.']
  shift_code varchar [note: 'Human‑readable code for the shift (e.g., SHIFT20230915-001).']
  shift_date date [note: 'Calendar date of the shift (derived from scheduled_start).']
  shift_status varchar [note: 'Current lifecycle status of the shift.']
  shift_type varchar [note: 'Classification of the shift (e.g., regular, overtime, on‑call, training).']
  station varchar [note: 'Work station or area assigned to the employee (Back‑of‑House, Front‑of‑House, etc.).']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the shift record.']

  Note: 'Represents a scheduled work shift for an employee at a specific restaurant location, daypart (breakfast, lunch, dinner, late-night), and station assignment (grill, fry, drive-thru, expo, host, bar, dish). Captures planned start/end times, actual clock-in/clock-out times, assigned BOH/FOH station, shift type (regular, overtime, on-call, training), break duration, scheduling source (Planday), and swap/coverage details (original assignee, covering employee, swap request reason, swap approval status, approval timestamp) when shift reassignment occurs. Core operational record for labor deployment, station coverage planning, Speed of Service (SOS) staffing optimization, and Planday shift coverage workflows.'
}

Table workforce.schedule {
  schedule_id varchar [pk, note: 'Unique system-generated identifier for each labor schedule.']
  schedule_employee_id varchar [note: 'Unique identifier of the manager or supervisor who approved the schedule.']
  schedule_manager_employee_id varchar [note: 'Unique identifier of the manager or supervisor who approved the schedule.']
  schedule_restaurant_unit_id varchar [note: 'Unique identifier of the restaurant unit for which the schedule is created.']
  approval_timestamp timestamp [note: 'Date‑time when the schedule was formally approved by the manager.']
  approved_by varchar [note: 'Display name of the manager who approved the schedule.']
  created_timestamp timestamp [note: 'Date‑time when the schedule record was first created in the system.']
  daypart_schedule_notes varchar [note: 'Optional comments or special instructions for each daypart (e.g., event staffing, overtime alerts).']
  fte_evening decimal(5,2) [note: 'Planned full‑time equivalent staff for the evening shift (e.g., 16:00‑22:00).']
  fte_midday decimal(5,2) [note: 'Planned full‑time equivalent staff for the midday shift (e.g., 12:00‑16:00).']
  fte_morning decimal(5,2) [note: 'Planned full‑time equivalent staff for the morning shift (e.g., 06:00‑12:00).']
  fte_night decimal(5,2) [note: 'Planned full‑time equivalent staff for the night shift (e.g., 22:00‑02:00).']
  fte_total decimal(5,2) [note: 'Sum of planned FTEs across all dayparts for the schedule period.']
  labor_pct_evening decimal(5,2) [note: 'Target labor cost as a percentage of sales for the evening shift.']
  labor_pct_midday decimal(5,2) [note: 'Target labor cost as a percentage of sales for the midday shift.']
  labor_pct_morning decimal(5,2) [note: 'Target labor cost as a percentage of sales for the morning shift.']
  labor_pct_night decimal(5,2) [note: 'Target labor cost as a percentage of sales for the night shift.']
  labor_percentage decimal(5,2) [note: 'Target labor cost expressed as a percentage of projected sales for the period.']
  period_end_date date [note: 'Last calendar date covered by the schedule.']
  period_start_date date [note: 'First calendar date covered by the schedule.']
  schedule_number varchar [note: 'Human‑readable schedule code assigned by the scheduling system (e.g., SCHED‑2024‑W15).']
  schedule_status varchar [note: 'Current lifecycle state of the schedule: draft (editable), published (visible to staff), or locked (finalized).']
  total_scheduled_hours decimal(6,2) [note: 'Aggregate number of labor hours planned across all dayparts and positions for the schedule period.']
  updated_timestamp timestamp [note: 'Date‑time of the most recent modification to the schedule.']
  version varchar [note: 'Incremental version of the schedule used for audit and rollback purposes.']

  Note: 'Weekly or period-level labor schedule published for a restaurant location, representing the planned staffing plan across all dayparts. Captures schedule period (start/end dates), restaurant unit, total scheduled hours, scheduled Labor%, FTE count by daypart, publication status (draft/published/locked), and the manager who approved the schedule. Links to individual shifts for granular staffing detail.'
}

Table workforce.time_entry {
  time_entry_id varchar [pk, note: 'Unique surrogate key for the time entry record.']
  primary_time_employee_id varchar [note: 'Identifier of the employee who performed the time entry.']
  shift_id varchar [note: 'Identifier of the scheduled shift associated with this time entry.']
  time_employee_id varchar [note: 'Identifier of the manager who performed the approval.']
  unit_id varchar [note: 'Identifier of the restaurant location where the work was performed.']
  approved_by_manager boolean [note: 'True when a manager has approved the time entry.']
  approved_timestamp timestamp [note: 'Date‑time when the entry was approved by a manager.']
  break_flag boolean [note: 'True if a break was taken during the shift.']
  break_minutes varchar [note: 'Total minutes taken for breaks during the shift.']
  clock_in_timestamp timestamp [note: 'Exact date‑time when the employee clocked in.']
  clock_out_timestamp timestamp [note: 'Exact date‑time when the employee clocked out.']
  created_timestamp timestamp [note: 'Timestamp when the time entry record was first created.']
  entry_number varchar [note: 'Human‑readable unique code for the time entry.']
  job_role varchar [note: 'Functional role of the employee during the shift.']
  labor_cost decimal(12,2) [note: 'Monetary cost of the labor for this entry (total_hours * labor_rate).']
  labor_rate decimal(8,4) [note: 'Hourly wage rate applicable to the employee for this entry (in local currency).']
  missed_punch_flag boolean [note: 'True if the employee missed a clock‑in or clock‑out punch.']
  notes varchar [note: 'Optional free‑form comments or remarks about the time entry.']
  overtime_flag boolean [note: 'True if any overtime hours were recorded.']
  overtime_hours decimal(5,2) [note: 'Number of overtime hours worked.']
  pay_code decimal(18,2) [note: 'Payroll code indicating the type of pay (regular, overtime, sick leave, etc.).']
  regular_hours decimal(5,2) [note: 'Number of non‑overtime hours worked.']
  scheduled_end_timestamp timestamp [note: 'Planned end date‑time of the shift according to the schedule.']
  scheduled_start_timestamp timestamp [note: 'Planned start date‑time of the shift according to the schedule.']
  time_entry_status varchar [note: 'Current lifecycle status of the time entry.']
  time_entry_type varchar [note: 'Method by which the time entry was recorded.']
  total_hours decimal(5,2) [note: 'Total number of hours (including overtime and breaks) recorded for the entry.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to the time entry.']
  work_date date [note: 'Calendar date on which the shift occurred.']

  Note: 'Captures actual clock-in and clock-out events for each employee per shift, sourced from Workday HCM time tracking or POS-integrated time clocks. Records regular hours, overtime hours, break time, missed punch flags, and manager approval status. Foundation for payroll processing, Labor% calculation, and compliance with FLSA/OSHA labor regulations.'
}

Table workforce.labor_forecast {
  labor_forecast_id varchar [pk, note: 'Unique identifier for the labor forecast record. _canonical_skip_reason: Entity does not fit standard role categories; treated as OTHER.']
  labor_restaurant_unit_id varchar [note: 'Identifier of the restaurant location for which the labor forecast is generated.']
  confidence_score decimal(5,2) [note: 'Statistical confidence level (0‑100) of the forecast output.']
  currency_code varchar [note: 'Three‑letter ISO currency code for monetary values.']
  daypart varchar [note: 'Time segment of the day for which labor is forecasted.']
  expected_adt varchar [note: 'Projected average daily transaction count for the forecast period.']
  expected_atc varchar [note: 'Projected average number of items per transaction for the forecast period.']
  forecast_created_timestamp timestamp [note: 'Timestamp when the forecast record was initially created.']
  forecast_date date [note: 'The calendar date for which the labor forecast applies.']
  forecast_updated_timestamp timestamp [note: 'Timestamp of the most recent update to the forecast record.']
  labor_cost_estimate decimal(12,2) [note: 'Estimated total labor cost (in currency) for the forecast period.']
  labor_forecast_status varchar [note: 'Current lifecycle status of the forecast record.']
  lto_flag boolean [note: 'Indicates whether a Limited Time Offer (LTO) is scheduled for the forecast period.']
  model_version varchar [note: 'Version identifier of the forecasting model used to generate the forecast.']
  notes varchar [note: 'Free‑form comments or observations about the forecast.']
  projected_cover_count varchar [note: 'Estimated number of guests (covers) expected for the forecast period.']
  projected_fte_boh decimal(10,2) [note: 'Forecasted full‑time equivalent staff needed for back‑of‑house operations.']
  projected_fte_foh decimal(10,2) [note: 'Forecasted full‑time equivalent staff needed for front‑of‑house operations.']
  projected_labor_percent decimal(5,2) [note: 'Projected labor cost as a percentage of total sales for the forecast period.']
  projected_throughput varchar [note: 'Estimated number of transactions/orders expected during the forecast period.']
  promotion_flag boolean [note: 'Indicates whether a planned promotion or marketing campaign is active during the forecast period.']
  scenario varchar [note: 'Scenario used for the forecast (e.g., baseline, optimistic, pessimistic).']
  week_number varchar [note: 'ISO week number of the forecast date.']
  year varchar [note: 'Four‑digit year of the forecast date.']

  Note: 'Projected labor demand by restaurant, daypart, and week based on historical transaction volume (ADT/ATC), seasonal patterns, and planned promotions or LTOs. Captures forecasted cover count, expected throughput, recommended FTE count by BOH/FOH, projected Labor%, and the forecasting model version used. Drives Planday schedule generation and labor budget alignment.'
}

Table workforce.payroll_record {
  payroll_record_id varchar [pk, note: 'System-generated unique identifier for the payroll record.']
  cost_center_id varchar [note: 'Financial cost‑center to which payroll costs are charged.']
  department_id varchar [note: 'Identifier of the internal department (e.g., FOH, BOH) for cost allocation.']
  employee_id varchar [note: 'Unique identifier of the employee to whom the payroll pertains.']
  facility_id varchar [note: 'Identifier of the restaurant/location where the employee works.']
  payroll_run_id varchar [note: 'Identifier of the payroll run batch that generated this record.']
  unit_id varchar [note: 'Identifier of the restaurant/location where the employee works.']
  benefit_deduction decimal(12,2) [note: 'Sum of employee benefit contributions deducted.']
  bonus_amount decimal(12,2) [note: 'Monetary value of any bonus paid.']
  commission_amount decimal(12,2) [note: 'Monetary value of commission earned.']
  created_timestamp timestamp [note: 'Timestamp when the payroll record was first created.']
  currency_code varchar [note: 'ISO 4217 currency code for monetary amounts.']
  employee_address varchar [note: 'Mailing address of the employee.']
  employee_type varchar [note: 'Classification of employment relationship.']
  fiscal_period varchar [note: 'Period number within the fiscal year (e.g., Q1, Q2).']
  gross_pay decimal(12,2) [note: 'Total earnings before any deductions.']
  is_bonus boolean [note: 'Indicates whether the payroll includes a bonus component.']
  job_title varchar [note: 'Official job title or position held by the employee.']
  labor_percent decimal(5,2) [note: 'Labor cost as a percentage of sales for the period.']
  net_pay decimal(12,2) [note: 'Take‑home earnings after all deductions.']
  notes varchar [note: 'Free‑form comments or remarks about the payroll record.']
  other_deductions decimal(12,2) [note: 'Miscellaneous deductions such as garnishments.']
  overtime_hours decimal(6,2) [note: 'Total overtime hours worked.']
  overtime_rate decimal(8,2) [note: 'Hourly rate applied to overtime hours.']
  pay_date date [note: 'Date on which the net amount is disbursed to the employee.']
  pay_group decimal(18,2) [note: 'Grouping used for payroll processing (e.g., weekly, bi‑weekly).']
  pay_period_end date [note: 'Last calendar day of the payroll period.']
  pay_period_start date [note: 'First calendar day of the payroll period.']
  pay_rate decimal(8,2) [note: 'Standard hourly or salary rate for the employee.']
  payroll_date timestamp [note: 'Exact time the payroll was run in the source system.']
  payroll_number decimal(18,2) [note: 'Human‑readable payroll reference number assigned by the payroll system.']
  payroll_record_status decimal(18,2) [note: 'Current processing state of the payroll record.']
  payroll_type decimal(18,2) [note: 'Nature of compensation for the period.']
  regular_hours decimal(6,2) [note: 'Total non‑overtime hours worked.']
  tax_withheld decimal(12,2) [note: 'Total tax amount deducted from gross pay.']
  tax_year varchar [note: 'Fiscal year applicable for tax reporting.']
  tip_amount decimal(12,2) [note: 'Tips declared by the employee for the period.']
  union_member_flag boolean [note: 'True if the employee is a union member.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to the payroll record.']

  Note: 'Period-level payroll summary for each employee, capturing gross pay, net pay, regular hours paid, overtime hours paid, tips declared, deductions (benefits, taxes, garnishments), pay period dates, and payroll run status. Sourced from Workday HCM payroll module. Serves as the authoritative payroll transaction record for finance integration and Labor% reporting.'
}

Table workforce.recruitment {
  recruitment_id varchar [pk, note: 'System-generated unique identifier for the recruitment record.']
  employee_id varchar [note: 'Identifier of the manager responsible for the hire.']
  facility_id varchar [note: 'Identifier of the restaurant or site where the role is located.']
  primary_recruitment_employee_id varchar [note: 'Identifier of the manager responsible for the hire.']
  primary_recruitment_location_unit_id varchar [note: 'FK to restaurant.unit']
  applicant_count varchar [note: 'Total number of applicants received.']
  budget_usd decimal(12,2) [note: 'Allocated budget for recruitment advertising and agency fees.']
  closing_date date [note: 'Date the requisition was closed to new applications.']
  compliance_status varchar [note: 'Indicates whether the recruitment process meets internal and regulatory compliance (e.g., equal‑opportunity reporting).']
  created_timestamp timestamp [note: 'Timestamp when the recruitment record was first created.']
  department varchar [note: 'Business department or functional area the position belongs to.']
  employment_type varchar [note: 'Classification of employment relationship for the role.']
  interview_stage_count varchar [note: 'Number of interview stages defined for the requisition.']
  job_level varchar [note: 'Organizational level of the position.']
  last_updated_timestamp timestamp [note: 'Timestamp of the most recent update to the recruitment record.']
  location_name varchar [note: 'Human‑readable name of the restaurant or site.']
  notes varchar [note: 'Free‑form notes captured by recruiters or hiring managers.']
  offers_accepted varchar [note: 'Count of offers that were accepted by candidates.']
  offers_extended varchar [note: 'Count of job offers that have been extended.']
  position_title varchar [note: 'Official title of the position being recruited for.']
  posting_channel varchar [note: 'Channel used to publish the job opening.']
  posting_date date [note: 'Date the job was first posted.']
  recruitment_status varchar [note: 'Current lifecycle status of the recruitment process.']
  required_certifications varchar [note: 'Comma‑separated list of certifications (e.g., ServSafe) required for the role.']
  required_education_level varchar [note: 'Minimum education level required for the position.']
  required_experience_years varchar [note: 'Minimum years of relevant experience required.']
  requisition_number varchar [note: 'External reference number assigned to the job requisition.']
  salary_range_max decimal(10,2) [note: 'Upper bound of the advertised salary range (USD).']
  salary_range_min decimal(10,2) [note: 'Lower bound of the advertised salary range (USD).']
  source_of_candidate varchar [note: 'Origin of the candidate pool for this requisition.']
  target_headcount varchar [note: 'Number of hires planned for this requisition.']
  time_to_fill_days varchar [note: 'Number of calendar days from posting to hire acceptance.']

  Note: 'Tracks the full recruiting lifecycle for open positions across restaurant locations, including job requisition details, posting channels, candidate information (demographics, source, experience, availability), interview stages, offer status, and time-to-fill metrics. Captures both the requisition workflow and candidate pipeline in a single record per applicant-requisition combination. Sourced from Workday HCM Recruiting module. Supports NRO staffing ramp-up planning, turnover backfill management, diversity hiring tracking, and talent pipeline analytics.'
}

Table workforce.onboarding {
  onboarding_id varchar [pk, note: 'Unique system-generated identifier for the onboarding process instance.']
  department_id varchar [note: 'Identifier of the department (e.g., FOH, BOH, HR) the employee belongs to.']
  employee_id varchar [note: 'Employee identifier of the colleague assigned to mentor the new hire.']
  facility_id varchar [note: 'Identifier of the restaurant location where the employee will work.']
  manager_employee_id varchar [note: 'Identifier of the manager who signs off on onboarding completion.']
  position_id varchar [note: 'Identifier of the specific job role (e.g., Shift Lead, Server, Cook).']
  primary_onboarding_assigned_buddy_employee_id varchar [note: 'Employee identifier of the colleague assigned to mentor the new hire.']
  tertiary_onboarding_manager_employee_id varchar [note: 'Identifier of the manager who signs off on onboarding completion.']
  unit_id varchar [note: 'Identifier of the restaurant location where the employee will work.']
  completion_percentage decimal(5,2) [note: 'Calculated percentage of completed onboarding tasks (0.00 – 100.00).']
  end_timestamp timestamp [note: 'Date and time when the onboarding process was completed or terminated.']
  food_handler_card_date timestamp [note: 'Date and time the food handler card was received.']
  food_handler_card_submitted boolean [note: 'True when the employee has submitted a valid food handler certification.']
  i9_completed boolean [note: 'Indicates whether the employee\'s I-9 employment eligibility form has been completed.']
  i9_completion_date timestamp [note: 'Date and time when I-9 verification was finalized.']
  method varchar [note: 'Mode used to deliver onboarding activities.']
  notes varchar [note: 'Additional comments or observations related to the onboarding process.']
  onboarding_status varchar [note: 'Current lifecycle state of the onboarding instance.']
  onboarding_type varchar [note: 'Classification of the onboarding scenario.']
  pos_access_provision_date timestamp [note: 'Date and time POS access was granted.']
  pos_access_provisioned boolean [note: 'True when the employee has been granted access to the POS system.']
  record_audit_created timestamp [note: 'Timestamp when the onboarding record was first created in the system.']
  record_audit_updated timestamp [note: 'Timestamp of the most recent modification to the onboarding record.']
  servsafe_completion_date timestamp [note: 'Date and time the ServSafe training was completed.']
  servsafe_enrolled boolean [note: 'Indicates whether the employee has enrolled in ServSafe food safety training.']
  start_timestamp timestamp [note: 'Date and time when the onboarding process officially began.']
  training_completed boolean [note: 'True when all required onboarding training modules have been completed.']
  training_completion_date timestamp [note: 'Date and time the final onboarding training was completed.']
  uniform_issuance_date timestamp [note: 'Date and time the uniform was issued to the employee.']
  uniform_issued boolean [note: 'Indicates whether the employee has been provided with required uniform.']

  Note: 'Tracks the onboarding process for newly hired employees, including completion status of required tasks (I-9 verification, food handler card submission, uniform issuance, POS system access provisioning, ServSafe enrollment), onboarding start/end dates, assigned onboarding buddy, and manager sign-off. Ensures compliance with FDA food safety and OSHA workplace safety requirements at point of hire.'
}

Table workforce.certification {
  certification_id varchar [pk, note: 'System-generated unique identifier for the certification record.']
  employee_id varchar [note: 'Identifier of the employee who holds this certification.']
  certification_code varchar [note: 'Business identifier or code assigned to the certification by the issuing body.']
  certification_name varchar [note: 'Human‑readable name of the certification (e.g., ServSafe Food Handler).']
  certification_status varchar [note: 'Current lifecycle status of the certification.']
  certification_type varchar [note: 'Category of certification required for foodservice operations.']
  compliance_status varchar [note: 'Regulatory compliance assessment of the certification.']
  created_timestamp timestamp [note: 'Timestamp when the certification record was first created in the system.']
  document_url varchar [note: 'Link to the scanned certification document stored in the document repository.']
  expiration_date decimal(10,4) [note: 'Date the certification expires and must be renewed.']
  is_mandatory boolean [note: 'Indicates if the certification is required for the employee\'s role.']
  issue_date date [note: 'Date the certification was originally issued.']
  issuing_body varchar [note: 'Organization that issued the certification.']
  last_verified_date date [note: 'Date when the certification was last validated by internal audit.']
  notes varchar [note: 'Free‑form notes regarding the certification (e.g., special conditions, comments).']
  related_role varchar [note: 'Operational role(s) for which the certification is applicable.']
  renewal_notice_date date [note: 'Date a renewal reminder is sent to the employee.']
  renewal_required boolean [note: 'Indicates whether the certification must be renewed before expiration.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the certification record.']

  Note: 'Single source of truth for all employee learning credentials, training completions, and regulatory certifications required for foodservice operations. Covers external certifications (ServSafe Food Handler, ServSafe Manager, allergen awareness, HACCP, alcohol service permits, OSHA safety) and internal training completions (new hire orientation, food safety modules, POS/KDS operation, BOH/FOH SOPs, LTO product training, management development). Captures credential type, issuing body (NRA ServSafe, local health department, internal L&D), delivery method (in-person, e-learning, OJT), issue/completion date, expiration date, assessment score, trainer/facilitator, and compliance status. Critical for food safety regulatory compliance, health department inspections, scheduling eligibility validation, and employee development tracking.'
}

Table workforce.training_completion {
  training_completion_id varchar [pk, note: 'System-generated unique identifier for each training completion record.']
  facility_id varchar [note: 'Identifier of the restaurant location where the training was completed.']
  primary_training_employee_id varchar [note: 'Unique identifier of the employee who completed the training.']
  shift_id varchar [note: 'Identifier of the work shift associated with the training session.']
  training_employee_id varchar [note: 'Unique identifier of the trainer or facilitator.']
  unit_id varchar [note: 'Identifier of the restaurant location where the training was completed.']
  assessment_max_score decimal(5,2) [note: 'Maximum possible score for the assessment.']
  assessment_passed boolean [note: 'Indicates whether the employee passed the assessment (true) or not (false).']
  assessment_score decimal(5,2) [note: 'Score achieved by the employee on the training assessment.']
  certification_expiration_date decimal(10,4) [note: 'Date when the certification earned from this training expires, if applicable.']
  certification_required boolean [note: 'True if the training results in a required certification for the employee.']
  completion_number varchar [note: 'Business-assigned code for the training completion event.']
  completion_timestamp timestamp [note: 'Date and time when the employee finished the training.']
  compliance_status varchar [note: 'Indicates whether the training satisfies regulatory or internal compliance requirements.']
  created_timestamp timestamp [note: 'Timestamp when the training completion record was first created in the system.']
  daypart varchar [note: 'Daypart during which the training took place.']
  delivery_method varchar [note: 'Method used to deliver the training to the employee.']
  notes varchar [note: 'Free-text field for any supplemental information or comments.']
  required_for_role varchar [note: 'Job role(s) for which this training is mandatory (e.g., cook, manager).']
  trainer_name varchar [note: 'Full name of the trainer or facilitator.']
  training_category varchar [note: 'More specific category or module within the training type.']
  training_completion_status varchar [note: 'Current lifecycle status of the training completion record.']
  training_duration_minutes decimal(10,4) [note: 'Total length of the training session in minutes.']
  training_type varchar [note: 'Broad classification of the training content.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the training completion record.']

  Note: 'Records completion of training programs by employees, including new hire orientation, food safety modules, POS operation, KDS usage, BOH/FOH SOPs, LTO product training, and management development programs. Captures training program name, delivery method (in-person, e-learning, OJT), completion date, assessment score, and trainer/facilitator. Supports compliance tracking and performance development.'
}

Table workforce.performance_review {
  performance_review_id varchar [pk, note: 'Unique identifier for the performance review record.']
  performance_employee_id varchar [note: 'Identifier of the manager or peer who performed the review.']
  primary_performance_employee_id varchar [note: 'Identifier of the employee being reviewed.']
  reviewer_employee_id varchar [note: 'Identifier of the manager or peer who performed the review.']
  unit_id varchar [note: 'Identifier of the restaurant location where the employee works.']
  accuracy_score decimal(3,2) [note: 'Score reflecting the employee\'s order accuracy.']
  acknowledgment_status boolean [note: 'Indicates whether the employee has acknowledged the review.']
  actual_hours decimal(5,2) [note: 'Total hours actually worked by the employee during the review period.']
  attendance_score decimal(3,2) [note: 'Score reflecting attendance and punctuality.']
  certification_status varchar [note: 'Current status of any required certifications (e.g., ServSafe).']
  comments varchar [note: 'Free‑form text comments from the reviewer.']
  competency_score_total decimal(5,2) [note: 'Sum of individual competency scores.']
  confidentiality_level varchar [note: 'Data classification of the review record.']
  corrective_action_flag boolean [note: 'True if corrective action is required based on the review.']
  created_timestamp timestamp [note: 'Timestamp when the review record was first created in the system.']
  department varchar [note: 'Organizational department of the employee.']
  development_goals varchar [note: 'Narrative of agreed‑upon development objectives.']
  food_safety_score decimal(3,2) [note: 'Score reflecting adherence to food safety standards.']
  guest_service_score decimal(3,2) [note: 'Score reflecting the employee\'s guest service quality.']
  labor_percentage_actual decimal(5,2) [note: 'Actual labor cost as a percentage of sales for the review period.']
  labor_percentage_target decimal(5,2) [note: 'Target labor cost as a percentage of sales for the review period.']
  next_review_due_date date [note: 'Planned date for the next performance review.']
  overall_rating decimal(3,2) [note: 'Aggregated rating summarizing the employee\'s performance.']
  overtime_hours decimal(5,2) [note: 'Number of overtime hours logged in the review period.']
  performance_review_status varchar [note: 'Current lifecycle state of the review.']
  promotion_recommendation boolean [note: 'True if the reviewer recommends promotion.']
  rating_scale varchar [note: 'Scale used for the overall and competency scores.']
  review_date timestamp [note: 'Timestamp when the review was conducted or recorded.']
  review_document_url varchar [note: 'Link to the stored review document or PDF.']
  review_method varchar [note: 'How the review was conducted.']
  review_number varchar [note: 'Human‑readable business identifier for the review, e.g., PR‑2023‑0001.']
  review_period_end date [note: 'Last day of the performance period covered by the review.']
  review_period_start date [note: 'First day of the performance period covered by the review.']
  review_type varchar [note: 'Classification of the review based on its trigger or schedule.']
  scheduled_hours decimal(5,2) [note: 'Total hours scheduled for the employee during the review period.']
  shift_daypart varchar [note: 'Typical daypart of the employee\'s shift.']
  speed_score decimal(3,2) [note: 'Score reflecting the employee\'s speed of service.']
  training_completed boolean [note: 'Indicates whether required training was completed.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to the review record.']

  Note: 'Captures all formal employee performance and conduct events including scheduled evaluations (90-day, annual), corrective actions (verbal warnings, written warnings, PIPs, suspensions), and promotion assessments. Records event type, overall rating, competency scores (speed, accuracy, guest service, food safety adherence), infraction details where applicable, reviewer identity, review period, development goals, progressive discipline step, and acknowledgment status. Sourced from Workday HCM Performance module. Serves as the single record of all formal employee assessments for both development and legal compliance.'
}

Table workforce.leave_request {
  leave_request_id varchar [pk, note: 'System-generated unique identifier for the leave request record.']
  leave_employee_id varchar [note: 'Identifier of the manager who reviewed and approved/denied the request (source: Workday HCM).']
  primary_leave_employee_id varchar [note: 'Unique identifier of the employee submitting the leave request (source: Workday HCM).']
  unit_id varchar [note: 'Identifier of the restaurant/location where the employee is scheduled, used for shift‑coverage planning.']
  approved_timestamp timestamp [note: 'Date‑time when the leave request was approved or denied.']
  attachment_present boolean [note: 'Flag indicating whether the employee attached supporting documentation (e.g., medical certificate).']
  backfill_assigned_flag boolean [note: 'True when a replacement shift has been scheduled to cover the employee\'s absence.']
  coverage_needed_flag boolean [note: 'True if the requested leave creates a staffing gap that requires backfill.']
  created_timestamp timestamp [note: 'Timestamp when the leave request record was first created in the system.']
  end_date date [note: 'Last calendar date of the requested leave period.']
  is_paid_leave boolean [note: 'True if the leave type is paid and will be reflected in payroll; false for unpaid leave.']
  leave_balance_after decimal(5,2) [note: 'Employee\'s accrued leave balance after the approved leave is deducted.']
  leave_balance_before decimal(5,2) [note: 'Employee\'s accrued leave balance before this request is applied.']
  leave_days_approved decimal(5,2) [note: 'Number of leave days actually approved for the employee.']
  leave_days_requested decimal(5,2) [note: 'Total number of leave days (including fractions) the employee is asking for.']
  notes varchar [note: 'Free‑form text for the employee or manager to provide context or special instructions.']
  payroll_impact_flag boolean [note: 'Indicates whether the approved leave should affect the employee\'s payroll calculations.']
  request_number varchar [note: 'Human‑readable reference number assigned to the leave request for tracking and communication.']
  request_status varchar [note: 'Current lifecycle status of the leave request.']
  request_submitted_timestamp timestamp [note: 'Date‑time when the employee submitted the leave request.']
  request_type varchar [note: 'Category of leave being requested, such as vacation, sick, FMLA, personal, or unpaid.']
  return_to_work_date date [note: 'Date the employee is scheduled to resume duties after the leave period.']
  start_date date [note: 'First calendar date of the requested leave period.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to the leave request record.']

  Note: 'Tracks employee requests for time off including vacation, sick leave, FMLA, personal days, and unpaid leave. Captures request type, requested dates, approved dates, leave balance consumed, approval status, approving manager, and return-to-work date. Integrates with Planday scheduling to flag coverage gaps and trigger backfill shift assignments.'
}

Table workforce.labor_violation {
  labor_violation_id varchar [pk, note: 'System‑generated unique identifier for each labor violation record.']
  employee_id varchar [note: 'Unique identifier of the employee involved in the violation.']
  labor_restaurant_unit_id varchar [note: 'Identifier of the restaurant location where the violation occurred.']
  labor_unit_id varchar [note: 'Identifier of the restaurant location where the violation occurred.']
  shift_id varchar [note: 'Identifier of the work shift during which the violation occurred.']
  actual_break_time timestamp [note: 'The break time actually taken by the employee.']
  compliance_reported boolean [note: 'Indicates whether the violation has been reported to the required compliance authority.']
  corrective_action_due_date date [note: 'Target date by which the corrective action must be completed.']
  corrective_action_taken varchar [note: 'Description of the remediation steps performed to address the violation.']
  created_timestamp timestamp [note: 'Timestamp when the violation record was first created in the system.']
  daypart varchar [note: 'Part of the day (e.g., breakfast, lunch) when the violation happened.']
  detection_method varchar [note: 'Whether the violation was captured automatically or through manual review.']
  detection_source varchar [note: 'System or process that first identified the violation.']
  fine_amount decimal(12,2) [note: 'Fine levied by a regulatory body for the violation.']
  labor_violation_description varchar [note: 'Free‑text narrative describing the circumstances of the violation.']
  labor_violation_status varchar [note: 'Lifecycle status of the violation record.']
  overtime_hours decimal(5,2) [note: 'Number of overtime hours recorded beyond allowed limits.']
  penalty_amount decimal(12,2) [note: 'Monetary penalty assessed for the violation, if any.']
  regulatory_body varchar [note: 'Government agency or authority to which the violation must be reported.']
  reported_by varchar [note: 'Identifier of the person or system that logged the violation.']
  resolved_timestamp timestamp [note: 'Date‑time when the violation was formally closed or resolved.']
  scheduled_break_time timestamp [note: 'The break time that was scheduled for the employee.']
  severity varchar [note: 'Severity rating assigned to the violation based on impact and risk.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the violation record.']
  violation_code varchar [note: 'Code that maps the violation to a regulatory or internal taxonomy.']
  violation_timestamp timestamp [note: 'Date‑time when the labor violation was detected or occurred.']
  violation_type varchar [note: 'Categorized type of the violation (e.g., missed break, overtime, under‑age work).']

  Note: 'Records instances of labor compliance violations detected during operations, including missed meal/rest breaks, overtime threshold breaches, minor labor law violations (under-18 hour restrictions), predictive scheduling violations (where applicable), tip credit violations (failure to meet minimum wage with tips, improper tip pool inclusions), scheduling conflicts with certified food handler requirements, and OSHA-reportable workplace incidents. Captures violation type, severity, regulatory framework violated (FLSA, OSHA, state labor code), restaurant location, employee affected, detection source (automated time system, manager report, employee complaint), remediation deadline, and corrective action taken. Supports OSHA 300 log maintenance, DOL Wage & Hour Division audit responses, and state labor board compliance reporting.'
}

Table workforce.labor_budget {
  labor_budget_id varchar [pk, note: 'System-generated unique identifier for each labor budget record.']
  labor_restaurant_unit_id varchar [note: 'Unique identifier of the restaurant location to which the labor budget applies.']
  labor_unit_id varchar [note: 'Unique identifier of the restaurant location to which the labor budget applies.']
  approved_timestamp timestamp [note: 'Date‑time when the budget was approved by finance.']
  budget_category decimal(18,2) [note: 'Classification of the budget purpose (e.g., operational labor, training, benefits).']
  budget_code decimal(18,2) [note: 'External business code used to reference the budget in financial systems.']
  budget_name decimal(18,2) [note: 'Human‑readable name for the labor budget (e.g., "2024 Q1 Labor Budget").']
  budget_source decimal(18,2) [note: 'Origin of the budget figures (historical data, forecasting model, or manager input).']
  budget_status decimal(18,2) [note: 'Current lifecycle state of the budget record.']
  budget_type decimal(18,2) [note: 'Granularity of the budget (annual, quarterly, monthly, weekly, or daypart specific).']
  created_timestamp timestamp [note: 'Date‑time when the budget record was first created.']
  currency_code varchar [note: 'Three‑letter ISO 4217 currency code for monetary amounts.']
  daypart varchar [note: 'Specific daypart the budget applies to; use "all_day" for full‑day budgets.']
  fiscal_period varchar [note: 'Period within the fiscal year (e.g., "Q1", "M03").']
  fiscal_year varchar [note: 'Four‑digit calendar year for which the budget is defined.']
  fte_budget_boh decimal(6,2) [note: 'Planned BOH full‑time equivalent headcount.']
  fte_budget_foh decimal(6,2) [note: 'Planned FOH full‑time equivalent headcount.']
  fte_budget_total decimal(6,2) [note: 'Planned full‑time equivalent headcount for the period (combined BOH and FOH).']
  hours_budget_boh decimal(8,2) [note: 'Planned BOH labor hours.']
  hours_budget_foh decimal(8,2) [note: 'Planned FOH labor hours.']
  hours_budget_total decimal(8,2) [note: 'Planned total labor hours for the period.']
  labor_cost_estimate decimal(12,2) [note: 'Projected labor cost derived from forecasting models, may differ from the budgeted amount.']
  labor_cost_estimate_boh decimal(12,2) [note: 'Projected BOH labor spend derived from forecasting.']
  labor_cost_estimate_foh decimal(12,2) [note: 'Projected FOH labor spend derived from forecasting.']
  labor_dollar_budget decimal(12,2) [note: 'Planned total labor spend in local currency for the period.']
  labor_percent_target decimal(5,2) [note: 'Planned labor cost as a percentage of total sales for the period.']
  labor_percent_target_boh decimal(5,2) [note: 'Target labor cost percentage for BOH operations.']
  labor_percent_target_foh decimal(5,2) [note: 'Target labor cost percentage for FOH operations.']
  notes varchar [note: 'Free‑form comments or rationale for the budget.']
  period_end_date date [note: 'Last calendar date of the budgeting period.']
  period_start_date date [note: 'First calendar date of the budgeting period.']
  scenario varchar [note: 'Forecasting scenario used to generate the budget.']
  updated_timestamp timestamp [note: 'Date‑time of the most recent modification to the budget record.']
  version varchar [note: 'Version number of the budget record for change tracking.']

  Note: 'Period-level labor budget targets by restaurant location, capturing budgeted Labor%, budgeted total labor dollars, budgeted FTE count by BOH/FOH, budgeted hours by daypart, budgeted SPLH (Sales Per Labor Hour), and the fiscal period. Serves as the financial target against which actual labor spend (from payroll_record and time_entry) and forecasted demand (from labor_forecast) are measured. Supports P&L management, AUV optimization, and manager accountability for labor cost control.'
}

Table workforce.tip_compliance {
  tip_compliance_id varchar [pk, note: 'Unique identifier for the tip_compliance data product (auto-inserted pre-linking).']
  corrected_tip_compliance_id varchar [note: 'Self-referencing FK on tip_compliance (corrected_tip_compliance_id)']
  employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: Tip compliance records are specific to an employee; adding employee_id FK enables joining to employee for employee details and eliminates any redundant employee attributes.']
  restaurant_unit_id varchar
  adjustment_amount decimal(18,2) [note: 'Adjustment amount for tip_compliance']
  allocated_tips decimal(18,2)
  allocated_tips_amount decimal(18,2)
  base_wage_rate decimal(18,2) [note: 'Base hourly wage rate']
  cash_tips decimal(18,2)
  compliance_date date [note: 'Date of tip compliance record']
  compliance_status varchar [note: 'Compliance status for tip_compliance']
  created_at timestamp
  created_timestamp timestamp
  credit_card_tips decimal(18,2)
  currency_code varchar [note: 'Currency code']
  declared_tips decimal(18,2)
  declared_tips_amount decimal(18,2)
  effective_hourly_rate decimal(18,2) [note: 'Effective hourly rate including tips']
  hours_worked decimal(8,2) [note: 'Hours worked in period']
  is_compliant boolean
  minimum_wage_gap decimal(18,2) [note: 'Minimum wage gap for tip_compliance']
  minimum_wage_shortfall decimal(18,2)
  notes varchar
  pay_period_end decimal(18,2) [note: 'Pay period end for tip_compliance']
  pay_period_end_date date [note: 'End of pay period']
  pay_period_start decimal(18,2) [note: 'Pay period start for tip_compliance']
  pay_period_start_date date [note: 'Start of pay period']
  period_end date
  period_end_date date
  period_start date
  period_start_date date
  reported_tips decimal(18,2)
  reported_tips_amount decimal(18,2) [note: 'Reported tips amount for tip_compliance']
  reporting_period varchar
  reporting_period_end date
  reporting_period_start date
  review_date date
  reviewed_at timestamp
  reviewed_by varchar
  sales_amount decimal(18,2) [note: 'Total sales for the period']
  shortfall_amount decimal(18,2)
  tip_credit decimal(18,2)
  tip_credit_amount decimal(18,2) [note: 'Tip credit amount for tip_compliance']
  tip_pool_contribution decimal(18,2) [note: 'Amount contributed to tip pool']
  tip_pool_distribution decimal(18,2) [note: 'Amount received from tip pool']
  tip_rate_pct decimal(5,2) [note: 'Tip rate as percentage of sales']
  total_tips_allocated decimal(18,2) [note: 'Total tips allocated']
  total_tips_reported decimal(18,2) [note: 'Total tips reported by employee']
  updated_at timestamp
  updated_timestamp timestamp

  Note: 'Tracks tip pooling arrangements, tip credit elections, tip sharing ratios, and employee-level tip declarations required for DOL FLSA §3(m) compliance. Captures tip pool participant roster, contribution percentages, distribution method (hours-based, points-based), tip credit amount claimed per pay period, employee tip declaration forms, and audit trail for tip pool changes. Supports compliance with federal and state tip credit regulations, tip pooling legality verification (front-of-house vs back-of-house eligibility per 2021 DOL final rule), and provides evidence for DOL Wage & Hour Division audits.'
}

Table workforce.scheduling_template {
  scheduling_template_id varchar [pk, note: 'Primary key for scheduling_template']
  base_scheduling_template_id varchar [note: 'Self-referencing FK on scheduling_template (base_scheduling_template_id)']
  daypart varchar [note: 'Primary daypart(s) the template applies to.']
  default_shift_length_minutes varchar [note: 'Standard length of a shift defined by the template, expressed in minutes.']
  effective_from date [note: 'Date when the template becomes effective for scheduling.']
  effective_until date [note: 'Date when the template expires or is superseded (null if open‑ended).']
  fte_target decimal(5,2) [note: 'Planned number of full‑time equivalents required when using this template.']
  is_default_template boolean [note: 'Indicates whether this template is the default choice for new locations or schedules.']
  labor_percentage decimal(5,2) [note: 'Target labor percentage of total operating hours for the template.']
  location_scope varchar [note: 'Geographic or organizational scope where the template can be applied.']
  notes varchar [note: 'Additional remarks or operational notes related to the template.']
  record_audit_created timestamp [note: 'Timestamp when the scheduling template record was first created in the system.']
  record_audit_updated timestamp [note: 'Timestamp of the most recent update to the scheduling template record.']
  role_applicability varchar [note: 'Workforce role(s) the template is intended for (Front‑of‑House, Back‑of‑House, or both).']
  scheduling_template_description varchar [note: 'Detailed free‑text description of the scheduling template\'s purpose and usage.']
  scheduling_template_status varchar [note: 'Current lifecycle status of the template.']
  template_code varchar [note: 'Business code used to reference the scheduling template across systems.']
  template_name varchar [note: 'Human‑readable name of the scheduling template.']
  template_type varchar [note: 'Category of the template indicating its purpose or usage scenario.']
  version_number varchar [note: 'Version of the template to support change management and audit.']

  Note: 'Master reference table for scheduling_template. Referenced by labor_scheduling_template_id.'
}

Table workforce.workforce_department {
  workforce_department_id varchar [pk, note: 'Primary key for department']
  employee_id varchar [note: 'Identifier of the employee who manages the department.']
  parent_department_id varchar [note: 'Identifier of the parent department in the organizational hierarchy.']
  unit_id varchar [note: 'Identifier of the restaurant location where the department operates.']
  budget_amount decimal(12,2) [note: 'Annual budget allocated to the department.']
  budget_currency decimal(18,2) [note: 'Three-letter ISO 4217 currency code for the department budget.']
  compliance_status varchar [note: 'Current compliance status of the department with regulatory requirements.']
  cost_center_code decimal(18,2) [note: 'Financial cost center code associated with the department.']
  created_timestamp timestamp [note: 'Timestamp when the department record was first created in the system.']
  department_type varchar [note: 'Category of department indicating its functional area (e.g., Front of House, Back of House).']
  effective_from date [note: 'Date when the department became operational.']
  effective_until date [note: 'Date when the department ceased operation (null if still active).']
  floor_area_sqft decimal(10,2) [note: 'Physical floor area occupied by the department in square feet.']
  headcount varchar [note: 'Number of full-time equivalent employees assigned to the department.']
  is_remote boolean [note: 'Flag indicating if the department operates remotely (e.g., corporate functions).']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the department record.']
  workforce_department_description varchar [note: 'Detailed description of the department\'s purpose and responsibilities.']
  workforce_department_status varchar [note: 'Current lifecycle status of the department.']

  Note: 'Workforce departments for labor scheduling, payroll allocation, and HR organizational structure. [SSOT: canonical source is restaurant.department]'
}

Table workforce.payroll_run {
  payroll_run_id varchar [pk, note: 'Primary key for payroll_run']
  employee_id varchar [note: 'Identifier of the user who processed the payroll run.']
  payroll_group_id varchar [note: 'Identifier of the payroll group or cost center associated with this run.']
  reversal_payroll_run_id varchar [note: 'Self-referencing FK on payroll_run (reversal_payroll_run_id)']
  unit_id varchar [note: 'Identifier of the restaurant location for which the payroll run was processed.']
  approval_status varchar [note: 'Approval status of the payroll run.']
  approval_timestamp timestamp [note: 'Timestamp when the payroll run was approved.']
  batch_number varchar [note: 'Batch number assigned by the external payroll processor.']
  cost_center_code decimal(18,2) [note: 'Business cost center code linked to the payroll run.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for payroll amounts.']
  deductions_amount decimal(15,2) [note: 'Total amount of taxes, benefits, and other deductions for the payroll run.']
  fiscal_period varchar [note: 'Fiscal period (e.g., Q1, Q2) for the payroll run.']
  gross_amount decimal(15,2) [note: 'Total gross payroll amount before any deductions.']
  is_finalized boolean [note: 'Indicates whether the payroll run has been finalized and posted to the payroll ledger.']
  net_amount decimal(15,2) [note: 'Net payroll amount after deductions.']
  pay_cycle decimal(18,2) [note: 'Frequency at which employees are paid for this run.']
  pay_period_end_date date [note: 'Last calendar date of the pay period covered by the payroll run.']
  pay_period_start_date date [note: 'First calendar date of the pay period covered by the payroll run.']
  payroll_run_description decimal(18,2) [note: 'Free-text notes or description about the payroll run.']
  payroll_run_status varchar [note: 'Current lifecycle state of the payroll run.']
  payroll_type decimal(18,2) [note: 'Category of payroll processing for the run.']
  record_audit_created timestamp [note: 'Timestamp when the payroll run record was first created in the data lake.']
  record_audit_updated timestamp [note: 'Timestamp of the most recent update to the payroll run record.']
  run_number varchar [note: 'External reference number assigned by the payroll system.']
  run_timestamp timestamp [note: 'Date and time when the payroll run was executed.']
  tax_year varchar [note: 'Fiscal tax year applicable to the payroll run.']
  total_employee_count varchar [note: 'Number of employees included in this payroll run.']

  Note: 'Master reference table for payroll_run. Referenced by payroll_run_id.'
}

Table workforce.payroll_group {
  payroll_group_id varchar [pk, note: 'Primary key for payroll_group']
  parent_payroll_group_id varchar [note: 'Self-referencing FK on payroll_group (parent_payroll_group_id)']
  cost_center_code decimal(18,2) [note: 'Internal cost center associated with the payroll group for financial allocation.']
  created_timestamp timestamp [note: 'Timestamp when the payroll group record was created in the system.']
  default_benefit_plan_code varchar [note: 'Identifier of the default benefit plan applied to employees in this payroll group.']
  default_tax_rate decimal(5,2) [note: 'Standard tax withholding rate applied to payrolls in this group.']
  effective_from date [note: 'Date when the payroll group becomes effective.']
  effective_until date [note: 'Date when the payroll group ceases to be effective; null if indefinite.']
  group_code varchar [note: 'Unique business code assigned to the payroll group.']
  group_manager_email varchar [note: 'Email address of the payroll group manager.']
  group_manager_name varchar [note: 'Full name of the manager responsible for the payroll group.']
  group_manager_phone varchar [note: 'Contact phone number of the payroll group manager.']
  group_name varchar [note: 'Descriptive name of the payroll group used in reporting and payroll processing.']
  group_type varchar [note: 'Classification of the payroll group based on employee compensation model.']
  payroll_currency_code decimal(18,2) [note: 'ISO 4217 currency code for payroll payments.']
  payroll_frequency decimal(18,2) [note: 'Regular interval at which payroll is processed for this group.']
  payroll_group_description varchar [note: 'Detailed description of the payroll group purpose and scope.']
  payroll_group_status varchar [note: 'Current lifecycle status of the payroll group.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the payroll group record.']

  Note: 'Master reference table for payroll_group. Referenced by payroll_group_id.'
}

Table franchise.franchisee {
  franchisee_id varchar [pk, note: 'Unique identifier for the franchisee']
  area_representative_id varchar [note: 'FK to the area representative managing this franchisee']
  bank_account_id varchar [note: 'FK to the franchisee bank account for royalty payments']
  distribution_center_id varchar [note: 'FK to the primary distribution center serving this franchisee']
  program_id varchar [note: 'FK to the loyalty program this franchisee participates in']
  territory_id varchar [note: 'FK to the territory assigned to this franchisee']
  address_line1 varchar [note: 'Primary street address of the franchisee']
  address_line2 varchar [note: 'Secondary address line']
  annual_revenue decimal(18,2) [note: 'Total annual revenue across all units']
  average_unit_volume decimal(12,2) [note: 'Average unit volume across all locations']
  city varchar [note: 'City of the franchisee headquarters']
  compliance_status varchar [note: 'Current compliance status of the franchisee']
  country_code varchar [note: 'ISO country code']
  created_timestamp timestamp [note: 'Record creation timestamp']
  credit_rating varchar [note: 'Credit rating of the franchisee entity']
  dba_name varchar [note: 'Doing-business-as name']
  established_date date [note: 'Date the franchisee entity was established']
  fdd_disclosure_status varchar [note: 'Status of FDD disclosure for this franchisee']
  food_safety_certified boolean [note: 'Whether the franchisee holds food safety certification']
  franchise_fee_amount decimal(18,2) [note: 'Initial franchise fee paid']
  franchisee_number varchar [note: 'Business identifier number for the franchisee']
  franchisee_status varchar [note: 'Current operational status (active, inactive, suspended)']
  franchisee_type varchar [note: 'Type of franchisee (single-unit, multi-unit, area developer)']
  ifa_membership_status varchar [note: 'International Franchise Association membership status']
  industry_segment varchar [note: 'Industry segment classification']
  insurance_expiry_date date [note: 'Date when insurance coverage expires']
  insurance_policy_number varchar [note: 'Insurance policy reference number']
  legal_name varchar [note: 'Legal registered name of the franchisee entity']
  next_renewal_date date [note: 'Date of next franchise agreement renewal']
  number_of_units varchar [note: 'Total number of restaurant units operated']
  postal_code varchar [note: 'Postal/ZIP code']
  royalty_fee_amount decimal(18,2) [note: 'Current royalty fee amount']
  royalty_rate decimal(5,2) [note: 'Royalty rate percentage']
  state_province varchar [note: 'State or province']
  state_tax_number varchar [note: 'State tax identification number']
  tax_id_ein varchar [note: 'Federal employer identification number']
  termination_date date [note: 'Date franchise was terminated if applicable']
  updated_timestamp timestamp [note: 'Record last update timestamp']

  Note: 'A franchisee entity representing an individual or organization that operates one or more franchise restaurant units under a franchise agreement.'
}

Table franchise.agreement {
  agreement_id varchar [pk, note: 'Unique identifier for the franchise agreement']
  agreement_franchisor_legal_entity_id varchar [note: 'FK to the franchisor legal entity']
  agreement_legal_entity_id varchar [note: 'FK to the franchisee legal entity']
  franchisee_id varchar [note: 'FK to the franchisee party']
  territory_id varchar [note: 'FK to the territory covered by this agreement']
  agreement_number varchar [note: 'Business reference number for the agreement']
  agreement_status varchar [note: 'Current status (active, expired, terminated)']
  agreement_type varchar [note: 'Type of agreement (single-unit, multi-unit, area development)']
  amendment_effective_date date [note: 'Effective date of the latest amendment']
  amendment_number varchar [note: 'Sequential amendment number']
  average_unit_volume decimal(12,2) [note: 'Expected average unit volume under this agreement']
  compliance_review_date date [note: 'Date of last compliance review']
  compliance_status varchar [note: 'Compliance status of the agreement']
  contract_version varchar [note: 'Version of the contract template used']
  created_timestamp timestamp [note: 'Record creation timestamp']
  effective_end_date date [note: 'Agreement end date']
  effective_start_date date [note: 'Agreement start date']
  ftc_compliance_attestation_flag boolean [note: 'Whether FTC compliance has been attested']
  initial_fee_amount decimal(18,2) [note: 'Initial franchise fee amount']
  marketing_fee_percent decimal(5,2) [note: 'Marketing fund contribution percentage']
  notes varchar [note: 'Free-text notes about the agreement']
  renewal_fee_amount decimal(18,2) [note: 'Fee charged upon renewal']
  renewal_term_years varchar [note: 'Length of renewal term in years']
  royalty_rate_percent decimal(5,2) [note: 'Royalty rate as a percentage of gross sales']
  sales_target_amount decimal(18,2) [note: 'Minimum sales target amount']
  signed_date date [note: 'Date the agreement was signed']
  termination_date date [note: 'Date the agreement was terminated']
  transfer_rights_flag boolean [note: 'Whether the agreement includes transfer rights']
  updated_timestamp timestamp [note: 'Record last update timestamp']

  Note: 'A franchise agreement governing the relationship between franchisor and franchisee including terms, fees, and obligations.'
}

Table franchise.territory {
  territory_id varchar [pk, note: 'Unique identifier for the territory']
  distribution_center_id varchar [note: 'FK to the distribution center serving this territory']
  area_sq_miles decimal(10,2) [note: 'Total area of the territory in square miles']
  assignment_status varchar [note: 'Whether the territory is assigned or available']
  average_unit_volume decimal(12,2) [note: 'Average unit volume for locations in this territory']
  city varchar [note: 'Primary city within the territory']
  compliance_status varchar [note: 'Compliance status of the territory']
  country_code varchar [note: 'ISO country code']
  created_timestamp timestamp [note: 'Record creation timestamp']
  dma varchar [note: 'Designated Market Area']
  effective_end_date date [note: 'End date of territory assignment']
  effective_start_date date [note: 'Start date of territory assignment']
  franchise_fee decimal(18,2) [note: 'Franchise fee applicable in this territory']
  geometry_wkt varchar [note: 'Well-Known Text representation of territory boundary']
  last_inspection_date date [note: 'Date of last territory inspection']
  median_income decimal(12,2) [note: 'Median household income in the territory']
  notes varchar [note: 'Free-text notes']
  number_of_locations varchar [note: 'Number of restaurant locations in the territory']
  population varchar [note: 'Population within the territory']
  radius_miles decimal(5,2) [note: 'Radius of the territory in miles']
  region varchar [note: 'Region classification']
  royalty_rate decimal(5,2) [note: 'Royalty rate applicable in this territory']
  territory_code varchar [note: 'Short code for the territory']
  territory_description varchar [note: 'Description of the territory']
  territory_name varchar [note: 'Name of the territory']
  territory_status varchar [note: 'Current status of the territory']
  territory_type varchar [note: 'Type of territory (exclusive, non-exclusive)']
  trade_area_classification varchar [note: 'Classification of the trade area']
  updated_timestamp timestamp [note: 'Record last update timestamp']
  zip_codes varchar [note: 'Comma-separated list of ZIP codes in the territory']

  Note: 'A geographic territory assigned to a franchisee defining the exclusive or protected area for franchise operations.'
}

Table franchise.billing {
  billing_id varchar [pk, note: 'Unique identifier for the billing record']
  agreement_id varchar [note: 'FK to the governing franchise agreement']
  franchisee_id varchar [note: 'FK to the franchisee being billed']
  amount_due decimal(18,2)
  amount_paid decimal(18,2) [note: 'Amount already paid']
  balance_outstanding decimal(18,2) [note: 'Remaining balance outstanding']
  billing_date date
  billing_number varchar [note: 'Business reference number for the billing']
  billing_status varchar [note: 'Status of the billing (draft, sent, paid, overdue)']
  billing_type varchar [note: 'Type of billing (recurring, one-time, adjustment)']
  created_timestamp timestamp [note: 'Record creation timestamp']
  currency_code varchar [note: 'ISO currency code']
  due_date date [note: 'Payment due date']
  invoice_date date [note: 'Date the invoice was issued']
  invoice_number varchar [note: 'Invoice reference number']
  is_paid boolean [note: 'Whether the billing has been fully paid']
  marketing_fee_amount decimal(18,2) [note: 'Marketing fund contribution amount']
  paid_date date [note: 'Date payment was received']
  payment_status varchar
  period varchar
  period_end date [note: 'End date of the billing period']
  period_start date [note: 'Start date of the billing period']
  royalty_amount decimal(18,2) [note: 'Royalty fee amount billed']
  technology_fee_amount decimal(18,2) [note: 'Technology fee amount']
