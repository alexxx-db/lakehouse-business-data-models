    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:quantityAffected rdf:type rdf:Property ;
    rdfs:label 'Quantity Affected' ;
    rdfs:comment 'Number of units or parts impacted by the defect.' ;
    rdfs:domain ind:DefectRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:rootCause rdf:type rdf:Property ;
    rdfs:label 'Root Cause' ;
    rdfs:comment 'Root cause analysis result describing why the defect occurred.' ;
