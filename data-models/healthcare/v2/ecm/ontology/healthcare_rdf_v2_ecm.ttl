    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DepreciationRun .

ind:assetCount rdf:type rdf:Property ;
    rdfs:label 'Asset Count' ;
    rdfs:comment 'The total number of assets included in this depreciation run.' ;
