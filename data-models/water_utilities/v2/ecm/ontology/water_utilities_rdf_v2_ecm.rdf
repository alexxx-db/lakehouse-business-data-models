    rdfs:comment 'Commodity rate per CCF' ;
    rdfs:domain ind:ServiceRateSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:commodityRatePerGallon rdf:type rdf:Property ;
    rdfs:label 'Commodity Rate Per Gallon' ;
    rdfs:comment 'Commodity rate per gallon' ;
    rdfs:domain ind:ServiceRateSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:commodityRatePerUnit rdf:type rdf:Property ;
    rdfs:label 'Commodity Rate Per Unit' ;
    rdfs:comment 'Commodity rate per unit of consumption' ;
    rdfs:domain ind:ServiceRateSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:demandChargeRate rdf:type rdf:Property ;
    rdfs:label 'Demand Charge Rate' ;
