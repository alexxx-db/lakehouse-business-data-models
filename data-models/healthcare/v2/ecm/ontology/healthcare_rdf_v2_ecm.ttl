    rdfs:comment '' .

ind:PromQuestion rdf:type rdfs:Class ;
    rdfs:subClassOf ind:DigitalHealth ;
    rdfs:label 'Prom Question' ;
    rdfs:comment 'Master reference table for prom_question. Referenced by question_id.' .

ind:PortalSession rdf:type rdfs:Class ;
    rdfs:subClassOf ind:DigitalHealth ;
    rdfs:label 'Portal Session' ;
    rdfs:comment 'Master reference table for portal_session. Referenced by session_id.' .

ind:Grant rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Finance ;
    rdfs:label 'Grant' ;
    rdfs:comment 'Master reference table for grant. Referenced by grant_id.' .

ind:Set rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Order ;
    rdfs:label 'Set' ;
    rdfs:comment 'Master reference table for set. Referenced by set_id.' .

ind:DistributionRule rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Radiology ;
    rdfs:label 'Distribution Rule' ;
    rdfs:comment 'Master reference table for distribution_rule. Referenced by distribution_rule_id.' .

ind:Grant rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Research ;
    rdfs:label 'Grant' ;
    rdfs:comment 'Master reference table for grant. Referenced by grant_id.' .

# --- Attribute Properties ---
ind:mpiRecordId rdf:type rdf:Property ;
    rdfs:label 'Mpi Record Id' ;
    rdfs:comment 'Unique surrogate primary key for the MPI golden record in the enterprise lakehouse. Serves as the enterprise-wide patient_id referenced by every clinical and financial domain. Role: MASTER_PARTY (enterprise identity anchor).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MpiRecord .

ind:careSiteId rdf:type rdf:Property ;
    rdfs:label 'Care Site Id' ;
    rdfs:comment 'The facility identifier of the healthcare organization where this patient identity was first registered and the MPI record originated. Links to the facility master for cross-facility identity management.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CareSite .

ind:employeeId rdf:type rdf:Property ;
    rdfs:label 'Employee Id' ;
    rdfs:comment 'The workforce employee identifier of the HIM analyst or MPI specialist who reviewed and approved the merge or unmerge action for this record. Required for manual merge audit trail and accountability.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:survivingMpiRecordId rdf:type rdf:Property ;
    rdfs:label 'Surviving Mpi Record Id' ;
    rdfs:comment 'For non-surviving (merged/deprecated) MPI records, the mpi_record_id of the surviving golden record that absorbed this identity. Null for active golden records. Supports merge history traversal and MRN crosswalk resolution.' ;
    rdfs:domain ind:MpiRecord ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MpiRecord .

ind:clinicalAiIntegrationMarker rdf:type rdf:Property ;
    rdfs:label 'Clinical Ai Integration Marker' ;
    rdfs:comment 'Marker added to satisfy clinical AI integration requirement' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:createdTimestamp rdf:type rdf:Property ;
    rdfs:label 'Created Timestamp' ;
    rdfs:comment 'The timestamp when this MPI golden record was first created in the enterprise MPI system. Serves as the authoritative record creation audit timestamp. Required for HIPAA audit trail compliance.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:dateOfBirth rdf:type rdf:Property ;
    rdfs:label 'Date Of Birth' ;
    rdfs:comment 'The patient\'s date of birth in yyyy-MM-dd format. Core PHI identifier used for identity matching, age-based clinical decision support, eligibility verification, and regulatory reporting. One of the 18 HIPAA PHI identifiers.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:dateOfDeath rdf:type rdf:Property ;
    rdfs:label 'Date Of Death' ;
    rdfs:comment 'The date of the patient\'s death in yyyy-MM-dd format. Populated when deceased_flag is True. Sourced from EHR ADT, state vital records, or Social Security Death Index. Used for mortality reporting, quality measures, and population health analytics.' ;
    rdfs:domain ind:MpiRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:deceasedFlag rdf:type rdf:Property ;
    rdfs:label 'Deceased Flag' ;
    rdfs:comment 'Indicates whether the patient is deceased. True = patient is deceased. Used to suppress deceased patients from active care management workflows, population health outreach, and appointment scheduling.' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:deploymentGuideSection rdf:type rdf:Property ;
    rdfs:label 'Deployment Guide Section' ;
    rdfs:domain ind:MpiRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:digitalHealthAddedFlag rdf:type rdf:Property ;
    rdfs:label 'Digital Health Added Flag' ;
    rdfs:comment 'Flag added by digital health batch' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:digitalHealthIntegrationMarker rdf:type rdf:Property ;
    rdfs:label 'Digital Health Integration Marker' ;
    rdfs:comment 'Marker for digital health integration' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:digitalHealthNote rdf:type rdf:Property ;
    rdfs:label 'Digital Health Note' ;
    rdfs:comment 'Marker added for digital health integration' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:enterprisePatientNumber rdf:type rdf:Property ;
    rdfs:label 'Enterprise Patient Number' ;
    rdfs:comment 'The enterprise-wide, human-readable unique patient identifier assigned by the MPI system. Serves as the SSOT identity key across all facilities, EHR systems, and HIE platforms. Distinct from facility-level MRNs.' ;
    rdfs:domain ind:MpiRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ethnicityCode rdf:type rdf:Property ;
    rdfs:label 'Ethnicity Code' ;
    rdfs:comment 'The patient\'s self-reported ethnicity using OMB codes (2135-2=Hispanic or Latino, 2186-5=Not Hispanic or Latino, UNK=Unknown/Not Reported). Collected per CMS health equity and USCDI requirements.' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:firstRegistrationDate rdf:type rdf:Property ;
    rdfs:label 'First Registration Date' ;
    rdfs:comment 'The date the patient was first registered in the enterprise MPI system. Represents the earliest known encounter with the healthcare organization. Used for longitudinal care analytics and patient tenure reporting.' ;
    rdfs:domain ind:MpiRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:genderIdentity rdf:type rdf:Property ;
    rdfs:label 'Gender Identity' ;
    rdfs:comment 'The patient\'s self-reported gender identity. Collected per CMS and ONC requirements for health equity reporting and SDOH documentation. Distinct from sex at birth. [ENUM-REF-CANDIDATE: male|female|transgender_male|transgender_female|nonbinary|genderqueer|other|unknown — promote to reference product]' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hiePatientNumber rdf:type rdf:Property ;
    rdfs:label 'Hie Patient Number' ;
    rdfs:comment 'The patient identifier assigned by the regional or national Health Information Exchange (HIE) network. Used for cross-organizational patient matching and care coordination. Supports CMS Interoperability and Patient Access Rule compliance.' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:identityConfidenceTier rdf:type rdf:Property ;
    rdfs:label 'Identity Confidence Tier' ;
    rdfs:comment 'A tiered classification of the overall identity confidence for this MPI golden record based on the number and quality of verified identity traits (e.g., government ID verified, biometric match, multi-source corroboration). \'high\'=strong multi-source verification; \'low\'=minimal corroboration; \'unverified\'=no identity proofing completed.' ;
    rdfs:domain ind:MpiRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:identityResolutionStatus rdf:type rdf:Property ;
    rdfs:label 'Identity Resolution Status' ;
    rdfs:comment 'Current identity resolution status of this MPI record. \'golden\' = authoritative enterprise identity; \'candidate\' = awaiting resolution; \'overlay\' = erroneous merge detected; \'duplicate\' = confirmed duplicate pending merge; \'merged\' = non-surviving record post-merge; \'unmerged\' = previously merged record that was separated; \'pending_review\' = flagged for analyst review. Core MPI lifecycle field. [ENUM-REF-CANDIDATE: golden|candidate|overlay|duplicate|merged|unmerged|pending_review — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:MpiRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interpreterRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Interpreter Required Flag' ;
    rdfs:comment 'Indicates whether the patient requires a professional interpreter for clinical encounters. True = interpreter services must be arranged. Supports compliance with Section 1557 of the ACA (language access) and CMS CLAS Standards.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isDuplicateFlag rdf:type rdf:Property ;
    rdfs:label 'Is Duplicate Flag' ;
    rdfs:comment 'Indicates whether this MPI record has been identified as a duplicate of another enterprise patient identity. True = confirmed or suspected duplicate. Used to trigger merge workflow in the MPI tool.' ;
    rdfs:domain ind:MpiRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isOverlayFlag rdf:type rdf:Property ;
    rdfs:label 'Is Overlay Flag' ;
    rdfs:comment 'Indicates whether this MPI record has been identified as an overlay — a patient safety event where two distinct patients\' records were erroneously merged. Overlay detection is a critical patient safety and HIM compliance function. True = overlay detected.' ;
    rdfs:domain ind:MpiRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastUpdatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Updated Timestamp' ;
    rdfs:comment 'The timestamp of the most recent update to this MPI golden record, including demographic changes, merge/unmerge events, or status changes. Used for change data capture, HIE synchronization, and audit compliance.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:lastVerifiedDate rdf:type rdf:Property ;
    rdfs:label 'Last Verified Date' ;
    rdfs:comment 'The most recent date on which the patient\'s identity was actively verified against a government-issued ID or biometric at a point of service. Used to assess identity confidence staleness and trigger re-verification workflows.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:legalFirstName rdf:type rdf:Property ;
    rdfs:label 'Legal First Name' ;
    rdfs:comment 'The patient\'s legal given/first name as recorded in the MPI golden record. PHI under HIPAA. Used for identity verification and clinical documentation.' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalLastName rdf:type rdf:Property ;
    rdfs:label 'Legal Last Name' ;
    rdfs:comment 'The patient\'s legal family/surname as recorded in the MPI golden record. Used for identity matching, clinical documentation, and regulatory reporting. PHI under HIPAA.' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:matchConfidenceScore rdf:type rdf:Property ;
    rdfs:label 'Match Confidence Score' ;
    rdfs:comment 'The probabilistic confidence score (0.0000–1.0000) produced by the identity matching algorithm indicating the likelihood that two records represent the same individual. Scores above the enterprise threshold trigger automatic merge; scores in the review band require analyst adjudication.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:medicaidNumber rdf:type rdf:Property ;
    rdfs:label 'Medicaid Number' ;
    rdfs:comment 'The state-assigned Medicaid recipient identifier for patients enrolled in Medicaid. Format varies by state. Used for Medicaid claims submission, eligibility verification, and CMS reporting.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicareBeneficiaryNumber rdf:type rdf:Property ;
    rdfs:label 'Medicare Beneficiary Number' ;
    rdfs:comment 'The CMS-assigned Medicare Beneficiary Identifier (MBI) for patients enrolled in Medicare. Replaced the Social Security Number-based Health Insurance Claim Number (HICN). Required for Medicare claims submission and CMS quality reporting.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mergeAlgorithm rdf:type rdf:Property ;
    rdfs:label 'Merge Algorithm' ;
    rdfs:comment 'The name or version of the probabilistic or deterministic matching algorithm used to identify this record as a merge candidate (e.g., \'Verato_v3.2\', \'Epic_MPI_Deterministic\', \'Rhapsody_Probabilistic_v2\'). Supports algorithm governance and audit.' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mergeReason rdf:type rdf:Property ;
    rdfs:label 'Merge Reason' ;
    rdfs:comment 'The documented reason or trigger for the merge of this MPI record into a surviving golden record. Supports audit trail and quality improvement for identity resolution processes.' ;
    rdfs:domain ind:MpiRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mergeTimestamp rdf:type rdf:Property ;
    rdfs:label 'Merge Timestamp' ;
    rdfs:comment 'The date and time when this MPI record was merged into a surviving golden record. Null if the record has never been merged. Part of the merge/unmerge audit trail required for HIM compliance.' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:middleName rdf:type rdf:Property ;
    rdfs:label 'Middle Name' ;
    rdfs:comment 'The patient\'s middle name or middle initial as recorded in the MPI golden record. Used to disambiguate patients with identical first and last names during identity resolution.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mpiRecordStatus rdf:type rdf:Property ;
    rdfs:label 'Mpi Record Status' ;
    rdfs:comment 'The current lifecycle status of this MPI golden record. \'active\'=current enterprise identity in use; \'inactive\'=no recent activity; \'merged\'=non-surviving record post-merge; \'deceased\'=patient deceased; \'test\'=test/training record; \'blocked\'=access restricted pending review.' ;
    rdfs:domain ind:MpiRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mrn rdf:type rdf:Property ;
    rdfs:label 'Mrn' ;
    rdfs:comment 'The primary facility-level Medical Record Number (MRN) assigned to the patient at the enterprise anchor facility. Additional facility MRNs are tracked in the MRN crosswalk. Sourced from Epic EHR or Cerner Millennium ADT.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nameSuffix rdf:type rdf:Property ;
    rdfs:label 'Name Suffix' ;
    rdfs:comment 'Generational or professional suffix appended to the patient\'s legal name (e.g., Jr., Sr., III). Used in identity matching to reduce false-positive duplicate detection.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nationalHealthIdType rdf:type rdf:Property ;
    rdfs:label 'National Health Id Type' ;
    rdfs:comment 'The type or issuing authority of the national health identifier stored in national_health_id (e.g., NHS_NUMBER=UK NHS Number, EHIC=European Health Insurance Card, MEDICARE_BENE_ID=CMS Medicare Beneficiary Identifier, MEDICAID_ID=State Medicaid ID).' ;
    rdfs:domain ind:MpiRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nationalHealthNumber rdf:type rdf:Property ;
    rdfs:label 'National Health Number' ;
    rdfs:comment 'National health identifier assigned by a government health authority (e.g., NHS Number for UK patients, EHIC number for EU patients, national health ID for international patients). Supports international patient identity standards and cross-border care coordination.' ;
    rdfs:domain ind:MpiRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:npiCrosswalkCount rdf:type rdf:Property ;
    rdfs:label 'Npi Crosswalk Count' ;
    rdfs:comment 'The number of distinct facility-level MRN crosswalk entries linked to this MPI golden record. Indicates the breadth of the patient\'s care history across the enterprise. Used for MPI quality monitoring and duplicate detection analytics.' ;
    rdfs:domain ind:MpiRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:patientClass rdf:type rdf:Property ;
    rdfs:label 'Patient Class' ;
    rdfs:comment 'The primary classification of the patient based on their predominant care setting and service utilization pattern. Drives billing, regulatory reporting, and population health segmentation. Sourced from ADT systems (Epic/Cerner). [ENUM-REF-CANDIDATE: inpatient|outpatient|emergency|observation|recurring|newborn|deceased — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preferredName rdf:type rdf:Property ;
    rdfs:label 'Preferred Name' ;
    rdfs:comment 'The name the patient prefers to be called, which may differ from their legal name. Supports patient-centered care and CAHPS patient experience requirements.' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryLanguageCode rdf:type rdf:Property ;
    rdfs:label 'Primary Language Code' ;
    rdfs:comment 'The ISO 639-1/639-2 language code representing the patient\'s primary spoken language (e.g., \'en\' for English, \'es\' for Spanish, \'zh\' for Chinese). Used to trigger interpreter services, translated materials, and CLAS Standards compliance.' ;
    rdfs:domain ind:MpiRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:raceCode rdf:type rdf:Property ;
    rdfs:label 'Race Code' ;
    rdfs:comment 'The patient\'s self-reported race using OMB/CDC race category codes. Collected per CMS health equity and USCDI requirements. Used for HEDIS disparity reporting, population health stratification, and health equity analytics. [ENUM-REF-CANDIDATE: 1002-5|2028-9|2054-5|2076-8|2106-3|2131-1|UNK — promote to reference product]' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:restrictedAccessFlag rdf:type rdf:Property ;
    rdfs:label 'Restricted Access Flag' ;
    rdfs:comment 'Indicates whether access to this patient\'s MPI record and associated PHI is restricted beyond standard role-based access controls. True = restricted access enforced. Applies to sensitive populations (e.g., behavioral health, HIV, substance abuse) per 42 CFR Part 2 and state law.' ;
    rdfs:domain ind:MpiRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sexAtBirth rdf:type rdf:Property ;
    rdfs:label 'Sex At Birth' ;
    rdfs:comment 'The patient\'s biological sex recorded at birth (M=Male, F=Female, X=Intersex/Other, U=Unknown). Used for clinical decision support, lab reference ranges, and CMS/HEDIS quality reporting. Distinct from gender identity.' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemCode rdf:type rdf:Property ;
    rdfs:label 'Source System Code' ;
    rdfs:comment 'The originating EHR or operational system that contributed the identity record that seeded this MPI golden record (e.g., EPIC=Epic EHR, CERNER=Cerner Millennium, MEDITECH=MEDITECH Expanse, HIE=Health Information Exchange). Supports data lineage and source system reconciliation. [ENUM-REF-CANDIDATE: EPIC|CERNER|MEDITECH|MANUAL|HIE|SALESFORCE_HC|EXTERNAL — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ssnLast4 rdf:type rdf:Property ;
    rdfs:label 'Ssn Last4' ;
    rdfs:comment 'The last four digits of the patient\'s Social Security Number (SSN). Stored in truncated form to support identity matching while minimizing PHI/PII exposure. Full SSN must not be stored in the silver layer per HIPAA minimum necessary standard.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unmergeReason rdf:type rdf:Property ;
    rdfs:label 'Unmerge Reason' ;
    rdfs:comment 'The documented reason for reversing a prior merge action on this MPI record. Supports patient safety investigation and HIM quality improvement workflows.' ;
    rdfs:domain ind:MpiRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unmergeTimestamp rdf:type rdf:Property ;
    rdfs:label 'Unmerge Timestamp' ;
    rdfs:comment 'The date and time when a previously merged MPI record was separated (unmerged) due to an overlay correction or erroneous merge reversal. Null if the record has never been unmerged. Critical patient safety audit field.' ;
    rdfs:domain ind:MpiRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:updatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Updated Timestamp' ;
    rdfs:comment 'Timestamp of the most recent update to the patient demographics record. Used for change data capture (CDC), ETL incremental loads, and audit trail compliance.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:vibeAddedFlag rdf:type rdf:Property ;
    rdfs:label 'Vibe Added Flag' ;
    rdfs:comment 'Marker added by VIBE batch to ensure touch' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:vibeAiAddedFlag rdf:type rdf:Property ;
    rdfs:label 'Vibe Ai Added Flag' ;
    rdfs:comment 'Marker added by VIBE mutator' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:vibeBatchMarker rdf:type rdf:Property ;
    rdfs:label 'Vibe Batch Marker' ;
    rdfs:comment 'Marker added by clinical domain batch mutator' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vibeMutationApplied rdf:type rdf:Property ;
    rdfs:label 'Vibe Mutation Applied' ;
    rdfs:comment 'Marker added by VIBE batch to indicate mutation applied.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vibeMutationMarker rdf:type rdf:Property ;
    rdfs:label 'Vibe Mutation Marker' ;
    rdfs:comment 'Marker attribute added by VIBE mutator to guarantee change' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vibeNewFlag rdf:type rdf:Property ;
    rdfs:label 'Vibe New Flag' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:vibeStructureMarker rdf:type rdf:Property ;
    rdfs:label 'Vibe Structure Marker' ;
    rdfs:comment 'structure enforcement marker' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vipFlag rdf:type rdf:Property ;
    rdfs:label 'Vip Flag' ;
    rdfs:comment 'Indicates whether the patient has been designated as a VIP (e.g., celebrity, executive, employee, or high-profile individual) requiring enhanced privacy protections and restricted access controls. True = VIP designation active. Triggers break-the-glass audit logging.' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:demographicsId rdf:type rdf:Property ;
    rdfs:label 'Demographics Id' ;
    rdfs:comment 'Unique surrogate identifier for the patient demographics record. Primary key for the demographics data product within the patient domain Silver layer.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Demographics .

ind:advanceDirectiveOnFile rdf:type rdf:Property ;
    rdfs:label 'Advance Directive On File' ;
    rdfs:comment 'Indicates whether the patient has an advance directive (e.g., living will, healthcare proxy, POLST) on file with the health system. Supports EMTALA-compliant emergency care and Joint Commission patient rights standards.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:birthDate rdf:type rdf:Property ;
    rdfs:label 'Birth Date' ;
    rdfs:comment 'Patient\'s date of birth in ISO 8601 format (yyyy-MM-dd). Core PHI element used for age calculation, eligibility verification, clinical decision support, and identity matching. Required by CMS and HIPAA.' ;
    rdfs:domain ind:Demographics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:birthTime rdf:type rdf:Property ;
    rdfs:label 'Birth Time' ;
    rdfs:comment 'Exact timestamp of the patient\'s birth. Clinically significant for neonatal records, multiple births, and vital statistics reporting to state health departments.' ;
    rdfs:domain ind:Demographics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:censusTract rdf:type rdf:Property ;
    rdfs:label 'Census Tract' ;
    rdfs:comment 'US Census Bureau census tract code derived from the patient\'s home address via geocoding. Enables Social Determinants of Health (SDOH) stratification, Area Deprivation Index (ADI) linkage, and population health analytics.' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deathCauseCode rdf:type rdf:Property ;
    rdfs:label 'Death Cause Code' ;
    rdfs:comment 'ICD-10-CM code representing the underlying cause of death as recorded on the death certificate. Used for vital statistics reporting, mortality analytics, and population health research.' ;
    rdfs:domain ind:Demographics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deathCertificateNumber rdf:type rdf:Property ;
    rdfs:label 'Death Certificate Number' ;
    rdfs:comment 'State-issued death certificate reference number. Used to cross-reference vital statistics records and support legal and administrative processes following patient death.' ;
    rdfs:domain ind:Demographics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deathDate rdf:type rdf:Property ;
    rdfs:label 'Death Date' ;
    rdfs:comment 'Date the patient was pronounced deceased (yyyy-MM-dd). Required for vital statistics reporting, care plan closure, and population health mortality analytics. Sourced from Epic ADT or state vital records.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:deceasedIndicator rdf:type rdf:Property ;
    rdfs:label 'Deceased Indicator' ;
    rdfs:comment 'Indicates whether the patient is deceased. Triggers suppression of outreach communications, updates to active care plans, and vital statistics reporting workflows.' ;
    rdfs:domain ind:Demographics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:emailAddress rdf:type rdf:Property ;
    rdfs:label 'Email Address' ;
    rdfs:comment 'Patient\'s primary email address for electronic communications including appointment reminders, patient portal access, and health education materials. PHI per HIPAA when combined with health information.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:enterpriseMrn rdf:type rdf:Property ;
    rdfs:label 'Enterprise Mrn' ;
    rdfs:comment 'Cross-facility enterprise-level MRN assigned by the Master Patient Index (MPI) to uniquely identify the patient across all facilities and care sites within the health system.' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:homeAddressLine1 rdf:type rdf:Property ;
    rdfs:label 'Home Address Line1' ;
    rdfs:comment 'Primary street address line for the patient\'s home residence. Used for correspondence, population health outreach, SDOH census tract linkage, and vital statistics reporting.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:homeAddressLine2 rdf:type rdf:Property ;
    rdfs:label 'Home Address Line2' ;
    rdfs:comment 'Secondary address line for the patient\'s home residence (apartment, suite, unit number). Supplements home_address_line1 for complete address resolution.' ;
    rdfs:domain ind:Demographics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:homeCity rdf:type rdf:Property ;
    rdfs:label 'Home City' ;
    rdfs:comment 'City of the patient\'s home residence address. Used for geographic analysis, population health stratification, and service area reporting.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:homeCountryCode rdf:type rdf:Property ;
    rdfs:label 'Home Country Code' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code for the patient\'s home residence (e.g., USA, CAN, MEX). Supports international patient management and cross-border care coordination.' ;
    rdfs:domain ind:Demographics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:homePostalCode rdf:type rdf:Property ;
    rdfs:label 'Home Postal Code' ;
    rdfs:comment 'ZIP or ZIP+4 postal code for the patient\'s home residence. Used for geographic analysis, SDOH census tract linkage, population health outreach, and payer eligibility verification.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:homeState rdf:type rdf:Property ;
    rdfs:label 'Home State' ;
    rdfs:comment 'Two-letter USPS state abbreviation for the patient\'s home residence. Used for state-level regulatory reporting, vital statistics, and payer eligibility.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interpreterRequired rdf:type rdf:Property ;
    rdfs:label 'Interpreter Required' ;
    rdfs:comment 'Indicates whether the patient requires a professional interpreter for clinical encounters. Triggers interpreter service workflows in scheduling and ADT systems. Supports EMTALA and Title VI compliance.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mailingAddressLine1 rdf:type rdf:Property ;
    rdfs:label 'Mailing Address Line1' ;
    rdfs:comment 'Primary street address line for the patient\'s mailing address when different from home address. Used for correspondence, EOB delivery, and appointment reminders.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mailingAddressSameAsHome rdf:type rdf:Property ;
    rdfs:label 'Mailing Address Same As Home' ;
    rdfs:comment 'Indicates whether the patient\'s mailing address is identical to their home address. When True, mailing address fields are not separately stored. Simplifies address management in multi-address scenarios.' ;
    rdfs:domain ind:Demographics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mailingCity rdf:type rdf:Property ;
    rdfs:label 'Mailing City' ;
    rdfs:comment 'City of the patient\'s mailing address when different from home address.' ;
    rdfs:domain ind:Demographics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mailingPostalCode rdf:type rdf:Property ;
    rdfs:label 'Mailing Postal Code' ;
    rdfs:comment 'ZIP or ZIP+4 postal code for the patient\'s mailing address when different from home address.' ;
    rdfs:domain ind:Demographics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mailingState rdf:type rdf:Property ;
    rdfs:label 'Mailing State' ;
    rdfs:comment 'Two-letter USPS state abbreviation for the patient\'s mailing address when different from home address.' ;
    rdfs:domain ind:Demographics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maritalStatus rdf:type rdf:Property ;
    rdfs:label 'Marital Status' ;
    rdfs:comment 'Patient\'s current marital or domestic partnership status. Used in social history documentation, insurance coordination of benefits, and next-of-kin determination. Sourced from Epic ADT registration. [ENUM-REF-CANDIDATE: single|married|divorced|widowed|separated|domestic_partner|unknown — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Demographics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:patientPortalEnrolled rdf:type rdf:Property ;
    rdfs:label 'Patient Portal Enrolled' ;
    rdfs:comment 'Indicates whether the patient is enrolled in the health system\'s patient portal (e.g., MyChart in Epic). Supports patient engagement metrics, Meaningful Use/Promoting Interoperability reporting, and digital health outreach.' ;
    rdfs:domain ind:Demographics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:preferredLanguageCode rdf:type rdf:Property ;
    rdfs:label 'Preferred Language Code' ;
    rdfs:comment 'Patient\'s preferred spoken/written language for healthcare communications, expressed as an ISO 639-1 or 639-2 language code (e.g., \'en\', \'es\', \'zh\'). Drives interpreter services, patient education material selection, and EMTALA-compliant communication. Required by CMS and Title VI of the Civil Rights Act.' ;
    rdfs:domain ind:Demographics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryPhone rdf:type rdf:Property ;
    rdfs:label 'Primary Phone' ;
    rdfs:comment 'Patient\'s primary contact telephone number. Used for appointment reminders, care coordination, and emergency contact. Sourced from Epic ADT registration.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryPhoneType rdf:type rdf:Property ;
    rdfs:label 'Primary Phone Type' ;
    rdfs:comment 'Classification of the patient\'s primary phone number (home landline, mobile/cell, work). Determines eligibility for automated outreach under TCPA regulations.' ;
    rdfs:domain ind:Demographics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pronouns rdf:type rdf:Property ;
    rdfs:label 'Pronouns' ;
    rdfs:comment 'Patient\'s preferred personal pronouns for use in clinical communications and care team interactions. Supports inclusive, patient-centered care and Joint Commission standards.' ;
    rdfs:domain ind:Demographics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:raceDescription rdf:type rdf:Property ;
    rdfs:label 'Race Description' ;
    rdfs:comment 'Human-readable description of the patient\'s self-reported race category (e.g., \'American Indian or Alaska Native\', \'Asian\', \'Black or African American\'). Paired with race_code for display and reporting.' ;
    rdfs:domain ind:Demographics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:registrationStatus rdf:type rdf:Property ;
    rdfs:label 'Registration Status' ;
    rdfs:comment 'Current lifecycle status of the patient\'s demographic record in the MPI. Active=current patient, Inactive=no recent encounters, Merged=duplicate resolved into another record, Deceased=patient has died, Test=test/training record.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:religionCode rdf:type rdf:Property ;
    rdfs:label 'Religion Code' ;
    rdfs:comment 'Patient\'s self-reported religious affiliation using HL7 v3 ReligiousAffiliation code set. Informs chaplaincy services, dietary restrictions, end-of-life care preferences, and culturally competent care delivery. [ENUM-REF-CANDIDATE: promote to reference product per HL7 v3 ReligiousAffiliation value set]' ;
    rdfs:domain ind:Demographics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sdohFoodInsecurity rdf:type rdf:Property ;
    rdfs:label 'Sdoh Food Insecurity' ;
    rdfs:comment 'Indicates whether the patient has screened positive for food insecurity. Core SDOH data element supporting care management referrals, population health stratification, and CMS health equity reporting.' ;
    rdfs:domain ind:Demographics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sdohHousingStatus rdf:type rdf:Property ;
    rdfs:label 'Sdoh Housing Status' ;
    rdfs:comment 'Patient\'s self-reported housing stability status. Core SDOH data element used for population health stratification, care management prioritization, and CMS health equity reporting.' ;
    rdfs:domain ind:Demographics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:secondaryPhone rdf:type rdf:Property ;
    rdfs:label 'Secondary Phone' ;
    rdfs:comment 'Patient\'s secondary contact telephone number. Used as a fallback contact channel when the primary phone is unreachable.' ;
    rdfs:domain ind:Demographics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vipIndicator rdf:type rdf:Property ;
    rdfs:label 'Vip Indicator' ;
    rdfs:comment 'Flags the patient as a VIP (e.g., celebrity, executive, employee, or high-profile individual) requiring enhanced privacy protections and special handling protocols. Triggers restricted access controls and audit logging per HIPAA minimum necessary standard.' ;
    rdfs:domain ind:Demographics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:addressId rdf:type rdf:Property ;
    rdfs:label 'Address Id' ;
    rdfs:comment 'Unique surrogate identifier for each patient address record in the Master Patient Index (MPI). Primary key for the patient.address data product.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:geographicRegionId rdf:type rdf:Property ;
    rdfs:label 'Geographic Region Id' ;
    rdfs:comment 'Foreign key linking to reference.geographic_region. Business justification: Patient address links to geographic region for SDOH analytics (area deprivation index, poverty rates, uninsured rates), population health stratification, health equity reporting, and community health ' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GeographicRegion .

ind:addressStatus rdf:type rdf:Property ;
    rdfs:label 'Address Status' ;
    rdfs:comment 'Current lifecycle status of the address record. Active indicates the address is in use; inactive indicates it has been superseded; undeliverable indicates mail has been returned or the address is not reachable; returned_mail indicates USPS or courier returned correspondence.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:addressType rdf:type rdf:Property ;
    rdfs:label 'Address Type' ;
    rdfs:comment 'Classifies the purpose of the address record. Supported types: home (primary residence), mailing (preferred correspondence), temporary (short-term stay), work (employer location), billing (financial correspondence), guarantor (responsible party address). [ENUM-REF-CANDIDATE: home|mailing|temporary|work|billing|guarantor — promote to reference product if additional types are needed]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:areaDeprivationIndex rdf:type rdf:Property ;
    rdfs:label 'Area Deprivation Index' ;
    rdfs:comment 'National Area Deprivation Index (ADI) score derived from the census tract of this address, ranging from 1 (least deprived) to 100 (most deprived). Used for SDOH risk stratification, population health segmentation, and value-based care program targeting.' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:city rdf:type rdf:Property ;
    rdfs:label 'City' ;
    rdfs:comment 'City or municipality of the patient address. Used for population health outreach, care gap closure, and Social Determinants of Health (SDOH) stratification.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:countryCode rdf:type rdf:Property ;
    rdfs:label 'Country Code' ;
    rdfs:comment 'ISO 3166-1 alpha-3 three-letter country code for the address (e.g., USA, CAN, MEX). Supports international patient populations and cross-border care coordination.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:county rdf:type rdf:Property ;
    rdfs:label 'County' ;
    rdfs:comment 'County or parish name associated with the patient address. Used for SDOH stratification, public health reporting, and county-level population health analytics.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:countyFipsCode rdf:type rdf:Property ;
    rdfs:label 'County Fips Code' ;
    rdfs:comment 'Five-digit Federal Information Processing Standards (FIPS) code uniquely identifying the county. Enables linkage to census data, Area Deprivation Index (ADI), and federal SDOH datasets for population health management.' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:digitalHealthIntegrationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Digital Health Integration Timestamp' ;
    rdfs:comment 'Timestamp of digital health integration' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:digitalHealthMarker rdf:type rdf:Property ;
    rdfs:label 'Digital Health Marker' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:district rdf:type rdf:Property ;
    rdfs:label 'District' ;
    rdfs:comment 'Administrative district or borough associated with the address. Used in urban markets and international patient populations for sub-county geographic segmentation and population health reporting.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:doNotContactReason rdf:type rdf:Property ;
    rdfs:label 'Do Not Contact Reason' ;
    rdfs:comment 'Free-text or coded reason why the patient has requested no contact at this address (e.g., patient request, domestic violence protection, deceased, address undeliverable). Supports HIPAA confidential communications compliance and patient preference management.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:effectiveEndDate rdf:type rdf:Property ;
    rdfs:label 'Effective End Date' ;
    rdfs:comment 'Date on which this address record is no longer active for the patient. Null indicates the address is currently active. Supports historical address tracking and transitions of care documentation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:effectiveStartDate rdf:type rdf:Property ;
    rdfs:label 'Effective Start Date' ;
    rdfs:comment 'Date from which this address record is considered active and valid for the patient. Supports temporal address management, enabling historical address lookups and point-in-time reporting for care coordination and billing.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:geocodePrecision rdf:type rdf:Property ;
    rdfs:label 'Geocode Precision' ;
    rdfs:comment 'Precision level of the geocoded coordinates indicating how accurately the latitude/longitude represents the address. Rooftop is highest precision; ungeocoded indicates geocoding has not been performed or failed.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:healthServiceArea rdf:type rdf:Property ;
    rdfs:label 'Health Service Area' ;
    rdfs:comment 'Dartmouth Atlas Health Service Area (HSA) or facility-defined service area code associated with the address. Used for population health management, market analysis, and care utilization reporting.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:housingType rdf:type rdf:Property ;
    rdfs:label 'Housing Type' ;
    rdfs:comment 'Categorizes the patient\'s housing situation at this address. Supports Social Determinants of Health (SDOH) screening, housing instability risk stratification, and population health management programs. Aligned with AHRQ SDOH domain of housing instability.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isConfidential rdf:type rdf:Property ;
    rdfs:label 'Is Confidential' ;
    rdfs:comment 'Indicates the address is marked confidential and must not be disclosed to unauthorized parties, including family members. Supports domestic violence protections, sensitive patient situations, and HIPAA confidential communications requirements under 45 CFR §164.522(b).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isDoNotMail rdf:type rdf:Property ;
    rdfs:label 'Is Do Not Mail' ;
    rdfs:comment 'Indicates the patient has requested that no physical mail be sent to this address. Enforced during population health outreach, care gap closure mailings, and marketing communications to honor patient preferences and comply with HIPAA minimum necessary standards.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPrimary rdf:type rdf:Property ;
    rdfs:label 'Is Primary' ;
    rdfs:comment 'Indicates whether this address is the patient\'s primary address of record. Only one address per patient should be flagged as primary at any given time. Used by clinical and billing systems to select the default address for correspondence.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:latitude rdf:type rdf:Property ;
    rdfs:label 'Latitude' ;
    rdfs:comment 'Geographic latitude coordinate (decimal degrees, WGS84) derived from geocoding the address. Supports spatial analytics, drive-time analysis, care access mapping, and population health outreach routing.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:line1 rdf:type rdf:Property ;
    rdfs:label 'Line1' ;
    rdfs:comment 'Primary street address line including house/building number and street name. First line of the patient\'s physical or mailing address as captured in Epic or Cerner registration.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:line2 rdf:type rdf:Property ;
    rdfs:label 'Line2' ;
    rdfs:comment 'Secondary address line for apartment, suite, unit, floor, or building designator. Supplements address_line1 for multi-unit dwellings.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:longitude rdf:type rdf:Property ;
    rdfs:label 'Longitude' ;
    rdfs:comment 'Geographic longitude coordinate (decimal degrees, WGS84) derived from geocoding the address. Supports spatial analytics, drive-time analysis, care access mapping, and population health outreach routing.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:moveInDate rdf:type rdf:Property ;
    rdfs:label 'Move In Date' ;
    rdfs:comment 'Date the patient moved into or began residing at this address, as reported by the patient during registration or updated via patient portal. Supports address tenure analysis and SDOH housing stability assessments.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:moveOutDate rdf:type rdf:Property ;
    rdfs:label 'Move Out Date' ;
    rdfs:comment 'Date the patient moved out of or ceased residing at this address, as reported during registration update or returned mail processing. Used to close address records and trigger re-registration workflows.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:mutatorAddedFlag rdf:type rdf:Property ;
    rdfs:label 'Mutator Added Flag' ;
    rdfs:comment 'Flag added by mutator to ensure model change.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ncoaMatchCode rdf:type rdf:Property ;
    rdfs:label 'Ncoa Match Code' ;
    rdfs:comment 'USPS NCOA match result code indicating the outcome of the change-of-address lookup (e.g., individual match, family match, business match, no match, moved with no forwarding address). Used to assess address currency and trigger update workflows.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ncoaUpdateDate rdf:type rdf:Property ;
    rdfs:label 'Ncoa Update Date' ;
    rdfs:comment 'Date on which this address was last updated via USPS National Change of Address (NCOA) processing. Supports address hygiene programs and ensures outreach mailings reach patients who have relocated.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:postalCode rdf:type rdf:Property ;
    rdfs:label 'Postal Code' ;
    rdfs:comment 'USPS ZIP or ZIP+4 postal code for the address. Used for geographic routing, population health outreach, and SDOH analysis. Note: Per HIPAA Safe Harbor, full 9-digit ZIP codes for small geographic areas may require de-identification.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preferredLanguage rdf:type rdf:Property ;
    rdfs:label 'Preferred Language' ;
    rdfs:comment 'ISO 639-1 or ISO 639-2 language code representing the patient\'s preferred language for written communications sent to this address (e.g., en, es, zh). Supports culturally competent outreach and CMS language access requirements.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sdohHousingInstabilityFlag rdf:type rdf:Property ;
    rdfs:label 'Sdoh Housing Instability Flag' ;
    rdfs:comment 'Indicates the patient has been identified as experiencing housing instability at this address based on SDOH screening (e.g., PRAPARE, AHC HRSN). Triggers care management interventions and community resource referrals.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sourceSystemAddressCode rdf:type rdf:Property ;
    rdfs:label 'Source System Address Code' ;
    rdfs:comment 'Native identifier for this address record in the originating operational system (e.g., Epic address record ID, Cerner address sequence number). Supports ETL reconciliation, deduplication, and cross-system traceability.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateCode rdf:type rdf:Property ;
    rdfs:label 'State Code' ;
    rdfs:comment 'Two-letter USPS state or territory abbreviation (e.g., CA, TX, NY). Used for state-level regulatory reporting, licensure verification, and population health segmentation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:updatedBy rdf:type rdf:Property ;
    rdfs:label 'Updated By' ;
    rdfs:comment 'Username or system identifier of the user or automated process that last modified this address record. Supports HIPAA audit trail requirements and data stewardship accountability.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:urbanRuralClassification rdf:type rdf:Property ;
    rdfs:label 'Urban Rural Classification' ;
    rdfs:comment 'Classifies the address location as urban, suburban, rural, or frontier based on USDA Rural-Urban Commuting Area (RUCA) codes or HRSA definitions. Used for CMS geographic payment adjustments, rural health program eligibility, and access-to-care analytics.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:validationDate rdf:type rdf:Property ;
    rdfs:label 'Validation Date' ;
    rdfs:comment 'Date on which the address was last validated against USPS or a third-party address verification service. Supports re-validation scheduling and data quality monitoring.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:validationSource rdf:type rdf:Property ;
    rdfs:label 'Validation Source' ;
    rdfs:comment 'Name of the system or service used to validate the address (e.g., USPS CASS, Melissa Data, SmartyStreets, Epic Address Validation). Supports audit trails for address quality management.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:validationStatus rdf:type rdf:Property ;
    rdfs:label 'Validation Status' ;
    rdfs:comment 'Current USPS or third-party address validation status. Validated indicates the address was confirmed deliverable by USPS CASS certification or equivalent. Corrected indicates the address was standardized during validation. Used to ensure accuracy of outreach mailings and care gap closure communications.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vibeMutationExtra rdf:type rdf:Property ;
    rdfs:label 'Vibe Mutation Extra' ;
    rdfs:comment 'Added by VIBE mutation to ensure non-empty diff' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vibeMutationMarkerAdded rdf:type rdf:Property ;
    rdfs:label 'Vibe Mutation Marker Added' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vibeTypeNormalizationMarker rdf:type rdf:Property ;
    rdfs:label 'Vibe Type Normalization Marker' ;
    rdfs:comment 'Marker recording that type/classification normalization pass was applied.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:insuranceCoverageId rdf:type rdf:Property ;
    rdfs:label 'Insurance Coverage Id' ;
    rdfs:comment 'Unique surrogate identifier for each insurance coverage record in the patient domain. Primary key for the insurance_coverage data product.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:InsuranceCoverage .

ind:insuranceMemberMpiRecordId rdf:type rdf:Property ;
    rdfs:label 'Insurance Member Mpi Record Id' ;
    rdfs:comment 'The insurance member identification number assigned by the payer to uniquely identify the insured individual. Used in eligibility verification (X12 270/271), claims submission (CMS-1500, UB-04), and Electronic Remittance Advice (ERA) matching.' ;
    rdfs:domain ind:InsuranceCoverage ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MpiRecord .

ind:insuranceMpiRecordId rdf:type rdf:Property ;
    rdfs:label 'Insurance Mpi Record Id' ;
    rdfs:comment 'Reference to the patient whose insurance coverage this record describes. Links to the master patient record via the Master Patient Index (MPI).' ;
    rdfs:domain ind:InsuranceCoverage ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MpiRecord .

ind:payerId rdf:type rdf:Property ;
    rdfs:label 'Payer Id' ;
    rdfs:comment 'Reference to the insurance payer organization responsible for adjudicating claims under this coverage. Aligns with the payer master in the reference data domain.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Payer .

ind:benefitYearEnd rdf:type rdf:Property ;
    rdfs:label 'Benefit Year End' ;
    rdfs:comment 'The end date of the insurance plan\'s benefit year (plan year). Used to reset deductible and out-of-pocket accumulator tracking and to identify coverage renewal requirements.' ;
    rdfs:domain ind:InsuranceCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:benefitYearStart rdf:type rdf:Property ;
    rdfs:label 'Benefit Year Start' ;
    rdfs:comment 'The start date of the insurance plan\'s benefit year (plan year). Used to reset deductible and out-of-pocket accumulator tracking. May differ from the coverage effective date for mid-year enrollments.' ;
    rdfs:domain ind:InsuranceCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cobPriority rdf:type rdf:Property ;
    rdfs:label 'Cob Priority' ;
    rdfs:comment 'Numeric priority order for Coordination of Benefits (COB) when a patient has multiple insurance coverages. 1 = primary payer, 2 = secondary payer, 3 = tertiary payer. Governs claim submission sequencing and payment responsibility allocation.' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:coinsuranceRate rdf:type rdf:Property ;
    rdfs:label 'Coinsurance Rate' ;
    rdfs:comment 'The percentage of covered service costs the patient is responsible for after the deductible is met, expressed as a decimal (e.g., 0.2000 = 20%). Used in patient financial counseling and Revenue Cycle Management (RCM) estimation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:copayAmount rdf:type rdf:Property ;
    rdfs:label 'Copay Amount' ;
    rdfs:comment 'The fixed dollar amount the patient is required to pay at the time of service for a covered visit or procedure (e.g., $25 primary care, $50 specialist). Used in point-of-service collection and patient financial counseling.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:coverageStatus rdf:type rdf:Property ;
    rdfs:label 'Coverage Status' ;
    rdfs:comment 'Current lifecycle status of the insurance coverage record. Drives eligibility verification workflows, claim submission eligibility, and front-end Revenue Cycle Management (RCM) processes. Active = currently valid; Pending = awaiting confirmation; Terminated = coverage ended; Suspended = temporarily inactive.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deductibleAmount rdf:type rdf:Property ;
    rdfs:label 'Deductible Amount' ;
    rdfs:comment 'The annual deductible amount the patient must pay out-of-pocket before the insurance plan begins covering costs. Expressed in USD. Used in patient financial counseling, prior authorization, and Revenue Cycle Management (RCM) workflows.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:deductibleMetAmount rdf:type rdf:Property ;
    rdfs:label 'Deductible Met Amount' ;
    rdfs:comment 'The year-to-date amount the patient has applied toward their annual deductible. Sourced from real-time eligibility verification (X12 271) responses. Used in patient financial counseling and point-of-service collection.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:effectiveDate rdf:type rdf:Property ;
    rdfs:label 'Effective Date' ;
    rdfs:comment 'The date on which the insurance coverage becomes effective and claims may be submitted. Used in eligibility verification and coordination of benefits (COB) sequencing. Aligns with X12 271 DTP*356 segment.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:eligibilityResponseCode rdf:type rdf:Property ;
    rdfs:label 'Eligibility Response Code' ;
    rdfs:comment 'The X12 271 AAA or EB segment response code returned by the payer during eligibility verification, indicating the specific eligibility status or rejection reason (e.g., \'1\' = Active Coverage, \'AAA\' = Rejection). Supports denial prevention and RCM analytics.' ;
    rdfs:domain ind:InsuranceCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eligibilityTransactionNumber rdf:type rdf:Property ;
    rdfs:label 'Eligibility Transaction Number' ;
    rdfs:comment 'The unique transaction control number (TCN) or trace number assigned to the X12 270/271 eligibility verification transaction or FHIR CoverageEligibilityRequest. Enables end-to-end audit trail and transaction reconciliation.' ;
    rdfs:domain ind:InsuranceCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eligibilityVerificationMethod rdf:type rdf:Property ;
    rdfs:label 'Eligibility Verification Method' ;
    rdfs:comment 'The method used to perform the most recent eligibility verification for this coverage. Supports audit trail requirements and verification workflow analytics. EDI_270_271 = X12 batch or real-time transaction; portal = payer web portal; phone = verbal verification; real_time_API = FHIR-based real-time check.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eligibilityVerificationStatus rdf:type rdf:Property ;
    rdfs:label 'Eligibility Verification Status' ;
    rdfs:comment 'The current status of the most recent eligibility verification transaction for this coverage record. Reflects the outcome of X12 270/271 EDI, portal, or phone-based verification. Drives front-end Revenue Cycle Management (RCM) workflows and claim denial prevention.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eligibilityVerifiedBy rdf:type rdf:Property ;
    rdfs:label 'Eligibility Verified By' ;
    rdfs:comment 'The name or system identifier of the staff member, automated process, or clearinghouse that performed the most recent eligibility verification. Supports audit trail and accountability for Revenue Cycle Management (RCM) workflows.' ;
    rdfs:domain ind:InsuranceCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eligibilityVerifiedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Eligibility Verified Timestamp' ;
    rdfs:comment 'The date and time when the most recent eligibility verification was completed. Used in the eligibility verification audit trail and to determine whether re-verification is required based on payer-specific or organizational SLA policies.' ;
    rdfs:domain ind:InsuranceCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:groupNumber rdf:type rdf:Property ;
    rdfs:label 'Group Number' ;
    rdfs:comment 'The employer or group plan number assigned by the payer that identifies the specific group policy under which the member is covered. Required for claims submission and eligibility verification.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:insuranceCardBackUrl rdf:type rdf:Property ;
    rdfs:label 'Insurance Card Back Url' ;
    rdfs:comment 'Secure URL or document reference to the scanned or photographed back of the patient\'s insurance card. Stored in a HIPAA-compliant document management system. Contains payer contact information and claims submission instructions.' ;
    rdfs:domain ind:InsuranceCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:insuranceCardFrontUrl rdf:type rdf:Property ;
    rdfs:label 'Insurance Card Front Url' ;
    rdfs:comment 'Secure URL or document reference to the scanned or photographed front of the patient\'s insurance card. Stored in a HIPAA-compliant document management system. Used for manual verification and patient registration workflows.' ;
    rdfs:domain ind:InsuranceCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicaidStateCode rdf:type rdf:Property ;
    rdfs:label 'Medicaid State Code' ;
    rdfs:comment 'Two-letter US state code identifying the state Medicaid program under which the patient is enrolled. Null for non-Medicaid plans. Required for Medicaid claim submission and state-specific billing rules.' ;
    rdfs:domain ind:InsuranceCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicarePart rdf:type rdf:Property ;
    rdfs:label 'Medicare Part' ;
    rdfs:comment 'For Medicare coverage, identifies the specific Medicare part: A (Hospital Insurance), B (Medical Insurance), C (Medicare Advantage/HMO), or D (Prescription Drug Coverage). Null for non-Medicare plans. Drives CMS billing rules and claim form selection.' ;
    rdfs:domain ind:InsuranceCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:networkStatus rdf:type rdf:Property ;
    rdfs:label 'Network Status' ;
    rdfs:comment 'Indicates whether the patient\'s coverage is being used within the payer\'s contracted provider network (in-network) or outside it (out-of-network). Affects patient cost-sharing, claim adjudication rates, and denial risk.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outOfPocketMax rdf:type rdf:Property ;
    rdfs:label 'Out Of Pocket Max' ;
    rdfs:comment 'The maximum annual amount the patient is required to pay out-of-pocket for covered services, after which the plan covers 100% of costs. Used in patient financial counseling and Revenue Cycle Management (RCM) workflows.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:outOfPocketMetAmount rdf:type rdf:Property ;
    rdfs:label 'Out Of Pocket Met Amount' ;
    rdfs:comment 'The year-to-date amount the patient has applied toward their annual out-of-pocket maximum. Sourced from real-time eligibility verification (X12 271) responses. Informs point-of-service collection decisions.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:payerElectronicNumber rdf:type rdf:Property ;
    rdfs:label 'Payer Electronic Number' ;
    rdfs:comment 'The electronic payer identification number used for submitting X12 EDI transactions (270/271 eligibility, 837 claims). Also known as the EDI payer ID or clearinghouse payer ID. Distinct from the NPI.' ;
    rdfs:domain ind:InsuranceCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planName rdf:type rdf:Property ;
    rdfs:label 'Plan Name' ;
    rdfs:comment 'The commercial name of the insurance plan as designated by the payer (e.g., \'Blue Shield PPO Gold\', \'Aetna HMO Select\'). Used for patient-facing communications and Revenue Cycle Management (RCM) workflows.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planType rdf:type rdf:Property ;
    rdfs:label 'Plan Type' ;
    rdfs:comment 'Classification of the insurance plan type indicating the network and coverage structure. Drives prior authorization requirements, referral rules, and claim adjudication logic. [ENUM-REF-CANDIDATE: HMO|PPO|POS|EPO|Medicare|Medicaid|self_pay|TRICARE|CHIP|workers_comp|commercial — promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorAuthRequired rdf:type rdf:Property ;
    rdfs:label 'Prior Auth Required' ;
    rdfs:comment 'Indicates whether the insurance plan requires prior authorization (pre-authorization) before certain services, procedures, or medications are covered. Drives pre-authorization workflows in Order Management and Surgical/Procedural Scheduling.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:referralRequired rdf:type rdf:Property ;
    rdfs:label 'Referral Required' ;
    rdfs:comment 'Indicates whether the insurance plan requires a referral from a Primary Care Physician (PCP) before the patient can see a specialist. Applicable primarily to Health Maintenance Organization (HMO) and Point of Service (POS) plans.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rxBin rdf:type rdf:Property ;
    rdfs:label 'Rx Bin' ;
    rdfs:comment 'The 6-digit Bank Identification Number (BIN) used to route pharmacy claims to the correct Pharmacy Benefit Manager (PBM). Printed on the insurance card and required for real-time pharmacy eligibility and adjudication via NCPDP SCRIPT standard.' ;
    rdfs:domain ind:InsuranceCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rxGroup rdf:type rdf:Property ;
    rdfs:label 'Rx Group' ;
    rdfs:comment 'The pharmacy benefit group number used to identify the specific pharmacy benefit plan within the Pharmacy Benefit Manager (PBM) system. Printed on the insurance card alongside RxBIN and PCN.' ;
    rdfs:domain ind:InsuranceCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rxPcn rdf:type rdf:Property ;
    rdfs:label 'Rx Pcn' ;
    rdfs:comment 'The Processor Control Number (PCN) used in conjunction with the RxBIN to route pharmacy claims to the correct sub-processor within the Pharmacy Benefit Manager (PBM). Required for pharmacy eligibility verification.' ;
    rdfs:domain ind:InsuranceCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemRecordCode rdf:type rdf:Property ;
    rdfs:label 'Source System Record Code' ;
    rdfs:comment 'The native primary key or record identifier for this coverage record in the originating operational system (e.g., Epic coverage record ID, Cerner insurance record ID). Enables traceability from the Silver layer back to the system of record.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subscriberRelationship rdf:type rdf:Property ;
    rdfs:label 'Subscriber Relationship' ;
    rdfs:comment 'The relationship of the patient (beneficiary) to the primary insurance subscriber. Determines coordination of benefits (COB) rules and claim filing requirements. \'Self\' indicates the patient is the primary subscriber.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:terminationDate rdf:type rdf:Property ;
    rdfs:label 'Termination Date' ;
    rdfs:comment 'The date on which the insurance coverage ends or is terminated. Null indicates open-ended active coverage. Used to prevent claim submission for services rendered outside the coverage period. Aligns with X12 271 DTP*357 segment.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:guarantorId rdf:type rdf:Property ;
    rdfs:label 'Guarantor Id' ;
    rdfs:comment 'Unique surrogate identifier for the financial guarantor record within the patient accounting system. Primary key for the guarantor entity; referenced by patient account and billing records across the Revenue Cycle Management (RCM) domain.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Guarantor .

ind:accountBalance rdf:type rdf:Property ;
    rdfs:label 'Account Balance' ;
    rdfs:comment 'Current outstanding balance owed by the guarantor on the patient account in USD. Represents the net self-pay balance after insurance adjudication, contractual adjustments, and payments applied. Core metric for RCM self-pay collection and patient financial counseling.' ;
    rdfs:domain ind:Guarantor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:accountNumber rdf:type rdf:Property ;
    rdfs:label 'Account Number' ;
    rdfs:comment 'Externally-known patient accounting number assigned to the guarantor account in the EHR revenue cycle or patient accounting system (e.g., Epic Resolute HB guarantor account number). Used by billing staff, financial counselors, and self-pay collection teams to identify and reference the account.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accountStatus rdf:type rdf:Property ;
    rdfs:label 'Account Status' ;
    rdfs:comment 'Current lifecycle status of the guarantor account within the Revenue Cycle Management (RCM) workflow. Drives billing, collection, and write-off processes. [ENUM-REF-CANDIDATE: active|inactive|collections|bad_debt|deceased|bankruptcy — promote to reference product if additional statuses are required]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:addressLine1 rdf:type rdf:Property ;
    rdfs:label 'Address Line1' ;
    rdfs:comment 'Primary street address line of the guarantor\'s mailing or billing address. Used for billing statement delivery, collection correspondence, and address verification in RCM workflows.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:addressLine2 rdf:type rdf:Property ;
    rdfs:label 'Address Line2' ;
    rdfs:comment 'Secondary address line for the guarantor (apartment, suite, unit, floor, PO Box). Supplements address_line1 for complete mailing address used in billing and collection correspondence.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:annualIncome rdf:type rdf:Property ;
    rdfs:label 'Annual Income' ;
    rdfs:comment 'Self-reported or verified annual gross income of the guarantor in USD. Used for financial assistance (charity care) eligibility screening, sliding-scale fee determination, and payment plan structuring per CMS and ACA financial assistance requirements.' ;
    rdfs:domain ind:Guarantor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:badDebtFlag rdf:type rdf:Property ;
    rdfs:label 'Bad Debt Flag' ;
    rdfs:comment 'Indicates whether the guarantor account balance has been written off as bad debt in the patient accounting system. Supports financial reporting, bad debt reserve calculations, and RAC audit documentation per GAAP and CMS guidelines.' ;
    rdfs:domain ind:Guarantor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bankruptcyFlag rdf:type rdf:Property ;
    rdfs:label 'Bankruptcy Flag' ;
    rdfs:comment 'Indicates whether the guarantor has filed for bankruptcy protection. When True, all collection activities must cease immediately per the automatic stay provisions of the U.S. Bankruptcy Code (11 U.S.C. §362) and the account is flagged for legal review.' ;
    rdfs:domain ind:Guarantor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:collectionAgencyFlag rdf:type rdf:Property ;
    rdfs:label 'Collection Agency Flag' ;
    rdfs:comment 'Indicates whether the guarantor account has been referred to an external collection agency for bad debt recovery. When True, direct billing and collection activities by the healthcare organization are suspended per FDCPA requirements.' ;
    rdfs:domain ind:Guarantor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:doNotContactFlag rdf:type rdf:Property ;
    rdfs:label 'Do Not Contact Flag' ;
    rdfs:comment 'Indicates whether the guarantor has requested cessation of all billing and collection contact. When True, all outreach activities are suppressed in compliance with FDCPA cease-and-desist provisions and HIPAA patient rights.' ;
    rdfs:domain ind:Guarantor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:employerName rdf:type rdf:Property ;
    rdfs:label 'Employer Name' ;
    rdfs:comment 'Name of the guarantor\'s current employer. Used in financial counseling, self-pay collection assessments, and financial assistance (charity care) eligibility screening to evaluate ability to pay.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:employerPhone rdf:type rdf:Property ;
    rdfs:label 'Employer Phone' ;
    rdfs:comment 'Phone number of the guarantor\'s employer. Used in self-pay collection processes and financial counseling to verify employment status and facilitate payment arrangements.' ;
    rdfs:domain ind:Guarantor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:employmentStatus rdf:type rdf:Property ;
    rdfs:label 'Employment Status' ;
    rdfs:comment 'Current employment status of the guarantor. Used in financial assistance (charity care) eligibility determination, payment plan structuring, and self-pay collection risk stratification. [ENUM-REF-CANDIDATE: employed_full_time|employed_part_time|self_employed|unemployed|retired|student|disabled — promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estatementConsentFlag rdf:type rdf:Property ;
    rdfs:label 'Estatement Consent Flag' ;
    rdfs:comment 'Indicates whether the guarantor has consented to receive electronic billing statements (e-statements) via email or patient portal in lieu of paper statements. Supports paperless billing initiatives and reduces statement delivery costs in RCM.' ;
    rdfs:domain ind:Guarantor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:federalPovertyLevelPct rdf:type rdf:Property ;
    rdfs:label 'Federal Poverty Level Pct' ;
    rdfs:comment 'Calculated Federal Poverty Level (FPL) percentage for the guarantor\'s household based on annual income and household size. Determines eligibility tier for financial assistance programs, charity care, and sliding-scale discounts per ACA Section 501(r) and CMS guidelines.' ;
    rdfs:domain ind:Guarantor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:financialAssistanceStatus rdf:type rdf:Property ;
    rdfs:label 'Financial Assistance Status' ;
    rdfs:comment 'Current status of the guarantor\'s financial assistance (charity care) application. Drives billing hold, discount application, and collection suspension workflows in the RCM system. Supports ACA Section 501(r) compliance reporting.' ;
    rdfs:domain ind:Guarantor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:financialAssistanceType rdf:type rdf:Property ;
    rdfs:label 'Financial Assistance Type' ;
    rdfs:comment 'Type of financial assistance program approved or applied for by the guarantor. Determines the discount percentage, payment schedule, and billing workflow applied to the account. [ENUM-REF-CANDIDATE: charity_care|sliding_scale|payment_plan|hardship|medicaid_pending — promote to reference product]' ;
    rdfs:domain ind:Guarantor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:firstName rdf:type rdf:Property ;
    rdfs:label 'First Name' ;
    rdfs:comment 'Legal first (given) name of the guarantor individual. Used in billing correspondence, patient financial counseling communications, and self-pay collection outreach. Protected Health Information (PHI) under HIPAA when linked to patient account data.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:guarantorType rdf:type rdf:Property ;
    rdfs:label 'Guarantor Type' ;
    rdfs:comment 'Classification of the guarantor indicating whether the responsible party is the patient themselves, a family member, a legal guardian, an estate, or an organization. Determines billing workflow routing and financial counseling approach. [ENUM-REF-CANDIDATE: self|parent|spouse|legal_guardian|estate|organization — promote to reference product if additional types are required]' ;
    rdfs:domain ind:Guarantor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:homePhone rdf:type rdf:Property ;
    rdfs:label 'Home Phone' ;
    rdfs:comment 'Home telephone number of the guarantor. Primary contact channel for billing inquiries, financial counseling outreach, and self-pay collection calls. Stored in compliance with HIPAA and Telephone Consumer Protection Act (TCPA) requirements.' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:householdSize rdf:type rdf:Property ;
    rdfs:label 'Household Size' ;
    rdfs:comment 'Number of individuals in the guarantor\'s household. Used in conjunction with annual income to determine Federal Poverty Level (FPL) percentage for financial assistance (charity care) eligibility and sliding-scale fee calculations.' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lastName rdf:type rdf:Property ;
    rdfs:label 'Last Name' ;
    rdfs:comment 'Legal last (family) name of the guarantor individual. Used in billing correspondence, collection letters, and identity verification for patient financial services.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastPaymentAmount rdf:type rdf:Property ;
    rdfs:label 'Last Payment Amount' ;
    rdfs:comment 'Dollar amount of the most recent payment received from the guarantor in USD. Used alongside last_payment_date for payment plan compliance monitoring, collection risk assessment, and RCM reporting.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lastPaymentDate rdf:type rdf:Property ;
    rdfs:label 'Last Payment Date' ;
    rdfs:comment 'Date of the most recent payment received from the guarantor toward the outstanding account balance. Used in collection aging analysis, payment plan compliance monitoring, and bad debt risk stratification.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastStatementDate rdf:type rdf:Property ;
    rdfs:label 'Last Statement Date' ;
    rdfs:comment 'Date on which the most recent billing statement was generated and sent to the guarantor. Used to track billing cycle compliance, manage statement frequency, and support collection escalation timelines in RCM.' ;
    rdfs:domain ind:Guarantor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:mobilePhone rdf:type rdf:Property ;
    rdfs:label 'Mobile Phone' ;
    rdfs:comment 'Mobile/cell phone number of the guarantor. Supports SMS billing notifications, payment reminders, and collection outreach. Consent for text messaging must be captured separately per TCPA requirements.' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:organizationName rdf:type rdf:Property ;
    rdfs:label 'Organization Name' ;
    rdfs:comment 'Legal name of the organization acting as guarantor when the responsible party is a business entity, estate, or institution rather than an individual. Populated when guarantor_type is \'organization\' or \'estate\'.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentPlanAmount rdf:type rdf:Property ;
    rdfs:label 'Payment Plan Amount' ;
    rdfs:comment 'Agreed monthly payment amount under the guarantor\'s active payment plan arrangement in USD. Used by RCM billing staff to monitor payment plan compliance and trigger collection escalation if payments are missed.' ;
    rdfs:domain ind:Guarantor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentPlanFlag rdf:type rdf:Property ;
    rdfs:label 'Payment Plan Flag' ;
    rdfs:comment 'Indicates whether the guarantor has an active payment plan arrangement for the outstanding account balance. When True, collection activities are suspended and the account follows the payment plan schedule in the RCM system.' ;
    rdfs:domain ind:Guarantor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:preferredContactMethod rdf:type rdf:Property ;
    rdfs:label 'Preferred Contact Method' ;
    rdfs:comment 'Guarantor\'s preferred method of contact for billing statements, payment reminders, and financial counseling communications. Drives outreach channel selection in RCM workflows and patient financial services.' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relationshipToPatient rdf:type rdf:Property ;
    rdfs:label 'Relationship To Patient' ;
    rdfs:comment 'Describes the guarantor\'s relationship to the patient as defined in the EHR patient accounting module. Used for financial counseling, billing correspondence, and HIPAA-compliant disclosure of account information. [ENUM-REF-CANDIDATE: self|spouse|parent|child|sibling|grandparent|legal_guardian|other — promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responsibilityPct rdf:type rdf:Property ;
    rdfs:label 'Responsibility Pct' ;
    rdfs:comment 'Percentage of the total patient account balance for which this guarantor is financially responsible. Supports scenarios where multiple guarantors share responsibility for a single patient account (e.g., divorced parents of a minor patient). Value range: 0.00 to 100.00.' ;
    rdfs:domain ind:Guarantor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sinceDate rdf:type rdf:Property ;
    rdfs:label 'Since Date' ;
    rdfs:comment 'Date on which the individual or organization was first established as the financial guarantor for the patient account. Marks the effective start of financial responsibility and is used in RCM aging analysis and financial counseling workflows.' ;
    rdfs:domain ind:Guarantor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:smsConsentFlag rdf:type rdf:Property ;
    rdfs:label 'Sms Consent Flag' ;
    rdfs:comment 'Indicates whether the guarantor has provided explicit written consent to receive SMS/text message billing notifications and payment reminders. Required for TCPA compliance before sending automated text messages to the guarantor\'s mobile phone.' ;
    rdfs:domain ind:Guarantor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ssnMasked rdf:type rdf:Property ;
    rdfs:label 'Ssn Masked' ;
    rdfs:comment 'Masked Social Security Number (SSN) of the guarantor, displaying only the last four digits (format: XXX-XX-NNNN). Used for identity verification in self-pay collections, financial assistance screening, and credit bureau reporting. Full SSN must never be stored in the Silver layer per HIPAA and PCI DSS data minimization requirements.' ;
    rdfs:domain ind:Guarantor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:state rdf:type rdf:Property ;
    rdfs:label 'State' ;
    rdfs:comment 'Two-letter US state or territory code of the guarantor\'s billing or mailing address (e.g., CA, TX, NY). Used for billing correspondence, state-specific financial assistance program eligibility, and regulatory reporting.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workPhone rdf:type rdf:Property ;
    rdfs:label 'Work Phone' ;
    rdfs:comment 'Work telephone number of the guarantor. Used as an alternate contact channel for billing and collection communications when home phone is unavailable. Stored in compliance with HIPAA and TCPA.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:emergencyContactId rdf:type rdf:Property ;
    rdfs:label 'Emergency Contact Id' ;
    rdfs:comment 'Unique surrogate identifier for the emergency contact record in the Master Patient Index (MPI) system. Primary key for the emergency_contact data product.' ;
    rdfs:domain ind:EmergencyContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:consentDate rdf:type rdf:Property ;
    rdfs:label 'Consent Date' ;
    rdfs:comment 'The date on which the patient provided consent to designate this individual as an emergency contact and/or authorized recipient of PHI. Required for HIPAA audit trails and regulatory compliance.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:consentObtainedBy rdf:type rdf:Property ;
    rdfs:label 'Consent Obtained By' ;
    rdfs:comment 'Name or identifier of the staff member (e.g., registration clerk, nurse) who obtained the patient\'s consent to designate this emergency contact. Supports HIPAA audit trail requirements and accountability in the registration workflow.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactStatus rdf:type rdf:Property ;
    rdfs:label 'Contact Status' ;
    rdfs:comment 'Current lifecycle status of the emergency contact record. Active = currently valid and reachable; Inactive = no longer applicable (e.g., relationship ended); Deceased = contact has died; Unverified = contact information has not been confirmed with the patient.' ;
    rdfs:domain ind:EmergencyContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactType rdf:type rdf:Property ;
    rdfs:label 'Contact Type' ;
    rdfs:comment 'Classification of the contact\'s role relative to the patient. Determines the scope of authority and notification priority. Values include emergency_contact (general notification), healthcare_proxy (authorized to make medical decisions), legal_guardian (legal authority over patient), authorized_representative (authorized to receive PHI per HIPAA), next_of_kin (biological/legal family), guarantor (financial responsibility). [ENUM-REF-CANDIDATE: emergency_contact|healthcare_proxy|legal_guardian|authorized_representative|next_of_kin|guarantor — promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:healthcareProxyFlag rdf:type rdf:Property ;
    rdfs:label 'Healthcare Proxy Flag' ;
    rdfs:comment 'Indicates whether this contact has been designated as the patient\'s healthcare proxy (durable power of attorney for healthcare decisions). When True, this individual is legally authorized to make medical decisions on behalf of the patient if the patient is incapacitated. Distinct from phi_disclosure_authorized.' ;
    rdfs:domain ind:EmergencyContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:legalGuardianFlag rdf:type rdf:Property ;
    rdfs:label 'Legal Guardian Flag' ;
    rdfs:comment 'Indicates whether this contact holds legal guardianship over the patient (e.g., parent of a minor, court-appointed guardian for an incapacitated adult). When True, this individual has legal authority over the patient\'s care decisions and access to medical records.' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:livesWithPatient rdf:type rdf:Property ;
    rdfs:label 'Lives With Patient' ;
    rdfs:comment 'Indicates whether the emergency contact resides in the same household as the patient. Relevant for discharge planning, home care coordination, and Social Determinants of Health (SDOH) assessments.' ;
    rdfs:domain ind:EmergencyContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:notes rdf:type rdf:Property ;
    rdfs:label 'Notes' ;
    rdfs:comment 'Free-text field for additional clinical or administrative notes about this emergency contact (e.g., \'Contact is deaf — use text messaging only\', \'Contact travels frequently — try mobile first\'). Supports nuanced care coordination and communication planning.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notificationConsentFlag rdf:type rdf:Property ;
    rdfs:label 'Notification Consent Flag' ;
    rdfs:comment 'Indicates whether the patient has explicitly consented to this contact being notified in the event of an emergency, admission, or discharge. Supports EMTALA compliance and HIPAA-compliant notification workflows.' ;
    rdfs:domain ind:EmergencyContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:phiDisclosureAuthorized rdf:type rdf:Property ;
    rdfs:label 'Phi Disclosure Authorized' ;
    rdfs:comment 'Indicates whether the patient has authorized this contact to receive Protected Health Information (PHI) about their care. Critical for HIPAA compliance — clinical staff must verify this flag before disclosing any PHI to the contact. True = authorized; False = not authorized.' ;
    rdfs:domain ind:EmergencyContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:priorityOrder rdf:type rdf:Property ;
    rdfs:label 'Priority Order' ;
    rdfs:comment 'Numeric rank indicating the order in which this contact should be notified in an emergency (1 = first contact, 2 = second, etc.). Supports triage and discharge planning workflows where multiple contacts exist for a single patient.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:proxyDocumentEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Proxy Document Effective Date' ;
    rdfs:comment 'The date on which the proxy authorization document (e.g., durable power of attorney, healthcare proxy form) became legally effective. Used to validate the currency of the authorization during care decisions.' ;
    rdfs:domain ind:EmergencyContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:proxyDocumentExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Proxy Document Expiration Date' ;
    rdfs:comment 'The date on which the proxy authorization document expires, if applicable. Null indicates the document is open-ended with no expiration. Clinical staff must verify this date before acting on proxy authority.' ;
    rdfs:domain ind:EmergencyContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:proxyDocumentType rdf:type rdf:Property ;
    rdfs:label 'Proxy Document Type' ;
    rdfs:comment 'Type of legal document on file that establishes this contact\'s authority as a healthcare proxy or legal guardian. Required for clinical staff to verify decision-making authority before acting on the contact\'s instructions.' ;
    rdfs:domain ind:EmergencyContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relationshipType rdf:type rdf:Property ;
    rdfs:label 'Relationship Type' ;
    rdfs:comment 'The personal or familial relationship between the emergency contact and the patient (e.g., spouse, parent, sibling). Used for care coordination, discharge planning, and EMTALA compliance. Distinct from contact_type which captures the legal/functional role. [ENUM-REF-CANDIDATE: spouse|parent|child|sibling|domestic_partner|grandparent|aunt_uncle|friend|employer|other — promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemContactCode rdf:type rdf:Property ;
    rdfs:label 'Source System Contact Code' ;
    rdfs:comment 'The native identifier assigned to this emergency contact record in the originating source system (e.g., Epic contact ID, Cerner relationship ID). Used for cross-system reconciliation, ETL traceability, and Health Information Exchange (HIE) matching.' ;
    rdfs:domain ind:EmergencyContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verifiedBy rdf:type rdf:Property ;
    rdfs:label 'Verified By' ;
    rdfs:comment 'Name or identifier of the staff member who last verified the accuracy of this emergency contact\'s information. Supports accountability and data quality governance in the patient registration process.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verifiedDate rdf:type rdf:Property ;
    rdfs:label 'Verified Date' ;
    rdfs:comment 'The most recent date on which the emergency contact\'s information was verified with the patient or the contact directly. Supports data quality management and ensures contact information is current for emergency use.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:workPhoneExtension rdf:type rdf:Property ;
    rdfs:label 'Work Phone Extension' ;
    rdfs:comment 'Extension number associated with the contact\'s work phone. Required for routing calls within large organizations where the contact is employed.' ;
    rdfs:domain ind:EmergencyContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sdohAssessmentId rdf:type rdf:Property ;
    rdfs:label 'Sdoh Assessment Id' ;
    rdfs:comment 'Unique surrogate identifier for each Social Determinants of Health (SDOH) assessment record in the patient domain. Primary key for this data product; referenced by downstream clinical, population health, and care management entities.' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SdohAssessment .

ind:assessmentCareSiteId rdf:type rdf:Property ;
    rdfs:label 'Assessment Care Site Id' ;
    rdfs:comment 'Foreign key linking to facility.care_site. Business justification: SDOH assessments occur at specific care sites; required for CMS quality measure reporting (screening rates by facility), care management program operations, and community health needs assessments tied' ;
    rdfs:domain ind:SdohAssessment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CareSite .

ind:assessmentLoincCodeId rdf:type rdf:Property ;
    rdfs:label 'Assessment Loinc Code Id' ;
    rdfs:comment 'Foreign key linking to reference.loinc_code. Business justification: SDOH screening tools use standardized LOINC codes (e.g., LOINC 96777-8 for housing instability) for interoperability, quality reporting, and CMS/HEDIS measure submission. Enables automated screening t' ;
    rdfs:domain ind:SdohAssessment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:LoincCode .

ind:clinicianId rdf:type rdf:Property ;
    rdfs:label 'Clinician Id' ;
    rdfs:comment 'Reference to the clinician or care team member who administered or documented this SDOH assessment. Used for accountability, workflow routing, and provider-level quality reporting.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:communityResourceId rdf:type rdf:Property ;
    rdfs:label 'Community Resource Id' ;
    rdfs:comment 'FK to the community resource connected during assessment.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CommunityResource .

ind:sdohZcodeMappingId rdf:type rdf:Property ;
    rdfs:label 'Sdoh Zcode Mapping Id' ;
    rdfs:comment 'sdoh zcode mapping id' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SdohZcodeMapping .

ind:visitId rdf:type rdf:Property ;
    rdfs:label 'Visit Id' ;
    rdfs:comment 'Reference to the clinical encounter during which this SDOH assessment was administered, if applicable. Supports linkage to the Admit-Discharge-Transfer (ADT) encounter context for population health reporting.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Visit .

ind:administrationMethod rdf:type rdf:Property ;
    rdfs:label 'Administration Method' ;
    rdfs:comment 'Method by which the SDOH screening assessment was administered. \'clinician_administered\' indicates face-to-face administration by a care team member; \'self_administered\' indicates patient completed independently; \'telephone\' indicates phone-based administration; \'electronic_portal\' indicates patient portal or kiosk; \'proxy\' indicates completed by a caregiver or family member on behalf of the patient.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assessmentDate rdf:type rdf:Property ;
    rdfs:label 'Assessment Date' ;
    rdfs:comment 'The calendar date on which the SDOH screening assessment was administered to the patient. This is the principal real-world business event date used for population health trending, ACO quality reporting, and CMS SDOH initiative compliance.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:assessmentNumber rdf:type rdf:Property ;
    rdfs:label 'Assessment Number' ;
    rdfs:comment 'Externally visible business identifier for this SDOH assessment record, typically system-generated by the population health or care management platform (e.g., Epic Healthy Planet, Salesforce Health Cloud). Used for cross-system referencing, audit trails, and patient communication.' ;
    rdfs:domain ind:SdohAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assessmentSetting rdf:type rdf:Property ;
    rdfs:label 'Assessment Setting' ;
    rdfs:comment 'Clinical or community setting in which the SDOH assessment was conducted. Supports stratification of SDOH findings by care setting for population health management and community health needs assessments (CHNA). [ENUM-REF-CANDIDATE: inpatient|outpatient|emergency|telehealth|community|home|pharmacy — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:SdohAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assessmentStatus rdf:type rdf:Property ;
    rdfs:label 'Assessment Status' ;
    rdfs:comment 'Current lifecycle status of the SDOH assessment record. \'completed\' indicates all questions were answered; \'in_progress\' indicates partial completion; \'refused\' indicates patient declined to participate; \'not_applicable\' indicates screening was deemed clinically inappropriate; \'cancelled\' indicates the assessment was voided.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assessmentTimestamp rdf:type rdf:Property ;
    rdfs:label 'Assessment Timestamp' ;
    rdfs:comment 'Precise date and time when the SDOH assessment was administered or documented in the system. Provides sub-day precision for workflow analytics, care coordination timing, and audit trail requirements.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:careProgramEnrolledFlag rdf:type rdf:Property ;
    rdfs:label 'Care Program Enrolled Flag' ;
    rdfs:comment 'Boolean indicator of whether the patient was enrolled in a care management or population health program as a direct result of this SDOH assessment. Supports ACO quality reporting, HEDIS measure tracking, and population health management program analytics.' ;
    rdfs:domain ind:SdohAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:consentObtainedFlag rdf:type rdf:Property ;
    rdfs:label 'Consent Obtained Flag' ;
    rdfs:comment 'Boolean indicator of whether the patient provided informed consent for SDOH screening and data sharing prior to administration of the assessment. Required for HIPAA compliance and data sharing with community-based organizations under the Gravity Project framework.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:financialStrainFlag rdf:type rdf:Property ;
    rdfs:label 'Financial Strain Flag' ;
    rdfs:comment 'Boolean indicator of whether the patient screened positive for financial strain. True indicates a positive screen. Supports financial assistance program referrals, charity care eligibility screening, and population health stratification.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:financialStrainScore rdf:type rdf:Property ;
    rdfs:label 'Financial Strain Score' ;
    rdfs:comment 'Numeric score for the financial strain SDOH domain, reflecting the patient\'s difficulty meeting basic financial needs including utilities, medical bills, and essential expenses. Aligned with Gravity Project financial insecurity value sets.' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:foodInsecurityFlag rdf:type rdf:Property ;
    rdfs:label 'Food Insecurity Flag' ;
    rdfs:comment 'Boolean indicator of whether the patient screened positive for food insecurity based on validated threshold scoring. True indicates a positive screen requiring intervention or referral. Used for population health stratification and care management prioritization.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:foodInsecurityScore rdf:type rdf:Property ;
    rdfs:label 'Food Insecurity Score' ;
    rdfs:comment 'Numeric score for the food insecurity SDOH domain, derived from responses to food security screening questions (e.g., Hunger Vital Sign 2-item screener). Higher scores indicate greater food insecurity risk. Used for ACO quality reporting and community health needs assessment.' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:housingInstabilityFlag rdf:type rdf:Property ;
    rdfs:label 'Housing Instability Flag' ;
    rdfs:comment 'Boolean indicator of whether the patient screened positive for housing instability. True indicates a positive screen. Supports ACO quality reporting, CMS SDOH initiatives, and community health needs assessments.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:housingInstabilityScore rdf:type rdf:Property ;
    rdfs:label 'Housing Instability Score' ;
    rdfs:comment 'Numeric score for the housing instability SDOH domain, capturing risk of homelessness, housing insecurity, or inadequate housing conditions. Derived from validated screening questions aligned with Gravity Project value sets.' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:icd10ZCode rdf:type rdf:Property ;
    rdfs:label 'Icd10 Z Code' ;
    rdfs:comment 'ICD-10-CM Z-code (Z55-Z65 range) assigned to document the social determinant of health finding for billing, claims, and quality reporting purposes. Examples include Z59.0 (Homelessness), Z59.4 (Lack of adequate food), Z63.0 (Problems in relationship with spouse). Required for CMS SDOH quality measure reporting and value-based care programs.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:identifiedNeedsSummary rdf:type rdf:Property ;
    rdfs:label 'Identified Needs Summary' ;
    rdfs:comment 'Free-text or structured narrative summarizing the specific social needs identified during this assessment. Documents the patient\'s expressed needs and priorities as captured by the administering clinician or care team member. Supports clinical documentation and care plan development.' ;
    rdfs:domain ind:SdohAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interpersonalSafetyFlag rdf:type rdf:Property ;
    rdfs:label 'Interpersonal Safety Flag' ;
    rdfs:comment 'Boolean indicator of whether the patient screened positive for interpersonal safety concerns. True indicates a positive screen. Triggers mandatory reporting workflows and care management escalation per facility policy and applicable state law.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:interpersonalSafetyScore rdf:type rdf:Property ;
    rdfs:label 'Interpersonal Safety Score' ;
    rdfs:comment 'Numeric score for the interpersonal safety SDOH domain, capturing exposure to domestic violence, intimate partner violence, or unsafe living conditions. Derived from validated screening questions per Gravity Project value sets.' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interpreterUsedFlag rdf:type rdf:Property ;
    rdfs:label 'Interpreter Used Flag' ;
    rdfs:comment 'Boolean indicator of whether a professional interpreter (in-person or telephonic) was used during the SDOH assessment administration. Supports health equity reporting and Section 1557 ACA language access compliance tracking.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:languageOfAdministration rdf:type rdf:Property ;
    rdfs:label 'Language Of Administration' ;
    rdfs:comment 'ISO 639-1 two-letter language code indicating the language in which the SDOH assessment was administered (e.g., \'en\' for English, \'es\' for Spanish). Supports health equity reporting, language access compliance, and population health stratification by preferred language.' ;
    rdfs:domain ind:SdohAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:loincPanelCode rdf:type rdf:Property ;
    rdfs:label 'Loinc Panel Code' ;
    rdfs:comment 'LOINC code identifying the specific SDOH screening panel administered (e.g., 93025-5 for PRAPARE, 96777-8 for AHC HRSN). Enables standardized clinical data exchange, EHR interoperability, and alignment with national SDOH coding standards.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:needClosureStatus rdf:type rdf:Property ;
    rdfs:label 'Need Closure Status' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:overallRiskLevel rdf:type rdf:Property ;
    rdfs:label 'Overall Risk Level' ;
    rdfs:comment 'Clinician or algorithm-assigned overall SDOH risk stratification level based on the combination of domain scores and positive flags. Drives care management program enrollment, outreach prioritization, and community health worker assignment.' ;
    rdfs:domain ind:SdohAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorityScore rdf:type rdf:Property ;
    rdfs:label 'Priority Score' ;
    rdfs:comment 'Priority score for outreach' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reassessmentDueDate rdf:type rdf:Property ;
    rdfs:label 'Reassessment Due Date' ;
    rdfs:comment 'Scheduled date for the next SDOH reassessment based on clinical protocol, risk level, or care management program requirements. Drives outreach scheduling and population health management workflows in Epic Healthy Planet and Salesforce Health Cloud.' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reassessmentIntervalDays rdf:type rdf:Property ;
    rdfs:label 'Reassessment Interval Days' ;
    rdfs:comment 'Number of days between this assessment and the scheduled reassessment, as defined by the applicable care management protocol or clinical guideline. Common intervals include 90, 180, or 365 days depending on risk level and program requirements.' ;
    rdfs:domain ind:SdohAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:referralClosedDate rdf:type rdf:Property ;
    rdfs:label 'Referral Closed Date' ;
    rdfs:comment 'Date on which the SDOH referral was closed, either due to successful resource connection, patient declination, or inability to contact. Supports referral loop closure tracking required by CMS SDOH initiatives and ACO quality reporting.' ;
    rdfs:domain ind:SdohAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:referralDate rdf:type rdf:Property ;
    rdfs:label 'Referral Date' ;
    rdfs:comment 'Date on which the referral to a community resource or social service was placed following identification of SDOH needs. Used for care coordination timeliness tracking and ACO quality measure reporting.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:referralDisposition rdf:type rdf:Property ;
    rdfs:label 'Referral Disposition' ;
    rdfs:comment 'Outcome disposition indicating whether the patient was referred to community resources or social services based on identified SDOH needs. \'referred\' indicates active referral placed; \'declined_referral\' indicates patient declined offered resources; \'no_needs_identified\' indicates no positive screens; \'pending\' indicates referral decision in progress; \'self_managed\' indicates patient managing independently.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referralOrganization rdf:type rdf:Property ;
    rdfs:label 'Referral Organization' ;
    rdfs:comment 'Name of the community-based organization (CBO), social service agency, or health-related social needs resource to which the patient was referred. Supports community health needs assessment (CHNA) reporting and ACO community partnership tracking.' ;
    rdfs:domain ind:SdohAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referralOutcome rdf:type rdf:Property ;
    rdfs:label 'Referral Outcome' ;
    rdfs:comment 'Outcome of the SDOH referral indicating whether the patient was successfully connected to the referred community resource. \'connected\' indicates successful resource engagement; \'not_connected\' indicates referral was unsuccessful; \'in_progress\' indicates outreach ongoing; \'declined\' indicates patient declined; \'unable_to_reach\' indicates patient could not be contacted.' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskStratificationTier rdf:type rdf:Property ;
    rdfs:label 'Risk Stratification Tier' ;
    rdfs:comment 'Patient risk stratification tier assigned at the time of attribution, based on clinical complexity, chronic condition burden, and Social Determinants of Health (SDOH) factors. Used by the attributed PCP and care team to prioritize outreach, care management intensity, and resource allocation in population health programs.' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:screeningToolCode rdf:type rdf:Property ;
    rdfs:label 'Screening Tool Code' ;
    rdfs:comment 'Standardized code identifying the validated SDOH screening instrument used for this assessment. Supported tools include: AHC HRSN (Accountable Health Communities Health-Related Social Needs), PRAPARE (Protocol for Responding to and Assessing Patients\' Assets, Risks, and Experiences), Hunger Vital Sign, WHO WHOQOL, WellCare, iScreen, and Other. [ENUM-REF-CANDIDATE: AHC_HRSN|PRAPARE|HUNGER_VITAL_SIGN|WHOQOL|WELLCARE|ISCREEN|OTHER — promote to reference product]' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:screeningToolName rdf:type rdf:Property ;
    rdfs:label 'Screening Tool Name' ;
    rdfs:comment 'Human-readable name of the SDOH screening instrument used (e.g., \'Accountable Health Communities Health-Related Social Needs Screening Tool\', \'PRAPARE\', \'Hunger Vital Sign\'). Complements the code for display and reporting purposes.' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:screeningToolVersion rdf:type rdf:Property ;
    rdfs:label 'Screening Tool Version' ;
    rdfs:comment 'Version number or edition of the screening instrument used (e.g., \'2019\', \'v2.0\'). Important for longitudinal comparability and regulatory reporting as tool versions may change question sets and scoring algorithms.' ;
    rdfs:domain ind:SdohAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sdohReferralId rdf:type rdf:Property ;
    rdfs:label 'Sdoh Referral Id' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SdohReferral .

ind:sdohRiskScoreId rdf:type rdf:Property ;
    rdfs:label 'Sdoh Risk Score Id' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sdohRiskStratificationId rdf:type rdf:Property ;
    rdfs:label 'Sdoh Risk Stratification Id' ;
    rdfs:comment 'FK to the risk stratification score derived from this assessment.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SdohRiskStratification .

ind:snomedFindingCode rdf:type rdf:Property ;
    rdfs:label 'Snomed Finding Code' ;
    rdfs:comment 'SNOMED CT (Systematized Nomenclature of Medicine Clinical Terms) code representing the primary social determinant finding identified in this assessment. Supports clinical documentation, problem list coding, and interoperability with FHIR-based systems per Gravity Project value sets.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:socialIsolationFlag rdf:type rdf:Property ;
    rdfs:label 'Social Isolation Flag' ;
    rdfs:comment 'Boolean indicator of whether the patient screened positive for social isolation. True indicates a positive screen. Supports care management program enrollment and community resource referral.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:socialIsolationScore rdf:type rdf:Property ;
    rdfs:label 'Social Isolation Score' ;
    rdfs:comment 'Numeric score for the social isolation SDOH domain, measuring the patient\'s level of social connectedness and risk of loneliness. Derived from validated screening questions aligned with Gravity Project and WHO WHOQOL social domain.' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalPositiveDomains rdf:type rdf:Property ;
    rdfs:label 'Total Positive Domains' ;
    rdfs:comment 'Count of SDOH domains for which the patient screened positive in this assessment. Ranges from 0 to the total number of domains assessed. Used for risk stratification, care management prioritization, and population health reporting. This is a raw count field, not a derived aggregate metric.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:transportationFlag rdf:type rdf:Property ;
    rdfs:label 'Transportation Flag' ;
    rdfs:comment 'Boolean indicator of whether the patient screened positive for transportation barriers. True indicates a positive screen requiring care coordination or community resource referral.' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:transportationScore rdf:type rdf:Property ;
    rdfs:label 'Transportation Score' ;
    rdfs:comment 'Numeric score for the transportation barrier SDOH domain, reflecting the patient\'s difficulty accessing healthcare services, food, or employment due to lack of reliable transportation. Aligned with Gravity Project transportation value sets.' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preferenceId rdf:type rdf:Property ;
    rdfs:label 'Preference Id' ;
    rdfs:comment 'Primary key for preference' ;
    rdfs:domain ind:Preference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:primaryPreferencePharmacyLocationId rdf:type rdf:Property ;
    rdfs:label 'Primary Preference Pharmacy Location Id' ;
    rdfs:comment 'Reference to the patient\'s preferred pharmacy for prescription fulfillment. Used by Epic Willow and Cerner PharmNet to route electronic prescriptions (e-prescribing) to the patient\'s designated pharmacy. Supports medication adherence and care coordination.' ;
    rdfs:domain ind:Preference ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PharmacyLocation .

ind:appointmentReminderOptIn rdf:type rdf:Property ;
    rdfs:label 'Appointment Reminder Opt In' ;
    rdfs:comment 'Indicates whether the patient has opted in to receive automated appointment reminders via their preferred communication channel. Drives reminder workflows in Epic Cadence and Cerner Millennium scheduling. Supports no-show reduction and patient access metrics.' ;
    rdfs:domain ind:Preference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:careManagementOptIn rdf:type rdf:Property ;
    rdfs:label 'Care Management Opt In' ;
    rdfs:comment 'Indicates whether the patient has consented to enrollment in care management or disease management programs (e.g., chronic disease management, transitional care, ACO care coordination). Drives population health outreach in Epic Healthy Planet and Salesforce Health Cloud.' ;
    rdfs:domain ind:Preference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:careSettingPreference rdf:type rdf:Property ;
    rdfs:label 'Care Setting Preference' ;
    rdfs:comment 'Patient\'s preferred care delivery setting for non-emergency services. Informs care team routing, scheduling, and population health outreach strategies. \'ed\' indicates Emergency Department (ED) preference for urgent needs. Supports health equity and SDOH analysis.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:communicationChannel rdf:type rdf:Property ;
    rdfs:label 'Communication Channel' ;
    rdfs:comment 'Patient\'s preferred channel for receiving appointment reminders, care instructions, test results, and general health communications. Drives outreach workflows in Epic MyChart, Salesforce Health Cloud, and patient engagement platforms. Supports CAHPS patient experience measurement.' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:communicationTimePreference rdf:type rdf:Property ;
    rdfs:label 'Communication Time Preference' ;
    rdfs:comment 'Patient\'s preferred time of day for receiving outbound communications such as appointment reminders, care management calls, and health coaching outreach. Used by care coordinators and automated outreach systems to optimize contact rates.' ;
    rdfs:domain ind:Preference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:culturalCarePreference rdf:type rdf:Property ;
    rdfs:label 'Cultural Care Preference' ;
    rdfs:comment 'Free-text or coded description of cultural practices, beliefs, or traditions that should be respected during care delivery. Examples include gender-concordant provider preference, traditional healing practices, or specific cultural rituals. Supports culturally competent care and CLAS Standards compliance.' ;
    rdfs:domain ind:Preference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dietaryPreference rdf:type rdf:Property ;
    rdfs:label 'Dietary Preference' ;
    rdfs:comment 'Patient\'s dietary preferences or restrictions relevant to inpatient meal planning and nutritional care (e.g., vegetarian, vegan, halal, kosher, gluten-free, diabetic diet). Sourced from EHR registration and nursing assessment. [ENUM-REF-CANDIDATE: vegetarian|vegan|halal|kosher|gluten_free|diabetic|low_sodium|renal — promote to reference product]' ;
    rdfs:domain ind:Preference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:doNotContact rdf:type rdf:Property ;
    rdfs:label 'Do Not Contact' ;
    rdfs:comment 'Indicates that the patient has requested no outbound contact from the health system for non-clinical communications. When true, suppresses all marketing, outreach, and non-essential communications. Must be honored per HIPAA Right to Restrict and TCPA.' ;
    rdfs:domain ind:Preference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:educationMaterialFormat rdf:type rdf:Property ;
    rdfs:label 'Education Material Format' ;
    rdfs:comment 'Patient\'s preferred format for receiving health education materials, discharge instructions, and care plan documents. Drives document generation and delivery in Epic ClinDoc and patient engagement platforms. Supports health literacy and accessibility compliance.' ;
    rdfs:domain ind:Preference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:effectiveFrom rdf:type rdf:Property ;
    rdfs:label 'Effective From' ;
    rdfs:comment 'Date from which this set of patient care and communication preferences is considered active and applicable. Enables temporal tracking of preference changes over time and supports preference versioning.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:effectiveUntil rdf:type rdf:Property ;
    rdfs:label 'Effective Until' ;
    rdfs:comment 'Date on which this set of patient care and communication preferences expires or is superseded. Null indicates the preferences are open-ended and currently active. Supports preference versioning and historical audit.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:genderConcordantProvider rdf:type rdf:Property ;
    rdfs:label 'Gender Concordant Provider' ;
    rdfs:comment 'Indicates whether the patient has expressed a preference to receive care from a provider of the same gender. Used in scheduling and provider assignment workflows to honor patient preferences and support culturally sensitive care delivery.' ;
    rdfs:domain ind:Preference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:healthLiteracyLevel rdf:type rdf:Property ;
    rdfs:label 'Health Literacy Level' ;
    rdfs:comment 'Assessment of the patient\'s health literacy level, indicating their ability to understand health information, medication instructions, and care plans. Informs the complexity and format of patient education materials. Supports SDOH analysis and health equity initiatives.' ;
    rdfs:domain ind:Preference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hearingAccommodation rdf:type rdf:Property ;
    rdfs:label 'Hearing Accommodation' ;
    rdfs:comment 'Specific hearing-related accessibility accommodation required by the patient during clinical encounters and communications. Drives accommodation scheduling and facility preparation. Supports ADA compliance and CLAS Standards.' ;
    rdfs:domain ind:Preference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interpreterNeeded rdf:type rdf:Property ;
    rdfs:label 'Interpreter Needed' ;
    rdfs:comment 'Indicates whether the patient requires professional interpreter services for clinical encounters. When true, triggers interpreter scheduling workflows in Epic Cadence and Cerner Millennium scheduling modules. Supports compliance with Section 1557 of the Affordable Care Act.' ;
    rdfs:domain ind:Preference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:interpreterType rdf:type rdf:Property ;
    rdfs:label 'Interpreter Type' ;
    rdfs:comment 'Specifies the modality of interpreter service preferred or required by the patient. \'sign_language\' indicates American Sign Language (ASL) or other signed language interpreter. Informs scheduling and resource allocation in Epic Cadence.' ;
    rdfs:domain ind:Preference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastVerifiedBy rdf:type rdf:Property ;
    rdfs:label 'Last Verified By' ;
    rdfs:comment 'Name or identifier of the staff member, system, or patient who last verified and confirmed the accuracy of the preference record. Supports audit trail and accountability for preference data quality.' ;
    rdfs:domain ind:Preference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:marketingOptIn rdf:type rdf:Property ;
    rdfs:label 'Marketing Opt In' ;
    rdfs:comment 'Indicates whether the patient has opted in to receive health system marketing communications, wellness newsletters, and promotional health content. Distinct from clinical communications. Governed by HIPAA marketing rules and CAN-SPAM Act.' ;
    rdfs:domain ind:Preference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mobilityAccommodation rdf:type rdf:Property ;
    rdfs:label 'Mobility Accommodation' ;
    rdfs:comment 'Specific mobility-related accessibility accommodation required by the patient for facility navigation, exam room setup, and transport. Informs facility preparation and scheduling in Epic Cadence. Supports ADA compliance.' ;
    rdfs:domain ind:Preference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notificationEmail rdf:type rdf:Property ;
    rdfs:label 'Notification Email' ;
    rdfs:comment 'Email address designated by the patient for receiving healthcare notifications, appointment reminders, and portal communications. May differ from the primary contact email on the patient master record. Governed by HIPAA and CAN-SPAM.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notificationPhone rdf:type rdf:Property ;
    rdfs:label 'Notification Phone' ;
    rdfs:comment 'Phone number designated by the patient for receiving healthcare notifications, appointment reminders, and care team calls. Expressed in E.164 international format. Governed by TCPA for automated outreach.' ;
    rdfs:domain ind:Preference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:organDonationStatus rdf:type rdf:Property ;
    rdfs:label 'Organ Donation Status' ;
    rdfs:comment 'Patient\'s registered organ and tissue donation preference. Sourced from state donor registries and patient registration. Required for CMS Conditions of Participation and UNOS reporting. Informs clinical teams during end-of-life care planning.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:portalEnrolled rdf:type rdf:Property ;
    rdfs:label 'Portal Enrolled' ;
    rdfs:comment 'Indicates whether the patient is actively enrolled in the patient portal (e.g., Epic MyChart). Portal enrollment enables secure messaging, online scheduling, test result viewing, and medication refill requests. Tracked for CMS Meaningful Use and patient engagement metrics.' ;
    rdfs:domain ind:Preference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:portalEnrollmentDate rdf:type rdf:Property ;
    rdfs:label 'Portal Enrollment Date' ;
    rdfs:comment 'Date on which the patient first activated and enrolled in the patient portal. Used to calculate portal engagement duration and for CMS Promoting Interoperability reporting.' ;
    rdfs:domain ind:Preference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:preferenceStatus rdf:type rdf:Property ;
    rdfs:label 'Preference Status' ;
    rdfs:comment 'Current lifecycle status of the patient preference record. \'active\' indicates preferences are current and in use; \'superseded\' indicates a newer version exists; \'pending_review\' indicates patient-submitted preferences awaiting staff validation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preferredContactName rdf:type rdf:Property ;
    rdfs:label 'Preferred Contact Name' ;
    rdfs:comment 'Full name of the patient\'s preferred contact person for care coordination communications, appointment reminders, and non-emergency notifications. May be a family member, caregiver, or healthcare proxy. Distinct from the emergency contact on the patient master record.' ;
    rdfs:domain ind:Preference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preferredContactRelationship rdf:type rdf:Property ;
    rdfs:label 'Preferred Contact Relationship' ;
    rdfs:comment 'Relationship of the preferred contact person to the patient. Used to determine appropriate disclosure scope under HIPAA and to contextualize care coordination communications. [ENUM-REF-CANDIDATE: self|spouse|parent|child|sibling|caregiver|legal_guardian|other — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Preference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:religiousPreference rdf:type rdf:Property ;
    rdfs:label 'Religious Preference' ;
    rdfs:comment 'Patient\'s religious or spiritual affiliation relevant to care delivery, chaplaincy services, dietary restrictions, and end-of-life planning. Informs culturally sensitive care and chaplain referrals. Stored as free text or standardized code per facility policy. Supports CAHPS patient experience and health equity initiatives.' ;
    rdfs:domain ind:Preference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:researchParticipationConsent rdf:type rdf:Property ;
    rdfs:label 'Research Participation Consent' ;
    rdfs:comment 'Indicates whether the patient has consented to be contacted for clinical research studies and trials. Drives patient recruitment workflows in research management systems. Supports IRB-compliant research operations and HIPAA Authorization requirements.' ;
    rdfs:domain ind:Preference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sdohScreeningConsent rdf:type rdf:Property ;
    rdfs:label 'Sdoh Screening Consent' ;
    rdfs:comment 'Indicates whether the patient has consented to Social Determinants of Health (SDOH) screening and data collection, including housing, food security, transportation, and social support assessments. Required for NCQA Health Equity Accreditation and CMS SDOH initiatives.' ;
    rdfs:domain ind:Preference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:source rdf:type rdf:Property ;
    rdfs:label 'Source' ;
    rdfs:comment 'Source channel or system through which the patient\'s preferences were captured or last updated. Supports data provenance, audit, and quality assessment. Values align with operational systems including Epic MyChart portal, Salesforce Health Cloud, and EHR registration workflows. [ENUM-REF-CANDIDATE: patient_portal|registration_staff|care_team|phone|mail|ehr_import|health_cloud — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surrogateDecisionMaker rdf:type rdf:Property ;
    rdfs:label 'Surrogate Decision Maker' ;
    rdfs:comment 'Indicates whether the patient has designated a surrogate decision maker (healthcare proxy, power of attorney for healthcare) to make medical decisions on their behalf. Triggers documentation workflows in Epic ClinDoc. Required for CMS Conditions of Participation.' ;
    rdfs:domain ind:Preference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:telehealthConsent rdf:type rdf:Property ;
    rdfs:label 'Telehealth Consent' ;
    rdfs:comment 'Indicates whether the patient has provided informed consent to receive care via telehealth modalities. Required before scheduling virtual visits in Epic Cadence or Cerner Millennium. Supports compliance with state telehealth consent laws and CMS telehealth billing requirements.' ;
    rdfs:domain ind:Preference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:visionAccommodation rdf:type rdf:Property ;
    rdfs:label 'Vision Accommodation' ;
    rdfs:comment 'Specific vision-related accessibility accommodation required by the patient for clinical materials, consent forms, and communications. Ensures accessible health information delivery per ADA and Section 508 requirements.' ;
    rdfs:domain ind:Preference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pcpAttributionId rdf:type rdf:Property ;
    rdfs:label 'Pcp Attribution Id' ;
    rdfs:comment 'Unique surrogate identifier for each PCP attribution record in the Master Patient Index (MPI) attribution registry. Serves as the primary key for all downstream joins across population health, HEDIS, and value-based care reporting.' ;
    rdfs:domain ind:PcpAttribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:accountableCareOrganizationId rdf:type rdf:Property ;
    rdfs:label 'Accountable Care Organization Id' ;
    rdfs:comment 'Reference to the Accountable Care Organization (ACO) record when the attribution is governed by an ACO participation agreement. Required for CMS Shared Savings Program (MSSP) and Next Generation ACO attribution reporting and shared savings calculations.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AccountableCareOrganization .

ind:apmEnrollmentId rdf:type rdf:Property ;
    rdfs:label 'Apm Enrollment Id' ;
    rdfs:comment 'FK to the APM participant registry record.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ApmEnrollment .

ind:attributedSpecialtyId rdf:type rdf:Property ;
    rdfs:label 'Attributed Specialty Id' ;
    rdfs:comment 'Foreign key linking to provider.specialty. Business justification: PCP attribution requires tracking the specialty of the attributed provider for network adequacy reporting, panel composition analysis, primary care vs specialist attribution rules, and risk-adjusted q' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Specialty .

ind:attributionPanelId rdf:type rdf:Property ;
    rdfs:label 'Attribution Panel Id' ;
    rdfs:comment 'Reference to the provider panel or patient panel record to which this attribution belongs. A panel represents the defined roster of patients assigned to a PCP or care team for population health management, capacity planning, and value-based care performance measurement.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AttributionPanel .

ind:careTeamId rdf:type rdf:Property ;
    rdfs:label 'Care Team Id' ;
    rdfs:comment 'Reference to the care team record when attribution is assigned to a multidisciplinary care team rather than a single PCP. Supports Accountable Care Organization (ACO) and Patient-Centered Medical Home (PCMH) attribution models where team-based care is the unit of attribution.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CareTeam .

ind:healthPlanId rdf:type rdf:Property ;
    rdfs:label 'Health Plan Id' ;
    rdfs:comment 'Reference to the payer insurance plan record associated with this attribution. Attribution rules and measurement periods vary by plan type (ACO, HMO, PPO, POS). Links to the billing and revenue cycle domain for plan-specific attribution logic.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:HealthPlan .

ind:rafScoreId rdf:type rdf:Property ;
    rdfs:label 'Raf Score Id' ;
    rdfs:comment 'FK to the RAF score record.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RafScore .

ind:acoContractNumber rdf:type rdf:Property ;
    rdfs:label 'Aco Contract Number' ;
    rdfs:comment 'CMS-assigned contract number for the Accountable Care Organization (ACO) governing this attribution. Required for CMS Medicare Shared Savings Program (MSSP) reporting, shared savings reconciliation, and regulatory submissions to CMS.' ;
    rdfs:domain ind:PcpAttribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:attributedProviderNpi rdf:type rdf:Property ;
    rdfs:label 'Attributed Provider Npi' ;
    rdfs:comment '10-digit National Provider Identifier (NPI) of the attributed Primary Care Physician (PCP) or care team lead as registered with the National Plan and Provider Enumeration System (NPPES). Required for HEDIS, MIPS, and CMS value-based care reporting submissions.' ;
    rdfs:domain ind:PcpAttribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:attributionConfidenceScore rdf:type rdf:Property ;
    rdfs:label 'Attribution Confidence Score' ;
    rdfs:comment 'Numeric score (0.00–100.00) representing the statistical confidence level of the attribution assignment. Higher scores indicate stronger evidence of the patient-PCP relationship based on visit frequency, claims history, or enrollment data. Used to prioritize manual review of low-confidence attributions and to weight population health analytics.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:attributionMethod rdf:type rdf:Property ;
    rdfs:label 'Attribution Method' ;
    rdfs:comment 'The methodology used to assign the patient to the PCP or care team. Claims-based attribution uses historical utilization patterns; enrollment-based uses payer plan enrollment data; manual is provider-assigned; algorithm-based uses predictive models; hybrid combines multiple methods; empanelment is practice-panel assignment. Drives HEDIS, MIPS, and ACO reporting logic.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:attributionOverrideReason rdf:type rdf:Property ;
    rdfs:label 'Attribution Override Reason' ;
    rdfs:comment 'Free-text or coded reason when an attribution assignment has been manually overridden from the algorithm-generated or payer-assigned attribution. Documents the clinical or administrative justification for the override, supporting audit trails and compliance with CMS and NCQA attribution integrity requirements.' ;
    rdfs:domain ind:PcpAttribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:attributionRank rdf:type rdf:Property ;
    rdfs:label 'Attribution Rank' ;
    rdfs:comment 'Ordinal rank (1 = primary) when a patient has multiple concurrent attribution records across different payers or plans. Rank 1 designates the primary PCP attribution used for population health management and HEDIS reporting. Higher ranks indicate secondary or supplemental attributions.' ;
    rdfs:domain ind:PcpAttribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:attributionReviewDate rdf:type rdf:Property ;
    rdfs:label 'Attribution Review Date' ;
    rdfs:comment 'Scheduled or completed date for the next periodic review of this attribution record. Attribution records are reviewed quarterly or annually per payer contract requirements to ensure accuracy of panel rosters and compliance with HEDIS and MIPS reporting periods.' ;
    rdfs:domain ind:PcpAttribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:attributionSegment rdf:type rdf:Property ;
    rdfs:label 'Attribution Segment' ;
    rdfs:comment 'Insurance coverage segment of the attributed patient. Determines applicable attribution methodology, quality measure set, and regulatory reporting requirements. Dual eligible patients (Medicare and Medicaid) require special attribution handling per CMS duals coordination rules.' ;
    rdfs:domain ind:PcpAttribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:attributionSource rdf:type rdf:Property ;
    rdfs:label 'Attribution Source' ;
    rdfs:comment 'The operational system of record from which this attribution record was sourced. Identifies whether the attribution originated from Epic Healthy Planet, Cerner Millennium, a payer attribution feed, manual entry, HL7 FHIR interface, or a population health management platform. Critical for data lineage and ETL reconciliation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:attributionStatus rdf:type rdf:Property ;
    rdfs:label 'Attribution Status' ;
    rdfs:comment 'Current lifecycle status of the PCP attribution record. Active indicates a current, valid attribution; pending indicates awaiting confirmation; disputed indicates a payer or provider challenge; terminated indicates the attribution period has ended; under_review indicates compliance or audit review in progress.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:careManagementEnrolled rdf:type rdf:Property ;
    rdfs:label 'Care Management Enrolled' ;
    rdfs:comment 'Indicates whether the attributed patient is currently enrolled in a care management or disease management program under the attributed PCP or ACO. True = enrolled in care management. Used for population health program tracking and HEDIS care management measure reporting.' ;
    rdfs:domain ind:PcpAttribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:consentOnFile rdf:type rdf:Property ;
    rdfs:label 'Consent On File' ;
    rdfs:comment 'Indicates whether the patient has provided documented consent for their health information to be shared with the attributed PCP, care team, and ACO for care coordination and population health management purposes. Required for HIPAA-compliant data sharing under ACO and HIE participation agreements.' ;
    rdfs:domain ind:PcpAttribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dataSharingOptOut rdf:type rdf:Property ;
    rdfs:label 'Data Sharing Opt Out' ;
    rdfs:comment 'Indicates whether the patient has exercised their right to opt out of data sharing with the ACO or population health program under CMS beneficiary notification and opt-out requirements. True = patient has opted out. Patients who opt out must be excluded from ACO attribution and shared data feeds.' ;
    rdfs:domain ind:PcpAttribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:disenrollmentReason rdf:type rdf:Property ;
    rdfs:label 'Disenrollment Reason' ;
    rdfs:comment 'Coded reason for the termination of the PCP attribution. Used for panel management analytics, provider turnover reporting, and population health program evaluation. [ENUM-REF-CANDIDATE: provider_change|plan_disenrollment|patient_request|provider_termination|death|moved_out_of_area|other — promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:endDate rdf:type rdf:Property ;
    rdfs:label 'End Date' ;
    rdfs:comment 'The calendar date on which the PCP attribution terminates. Null indicates an open-ended, currently active attribution. Used to calculate attribution duration, panel turnover, and to exclude patients from measurement periods after disenrollment or provider change.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:geographicRegion rdf:type rdf:Property ;
    rdfs:label 'Geographic Region' ;
    rdfs:comment 'Geographic region or service area associated with this attribution record, typically aligned with CMS Hospital Referral Regions (HRR) or payer-defined service areas. Used for population health geographic analysis, regional quality benchmarking, and ACO regional benchmark calculations.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hccRiskScore rdf:type rdf:Property ;
    rdfs:label 'Hcc Risk Score' ;
    rdfs:comment 'CMS Hierarchical Condition Category (HCC) risk adjustment score for the attributed patient at the time of attribution. Used in Medicare Advantage and ACO shared savings calculations to adjust expected expenditures for patient complexity. Sourced from CMS risk adjustment data or population health platform.' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hedisEligible rdf:type rdf:Property ;
    rdfs:label 'Hedis Eligible' ;
    rdfs:comment 'Indicates whether this attribution record qualifies the patient for inclusion in HEDIS (Healthcare Effectiveness Data and Information Set) measure calculations for the current measurement year. Eligibility is determined by continuous enrollment criteria, plan type, and attribution method per NCQA HEDIS Technical Specifications.' ;
    rdfs:domain ind:PcpAttribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPrimaryAttribution rdf:type rdf:Property ;
    rdfs:label 'Is Primary Attribution' ;
    rdfs:comment 'Indicates whether this attribution record is the patient\'s primary PCP attribution used as the single source of truth (SSOT) for population health management, HEDIS measurement, and MIPS performance reporting. True = primary attribution; False = secondary or supplemental attribution.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastVisitDate rdf:type rdf:Property ;
    rdfs:label 'Last Visit Date' ;
    rdfs:comment 'Date of the most recent qualifying primary care visit between the patient and the attributed PCP within the attribution lookback period. Used to assess recency of the patient-provider relationship and to support attribution validation and panel management.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lookbackPeriodMonths rdf:type rdf:Property ;
    rdfs:label 'Lookback Period Months' ;
    rdfs:comment 'The number of months in the historical claims lookback window used to determine claims-based attribution. Standard values are 12 or 24 months per CMS and NCQA attribution methodologies. Stored to support audit and reproducibility of attribution assignments.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:measurementYear rdf:type rdf:Property ;
    rdfs:label 'Measurement Year' ;
    rdfs:comment 'The calendar year for which this attribution record is applicable for quality measurement reporting (HEDIS, MIPS, ACO quality measures). Attribution records are typically finalized at the start of each measurement year and used throughout the performance period.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mipsEligible rdf:type rdf:Property ;
    rdfs:label 'Mips Eligible' ;
    rdfs:comment 'Indicates whether the attributed provider qualifies for Merit-based Incentive Payment System (MIPS) performance measurement under MACRA for this attribution record. Eligibility is based on provider NPI, patient volume thresholds, and billing thresholds per CMS MIPS eligibility criteria.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:overrideAuthorizedBy rdf:type rdf:Property ;
    rdfs:label 'Override Authorized By' ;
    rdfs:comment 'Name or identifier of the clinical or administrative staff member who authorized a manual attribution override. Required for audit trail integrity and compliance with CMS and NCQA attribution override documentation requirements.' ;
    rdfs:domain ind:PcpAttribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:overrideDate rdf:type rdf:Property ;
    rdfs:label 'Override Date' ;
    rdfs:comment 'Date on which the manual attribution override was authorized and applied. Used in conjunction with override_authorized_by and attribution_override_reason to maintain a complete audit trail of attribution changes.' ;
    rdfs:domain ind:PcpAttribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:panelAssignmentDate rdf:type rdf:Property ;
    rdfs:label 'Panel Assignment Date' ;
    rdfs:comment 'Date the patient was formally added to the attributed PCP\'s patient panel in the practice management or population health system (e.g., Epic Healthy Planet empanelment). May differ from the attribution effective date when payer attribution and practice empanelment are managed separately.' ;
    rdfs:domain ind:PcpAttribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:payerAttributionNumber rdf:type rdf:Property ;
    rdfs:label 'Payer Attribution Number' ;
    rdfs:comment 'The external attribution identifier assigned by the payer or managed care organization in their attribution feed. Used to reconcile internal attribution records with payer-issued attribution rosters and to resolve attribution disputes with payers.' ;
    rdfs:domain ind:PcpAttribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sdohFlag rdf:type rdf:Property ;
    rdfs:label 'Sdoh Flag' ;
    rdfs:comment 'Indicates whether the patient has documented Social Determinants of Health (SDOH) risk factors (e.g., food insecurity, housing instability, transportation barriers) that require care coordination support from the attributed PCP or care team. True = SDOH risk factors present.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sourceFeedDate rdf:type rdf:Property ;
    rdfs:label 'Source Feed Date' ;
    rdfs:comment 'Date of the payer attribution feed or population health system extract from which this attribution record was loaded. Used for data currency validation, ETL reconciliation, and to identify stale attribution records that require refresh from the source system.' ;
    rdfs:domain ind:PcpAttribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:visitCountLookback rdf:type rdf:Property ;
    rdfs:label 'Visit Count Lookback' ;
    rdfs:comment 'Number of qualifying primary care visits with the attributed provider during the claims-based attribution lookback period (typically 24 months). Used to validate and support claims-based attribution assignments and to calculate attribution confidence scores per CMS and NCQA methodologies.' ;
    rdfs:domain ind:PcpAttribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:eligibilityCheckId rdf:type rdf:Property ;
    rdfs:label 'Eligibility Check Id' ;
    rdfs:comment 'Unique surrogate identifier for each insurance eligibility verification transaction record in the Silver layer lakehouse.' ;
    rdfs:domain ind:EligibilityCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:clinicalOrderId rdf:type rdf:Property ;
    rdfs:label 'Clinical Order Id' ;
    rdfs:comment 'Foreign key linking to order.clinical_order. Business justification: Real-time benefit verification during CPOE ordering requires linking eligibility checks to specific orders for prior authorization determination, formulary checking, and coverage validation at order p' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ClinicalOrder .

ind:imagingOrderId rdf:type rdf:Property ;
    rdfs:label 'Imaging Order Id' ;
    rdfs:comment 'Foreign key linking to radiology.imaging_order. Business justification: Real-time eligibility verification is performed at imaging order placement for prior authorization requirements and coverage verification. Radiology orders frequently require pre-service authorization' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ImagingOrder .

ind:orderingClinicianId rdf:type rdf:Property ;
    rdfs:label 'Ordering Clinician Id' ;
    rdfs:comment 'Foreign key linking to provider.clinician. Business justification: Eligibility verifications are often triggered by specific provider orders or referrals. Tracking the ordering clinician supports prior authorization workflows, audit trails for medical necessity, and ' ;
    rdfs:domain ind:EligibilityCheck ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:clearinghouseName rdf:type rdf:Property ;
    rdfs:label 'Clearinghouse Name' ;
    rdfs:comment 'The name of the EDI clearinghouse (e.g., Change Healthcare, Availity, Waystar) used to route the 270/271 eligibility transaction between the provider and the payer. Null for direct payer connections.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coinsurancePercent rdf:type rdf:Property ;
    rdfs:label 'Coinsurance Percent' ;
    rdfs:comment 'The percentage of covered service costs the patient is responsible for after the deductible is met, as confirmed in the eligibility response (e.g., 20.00 for a 20% patient coinsurance obligation).' ;
    rdfs:domain ind:EligibilityCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:coordinationOfBenefitsFlag rdf:type rdf:Property ;
    rdfs:label 'Coordination Of Benefits Flag' ;
    rdfs:comment 'Indicates whether the patient has multiple insurance coverages requiring Coordination of Benefits (COB) processing. True = secondary or tertiary payer exists and COB rules must be applied during claims adjudication.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:coverageType rdf:type rdf:Property ;
    rdfs:label 'Coverage Type' ;
    rdfs:comment 'Indicates the order of coverage for this payer relative to other payers the patient may have. \'primary\' = first-pay payer; \'secondary\' = pays after primary; \'tertiary\' = pays after secondary.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:familyDeductibleAmount rdf:type rdf:Property ;
    rdfs:label 'Family Deductible Amount' ;
    rdfs:comment 'The annual family deductible amount for the patient\'s insurance plan as confirmed in the eligibility response. Applicable when the patient is covered under a family plan.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:individualDeductibleAmount rdf:type rdf:Property ;
    rdfs:label 'Individual Deductible Amount' ;
    rdfs:comment 'The annual individual deductible amount for the patient\'s insurance plan as confirmed in the eligibility response. Represents the amount the patient must pay out-of-pocket before insurance begins covering costs.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:individualDeductibleMetAmount rdf:type rdf:Property ;
    rdfs:label 'Individual Deductible Met Amount' ;
    rdfs:comment 'The year-to-date amount of the individual deductible that the patient has already satisfied as of the verification date. Used to calculate remaining patient financial responsibility.' ;
    rdfs:domain ind:EligibilityCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:individualOutOfPocketMax rdf:type rdf:Property ;
    rdfs:label 'Individual Out Of Pocket Max' ;
    rdfs:comment 'The annual individual out-of-pocket maximum (OOPM) for the patient\'s plan as confirmed in the eligibility response. Once met, the insurer covers 100% of covered services for the remainder of the benefit year.' ;
    rdfs:domain ind:EligibilityCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:individualOutOfPocketMet rdf:type rdf:Property ;
    rdfs:label 'Individual Out Of Pocket Met' ;
    rdfs:comment 'The year-to-date amount applied toward the patient\'s individual out-of-pocket maximum as of the verification date. Used to determine remaining patient financial liability.' ;
    rdfs:domain ind:EligibilityCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isOverride rdf:type rdf:Property ;
    rdfs:label 'Is Override' ;
    rdfs:comment 'Indicates whether the eligibility verification result was manually overridden by a staff member, superseding the automated payer response. True = result was overridden; False = result reflects the original payer response.' ;
    rdfs:domain ind:EligibilityCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:overrideReason rdf:type rdf:Property ;
    rdfs:label 'Override Reason' ;
    rdfs:comment 'Free-text reason documented when a staff member manually overrides the eligibility verification result (e.g., patient confirmed coverage verbally, payer system outage). Supports audit trail for compliance.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorAuthNumber rdf:type rdf:Property ;
    rdfs:label 'Prior Auth Number' ;
    rdfs:comment 'The prior authorization number issued by the payer for the specific service, if authorization has already been obtained at the time of eligibility verification. Null if no prior auth exists or is not yet required.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rejectionReasonCode rdf:type rdf:Property ;
    rdfs:label 'Rejection Reason Code' ;
    rdfs:comment 'The ASC X12 AAA reject reason code returned by the payer when the eligibility inquiry could not be processed (e.g., \'15\' = Required information missing, \'72\' = Invalid/missing subscriber/insured ID). Null when verification is successful.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rejectionReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Rejection Reason Description' ;
    rdfs:comment 'Human-readable description of the rejection reason returned by the payer or clearinghouse when the eligibility inquiry failed. Supports staff workflow resolution and denial prevention.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responseTimestamp rdf:type rdf:Property ;
    rdfs:label 'Response Timestamp' ;
    rdfs:comment 'The exact date and time when the payer returned the eligibility response (271 transaction or portal/phone response). Used to calculate verification turnaround time for SLA monitoring.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:serviceDate rdf:type rdf:Property ;
    rdfs:label 'Service Date' ;
    rdfs:comment 'The date of service for which eligibility is being verified. May be the date of an upcoming appointment or the date of a completed encounter. Used to confirm coverage was active on the specific date of care.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:serviceTypeCode rdf:type rdf:Property ;
    rdfs:label 'Service Type Code' ;
    rdfs:comment 'The ASC X12 service type code indicating the category of healthcare service for which eligibility was verified (e.g., \'30\' = Health Benefit Plan Coverage, \'98\' = Professional Physician Visit, \'48\' = Hospital Inpatient). Aligns with the 271 EB01 element.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transactionControlNumber rdf:type rdf:Property ;
    rdfs:label 'Transaction Control Number' ;
    rdfs:comment 'Unique control number assigned to the 270/271 EDI eligibility inquiry and response transaction set. Used for end-to-end transaction tracing and reconciliation with payer acknowledgments.' ;
    rdfs:domain ind:EligibilityCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verificationMethod rdf:type rdf:Property ;
    rdfs:label 'Verification Method' ;
    rdfs:comment 'The method used to perform the eligibility verification. \'edi_270_271\' = HIPAA-compliant EDI transaction; \'portal\' = payer web portal; \'phone\' = telephone inquiry; \'fax\' = fax-based verification; \'real_time_api\' = real-time API call (e.g., FHIR-based); \'batch\' = overnight batch eligibility run.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verificationStatus rdf:type rdf:Property ;
    rdfs:label 'Verification Status' ;
    rdfs:comment 'Current lifecycle status of the eligibility verification transaction as returned by the payer. \'active\' = patient is currently covered; \'inactive\' = coverage lapsed; \'pending\' = awaiting payer response; \'error\' = transaction failed; \'partial\' = incomplete response received; \'not_found\' = member not found in payer system.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verificationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Verification Timestamp' ;
    rdfs:comment 'The exact date and time when the eligibility verification request was initiated and submitted to the payer. Serves as the principal business event timestamp for this transaction.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:verificationType rdf:type rdf:Property ;
    rdfs:label 'Verification Type' ;
    rdfs:comment 'Indicates whether the eligibility check was performed in real-time at point of service, as part of a scheduled batch run (e.g., night-before appointment verification), or manually initiated by a staff member.' ;
    rdfs:domain ind:EligibilityCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verificationUser rdf:type rdf:Property ;
    rdfs:label 'Verification User' ;
    rdfs:domain ind:EligibilityCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verifiedByUser rdf:type rdf:Property ;
    rdfs:label 'Verified By User' ;
    rdfs:comment 'The username or staff identifier of the person who performed or confirmed the eligibility verification, applicable for manual or portal-based verifications. Null for fully automated EDI or batch verifications.' ;
    rdfs:domain ind:EligibilityCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:registrationEventId rdf:type rdf:Property ;
    rdfs:label 'Registration Event Id' ;
    rdfs:comment 'Unique surrogate identifier for each patient registration lifecycle event record in the Master Patient Index (MPI). Primary key for this product. Role: TRANSACTION_HEADER.' ;
    rdfs:domain ind:RegistrationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:primaryRegistrationClinicianId rdf:type rdf:Property ;
    rdfs:label 'Primary Registration Clinician Id' ;
    rdfs:comment 'Reference to the attending clinician assigned to the patient at the time of registration. Corresponds to HL7 PV1-7 Attending Doctor. Used for care team attribution and provider-level registration analytics.' ;
    rdfs:domain ind:RegistrationEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:primaryRegistrationMpiRecordId rdf:type rdf:Property ;
    rdfs:label 'Primary Registration Mpi Record Id' ;
    rdfs:comment 'Reference to the patient master record in the Master Patient Index (MPI) for whom this registration event was generated. Links every registration event to the canonical patient identity.' ;
    rdfs:domain ind:RegistrationEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MpiRecord .

ind:tertiaryRegistrationPcpProviderClinicianId rdf:type rdf:Property ;
    rdfs:label 'Tertiary Registration Pcp Provider Clinician Id' ;
    rdfs:comment 'Reference to the patient\'s designated Primary Care Physician (PCP) at the time of registration. Used for care coordination, referral authorization, and population health management.' ;
    rdfs:domain ind:RegistrationEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:admissionType rdf:type rdf:Property ;
    rdfs:label 'Admission Type' ;
    rdfs:comment 'Classifies the urgency and nature of the patient\'s admission at registration. Aligns with UB-04 Form Locator 14 and CMS billing requirements. Drives DRG grouping and reimbursement logic.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:admitReason rdf:type rdf:Property ;
    rdfs:label 'Admit Reason' ;
    rdfs:comment 'Free-text or coded description of the chief complaint or reason for the patient\'s registration or admission at this event. Corresponds to HL7 PV2-3 Admit Reason. Supports clinical documentation and triage analytics.' ;
    rdfs:domain ind:RegistrationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:adtMessageType rdf:type rdf:Property ;
    rdfs:label 'Adt Message Type' ;
    rdfs:comment 'The HL7 Admit Discharge Transfer (ADT) message type code that triggered or corresponds to this registration event (e.g., A01, A04, A08, A28, A31, A40). Provides direct traceability to the source HL7 message for interoperability and audit purposes.' ;
    rdfs:domain ind:RegistrationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:advanceDirectiveFlag rdf:type rdf:Property ;
    rdfs:label 'Advance Directive Flag' ;
    rdfs:comment 'Indicates whether the patient has an advance directive (e.g., living will, healthcare proxy, DNR order) on file at the time of this registration event. Required by the Patient Self-Determination Act and CMS Conditions of Participation.' ;
    rdfs:domain ind:RegistrationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:completenessScore rdf:type rdf:Property ;
    rdfs:label 'Completeness Score' ;
    rdfs:comment 'A numeric score (0.00–100.00) representing the percentage of required registration data fields that were populated at the time of this event. Used to identify incomplete registrations requiring follow-up and to measure registration quality across facilities and staff.' ;
    rdfs:domain ind:RegistrationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dischargeDisposition rdf:type rdf:Property ;
    rdfs:label 'Discharge Disposition' ;
    rdfs:comment 'The patient\'s discharge disposition code at the time of a discharge-related registration update event (e.g., home, skilled nursing facility, expired, AMA). Corresponds to UB-04 Form Locator 17 and HL7 PV1-36. Null for non-discharge events. [ENUM-REF-CANDIDATE: home|snf|rehab|expired|ama|transfer|hospice|ltac — promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:drgCode rdf:type rdf:Property ;
    rdfs:label 'Drg Code' ;
    rdfs:comment 'The preliminary Diagnosis-Related Group (DRG) code assigned at registration based on the anticipated principal diagnosis and procedure. Used for prospective payment estimation and case mix index (CMI) tracking. May be updated at discharge.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:duplicateFlag rdf:type rdf:Property ;
    rdfs:label 'Duplicate Flag' ;
    rdfs:comment 'Indicates whether this registration event was identified as a potential duplicate patient record in the Master Patient Index (MPI). Triggers MPI duplicate review and merge workflow. Critical for patient safety and data integrity.' ;
    rdfs:domain ind:RegistrationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:eligibilityVerificationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Eligibility Verification Timestamp' ;
    rdfs:comment 'The date and time at which insurance eligibility was electronically verified for this registration event. Used for revenue cycle audit trails and payer dispute resolution.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:eligibilityVerifiedFlag rdf:type rdf:Property ;
    rdfs:label 'Eligibility Verified Flag' ;
    rdfs:comment 'Indicates whether the patient\'s insurance eligibility was verified in real-time during this registration event via electronic eligibility transaction (HIPAA 270/271). Supports revenue cycle management and denial prevention.' ;
    rdfs:domain ind:RegistrationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:eventStatus rdf:type rdf:Property ;
    rdfs:label 'Event Status' ;
    rdfs:comment 'Current workflow status of the registration event. Completed indicates the event was fully processed and committed to the MPI. Pending indicates the event is awaiting verification or approval. Failed indicates a system or validation error prevented completion.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventTimestamp rdf:type rdf:Property ;
    rdfs:label 'Event Timestamp' ;
    rdfs:comment 'The precise date and time at which the registration event occurred in the source system. Represents the real-world business event time, not the record audit timestamp. Used for MPI audit trail sequencing and regulatory reporting.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:eventType rdf:type rdf:Property ;
    rdfs:label 'Event Type' ;
    rdfs:comment 'Classifies the type of registration lifecycle event: new_registration (first-time patient identity creation), pre_registration (advance registration before arrival), update (demographic or insurance data change), merge (two patient records combined in MPI), unmerge (previously merged records separated). Drives MPI audit trail logic.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expectedLosDays rdf:type rdf:Property ;
    rdfs:label 'Expected Los Days' ;
    rdfs:comment 'The anticipated Length of Stay (LOS) in days estimated at the time of registration or admission. Used for bed management, discharge planning, and case management workflows. Supports Average Length of Stay (ALOS) benchmarking.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:financialClass rdf:type rdf:Property ;
    rdfs:label 'Financial Class' ;
    rdfs:comment 'The patient\'s financial classification at the time of registration, indicating the primary payer category (e.g., Medicare, Medicaid, Commercial, Self-Pay, Charity). Drives revenue cycle routing, eligibility verification, and billing workflows. [ENUM-REF-CANDIDATE: medicare|medicaid|commercial|self_pay|charity|workers_comp|tricare — promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hipaaNoticeDeliveredFlag rdf:type rdf:Property ;
    rdfs:label 'Hipaa Notice Delivered Flag' ;
    rdfs:comment 'Indicates whether the HIPAA Notice of Privacy Practices (NPP) was delivered to the patient during this registration event, as required by the HIPAA Privacy Rule. Supports OCR audit readiness.' ;
    rdfs:domain ind:RegistrationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:identityVerificationMethod rdf:type rdf:Property ;
    rdfs:label 'Identity Verification Method' ;
    rdfs:comment 'The method used to verify the patient\'s identity at the time of registration. Options include government-issued photo ID, insurance card, biometric scan, passport, self-reported (no verification), or none. Critical for fraud prevention, HIPAA compliance, and MPI accuracy.' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isActive rdf:type rdf:Property ;
    rdfs:label 'Is Active' ;
    rdfs:comment 'Indicates whether this registration event record is the current active version in the silver layer. Set to False for records superseded by subsequent updates, merges, or corrections. Supports slowly changing dimension (SCD) pattern for MPI history.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:languagePreference rdf:type rdf:Property ;
    rdfs:label 'Language Preference' ;
    rdfs:comment 'The patient\'s preferred spoken or written language for communication, captured at registration. Drives interpreter services requests and language-concordant care delivery. Stored as ISO 639-1 two-letter language code (e.g., en, es, zh).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mpiMatchScore rdf:type rdf:Property ;
    rdfs:label 'Mpi Match Score' ;
    rdfs:comment 'The probabilistic match score (0.00–100.00) assigned by the MPI algorithm when this registration event was processed, indicating the confidence level of patient identity matching. Scores above threshold trigger auto-merge; scores in range trigger manual review.' ;
    rdfs:domain ind:RegistrationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mpiMatchStatus rdf:type rdf:Property ;
    rdfs:label 'Mpi Match Status' ;
    rdfs:comment 'The outcome of the MPI identity matching process for this registration event. Indicates whether the patient was identified as a new patient, automatically matched to an existing record, flagged for manual review, automatically merged, or returned no match.' ;
    rdfs:domain ind:RegistrationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pointOfCare rdf:type rdf:Property ;
    rdfs:label 'Point Of Care' ;
    rdfs:comment 'The specific unit, department, or care area within the facility where the patient was registered (e.g., Emergency Department, ICU, Outpatient Clinic). Corresponds to HL7 PV1-3 Assigned Patient Location. Used for capacity and throughput analytics.' ;
    rdfs:domain ind:RegistrationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preAuthorizationNumber rdf:type rdf:Property ;
    rdfs:label 'Pre Authorization Number' ;
    rdfs:comment 'The prior authorization number obtained from the payer at the time of registration for planned services. Required for revenue cycle management and claim adjudication. Null if no prior authorization was required or obtained.' ;
    rdfs:domain ind:RegistrationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorMrn rdf:type rdf:Property ;
    rdfs:label 'Prior Mrn' ;
    rdfs:comment 'The Medical Record Number of the patient record that was merged or unmerged in this event. Preserved for MPI audit trail and downstream system reconciliation. Null for non-merge events.' ;
    rdfs:domain ind:RegistrationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:registrationDate rdf:type rdf:Property ;
    rdfs:label 'Registration Date' ;
    rdfs:comment 'The calendar date on which the patient registration event was initiated. Used for day-level reporting, scheduling, and operational analytics distinct from the precise event timestamp.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:registrationSource rdf:type rdf:Property ;
    rdfs:label 'Registration Source' ;
    rdfs:comment 'The channel or pathway through which the patient registration was initiated. Examples include Emergency Department (ED) walk-in, scheduled appointment, inpatient transfer, online pre-registration portal, referral, or direct admission. Supports operational throughput and access analytics. [ENUM-REF-CANDIDATE: ed_walk_in|scheduled|transfer|online_pre_registration|referral|direct_admit — promote to reference product]' ;
    rdfs:domain ind:RegistrationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:restrictedRecordFlag rdf:type rdf:Property ;
    rdfs:label 'Restricted Record Flag' ;
    rdfs:comment 'Indicates whether this patient\'s record has been flagged for restricted access beyond standard role-based controls (e.g., sensitive diagnoses, employee patient, domestic violence victim). Enforces HIPAA minimum necessary and break-the-glass access policies.' ;
    rdfs:domain ind:RegistrationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sourceSystemEventCode rdf:type rdf:Property ;
    rdfs:label 'Source System Event Code' ;
    rdfs:comment 'The native identifier of this registration event in the originating source system (e.g., Epic ADT event ID, Cerner encounter number). Enables bidirectional traceability between the lakehouse silver layer and the operational EHR system.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:identityMergeHistoryId rdf:type rdf:Property ;
    rdfs:label 'Identity Merge History Id' ;
    rdfs:comment 'Unique surrogate identifier for each Master Patient Index (MPI) merge or unmerge event record in the identity merge history. Primary key for this table. Entity role: TRANSACTION_HEADER — tracks discrete MPI overlay business events with full lifecycle.' ;
    rdfs:domain ind:IdentityMergeHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:primaryIdentityCareSiteId rdf:type rdf:Property ;
    rdfs:label 'Primary Identity Care Site Id' ;
    rdfs:comment 'Reference to the healthcare facility associated with the surviving patient MRN. In multi-facility health systems, the surviving record may be anchored to a specific facility or enterprise entity. Supports facility-level MPI integrity reporting.' ;
    rdfs:domain ind:IdentityMergeHistory ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CareSite .

ind:primaryIdentityEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Identity Employee Id' ;
    rdfs:comment 'Reference to the Health Information Management (HIM) analyst or workforce member who reviewed and approved the merge event. Required for accountability, HIPAA audit trail, and quality oversight of MPI integrity operations.' ;
    rdfs:domain ind:IdentityMergeHistory ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:priorMergeEventIdentityMergeHistoryId rdf:type rdf:Property ;
    rdfs:label 'Prior Merge Event Identity Merge History Id' ;
    rdfs:comment 'Self-referencing identifier pointing to the original merge event that this record reverses or supersedes. Populated for unmerge events to establish the reversal chain. Enables full audit trail reconstruction of MPI overlay history.' ;
    rdfs:domain ind:IdentityMergeHistory ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:IdentityMergeHistory .

ind:approvingHimAnalystName rdf:type rdf:Property ;
    rdfs:label 'Approving Him Analyst Name' ;
    rdfs:comment 'Full name of the HIM analyst who approved the merge event, captured at the time of approval for audit trail purposes. Retained as a denormalized value to preserve the historical record even if the analyst\'s workforce record changes.' ;
    rdfs:domain ind:IdentityMergeHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:breachAssessmentRequired rdf:type rdf:Property ;
    rdfs:label 'Breach Assessment Required' ;
    rdfs:comment 'Indicates whether a formal HIPAA breach risk assessment is required as a result of this merge or unmerge event. Set to true when PHI may have been improperly disclosed due to an incorrect merge. Triggers the OCR-mandated breach notification workflow.' ;
    rdfs:domain ind:IdentityMergeHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:breachAssessmentStatus rdf:type rdf:Property ;
    rdfs:label 'Breach Assessment Status' ;
    rdfs:comment 'Current status of the HIPAA breach risk assessment associated with this merge event. Not_required indicates no PHI risk identified; pending indicates assessment not yet started; in_progress indicates under review; completed_no_breach indicates assessment concluded with no reportable breach; completed_breach_confirmed indicates a reportable breach was identified.' ;
    rdfs:domain ind:IdentityMergeHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:duplicateDetectionMethod rdf:type rdf:Property ;
    rdfs:label 'Duplicate Detection Method' ;
    rdfs:comment 'The technical method used to identify the duplicate patient records prior to the merge event. Exact match uses deterministic field equality; probabilistic uses weighted scoring; manual indicates HIM staff identification; rule_based uses configured business rules; ml_model uses a machine learning classifier; hybrid combines multiple methods.' ;
    rdfs:domain ind:IdentityMergeHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hl7MessageControlNumber rdf:type rdf:Property ;
    rdfs:label 'Hl7 Message Control Number' ;
    rdfs:comment 'The HL7 message identifier (MSH-10 Message Control ID) of the ADT A40 or FHIR Patient/$merge message that triggered or communicated this merge event. Supports HL7 interface traceability, cross-system reconciliation, and Health Information Exchange (HIE) audit.' ;
    rdfs:domain ind:IdentityMergeHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:matchingFieldsUsed rdf:type rdf:Property ;
    rdfs:label 'Matching Fields Used' ;
    rdfs:comment 'Comma-delimited list of patient demographic fields that were evaluated by the matching algorithm to identify the duplicate records (e.g., last_name, date_of_birth, ssn_last4, address, phone). Supports algorithm transparency, audit, and performance tuning.' ;
    rdfs:domain ind:IdentityMergeHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mergeConfidenceScore rdf:type rdf:Property ;
    rdfs:label 'Merge Confidence Score' ;
    rdfs:comment 'Numeric probability score (0.0000 to 1.0000) produced by the identity matching algorithm indicating the likelihood that the two patient records represent the same individual. Higher scores indicate greater algorithmic certainty. Used to stratify merge decisions and set review thresholds.' ;
    rdfs:domain ind:IdentityMergeHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mergeEventNumber rdf:type rdf:Property ;
    rdfs:label 'Merge Event Number' ;
    rdfs:comment 'Externally-known business identifier for this MPI merge or unmerge event, assigned by the source system (e.g., Epic MPI or 3M HIS). Used for cross-system traceability, audit inquiries, and HIPAA compliance reporting. Serves as the BUSINESS_IDENTIFIER for this transaction.' ;
    rdfs:domain ind:IdentityMergeHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mergeEventType rdf:type rdf:Property ;
    rdfs:label 'Merge Event Type' ;
    rdfs:comment 'Classification of the MPI identity event: merge (combining duplicate records), unmerge (reversing a prior merge), overlay (replacing one record\'s data with another), deactivation (retiring a non-surviving MRN), or reactivation (restoring a previously deactivated MRN). Drives downstream processing logic.' ;
    rdfs:domain ind:IdentityMergeHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mergeRationale rdf:type rdf:Property ;
    rdfs:label 'Merge Rationale' ;
    rdfs:comment 'Free-text narrative explanation provided by the HIM analyst or system documenting the clinical or administrative justification for the merge decision. Includes evidence reviewed (e.g., matching demographics, shared encounter history, insurance data). Required for HIPAA audit trail.' ;
    rdfs:domain ind:IdentityMergeHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mergeStatus rdf:type rdf:Property ;
    rdfs:label 'Merge Status' ;
    rdfs:comment 'Current workflow lifecycle state of the merge event. Pending indicates awaiting HIM analyst review; approved indicates authorized but not yet executed; completed indicates fully processed in the MPI; reversed indicates the merge was undone; failed indicates a system error prevented completion; under_review indicates flagged for additional scrutiny. Serves as the LIFECYCLE_STATUS for this transaction.' ;
    rdfs:domain ind:IdentityMergeHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mergeTriggerSource rdf:type rdf:Property ;
    rdfs:label 'Merge Trigger Source' ;
    rdfs:comment 'The originating source or workflow that initiated the merge event. Indicates whether the merge was triggered by an automated algorithm, manual HIM analyst review, an ADT (Admit Discharge Transfer) feed, patient registration workflow, payer matching, Health Information Exchange (HIE) notification, or batch deduplication process. [ENUM-REF-CANDIDATE: automated_algorithm|manual_him_review|adt_feed|registration_workflow|payer_match|hie_notification|batch_dedup — promote to reference product]' ;
    rdfs:domain ind:IdentityMergeHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mpiOverlayType rdf:type rdf:Property ;
    rdfs:label 'Mpi Overlay Type' ;
    rdfs:comment 'Specifies the scope of data overlaid during the merge event. Full overlay replaces all data from the non-surviving record; partial overlay merges selected data elements; demographic_only merges only identity/demographic fields; clinical_only merges only clinical encounter data. Supports impact analysis and reversal planning.' ;
    rdfs:domain ind:IdentityMergeHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nonSurvivingDobAtMerge rdf:type rdf:Property ;
    rdfs:label 'Non Surviving Dob At Merge' ;
    rdfs:comment 'Date of birth of the non-surviving (duplicate) patient as recorded at the time of the merge event. Captured as a point-in-time demographic snapshot for audit trail and identity verification during unmerge or dispute resolution.' ;
    rdfs:domain ind:IdentityMergeHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nonSurvivingEnterpriseMrn rdf:type rdf:Property ;
    rdfs:label 'Non Surviving Enterprise Mrn' ;
    rdfs:comment 'The enterprise-level Medical Record Number (MRN) associated with the non-surviving (duplicate) patient record prior to the merge. Retained for audit trail, unmerge operations, and HIPAA compliance.' ;
    rdfs:domain ind:IdentityMergeHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nonSurvivingMrn rdf:type rdf:Property ;
    rdfs:label 'Non Surviving Mrn' ;
    rdfs:comment 'The Medical Record Number (MRN) of the duplicate or erroneous patient record that is deactivated and subsumed into the surviving MRN during the merge event. Retained for audit trail and reversal capability.' ;
    rdfs:domain ind:IdentityMergeHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nonSurvivingPatientNameAtMerge rdf:type rdf:Property ;
    rdfs:label 'Non Surviving Patient Name At Merge' ;
    rdfs:comment 'Full name of the non-surviving (duplicate) patient as recorded at the time of the merge event. Captured as a point-in-time snapshot for audit trail and reversal purposes. Critical for confirming correct patient identification during unmerge operations.' ;
    rdfs:domain ind:IdentityMergeHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:patientSafetyImpactFlag rdf:type rdf:Property ;
    rdfs:label 'Patient Safety Impact Flag' ;
    rdfs:comment 'Indicates whether this merge or unmerge event has a potential patient safety impact, such as when clinical records (allergies, medications, diagnoses) from two different patients were commingled. Triggers patient safety event reporting and clinical review workflows.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:phiDisclosureRiskFlag rdf:type rdf:Property ;
    rdfs:label 'Phi Disclosure Risk Flag' ;
    rdfs:comment 'Indicates whether this merge event created a potential Protected Health Information (PHI) disclosure risk, such as when records from two different individuals were incorrectly merged and clinical data may have been exposed to the wrong patient or provider. Triggers mandatory HIPAA breach assessment workflow.' ;
    rdfs:domain ind:IdentityMergeHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:qualityReviewFlag rdf:type rdf:Property ;
    rdfs:label 'Quality Review Flag' ;
    rdfs:comment 'Indicates whether this merge event has been flagged for MPI quality review, such as for inclusion in periodic HIM audits, regulatory reporting, or quality improvement initiatives. Supports NCQA, CMS, and internal quality measurement programs.' ;
    rdfs:domain ind:IdentityMergeHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:qualityReviewNotes rdf:type rdf:Property ;
    rdfs:label 'Quality Review Notes' ;
    rdfs:comment 'Free-text notes entered by the HIM quality reviewer documenting findings, observations, or corrective actions identified during the quality review of this merge event. Supports continuous improvement of MPI integrity processes.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recordsAffectedCount rdf:type rdf:Property ;
    rdfs:label 'Records Affected Count' ;
    rdfs:comment 'The total number of clinical, financial, or administrative records (encounters, orders, claims, etc.) that were reassociated from the non-surviving MRN to the surviving MRN as a result of this merge event. Indicates the scope and impact of the merge operation.' ;
    rdfs:domain ind:IdentityMergeHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reversalApprovedBy rdf:type rdf:Property ;
    rdfs:label 'Reversal Approved By' ;
    rdfs:comment 'Name or identifier of the HIM analyst or supervisor who authorized the reversal (unmerge) of a prior merge event. Captured as a denormalized string for audit trail permanence. Supports accountability and HIPAA compliance.' ;
    rdfs:domain ind:IdentityMergeHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reversalReason rdf:type rdf:Property ;
    rdfs:label 'Reversal Reason' ;
    rdfs:comment 'Free-text explanation documenting why a prior merge event was reversed (unmerged). Populated only for unmerge event types. Common reasons include incorrect patient identification, registration error, or patient dispute. Required for HIPAA audit trail and MPI integrity governance.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reversalTimestamp rdf:type rdf:Property ;
    rdfs:label 'Reversal Timestamp' ;
    rdfs:comment 'The date and time when a prior merge event was reversed (unmerged) in the source system. Populated only for unmerge event types. Supports chronological audit trail reconstruction and MPI integrity reporting.' ;
    rdfs:domain ind:IdentityMergeHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:reviewPriority rdf:type rdf:Property ;
    rdfs:label 'Review Priority' ;
    rdfs:comment 'Priority level assigned to this merge event for HIM analyst review queue management. Routine indicates standard processing; urgent indicates elevated risk or patient safety concern; critical indicates immediate action required due to active patient care impact or confirmed PHI disclosure.' ;
    rdfs:domain ind:IdentityMergeHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemMergeCode rdf:type rdf:Property ;
    rdfs:label 'Source System Merge Code' ;
    rdfs:comment 'The native identifier assigned to this merge event by the originating operational system (e.g., Epic MPI event ID, 3M HIS transaction ID). Used for cross-system traceability and reconciliation between the data platform and source systems.' ;
    rdfs:domain ind:IdentityMergeHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:survivingDobAtMerge rdf:type rdf:Property ;
    rdfs:label 'Surviving Dob At Merge' ;
    rdfs:comment 'Date of birth of the surviving patient as recorded at the time of the merge event. Captured as a point-in-time demographic snapshot for audit trail and identity verification purposes during unmerge or dispute resolution.' ;
    rdfs:domain ind:IdentityMergeHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:survivingEnterpriseMrn rdf:type rdf:Property ;
    rdfs:label 'Surviving Enterprise Mrn' ;
    rdfs:comment 'The enterprise-level (cross-facility) Medical Record Number (MRN) assigned to the surviving patient identity in the Master Patient Index (MPI). Distinct from facility-level MRN; used in multi-facility health systems for enterprise-wide patient matching.' ;
    rdfs:domain ind:IdentityMergeHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:survivingMrn rdf:type rdf:Property ;
    rdfs:label 'Surviving Mrn' ;
    rdfs:comment 'The Medical Record Number (MRN) of the patient record that is retained as the active, canonical identity in the Master Patient Index (MPI) following the merge. All clinical and financial records are associated to this MRN post-merge.' ;
    rdfs:domain ind:IdentityMergeHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:survivingPatientNameAtMerge rdf:type rdf:Property ;
    rdfs:label 'Surviving Patient Name At Merge' ;
    rdfs:comment 'Full name of the surviving patient as recorded at the time of the merge event. Captured as a point-in-time snapshot for audit trail purposes, as the patient\'s name in the master record may change over time. Supports historical audit and HIPAA compliance.' ;
    rdfs:domain ind:IdentityMergeHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:flagId rdf:type rdf:Property ;
    rdfs:label 'Flag Id' ;
    rdfs:comment 'Unique system-generated identifier for each patient-level clinical or administrative alert flag record. Primary key for the patient flag entity.' ;
    rdfs:domain ind:Flag ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:icdCodeId rdf:type rdf:Property ;
    rdfs:label 'Icd Code Id' ;
    rdfs:comment 'Foreign key linking to reference.icd_code. Business justification: Clinical flags for infectious disease precautions, isolation protocols, and condition-specific alerts reference ICD-10 codes (e.g., A41.9 for sepsis precautions). Supports infection control workflows,' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:IcdCode .

ind:primaryFlagClinicianId rdf:type rdf:Property ;
    rdfs:label 'Primary Flag Clinician Id' ;
    rdfs:comment 'Reference to the clinician or staff member who created or initiated this flag. Used for accountability, audit, and follow-up workflows.' ;
    rdfs:domain ind:Flag ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:snomedConceptId rdf:type rdf:Property ;
    rdfs:label 'Snomed Concept Id' ;
    rdfs:comment 'Foreign key linking to reference.snomed_concept. Business justification: Clinical flags use SNOMED CT for precise concepts (fall risk, allergy severity, behavioral health alerts). Enables clinical decision support rules, interoperability via FHIR Flag resource, and granula' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SnomedConcept .

ind:tertiaryFlagReviewedByProviderClinicianId rdf:type rdf:Property ;
    rdfs:label 'Tertiary Flag Reviewed By Provider Clinician Id' ;
    rdfs:comment 'Reference to the clinician or staff member who most recently reviewed this flag for continued clinical relevance. Supports accountability and periodic review compliance.' ;
    rdfs:domain ind:Flag ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:acknowledgmentCount rdf:type rdf:Property ;
    rdfs:label 'Acknowledgment Count' ;
    rdfs:comment 'Total number of times this flag has been acknowledged by clinical or administrative staff. Supports alert fatigue analysis and compliance monitoring for mandatory acknowledgment flags.' ;
    rdfs:domain ind:Flag ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:amaHistoryFlag rdf:type rdf:Property ;
    rdfs:label 'Ama History Flag' ;
    rdfs:comment 'Indicates whether this flag specifically documents a history of the patient leaving Against Medical Advice (AMA). Supports risk management, care planning, and EMTALA compliance workflows.' ;
    rdfs:domain ind:Flag ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:flagCode rdf:type rdf:Property ;
    rdfs:label 'Flag Code' ;
    rdfs:comment 'Standardized code identifying the specific flag, aligned with the source EHR system\'s internal code set or a standard terminology (e.g., SNOMED CT concept code for the alert condition). Enables interoperability and cross-system flag reconciliation.' ;
    rdfs:domain ind:Flag ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:codeSystem rdf:type rdf:Property ;
    rdfs:label 'Code System' ;
    rdfs:comment 'Identifies the coding system or terminology used for the flag_code (e.g., SNOMED-CT, ICD-10, LOCAL for facility-defined codes). Supports interoperability and terminology mapping across systems.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:confidentialityLevel rdf:type rdf:Property ;
    rdfs:label 'Confidentiality Level' ;
    rdfs:comment 'Confidentiality classification of this flag controlling which roles and users may view it. Restricted and very-restricted flags (e.g., VIP, behavioral, legal hold) are visible only to authorized personnel. Supports HIPAA minimum necessary standard.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:flagDescription rdf:type rdf:Property ;
    rdfs:label 'Flag Description' ;
    rdfs:comment 'Free-text narrative describing the clinical or administrative alert, including relevant context, specific precautions required, or instructions for care team members. Contains Protected Health Information (PHI) and must be handled per HIPAA requirements.' ;
    rdfs:domain ind:Flag ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:displayInChart rdf:type rdf:Property ;
    rdfs:label 'Display In Chart' ;
    rdfs:comment 'Indicates whether this flag should be prominently displayed in the patient\'s electronic health record chart header or banner. Controls EHR display logic for patient safety alerts.' ;
    rdfs:domain ind:Flag ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:displayInRegistration rdf:type rdf:Property ;
    rdfs:label 'Display In Registration' ;
    rdfs:comment 'Indicates whether this flag should be surfaced during patient registration and ADT workflows. Supports administrative flags such as financial hardship, legal hold, or VIP status at point of registration.' ;
    rdfs:domain ind:Flag ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:displayInScheduling rdf:type rdf:Property ;
    rdfs:label 'Display In Scheduling' ;
    rdfs:comment 'Indicates whether this flag should be visible in scheduling and appointment management workflows (e.g., Epic Cadence). Supports pre-visit preparation for flags such as interpreter needed, VIP, or behavioral alerts.' ;
    rdfs:domain ind:Flag ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:expirationDate rdf:type rdf:Property ;
    rdfs:label 'Expiration Date' ;
    rdfs:comment 'The date on which this flag is scheduled to expire or be automatically inactivated. Null indicates the flag is indefinite and requires manual resolution. Supports time-limited flags such as infectious precautions or temporary behavioral alerts.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fallRiskAssessmentTool rdf:type rdf:Property ;
    rdfs:label 'Fall Risk Assessment Tool' ;
    rdfs:comment 'Identifies the standardized fall risk assessment instrument used to generate the fall_risk_score. Supports comparability of fall risk data across units and facilities.' ;
    rdfs:domain ind:Flag ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fallRiskScore rdf:type rdf:Property ;
    rdfs:label 'Fall Risk Score' ;
    rdfs:comment 'Numeric fall risk assessment score (e.g., Morse Fall Scale or Johns Hopkins Fall Risk Assessment Tool score) associated with a fall risk flag. Null when flag_subtype is not fall risk. Supports NDNQI fall prevention reporting and The Joint Commission NPSG.09.02.01.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:flagStatus rdf:type rdf:Property ;
    rdfs:label 'Flag Status' ;
    rdfs:comment 'Current lifecycle status of the patient flag. Active flags are displayed in clinical workflows; inactive or resolved flags are retained for historical reference; entered-in-error flags are suppressed from display but preserved for audit.' ;
    rdfs:domain ind:Flag ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:flagType rdf:type rdf:Property ;
    rdfs:label 'Flag Type' ;
    rdfs:comment 'High-level category of the flag indicating whether it is clinical (e.g., allergy, fall risk), administrative (e.g., VIP, interpreter needed), safety (e.g., infectious precaution, latex allergy), behavioral (e.g., behavioral alert), financial (e.g., financial hardship), or legal (e.g., legal hold). Drives routing and display logic across care settings.' ;
    rdfs:domain ind:Flag ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:flaggedByRole rdf:type rdf:Property ;
    rdfs:label 'Flagged By Role' ;
    rdfs:comment 'The professional role or job function of the individual who created this flag. Provides context for the flag\'s origin and supports role-based analytics on flag creation patterns. [ENUM-REF-CANDIDATE: physician|nurse|pharmacist|social_worker|case_manager|administrative|security|other — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Flag ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:flaggedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Flagged Timestamp' ;
    rdfs:comment 'The date and time when this flag was first entered into the EHR system. Serves as the record audit creation timestamp and supports chronological ordering of flag history.' ;
    rdfs:domain ind:Flag ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:infectiousPrecautionType rdf:type rdf:Property ;
    rdfs:label 'Infectious Precaution Type' ;
    rdfs:comment 'Specifies the type of infection control precaution required for this patient when the flag_subtype is infectious precaution. Drives isolation protocols, PPE requirements, and room assignment workflows. Null when not applicable.' ;
    rdfs:domain ind:Flag ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interpreterLanguage rdf:type rdf:Property ;
    rdfs:label 'Interpreter Language' ;
    rdfs:comment 'The language for which an interpreter is required when the flag_subtype is interpreter needed. Uses ISO 639-1 two-letter language codes (e.g., es for Spanish, zh for Chinese). Supports Title VI compliance and patient communication workflows.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isEnterpriseWide rdf:type rdf:Property ;
    rdfs:label 'Is Enterprise Wide' ;
    rdfs:comment 'Indicates whether this flag applies across all facilities in the enterprise (True) or is scoped to a specific facility (False). Enterprise-wide flags travel with the patient to any care setting within the health system.' ;
    rdfs:domain ind:Flag ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastAcknowledgedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Acknowledged Timestamp' ;
    rdfs:comment 'The most recent date and time this flag was acknowledged by a staff member. Supports compliance monitoring and identification of flags that have not been recently reviewed.' ;
    rdfs:domain ind:Flag ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:lastReviewedDate rdf:type rdf:Property ;
    rdfs:label 'Last Reviewed Date' ;
    rdfs:comment 'The date on which this flag was most recently reviewed by a clinician or authorized staff member for continued relevance and accuracy. Supports periodic flag review workflows required by accreditation standards.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalHoldReference rdf:type rdf:Property ;
    rdfs:label 'Legal Hold Reference' ;
    rdfs:comment 'Reference number or case identifier associated with a legal hold flag. Links the patient flag to the corresponding legal matter or litigation hold managed by the health system\'s legal department. Null when flag_subtype is not legal hold.' ;
    rdfs:domain ind:Flag ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:onsetDate rdf:type rdf:Property ;
    rdfs:label 'Onset Date' ;
    rdfs:comment 'The date on which the condition or circumstance prompting this flag first became clinically or administratively relevant for the patient. Distinct from the date the flag was entered into the system.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:phiFlag rdf:type rdf:Property ;
    rdfs:label 'Phi Flag' ;
    rdfs:comment 'Indicates whether this flag record contains Protected Health Information (PHI) as defined under HIPAA. Drives data governance, access control, and de-identification workflows in the lakehouse.' ;
    rdfs:domain ind:Flag ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresAcknowledgment rdf:type rdf:Property ;
    rdfs:label 'Requires Acknowledgment' ;
    rdfs:comment 'Indicates whether clinical or administrative staff must explicitly acknowledge this flag before proceeding with patient care activities. Supports mandatory alert workflows for high-severity flags such as fall risk or infectious precautions.' ;
    rdfs:domain ind:Flag ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:resolutionReason rdf:type rdf:Property ;
    rdfs:label 'Resolution Reason' ;
    rdfs:comment 'Reason code explaining why the flag was resolved or inactivated. Supports quality review, audit, and analytics on flag lifecycle patterns. [ENUM-REF-CANDIDATE: condition_resolved|entered_in_error|patient_request|clinical_review|expired|superseded|other — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Flag ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resolvedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Resolved Timestamp' ;
    rdfs:comment 'The date and time when this flag was resolved, inactivated, or marked as entered-in-error. Null if the flag remains active. Supports lifecycle tracking and compliance reporting.' ;
    rdfs:domain ind:Flag ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:sampleAmount rdf:type rdf:Property ;
    rdfs:label 'Sample Amount' ;
    rdfs:comment 'Sample monetary attribute added by mutator' ;
    rdfs:domain ind:Flag ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sampleDate rdf:type rdf:Property ;
    rdfs:label 'Sample Date' ;
    rdfs:comment 'Sample date attribute added by mutator' ;
    rdfs:domain ind:Flag ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:sampleFlag rdf:type rdf:Property ;
    rdfs:label 'Sample Flag' ;
    rdfs:comment 'Sample flag attribute added by mutator' ;
    rdfs:domain ind:Flag ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:severity rdf:type rdf:Property ;
    rdfs:label 'Severity' ;
    rdfs:comment 'Clinical or administrative severity level of the flag indicating urgency and required response. Critical flags require immediate action; informational flags are advisory only. Drives alert prioritization and display prominence in EHR workflows.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemFlagCode rdf:type rdf:Property ;
    rdfs:label 'Source System Flag Code' ;
    rdfs:comment 'The native identifier of this flag record in the originating operational system (e.g., Epic internal flag ID, Cerner alert ID). Supports bidirectional traceability between the lakehouse silver layer and the source EHR system.' ;
    rdfs:domain ind:Flag ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:subtype rdf:type rdf:Property ;
    rdfs:label 'Subtype' ;
    rdfs:comment 'Granular classification of the flag within its type. Examples include: VIP, fall risk, latex allergy, infectious precaution, AMA history, safety risk, interpreter needed, financial hardship, legal hold, elopement risk, violence risk, do not resuscitate. [ENUM-REF-CANDIDATE: vip|fall_risk|latex_allergy|infectious_precaution|ama_history|safety_risk|interpreter_needed|financial_hardship|legal_hold|elopement_risk|violence_risk|do_not_resuscitate — promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sweepClassificationApplied rdf:type rdf:Property ;
    rdfs:label 'Sweep Classification Applied' ;
    rdfs:comment 'Marker indicating global PII/PHI and type-classification sweep was applied.' ;
    rdfs:domain ind:Flag ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:populationSegmentId rdf:type rdf:Property ;
    rdfs:label 'Population Segment Id' ;
    rdfs:comment 'Unique surrogate identifier for each patient population segmentation and risk stratification record in the Silver Layer lakehouse. Primary key for this entity.' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PopulationSegment .

ind:costCenterId rdf:type rdf:Property ;
    rdfs:label 'Cost Center Id' ;
    rdfs:comment 'Foreign key linking to finance.cost_center. Business justification: Population health and care management programs are budgeted and managed by cost center. Value-based care contract performance reporting requires cost center attribution for care management expenses to' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CostCenter .

ind:definingIcdCodeId rdf:type rdf:Property ;
    rdfs:label 'Defining Icd Code Id' ;
    rdfs:comment 'Foreign key linking to reference.icd_code. Business justification: Risk stratification segments (diabetes_flag, chf_flag, copd_flag) are defined by specific ICD-10 diagnosis codes. Linking the defining diagnosis enables transparent stratification logic, audit trails ' ;
    rdfs:domain ind:PopulationSegment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:IcdCode .

ind:groupId rdf:type rdf:Property ;
    rdfs:label 'Group Id' ;
    rdfs:comment 'Reference to the practice or clinic to which the patient is attributed for population health management and ACO performance reporting. Supports panel-level analytics and practice-level care gap reporting.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Group .

ind:segmentCareSiteId rdf:type rdf:Property ;
    rdfs:label 'Segment Care Site Id' ;
    rdfs:comment 'Foreign key linking to facility.care_site. Business justification: Risk stratification and population health segments are facility-specific for attributed patient panels, ACO performance reporting by site, and care management resource planning. MSSP and value-based c' ;
    rdfs:domain ind:PopulationSegment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CareSite .

ind:acoAttributionFlag rdf:type rdf:Property ;
    rdfs:label 'Aco Attribution Flag' ;
    rdfs:comment 'Indicates whether the patient is attributed to an Accountable Care Organization (ACO) for the current performance year. Attributed patients are included in ACO quality and financial performance calculations.' ;
    rdfs:domain ind:PopulationSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:acoCode rdf:type rdf:Property ;
    rdfs:label 'Aco Code' ;
    rdfs:comment 'Reference to the ACO to which the patient is attributed for the current performance year. Used for ACO-level quality reporting, shared savings calculations, and CMS submission.' ;
    rdfs:domain ind:PopulationSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:asthmaFlag rdf:type rdf:Property ;
    rdfs:label 'Asthma Flag' ;
    rdfs:comment 'Indicates whether the patient has an active diagnosis of asthma as identified by the stratification model. Used for chronic disease cohort identification and HEDIS Asthma Medication Ratio measure targeting.' ;
    rdfs:domain ind:PopulationSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:attributedCareProgram rdf:type rdf:Property ;
    rdfs:label 'Attributed Care Program' ;
    rdfs:comment 'Name or code of the care management or population health program to which the patient is attributed based on their segment assignment (e.g., Complex Care Management, Transitional Care, Diabetes Disease Management, ACO Care Coordination). Drives workflow routing in Epic Healthy Planet.' ;
    rdfs:domain ind:PopulationSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:careGapCount rdf:type rdf:Property ;
    rdfs:label 'Care Gap Count' ;
    rdfs:comment 'Total number of open care gaps identified for the patient at the time of stratification, based on HEDIS and clinical quality measures. Drives outreach prioritization and care coordinator workload assignment in population health programs.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:careGapCountOpen rdf:type rdf:Property ;
    rdfs:label 'Care Gap Count Open' ;
    rdfs:comment 'Number of open care gaps for this patient segment.' ;
    rdfs:domain ind:PopulationSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:careManagementEnrollmentFlag rdf:type rdf:Property ;
    rdfs:label 'Care Management Enrollment Flag' ;
    rdfs:comment 'Indicates whether the patient is currently enrolled in a formal care management or disease management program based on their segment assignment. Distinguishes patients receiving active care management from those identified but not yet enrolled.' ;
    rdfs:domain ind:PopulationSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:chfFlag rdf:type rdf:Property ;
    rdfs:label 'Chf Flag' ;
    rdfs:comment 'Indicates whether the patient has an active diagnosis of congestive heart failure (CHF) as identified by the stratification model. Used for chronic disease cohort identification, readmission risk stratification, and HEDIS measure targeting.' ;
    rdfs:domain ind:PopulationSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:chronicConditionCount rdf:type rdf:Property ;
    rdfs:label 'Chronic Condition Count' ;
    rdfs:comment 'Total number of distinct active chronic conditions identified for the patient by the stratification model. Used as a complexity indicator for care management intensity assignment and risk tier determination.' ;
    rdfs:domain ind:PopulationSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ckdFlag rdf:type rdf:Property ;
    rdfs:label 'Ckd Flag' ;
    rdfs:comment 'Indicates whether the patient has an active diagnosis of chronic kidney disease (CKD) as identified by the stratification model. Used for chronic disease cohort identification and nephrology care management program targeting.' ;
    rdfs:domain ind:PopulationSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:copdFlag rdf:type rdf:Property ;
    rdfs:label 'Copd Flag' ;
    rdfs:comment 'Indicates whether the patient has an active diagnosis of chronic obstructive pulmonary disease (COPD) as identified by the stratification model. Used for chronic disease cohort identification and respiratory disease management program targeting.' ;
    rdfs:domain ind:PopulationSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:depressionFlag rdf:type rdf:Property ;
    rdfs:label 'Depression Flag' ;
    rdfs:comment 'Indicates whether the patient has an active diagnosis of depression or major depressive disorder as identified by the stratification model. Used for behavioral health integration, HEDIS Depression Screening measure targeting, and care program enrollment.' ;
    rdfs:domain ind:PopulationSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:diabetesFlag rdf:type rdf:Property ;
    rdfs:label 'Diabetes Flag' ;
    rdfs:comment 'Indicates whether the patient has an active diagnosis of diabetes mellitus (Type 1 or Type 2) as identified by the stratification model using ICD-10 codes. Used for chronic disease cohort identification and HEDIS Comprehensive Diabetes Care measure targeting.' ;
    rdfs:domain ind:PopulationSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:edUtilizationRiskFlag rdf:type rdf:Property ;
    rdfs:label 'Ed Utilization Risk Flag' ;
    rdfs:comment 'Indicates whether the patient has been identified as high-risk for avoidable Emergency Department (ED) utilization based on the stratification model. Supports AHRQ Prevention Quality Indicator (PQI) reporting and ED diversion programs.' ;
    rdfs:domain ind:PopulationSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hccConditionCount rdf:type rdf:Property ;
    rdfs:label 'Hcc Condition Count' ;
    rdfs:comment 'Number of distinct CMS HCC categories mapped to the patient\'s active diagnoses. Used for risk adjustment completeness audits, CDI (Clinical Documentation Improvement) gap identification, and RAF (Risk Adjustment Factor) optimization.' ;
    rdfs:domain ind:PopulationSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:hypertensionFlag rdf:type rdf:Property ;
    rdfs:label 'Hypertension Flag' ;
    rdfs:comment 'Indicates whether the patient has an active diagnosis of hypertension as identified by the stratification model. Used for chronic disease cohort identification and HEDIS Controlling High Blood Pressure measure targeting.' ;
    rdfs:domain ind:PopulationSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:measurementPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Measurement Period End Date' ;
    rdfs:comment 'End date of the measurement or look-back period used by the stratification model to evaluate the patient\'s clinical history, utilization patterns, and chronic condition burden.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:measurementPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Measurement Period Start Date' ;
    rdfs:comment 'Start date of the measurement or look-back period used by the stratification model to evaluate the patient\'s clinical history, utilization patterns, and chronic condition burden.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:mipsEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Mips Eligible Flag' ;
    rdfs:comment 'Patient is in a MIPS-eligible clinician panel.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:payerProductType rdf:type rdf:Property ;
    rdfs:label 'Payer Product Type' ;
    rdfs:comment 'Classification of the patient\'s insurance product type at the time of stratification. Determines applicable risk adjustment model, quality measure set, and care program eligibility. Dual Eligible indicates patients covered by both Medicare and Medicaid.' ;
    rdfs:domain ind:PopulationSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:performanceYear rdf:type rdf:Property ;
    rdfs:label 'Performance Year' ;
    rdfs:comment 'The calendar year for which this population segment assignment and risk stratification is valid. Used to partition historical stratification records for year-over-year trend analysis and ACO performance reporting.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:predictedUtilizationTier rdf:type rdf:Property ;
    rdfs:label 'Predicted Utilization Tier' ;
    rdfs:comment 'Predicted healthcare utilization tier for the patient over the next 12 months, derived from the stratification model. Informs care management intensity, proactive outreach scheduling, and resource allocation planning.' ;
    rdfs:domain ind:PopulationSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorRiskScore rdf:type rdf:Property ;
    rdfs:label 'Prior Risk Score' ;
    rdfs:comment 'The patient\'s risk score from the immediately preceding stratification cycle. Used to calculate risk score delta and identify patients with significant risk trajectory changes requiring care management intervention.' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priorRiskTier rdf:type rdf:Property ;
    rdfs:label 'Prior Risk Tier' ;
    rdfs:comment 'The patient\'s risk tier from the immediately preceding stratification cycle. Enables risk tier transition analysis (e.g., rising-risk identification, care management effectiveness measurement) and population health trend reporting.' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:readmissionRiskFlag rdf:type rdf:Property ;
    rdfs:label 'Readmission Risk Flag' ;
    rdfs:comment 'Indicates whether the patient has been identified as high-risk for 30-day hospital readmission based on the stratification model. Triggers transitional care management (TCM) outreach and care coordination workflows.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:riskScore rdf:type rdf:Property ;
    rdfs:label 'Risk Score' ;
    rdfs:comment 'Numeric composite risk score assigned to the patient by the stratification model. Higher values indicate greater predicted utilization or clinical risk. Sourced from the model identified in risk_score_source (e.g., CMS HCC, ACG, or proprietary algorithm).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskScorePercentile rdf:type rdf:Property ;
    rdfs:label 'Risk Score Percentile' ;
    rdfs:comment 'Percentile rank of the patient\'s risk score within the attributed population panel, expressed as a value between 0.00 and 100.00. Enables relative risk comparison across the population for care gap prioritization.' ;
    rdfs:domain ind:PopulationSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:riskScoreSource rdf:type rdf:Property ;
    rdfs:label 'Risk Score Source' ;
    rdfs:comment 'Identifies the risk scoring model or algorithm used to generate the patient\'s risk score. CMS HCC (Hierarchical Condition Category) is used for Medicare populations; ACG (Adjusted Clinical Groups) for commercial; proprietary models may be used for internal programs.' ;
    rdfs:domain ind:PopulationSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskTier rdf:type rdf:Property ;
    rdfs:label 'Risk Tier' ;
    rdfs:comment 'Ordinal risk stratification tier assigned to the patient, where Tier 1 represents the highest-risk patients requiring intensive care management and Tier 5 represents the lowest-risk healthy population. Used for ACO performance reporting and care resource allocation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sdohDomainFlags rdf:type rdf:Property ;
    rdfs:label 'Sdoh Domain Flags' ;
    rdfs:comment 'Pipe-delimited list of specific SDOH domains identified for the patient (e.g., food_insecurity|housing_instability|transportation|social_isolation|financial_strain). Supports targeted community resource referrals and SDOH-informed care planning.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sdohRiskFlag rdf:type rdf:Property ;
    rdfs:label 'Sdoh Risk Flag' ;
    rdfs:comment 'Indicates whether the patient has been identified as having one or more Social Determinants of Health (SDOH) risk factors (e.g., food insecurity, housing instability, transportation barriers) that may impact care outcomes and utilization.' ;
    rdfs:domain ind:PopulationSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:segmentType rdf:type rdf:Property ;
    rdfs:label 'Segment Type' ;
    rdfs:comment 'Categorical classification of the patient\'s population segment as defined by the population health management program. Drives care program assignment, outreach prioritization, and HEDIS measure targeting. [ENUM-REF-CANDIDATE: chronic_disease_cohort|high_risk|rising_risk|healthy|complex_care|palliative — promote to reference product if additional values are needed]' ;
    rdfs:domain ind:PopulationSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemSegmentCode rdf:type rdf:Property ;
    rdfs:label 'Source System Segment Code' ;
    rdfs:comment 'The native identifier for this population segment record in the source operational system (e.g., Epic Healthy Planet internal segment ID). Supports bidirectional traceability between the lakehouse Silver Layer and the source EHR.' ;
    rdfs:domain ind:PopulationSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stratificationDate rdf:type rdf:Property ;
    rdfs:label 'Stratification Date' ;
    rdfs:comment 'The most recent date on which the patient\'s risk score and segment assignment were calculated or refreshed by the stratification model. Used to identify stale stratifications requiring recalculation.' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:stratificationModelVersion rdf:type rdf:Property ;
    rdfs:label 'Stratification Model Version' ;
    rdfs:comment 'Version identifier of the risk stratification model or algorithm used to produce this segment assignment. Critical for reproducibility, model governance, and year-over-year trend analysis in population health reporting.' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stratificationStatus rdf:type rdf:Property ;
    rdfs:label 'Stratification Status' ;
    rdfs:comment 'Current lifecycle status of this population segment record. Active indicates the current valid assignment; superseded indicates a prior assignment replaced by a newer stratification run; pending_review indicates the record requires clinical validation.' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:careProgramEnrollmentId rdf:type rdf:Property ;
    rdfs:label 'Care Program Enrollment Id' ;
    rdfs:comment 'Unique surrogate identifier for each care program enrollment record. Primary key for this entity. Role: MASTER_AGREEMENT — this entity represents a long-running binding relationship between a patient and a population health care management program.' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CareProgramEnrollment .

ind:carePlanId rdf:type rdf:Property ;
    rdfs:label 'Care Plan Id' ;
    rdfs:comment 'Reference to the active care plan associated with this enrollment. Links the enrollment to the patient\'s individualized care plan containing goals, interventions, and care team assignments managed in the clinical domain.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CarePlan .

ind:complianceProgramId rdf:type rdf:Property ;
    rdfs:label 'Compliance Program Id' ;
    rdfs:comment 'Reference to the care management program definition in which the patient is enrolled (e.g., Diabetes Disease Management, CHF Care Coordination, High-Risk Care Management). Links to the program catalog.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ComplianceProgram .

ind:enrollmentCareSiteId rdf:type rdf:Property ;
    rdfs:label 'Enrollment Care Site Id' ;
    rdfs:comment 'Foreign key linking to facility.care_site. Business justification: Care management program enrollments are typically site-specific for resource allocation, care manager assignment by facility, and site-level quality/outcome reporting. ACO and value-based contracts re' ;
    rdfs:domain ind:CareProgramEnrollment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CareSite .

ind:disenrollmentDate rdf:type rdf:Property ;
    rdfs:label 'Disenrollment Date' ;
    rdfs:comment 'Date on which the patient was disenrolled or exited the care management program. Null if the patient is currently active. Used for program duration calculations, outcomes analysis, and value-based care reporting.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:enrollmentDate rdf:type rdf:Property ;
    rdfs:label 'Enrollment Date' ;
    rdfs:comment 'Date on which the patient was formally enrolled and accepted into the care management program. Represents the effective start of the enrollment agreement. Used for program duration calculations, HEDIS measure attribution, and ACO performance reporting.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:enrollmentNumber rdf:type rdf:Property ;
    rdfs:label 'Enrollment Number' ;
    rdfs:comment 'Externally-known business identifier for this care program enrollment record, assigned by the population health management platform or care management system (e.g., Epic Healthy Planet, Salesforce Health Cloud). Used for cross-system reference and audit tracking.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:enrollmentSource rdf:type rdf:Property ;
    rdfs:label 'Enrollment Source' ;
    rdfs:comment 'Channel or mechanism through which the patient was identified and enrolled in the care program. Supports program intake analysis, referral source tracking, and population health outreach effectiveness measurement. [ENUM-REF-CANDIDATE: provider_referral|care_manager_outreach|risk_stratification_algorithm|patient_self_referral|payer_referral|ed_discharge|inpatient_discharge — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:enrollmentStatus rdf:type rdf:Property ;
    rdfs:label 'Enrollment Status' ;
    rdfs:comment 'Current lifecycle status of the patient\'s care program enrollment. \'active\' indicates the patient is actively participating; \'pending\' indicates enrollment initiated but not yet confirmed; \'disenrolled\' indicates the patient has left the program; \'suspended\' indicates temporary pause; \'completed\' indicates successful program graduation; \'declined\' indicates patient refused enrollment.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastCareManagerContactDate rdf:type rdf:Property ;
    rdfs:label 'Last Care Manager Contact Date' ;
    rdfs:comment 'Date of the most recent documented contact between the assigned care manager and the patient. Used to identify patients who are overdue for care manager outreach, monitor care management engagement, and support CMS CCM monthly contact requirements.' ;
    rdfs:domain ind:CareProgramEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastStratificationDate rdf:type rdf:Property ;
    rdfs:label 'Last Stratification Date' ;
    rdfs:comment 'Date on which the patient\'s risk stratification was most recently calculated or refreshed. Used to identify patients with stale risk scores requiring re-stratification and to ensure currency of population health segmentation.' ;
    rdfs:domain ind:CareProgramEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nextCareManagerContactDate rdf:type rdf:Property ;
    rdfs:label 'Next Care Manager Contact Date' ;
    rdfs:comment 'Scheduled date for the next care manager outreach contact with the patient. Used for care manager workload scheduling, proactive outreach management, and ensuring compliance with program contact frequency requirements.' ;
    rdfs:domain ind:CareProgramEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:payerProgramName rdf:type rdf:Property ;
    rdfs:label 'Payer Program Name' ;
    rdfs:comment 'Name of the payer-specific care management or value-based care program under which this enrollment is tracked (e.g., \'Medicare Shared Savings Program\', \'Medicaid Managed Care Disease Management\', \'Commercial ACO\'). Supports payer-specific performance reporting and contract management.' ;
    rdfs:domain ind:CareProgramEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:programOutcome rdf:type rdf:Property ;
    rdfs:label 'Program Outcome' ;
    rdfs:comment 'Final outcome recorded upon program completion or disenrollment. Captures whether the patient achieved the program\'s clinical and care management goals. Used for program effectiveness reporting, quality improvement, and value-based care outcome measurement.' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskScoreModelVersion rdf:type rdf:Property ;
    rdfs:label 'Risk Score Model Version' ;
    rdfs:comment 'Version identifier of the risk stratification model used to calculate the risk score. Critical for reproducibility, model drift monitoring, and regulatory audit of risk-based payment adjustments.' ;
    rdfs:domain ind:CareProgramEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemEnrollmentCode rdf:type rdf:Property ;
    rdfs:label 'Source System Enrollment Code' ;
    rdfs:comment 'Native identifier for this enrollment record in the originating operational system (e.g., Epic Healthy Planet enrollment ID, Salesforce Health Cloud record ID). Used for cross-system reconciliation, ETL traceability, and back-referencing to the system of record.' ;
    rdfs:domain ind:CareProgramEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:valueBasedContractType rdf:type rdf:Property ;
    rdfs:label 'Value Based Contract Type' ;
    rdfs:comment 'Type of value-based care contract or payment model under which this enrollment is attributed. Determines financial incentive structure, quality measure requirements, and reporting obligations. [ENUM-REF-CANDIDATE: aco_mssp|aco_reach|pcmh|bundled_payment|capitation|shared_savings|pay_for_performance|fee_for_service — promote to reference product]' ;
    rdfs:domain ind:CareProgramEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:financialAssistanceId rdf:type rdf:Property ;
    rdfs:label 'Financial Assistance Id' ;
    rdfs:comment 'Unique surrogate identifier for each patient financial assistance application record in the lakehouse Silver layer. Primary key for this entity.' ;
    rdfs:domain ind:FinancialAssistance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:chartOfAccountsId rdf:type rdf:Property ;
    rdfs:label 'Chart Of Accounts Id' ;
    rdfs:comment 'Foreign key linking to finance.chart_of_accounts. Business justification: Financial assistance write-offs post to specific GL accounts (revenue contra-accounts) for GAAP financial statement preparation. Month-end close process requires mapping charity care adjustments to pr' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ChartOfAccounts .

ind:fundId rdf:type rdf:Property ;
    rdfs:label 'Fund Id' ;
    rdfs:comment 'Foreign key linking to finance.fund. Business justification: Financial assistance often draws from restricted funds (endowments, grants, community benefit funds). Fund accounting requires tracking which fund sources finance charity care write-offs for donor res' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Fund .

ind:annualHouseholdIncome rdf:type rdf:Property ;
    rdfs:label 'Annual Household Income' ;
    rdfs:comment 'Total annual gross income of the patient\'s household as reported and verified during the application process. Sensitive financial data used to calculate Federal Poverty Level (FPL) percentage. Stored in USD.' ;
    rdfs:domain ind:FinancialAssistance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:appealDate rdf:type rdf:Property ;
    rdfs:label 'Appeal Date' ;
    rdfs:comment 'Date on which the patient submitted a formal appeal of the financial assistance denial decision. Used to track appeal timelines and compliance with patient rights notification requirements.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:appealFlag rdf:type rdf:Property ;
    rdfs:label 'Appeal Flag' ;
    rdfs:comment 'Indicates whether the patient has filed a formal appeal of a denied financial assistance application. Triggers appeal workflow routing in the Revenue Cycle Management (RCM) system.' ;
    rdfs:domain ind:FinancialAssistance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appealOutcome rdf:type rdf:Property ;
    rdfs:label 'Appeal Outcome' ;
    rdfs:comment 'Result of the formal appeal review for a denied financial assistance application. Determines whether the original denial decision is upheld or reversed.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicationDate rdf:type rdf:Property ;
    rdfs:label 'Application Date' ;
    rdfs:comment 'Calendar date on which the patient submitted the financial assistance application. Used as the principal business event date for aging, reporting, and 501(c)(3) community benefit tracking.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:applicationNumber rdf:type rdf:Property ;
    rdfs:label 'Application Number' ;
    rdfs:comment 'Externally visible, human-readable application reference number assigned at submission. Used by financial counselors, patients, and payers to track the application through the review lifecycle. Format: FA-YYYY-NNNNNN.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicationSource rdf:type rdf:Property ;
    rdfs:label 'Application Source' ;
    rdfs:comment 'Channel or touchpoint through which the financial assistance application was initiated. Used for operational analytics on access patterns and financial counseling resource allocation. [ENUM-REF-CANDIDATE: patient_portal|financial_counselor|social_worker|emergency_department|inpatient_admission|mail|phone|community_partner — promote to reference product]' ;
    rdfs:domain ind:FinancialAssistance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicationStatus rdf:type rdf:Property ;
    rdfs:label 'Application Status' ;
    rdfs:comment 'Current lifecycle state of the financial assistance application. Drives workflow routing in financial counseling and Revenue Cycle Management (RCM) modules. [ENUM-REF-CANDIDATE: pending|approved|denied|cancelled|expired|under_review — promote to reference product if additional statuses are needed]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvalDate rdf:type rdf:Property ;
    rdfs:label 'Approval Date' ;
    rdfs:comment 'Calendar date on which the financial assistance application was approved by the financial counselor or review committee. Marks the start of the assistance benefit period.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:approvedAssistanceAmount rdf:type rdf:Property ;
    rdfs:label 'Approved Assistance Amount' ;
    rdfs:comment 'Fixed dollar amount of financial assistance approved for the patient, where a flat amount rather than a percentage discount is granted. Stored in USD. Applicable for payment plan subsidies or specific hardship grants.' ;
    rdfs:domain ind:FinancialAssistance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:approvedDiscountPercentage rdf:type rdf:Property ;
    rdfs:label 'Approved Discount Percentage' ;
    rdfs:comment 'Percentage discount approved for the patient\'s outstanding or future balances under the financial assistance program. Expressed as a value between 0.00 and 100.00. Used in Revenue Cycle Management (RCM) to apply adjustments to patient accounts.' ;
    rdfs:domain ind:FinancialAssistance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:balanceEligibleAmount rdf:type rdf:Property ;
    rdfs:label 'Balance Eligible Amount' ;
    rdfs:comment 'Total patient account balance that is eligible for financial assistance consideration at the time of application. Represents the gross amount subject to discount or write-off. Stored in USD.' ;
    rdfs:domain ind:FinancialAssistance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:collectionHoldFlag rdf:type rdf:Property ;
    rdfs:label 'Collection Hold Flag' ;
    rdfs:comment 'Indicates whether collections activity on the patient\'s account has been placed on hold pending the outcome of the financial assistance application. Required under IRS 501(r)(6) to prevent extraordinary collection actions during the application review period.' ;
    rdfs:domain ind:FinancialAssistance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:communityBenefitCategory rdf:type rdf:Property ;
    rdfs:label 'Community Benefit Category' ;
    rdfs:comment 'IRS Form 990 Schedule H community benefit category under which this financial assistance record is classified for 501(c)(3) tax-exempt reporting. Drives annual community benefit schedule compilation. [ENUM-REF-CANDIDATE: charity_care|unreimbursed_medicaid|community_health_improvement|subsidized_health_services|research|cash_in_kind — promote to reference product]' ;
    rdfs:domain ind:FinancialAssistance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:denialDate rdf:type rdf:Property ;
    rdfs:label 'Denial Date' ;
    rdfs:comment 'Calendar date on which the financial assistance application was formally denied. Required for tracking denial rates, appeal timelines, and regulatory compliance with IRS 501(r) notification requirements.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:denialReason rdf:type rdf:Property ;
    rdfs:label 'Denial Reason' ;
    rdfs:comment 'Coded reason for denial of the financial assistance application. Used for quality review, appeal processing, and regulatory reporting. [ENUM-REF-CANDIDATE: income_exceeds_threshold|incomplete_documentation|duplicate_application|ineligible_service|patient_declined|other — promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:extraordinaryCollectionActionFlag rdf:type rdf:Property ;
    rdfs:label 'Extraordinary Collection Action Flag' ;
    rdfs:comment 'Indicates whether any Extraordinary Collection Actions (ECAs) as defined by IRS 501(r)(6) — such as reporting to credit bureaus, filing lawsuits, or placing liens — were initiated against the patient. Must be False during the application review period.' ;
    rdfs:domain ind:FinancialAssistance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fplGuidelineYear rdf:type rdf:Property ;
    rdfs:label 'Fpl Guideline Year' ;
    rdfs:comment 'Calendar year of the HHS Federal Poverty Level guidelines used to calculate the FPL percentage. Required for audit reproducibility as FPL thresholds change annually.' ;
    rdfs:domain ind:FinancialAssistance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fplPercentage rdf:type rdf:Property ;
    rdfs:label 'Fpl Percentage' ;
    rdfs:comment 'Patient household income expressed as a percentage of the current year\'s Federal Poverty Level (FPL) based on household size. Primary eligibility threshold metric used to determine assistance tier and discount level per the facility\'s financial assistance policy.' ;
    rdfs:domain ind:FinancialAssistance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:incomeVerificationMethod rdf:type rdf:Property ;
    rdfs:label 'Income Verification Method' ;
    rdfs:comment 'Method used to verify the patient\'s household income for eligibility determination. Required for IRS 501(r) compliance documentation and audit purposes. [ENUM-REF-CANDIDATE: self_attestation|tax_return|pay_stub|bank_statement|government_benefit_letter|third_party_database — promote to reference product]' ;
    rdfs:domain ind:FinancialAssistance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:insuranceCoverageVerified rdf:type rdf:Property ;
    rdfs:label 'Insurance Coverage Verified' ;
    rdfs:comment 'Indicates whether the patient\'s insurance coverage eligibility was verified prior to processing the financial assistance application. Ensures that assistance is applied only after exhausting third-party payer sources per IRS 501(r) requirements.' ;
    rdfs:domain ind:FinancialAssistance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:medicaidApplicationSubmitted rdf:type rdf:Property ;
    rdfs:label 'Medicaid Application Submitted' ;
    rdfs:comment 'Indicates whether a Medicaid application was submitted on behalf of the patient as part of the financial assistance process. Tracks presumptive eligibility and Medicaid enrollment referral outcomes.' ;
    rdfs:domain ind:FinancialAssistance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:medicaidScreened rdf:type rdf:Property ;
    rdfs:label 'Medicaid Screened' ;
    rdfs:comment 'Indicates whether the patient was screened for Medicaid or other government-sponsored program eligibility before or during the financial assistance application process. Required for IRS 501(r) compliance and CMS uncompensated care reporting.' ;
    rdfs:domain ind:FinancialAssistance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:notificationDate rdf:type rdf:Property ;
    rdfs:label 'Notification Date' ;
    rdfs:comment 'Date on which the written notification of the financial assistance decision was sent to the patient. Required for IRS 501(r) compliance audit trail.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:notificationSentFlag rdf:type rdf:Property ;
    rdfs:label 'Notification Sent Flag' ;
    rdfs:comment 'Indicates whether the required written notification of the application decision (approval or denial) was sent to the patient per IRS 501(r) plain language notification requirements.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:paymentPlanDurationMonths rdf:type rdf:Property ;
    rdfs:label 'Payment Plan Duration Months' ;
    rdfs:comment 'Total number of months over which the patient\'s balance will be paid under an approved payment plan. Applicable only when program_type is \'payment_plan\'. Used for cash flow forecasting in Revenue Cycle Management (RCM).' ;
    rdfs:domain ind:FinancialAssistance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:paymentPlanMonthlyAmount rdf:type rdf:Property ;
    rdfs:label 'Payment Plan Monthly Amount' ;
    rdfs:comment 'Monthly installment amount agreed upon under an approved payment plan financial assistance program. Applicable only when program_type is \'payment_plan\'. Stored in USD.' ;
    rdfs:domain ind:FinancialAssistance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:presumptiveEligibilityFlag rdf:type rdf:Property ;
    rdfs:label 'Presumptive Eligibility Flag' ;
    rdfs:comment 'Indicates whether the patient was granted Medicaid Presumptive Eligibility (PE) as part of the financial assistance determination. PE allows temporary Medicaid coverage while the full application is pending.' ;
    rdfs:domain ind:FinancialAssistance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:programType rdf:type rdf:Property ;
    rdfs:label 'Program Type' ;
    rdfs:comment 'Classification of the financial assistance program under which the patient is applying. Determines eligibility criteria, discount methodology, and regulatory reporting category. [ENUM-REF-CANDIDATE: charity_care|medicaid_presumptive_eligibility|sliding_fee_scale|payment_plan|financial_hardship|hill_burton — promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Review Completion Date' ;
    rdfs:comment 'Date on which the financial counselor or review committee completed the review of the application, regardless of outcome. Used to measure processing turnaround time and compliance with internal Service Level Agreements (SLAs).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sourceSystemApplicationCode rdf:type rdf:Property ;
    rdfs:label 'Source System Application Code' ;
    rdfs:comment 'Native application identifier from the originating operational system (e.g., Epic Resolute HB application record ID). Enables bidirectional traceability between the lakehouse Silver layer and the source system for reconciliation and audit.' ;
    rdfs:domain ind:FinancialAssistance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:writeOffAmount rdf:type rdf:Property ;
    rdfs:label 'Write Off Amount' ;
    rdfs:comment 'Dollar amount of patient balance written off as charity care or uncompensated care following approval of financial assistance. Reported in 501(c)(3) community benefit schedules and CMS cost reports. Stored in USD.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:portalAccountId rdf:type rdf:Property ;
    rdfs:label 'Portal Account Id' ;
    rdfs:comment 'Unique surrogate identifier for the patient portal account record. Primary key for the portal_account data product. Role classification: MASTER_AGREEMENT — represents a long-running digital engagement relationship between a patient and the healthcare organization\'s portal platform.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PortalAccount .

ind:accountType rdf:type rdf:Property ;
    rdfs:label 'Account Type' ;
    rdfs:comment 'Classification of the portal account indicating whether it is a direct patient account, a proxy account (parent, guardian, caregiver, healthcare POA), or a shared account. Determines applicable access rules and HIPAA authorization requirements. Satisfies MASTER_AGREEMENT CLASSIFICATION_OR_TYPE category.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:activationDate rdf:type rdf:Property ;
    rdfs:label 'Activation Date' ;
    rdfs:comment 'Calendar date on which the patient first activated and verified their portal account. Distinct from created_date — an account may be created by staff but not activated by the patient until later. Key metric for digital front door strategy and patient engagement KPIs.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:activationMethod rdf:type rdf:Property ;
    rdfs:label 'Activation Method' ;
    rdfs:comment 'Method by which the patient portal account was activated. Supports analysis of activation channel effectiveness for digital front door strategy and patient engagement programs.' ;
    rdfs:domain ind:PortalAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appLinkDate rdf:type rdf:Property ;
    rdfs:label 'App Link Date' ;
    rdfs:comment 'Date on which the patient first linked a third-party digital health application to their portal account. Used for interoperability adoption tracking and CMS Promoting Interoperability reporting.' ;
    rdfs:domain ind:PortalAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:appointmentSchedulingEnabled rdf:type rdf:Property ;
    rdfs:label 'Appointment Scheduling Enabled' ;
    rdfs:comment 'Indicates whether the patient has been enabled for self-service appointment scheduling through the portal. Supports digital front door strategy, patient access analytics, and operational capacity planning.' ;
    rdfs:domain ind:PortalAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:createdDate rdf:type rdf:Property ;
    rdfs:label 'Created Date' ;
    rdfs:comment 'Calendar date on which the portal account was first created in the portal platform. Used for cohort analysis, onboarding funnel reporting, and MIPS Promoting Interoperability measure denominators. Satisfies MASTER_AGREEMENT EFFECTIVE_FROM category.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deactivationDate rdf:type rdf:Property ;
    rdfs:label 'Deactivation Date' ;
    rdfs:comment 'Calendar date on which the portal account was deactivated or terminated. Null for currently active accounts. Used for access revocation auditing and HIPAA compliance reporting. Satisfies MASTER_AGREEMENT EFFECTIVE_UNTIL category.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:digitalHealthAppLinked rdf:type rdf:Property ;
    rdfs:label 'Digital Health App Linked' ;
    rdfs:comment 'Indicates whether the patient has linked one or more third-party digital health applications (e.g., Apple Health, Google Fit, wearable device apps) to their portal account via FHIR API. Supports CMS Interoperability Final Rule compliance and patient-generated health data ingestion.' ;
    rdfs:domain ind:PortalAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:identityVerifiedDate rdf:type rdf:Property ;
    rdfs:label 'Identity Verified Date' ;
    rdfs:comment 'Date on which the patient\'s identity was formally verified. Supports audit trail requirements and periodic re-verification workflows per NIST identity assurance standards.' ;
    rdfs:domain ind:PortalAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:identityVerifiedFlag rdf:type rdf:Property ;
    rdfs:label 'Identity Verified Flag' ;
    rdfs:comment 'Indicates whether the patient\'s identity has been formally verified during portal account setup (e.g., via in-person verification, identity proofing service, or government ID check). Supports NIST identity assurance level requirements and HIPAA access control.' ;
    rdfs:domain ind:PortalAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastLoginDate rdf:type rdf:Property ;
    rdfs:label 'Last Login Date' ;
    rdfs:comment 'Most recent calendar date on which the patient successfully authenticated and logged into the portal. Used for patient engagement analytics, dormant account identification, and MIPS Promoting Interoperability active patient measures.' ;
    rdfs:domain ind:PortalAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastLoginTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Login Timestamp' ;
    rdfs:comment 'Precise date and time of the most recent successful patient authentication to the portal. Provides granular session tracking for security auditing and HIPAA access log compliance beyond the date-level last_login_date.' ;
    rdfs:domain ind:PortalAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:linkedAppName rdf:type rdf:Property ;
    rdfs:label 'Linked App Name' ;
    rdfs:comment 'Name of the primary third-party digital health application linked to the portal account (e.g., Apple Health, Google Fit, Fitbit). Populated when digital_health_app_linked is true. Supports interoperability reporting and app ecosystem analytics.' ;
    rdfs:domain ind:PortalAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:loginFailureCount rdf:type rdf:Property ;
    rdfs:label 'Login Failure Count' ;
    rdfs:comment 'Number of consecutive failed authentication attempts since the last successful login. Used to trigger account lockout policies per HIPAA security rule requirements and NIST password management guidelines.' ;
    rdfs:domain ind:PortalAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:messagingOptIn rdf:type rdf:Property ;
    rdfs:label 'Messaging Opt In' ;
    rdfs:comment 'Indicates whether the patient has opted in to receive secure portal messages from care team members. Supports patient engagement workflows, care coordination, and MIPS Promoting Interoperability secure messaging measures.' ;
    rdfs:domain ind:PortalAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:notificationMobilePhone rdf:type rdf:Property ;
    rdfs:label 'Notification Mobile Phone' ;
    rdfs:comment 'Mobile phone number used for SMS-based portal notifications and two-factor authentication. May differ from the patient\'s primary contact phone on file. Subject to TCPA consent requirements.' ;
    rdfs:domain ind:PortalAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notificationPreference rdf:type rdf:Property ;
    rdfs:label 'Notification Preference' ;
    rdfs:comment 'Patient\'s preferred channel for receiving portal notifications (e.g., new messages, appointment reminders, test results). Drives outbound communication workflows and patient engagement strategy.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:portalAccountNumber rdf:type rdf:Property ;
    rdfs:label 'Portal Account Number' ;
    rdfs:comment 'Externally-known unique alphanumeric identifier assigned to the portal account by the portal platform (e.g., Epic MyChart account number, Cerner HealtheLife account ID). Used for cross-system reconciliation and patient-facing reference. Satisfies MASTER_AGREEMENT BUSINESS_IDENTIFIER category.' ;
    rdfs:domain ind:PortalAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:portalPlatform rdf:type rdf:Property ;
    rdfs:label 'Portal Platform' ;
    rdfs:comment 'Name of the patient portal platform hosting this account (e.g., Epic MyChart, Cerner HealtheLife). Identifies the source system for digital engagement and determines applicable integration patterns for FHIR-based data exchange.' ;
    rdfs:domain ind:PortalAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:proxyAccessFlag rdf:type rdf:Property ;
    rdfs:label 'Proxy Access Flag' ;
    rdfs:comment 'Indicates whether this portal account has been granted proxy access to another patient\'s health record (e.g., parent accessing a minor child\'s record, adult caregiver accessing an elderly patient\'s record). When true, proxy-specific fields are populated.' ;
    rdfs:domain ind:PortalAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:proxyAccessLevel rdf:type rdf:Property ;
    rdfs:label 'Proxy Access Level' ;
    rdfs:comment 'Scope of access granted to the proxy account holder. \'full\' allows all portal functions including messaging and scheduling; \'limited\' restricts to specific record sections; \'view_only\' allows read-only access to designated information. Enforces HIPAA minimum necessary standard.' ;
    rdfs:domain ind:PortalAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:proxyAuthorizationDate rdf:type rdf:Property ;
    rdfs:label 'Proxy Authorization Date' ;
    rdfs:comment 'Date on which proxy access was formally authorized and granted. Establishes the start of the proxy access period for audit and compliance purposes.' ;
    rdfs:domain ind:PortalAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:proxyDateOfBirth rdf:type rdf:Property ;
    rdfs:label 'Proxy Date Of Birth' ;
    rdfs:comment 'Date of birth of the proxy account holder. Used for identity verification during proxy access setup and to confirm the proxy is a legal adult where required (e.g., adult caregiver, healthcare POA).' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:proxyExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Proxy Expiration Date' ;
    rdfs:comment 'Date on which the proxy access authorization expires. Null for indefinite authorizations. System should automatically revoke access on this date. Critical for HIPAA compliance and time-limited proxy arrangements (e.g., temporary caregiver).' ;
    rdfs:domain ind:PortalAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:proxyFirstName rdf:type rdf:Property ;
    rdfs:label 'Proxy First Name' ;
    rdfs:comment 'First (given) name of the proxy account holder who has been granted access to the patient\'s portal record. Required for identity verification and HIPAA-compliant proxy access management.' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:proxyLastName rdf:type rdf:Property ;
    rdfs:label 'Proxy Last Name' ;
    rdfs:comment 'Last (family) name of the proxy account holder who has been granted access to the patient\'s portal record. Required for identity verification and HIPAA-compliant proxy access management.' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:proxyLegalDocumentReference rdf:type rdf:Property ;
    rdfs:label 'Proxy Legal Document Reference' ;
    rdfs:comment 'Reference identifier or URL to the supporting legal documentation (e.g., court order number, POA document ID, scanned document storage path) that authorizes the proxy access. Supports HIPAA audit and legal compliance.' ;
    rdfs:domain ind:PortalAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:proxyLegalDocumentType rdf:type rdf:Property ;
    rdfs:label 'Proxy Legal Document Type' ;
    rdfs:comment 'Type of legal documentation supporting the proxy access authorization. Required for healthcare POA and legal guardian proxy relationships. Supports HIPAA compliance and legal defensibility of proxy access grants.' ;
    rdfs:domain ind:PortalAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:proxyRelationshipType rdf:type rdf:Property ;
    rdfs:label 'Proxy Relationship Type' ;
    rdfs:comment 'Type of relationship between the proxy account holder and the patient whose record is being accessed. Determines applicable HIPAA authorization requirements and access scope. Aligned with HL7 FHIR RelatedPerson.relationship value set.' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:proxyRevocationDate rdf:type rdf:Property ;
    rdfs:label 'Proxy Revocation Date' ;
    rdfs:comment 'Date on which proxy access was explicitly revoked before its natural expiration. Null if access was not revoked early. Supports HIPAA audit trail requirements for access termination events.' ;
    rdfs:domain ind:PortalAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:proxyRevocationReason rdf:type rdf:Property ;
    rdfs:label 'Proxy Revocation Reason' ;
    rdfs:comment 'Reason code for early revocation of proxy access. Supports compliance auditing and legal documentation requirements. \'age_of_majority\' applies when a minor patient reaches adulthood and proxy parental access is automatically terminated.' ;
    rdfs:domain ind:PortalAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rxRenewalRequestEnabled rdf:type rdf:Property ;
    rdfs:label 'Rx Renewal Request Enabled' ;
    rdfs:comment 'Indicates whether the patient is enabled to submit prescription renewal requests through the portal. Supports pharmacy engagement workflows and MIPS Promoting Interoperability measures for patient-generated health data.' ;
    rdfs:domain ind:PortalAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sourceSystemAccountCode rdf:type rdf:Property ;
    rdfs:label 'Source System Account Code' ;
    rdfs:comment 'Native account identifier from the originating portal system (e.g., Epic MyChart internal account ID, Cerner HealtheLife user GUID). Enables bidirectional reconciliation between the lakehouse silver layer and the operational system of record.' ;
    rdfs:domain ind:PortalAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:termsAcceptedDate rdf:type rdf:Property ;
    rdfs:label 'Terms Accepted Date' ;
    rdfs:comment 'Date on which the patient accepted the portal terms of use and privacy notice. Supports HIPAA Notice of Privacy Practices compliance documentation and legal audit trail.' ;
    rdfs:domain ind:PortalAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:termsAcceptedFlag rdf:type rdf:Property ;
    rdfs:label 'Terms Accepted Flag' ;
    rdfs:comment 'Indicates whether the patient has accepted the portal terms of use and privacy notice. Required for account activation. Supports HIPAA Notice of Privacy Practices acknowledgment tracking.' ;
    rdfs:domain ind:PortalAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:termsVersion rdf:type rdf:Property ;
    rdfs:label 'Terms Version' ;
    rdfs:comment 'Version identifier of the portal terms of use and privacy notice that the patient accepted. Enables tracking of re-consent requirements when terms are updated, supporting HIPAA Notice of Privacy Practices compliance.' ;
    rdfs:domain ind:PortalAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:testResultNotificationEnabled rdf:type rdf:Property ;
    rdfs:label 'Test Result Notification Enabled' ;
    rdfs:comment 'Indicates whether the patient has enabled portal notifications for new laboratory or radiology test results. Supports patient engagement, timely result delivery, and 21st Century Cures Act information blocking compliance.' ;
    rdfs:domain ind:PortalAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:twoFactorAuthEnrolled rdf:type rdf:Property ;
    rdfs:label 'Two Factor Auth Enrolled' ;
    rdfs:comment 'Indicates whether the patient has enrolled in two-factor authentication (2FA) for portal access. Supports HIPAA security rule compliance, NIST identity assurance level requirements, and organizational security policy enforcement.' ;
    rdfs:domain ind:PortalAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:twoFactorAuthMethod rdf:type rdf:Property ;
    rdfs:label 'Two Factor Auth Method' ;
    rdfs:comment 'The specific method used for two-factor authentication when enrolled. Supports security posture analysis and patient experience optimization for authentication workflows.' ;
    rdfs:domain ind:PortalAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:proxyAccessId rdf:type rdf:Property ;
    rdfs:label 'Proxy Access Id' ;
    rdfs:comment 'Unique surrogate identifier for each proxy access record in the patient domain. Primary key for the proxy_access data product.' ;
    rdfs:domain ind:ProxyAccess ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:primaryProxyPersonDemographicsId rdf:type rdf:Property ;
    rdfs:label 'Primary Proxy Person Demographics Id' ;
    rdfs:comment 'Reference to the person record of the authorized proxy representative. Links to the proxy\'s own identity record in the patient or person master.' ;
    rdfs:domain ind:ProxyAccess ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Demographics .

ind:accessLevel rdf:type rdf:Property ;
    rdfs:label 'Access Level' ;
    rdfs:comment 'Scope of access granted to the proxy representative within the patient portal and clinical systems. Full access includes all PHI; limited restricts to specific data categories; view-only prevents any actions. [ENUM-REF-CANDIDATE: full|limited|view_only|scheduling_only|messaging_only — promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accessStatus rdf:type rdf:Property ;
    rdfs:label 'Access Status' ;
    rdfs:comment 'Current lifecycle status of the proxy access record. Active indicates the proxy currently has authorized access; expired indicates the authorization period has lapsed; revoked indicates access was explicitly terminated before expiration.' ;
    rdfs:domain ind:ProxyAccess ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ageOfMajorityDate rdf:type rdf:Property ;
    rdfs:label 'Age Of Majority Date' ;
    rdfs:comment 'Date on which the patient is expected to reach the age of majority (typically 18th birthday). Used to schedule automatic expiration or review of proxy access for minor patients. Populated only when minor_patient_flag is true.' ;
    rdfs:domain ind:ProxyAccess ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:authorizationDate rdf:type rdf:Property ;
    rdfs:label 'Authorization Date' ;
    rdfs:comment 'Date on which the proxy access was formally authorized and activated. Represents the effective start of the proxy\'s access rights. Aligns with MASTER_AGREEMENT EFFECTIVE_FROM category.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:authorizationLocation rdf:type rdf:Property ;
    rdfs:label 'Authorization Location' ;
    rdfs:comment 'Facility or location where the proxy authorization was processed (e.g., hospital registration desk, clinic front desk, online portal). Supports operational reporting and audit.' ;
    rdfs:domain ind:ProxyAccess ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingAccessFlag rdf:type rdf:Property ;
    rdfs:label 'Billing Access Flag' ;
    rdfs:comment 'Indicates whether the proxy is authorized to view billing statements and make payments on behalf of the patient through the patient portal.' ;
    rdfs:domain ind:ProxyAccess ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:consentObtainedMethod rdf:type rdf:Property ;
    rdfs:label 'Consent Obtained Method' ;
    rdfs:comment 'Method by which the patient\'s consent for proxy access was obtained. Supports HIPAA consent documentation requirements and audit trail.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastAccessTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Access Timestamp' ;
    rdfs:comment 'Timestamp of the most recent time the proxy accessed the patient\'s record through the portal or clinical system. Used for access monitoring, dormant account detection, and HIPAA audit log reporting.' ;
    rdfs:domain ind:ProxyAccess ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:legalDocumentEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Legal Document Effective Date' ;
    rdfs:comment 'Date on which the supporting legal document became effective. Used to validate that the legal authority was in force at the time of proxy authorization.' ;
    rdfs:domain ind:ProxyAccess ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:legalDocumentExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Legal Document Expiration Date' ;
    rdfs:comment 'Date on which the supporting legal document expires, if applicable. Nullable for permanent legal instruments. Triggers review workflows when approaching expiration.' ;
    rdfs:domain ind:ProxyAccess ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:legalDocumentReference rdf:type rdf:Property ;
    rdfs:label 'Legal Document Reference' ;
    rdfs:comment 'Reference identifier or document locator for the supporting legal documentation (e.g., court order number, power of attorney document ID, or document management system reference). Enables retrieval of the underlying legal instrument for audit and compliance verification.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalDocumentType rdf:type rdf:Property ;
    rdfs:label 'Legal Document Type' ;
    rdfs:comment 'Type of legal documentation supporting the proxy authorization. Required for legal guardian and healthcare power of attorney proxy types. Drives document verification workflows. [ENUM-REF-CANDIDATE: court_order|power_of_attorney|birth_certificate|adoption_decree|guardianship_order|none_required — promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:messagingAccessFlag rdf:type rdf:Property ;
    rdfs:label 'Messaging Access Flag' ;
    rdfs:comment 'Indicates whether the proxy is authorized to send and receive secure messages with the care team on behalf of the patient through the patient portal.' ;
    rdfs:domain ind:ProxyAccess ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:minorPatientFlag rdf:type rdf:Property ;
    rdfs:label 'Minor Patient Flag' ;
    rdfs:comment 'Indicates whether the patient is a minor (under 18 years of age) at the time of proxy authorization. Drives specific access rules and automatic expiration logic when the patient reaches the age of majority.' ;
    rdfs:domain ind:ProxyAccess ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mychartProxyAccountNumber rdf:type rdf:Property ;
    rdfs:label 'Mychart Proxy Account Number' ;
    rdfs:comment 'Epic MyChart system identifier for the proxy\'s portal account. Used to link the proxy access record to the proxy\'s active MyChart login session and access audit logs.' ;
    rdfs:domain ind:ProxyAccess ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:phiRestrictionFlag rdf:type rdf:Property ;
    rdfs:label 'Phi Restriction Flag' ;
    rdfs:comment 'Indicates whether specific PHI restrictions apply to this proxy\'s access (e.g., sensitive categories such as mental health, substance abuse, or reproductive health are excluded from proxy view). When true, restricted_phi_categories should be reviewed.' ;
    rdfs:domain ind:ProxyAccess ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:portalAccessEnabled rdf:type rdf:Property ;
    rdfs:label 'Portal Access Enabled' ;
    rdfs:comment 'Indicates whether the proxy currently has active access to the patient portal (e.g., Epic MyChart). May be false even when access_status is active if the proxy has not yet activated their portal account.' ;
    rdfs:domain ind:ProxyAccess ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:proxyEmail rdf:type rdf:Property ;
    rdfs:label 'Proxy Email' ;
    rdfs:comment 'Email address of the proxy representative used for MyChart portal login and proxy-related notifications. Serves as the primary digital contact channel for the proxy.' ;
    rdfs:domain ind:ProxyAccess ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:proxyPhone rdf:type rdf:Property ;
    rdfs:label 'Proxy Phone' ;
    rdfs:comment 'Primary phone number of the proxy representative for identity verification and contact purposes during proxy authorization or revocation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:proxyRelationship rdf:type rdf:Property ;
    rdfs:label 'Proxy Relationship' ;
    rdfs:comment 'Proxy relationship' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:proxyType rdf:type rdf:Property ;
    rdfs:label 'Proxy Type' ;
    rdfs:comment 'Classification of the proxy relationship type as defined under HIPAA personal representative rules. Determines the legal basis for access. [ENUM-REF-CANDIDATE: parent_guardian|adult_caregiver|legal_guardian|healthcare_power_of_attorney|personal_representative|minor_self — promote to reference product]' ;
    rdfs:domain ind:ProxyAccess ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:restrictedPhiCategories rdf:type rdf:Property ;
    rdfs:label 'Restricted Phi Categories' ;
    rdfs:comment 'Comma-delimited list of PHI categories excluded from this proxy\'s access scope (e.g., mental_health, substance_abuse, reproductive_health, hiv_status). Populated only when phi_restriction_flag is true. Drives data filtering in the patient portal.' ;
    rdfs:domain ind:ProxyAccess ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revocationDate rdf:type rdf:Property ;
    rdfs:label 'Revocation Date' ;
    rdfs:comment 'Date on which the proxy access was explicitly revoked prior to the scheduled expiration. Populated only when access_status is revoked. Supports HIPAA audit trail requirements.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:revocationReason rdf:type rdf:Property ;
    rdfs:label 'Revocation Reason' ;
    rdfs:comment 'Reason code explaining why proxy access was revoked. Required when revocation_date is populated. Supports compliance reporting and audit. [ENUM-REF-CANDIDATE: patient_request|proxy_request|legal_order|age_of_majority|death_of_patient|death_of_proxy|administrative — promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rxRefillAccessFlag rdf:type rdf:Property ;
    rdfs:label 'Rx Refill Access Flag' ;
    rdfs:comment 'Indicates whether the proxy is authorized to request prescription refills on behalf of the patient through the patient portal. Relevant for caregiver proxies managing chronic condition patients.' ;
    rdfs:domain ind:ProxyAccess ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:schedulingAccessFlag rdf:type rdf:Property ;
    rdfs:label 'Scheduling Access Flag' ;
    rdfs:comment 'Indicates whether the proxy is authorized to schedule, reschedule, or cancel appointments on behalf of the patient through the patient portal.' ;
    rdfs:domain ind:ProxyAccess ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sourceSystemProxyCode rdf:type rdf:Property ;
    rdfs:label 'Source System Proxy Code' ;
    rdfs:comment 'Native identifier for this proxy access record in the originating source system (e.g., Epic MyChart proxy relationship ID). Enables bidirectional traceability between the lakehouse Silver layer and the operational EHR.' ;
    rdfs:domain ind:ProxyAccess ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verificationDate rdf:type rdf:Property ;
    rdfs:label 'Verification Date' ;
    rdfs:comment 'Date on which the proxy\'s identity and legal authority were verified by authorized staff. Supports compliance audit trail.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:mrnCrosswalkId rdf:type rdf:Property ;
    rdfs:label 'Mrn Crosswalk Id' ;
    rdfs:comment 'Unique surrogate primary key for each MRN crosswalk record in the enterprise patient identity resolution table.' ;
    rdfs:domain ind:MrnCrosswalk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:mrnMpiRecordId rdf:type rdf:Property ;
    rdfs:label 'Mrn Mpi Record Id' ;
    rdfs:comment 'MPI record FK' ;
    rdfs:domain ind:MrnCrosswalk ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MpiRecord .

ind:primaryMrnMpiRecordId rdf:type rdf:Property ;
    rdfs:label 'Primary Mrn Mpi Record Id' ;
    rdfs:comment 'Enterprise-wide unique patient identifier from the Master Patient Index (MPI). This is the golden record identifier that all facility-specific MRNs and system identifiers resolve to. Serves as the anchor for cross-system patient identity resolution.' ;
    rdfs:domain ind:MrnCrosswalk ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MpiRecord .

ind:activeFlag rdf:type rdf:Property ;
    rdfs:label 'Active Flag' ;
    rdfs:comment 'Flag indicating if CDM entry is active' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:adtEventType rdf:type rdf:Property ;
    rdfs:label 'Adt Event Type' ;
    rdfs:comment 'The HL7 ADT (Admit, Discharge, Transfer) event type that triggered the creation or update of this crosswalk record (e.g., A01=Admit, A03=Discharge, A08=Update Patient Info, A28=Add Person, A40=Merge Patient). Supports ADT-driven MPI integration and audit tracing. [ENUM-REF-CANDIDATE: A01|A02|A03|A04|A08|A28|A31|A40 — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:adtMessageControlNumber rdf:type rdf:Property ;
    rdfs:label 'Adt Message Control Number' ;
    rdfs:comment 'The HL7 message control ID from the ADT message that created or last updated this crosswalk record. Enables traceability back to the originating HL7 v2 or FHIR message in the ADT integration layer for audit and reconciliation purposes.' ;
    rdfs:domain ind:MrnCrosswalk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assigningAuthority rdf:type rdf:Property ;
    rdfs:label 'Assigning Authority' ;
    rdfs:comment 'The name of the organization or system that assigned and is responsible for maintaining this patient identifier (e.g., \'Epic EMPI\', \'Cerner Millennium\', \'State HIE\', \'CMS\', \'BlueCross BlueShield\'). Corresponds to the HL7 v2 CX.4 Assigning Authority component.' ;
    rdfs:domain ind:MrnCrosswalk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cernerEuid rdf:type rdf:Property ;
    rdfs:label 'Cerner Euid' ;
    rdfs:comment 'The patient identifier assigned by Cerner Millennium\'s Enterprise Unique ID (EUID) system. Used for patient matching and identity resolution across all Cerner-connected facilities. Populated when source_system = \'Cerner\'.' ;
    rdfs:domain ind:MrnCrosswalk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:crosswalkStatus rdf:type rdf:Property ;
    rdfs:label 'Crosswalk Status' ;
    rdfs:comment 'Lifecycle status of this crosswalk mapping record. Active records are in current use for identity resolution. Deprecated records have been superseded. Pending_review records require MPI analyst review. Merged records indicate the source identifier was consolidated into another enterprise patient record.' ;
    rdfs:domain ind:MrnCrosswalk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataQualityScore rdf:type rdf:Property ;
    rdfs:label 'Data Quality Score' ;
    rdfs:comment 'Composite data quality score (0.0000 to 1.0000) for this crosswalk record, reflecting completeness, consistency, and accuracy of the identifier mapping. Computed by the MPI data quality engine. Supports NCQA HEDIS data quality reporting and MPI governance dashboards.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:epicEmpiNumber rdf:type rdf:Property ;
    rdfs:label 'Epic Empi Number' ;
    rdfs:comment 'The patient identifier assigned by Epic\'s Enterprise Master Patient Index (EMPI) system. Used for patient matching and identity resolution across all Epic-connected facilities within the health system. Populated when source_system = \'Epic\'.' ;
    rdfs:domain ind:MrnCrosswalk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facilityMrn rdf:type rdf:Property ;
    rdfs:label 'Facility Mrn' ;
    rdfs:comment 'The facility-specific Medical Record Number (MRN) assigned to the patient at a particular care site. This is the local identifier used within the facility\'s EHR system (Epic, Cerner, MEDITECH) and on clinical documentation.' ;
    rdfs:domain ind:MrnCrosswalk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fhirPatientReference rdf:type rdf:Property ;
    rdfs:label 'Fhir Patient Reference' ;
    rdfs:comment 'The FHIR Patient resource reference URL or logical ID for this patient in the source system\'s FHIR API endpoint (e.g., \'Patient/12345\' or full URL). Enables direct FHIR-based patient record retrieval from the source system for interoperability workflows.' ;
    rdfs:domain ind:MrnCrosswalk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hieNetworkName rdf:type rdf:Property ;
    rdfs:label 'Hie Network Name' ;
    rdfs:comment 'Name of the Health Information Exchange (HIE) network through which the hie_patient_id was assigned or is used for record exchange (e.g., \'CommonWell Health Alliance\', \'Carequality\', \'State HIE\'). Populated when identifier_type = \'HIEID\'.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:identifierSystemOid rdf:type rdf:Property ;
    rdfs:label 'Identifier System Oid' ;
    rdfs:comment 'The HL7 Object Identifier (OID) or URI that uniquely identifies the assigning authority or namespace for this identifier (e.g., the OID for Epic EMPI, Cerner EUID, or a specific facility\'s MRN namespace). Enables unambiguous identifier resolution in HL7 FHIR and v2 interoperability contexts.' ;
    rdfs:domain ind:MrnCrosswalk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:identifierType rdf:type rdf:Property ;
    rdfs:label 'Identifier Type' ;
    rdfs:comment 'Classification of the identifier represented in this crosswalk record. Distinguishes between facility MRNs, Epic Enterprise Master Patient Index (EMPI) IDs, Cerner Enterprise Unique IDs (EUIDs), payer member IDs, Health Information Exchange (HIE) identifiers, and national identifiers. [ENUM-REF-CANDIDATE: MRN|EMPI|EUID|MemberID|HIEID|NationalID|Other — promote to reference product]' ;
    rdfs:domain ind:MrnCrosswalk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isGoldenRecord rdf:type rdf:Property ;
    rdfs:label 'Is Golden Record' ;
    rdfs:comment 'Indicates whether this crosswalk record is associated with the MPI golden record — the authoritative, deduplicated enterprise patient identity. Only one active crosswalk record per patient_id should carry this flag as True. Used by downstream systems to select the canonical patient identity.' ;
    rdfs:domain ind:MrnCrosswalk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPrimaryIdentifier rdf:type rdf:Property ;
    rdfs:label 'Is Primary Identifier' ;
    rdfs:comment 'Indicates whether this crosswalk record represents the primary or preferred identifier for the patient within the specified source system or facility. When True, this identifier is used as the default lookup key for the patient in that system context.' ;
    rdfs:domain ind:MrnCrosswalk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastAdtEventDate rdf:type rdf:Property ;
    rdfs:label 'Last Adt Event Date' ;
    rdfs:comment 'Date of the most recent ADT (Admit, Discharge, Transfer) event that updated this crosswalk record. Used to assess record currency and identify stale crosswalk mappings that may require re-validation.' ;
    rdfs:domain ind:MrnCrosswalk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:localMrn rdf:type rdf:Property ;
    rdfs:label 'Local Mrn' ;
    rdfs:domain ind:MrnCrosswalk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:matchAlgorithm rdf:type rdf:Property ;
    rdfs:label 'Match Algorithm' ;
    rdfs:comment 'Name and version of the matching algorithm or rules engine used to establish the identity link between the source identifier and the enterprise patient_id (e.g., \'Deterministic-v2.1\', \'Probabilistic-Jaro-Winkler-v3\', \'Manual-Override\'). Supports auditability of identity resolution decisions.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:matchStatus rdf:type rdf:Property ;
    rdfs:label 'Match Status' ;
    rdfs:comment 'Current status of the patient identity matching result for this crosswalk record. Indicates whether the identifier has been definitively matched to the enterprise patient_id, is a probable or possible match requiring review, is unmatched, has been identified as a duplicate, or has been retired. [ENUM-REF-CANDIDATE: matched|probable_match|possible_match|unmatched|duplicate|retired — promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:matchType rdf:type rdf:Property ;
    rdfs:label 'Match Type' ;
    rdfs:comment 'Classification of how the identity match was established: deterministic (exact rule-based match on key identifiers), probabilistic (statistical scoring), manual (human-reviewed and confirmed), or system_override (administrative correction). Supports data quality governance and audit workflows.' ;
    rdfs:domain ind:MrnCrosswalk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:meditechPatientNumber rdf:type rdf:Property ;
    rdfs:label 'Meditech Patient Number' ;
    rdfs:comment 'The patient identifier assigned by MEDITECH Expanse EHR system. Used for patient identity resolution when the facility operates on MEDITECH. Populated when source_system = \'MEDITECH\'.' ;
    rdfs:domain ind:MrnCrosswalk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:overlayRiskFlag rdf:type rdf:Property ;
    rdfs:label 'Overlay Risk Flag' ;
    rdfs:comment 'Indicates whether this crosswalk record has been flagged as a potential patient record overlay risk — a patient safety event where one patient\'s records are incorrectly merged with or attributed to another patient. Triggers immediate MPI analyst review workflow.' ;
    rdfs:domain ind:MrnCrosswalk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:payerMemberNumber rdf:type rdf:Property ;
    rdfs:label 'Payer Member Number' ;
    rdfs:comment 'The insurance payer\'s member identification number for this patient. Used to link the enterprise patient record to payer eligibility, claims, and Explanation of Benefits (EOB) data. Populated when identifier_type = \'MemberID\'.' ;
    rdfs:domain ind:MrnCrosswalk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryFlag rdf:type rdf:Property ;
    rdfs:label 'Primary Flag' ;
    rdfs:comment 'Added to expand thin product provider.assignment' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reviewReason rdf:type rdf:Property ;
    rdfs:label 'Review Reason' ;
    rdfs:comment 'Free-text or coded reason why this crosswalk record has been flagged for review (e.g., \'Duplicate MRN detected\', \'Name mismatch\', \'DOB discrepancy\', \'Overlay risk identified\'). Populated when match_status = \'possible_match\' or crosswalk_status = \'pending_review\'.' ;
    rdfs:domain ind:MrnCrosswalk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceFacilityCode rdf:type rdf:Property ;
    rdfs:label 'Source Facility Code' ;
    rdfs:comment 'The short code or abbreviation identifying the facility that issued the facility_mrn (e.g., \'MGH\', \'BWH\', \'CHOP\'). Used in MRN display formatting and cross-facility reporting where the full facility_id FK is not needed for human-readable identification.' ;
    rdfs:domain ind:MrnCrosswalk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceLastUpdatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Source Last Updated Timestamp' ;
    rdfs:comment 'Timestamp of the most recent update to this patient identifier record in the originating source system (Epic, Cerner, MEDITECH, HIE). Distinct from updated_timestamp which reflects the lakehouse record update time. Used for source-to-target reconciliation and data freshness monitoring.' ;
    rdfs:domain ind:MrnCrosswalk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:sourceSystemIdentifier rdf:type rdf:Property ;
    rdfs:label 'Source System Identifier' ;
    rdfs:comment 'The patient identifier as it exists natively in the source system (e.g., Epic EMPI ID, Cerner EUID, MEDITECH patient number, HIE patient ID). This is the raw identifier value before enterprise harmonization.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemMrnType rdf:type rdf:Property ;
    rdfs:label 'Source System Mrn Type' ;
    rdfs:comment 'Source system MRN type' ;
    rdfs:domain ind:MrnCrosswalk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verifiedFlag rdf:type rdf:Property ;
    rdfs:label 'Verified Flag' ;
    rdfs:comment 'Indicates whether the identity link between the source identifier and the enterprise patient_id has been verified by an MPI analyst or clinical staff. Verified records carry higher trust for patient safety-critical workflows such as medication administration and surgical scheduling.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:communicationLogId rdf:type rdf:Property ;
    rdfs:label 'Communication Log Id' ;
    rdfs:comment 'Unique identifier for the patient communication event. Primary key.' ;
    rdfs:domain ind:CommunicationLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:careGapLoincCodeId rdf:type rdf:Property ;
    rdfs:label 'Care Gap Loinc Code Id' ;
    rdfs:comment 'Foreign key linking to reference.loinc_code. Business justification: Care gap outreach campaigns reference specific quality measures identified by LOINC codes (e.g., LOINC 55284-4 for blood pressure screening). Enables HEDIS/MIPS reporting, campaign effectiveness track' ;
    rdfs:domain ind:CommunicationLog ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:LoincCode .

ind:communicationCampaignId rdf:type rdf:Property ;
    rdfs:label 'Communication Campaign Id' ;
    rdfs:comment 'Identifier of the population health or outreach campaign this communication is part of, enabling campaign effectiveness tracking.' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CommunicationCampaign .

ind:followUpCommunicationLogId rdf:type rdf:Property ;
    rdfs:label 'Follow Up Communication Log Id' ;
    rdfs:comment 'Self-referencing FK on communication_log (follow_up_communication_log_id)' ;
    rdfs:domain ind:CommunicationLog ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CommunicationLog .

ind:messageTemplateId rdf:type rdf:Property ;
    rdfs:label 'Message Template Id' ;
    rdfs:comment 'Reference identifier for the message template used in this campaign.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MessageTemplate .

ind:primaryCommunicationCampaignId rdf:type rdf:Property ;
    rdfs:label 'Primary Communication Campaign Id' ;
    rdfs:domain ind:CommunicationLog ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CommunicationCampaign .

ind:careGapCode rdf:type rdf:Property ;
    rdfs:label 'Care Gap Code' ;
    rdfs:comment 'Code identifying the specific care gap or quality measure this communication addresses (e.g., HEDIS measure code).' ;
    rdfs:domain ind:CommunicationLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:careGapDescription rdf:type rdf:Property ;
    rdfs:label 'Care Gap Description' ;
    rdfs:comment 'Description of the care gap or preventive service the communication is intended to close (e.g., overdue mammogram, diabetic eye exam).' ;
    rdfs:domain ind:CommunicationLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:channel rdf:type rdf:Property ;
    rdfs:label 'Channel' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:communicationDate rdf:type rdf:Property ;
    rdfs:label 'Communication Date' ;
    rdfs:comment 'Date the communication was sent or initiated, used for reporting and tracking outreach timing.' ;
    rdfs:domain ind:CommunicationLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:communicationDirection rdf:type rdf:Property ;
    rdfs:label 'Communication Direction' ;
    rdfs:comment 'Communication direction' ;
    rdfs:domain ind:CommunicationLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:communicationNumber rdf:type rdf:Property ;
    rdfs:label 'Communication Number' ;
    rdfs:comment 'Business identifier or tracking number for this communication event, used for reference and audit purposes.' ;
    rdfs:domain ind:CommunicationLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:communicationStatus rdf:type rdf:Property ;
    rdfs:label 'Communication Status' ;
    rdfs:comment 'Current lifecycle status of the communication event per HL7 FHIR Communication status value set. [ENUM-REF-CANDIDATE: preparation|in-progress|not-done|on-hold|stopped|completed|entered-in-error|unknown — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:communicationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Communication Timestamp' ;
    rdfs:comment 'Precise date and time the communication was sent or initiated, supporting detailed audit and sequence analysis.' ;
    rdfs:domain ind:CommunicationLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:communicationType rdf:type rdf:Property ;
    rdfs:label 'Communication Type' ;
    rdfs:comment 'Category of communication describing the purpose or business function (appointment reminder, care gap notification, preventive screening outreach, billing statement, post-discharge follow-up, population health campaign).' ;
    rdfs:domain ind:CommunicationLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contentSummary rdf:type rdf:Property ;
    rdfs:label 'Content Summary' ;
    rdfs:comment 'Content summary' ;
    rdfs:domain ind:CommunicationLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deliveredFlag rdf:type rdf:Property ;
    rdfs:label 'Delivered Flag' ;
    rdfs:domain ind:CommunicationLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:deliveredTimestamp rdf:type rdf:Property ;
    rdfs:label 'Delivered Timestamp' ;
    rdfs:comment 'Delivered timestamp' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:deliveryFailureReason rdf:type rdf:Property ;
    rdfs:label 'Delivery Failure Reason' ;
    rdfs:comment 'Reason or error message explaining why the communication delivery failed (invalid contact, opt-out, system error).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deliveryStatus rdf:type rdf:Property ;
    rdfs:label 'Delivery Status' ;
    rdfs:comment 'Status indicating whether the communication was successfully delivered to the recipient.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deliveryTimestamp rdf:type rdf:Property ;
    rdfs:label 'Delivery Timestamp' ;
    rdfs:comment 'Date and time the communication was confirmed delivered to the recipient system or device.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:direction rdf:type rdf:Property ;
    rdfs:label 'Direction' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:failureReason rdf:type rdf:Property ;
    rdfs:label 'Failure Reason' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fhirCommunicationReference rdf:type rdf:Property ;
    rdfs:label 'Fhir Communication Reference' ;
    rdfs:comment 'FHIR resource identifier for this communication, enabling interoperability with FHIR-compliant systems.' ;
    rdfs:domain ind:CommunicationLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:languageCode rdf:type rdf:Property ;
    rdfs:label 'Language Code' ;
    rdfs:comment 'ISO 639-1 language code indicating the language in which the communication was delivered.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:messageBody rdf:type rdf:Property ;
    rdfs:label 'Message Body' ;
    rdfs:comment 'Full text content of the communication message sent to the patient or recipient.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:openedFlag rdf:type rdf:Property ;
    rdfs:label 'Opened Flag' ;
    rdfs:domain ind:CommunicationLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:openedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Opened Timestamp' ;
    rdfs:domain ind:CommunicationLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:optOutChannel rdf:type rdf:Property ;
    rdfs:label 'Opt Out Channel' ;
    rdfs:comment 'Specific communication channel the patient opted out of (e.g., SMS, email, phone calls).' ;
    rdfs:domain ind:CommunicationLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:optOutDate rdf:type rdf:Property ;
    rdfs:label 'Opt Out Date' ;
    rdfs:comment 'Date the patient opted out of receiving communications of this type.' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:optOutFlag rdf:type rdf:Property ;
    rdfs:label 'Opt Out Flag' ;
    rdfs:comment 'Indicator that the patient has opted out of receiving this type of communication.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:patientResponseDate rdf:type rdf:Property ;
    rdfs:label 'Patient Response Date' ;
    rdfs:comment 'Date the patient responded to the communication, if applicable.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:patientResponseFlag rdf:type rdf:Property ;
    rdfs:label 'Patient Response Flag' ;
    rdfs:comment 'Indicator of whether the patient responded to this communication.' ;
    rdfs:domain ind:CommunicationLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:patientResponseText rdf:type rdf:Property ;
    rdfs:label 'Patient Response Text' ;
    rdfs:comment 'Text content of the patients response to the communication, captured for follow-up and documentation.' ;
    rdfs:domain ind:CommunicationLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priority rdf:type rdf:Property ;
    rdfs:label 'Priority' ;
    rdfs:comment 'Priority level of the communication indicating urgency of the message.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recipientAddress rdf:type rdf:Property ;
    rdfs:label 'Recipient Address' ;
    rdfs:comment 'Mailing address of the recipient authorized to receive the PHI disclosure.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recipientContactValue rdf:type rdf:Property ;
    rdfs:label 'Recipient Contact Value' ;
    rdfs:comment 'The actual contact value used to reach the recipient (phone number, email address, mailing address, portal account ID).' ;
    rdfs:domain ind:CommunicationLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recipientEmail rdf:type rdf:Property ;
    rdfs:label 'Recipient Email' ;
    rdfs:comment 'Recipient email' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recipientName rdf:type rdf:Property ;
    rdfs:label 'Recipient Name' ;
    rdfs:comment 'Name of the individual who received the communication (patient or proxy).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recipientPhone rdf:type rdf:Property ;
    rdfs:label 'Recipient Phone' ;
    rdfs:comment 'Recipient phone' ;
    rdfs:domain ind:CommunicationLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recipientType rdf:type rdf:Property ;
    rdfs:label 'Recipient Type' ;
    rdfs:comment 'Type of recipient receiving the communication (patient, proxy, emergency contact, guarantor, family member).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:respondedFlag rdf:type rdf:Property ;
    rdfs:label 'Responded Flag' ;
    rdfs:domain ind:CommunicationLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:senderName rdf:type rdf:Property ;
    rdfs:label 'Sender Name' ;
    rdfs:comment 'Name of the individual or system that sent the communication, for display and audit purposes.' ;
    rdfs:domain ind:Patient ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:senderRole rdf:type rdf:Property ;
    rdfs:label 'Sender Role' ;
    rdfs:comment 'Role or title of the sender (e.g., care manager, nurse, physician, automated system, billing department).' ;
    rdfs:domain ind:CommunicationLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sentTimestamp rdf:type rdf:Property ;
    rdfs:label 'Sent Timestamp' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:sourceSystemCommunicationCode rdf:type rdf:Property ;
    rdfs:label 'Source System Communication Code' ;
    rdfs:comment 'Unique identifier of this communication in the originating source system, used for traceability and reconciliation.' ;
    rdfs:domain ind:CommunicationLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subjectLine rdf:type rdf:Property ;
    rdfs:label 'Subject Line' ;
    rdfs:comment 'Subject or title of the communication message, used for email and portal messages.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentReferenceId rdf:type rdf:Property ;
    rdfs:label 'Consent Reference Id' ;
    rdfs:comment 'Unique identifier for the consent reference record. Primary key.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ConsentReference .

ind:primaryConsentClinicianId rdf:type rdf:Property ;
    rdfs:label 'Primary Consent Clinician Id' ;
    rdfs:comment 'Foreign key reference to the provider who obtained or witnessed the consent from the patient.' ;
    rdfs:domain ind:ConsentReference ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:supersededConsentReferenceId rdf:type rdf:Property ;
    rdfs:label 'Superseded Consent Reference Id' ;
    rdfs:comment 'Self-referencing FK on consent_reference (superseded_consent_reference_id)' ;
    rdfs:domain ind:ConsentReference ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ConsentReference .

ind:treatmentConsentId rdf:type rdf:Property ;
    rdfs:label 'Treatment Consent Id' ;
    rdfs:comment 'Foreign key linking to consent.treatment_consent. Business justification: Joint Commission and CMS mandate documented treatment consent for procedures. Clinical workflows verify consent before procedure start; surgical safety checklists require consent_obtained flag validat' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TreatmentConsent .

ind:auditTrailFlag rdf:type rdf:Property ;
    rdfs:label 'Audit Trail Flag' ;
    rdfs:comment 'Indicates whether a detailed audit trail exists for this consent reference in the consent domain SSOT. True if audit trail is available, False otherwise.' ;
    rdfs:domain ind:ConsentReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:consentEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Consent Effective Date' ;
    rdfs:comment 'The date when the consent becomes effective and enforceable. Denormalized from consent master for quick filtering and reporting.' ;
    rdfs:domain ind:ConsentReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:consentExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Consent Expiration Date' ;
    rdfs:comment 'The date when the consent expires and is no longer valid. Null if the consent has no expiration. Denormalized from consent master for quick filtering.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:consentMethod rdf:type rdf:Property ;
    rdfs:label 'Consent Method' ;
    rdfs:comment 'The method by which the consent was obtained from the patient (e.g., written signature, verbal acknowledgment, electronic signature via patient portal, implied consent).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentObtainedDate rdf:type rdf:Property ;
    rdfs:label 'Consent Obtained Date' ;
    rdfs:comment 'The date when the consent was originally obtained from the patient or their authorized representative.' ;
    rdfs:domain ind:ConsentReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:consentRevocationDate rdf:type rdf:Property ;
    rdfs:label 'Consent Revocation Date' ;
    rdfs:comment 'The date when the patient revoked their consent. Null if the consent has not been revoked.' ;
    rdfs:domain ind:ConsentReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:consentScope rdf:type rdf:Property ;
    rdfs:label 'Consent Scope' ;
    rdfs:comment 'Textual description of the scope or boundaries of the consent. Describes what specific activities, data types, or purposes are covered by this consent.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentStatus rdf:type rdf:Property ;
    rdfs:label 'Consent Status' ;
    rdfs:comment 'Current lifecycle status of the consent reference. Indicates whether the consent is currently active, has been revoked by the patient, has expired, is pending approval, or has been superseded by a newer consent.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentType rdf:type rdf:Property ;
    rdfs:label 'Consent Type' ;
    rdfs:comment 'The category of consent being referenced. Indicates the purpose or scope of the consent (e.g., treatment, research participation, marketing communications, PHI disclosure, HIE participation, telehealth services).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Document Reference Number' ;
    rdfs:comment 'Reference identifier to the physical or electronic consent document stored in the document management system. Enables retrieval of the original signed consent form.' ;
    rdfs:domain ind:ConsentReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:externalConsentCode rdf:type rdf:Property ;
    rdfs:label 'External Consent Code' ;
    rdfs:comment 'External consent ID' ;
    rdfs:domain ind:ConsentReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:guardianName rdf:type rdf:Property ;
    rdfs:label 'Guardian Name' ;
    rdfs:comment 'Full name of the legal guardian or authorized representative who provided consent on behalf of the patient. Null if patient provided consent directly.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:guardianRelationship rdf:type rdf:Property ;
    rdfs:label 'Guardian Relationship' ;
    rdfs:comment 'The relationship of the guardian or authorized representative to the patient (e.g., parent, spouse, healthcare proxy, power of attorney).' ;
    rdfs:domain ind:ConsentReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hieParticipationFlag rdf:type rdf:Property ;
    rdfs:label 'Hie Participation Flag' ;
    rdfs:comment 'Indicates whether the patient has consented to participate in Health Information Exchange networks for sharing their medical records across organizations. True if HIE participation is authorized, False otherwise.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:languageOfConsent rdf:type rdf:Property ;
    rdfs:label 'Language Of Consent' ;
    rdfs:comment 'The language in which the consent was presented to and obtained from the patient. Important for compliance with language access requirements.' ;
    rdfs:domain ind:ConsentReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:marketingOptInFlag rdf:type rdf:Property ;
    rdfs:label 'Marketing Opt In Flag' ;
    rdfs:comment 'Indicates whether the patient has opted in to receive marketing communications. True if patient opted in, False otherwise.' ;
    rdfs:domain ind:ConsentReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:phiDisclosureAuthorizedFlag rdf:type rdf:Property ;
    rdfs:label 'Phi Disclosure Authorized Flag' ;
    rdfs:comment 'Indicates whether this consent authorizes disclosure of Protected Health Information to third parties. True if PHI disclosure is authorized, False otherwise.' ;
    rdfs:domain ind:ConsentReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:recordReference rdf:type rdf:Property ;
    rdfs:label 'Record Reference' ;
    rdfs:comment 'Foreign key reference to the consent master record in the consent domain SSOT. Enables cross-domain joins to full consent details.' ;
    rdfs:domain ind:ConsentReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:referencePriority rdf:type rdf:Property ;
    rdfs:label 'Reference Priority' ;
    rdfs:comment 'Priority order of this consent reference when multiple consents of the same type exist for a patient. Lower numbers indicate higher priority. Used for determining which consent applies in conflict scenarios.' ;
    rdfs:domain ind:ConsentReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:researchParticipationFlag rdf:type rdf:Property ;
    rdfs:label 'Research Participation Flag' ;
    rdfs:comment 'Indicates whether this consent includes authorization for the patient to participate in research studies. True if research participation is authorized, False otherwise.' ;
    rdfs:domain ind:ConsentReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:scope rdf:type rdf:Property ;
    rdfs:label 'Scope' ;
    rdfs:comment 'Scope and coverage of the audit' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemReferenceCode rdf:type rdf:Property ;
    rdfs:label 'Source System Reference Code' ;
    rdfs:comment 'The unique identifier for this consent reference record in the source system. Used for data lineage and reconciliation.' ;
    rdfs:domain ind:ConsentReference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verifiedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Verified Timestamp' ;
    rdfs:comment 'The date and time when this consent reference record was verified. Null if not yet verified.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:witnessRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Witness Required Flag' ;
    rdfs:comment 'Indicates whether a witness signature was required for this consent based on regulatory or organizational policy. True if witness was required, False otherwise.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:qualityMeasureEvaluationId rdf:type rdf:Property ;
    rdfs:label 'Quality Measure Evaluation Id' ;
    rdfs:comment 'Unique surrogate identifier for each patient-measure evaluation record. Primary key for the association.' ;
    rdfs:domain ind:QualityMeasureEvaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:careGapClosureId rdf:type rdf:Property ;
    rdfs:label 'Care Gap Closure Id' ;
    rdfs:comment 'FK to the care gap closure record.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CareGapClosure .

ind:clinicalAiCareGapId rdf:type rdf:Property ;
    rdfs:label 'Clinical Ai Care Gap Id' ;
    rdfs:domain ind:QualityMeasureEvaluation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CareGap .

ind:primaryQualityMeasureId rdf:type rdf:Property ;
    rdfs:label 'Primary Quality Measure Id' ;
    rdfs:comment 'Foreign key linking to the quality measure definition against which the patient is being evaluated' ;
    rdfs:domain ind:QualityMeasureEvaluation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Measure .

ind:qualityMeasureAttributionId rdf:type rdf:Property ;
    rdfs:label 'Quality Measure Attribution Id' ;
    rdfs:comment 'FK to the quality measure attribution record.' ;
    rdfs:domain ind:QualityMeasureEvaluation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MeasureAttribution .

ind:qualityMeasureId rdf:type rdf:Property ;
    rdfs:label 'Quality Measure Id' ;
    rdfs:comment 'Foreign key linking to quality.measure. Business justification: Quality measures frequently target diagnosis-specific cohorts (diabetes HbA1c control, heart failure readmission). Measure calculation engines filter eligible populations by diagnosis codes. Essential' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Measure .

ind:careGapClosedFlag rdf:type rdf:Property ;
    rdfs:label 'Care Gap Closed Flag' ;
    rdfs:domain ind:QualityMeasureEvaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:closureDate rdf:type rdf:Property ;
    rdfs:label 'Closure Date' ;
    rdfs:comment 'Date on which the quality gap was closed (patient became numerator compliant). Null if gap remains open. Used for tracking gap closure velocity and care management effectiveness.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:dataSource rdf:type rdf:Property ;
    rdfs:label 'Data Source' ;
    rdfs:comment 'Source system or data collection method used to determine compliance for this evaluation (e.g., EHR, claims, chart abstraction, patient survey). Important for hybrid measure reporting and data validation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:denominatorEligible rdf:type rdf:Property ;
    rdfs:label 'Denominator Eligible' ;
    rdfs:comment 'Indicates whether the patient meets the denominator eligibility criteria for this measure in this measurement year (e.g., age range, diagnosis, enrollment continuity). Determined by applying measure-specific eligible population logic.' ;
    rdfs:domain ind:QualityMeasureEvaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:denominatorFlag rdf:type rdf:Property ;
    rdfs:label 'Denominator Flag' ;
    rdfs:comment 'Denominator flag' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dueDate rdf:type rdf:Property ;
    rdfs:label 'Due Date' ;
    rdfs:comment 'Target date by which the quality gap should be closed to count toward the measurement year performance (typically end of measurement period or submission deadline). Used for care management prioritization and outreach scheduling.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:evaluationDate rdf:type rdf:Property ;
    rdfs:label 'Evaluation Date' ;
    rdfs:comment 'Timestamp when this patient-measure evaluation was last calculated or refreshed. Quality measure evaluations are typically run monthly or quarterly to identify new gaps and update compliance status.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exclusionFlag rdf:type rdf:Property ;
    rdfs:label 'Exclusion Flag' ;
    rdfs:comment 'Exclusion flag' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exclusionReason rdf:type rdf:Property ;
    rdfs:label 'Exclusion Reason' ;
    rdfs:comment 'Reason code or description for why the patient was excluded from the denominator (e.g., hospice enrollment, bilateral mastectomy for breast cancer screening measures, medical contraindication). Null if not excluded.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gapStatus rdf:type rdf:Property ;
    rdfs:label 'Gap Status' ;
    rdfs:comment 'Current status of the quality gap for this patient-measure combination. OPEN = gap identified, patient eligible but not compliant; CLOSED = gap closed, patient now compliant; IN_PROGRESS = outreach/intervention underway; NOT_APPLICABLE = patient excluded or not eligible.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interventionCode rdf:type rdf:Property ;
    rdfs:label 'Intervention Code' ;
    rdfs:comment 'Code or identifier for the care management intervention applied to close this gap (e.g., appointment scheduled, prescription sent, patient education provided). Null if no intervention yet.' ;
    rdfs:domain ind:QualityMeasureEvaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:measureVersion rdf:type rdf:Property ;
    rdfs:label 'Measure Version' ;
    rdfs:comment 'NCQA version year' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:measurementPeriodEnd rdf:type rdf:Property ;
    rdfs:label 'Measurement Period End' ;
    rdfs:comment 'Measurement period end' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:measurementPeriodStart rdf:type rdf:Property ;
    rdfs:label 'Measurement Period Start' ;
    rdfs:comment 'Measurement period start' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:numeratorCompliant rdf:type rdf:Property ;
    rdfs:label 'Numerator Compliant' ;
    rdfs:comment 'Indicates whether the patient met the numerator criteria (received the required service, achieved the outcome) for this measure. True means the patient is compliant; false indicates a quality gap.' ;
    rdfs:domain ind:QualityMeasureEvaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:numeratorFlag rdf:type rdf:Property ;
    rdfs:label 'Numerator Flag' ;
    rdfs:comment 'Numerator flag' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:outreachAttempted rdf:type rdf:Property ;
    rdfs:label 'Outreach Attempted' ;
    rdfs:comment 'Indicates whether population health outreach (phone call, letter, patient portal message) has been attempted to close this gap. Used to track care management engagement efforts.' ;
    rdfs:domain ind:QualityMeasureEvaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:outreachDate rdf:type rdf:Property ;
    rdfs:label 'Outreach Date' ;
    rdfs:comment 'Date of most recent outreach attempt to the patient regarding this quality gap. Null if no outreach attempted.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:performanceMetFlag rdf:type rdf:Property ;
    rdfs:label 'Performance Met Flag' ;
    rdfs:domain ind:QualityMeasureEvaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:programEnrollmentId rdf:type rdf:Property ;
    rdfs:label 'Program Enrollment Id' ;
    rdfs:comment 'Unique surrogate identifier for the program enrollment record. Primary key for the association.' ;
    rdfs:domain ind:ProgramEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:careProgramId rdf:type rdf:Property ;
    rdfs:label 'Care Program Id' ;
    rdfs:comment 'Care program FK' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CareProgram .

ind:programAttributionPayerId rdf:type rdf:Property ;
    rdfs:label 'Program Attribution Payer Id' ;
    rdfs:comment 'Payer attributing patient to program' ;
    rdfs:domain ind:ProgramEnrollment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Payer .

ind:programCareManagerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Program Care Manager Employee Id' ;
    rdfs:comment 'Employee responsible for managing the patient within the program.' ;
    rdfs:domain ind:ProgramEnrollment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:programPayerId rdf:type rdf:Property ;
    rdfs:label 'Program Payer Id' ;
    rdfs:comment 'Payer sponsoring or requiring the program enrollment.' ;
    rdfs:domain ind:ProgramEnrollment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Payer .

ind:qualityProgramId rdf:type rdf:Property ;
    rdfs:label 'Quality Program Id' ;
    rdfs:comment 'Foreign key linking to the quality program master record. Identifies which quality program the patient is enrolled in.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:QualityProgram .

ind:referralId rdf:type rdf:Property ;
    rdfs:label 'Referral Id' ;
    rdfs:comment 'Added to expand thin product patient.program_enrollment' ;
    rdfs:domain ind:ProgramEnrollment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SdohReferral .

ind:actualCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Actual Completion Date' ;
    rdfs:comment 'Actual program completion date' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:actualEndDate rdf:type rdf:Property ;
    rdfs:label 'Actual End Date' ;
    rdfs:comment 'Added to expand thin product patient.program_enrollment' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:billingProviderNotes rdf:type rdf:Property ;
    rdfs:label 'Billing Provider Notes' ;
    rdfs:comment 'Added to expand thin product with domain-appropriate detail.' ;
    rdfs:domain ind:ProgramEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eligibilityCriteriaMet rdf:type rdf:Property ;
    rdfs:label 'Eligibility Criteria Met' ;
    rdfs:comment 'Criteria that qualified patient for program' ;
    rdfs:domain ind:ProgramEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:engagementLevel rdf:type rdf:Property ;
    rdfs:label 'Engagement Level' ;
    rdfs:comment 'Added to expand thin product patient.program_enrollment' ;
    rdfs:domain ind:ProgramEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:enrollmentMethod rdf:type rdf:Property ;
    rdfs:label 'Enrollment Method' ;
    rdfs:comment 'Method of enrollment (auto, manual, referral)' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:enrollmentNotes rdf:type rdf:Property ;
    rdfs:label 'Enrollment Notes' ;
    rdfs:comment 'Free-text notes related to the enrollment decision or status changes.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expectedCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Expected Completion Date' ;
    rdfs:comment 'Expected program completion date' ;
    rdfs:domain ind:ProgramEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:extraAttr1 rdf:type rdf:Property ;
    rdfs:label 'Extra Attr 1' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:extraAttr2 rdf:type rdf:Property ;
    rdfs:label 'Extra Attr 2' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:extraAttr3 rdf:type rdf:Property ;
    rdfs:label 'Extra Attr 3' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:extraAttr4 rdf:type rdf:Property ;
    rdfs:label 'Extra Attr 4' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:extraAttr5 rdf:type rdf:Property ;
    rdfs:label 'Extra Attr 5' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:graduationReadinessScore rdf:type rdf:Property ;
    rdfs:label 'Graduation Readiness Score' ;
    rdfs:comment 'Added to expand thin product with domain-appropriate detail.' ;
    rdfs:domain ind:ProgramEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lastContactDate rdf:type rdf:Property ;
    rdfs:label 'Last Contact Date' ;
    rdfs:comment 'Date of the most recent outreach or contact with the patient for this program.' ;
    rdfs:domain ind:ProgramEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastOutreachDate rdf:type rdf:Property ;
    rdfs:label 'Last Outreach Date' ;
    rdfs:comment 'Date of last outreach attempt' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastTouchpointAt rdf:type rdf:Property ;
    rdfs:label 'Last Touchpoint At' ;
    rdfs:comment 'Added to expand thin product patient.program_enrollment' ;
    rdfs:domain ind:ProgramEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:nextScheduledContactDate rdf:type rdf:Property ;
    rdfs:label 'Next Scheduled Contact Date' ;
    rdfs:comment 'Date of the next planned outreach or follow-up contact.' ;
    rdfs:domain ind:ProgramEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:optOutReason rdf:type rdf:Property ;
    rdfs:label 'Opt Out Reason' ;
    rdfs:comment 'Reason for opting out' ;
    rdfs:domain ind:ProgramEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outcomeSummary rdf:type rdf:Property ;
    rdfs:label 'Outcome Summary' ;
    rdfs:comment 'Added to expand thin product patient.program_enrollment' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outreachAttemptCount rdf:type rdf:Property ;
    rdfs:label 'Outreach Attempt Count' ;
    rdfs:comment 'Number of outreach attempts made' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:outreachAttempts rdf:type rdf:Property ;
    rdfs:label 'Outreach Attempts' ;
    rdfs:comment 'Number of outreach attempts made to enroll patient' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:programCostAmount rdf:type rdf:Property ;
    rdfs:label 'Program Cost Amount' ;
    rdfs:comment 'Added to expand thin product with domain-appropriate detail.' ;
    rdfs:domain ind:ProgramEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:programEnrollmentDate rdf:type rdf:Property ;
    rdfs:label 'Program Enrollment Date' ;
    rdfs:comment 'Date the patient was enrolled into the quality program. Determines eligibility for program-specific measures and performance periods. Sourced from quality program enrollment systems or EHR population health modules.' ;
    rdfs:domain ind:ProgramEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:programEnrollmentStatus rdf:type rdf:Property ;
    rdfs:label 'Program Enrollment Status' ;
    rdfs:comment 'Current status of the patient\'s enrollment in the quality program. Values: active (currently enrolled and eligible for measures), inactive (enrollment paused), pending (enrollment initiated but not yet active), disenrolled (enrollment terminated), suspended (temporarily ineligible). Drives inclusion in quality measure denominators and performance calculations.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:programNotes rdf:type rdf:Property ;
    rdfs:label 'Program Notes' ;
    rdfs:comment 'Notes about patient enrollment' ;
    rdfs:domain ind:ProgramEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reengagementFlag rdf:type rdf:Property ;
    rdfs:label 'Reengagement Flag' ;
    rdfs:comment 'Added to expand thin product with domain-appropriate detail.' ;
    rdfs:domain ind:ProgramEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:referralSource rdf:type rdf:Property ;
    rdfs:label 'Referral Source' ;
    rdfs:comment 'Entity or person that referred the patient to the program.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskScoreAtEnrollment rdf:type rdf:Property ;
    rdfs:label 'Risk Score At Enrollment' ;
    rdfs:comment 'Patient risk score at time of enrollment' ;
    rdfs:domain ind:ProgramEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:targetEndDate rdf:type rdf:Property ;
    rdfs:label 'Target End Date' ;
    rdfs:comment 'Added to expand thin product patient.program_enrollment' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:targetOutcome rdf:type rdf:Property ;
    rdfs:label 'Target Outcome' ;
    rdfs:comment 'Primary clinical or operational outcome targeted by the enrollment.' ;
    rdfs:domain ind:ProgramEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vibeExpandedFlag rdf:type rdf:Property ;
    rdfs:label 'Vibe Expanded Flag' ;
    rdfs:comment 'Flag added by VIBE batch to expand thin product attribute set.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
