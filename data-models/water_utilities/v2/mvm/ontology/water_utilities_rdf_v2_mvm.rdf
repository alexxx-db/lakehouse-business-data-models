    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:testResult rdf:type rdf:Property ;
    rdfs:label 'Test Result' ;
    rdfs:comment 'The test result value recorded for each accuracy test in the metering domain.' ;
    rdfs:domain ind:AccuracyTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:testStatus rdf:type rdf:Property ;
    rdfs:label 'Test Status' ;
    rdfs:comment 'Scheduled, In-progress, Completed, Failed, Cancelled. Ref: Sensus AMI.' ;
    rdfs:domain ind:AccuracyTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:testType rdf:type rdf:Property ;
    rdfs:label 'Test Type' ;
    rdfs:comment 'Type of test (bench, field, new_meter, complaint). Ref: Sensus AMI.' ;
    rdfs:domain ind:AccuracyTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:testVolumeGallons rdf:type rdf:Property ;
    rdfs:label 'Test Volume Gallons' ;
    rdfs:comment 'Total volume used in test. Ref: Sensus AMI.' ;
    rdfs:domain ind:AccuracyTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:testedBy rdf:type rdf:Property ;
    rdfs:label 'Tested By' ;
    rdfs:comment 'The tested by value recorded for each accuracy test in the metering domain.' ;
    rdfs:domain ind:AccuracyTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:testerName rdf:type rdf:Property ;
    rdfs:label 'Tester Name' ;
    rdfs:comment 'The tester name used to identify each accuracy test record in the metering domain.' ;
    rdfs:domain ind:AccuracyTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:toleranceHigh rdf:type rdf:Property ;
    rdfs:label 'Tolerance High' ;
    rdfs:comment 'The tolerance high value recorded for each accuracy test in the metering domain.' ;
    rdfs:domain ind:AccuracyTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:toleranceLow rdf:type rdf:Property ;
    rdfs:label 'Tolerance Low' ;
    rdfs:comment 'The tolerance low value recorded for each accuracy test in the metering domain.' ;
    rdfs:domain ind:AccuracyTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:weightedAccuracyPct rdf:type rdf:Property ;
    rdfs:label 'Weighted Accuracy Pct' ;
    rdfs:comment 'AWWA weighted accuracy percentage' ;
    rdfs:domain ind:AccuracyTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:activeFlag rdf:type rdf:Property ;
    rdfs:label 'Active Flag' ;
    rdfs:comment 'The active flag value recorded for each read route in the metering domain.' ;
    rdfs:domain ind:ReadRoute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cycleCode rdf:type rdf:Property ;
    rdfs:label 'Cycle Code' ;
    rdfs:comment 'The cycle code value recorded for each read route in the metering domain.' ;
    rdfs:domain ind:ReadRoute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cycleNumber rdf:type rdf:Property ;
    rdfs:label 'Cycle Number' ;
    rdfs:comment 'The cycle number value recorded for each read route in the metering domain.' ;
    rdfs:domain ind:ReadRoute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedDurationHours rdf:type rdf:Property ;
    rdfs:label 'Estimated Duration Hours' ;
    rdfs:comment 'Estimated time to complete route. Ref: Sensus AMI.' ;
    rdfs:domain ind:ReadRoute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedReadHours rdf:type rdf:Property ;
    rdfs:label 'Estimated Read Hours' ;
    rdfs:comment 'Estimated hours to complete a full route read. Ref: Sensus AMI.' ;
    rdfs:domain ind:ReadRoute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:estimatedReadTimeHours rdf:type rdf:Property ;
    rdfs:label 'Estimated Read Time Hours' ;
    rdfs:comment 'Estimated time to complete route in hours. Ref: Sensus AMI.' ;
    rdfs:domain ind:ReadRoute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hazardNotes rdf:type rdf:Property ;
    rdfs:label 'Hazard Notes' ;
    rdfs:comment 'Safety hazard notes for field personnel. Ref: Sensus AMI.' ;
    rdfs:domain ind:ReadRoute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isAmiRoute rdf:type rdf:Property ;
    rdfs:label 'Is Ami Route' ;
    rdfs:comment 'Boolean flag indicating whether the is ami route condition applies to the read route record.' ;
    rdfs:domain ind:ReadRoute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastReadDate rdf:type rdf:Property ;
    rdfs:label 'Last Read Date' ;
    rdfs:comment 'Date route was last read. Ref: Sensus AMI.' ;
    rdfs:domain ind:ReadRoute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nextScheduledDate rdf:type rdf:Property ;
    rdfs:label 'Next Scheduled Date' ;
    rdfs:comment 'Next scheduled read date. Ref: Sensus AMI.' ;
    rdfs:domain ind:ReadRoute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nextScheduledReadDate rdf:type rdf:Property ;
    rdfs:label 'Next Scheduled Read Date' ;
    rdfs:comment 'Next scheduled read date. Ref: Sensus AMI.' ;
    rdfs:domain ind:ReadRoute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:readCycle rdf:type rdf:Property ;
    rdfs:label 'Read Cycle' ;
    rdfs:comment 'The read cycle value recorded for each read route in the metering domain.' ;
    rdfs:domain ind:ReadRoute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:readCycleDays rdf:type rdf:Property ;
    rdfs:label 'Read Cycle Days' ;
    rdfs:comment 'Number of days between reads on this route. Ref: Sensus AMI.' ;
    rdfs:domain ind:ReadRoute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:readDayOfMonth rdf:type rdf:Property ;
    rdfs:label 'Read Day Of Month' ;
    rdfs:comment 'Scheduled day of month for reading. Ref: Sensus AMI.' ;
    rdfs:domain ind:ReadRoute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:readFrequency rdf:type rdf:Property ;
    rdfs:label 'Read Frequency' ;
    rdfs:comment 'Read frequency (monthly, bi_monthly, quarterly). Ref: Sensus AMI.' ;
    rdfs:domain ind:ReadRoute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:readMethod rdf:type rdf:Property ;
    rdfs:label 'Read Method' ;
    rdfs:comment 'Walk-by AMR, Drive-by AMR, AMI, Manual. Ref: Sensus AMI.' ;
    rdfs:domain ind:ReadRoute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:readRouteNumber rdf:type rdf:Property ;
    rdfs:label 'Read Route Number' ;
    rdfs:comment 'The read route number value recorded for each read route in the metering domain.' ;
    rdfs:domain ind:ReadRoute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:readRouteStatus rdf:type rdf:Property ;
    rdfs:label 'Read Route Status' ;
    rdfs:comment 'Lifecycle status of the record. Ref: Sensus AMI.' ;
    rdfs:domain ind:ReadRoute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:readRouteType rdf:type rdf:Property ;
    rdfs:label 'Read Route Type' ;
    rdfs:comment 'The read route type value recorded for each read route in the metering domain.' ;
    rdfs:domain ind:ReadRoute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:readSequence rdf:type rdf:Property ;
    rdfs:label 'Read Sequence' ;
    rdfs:comment 'The read sequence value recorded for each read route in the metering domain.' ;
    rdfs:domain ind:ReadRoute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:routeCode rdf:type rdf:Property ;
    rdfs:label 'Route Code' ;
    rdfs:comment 'Unique route code identifier. Ref: Sensus AMI.' ;
    rdfs:domain ind:ReadRoute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:routeDistanceMiles rdf:type rdf:Property ;
    rdfs:label 'Route Distance Miles' ;
    rdfs:comment 'Total route distance in miles. Ref: Sensus AMI.' ;
    rdfs:domain ind:ReadRoute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:routeName rdf:type rdf:Property ;
    rdfs:label 'Route Name' ;
    rdfs:comment 'Descriptive route name. Ref: Sensus AMI.' ;
    rdfs:domain ind:ReadRoute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:routeNumber rdf:type rdf:Property ;
    rdfs:label 'Route Number' ;
    rdfs:comment 'The route number value recorded for each read route in the metering domain.' ;
    rdfs:domain ind:ReadRoute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:routeSequence rdf:type rdf:Property ;
    rdfs:label 'Route Sequence' ;
    rdfs:comment 'The route sequence value recorded for each read route in the metering domain.' ;
    rdfs:domain ind:ReadRoute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:routeSequenceEnd rdf:type rdf:Property ;
    rdfs:label 'Route Sequence End' ;
    rdfs:comment 'Ending sequence number. Ref: Sensus AMI.' ;
    rdfs:domain ind:ReadRoute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:routeSequenceStart rdf:type rdf:Property ;
    rdfs:label 'Route Sequence Start' ;
    rdfs:comment 'Starting sequence number. Ref: Sensus AMI.' ;
    rdfs:domain ind:ReadRoute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:routeStatus rdf:type rdf:Property ;
    rdfs:label 'Route Status' ;
    rdfs:comment 'Status (active, inactive, seasonal). Ref: Sensus AMI.' ;
    rdfs:domain ind:ReadRoute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:routeType rdf:type rdf:Property ;
    rdfs:label 'Route Type' ;
    rdfs:comment 'Type (manual_walk, drive_by, AMI_fixed_network). Ref: Sensus AMI.' ;
    rdfs:domain ind:ReadRoute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sequenceDescription rdf:type rdf:Property ;
    rdfs:label 'Sequence Description' ;
    rdfs:comment 'Description of route sequence/path. Ref: Sensus AMI.' ;
    rdfs:domain ind:ReadRoute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sequenceOptimized rdf:type rdf:Property ;
    rdfs:label 'Sequence Optimized' ;
    rdfs:comment 'Whether route sequence is GPS-optimized. Ref: Sensus AMI.' ;
    rdfs:domain ind:ReadRoute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sequenceOptimizedDate rdf:type rdf:Property ;
    rdfs:label 'Sequence Optimized Date' ;
    rdfs:comment 'Date the route sequence was last optimized for efficiency. Ref: Sensus AMI.' ;
    rdfs:domain ind:ReadRoute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:sequenceOptimizedFlag rdf:type rdf:Property ;
    rdfs:label 'Sequence Optimized Flag' ;
    rdfs:comment 'Whether the route sequence has been optimized for efficiency. Ref: Sensus AMI.' ;
    rdfs:domain ind:ReadRoute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sequenceOrder rdf:type rdf:Property ;
    rdfs:label 'Sequence Order' ;
    rdfs:comment 'The sequence order value recorded for each read route in the metering domain.' ;
    rdfs:domain ind:ReadRoute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:serviceAreaDescription rdf:type rdf:Property ;
    rdfs:label 'Service Area Description' ;
    rdfs:comment 'The service area description value recorded for each read route in the metering domain.' ;
    rdfs:domain ind:ReadRoute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:classId rdf:type rdf:Property ;
    rdfs:label 'Class Id' ;
    rdfs:comment 'Foreign key linking to asset.asset_class. Business justification: Registry stores asset classification as a free-text field; linking to the asset_class taxonomy enables consistent classification and removes the redundant string column. Ref: IBM Maximo.' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Class .

ind:parentAssetRegistryId rdf:type rdf:Property ;
    rdfs:label 'Parent Asset Registry Id' ;
    rdfs:comment 'Self-referencing identifier pointing to the parent asset in the asset hierarchy (e.g., a pump impeller\'s parent is the pump assembly; the pump assembly\'s parent is the pump station). Enables parent-child asset hierarchy navigation for maintenance cost roll-up and condition assessment aggregation. Null for top-level assets. Ref: IBM Maximo.' ;
    rdfs:domain ind:Registry ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Registry .

ind:acquisitionCost rdf:type rdf:Property ;
    rdfs:label 'Acquisition Cost' ;
    rdfs:comment 'Original purchase or construction cost of the asset in US dollars at the time of acquisition. Represents the capitalized cost basis used for depreciation calculations and fixed asset register reporting. Sourced from SAP FI/CO asset accounting module. Required for GASB Statement No. 34 infrastructure asset reporting. Ref: IBM Maximo.' ;
    rdfs:domain ind:Registry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:assetCategory rdf:type rdf:Property ;
    rdfs:label 'Asset Category' ;
    rdfs:comment 'Operational domain category indicating which business process area the asset belongs to (e.g., water_treatment for WTP equipment, wastewater_treatment for WWTP equipment, distribution for pipes and valves in the distribution network, collection for sewer infrastructure, metering for AMI/AMR devices). [ENUM-REF-CANDIDATE: water_treatment|wastewater_treatment|distribution|collection|metering|electrical|mechanical|civil|vehicle|instrumentation_control — 10 candidates stripped; promote to reference product]. Ref: IBM Maximo.' ;
    rdfs:domain ind:Registry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assetName rdf:type rdf:Property ;
    rdfs:label 'Asset Name' ;
    rdfs:comment 'Human-readable name or short description of the asset (e.g., \'Raw Water Pump No. 3\', \'Influent Gate Valve 12-inch\', \'Chlorine Contact Basin Filter 2\'). Used as the primary display label in CMMS, GIS, and reporting interfaces. Ref: IBM Maximo.' ;
    rdfs:domain ind:Registry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assetType rdf:type rdf:Property ;
    rdfs:label 'Asset Type' ;
    rdfs:comment 'Sub-classification within the asset class providing more granular categorization (e.g., Centrifugal Pump, Gate Valve, Ductile Iron Pipe, AMI Smart Meter). Aligns with IBM Maximo asset type and SAP PM equipment category for maintenance planning and spare parts management.' ;
    rdfs:domain ind:Registry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capacityUnit rdf:type rdf:Property ;
    rdfs:label 'Capacity Unit' ;
    rdfs:comment 'Unit of measure for the rated_capacity field. Common units include GPM (Gallons per Minute) for pumps, MGD (Million Gallons per Day) for treatment processes, gallons for storage tanks, kW for electrical equipment, and PSI (Pounds per Square Inch) for pressure vessels. [ENUM-REF-CANDIDATE: GPM|MGD|gallons|kW|kVA|HP|PSI|NTU|mg_L — 9 candidates stripped; promote to reference product]. Ref: IBM Maximo.' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:diameterMm rdf:type rdf:Property ;
    rdfs:label 'Diameter Mm' ;
    rdfs:comment 'Nominal diameter of the asset in millimeters. For pipes and valves, this is the internal bore diameter. For pumps, this is the discharge diameter. Used for hydraulic capacity calculations, spare parts specification, and network modeling in Innovyze InfoWater. Ref: IBM Maximo.' ;
    rdfs:domain ind:Registry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:functionalLocation rdf:type rdf:Property ;
    rdfs:label 'Functional Location' ;
    rdfs:comment 'Hierarchical functional location code representing the physical or functional position of the asset within the utility\'s infrastructure (e.g., WTP-PUMP-STATION-01-PUMP-03). Mirrors the SAP PM Functional Location (FLOC) structure and IBM Maximo Location field. Used for structured asset hierarchy navigation and maintenance cost allocation.' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isLeadServiceLine rdf:type rdf:Property ;
    rdfs:label 'Is Lead Service Line' ;
    rdfs:comment 'Indicates whether this asset is a lead service line or contains lead components. Critical for compliance with the EPA Lead and Copper Rule Revisions (LCRR) which requires utilities to inventory and replace lead service lines. True = confirmed lead service line; False = non-lead or unknown.' ;
    rdfs:domain ind:Registry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastUpdatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Updated Timestamp' ;
    rdfs:comment 'Timestamp of the most recent update to the asset record in the enterprise asset registry. Used for change tracking, data synchronization with IBM Maximo and SAP PM, and audit trail maintenance. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:maintenanceStrategy rdf:type rdf:Property ;
    rdfs:label 'Maintenance Strategy' ;
    rdfs:comment 'The primary maintenance approach applied to this asset as defined in the Computerized Maintenance Management System (CMMS). \'preventive\' indicates time-based scheduled maintenance; \'predictive\' indicates condition-monitoring-based maintenance; \'condition_based\' indicates maintenance triggered by condition thresholds; \'run_to_failure\' is applied to non-critical, easily replaceable assets. Ref: IBM Maximo.' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maximoAssetNum rdf:type rdf:Property ;
    rdfs:label 'Maximo Asset Num' ;
    rdfs:comment 'The asset number as assigned and maintained in IBM Maximo Asset Management (CMMS). This is the operational cross-reference key used by maintenance crews and work order management. Must be unique within the Maximo instance.' ;
    rdfs:domain ind:Registry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modelNum rdf:type rdf:Property ;
    rdfs:label 'Model Num' ;
    rdfs:comment 'Manufacturer\'s model or product number for the asset (e.g., \'LF 3196 STX\', \'NK 65-200\'). Used for spare parts identification, technical documentation retrieval, and procurement of replacement units. Sourced from IBM Maximo model field.' ;
    rdfs:domain ind:Registry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextMaintenanceDate rdf:type rdf:Property ;
    rdfs:label 'Next Maintenance Date' ;
    rdfs:comment 'Date on which the next scheduled preventive maintenance activity is due for this asset. Derived from the PM schedule and last maintenance date. Used for maintenance planning, resource scheduling, and compliance tracking in IBM Maximo.' ;
    rdfs:domain ind:Registry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:powerRatingKw rdf:type rdf:Property ;
    rdfs:label 'Power Rating Kw' ;
    rdfs:comment 'Nameplate power rating of the asset in kilowatts (kW). Applicable to pumps, blowers, motors, generators, and other electrical equipment. Used for energy consumption analysis, Variable Frequency Drive (VFD) sizing, electrical load planning, and OPEX budgeting. Ref: IBM Maximo.' ;
    rdfs:domain ind:Registry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatoryAssetCode rdf:type rdf:Property ;
    rdfs:label 'Regulatory Asset Code' ;
    rdfs:comment 'Asset identifier assigned by a regulatory authority (e.g., state drinking water program, EPA) for compliance tracking and reporting purposes. Used in regulatory submissions such as the Consumer Confidence Report (CCR), Discharge Monitoring Report (DMR), and NPDES permit compliance documentation. Ref: IBM Maximo.' ;
    rdfs:domain ind:Registry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:replacementCost rdf:type rdf:Property ;
    rdfs:label 'Replacement Cost' ;
    rdfs:comment 'Current estimated cost to replace the asset with a new equivalent unit in US dollars. Updated periodically based on market pricing and engineering estimates. Used for Capital Improvement Program (CIP) budgeting, insurance valuation, and risk-based asset management decision-making. Ref: IBM Maximo.' ;
    rdfs:domain ind:Registry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sapEquipmentNum rdf:type rdf:Property ;
    rdfs:label 'Sap Equipment Num' ;
    rdfs:comment 'The equipment number assigned in SAP Plant Maintenance (PM) module. Used for integration with SAP FI/CO for depreciation, CAPEX/OPEX tracking, and maintenance cost postings. Enables bidirectional synchronization between SAP PM and the asset registry. Ref: IBM Maximo.' ;
    rdfs:domain ind:Registry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serialNum rdf:type rdf:Property ;
    rdfs:label 'Serial Num' ;
    rdfs:comment 'Unique serial number assigned by the manufacturer to this specific asset unit. Used for warranty claims, recall tracking, and precise asset identification when multiple identical units exist. Sourced from IBM Maximo serial number field.' ;
    rdfs:domain ind:Registry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vibeAssetDomainFlag rdf:type rdf:Property ;
    rdfs:label 'Vibe Asset Domain Flag' ;
    rdfs:comment 'Marks that this product is part of the built-out asset domain. Ref: IBM Maximo.' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:warrantyExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Warranty Expiry Date' ;
    rdfs:comment 'Date on which the manufacturer\'s warranty for the asset expires. Used to trigger warranty claim processes before expiry and to transition maintenance responsibility from warranty to O&M budget. Sourced from IBM Maximo warranty end date.' ;
    rdfs:domain ind:Registry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:amiApplicable rdf:type rdf:Property ;
    rdfs:label 'Ami Applicable' ;
    rdfs:comment 'Indicates whether assets of this class are part of the AMI/AMR metering infrastructure managed via the Sensus FlexNet AMI Platform. True for smart meters and communication endpoints; False for all other asset classes. Ref: IBM Maximo.' ;
    rdfs:domain ind:Class ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:assetDomain rdf:type rdf:Property ;
    rdfs:label 'Asset Domain' ;
    rdfs:comment 'Operational domain to which this asset class primarily belongs within the utility (e.g., Water Treatment, Water Distribution, Wastewater Collection, Wastewater Treatment, Metering, Fleet, Facilities, Cross-Domain). Drives domain-specific maintenance strategies and regulatory reporting alignment. [ENUM-REF-CANDIDATE: Water Treatment|Water Distribution|Wastewater Collection|Wastewater Treatment|Metering|Fleet|Facilities|Cross-Domain — promote to reference product]. Ref: IBM Maximo.' ;
    rdfs:domain ind:Class ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capexThresholdUsd rdf:type rdf:Property ;
    rdfs:label 'Capex Threshold Usd' ;
    rdfs:comment 'Minimum acquisition or renewal cost in USD above which expenditures on assets of this class are capitalized as CAPEX rather than expensed as OPEX. Aligned with GAAP/GASB capitalization policies and SAP FI/CO asset accounting rules. Ref: IBM Maximo.' ;
    rdfs:domain ind:Class ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cipProgramCategory rdf:type rdf:Property ;
    rdfs:label 'Cip Program Category' ;
    rdfs:comment 'CIP program category under which capital renewal projects for assets of this class are budgeted and tracked. Aligns with the utility\'s multi-year CIP planning structure in SAP PS and financial reporting to the Public Utilities Commission. [ENUM-REF-CANDIDATE: Water Supply|Water Treatment|Water Distribution|Wastewater Collection|Wastewater Treatment|Metering|Facilities|Fleet|Cross-Program — promote to reference product]. Ref: IBM Maximo.' ;
    rdfs:domain ind:Class ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:classStatus rdf:type rdf:Property ;
    rdfs:label 'Class Status' ;
    rdfs:comment 'Current lifecycle status of the asset class record within the reference taxonomy. \'Active\' classes are available for new asset registrations; \'Deprecated\' classes are retained for historical assets but cannot be assigned to new assets. Ref: IBM Maximo.' ;
    rdfs:domain ind:Class ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conditionAssessmentMethod rdf:type rdf:Property ;
    rdfs:label 'Condition Assessment Method' ;
    rdfs:comment 'Default method used to assess the physical condition of assets in this class. CIPP and pipe assets typically use CCTV; rotating equipment uses vibration analysis; distribution mains may use acoustic leak detection. Drives field inspection work order types in Maximo. [ENUM-REF-CANDIDATE: Visual Inspection|CCTV|Acoustic Leak Detection|Vibration Analysis|Ultrasonic Testing|Hydraulic Testing|SCADA Monitoring|Not Applicable — promote to reference product]. Ref: IBM Maximo.' ;
    rdfs:domain ind:Class ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consequenceOfFailure rdf:type rdf:Property ;
    rdfs:label 'Consequence Of Failure' ;
    rdfs:comment 'Primary category of consequence if assets of this class fail. Drives risk-based maintenance prioritization and emergency response planning. [ENUM-REF-CANDIDATE: Service Interruption|Public Health Risk|Environmental Non-Compliance|Safety Hazard|Financial Loss|Reputational — promote to reference product]. Ref: IBM Maximo.' ;
    rdfs:domain ind:Class ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:criticalityTier rdf:type rdf:Property ;
    rdfs:label 'Criticality Tier' ;
    rdfs:comment 'Default criticality tier classification for assets of this class based on consequence of failure analysis. Critical assets (e.g., primary WTP pumps, transmission mains) receive highest maintenance priority and fastest response SLAs. Ref: IBM Maximo.' ;
    rdfs:domain ind:Class ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:criticalityWeight rdf:type rdf:Property ;
    rdfs:label 'Criticality Weight' ;
    rdfs:comment 'Numeric weighting factor (typically 0.00–10.00) applied to assets of this class during criticality assessment scoring. Higher values indicate greater consequence of failure on service delivery, public health, or regulatory compliance. Used in risk-based asset prioritization per ISO 55001.' ;
    rdfs:domain ind:Class ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:depreciationMethod rdf:type rdf:Property ;
    rdfs:label 'Depreciation Method' ;
    rdfs:comment 'Default accounting depreciation method applied to assets of this class for financial reporting purposes. Straight-Line is most common for utility infrastructure. Aligned with GAAP/GASB requirements for municipal utility financial statements. [ENUM-REF-CANDIDATE: Straight-Line|Declining Balance|Units of Production|Sum-of-Years-Digits|Modified Accelerated Cost Recovery — promote to reference product]. Ref: IBM Maximo.' ;
    rdfs:domain ind:Class ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:environmentalRiskFlag rdf:type rdf:Property ;
    rdfs:label 'Environmental Risk Flag' ;
    rdfs:comment 'Indicates whether failure of assets in this class poses a direct environmental risk requiring regulatory notification (e.g., SSO, CSO, chemical spill, NPDES permit exceedance). True triggers mandatory environmental incident reporting workflows. Ref: IBM Maximo.' ;
    rdfs:domain ind:Class ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:gisFeatureClass rdf:type rdf:Property ;
    rdfs:label 'Gis Feature Class' ;
    rdfs:comment 'Corresponding feature class name in Esri ArcGIS geodatabase for assets of this class (e.g., \'wDistributionMain\', \'wValve\', \'wPump\'). Enables spatial analysis, network modeling in Innovyze InfoWater, and GIS-CMMS integration for field crew dispatch. Ref: IBM Maximo.' ;
    rdfs:domain ind:Class ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hierarchyLevel rdf:type rdf:Property ;
    rdfs:label 'Hierarchy Level' ;
    rdfs:comment 'Numeric depth of this class within the classification hierarchy (1 = top-level category, 2 = sub-category, 3 = class, 4 = sub-class). Drives roll-up aggregation logic in CAPEX planning and maintenance reporting. Ref: IBM Maximo.' ;
    rdfs:domain ind:Class ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:inspectionFrequencyDays rdf:type rdf:Property ;
    rdfs:label 'Inspection Frequency Days' ;
    rdfs:comment 'Default interval in calendar days between mandatory regulatory or condition inspections for assets of this class. Distinct from PM frequency — this is driven by regulatory compliance requirements (e.g., EPA, state primacy agency mandates) rather than maintenance strategy. Ref: IBM Maximo.' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:iso55001Aligned rdf:type rdf:Property ;
    rdfs:label 'Iso 55001 Aligned' ;
    rdfs:comment 'Indicates whether the maintenance strategy, criticality assessment, and lifecycle management approach for this asset class have been formally aligned with ISO 55001 Asset Management System requirements. Used for ISO certification audit evidence.' ;
    rdfs:domain ind:Class ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lcrrApplicable rdf:type rdf:Property ;
    rdfs:label 'Lcrr Applicable' ;
    rdfs:comment 'Indicates whether assets of this class are subject to EPA Lead and Copper Rule Revisions (LCRR) compliance requirements, such as lead service line inventory and replacement tracking. Applicable to service lines, connectors, and plumbing components.' ;
    rdfs:domain ind:Class ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:materialStandard rdf:type rdf:Property ;
    rdfs:label 'Material Standard' ;
    rdfs:comment 'Default material specification or construction standard applicable to assets of this class (e.g., \'AWWA C900 PVC\', \'AWWA C200 Steel\', \'ASTM A536 Ductile Iron\', \'HDPE ASTM D3035\'). Used in procurement specifications and asset registry for infrastructure renewal planning.' ;
    rdfs:domain ind:Class ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maximoClassCode rdf:type rdf:Property ;
    rdfs:label 'Maximo Class Code' ;
    rdfs:comment 'Corresponding asset class identifier in IBM Maximo Asset Management CMMS. Used for bidirectional synchronization between the Silver Layer lakehouse and Maximo for work order generation, PM scheduling, and asset lifecycle management.' ;
    rdfs:domain ind:Class ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:meanTimeBetweenFailuresDays rdf:type rdf:Property ;
    rdfs:label 'Mean Time Between Failures Days' ;
    rdfs:comment 'Industry benchmark mean time between failures in days for assets of this class, used as a baseline for reliability-centered maintenance planning and failure probability modeling. Sourced from AWWA reliability benchmarks and historical Maximo work order data.' ;
    rdfs:domain ind:Class ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:meanTimeToRepairHours rdf:type rdf:Property ;
    rdfs:label 'Mean Time To Repair Hours' ;
    rdfs:comment 'Industry benchmark mean time to repair in hours for assets of this class, used for SLA setting, crew resource planning, and service restoration time estimation. Sourced from AWWA benchmarks and historical Maximo corrective work order durations.' ;
    rdfs:domain ind:Class ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:numberSap rdf:type rdf:Property ;
    rdfs:label 'Number Sap' ;
    rdfs:comment 'Corresponding asset class number in SAP FI/CO Asset Accounting module (transaction AS02/AS03). Enables direct cross-reference between the enterprise data lakehouse and the SAP ERP system of record for financial reconciliation. Ref: IBM Maximo.' ;
    rdfs:domain ind:Class ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pmFrequencyDays rdf:type rdf:Property ;
    rdfs:label 'Pm Frequency Days' ;
    rdfs:comment 'Default interval in calendar days between scheduled preventive maintenance activities for assets of this class. Used by IBM Maximo PM scheduling engine to auto-generate work orders. Overridable at the individual asset level.' ;
    rdfs:domain ind:Class ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:primaryCategory rdf:type rdf:Property ;
    rdfs:label 'Primary Category' ;
    rdfs:comment 'Top-level classification grouping for the asset class aligned with standard utility asset taxonomy: Mechanical (pumps, blowers, mixers), Electrical (transformers, switchgear), Civil (pipes, structures, tanks), Instrumentation (sensors, meters, SCADA RTUs), Vehicle (fleet), Information Technology, or Other. [ENUM-REF-CANDIDATE: Mechanical|Electrical|Civil|Instrumentation|Vehicle|Information Technology|Other — promote to reference product]. Ref: IBM Maximo.' ;
    rdfs:domain ind:Class ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:renewalStrategy rdf:type rdf:Property ;
    rdfs:label 'Renewal Strategy' ;
    rdfs:comment 'Default end-of-life renewal strategy for assets of this class used in CIP planning. CIPP (Cured-in-Place Pipe) and trenchless methods are common for buried pipe rehabilitation; rotating equipment typically follows Replace-in-Kind or Upgrade strategies. Ref: IBM Maximo.' ;
    rdfs:domain ind:Class ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:safetyClassification rdf:type rdf:Property ;
    rdfs:label 'Safety Classification' ;
    rdfs:comment 'Primary safety hazard classification for work activities on assets of this class. Drives OSHA-compliant safety permit requirements (e.g., confined space entry permits, lockout/tagout procedures) when generating work orders in Maximo.' ;
    rdfs:domain ind:Class ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:salvageValuePct rdf:type rdf:Property ;
    rdfs:label 'Salvage Value Pct' ;
    rdfs:comment 'Default residual/salvage value expressed as a percentage of original acquisition cost at end of useful life for assets in this class. Used in depreciation calculations and asset disposal planning within SAP FI/CO. Ref: IBM Maximo.' ;
    rdfs:domain ind:Class ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scadaMonitored rdf:type rdf:Property ;
    rdfs:label 'Scada Monitored' ;
    rdfs:comment 'Indicates whether assets of this class are typically monitored via SCADA (Supervisory Control and Data Acquisition) systems integrated with OSIsoft PI Historian. True for pumps, valves, flow meters, and treatment equipment; False for passive civil assets such as buried pipes.' ;
    rdfs:domain ind:Class ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sizeUnitOfMeasure rdf:type rdf:Property ;
    rdfs:label 'Size Unit Of Measure' ;
    rdfs:comment 'Standard unit of measure used to express the principal sizing attribute for assets of this class (e.g., \'inches\' for pipe diameter, \'HP\' for pump motor horsepower, \'kVA\' for transformer capacity, \'GPM\' for flow capacity). Ensures consistent sizing data entry across the asset registry. [ENUM-REF-CANDIDATE: inches|mm|feet|meters|kVA|HP|kW|GPM|MGD|gallons|cubic feet — promote to reference product]. Ref: IBM Maximo.' ;
    rdfs:domain ind:Class ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sparePartsRequired rdf:type rdf:Property ;
    rdfs:label 'Spare Parts Required' ;
    rdfs:comment 'Indicates whether assets of this class typically require dedicated spare parts inventory to be maintained in the storeroom (SAP MM / Maximo Inventory). True for critical rotating equipment and instrumentation; False for passive civil assets. Ref: IBM Maximo.' ;
    rdfs:domain ind:Class ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ssotEntityRole rdf:type rdf:Property ;
    rdfs:label 'Ssot Entity Role' ;
    rdfs:comment 'SSOT cross-domain reconciliation link. Ref: IBM Maximo.' ;
    rdfs:domain ind:Class ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workOrderTypeDefault rdf:type rdf:Property ;
    rdfs:label 'Work Order Type Default' ;
    rdfs:comment 'Default work order type generated in IBM Maximo for assets of this class when a maintenance event is triggered. Drives labor planning, cost coding, and CAPEX vs OPEX classification of maintenance expenditures.' ;
    rdfs:domain ind:Class ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:parentLocationId rdf:type rdf:Property ;
    rdfs:label 'Parent Location Id' ;
    rdfs:comment 'Reference to the parent location in the hierarchical location structure (e.g., a room\'s parent is a floor, a floor\'s parent is a building). Ref: IBM Maximo.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Location .

ind:accessRestrictions rdf:type rdf:Property ;
    rdfs:label 'Access Restrictions' ;
    rdfs:comment 'Description of physical or security access restrictions for the location (e.g., \'Restricted - Badge Required\', \'Public Access\', \'Confined Space\'). Ref: IBM Maximo.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:areaSquareFeet rdf:type rdf:Property ;
    rdfs:label 'Area Square Feet' ;
    rdfs:comment 'Physical area of the location in square feet, used for space planning and asset density analysis. Ref: IBM Maximo.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dmaZone rdf:type rdf:Property ;
    rdfs:label 'Dma Zone' ;
    rdfs:comment 'District Metered Area zone identifier for water distribution network segmentation and Non-Revenue Water (NRW) analysis. Ref: IBM Maximo.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:environmentalConditions rdf:type rdf:Property ;
    rdfs:label 'Environmental Conditions' ;
    rdfs:comment 'Description of environmental conditions at the location (e.g., \'Indoor Climate Controlled\', \'Outdoor Exposed\', \'Wet Environment\', \'Corrosive Atmosphere\'). Ref: IBM Maximo.' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:floorLevel rdf:type rdf:Property ;
    rdfs:label 'Floor Level' ;
    rdfs:comment 'Floor or level number within a building (e.g., 1 for ground floor, 2 for second floor, -1 for basement). Ref: IBM Maximo.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:hazardClassification rdf:type rdf:Property ;
    rdfs:label 'Hazard Classification' ;
    rdfs:comment 'Safety hazard classification for the location (e.g., \'Confined Space\', \'High Voltage\', \'Chemical Storage\', \'None\'). Ref: IBM Maximo.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:locationStatus rdf:type rdf:Property ;
    rdfs:label 'Location Status' ;
    rdfs:comment 'Current operational status of the location in its lifecycle. Ref: IBM Maximo.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:locationType rdf:type rdf:Property ;
    rdfs:label 'Location Type' ;
    rdfs:comment 'Classification of the location type within the asset hierarchy. Ref: IBM Maximo.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:roomNumber rdf:type rdf:Property ;
    rdfs:label 'Room Number' ;
    rdfs:comment 'Room or space identifier within a floor or building (e.g., \'Room 101\', \'Electrical Vault A\'). Ref: IBM Maximo.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sapFunctionalLocation rdf:type rdf:Property ;
    rdfs:label 'Sap Functional Location' ;
    rdfs:comment 'SAP PM functional location code for asset hierarchy and maintenance planning integration. Ref: IBM Maximo.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scadaIntegrationFlag rdf:type rdf:Property ;
    rdfs:label 'Scada Integration Flag' ;
    rdfs:comment 'Indicates whether the location is integrated with SCADA systems (OSIsoft PI Historian) for real-time monitoring and control.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:serviceTerritory rdf:type rdf:Property ;
    rdfs:label 'Service Territory' ;
    rdfs:comment 'Service territory or jurisdiction code defining the geographic area served by the utility. Ref: IBM Maximo.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:spatialReferenceCode rdf:type rdf:Property ;
    rdfs:label 'Spatial Reference Code' ;
    rdfs:comment 'Coordinate system reference identifier (EPSG code) used for GIS spatial data (e.g., \'EPSG:4326\' for WGS 84). Ref: IBM Maximo.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vibeAddedFlag rdf:type rdf:Property ;
    rdfs:label 'Vibe Added Flag' ;
    rdfs:comment 'The vibe added flag value recorded for each location in the asset domain.' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:watershed rdf:type rdf:Property ;
    rdfs:label 'Watershed' ;
    rdfs:comment 'Watershed or drainage basin identifier for regulatory reporting and environmental compliance under the Clean Water Act (CWA). Ref: IBM Maximo.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gisLocationId rdf:type rdf:Property ;
    rdfs:label 'Gis Location Id' ;
    rdfs:comment 'Reference to the asset location in the Geographic Information System (GIS), enabling spatial analysis and mapping of condition assessment results. Ref: IBM Maximo.' ;
    rdfs:domain ind:ConditionAssessment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Location .

ind:primaryConditionAssetRegistryId rdf:type rdf:Property ;
    rdfs:label 'Primary Condition Asset Registry Id' ;
    rdfs:comment 'Reference to the infrastructure asset being assessed (pipe, pump, valve, treatment equipment, vehicle, etc.). Ref: IBM Maximo.' ;
    rdfs:domain ind:ConditionAssessment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Registry .

ind:approvedDate rdf:type rdf:Property ;
    rdfs:label 'Approved Date' ;
    rdfs:comment 'Date when the assessment was formally approved by management. Ref: IBM Maximo.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:assessmentDate rdf:type rdf:Property ;
    rdfs:label 'Assessment Date' ;
    rdfs:comment 'The date on which the condition assessment was performed in the field. Ref: IBM Maximo.' ;
    rdfs:domain ind:ConditionAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:assessmentIntervalMonths rdf:type rdf:Property ;
    rdfs:label 'Assessment Interval Months' ;
    rdfs:comment 'Standard inspection frequency interval in months for this asset type and condition grade. Ref: IBM Maximo.' ;
    rdfs:domain ind:ConditionAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:assessmentMethod rdf:type rdf:Property ;
    rdfs:label 'Assessment Method' ;
    rdfs:comment 'The inspection or testing method used to assess asset condition. Common methods include visual inspection, Closed-Circuit Television (CCTV) for pipes, acoustic leak detection, vibration analysis for rotating equipment, ultrasonic thickness measurement for corrosion, infrared thermography for electrical systems, and various hydraulic testing methods. [ENUM-REF-CANDIDATE: visual|cctv|acoustic|vibration_analysis|ultrasonic_thickness|infrared_thermography|dye_testing|smoke_testing|pressure_testing|flow_testing|electrical_testing|corrosion_survey — 12 candidates stripped; promote to reference product]. Ref: IBM Maximo.' ;
    rdfs:domain ind:ConditionAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assessmentNumber rdf:type rdf:Property ;
    rdfs:label 'Assessment Number' ;
    rdfs:comment 'Business identifier for the condition assessment, typically generated by the Computerized Maintenance Management System (CMMS) or inspection system. Ref: IBM Maximo.' ;
    rdfs:domain ind:ConditionAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assessmentStatus rdf:type rdf:Property ;
    rdfs:label 'Assessment Status' ;
    rdfs:comment 'Current workflow status of the condition assessment record: scheduled, in progress, completed (field work done), reviewed (technical review complete), approved (management sign-off), or cancelled. Ref: IBM Maximo.' ;
    rdfs:domain ind:ConditionAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assessmentTimestamp rdf:type rdf:Property ;
    rdfs:label 'Assessment Timestamp' ;
    rdfs:comment 'Precise date and time when the condition assessment was completed, including time zone information. Ref: IBM Maximo.' ;
    rdfs:domain ind:ConditionAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:assessmentType rdf:type rdf:Property ;
    rdfs:label 'Assessment Type' ;
    rdfs:comment 'Classification of the assessment purpose: routine scheduled inspection, preventive maintenance assessment, reactive inspection following an incident, condition-based monitoring, regulatory compliance inspection, pre-failure investigation, post-repair verification, or new asset commissioning. [ENUM-REF-CANDIDATE: routine|preventive|reactive|condition_based|regulatory|pre_failure|post_repair|commissioning — 8 candidates stripped; promote to reference product]. Ref: IBM Maximo.' ;
    rdfs:domain ind:ConditionAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:criticalDefectCount rdf:type rdf:Property ;
    rdfs:label 'Critical Defect Count' ;
    rdfs:comment 'Number of critical or high-severity defects requiring immediate attention or corrective action. Ref: IBM Maximo.' ;
    rdfs:domain ind:ConditionAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:defectCount rdf:type rdf:Property ;
    rdfs:label 'Defect Count' ;
    rdfs:comment 'Total number of defects, anomalies, or non-conformances identified during the condition assessment. Ref: IBM Maximo.' ;
    rdfs:domain ind:ConditionAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:defectDescription rdf:type rdf:Property ;
    rdfs:label 'Defect Description' ;
    rdfs:comment 'Detailed narrative description of defects, damage, deterioration, or performance issues observed during the assessment. Ref: IBM Maximo.' ;
    rdfs:domain ind:ConditionAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedRepairCost rdf:type rdf:Property ;
    rdfs:label 'Estimated Repair Cost' ;
    rdfs:comment 'Preliminary cost estimate for recommended repair or rehabilitation work, used for Capital Expenditure (CAPEX) and Operating Expenditure (OPEX) planning. Ref: IBM Maximo.' ;
    rdfs:domain ind:ConditionAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:estimatedReplacementCost rdf:type rdf:Property ;
    rdfs:label 'Estimated Replacement Cost' ;
    rdfs:comment 'Estimated cost to fully replace the asset with equivalent new equipment or infrastructure. Ref: IBM Maximo.' ;
    rdfs:domain ind:ConditionAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:failureProbability rdf:type rdf:Property ;
    rdfs:label 'Failure Probability' ;
    rdfs:comment 'Statistical probability (0.0000 to 1.0000) of asset failure within the next planning period, calculated from condition data, age, and historical failure rates. Ref: IBM Maximo.' ;
    rdfs:domain ind:ConditionAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:inspectionEquipmentUsed rdf:type rdf:Property ;
    rdfs:label 'Inspection Equipment Used' ;
    rdfs:comment 'Description of specialized equipment, instruments, or tools used during the assessment (e.g., CCTV crawler, ultrasonic thickness gauge, vibration analyzer, acoustic leak detector). Ref: IBM Maximo.' ;
    rdfs:domain ind:ConditionAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectorCertification rdf:type rdf:Property ;
    rdfs:label 'Inspector Certification' ;
    rdfs:comment 'Professional certifications held by the inspector relevant to the assessment method (e.g., NASSCO PACP/MACP/LACP for pipeline inspection, ASNT Level II for ultrasonic testing, thermography certification). Ref: IBM Maximo.' ;
    rdfs:domain ind:ConditionAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectorName rdf:type rdf:Property ;
    rdfs:label 'Inspector Name' ;
    rdfs:comment 'Full name of the inspector or technician who conducted the assessment. Ref: IBM Maximo.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextAssessmentDueDate rdf:type rdf:Property ;
    rdfs:label 'Next Assessment Due Date' ;
    rdfs:comment 'Scheduled date for the next condition assessment based on asset criticality, condition grade, and inspection frequency requirements. Ref: IBM Maximo.' ;
    rdfs:domain ind:ConditionAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:performanceScore rdf:type rdf:Property ;
    rdfs:label 'Performance Score' ;
    rdfs:comment 'Quantitative score (0-100 scale) representing the operational performance and efficiency of the asset relative to design specifications. Ref: IBM Maximo.' ;
    rdfs:domain ind:ConditionAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recommendedAction rdf:type rdf:Property ;
    rdfs:label 'Recommended Action' ;
    rdfs:comment 'Recommended intervention strategy based on assessment findings: continue monitoring, schedule repair, plan rehabilitation, schedule replacement, no action required, or emergency repair needed. Ref: IBM Maximo.' ;
    rdfs:domain ind:ConditionAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recommendedActionPriority rdf:type rdf:Property ;
    rdfs:label 'Recommended Action Priority' ;
    rdfs:comment 'Priority level for the recommended intervention: immediate (0-30 days), urgent (1-6 months), high (6-12 months), medium (1-3 years), low (3+ years). Ref: IBM Maximo.' ;
    rdfs:domain ind:ConditionAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remainingUsefulLifeYears rdf:type rdf:Property ;
    rdfs:label 'Remaining Useful Life Years' ;
    rdfs:comment 'Estimated number of years the asset can continue to operate before requiring major rehabilitation or replacement, based on current condition and deterioration rate. Ref: IBM Maximo.' ;
    rdfs:domain ind:ConditionAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reviewedDate rdf:type rdf:Property ;
    rdfs:label 'Reviewed Date' ;
    rdfs:comment 'Date when the assessment was reviewed and validated by a supervisor or subject matter expert.' ;
    rdfs:domain ind:ConditionAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:riskScore rdf:type rdf:Property ;
    rdfs:label 'Risk Score' ;
    rdfs:comment 'Composite risk score calculated as the product of failure probability and consequence of failure, used to prioritize asset renewal and Capital Improvement Program (CIP) planning. Ref: IBM Maximo.' ;
    rdfs:domain ind:ConditionAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:structuralIntegrityScore rdf:type rdf:Property ;
    rdfs:label 'Structural Integrity Score' ;
    rdfs:comment 'Quantitative score (0-100 scale) representing the structural soundness of the asset based on inspection findings. Higher scores indicate better structural condition. Ref: IBM Maximo.' ;
    rdfs:domain ind:ConditionAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:clearanceAnalyticalResultId rdf:type rdf:Property ;
    rdfs:label 'Clearance Analytical Result Id' ;
    rdfs:comment 'Foreign key linking to quality.analytical_result. Business justification: Return-to-service protocols require analytical results confirming water quality clearance before restoring service after pipe repair or maintenance. Role-prefix \'clearance_\' distinguishes this from th' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AnalyticalResult .

ind:enforcementActionId rdf:type rdf:Property ;
    rdfs:label 'Enforcement Action Id' ;
    rdfs:comment 'Foreign key linking to compliance.enforcement_action. Business justification: Enforcement actions (consent orders, administrative orders) mandate specific remediation work with deadlines. Work orders must reference enforcement actions to track compliance schedule milestones, re. Ref: IBM Maximo.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EnforcementAction .

ind:primaryWorkAssetRegistryId rdf:type rdf:Property ;
    rdfs:label 'Primary Work Asset Registry Id' ;
    rdfs:comment 'Reference to the physical asset (pipe, pump, valve, treatment equipment, vehicle) that is the subject of this work order. Ref: IBM Maximo.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Registry .

ind:actualCost rdf:type rdf:Property ;
    rdfs:label 'Actual Cost' ;
    rdfs:comment 'Total actual cost incurred for the work order, including labor, materials, contractor services, and overhead allocations. Ref: IBM Maximo.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:actualFinishTimestamp rdf:type rdf:Property ;
    rdfs:label 'Actual Finish Timestamp' ;
    rdfs:comment 'Actual date and time when work execution was completed in the field. Ref: IBM Maximo.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:actualLaborHours rdf:type rdf:Property ;
    rdfs:label 'Actual Labor Hours' ;
    rdfs:comment 'Total labor hours actually expended on the work order, captured from time sheets and labor transactions. Ref: IBM Maximo.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:actualStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Actual Start Timestamp' ;
    rdfs:comment 'Actual date and time when work execution began in the field. Ref: IBM Maximo.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:assignedTo rdf:type rdf:Property ;
    rdfs:label 'Assigned To' ;
    rdfs:comment 'Name or identifier of the technician, crew, or contractor assigned to execute the work order. Ref: IBM Maximo.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:completionNotes rdf:type rdf:Property ;
    rdfs:label 'Completion Notes' ;
    rdfs:comment 'Detailed narrative entered by the technician upon work completion, documenting findings, actions taken, parts replaced, and any follow-up recommendations. Ref: IBM Maximo.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:downtimeDurationHours rdf:type rdf:Property ;
    rdfs:label 'Downtime Duration Hours' ;
    rdfs:comment 'Total hours the asset was out of service or unavailable due to this maintenance activity, critical for calculating Mean Time Between Failures (MTBF) and Mean Time To Repair (MTTR) Key Performance Indicators (KPIs). Ref: IBM Maximo.' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:estimatedCost rdf:type rdf:Property ;
    rdfs:label 'Estimated Cost' ;
    rdfs:comment 'Planned total cost for the work order including labor, materials, and services, used for budgeting and Capital Expenditure (CAPEX) / Operating Expenditure (OPEX) planning. Ref: IBM Maximo.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:estimatedLaborHours rdf:type rdf:Property ;
    rdfs:label 'Estimated Labor Hours' ;
    rdfs:comment 'Planned total labor hours required to complete the work order, used for resource planning and scheduling. Ref: IBM Maximo.' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:failureCode rdf:type rdf:Property ;
    rdfs:label 'Failure Code' ;
    rdfs:comment 'Standardized code identifying the type of failure or problem that triggered the work order (e.g., leak, blockage, electrical fault, mechanical wear). Ref: IBM Maximo.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:permitRequired rdf:type rdf:Property ;
    rdfs:label 'Permit Required' ;
    rdfs:comment 'Indicates whether regulatory permits (confined space entry, hot work, excavation, discharge) are required before work can commence. Ref: IBM Maximo.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:remedyCode rdf:type rdf:Property ;
    rdfs:label 'Remedy Code' ;
    rdfs:comment 'Standardized code identifying the corrective action taken to resolve the failure (e.g., repair, replace, adjust, clean). Ref: IBM Maximo.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:safetyPlanRequired rdf:type rdf:Property ;
    rdfs:label 'Safety Plan Required' ;
    rdfs:comment 'Indicates whether a formal safety plan, Job Safety Analysis (JSA), or Occupational Safety and Health Administration (OSHA) compliance documentation is required for this work order.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:scheduledFinishDate rdf:type rdf:Property ;
    rdfs:label 'Scheduled Finish Date' ;
    rdfs:comment 'Planned date when work is scheduled to be completed. Ref: IBM Maximo.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:scheduledStartDate rdf:type rdf:Property ;
    rdfs:label 'Scheduled Start Date' ;
    rdfs:comment 'Planned date when work is scheduled to begin. Ref: IBM Maximo.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:source rdf:type rdf:Property ;
    rdfs:label 'Source' ;
    rdfs:comment 'Origin or trigger that created the work order (preventive maintenance schedule, Supervisory Control and Data Acquisition (SCADA) alarm, customer complaint, inspection finding, operator observation, predictive analytics model, regulatory mandate). [ENUM-REF-CANDIDATE: pm_schedule|scada_alarm|customer_complaint|inspection|operator_round|predictive_analytics|regulatory_requirement — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supervisorApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Supervisor Approval Date' ;
    rdfs:comment 'Date when the work order was reviewed and approved by the maintenance supervisor or manager.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:warrantyClaim rdf:type rdf:Property ;
    rdfs:label 'Warranty Claim' ;
    rdfs:comment 'Indicates whether this work order is associated with a warranty claim against a vendor or contractor for defective equipment or workmanship. Ref: IBM Maximo.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:workOrderNumber rdf:type rdf:Property ;
    rdfs:label 'Work Order Number' ;
    rdfs:comment 'Externally visible business identifier for the work order, typically human-readable and used in field operations and reporting. Ref: IBM Maximo.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workOrderStatus rdf:type rdf:Property ;
    rdfs:label 'Work Order Status' ;
    rdfs:comment 'Current lifecycle status of the work order in the maintenance workflow, from creation through completion and closure. [ENUM-REF-CANDIDATE: draft|approved|scheduled|in_progress|on_hold|completed|closed|cancelled — 8 candidates stripped; promote to reference product]. Ref: IBM Maximo.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workOrderType rdf:type rdf:Property ;
    rdfs:label 'Work Order Type' ;
    rdfs:comment 'Classification of the work order by maintenance strategy: preventive maintenance (PM), corrective maintenance (CM), predictive maintenance (PdM), emergency, inspection, calibration, or capital project work. [ENUM-REF-CANDIDATE: preventive_maintenance|corrective_maintenance|predictive_maintenance|emergency|inspection|calibration|project — 7 candidates stripped; promote to reference product]. Ref: IBM Maximo.' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:autoGenerateWorkOrderFlag rdf:type rdf:Property ;
    rdfs:label 'Auto Generate Work Order Flag' ;
    rdfs:comment 'Indicates whether work orders should be automatically generated by the CMMS system when the schedule becomes due, or whether manual review and approval is required before work order creation. Ref: IBM Maximo.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:downtimeRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Downtime Required Flag' ;
    rdfs:comment 'Indicates whether the asset must be taken out of service (downtime) to perform the preventive maintenance task, requiring operational planning and backup capacity arrangements. Ref: IBM Maximo.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:estimatedDowntimeHours rdf:type rdf:Property ;
    rdfs:label 'Estimated Downtime Hours' ;
    rdfs:comment 'Estimated duration in hours that the asset will be out of service during preventive maintenance, used for operational planning and redundancy management. Ref: IBM Maximo.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:estimatedLaborCost rdf:type rdf:Property ;
    rdfs:label 'Estimated Labor Cost' ;
    rdfs:comment 'Estimated cost of labor required to complete the preventive maintenance task based on estimated hours and labor rates, used for budgeting and OPEX planning. Ref: IBM Maximo.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:estimatedMaterialCost rdf:type rdf:Property ;
    rdfs:label 'Estimated Material Cost' ;
    rdfs:comment 'Estimated cost of materials, parts, and consumables required to complete the preventive maintenance task, used for budgeting and OPEX planning. Ref: IBM Maximo.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:frequencyInterval rdf:type rdf:Property ;
    rdfs:label 'Frequency Interval' ;
    rdfs:comment 'Numeric value representing the interval between preventive maintenance occurrences, interpreted based on the frequency unit (e.g., 30 for days, 500 for hours, 1000 for gallons). Ref: IBM Maximo.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:frequencyUnit rdf:type rdf:Property ;
    rdfs:label 'Frequency Unit' ;
    rdfs:comment 'Unit of measure for the frequency interval, defining whether the schedule is based on time periods (days, weeks, months, years), operating hours, operational cycles, or volume processed (gallons, cubic meters). [ENUM-REF-CANDIDATE: days|weeks|months|years|hours|cycles|gallons|cubic_meters — 8 candidates stripped; promote to reference product]. Ref: IBM Maximo.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastModifiedBy rdf:type rdf:Property ;
    rdfs:label 'Last Modified By' ;
    rdfs:comment 'Username or identifier of the user who last modified this preventive maintenance schedule record. Ref: IBM Maximo.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastPerformedDate rdf:type rdf:Property ;
    rdfs:label 'Last Performed Date' ;
    rdfs:comment 'Date when the preventive maintenance task was last completed, used to calculate the next due date for calendar-based schedules. Ref: IBM Maximo.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:leadTimeDays rdf:type rdf:Property ;
    rdfs:label 'Lead Time Days' ;
    rdfs:comment 'Number of days before the next due date that the work order should be generated to allow for planning, scheduling, and resource allocation. Ref: IBM Maximo.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:maintenanceTaskDescription rdf:type rdf:Property ;
    rdfs:label 'Maintenance Task Description' ;
    rdfs:comment 'Detailed description of the preventive maintenance task to be performed, including specific procedures, inspections, or servicing activities required. Ref: IBM Maximo.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:meterThreshold rdf:type rdf:Property ;
    rdfs:label 'Meter Threshold' ;
    rdfs:comment 'Threshold value for meter-based preventive maintenance triggers; when the asset meter reading reaches or exceeds this value, a work order is automatically generated. Ref: IBM Maximo.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nextDueDate rdf:type rdf:Property ;
    rdfs:label 'Next Due Date' ;
    rdfs:comment 'Calculated date when the next preventive maintenance work order should be generated based on the schedule frequency and last performed date. Ref: IBM Maximo.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:requiredSkillCertifications rdf:type rdf:Property ;
    rdfs:label 'Required Skill Certifications' ;
    rdfs:comment 'Comma-separated list of required skill certifications or qualifications that technicians must possess to perform this preventive maintenance task safely and effectively (e.g., electrical license, confined space entry, SCADA operator certification). Ref: IBM Maximo.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:safetyRequirements rdf:type rdf:Property ;
    rdfs:label 'Safety Requirements' ;
    rdfs:comment 'Description of safety precautions, personal protective equipment (PPE), lockout/tagout procedures, confined space entry protocols, or other safety measures required for this preventive maintenance task. Ref: IBM Maximo.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduleNumber rdf:type rdf:Property ;
    rdfs:label 'Schedule Number' ;
    rdfs:comment 'Business identifier for the preventive maintenance schedule, typically assigned by the CMMS system for tracking and reporting purposes. Ref: IBM Maximo.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduleStatus rdf:type rdf:Property ;
    rdfs:label 'Schedule Status' ;
    rdfs:comment 'Current lifecycle status of the preventive maintenance schedule indicating whether it is actively generating work orders or has been suspended or deactivated. Ref: IBM Maximo.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:seasonalEndMonth rdf:type rdf:Property ;
    rdfs:label 'Seasonal End Month' ;
    rdfs:comment 'Month number (1-12) when seasonal preventive maintenance schedule becomes inactive, applicable only when seasonal_schedule_flag is true. Ref: IBM Maximo.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:seasonalScheduleFlag rdf:type rdf:Property ;
    rdfs:label 'Seasonal Schedule Flag' ;
    rdfs:comment 'Indicates whether this preventive maintenance schedule is seasonal in nature, applicable only during specific months or seasons (e.g., winterization of outdoor equipment, summer peak demand preparation). Ref: IBM Maximo.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:seasonalStartMonth rdf:type rdf:Property ;
    rdfs:label 'Seasonal Start Month' ;
    rdfs:comment 'Month number (1-12) when seasonal preventive maintenance schedule becomes active, applicable only when seasonal_schedule_flag is true. Ref: IBM Maximo.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:triggerType rdf:type rdf:Property ;
    rdfs:label 'Trigger Type' ;
    rdfs:comment 'Type of trigger mechanism that determines when preventive maintenance is due: calendar-based (time intervals), meter-based (usage thresholds), condition-based (sensor readings), runtime-based (operating hours), or cycle-based (number of operations). Ref: IBM Maximo.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workZone rdf:type rdf:Property ;
    rdfs:label 'Work Zone' ;
    rdfs:comment 'Specific work zone, area, or department within the facility where the preventive maintenance activity will take place, used for crew assignment and access control. Ref: IBM Maximo.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:createdBy rdf:type rdf:Property ;
    rdfs:label 'Created By' ;
    rdfs:comment 'Username or identifier of the user who created this preventive maintenance schedule record in the CMMS system. Ref: IBM Maximo.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:failureRecordId rdf:type rdf:Property ;
    rdfs:label 'Failure Record Id' ;
    rdfs:comment 'Unique identifier for the asset failure event record. Primary key. Ref: IBM Maximo.' ;
    rdfs:domain ind:FailureRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:primaryFailureAssetRegistryId rdf:type rdf:Property ;
    rdfs:label 'Primary Failure Asset Registry Id' ;
    rdfs:comment 'Reference to the physical asset that experienced the failure (equipment, pipe, pump, valve, etc.). Ref: IBM Maximo.' ;
    rdfs:domain ind:FailureRecord ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Registry .

ind:actualRepairCost rdf:type rdf:Property ;
    rdfs:label 'Actual Repair Cost' ;
    rdfs:comment 'Actual total cost incurred to repair or replace the failed asset after work completion. Ref: IBM Maximo.' ;
    rdfs:domain ind:FailureRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:affectedSystem rdf:type rdf:Property ;
    rdfs:label 'Affected System' ;
    rdfs:comment 'The operational system or process affected by the failure (e.g., high service pump station, chlorination system, SCADA network, distribution main). Ref: IBM Maximo.' ;
    rdfs:domain ind:FailureRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:correctiveActionsRecommended rdf:type rdf:Property ;
    rdfs:label 'Corrective Actions Recommended' ;
    rdfs:comment 'List of recommended corrective and preventive actions to prevent recurrence of similar failures. Ref: IBM Maximo.' ;
    rdfs:domain ind:FailureRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:csoEventFlag rdf:type rdf:Property ;
    rdfs:label 'Cso Event Flag' ;
    rdfs:comment 'Boolean flag indicating whether the failure resulted in a Combined Sewer Overflow event requiring regulatory reporting. Ref: IBM Maximo.' ;
    rdfs:domain ind:FailureRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:detectionMethod rdf:type rdf:Property ;
    rdfs:label 'Detection Method' ;
    rdfs:comment 'Method by which the failure was discovered (SCADA alarm, operator inspection, customer complaint, etc.). [ENUM-REF-CANDIDATE: scada_alarm|operator_inspection|customer_complaint|scheduled_inspection|predictive_maintenance|routine_testing|emergency_response — 7 candidates stripped; promote to reference product]. Ref: IBM Maximo.' ;
    rdfs:domain ind:FailureRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:emergencyResponseActions rdf:type rdf:Property ;
    rdfs:label 'Emergency Response Actions' ;
    rdfs:comment 'Detailed description of immediate emergency response actions taken to mitigate the failure (e.g., valve isolation, backup system activation, customer notification).' ;
    rdfs:domain ind:FailureRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:environmentalImpactDescription rdf:type rdf:Property ;
    rdfs:label 'Environmental Impact Description' ;
    rdfs:comment 'Description of any environmental impact resulting from the failure (e.g., water body contamination, soil contamination, habitat damage). Ref: IBM Maximo.' ;
    rdfs:domain ind:FailureRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:failureCause rdf:type rdf:Property ;
    rdfs:label 'Failure Cause' ;
    rdfs:comment 'Identified root cause of the failure (e.g., age-related deterioration, improper installation, inadequate maintenance, design deficiency, operational error, external damage). Ref: IBM Maximo.' ;
    rdfs:domain ind:FailureRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:failureCriticalityScore rdf:type rdf:Property ;
    rdfs:label 'Failure Criticality Score' ;
    rdfs:comment 'Calculated criticality score based on failure severity, service impact, and asset importance (typically 1-100 scale). Ref: IBM Maximo.' ;
    rdfs:domain ind:FailureRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:failureDate rdf:type rdf:Property ;
    rdfs:label 'Failure Date' ;
    rdfs:comment 'Calendar date when the asset failure occurred. Ref: IBM Maximo.' ;
    rdfs:domain ind:FailureRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:failureEffect rdf:type rdf:Property ;
    rdfs:label 'Failure Effect' ;
    rdfs:comment 'Description of the operational impact and consequences of the failure on system performance and service delivery. Ref: IBM Maximo.' ;
    rdfs:domain ind:FailureRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:failureMode rdf:type rdf:Property ;
    rdfs:label 'Failure Mode' ;
    rdfs:comment 'Classification of how the asset failed (e.g., mechanical fracture, electrical short, corrosion perforation, seal leakage, bearing seizure, control malfunction). Ref: IBM Maximo.' ;
    rdfs:domain ind:FailureRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:failureNumber rdf:type rdf:Property ;
    rdfs:label 'Failure Number' ;
    rdfs:comment 'Business-readable unique identifier for the failure event, typically auto-generated by CMMS. Ref: IBM Maximo.' ;
    rdfs:domain ind:FailureRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:failureSeverity rdf:type rdf:Property ;
    rdfs:label 'Failure Severity' ;
    rdfs:comment 'Severity classification of the failure based on service impact, safety risk, and regulatory implications. Ref: IBM Maximo.' ;
    rdfs:domain ind:FailureRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:failureStatus rdf:type rdf:Property ;
    rdfs:label 'Failure Status' ;
    rdfs:comment 'Current lifecycle status of the failure record in the investigation and resolution workflow. Ref: IBM Maximo.' ;
    rdfs:domain ind:FailureRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:failureTime rdf:type rdf:Property ;
    rdfs:label 'Failure Time' ;
    rdfs:comment 'Precise date and time when the asset failure was detected or occurred. Ref: IBM Maximo.' ;
    rdfs:domain ind:FailureRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:mtbfImpactFlag rdf:type rdf:Property ;
    rdfs:label 'Mtbf Impact Flag' ;
    rdfs:comment 'Boolean flag indicating whether this failure event should be included in MTBF reliability calculations for the asset class. Ref: IBM Maximo.' ;
    rdfs:domain ind:FailureRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mttrHours rdf:type rdf:Property ;
    rdfs:label 'Mttr Hours' ;
    rdfs:comment 'Measured time in hours from failure detection to restoration of asset to full operational status. Ref: IBM Maximo.' ;
    rdfs:domain ind:FailureRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:overflowVolumeGallons rdf:type rdf:Property ;
    rdfs:label 'Overflow Volume Gallons' ;
    rdfs:comment 'Estimated volume of wastewater overflow in gallons resulting from SSO or CSO event, if applicable. Ref: IBM Maximo.' ;
    rdfs:domain ind:FailureRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pressureDropPsi rdf:type rdf:Property ;
    rdfs:label 'Pressure Drop Psi' ;
    rdfs:comment 'Measured drop in system pressure (PSI) resulting from the failure event. Ref: IBM Maximo.' ;
    rdfs:domain ind:FailureRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:productionLossMgd rdf:type rdf:Property ;
    rdfs:label 'Production Loss Mgd' ;
    rdfs:comment 'Estimated water production capacity lost due to the failure, measured in Million Gallons per Day. Ref: IBM Maximo.' ;
    rdfs:domain ind:FailureRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatoryNotificationDate rdf:type rdf:Property ;
    rdfs:label 'Regulatory Notification Date' ;
    rdfs:comment 'Date when regulatory agencies were notified of the failure event, if applicable. Ref: IBM Maximo.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryNotificationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Notification Required Flag' ;
    rdfs:comment 'Boolean flag indicating whether the failure event requires notification to regulatory agencies (EPA, state primacy agency). Ref: IBM Maximo.' ;
    rdfs:domain ind:FailureRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:repairCostEstimate rdf:type rdf:Property ;
    rdfs:label 'Repair Cost Estimate' ;
    rdfs:comment 'Estimated total cost to repair or replace the failed asset, including labor, materials, and contractor costs. Ref: IBM Maximo.' ;
    rdfs:domain ind:FailureRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rootCauseAnalysisCompletedFlag rdf:type rdf:Property ;
    rdfs:label 'Root Cause Analysis Completed Flag' ;
    rdfs:comment 'Boolean flag indicating whether a formal root cause analysis (RCA) has been completed for this failure event. Ref: IBM Maximo.' ;
    rdfs:domain ind:FailureRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rootCauseAnalysisFindings rdf:type rdf:Property ;
    rdfs:label 'Root Cause Analysis Findings' ;
    rdfs:comment 'Detailed findings and conclusions from the root cause analysis investigation, including contributing factors and systemic issues identified. Ref: IBM Maximo.' ;
    rdfs:domain ind:FailureRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:serviceInterruptionFlag rdf:type rdf:Property ;
    rdfs:label 'Service Interruption Flag' ;
    rdfs:comment 'Boolean flag indicating whether the failure resulted in a complete service interruption to customers. Ref: IBM Maximo.' ;
    rdfs:domain ind:FailureRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ssoEventFlag rdf:type rdf:Property ;
    rdfs:label 'Sso Event Flag' ;
    rdfs:comment 'Boolean flag indicating whether the failure resulted in a Sanitary Sewer Overflow event requiring regulatory reporting. Ref: IBM Maximo.' ;
    rdfs:domain ind:FailureRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:warrantyClaimFlag rdf:type rdf:Property ;
    rdfs:label 'Warranty Claim Flag' ;
    rdfs:comment 'Boolean flag indicating whether the failure is covered under manufacturer or contractor warranty and a claim was filed. Ref: IBM Maximo.' ;
    rdfs:domain ind:FailureRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:primaryInspectionAssetRegistryId rdf:type rdf:Property ;
    rdfs:label 'Primary Inspection Asset Registry Id' ;
    rdfs:comment 'Reference to the asset or infrastructure component that was inspected. Ref: IBM Maximo.' ;
    rdfs:domain ind:InspectionEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Registry .

ind:checklistVersion rdf:type rdf:Property ;
    rdfs:label 'Checklist Version' ;
    rdfs:comment 'Version identifier of the inspection checklist used, ensuring traceability to specific regulatory or operational standards. Ref: IBM Maximo.' ;
    rdfs:domain ind:InspectionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:correctiveActionDueDate rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Due Date' ;
    rdfs:comment 'Target date by which identified deficiencies must be remediated, based on regulatory or operational requirements. Ref: IBM Maximo.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:correctiveActionRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Required Flag' ;
    rdfs:comment 'Indicates whether corrective action work orders or follow-up activities are required as a result of this inspection. Ref: IBM Maximo.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:criticalDeficiencyFlag rdf:type rdf:Property ;
