  temperature_control_system varchar [note: 'Type of temperature control']
  temperature_monitoring_interval_minutes varchar [note: 'Monitoring frequency in minutes']
  third_party_logistics_flag boolean [note: 'Whether operated by 3PL']
  updated_timestamp timestamp [note: 'Record last update timestamp']
