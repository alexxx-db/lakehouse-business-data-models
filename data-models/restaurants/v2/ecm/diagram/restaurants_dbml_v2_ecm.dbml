  receiving_method varchar [note: 'Method of receiving (dock, curbside)']
  temperature_celsius decimal(6,2) [note: 'Temperature at time of receipt']
  temperature_deviation_flag boolean [note: 'Whether temperature was out of spec']
  total_cost decimal(18,2) [note: 'Total cost of received goods']
  total_quantity decimal(18,2) [note: 'Total quantity received']
  updated_timestamp timestamp [note: 'Record last update timestamp']

  Note: 'Header record for receiving goods against a purchase order at a restaurant or distribution center.'
}

Table supply.goods_receipt_line {
  goods_receipt_line_id varchar [pk, note: 'Primary key']
  employee_id varchar [note: 'FK to receiving employee']
  gl_account_id varchar [note: 'FK to GL account for posting']
  goods_receipt_id varchar [note: 'FK to parent goods receipt']
