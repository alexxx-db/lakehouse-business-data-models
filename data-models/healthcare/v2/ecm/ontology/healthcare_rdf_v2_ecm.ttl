    rdfs:comment 'Provider affiliations' .

ind:PreferenceCard rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Provider ;
    rdfs:label 'Preference Card' ;
    rdfs:comment 'Surgeon preference cards' .

ind:SurveyParticipation rdf:type rdfs:Class ;
