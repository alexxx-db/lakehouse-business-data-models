    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mitigationStrategy rdf:type rdf:Property ;
    rdfs:label 'Mitigation Strategy' ;
    rdfs:comment 'Mitigation approach' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pathwayDescription rdf:type rdf:Property ;
    rdfs:label 'Pathway Description' ;
    rdfs:comment 'Narrative description of the risk pathway from source through exposure to receptor.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:probabilityRating rdf:type rdf:Property ;
    rdfs:label 'Probability Rating' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:probabilityScore rdf:type rdf:Property ;
    rdfs:label 'Probability Score' ;
    rdfs:comment 'Probability 0-1' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:receptorCode rdf:type rdf:Property ;
    rdfs:label 'Receptor Code' ;
    rdfs:comment 'FK to receptor identifying the population or ecological entity at risk.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:receptorPopulation rdf:type rdf:Property ;
    rdfs:label 'Receptor Population' ;
    rdfs:comment 'Affected receptor population (general_public, sensitive_subpopulation, aquatic_ecosystem). Supports ontology receptor concepts.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:receptorPopulationAtRisk rdf:type rdf:Property ;
    rdfs:label 'Receptor Population At Risk' ;
    rdfs:comment 'Estimated population at risk from this project risk.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:receptorType rdf:type rdf:Property ;
    rdfs:label 'Receptor Type' ;
    rdfs:comment 'Type of receptor at risk (human_population, aquatic_ecosystem, terrestrial_ecosystem, groundwater_resource) per ontology enumeration.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:residualImpactRating rdf:type rdf:Property ;
    rdfs:label 'Residual Impact Rating' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:residualProbabilityRating rdf:type rdf:Property ;
    rdfs:label 'Residual Probability Rating' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responseStrategy rdf:type rdf:Property ;
    rdfs:label 'Response Strategy' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:riskDescription rdf:type rdf:Property ;
    rdfs:label 'Risk Description' ;
    rdfs:comment 'Detailed risk description' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskNumber rdf:type rdf:Property ;
    rdfs:label 'Risk Number' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskStatus rdf:type rdf:Property ;
    rdfs:label 'Risk Status' ;
    rdfs:comment 'Open, mitigated, closed, realized' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:treatmentTechnologyMitigation rdf:type rdf:Property ;
    rdfs:label 'Treatment Technology Mitigation' ;
    rdfs:comment 'Treatment technology for risk mitigation (GAC, ion_exchange, membrane, UV)' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:treatmentTechnologyResponse rdf:type rdf:Property ;
    rdfs:label 'Treatment Technology Response' ;
    rdfs:comment 'Recommended treatment technology response (GAC, ion_exchange, membrane, UV_AOP). Links risk to treatment technology ontology class.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:triggeredFlag rdf:type rdf:Property ;
    rdfs:label 'Triggered Flag' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:issueId rdf:type rdf:Property ;
    rdfs:label 'Issue Id' ;
    rdfs:comment 'Unique identifier for the project issue record. Primary key.' ;
    rdfs:domain ind:Issue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:issueAssignedToEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Issue Assigned To Employee Id' ;
    rdfs:domain ind:Issue ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:issueContractorVendorId rdf:type rdf:Property ;
    rdfs:label 'Issue Contractor Vendor Id' ;
    rdfs:comment 'Reference to the contractor involved in or responsible for the issue, if applicable. Null if issue does not involve a contractor.' ;
    rdfs:domain ind:Issue ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Vendor .

ind:issueIdentifiedByEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Issue Identified By Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: Issue identifiers are project team employees. Tracking who identified issues is essential for lessons learned, quality improvement, and employee performance reviews. Standard project management practi' ;
    rdfs:domain ind:Issue ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:issueRequestForInformationId rdf:type rdf:Property ;
    rdfs:label 'Issue Request For Information Id' ;
    rdfs:comment 'Reference to the RFI that preceded or is associated with this issue, if applicable. Null if no RFI relationship exists.' ;
    rdfs:domain ind:Issue ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RequestForInformation .

ind:issueRfiRequestForInformationId rdf:type rdf:Property ;
    rdfs:label 'Issue Rfi Request For Information Id' ;
    rdfs:comment 'Reference to the RFI that preceded or is associated with this issue, if applicable. Null if no RFI relationship exists.' ;
    rdfs:domain ind:Issue ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RequestForInformation .

ind:issueVendorId rdf:type rdf:Property ;
    rdfs:label 'Issue Vendor Id' ;
    rdfs:comment 'Reference to the contractor involved in or responsible for the issue, if applicable. Null if issue does not involve a contractor.' ;
    rdfs:domain ind:Issue ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Vendor .

ind:primaryIssueChangeOrderId rdf:type rdf:Property ;
    rdfs:label 'Primary Issue Change Order Id' ;
    rdfs:comment 'Reference to the change order generated as a result of this issue, if applicable. Null if no change order was required.' ;
    rdfs:domain ind:Issue ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ChangeOrder .

ind:relatedRiskId rdf:type rdf:Property ;
    rdfs:label 'Related Risk Id' ;
    rdfs:domain ind:Issue ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Risk .

ind:assetClassAffected rdf:type rdf:Property ;
    rdfs:label 'Asset Class Affected' ;
    rdfs:comment 'Type of infrastructure asset impacted by the issue (e.g., water main, pump, valve, treatment equipment, SCADA system). Used for asset management integration and maintenance planning.' ;
    rdfs:domain ind:Issue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignedResolver rdf:type rdf:Property ;
    rdfs:label 'Assigned Resolver' ;
    rdfs:comment 'Name or identifier of the individual or team responsible for investigating and resolving the issue. May be reassigned during escalation.' ;
    rdfs:domain ind:Issue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:issueCategory rdf:type rdf:Property ;
    rdfs:label 'Issue Category' ;
    rdfs:domain ind:Issue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dateIdentified rdf:type rdf:Property ;
    rdfs:label 'Date Identified' ;
    rdfs:comment 'Calendar date when the issue was first discovered or reported. Distinct from when the issue record was created in the system.' ;
    rdfs:domain ind:Issue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:escalatedFlag rdf:type rdf:Property ;
    rdfs:label 'Escalated Flag' ;
    rdfs:domain ind:Issue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:issueDescription rdf:type rdf:Property ;
    rdfs:label 'Issue Description' ;
    rdfs:comment 'Detailed narrative description of the problem, conflict, or decision requiring resolution. Includes context, background, and any relevant technical or operational details.' ;
    rdfs:domain ind:Issue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:issueNumber rdf:type rdf:Property ;
    rdfs:label 'Issue Number' ;
    rdfs:comment 'Business-facing unique issue tracking number assigned sequentially or per project numbering scheme. Used for communication and reference in project documentation.' ;
    rdfs:domain ind:Issue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:issuePriority rdf:type rdf:Property ;
    rdfs:label 'Issue Priority' ;
    rdfs:comment 'Priority.' ;
    rdfs:domain ind:Issue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:issueStatus rdf:type rdf:Property ;
    rdfs:label 'Issue Status' ;
    rdfs:comment 'Current lifecycle state of the issue: open (newly identified), in_progress (actively being worked), pending_approval (awaiting decision or sign-off), resolved (solution implemented), closed (issue finalized and archived), escalated (elevated to higher authority).' ;
    rdfs:domain ind:Issue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:issueTitle rdf:type rdf:Property ;
    rdfs:label 'Issue Title' ;
    rdfs:domain ind:Issue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:issueType rdf:type rdf:Property ;
    rdfs:label 'Issue Type' ;
    rdfs:comment 'Classification of the issue by nature: design conflict (engineering or architectural discrepancy), contractor dispute (disagreement with contractor), permit delay (regulatory approval holdup), utility conflict (interference with existing water/wastewater/other utilities), community complaint (public or stakeholder concern), or regulatory requirement change (new compliance mandate).' ;
    rdfs:domain ind:Issue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:raisedDate rdf:type rdf:Property ;
    rdfs:label 'Raised Date' ;
    rdfs:comment 'Raised date.' ;
    rdfs:domain ind:Issue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:regulatoryImpactFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Impact Flag' ;
    rdfs:comment 'Indicates whether the issue has regulatory or compliance implications (e.g., affects NPDES permit, SDWA compliance, environmental discharge limits). True if regulatory impact exists; false otherwise.' ;
    rdfs:domain ind:Issue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:scopeImpactDescription rdf:type rdf:Property ;
    rdfs:label 'Scope Impact Description' ;
    rdfs:comment 'Narrative description of how the issue affected project scope, including specific deliverables added, removed, or modified.' ;
    rdfs:domain ind:Issue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scopeImpactFlag rdf:type rdf:Property ;
    rdfs:label 'Scope Impact Flag' ;
    rdfs:comment 'Indicates whether the issue resulted in a change to project scope (addition, deletion, or modification of deliverables). True if scope was affected; false otherwise.' ;
    rdfs:domain ind:Issue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:closeoutRecordId rdf:type rdf:Property ;
    rdfs:label 'Closeout Record Id' ;
    rdfs:comment 'Unique identifier for the project closeout record. Primary key.' ;
