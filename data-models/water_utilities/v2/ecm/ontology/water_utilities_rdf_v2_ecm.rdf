    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collectionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Collection Timestamp' ;
    rdfs:comment 'Date and time when the physical sample was collected in the field or at the facility. Critical for regulatory compliance and sample integrity validation.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:compositeIntervalMinutes rdf:type rdf:Property ;
    rdfs:label 'Composite Interval Minutes' ;
