ind:addressLine2 rdf:type rdf:Property ;
    rdfs:label 'Address Line 2' ;
    rdfs:comment 'Secondary address information (building name, floor, department) for the pharmacy location.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:afterHoursPhone rdf:type rdf:Property ;
    rdfs:label 'After Hours Phone' ;
    rdfs:comment 'Telephone number for reaching the practice location or on-call provider outside of regular business hours. Required for continuity of care and NCQA medical home standards.' ;
    rdfs:domain ind:PharmacyLocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appointmentSchedulingUrl rdf:type rdf:Property ;
