    rdfs:range ind:OrBlock .

ind:ownerServiceId rdf:type rdf:Property ;
    rdfs:label 'Owner Service Id' ;
    rdfs:comment 'Identifier of the surgical service or service line that owns the block, if block_owner_type is service.' ;
    rdfs:domain ind:Scheduling ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Service .

ind:targetProcedureCptCodeId rdf:type rdf:Property ;
    rdfs:label 'Target Procedure Cpt Code Id' ;
    rdfs:comment 'Foreign key linking to reference.cpt_code. Business justification: OR blocks allocated by procedure type require CPT reference for duration estimation, equipment planning, anesthesia type determination, and block utilization analysis. Core to perioperative capacity m' ;
    rdfs:domain ind:OrBlock ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CptCode .

ind:allowsOverbooking rdf:type rdf:Property ;
    rdfs:label 'Allows Overbooking' ;
    rdfs:comment 'Indicates whether cases can be scheduled beyond the allocated block end time, allowing for extended use of the OR suite.' ;
    rdfs:domain ind:Scheduling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:allowsSharing rdf:type rdf:Property ;
    rdfs:label 'Allows Sharing' ;
    rdfs:comment 'Indicates whether the block owner permits other surgeons or services to share unused portions of the block time.' ;
    rdfs:domain ind:OrBlock ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:anesthesiaTypeRequired rdf:type rdf:Property ;
    rdfs:label 'Anesthesia Type Required' ;
    rdfs:comment 'Type of anesthesia typically required for cases scheduled in this block (e.g., general, regional, local, MAC). Used for resource planning.' ;
    rdfs:domain ind:OrBlock ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:blockDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Block Duration Minutes' ;
    rdfs:comment 'Total duration of the OR block in minutes, calculated from start to end time.' ;
    rdfs:domain ind:OrBlock ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:blockEndTime rdf:type rdf:Property ;
    rdfs:label 'Block End Time' ;
    rdfs:comment 'Time of day when the OR block ends, in HH:mm format (e.g., 15:30). Represents the scheduled end of the allocated time window.' ;
    rdfs:domain ind:OrBlock ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:blockName rdf:type rdf:Property ;
    rdfs:label 'Block Name' ;
    rdfs:comment 'Descriptive name of the OR block, often including the service or surgeon name for easy identification.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:blockNumber rdf:type rdf:Property ;
    rdfs:label 'Block Number' ;
    rdfs:comment 'Business identifier or code for the OR block allocation, used for scheduling and reporting purposes.' ;
    rdfs:domain ind:OrBlock ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:blockOwnerType rdf:type rdf:Property ;
    rdfs:label 'Block Owner Type' ;
    rdfs:comment 'Type of entity that owns or controls the block time allocation (service line, individual surgeon, specialty, department, or open block).' ;
    rdfs:domain ind:Scheduling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:blockStartTime rdf:type rdf:Property ;
    rdfs:label 'Block Start Time' ;
    rdfs:comment 'Time of day when the OR block begins, in HH:mm format (e.g., 07:30). Represents the scheduled start of the allocated time window.' ;
    rdfs:domain ind:OrBlock ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:blockStatus rdf:type rdf:Property ;
    rdfs:label 'Block Status' ;
    rdfs:comment 'Current operational status of the OR block allocation indicating whether it is available for scheduling.' ;
    rdfs:domain ind:Scheduling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:equipmentSetRequired rdf:type rdf:Property ;
    rdfs:label 'Equipment Set Required' ;
    rdfs:comment 'Standard equipment set or configuration required for cases in this block (e.g., orthopedic, cardiac, robotic). Used for OR setup and resource allocation.' ;
    rdfs:domain ind:OrBlock ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minimumUtilizationThresholdPct rdf:type rdf:Property ;
    rdfs:label 'Minimum Utilization Threshold Pct' ;
    rdfs:comment 'Minimum percentage of block time that must be utilized to maintain the block allocation. Used for performance monitoring and block reallocation decisions.' ;
    rdfs:domain ind:OrBlock ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ownerSpecialtyCode rdf:type rdf:Property ;
    rdfs:label 'Owner Specialty Code' ;
    rdfs:comment 'Code representing the surgical specialty that owns the block, if block_owner_type is specialty.' ;
    rdfs:domain ind:Scheduling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recurringPattern rdf:type rdf:Property ;
    rdfs:label 'Recurring Pattern' ;
    rdfs:comment 'Pattern describing how the block recurs over time (e.g., every week, every other week, first Monday of month). [ENUM-REF-CANDIDATE: weekly|biweekly|monthly|first_week|second_week|third_week|fourth_week|custom — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:OrBlock ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:releaseLeadTimeDays rdf:type rdf:Property ;
    rdfs:label 'Release Lead Time Days' ;
    rdfs:comment 'Number of days before the block date that unused time must be released, if release_rule_type is days_before.' ;
    rdfs:domain ind:OrBlock ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:releaseLeadTimeHours rdf:type rdf:Property ;
    rdfs:label 'Release Lead Time Hours' ;
    rdfs:comment 'Number of hours before the block start time that unused time must be released, if release_rule_type is hours_before.' ;
    rdfs:domain ind:OrBlock ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:releaseRuleType rdf:type rdf:Property ;
    rdfs:label 'Release Rule Type' ;
    rdfs:comment 'Type of rule governing when unused block time is released back to the general pool for other surgeons or services to use.' ;
    rdfs:domain ind:OrBlock ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:orBlockStatus rdf:type rdf:Property ;
    rdfs:label 'Or Block Status' ;
    rdfs:domain ind:OrBlock ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetUtilizationThresholdPct rdf:type rdf:Property ;
    rdfs:label 'Target Utilization Threshold Pct' ;
    rdfs:comment 'Target percentage of block time utilization that the owner is expected to achieve for optimal OR capacity management.' ;
    rdfs:domain ind:OrBlock ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:building rdf:type rdf:Property ;
    rdfs:label 'Building' ;
    rdfs:comment 'Building name or number within the facility where the resource is located. Applicable primarily to room and equipment resources.' ;
    rdfs:domain ind:SchedulableResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:defaultSlotDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Default Slot Duration Minutes' ;
    rdfs:comment 'Standard duration in minutes for a single scheduling slot or appointment block for this resource. Used as the default when creating schedules.' ;
    rdfs:domain ind:SchedulableResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:floor rdf:type rdf:Property ;
    rdfs:label 'Floor' ;
    rdfs:comment 'Floor number or level within the building where the resource is located. Applicable primarily to room and equipment resources.' ;
    rdfs:domain ind:SchedulableResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maintenanceWindowEnd rdf:type rdf:Property ;
    rdfs:label 'Maintenance Window End' ;
    rdfs:comment 'End date and time of scheduled maintenance or downtime window. Applicable primarily to equipment and room resources.' ;
    rdfs:domain ind:SchedulableResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:maintenanceWindowStart rdf:type rdf:Property ;
    rdfs:label 'Maintenance Window Start' ;
    rdfs:comment 'Start date and time of scheduled maintenance or downtime window during which the resource is unavailable for scheduling. Applicable primarily to equipment and room resources.' ;
    rdfs:domain ind:SchedulableResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:minimumTurnoverTimeMinutes rdf:type rdf:Property ;
    rdfs:label 'Minimum Turnover Time Minutes' ;
    rdfs:comment 'Minimum time in minutes required between consecutive appointments or uses of the resource. Includes cleaning, setup, and preparation time. Critical for scheduling optimization and capacity planning.' ;
    rdfs:domain ind:SchedulableResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:resourceCode rdf:type rdf:Property ;
    rdfs:label 'Resource Code' ;
    rdfs:comment 'Unique business identifier or code for the resource. May be an internal system code, asset tag, or room number depending on resource type.' ;
    rdfs:domain ind:SchedulableResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:roomCapacity rdf:type rdf:Property ;
    rdfs:label 'Room Capacity' ;
    rdfs:comment 'Maximum number of patients or occupants that can be accommodated in the room simultaneously. Applicable only to room resources. Null for non-room resources.' ;
    rdfs:domain ind:SchedulableResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:roomConfiguration rdf:type rdf:Property ;
    rdfs:label 'Room Configuration' ;
    rdfs:comment 'Physical configuration or layout of the room (e.g., single-bed, multi-bed, open bay, private suite). Applicable only to room resources.' ;
    rdfs:domain ind:SchedulableResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:schedulingConstraints rdf:type rdf:Property ;
    rdfs:label 'Scheduling Constraints' ;
    rdfs:comment 'Free-text description of any special scheduling rules, restrictions, or constraints that apply to this resource (e.g., only available for specific appointment types, requires advance booking, limited to certain patient populations).' ;
    rdfs:domain ind:SchedulableResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:schedulingStatus rdf:type rdf:Property ;
    rdfs:label 'Scheduling Status' ;
    rdfs:comment 'Current availability status of the resource for scheduling purposes. Active resources are available for scheduling; inactive resources are temporarily unavailable; maintenance resources are undergoing service; reserved resources are held for specific purposes; retired resources are permanently removed from service.' ;
    rdfs:domain ind:SchedulableResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:schedulableResourceStatus rdf:type rdf:Property ;
    rdfs:label 'Schedulable Resource Status' ;
    rdfs:domain ind:SchedulableResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sterilizationCycleRequired rdf:type rdf:Property ;
    rdfs:label 'Sterilization Cycle Required' ;
    rdfs:comment 'Indicates whether the resource requires a sterilization cycle between uses. True if sterilization is required, False otherwise. Applicable primarily to equipment and room resources used in surgical or procedural settings.' ;
    rdfs:domain ind:SchedulableResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sterilizationDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Sterilization Duration Minutes' ;
    rdfs:comment 'Duration in minutes required to complete the sterilization cycle for the resource. Applicable only when sterilization_cycle_required is True.' ;
    rdfs:domain ind:SchedulableResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:unit rdf:type rdf:Property ;
    rdfs:label 'Unit' ;
    rdfs:comment 'Unit, wing, or zone designation within the floor where the resource is located. Applicable primarily to room and equipment resources.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resourceAssignmentId rdf:type rdf:Property ;
    rdfs:label 'Resource Assignment Id' ;
    rdfs:comment 'Unique identifier for the resource assignment record. Primary key for the resource assignment entity.' ;
    rdfs:domain ind:Scheduling ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ResourceAssignment .

ind:primaryResourceEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Resource Employee Id' ;
    rdfs:comment 'Foreign key reference to the staff member (nurse, technician, assistant) assigned to support this appointment or procedure. Populated when resource_type is staff or care_team_member.' ;
    rdfs:domain ind:ResourceAssignment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:substituteForResourceAssignmentId rdf:type rdf:Property ;
    rdfs:label 'Substitute For Resource Assignment Id' ;
    rdfs:comment 'Foreign key reference to another resource assignment that this assignment is substituting for. Used when a resource is replaced due to unavailability, conflict, or last-minute changes.' ;
    rdfs:domain ind:ResourceAssignment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ResourceAssignment .

ind:tertiaryResourceRequestedByUserEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Tertiary Resource Requested By User Employee Id' ;
    rdfs:comment 'Foreign key reference to the user who initially requested or created this resource assignment. Typically a scheduler, care coordinator, or provider.' ;
    rdfs:domain ind:ResourceAssignment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:assignmentPriority rdf:type rdf:Property ;
    rdfs:label 'Assignment Priority' ;
    rdfs:comment 'Priority level for this resource assignment. Determines scheduling precedence and resource allocation urgency, especially critical for Operating Room (OR) and Emergency Department (ED) scheduling.' ;
    rdfs:domain ind:Scheduling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:confirmationDatetime rdf:type rdf:Property ;
    rdfs:label 'Confirmation Datetime' ;
    rdfs:comment 'Date and time when the resource confirmed their assignment. Tracks confirmation lead time and supports compliance with staffing notification requirements.' ;
    rdfs:domain ind:Scheduling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:conflictDescription rdf:type rdf:Property ;
    rdfs:label 'Conflict Description' ;
    rdfs:comment 'Free-text description of the nature of the scheduling conflict, if one exists. Provides context for resolution and audit trail of scheduling issues.' ;
    rdfs:domain ind:Scheduling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conflictFlag rdf:type rdf:Property ;
    rdfs:label 'Conflict Flag' ;
    rdfs:comment 'Boolean indicator of whether this resource assignment has a scheduling conflict with another assignment or unavailability period. Triggers alerts for scheduling coordinators to resolve double-bookings.' ;
    rdfs:domain ind:Scheduling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:credentialingVerificationDatetime rdf:type rdf:Property ;
    rdfs:label 'Credentialing Verification Datetime' ;
    rdfs:comment 'Date and time when credentialing verification was completed for this assignment. Documents compliance with pre-assignment credentialing checks.' ;
    rdfs:domain ind:Scheduling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:equipmentAssetTag rdf:type rdf:Property ;
    rdfs:label 'Equipment Asset Tag' ;
    rdfs:comment 'Physical asset tag or serial number of the specific equipment unit assigned. Enables traceability for maintenance, sterilization, and recall management.' ;
    rdfs:domain ind:Scheduling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:equipmentReservationStatus rdf:type rdf:Property ;
    rdfs:label 'Equipment Reservation Status' ;
    rdfs:comment 'Current status of equipment reservation for this assignment. Tracks equipment lifecycle from initial reservation through active use and return to inventory.' ;
    rdfs:domain ind:ResourceAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastMaintenanceDate rdf:type rdf:Property ;
    rdfs:label 'Last Maintenance Date' ;
    rdfs:comment 'Date of the most recent preventive or corrective maintenance performed on the assigned equipment. Supports compliance with manufacturer and regulatory maintenance schedules.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:maintenanceClearanceFlag rdf:type rdf:Property ;
    rdfs:label 'Maintenance Clearance Flag' ;
    rdfs:comment 'Boolean indicator of whether assigned equipment has passed required maintenance checks and is cleared for clinical use. Ensures equipment safety and regulatory compliance.' ;
    rdfs:domain ind:Scheduling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:privilegeCode rdf:type rdf:Property ;
    rdfs:label 'Privilege Code' ;
    rdfs:comment 'Code representing the specific clinical privilege or authorization required and verified for this assignment. Links to the provider\'s credentialed privileges for the procedure or service type.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestedDatetime rdf:type rdf:Property ;
    rdfs:label 'Requested Datetime' ;
    rdfs:comment 'Date and time when this resource assignment was initially requested or created. Supports lead time analysis and scheduling workflow tracking.' ;
    rdfs:domain ind:Scheduling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:resourceAssignmentStatus rdf:type rdf:Property ;
    rdfs:label 'Resource Assignment Status' ;
    rdfs:domain ind:ResourceAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sterilizationBatchNumber rdf:type rdf:Property ;
    rdfs:label 'Sterilization Batch Number' ;
    rdfs:comment 'Batch or lot number from the sterilization process for assigned equipment. Enables traceability in case of sterilization failures or Healthcare-Associated Infection (HAI) investigations.' ;
    rdfs:domain ind:Scheduling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sterilizationClearanceFlag rdf:type rdf:Property ;
    rdfs:label 'Sterilization Clearance Flag' ;
    rdfs:comment 'Boolean indicator of whether assigned equipment has passed sterilization and is cleared for use. Critical for infection control and patient safety in surgical and procedural settings.' ;
    rdfs:domain ind:Scheduling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:waitlistEntryId rdf:type rdf:Property ;
    rdfs:label 'Waitlist Entry Id' ;
    rdfs:comment 'Unique identifier for the waitlist entry record. Primary key.' ;
    rdfs:domain ind:Scheduling ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:WaitlistEntry .

ind:populationHealthGapId rdf:type rdf:Property ;
    rdfs:label 'Population Health Gap Id' ;
    rdfs:comment 'Foreign key linking to quality.population_health_gap. Business justification: Waitlist management for care gaps is a real workflow—patients with identified HEDIS/Stars gaps are placed on waitlists for appropriate appointments. Care management teams prioritize waitlist outreach ' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PopulationHealthGap .

ind:primaryWaitlistClinicianId rdf:type rdf:Property ;
    rdfs:label 'Primary Waitlist Clinician Id' ;
    rdfs:comment 'Identifier for the specific provider requested by the patient or referring provider. Null if no specific provider preference. Links to provider master data.' ;
    rdfs:domain ind:WaitlistEntry ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:primaryWaitlistRequestedDepartmentWorkforceOrgUnitId rdf:type rdf:Property ;
    rdfs:label 'Primary Waitlist Requested Department Workforce Org Unit Id' ;
    rdfs:comment 'Identifier for the specific department or clinic requested by the patient. Null if no specific department preference. Links to department master data.' ;
    rdfs:domain ind:WaitlistEntry ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:OrgUnit .

ind:requestedAppointmentTypeId rdf:type rdf:Property ;
    rdfs:label 'Requested Appointment Type Id' ;
    rdfs:comment 'Identifier for the type of appointment requested by the patient or ordering provider. Links to appointment type master data.' ;
    rdfs:domain ind:WaitlistEntry ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AppointmentType .

ind:visitReasonIcdCodeId rdf:type rdf:Property ;
    rdfs:label 'Visit Reason Icd Code Id' ;
    rdfs:comment 'Foreign key linking to reference.icd_code. Business justification: Waitlist visit reason ICD codes enable clinical prioritization, authorization requirement determination, specialty matching, and quality measure tracking. Critical for access management and care gap c' ;
    rdfs:domain ind:Scheduling ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:IcdCode .

ind:entryNumber rdf:type rdf:Property ;
    rdfs:label 'Entry Number' ;
    rdfs:comment 'Business-facing unique identifier or tracking number for the waitlist entry, used for patient communication and scheduling team reference.' ;
    rdfs:domain ind:WaitlistEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:entryStatus rdf:type rdf:Property ;
    rdfs:label 'Entry Status' ;
    rdfs:comment 'Current lifecycle status of the waitlist entry: active (awaiting action), offered (appointment offered to patient), accepted (patient accepted offer), expired (entry aged out or SLA missed), removed (manually removed from queue), pending (awaiting information or approval), in_progress (actively being worked by scheduling team), scheduled (appointment successfully scheduled), escalated (escalated due to aging or priority), closed (completed or resolved). [ENUM-REF-CANDIDATE: active|offered|accepted|expired|removed|pending|in_progress|scheduled|escalated|closed — 10 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:WaitlistEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:entryType rdf:type rdf:Property ;
    rdfs:label 'Entry Type' ;
    rdfs:comment 'Classification of the waitlist entry indicating the source or nature of the scheduling request: waitlist (patient-initiated or provider-requested appointment waitlist), referral_queue (unscheduled referral awaiting scheduling), order_based (pending order requiring appointment), recall (recall-driven request for follow-up), surgical_request (surgical scheduling request), work_queue (general scheduling department work item).' ;
    rdfs:domain ind:WaitlistEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedWaitTimeDays rdf:type rdf:Property ;
    rdfs:label 'Estimated Wait Time Days' ;
    rdfs:comment 'Estimated number of days the patient will wait from queue entry to scheduled appointment, based on current capacity and demand forecasting.' ;
    rdfs:domain ind:WaitlistEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lastOutreachDatetime rdf:type rdf:Property ;
    rdfs:label 'Last Outreach Datetime' ;
    rdfs:comment 'Date and time of the most recent outreach attempt to the patient. Null if no outreach has been attempted.' ;
    rdfs:domain ind:Scheduling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:lastOutreachMethod rdf:type rdf:Property ;
    rdfs:label 'Last Outreach Method' ;
    rdfs:comment 'Method used for the most recent outreach attempt: phone call, email, SMS text, patient portal message, postal mail.' ;
    rdfs:domain ind:Scheduling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preferredContactChannel rdf:type rdf:Property ;
    rdfs:label 'Preferred Contact Channel' ;
    rdfs:comment 'Patient preferred method of contact for scheduling outreach and appointment notifications: phone, email, SMS text message, patient portal message, postal mail.' ;
    rdfs:domain ind:Scheduling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preferredDaysOfWeek rdf:type rdf:Property ;
    rdfs:label 'Preferred Days Of Week' ;
    rdfs:comment 'Patient preference for days of the week for scheduling (e.g., Monday, Wednesday, Friday). Stored as comma-separated list or coded representation.' ;
    rdfs:domain ind:Scheduling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preferredTimeOfDay rdf:type rdf:Property ;
    rdfs:label 'Preferred Time Of Day' ;
    rdfs:comment 'Patient preference for time of day for scheduling: morning (before noon), afternoon (noon to 5pm), evening (after 5pm), any (no preference).' ;
    rdfs:domain ind:Scheduling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:queueEntryDatetime rdf:type rdf:Property ;
    rdfs:label 'Queue Entry Datetime' ;
    rdfs:comment 'Date and time when the patient was added to the waitlist or scheduling queue. Used for aging calculations and first-in-first-out queue management.' ;
    rdfs:domain ind:Scheduling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:removalDatetime rdf:type rdf:Property ;
    rdfs:label 'Removal Datetime' ;
    rdfs:comment 'Date and time when the waitlist entry was removed from the queue without scheduling (e.g., patient declined, no longer needed, duplicate entry). Null if not removed.' ;
    rdfs:domain ind:Scheduling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:scheduledDatetime rdf:type rdf:Property ;
    rdfs:label 'Scheduled Datetime' ;
    rdfs:comment 'Date and time when the appointment was successfully scheduled and the waitlist entry was resolved. Null if not yet scheduled.' ;
    rdfs:domain ind:Scheduling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:slaTargetDatetime rdf:type rdf:Property ;
    rdfs:label 'Sla Target Datetime' ;
    rdfs:comment 'Target date and time by which the scheduling action should be completed per organizational or regulatory service level agreement. Used for compliance monitoring and escalation triggers.' ;
    rdfs:domain ind:Scheduling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:specialtyRequired rdf:type rdf:Property ;
    rdfs:label 'Specialty Required' ;
    rdfs:comment 'Clinical specialty required for the appointment (e.g., Cardiology, Orthopedics, Primary Care). Used for routing to appropriate scheduling queues.' ;
    rdfs:domain ind:Scheduling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waitlistEntryStatus rdf:type rdf:Property ;
    rdfs:label 'Waitlist Entry Status' ;
    rdfs:domain ind:WaitlistEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:telehealthEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Telehealth Eligible Flag' ;
    rdfs:comment 'Indicates whether the patient is eligible and willing to receive care via telehealth modality for this appointment request. True if telehealth is an acceptable option.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:transportationAssistanceNeededFlag rdf:type rdf:Property ;
    rdfs:label 'Transportation Assistance Needed Flag' ;
    rdfs:comment 'Indicates whether the patient requires transportation assistance to attend the appointment. True if transportation support is needed.' ;
    rdfs:domain ind:Scheduling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appointmentStatusHistoryId rdf:type rdf:Property ;
    rdfs:label 'Appointment Status History Id' ;
    rdfs:comment 'Unique identifier for each appointment status transition record in the audit log. Primary key for the appointment status history table.' ;
    rdfs:domain ind:AppointmentStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:primarySchedulingAppointmentId rdf:type rdf:Property ;
    rdfs:label 'Primary Scheduling Appointment Id' ;
    rdfs:comment 'Foreign key reference to the appointment that underwent this status transition. Links this status history record to the parent appointment in the scheduling_appointment table.' ;
    rdfs:domain ind:AppointmentStatusHistory ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SchedulingAppointment .

ind:tertiaryRescheduledAppointmentSchedulingAppointmentId rdf:type rdf:Property ;
    rdfs:label 'Tertiary Rescheduled Appointment Scheduling Appointment Id' ;
    rdfs:comment 'Foreign key reference to the new appointment created when this appointment was rescheduled. Null if not rescheduled. Used to track rescheduling patterns and patient retention.' ;
    rdfs:domain ind:AppointmentStatusHistory ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SchedulingAppointment .

ind:advanceNoticeHours rdf:type rdf:Property ;
    rdfs:label 'Advance Notice Hours' ;
    rdfs:comment 'Number of hours between the cancellation timestamp and the originally scheduled appointment time. Used to determine if cancellation met policy requirements and to analyze cancellation lead time patterns.' ;
    rdfs:domain ind:AppointmentStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:auditRequired rdf:type rdf:Property ;
    rdfs:label 'Audit Required' ;
    rdfs:comment 'Flag indicating whether this status transition requires additional audit review or documentation per compliance policy. True if audit required, False otherwise. Used for compliance monitoring.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:backfillIndicator rdf:type rdf:Property ;
    rdfs:label 'Backfill Indicator' ;
    rdfs:comment 'Flag indicating whether this no-show or cancellation slot was successfully backfilled with another patient. True if the slot was reused, False if it remained empty. Critical for revenue protection and capacity utilization analysis.' ;
    rdfs:domain ind:AppointmentStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:estimatedRevenueImpact rdf:type rdf:Property ;
    rdfs:label 'Estimated Revenue Impact' ;
    rdfs:comment 'Estimated financial impact of this status transition in USD. Positive for revenue-generating transitions, negative for lost revenue (no-shows, cancellations). Used for financial forecasting and no-show cost analysis.' ;
    rdfs:domain ind:AppointmentStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:financialImpactFlag rdf:type rdf:Property ;
    rdfs:label 'Financial Impact Flag' ;
    rdfs:comment 'Indicates whether this status transition has financial implications (e.g., no-show fee, late cancellation charge, lost revenue). True if financial impact exists, False otherwise. Used for revenue cycle reporting.' ;
    rdfs:domain ind:AppointmentStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hedisMeasureApplicable rdf:type rdf:Property ;
    rdfs:label 'Hedis Measure Applicable' ;
    rdfs:comment 'Indicates whether this appointment status transition impacts HEDIS access and availability measures. True if applicable to quality reporting, False otherwise. Used for NCQA quality measure compliance.' ;
    rdfs:domain ind:AppointmentStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hedisMeasureCode rdf:type rdf:Property ;
    rdfs:label 'Hedis Measure Code' ;
    rdfs:comment 'Specific HEDIS measure code that this status transition impacts (e.g., access measures, preventive care measures). Null if not applicable to HEDIS reporting.' ;
    rdfs:domain ind:Scheduling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:initiatedByRole rdf:type rdf:Property ;
    rdfs:label 'Initiated By Role' ;
    rdfs:comment 'Role or job function of the user who triggered the transition (e.g., Scheduler, Nurse, Patient, System). Used for workflow analysis and training needs assessment.' ;
    rdfs:domain ind:AppointmentStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:initiatedByUserName rdf:type rdf:Property ;
    rdfs:label 'Initiated By User Name' ;
    rdfs:comment 'Name of the user who triggered this status transition. Human-readable identifier for operational review and audit purposes.' ;
    rdfs:domain ind:AppointmentStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:noShowPenaltyAmount rdf:type rdf:Property ;
    rdfs:label 'No Show Penalty Amount' ;
    rdfs:comment 'Dollar amount of the no-show penalty or late cancellation fee charged to the patient. Null if no penalty was applied. Used for revenue tracking and policy effectiveness analysis.' ;
    rdfs:domain ind:AppointmentStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:noShowPenaltyApplied rdf:type rdf:Property ;
    rdfs:label 'No Show Penalty Applied' ;
    rdfs:comment 'Indicates whether a no-show penalty or fee was applied to the patient account as a result of this transition. True if penalty applied, False otherwise. Used for no-show policy enforcement tracking.' ;
    rdfs:domain ind:AppointmentStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:notificationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Notification Timestamp' ;
    rdfs:comment 'Date and time when waitlist notifications were sent for this available slot. Null if no notifications were sent. Used to measure notification-to-booking conversion time.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:patientContactMethod rdf:type rdf:Property ;
    rdfs:label 'Patient Contact Method' ;
    rdfs:comment 'Method used to contact the patient regarding this status transition. Used for communication effectiveness analysis and patient preference tracking.' ;
    rdfs:domain ind:AppointmentStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:patientContactedFlag rdf:type rdf:Property ;
    rdfs:label 'Patient Contacted Flag' ;
    rdfs:comment 'Indicates whether the patient was contacted regarding this status transition (e.g., confirmation call, cancellation notification, no-show follow-up). True if contact attempted, False otherwise.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:qualityMeasureImpact rdf:type rdf:Property ;
    rdfs:label 'Quality Measure Impact' ;
    rdfs:comment 'Classification of how this status transition impacts quality measures. Positive for completed visits, negative for no-shows affecting access measures, neutral for administrative changes.' ;
    rdfs:domain ind:AppointmentStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reasonCategory rdf:type rdf:Property ;
    rdfs:label 'Reason Category' ;
    rdfs:comment 'High-level classification of the transition reason. Groups granular reason codes into analytical categories for no-show and cancellation pattern tracking. [ENUM-REF-CANDIDATE: patient_request|provider_unavailable|facility_issue|insurance_issue|clinical_reason|administrative|weather|transportation|no_reason_given|other — 10 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:AppointmentStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryReportable rdf:type rdf:Property ;
    rdfs:label 'Regulatory Reportable' ;
    rdfs:comment 'Indicates whether this status transition must be included in regulatory reporting (CMS, state health departments, accreditation bodies). True if reportable, False otherwise.' ;
    rdfs:domain ind:AppointmentStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appointmentStatusHistoryStatus rdf:type rdf:Property ;
    rdfs:label 'Appointment Status History Status' ;
    rdfs:domain ind:AppointmentStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:systemGenerated rdf:type rdf:Property ;
    rdfs:label 'System Generated' ;
    rdfs:comment 'Indicates whether this status transition was automatically generated by the system (e.g., auto no-show after appointment time) versus manually entered by staff. True if system-generated, False if manual.' ;
    rdfs:domain ind:AppointmentStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:transitionReasonCode rdf:type rdf:Property ;
    rdfs:label 'Transition Reason Code' ;
    rdfs:comment 'Coded reason for the status transition. Includes cancellation reason codes, no-show reason codes, and other transition justifications. Used for root cause analysis and no-show reduction programs.' ;
    rdfs:domain ind:AppointmentStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transitionReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Transition Reason Description' ;
    rdfs:comment 'Free-text description or additional detail about why the status transition occurred. Supplements the reason code with context provided by staff or patient.' ;
    rdfs:domain ind:AppointmentStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transitionSource rdf:type rdf:Property ;
    rdfs:label 'Transition Source' ;
    rdfs:comment 'The system or channel through which the status transition was initiated. Distinguishes manual staff actions from automated system transitions and patient self-service actions. [ENUM-REF-CANDIDATE: manual|automated|patient_portal|ivr|mobile_app|kiosk|interface|batch_process — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:AppointmentStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transitionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Transition Timestamp' ;
    rdfs:comment 'The exact date and time when this status transition occurred. Primary business event timestamp for this audit record. Used for no-show detection, cancellation pattern analysis, and operational throughput measurement.' ;
    rdfs:domain ind:AppointmentStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:waitlistNotificationSent rdf:type rdf:Property ;
    rdfs:label 'Waitlist Notification Sent' ;
    rdfs:comment 'Indicates whether waitlisted patients were notified of this newly available slot following a cancellation or no-show. True if notification sent, False otherwise. Used for waitlist management effectiveness tracking.' ;
    rdfs:domain ind:AppointmentStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:withinPolicyWindow rdf:type rdf:Property ;
    rdfs:label 'Within Policy Window' ;
    rdfs:comment 'Indicates whether the cancellation or status change occurred within the required advance notice window per organizational policy. True if within policy, False if late. Used for policy compliance reporting.' ;
    rdfs:domain ind:AppointmentStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appointmentReminderId rdf:type rdf:Property ;
    rdfs:label 'Appointment Reminder Id' ;
    rdfs:comment 'Unique identifier for the appointment reminder record. Primary key.' ;
    rdfs:domain ind:AppointmentReminder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reminderTemplateId rdf:type rdf:Property ;
    rdfs:label 'Reminder Template Id' ;
    rdfs:comment 'Identifier for the message template used to generate the reminder content. References the template library in the source system.' ;
    rdfs:domain ind:Scheduling ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ReminderTemplate .

ind:actualSendDatetime rdf:type rdf:Property ;
    rdfs:label 'Actual Send Datetime' ;
    rdfs:comment 'The actual date and time when the reminder was sent by the messaging system. May differ from scheduled send time due to system delays or batch processing.' ;
    rdfs:domain ind:AppointmentReminder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:appointmentTime rdf:type rdf:Property ;
    rdfs:label 'Appointment Time' ;
    rdfs:comment 'The scheduled start time of the appointment for which this reminder was sent. Denormalized from the scheduling_appointment product for reporting convenience.' ;
    rdfs:domain ind:AppointmentReminder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:attemptNumber rdf:type rdf:Property ;
    rdfs:label 'Attempt Number' ;
    rdfs:comment 'The sequential attempt number for this reminder (e.g., 1 for first attempt, 2 for second attempt). Supports tracking of retry logic and escalation workflows.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costPerReminder rdf:type rdf:Property ;
    rdfs:label 'Cost Per Reminder' ;
    rdfs:comment 'The cost incurred for sending this reminder through the selected delivery channel (e.g., SMS carrier fees, IVR system costs). Supports cost analysis and Return on Investment (ROI) calculation for reminder programs.' ;
    rdfs:domain ind:AppointmentReminder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:deliveryChannel rdf:type rdf:Property ;
    rdfs:label 'Delivery Channel' ;
    rdfs:comment 'The communication channel through which the reminder was sent (e.g., phone call, SMS text message, email, patient portal message, Interactive Voice Response (IVR), mobile app push notification).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facilityName rdf:type rdf:Property ;
    rdfs:label 'Facility Name' ;
    rdfs:comment 'The name of the facility where the appointment is scheduled. Denormalized for patient communication and reporting purposes.' ;
    rdfs:domain ind:AppointmentReminder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:leadTimeDays rdf:type rdf:Property ;
    rdfs:label 'Lead Time Days' ;
    rdfs:comment 'The number of days before the appointment that this reminder was scheduled to be sent. Supports analysis of optimal reminder timing for no-show reduction.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maxAttemptsAllowed rdf:type rdf:Property ;
    rdfs:label 'Max Attempts Allowed' ;
    rdfs:comment 'The maximum number of reminder attempts configured for this appointment type or reminder workflow. Used to determine when to stop retry attempts.' ;
    rdfs:domain ind:Scheduling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:optOutDatetime rdf:type rdf:Property ;
    rdfs:label 'Opt Out Datetime' ;
    rdfs:comment 'The date and time when the patient opted out of automated reminders, if applicable. Null if patient has not opted out.' ;
    rdfs:domain ind:AppointmentReminder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:providerName rdf:type rdf:Property ;
    rdfs:label 'Provider Name' ;
    rdfs:comment 'The name of the provider for the appointment. Denormalized for patient communication and reporting purposes.' ;
    rdfs:domain ind:AppointmentReminder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recipientEmailAddress rdf:type rdf:Property ;
    rdfs:label 'Recipient Email Address' ;
    rdfs:comment 'The email address to which the reminder was sent, if delivery channel was email. Protected Health Information (PHI) under HIPAA.' ;
    rdfs:domain ind:AppointmentReminder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recipientPhoneNumber rdf:type rdf:Property ;
    rdfs:label 'Recipient Phone Number' ;
    rdfs:comment 'The phone number to which the reminder was sent, if delivery channel was phone or SMS. Protected Health Information (PHI) under HIPAA.' ;
    rdfs:domain ind:AppointmentReminder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reminderType rdf:type rdf:Property ;
    rdfs:label 'Reminder Type' ;
    rdfs:comment 'The type or sequence of the reminder in the automated reminder workflow (e.g., initial, first reminder, second reminder, final reminder, confirmation request, pre-visit instructions).' ;
    rdfs:domain ind:Scheduling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responseChannel rdf:type rdf:Property ;
    rdfs:label 'Response Channel' ;
    rdfs:comment 'The channel through which the patient responded to the reminder (e.g., phone call, SMS reply, email reply, patient portal, IVR system, mobile app).' ;
    rdfs:domain ind:AppointmentReminder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduledSendDatetime rdf:type rdf:Property ;
    rdfs:label 'Scheduled Send Datetime' ;
    rdfs:comment 'The date and time when the reminder was scheduled to be sent, based on the reminder lead time configuration and appointment date.' ;
    rdfs:domain ind:AppointmentReminder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:appointmentReminderStatus rdf:type rdf:Property ;
    rdfs:label 'Appointment Reminder Status' ;
    rdfs:domain ind:AppointmentReminder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capacityUtilizationId rdf:type rdf:Property ;
    rdfs:label 'Capacity Utilization Id' ;
    rdfs:comment 'Primary key for capacity_utilization' ;
    rdfs:domain ind:CapacityUtilization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:budgetId rdf:type rdf:Property ;
    rdfs:label 'Budget Id' ;
    rdfs:comment 'Foreign key linking to finance.budget. Business justification: Capacity plans drive volume-based budget assumptions (target_visit_volume, target_case_volume). Linking enables budget-to-actual volume variance analysis, reforecasting, and operational budget managem' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Budget .

ind:primaryCapacityEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Capacity Employee Id' ;
    rdfs:comment 'Identifier of the user or system that created this capacity utilization record.' ;
    rdfs:domain ind:CapacityUtilization ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:accessDays rdf:type rdf:Property ;
    rdfs:label 'Access Days' ;
    rdfs:comment 'Average number of days from appointment request to scheduled appointment date, measuring patient access timeliness.' ;
    rdfs:domain ind:CapacityUtilization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:actualCaseVolume rdf:type rdf:Property ;
    rdfs:label 'Actual Case Volume' ;
    rdfs:comment 'Actual number of surgical or procedural cases performed during the period.' ;
    rdfs:domain ind:CapacityUtilization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:actualUtilizationRatePct rdf:type rdf:Property ;
    rdfs:label 'Actual Utilization Rate Pct' ;
    rdfs:comment 'Actual utilization rate achieved as a percentage of available capacity.' ;
    rdfs:domain ind:CapacityUtilization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:actualVisitVolume rdf:type rdf:Property ;
    rdfs:label 'Actual Visit Volume' ;
    rdfs:comment 'Actual number of patient visits or appointments completed during the period.' ;
    rdfs:domain ind:CapacityUtilization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:addOnCaseCount rdf:type rdf:Property ;
    rdfs:label 'Add On Case Count' ;
    rdfs:comment 'Number of add-on surgical cases scheduled outside of allocated block time during the period.' ;
    rdfs:domain ind:Scheduling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:availableFte rdf:type rdf:Property ;
    rdfs:label 'Available Fte' ;
    rdfs:comment 'Full-time equivalent staff or provider capacity available during the planning period.' ;
    rdfs:domain ind:CapacityUtilization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:availableHours rdf:type rdf:Property ;
    rdfs:label 'Available Hours' ;
    rdfs:comment 'Total hours available for scheduling during the planning period (provider time, room time, or equipment time).' ;
    rdfs:domain ind:CapacityUtilization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:availableMinutes rdf:type rdf:Property ;
    rdfs:label 'Available Minutes' ;
    rdfs:comment 'Total minutes available for scheduling during the planning period, used primarily for OR block time tracking.' ;
    rdfs:domain ind:CapacityUtilization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:cancellationCount rdf:type rdf:Property ;
    rdfs:label 'Cancellation Count' ;
    rdfs:comment 'Number of cancelled appointments or cases during the period.' ;
    rdfs:domain ind:CapacityUtilization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:firstCaseOnTimeStartFlag rdf:type rdf:Property ;
    rdfs:label 'First Case On Time Start Flag' ;
    rdfs:comment 'Indicates whether the first case of the day started on time. True if on time, False if delayed.' ;
    rdfs:domain ind:Scheduling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:noShowCount rdf:type rdf:Property ;
    rdfs:label 'No Show Count' ;
    rdfs:comment 'Number of patient no-shows during the period, impacting actual utilization.' ;
    rdfs:domain ind:CapacityUtilization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:overbookingCount rdf:type rdf:Property ;
    rdfs:label 'Overbooking Count' ;
    rdfs:comment 'Number of instances where capacity was overbooked beyond available slots or time.' ;
    rdfs:domain ind:CapacityUtilization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:planningPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Planning Period End Date' ;
    rdfs:comment 'End date of the planning or measurement period for this capacity record.' ;
    rdfs:domain ind:CapacityUtilization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:planningPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Planning Period Start Date' ;
    rdfs:comment 'Start date of the planning or measurement period for this capacity record.' ;
    rdfs:domain ind:CapacityUtilization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reallocationRecommendation rdf:type rdf:Property ;
    rdfs:label 'Reallocation Recommendation' ;
    rdfs:comment 'Recommendation for capacity reallocation based on variance analysis (e.g., increase block time, reduce slots, shift resources).' ;
    rdfs:domain ind:CapacityUtilization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:releasedMinutes rdf:type rdf:Property ;
    rdfs:label 'Released Minutes' ;
    rdfs:comment 'Minutes of OR block time released back to the pool for reallocation due to underutilization or cancellations.' ;
    rdfs:domain ind:Scheduling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:scheduledHours rdf:type rdf:Property ;
    rdfs:label 'Scheduled Hours' ;
    rdfs:comment 'Total hours scheduled with appointments or cases during the period.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scheduledMinutes rdf:type rdf:Property ;
    rdfs:label 'Scheduled Minutes' ;
    rdfs:comment 'Total minutes scheduled with cases or appointments during the period.' ;
    rdfs:domain ind:Scheduling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:capacityUtilizationStatus rdf:type rdf:Property ;
    rdfs:label 'Capacity Utilization Status' ;
    rdfs:domain ind:CapacityUtilization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetCaseVolume rdf:type rdf:Property ;
    rdfs:label 'Target Case Volume' ;
    rdfs:comment 'Planned number of surgical or procedural cases for the planning period.' ;
    rdfs:domain ind:CapacityUtilization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:targetUtilizationRatePct rdf:type rdf:Property ;
    rdfs:label 'Target Utilization Rate Pct' ;
    rdfs:comment 'Target utilization rate as a percentage of available capacity (e.g., 85.00 represents 85% target utilization).' ;
    rdfs:domain ind:CapacityUtilization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:targetVisitVolume rdf:type rdf:Property ;
    rdfs:label 'Target Visit Volume' ;
    rdfs:comment 'Planned number of patient visits or appointments for the planning period.' ;
    rdfs:domain ind:CapacityUtilization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:trendIndicator rdf:type rdf:Property ;
    rdfs:label 'Trend Indicator' ;
    rdfs:comment 'Directional trend of utilization over time: increasing demand, decreasing demand, stable, or volatile patterns.' ;
    rdfs:domain ind:CapacityUtilization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:turnoverTimeMinutes rdf:type rdf:Property ;
    rdfs:label 'Turnover Time Minutes' ;
    rdfs:comment 'Average time in minutes between cases for room cleaning, setup, and preparation.' ;
    rdfs:domain ind:CapacityUtilization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:utilizedHours rdf:type rdf:Property ;
    rdfs:label 'Utilized Hours' ;
    rdfs:comment 'Actual hours used for patient care activities during the period.' ;
    rdfs:domain ind:CapacityUtilization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:utilizedMinutes rdf:type rdf:Property ;
    rdfs:label 'Utilized Minutes' ;
    rdfs:comment 'Actual minutes used for patient care activities during the period.' ;
    rdfs:domain ind:CapacityUtilization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:varianceHours rdf:type rdf:Property ;
    rdfs:label 'Variance Hours' ;
    rdfs:comment 'Difference between actual and planned hours (actual minus planned).' ;
    rdfs:domain ind:CapacityUtilization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:varianceUtilizationPct rdf:type rdf:Property ;
    rdfs:label 'Variance Utilization Pct' ;
    rdfs:comment 'Difference between actual and target utilization rate as a percentage.' ;
    rdfs:domain ind:CapacityUtilization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:varianceVolume rdf:type rdf:Property ;
    rdfs:label 'Variance Volume' ;
    rdfs:comment 'Difference between actual and planned visit or case volume (actual minus planned).' ;
    rdfs:domain ind:CapacityUtilization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:waitlistVolume rdf:type rdf:Property ;
    rdfs:label 'Waitlist Volume' ;
    rdfs:comment 'Number of patients on the waitlist for this resource or service during the period.' ;
    rdfs:domain ind:CapacityUtilization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:blockUtilizationId rdf:type rdf:Property ;
    rdfs:label 'Block Utilization Id' ;
    rdfs:comment 'Unique identifier for the operating room block utilization record.' ;
    rdfs:domain ind:BlockUtilization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:allocatedMinutes rdf:type rdf:Property ;
    rdfs:label 'Allocated Minutes' ;
    rdfs:comment 'Total number of minutes allocated for the OR block on this date.' ;
    rdfs:domain ind:BlockUtilization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:averageTurnoverMinutes rdf:type rdf:Property ;
    rdfs:label 'Average Turnover Minutes' ;
    rdfs:comment 'Average turnover time between cases within this block, calculated as total turnover minutes divided by number of turnovers.' ;
    rdfs:domain ind:BlockUtilization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:blockOverrunMinutes rdf:type rdf:Property ;
    rdfs:label 'Block Overrun Minutes' ;
    rdfs:comment 'Number of minutes the block ran beyond its allocated end time due to case overruns or delays.' ;
    rdfs:domain ind:BlockUtilization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:blockReallocationRiskFlag rdf:type rdf:Property ;
    rdfs:label 'Block Reallocation Risk Flag' ;
    rdfs:comment 'Indicates whether this block is at risk for reallocation due to consistently low utilization (True) or not (False).' ;
    rdfs:domain ind:BlockUtilization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cancelledCaseCount rdf:type rdf:Property ;
    rdfs:label 'Cancelled Case Count' ;
    rdfs:comment 'Total number of scheduled cases that were cancelled within the block time.' ;
    rdfs:domain ind:BlockUtilization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:completedCaseCount rdf:type rdf:Property ;
    rdfs:label 'Completed Case Count' ;
    rdfs:comment 'Total number of surgical cases that were completed during the block time.' ;
    rdfs:domain ind:BlockUtilization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:firstCaseDelayMinutes rdf:type rdf:Property ;
    rdfs:label 'First Case Delay Minutes' ;
    rdfs:comment 'Number of minutes the first case was delayed beyond the scheduled start time. Zero if started on time.' ;
    rdfs:domain ind:BlockUtilization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:meetsUtilizationThresholdFlag rdf:type rdf:Property ;
    rdfs:label 'Meets Utilization Threshold Flag' ;
    rdfs:comment 'Indicates whether the block utilization met or exceeded the minimum utilization threshold required to retain the block allocation (True) or fell below threshold (False).' ;
    rdfs:domain ind:BlockUtilization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:primeTimeFlag rdf:type rdf:Property ;
    rdfs:label 'Prime Time Flag' ;
    rdfs:comment 'Indicates whether this block occurred during prime OR time (typically weekday daytime hours, True) or non-prime time (False).' ;
    rdfs:domain ind:BlockUtilization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:procedureMinutes rdf:type rdf:Property ;
    rdfs:label 'Procedure Minutes' ;
    rdfs:comment 'Total number of minutes spent on actual surgical procedures (wheels in to wheels out), excluding turnover time.' ;
    rdfs:domain ind:BlockUtilization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:releaseTimestamp rdf:type rdf:Property ;
    rdfs:label 'Release Timestamp' ;
    rdfs:comment 'Date and time when unused block time was released back to the pool for reallocation.' ;
    rdfs:domain ind:BlockUtilization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:scheduledCaseCount rdf:type rdf:Property ;
    rdfs:label 'Scheduled Case Count' ;
    rdfs:comment 'Total number of surgical cases scheduled within the block time.' ;
    rdfs:domain ind:BlockUtilization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:blockUtilizationStatus rdf:type rdf:Property ;
    rdfs:label 'Block Utilization Status' ;
    rdfs:domain ind:BlockUtilization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetUtilizationPercentage rdf:type rdf:Property ;
    rdfs:label 'Target Utilization Percentage' ;
    rdfs:comment 'The target utilization percentage threshold defined for this block owner or service line.' ;
    rdfs:domain ind:BlockUtilization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:turnoverMinutes rdf:type rdf:Property ;
    rdfs:label 'Turnover Minutes' ;
    rdfs:comment 'Total number of minutes spent on room turnover between cases (wheels out to wheels in for next case).' ;
    rdfs:domain ind:BlockUtilization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:unutilizedMinutes rdf:type rdf:Property ;
    rdfs:label 'Unutilized Minutes' ;
    rdfs:comment 'Number of allocated minutes that were neither used nor released, representing idle OR time.' ;
    rdfs:domain ind:BlockUtilization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:usedMinutes rdf:type rdf:Property ;
    rdfs:label 'Used Minutes' ;
    rdfs:comment 'Total number of minutes actually used for surgical procedures, including procedure time and turnover time.' ;
    rdfs:domain ind:BlockUtilization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:utilizationDate rdf:type rdf:Property ;
    rdfs:label 'Utilization Date' ;
    rdfs:comment 'The calendar date on which the OR block utilization was measured.' ;
    rdfs:domain ind:BlockUtilization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:utilizationPercentage rdf:type rdf:Property ;
    rdfs:label 'Utilization Percentage' ;
    rdfs:comment 'Percentage of allocated block time that was actually used, calculated as (used_minutes / allocated_minutes) * 100.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:utilizationVariancePercentage rdf:type rdf:Property ;
    rdfs:label 'Utilization Variance Percentage' ;
    rdfs:comment 'Variance between actual utilization percentage and target utilization percentage (actual minus target).' ;
    rdfs:domain ind:BlockUtilization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bookingRuleId rdf:type rdf:Property ;
    rdfs:label 'Booking Rule Id' ;
    rdfs:comment 'Primary key for booking_rule' ;
    rdfs:domain ind:BookingRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:primaryBookingAppointmentTypeId rdf:type rdf:Property ;
    rdfs:label 'Primary Booking Appointment Type Id' ;
    rdfs:comment 'Reference to the specific appointment type to which this rule applies. Null indicates the rule applies to all appointment types.' ;
    rdfs:domain ind:BookingRule ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AppointmentType .

ind:primaryBookingEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Booking Employee Id' ;
    rdfs:comment 'Reference to the user who approved this scheduling rule for activation. Null for draft or unapproved rules. Supports governance and accountability.' ;
    rdfs:domain ind:Scheduling ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:supersededRuleBookingRuleId rdf:type rdf:Property ;
    rdfs:label 'Superseded Rule Booking Rule Id' ;
    rdfs:comment 'Reference to the previous version of this rule that was replaced. Null for initial rule versions. Maintains lineage for rule versioning and audit trail.' ;
    rdfs:domain ind:BookingRule ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BookingRule .

ind:appliesToSurgicalCases rdf:type rdf:Property ;
    rdfs:label 'Applies To Surgical Cases' ;
    rdfs:comment 'Indicates whether this rule applies to surgical case scheduling in Epic OpTime. True enforces the rule for Operating Room (OR) scheduling, false exempts surgical cases.' ;
    rdfs:domain ind:BookingRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appliesToTelehealth rdf:type rdf:Property ;
    rdfs:label 'Applies To Telehealth' ;
    rdfs:comment 'Indicates whether this rule applies to telehealth virtual appointments. True enforces the rule for telehealth visits, false exempts telehealth from this rule.' ;
    rdfs:domain ind:BookingRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:businessJustification rdf:type rdf:Property ;
    rdfs:label 'Business Justification' ;
    rdfs:comment 'Rationale for implementing this scheduling rule, including clinical, operational, financial, or regulatory drivers. Used for governance and audit purposes.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conflictRuleType rdf:type rdf:Property ;
    rdfs:label 'Conflict Rule Type' ;
    rdfs:comment 'Type of scheduling conflict this rule prevents. Same day block prevents multiple appointments on the same day, same week block prevents appointments in the same week, concurrent block prevents overlapping appointments, sequential required enforces appointment ordering.' ;
    rdfs:domain ind:BookingRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:doubleBookingAllowed rdf:type rdf:Property ;
    rdfs:label 'Double Booking Allowed' ;
    rdfs:comment 'Indicates whether multiple appointments can be scheduled in the same time slot for the same provider or resource. True permits double booking, false enforces single appointment per slot.' ;
    rdfs:domain ind:BookingRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:enforcementMode rdf:type rdf:Property ;
    rdfs:label 'Enforcement Mode' ;
    rdfs:comment 'Defines how strictly the rule is enforced in scheduling systems. Hard block prevents scheduling, soft warning allows override with acknowledgment, advisory provides guidance without enforcement.' ;
    rdfs:domain ind:BookingRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:insuranceTypeRequired rdf:type rdf:Property ;
    rdfs:label 'Insurance Type Required' ;
    rdfs:comment 'Specific insurance plan type or payer category required for scheduling under this rule. Null indicates no insurance restriction. Used to enforce payer-specific access rules.' ;
    rdfs:domain ind:BookingRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maximumLeadTimeDays rdf:type rdf:Property ;
    rdfs:label 'Maximum Lead Time Days' ;
    rdfs:comment 'Maximum number of days in advance that an appointment can be scheduled. Used to control booking horizon and prevent excessive future scheduling.' ;
    rdfs:domain ind:BookingRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:maximumPatientAgeYears rdf:type rdf:Property ;
    rdfs:label 'Maximum Patient Age Years' ;
    rdfs:comment 'Maximum patient age in years permitted to schedule under this rule. Used to enforce age-appropriate care restrictions. Null indicates no maximum age limit.' ;
    rdfs:domain ind:BookingRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:minimumLeadTimeDays rdf:type rdf:Property ;
    rdfs:label 'Minimum Lead Time Days' ;
    rdfs:comment 'Minimum number of days in advance that an appointment must be scheduled. Used to enforce advance booking requirements for procedures requiring preparation or authorization.' ;
    rdfs:domain ind:BookingRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:minimumPatientAgeYears rdf:type rdf:Property ;
    rdfs:label 'Minimum Patient Age Years' ;
    rdfs:comment 'Minimum patient age in years required to schedule under this rule. Used to enforce age-appropriate care restrictions. Null indicates no minimum age requirement.' ;
    rdfs:domain ind:BookingRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:overrideAuthorityLevel rdf:type rdf:Property ;
    rdfs:label 'Override Authority Level' ;
    rdfs:comment 'Minimum user role or authority level required to override this rule during scheduling. Defines escalation hierarchy for exception handling.' ;
    rdfs:domain ind:BookingRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requiredPreVisitOrders rdf:type rdf:Property ;
    rdfs:label 'Required Pre Visit Orders' ;
    rdfs:comment 'Comma-separated list of order types or procedure codes that must be completed before the appointment. Used to enforce prerequisite testing or preparation requirements.' ;
    rdfs:domain ind:BookingRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rulePriority rdf:type rdf:Property ;
    rdfs:label 'Rule Priority' ;
    rdfs:comment 'Numeric priority ranking used to resolve conflicts when multiple rules apply to the same scheduling scenario. Lower numbers indicate higher priority. Rules with higher priority take precedence in enforcement.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sameDayBookingAllowed rdf:type rdf:Property ;
    rdfs:label 'Same Day Booking Allowed' ;
    rdfs:comment 'Indicates whether appointments can be scheduled on the same day as the request. True allows same-day scheduling, false requires advance booking per minimum lead time rules.' ;
    rdfs:domain ind:BookingRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:selfSchedulingAllowed rdf:type rdf:Property ;
    rdfs:label 'Self Scheduling Allowed' ;
    rdfs:comment 'Indicates whether patients can book appointments directly through online portals without staff intervention. True permits patient self-service scheduling, false requires staff-assisted booking.' ;
    rdfs:domain ind:BookingRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bookingRuleStatus rdf:type rdf:Property ;
    rdfs:label 'Booking Rule Status' ;
    rdfs:domain ind:BookingRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:patientPreferenceId rdf:type rdf:Property ;
    rdfs:label 'Patient Preference Id' ;
    rdfs:comment 'Unique identifier for the patient scheduling preference record. Primary key.' ;
    rdfs:domain ind:PatientPreference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:primaryPatientClinicianId rdf:type rdf:Property ;
    rdfs:label 'Primary Patient Clinician Id' ;
    rdfs:comment 'The provider the patient prefers to see for appointments. Used to prioritize provider matching in scheduling workflows.' ;
    rdfs:domain ind:PatientPreference ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:primaryPatientEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Patient Employee Id' ;
    rdfs:comment 'The system user who last verified or updated the preference record. Supports audit trail and data stewardship.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:tertiaryPatientModifiedByUserEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Tertiary Patient Modified By User Employee Id' ;
    rdfs:comment 'The system user who last modified this preference record. Supports audit trail and data stewardship.' ;
    rdfs:domain ind:PatientPreference ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:accessibilityNeeds rdf:type rdf:Property ;
    rdfs:label 'Accessibility Needs' ;
    rdfs:comment 'Free-text description of any accessibility accommodations the patient requires (e.g., wheelchair access, hearing assistance, visual aids). Used to ensure appropriate facility and resource assignment.' ;
    rdfs:domain ind:PatientPreference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:advanceNoticeDays rdf:type rdf:Property ;
    rdfs:label 'Advance Notice Days' ;
    rdfs:comment 'The minimum number of days advance notice the patient requires for appointment scheduling. Supports patient access planning and reduces no-shows.' ;
    rdfs:domain ind:PatientPreference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:genderPreferenceProvider rdf:type rdf:Property ;
    rdfs:label 'Gender Preference Provider' ;
    rdfs:comment 'The patient\'s preference for provider gender. Supports patient-centered care and cultural sensitivity in scheduling.' ;
    rdfs:domain ind:PatientPreference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:groupVisitEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Group Visit Eligible Flag' ;
    rdfs:comment 'Indicates whether the patient is willing to participate in group medical appointments. Supports population health and chronic disease management programs.' ;
    rdfs:domain ind:PatientPreference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:optOutRemindersFlag rdf:type rdf:Property ;
    rdfs:label 'Opt Out Reminders Flag' ;
    rdfs:comment 'Indicates whether the patient has opted out of receiving appointment reminders. Honors patient communication preferences and regulatory requirements.' ;
    rdfs:domain ind:PatientPreference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:preferenceNotes rdf:type rdf:Property ;
    rdfs:label 'Preference Notes' ;
    rdfs:comment 'Free-text notes providing additional context or special instructions related to the patient\'s scheduling preferences. Used by scheduling staff to accommodate unique patient needs.' ;
    rdfs:domain ind:PatientPreference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preferenceSource rdf:type rdf:Property ;
    rdfs:label 'Preference Source' ;
    rdfs:comment 'The channel or system through which the preference was captured. Supports data lineage and preference quality assessment.' ;
    rdfs:domain ind:PatientPreference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preferenceType rdf:type rdf:Property ;
    rdfs:label 'Preference Type' ;
    rdfs:comment 'Category of scheduling preference being captured. Classifies the preference to enable targeted matching in scheduling workflows.' ;
    rdfs:domain ind:PatientPreference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preferredVisitModality rdf:type rdf:Property ;
    rdfs:label 'Preferred Visit Modality' ;
    rdfs:comment 'The patient\'s preferred modality for care delivery. Supports patient-centered scheduling and access optimization.' ;
    rdfs:domain ind:PatientPreference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sameDayAppointmentPreference rdf:type rdf:Property ;
    rdfs:label 'Same Day Appointment Preference' ;
    rdfs:comment 'The patient\'s preference for same-day appointment availability. Guides urgent care and walk-in scheduling strategies.' ;
    rdfs:domain ind:PatientPreference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:schedulingPriorityLevel rdf:type rdf:Property ;
    rdfs:label 'Scheduling Priority Level' ;
    rdfs:comment 'The priority level assigned to this patient for scheduling purposes. May reflect clinical urgency, care program enrollment, or VIP status.' ;
    rdfs:domain ind:PatientPreference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:specialtyPreference rdf:type rdf:Property ;
    rdfs:label 'Specialty Preference' ;
    rdfs:comment 'The medical specialty the patient prefers for care (e.g., cardiology, orthopedics). Used for specialty-specific scheduling workflows.' ;
    rdfs:domain ind:PatientPreference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:patientPreferenceStatus rdf:type rdf:Property ;
    rdfs:label 'Patient Preference Status' ;
    rdfs:domain ind:PatientPreference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:telehealthPreference rdf:type rdf:Property ;
    rdfs:label 'Telehealth Preference' ;
    rdfs:comment 'The patient\'s preference level for telehealth versus in-person visits. Guides visit modality selection in scheduling.' ;
    rdfs:domain ind:PatientPreference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:telehealthSessionId rdf:type rdf:Property ;
    rdfs:label 'Telehealth Session Id' ;
    rdfs:comment 'Primary key for telehealth_session' ;
    rdfs:domain ind:TelehealthSession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:telehealthConsentId rdf:type rdf:Property ;
    rdfs:label 'Telehealth Consent Id' ;
    rdfs:comment 'Foreign key linking to consent.telehealth_consent. Business justification: Telehealth sessions require platform-specific consent per state regulations and interstate licensure compacts. Providers verify telehealth consent before session start. Required for CMS telehealth bil' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TelehealthConsent .

ind:billingEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Billing Eligible Flag' ;
    rdfs:comment 'Indicates whether the telehealth session meets all requirements for billing and reimbursement. Based on completion status, duration, documentation, and payer rules.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:billingModifierCode rdf:type rdf:Property ;
    rdfs:label 'Billing Modifier Code' ;
    rdfs:comment 'CPT or HCPCS modifier code applied to the telehealth session for billing purposes (e.g., GT, 95, GQ). Indicates the service was delivered via telehealth.' ;
    rdfs:domain ind:Scheduling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cancellationDatetime rdf:type rdf:Property ;
    rdfs:label 'Cancellation Datetime' ;
    rdfs:comment 'Date and time when the telehealth session was cancelled, if applicable.' ;
    rdfs:domain ind:Scheduling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:cancelledByRole rdf:type rdf:Property ;
    rdfs:label 'Cancelled By Role' ;
    rdfs:comment 'Role of the person or system that initiated the cancellation of the telehealth session.' ;
    rdfs:domain ind:TelehealthSession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:connectionQualityScore rdf:type rdf:Property ;
    rdfs:label 'Connection Quality Score' ;
    rdfs:comment 'Numeric score representing the overall quality of the telehealth connection, typically on a scale of 0-100. Based on bandwidth, latency, and stability metrics.' ;
    rdfs:domain ind:TelehealthSession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:connectionStatus rdf:type rdf:Property ;
    rdfs:label 'Connection Status' ;
    rdfs:comment 'Technical status of the network connection during the telehealth session. Used to track quality and troubleshoot issues.' ;
    rdfs:domain ind:TelehealthSession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:distantSiteCode rdf:type rdf:Property ;
    rdfs:label 'Distant Site Code' ;
    rdfs:comment 'Code identifying the location where the provider is physically located during the telehealth session. Required for certain telehealth billing scenarios.' ;
    rdfs:domain ind:TelehealthSession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interpreterPresentFlag rdf:type rdf:Property ;
    rdfs:label 'Interpreter Present Flag' ;
    rdfs:comment 'Indicates whether an interpreter was actually present and participated in the telehealth session.' ;
    rdfs:domain ind:TelehealthSession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:originatingSiteCode rdf:type rdf:Property ;
    rdfs:label 'Originating Site Code' ;
    rdfs:comment 'Code identifying the location where the patient is physically located during the telehealth session. Required for certain telehealth billing scenarios.' ;
    rdfs:domain ind:TelehealthSession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:patientBrowser rdf:type rdf:Property ;
    rdfs:label 'Patient Browser' ;
    rdfs:comment 'Web browser used by the patient to access the telehealth session, if applicable. Used for technical support and compatibility tracking.' ;
    rdfs:domain ind:TelehealthSession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:patientOperatingSystem rdf:type rdf:Property ;
    rdfs:label 'Patient Operating System' ;
    rdfs:comment 'Operating system of the device used by the patient (e.g., iOS, Android, Windows, macOS). Used for troubleshooting and compatibility analysis.' ;
    rdfs:domain ind:TelehealthSession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:platformName rdf:type rdf:Property ;
    rdfs:label 'Platform Name' ;
    rdfs:comment 'Name of the telehealth platform or application used to conduct the session (e.g., Epic MyChart Video, Zoom for Healthcare, Doxy.me).' ;
    rdfs:domain ind:TelehealthSession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:platformVendor rdf:type rdf:Property ;
    rdfs:label 'Platform Vendor' ;
    rdfs:comment 'Vendor or manufacturer of the telehealth platform used for the session.' ;
    rdfs:domain ind:TelehealthSession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerAttestationDatetime rdf:type rdf:Property ;
    rdfs:label 'Provider Attestation Datetime' ;
    rdfs:comment 'Date and time when the provider attested to the completion of the telehealth session.' ;
    rdfs:domain ind:TelehealthSession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:providerDeviceType rdf:type rdf:Property ;
    rdfs:label 'Provider Device Type' ;
    rdfs:comment 'Type of device used by the provider to conduct the telehealth session.' ;
    rdfs:domain ind:TelehealthSession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recordingEnabledFlag rdf:type rdf:Property ;
    rdfs:label 'Recording Enabled Flag' ;
    rdfs:comment 'Indicates whether the telehealth session was recorded for clinical, educational, or quality purposes. Requires explicit patient consent.' ;
    rdfs:domain ind:TelehealthSession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sessionAccessCode rdf:type rdf:Property ;
    rdfs:label 'Session Access Code' ;
    rdfs:comment 'PIN or access code required to join the telehealth session. Used for additional security and patient verification.' ;
    rdfs:domain ind:TelehealthSession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sessionNumber rdf:type rdf:Property ;
    rdfs:label 'Session Number' ;
    rdfs:comment 'Human-readable business identifier for the telehealth session, used for tracking and reference purposes.' ;
    rdfs:domain ind:TelehealthSession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sessionStatus rdf:type rdf:Property ;
    rdfs:label 'Session Status' ;
    rdfs:comment 'Current lifecycle status of the telehealth session. Tracks progression from scheduling through completion or cancellation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sessionUrl rdf:type rdf:Property ;
    rdfs:label 'Session Url' ;
    rdfs:comment 'Web link or URL provided to the patient and provider to access the telehealth session. Confidential to prevent unauthorized access.' ;
    rdfs:domain ind:TelehealthSession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:telehealthSessionStatus rdf:type rdf:Property ;
    rdfs:label 'Telehealth Session Status' ;
    rdfs:domain ind:TelehealthSession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:technicalIssueDescription rdf:type rdf:Property ;
    rdfs:label 'Technical Issue Description' ;
    rdfs:comment 'Free-text description of any technical issues encountered during the telehealth session, such as connectivity problems, audio/video quality issues, or platform errors.' ;
    rdfs:domain ind:TelehealthSession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:technicalIssueReportedFlag rdf:type rdf:Property ;
    rdfs:label 'Technical Issue Reported Flag' ;
    rdfs:comment 'Indicates whether any technical issues were reported during or after the telehealth session that impacted quality or completion.' ;
    rdfs:domain ind:TelehealthSession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:recallListId rdf:type rdf:Property ;
    rdfs:label 'Recall List Id' ;
    rdfs:comment 'Unique identifier for the recall list entry. Primary key for the recall list product.' ;
    rdfs:domain ind:RecallList ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:obligationId rdf:type rdf:Property ;
    rdfs:label 'Obligation Id' ;
    rdfs:comment 'Foreign key linking to compliance.obligation. Business justification: Recall programs fulfill regulatory obligations including preventive care mandates, quality measure requirements, and care gap closure. CMS, HEDIS, and Star ratings requirement.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Obligation .

ind:appointmentScheduledDate rdf:type rdf:Property ;
    rdfs:label 'Appointment Scheduled Date' ;
    rdfs:comment 'Date when the recall appointment was successfully scheduled.' ;
    rdfs:domain ind:RecallList ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cancellationDate rdf:type rdf:Property ;
    rdfs:label 'Cancellation Date' ;
    rdfs:comment 'Date when the recall was cancelled.' ;
    rdfs:domain ind:RecallList ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:careGapRegistryCode rdf:type rdf:Property ;
    rdfs:label 'Care Gap Registry Code' ;
    rdfs:comment 'Reference to the care gap registry entry that triggered this recall. Links to population health management and quality measure tracking systems.' ;
    rdfs:domain ind:RecallList ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:clinicalBasis rdf:type rdf:Property ;
    rdfs:label 'Clinical Basis' ;
    rdfs:comment 'Clinical justification for the recall, including relevant diagnosis codes, procedure history, or risk factors that necessitate follow-up care.' ;
    rdfs:domain ind:RecallList ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cmsQualityProgram rdf:type rdf:Property ;
    rdfs:label 'Cms Quality Program' ;
    rdfs:comment 'CMS quality program associated with this recall (e.g., MIPS, MSSP, Value-Based Purchasing, Hospital Quality Reporting).' ;
    rdfs:domain ind:RecallList ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gapClosureEvidence rdf:type rdf:Property ;
    rdfs:label 'Gap Closure Evidence' ;
    rdfs:comment 'Documentation or reference to clinical evidence that the care gap was closed (e.g., lab result, procedure note, immunization record).' ;
    rdfs:domain ind:RecallList ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastServiceDate rdf:type rdf:Property ;
    rdfs:label 'Last Service Date' ;
    rdfs:comment 'The date of the last completed service or appointment that established the baseline for calculating the recall date.' ;
    rdfs:domain ind:RecallList ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:qualityMeasureNumeratorEligible rdf:type rdf:Property ;
    rdfs:label 'Quality Measure Numerator Eligible' ;
    rdfs:comment 'Indicates whether completing this recall would make the patient eligible for the numerator of the associated quality measure.' ;
    rdfs:domain ind:RecallList ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:recallCategory rdf:type rdf:Property ;
    rdfs:label 'Recall Category' ;
    rdfs:comment 'High-level category of the recall to support population health segmentation and reporting (preventive care, chronic disease management, post-procedure surveillance, care gap closure, immunization, screening, wellness). [ENUM-REF-CANDIDATE: preventive_care|chronic_disease_management|post_procedure_surveillance|care_gap_closure|immunization|screening|wellness — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:RecallList ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recallCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Recall Completion Date' ;
    rdfs:comment 'Date when the recall was completed (patient attended the appointment and received the service).' ;
    rdfs:domain ind:RecallList ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:recallExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Recall Expiration Date' ;
    rdfs:comment 'Date after which the recall is considered expired and may be closed or escalated. Typically set based on quality measure reporting deadlines or clinical urgency.' ;
    rdfs:domain ind:RecallList ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:recallIntervalMonths rdf:type rdf:Property ;
    rdfs:label 'Recall Interval Months' ;
    rdfs:comment 'The standard recall interval in months for this type of service or condition (e.g., 12 months for annual wellness visit, 6 months for diabetes A1C, 24 months for colonoscopy follow-up).' ;
    rdfs:domain ind:RecallList ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:recallReasonCode rdf:type rdf:Property ;
    rdfs:label 'Recall Reason Code' ;
    rdfs:comment 'Standardized code representing the recall reason. May use SNOMED CT, LOINC, or internal coding system to classify the type of recall.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:starMeasureApplicable rdf:type rdf:Property ;
    rdfs:label 'Star Measure Applicable' ;
    rdfs:comment 'Indicates whether this recall is applicable to Medicare STAR quality ratings for Medicare Advantage plans.' ;
    rdfs:domain ind:RecallList ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:recallListStatus rdf:type rdf:Property ;
    rdfs:label 'Recall List Status' ;
    rdfs:domain ind:RecallList ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetRecallDate rdf:type rdf:Property ;
    rdfs:label 'Target Recall Date' ;
    rdfs:comment 'The target date by which the patient should be recalled for the follow-up appointment or service. Calculated based on clinical guidelines and recall interval.' ;
    rdfs:domain ind:RecallList ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:transportationAssistanceNeeded rdf:type rdf:Property ;
    rdfs:label 'Transportation Assistance Needed' ;
    rdfs:comment 'Indicates whether the patient requires transportation assistance to attend the recall appointment. Supports Social Determinants of Health (SDOH) interventions.' ;
    rdfs:domain ind:RecallList ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:providerAvailabilityId rdf:type rdf:Property ;
    rdfs:label 'Provider Availability Id' ;
    rdfs:comment 'Unique identifier for the provider availability record. Primary key.' ;
    rdfs:domain ind:ProviderAvailability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:primaryProviderEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Provider Employee Id' ;
    rdfs:comment 'Identifier of the user who requested or created this availability record.' ;
    rdfs:domain ind:ProviderAvailability ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:providerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Provider Employee Id' ;
    rdfs:domain ind:ProviderAvailability ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:tertiaryProviderCancelledByUserEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Tertiary Provider Cancelled By User Employee Id' ;
    rdfs:comment 'Identifier of the user who cancelled this availability record.' ;
    rdfs:domain ind:ProviderAvailability ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:acceptsNewPatientsFlag rdf:type rdf:Property ;
    rdfs:label 'Accepts New Patients Flag' ;
    rdfs:domain ind:ProviderAvailability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:availabilityStatus rdf:type rdf:Property ;
    rdfs:label 'Availability Status' ;
    rdfs:comment 'Current status of the availability record in its lifecycle.' ;
    rdfs:domain ind:ProviderAvailability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:availabilityType rdf:type rdf:Property ;
    rdfs:label 'Availability Type' ;
    rdfs:comment 'The type of availability record: scheduled (normal working hours), on_call (available for urgent calls), blocked (time blocked for non-clinical work), vacation (time off), cme (Continuing Medical Education), administrative (administrative duties).' ;
    rdfs:domain ind:ProviderAvailability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bookedAppointments rdf:type rdf:Property ;
    rdfs:label 'Booked Appointments' ;
    rdfs:comment 'The current count of appointments already booked during this availability period. Used for capacity management.' ;
    rdfs:domain ind:ProviderAvailability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:coverageArea rdf:type rdf:Property ;
    rdfs:label 'Coverage Area' ;
    rdfs:comment 'Geographic or organizational coverage area for on-call availability. Examples: entire hospital, specific units, regional coverage.' ;
    rdfs:domain ind:ProviderAvailability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:endDatetime rdf:type rdf:Property ;
    rdfs:label 'End Datetime' ;
    rdfs:comment 'The date and time when the provider availability period ends. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.' ;
    rdfs:domain ind:ProviderAvailability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:endTime rdf:type rdf:Property ;
    rdfs:label 'End Time' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:maxAppointments rdf:type rdf:Property ;
    rdfs:label 'Max Appointments' ;
    rdfs:comment 'The maximum number of appointments that can be scheduled during this availability period. Null indicates no specific limit.' ;
    rdfs:domain ind:ProviderAvailability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:onCallType rdf:type rdf:Property ;
    rdfs:label 'On Call Type' ;
    rdfs:comment 'The type of on-call availability when availability_type is on_call: primary (first responder), backup (secondary coverage), home (available from home), hospital (on-site coverage).' ;
    rdfs:domain ind:ProviderAvailability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:overbookingAllowed rdf:type rdf:Property ;
    rdfs:label 'Overbooking Allowed' ;
    rdfs:comment 'Boolean indicator (True/False) whether overbooking beyond max_appointments is permitted during this availability period.' ;
    rdfs:domain ind:ProviderAvailability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:recurrenceEndDate rdf:type rdf:Property ;
    rdfs:label 'Recurrence End Date' ;
    rdfs:comment 'The date when a recurring availability pattern ends. Null for one-time availability records. Format: yyyy-MM-dd.' ;
    rdfs:domain ind:ProviderAvailability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:startTime rdf:type rdf:Property ;
    rdfs:label 'Start Time' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:unavailabilityReason rdf:type rdf:Property ;
    rdfs:label 'Unavailability Reason' ;
    rdfs:comment 'Free-text description of the reason for unavailability when availability_type is blocked, vacation, cme, or administrative. Examples: conference attendance, personal leave, training, committee meeting.' ;
    rdfs:domain ind:ProviderAvailability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unavailabilityReasonCode rdf:type rdf:Property ;
    rdfs:label 'Unavailability Reason Code' ;
    rdfs:comment 'Standardized code representing the reason for unavailability. Used for reporting and analytics.' ;
    rdfs:domain ind:ProviderAvailability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surgicalCaseTeamId rdf:type rdf:Property ;
    rdfs:label 'Surgical Case Team Id' ;
    rdfs:comment 'Unique identifier for the surgical case team assignment record. Primary key for this entity.' ;
    rdfs:domain ind:SurgicalCaseTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:primarySurgicalEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Surgical Employee Id' ;
    rdfs:comment 'System user identifier of the person who verified the team member\'s credentials and privileges for this case.' ;
    rdfs:domain ind:SurgicalCaseTeam ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:surgicalEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Surgical Employee Id' ;
    rdfs:domain ind:SurgicalCaseTeam ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:tertiarySurgicalCancelledByUserEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Tertiary Surgical Cancelled By User Employee Id' ;
    rdfs:comment 'System user identifier of the person who cancelled this team member assignment.' ;
    rdfs:domain ind:SurgicalCaseTeam ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:anesthesiologistNpi rdf:type rdf:Property ;
    rdfs:label 'Anesthesiologist Npi' ;
    rdfs:comment 'National Provider Identifier of the anesthesiologist or CRNA (Certified Registered Nurse Anesthetist) assigned to the case. Used for anesthesia billing and quality tracking. [Moved from surgical_case: This attribute represents the anesthesiologist clinician-case relationship. In the M:N model, this becomes a record in surgical_case_team with team_role_code=\'ANESTHESIOLOGIST\' or \'CRNA\'. The current model cannot represent cases with multiple anesthesia providers or CRNA+anesthesiologist teams.]' ;
    rdfs:domain ind:SurgicalCaseTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignmentDatetime rdf:type rdf:Property ;
    rdfs:label 'Assignment Datetime' ;
    rdfs:domain ind:SurgicalCaseTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assistingSurgeonNpi rdf:type rdf:Property ;
    rdfs:label 'Assisting Surgeon Npi' ;
    rdfs:comment 'National Provider Identifier of the assisting surgeon, if applicable. Used for billing assistant surgeon charges and documenting surgical team composition. [Moved from surgical_case: This attribute represents another specific clinician-case relationship (the assisting surgeon role). In the M:N model, this becomes a record in surgical_case_team with team_role_code=\'ASSISTING_SURGEON\'. The current model artificially limits cases to one assisting surgeon.]' ;
    rdfs:domain ind:SurgicalCaseTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:callStatus rdf:type rdf:Property ;
    rdfs:label 'Call Status' ;
    rdfs:comment 'Indicates whether the team member is scheduled, on-call, backup, or responding to an emergency for this case. Used for staffing and scheduling analytics.' ;
    rdfs:domain ind:SurgicalCaseTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryRoleFlag rdf:type rdf:Property ;
    rdfs:label 'Primary Role Flag' ;
    rdfs:comment 'Indicates whether this team member holds the primary responsibility for their role category (e.g., primary surgeon vs. assisting surgeon). True if primary, False if secondary or assisting.' ;
    rdfs:domain ind:SurgicalCaseTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:primarySurgeonName rdf:type rdf:Property ;
    rdfs:label 'Primary Surgeon Name' ;
    rdfs:comment 'Full name of the primary surgeon. Used for operational communication, patient information, and surgical schedule displays. [Moved from surgical_case: Denormalized display attribute derived from the primary surgeon relationship. Should be removed as it can be derived from the surgical_case_team association joined to clinician.]' ;
    rdfs:domain ind:SurgicalCaseTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primarySurgeonNpi rdf:type rdf:Property ;
    rdfs:label 'Primary Surgeon Npi' ;
    rdfs:comment 'National Provider Identifier of the primary surgeon responsible for the surgical case. Ten-digit unique identifier assigned by CMS. Used for credentialing, billing, and quality reporting. [Moved from surgical_case: This attribute represents one specific clinician-case relationship (the primary surgeon role). In the M:N model, this becomes a record in surgical_case_team with team_role_code=\'PRIMARY_SURGEON\'. Storing it as a single attribute on surgical_case violates normalization and prevents tracking multiple surgeons or role changes.]' ;
    rdfs:domain ind:SurgicalCaseTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:privilegeVerifiedFlag rdf:type rdf:Property ;
    rdfs:label 'Privilege Verified Flag' ;
    rdfs:domain ind:SurgicalCaseTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:qualityMeasureApplicableFlag rdf:type rdf:Property ;
    rdfs:label 'Quality Measure Applicable Flag' ;
    rdfs:comment 'Indicates whether this team member assignment is subject to quality measurement or reporting requirements. True if applicable, False otherwise.' ;
    rdfs:domain ind:SurgicalCaseTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reliefFlag rdf:type rdf:Property ;
    rdfs:label 'Relief Flag' ;
    rdfs:domain ind:SurgicalCaseTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:replacementTeamMemberNpi rdf:type rdf:Property ;
    rdfs:label 'Replacement Team Member Npi' ;
    rdfs:comment 'The NPI of the replacement team member if this assignment was substituted. Used to track last-minute staffing changes.' ;
    rdfs:domain ind:SurgicalCaseTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:roleStatus rdf:type rdf:Property ;
    rdfs:label 'Role Status' ;
    rdfs:domain ind:SurgicalCaseTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scrubTimeMinutes rdf:type rdf:Property ;
    rdfs:label 'Scrub Time Minutes' ;
    rdfs:comment 'Time in minutes spent by the team member in surgical scrub preparation. Applicable to scrubbed team members (surgeons, scrub techs).' ;
    rdfs:domain ind:SurgicalCaseTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:supervisingProviderNpi rdf:type rdf:Property ;
    rdfs:label 'Supervising Provider Npi' ;
    rdfs:comment 'The NPI of the attending physician or supervising provider if this team member is a resident, fellow, or student. Required for teaching case billing compliance.' ;
    rdfs:domain ind:SurgicalCaseTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:teachingCaseFlag rdf:type rdf:Property ;
    rdfs:label 'Teaching Case Flag' ;
    rdfs:comment 'Indicates whether this is a teaching case with resident or student participation under supervision. True if teaching case, False otherwise. Impacts billing and documentation requirements.' ;
    rdfs:domain ind:SurgicalCaseTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:teamMemberName rdf:type rdf:Property ;
    rdfs:label 'Team Member Name' ;
    rdfs:comment 'Full legal name of the care team member assigned to this surgical case. Used for case documentation and credentialing verification.' ;
    rdfs:domain ind:SurgicalCaseTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:teamMemberNpi rdf:type rdf:Property ;
    rdfs:label 'Team Member Npi' ;
    rdfs:comment 'The 10-digit National Provider Identifier for the team member assigned to this surgical case. Required for billing and credentialing verification.' ;
    rdfs:domain ind:SurgicalCaseTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:teamRole rdf:type rdf:Property ;
    rdfs:label 'Team Role' ;
    rdfs:domain ind:SurgicalCaseTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:teamRoleCode rdf:type rdf:Property ;
    rdfs:label 'Team Role Code' ;
    rdfs:comment 'Standardized code representing the role of the team member in the surgical case. Values: SURGEON (primary surgeon), CO_SURGEON (assisting surgeon), ANESTHESIOLOGIST (physician anesthesiologist), CRNA (Certified Registered Nurse Anesthetist), SCRUB_TECH (scrub technician), CIRCULATING_NURSE (circulating nurse). [ENUM-REF-CANDIDATE: SURGEON|CO_SURGEON|ANESTHESIOLOGIST|CRNA|SCRUB_TECH|CIRCULATING_NURSE|PERFUSIONIST|FIRST_ASSIST|SURGICAL_RESIDENT|ANESTHESIA_RESIDENT|STUDENT_NURSE — promote to reference product]' ;
    rdfs:domain ind:SurgicalCaseTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:teamRoleDescription rdf:type rdf:Property ;
    rdfs:label 'Team Role Description' ;
    rdfs:comment 'Human-readable description of the team member\'s role and responsibilities during the surgical case.' ;
    rdfs:domain ind:SurgicalCaseTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:timeInRoomMinutes rdf:type rdf:Property ;
    rdfs:label 'Time In Room Minutes' ;
    rdfs:comment 'Total time in minutes that the team member spent in the operating room for this case. Used for efficiency and utilization analysis.' ;
    rdfs:domain ind:SurgicalCaseTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:bookingQueueId rdf:type rdf:Property ;
    rdfs:label 'Booking Queue Id' ;
    rdfs:comment 'Primary key for booking_queue' ;
    rdfs:domain ind:BookingQueue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:bookingAppointmentTypeId rdf:type rdf:Property ;
    rdfs:label 'Booking Appointment Type Id' ;
    rdfs:domain ind:BookingQueue ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AppointmentType .

ind:bookingClinicianId rdf:type rdf:Property ;
    rdfs:label 'Booking Clinician Id' ;
    rdfs:domain ind:BookingQueue ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:bookingRequestedAppointmentTypeId rdf:type rdf:Property ;
    rdfs:label 'Booking Requested Appointment Type Id' ;
    rdfs:comment 'Reference to the type of appointment being requested. Links to appointment type reference data for scheduling parameters.' ;
    rdfs:domain ind:BookingQueue ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AppointmentType .

ind:bookingWorkforceOrgUnitId rdf:type rdf:Property ;
    rdfs:label 'Booking Workforce Org Unit Id' ;
    rdfs:domain ind:BookingQueue ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:OrgUnit .

ind:primaryBookingClinicianId rdf:type rdf:Property ;
    rdfs:label 'Primary Booking Clinician Id' ;
    rdfs:comment 'Reference to the provider who initiated the scheduling request or referral. Links to provider master data.' ;
    rdfs:domain ind:BookingQueue ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:primaryBookingRequestedDepartmentWorkforceOrgUnitId rdf:type rdf:Property ;
    rdfs:label 'Primary Booking Requested Department Workforce Org Unit Id' ;
    rdfs:comment 'Reference to the specific department or clinic within the facility where the appointment is requested.' ;
    rdfs:domain ind:BookingQueue ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:OrgUnit .

ind:agingDays rdf:type rdf:Property ;
    rdfs:label 'Aging Days' ;
    rdfs:comment 'Number of calendar days the queue entry has been open since queue entry datetime. Used for aging reports and escalation triggers.' ;
    rdfs:domain ind:BookingQueue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:assignedToUserName rdf:type rdf:Property ;
    rdfs:label 'Assigned To User Name' ;
    rdfs:domain ind:BookingQueue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:currentDepth rdf:type rdf:Property ;
    rdfs:label 'Current Depth' ;
    rdfs:domain ind:BookingQueue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:enqueuedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Enqueued Timestamp' ;
    rdfs:domain ind:BookingQueue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:processedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Processed Timestamp' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:queueCode rdf:type rdf:Property ;
    rdfs:label 'Queue Code' ;
    rdfs:domain ind:BookingQueue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:queueNumber rdf:type rdf:Property ;
    rdfs:label 'Queue Number' ;
    rdfs:comment 'Human-readable business identifier for the queue entry. Used for tracking and reference by scheduling staff.' ;
    rdfs:domain ind:BookingQueue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:queueStatus rdf:type rdf:Property ;
    rdfs:label 'Queue Status' ;
    rdfs:comment 'Current lifecycle status of the queue entry. Tracks progression through the scheduling workflow from initial entry to resolution.' ;
    rdfs:domain ind:BookingQueue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:queueType rdf:type rdf:Property ;
    rdfs:label 'Queue Type' ;
    rdfs:comment 'Classification of the scheduling queue entry by source or purpose. Determines workflow routing and handling procedures.' ;
    rdfs:domain ind:BookingQueue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:routingRule rdf:type rdf:Property ;
    rdfs:label 'Routing Rule' ;
    rdfs:domain ind:BookingQueue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:slaTargetHours rdf:type rdf:Property ;
    rdfs:label 'Sla Target Hours' ;
    rdfs:domain ind:BookingQueue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waitTimeMinutes rdf:type rdf:Property ;
    rdfs:label 'Wait Time Minutes' ;
    rdfs:domain ind:BookingQueue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:equipmentReservationId rdf:type rdf:Property ;
    rdfs:label 'Equipment Reservation Id' ;
    rdfs:comment 'Unique identifier for the equipment reservation record. Primary key.' ;
    rdfs:domain ind:EquipmentReservation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:primaryEquipmentEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Equipment Employee Id' ;
    rdfs:comment 'Reference to the system user who confirmed the equipment reservation. Links to user or staff master data for audit trail.' ;
    rdfs:domain ind:EquipmentReservation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:reservedMaterialMasterId rdf:type rdf:Property ;
    rdfs:label 'Reserved Material Master Id' ;
    rdfs:comment 'Foreign key linking to supply.material_master. Business justification: Reservable equipment includes supply-chain-managed portable devices, instruments, and consumable kits tracked as material master items (not fixed assets). Enables unified asset tracking, maintenance s' ;
    rdfs:domain ind:EquipmentReservation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MaterialMaster .

ind:tertiaryEquipmentRequestedByUserEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Tertiary Equipment Requested By User Employee Id' ;
    rdfs:comment 'Reference to the system user who created the equipment reservation request. Links to user or staff master data for audit trail.' ;
    rdfs:domain ind:EquipmentReservation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:reservationNumber rdf:type rdf:Property ;
    rdfs:label 'Reservation Number' ;
    rdfs:comment 'Human-readable business identifier for the equipment reservation. Externally visible tracking number used by clinical and operational staff.' ;
    rdfs:domain ind:EquipmentReservation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reservationPriority rdf:type rdf:Property ;
    rdfs:label 'Reservation Priority' ;
    rdfs:comment 'Clinical priority level of the equipment reservation. Determines scheduling precedence and conflict resolution rules.' ;
    rdfs:domain ind:EquipmentReservation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reservationStatus rdf:type rdf:Property ;
    rdfs:label 'Reservation Status' ;
    rdfs:comment 'Current lifecycle status of the equipment reservation. Tracks the reservation from initial request through completion or cancellation. [ENUM-REF-CANDIDATE: requested|pending_approval|confirmed|in_use|released|cancelled|conflict|on_hold — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:EquipmentReservation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reservationType rdf:type rdf:Property ;
    rdfs:label 'Reservation Type' ;
    rdfs:domain ind:EquipmentReservation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reservedEndDatetime rdf:type rdf:Property ;
    rdfs:label 'Reserved End Datetime' ;
    rdfs:domain ind:EquipmentReservation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reservedStartDatetime rdf:type rdf:Property ;
    rdfs:label 'Reserved Start Datetime' ;
    rdfs:domain ind:EquipmentReservation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sterilizationClearanceDatetime rdf:type rdf:Property ;
    rdfs:label 'Sterilization Clearance Datetime' ;
    rdfs:comment 'Date and time when the equipment was cleared as sterile and available for use. Critical for infection prevention and equipment readiness.' ;
    rdfs:domain ind:EquipmentReservation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:sterilizationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Sterilization Required Flag' ;
    rdfs:comment 'Indicates whether the equipment requires sterilization before or after use. Critical for infection control and equipment availability planning.' ;
    rdfs:domain ind:EquipmentReservation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:caseMaterialUsageId rdf:type rdf:Property ;
