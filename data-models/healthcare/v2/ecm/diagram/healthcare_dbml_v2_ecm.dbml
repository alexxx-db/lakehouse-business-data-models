  message_log_id varchar [note: 'FK to message log']
  primary_radiology_report_id varchar [note: 'FK to radiology report']
  recipient_clinician_id varchar [note: 'Clinician who is the intended recipient of the distributed report.']
  report_care_site_id varchar [note: 'Facility associated with the distribution destination.']
  report_recipient_care_site_id varchar [note: 'Care site recipient of report']
  routing_rule_id varchar [note: 'Added to expand thin product order.report_distribution']
  trading_partner_id varchar [note: 'FK to trading partner']
  acknowledged_at timestamp [note: 'Added to expand thin product radiology.report_distribution']
  acknowledged_flag boolean
  acknowledged_timestamp timestamp
  acknowledgment_code varchar [note: 'Acknowledgment code']
  acknowledgment_status varchar
  acknowledgment_timestamp timestamp
  attachment_count varchar [note: 'Number of attachments included with report']
  attachment_included_flag boolean [note: 'Added to expand thin product radiology.report_distribution']
  consent_verified_flag boolean [note: 'Whether patient consent for distribution was verified']
  created_timestamp timestamp [note: 'Timestamp when the distribution record was created.']
  critical_result_flag boolean [note: 'Whether report contains critical results requiring immediate notification']
  delivered_at timestamp [note: 'Added to expand thin product radiology.report_distribution']
  delivered_timestamp timestamp [note: 'Delivered timestamp']
  delivery_attempt_count varchar [note: 'Added to expand thin product radiology.report_distribution']
  delivery_confirmed_flag boolean
  delivery_failure_reason varchar
  delivery_latency_seconds varchar [note: 'Added to expand thin product with domain-appropriate detail.']
  delivery_method varchar
  delivery_status varchar [note: 'Delivery status']
  delivery_timestamp timestamp
  distribution_batch_number varchar [note: 'Added to expand thin product with domain-appropriate detail.']
  distribution_channel varchar [note: 'Added to expand thin product radiology.report_distribution']
  distribution_method varchar [note: 'Method used to distribute the report (e.g., HL7, fax, Direct message, portal).']
  distribution_notes varchar [note: 'Notes about distribution']
  distribution_priority varchar [note: 'Priority of distribution (routine, urgent, stat)']
  distribution_status varchar
  distribution_timestamp timestamp
  document_format varchar [note: 'Document format']
  encryption_method varchar [note: 'Encryption method used for secure transmission']
  error_message varchar [note: 'Error message']
  escalation_flag boolean [note: 'Added to expand thin product with domain-appropriate detail.']
  escalation_timestamp timestamp [note: 'Added to expand thin product with domain-appropriate detail.']
  external_system_reference varchar [note: 'Reference ID in external distribution system']
  extra_attr_1 varchar
  extra_attr_2 varchar
  extra_attr_3 varchar
  extra_attr_4 varchar
  extra_attr_5 varchar
  failed_reason varchar [note: 'Added to expand thin product radiology.report_distribution']
  failure_reason varchar
  priority varchar [note: 'Priority level of the distribution (e.g., stat, routine).']
  priority_level varchar [note: 'Priority level of distribution']
  read_confirmation_timestamp timestamp [note: 'Timestamp when recipient confirmed reading']
  read_receipt_requested boolean [note: 'Whether read receipt was requested']
  read_receipt_timestamp timestamp [note: 'Timestamp when recipient acknowledged reading report']
  recipient_email varchar [note: 'Email address used for report distribution.']
  recipient_fax varchar [note: 'Fax number of recipient']
  recipient_fax_number varchar [note: 'Fax number used for report distribution.']
  recipient_name varchar
  recipient_npi varchar
  recipient_organization varchar [note: 'Added to expand thin product with domain-appropriate detail.']
  recipient_reference varchar [note: 'Added to expand thin product radiology.report_distribution']
  recipient_type varchar [note: 'Type of recipient (provider, facility, patient)']
  retry_count varchar [note: 'Retry count']
  sent_timestamp timestamp
  sla_compliance_flag boolean [note: 'Whether SLA compliant']
  transmission_timestamp timestamp [note: 'Transmission timestamp']
  updated_timestamp timestamp [note: 'Record last update timestamp']
  vibe_expanded_flag boolean [note: 'Flag added by VIBE batch to expand thin product attribute set.']
  vibe_mutation_applied varchar [note: 'Added by VIBE mutation to ensure model change']
  vibe_mutation_flag boolean [note: 'Flag added by VIBE mutator to ensure product is touched']
  vibe_structure_marker varchar [note: 'Marks product as part of the required ECM structure.']
  viewed_timestamp timestamp [note: 'When recipient viewed the report']

  Note: 'This association product represents the distribution event between radiology reports and external trading partners. It captures the transmission of a finalized radiology report to an external entity (HIE, referring provider, specialist, payer, patient portal) via interoperability standards. Each record links one report to one trading partner with transmission metadata, delivery status, acknowledgment tracking, and SLA compliance monitoring that exist only in the context of this specific distribution event.. Existence Justification: In healthcare interoperability operations, a single finalized radiology report is routinely distributed to multiple external trading partners (referring providers, specialists, HIEs, patient portals, payers) based on care coordination needs, regulatory requirements, and data sharing agreements. Each trading partner may receive hundreds or thousands of reports over time. The distribution relationship is an operational business process actively managed by interoperability teams, tracking transmission status, acknowledgments, retries, and SLA compliance per partner per report.'
}

