    rdfs:comment 'Current status of the pharmacy\'s participation in this network. Active means pharmacy is currently in-network and accepting claims. Inactive means participation has ended. Suspended means temporarily not accepting network claims. Pending means contract signed but not yet effective.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

