    rdfs:domain ind:TreatmentTechnology ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TreatmentTechnology .

ind:parentLaborUnionId rdf:type rdf:Property ;
    rdfs:label 'Parent Labor Union Id' ;
