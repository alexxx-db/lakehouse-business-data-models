    rdfs:range xsd:decimal .

ind:costNet rdf:type rdf:Property ;
    rdfs:label 'Cost Net' ;
    rdfs:comment 'Net cost after adjustments.' ;
    rdfs:domain ind:CustomerComplaint ;
