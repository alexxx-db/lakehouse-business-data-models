// DBML Schema for Business: Health_Insurance
// Version: 3
// Generated on: 2026-07-10 22:45:21

Project {
  database_type: 'Databricks Unity Catalog'
  Note: 'Lakehouse data model for Health_Insurance - Version 3'
}

Table member.subscriber {
  subscriber_id varchar [pk, note: 'Primary key for subscriber']
  group_location_id varchar [note: 'Foreign key linking to employer.group_location. Business justification: Multi-site employers assign subscribers to specific group locations for rating area determination, on-site clinic access, and location-based benefit administration. This link enables location-level en']
  health_plan_id varchar [note: 'Reference to the health plan product.']
  primary_care_coordinator_id varchar [note: 'Foreign key linking to care.care_coordinator. Business justification: Primary Care Coordinator Assignment: case‑management reports need each subscriber linked to their assigned care coordinator.']
  primary_provider_id varchar [note: 'Foreign key linking to provider.provider_provider. Business justification: REQUIRED: Primary Care Provider assignment for each subscriber is needed for care coordination, network adequacy reporting, and member portal display.']
  annual_income decimal(12,2) [note: 'Subscriber\'s reported annual income (for subsidy eligibility).']
  chip_number varchar [note: 'Children\'s Health Insurance Program identifier.']
  citizenship_status varchar [note: 'Legal citizenship or residency status.']
  cob_indicator varchar [note: 'Indicates subscriber\'s position in coordination of benefits.']
  consent_to_electronic_communication boolean [note: 'Subscriber\'s consent to receive electronic communications.']
  coverage_type varchar [note: 'Type of health plan coverage.']
  created_timestamp timestamp [note: 'Timestamp when the subscriber record was created.']
  date_of_birth date [note: 'Subscriber\'s birth date.']
  disability_status varchar [note: 'Indicates if subscriber has a disability.']
  effective_date date [note: 'Date when subscriber coverage becomes effective.']
  enrollment_source varchar [note: 'Channel through which subscriber enrolled.']
  first_name varchar [note: 'Subscriber\'s given name.']
  gender varchar [note: 'Subscriber\'s gender as reported.']
  hcc_score decimal(5,2) [note: 'Aggregated HCC score for the subscriber.']
  is_deceased boolean [note: 'Flag indicating if subscriber is deceased.']
  language_preference varchar [note: 'Preferred language for communications.']
  last_name varchar [note: 'Subscriber\'s family name.']
  line_of_business varchar [note: 'Business line the subscriber belongs to.']
  marital_status varchar [note: 'Subscriber\'s marital status.']
  medicaid_number varchar [note: 'State Medicaid identifier.']
  medicare_beneficiary_number varchar [note: 'Unique identifier for Medicare beneficiaries.']
  middle_name varchar [note: 'Subscriber\'s middle name (if any).']
  number varchar [note: 'External contract number assigned to the subscriber.']
  primary_contact_method varchar [note: 'Preferred method for contacting subscriber.']
  race_ethnicity varchar [note: 'Self-reported race/ethnicity for reporting.']
  risk_adjustment_factor decimal(5,4) [note: 'Factor used for risk adjustment calculations.']
  ssn varchar [note: 'Subscriber\'s Social Security Number.']
  subscriber_status varchar [note: 'Current lifecycle status of the subscriber.']
  termination_date date [note: 'Date when subscriber coverage ends (if applicable).']
  tobacco_use_status varchar [note: 'Subscriber\'s tobacco use status.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the subscriber record.']
  veteran_status boolean [note: 'Indicates if subscriber is a veteran.']

  Note: 'Core master entity representing the primary insured individual (subscriber/policyholder) who holds the health insurance contract. Captures full demographic identity including SSN, date of birth, gender, marital status, language preference, race/ethnicity (for HEDIS/CMS reporting), tobacco use status, disability status, and Medicare/Medicaid beneficiary identifiers. Serves as the SSOT for subscriber identity across commercial, Medicare Advantage, Medicaid, and CHIP lines of business. All dependent, eligibility, and benefit records reference this entity. Supports HIPAA PHI/PII obligations, CMS enrollment reporting, and X12 834 subscriber loop requirements.'
}

Table member.dependent {
  dependent_id varchar [pk, note: 'Primary key for dependent']
  benefit_package_id varchar [note: 'Foreign key linking to plan.benefit_package. Business justification: Dependents may be enrolled in different benefit packages than the subscriber (e.g., pediatric-only dental/vision packages, CHIP benefit packages). Benefit determination and cost-sharing calculations f']
  contact_id varchar [note: 'Foreign key linking to member.member_contact. Business justification: member_contact is the single source of truth for all member contact information and addresses. The dependent table currently stores inline contact and address fields (address_line1, address_line2, cit']
  identity_id varchar [note: 'Foreign key linking to member.identity. Business justification: The identity table is the authoritative identity resolution record for each unique insured individual — explicitly covering both subscribers AND dependents (identity.member_type and identity.relations']
  subscriber_id varchar [note: 'Identifier of the primary member (subscriber) to whom this dependent is attached.']
  age_out_eligibility_flag boolean [note: 'True if the dependent is eligible for age-out coverage under plan rules.']
  chip_eligibility_flag boolean [note: 'Indicates eligibility for the Children\'s Health Insurance Program.']
  country varchar [note: 'Three-letter ISO country code of residence.']
  coverage_end_date date [note: 'Date when dependent\'s coverage terminated or is scheduled to end.']
  coverage_start_date date [note: 'Date when dependent\'s coverage became effective.']
  coverage_status varchar [note: 'Current status of the dependent\'s coverage.']
  created_timestamp timestamp [note: 'Timestamp when the dependent record was first created in the system.']
  date_of_birth date [note: 'Birth date of the dependent.']
  disability_status boolean [note: 'Indicates if the dependent has a documented disability.']
  first_name varchar [note: 'Given name of the dependent.']
  gender varchar [note: 'Gender of the dependent as reported.']
  is_primary_contact boolean [note: 'Indicates if this dependent is the primary contact for the subscriber\'s household.']
  language_preference varchar [note: 'Preferred language for communications with the dependent.']
  last_name varchar [note: 'Family name of the dependent.']
  medicaid_eligibility_flag boolean [note: 'Indicates eligibility for Medicaid program.']
  middle_name varchar [note: 'Middle name or initial of the dependent.']
  record_status varchar [note: 'Lifecycle status of the record itself.']
  relationship_end_date date [note: 'Date when the dependent relationship ended, if applicable.']
  relationship_start_date date [note: 'Date when the dependent relationship became effective.']
  relationship_type varchar [note: 'Legal relationship of the dependent to the subscriber.']
  sequence_number varchar [note: 'Ordinal number to differentiate multiple dependents of same relationship type.']
  ssn varchar [note: 'Government-issued identifier for the dependent.']
  student_status boolean [note: 'Indicates if the dependent is currently a student (True) or not (False).']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the dependent record.']

  Note: 'Master entity representing individuals covered under a subscriber\'s health plan — spouses, domestic partners, children, and other qualifying dependents. Tracks relationship type to subscriber, dependent sequence number, student status, disability status, age-out eligibility rules, and CHIP/Medicaid eligibility indicators. Maintains its own demographic profile including DOB, gender, SSN, and language preference. Supports dependent verification workflows, age-out processing, and CMS CHIP enrollment reporting. Each dependent record is linked to a subscriber and an enrollment span.'
}

Table member.identity {
  identity_id varchar [pk, note: 'Primary key for identity']
  subscriber_id varchar [note: 'Identifier assigned by the health plan to the member (e.g., commercial member ID, MBI for Medicare).']
  address_line1 varchar [note: 'First line of the member\'s mailing address.']
  address_line2 varchar [note: 'Second line of the member\'s mailing address (if applicable).']
  citizenship_status varchar [note: 'Citizenship or residency status relevant for eligibility and reporting.']
  city varchar [note: 'City component of the member\'s mailing address.']
  country varchar [note: 'Three‑letter ISO country code of the member\'s residence.']
  coverage_end_date date [note: 'Date when the member\'s coverage terminated or is scheduled to end.']
  coverage_start_date date [note: 'Date when the member\'s coverage became effective.']
  created_timestamp timestamp [note: 'Timestamp when the identity record was first created in the system.']
  date_of_birth date [note: 'Member\'s birth date, used for age‑based eligibility and risk calculations.']
  eligibility_status varchar [note: 'Current eligibility determination for benefits coverage.']
  email varchar [note: 'Primary email address used for member communications and portal login.']
  enrollment_effective_date date [note: 'Date the member\'s enrollment into the plan became effective.']
  ethnicity varchar [note: 'Member\'s ethnicity as reported for demographic reporting.']
  external_subscriber_number varchar [note: 'Identifier from an external source such as employer payroll or third‑party administrator.']
  first_name varchar [note: 'Member\'s given (first) name.']
  full_name varchar [note: 'Complete legal name of the member as it appears on official documents.']
  gender varchar [note: 'Self‑identified gender of the member.']
  language_preference varchar [note: 'Primary language the member prefers for communications.']
  last_name varchar [note: 'Member\'s family (last) name.']
  lob varchar [note: 'Business line (e.g., commercial, Medicare) to which the member belongs.']
  marital_status varchar [note: 'Member\'s marital status for demographic and eligibility purposes.']
  member_status varchar [note: 'Overall lifecycle status of the member within the health plan.']
  member_type varchar [note: 'Indicates whether the record represents a primary subscriber or a dependent.']
  middle_name varchar [note: 'Member\'s middle name(s), if any.']
  phone_number varchar [note: 'Primary telephone number for member contact.']
  postal_code varchar [note: 'ZIP or postal code of the member\'s mailing address.']
  primary_contact_method varchar [note: 'Preferred channel for member communications.']
  race varchar [note: 'Member\'s race classification for HEDIS and regulatory reporting.']
  relationship_to_subscriber varchar [note: 'Describes the member\'s relationship to the primary subscriber.']
  risk_score decimal(5,2) [note: 'Calculated risk score used for underwriting and care management.']
  source_system_record_code varchar [note: 'Unique identifier of the source record in the originating system.']
  ssn_hash varchar [note: 'Hashed Social Security Number used for identity matching while protecting PII.']
  state varchar [note: 'State or province component of the member\'s mailing address (2‑letter code).']
  termination_date date [note: 'Date the member\'s relationship with the plan was terminated.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the identity record.']
  verification_date date [note: 'Date on which the member\'s identity was successfully verified.']
  verification_status varchar [note: 'Current status of the member\'s identity verification process.']

  Note: 'Authoritative identity resolution record for each unique insured individual (subscriber or dependent) assigned a unique member ID by the health plan. Stores the plan-assigned member ID (MBI for Medicare, Medicaid ID, commercial member ID), cross-reference IDs from source systems (Facets member ID, QNXT ID), alternate IDs (SSN hash, external subscriber ID from employer), and identity verification status. Manages member ID history and superseded IDs. This is the enterprise golden record for member identity used by all downstream domains (claims, pharmacy, care management) to resolve member identity.'
}

Table member.contact {
  contact_id varchar [pk, note: 'System-generated unique identifier for each contact record associated with a member.']
  member_subscriber_id varchar [note: 'add column member_subscriber_id (BIGINT) with FK to member.subscriber.subscriber_id - member contacts must link to the subscriber they represent']
  address_cass_certified boolean [note: 'True if the address has passed USPS CASS certification.']
  address_effective_date date [note: 'Date when the address became effective for the member.']
  address_geocode_accuracy varchar [note: 'Indicates the confidence level of the geocoding result.']
  address_geocode_source varchar [note: 'System used to generate latitude/longitude for the address.']
  address_line1 varchar [note: 'Primary street address line.']
  address_line2 varchar [note: 'Secondary street address line (apartment, suite, etc.).']
  address_priority_rank varchar [note: 'Numeric rank indicating the order of address preference for the member.']
  address_source_system varchar [note: 'Source system that originally supplied the address record.']
  address_termination_date date [note: 'Date when the address was terminated or superseded.']
  address_type varchar [note: 'Purpose of the address (e.g., home, mailing, temporary).']
  address_verification_status varchar [note: 'USPS CASS certification status of the address.']
  census_tract varchar [note: 'Eleven‑digit census tract identifier for geographic analysis.']
  city varchar [note: 'City of the address.']
  contact_type varchar [note: 'Classification of the contact relationship to the member.']
  country_code varchar [note: 'Three‑letter ISO country code of the address.']
  county_fips varchar [note: 'Five‑digit Federal Information Processing Standard code for the county.']
  created_timestamp timestamp [note: 'Date and time when the contact record was first created.']
  email_address varchar [note: 'Primary electronic mail address for the contact.']
  fax_number varchar [note: 'Fax number for the contact.']
  id_type varchar [note: 'Type of identifier used for the contact (e.g., NPI, SSN).']
  id_value decimal(18,2) [note: 'The actual identifier value corresponding to contact_id_type.']
  is_primary_contact boolean [note: 'Indicates whether this record is the member\'s primary contact.']
  language_preference varchar [note: 'Member\'s preferred language for communications.']
  last_verified_timestamp timestamp [note: 'Timestamp of the most recent address verification event.']
  latitude decimal(9,6) [note: 'Geographic latitude of the address in decimal degrees.']
  longitude decimal(9,6) [note: 'Geographic longitude of the address in decimal degrees.']
  member_contact_status varchar [note: 'Current lifecycle status of the contact record.']
  name varchar [note: 'Legal full name of the contact person (member, dependent, or other party).']
  notes varchar [note: 'Free‑form notes related to the contact (e.g., preferred call times).']
  opt_in_email boolean [note: 'Indicates whether the member has consented to receive email communications.']
  opt_in_robocall boolean [note: 'Indicates whether the member permits automated voice calls.']
  opt_in_sms boolean [note: 'Indicates whether the member has consented to receive SMS messages.']
  phone_home varchar [note: 'Primary residential telephone number.']
  phone_mobile varchar [note: 'Cellular telephone number for mobile contact.']
  phone_work varchar [note: 'Telephone number associated with the contact\'s place of work.']
  postal_code varchar [note: 'Postal or ZIP code for the address.']
  preferred_contact_method varchar [note: 'Contact channel the member prefers for communications.']
  relationship varchar [note: 'Relationship of the contact to the member.']
  state_province varchar [note: 'State or province component of the address.']
  tcp_a_consent_flag boolean [note: 'True if the contact has provided consent under the Telephone Consumer Protection Act.']
  updated_timestamp timestamp [note: 'Date and time of the most recent update to the contact record.']

  Note: 'Single source of truth for all member contact information and addresses. Manages physical and mailing addresses (home, mailing, temporary, employer), phone numbers (home, mobile, work), email addresses, and fax numbers. Tracks contact type, address type, effective and termination dates, address verification status (USPS CASS-certified), county FIPS code, census tract, geographic coordinates for network adequacy analysis, opt-in/opt-out status per channel (SMS, email, robocall), TCPA consent flags, and preferred contact method and language. Supports multiple concurrent addresses with priority ranking. Used for premium billing, EOB mailing, provider directory access, CMS geographic reporting, member services outreach, care management communications, and CAHPS survey administration. Maintains full address and contact history for audit and compliance purposes.'
}

Table member.pcp_assignment {
  pcp_assignment_id varchar [pk, note: 'Primary key for pcp_assignment']
  benefit_package_id varchar [note: 'Foreign key linking to plan.benefit_package. Business justification: Benefit packages define PCP assignment requirements (e.g., mandatory PCP for HMO benefit packages). Linking pcp_assignment to benefit_package enables benefit-package-level PCP compliance reporting and']
  capitation_arrangement_id varchar [note: 'Foreign key linking to contract.capitation_arrangement. Business justification: PCPs under capitation contracts have their panel members attributed through PCP assignments. Linking pcp_assignment to capitation_arrangement enables accurate PMPM payment calculation per PCP panel, s']
  contract_provider_contract_id varchar [note: 'Foreign key linking to contract.provider_contract. Business justification: Required for compliance check that a PCP assignment respects an active provider contract; ensures network participation rules are enforced during PCP selection.']
  health_plan_id varchar [note: 'Foreign key linking to plan.health_plan. Business justification: PCP assignments are plan-specific — HMO plans require PCP assignment while PPO plans do not. Plan-level PCP panel management, network adequacy reporting, and auto-assignment logic all require knowing ']
  member_subscriber_id varchar [note: 'Unique identifier of the member to whom the PCP is assigned.']
  par_agreement_id varchar [note: 'Foreign key linking to network.par_agreement. Business justification: PCP assignment workflows must verify the specific PAR agreement under which the PCP participates in the network, supporting continuity of care, credentialing status checks, and contract compliance. Th']
  pcp_provider_id varchar [note: 'Foreign key linking to provider.provider_provider. Business justification: REQUIRED: PCP assignment records must reference the provider entity to support network participation audits and accurate provider‑member linkage.']
  practice_location_id varchar [note: 'Foreign key linking to provider.practice_location. Business justification: PCP assignments must specify WHICH office location the member is assigned to, since a provider can have multiple practice locations. Network adequacy reporting, member directory display, and care coor']
  provider_assignment_id varchar [note: 'Foreign key linking to network.provider_assignment. Business justification: Panel management requires linking a member\'s PCP assignment to the provider\'s network.provider_assignment record to verify panel capacity, accepting_new_patients_flag, and panel_status before assignme']
  provider_network_id varchar [note: 'Identifier of the provider network to which the PCP belongs.']
  specialty_id varchar [note: 'Foreign key linking to provider.specialty. Business justification: pcp_assignment.pcp_specialty_code is a denormalized representation of provider.specialty. Linking to specialty normalizes this, enabling credentialing validation, HEDIS specialty reporting, and networ']
  tier_id varchar [note: 'Foreign key linking to network.tier. Business justification: PCP assignments in tiered networks must record the PCP\'s tier to calculate member cost-sharing and steerage incentives. The existing network_tier plain-text column is a denormalization of network.tier']
  assignment_reason varchar [note: 'Free‑text explanation for why the PCP was assigned (e.g., member request, network requirement).']
  assignment_status varchar [note: 'Current lifecycle status of the PCP assignment.']
  assignment_type varchar [note: 'Method by which the PCP was assigned: member‑selected, auto‑assigned by system, or plan‑assigned.']
  change_reason varchar [note: 'Reason for a change to the PCP assignment (e.g., member relocation, provider departure).']
  change_timestamp timestamp [note: 'Exact time when the most recent change to the assignment was recorded.']
  created_timestamp timestamp [note: 'Timestamp when the PCP assignment record was first created in the system.']
  effective_date date [note: 'Date when the PCP assignment becomes effective for the member.']
  is_current boolean [note: 'True if the assignment is the active PCP for the member at query time.']
  is_primary boolean [note: 'Indicates if this PCP is the member\'s primary provider when multiple assignments exist.']
  notes varchar [note: 'Additional free‑form comments or audit notes about the assignment.']
  panel_status varchar [note: 'Indicates whether the PCP is currently in the member\'s provider panel.']
  termination_date date [note: 'Date when the PCP assignment ends or is scheduled to end; null if still active.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the PCP assignment record.']

  Note: 'Tracks Primary Care Provider (PCP) assignments for members enrolled in HMO, POS, and other gatekeeper plan types. Records assigned PCP NPI, PCP effective and termination dates, assignment type (member-selected, auto-assigned, plan-assigned), PCP change reason, PCP panel status at time of assignment, and PCP network tier. Manages PCP change request history and auto-assignment rules for newborns and new enrollees. Used for care coordination, referral authorization, capitation payment calculation, and HEDIS PCP attribution. Integrates with provider and network domains.'
}

Table member.cob_record {
  cob_record_id varchar [pk, note: 'Primary key for cob_record']
  group_id varchar [note: 'Foreign key linking to employer.group. Business justification: Coordination of benefits processing must record the employee handling the COB record for compliance and audit.']
  health_plan_id varchar [note: 'Foreign key linking to plan.health_plan. Business justification: COB adjudication requires knowing which health_plan is primary/secondary to apply correct cost-sharing rules. Insurers must reference the specific plan whose benefits are being coordinated. Every COB ']
  member_subscriber_id varchar [note: 'Unique identifier of the member to whom this COB record belongs.']
  regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: Medicare Secondary Payer (MSP) rules and state COB regulations are specific regulatory obligations governing COB records. The existing \'is_msp_compliant\' column signals MSP regulatory dependency. Comp']
  birthday_rule_applicable boolean [note: 'Indicates whether the birthday rule is used to determine primary payer.']
  cob_order varchar [note: 'Sequencing of the carrier in the coordination of benefits hierarchy.']
  cob_status varchar [note: 'Current lifecycle status of the COB record.']
  cob_verification_date date [note: 'Date when the COB information was verified.']
  coordination_of_benefits_rule varchar [note: 'Rule applied to determine payer order (e.g., birthday rule).']
  created_timestamp timestamp [note: 'Timestamp when the COB record was first created in the data lake.']
  effective_date date [note: 'Date the COB coverage becomes effective.']
  is_msp_compliant boolean [note: 'Indicates compliance with Medicare Secondary Payer rules.']
  is_subrogation_flag boolean [note: 'True if the claim may be subject to subrogation based on this COB arrangement.']
  notes varchar [note: 'Free‑form notes or comments about the COB arrangement.']
  number varchar [note: 'Business identifier assigned to the COB record for external reference.']
  policy_type varchar [note: 'Classification of the other carrier policy.']
  termination_date date [note: 'Date the COB coverage ends or is terminated.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the COB record.']
  verification_method varchar [note: 'Method used to verify the COB information.']

  Note: 'Coordination of Benefits (COB) record tracking a member\'s other insurance coverage to prevent duplicate payment and ensure correct primary/secondary/tertiary payer sequencing. Captures other carrier name, other carrier member ID, other carrier group number, policy type (commercial, Medicare, Medicaid, auto, workers comp), COB order (primary/secondary/tertiary), effective and termination dates, birthday rule applicability, and COB verification date. Supports COB inquiry workflows, subrogation identification, and Medicare Secondary Payer (MSP) compliance. Used by claims adjudication for COB calculation.'
}

Table member.id_card {
  id_card_id varchar [pk, note: 'Surrogate primary key for the ID card record.']
  eligibility_span_id varchar [note: 'Foreign key linking to member.eligibility_span. Business justification: An ID card is issued to represent a member\'s active coverage for a specific eligibility period. Linking id_card to eligibility_span establishes the authoritative coverage period the card represents, e']
  formulary_id varchar [note: 'Foreign key linking to pharmacy.formulary. Business justification: Member ID cards display formulary-specific pharmacy benefit information (tier copays, BIN/PCN). Linking id_card to formulary enables member portal drug coverage lookups, formulary change notifications']
  group_id varchar [note: 'Foreign key linking to employer.group. Business justification: Member ID cards display the employer group number; group_number on id_card is a denormalized plain attribute. A proper FK to employer.group enforces referential integrity, enables group-level card iss']
  health_plan_id varchar [note: 'Foreign key linking to plan.health_plan. Business justification: ID cards are issued per health plan; linking enables tracking issuance per plan for regulatory reporting.']
  member_identity_id varchar [note: 'Unique identifier of the member to whom the card is issued.']
  pcp_provider_id varchar [note: 'Foreign key linking to provider.provider. Business justification: id_card.pcp_name is a denormalized copy of provider data used for card printing. A direct FK to provider.provider normalizes this, enabling real-time PCP name/contact retrieval for card generation and']
  tier_id varchar [note: 'Foreign key linking to network.tier. Business justification: ID card generation for tiered network plans requires the member\'s assigned tier to print correct copay amounts and tier labels. ID card printing systems must reference network.tier directly to populat']
  barcode varchar [note: 'Machine-readable barcode value encoded on the card.']
  card_format varchar [note: 'Delivery format of the card: physical plastic, digital image, or mobile app representation.']
  card_number varchar [note: 'The alphanumeric identifier printed on the ID card, used for member identification.']
  card_type varchar [note: 'Category of coverage the card provides (e.g., medical, dental).']
  card_version varchar [note: 'Version identifier for the card design/layout.']
  copay_amount decimal(10,2) [note: 'Standard copayment amount shown on the card for office visits.']
  created_timestamp timestamp [note: 'Timestamp when the card record was created in the system.']
  customer_service_phone varchar [note: 'Phone number printed on the card for member support.']
  delivery_confirmation_date date [note: 'Date when delivery of the card was confirmed.']
  delivery_method varchar [note: 'Method used to deliver the card to the member.']
  expiration_date date [note: 'Date after which the card is no longer valid.']
  external_system_code varchar [note: 'Identifier of the card record in the source operational system (e.g., Facets).']
  id_card_status varchar [note: 'Current lifecycle status of the card.']
  is_primary boolean [note: 'Indicates if this card is the member\'s primary ID card.']
  issue_date date [note: 'Date the card was originally issued to the member.']
  language_preference varchar [note: 'Member\'s preferred language for card language.']
  last_status_change_timestamp timestamp [note: 'Timestamp when the card status last changed.']
  magnetic_stripe_data varchar [note: 'Data encoded on the magnetic stripe of the physical card.']
  pharmacy_bin varchar [note: 'Bank Identification Number for pharmacy benefits.']
  pharmacy_group_number varchar [note: 'Group number used for pharmacy benefit routing.']
  pharmacy_pcn varchar [note: 'Processor Control Number for pharmacy claims.']
  replacement_date date [note: 'Date a replacement card was issued, if applicable.']
  replacement_reason varchar [note: 'Reason why the card was replaced.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the card record.']

  Note: 'Manages the issuance and tracking of member health insurance ID cards (physical and digital). Records card issue date, card type (medical, dental, vision, pharmacy, combined), card format (physical, digital/mobile), card status (active, replaced, lost/stolen, expired), plan name on card, group number, member ID displayed, PCP name (for HMO cards), copay amounts displayed, pharmacy BIN/PCN/Group numbers, and customer service phone numbers. Tracks card replacement requests, reason for replacement, and delivery confirmation. Supports member services ID card fulfillment workflows and digital ID card provisioning via member portal.'
}

Table member.policy {
  policy_id varchar [pk, note: 'Primary key for policy']
  benefit_package_id varchar [note: 'Foreign key linking to plan.benefit_package. Business justification: A policy\'s coverage terms are defined by a specific benefit package. Claims adjudication, prior authorization, and EOB generation all require knowing which benefit package governs the policy. Domain e']
  formulary_id varchar [note: 'Foreign key linking to pharmacy.formulary. Business justification: A member policy governs which formulary applies to pharmacy benefits. Pharmacy benefit administrators and member portals require direct policy-to-formulary resolution for benefit verification, member ']
  group_plan_offering_id varchar [note: 'Foreign key linking to employer.group_plan_offering. Business justification: A member policy is created from a specific employer group plan offering — the exact product selected during open enrollment. This link drives renewal processing, ACA affordability determination, emplo']
  identity_id varchar [note: 'Reference to the insured member associated with the policy.']
  parent_policy_id varchar [note: 'Self-referencing FK on policy (parent_policy_id)']
  rate_id varchar [note: 'Foreign key linking to plan.rate. Business justification: A policy\'s premium is calculated from a specific rate record. Linking policy to rate enables premium reconciliation, rate change impact analysis, and actuarial audits. The denormalized premium_amount/']
  subscriber_id varchar [note: 'Foreign key linking to member.subscriber. Business justification: Policy is a child of subscriber; adding subscriber_id FK establishes the 1:N relationship and removes the silo.']
  year_id varchar [note: 'Foreign key linking to plan.year. Business justification: Policies align to plan years for accumulator resets, ACA MLR reporting, and renewal processing. The plan year governs deductible reset dates and open enrollment eligibility. A domain expert would expe']
  coverage_end_date date [note: 'Date when coverage under the policy ends.']
  coverage_limit_amount decimal(18,2) [note: 'Maximum monetary limit for covered services under the policy.']
  coverage_limit_currency varchar [note: 'Currency code for the coverage limit amount.']
  coverage_limit_type varchar [note: 'Scope of the coverage limit (e.g., lifetime, annual).']
  coverage_start_date date [note: 'Date when coverage under the policy begins.']
  coverage_status varchar [note: 'Current status of the coverage portion of the policy.']
  coverage_type varchar [note: 'Type of coverage plan (e.g., HMO, PPO).']
  deductible_amount decimal(18,2) [note: 'Amount the insured must pay before coverage applies.']
  deductible_currency varchar [note: 'Currency code for the deductible amount.']
  effective_date date [note: 'Date when the policy becomes effective.']
  expiration_date date [note: 'Date when the policy expires if not renewed.']
  number varchar [note: 'Human-readable policy number assigned by the insurer.']
  out_of_pocket_max_amount decimal(18,2) [note: 'Maximum amount the insured pays in a benefit year.']
  out_of_pocket_max_currency varchar [note: 'Currency code for the out-of-pocket maximum amount.']
  policy_status varchar [note: 'Current lifecycle status of the policy.']
  policy_type varchar [note: 'Classification of the policy based on the insured entity type.']
  renewal_amount decimal(18,2) [note: 'Total amount paid for the policy renewal.']
  renewal_currency varchar [note: 'Currency code for the renewal amount.']
  renewal_date date [note: 'Date when the policy renewal was processed.']
  renewal_deductible_amount decimal(18,2) [note: 'Deductible portion of the renewal payment.']
  renewal_deductible_currency varchar [note: 'Currency code for the renewal deductible amount.']
  renewal_out_of_pocket_max_amount decimal(18,2) [note: 'Out-of-pocket maximum for the renewal period.']
  renewal_out_of_pocket_max_currency varchar [note: 'Currency code for the renewal out-of-pocket maximum amount.']
  renewal_premium_amount decimal(18,2) [note: 'Premium portion of the renewal payment.']
  renewal_premium_currency varchar [note: 'Currency code for the renewal premium amount.']
  renewal_status varchar [note: 'Current status of the policy renewal process.']
  termination_date date [note: 'Date when the policy was terminated.']
  termination_reason varchar [note: 'Reason for policy termination.']

  Note: 'Master reference table for policy. Referenced by policy_id.'
}

Table member.eligibility_span {
  eligibility_span_id varchar [pk, note: 'System-generated unique identifier for the eligibility span record.']
  benefit_package_id varchar [note: 'Identifier of the specific benefit package within the plan.']
  member_identity_id varchar [note: 'Unique identifier of the member to whom this eligibility span applies.']
  network_service_area_id varchar [note: 'Foreign key linking to network.service_area. Business justification: An eligibility span is fundamentally tied to a service area — regulatory filings, network adequacy reporting, and enrollment processing all require knowing which service area covers the member\'s eligi']
  policy_id varchar [note: 'Foreign key linking to member.policy. Business justification: An eligibility span represents a continuous period of health plan eligibility under a specific policy. policy is the master reference for coverage terms (deductible, out-of-pocket max, premium, covera']
  transaction_id varchar [note: 'Foreign key linking to enrollment.transaction. Business justification: Enrollment transaction processing: enrollment transactions (add, change, terminate) directly create or modify eligibility spans. This link supports retroactive adjustment processing, enrollment audit ']
  cobro_end_date date [note: 'End date of COBRA continuation coverage, if applicable.']
  cobro_start_date date [note: 'Start date of COBRA continuation coverage, if applicable.']
  coverage_type varchar [note: 'Type of coverage provided during the eligibility span.']
  created_timestamp timestamp [note: 'Timestamp when the eligibility span record was created in the system.']
  effective_date date [note: 'Date when the eligibility period becomes effective.']
  eligibility_source varchar [note: 'Origin of the eligibility information (e.g., EDI 834 file, manual entry).']
  eligibility_status varchar [note: 'Current status of the eligibility span.']
  enrollment_type varchar [note: 'Nature of the enrollment event that created this eligibility span.']
  gap_in_coverage_flag boolean [note: 'True if there is a gap in coverage between this span and the previous span.']
  is_primary_coverage boolean [note: 'Indicates whether this span represents the primary coverage for the member (vs. supplemental).']
  line_of_business varchar [note: 'Business line under which the coverage is offered.']
  premium_amount decimal(12,2) [note: 'Monthly premium amount associated with this eligibility span.']
  premium_currency varchar [note: 'Three-letter ISO currency code for the premium amount.']
  retroactive_eligibility_flag boolean [note: 'Indicates if the eligibility was applied retroactively.']
  subscriber_relationship_code varchar [note: 'Code indicating the relationship of the member to the primary subscriber.']
  termination_date date [note: 'Date when the eligibility period ends or is scheduled to end.']
  termination_reason_code varchar [note: 'Code describing why the eligibility span terminated.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the eligibility span record.']

  Note: 'Core transactional entity representing a continuous period of health plan eligibility for a member. Captures effective date, termination date, termination reason code, plan ID, benefit package, group/employer ID, subscriber relationship code, premium amount, and eligibility source (834 EDI, manual entry, CMS enrollment file). Tracks eligibility status (active, terminated, suspended, COBRA), retroactive eligibility adjustments, and gap-in-coverage periods. The SSOT for answering \'Is this member eligible on date X?\' — used by claims adjudication, pharmacy, and provider eligibility verification (270/271 transactions).'
}

Table member.member_enrollment {
  member_enrollment_id varchar [pk, note: 'Primary key for the enrollment association']
  benefit_package_id varchar [note: 'Foreign key linking to plan.benefit_package. Business justification: Enrollment events specify the exact benefit package selected by the member. This drives benefit determination, cost-sharing application, and formulary assignment at enrollment. Required for accurate b']
  capitation_arrangement_id varchar [note: 'Foreign key linking to contract.capitation_arrangement. Business justification: Member enrollment in care programs drives capitation payment calculations. The capitation_arrangement governs PMPM rates and attributed member counts. Finance and provider relations teams require this']
  member_subscriber_id varchar [note: 'Foreign key linking to subscriber']
  program_id varchar [note: 'Foreign key linking to care program']
  year_id varchar [note: 'Foreign key linking to plan.year. Business justification: Enrollment events are tied to specific plan years for open enrollment period validation, ACA compliance reporting, and accumulator reset processing. CMS requires plan-year-level enrollment counts; thi']
  effective_end_date date [note: 'Date when the enrollment ends or is terminated']
  effective_start_date date [note: 'Date when the enrollment becomes effective']
  member_enrollment_status varchar [note: 'Current status of the enrollment (e.g., active, terminated)']
  member_enrollment_type varchar [note: 'Classification of enrollment (e.g., mandatory, optional)']
  number varchar [note: 'Unique identifier for the enrollment record']
  reason varchar [note: 'Reason for enrollment, often derived from eligibility criteria']

  Note: 'This association product represents the enrollment contract between a subscriber and a care program. It captures enrollment-specific data such as enrollment number, status, effective dates, type, and reason. Each record links one subscriber to one care program.. Existence Justification: Subscribers can enroll in multiple care programs and each care program can have many subscribers. The enrollment is an operational record that is created, updated, and deleted by staff and includes attributes such as enrollment dates, status, type, and reason. The business treats enrollment as a distinct entity (Enrollment) that is queried and reported on.'
}

Table member.grievance {
  grievance_id varchar [pk, note: 'Primary key for grievance']
  benefit_package_id varchar [note: 'Identifier of the specific benefit package linked to the member\'s coverage.']
  drug_master_id varchar [note: 'Foreign key linking to pharmacy.drug_master. Business justification: Member grievances filed for drug coverage denials, formulary tier placement disputes, or PA denials must reference the specific drug. CMS Part D and state regulators require grievance reporting by dru']
  facility_id varchar [note: 'Foreign key linking to provider.facility. Business justification: Grievances are frequently filed against facilities (hospitals, urgent care centers) rather than individual providers. CMS grievance reporting and state regulatory submissions require identifying the f']
  formulary_exception_id varchar [note: 'Foreign key linking to pharmacy.formulary_exception. Business justification: Grievances are frequently filed after a formulary exception denial. CMS Part D requires tracking the full coverage determination appeals chain: exception request → denial → grievance. This FK creates ']
  group_id varchar [note: 'Identifier of the staff member or investigator assigned to handle the grievance.']
  header_id varchar [note: 'SSOT reference to appeal.grievance (single source of truth)']
  health_plan_id varchar [note: 'Identifier of the health plan under which the member is enrolled at the time of the grievance.']
  member_subscriber_id varchar [note: 'Unique identifier of the member who filed the grievance.']
  pa_request_id varchar [note: 'Foreign key linking to utilization.pa_request. Business justification: Grievances are frequently filed when a PA request is denied. This link supports the denial-to-grievance workflow, CMS regulatory reporting of adverse determination appeals, and grievance resolution tr']
  practice_location_id varchar [note: 'Foreign key linking to provider.practice_location. Business justification: CMS and state regulators require grievances to identify the specific practice location where the access or service issue occurred. A provider may operate at multiple sites; location-level grievance tr']
  prior_authorization_id varchar [note: 'Foreign key linking to pharmacy.prior_authorization. Business justification: Grievances are filed when prior authorizations are denied. CMS Part D coverage determination regulations require tracking the PA denial → grievance → appeal chain. Health plan compliance teams and reg']
  provider_contract_id varchar [note: 'Foreign key linking to contract.provider_contract. Business justification: Member grievances arising from network adequacy, claim denials, or reimbursement disputes must be linked to the governing provider contract for contract performance monitoring, dispute resolution trac']
  provider_id varchar [note: 'Foreign key linking to provider.provider_provider. Business justification: REQUIRED: Grievances are often filed against a specific provider; linking enables tracking, reporting, and regulatory compliance.']
  provider_network_id varchar [note: 'Foreign key linking to network.provider_network. Business justification: Grievance Management Report requires linking each grievance to the provider network involved, enabling compliance tracking and root‑cause analysis.']
  regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: CMS and state regulations mandate specific grievance/appeals timelines and reporting (ACA §2719, CMS managed care rules). Linking grievance to the governing regulatory_obligation enables compliance tr']
  reimbursement_policy_id varchar [note: 'Foreign key linking to contract.reimbursement_policy. Business justification: Grievances frequently dispute specific reimbursement policy decisions — denials, bundling reductions, or modifier edits. Linking grievance to the triggering reimbursement_policy enables root-cause ana']
  um_case_id varchar [note: 'Foreign key linking to utilization.um_case. Business justification: Grievances arise from adverse UM case determinations (e.g., concurrent review denials, LOS disputes). Linking grievance to um_case enables UM-driven grievance reporting, NCQA/URAC compliance audits, a']
  cms_reportable_indicator boolean [note: 'True if the grievance is reportable under CMS grievance reporting requirements (e.g., Medicare Advantage).']
  created_timestamp timestamp [note: 'Timestamp when the grievance record was first created in the data warehouse.']
  currency_code varchar [note: 'ISO 4217 three‑letter currency code for the disputed amount.']
  disputed_amount decimal(12,2) [note: 'Monetary amount that the member is contesting, if applicable (e.g., billing dispute).']
  investigation_end_timestamp timestamp [note: 'Date‑time when the investigation concluded.']
  investigation_start_timestamp timestamp [note: 'Date‑time when the investigation of the grievance began.']
  issue_category_code varchar [note: 'More granular classification of the grievance issue within the selected grievance type.']
  lob_code varchar [note: 'Code identifying the line of business (e.g., commercial, Medicare, Medicaid, CHIP) associated with the member.']
  member_grievance_status varchar [note: 'Current lifecycle state of the grievance.']
  member_satisfaction_score varchar [note: 'Member‑reported satisfaction rating of the grievance resolution on a 1‑5 scale.']
  number varchar [note: 'Business‑visible identifier assigned to the grievance, often used in member communications and regulatory reporting.']
  received_timestamp timestamp [note: 'Exact date‑time when the grievance was first recorded in the system.']
  regulatory_reporting_flag boolean [note: 'Indicates whether the grievance must be reported to regulatory bodies (true) or not (false).']
  resolution_date date [note: 'Calendar date on which the grievance was formally resolved.']
  resolution_description varchar [note: 'Narrative details of the actions taken or explanation provided to resolve the grievance.']
  resolution_type_code varchar [note: 'Indicates how the grievance was addressed, e.g., corrective action, explanation, refund, no action, or other.']
  source varchar [note: 'Channel through which the grievance was received.']
  state_code varchar [note: 'Two‑letter US state abbreviation where the grievance originated or is applicable.']
  type_code varchar [note: 'Categorizes the grievance by primary concern area such as quality of care, access, provider attitude, billing/financial, or benefit/coverage.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the grievance record.']

  Note: 'Operational record of formal member grievances (non-appeal complaints) filed against the health plan regarding service quality, access to care, provider behavior, billing disputes, or administrative issues. Tracks grievance receipt date, grievance type code (quality of care, access, attitude/service, billing/financial, benefit/coverage), issue category, member-reported description, assigned investigator, investigation timeline, resolution date, resolution type, resolution description, member satisfaction with resolution, regulatory reporting flag, and CMS/state DOI reportable indicator. Distinct from the appeal domain which handles coverage determination and claim denial disputes — grievances are expressions of dissatisfaction, not requests for coverage reversal. Supports CMS grievance reporting requirements for Medicare Advantage (42 CFR §422.564) and Medicaid managed care (42 CFR §438.402), state DOI complaint reporting, and NCQA accreditation standards (CR standards).'
}

Table member.address {
  address_id varchar [pk, note: 'Surrogate primary key for the address record.']
  plan_service_area_id varchar [note: 'Foreign key linking to plan.plan_service_area. Business justification: Member addresses must be validated against plan service areas to confirm enrollment eligibility and regulatory compliance. State insurance regulators require insurers to verify members reside within t']
  subscriber_id varchar [note: 'Identifier of the member to whom this address belongs.']
  address_type varchar [note: 'Classification of address purpose.']
  census_tract varchar [note: 'Census tract identifier for demographic analysis.']
  change_reason varchar [note: 'Reason for address change (e.g., member request, system update).']
  city varchar [note: 'City name of the address.']
  country_code varchar [note: 'Three-letter ISO country code.']
  county_fips varchar [note: 'Federal Information Processing Standard code for the county.']
  created_timestamp timestamp [note: 'Timestamp when the address record was first created in the data lake.']
  effective_date date [note: 'Date when the address became effective for the member.']
  external_code varchar [note: 'External identifier for the address from source system.']
  geocode_accuracy_meters varchar [note: 'Accuracy of the geocoding result in meters.']
  is_primary boolean [note: 'Indicates if this address is the primary address for the member.']
  latitude decimal(9,6) [note: 'Geographic latitude in decimal degrees.']
  line1 varchar [note: 'Primary street address line.']
  line2 varchar [note: 'Secondary address line (apartment, suite, etc.).']
  line3 varchar [note: 'Additional address line if needed.']
  line4 varchar [note: 'Additional address line if needed.']
  longitude decimal(9,6) [note: 'Geographic longitude in decimal degrees.']
  member_address_status varchar [note: 'Current lifecycle status of the address.']
  postal_code varchar [note: 'Five-digit ZIP code, optionally with ZIP+4.']
  priority_rank varchar [note: 'Rank indicating priority among multiple concurrent addresses for the member (1 = highest).']
  state_code varchar [note: 'Two-letter US state abbreviation.']
  termination_date date [note: 'Date when the address was terminated or superseded.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the address record.']
  verification_date date [note: 'Date when address verification was performed.']
  verification_status varchar [note: 'USPS CASS certification status of the address.']

  Note: 'Manages all physical and mailing addresses associated with a member, including home address, mailing address, temporary address, and employer address. Tracks address type, effective and termination dates, address verification status (USPS CASS-certified), county FIPS code, census tract, and geographic coordinates for network adequacy analysis. Supports multiple concurrent addresses with priority ranking. Used for premium billing, EOB mailing, provider directory access, and CMS geographic reporting. Maintains address history for audit and compliance purposes.'
}

Table enrollment.transaction {
  transaction_id varchar [pk, note: 'Primary key for transaction']
  benefit_package_id varchar [note: 'Foreign key linking to plan.benefit_package. Business justification: Enrollment transactions (add/change/term) are executed against a specific benefit package. This FK enables claims reprocessing (claims_reprocess_flag) to reference the correct benefit design and suppo']
  enrollment_open_enrollment_period_id varchar [note: 'Foreign key linking to enrollment.open_enrollment_period. Business justification: Each enrollment transaction occurs within a defined open enrollment period; linking transaction to period enables period‑based reporting and ensures the period is not a silo.']
  group_renewal_id varchar [note: 'Foreign key linking to employer.group_renewal. Business justification: Financial reconciliation requires associating each enrollment transaction with the employer\'s renewal cycle.']
  provider_id varchar [note: 'Identifier of the eligibility span generated from this transaction.']
  qualifying_life_event_id varchar [note: 'Foreign key linking to enrollment.qualifying_life_event. Business justification: An enrollment transaction is frequently triggered by a qualifying life event (QLE) that opens a special enrollment period (SEP). Linking transaction to qualifying_life_event captures the causal event ']
  rate_id varchar [note: 'Foreign key linking to plan.plan_rate. Business justification: Required for premium audit reports that must trace each enrollment transaction to the exact rate applied for regulatory compliance.']
  reconciliation_id varchar [note: 'Foreign key linking to enrollment.reconciliation. Business justification: Enrollment reconciliation runs identify discrepancies (adds, changes, terminations) that must be resolved via corrective enrollment transactions. Linking transaction to reconciliation captures which r']
  adjustment_amount decimal(12,2) [note: 'Monetary adjustment (e.g., discount, surcharge) applied to the gross premium.']
  adjustment_reason_code varchar [note: 'Standard code describing why a financial or coverage adjustment was made.']
  approving_authority varchar [note: 'Name or role of the individual or system that approved the enrollment change.']
  audit_user_role varchar [note: 'Role of the audit user (e.g., admin, operator, system).']
  claims_reprocess_flag boolean [note: 'True if the enrollment change requires downstream claims to be re‑processed.']
  compliance_status varchar [note: 'Current compliance status of the transaction with applicable regulations.']
  coverage_period_type varchar [note: 'Indicates whether the coverage is continuous, intermittent, or contains a gap.']
  created_timestamp timestamp [note: 'Timestamp when the enrollment transaction record was first created in the lakehouse.']
  currency_code varchar [note: 'Three‑letter ISO currency code for the monetary values in this transaction.']
  effective_date date [note: 'Date on which the member\'s coverage under the new enrollment becomes effective.']
  effective_end_date date [note: 'Scheduled end date of the coverage period associated with this enrollment (may differ from termination_date).']
  enrollment_comment varchar [note: 'Free‑form text field for notes or comments entered by the processor.']
  enrollment_origin varchar [note: 'Channel through which the enrollment was initiated.']
  enrollment_transaction_number varchar [note: 'External business identifier assigned to the enrollment transaction, used for tracking and reference.']
  enrollment_type varchar [note: 'Category of enrollment event: open enrollment, special enrollment period, automatic enrollment, special manual enrollment, or other.']
  event_timestamp timestamp [note: 'Exact date‑time when the enrollment event occurred in the source system.']
  financial_impact_flag boolean [note: 'True when the enrollment change has a direct impact on premium billing or financial reporting.']
  grace_period_end_date date [note: 'Date when the applicable grace period expires.']
  gross_amount decimal(12,2) [note: 'Total premium amount before any adjustments for the enrollment period.']
  health_plan_type varchar [note: 'Classification of the health plan (e.g., HMO, PPO, EPO, POS, HDHP).']
  is_grace_period boolean [note: 'True if the enrollment is being processed within a grace period after termination.']
  net_amount decimal(12,2) [note: 'Final premium amount after adjustments, representing the amount to be billed.']
  original_termination_reference varchar [note: 'Reference to the prior termination transaction that is being reinstated.']
  prior_authorization_required boolean [note: 'Indicates whether the enrollment change triggers a prior authorization requirement.']
  processing_status varchar [note: 'Current processing stage of the transaction within the enrollment workflow.']
  reactivation_date date [note: 'Effective date of coverage reactivation for reinstatement events.']
  regulatory_reporting_flag boolean [note: 'Indicates whether this transaction must be reported to a regulatory body (e.g., CMS, NAIC).']
  retroactive_adjustment_flag boolean [note: 'Flag indicating whether the transaction represents a retroactive adjustment to prior coverage dates.']
  source varchar [note: 'Source of the enrollment transaction record, e.g., EDI 834 feed, web portal, batch load, or API.']
  termination_date date [note: 'Date on which coverage ends for a disenrollment or termination event (nullable if not applicable).']
  termination_reason varchar [note: 'Standardized reason why the enrollment was terminated.']
  transaction_status varchar [note: 'Current lifecycle status of the enrollment transaction.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the enrollment transaction record.']

  Note: 'Transactional record capturing every enrollment action for a member — initial enrollment, re-enrollment, plan change, disenrollment (voluntary/involuntary termination), reinstatement, and retroactive adjustment. Tracks enrollment source, enrollment period type (open enrollment, SEP, auto-enrollment), effective date, submitted date, processing status, and transaction-type-specific attributes: termination reason/last day of coverage/grace period status for disenrollments; original termination reference/reinstatement effective date/approving authority for reinstatements; adjusted dates/financial impact flag/claims reprocessing trigger for retro adjustments. One enrollment_transaction may produce one or more eligibility_spans. Sourced from Facets/QNXT and 834 EDI transactions via Availity/Change Healthcare.'
}

Table enrollment.qualifying_life_event {
  qualifying_life_event_id varchar [pk, note: 'System-generated unique identifier for the qualifying life event record.']
  regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: SEP verification requires tracking which regulatory obligation (42 CFR 435.916, state insurance codes) governs each QLE determination for CMS compliance audits and appeal documentation.']
  appeal_reference varchar [note: 'Reference number of any appeal filed against a denial.']
  cms_sep_outcome varchar [note: 'Result of the CMS SEP eligibility determination.']
  created_timestamp timestamp [note: 'Timestamp when the qualifying life event record was first created in the system.']
  denial_reason varchar [note: 'Explanation why the SEP request was denied, if applicable.']
  documentation_type varchar [note: 'Type of supporting document submitted for the event.']
  event_date date [note: 'Calendar date on which the qualifying life event occurred.']
  event_type varchar [note: 'Category of the life event that triggers a special enrollment period.']
  qualifying_life_event_status varchar [note: 'Overall lifecycle status of the qualifying life event record.']
  sep_category_code varchar [note: 'CMS‑defined code that classifies the SEP category for the qualifying life event.']
  sep_window_end date [note: 'Last date the special enrollment period (SEP) is open for this event.']
  sep_window_start date [note: 'First date the special enrollment period (SEP) is open for this event.']
  sep_window_status varchar [note: 'Current state of the SEP window based on dates and actions.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to the qualifying life event record.']
  verification_date date [note: 'Date the verification decision was recorded.']
  verification_status varchar [note: 'Current status of the CMS SEP verification process.']

  Note: 'Master record of a qualifying life event (QLE) that triggers a special enrollment period (SEP), including the full SEP verification lifecycle. Captures event type (marriage, birth, loss of coverage, relocation, divorce, adoption), event date, SEP window open/close dates, CMS SEP category codes, submitted documentation type and artifacts (birth certificate, marriage license, loss of coverage letter), verification status, verifier ID, verification date, CMS SEP verification outcome, pend/denial reason, and appeal reference. This is the authoritative SSOT for both QLE registration and SEP verification — no separate verification record exists. Required for ACA compliance, CMS SEP eligibility determinations, and SEP integrity program compliance. Sourced from Facets/QNXT pend workflow and member portal document uploads.'
}

Table enrollment.open_enrollment_period {
  open_enrollment_period_id varchar [pk, note: 'Primary key for open_enrollment_period']
  plan_year_id varchar [note: 'Foreign key linking to plan.year. Business justification: Open enrollment periods are defined within a plan year — start_date, end_date, and enrollment_deadline_date are all plan-year-bounded. This FK enables OEP-to-plan-year alignment for ACA regulatory fil']
  regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: OEP windows are mandated by specific regulations (ACA §1311, state codes). Business tracks which regulatory obligation drives each enrollment period for compliance reporting and regulatory filing vali']
  compliance_status varchar [note: 'Current compliance verification outcome for the enrollment period.']
  created_timestamp timestamp [note: 'Date‑time when the enrollment period record was first created in the system.']
  eligibility_segment varchar [note: 'Population segment eligible for this enrollment period (e.g., group, individual, Medicare).']
  end_date date [note: 'Last calendar day for submitting enrollment applications; after this date the window closes.']
  enrollment_cutoff_time timestamp [note: 'Daily cut‑off time (in local time) after which submissions on the deadline date are rejected.']
  enrollment_deadline_date date [note: 'Final calendar date by which all enrollment submissions must be received.']
  enrollment_type varchar [note: 'Classification of the enrollment window based on its recurrence and purpose.']
  exchange_type varchar [note: 'Marketplace or exchange through which the enrollment is offered.']
  is_annual boolean [note: 'True if the enrollment period recurs each year on the same schedule.']
  is_retrospective_allowed boolean [note: 'True if members may submit enrollment changes that become effective prior to the submission date.']
  lob varchar [note: 'Business line to which the enrollment period applies.']
  notes varchar [note: 'Free‑form text for additional remarks, exceptions, or operational comments.']
  open_enrollment_period_status varchar [note: 'Current lifecycle status of the enrollment window.']
  period_code varchar [note: 'Short alphanumeric code that uniquely identifies the enrollment window across systems.']
  period_name varchar [note: 'Descriptive name of the enrollment window, e.g., "2025 Individual Marketplace OE".']
  regulatory_filing_required boolean [note: 'Indicates whether this enrollment period triggers mandatory regulatory reporting (e.g., CMS filings).']
  start_date date [note: 'First calendar day on which members may submit enrollment applications.']
  updated_timestamp timestamp [note: 'Date‑time of the most recent modification to the enrollment period record.']
  volume_actual varchar [note: 'Actual count of enrollments captured within the window.']
  volume_target varchar [note: 'Planned number of enrollments the organization aims to achieve during the window.']
  volume_target_met boolean [note: 'Indicates whether the actual enrollment volume met or exceeded the target.']

  Note: 'Master record defining each open enrollment window — annual employer group OE, ACA marketplace OE, Medicare Annual Enrollment Period (AEP), and Medicaid continuous enrollment periods. Captures period start/end dates, eligible population segment, LOB, exchange type (SHOP, individual marketplace, off-exchange), and enrollment volume targets. Used to govern when enrollment_records are accepted without a QLE. Sourced from CMS plan year calendars and employer group contracts.'
}

Table enrollment.edi_transaction {
  edi_transaction_id varchar [pk, note: 'Primary key for edi_transaction']
  transaction_id varchar [note: 'External identifier supplied by the sender to uniquely identify the transaction (e.g., control number from the sender\'s system).']
  average_record_size_bytes decimal(12,2) [note: 'Average size of each member record within the file, calculated as file_size_bytes divided by member_count.']
  effective_date date [note: 'Date on which the enrollment coverage becomes effective for the member(s).']
  enrollment_action_code varchar [note: 'Standard X12 834 code indicating Add (A), Delete (D), Modify (M), or Correct (C) action.']
  error_code varchar [note: 'Standardized error code returned when processing fails (e.g., X12 validation error).']
  error_description varchar [note: 'Human‑readable description of the processing error.']
  file_name varchar [note: 'Original filename of the inbound 834 transaction as received from the EDI gateway.']
  file_received_timestamp timestamp [note: 'Date‑time when the 834 file was first ingested into the lakehouse.']
  file_size_bytes varchar [note: 'Total size of the inbound 834 file in bytes.']
  group_control_number varchar [note: 'Control number identifying the GS functional group for the transaction.']
  interchange_control_number varchar [note: 'Control number identifying the ISA interchange envelope for the transaction.']
  last_attempt_timestamp timestamp [note: 'Timestamp of the most recent processing attempt.']
  lifecycle_status varchar [note: 'Overall lifecycle state of the transaction from ingestion to final disposition.']
  member_count varchar [note: 'Number of individual member enrollment records contained in the 834 file.']
  processing_attempts varchar [note: 'Number of times the transaction has been attempted for processing.']
  processing_status varchar [note: 'Current workflow status of the transaction within the ingestion pipeline.']
  receiver_code varchar [note: 'Identifier of the trading partner that receives the 834 file (typically the health insurer).']
  reconciliation_status varchar [note: 'Result of matching the transaction to internal enrollment records.']
  record_audit_created timestamp [note: 'Timestamp when the transaction record was first created in the lakehouse.']
  record_audit_updated timestamp [note: 'Timestamp of the most recent update to the transaction record.']
  termination_date date [note: 'Date on which the enrollment coverage ends, if applicable.']
  transaction_set_control_number varchar [note: 'Control number that uniquely identifies the 834 transaction set within the interchange.']
  transaction_timestamp timestamp [note: 'Timestamp representing the business event time encoded in the 834 transaction (e.g., effective date of the enrollment action).']
  transaction_type varchar [note: 'Indicates whether the 834 file adds new enrollments, changes existing ones, terminates coverage, or corrects prior data.']

  Note: 'Raw and processed 834 EDI transaction records received from employer groups, exchanges, and CMS — the primary electronic mechanism for enrollment adds, changes, and terminations. Captures ISA/GS envelope metadata, transaction set control number, sender/receiver IDs, transaction type (full file vs. change only), processing status, error codes, and reconciliation status. Sourced from Availity/Change Healthcare EDI gateway. Distinct from enrollment_record (the business outcome) — this is the inbound EDI artifact.'
}

Table enrollment.eligibility_verification {
  eligibility_verification_id varchar [pk, note: 'Primary key for eligibility_verification']
  benefit_package_id varchar [note: 'Foreign key linking to plan.benefit_package. Business justification: 270/271 eligibility transactions are scoped to a specific benefit package — the response includes benefit limits, cost-sharing, and coverage details defined at benefit_package level. Providers need pa']
  member_identity_id varchar [note: 'Unique member identifier used in the eligibility request (e.g., member number, SSN, MRN).']
  plan_election_id varchar [note: 'Foreign key linking to enrollment.plan_election. Business justification: A 270/271 eligibility verification inquiry is performed in the context of a specific plan election — verifying that a member\'s coverage under a particular plan election is active and valid. Linking el']
  practice_location_id varchar [note: 'Foreign key linking to provider.practice_location. Business justification: HIPAA 270/271 eligibility verification transactions are location-specific — the service delivery site determines benefit applicability and network status. Linking eligibility_verification to practice_']
  provider_id varchar [note: 'Foreign key linking to provider.provider_provider. Business justification: Required for automated provider credential checks during eligibility verification; the process matches providers to member eligibility inquiries.']
  transaction_id varchar [note: 'Identifier assigned by the source system for the eligibility transaction.']
  authorization_number varchar [note: 'Authorization number returned when prior authorization is required.']
  authorization_required boolean [note: 'Indicates whether prior authorization is required for the service.']
  benefit_category varchar [note: 'High‑level category of benefits being queried (e.g., medical, dental).']
  benefit_limit decimal(10,2) [note: 'Maximum dollar amount allowed for the queried benefit.']
  benefit_remaining decimal(10,2) [note: 'Remaining dollar amount of the benefit available.']
  benefit_used decimal(10,2) [note: 'Dollar amount of the benefit already utilized in the current period.']
  coverage_type varchar [note: 'Level of coverage returned (full, partial, or none).']
  created_timestamp timestamp [note: 'Timestamp when the eligibility record was first persisted in the data lake.']
  deductible_remaining decimal(10,2) [note: 'Member\'s remaining deductible balance for the benefit period.']
  diagnosis_code varchar [note: 'ICD diagnosis code associated with the request, if applicable.']
  eligibility_status varchar [note: 'Overall result of the eligibility check (eligible, ineligible, error, or pending).']
  error_code varchar [note: 'Technical or business error code returned in a failed eligibility response.']
  error_description varchar [note: 'Human‑readable description of the error condition.']
  inquiry_reference_number varchar [note: 'External reference number assigned by the source system (e.g., Availity) for the eligibility request.']
  inquiry_timestamp timestamp [note: 'Date‑time when the eligibility request was sent to the payer.']
  member_identifier_type varchar [note: 'Type of identifier supplied for the member (SSN, MRN, or internal member ID).']
  oop_remaining decimal(10,2) [note: 'Remaining out‑of‑pocket amount before maximum OOP is reached.']
  response_message varchar [note: 'Free‑form message returned by the payer providing additional context.']
  response_time_seconds decimal(10,2) [note: 'Elapsed time between request and response, measured in seconds.']
  response_timestamp timestamp [note: 'Date‑time when the eligibility response was received.']
  service_code varchar [note: 'CPT code of the service/procedure for which eligibility is being checked.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the eligibility record.']

  Note: 'Transactional record of real-time 270/271 eligibility verification requests and responses. Captures requesting provider NPI, member identifier used, inquiry date/time, response status, coverage details returned, deductible/OOP balances returned, and response time SLA. Supports provider-facing eligibility verification at point of care. Sourced from Availity/Change Healthcare 270/271 gateway and Facets real-time eligibility API.'
}

Table enrollment.plan_election {
  plan_election_id varchar [pk, note: 'Unique surrogate identifier for the plan election record.']
  benefit_package_id varchar [note: 'Foreign key linking to plan.benefit_package. Business justification: Members elect a specific benefit package (metal tier, cost-sharing design) during enrollment. This FK enables benefit-package-level enrollment reporting, premium calculation validation, and ACA actuar']
  edi_transaction_id varchar [note: 'Foreign key linking to enrollment.edi_transaction. Business justification: Plan elections received from employer groups via 834 EDI files must be traceable back to the originating EDI transaction record. This FK enables end-to-end traceability from the raw EDI file through t']
  open_enrollment_period_id varchar [note: 'Foreign key linking to enrollment.open_enrollment_period. Business justification: A plan election is made within the context of a specific open enrollment period (annual OEP, ACA marketplace OEP, Medicare OEP). Linking plan_election to open_enrollment_period enables volume tracking']
  pcp_provider_id varchar [note: 'Foreign key linking to provider.provider. Business justification: PCP designation at plan election is a core health insurance enrollment workflow. Members select a Primary Care Provider when electing a plan; this FK supports PCP assignment tracking, continuity-of-ca']
  plan_year_id varchar [note: 'Foreign key linking to plan.year. Business justification: Plan elections are always scoped to a plan year for ACA compliance, open enrollment period alignment, and annual enrollment reporting. Role-prefix \'plan_year_id\' used to distinguish from generic date ']
  prior_plan_election_id varchar [note: 'Reference to the previous election record when this election is a change or reinstatement.']
  qualifying_life_event_id varchar [note: 'Foreign key linking to enrollment.qualifying_life_event. Business justification: A plan election made during a special enrollment period must reference the qualifying life event that opened that SEP window. This FK is critical for SEP eligibility validation, CMS SEP outcome tracki']
  cobra_eligibility_end_date date [note: 'Date when COBRA eligibility expires.']
  coverage_tier varchar [note: 'Level of coverage elected (e.g., employee only, employee + spouse, employee + children, family).']
  dental_rider_flag boolean [note: 'Indicates if a dental coverage rider was elected.']
  effective_date date [note: 'Date the elected coverage becomes effective.']
  election_number varchar [note: 'External reference number assigned to the election by the enrollment system.']
  election_type varchar [note: 'Nature of the election event (new enrollment, change, termination, reinstatement).']
  enrollment_event_type varchar [note: 'Type of enrollment event that triggered the election.']
  enrollment_source varchar [note: 'Channel through which the election was submitted.']
  fsa_election_flag boolean [note: 'Indicates if a Flexible Spending Account was elected.']
  hra_election_flag boolean [note: 'Indicates if a Health Reimbursement Arrangement was elected.']
  hsa_election_flag boolean [note: 'Indicates if a Health Savings Account was elected.']
  is_cobra_eligible boolean [note: 'Indicates if the election is eligible for COBRA continuation coverage.']
  notes varchar [note: 'Free‑text field for additional comments or special instructions related to the election.']
  plan_election_status varchar [note: 'Current processing status of the election record.']
  premium_contribution_employee decimal(12,2) [note: 'Portion of the premium paid by the employee.']
  premium_contribution_employer decimal(12,2) [note: 'Portion of the premium paid by the employer.']
  premium_frequency varchar [note: 'Billing frequency for the premium (e.g., monthly).']
  record_audit_created timestamp [note: 'Timestamp when the election record was first created in the system.']
  record_audit_updated timestamp [note: 'Timestamp of the most recent update to the election record.']
  termination_date date [note: 'Date the elected coverage ends, if applicable.']
  total_premium decimal(12,2) [note: 'Total premium amount for the elected coverage (employer + employee).']
  vision_rider_flag boolean [note: 'Indicates if a vision coverage rider was elected.']

  Note: 'Master record of a subscriber\'s specific plan selection, coverage tier, and covered member roster during an enrollment or plan change event. Captures elected plan ID, coverage tier (employee-only, employee+spouse, employee+children, family), effective date, prior plan reference, premium contribution split (employer vs. employee), HSA/HRA/FSA election flag, dental/vision rider elections, and the roster of covered individuals with their relationship codes, age-out dates, and COBRA continuation eligibility. References member domain for person identity — this product owns the enrollment-specific election and roster, not the person demographics. Represents the member\'s choice artifact — distinct from eligibility_span (the resulting coverage). Sourced from Facets/QNXT benefits election module.'
}

Table enrollment.reconciliation {
  reconciliation_id varchar [pk, note: 'Primary key for reconciliation']
  plan_year_id varchar [note: 'Foreign key linking to plan.year. Business justification: Enrollment reconciliation runs (CMS 820/834 reconciliation) are always executed within a specific plan year. This FK enables plan-year-level discrepancy reporting, financial impact aggregation, and CM']
  auto_resolution_flag boolean [note: 'Indicates whether the system automatically resolved the discrepancy.']
  comments varchar [note: 'Free‑form notes captured by the analyst about the reconciliation outcome.']
  created_timestamp timestamp [note: 'Timestamp when the reconciliation record was first created in the lakehouse.']
  currency_code varchar [note: 'Three‑letter ISO 4217 code of the currency used for financial impact values.']
  discrepancy_add_count varchar [note: 'Count of enrollment records present in the source but missing in the internal system.']
  discrepancy_change_count varchar [note: 'Count of enrollment attribute changes (e.g., plan, coverage) that differ between systems.']
  discrepancy_demographic_mismatch_count varchar [note: 'Number of records where member demographic data (name, DOB, SSN) does not match.']
  discrepancy_detail_file_path varchar [note: 'File system or object storage path to the detailed discrepancy report generated by the run.']
  discrepancy_termination_count varchar [note: 'Count of enrollment records terminated in the source but still active internally.']
  discrepancy_total_count varchar [note: 'Aggregate number of mismatches identified in the reconciliation run.']
  financial_impact_adjustment decimal(15,2) [note: 'Sum of adjustments (credits, penalties) applied to the gross impact.']
  financial_impact_gross decimal(15,2) [note: 'Total gross monetary impact of all unresolved discrepancies before adjustments.']
  financial_impact_net decimal(15,2) [note: 'Net monetary impact after adjustments; the amount that may affect premium billing.']
  manual_resolution_flag boolean [note: 'Indicates whether human intervention is required to resolve the discrepancy.']
  period_end date [note: 'End date of the enrollment coverage period being reconciled.']
  period_start date [note: 'Start date of the enrollment coverage period being reconciled.']
  reconciliation_status varchar [note: 'Current lifecycle status of the reconciliation process.']
  resolution_deadline date [note: 'Date by which outstanding discrepancies must be resolved to avoid financial impact.']
  run_number varchar [note: 'Sequential number assigned to each reconciliation execution for tracking and audit purposes.']
  run_timestamp timestamp [note: 'Date‑time when the reconciliation run was initiated.']
  run_type varchar [note: 'Indicates whether the run was a full reconciliation or an incremental update.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the reconciliation record.']

  Note: 'Transactional record capturing periodic reconciliation between the health plan\'s enrollment records and external authoritative sources — employer group rosters, CMS enrollment files (TRR/MARx), state Medicaid agency 834 files, and ACA exchange enrollment data. Captures reconciliation run date, source system, discrepancy count by type (adds, terms, changes, demographic mismatches), auto-resolution vs. manual resolution status, resolution deadline, and financial impact of unresolved discrepancies on premium billing and risk adjustment. Critical for CMS compliance (monthly TRR reconciliation), premium billing accuracy, and employer group roster integrity.'
}

Table enrollment.cms_submission {
  cms_submission_id varchar [pk, note: 'Primary key for cms_submission']
  audit_finding_id varchar [note: 'Foreign key linking to compliance.audit_finding. Business justification: CMS EDGE/EDE submissions are audited for data accuracy and timeliness. Audit findings reference specific submission batches for remediation, resubmission tracking, and penalty avoidance.']
  benefit_package_id varchar [note: 'Identifier for the specific benefit package within the plan.']
  breach_incident_id varchar [note: 'Foreign key linking to compliance.breach_incident. Business justification: CMS submission files contain PHI and may be involved in breach incidents (unauthorized access, transmission errors). Business tracks which submissions were affected for HIPAA notification and remediat']
  cms_transaction_id varchar [note: 'Unique transaction identifier assigned by CMS for the submission.']
  formulary_id varchar [note: 'Foreign key linking to pharmacy.formulary. Business justification: CMS Part D submissions report formulary compliance, drug coverage status, and benefit design. Each submission must reference the specific formulary version in effect to validate regulatory compliance ']
  health_plan_id varchar [note: 'Identifier of the health plan associated with the enrollment.']
  member_risk_score_id varchar [note: 'Foreign key linking to risk.member_risk_score. Business justification: CMS submissions report risk-adjusted payments; linking to member risk scores enables RAF validation, payment reconciliation, and audit trail for risk adjustment factors used in premium calculations. R']
  member_subscriber_id varchar [note: 'Internal identifier of the member whose enrollment is being submitted.']
  pbm_contract_id varchar [note: 'Foreign key linking to pharmacy.pbm_contract. Business justification: CMS Part D submissions must report PBM contract terms including rebate arrangements, dispensing fees, and network configurations. Each submission references the governing PBM contract to validate pric']
  plan_election_id varchar [note: 'Foreign key linking to enrollment.plan_election. Business justification: CMS submissions for Medicare Advantage, Part D, and Medicaid report on specific plan elections — the subscriber\'s coverage selection is the core data element being submitted to CMS. Linking cms_submis']
  plan_year_id varchar [note: 'Foreign key linking to plan.year. Business justification: CMS enrollment submissions (RAPS, EDGE, 834) are always tied to a plan year for risk adjustment, MLR reporting, and regulatory filing deadlines. Direct FK to plan.year enables plan-year submission aud']
  adjustment_amount decimal(12,2) [note: 'Any premium adjustments (e.g., discounts, fees) applied to the submission.']
  audit_user varchar [note: 'User ID of the person who created or last updated the record.']
  audit_user_role varchar [note: 'Role or job function of the audit user (e.g., Data Steward, Operations Analyst).']
  compliance_check_date date [note: 'Date when the compliance validation was performed.']
  compliance_error_code varchar [note: 'Code representing a specific compliance validation failure.']
  compliance_error_description varchar [note: 'Human‑readable description of the compliance error.']
  compliance_flag boolean [note: 'Indicates whether the submission passed all regulatory compliance validations.']
  created_timestamp timestamp [note: 'Timestamp when the submission record was first created in the lakehouse.']
  currency_code varchar [note: 'Three‑letter ISO currency code for the monetary values.']
  data_quality_score decimal(5,2) [note: 'Score (0‑100) reflecting the overall quality of the submission data.']
  effective_date date [note: 'Date when the member\'s coverage becomes effective.']
  enrollment_cms_submission_status varchar [note: 'Current lifecycle status of the submission within the processing pipeline.']
  error_code varchar [note: 'Technical error code returned by the CMS response file.']
  error_message varchar [note: 'Detailed error message associated with the error code.']
  is_legacy_submission boolean [note: 'Flag indicating whether the submission originates from a legacy system.']
  is_test_submission boolean [note: 'Flag indicating whether the submission is a test (non‑production) record.']
  member_number varchar [note: 'External member identifier used in member communications and EDI files.']
  net_amount decimal(12,2) [note: 'Final premium amount after adjustments, to be billed.']
  processing_end_timestamp timestamp [note: 'Timestamp when internal processing of the submission completed.']
  processing_start_timestamp timestamp [note: 'Timestamp when internal processing of the submission began.']
  processing_status varchar [note: 'Current status of internal processing of the submission file.']
  rejection_reason_code varchar [note: 'CMS‑provided code indicating why a submission was rejected.']
  rejection_reason_description varchar [note: 'Human‑readable description of the rejection reason.']
  risk_adjustment_flag boolean [note: 'Indicates whether the submission impacts the RAF (Risk Adjustment Factor) score.']
  submission_file_name varchar [note: 'Name of the EDI file transmitted to CMS.']
  submission_file_timestamp timestamp [note: 'Timestamp when the EDI file was created or received by the gateway.']
  submission_source_system varchar [note: 'Originating core administration system that generated the submission.']
  submission_timestamp timestamp [note: 'Date‑time when the enrollment batch was transmitted to CMS.']
  submission_type varchar [note: 'Indicates whether the submission is an initial enrollment, a correction, a deletion, or a termination request.']
  submission_version varchar [note: 'Version identifier for the submission schema or format.']
  termination_date date [note: 'Date when the member\'s coverage ends, if applicable.']
  total_premium_amount decimal(12,2) [note: 'Gross premium amount for the enrollment before adjustments.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the submission record.']

  Note: 'Transactional record of enrollment data submissions to CMS for Medicare Advantage, Part D, and Medicaid managed care programs via RAPS and EDPS. Captures submission batch ID, submission type (initial, correction, delete), CMS transaction ID, acceptance/rejection status, error detail codes, risk adjustment impact flag, and reconciliation status. Critical for government program compliance and RAF score accuracy. Sourced from CMS EDPS/RAPS response files.'
}

Table plan.health_plan {
  health_plan_id varchar [pk, note: 'Unique system-generated identifier for the health plan record.']
  pharmacy_formulary_id varchar [note: 'Reference to the formulary that defines drug tiering and coverage for the plan.']
  benefit_design_version varchar [note: 'Version identifier for the benefit design configuration.']
  cms_plan_code varchar [note: 'CMS plan identifier used for regulatory reporting.']
  coinsurance_percentage decimal(5,2) [note: 'Percentage of allowed amount the member pays after deductible is met.']
  copay_primary_care decimal(10,2) [note: 'Fixed copayment amount for a primary care office visit.']
  copay_specialist decimal(10,2) [note: 'Fixed copayment amount for a specialist office visit.']
  created_timestamp timestamp [note: 'Timestamp when the plan record was first created in the system.']
  deductible_family decimal(10,2) [note: 'Annual amount a family must pay before cost‑sharing begins.']
  deductible_individual decimal(10,2) [note: 'Annual amount an individual member must pay before cost‑sharing begins.']
  effective_date date [note: 'Date the plan becomes binding for members.']
  enrollment_end_date date [note: 'Last date members may enroll in the plan for the plan year.']
  enrollment_start_date date [note: 'First date members may enroll in the plan for the plan year.']
  hcc_score decimal(5,2) [note: 'Aggregated HCC score for the plan population used in risk adjustment.']
  hios_plan_code varchar [note: 'CMS‑assigned HIOS identifier for the plan.']
  is_exempt_from_mlr boolean [note: 'Indicates whether the plan is exempt from Medical Loss Ratio reporting requirements.']
  last_review_date date [note: 'Date the plan design was last reviewed for compliance or pricing updates.']
  line_of_business varchar [note: 'Broad business segment the plan belongs to, such as commercial or government.']
  market_segment varchar [note: 'Target market for the plan: individual, small group, large group, Medicare, or Medicaid.']
  network_tier varchar [note: 'Tier classification of the network (e.g., Tier1, Tier2).']
  out_of_pocket_max_family decimal(10,2) [note: 'Maximum amount a family pays in a year before the plan pays 100% of covered services.']
  out_of_pocket_max_individual decimal(10,2) [note: 'Maximum amount an individual pays in a year before the plan pays 100% of covered services.']
  plan_aca_compliant boolean [note: 'True if the plan meets all Affordable Care Act regulatory requirements.']
  plan_category varchar [note: 'High‑level category indicating commercial, government, or special market plans.']
  plan_code varchar [note: 'Business identifier code used in core administration platforms to reference the plan.']
  plan_description varchar [note: 'Narrative description of the plan\'s benefits and target audience.']
  plan_marketplace_eligible boolean [note: 'Indicates if the plan can be sold on the ACA Health Insurance Marketplace.']
  plan_name varchar [note: 'Human‑readable name of the health plan as marketed to members.']
  plan_region varchar [note: 'Geographic region (e.g., Northeast, Midwest) for reporting and network adequacy.']
  plan_state varchar [note: 'Two‑letter US state abbreviation where the plan is offered.']
  plan_status varchar [note: 'Current lifecycle status of the plan.']
  plan_type varchar [note: 'Classification of the plan product (e.g., HMO, PPO, EPO, POS, HDHP, QHP, Medicare Advantage, Medicaid).']
  plan_year varchar [note: 'Calendar year for which the plan design is effective.']
  premium_amount decimal(10,2) [note: 'Base premium amount charged to the member or group for the plan year.']
  premium_currency varchar [note: 'ISO 4217 currency code for the premium amount.']
  premium_frequency varchar [note: 'Billing frequency for the premium (monthly, quarterly, annually).']
  regulatory_classification varchar [note: 'Regulatory category of the plan (e.g., ACA, Medicare, Medicaid).']
  risk_adjustment_factor decimal(5,4) [note: 'Factor used for risk‑adjusted payments under CMS risk adjustment models.']
  sbc_document_url varchar [note: 'Link to the electronic Summary of Benefits and Coverage document for the plan.']
  termination_date date [note: 'Date the plan is terminated or expires; null if open‑ended.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the plan record.']

  Note: 'Master catalog of all health plan products offered by the insurer — HMO, PPO, EPO, POS, HDHP, QHP, Medicare Advantage, and Medicaid managed care plans. Serves as the SSOT for plan identity, plan type classification, line of business (LOB), market segment (individual, small group, large group, Medicare, Medicaid), regulatory classification, CMS plan ID, HIOS plan ID, plan-year lifecycle, and provider network configuration (network ID, tiered network designations, access type, out-of-network coverage rules, network adequacy standards). Foundational entity for all benefit configuration, enrollment, and claims adjudication in Facets/QNXT.'
}

Table plan.benefit_package {
  benefit_package_id varchar [pk, note: 'System-generated unique identifier for the benefit package record.']
  health_plan_id varchar [note: 'Foreign key linking to plan.health_plan. Business justification: A benefit package is defined for a specific health plan. Adding health_plan_id to benefit_package creates the necessary parent relationship and prevents the package from being a silo.']
  regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: Benefit packages must comply with ACA metal tier actuarial value requirements, EHB mandates, and state benefit mandates. Linking benefit_package to regulatory_obligation enables package-level mandate ']
  actuarial_value_pct decimal(5,2) [note: 'Percentage of total average costs the plan is expected to cover, expressed as a percent.']
  benefit_package_status varchar [note: 'Current lifecycle status of the benefit package.']
  coinsurance_inpatient decimal(5,2) [note: 'Percentage of allowed amount the member pays for inpatient services after deductible.']
  coinsurance_outpatient decimal(5,2) [note: 'Percentage of allowed amount the member pays for outpatient services after deductible.']
  copay_primary_care decimal(5,2) [note: 'Fixed dollar copay for a primary care office visit.']
  copay_specialist decimal(5,2) [note: 'Fixed dollar copay for a specialist office visit.']
  created_timestamp timestamp [note: 'Timestamp when the benefit package record was first created in the system.']
  deductible_type varchar [note: 'Indicates whether the deductible is embedded (per member) or aggregate (family).']
  effective_end_date date [note: 'Date on which the benefit package expires or is superseded (null if open‑ended).']
  effective_start_date date [note: 'Date on which the benefit package becomes effective.']
  family_deductible_amount decimal(10,2) [note: 'Dollar amount a family must pay before cost‑sharing begins for the family unit.']
  generic_substitution_required boolean [note: 'Indicates whether generic substitution is mandatory when a generic equivalent is available.']
  individual_deductible_amount decimal(10,2) [note: 'Dollar amount an individual must pay before cost‑sharing begins.']
  mail_order_copay_brand decimal(5,2) [note: 'Fixed copay for brand‑name drugs dispensed via mail‑order.']
  mail_order_copay_generic decimal(5,2) [note: 'Fixed copay for generic drugs dispensed via mail‑order.']
  metal_tier varchar [note: 'ACA metal tier designation indicating the level of coverage.']
  network_designation varchar [note: 'Indicates whether the benefit package applies to in‑network or out‑of‑network providers.']
  out_of_pocket_max_family decimal(10,2) [note: 'Maximum amount a family will pay in a plan year for covered services.']
  out_of_pocket_max_individual decimal(10,2) [note: 'Maximum amount an individual will pay in a plan year for covered services.']
  package_code varchar [note: 'External business code or number used to identify the benefit package in plan documents and communications.']
  package_name varchar [note: 'Human‑readable name of the benefit package (e.g., "Silver 2024 PPO").']
  plan_type varchar [note: 'Classification of the health plan product type.']
  prior_auth_required boolean [note: 'Indicates whether a prior authorization is required for services covered under this package.']
  retail_copay_brand decimal(5,2) [note: 'Fixed copay for brand‑name drugs dispensed at retail pharmacies.']
  retail_copay_generic decimal(5,2) [note: 'Fixed copay for generic drugs dispensed at retail pharmacies.']
  specialty_copay decimal(5,2) [note: 'Fixed copay for specialty pharmacy drugs.']
  specialty_drug_management_program varchar [note: 'Name or description of the management program applied to specialty drugs (e.g., step therapy, limited distribution).']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the benefit package record.']

  Note: 'Defines the structured benefit package associated with a health plan and plan year, grouping all covered services into a coherent benefit design. Captures package name, effective dates, plan-year, benefit tier (Bronze, Silver, Gold, Platinum for ACA QHPs), actuarial value percentage, metal tier classification, embedded vs. aggregate deductible design, and full pharmacy benefit configuration — PBM vendor, formulary ID, retail vs. mail-order copay differentials, specialty pharmacy requirements, 90-day supply rules, mandatory generic substitution flags, specialty drug management programs, and retail/mail-order/specialty pharmacy network designations. One health plan may have multiple benefit packages across plan years. Sourced from benefits administration and PBM integration (RxClaim/Argus).'
}

Table plan.benefit {
  benefit_id varchar [pk, note: 'Unique surrogate key for each benefit record.']
  benefit_package_id varchar [note: 'Foreign key linking to plan.benefit_package. Business justification: A benefit is defined within a specific benefit package — one benefit_package contains many individual benefits. While benefit already references health_plan directly, the more precise organizational u']
  health_plan_id varchar [note: 'Identifier of the health plan to which this benefit belongs.']
  regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: Individual benefits are mandated by specific regulatory obligations (ACA EHB mandates, state benefit mandates, EPSDT requirements). The existing regulatory_classification plain column is a denormalize']
  specialty_id varchar [note: 'Foreign key linking to provider.specialty. Business justification: Specialty-specific benefit design is a real business pattern in health insurance: mental health benefits tied to psychiatry/psychology specialties, preventive care benefits tied to PCP specialties, sp']
  year_id varchar [note: 'Foreign key linking to plan.year. Business justification: benefit has a denormalized plan_year INT column. The year table is the authoritative plan year configuration record for each health plan. Replacing plan_year INT with a year_id FK normalizes temporal ']
  accumulation_rule varchar [note: 'Rule governing how limits accumulate across periods.']
  authorization_required boolean [note: 'Indicates whether the benefit requires prior authorization.']
  authorization_type varchar [note: 'Timing of the required authorization relative to service delivery.']
  benefit_status varchar [note: 'Current lifecycle status of the benefit record.']
  category varchar [note: 'High‑level classification of the benefit type. [ENUM-REF-CANDIDATE: medical|dental|vision|pharmacy|behavioral|dme|snf|home_health|wellness|ancillary — 10 candidates stripped; promote to reference product]']
  code varchar [note: 'Business identifier or code used in core administration platforms to reference the benefit.']
  cost_sharing_amount decimal(12,2) [note: 'Fixed dollar amount for copay or deductible (if applicable).']
  cost_sharing_frequency varchar [note: 'Frequency at which cost‑sharing applies.']
  cost_sharing_percent decimal(5,2) [note: 'Percentage for coinsurance (e.g., 20.00 for 20%).']
  cost_sharing_type varchar [note: 'Mechanism by which the member shares cost (deductible, copay, coinsurance, or none).']
  coverage_type varchar [note: 'Indicates whether the benefit applies to in‑network, out‑of‑network, or both provider sets.']
  created_timestamp timestamp [note: 'Timestamp when the benefit record was first created in the system.']
  diagnosis_code varchar [note: 'Diagnosis code that may trigger the benefit or exclusion.']
  drug_ndc varchar [note: 'NDC identifier for pharmacy benefits, when applicable.']
  effective_end_date date [note: 'Date when the benefit ceases to be active; null for open‑ended benefits.']
  effective_start_date date [note: 'Date when the benefit becomes active for the plan year.']
  ehb_classification varchar [note: 'Flag indicating if the benefit satisfies ACA Essential Health Benefit requirements.']
  exclusion_code varchar [note: 'Code identifying the specific excluded service (e.g., CPT, HCPCS, NDC).']
  exclusion_reason varchar [note: 'Narrative reason for the exclusion (e.g., "experimental", "non‑covered diagnosis").']
  exclusion_type varchar [note: 'Category of service that is excluded from coverage.']
  formulary_tier varchar [note: 'Tier classification within the drug formulary.']
  group varchar [note: 'Member group to which the benefit applies.']
  is_exempt boolean [note: 'True if the benefit is exempt from certain regulations or cost‑sharing.']
  is_mandatory boolean [note: 'True if the benefit is required by law or contract.']
  limit_period varchar [note: 'Timeframe over which the limit applies.']
  limit_type varchar [note: 'Type of utilization limit (e.g., number of visits, days, dollar amount).']
  limit_value decimal(12,2) [note: 'Numeric value associated with the limit type.']
  moop_max_amount decimal(12,2) [note: 'Maximum out‑of‑pocket expense for the entire plan year, including deductibles and copays.']
  name varchar [note: 'Human‑readable name of the benefit (e.g., "Office Visit", "Generic Drug Tier 1").']
  oop_max_amount decimal(12,2) [note: 'Maximum out‑of‑pocket expense a member can incur in a benefit year.']
  preventive_service_flag boolean [note: 'True if the benefit is classified as a preventive service under ACA.']
  prior_auth_review_level varchar [note: 'Level of review required for the authorization (e.g., provider, clinical, pharmacy).']
  service_code varchar [note: 'Procedure or service code associated with the benefit.']
  tier varchar [note: 'Tier designation used in formulary or cost‑sharing structures.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the benefit record.']
  wellness_mandate_flag boolean [note: 'True if the benefit is mandated by wellness legislation or employer policy.']

  Note: 'Granular catalog of individual covered benefits within a benefit package — medical, dental, vision, behavioral health, pharmacy, DME, SNF, home health, preventive, wellness, and ancillary services. Each benefit record captures the benefit category, CPT/HCPCS service category, coverage type (in-network, out-of-network), and serves as the anchor for child-level structures: benefit limits (visit limits, day limits, dollar limits as child arrays), exclusions and non-covered service rules (as child arrays), ACA Essential Health Benefit (EHB) classification, wellness/preventive mandate flags, and prior authorization requirement indicators. Directly drives claims adjudication rules in Facets/QNXT. Sub-entities modeled as child arrays: benefit_limit (limit_type, limit_value, limit_period, accumulation_rule), benefit_exclusion (exclusion_type, exclusion_code, exclusion_reason), and benefit_authorization_flag (auth_required, auth_type, review_level).'
}

Table plan.cost_share_rule {
  cost_share_rule_id varchar [pk, note: 'System-generated unique identifier for the cost share rule.']
  benefit_id varchar [note: 'Identifier of the specific benefit (e.g., office visit) that the rule applies to.']
  benefit_package_id varchar [note: 'Identifier of the benefit package (group of benefits) containing the rule.']
  health_plan_id varchar [note: 'Identifier of the health plan to which the rule belongs.']
  regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: Cost-sharing rules must implement specific regulatory obligations (ACA out-of-pocket maximum limits, MHPAEA parity requirements, HSA-compatible HDHP rules). Linking cost_share_rule to regulatory_oblig']
  accumulator_threshold decimal(12,2) [note: 'Threshold amount that triggers a change in cost‑share (e.g., after $1,000 of spend).']
  accumulator_unit varchar [note: 'Unit of measure for the accumulator threshold.']
  after_deductible boolean [note: 'True if the cost‑share applies after the deductible is satisfied.']
  applies_to_ancillary boolean [note: 'True if the rule applies to ancillary services (lab, imaging).']
  applies_to_drug boolean [note: 'True if the rule applies to prescription drug services.']
  applies_to_procedure boolean [note: 'True if the rule applies to medical procedures (CPT/HCPCS).']
  applies_to_service_category varchar [note: 'Service categories to which the rule applies.']
  coinsurance_rate decimal(5,4) [note: 'Percentage of allowed amount the member pays after deductible (in‑network).']
  coinsurance_rate_out_of_network decimal(5,4) [note: 'Percentage of allowed amount the member pays after deductible (out‑of‑network).']
  copay_amount decimal(12,2) [note: 'Fixed dollar copay applied to a service when in‑network.']
  copay_amount_out_of_network decimal(12,2) [note: 'Fixed dollar copay applied to a service when out‑of‑network.']
  cost_share_category varchar [note: 'Logical grouping of the rule relative to deductible and out‑of‑pocket phases.']
  cost_share_rule_status varchar [note: 'Current lifecycle status of the rule.']
  created_timestamp timestamp [note: 'Timestamp when the rule record was first created.']
  deductible_aggregate_flag boolean [note: 'True if the deductible aggregates across multiple services or members.']
  deductible_amount decimal(12,2) [note: 'Dollar amount of the deductible that must be satisfied before cost‑share applies.']
  deductible_embedded_flag boolean [note: 'True if the deductible is embedded within the cost‑share rule (e.g., for HDHPs).']
  description varchar [note: 'Free‑form description of the rule\'s purpose and application.']
  effective_end_date date [note: 'Date when the rule expires (null for open‑ended).']
  effective_start_date date [note: 'Date when the rule becomes effective.']
  hsa_compatible boolean [note: 'True if the rule is compatible with a Health Savings Account (HDHP).']
  is_default_rule boolean [note: 'True if this rule is the default for its benefit when no other rule matches.']
  max_benefit_amount decimal(12,2) [note: 'Maximum dollar amount payable under this rule per service occurrence.']
  max_benefit_units varchar [note: 'Maximum number of units (e.g., visits) payable under this rule per benefit period.']
  member_tier varchar [note: 'Member classification for which the rule applies (individual, family, or group).']
  network_type varchar [note: 'Indicates whether the rule applies to in‑network, out‑of‑network, or both provider networks.']
  notes varchar [note: 'Free‑form field for any supplemental information or comments.']
  out_of_pocket_max decimal(12,2) [note: 'Maximum amount an individual member can pay out of pocket in a plan year.']
  out_of_pocket_max_family decimal(12,2) [note: 'Maximum amount a family can pay out of pocket in a plan year.']
  prior_to_deductible boolean [note: 'True if the cost‑share applies before the deductible is satisfied.']
  regulatory_classification varchar [note: 'Regulatory framework governing the rule (e.g., ACA, CMS).']
  rule_code varchar [note: 'Business code used to reference the rule in downstream systems.']
  rule_name varchar [note: 'Human‑readable name of the cost‑share rule.']
  rule_type varchar [note: 'Category of cost‑share rule (e.g., deductible, copay, coinsurance).']
  rule_version varchar [note: 'Incremental version number for change management.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the rule.']

  Note: 'Defines cost-sharing parameters for a specific benefit within a benefit package — deductibles, copays, coinsurance rates, out-of-pocket maximums (MOOP), and accumulator threshold definitions. Captures in-network vs. out-of-network differentials, individual vs. family tier logic, embedded vs. aggregate deductible flags, HSA-compatibility indicators for HDHP plans, cost-share tier (preventive exempt, before-deductible, after-deductible), and whether cost share applies before or after deductible satisfaction. Authoritative source for member cost-sharing design used in EOB generation and claims adjudication configuration.'
}

Table plan.year {
  year_id varchar [pk, note: 'Unique surrogate key for each plan year configuration record.']
  health_plan_id varchar [note: 'Foreign key reference to the master health plan that this year configuration belongs to.']
  aca_compliance_indicator boolean [note: 'True if the plan year meets Affordable Care Act reporting requirements.']
  accumulator_reset_date date [note: 'Date on which annual benefit accumulators (e.g., deductibles) are reset.']
  cms_plan_submission_deadline date [note: 'Final date to submit plan year details to Centers for Medicare & Medicaid Services.']
  created_timestamp timestamp [note: 'Timestamp when the plan year record was first created in the system.']
  currency_code varchar [note: 'Three‑letter ISO 4217 code representing the currency for premium amounts.']
  effective_from date [note: 'Date on which the plan year becomes legally effective.']
  effective_until date [note: 'Date on which the plan year ceases to be effective (nullable for open‑ended plans).']
  end_date date [note: 'Last day of the plan year coverage period.']
  grace_period_days varchar [note: 'Number of days after premium due date before coverage is terminated.']
  open_enrollment_end_date date [note: 'Last day of the open enrollment window for this plan year.']
  open_enrollment_start_date date [note: 'First day members may enroll or make changes for this plan year.']
  plan_year_budget_amount decimal(12,2) [note: 'Allocated budget for the plan year (used for internal financial planning).']
  plan_year_code varchar [note: 'Business identifier or code assigned to the plan year (e.g., FY2024-01).']
  plan_year_coverage_type varchar [note: 'Design of the health plan offering for the year.']
  plan_year_description varchar [note: 'Narrative description of the plan year configuration.']
  plan_year_market_segment varchar [note: 'Target market segment for the plan year (e.g., individual, group, government).']
  plan_year_notes varchar [note: 'Free‑form notes or comments entered by administrators.']
  plan_year_premium_rate decimal(12,4) [note: 'Base premium rate applied to members for this plan year.']
  plan_year_regulatory_classification varchar [note: 'Regulatory category governing the plan year.']
  plan_year_state varchar [note: 'Two‑letter state abbreviation where the plan year is offered.']
  plan_year_type varchar [note: 'Classification of the plan year calendar basis: calendar year, fiscal year, or custom.']
  premium_effective_date date [note: 'Date when the premium amount for the plan year takes effect.']
  regulatory_filing_required boolean [note: 'Indicates whether a regulatory filing is required for this plan year.']
  revision_number varchar [note: 'Revision identifier for changes made within a version.']
  run_out_period_days varchar [note: 'Days after plan year end during which claims can still be submitted.']
  special_enrollment_period_rules varchar [note: 'Textual rules governing qualifying life events and special enrollment periods.']
  start_date date [note: 'First day of the plan year coverage period.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the plan year record.']
  version_number varchar [note: 'Sequential version number for the plan year configuration.']
  year_status varchar [note: 'Current lifecycle status of the plan year configuration.']

  Note: 'Defines the plan year configuration for each health plan — plan year start and end dates, open enrollment window, special enrollment period rules, grace period duration, run-out period, and plan year type (calendar year vs. non-calendar year). Governs accumulator reset logic, benefit renewal, and premium rate effective dates. Supports ACA plan year compliance and CMS reporting requirements.'
}

Table plan.rate {
  rate_id varchar [pk, note: 'Unique surrogate key for each plan rate record.']
  health_plan_id varchar [note: 'Identifier of the health plan to which this rate applies.']
  rate_development_id varchar [note: 'Foreign key linking to risk.rate_development. Business justification: Actuarial rate development produces the base rates, age factors, and trend factors that populate plan.rate records. Linking plan.rate to risk.rate_development enables actuarial audit trails, regulator']
  regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: Rate filings must comply with specific regulatory obligations (state rate review requirements, ACA rate increase justification thresholds, CMS rate filing deadlines). Linking rate to regulatory_obliga']
  year_id varchar [note: 'Foreign key linking to plan.year. Business justification: rate has a denormalized plan_year INT column. Premium rates are defined per plan year, and the year table is the authoritative plan year record. Replacing plan_year INT with a year_id FK normalizes th']
  age_rated_premium decimal(12,4) [note: 'Premium amount after applying the age factor to the base rate.']
  base_rate decimal(12,4) [note: 'Base premium amount before age or family adjustments, expressed in the plan currency.']
  change_reason varchar [note: 'Free‑text explanation for why the rate was created or modified.']
  code varchar [note: 'External code used by actuarial systems to identify the rate.']
  cost_sharing_rule_code varchar [note: 'Code that identifies the cost‑sharing rule (deductible, copay, coinsurance) associated with the plan.']
  created_timestamp timestamp [note: 'Timestamp when the rate record was first created in the data lake.']
  currency_code varchar [note: 'Three‑letter ISO currency code for the premium amounts (e.g., USD).']
  effective_date date [note: 'Date on which the rate becomes effective for enrollment.']
  family_tier varchar [note: 'Category of coverage for the enrollee: employee only, employee + spouse, employee + child, or family.']
  family_tier_premium decimal(12,4) [note: 'Premium amount for the specified family tier.']
  filing_reference varchar [note: 'Reference number for the filing submitted to the Department of Insurance.']
  is_tobacco_surcharge_applicable boolean [note: 'Indicates if a tobacco surcharge is applied to this rate.']
  market_segment varchar [note: 'Segment of the market the rate applies to: individual, small group, or large group.']
  max_age varchar [note: 'Inclusive upper bound of the age band for this rate.']
  min_age varchar [note: 'Inclusive lower bound of the age band for this rate.']
  name varchar [note: 'Human‑readable name for the rate definition.']
  plan_designation varchar [note: 'Type of health plan product (e.g., HMO, PPO).']
  premium_type varchar [note: 'Frequency at which the premium is billed.']
  rate_status varchar [note: 'Current lifecycle status of the rate.']
  rating_area_code varchar [note: 'Three‑character code representing the geographic rating area defined by CMS.']
  surcharge_amount decimal(12,4) [note: 'Monetary amount added to the premium for tobacco users.']
  termination_date date [note: 'Date on which the rate is no longer valid; null if open‑ended.']
  tobacco_use_indicator varchar [note: 'Indicates whether the member uses tobacco (yes) or not (no).']
  underwriting_class_code varchar [note: 'Code representing the underwriting class applied to the rate.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the rate record.']
  version varchar [note: 'Version identifier for the rate definition (e.g., v1, v2).']

  Note: 'Premium rate table for each health plan by rating factors — age band, geographic rating area, tobacco use, plan year, and market segment (individual, small group, large group). Captures the base rate, age-rated premium, family tier premium (employee only, employee + spouse, employee + child, family), rating area code, effective and termination dates, and rate filing reference. Supports premium billing, quoting, and DOI rate filing compliance. Sourced from actuarial rate-setting and pricing systems.'
}

Table plan.plan_service_area {
  plan_service_area_id varchar [pk, note: 'Unique surrogate key for the plan service area record.']
  health_plan_id varchar [note: 'Identifier of the health plan associated with this service area.']
  regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: Service area definitions must comply with network adequacy and geographic coverage regulatory obligations (CMS network adequacy standards, state geographic coverage mandates). Linking plan_service_are']
  year_id varchar [note: 'Foreign key linking to plan.year. Business justification: plan_service_area has a denormalized plan_year INT column. Service area authorizations are defined per plan year — a health plan\'s geographic coverage may change year over year. Replacing plan_year IN']
  county varchar [note: 'County name within the state for the service area.']
  coverage_type varchar [note: 'Type of health plan coverage associated with this service area.']
  created_timestamp timestamp [note: 'Timestamp when the service area record was created.']
  effective_end_date date [note: 'Date when the service area ceases to be effective (nullable for open‑ended).']
  effective_start_date date [note: 'Date when the service area becomes effective for enrollment.']
  enrollment_capacity varchar [note: 'Maximum number of members that can be enrolled in this service area.']
  exchange_market varchar [note: 'Name of the ACA exchange market (if applicable) where the plan is offered.']
  exchange_market_code varchar [note: 'Unique identifier for the exchange market.']
  geographic_region_code varchar [note: 'Standard code representing the broader geographic region for the service area.']
  is_exclusive boolean [note: 'Indicates whether the service area is exclusive to this plan (True) or shared (False).']
  is_federal_funded boolean [note: 'Indicates whether the service area receives federal funding.']
  is_medicaid_eligible boolean [note: 'Indicates if the service area is eligible for Medicaid plans.']
  is_medicare_eligible boolean [note: 'Indicates if the service area is eligible for Medicare Advantage plans.']
  is_regulatory_compliant boolean [note: 'Indicates whether the service area meets all regulatory requirements.']
  is_state_funded boolean [note: 'Indicates whether the service area receives state funding.']
  lifecycle_status varchar [note: 'Current lifecycle status of the service area record.']
  network_type varchar [note: 'Specifies if the service area applies to in‑network or out‑of‑network coverage.']
  notes varchar [note: 'Free‑text notes regarding the service area.']
  plan_category varchar [note: 'Broad category of the plan associated with the service area.']
  regulatory_approval_status varchar [note: 'Current status of regulatory approval for the service area.']
  regulatory_filing_number varchar [note: 'Reference number for the regulatory filing associated with this service area.']
  service_area_code varchar [note: 'Unique identifier assigned by CMS for the service area.']
  service_area_name varchar [note: 'Human‑readable name of the geographic service area.']
  service_area_type varchar [note: 'Geographic granularity of the service area.']
  state varchar [note: 'Two‑letter US state abbreviation where the service area is located.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the service area record.']
  version_number varchar [note: 'Version of the service area record for change tracking.']
  zip_codes_excluded varchar [note: 'Comma‑separated list of ZIP codes excluded from the service area.']
  zip_codes_included varchar [note: 'Comma‑separated list of ZIP codes included in the service area.']

  Note: 'Defines the geographic service area in which a health plan is authorized to enroll members and provide coverage. Captures the service area name, state, county, zip code inclusions/exclusions, CMS service area ID, effective dates, and regulatory approval status. Required for CMS QHP submissions, Medicare Advantage service area filings, and state DOI market conduct compliance. Governs member eligibility for plan enrollment based on residence.'
}

Table plan.rx_benefit_config {
  rx_benefit_config_id varchar [pk, note: 'System‑generated unique identifier for the pharmacy benefit configuration record.']
  formulary_id varchar [note: 'Unique identifier of the drug formulary associated with this configuration.']
  health_plan_id varchar [note: 'Identifier of the health plan to which this pharmacy benefit configuration applies.']
  regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: Rx benefit configurations must comply with ACA preventive drug mandates (USPSTF A/B rated drugs at $0 cost-sharing), state drug coverage mandates, and CMS formulary requirements. Linking rx_benefit_co']
  coinsurance_rate decimal(5,2) [note: 'Coinsurance rate expressed as a percentage of the allowed amount.']
  cost_sharing_method varchar [note: 'Method used to calculate member cost‑sharing (copay, coinsurance, or percentage).']
  coverage_limit_per_prescription decimal(10,2) [note: 'Maximum reimbursable amount for a single prescription fill.']
  coverage_limit_per_year decimal(10,2) [note: 'Annual dollar limit on pharmacy benefit coverage.']
  created_timestamp timestamp [note: 'Timestamp when the record was first created in the data lake.']
  deductible_amount decimal(10,2) [note: 'Dollar amount of the pharmacy deductible.']
  deductible_applicable boolean [note: 'Indicates whether the plan deductible applies to pharmacy benefits.']
  drug_category_exclusions varchar [note: 'Comma‑separated list of drug categories that are excluded from coverage.']
  effective_end_date date [note: 'Date when this pharmacy benefit configuration expires or is superseded.']
  effective_start_date date [note: 'Date when this pharmacy benefit configuration becomes effective.']
  formulary_version varchar [note: 'Version string of the formulary to support change tracking and audits.']
  is_biologic_preferred boolean [note: 'True if biologic drugs are preferred within the formulary.']
  is_biosimilar_preferred boolean [note: 'True if biosimilar drugs are preferred over reference biologics.']
  is_exempt_from_mlr boolean [note: 'True if the plan is exempt from MLR reporting requirements for this pharmacy benefit.']
  is_specialty_drug_excluded boolean [note: 'Indicates whether specialty drugs are excluded from coverage.']
  last_review_date date [note: 'Date when the configuration was last reviewed for compliance or policy changes.']
  mail_order_network_type varchar [note: 'Classification of the mail‑order pharmacy network.']
  max_coverage_amount decimal(10,2) [note: 'Upper limit on total pharmacy benefit coverage per benefit period.']
  ninety_day_supply_allowed boolean [note: 'True if a 90‑day supply of medication is permitted under this benefit configuration.']
  notes varchar [note: 'Free‑form text for additional comments or special instructions.']
  out_of_pocket_max decimal(10,2) [note: 'Maximum out‑of‑pocket expense a member can incur for pharmacy benefits.']
  pbm_vendor varchar [note: 'Name of the PBM vendor that administers the formulary and pharmacy benefits.']
  prior_auth_exemption_drugs varchar [note: 'List of NDCs for which prior authorization is waived.']
  retail_network_type varchar [note: 'Classification of the retail pharmacy network (e.g., in‑network or out‑of‑network).']
  rx_benefit_config_status varchar [note: 'Current lifecycle status of the benefit configuration.']
  specialty_pharmacy_network varchar [note: 'Name or code of the specialty pharmacy network used for high‑cost drugs.']
  step_therapy_required boolean [note: 'Indicates whether step‑therapy (sequential drug use) is required for covered drugs.']
  therapeutic_class_limit varchar [note: 'Maximum number of distinct therapeutic classes allowed per member per year.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the record.']
  version_number varchar [note: 'Incremental version number for change management.']

  Note: 'Pharmacy benefit configuration record linking a health plan to its PBM formulary and defining pharmacy-specific cost-sharing rules — retail vs. mail-order copay differentials, specialty pharmacy requirements, 90-day supply rules, mandatory generic substitution flags, and specialty drug management programs. Captures the PBM vendor, formulary ID, retail network type, mail-order network, specialty pharmacy network, and drug management program flags. Sourced from RxClaim/Argus PBM integration.'
}

Table plan.network_config {
  network_config_id varchar [pk, note: 'System-generated unique identifier for each plan‑network configuration record.']
  health_plan_id varchar [note: 'Unique identifier of the health plan to which this network configuration applies.']
  provider_network_id varchar [note: 'Unique identifier of the provider network associated with the plan.']
  access_type varchar [note: 'Access model of the plan for this network (e.g., HMO closed, PPO open).']
  created_timestamp timestamp [note: 'Timestamp when the configuration record was first created in the system.']
  effective_end_date date [note: 'Date when this plan‑network configuration ceases to be effective (null if open‑ended).']
  effective_start_date date [note: 'Date when this plan‑network configuration becomes effective.']
  network_adequacy_measure varchar [note: 'Metric or description used to assess network adequacy (e.g., provider‑to‑member ratio).']
  network_adequacy_standard_code varchar [note: 'Code referencing the CMS‑defined adequacy standard applied to this network.']
  network_config_status varchar [note: 'Current lifecycle status of the configuration record.']
  network_contract_number varchar [note: 'Identifier of the contractual agreement governing the provider network.']
  network_coverage_type varchar [note: 'Extent of coverage provided by the network for the plan (full, partial, or none).']
  network_designation varchar [note: 'Overall designation of the network relative to the plan (in‑network, out‑of‑network, or partial).']
  network_exclusion_description varchar [note: 'Textual description of exclusions when the exclusion flag is true.']
  network_exclusion_flag boolean [note: 'Indicates whether the network has any excluded providers or services.']
  network_geography_region varchar [note: 'Geographic region code (e.g., Northeast, Midwest) where the network operates.']
  network_provider_count varchar [note: 'Total number of active providers participating in the network for the plan.']
  network_state varchar [note: 'Two‑letter state abbreviation for the primary state of the network.']
  network_tier varchar [note: 'Tier designation of the network for the plan (e.g., Tier 1 preferred, Tier 2 standard).']
  network_zip_code varchar [note: 'Primary ZIP code associated with the network\'s main service area.']
  out_of_network_benefit_type varchar [note: 'Type of benefit applied to out‑of‑network services (copay, coinsurance, or none).']
  out_of_network_coinsurance_pct decimal(5,2) [note: 'Percentage of allowed amount the member pays for out‑of‑network services when benefit type is coinsurance.']
  out_of_network_copay_amount decimal(10,2) [note: 'Fixed dollar copay amount for out‑of‑network services when benefit type is copay.']
  out_of_network_coverage_flag boolean [note: 'Indicates whether the plan provides any benefit for out‑of‑network services.']
  tier_priority varchar [note: 'Numeric priority used to order tiers when multiple tiers exist.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the configuration record.']

  Note: 'Associates a health plan with its provider network configuration — defining which provider networks are in-network for the plan, tiered network designations (Tier 1 preferred, Tier 2 standard), out-of-network coverage rules, and network adequacy standards. Captures the network ID, network tier, access type (HMO closed, PPO open, EPO exclusive), out-of-network benefit flag, and effective dates. Links the plan domain to the network domain for claims adjudication and member directory services.'
}

Table provider.specialty {
  specialty_id varchar [pk, note: 'Primary key for specialty']
  provider_id varchar [note: 'Reference to the healthcare provider who holds this specialty designation. Links to the provider master entity.']
  accepting_new_patients_flag boolean [note: 'Indicates whether the provider is currently accepting new patients for this specialty. True if accepting; False if panel is closed. Used for provider directory accuracy.']
  board_certified_flag boolean [note: 'Indicates whether the provider is board certified in this specialty. True if certified by a recognized medical board; False otherwise.']
  category varchar [note: 'High-level grouping of the specialty into major healthcare service categories for network adequacy and reporting purposes. [ENUM-REF-CANDIDATE: allopathic_osteopathic|dental|behavioral_health|chiropractic|podiatric|nursing|pharmacy|ancillary — 8 candidates stripped; promote to reference product]']
  certification_date date [note: 'The date on which the provider was initially certified by the board in this specialty. Format: yyyy-MM-dd.']
  certification_expiration_date date [note: 'The date on which the board certification expires and requires renewal. Null if certification does not expire or is lifetime. Format: yyyy-MM-dd.']
  certification_number varchar [note: 'The unique certification number or identifier issued by the certifying board for this specialty. Used for verification purposes.']
  certifying_board_name varchar [note: 'The name of the medical board or certifying organization that granted board certification for this specialty (e.g., American Board of Internal Medicine, American Board of Surgery). Null if not board certified.']
  code varchar [note: 'The National Uniform Claim Committee (NUCC) Health Care Provider Taxonomy Code representing the provider\'s specialty classification. Ten-digit alphanumeric code with an X in the 11th position.']
  credentialing_effective_date date [note: 'The date on which the provider\'s credentialing for this specialty became effective within the health plan\'s network. Format: yyyy-MM-dd.']
  credentialing_end_date date [note: 'The date on which the provider\'s credentialing for this specialty ended or will end. Null if currently active with no planned end date. Format: yyyy-MM-dd.']
  credentialing_review_date date [note: 'The date of the most recent credentialing review or recredentialing for this specialty. NCQA requires recredentialing at least every three years. Format: yyyy-MM-dd.']
  credentialing_status varchar [note: 'The current credentialing status of the provider for this specific specialty within the health plan\'s network. Active indicates the provider is credentialed and authorized to provide services in this specialty.']
  current_record_flag boolean [note: 'Indicates whether this is the current active version of the specialty record. True for the current record; False for historical versions. Supports slowly changing dimension (SCD) Type 2 historization.']
  end_date date [note: 'The date on which the provider stopped practicing in this specialty, if applicable. Null if the provider is still actively practicing in this specialty. Format: yyyy-MM-dd.']
  fellowship_completed_flag boolean [note: 'Indicates whether the provider completed a fellowship program in this specialty or subspecialty. True if fellowship training was completed; False otherwise.']
  fellowship_completion_date date [note: 'The date on which the provider completed the fellowship program. Format: yyyy-MM-dd. Null if no fellowship was completed.']
  fellowship_program_name varchar [note: 'The name of the fellowship program and institution where the provider completed subspecialty training. Null if no fellowship was completed.']
  hedis_specialty_flag boolean [note: 'Indicates whether this specialty is relevant for HEDIS measure attribution and quality reporting. True if the specialty is used in HEDIS measure calculations; False otherwise.']
  name varchar [note: 'The human-readable name of the specialty (e.g., Cardiology, Orthopedic Surgery, Family Medicine). Corresponds to the specialty taxonomy code.']
  network_adequacy_category varchar [note: 'The network adequacy category or specialty grouping used for regulatory reporting and network adequacy analysis. Maps specialty to state-specific or CMS network adequacy standards.']
  next_credentialing_review_date date [note: 'The scheduled date for the next credentialing review or recredentialing for this specialty. Used for compliance tracking and proactive credentialing management. Format: yyyy-MM-dd.']
  pcp_eligible_flag boolean [note: 'Indicates whether this specialty qualifies the provider to serve as a Primary Care Provider (PCP) for member assignment. True for specialties such as Family Medicine, Internal Medicine, Pediatrics, and General Practice.']
  recertification_cycle_years varchar [note: 'The number of years in the recertification cycle (e.g., 10 years for most ABMS boards). Null if recertification is not required.']
  recertification_required_flag boolean [note: 'Indicates whether the board certification requires periodic recertification or maintenance of certification (MOC). True if recertification is required; False if lifetime certification.']
  record_created_timestamp timestamp [note: 'The timestamp when this specialty record was first created in the data platform. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX. Used for audit trail and data lineage.']
  record_effective_date date [note: 'The date from which this version of the specialty record is effective for business purposes. Supports slowly changing dimension (SCD) Type 2 historization. Format: yyyy-MM-dd.']
  record_end_date date [note: 'The date on which this version of the specialty record ceased to be effective. Null for the current active record. Supports slowly changing dimension (SCD) Type 2 historization. Format: yyyy-MM-dd.']
  record_updated_timestamp timestamp [note: 'The timestamp when this specialty record was last updated in the data platform. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX. Used for audit trail and change tracking.']
  source_system_code varchar [note: 'The unique identifier for this specialty record in the source system. Used for data lineage, reconciliation, and troubleshooting.']
  specialist_referral_required_flag boolean [note: 'Indicates whether members require a referral from their PCP to see this provider in this specialty, based on plan type (e.g., HMO requires referrals; PPO typically does not). True if referral is required; False otherwise.']
  specialty_type varchar [note: 'Indicates whether this is the provider\'s primary specialty, secondary specialty, or tertiary specialty. Primary specialty is the main area of practice; secondary and tertiary are additional areas of expertise.']
  start_date date [note: 'The date on which the provider began practicing in this specialty. Used to calculate years of experience and for credentialing verification. Format: yyyy-MM-dd.']
  subspecialty_code varchar [note: 'Additional NUCC taxonomy code representing a subspecialty within the primary specialty (e.g., Interventional Cardiology within Cardiology). Null if no subspecialty designation.']
  subspecialty_name varchar [note: 'The human-readable name of the subspecialty, if applicable. Provides additional granularity beyond the primary specialty for network adequacy and member search.']
  telehealth_enabled_flag boolean [note: 'Indicates whether the provider offers telehealth or telemedicine services for this specialty. True if telehealth services are available; False otherwise. Important for provider directory accuracy.']
  years_in_specialty varchar [note: 'The number of years the provider has been practicing in this specialty. Calculated from the date the provider first began practicing in this specialty area.']

  Note: 'Tracks all specialty and sub-specialty designations for a provider, including primary and secondary specialties, NUCC taxonomy codes, board certification details, certification body, certification date, expiration date, and specialty-level credentialing status. A provider may hold multiple specialties across different taxonomies. Supports network adequacy analysis by specialty and HEDIS measure attribution.'
}

Table provider.practice_location {
  practice_location_id varchar [pk, note: 'Unique identifier for the practice location. Primary key.']
  facility_id varchar [note: 'Foreign key linking to provider.facility. Business justification: A practice location can be physically situated within a healthcare facility (e.g., a physician\'s office inside a hospital or ASC). Adding facility_id FK normalizes this relationship and allows the dir']
  group_practice_id varchar [note: 'Foreign key linking to provider.group_practice. Business justification: A practice location is operated by a medical group or group practice. The practice_location table currently stores medical_group_name as a denormalized STRING. Adding group_practice_id FK normalizes t']
  primary_practice_medicaid_provider_id varchar [note: 'State-specific Medicaid provider identifier for this practice location. Required for Medicaid claims submission.']
  tertiary_practice_practitioner_provider_id varchar [note: 'Reference to the primary provider associated with this practice location. A provider may have multiple practice locations.']
  accepting_new_patients_flag boolean [note: 'Indicates whether this practice location is currently accepting new patients. Critical for member provider search and network adequacy.']
  ada_compliant_flag boolean [note: 'Indicates whether the practice location meets ADA accessibility requirements.']
  address_line_1 varchar [note: 'Primary street address of the practice location (street number and name).']
  address_line_2 varchar [note: 'Secondary address information such as suite, floor, building, or unit number.']
  city varchar [note: 'City name of the practice location.']
  county_name varchar [note: 'County name where the practice location is situated. Used for network adequacy geographic access analysis.']
  created_timestamp timestamp [note: 'Timestamp when this practice location record was first created in the system.']
  directory_display_flag boolean [note: 'Indicates whether this practice location should be displayed in the member-facing provider directory. May be false even if active (e.g., administrative locations).']
  effective_date date [note: 'Date when this practice location became active in the provider network.']
  email_address varchar [note: 'Primary email contact for the practice location for administrative and member communication.']
  fax_number varchar [note: 'Fax number for the practice location used for prior authorization and medical records transmission.']
  fips_code varchar [note: '5-digit FIPS county code for geographic identification and network adequacy reporting.']
  languages_spoken varchar [note: 'Comma-separated list of languages spoken by staff at this practice location (e.g., \'English, Spanish, Mandarin\'). Supports member language access requirements.']
  last_verified_date date [note: 'Date when the practice location information was last verified for accuracy. CMS requires quarterly verification for provider directory data.']
  latitude decimal(10,7) [note: 'Geographic latitude coordinate of the practice location in decimal degrees. Used for time/distance network adequacy calculations.']
  location_name varchar [note: 'Business name or designation of the practice location (e.g., \'Main Street Family Medicine\', \'Downtown Urgent Care Center\').']
  location_type varchar [note: 'Classification of the practice location type indicating the care delivery setting.']
  longitude decimal(10,7) [note: 'Geographic longitude coordinate of the practice location in decimal degrees. Used for time/distance network adequacy calculations.']
  npi varchar [note: '10-digit National Provider Identifier for this practice location if it has a Type 2 (organizational) NPI. May be null if location uses only the provider\'s individual NPI.']
  office_hours varchar [note: 'Operating hours of the practice location (e.g., \'Mon-Fri 8:00 AM - 5:00 PM, Sat 9:00 AM - 1:00 PM\'). Free-text field for member-facing display.']
  parking_available_flag boolean [note: 'Indicates whether on-site or nearby parking is available for patients.']
  participation_status varchar [note: 'Current participation status of this practice location in the provider network. Determines whether location appears in member-facing provider directory.']
  patient_age_maximum varchar [note: 'Maximum patient age accepted at this practice location (e.g., 18 for pediatrics only). Null if no maximum restriction.']
  patient_age_minimum varchar [note: 'Minimum patient age accepted at this practice location (e.g., 0 for all ages, 18 for adults only). Null if no minimum restriction.']
  patient_gender_restriction varchar [note: 'Gender restriction for patients served at this location (e.g., \'female_only\' for women\'s health clinics).']
  phone_number varchar [note: 'Primary contact phone number for the practice location (10-digit format without formatting).']
  public_transportation_access_flag boolean [note: 'Indicates whether the practice location is accessible via public transportation.']
  record_status varchar [note: 'Current status of this practice location record in the data warehouse. Supports soft-delete and historical tracking.']
  state_code varchar [note: 'Two-letter state abbreviation (e.g., \'CA\', \'NY\', \'TX\').']
  tax_identifier varchar [note: 'Federal Tax Identification Number (EIN) for the practice location or medical group. Used for claims payment and 1099 reporting.']
  telehealth_available_flag boolean [note: 'Indicates whether telehealth services are available at this practice location.']
  termination_date date [note: 'Date when this practice location was terminated from the provider network. Null if currently active.']
  updated_timestamp timestamp [note: 'Timestamp when this practice location record was last modified.']
  verification_method varchar [note: 'Method used for the most recent verification of practice location information.']
  wheelchair_accessible_flag boolean [note: 'Indicates whether the practice location has wheelchair accessibility features (ramps, elevators, accessible restrooms).']
  zip_code varchar [note: '5-digit or ZIP+4 postal code for the practice location.']

  Note: 'Represents a physical or virtual practice location where a provider delivers care. Captures address (street, city, state, ZIP+4), county, FIPS code, geolocation (lat/long), phone, fax, office hours, accessibility features (ADA compliance, wheelchair access), telehealth availability, accepting new patients flag by location, patient age/population restrictions, and location type (office, hospital, urgent care, telehealth-only). Supports CMS provider directory accuracy requirements, network adequacy geographic access standards (time/distance), and member-facing provider search. A provider may have multiple practice locations; each location may serve multiple providers.'
}

Table provider.license {
  license_id varchar [pk, note: 'Primary key for license']
  provider_id varchar [note: 'Reference to the healthcare provider who holds this license. Links to the provider master entity.']
  attestation_date date [note: 'The date the provider attested to the accuracy and currency of this license information. Used for credentialing and recredentialing cycles.']
  authorized_schedules varchar [note: 'For DEA and CDS registrations, the controlled substance schedules the provider is authorized to prescribe (Schedule II, III, IV, V). Stored as comma-separated list. Critical for pharmacy benefit management and prior authorization workflows.']
  compact_participation_flag boolean [note: 'Indicates whether this license is part of an interstate licensure compact (e.g., Interstate Medical Licensure Compact, Nurse Licensure Compact). True if the license grants multi-state practice privileges; false otherwise.']
  compact_privilege_states varchar [note: 'Comma-separated list of state abbreviations where the provider has practice privileges under the interstate compact. Used for multi-state network adequacy and provider directory management.']
  compact_type varchar [note: 'The specific interstate licensure compact this license participates in. IMLC is Interstate Medical Licensure Compact for physicians. Populated only when compact_participation_flag is true. [ENUM-REF-CANDIDATE: imlc|nurse_licensure_compact|psychology_compact|physical_therapy_compact|ems_compact|counseling_compact|none — 7 candidates stripped; promote to reference product]']
  continuing_education_hours_required decimal(6,2) [note: 'The number of continuing education or CME hours required per renewal cycle to maintain this license. Varies by state and license type.']
  continuing_education_required_flag boolean [note: 'Indicates whether continuing education (CE) or continuing medical education (CME) is required to maintain this license. True if CE/CME is mandatory for renewal; false otherwise.']
  disciplinary_action_date date [note: 'The date disciplinary action was taken against the license. Used for credentialing review timelines and risk assessment.']
  disciplinary_action_details varchar [note: 'Detailed description of any disciplinary actions, sanctions, or restrictions imposed by the licensing authority. Includes nature of violation, dates, and resolution. Populated only when disciplinary_action_flag is true.']
  disciplinary_action_flag boolean [note: 'Indicates whether any disciplinary action has been taken against this license by the issuing authority. True if disciplinary action exists; false otherwise. Critical for credentialing risk assessment.']
  effective_date date [note: 'The date the license becomes valid and the provider is authorized to practice under this credential. May differ from issue date for renewals or reinstatements.']
  expiration_date date [note: 'The date the license expires and is no longer valid unless renewed. Critical for credentialing compliance and provider directory accuracy. Null for licenses with no expiration.']
  issue_date date [note: 'The date the license or registration was originally issued by the licensing authority. Used to calculate license tenure and verify historical credentialing timelines.']
  issuing_authority varchar [note: 'The regulatory body or government agency that issued the license or registration. Examples include State Medical Board, State Board of Nursing, Drug Enforcement Administration (DEA), State Pharmacy Board, or Centers for Medicare and Medicaid Services (CMS).']
  issuing_state varchar [note: 'The U.S. state or territory that issued the license. Uses two-letter state abbreviation. Critical for multi-state licensure tracking and Interstate Medical Licensure Compact compliance. [ENUM-REF-CANDIDATE: AL|AK|AZ|AR|CA|CO|CT|DE|FL|GA|HI|ID|IL|IN|IA|KS|KY|LA|ME|MD|MA|MI|MN|MS|MO|MT|NE|NV|NH|NJ|NM|NY|NC|ND|OH|OK|OR|PA|RI|SC|SD|TN|TX|UT|VT|VA|WA|WV|WI|WY|DC — 51 candidates stripped; promote to reference product]']
  license_status varchar [note: 'Current status of the license or registration in its lifecycle. Active indicates the license is valid and in good standing; suspended, revoked, or expired indicate the provider cannot practice under this credential. [ENUM-REF-CANDIDATE: active|inactive|suspended|revoked|expired|surrendered|pending_renewal|probation|restricted — 9 candidates stripped; promote to reference product]']
  license_type varchar [note: 'The category of professional license or registration. Includes state medical licenses (MD, DO), nursing licenses (RN, LPN, NP), DEA controlled substance registrations, state CDS permits, pharmacy licenses, and other professional certifications. [ENUM-REF-CANDIDATE: medical_license|nursing_license|dea_registration|cds_permit|pharmacy_license|dental_license|optometry_license|podiatry_license|chiropractic_license|physical_therapy_license|occupational_therapy_license|behavioral_health_license|advanced_practice_license|physician_assistant_license|other — 15 candidates stripped; promote to reference product]']
  number varchar [note: 'The unique license or registration number issued by the licensing authority. For DEA registrations, this is the DEA number; for state medical licenses, this is the state-issued license number.']
  practice_restrictions varchar [note: 'Any limitations or restrictions placed on the license by the issuing authority. May include supervision requirements, practice setting restrictions, or specific clinical limitations.']
  primary_source_verification_date date [note: 'The date the license was last verified directly with the issuing authority (primary source). NCQA requires PSV within 180 days of credentialing decision and every 36 months thereafter.']
  primary_source_verification_method varchar [note: 'The method used to verify the license with the primary source. Includes online state board portals, written correspondence, phone verification, third-party credentialing services, or automated API integration.']
  record_created_timestamp timestamp [note: 'The date and time this license record was first created in the data platform. Used for audit trail and data lineage tracking.']
  record_current_flag boolean [note: 'Indicates whether this is the current active version of the license record. True for the current record; false for historical versions. Supports Type 2 slowly changing dimension queries.']
  record_effective_timestamp timestamp [note: 'The date and time from which this version of the license record is effective for business reporting. Supports Type 2 slowly changing dimension tracking.']
  record_end_timestamp timestamp [note: 'The date and time when this version of the license record was superseded by a new version. Null for the current active record. Supports Type 2 slowly changing dimension tracking.']
  record_updated_timestamp timestamp [note: 'The date and time this license record was last modified in the data platform. Used for change tracking and audit purposes.']
  renewal_cycle_months varchar [note: 'The number of months between required renewals for this license type. Common values are 12, 24, or 36 months depending on state and license type.']
  renewal_date date [note: 'The date the license was last renewed. Used to track renewal cycles and ensure continuous licensure for credentialing purposes.']
  scope_of_practice varchar [note: 'Description of the clinical activities and services the provider is authorized to perform under this license. Varies by license type and state regulations. Used for state-specific scope-of-practice validation.']
  source_system_code varchar [note: 'The unique identifier for this license record in the source operational system. Used for data lineage and reconciliation.']
  telemedicine_authorized_flag boolean [note: 'Indicates whether the provider is authorized to deliver telemedicine services under this license. True if telemedicine practice is permitted; false otherwise. Critical for virtual care network management.']
  verification_source varchar [note: 'The specific entity or system used to perform primary source verification. Examples include state medical board website, NPDB, third-party credentialing verification organization (CVO), or automated verification service.']
  verification_url varchar [note: 'The web address of the state licensing board or regulatory authority where the license can be verified online. Used for automated primary source verification workflows.']

  Note: 'Single source of truth for all professional licenses, certifications, and regulatory registrations held by a provider. Covers state medical licenses (MD, DO, NP, PA, RN, LCSW, LPC, etc.), DEA controlled substance registrations (including authorized schedules II-V and registration state), CDS (state-level controlled dangerous substance) permits, state pharmacy licenses, and other regulatory registrations. Stores license/registration type, issuing authority (state medical board, state nursing board, DEA, CMS, state pharmacy board), license or registration number, authorized schedules (for DEA/CDS), issue date, expiration date, renewal date, status (active, suspended, revoked, expired, surrendered, pending renewal), disciplinary action flags, disciplinary action details, and primary source verification (PSV) date and source. Supports NCQA credentialing standards for PSV, multi-state licensure tracking via Interstate Medical Licensure Compact, controlled substance prescribing authorization, pharmacy benefit management workflows, and state-specific scope-of-practice validation.'
}

Table provider.affiliation {
  affiliation_id varchar [pk, note: 'Primary key for affiliation']
  facility_id varchar [note: 'Foreign key linking to provider.facility. Business justification: The affiliation table captures hospital affiliations and admitting privileges (admitting_privileges_flag is present). Currently there is no FK to the facility where these privileges are held — the rel']
  group_practice_id varchar [note: 'Foreign key linking to provider.group_practice. Business justification: affiliation should reference the medical group (group_practice) it belongs to; the existing column name does not match target PK naming, so a new FK column is added and the generic column removed.']
  provider_id varchar [note: 'Reference to the individual provider (physician, nurse practitioner, or other healthcare professional) who holds this affiliation. Links to the provider master entity.']
  accepting_new_patients_flag boolean [note: 'Boolean indicator denoting whether the provider is accepting new patients through this affiliation. True indicates accepting new patients; False indicates not accepting new patients.']
  admitting_privileges_flag boolean [note: 'Boolean indicator denoting whether the provider has admitting privileges at the affiliated hospital or facility. True indicates admitting privileges are granted; False indicates no admitting privileges.']
  affiliation_status varchar [note: 'Current lifecycle status of the provider affiliation. Indicates whether the affiliation is active and in effect, inactive, suspended, pending approval, or terminated.']
  affiliation_type varchar [note: 'Categorical classification of the affiliation relationship. Indicates whether the provider is affiliated with a medical group, Independent Practice Association (IPA), Accountable Care Organization (ACO), health system, hospital, or other facility type.']
  billing_npi varchar [note: 'The National Provider Identifier (NPI) used for billing purposes in this affiliation context. May represent the organizational NPI (Type 2) of the affiliated entity.']
  created_timestamp timestamp [note: 'The date and time when this affiliation record was first created in the system. Used for audit trail and data lineage tracking.']
  credentialing_verification_date date [note: 'The date on which the provider\'s credentials and affiliation with the organization were last verified. Used to track compliance with credentialing re-verification requirements.']
  department_name varchar [note: 'The name of the department, division, or service line within the affiliated organization where the provider practices. Examples include Cardiology, Emergency Medicine, Orthopedic Surgery, Primary Care.']
  directory_display_flag boolean [note: 'Boolean indicator denoting whether this affiliation should be displayed in the member-facing provider directory. True indicates the affiliation is publicly visible; False indicates it is for internal use only.']
  end_date date [note: 'The date on which the provider affiliation ended or is scheduled to end. Null for open-ended affiliations that are currently active.']
  last_updated_by varchar [note: 'The user ID or system identifier of the person or process that last updated this affiliation record. Supports audit and accountability requirements.']
  last_updated_timestamp timestamp [note: 'The date and time when this affiliation record was last modified. Used for audit trail and change tracking.']
  medical_staff_category varchar [note: 'The category of medical staff membership the provider holds at the affiliated hospital or facility. Categories include Active Staff, Courtesy Staff, Consulting Staff, Honorary Staff, Affiliate Staff, and Provisional Staff.']
  network_participation_flag boolean [note: 'Boolean indicator denoting whether this affiliation makes the provider eligible for participation in the health plan\'s provider network. True indicates network participation; False indicates non-participating affiliation.']
  next_credentialing_due_date date [note: 'The date by which the next credentialing verification for this affiliation is due. Supports proactive credentialing workflow management.']
  notes varchar [note: 'Free-text field for capturing additional notes, comments, or special instructions related to the provider affiliation. May include details about practice restrictions, scheduling notes, or administrative remarks.']
  primary_affiliation_flag boolean [note: 'Boolean indicator denoting whether this is the provider\'s primary organizational affiliation. True indicates this is the main affiliation; False indicates a secondary or additional affiliation.']
  role_title varchar [note: 'The provider\'s role or title within the affiliated organization. Examples include Staff Physician, Medical Director, Department Chair, Attending Physician, Consulting Physician.']
  source_record_reference varchar [note: 'The unique identifier of this affiliation record in the source system. Used for traceability and reconciliation with upstream systems.']
  start_date date [note: 'The date on which the provider affiliation became effective. Represents the beginning of the provider-organization relationship.']
  tin varchar [note: 'The Tax Identification Number (TIN) or Employer Identification Number (EIN) under which the provider bills for services rendered through this affiliation. Used for claims routing and payment processing.']
  created_by varchar [note: 'The user ID or system identifier of the person or process that created this affiliation record. Supports audit and accountability requirements.']

  Note: 'Captures the organizational affiliations of individual providers — medical group memberships, IPA affiliations, ACO participation, health system relationships, and hospital associations. Stores affiliation type, affiliated organization (group practice or facility reference), affiliation start and end dates, department, role, and active status. Supports provider directory accuracy, network configuration, claims routing logic, and understanding of provider-to-organization hierarchies. For hospital-based providers, captures the association with the facility where the provider practices.'
}

Table provider.group_practice {
  group_practice_id varchar [pk, note: 'Primary key for group_practice']
  facility_id varchar [note: 'Foreign key linking to provider.facility. Business justification: A group practice (medical group, IPA, physician organization) is often affiliated with or operates within a primary healthcare facility (e.g., a hospital-based medical group). The group_practice table']
  network_service_area_id varchar [note: 'Foreign key linking to network.service_area. Business justification: Group practices serve defined geographic service areas. Critical for network adequacy assessment (group practice counts by county/MSA), member assignment planning, and ensuring adequate primary care a']
  primary_group_medicaid_provider_id varchar [note: 'The state-assigned Medicaid provider identifier for the group practice, used for Medicaid claims submission.']
  accepting_new_patients boolean [note: 'Indicates whether the group practice is currently accepting new patients. Used for provider directory accuracy and member access.']
  accessibility_accommodations varchar [note: 'Description of accessibility accommodations available at the group practice (e.g., wheelchair access, hearing loop, accessible exam tables) to comply with ADA requirements.']
  aco_name varchar [note: 'The name of the ACO in which the group practice participates, if applicable.']
  aco_participant boolean [note: 'Indicates whether the group practice participates in an Accountable Care Organization (ACO) for value-based care arrangements.']
  address_line_1 varchar [note: 'The primary street address line 1 of the group practice\'s main location or headquarters.']
  address_line_2 varchar [note: 'The primary street address line 2 (suite, floor, building) of the group practice\'s main location.']
  city varchar [note: 'The city where the group practice\'s primary location is situated.']
  cms_certification_number varchar [note: 'The CMS Certification Number (CCN) assigned to FQHC, RHC, or other certified facilities. Required for Medicare/Medicaid billing.']
  county varchar [note: 'The county in which the group practice\'s primary location is located. Used for network adequacy and geographic access reporting.']
  created_timestamp timestamp [note: 'The timestamp when this group practice record was first created in the provider management system.']
  credentialing_date date [note: 'The date on which the group practice was initially credentialed and approved for network participation.']
  credentialing_status varchar [note: 'The current credentialing status of the group practice within the health plan\'s credentialing process.']
  data_source_system varchar [note: 'The name of the source system from which this group practice record originated (e.g., Cactus, ProviderSource, NPPES).']
  doing_business_as_name varchar [note: 'The trade name or DBA name under which the group practice operates, if different from the legal name.']
  effective_date date [note: 'The date on which the group practice\'s participation in the health plan network became effective.']
  email_address varchar [note: 'The primary email address for administrative and contracting communications with the group practice.']
  fax_number varchar [note: 'The fax number for the group practice, used for prior authorization and medical records transmission.']
  group_name varchar [note: 'The legal business name of the medical group, physician organization, or practice entity as registered with state authorities and CMS.']
  group_npi varchar [note: 'The 10-digit Type 2 NPI assigned to the group practice organization by CMS. This is the organizational NPI distinct from individual provider NPIs.']
  group_size varchar [note: 'The total number of individual providers (physicians, nurse practitioners, physician assistants) affiliated with and practicing under this group.']
  group_type varchar [note: 'Classification of the group practice organizational structure: solo practice (single physician), single specialty group, multi-specialty group, Independent Practice Association (IPA), Federally Qualified Health Center (FQHC), or Rural Health Clinic (RHC).']
  language_services_offered varchar [note: 'Comma-separated list of languages in which the group practice offers clinical services, used for provider directory cultural competency and member access.']
  participation_status varchar [note: 'The current participation status of the group practice in the health plan\'s provider network. Active indicates the group is contracted and accepting members.']
  phone_number varchar [note: 'The primary contact phone number for the group practice.']
  primary_specialty varchar [note: 'The primary medical specialty or service focus of the group practice (e.g., Family Medicine, Cardiology, Orthopedic Surgery, Multi-Specialty).']
  recredentialing_due_date date [note: 'The date by which the group practice must complete recredentialing to maintain network participation. NCQA requires recredentialing at least every 36 months.']
  state varchar [note: 'The two-letter state abbreviation for the group practice\'s primary location.']
  tax_identifier varchar [note: 'The federal tax identification number (TIN/EIN) assigned to the group practice by the IRS. Used for claims payment and 1099 reporting.']
  taxonomy_code varchar [note: 'The 10-character alphanumeric taxonomy code identifying the group\'s primary classification, specialty, and area of practice per the NUCC taxonomy.']
  telehealth_enabled boolean [note: 'Indicates whether the group practice offers telehealth or telemedicine services to members.']
  termination_date date [note: 'The date on which the group practice\'s participation in the health plan network was terminated or is scheduled to terminate. Null for active participants.']
  termination_reason varchar [note: 'The reason for termination of the group practice\'s network participation (e.g., voluntary withdrawal, quality issues, credentialing failure, contract non-renewal).']
  updated_timestamp timestamp [note: 'The timestamp when this group practice record was last modified in the provider management system.']
  website_url varchar [note: 'The public website URL for the group practice, used in provider directory listings.']
  zip_code varchar [note: 'The 5-digit or 9-digit ZIP code for the group practice\'s primary location.']

  Note: 'Represents a medical group, physician organization, IPA, or multi-specialty group practice as a distinct business entity with its own Type 2 NPI and TIN. Stores group name, group NPI, TIN/EIN, group type (solo practice, group practice, IPA, FQHC, RHC), primary specialty, address, phone, CMS certification number, and group size. Serves as the organizational parent for individual provider affiliations and supports group-level contracting and network participation.'
}

Table provider.facility {
  facility_id varchar [pk, note: 'Unique identifier for the healthcare facility record. Primary key.']
  accepting_new_patients_flag boolean [note: 'Indicates whether the facility is currently accepting new patients. Used in provider directory and network adequacy reporting.']
  address_line_1 varchar [note: 'Primary street address of the facility physical location.']
  address_line_2 varchar [note: 'Secondary address information such as suite, floor, or building number.']
  bed_count varchar [note: 'Total number of licensed beds at the facility. Used for network adequacy calculations and capacity planning.']
  ccn varchar [note: 'Six-character alphanumeric identifier assigned by CMS to Medicare/Medicaid certified facilities. Also known as Provider Number.']
  city varchar [note: 'City where the facility is located.']
  clia_number varchar [note: 'Ten-character identifier issued by CMS for facilities performing laboratory testing. Format: 2-digit state code + 1 letter + 7 digits.']
  county_name varchar [note: 'County where the facility is located. Used for network adequacy geographic analysis.']
  credentialing_effective_date date [note: 'Date when the current credentialing approval became effective.']
  credentialing_expiration_date date [note: 'Date when the current credentialing approval expires and recredentialing is required.']
  credentialing_status varchar [note: 'Current status of the facility credentialing process. Indicates whether the facility has passed credentialing review and is approved for network participation.']
  critical_access_hospital_flag boolean [note: 'Indicates whether the facility is designated as a Critical Access Hospital under the Medicare Rural Hospital Flexibility Program.']
  effective_date date [note: 'Date when the facility record or current participation status became effective.']
  email_address varchar [note: 'Primary email address for facility communications and electronic correspondence.']
  emergency_services_flag boolean [note: 'Indicates whether the facility provides 24/7 emergency department services.']
  facility_type varchar [note: 'Classification of the healthcare facility. Values: hospital (acute care hospital), snf (Skilled Nursing Facility), asc (Ambulatory Surgical Center), fqhc (Federally Qualified Health Center), rhc (Rural Health Clinic), behavioral_health (behavioral health facility). [ENUM-REF-CANDIDATE: hospital|snf|asc|fqhc|rhc|behavioral_health|home_health|hospice|dialysis_center|dme_supplier|ltac|irf|imaging_center — promote to reference product]']
  fax_number varchar [note: 'Fax number for the facility, used for prior authorization and medical records transmission.']
  medicaid_certified_flag boolean [note: 'Indicates whether the facility is certified to participate in the Medicaid program.']
  medicare_certified_flag boolean [note: 'Indicates whether the facility is certified to participate in the Medicare program.']
  name varchar [note: 'Legal name of the healthcare facility as registered with state and federal authorities.']
  network_tier varchar [note: 'Tiering classification of the facility within the provider network. Tier 1 is preferred/lowest cost-sharing. Out_of_network indicates non-participating facility.']
  npi varchar [note: 'Type 2 NPI assigned to the facility by CMS. Ten-digit unique organizational identifier required for HIPAA transactions.']
  ownership_type varchar [note: 'Legal ownership structure of the facility. Values: for_profit (investor-owned), non_profit (tax-exempt), government (federal/state/local), tribal (Indian Health Service or tribal).']
  participation_status varchar [note: 'Current status of the facility in the provider network. Indicates whether the facility is actively participating, suspended, or terminated.']
  phone_number varchar [note: 'Primary contact phone number for the facility.']
  postal_code varchar [note: 'Five or nine-digit ZIP code of the facility location.']
  quality_rating decimal(3,2) [note: 'Overall quality rating score for the facility on a scale of 1.00 to 5.00. Derived from CMS Star Ratings, HEDIS measures, or internal quality assessments.']
  record_created_timestamp timestamp [note: 'Timestamp when this facility record was first created in the data platform.']
  record_updated_timestamp timestamp [note: 'Timestamp when this facility record was last updated in the data platform.']
  source_system_code varchar [note: 'Unique identifier for this facility in the source system. Used for data lineage and reconciliation.']
  state_code varchar [note: 'Two-letter state abbreviation where the facility is located.']
  tax_identifier varchar [note: 'Federal Employer Identification Number (EIN) assigned by IRS. Used for claims payment and 1099 reporting.']
  teaching_hospital_flag boolean [note: 'Indicates whether the facility is a teaching hospital affiliated with a medical school and residency programs.']
  telehealth_enabled_flag boolean [note: 'Indicates whether the facility offers telehealth or virtual care services.']
  termination_date date [note: 'Date when the facility participation was terminated or is scheduled to terminate. Null if currently active.']
  trauma_level varchar [note: 'Trauma center designation level assigned by state or American College of Surgeons. Level 1 is highest capability. Not_designated indicates facility is not a trauma center.']
  website_url varchar [note: 'Public website URL for the facility. Used in provider directory.']

  Note: 'Master record for healthcare facilities — hospitals, SNFs, ASCs, FQHCs, RHCs, behavioral health facilities, home health agencies, hospices, dialysis centers, and DME suppliers. Stores facility name, facility type, CMS certification number (CCN), Medicare/Medicaid certification status, accreditation body (Joint Commission, DNV, CIHQ), accreditation expiration, bed count, trauma level, teaching hospital status, critical access hospital designation, CLIA number, and facility NPI. Distinct from individual provider records; supports institutional claims (837I) routing, network adequacy facility-type analysis, and CMS Star Rating facility attribution. Serves as the organizational anchor for hospital privilege tracking.'
}

Table provider.directory_entry {
  directory_entry_id varchar [pk, note: 'Primary key for directory_entry']
  provider_directory_id varchar [pk, note: 'Unique identifier for the provider directory entry record. This is the primary key for the published directory entry, distinct from the internal provider master record.']
  contract_provider_contract_id varchar [note: 'Foreign key linking to contract.provider_contract. Business justification: Directory Publication Report requires contract details for each provider entry to determine network participation terms.']
  health_plan_id varchar [note: 'Reference to the specific health plan for which this directory entry is published. A provider may have multiple directory entries across different plans.']
  practice_location_id varchar [note: 'Foreign key linking to provider.practice_location. Business justification: The directory_entry table is the consumer-facing view of a provider\'s participation and currently stores a full denormalized copy of the practice address (practice_address_line1, practice_address_line']
  provider_id varchar [note: 'Reference to the internal provider master record. Links this published directory entry to the authoritative provider identity in the provider domain.']
  provider_network_id varchar [note: 'Reference to the provider network in which this provider participates for this plan. Determines member access and cost-sharing tier.']
  accepting_new_patients_flag boolean [note: 'Indicates whether the provider is currently accepting new patients for this plan and network. Critical for directory accuracy and member access.']
  accessibility_features varchar [note: 'Description of accessibility features available at the practice location (wheelchair access, hearing loop, accessible parking). Supports ADA compliance and member access.']
  attestation_method varchar [note: 'Method used to verify the directory information with the provider. Documents the verification approach for audit and compliance purposes.']
  attestation_status varchar [note: 'Status of the provider attestation or verification process for this directory entry. Tracks compliance with CMS directory accuracy requirements.']
  board_certifications varchar [note: 'Comma-separated list of board certifications held by the provider. Demonstrates advanced training and specialty expertise.']
  directory_display_name varchar [note: 'Consumer-facing display name of the provider as it appears in the published directory. May differ from legal name for readability and member experience.']
  directory_publication_date date [note: 'Date when this directory entry was published or last updated in the member-facing provider directory. Required for CMS directory accuracy attestation.']
  gender varchar [note: 'Gender of the provider. Some members have preferences for provider gender, particularly for primary care and OB/GYN services.']
  graduation_year varchar [note: 'Year the provider graduated from medical school or professional training program. Helps members assess provider experience.']
  hospital_affiliation varchar [note: 'Name of hospital(s) where the provider has admitting privileges or primary affiliation. Important for continuity of care and member decision-making.']
  languages_spoken varchar [note: 'Comma-separated list of languages spoken by the provider or available at the practice location. Critical for member access and cultural competency.']
  last_verified_date date [note: 'Date when the directory information was last verified with the provider or practice. CMS and state DOI mandate regular verification cycles (typically 90 days).']
  medical_school varchar [note: 'Name of the medical school or professional training institution where the provider received their degree. Provides credential transparency for members.']
  network_tier varchar [note: 'Cost-sharing tier for this provider within the plan network. Determines member copay, coinsurance, and out-of-pocket costs.']
  next_verification_due_date date [note: 'Date by which the next directory verification must be completed to maintain compliance with CMS and state DOI accuracy mandates.']
  npi varchar [note: 'Ten-digit National Provider Identifier assigned by CMS. The authoritative unique identifier for healthcare providers in the United States.']
  office_hours varchar [note: 'Text description of office hours for the practice location. Helps members understand availability for appointment scheduling.']
  participation_effective_date date [note: 'Date when the providers participation in this plan and network became effective. Determines when members can access the provider at in-network rates.']
  participation_status varchar [note: 'Current status of the providers participation in this specific plan and network. Determines whether the directory entry is published to members.']
  participation_termination_date date [note: 'Date when the providers participation in this plan and network ended or will end. Critical for member notification and continuity of care transitions.']
  pcp_flag boolean [note: 'Indicates whether this provider is eligible to serve as a Primary Care Provider (PCP) for plan members. Relevant for HMO and POS plans requiring PCP selection.']
  practice_website_url varchar [note: 'Website URL for the practice or provider. Published in directory to enable members to learn more about the provider and services offered.']
  provider_type varchar [note: 'High-level classification of the provider entity type. Determines directory presentation and search filtering options for members.']
  record_created_timestamp timestamp [note: 'Timestamp when this directory entry record was first created in the data warehouse. Supports audit trail and data lineage tracking.']
  record_updated_timestamp timestamp [note: 'Timestamp when this directory entry record was last updated in the data warehouse. Tracks data freshness and change frequency.']
  source_system_code varchar [note: 'Unique identifier for this directory entry in the source system. Enables traceability and reconciliation with upstream provider management systems.']
  specialty_display varchar [note: 'Consumer-friendly specialty name displayed in the directory. Simplified from clinical taxonomy codes for member understanding.']
  telehealth_available_flag boolean [note: 'Indicates whether the provider offers telehealth or virtual visit services for this plan. Increasingly important for member access and convenience.']
  tin varchar [note: 'Nine-digit Tax Identification Number (EIN or SSN) associated with the provider or practice for billing and contracting purposes.']

  Note: 'Published provider directory record representing the consumer-facing view of a provider\'s participation in a specific health plan and network. Captures provider display name, accepting new patients status, languages spoken, telehealth availability, network tier, plan participation, directory publication date, last verified date, and directory accuracy attestation status. Supports CMS and state DOI provider directory accuracy mandates (no-surprise billing, network adequacy). Distinct from the internal provider master — this is the published, plan-specific directory entry.'
}

Table provider.participation_status {
  participation_status_id varchar [pk, note: 'Unique identifier for the provider participation status record.']
  contract_provider_contract_id varchar [note: 'Identifier of the provider contract governing this participation relationship. Links to the provider contract entity.']
  corrective_action_plan_id varchar [note: 'Foreign key linking to compliance.corrective_action_plan. Business justification: Provider participation may be suspended or restricted pending completion of a corrective action plan (e.g., credentialing deficiency, quality failure). Linking participation_status to corrective_actio']
  fee_schedule_id varchar [note: 'Foreign key linking to contract.fee_schedule. Business justification: A provider\'s network tier and participation status directly determine which fee schedule applies during claims adjudication. Adjudication systems look up the applicable fee schedule from the participa']
  health_plan_id varchar [note: 'Identifier of the health plan associated with this participation status. Links to the plan master entity.']
  practice_location_id varchar [note: 'Foreign key linking to provider.practice_location. Business justification: A provider\'s participation status can be location-specific — a provider may be in-network at one practice location but not another (e.g., participating at their primary office but not at a satellite c']
  program_id varchar [note: 'Foreign key linking to care.program. Business justification: Value-based care and network participation often requires providers to be enrolled in specific care programs (ACO, PCMH, disease management). Participation status must reference which care program the']
  provider_id varchar [note: 'Identifier of the healthcare provider whose participation status is being tracked. Links to the provider master entity.']
  provider_network_id varchar [note: 'Identifier of the provider network in which the provider participates. Links to the network master entity.']
  regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: Provider participation status changes are often mandated by regulatory obligations (OIG exclusion lists, state Medicaid termination requirements). Compliance teams must link participation status recor']
  reimbursement_policy_id varchar [note: 'Foreign key linking to contract.reimbursement_policy. Business justification: A provider\'s participation status (network tier, LOB, specialty) determines which reimbursement policies govern claims adjudication — NCCI edits, global surgery rules, and modifier policies are applie']
  accepting_new_patients_flag boolean [note: 'Indicates whether the provider is currently accepting new patients within this network and plan. Critical for provider directory accuracy and member access to care.']
  claims_adjudication_flag boolean [note: 'Indicates whether claims from this provider should be adjudicated as in-network for this plan and network. This is the authoritative flag for claims processing network determination.']
  code varchar [note: 'Current participation status of the provider within the network and plan. Active status indicates the provider is eligible for in-network claims adjudication. This is the authoritative field for network participation determination.']
  continuity_of_care_end_date date [note: 'The date through which continuity of care provisions apply for members in active treatment with this provider. Allows in-network benefits to continue for a transition period after provider termination.']
  credentialing_approval_date date [note: 'The date on which the provider was approved through the credentialing process for this participation arrangement.']
  credentialing_status varchar [note: 'The current credentialing status of the provider for this participation arrangement. Credentialing approval is a prerequisite for active participation status.']
  current_record_flag boolean [note: 'Indicates whether this is the current active version of the participation status record. True for the most recent version, false for historical versions.']
  directory_display_flag boolean [note: 'Indicates whether the provider should be displayed in the member-facing provider directory for this network and plan. May be false during pending credentialing or for providers with restricted panel status.']
  effective_date date [note: 'The date on which this participation status becomes effective. Claims with service dates on or after this date are subject to this participation status for network determination.']
  lob_code varchar [note: 'The line of business for which this participation status applies. Determines the regulatory framework and benefit structure applicable to this participation relationship.']
  member_notification_date date [note: 'The date on which affected members were notified of the provider participation status change. Required for regulatory compliance with provider termination notification requirements.']
  member_notification_method varchar [note: 'The communication channel used to notify members of the provider participation status change.']
  name varchar [note: 'Human-readable description of the participation status code.']
  network_tier_code varchar [note: 'The network tier assignment for this provider participation. Determines member cost-sharing levels in tiered network products.']
  next_recredentialing_date date [note: 'The date by which the provider must complete recredentialing to maintain active participation status. Typically occurs every 24-36 months per NCQA standards.']
  panel_status varchar [note: 'Indicates whether the provider panel is open to new member assignments. Closed or restricted panels may still serve existing members but do not accept new PCP assignments.']
  participation_category varchar [note: 'The category of participation indicating the scope of services the provider is authorized to deliver under this arrangement.']
  pcp_flag boolean [note: 'Indicates whether the provider is participating as a primary care provider in this network and plan. Determines PCP assignment eligibility for HMO and POS products.']
  record_created_timestamp timestamp [note: 'The timestamp when this participation status record was first created in the data platform.']
  record_effective_date date [note: 'The business effective date of this participation status record version. Used for slowly changing dimension type 2 historization.']
  record_end_date date [note: 'The business end date of this participation status record version. Null for the current active version. Used for slowly changing dimension type 2 historization.']
  record_updated_timestamp timestamp [note: 'The timestamp when this participation status record was last updated in the data platform.']
  regulatory_sanction_flag boolean [note: 'Indicates whether the provider is currently under regulatory sanction that affects their participation status. Sanctions may be imposed by state medical boards, CMS, or other regulatory bodies.']
  risk_arrangement_code varchar [note: 'The financial risk arrangement under which the provider participates. Indicates whether the provider is paid fee-for-service, capitation, or under a value-based care model.']
  sanction_effective_date date [note: 'The date on which a regulatory sanction affecting participation status became effective.']
  sanction_end_date date [note: 'The date on which a regulatory sanction affecting participation status is scheduled to end or was lifted.']
  source_system_code varchar [note: 'The unique identifier for this participation status record in the source system. Used for data lineage and reconciliation.']
  specialist_flag boolean [note: 'Indicates whether the provider is participating as a specialist in this network and plan. Used for network adequacy reporting and referral management.']
  status_change_trigger varchar [note: 'The business event or process that triggered this participation status change. Used for audit trail and root cause analysis of network changes. [ENUM-REF-CANDIDATE: CREDENTIALING_DECISION|CONTRACT_EXECUTION|CONTRACT_TERMINATION|SANCTION_IMPOSED|VOLUNTARY_REQUEST|NETWORK_CHANGE|RECREDENTIALING_OUTCOME — 7 candidates stripped; promote to reference product]']
  telehealth_enabled_flag boolean [note: 'Indicates whether the provider offers telehealth services under this participation arrangement. Required for provider directory display and member access to virtual care.']
  termination_date date [note: 'The date on which this participation status ends. Null for active, ongoing participation. Claims with service dates after this date are subject to out-of-network adjudication unless continuity of care provisions apply.']
  termination_reason_code varchar [note: 'Standardized code indicating the reason for participation termination. Required for regulatory reporting and member notification requirements.']
  termination_reason_description varchar [note: 'Detailed explanation of the termination reason. Provides additional context beyond the standardized termination reason code.']

  Note: 'Tracks the participation status history of a provider within a specific health plan, network, and line of business (LOB). Records participation status (active, inactive, terminated, suspended, pending credentialing), effective date, termination date, termination reason code, LOB (commercial, Medicare Advantage, Medicaid, CHIP, marketplace/QHP), network ID, and status change trigger (credentialing decision, contract termination, sanction, voluntary withdrawal). This is the authoritative record for claims adjudication in-network/out-of-network determination. Supports member notification requirements for provider terminations, continuity of care provisions, and regulatory reporting of network changes.'
}

Table provider.provider {
  provider_id varchar [pk, note: 'Unique identifier for the provider_provider data product (auto-inserted pre-linking).']
  address_line1 varchar [note: 'Primary street address of the provider\'s main practice location.']
  address_line2 varchar [note: 'Secondary address information (suite, floor, etc.).']
  board_certification_summary_status varchar [note: 'Overall completeness of board certification documentation.']
  board_certifications varchar [note: 'List of board certifications held by the provider.']
  category varchar [note: 'High‑level classification of the provider (e.g., physician, hospital, clinic, DME supplier, behavioral health, ancillary).']
  city varchar [note: 'City of the provider\'s primary practice location.']
  country_code varchar [note: 'Three‑letter ISO country code of the provider\'s location.']
  created_timestamp timestamp [note: 'Timestamp when the provider record was first created in the system.']
  credentialing_status varchar [note: 'Current status of the provider\'s credentialing process.']
  cultural_competency_certifications varchar [note: 'Certifications or training demonstrating cultural competency for language access.']
  date_of_birth date [note: 'Birth date of an individual provider; used for credentialing and compliance.']
  dea_number varchar [note: 'Drug Enforcement Administration registration number for prescribing controlled substances.']
  effective_end_date date [note: 'Date when the provider\'s current status or network participation ends (nullable for open‑ended).']
  effective_start_date date [note: 'Date when the provider\'s current status or network participation became effective.']
  email_address varchar [note: 'Primary email address used for provider communications.']
  first_name varchar [note: 'Given name of an individual provider.']
  gender varchar [note: 'Gender of the individual provider as reported.']
  language_proficiency varchar [note: 'Proficiency level for each language (e.g., fluent, conversational).']
  languages_spoken varchar [note: 'Comma‑separated list of languages the provider can communicate in.']
  last_name varchar [note: 'Family name of an individual provider.']
  last_verified_timestamp timestamp [note: 'Timestamp of the last verification of provider data against source registries.']
  license_number varchar [note: 'State‑issued professional license identifier.']
  license_state varchar [note: 'Two‑letter US state code where the professional license was issued.']
  malpractice_coverage_flag boolean [note: 'Indicates whether the provider has active malpractice insurance coverage.']
  name varchar [note: 'Full legal name of the provider (individual name or organization name).']
  network_participation_flag boolean [note: 'True if the provider is currently part of any contracted network.']
  npi varchar [note: '10‑digit unique identifier assigned to health care providers by the National Plan and Provider Enumeration System.']
  participation_status varchar [note: 'Indicates the provider\'s participation level in the plan\'s network.']
  phone_number varchar [note: 'Primary contact telephone number for the provider.']
  postal_code varchar [note: 'ZIP or postal code for the provider\'s address.']
  primary_specialty varchar [note: 'Main clinical specialty of the provider, derived from taxonomy.']
  provider_type varchar [note: 'Indicates whether the provider record represents an individual practitioner or an organizational entity.']
  state varchar [note: 'State of the provider\'s primary practice location.']
  status_flag boolean [note: 'Operational status of the provider within the health plan.']
  taxonomy_code varchar [note: 'Standard taxonomy code (e.g., from the AMA) that describes the provider\'s specialty or service area.']
  taxonomy_description varchar [note: 'Human‑readable description of the taxonomy code.']
  termination_date date [note: 'Date the provider relationship was terminated, if applicable.']
  tin_ein varchar [note: 'Federal tax identifier for the provider organization or individual.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the provider record.']
  upin varchar [note: 'Legacy identifier for physicians used in Medicare billing.']
  website_url varchar [note: 'Public website URL for the provider or practice.']

  Note: 'Core master entity representing all healthcare providers — physicians, hospitals, clinics, ancillary providers, facilities, DME suppliers, and behavioral health providers. Serves as the NPI-based SSOT for provider identity across the enterprise. Stores individual (Type 1 NPI) and organizational (Type 2 NPI) provider records sourced from Cactus or ProviderSource. Includes provider type, taxonomy code, primary specialty, DEA number, UPIN, TIN/EIN, gender, languages spoken (with proficiency), cultural competency certifications, contact information for key operational contacts (credentialing, billing, office manager), malpractice coverage status flag, board certification summary status, and provider status flags. Supports CMS provider directory accuracy mandates, NCQA credentialing standards, and CLAS standards for language access.'
}

Table claim.header {
  header_id varchar [pk, note: 'Primary key for header']
  account_id varchar [note: 'Foreign key linking to billing.billing_account. Business justification: Needed for account‑level statements that combine premium billing and claim charges, a core reporting requirement for member cost‑sharing and financial reconciliation.']
  billing_group_practice_id varchar [note: 'Foreign key linking to provider.group_practice. Business justification: Claims submitted under a group NPI must link to provider.group_practice for group-level claims analytics, capitation payment reconciliation, and value-based contract performance reporting. billing_pro']
  eligibility_span_id varchar [note: 'Foreign key linking to member.eligibility_span. Business justification: Claim intake requires immediate eligibility verification against the member\'s eligibility span before adjudication begins. This is a distinct pre-adjudication edit step. The header-level link captures']
  eligibility_verification_id varchar [note: 'Foreign key linking to enrollment.eligibility_verification. Business justification: Claims adjudication must reference the real-time eligibility verification performed at time of service (capturing authorization_number, benefit_remaining, deductible_remaining). This \'eligibility-at-t']
  grace_period_id varchar [note: 'Foreign key linking to billing.grace_period. Business justification: ACA mandates special claim handling during premium grace periods: claims must be pended in grace period 2-3 and retroactively denied if premium unpaid. Claim adjudication systems must directly referen']
  inpatient_admission_id varchar [note: 'Foreign key linking to utilization.inpatient_admission. Business justification: Required for Admission‑to‑Claim reconciliation report; claims are generated from inpatient admissions, so linking each claim to its admission record is standard practice.']
  pa_request_id varchar [note: 'Foreign key linking to utilization.pa_request. Business justification: Outpatient claims require PA validation at the header level before adjudication. The header\'s denormalized \'prior_authorization_number\' should resolve to the actual pa_request record, enabling PA comp']
  plan_election_id varchar [note: 'Foreign key linking to enrollment.plan_election. Business justification: Claim adjudication requires direct reference to the member\'s active plan election at time of service to validate coverage tier, benefit limits, and premium. This \'eligibility-at-adjudication\' linkage ']
  plan_service_area_id varchar [note: 'Foreign key linking to plan.plan_service_area. Business justification: Network adequacy and service‑area compliance reports need to map each claim to the plan’s service area where the service was rendered.']
  primary_header_claiming_provider_provider_provider_id varchar [note: 'Foreign key linking to provider.provider_provider. Business justification: Required for network participation and quality reporting; each claim must be linked to the provider entity for regulatory and performance analytics.']
  program_id varchar [note: 'Foreign key linking to care.program. Business justification: Care program cost attribution and ROI reporting: payers must link claims to the active care management program at time of service to measure program effectiveness, calculate PMPM savings, and satisfy ']
  rendering_facility_id varchar [note: 'Foreign key linking to provider.facility. Business justification: Inpatient and outpatient claims must be linked to the rendering facility for DRG-based payment, network adequacy reporting, and CMS facility quality reporting. Header has billing_provider_npi (denorma']
  service_practice_location_id varchar [note: 'Foreign key linking to provider.practice_location. Business justification: Header-level service location is required for network status verification, geographic claims analysis, and directory accuracy audits. place_of_service_code is a denormalized code; a FK to practice_loc']
  transaction_id varchar [note: 'Foreign key linking to enrollment.enrollment_transaction. Business justification: Required for claim adjudication to reference the exact enrollment transaction that established coverage at service date, used in CMS audit and eligibility verification reports.']
  year_id varchar [note: 'Foreign key linking to plan.plan_year. Business justification: Regulatory reporting and rate filing require associating each claim with the specific plan year under which coverage was provided.']
  adjustment_flag boolean [note: 'Indicates if the claim includes any adjustments.']
  admission_date date [note: 'Date of patient admission for inpatient claims.']
  allowed_amount decimal(12,2) [note: 'Maximum amount the insurer permits for the services.']
  billed_amount decimal(12,2) [note: 'Total amount billed to the insurer before adjustments.']
  billing_provider_npi varchar [note: 'NPI of the provider responsible for billing.']
  billing_type varchar [note: 'Method of billing for the claim.']
  claim_event_timestamp timestamp [note: 'Date and time of the primary service rendered for the claim.']
  claim_line_count varchar [note: 'Number of line detail records associated with this claim.']
  claim_number varchar [note: 'Unique claim identifier assigned by the insurer.']
  claim_source varchar [note: 'Origin of the claim submission.']
  claim_status varchar [note: 'Current processing status of the claim.']
  claim_type varchar [note: 'Category of claim based on service type.']
  claim_version varchar [note: 'Version number of the claim for tracking revisions.']
  cob_indicator boolean [note: 'Flag indicating whether coordination of benefits processing is required.']
  created_timestamp timestamp [note: 'Timestamp when the claim header record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO currency code for monetary amounts.']
  denial_reason_code varchar [note: 'Code representing the reason for claim denial, if applicable.']
  diagnosis_codes varchar [note: 'Pipe-separated list of diagnosis codes associated with the claim.']
  discharge_date date [note: 'Date of patient discharge for inpatient claims.']
  drg_code varchar [note: 'DRG assignment for inpatient claims.']
  is_hipaa_compliant boolean [note: 'Flag indicating whether the claim data complies with HIPAA regulations.']
  is_mlr_excluded boolean [note: 'Indicates if the claim is excluded from MLR calculations.']
  is_suspended boolean [note: 'Indicates if the claim is currently suspended pending additional information.']
  length_of_stay varchar [note: 'Number of days between admission and discharge.']
  lob varchar [note: 'Business line to which the claim belongs.']
  paid_amount decimal(12,2) [note: 'Net amount paid to the provider after adjustments.']
  place_of_service_code varchar [note: 'Code indicating where the service was provided.']
  prior_status varchar [note: 'Previous status before the most recent transition.']
  procedure_codes varchar [note: 'Pipe-separated list of procedure codes billed on the claim.']
  referral_provider_npi varchar [note: 'NPI of the referring provider, if applicable.']
  sla_due_date date [note: 'Date by which the claim must be processed to meet service level agreement.']
  sla_met boolean [note: 'Flag indicating whether the claim met the SLA deadline.']
  status_change_timestamp timestamp [note: 'Timestamp of the most recent status transition.']
  suspension_reason varchar [note: 'Reason why the claim was suspended.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the claim header record.']

  Note: 'Core master record and lifecycle hub for every submitted health insurance claim — professional (CMS-1500/837P), institutional (UB-04/837I), dental (ADA/837D), and behavioral health. Captures claim-level identifiers (ICN), claim type, bill type, place of service, financial totals (billed/allowed/paid), adjudication status with full status transition history (prior status, new status, timestamp, reason, changed-by), service dates, COB indicator, LOB, plan and member identifiers, provider NPIs (rendering, billing, facility, attending, referring), DRG assignment, admission details, claim source (EDI/paper/portal), adjustment linkage, pend/suspend reason tracking, SLA monitoring dates, and HIPAA compliance flags. Serves as the central hub linking all claim-related detail records.'
}

Table claim.line {
  line_id varchar [pk, note: 'Primary key for line']
  auth_service_line_id varchar [note: 'Foreign key linking to utilization.auth_service_line. Business justification: Audit of Prior Authorization compliance; claim line references the authorized service line to verify authorized quantity, price, and status.']
  benefit_id varchar [note: 'Foreign key linking to plan.benefit. Business justification: Adjudication uses benefit definitions to determine coverage and cost sharing for each claim line; linking claim line to plan.benefit is required for accurate payment calculation.']
  benefit_package_id varchar [note: 'Foreign key linking to plan.benefit_package. Business justification: Pharmacy claim lines require benefit package context for retail vs mail-order copay differentiation, specialty drug management program rules, and generic substitution requirements during adjudication.']
  claim_header_id varchar [note: 'Identifier of the parent claim to which this line belongs.']
  cost_share_rule_id varchar [note: 'Foreign key linking to plan.cost_share_rule. Business justification: Service lines apply specific cost-share rules based on service category, network type, and member tier. Line-level cost-sharing calculation requires direct rule reference.']
  drug_master_id varchar [note: 'Foreign key linking to pharmacy.drug_master. Business justification: Medical claim lines referencing drugs (infusions, injectables, DME) require drug identity for MLR drug-spend categorization, duplicate therapy detection across medical/pharmacy claims, and formulary c']
  fee_schedule_rate_id varchar [note: 'Foreign key linking to contract.fee_schedule_rate. Business justification: Claim line allowed_amount is derived from a specific fee schedule rate row. Linking claim.line to contract.fee_schedule_rate enables contract compliance auditing, repricing dispute resolution, and MLR']
  par_agreement_id varchar [note: 'Foreign key linking to network.par_agreement. Business justification: Claim line adjudication applies par agreement contracted rates to calculate allowed amounts at the service-line level. Line-level rate validation against par agreement is a core claims adjudication en']
  plan_id varchar [note: 'Foreign key linking to care.care_plan. Business justification: Care plan adherence tracking: linking individual claim service lines to the directing care plan enables payers to measure whether members received care-plan-specified services, supporting case manager']
  provider_id varchar [note: 'Foreign key linking to provider.provider_provider. Business justification: Line‑level provider attribution enables detailed utilization, cost, and service‑type analysis required by utilization review and case‑mix reporting.']
  reimbursement_policy_id varchar [note: 'Foreign key linking to contract.reimbursement_policy. Business justification: Reimbursement policies (NCCI edits, modifier reductions, global surgery, max units) govern line-level adjudication decisions. Linking claim.line to the applied reimbursement_policy enables denial root']
  tier_id varchar [note: 'Foreign key linking to network.network_tier. Business justification: Needed for patient billing statements; tier determines deductible, copay, and coinsurance for each claim line in network‑based cost‑share calculations.']
  adjustment_amount decimal(12,2) [note: 'Monetary amount of any adjustment applied to the line after initial adjudication.']
  adjustment_reason_code varchar [note: 'Code describing the reason for the line adjustment.']
  admission_date date [note: 'Date the patient was admitted (applicable to institutional claims).']
  allowed_amount decimal(12,2) [note: 'Maximum amount the payer agrees to pay for the line.']
  anesthesia_minutes varchar [note: 'Total minutes of anesthesia administered for the line (if applicable).']
  billed_amount decimal(12,2) [note: 'Charged amount submitted to the payer for the line.']
  cob_paid_amount decimal(12,2) [note: 'Amount paid by secondary/tertiary payers under COB processing.']
  created_timestamp timestamp [note: 'Timestamp when the line record was first created in the system.']
  denial_reason_code varchar [note: 'Standard code indicating why the line was denied.']
  description varchar [note: 'Free‑text description of the service rendered.']
  discharge_date date [note: 'Date the patient was discharged (applicable to institutional claims).']
  emergency_indicator boolean [note: 'True if the service was rendered as an emergency.']
  epsdt_indicator boolean [note: 'True if the service qualifies for EPSDT coverage (for Medicaid).']
  family_planning_indicator boolean [note: 'True if the service is related to family planning.']
  line_status varchar [note: 'Current processing status of the claim line.']
  line_type varchar [note: 'Category of service rendered on the line.']
  modifier_1 varchar [note: 'First two‑character modifier associated with the procedure code.']
  modifier_2 varchar [note: 'Second two‑character modifier associated with the procedure code.']
  modifier_3 varchar [note: 'Third two‑character modifier associated with the procedure code.']
  modifier_4 varchar [note: 'Fourth two‑character modifier associated with the procedure code.']
  number varchar [note: 'Sequential number of the line within the claim.']
  paid_amount decimal(12,2) [note: 'Amount actually paid by the payer for the line.']
  patient_responsibility_amount decimal(12,2) [note: 'Sum of copay, coinsurance, and deductible amounts owed by the member.']
  place_of_service_code varchar [note: 'Two‑digit code indicating where the service was provided.']
  prior_authorization_number varchar [note: 'Reference number of the prior authorization associated with the line.']
  procedure_code varchar [note: 'Standard procedure code representing the service rendered.']
  remark_code varchar [note: 'Additional informational code attached to the line.']
  revenue_code varchar [note: 'Four‑digit code used for institutional billing to indicate type of service.']
  service_date date [note: 'Date on which the service was provided.']
  units_of_service decimal(10,2) [note: 'Quantity of the service rendered (e.g., number of visits, dosage units).']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the line record.']

  Note: 'Line-level detail for each service rendered within a claim. Captures line number, CPT/HCPCS procedure code, procedure modifier codes (up to 4), revenue code (institutional), service date, units of service, billed amount per line, allowed amount, paid amount, copay amount, coinsurance amount, deductible amount, COB paid amount, line status, denial reason code, remark codes, place of service code, rendering provider NPI at line level, NDC code (for drug lines), quantity qualifier, anesthesia minutes, emergency indicator, EPSDT indicator, family planning indicator, and prior authorization number.'
}

Table claim.diagnosis {
  diagnosis_id varchar [pk, note: 'Primary key for diagnosis']
  benefit_id varchar [note: 'Foreign key linking to plan.benefit. Business justification: Diagnosis codes trigger benefit-specific coverage rules (preventive service flag, prior authorization requirements, exclusions, EHB classification). Medical necessity determination and coverage adjudi']
  claim_header_id varchar [note: 'Identifier of the claim to which this diagnosis belongs.']
  member_identity_id varchar [note: 'add column member_identity_id (BIGINT) with FK to member.identity.identity_id - diagnoses are associated with specific members']
  risk_hcc_mapping_id varchar [note: 'Foreign key linking to risk.hcc_mapping. Business justification: Clinical quality and risk‑adjustment reports need each diagnosis linked to its HCC mapping for proper risk score calculations.']
  year_id varchar [note: 'Foreign key linking to plan.year. Business justification: Diagnosis codes are year-specific for risk adjustment (HCC model version changes annually, ICD version updates). CMS risk adjustment and RADV audit process.']
  chronic_condition_flag boolean [note: 'True if the diagnosis represents a chronic condition relevant for care management.']
  code varchar [note: 'Official diagnosis code assigned to the claim line.']
  created_timestamp timestamp [note: 'Date‑time when the diagnosis line was initially loaded into the data lake.']
  description varchar [note: 'Full textual description of the diagnosis code.']
  diagnosis_date date [note: 'Calendar date the diagnosis was documented on the claim.']
  diagnosis_status varchar [note: 'Operational status indicating if the diagnosis line is active, pending review, or logically deleted.']
  diagnosis_type varchar [note: 'Specifies the role of the diagnosis (e.g., principal, admitting, external cause, other).']
  drg_code varchar [note: 'DRG (Diagnosis Related Group) code assigned for inpatient claims.']
  drg_description varchar [note: 'Textual description of the DRG code.']
  hcc_category varchar [note: 'HCC category code used for risk‑adjustment and RAF calculations.']
  icd_version varchar [note: 'Indicates whether the diagnosis code follows ICD‑9‑CM or ICD‑10‑CM standards.']
  line_quantity varchar [note: 'Number of times the same diagnosis appears on the claim; typically 1.']
  poa_indicator varchar [note: 'Indicates if the condition was present at the time of admission (Y=Yes, N=No, U=Unknown).']
  qualifier varchar [note: 'Free‑text qualifier providing extra context (e.g., laterality, severity).']
  risk_adjustment_factor decimal(5,4) [note: 'Numeric factor used in risk‑adjustment calculations for the diagnosis.']
  sequence varchar [note: 'Ordinal position of the diagnosis on the claim (1‑n).']
  updated_timestamp timestamp [note: 'Date‑time of the latest modification to the diagnosis line.']

  Note: 'Diagnosis code assignments at the claim level supporting ICD-10-CM coding. Captures claim ICN, diagnosis sequence number, ICD version (ICD-10/ICD-9), diagnosis code, diagnosis description, diagnosis type (principal, admitting, external cause, other), POA (Present on Admission) indicator, HCC category mapping, chronic condition flag, and diagnosis qualifier. Supports DRG grouping, risk adjustment (HCC/RAF), HEDIS measure attribution, and clinical analytics.'
}

Table claim.procedure {
  procedure_id varchar [pk, note: 'Primary key for procedure']
  benefit_id varchar [note: 'Foreign key linking to plan.benefit. Business justification: Procedure codes map to benefit coverage rules for authorization requirements, visit/service limits, and cost-sharing tiers. Utilization management and payment determination process.']
  claim_header_id varchar [note: 'Identifier of the parent claim to which this procedure belongs.']
  facility_id varchar [note: 'Foreign key linking to provider.facility. Business justification: Surgical and outpatient procedures are performed at specific credentialed facilities. CMS quality measures, value-based care analytics, and facility credentialing verification require a direct FK from']
  member_identity_id varchar [note: 'add column member_identity_id (BIGINT) with FK to member.identity.identity_id - procedures are performed on specific members']
  network_service_area_id varchar [note: 'Foreign key linking to network.service_area. Business justification: Supports network adequacy compliance reporting by linking procedure location to the defined service area of the provider network.']
  pa_request_id varchar [note: 'Foreign key linking to utilization.pa_request. Business justification: Procedure-level PA validation is required for high-cost services (surgery, imaging, specialty drugs). The procedure record\'s denormalized \'prior_authorization_number\' and \'prior_authorization_status\' ']
  practice_location_id varchar [note: 'Identifier of the facility where the procedure was performed (e.g., hospital NPI or internal location code).']
  surgeon_provider_provider_provider_id varchar [note: 'Foreign key linking to provider.provider_provider. Business justification: Links surgeon NPI to provider entity for surgeon performance, outcome, and credentialing dashboards mandated by quality‑measure reporting.']
  year_id varchar [note: 'Foreign key linking to plan.year. Business justification: Procedure coding and coverage rules are year-specific (CPT/HCPCS annual updates, plan year benefit design changes). Claims processing and regulatory compliance process.']
  anesthesia_time_minutes varchar [note: 'Total minutes of anesthesia administered for the procedure.']
  billing_category varchar [note: 'Category used for billing and reimbursement rules.']
  charge_amount decimal(12,2) [note: 'Billed amount for the procedure before adjustments.']
  claim_adjustment_amount decimal(12,2) [note: 'Monetary amount of the adjustment applied to the procedure charge.']
  claim_adjustment_reason varchar [note: 'Reason code for any post‑adjudication adjustment applied to this procedure.']
  claim_line_number varchar [note: 'Line number of this procedure within the claim file.']
  claim_status varchar [note: 'Current processing status of the claim line containing this procedure.']
  code varchar [note: 'Standardized code representing the medical procedure performed.']
  code_system varchar [note: 'The coding system used for the procedure_code field.']
  currency_code varchar [note: 'Three‑letter ISO 4217 currency code for monetary amounts.']
  diagnosis_codes varchar [note: 'Pipe‑delimited list of primary diagnosis codes (ICD‑10‑CM) associated with the procedure. [ENUM-REF-CANDIDATE: multiple codes — promote to reference product]']
  documentation_indicator varchar [note: 'Indicates completeness of clinical documentation for the procedure.']
  drg_code varchar [note: 'DRG assignment for the inpatient case derived from the procedure and diagnoses.']
  drg_weight decimal(5,4) [note: 'Relative weight of the DRG used for reimbursement calculations.']
  is_emergency boolean [note: 'True if the procedure was performed under emergency conditions.']
  is_outpatient boolean [note: 'True if the procedure was performed in an outpatient setting.']
  is_primary_procedure boolean [note: 'True if this is the principal procedure for the claim.']
  laterality varchar [note: 'Anatomical side on which the procedure was performed.']
  modifier varchar [note: 'Additional qualifier or modifier associated with the procedure code (e.g., bilateral, emergency).']
  net_amount decimal(12,2) [note: 'Final reimbursable amount after adjustments, discounts, and contractual allowances.']
  notes varchar [note: 'Clinician‑entered free‑text comments about the procedure.']
  procedure_date date [note: 'Calendar date on which the procedure was performed.']
  procedure_status varchar [note: 'Current processing status of the procedure record.']
  quality_measure_flag boolean [note: 'True if the procedure contributes to a quality measure (e.g., HEDIS).']
  record_created_timestamp timestamp [note: 'Timestamp when the procedure record was first inserted into the data lake.']
  record_updated_timestamp timestamp [note: 'Timestamp of the most recent update to the procedure record.']
  revenue_code varchar [note: 'Hospital revenue code associated with the procedure for institutional claims.']
  risk_adjustment_factor decimal(5,4) [note: 'Factor used for risk‑adjusted payment calculations.']
  sequence varchar [note: 'Ordinal position of the procedure within the claim (1‑based).']
  surgeon_name varchar [note: 'Full name of the surgeon who performed the procedure.']
  timestamp timestamp [note: 'Exact date‑time when the procedure was performed, captured to the second.']
  units_of_service varchar [note: 'Number of units billed for the procedure (e.g., time‑based units).']

  Note: 'Procedure code assignments at the claim header level (distinct from line-level CPT). Captures principal procedure code (ICD-10-PCS for inpatient), procedure date, procedure sequence, surgeon NPI, procedure qualifier, and secondary procedure codes. Supports DRG assignment, surgical case management, and inpatient utilization analytics. Primarily applicable to 837I institutional claims.'
}

Table claim.adjudication {
  adjudication_id varchar [pk, note: 'System-generated unique identifier for the adjudication record.']
  benefit_package_id varchar [note: 'Foreign key linking to plan.benefit_package. Business justification: Adjudication validates cost-sharing (deductible, OOP max, copays) against member\'s enrolled benefit package tier. Auto-adjudication rules apply package-level limits for metal tier compliance and netwo']
  claim_header_id varchar [note: 'Unique identifier of the claim that this adjudication decision applies to.']
  claim_line_id varchar [note: 'Foreign key linking to claim.line. Business justification: Adjudication occurs at both the claim header level and the individual claim line level in health insurance (837P professional claims adjudicate each service line independently). The adjudication table']
  cost_share_rule_id varchar [note: 'Foreign key linking to plan.cost_share_rule. Business justification: Adjudication engine applies specific cost-share rules (copay amount, coinsurance rate, deductible) to calculate allowed and paid amounts. Core claims payment calculation process.']
  drug_master_id varchar [note: 'Foreign key linking to pharmacy.drug_master. Business justification: Pharmacy claim adjudication applies drug-specific edits: formulary compliance, step therapy, quantity limits, and DUR alerts. Linking adjudication to drug_master enables drug-level adjudication audit ']
  eligibility_span_id varchar [note: 'Foreign key linking to member.eligibility_span. Business justification: Adjudication MUST verify the member\'s active eligibility span at date of service — this is the foundational adjudication edit. The eligibility_span defines coverage window, benefit package, network ti']
  fee_schedule_rate_id varchar [note: 'Foreign key linking to contract.fee_schedule_rate. Business justification: Adjudication is the authoritative financial record; regulators and auditors require a direct link from the adjudication event to the fee schedule rate used to compute allowed_amount. Supports contract']
  group_plan_offering_id varchar [note: 'Foreign key linking to employer.group_plan_offering. Business justification: Adjudication applies offering-specific cost-sharing rules (deductible, OOP, employee contribution caps). adjudication already has group_id and health_plan_id but not the specific offering. ACA afforda']
  health_plan_id varchar [note: 'Identifier of the benefit plan under which the claim was submitted.']
  member_identity_id varchar [note: 'Unique identifier of the insured member associated with the claim.']
  pa_decision_id varchar [note: 'Foreign key linking to utilization.pa_decision. Business justification: Adjudicators validate authorized quantity, authorized dates, and approval status from the PA decision record against the claim being processed. Direct FK to pa_decision supports adjudication edit chec']
  pa_request_id varchar [note: 'Foreign key linking to utilization.pa_request. Business justification: Adjudication must verify prior authorization existence and status before approving payment. Linking adjudication directly to pa_request enables auto-adjudication PA validation, edit code generation fo']
  provider_id varchar [note: 'National Provider Identifier (NPI) of the treating provider.']
  stop_loss_policy_id varchar [note: 'Foreign key linking to employer.stop_loss_policy. Business justification: Adjudication for self-funded groups is where stop-loss threshold evaluation occurs and is recorded. The adjudication record must reference the applicable stop-loss policy to document whether the indiv']
  tier_id varchar [note: 'Foreign key linking to network.tier. Business justification: Adjudication directly applies tier-based cost-sharing rules (deductible, copay, coinsurance differentials). The adjudication engine must reference the tier to calculate member cost-share amounts. This']
  vbc_contract_id varchar [note: 'Foreign key linking to contract.vbc_contract. Business justification: VBC adjudication attribution is a named business process: adjudicated claims must be attributed to the VBC contract for shared savings calculation, benchmark expenditure tracking, and quality gate rep']
  accumulator_deductible_impact decimal(12,2) [note: 'Impact on the member\'s deductible accumulator from this adjudication.']
  accumulator_oop_impact decimal(12,2) [note: 'Impact on the member\'s out‑of‑pocket accumulator.']
  adjudication_status varchar [note: 'Current status of the adjudication decision.']
  admission_date date [note: 'Date the patient was admitted (for institutional claims).']
  allowed_amount decimal(12,2) [note: 'Maximum amount the plan permits for the service after contracts and fee schedules.']
  allowed_amount_method varchar [note: 'Methodology used to calculate the allowed amount.']
  auto_adjudication_flag boolean [note: 'Indicates whether the claim was processed automatically without manual review.']
  claim_type varchar [note: 'Category of the claim based on service setting.']
  cob_adjusted_amount decimal(12,2) [note: 'Amount adjusted after coordination of benefits.']
  cob_processing_result varchar [note: 'Result of COB processing for the claim.']
  currency_code varchar [note: 'Three‑letter ISO currency code for monetary amounts.']
  deductible_amount decimal(12,2) [note: 'Portion of the member\'s deductible applied by this adjudication.']
  diagnosis_code varchar [note: 'Primary diagnosis code associated with the claim.']
  discharge_date date [note: 'Date the patient was discharged (for institutional claims).']
  duplicate_claim_flag boolean [note: 'True if the claim is identified as a potential duplicate.']
  edit_bypass_reason varchar [note: 'Reason provided when an edit was bypassed.']
  edit_code varchar [note: 'Code of the clinical or administrative edit applied (e.g., NCCI, OCE).']
  edit_description varchar [note: 'Human‑readable description of the edit.']
  edit_outcome varchar [note: 'Result of the edit evaluation.']
  edit_override_authority varchar [note: 'Identifier of the person or system that overrode the edit.']
  edit_override_flag boolean [note: 'Indicates whether the edit result was manually overridden.']
  edit_timestamp timestamp [note: 'Date and time when the edit was evaluated.']
  medical_necessity_flag boolean [note: 'Indicates whether the service met medical necessity criteria.']
  network_status varchar [note: 'Network relationship of the provider for this claim.']
  number varchar [note: 'External reference number assigned to the adjudication for audit and communication purposes.']
  oop_amount decimal(12,2) [note: 'Member out‑of‑pocket responsibility after this adjudication.']
  prior_authorization_required boolean [note: 'True if the service required prior authorization.']
  prior_authorization_status varchar [note: 'Outcome of the prior authorization request.']
  record_audit_created timestamp [note: 'Timestamp when the adjudication record was first created in the system.']
  record_audit_updated timestamp [note: 'Timestamp of the most recent update to the adjudication record.']
  service_date date [note: 'Date on which the service was rendered.']
  timeliness_flag boolean [note: 'Indicates whether the claim was filed within the required time window.']
  timestamp timestamp [note: 'Date and time when the adjudication decision was generated.']
  total_adjustment_amount decimal(12,2) [note: 'Sum of all adjustments (deductibles, coinsurance, contractual) applied.']
  total_charge_amount decimal(12,2) [note: 'Aggregate charge amount submitted on the claim before any adjustments.']
  total_net_amount decimal(12,2) [note: 'Final amount payable to the provider after all adjustments.']

  Note: 'Authoritative record of the adjudication decision for each claim and claim line, capturing the full pre-payment processing lifecycle including all clinical and administrative edit results. Includes adjudication status (paid/denied/pended/suspended/voided), auto-adjudication flag, adjudicator ID, benefit plan applied, accumulator impacts (deductible/OOP), COB processing results, allowed amount calculation method (fee schedule/MAC/RBP/capitation), network status, medical necessity determination, and final disposition. Captures granular edit-level results (NCCI/OCE/LCD/NCD/plan-specific/timely filing/duplicate) with edit code, edit description, pass/fail/bypass/override outcomes per line, bypass reason, and override authority. Supports coding compliance, payment accuracy, and CMS edit mandate adherence.'
}

Table claim.eob {
  eob_id varchar [pk, note: 'Unique surrogate key for the EOB record.']
  adjudication_id varchar [note: 'Foreign key linking to claim.adjudication. Business justification: An Explanation of Benefits (EOB) document is generated directly from the adjudication decision — it communicates the adjudication outcome (allowed amounts, deductibles, COB adjustments, denial reasons']
  claim_header_id varchar [note: 'Foreign key linking to claim.header. Business justification: EOB is generated for a specific claim; linking to claim header provides the parent relationship']
  formulary_drug_tier_id varchar [note: 'Foreign key linking to pharmacy.formulary_drug_tier. Business justification: CMS Part D and ACA require EOBs to explain member cost-sharing by formulary tier. Linking eob to formulary_drug_tier enables accurate tier-based cost-sharing explanation on member EOBs, supports SBC a']
  health_plan_id varchar [note: 'Foreign key linking to plan.health_plan. Business justification: EOB documents display plan-specific information (plan name, SBC reference URL, appeal rights version, regulatory classification). Required for member communication and ERISA/ACA disclosure compliance.']
  member_identity_id varchar [note: 'Unique identifier of the covered member associated with the claim.']
  policy_id varchar [note: 'Foreign key linking to member.policy. Business justification: EOB generation requires direct policy context to display coverage limits, deductible amounts, OOP max, and premium details. Regulatory EOB standards (ACA, ERISA) require policy-level benefit informati']
  provider_id varchar [note: 'Foreign key linking to provider.provider. Business justification: Required for EOB Generation Rule: includes credential status of provider on explanation of benefits for compliance.']
  subscriber_id varchar [note: 'Identifier of the primary subscriber (often the employee or policyholder).']
  allowed_amount decimal(12,2) [note: 'Maximum amount the plan permits for the service.']
  appeal_rights_text varchar [note: 'Narrative describing the member\'s right to appeal the decision.']
  appeal_rights_version varchar [note: 'Version identifier for the appeal rights language used.']
  billed_amount decimal(12,2) [note: 'Total amount billed by the provider before any adjustments.']
  claim_icn varchar [note: 'Unique claim identifier used throughout the adjudication process.']
  cob_adjustment_amount decimal(12,2) [note: 'Amount adjusted due to coordination of benefits with other payers.']
  created_timestamp timestamp [note: 'Timestamp when the EOB record was first created in the data warehouse.']
  delivery_date date [note: 'Date the EOB was actually delivered to the recipient.']
  delivery_method varchar [note: 'Method used to deliver the EOB to the member or provider.']
  denial_reason_summary varchar [note: 'Brief text explaining why a claim or line was denied.']
  document_number varchar [note: 'External document identifier assigned to the EOB for tracking and reference.']
  eob_status varchar [note: 'Current lifecycle status of the EOB record.']
  eob_type varchar [note: 'Indicates whether the EOB is intended for the member or the provider.']
  generation_timestamp timestamp [note: 'Date and time when the EOB was generated by the claims engine.']
  language_code varchar [note: 'ISO 639‑2 language code indicating the language of the EOB content.']
  member_responsibility_amount decimal(12,2) [note: 'Portion of the claim the member must pay (deductible, copay, coinsurance, or non‑covered).']
  member_responsibility_type varchar [note: 'Category of the member\'s financial responsibility for the claim.']
  plan_paid_amount decimal(12,2) [note: 'Amount paid by the health plan to the provider.']
  provider_npi varchar [note: 'Unique national identifier for the provider.']
  remark_codes varchar [note: 'Standardized codes providing additional claim processing information.']
  sbc_reference varchar [note: 'Link or identifier to the applicable Summary of Benefits and Coverage document.']
  service_end_date date [note: 'Last date of service covered by the claim.']
  service_start_date date [note: 'First date of service covered by the claim.']
  suppression_flag boolean [note: 'Indicates whether the EOB should be suppressed from member delivery (e.g., for zero‑payment claims).']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the EOB record.']
  version_number varchar [note: 'Sequential version number for revisions of the EOB.']

  Note: 'Explanation of Benefits document record generated for members and providers following claim adjudication. Captures EOB document ID, EOB type (member/provider), generation date, delivery method (mail/portal/EDI 835), member ID, subscriber ID, claim ICN, service dates, provider name, billed amount, allowed amount, plan paid amount, member responsibility (deductible, copay, coinsurance, non-covered), COB adjustment, denial reason summary, remark codes, appeal rights language version, SBC reference, and EOB suppression flag. Supports member transparency and ACA SBC compliance.'
}

Table claim.adjustment {
  adjustment_id varchar [pk, note: 'Primary key for adjustment']
  account_id varchar [note: 'Foreign key linking to billing.account. Business justification: Overpayment recovery and claim adjustment posting require direct linkage to the billing account where recoveries are tracked. Accounts receivable workflows and recovery_status reporting depend on know']
  adjudication_id varchar [note: 'Foreign key linking to claim.adjudication. Business justification: Post-adjudication adjustments (recoveries, audit findings, overpayment corrections, reversals) are corrections to a specific adjudication decision. The adjustment table currently links to claim.header']
  audit_finding_id varchar [note: 'Foreign key linking to compliance.audit_finding. Business justification: Audit findings (e.g., RAC, OIG, internal audits) directly trigger claim adjustments for overpayment recovery. A proper FK replaces the denormalized audit_finding_reference text field, enabling complia']
  benefit_id varchar [note: 'Foreign key linking to plan.benefit. Business justification: Adjustments reference specific benefit rules when correcting coverage determinations (limit violations, exclusion codes, authorization requirements). Claims correction and audit process.']
  claim_header_id varchar [note: 'Identifier of the original claim to which this adjustment applies.']
  corrective_action_plan_id varchar [note: 'Foreign key linking to compliance.corrective_action_plan. Business justification: Corrective action plans mandating systematic claim reprocessing (e.g., CMS 60-day overpayment rule remediation, state audit CAPs) drive batches of claim adjustments. Linking adjustment to corrective_a']
  drug_master_id varchar [note: 'Foreign key linking to pharmacy.drug_master. Business justification: Pharmacy claim adjustments for overpayment recovery, manufacturer rebate reconciliation, and fraud investigations require drug-level identity. Linking adjustment to drug_master enables drug-specific o']
  fwa_case_id varchar [note: 'Foreign key linking to compliance.fwa_case. Business justification: When an FWA investigation identifies fraud or overpayment, claim adjustments are initiated to recover funds. Linking adjustment to fwa_case enables FWA recovery tracking, regulatory reporting on case-']
  health_plan_id varchar [note: 'Foreign key linking to plan.health_plan. Business justification: Adjustments track plan-level overpayment recovery, MLR exclusion flags, and regulatory reporting requirements. Financial reconciliation and CMS MLR reporting process.']
  line_id varchar [note: 'Foreign key linking to claim.line. Business justification: Adjustment may apply to a specific claim line; replace claim_line_number with a proper FK to claim.line']
  member_identity_id varchar [note: 'Unique identifier of the member associated with the claim adjustment.']
  member_risk_score_id varchar [note: 'Foreign key linking to risk.member_risk_score. Business justification: Risk adjustment payment corrections (CMS reconciliation, retroactive risk score changes) require linking the adjustment to the specific risk score version that triggered it. Supports risk adjustment a']
  pa_request_id varchar [note: 'Foreign key linking to utilization.pa_request. Business justification: Claim adjustments triggered by PA findings (unauthorized services, retroactive PA denials, authorization reversals) must reference the originating PA request. This link supports overpayment recovery w']
  provider_contract_id varchar [note: 'Foreign key linking to contract.provider_contract. Business justification: Adjustment records are created after an appeal decision; linking to the appeal case provides audit trail and regulatory reporting of appeal‑driven adjustments.']
  provider_id varchar [note: 'Unique identifier of the provider linked to the adjusted claim.']
  radv_audit_id varchar [note: 'Foreign key linking to risk.radv_audit. Business justification: RADV audit findings directly generate claim payment adjustments and overpayment demands from CMS. The adjustment table has audit_finding_reference, audit_source, and audit_type columns confirming audi']
  adjusted_amount decimal(15,2) [note: 'Total amount after the adjustment is applied.']
  adjustment_date timestamp [note: 'Timestamp when the adjustment was recorded or became effective.']
  adjustment_status varchar [note: 'Current processing status of the adjustment.']
  adjustment_type varchar [note: 'Category of the adjustment indicating its nature.']
  audit_source varchar [note: 'Origin of the audit finding (e.g., internal, RAC, OIG, provider self‑disclosure).']
  audit_type varchar [note: 'Type of audit that triggered the adjustment.']
  code varchar [note: 'Internal code categorizing the adjustment for reporting.']
  compliance_60_day_rule boolean [note: 'Indicates whether the adjustment complies with the CMS 60‑day overpayment recoupment rule.']
  created_timestamp timestamp [note: 'Timestamp when the adjustment record was first created in the system.']
  currency_code varchar [note: 'Three‑letter ISO currency code for monetary values.']
  demand_lifecycle_stage varchar [note: 'Stage of the demand/collection lifecycle for the adjustment.']
  description varchar [note: 'Narrative description of why and how the adjustment was made.']
  diagnosis_code varchar [note: 'ICD diagnosis code(s) associated with the claim adjustment, if relevant.']
  effective_date date [note: 'Date when the adjustment takes effect.']
  expiration_date date [note: 'Date when the adjustment ceases to be effective, if applicable.']
  identifier varchar [note: 'External or business-facing identifier for the adjustment (e.g., RAC audit number).']
  initiator_role varchar [note: 'Business role of the initiator.']
  is_duplicate boolean [note: 'Flag identifying the adjustment as a duplicate payment correction.']
  is_fraud boolean [note: 'Indicates whether the adjustment is related to suspected fraud.']
  is_reversal boolean [note: 'Indicates whether the adjustment reverses a prior adjustment.']
  is_void boolean [note: 'Indicates whether the adjustment voids the original claim payment.']
  net_adjustment_amount decimal(15,2) [note: 'Difference between original and adjusted amounts (positive for overpayment recovery, negative for additional payment).']
  notes varchar [note: 'Additional free‑form notes captured by the adjuster.']
  original_amount decimal(15,2) [note: 'Total amount originally paid on the claim before any adjustment.']
  overpayment_indicator boolean [note: 'Flag indicating whether the adjustment relates to an overpayment.']
  overpayment_type varchar [note: 'Specific category of overpayment being corrected.']
  procedure_code varchar [note: 'Procedure code(s) related to the adjusted claim line.']
  reason_code varchar [note: 'Standardized code describing the business reason for the adjustment.']
  recovery_method varchar [note: 'Method used to recover the overpayment.']
  recovery_status varchar [note: 'Current status of the recovery process.']
  regulatory_reporting_flag boolean [note: 'True when the adjustment must be reported to regulatory bodies (e.g., CMS RAC).']
  resolution_status varchar [note: 'Overall resolution state of the adjustment case.']
  sequence varchar [note: 'Sequential order of adjustments applied to the same claim.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the adjustment record.']

  Note: 'Single source of truth for all post-adjudication corrections, recoveries, and audit findings — including claim adjustments, voids, reprocessing events, overpayment identification and recovery, and post-payment audit results for payment integrity and FWA detection. Captures adjustment type (void/replacement/corrected/retroactive), overpayment type (duplicate payment/incorrect rate/ineligible member/billing error/fraud), audit type (post-payment/prepayment/clinical/coding/billing), audit source (internal/RAC/OIG/provider self-disclosure), financial impact (original vs adjusted amounts, net adjustment, overpayment amount, recovery amounts, demand lifecycle), initiator, CMS 60-day overpayment rule compliance, recovery method (offset/check/installment), recovery status, and resolution status. Supports payment integrity programs, CMS RAC audit compliance, and regulatory overpayment reporting.'
}

Table claim.denial {
  denial_id varchar [pk, note: 'System-generated unique identifier for the denial record.']
  adjudication_id varchar [note: 'Foreign key linking to claim.adjudication. Business justification: A denial is a specific outcome of the adjudication process — when adjudication results in a denial decision, a denial record is created capturing the denial reason codes (CARC/RARC), clinical criteria']
  benefit_id varchar [note: 'Foreign key linking to plan.benefit. Business justification: Denials cite benefit-level exclusions, coverage limits, and clinical criteria. Denial management, appeals processing, and medical necessity review process.']
  claim_header_id varchar [note: 'Unique identifier of the claim associated with this denial.']
  formulary_exception_id varchar [note: 'Foreign key linking to pharmacy.formulary_exception. Business justification: When a formulary exception request is denied, a denial record is created. Linking denial to formulary_exception enables CMS Part D coverage determination tracking, appeal rights notification complianc']
  grace_period_id varchar [note: 'Foreign key linking to billing.grace_period. Business justification: Grace period expiration is a specific denial trigger under ACA regulations. Linking claim.denial directly to billing.grace_period enables regulatory reporting on grace-period-triggered denials, suppor']
  health_plan_id varchar [note: 'Foreign key linking to plan.health_plan. Business justification: Denials require plan-specific appeal rights, timelines (grace period days), and regulatory classification for member notification. Appeals management and state/federal compliance process.']
  line_id varchar [note: 'Foreign key linking to claim.line. Business justification: Denial may apply to a specific claim line; replace claim_line_number with a proper FK to claim.line']
  medical_policy_id varchar [note: 'Foreign key linking to utilization.medical_policy. Business justification: Denials based on medical necessity or non-covered services must cite the specific medical policy version that drove the denial. This link supports appeal defense documentation, regulatory audit trails']
  member_subscriber_id varchar [note: 'Unique identifier of the member whose claim was denied.']
  pa_request_id varchar [note: 'Foreign key linking to utilization.pa_request. Business justification: Denials caused by missing or failed PA must reference the originating PA request for appeal workflows, ACA-mandated denial notice generation, and regulatory reporting. This link enables denial-to-PA t']
  policy_id varchar [note: 'Foreign key linking to member.policy. Business justification: Denial processing and appeal resolution require direct policy reference to validate coverage limits, benefit exclusions, and policy-level eligibility at time of service. Denial letters and regulatory ']
  prior_authorization_id varchar [note: 'Foreign key linking to pharmacy.prior_authorization. Business justification: Pharmacy claim denials are frequently caused by PA failures or missing PA. Linking denial to pharmacy.prior_authorization supports CMS/ACA timely denial reporting, appeals processing, and denial root-']
  reimbursement_policy_id varchar [note: 'Foreign key linking to contract.reimbursement_policy. Business justification: Denials are frequently triggered by specific reimbursement policy rules (NCCI, modifier, POS restrictions). Linking denial to the policy that generated it enables denial root-cause analysis, appeals w']
  appeal_deadline_date date [note: 'Last date by which an appeal must be filed.']
  appeal_eligibility_flag boolean [note: 'Indicates whether the denial is eligible for an appeal.']
  carc_code varchar [note: 'Standardized code describing the reason for the claim adjustment/denial.']
  clinical_criteria varchar [note: 'Reference to the clinical guideline or utilization management criteria applied.']
  created_timestamp timestamp [note: 'Timestamp when the denial record was first created in the system.']
  currency_code varchar [note: 'Three‑letter ISO currency code for monetary values.']
  denial_date date [note: 'Date the denial decision was rendered.']
  denial_status varchar [note: 'Current lifecycle status of the denial.']
  denial_type varchar [note: 'High‑level classification of the denial reason.']
  denied_adjustment_amount decimal(12,2) [note: 'Adjustments (e.g., contractual allowances, discounts) applied to the denied amount.']
  denied_gross_amount decimal(12,2) [note: 'Original amount of the claim that was denied before any adjustments.']
  denied_net_amount decimal(12,2) [note: 'Final net amount after adjustments that the member is responsible for due to the denial.']
  letter_generated_flag boolean [note: 'True if a formal denial letter was generated and sent to the member/provider.']
  medical_necessity_flag boolean [note: 'Indicates whether the claim failed medical necessity criteria (true = not medically necessary).']
  notes varchar [note: 'Free‑form notes captured by reviewers or staff during denial handling.']
  number varchar [note: 'External business identifier assigned to the denial, used in communications and reporting.']
  override_flag boolean [note: 'True if the denial was manually overridden by a reviewer.']
  override_reason varchar [note: 'Explanation for why the denial was overridden.']
  rac_code varchar [note: 'Standardized remark code that provides additional context for the denial.']
  reason_description varchar [note: 'Narrative explanation of why the claim or line was denied.']
  resolution_date date [note: 'Date the denial was resolved or closed.']
  resolution_status varchar [note: 'Current status of the denial resolution process.']
  subtype varchar [note: 'More granular category within the denial type, if applicable.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the denial record.']

  Note: 'Authoritative record of claim and claim line denials, capturing denial reason codes, clinical rationale, and resolution tracking. Includes denial ID, claim ICN, line number (if line-level denial), denial date, denial type (clinical, administrative, technical, COB, timely filing), CARC code, RARC code, denial reason description, clinical criteria applied (InterQual/MCG), medical necessity determination, denial letter generated flag, appeal eligibility flag, appeal deadline date, denial override flag, override reason, and resolution status. Supports appeals workflow, regulatory reporting, and denial management analytics.'
}

Table claim.cob {
  cob_id varchar [pk, note: 'Primary key for cob']
  adjudication_id varchar [note: 'Foreign key linking to claim.adjudication. Business justification: Coordination of Benefits (COB) processing is an integral part of the adjudication workflow — COB determines the secondary payer liability after the primary payer adjudicates. The cob table currently l']
  claim_header_id varchar [note: 'Foreign key linking to claim.header. Business justification: COB processing is performed per claim; linking to claim header enables traceability']
  claim_id varchar [note: 'Foreign key linking to pharmacy.pharmacy_claim. Business justification: COB coordination for pharmacy claims (Part D/Medicaid crossover, dual-coverage members) requires direct linkage to the pharmacy claim being coordinated. Enables Part D TrOOP tracking, MSP pharmacy COB']
  cob_record_id varchar [note: 'Foreign key linking to member.cob_record. Business justification: COB adjudication processing must reference the member\'s COB record to determine payer order, coordination rules, and MSP compliance. This is a core operational link: claim COB processing directly cons']
  group_id varchar [note: 'Internal identifier of the user who performed the COB processing.']
  health_plan_id varchar [note: 'Foreign key linking to plan.health_plan. Business justification: COB processing determines primary vs secondary payer responsibility based on plan coordination rules and MSP indicator. Coordination of benefits adjudication and Medicare crossover processing.']
  adjustment_amount decimal(12,2) [note: 'Monetary amount of the adjustment applied to the net liability.']
  adjustment_reason varchar [note: 'Reason for any monetary adjustment applied during COB processing.']
  batch_number varchar [note: 'Identifier of the ETL batch that loaded this COB record.']
  claim_icn varchar [note: 'Unique identifier assigned to the underlying claim that this COB record relates to.']
  claim_line_count varchar [note: 'Number of line items on the underlying claim.']
  cob_status varchar [note: 'Current processing status of the COB record.']
  comments varchar [note: 'Free‑form notes entered by the processor.']
  created_timestamp timestamp [note: 'Timestamp when the COB record was first created in the system.']
  crossover_claim_flag boolean [note: 'Indicates whether the claim crosses over between primary and secondary payer responsibilities.']
  currency_code varchar [note: 'Three‑letter ISO 4217 code for monetary values (e.g., USD).']
  effective_date date [note: 'Date when the COB processing became effective.']
  expiration_date date [note: 'Date when the COB record expires or is no longer valid (nullable).']
  is_duplicate boolean [note: 'Flag indicating whether this COB record was generated for a duplicate claim.']
  is_manual_override boolean [note: 'True if a user manually overrode automated COB decisions.']
  medicaid_crossover_indicator boolean [note: 'Flag showing if Medicaid is involved in a crossover scenario.']
  method varchar [note: 'Method used for coordination of benefits: standard, non‑duplication, or maintenance of benefits.']
  msp_indicator boolean [note: 'Flag indicating whether Medicare is acting as the secondary payer for this claim.']
  msp_type varchar [note: 'Specifies the type of Medicare secondary payer relationship (full or partial).']
  net_liability_amount decimal(12,2) [note: 'Remaining liability amount after primary and secondary payments and adjustments.']
  primary_payer_allowed_amount decimal(12,2) [note: 'Maximum amount the primary payer allowed for the claim before COB.']
  primary_payer_denial_reason varchar [note: 'Reason code or description why the primary payer denied all or part of the claim.']
  primary_payer_paid_amount decimal(12,2) [note: 'Amount actually paid by the primary payer after adjudication.']
  process_order varchar [note: 'Sequential order in which multiple payer COB steps are applied for the claim.']
  processed_timestamp timestamp [note: 'Date‑time when the COB processing was completed.']
  processing_user_name varchar [note: 'Display name of the user who performed the COB processing.']
  total_allowed_amount decimal(12,2) [note: 'Sum of allowed amounts for all claim lines as determined by the primary payer.']
  total_charge_amount decimal(12,2) [note: 'Aggregate charge amount from all claim lines before any adjustments.']
  total_paid_amount decimal(12,2) [note: 'Total amount paid by the primary payer before secondary adjudication.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the COB record.']

  Note: 'Coordination of Benefits processing record for claims involving multiple payers. Captures COB record ID, claim ICN, primary payer ID, primary payer name, primary payer paid amount, primary payer allowed amount, primary payer denial reason, secondary payer ID, COB processing order, COB method (standard/non-duplication/maintenance of benefits), other insurance type (employer group/Medicare/Medicaid/auto/workers comp), Medicare as secondary payer (MSP) indicator, MSP type, crossover claim flag, Medicaid crossover indicator, and net liability after COB. Supports accurate secondary adjudication and CMS MSP compliance.'
}

Table claim.payment {
  payment_id varchar [pk, note: 'Primary key for payment']
  account_id varchar [note: 'Foreign key linking to billing.account. Business justification: Claim payment disbursement reconciliation and GL posting require direct traceability from claim payments to billing accounts. Payment reconciliation reports and financial close processes depend on thi']
  adjudication_id varchar [note: 'Foreign key linking to claim.adjudication. Business justification: Claim payments are authorized and calculated by the adjudication process — the adjudication record determines the net_amount, allowed_amount, and payment authorization. The payment table currently lin']
  dispensing_pharmacy_id varchar [note: 'Foreign key linking to pharmacy.dispensing_pharmacy. Business justification: Direct pharmacy payments (EFT/check to dispensing pharmacies) require linking to the dispensing pharmacy entity for network audit, 1099 tax reporting, payment reconciliation against contracted dispens']
  health_plan_id varchar [note: 'Foreign key linking to plan.health_plan. Business justification: Payment batches reconcile against plan-level financial accounts, MLR reporting, and risk adjustment factors. Financial settlement and CMS regulatory reporting process.']
  par_agreement_id varchar [note: 'Foreign key linking to network.par_agreement. Business justification: Provider payments are governed by par agreement terms (contracted rates, EFT routing, payment conditions). Payment reconciliation against par agreement contracted rates is a named operational process ']
  pbm_contract_id varchar [note: 'Foreign key linking to pharmacy.pbm_contract. Business justification: PBM payments are governed by PBM contracts specifying dispensing fees, rebate pass-through, and performance guarantees. Linking payment to pbm_contract enables PBM financial reconciliation, rebate set']
  primary_payment_claim_claim_header_id varchar [note: 'FK to claim.header']
  primary_payment_party_id varchar [note: 'Unique identifier of the entity receiving the payment (provider NPI or member ID).']
  provider_id varchar [note: 'Foreign key linking to provider.provider. Business justification: Payments may be adjusted based on appeal outcomes; linking to the appeal outcome enables accurate reconciliation and compliance reporting of appeal‑related payment changes.']
  rate_id varchar [note: 'Foreign key linking to plan.rate. Business justification: Capitation and risk-adjusted payments reconcile against rate tables (age-rated premium, underwriting class, rating area). Provider payment reconciliation and financial settlement process.']
  adjustment_amount decimal(15,2) [note: 'Sum of all adjustments (CARC/RARC) applied to the gross amount.']
  batch_number varchar [note: 'Identifier of the batch in which this payment was processed.']
  batch_sequence varchar [note: 'Sequence order of the payment within its batch.']
  carc_codes varchar [note: 'Pipe‑separated list of CARC codes applied to the claim payment.']
  channel varchar [note: 'Delivery channel for the payment transaction.']
  check_number varchar [note: 'Check number when payment method is a paper check.']
  clearinghouse_code varchar [note: 'Identifier of the EDI clearinghouse that processed the 835 transaction.']
  clearinghouse_name varchar [note: 'Human‑readable name of the clearinghouse (e.g., Availity, Change Healthcare).']
  created_timestamp timestamp [note: 'Timestamp when the payment record was first created in the system.']
  currency_code varchar [note: 'Three‑letter ISO 4217 currency code for the payment.']
  cycle varchar [note: 'Frequency with which the payment is issued.']
  description varchar [note: 'Free‑text description of the payment purpose.']
  gl_posting_date date [note: 'Date the payment entry was posted to the general ledger.']
  gl_reference_number varchar [note: 'Reference identifier linking the payment to the GL transaction.']
  gross_amount decimal(15,2) [note: 'Total amount before any adjustments or taxes.']
  is_reconciled boolean [note: 'Indicates whether the payment has been fully reconciled.']
  is_returned boolean [note: 'True if the payment was returned by the bank or clearinghouse.']
  is_voided boolean [note: 'True if the payment was voided after issuance.']
  method varchar [note: 'Instrument used to disburse the payment.']
  net_amount decimal(15,2) [note: 'Final amount paid to the payee after adjustments.']
  note varchar [note: 'Additional free‑form notes related to the payment.']
  number varchar [note: 'External payment reference number used in remittance advice and provider communications.']
  payee_type varchar [note: 'Classification of the payee: provider, member, or other.']
  payment_date timestamp [note: 'Timestamp when the payment was issued to the payee.']
  payment_status varchar [note: 'Current lifecycle state of the payment.']
  payment_type varchar [note: 'Category of the payment (e.g., claim settlement, capitation offset).']
  racr_codes varchar [note: 'Pipe‑separated list of RARC codes providing additional adjustment details.']
  reason_code varchar [note: 'Standard code indicating why the payment was made (e.g., claim settlement, rebate).']
  reconciliation_status varchar [note: 'Current status of the payment\'s financial reconciliation.']
  returned_reason varchar [note: 'Explanation for why the payment was returned.']
  source varchar [note: 'Indicates whether the payment originated from internal systems or an external entity.']
  tax_amount decimal(15,2) [note: 'Tax withheld or applied to the payment, if applicable.']
  trace_number varchar [note: 'Bank‑provided trace number for tracking the payment.']
  transaction_control_number varchar [note: 'Unique control number for the 835 remittance advice transaction.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the payment record.']
  void_reason varchar [note: 'Explanation for why the payment was voided.']

  Note: 'Single source of truth for all claim payment disbursements and electronic remittance advice (835 ERA) transmitted to providers and members. Captures payee information (NPI/TIN/member ID), payment amount, payment date, payment method (EFT/check/virtual card/capitation offset), check/EFT trace number, payment status lifecycle (issued/cleared/voided/returned/stopped), 835 transaction control number, clearinghouse ID (Availity, Change Healthcare), CARC/RARC adjustment codes at claim level, claim-level payment detail, reconciliation status, and GL posting reference. Consolidates provider remittance advice and claim payment into a single authoritative record for payment reconciliation, cash posting, and provider inquiry resolution.'
}

Table pharmacy.drug_master {
  drug_master_id varchar [pk, note: 'Unique surrogate identifier for each drug master record in the lakehouse Silver layer. Serves as the primary key for all downstream joins across formulary, claims, DUR, rebate contracting, and PBM adjudication.']
  compliance_regulatory_obligation_id varchar
  atc_code varchar [note: 'The WHO Anatomical Therapeutic Chemical (ATC) classification code at the 5th level, identifying the drug\'s anatomical main group, therapeutic subgroup, pharmacological subgroup, chemical subgroup, and chemical substance. Used for therapeutic class reporting, HEDIS pharmacy measures, population health analytics, and international drug classification alignment.']
  awp_effective_date date [note: 'The date on which the current AWP unit price became effective. Used to apply the correct AWP for historical claims repricing, audit reconciliation, and retroactive rebate calculations.']
  awp_unit_price decimal(18,6) [note: 'The Average Wholesale Price (AWP) per unit of the drug as published by First Databank or Medi-Span. AWP is the benchmark pricing reference used in pharmacy reimbursement calculations, MAC pricing comparisons, and rebate contract negotiations. Expressed in USD per unit (tablet, mL, gram, etc.).']
  brand_name varchar [note: 'The proprietary trade name under which the drug is marketed by the manufacturer (e.g., Lipitor, Humira). Used in formulary tier assignment, rebate contracting, member communications, and brand vs. generic substitution logic in PBM adjudication.']
  controlled_substance_schedule varchar [note: 'The DEA controlled substance schedule classification (I through V) indicating the drug\'s potential for abuse and accepted medical use. Schedule II-V drugs require enhanced DUR edits, quantity limits, early refill restrictions, and special handling in PBM adjudication. Not_scheduled indicates no DEA restriction.']
  created_timestamp timestamp [note: 'The timestamp when this drug master record was first created in the lakehouse Silver layer. Used for data lineage, audit compliance, and change data capture tracking per HIPAA Security Rule requirements.']
  dea_number_required boolean [note: 'Indicates whether a valid DEA registration number is required on the prescription for this drug due to its controlled substance classification. Drives prescription validation edits in PBM adjudication and pharmacy dispensing workflows.']
  dosage_form varchar [note: 'The physical form in which the drug is dispensed (e.g., tablet, capsule, solution, injection, patch, inhaler). Critical for formulary configuration, quantity limit rules, step therapy protocols, and DUR screening in RxClaim/Argus. [ENUM-REF-CANDIDATE: tablet|capsule|solution|injection|patch|inhaler|cream|ointment|suspension|powder — promote to reference product]']
  drug_class_code varchar [note: 'The classification code for the drug class within the GPI or ETC hierarchy, representing a more granular grouping below therapeutic subclass (e.g., specific statin subtype). Used in formulary step therapy rules, DUR clinical edits, and rebate tier segmentation in PBM systems.']
  drug_class_name varchar [note: 'The human-readable name of the drug class corresponding to the drug_class_code. Provides the most granular named classification level in the therapeutic hierarchy for formulary configuration and clinical reporting.']
  drug_name varchar [note: 'The full proprietary or established name of the drug as it appears on the FDA-approved label and in the First Databank or Medi-Span drug database feed. Used as the primary human-readable identity label across formulary displays, EOB communications, and member-facing materials.']
  drug_status varchar [note: 'Current lifecycle status of the drug record in the master file. Active drugs are eligible for formulary placement and PBM adjudication. Discontinued or recalled drugs trigger claim edits and member/provider notifications. Drives formulary maintenance workflows in RxClaim/Argus.']
  drug_type varchar [note: 'Classification of the drug as brand-name, generic, biosimilar, over-the-counter (OTC), compounded, or repackaged. Drives formulary tier assignment, cost-sharing rules, generic substitution logic, and rebate eligibility in PBM adjudication and formulary management.']
  effective_date date [note: 'The date on which this drug master record became effective and eligible for use in formulary configuration, PBM adjudication, and claims processing. Used for temporal validity enforcement in adjudication date-of-service lookups and formulary effective date management.']
  fda_approval_status varchar [note: 'The current FDA regulatory approval status of the drug product. Approved drugs are eligible for formulary coverage. Tentatively approved generics may be covered under specific plan designs. Withdrawn or not-approved drugs are excluded from formulary and trigger claim denials. Required for CMS Part D formulary compliance.']
  generic_name varchar [note: 'The International Nonproprietary Name (INN) or United States Adopted Name (USAN) for the active ingredient(s) of the drug (e.g., atorvastatin, adalimumab). Used for generic substitution logic, DUR screening, therapeutic equivalence grouping, and HEDIS pharmacy measure reporting.']
  gpi_code varchar [note: 'The 14-digit Medi-Span Generic Product Identifier (GPI) code providing a hierarchical drug classification from drug group (2 digits) through drug class, subclass, name, name extension, dosage form, and strength. Used as the primary therapeutic classification key in RxClaim/Argus PBM systems for formulary management, DUR screening, and rebate contracting.']
  hcc_relevant boolean [note: 'Indicates whether this drug is clinically associated with one or more CMS Hierarchical Condition Categories (HCCs) for risk adjustment purposes. HCC-relevant drugs are used in RAF score modeling, RAPS/EDPS encounter data submissions, and population health stratification for Medicare Advantage plans.']
  is_biosimilar boolean [note: 'Indicates whether this drug is an FDA-approved biosimilar to a reference biological product. Biosimilars have distinct formulary placement rules, interchangeability designations, and rebate contracting considerations under CMS Part D and commercial plan designs.']
  is_generic_available boolean [note: 'Indicates whether an FDA-approved generic equivalent is available in the market for this brand-name drug. Used in formulary tier assignment, member cost-sharing communications, and generic substitution prompts during PBM adjudication and pharmacy dispensing.']
  is_maintenance_drug boolean [note: 'Indicates whether this drug is classified as a maintenance medication intended for long-term chronic condition management (e.g., antihypertensives, statins, diabetes medications). Maintenance drugs are eligible for 90-day supply dispensing at mail-order pharmacies and are used in HEDIS medication adherence measures (PDC).']
  is_preventive_drug boolean [note: 'Indicates whether this drug qualifies as a preventive medication under ACA Section 2713 or HDHP/HSA preventive care rules, making it eligible for $0 cost-sharing before the deductible is met. Used in benefit configuration and claims adjudication cost-sharing logic.']
  is_specialty_drug boolean [note: 'Indicates whether this drug is classified as a specialty pharmaceutical requiring special handling, storage, administration, or monitoring (e.g., biologics, oncology agents, hepatitis C treatments). Specialty drugs are subject to mandatory specialty pharmacy channel requirements, prior authorization, and enhanced DUR in PBM adjudication. Critical for CMS Part D specialty tier placement.']
  labeler_code varchar [note: 'The 5-digit FDA-assigned labeler code (first segment of the NDC) identifying the firm that manufactures, repackages, relabels, or distributes the drug. Used for manufacturer-level rebate aggregation and PBM contract management.']
  multi_source_code varchar [note: 'The FDA Orange Book multi-source code indicating the competitive market status of the drug: O=originator brand with no generic, M=multi-source (generic available), N=no current market (discontinued), Y=single-source generic. Used in generic substitution logic, formulary tier assignment, and MAC pricing eligibility determination.']
  ndc varchar [note: 'The 11-digit National Drug Code assigned by the FDA uniquely identifying the labeler, product, and package size of a drug. This is the primary external business identifier for the drug and is used in pharmacy claims (NCPDP/837P), formulary management, PBM adjudication (RxClaim/Argus), and CMS Part D reporting. Stored in 5-4-2 format without hyphens.']
  ndc_11 varchar [note: 'The NDC formatted in the standard 5-4-2 hyphenated display format (e.g., 12345-6789-01) as required for human-readable labeling, SBC documentation, and regulatory submissions to CMS and state DOIs.']
  package_size decimal(18,4) [note: 'The quantity of drug units contained in the dispensed package as defined by the NDC (e.g., 30 tablets, 100 mL, 1 vial). Used in unit-of-use pricing calculations, days supply verification, quantity limit enforcement, and MAC pricing per-unit derivation.']
  package_size_unit varchar [note: 'The unit of measure for the package size quantity (e.g., EA for each/tablet/capsule, ML for milliliter, GM for gram). Used in conjunction with package_size for accurate dispensing quantity calculations, days supply verification, and unit-cost pricing in PBM adjudication. [ENUM-REF-CANDIDATE: EA|ML|GM|MG|TAB|CAP|VIAL|PATCH|KIT — 9 candidates stripped; promote to reference product]']
  pharmacological_category varchar [note: 'The pharmacological mechanism-of-action category of the drug (e.g., ACE Inhibitor, Beta Blocker, SSRI, Statin, Monoclonal Antibody). Used for DUR drug-drug interaction screening, therapeutic duplication edits, clinical program targeting in care management, and HEDIS measure attribution.']
  rems_program varchar [note: 'The name of the FDA-mandated Risk Evaluation and Mitigation Strategy (REMS) program associated with this drug, if applicable (e.g., iPLEDGE for isotretinoin, TIRF REMS for fentanyl products). REMS drugs require special dispensing controls, patient enrollment, and prescriber certification that must be validated during PBM adjudication and prior authorization.']
  route_of_administration varchar [note: 'The path by which the drug is administered to the patient (e.g., oral, intravenous, subcutaneous, topical, inhalation). Drives formulary benefit category assignment (medical vs. pharmacy benefit), prior authorization requirements, and specialty pharmacy routing in PBM adjudication. [ENUM-REF-CANDIDATE: oral|intravenous|subcutaneous|intramuscular|topical|inhalation|transdermal|ophthalmic|otic|rectal — promote to reference product]']
  source_record_code varchar [note: 'The native record identifier from the originating source system (First Databank, Medi-Span, RxClaim, or Argus) for this drug master record. Used for data lineage, cross-system reconciliation, and upstream change tracking in the lakehouse ingestion pipeline.']
  source_system_code varchar [note: 'Identifies the operational source system from which this drug master record was ingested (e.g., FDB=First Databank, MEDISPAN=Medi-Span, RXCLAIM=RxClaim PBM, ARGUS=Argus PBM, INTERNAL=internally maintained). Used for data lineage tracking, conflict resolution during ETL, and audit compliance in the Databricks Silver layer.']
  strength varchar [note: 'The concentration or potency of the active ingredient(s) expressed as a numeric value with unit of measure (e.g., 10 mg, 500 mg/5 mL, 0.25%). Used in DUR duplicate therapy screening, quantity limit enforcement, and clinical appropriateness review in UM/PA workflows.']
  termination_date date [note: 'The date on which this drug master record was terminated or superseded, indicating the drug is no longer active for formulary placement or new claim adjudication. Null indicates the record is currently active. Used for historical claims repricing and formulary audit trails.']
  therapeutic_class_code varchar [note: 'The standardized code identifying the broad therapeutic class of the drug (e.g., cardiovascular agents, anti-infectives, antineoplastics). Used for formulary tier grouping, rebate contract aggregation, utilization reporting, and disease management program enrollment triggers.']
  therapeutic_class_name varchar [note: 'The human-readable name of the therapeutic class corresponding to the therapeutic_class_code. Used in formulary displays, member-facing SBC documents, provider communications, and regulatory reporting to CMS and state DOIs.']
  therapeutic_equivalence_code varchar [note: 'The FDA Orange Book therapeutic equivalence evaluation code (e.g., AB, AA, BC) indicating whether a generic drug is therapeutically equivalent to the reference listed drug. AB-rated generics are substitutable at the pharmacy. Used in generic substitution logic, formulary step therapy, and DAW (Dispense As Written) override processing in PBM adjudication.']
  therapeutic_subclass_code varchar [note: 'The standardized code identifying the therapeutic subclass within the broader therapeutic class (e.g., HMG-CoA Reductase Inhibitors within cardiovascular agents). Enables granular formulary tier differentiation, step therapy protocol design, and rebate contract segmentation.']
  therapeutic_subclass_name varchar [note: 'The human-readable name of the therapeutic subclass corresponding to the therapeutic_subclass_code. Used in formulary management workflows, clinical program configuration, and detailed utilization analytics.']
  updated_timestamp timestamp [note: 'The timestamp when this drug master record was last modified in the lakehouse Silver layer. Used for incremental data refresh, change detection, and audit trail maintenance in the Databricks lakehouse pipeline.']
  wac_unit_price decimal(18,6) [note: 'The Wholesale Acquisition Cost (WAC) per unit as reported by the manufacturer, representing the list price to wholesalers before discounts and rebates. Used as a pricing benchmark for specialty drug reimbursement, rebate baseline calculations, and CMS Part D coverage gap discount program calculations.']

  Note: 'Authoritative NDC-level drug master record for all covered pharmaceutical products. Captures National Drug Code (NDC), drug name, generic name, brand name, manufacturer, dosage form, strength, route of administration, drug class, controlled substance schedule, FDA approval status, and therapeutic equivalence codes (AB-rated/biosimilar). Includes generic substitution relationships and the full therapeutic classification hierarchy: ATC (Anatomical Therapeutic Chemical) code, GPI (Generic Product Identifier) prefix, pharmacological category, therapeutic class, therapeutic subclass, class name, and subclass name. This is the SSOT for all drug identity, classification, equivalence, and therapeutic hierarchy data used across formulary, claims, DUR, rebate contracting, HEDIS pharmacy measures, and PBM adjudication. Sourced from First Databank/Medi-Span drug database feeds.'
}

Table pharmacy.formulary {
  formulary_id varchar [pk, note: 'Unique surrogate identifier for the formulary record. Primary key for the formulary data product in the pharmacy domain.']
  compliance_regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: Formulary design must adhere to specific regulatory obligations (ACA, CMS); linking enables reporting of compliance status per formulary.']
  prior_version_formulary_id varchar [note: 'Reference to the immediately preceding version of this formulary. Enables formulary change tracking, member notification workflows, and historical adjudication lookups for appeals and grievances.']
  category varchar [note: 'Business classification of the formulary indicating its benefit richness level relative to other formularies offered by the plan. Used in benefit design analytics, member communications, and plan comparison tools.']
  change_notification_date date [note: 'Date on which member notification was sent for formulary changes. CMS Part D requires 60-day advance notice for non-preferred formulary changes and immediate notification for safety-related removals.']
  cms_formulary_code varchar [note: 'The CMS-assigned formulary identifier used in Part D formulary file submissions to CMS. Required for Medicare Part D plans to identify the formulary in RAPS and EDPS submissions.']
  code varchar [note: 'Externally-known alphanumeric code uniquely identifying the formulary across systems, used in EDI transactions, PBM interfaces, and CMS Part D submissions. Corresponds to the formulary ID field in RxClaim/Argus PBM system.']
  created_timestamp timestamp [note: 'Timestamp when this formulary record was first created in the system. Used for audit trail, data lineage, and compliance documentation purposes.']
  description varchar [note: 'Free-text business description of the formulary, including its intended population, key design features, and any notable coverage inclusions or exclusions. Used in internal documentation and plan benefit configuration.']
  drug_count varchar [note: 'Total number of unique drug entries (NDC or drug-tier combinations) included in this formulary at the time of the last update. Used for formulary adequacy assessments and CMS Part D formulary file validation.']
  drug_utilization_review_ind boolean [note: 'Indicates whether Drug Utilization Review (DUR) edits are applied during adjudication under this formulary. DUR programs screen for drug interactions, duplicate therapy, and inappropriate dosing per OBRA \'90 requirements.']
  effective_date date [note: 'The date on which this formulary becomes active and applicable to member benefit adjudication. Used by PBM systems (RxClaim/Argus) to determine which formulary version applies at point of dispensing.']
  formulary_status varchar [note: 'Current lifecycle status of the formulary record. Active formularies are used in live adjudication; pending formularies are approved but not yet effective; retired formularies are historical records no longer in use.']
  formulary_type varchar [note: 'Classification of the formulary structure indicating coverage breadth and tier design. Open formularies cover most drugs; closed formularies restrict to listed drugs only; tiered formularies apply differential cost-sharing by tier.']
  generic_substitution_policy varchar [note: 'Policy governing generic drug substitution at point of dispensing. Mandatory substitution requires dispensing of generic equivalents; permissive allows brand if requested; DAW (Dispense As Written) honored respects prescriber instructions.']
  is_aca_compliant boolean [note: 'Indicates whether this formulary meets ACA Qualified Health Plan (QHP) essential health benefit (EHB) drug coverage requirements, including the required drug categories and classes under 45 CFR Part 156.']
  is_cms_part_d boolean [note: 'Indicates whether this formulary is subject to CMS Medicare Part D regulatory requirements, including annual bid submission, formulary file submission to CMS, and coverage determination obligations.']
  last_review_date date [note: 'Date on which the Pharmacy and Therapeutics (P&T) Committee last reviewed and approved this formulary. P&T Committee review is required for CMS Part D compliance and NCQA accreditation.']
  lob_code varchar [note: 'Line of Business (LOB) associated with this formulary, indicating the regulatory and market segment under which the formulary operates. Drives CMS Part D, Medicaid, or commercial compliance requirements.']
  low_income_subsidy_ind boolean [note: 'Indicates whether this formulary is designated for use by Low Income Subsidy (LIS) eligible members under Medicare Part D. LIS formularies must meet CMS benchmark plan requirements for cost-sharing and drug coverage.']
  mail_order_ind boolean [note: 'Indicates whether this formulary supports mail-order pharmacy dispensing. Mail-order programs typically offer 90-day supplies at reduced cost-sharing and are a key component of pharmacy benefit design.']
  name varchar [note: 'Human-readable business name of the formulary (e.g., \'Standard Commercial Formulary 2025\', \'Medicare Part D Enhanced Formulary\'). Used in member-facing materials, SBC documents, and plan benefit configurations.']
  next_review_date date [note: 'Scheduled date for the next Pharmacy and Therapeutics (P&T) Committee review of this formulary. Supports compliance tracking for CMS Part D requirements mandating regular formulary review cycles.']
  pbm_formulary_code varchar [note: 'The formulary identifier as assigned by the PBM system (RxClaim or Argus). Used for cross-system reconciliation between the health plan\'s internal formulary record and the PBM\'s formulary configuration.']
  plan_year varchar [note: 'The benefit plan year (e.g., 2025) for which this formulary is effective. Used for annual formulary change management, CMS Part D annual bid submissions, and benefit year reporting.']
  prior_auth_ind boolean [note: 'Indicates whether this formulary requires prior authorization (PA) for any covered drugs. PA requirements are subject to CMS Part D coverage determination timelines and member appeal rights.']
  pt_committee_approval_date date [note: 'Date on which the Pharmacy and Therapeutics (P&T) Committee formally approved this formulary or the most recent formulary update. Required documentation for CMS Part D compliance and NCQA accreditation audits.']
  quantity_limit_ind boolean [note: 'Indicates whether this formulary applies quantity limits (QL) on covered drugs, restricting the amount dispensed per fill or per defined time period. Quantity limits are a utilization management tool subject to CMS Part D exception requirements.']
  regulatory_approval_date date [note: 'The date on which CMS or the applicable State Department of Insurance approved this formulary for use. Required for Part D compliance documentation and audit trails.']
  regulatory_filing_date date [note: 'The date on which the formulary was submitted to CMS or the applicable State Department of Insurance for regulatory review and approval.']
  regulatory_filing_status varchar [note: 'Status of the formulary\'s regulatory filing with CMS or applicable State Department of Insurance (DOI). Tracks whether the formulary has been submitted, approved, or rejected for compliance with Part D or state market requirements.']
  source_system_code varchar [note: 'Identifies the operational source system from which this formulary record originated (e.g., RxClaim, Argus PBM system, Facets). Used for data lineage tracking and cross-system reconciliation in the Databricks Silver layer.']
  specialty_pharmacy_ind boolean [note: 'Indicates whether this formulary designates a specialty pharmacy network for dispensing high-cost specialty drugs. Specialty pharmacy programs may include limited distribution networks and enhanced clinical support services.']
  specialty_tier_ind boolean [note: 'Indicates whether this formulary includes a specialty drug tier for high-cost specialty medications. Specialty tiers typically apply to drugs with monthly costs exceeding CMS specialty tier threshold (currently $670/month for Part D).']
  step_therapy_ind boolean [note: 'Indicates whether this formulary employs step therapy (also known as fail-first) protocols requiring members to try lower-cost or preferred drugs before coverage of higher-cost alternatives is authorized.']
  termination_date date [note: 'The date on which this formulary is no longer active. Null indicates an open-ended formulary with no defined end date. Used for formulary version management and historical adjudication lookups.']
  tier_count varchar [note: 'The total number of cost-sharing tiers defined in this formulary (e.g., 3-tier, 4-tier, 5-tier, 6-tier). Determines the tier structure used in drug tier assignments and member cost-sharing calculations.']
  updated_timestamp timestamp [note: 'Timestamp when this formulary record was last modified. Used for change tracking, incremental data loads in the Databricks Silver layer, and audit trail requirements.']
  url varchar [note: 'Public-facing URL where members can access the formulary drug list. CMS Part D and ACA QHP regulations require health plans to publish formularies online and provide the URL in plan materials and SBC documents.']
  version varchar [note: 'Version number of the formulary, incremented with each approved update or mid-year formulary change. Used to track formulary change history and ensure members receive required 60-day advance notice of non-preferred changes.']

  Note: 'Master record for each formulary (drug benefit list) offered by the health plan. Defines the formulary name, effective date range, line of business (LOB), plan year, formulary type (open/closed/tiered), PBM contract reference, and regulatory filing status. A formulary is the SSOT for which drugs are covered under a given benefit design and is required for CMS Part D compliance.'
}

Table pharmacy.formulary_drug_tier {
  formulary_drug_tier_id varchar [pk, note: 'Unique surrogate identifier for each formulary drug tier assignment record. Primary key for this association entity linking a drug (NDC) to a formulary with its tier, cost-sharing, and utilization management (UM) controls.']
  clinical_criteria_id varchar [note: 'Foreign key linking to utilization.clinical_criteria. Business justification: Formulary drug tier PA criteria and step therapy clinical rationale are defined by clinical criteria records. pa_criteria_description and st_clinical_rationale are denormalized text representations of']
  drug_master_id varchar [note: 'Reference to the internal drug master record corresponding to this NDC, enabling joins to the drug master for drug name, therapeutic class, and other drug attributes.']
  formulary_id varchar [note: 'Reference to the formulary to which this drug tier assignment belongs. A formulary is the approved list of covered drugs for a given plan and benefit year.']
  group_plan_offering_id varchar [note: 'Foreign key linking to employer.group_plan_offering. Business justification: Plan offerings specify which formulary tiers apply to members. Required for member cost-sharing calculations, benefit comparison tools, and plan design documentation in group benefit administration.']
  benefit_year varchar [note: 'The plan benefit year (e.g., 2024, 2025) to which this formulary drug tier assignment applies. CMS Part D formulary files are submitted annually by benefit year.']
  coinsurance_rate decimal(5,4) [note: 'Member coinsurance percentage applied to the drug cost under this formulary tier assignment, expressed as a decimal (e.g., 0.20 = 20%). Used when cost-sharing is percentage-based rather than fixed copay. Applies to specialty and high-cost tiers.']
  copay_mail_order decimal(10,2) [note: 'Fixed member copay amount for a 90-day supply dispensed through a mail-order pharmacy under this formulary tier assignment. Mail-order copays are typically lower than retail to incentivize mail-order utilization.']
  copay_retail_30 decimal(10,2) [note: 'Fixed member copay amount for a 30-day supply dispensed at a retail pharmacy under this formulary tier assignment. Drives member cost-sharing at point of sale. Used in SBC and EOB generation.']
  copay_retail_90 decimal(10,2) [note: 'Fixed member copay amount for a 90-day supply dispensed at a retail pharmacy under this formulary tier assignment. Applicable for maintenance medications at extended-supply retail pharmacies.']
  coverage_status varchar [note: 'Indicates whether the drug is covered under this formulary assignment. \'covered\' = fully covered per tier rules; \'covered_with_restrictions\' = covered subject to UM controls (PA, ST, QL); \'not_covered\' = not on formulary; \'excluded\' = explicitly excluded per CMS or plan rules.']
  created_timestamp timestamp [note: 'Timestamp when this formulary drug tier assignment record was first created in the system. Supports audit trail, data lineage, and regulatory compliance documentation.']
  deductible_applies boolean [note: 'Indicates whether the plan deductible must be met before cost-sharing for this drug tier applies. Relevant for High Deductible Health Plans (HDHP) and plans with drug-specific deductibles.']
  dispensing_channel varchar [note: 'Pharmacy dispensing channel(s) through which this drug may be dispensed under this formulary tier assignment. \'specialty\' indicates dispensing is restricted to a specialty pharmacy network. Drives pharmacy routing at point of sale.']
  drug_tier_change_reason varchar [note: 'Business reason for a change to the drug\'s tier assignment (e.g., \'generic available\', \'contract renegotiation\', \'clinical review\', \'CMS requirement\', \'formulary refresh\'). Supports audit trail and CMS formulary change notification requirements.']
  dur_alert_type varchar [note: 'Type of Drug Utilization Review (DUR) alert associated with this formulary drug tier assignment (e.g., \'drug-drug interaction\', \'drug-disease contraindication\', \'duplicate therapy\', \'dose range check\'). Drives DUR edits at point of sale in the PBM adjudication system. [ENUM-REF-CANDIDATE: drug_drug_interaction|drug_disease|duplicate_therapy|dose_range|drug_allergy|drug_age — promote to reference product]']
  effective_date date [note: 'Date on which this formulary drug tier assignment becomes effective. Used to determine the applicable tier and cost-sharing rules at the time of dispensing. Required for CMS formulary file submissions.']
  formulary_status_code varchar [note: 'CMS-defined formulary status code used in the Part D formulary file submission. Values: 1=Covered, 2=Covered with Restrictions, 3=Not Covered, 4=Covered (Grandfathered), 5=Covered (Transition), 6=Covered (LIS). Required field in CMS formulary extract file.']
  lob_code varchar [note: 'Line of business to which this formulary drug tier assignment applies (e.g., \'commercial\', \'medicare_part_d\', \'medicaid\', \'exchange\', \'fehb\'). Determines applicable regulatory requirements and cost-sharing rules.']
  mac_pricing_applicable boolean [note: 'Indicates whether Maximum Allowable Cost (MAC) pricing applies to this drug under this formulary tier assignment. MAC pricing caps reimbursement for generic drugs and is a key PBM contract term.']
  ndc_code varchar [note: '11-digit National Drug Code uniquely identifying the specific drug product, dosage form, and package size assigned to this formulary tier. NDC is the primary drug identifier used in pharmacy claim adjudication and CMS formulary file submissions.']
  pa_type varchar [note: 'Type of prior authorization process required for this drug (e.g., \'standard\' = standard review timeline; \'expedited\' = urgent/expedited review; \'retrospective\' = post-service review). Null or \'not_applicable\' if prior_auth_required is false.']
  pbm_formulary_code varchar [note: 'PBM system-specific formulary identifier used in RxClaim or Argus to reference this formulary configuration. Enables reconciliation between the health plan\'s internal formulary records and the PBM\'s adjudication system.']
  prior_auth_required boolean [note: 'Indicates whether prior authorization (PA) is required before this drug will be covered under this formulary tier assignment. When true, a PA request must be approved before the claim will adjudicate. Reported in the CMS PA extract file.']
  ql_clinical_basis varchar [note: 'Clinical rationale or basis for the quantity limit rule (e.g., \'FDA-approved maximum dose\', \'clinical guidelines\', \'safety limit\'). Documents the evidence basis for the QL control as required for CMS and NCQA compliance.']
  ql_days_supply varchar [note: 'The number of days supply over which the maximum quantity limit applies (e.g., 30 days, 90 days). Defines the time window for the quantity limit rule. Null if quantity_limit_required is false.']
  ql_dosage_form_restriction varchar [note: 'Specifies any dosage form restrictions associated with the quantity limit rule (e.g., \'tablet only\', \'extended-release excluded\', \'oral solution only\'). Captures clinical basis for dosage form-specific QL controls.']
  ql_max_quantity decimal(10,3) [note: 'Maximum quantity of the drug allowed per fill or per defined time period under the quantity limit rule. Expressed in the drug\'s dispensing unit (e.g., tablets, mL, units). Null if quantity_limit_required is false.']
  quantity_limit_required boolean [note: 'Indicates whether a quantity limit (QL) applies to this drug under this formulary assignment. When true, the dispensed quantity per fill or per time period is restricted. Reported in the CMS QL extract file.']
  record_status varchar [note: 'Lifecycle status of this formulary drug tier assignment record. \'active\' = currently in effect; \'inactive\' = terminated or expired; \'pending\' = approved but not yet effective; \'superseded\' = replaced by a newer version of the same assignment.']
  specialty_drug_flag boolean [note: 'Indicates whether this drug is designated as a specialty drug under this formulary. Specialty drugs typically require dispensing through a specialty pharmacy, have higher cost-sharing, and may require PA. Used in specialty pharmacy channel routing and PBM contract management.']
  st_override_criteria varchar [note: 'Criteria under which the step therapy requirement may be overridden without completing the required step sequence (e.g., \'contraindication to step drug\', \'prior treatment failure documented\', \'clinical exception\'). Supports PA override adjudication.']
  st_required_step_ndc varchar [note: 'National Drug Code (NDC) of the required step drug that must be tried and failed before coverage of this drug is approved under the step therapy protocol. Null if step_therapy_required is false.']
  st_step_number varchar [note: 'The sequence number of this drug in the step therapy protocol (e.g., 1 = first-line, 2 = second-line). Defines the order in which step drugs must be tried and failed before coverage of the target drug is approved. Null if step_therapy_required is false.']
  step_therapy_required boolean [note: 'Indicates whether step therapy (ST) applies to this drug under this formulary assignment. When true, the member must first try and fail one or more preferred (step) drugs before coverage of this drug is approved. Reported in the CMS ST extract file.']
  termination_date date [note: 'Date on which this formulary drug tier assignment expires or is terminated. Null indicates the assignment is currently active with no defined end date. Supports historical tracking and CMS formulary file change submissions.']
  tier_name varchar [note: 'Human-readable label for the drug tier (e.g., \'Generic\', \'Preferred Brand\', \'Non-Preferred Brand\', \'Specialty\', \'Specialty Preferred\'). Displayed on member-facing materials including the Summary of Benefits and Coverage (SBC) and Explanation of Benefits (EOB).']
  tier_number varchar [note: 'Numeric tier level assigned to the drug within the formulary (e.g., 1=Generic, 2=Preferred Brand, 3=Non-Preferred Brand, 4=Specialty, 5=Specialty Preferred, 6=Select Care). Drives member cost-sharing at point of sale. CMS requires tier number in formulary file submissions.']
  transition_fill_allowed boolean [note: 'Indicates whether a transition fill is permitted for this drug when a member is new to the plan or the drug\'s formulary status has changed. CMS Part D requires transition fills for certain drugs during the transition period.']
  updated_timestamp timestamp [note: 'Timestamp when this formulary drug tier assignment record was last modified. Supports change tracking, audit trail, and CMS formulary change notification compliance.']

  Note: 'Association entity linking a specific drug (NDC) to a formulary with its assigned tier, cost-sharing rules, coverage status, and all utilization management (UM) controls. UM controls owned by this product include: quantity limits (max quantity per fill/time period, dosage form restrictions, clinical basis), step therapy protocols (fail-first drug sequences, required step drugs, step sequence, clinical rationale, override criteria), prior authorization flags, and specialty drug designation. Captures effective date range for each tier assignment and each UM control configuration. This is the single operational record that drives member cost-sharing and UM edits at point of sale, and is the SSOT for CMS formulary file submissions including formulary, QL, ST, and PA extract files.'
}

Table pharmacy.drug_pricing {
  drug_pricing_id varchar [pk, note: 'Unique surrogate identifier for each NDC-level drug pricing record in the Silver Layer lakehouse. Primary key for the drug_pricing data product.']
  drug_master_id varchar [note: 'Foreign key linking to pharmacy.drug_master. Business justification: drug_pricing records are defined per NDC; linking to drug_master provides the authoritative drug attributes and eliminates duplicated columns.']
  awp_discount_pct decimal(7,4) [note: 'Percentage discount applied to AWP to derive the reimbursement rate under AWP-based contracts (e.g., AWP minus 15%). Expressed as a positive decimal percentage (e.g., 15.0000 = 15%). Used for PBM contract compliance validation and reimbursement audits.']
  awp_price decimal(18,6) [note: 'Average Wholesale Price per unit as published by First Databank or Medi-Span. Commonly used as the benchmark for pharmacy reimbursement calculations and discount negotiations. Expressed in USD.']
  created_timestamp timestamp [note: 'Timestamp when this drug pricing record was first created in the Silver Layer lakehouse. Used for data lineage, audit trails, and SLA monitoring of pricing file processing.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for all monetary price fields in this record (e.g., USD). Supports multi-currency operations for Puerto Rico and other US territories. Defaults to USD for domestic plans.']
  days_supply varchar [note: 'Number of days of drug supply for which this pricing record applies (e.g., 30-day retail, 90-day mail order). Used to differentiate pricing tiers by supply duration per PBM contract terms.']
  dea_schedule varchar [note: 'DEA controlled substance schedule classification (CI through CV) or NON-CONTROLLED. Used for DUR edits, quantity limit enforcement, prior authorization requirements, and regulatory compliance reporting.']
  dispensing_channel varchar [note: 'Pharmacy dispensing channel for which this pricing record applies: retail (community pharmacy), mail_order (90-day supply mail service), specialty (specialty pharmacy), or long_term_care (LTC facility pharmacy). Pricing may differ by channel per PBM contract terms.']
  dispensing_fee decimal(10,4) [note: 'Fixed dispensing fee in USD paid to the pharmacy per prescription fill, separate from the ingredient cost. Defined in PBM network contracts and applied during claim adjudication to calculate total pharmacy reimbursement.']
  effective_date date [note: 'Date on which this pricing record becomes effective and applicable for claim adjudication. Used to select the correct price for a claim based on the date of service. Aligns with PBM pricing file effective dates.']
  expiration_date date [note: 'Date on which this pricing record expires and is no longer applicable for new claim adjudication. Null indicates an open-ended pricing record with no defined end date. Used with effective_date to determine the active pricing window.']
  formulary_tier varchar [note: 'Formulary tier assignment for this drug under the applicable plan benefit design (e.g., tier_1=preferred generic, tier_2=generic, tier_3=preferred brand, tier_4=non-preferred brand, tier_5=specialty). Drives member cost-sharing (copay/coinsurance) during claim adjudication.']
  mac_list_version varchar [note: 'Version identifier of the MAC list, used to track updates and revisions to the MAC pricing schedule. Supports audit trails for MAC list changes and pharmacy reimbursement disputes. Null when price_type is not MAC.']
  mac_methodology varchar [note: 'Describes the methodology used to derive the MAC price (e.g., MARKET_BASKET=based on market survey of acquisition costs, NADAC_BASED=derived from CMS NADAC data, AWP_DISCOUNT=percentage discount from AWP, WAC_DISCOUNT=percentage discount from WAC, CUSTOM=plan-specific methodology). Required for PBM contract compliance and regulatory transparency. Null when price_type is not MAC.']
  mac_price decimal(18,6) [note: 'Maximum Allowable Cost per unit set by the PBM or health plan for generic and multi-source drugs. Represents the upper reimbursement limit for a drug under the applicable MAC list. Expressed in USD. Null when price_type is not MAC.']
  multi_source_code varchar [note: 'FDA Orange Book multi-source code indicating the competitive market status of the drug: O=Originator brand (no generic), M=Multi-source (generic available), N=Non-multi-source, Y=Generic product. Used to determine MAC eligibility and generic substitution applicability.']
  package_size decimal(10,4) [note: 'Quantity of units contained in the standard package as defined by the NDC. Used to convert between package-level and per-unit pricing and to validate dispensed quantity against package size during adjudication.']
  package_size_uom varchar [note: 'Unit of measure for the package size quantity (e.g., TAB for tablets, ML for milliliters). Distinct from unit_of_measure which applies to the pricing unit; this field describes the package-level quantity unit. [ENUM-REF-CANDIDATE: EA|ML|GM|MG|UN|TAB|CAP|VIAL|PATCH — promote to reference product]']
  price_change_pct decimal(10,4) [note: 'Percentage change in unit price from the prior pricing record to the current record, calculated as ((unit_price - prior_unit_price) / prior_unit_price) * 100. Used for drug price inflation monitoring, CMS price increase reporting, and PBM contract compliance.']
  price_type varchar [note: 'Classifies the pricing methodology represented by this record: AWP (Average Wholesale Price), WAC (Wholesale Acquisition Cost), MAC (Maximum Allowable Cost), RBP (Reference Based Pricing), NADAC (National Average Drug Acquisition Cost), or Usual and Customary. Determines how the price is applied during claim adjudication and reimbursement calculation. [ENUM-REF-CANDIDATE: AWP|WAC|MAC|RBP|NADAC|USUAL_AND_CUSTOMARY — promote to reference product]']
  pricing_file_date date [note: 'Publication or release date of the source pricing file from which this record was extracted. Used to track pricing file currency, identify stale pricing data, and support audit and reconciliation processes.']
  pricing_file_name varchar [note: 'Name of the source pricing file from which this record was loaded (e.g., \'FDB_PRICE_20240101.txt\', \'RXCLAIM_MAC_Q1_2024.csv\'). Used for data lineage, audit trails, and troubleshooting pricing discrepancies.']
  pricing_source varchar [note: 'Identifies the originating source of the pricing data (e.g., First Databank, Medi-Span, RxClaim PBM feed, Argus PBM feed, CMS published rates, internal custom pricing). Critical for audit trails and PBM contract compliance. [ENUM-REF-CANDIDATE: FDB|MEDISPAN|RXCLAIM|ARGUS|CMS|INTERNAL|CUSTOM — promote to reference product]']
  pricing_status varchar [note: 'Current lifecycle status of the pricing record: active (currently in use for adjudication), inactive (no longer applicable), pending (approved but not yet effective), superseded (replaced by a newer pricing record for the same NDC and price type).']
  prior_unit_price decimal(18,6) [note: 'Previous per-unit price for this NDC and price type before the most recent pricing update. Used for price change analysis, trend reporting, and PBM contract compliance audits.']
  rbp_price decimal(18,6) [note: 'Reference Based Pricing per unit used as the benchmark reimbursement amount under RBP pharmacy contracts. Expressed in USD. Null when price_type is not RBP.']
  unit_of_measure varchar [note: 'Dispensing unit of measure for which the price applies (e.g., EA=Each, ML=Milliliter, GM=Gram, MG=Milligram, UN=Unit, TAB=Tablet, CAP=Capsule, VIAL=Vial, PATCH=Patch). Required for accurate per-unit cost calculation during adjudication. [ENUM-REF-CANDIDATE: EA|ML|GM|MG|UN|TAB|CAP|VIAL|PATCH — promote to reference product]']
  unit_price decimal(18,6) [note: 'Per-unit drug price expressed in USD for the applicable price type (AWP, WAC, MAC, or RBP). Used as the basis for claim adjudication, cost-sharing calculation, and pharmacy reimbursement. Precision to 6 decimal places to accommodate high-precision specialty drug pricing.']
  updated_timestamp timestamp [note: 'Timestamp when this drug pricing record was last modified in the Silver Layer lakehouse. Used for change data capture (CDC), incremental processing, and audit trail maintenance.']
  wac_price decimal(18,6) [note: 'Wholesale Acquisition Cost per unit as reported by the manufacturer to the pricing compendia. Represents the list price from manufacturer to wholesaler before discounts. Expressed in USD. Used in WAC-based reimbursement contracts.']

  Note: 'NDC-level drug pricing record capturing AWP (Average Wholesale Price), WAC (Wholesale Acquisition Cost), MAC (Maximum Allowable Cost), and RBP (Reference Based Pricing) values sourced from PBM pricing files. Includes effective date, pricing source, unit of measure, package size, price type, MAC list name, and MAC list methodology reference. Used for claim adjudication, cost-sharing calculation, and pharmacy reimbursement. MAC list grouping attributes are included directly on pricing records for governance and PBM contract compliance. Sourced from RxClaim or Argus PBM pricing feeds and First Databank/Medi-Span pricing updates.'
}

Table pharmacy.pharmacy_claim {
  pharmacy_claim_id varchar [pk, note: 'Unique surrogate identifier for each pharmacy claim record in the Silver layer lakehouse. Primary key for the pharmacy_claim data product. Role: TRANSACTION_HEADER.']
  account_id varchar [note: 'Foreign key linking to billing.account. Business justification: Pharmacy claim costs are financially settled against a billing account (employer group or individual member account). Linking pharmacy claims to billing accounts enables pharmacy cost allocation repor']
  claim_pharmacy_enrollment_transaction_id varchar [note: 'Foreign key linking to enrollment.enrollment_transaction. Business justification: Provides audit link between each pharmacy claim and the enrollment transaction that established coverage, needed for reconciliation and regulatory audit.']
  condition_registry_id varchar [note: 'Foreign key linking to care.condition_registry. Business justification: Linking pharmacy claims to a member\'s condition registry entry enables disease-specific drug utilization analysis (e.g., diabetes medication adherence PDC calculation), risk adjustment validation, and']
  dispensing_pharmacy_id varchar [note: 'Surrogate reference to the pharmacy that dispensed the drug. Links to the provider/pharmacy master record. Distinguishes retail, mail-order, and specialty pharmacy channels. Used for network adequacy reporting and pharmacy audit trail requirements.']
  drug_master_id varchar [note: 'Surrogate reference to the NDC-level drug master record in the pharmacy domain. Links to the formulary drug master product which carries NDC, drug name, tier, and pricing (AWP/WAC/MAC). Central to formulary compliance and drug utilization review (DUR).']
  formulary_drug_tier_id varchar [note: 'Foreign key linking to pharmacy.formulary_drug_tier. Business justification: A pharmacy claim is adjudicated against a specific formulary drug tier assignment that determines cost-sharing (copay, coinsurance, PA requirements). Adding formulary_drug_tier_id links the claim to t']
  formulary_id varchar [note: 'Foreign key linking to pharmacy.formulary. Business justification: A pharmacy claim is adjudicated under a specific formulary that governs drug coverage, tier assignments, and cost-sharing rules. Adding formulary_id to pharmacy_claim links the claim to the formulary ']
  gap_id varchar [note: 'Foreign key linking to care.gap. Business justification: Pharmacy claims are a primary source for closing care gaps (e.g., statin fill closes cardiovascular gap, antidepressant fill closes HEDIS medication management gap). Direct FK enables automated gap cl']
  group_id varchar [note: 'Foreign key linking to employer.group. Business justification: Required for Claim Processing Audit Report to track which employee adjudicated each pharmacy claim.']
  header_id varchar [note: 'Foreign key linking to claim.header. Business justification: Required for integrated care reporting: links pharmacy claims to the corresponding medical claim header for episode‑of‑care analysis and coordinated benefits calculations.']
  health_plan_id varchar [note: 'Surrogate reference to the health plan or benefit plan under which this pharmacy claim was adjudicated. Links to the plan and benefit product. Determines formulary, cost-sharing rules, and CMS Part D contract identification.']
  member_identity_id varchar [note: 'Surrogate reference to the health plan member who is the beneficiary of this pharmacy claim. Links to the member master record in the Core Administration Platform (Facets/QNXT). Required for eligibility verification, coordination of benefits (COB), and CMS Part D risk adjustment (RAF/HCC).']
  member_risk_score_id varchar [note: 'Foreign key linking to risk.member_risk_score. Business justification: Risk‑adjusted claim adjudication report requires each claim to reference the member\'s risk score to apply CMS risk adjustment factors.']
  party_id varchar [note: 'Foreign key linking to contract.party. Business justification: Required for the \'Pharmacy Claim Appeal\' process where each claim can generate an appeal case; enables claim‑level appeal reporting and tracking.']
  pbm_contract_id varchar [note: 'Foreign key linking to pharmacy.pbm_contract. Business justification: Pharmacy claims are processed and adjudicated under specific PBM contract terms (AWP discount rates, dispensing fees, MAC pricing methodology, rebate pass-through). Adding pbm_contract_id to pharmacy_']
  plan_id varchar [note: 'Foreign key linking to care.care_plan. Business justification: Pharmacy claims for care-managed members must be traceable to the active care plan to support medication adherence monitoring, HEDIS medication management measures (e.g., antidepressant adherence, sta']
  prior_authorization_id varchar [note: 'Surrogate reference to the prior authorization record that approved dispensing of this drug, if applicable. Null when no PA was required. Links to the utilization management PA product. Required for specialty drug claims and step therapy override tracking.']
  program_id varchar [note: 'Foreign key linking to care.program. Business justification: Required for claim adjudication to determine member\'s eligibility span at service date, supporting CMS reporting and accurate cost‑share calculations.']
  provider_id varchar [note: 'Surrogate reference to the prescribing provider who authored the prescription. Links to the provider master record in the Provider Management System (Cactus/ProviderSource). Used for prescriber profiling, fraud/waste/abuse (FWA) detection, and HEDIS measure attribution.']
  um_case_id varchar [note: 'Foreign key linking to utilization.um_case. Business justification: Claims are associated with utilization‑management cases for case‑level cost analysis and outcome tracking, required by case management dashboards.']
  adjudication_timestamp timestamp [note: 'Date and time the pharmacy claim was adjudicated (approved or rejected) by the PBM system. Distinct from fill_date (dispensing event). Used for claims processing SLA measurement, 835 remittance matching, and audit trail compliance.']
  basis_of_cost_determination varchar [note: 'Code indicating the pricing benchmark used to determine the ingredient cost for this claim. AWP = Average Wholesale Price; WAC = Wholesale Acquisition Cost; MAC = Maximum Allowable Cost; usual_and_customary = pharmacy\'s standard retail price; negotiated = contracted rate; 340B = 340B program pricing; other = alternative basis. [ENUM-REF-CANDIDATE: awp|wac|mac|usual_and_customary|negotiated|340b|other — 7 candidates stripped; promote to reference product]']
  claim_number varchar [note: 'Externally-known, human-readable claim reference number assigned by the Pharmacy Benefit Management (PBM) system (RxClaim or Argus) at adjudication. Used for member communications, Explanation of Benefits (EOB), and 835 remittance reconciliation. Maps to NCPDP D.0 transaction reference number.']
  claim_status varchar [note: 'Current adjudication lifecycle status of the pharmacy claim as determined by the PBM system. \'paid\' = claim adjudicated and payment issued; \'rejected\' = claim denied with reject code; \'reversed\' = previously paid claim reversed; \'adjusted\' = claim reprocessed with changed amounts; \'pending\' = awaiting adjudication; \'void\' = cancelled before processing.']
  cob_indicator boolean [note: 'Indicates whether coordination of benefits (COB) was applied on this claim (True = COB applied, another payer was involved). Triggers COB segment processing and other_payer_amount population. Used for COB reconciliation and CMS Part D TrOOP calculations.']
  created_timestamp timestamp [note: 'Timestamp when this pharmacy claim record was first created in the Silver layer data product. Supports audit trail, data lineage, and HIPAA record retention requirements. RECORD_AUDIT_CREATED category.']
  daw_code varchar [note: 'NCPDP Dispense As Written (DAW) code indicating whether a brand drug was dispensed when a generic was available, and the reason. 0 = no product selection indicated; 1 = substitution not allowed by prescriber; 2 = substitution allowed, patient requested brand; 3 = substitution allowed, pharmacist selected brand; 4 = substitution allowed, generic not in stock; 5 = substitution allowed, brand dispensed as generic. Used for generic substitution rate analytics and formulary compliance.']
  days_supply varchar [note: 'Number of days of medication supply dispensed on this claim as reported by the dispensing pharmacy. Used for refill-too-soon edits, medication adherence (MPR/PDC) calculations, HEDIS pharmacy measures, and CMS Part D days supply validation.']
  deductible_applied decimal(10,2) [note: 'Dollar amount of this pharmacy claim applied toward the member\'s pharmacy or combined medical/pharmacy deductible. Relevant for HDHP/HSA plans and CMS Part D deductible phase tracking. Contributes to OOP/MOOP accumulation.']
  dispensing_fee decimal(10,2) [note: 'Fee charged by the dispensing pharmacy for the act of dispensing the prescription, separate from ingredient cost. Negotiated as part of the PBM network contract. Used for PBM contract reconciliation and total claim cost analysis.']
  dispensing_pharmacy_npi varchar [note: '10-digit National Provider Identifier (NPI) of the dispensing pharmacy as submitted on the pharmacy claim. Denormalized for claim-level auditability and NCPDP D.0 compliance. Used for pharmacy network validation, audit trail, and CMS Part D encounter data.']
  dur_outcome_code varchar [note: 'NCPDP standard code indicating the outcome of the prospective drug utilization review (DUR) edit performed during adjudication (e.g., drug-drug interaction, duplicate therapy, dose check). Null if no DUR alert was triggered. Critical for pharmacy safety and regulatory compliance. [ENUM-REF-CANDIDATE: promote to reference product — NCPDP DUR outcome codes exceed 6 values]']
  fill_date date [note: 'The date the prescription was dispensed by the pharmacy to the member. This is the principal real-world business event date (BUSINESS_EVENT_TIMESTAMP category). Used for days supply calculations, refill-too-soon edits, and CMS Part D encounter data date of service reporting.']
  ingredient_cost decimal(12,2) [note: 'The cost of the drug ingredient(s) as billed by the dispensing pharmacy, before dispensing fee and other adjustments. Basis may be AWP, WAC, MAC, or negotiated rate. Core component of the MONETARY_TRIPLET for pharmacy claim financials. Used for PBM contract reconciliation and MLR calculation.']
  is_340b_claim boolean [note: 'Indicates whether this pharmacy claim was dispensed under the 340B Drug Pricing Program (True = 340B claim). Used for 340B duplicate discount prevention, HRSA compliance reporting, and separation of 340B and non-340B claims in financial reconciliation.']
  is_compound_claim boolean [note: 'Indicates whether this claim is for a compounded drug product containing multiple ingredients (True = compound claim). Compound claims require line-level detail in the pharmacy_claim_line product. Used for compound drug utilization review and cost management.']
  line_of_business varchar [note: 'Line of business under which this pharmacy claim was adjudicated. Drives regulatory reporting requirements, formulary rules, and cost-sharing structures. \'commercial\' = employer-sponsored or individual; \'medicare_part_d\' = CMS Medicare Part D; \'medicaid\' = state Medicaid; \'exchange\' = ACA marketplace QHP; \'cobra\' = COBRA continuation coverage.']
  member_coinsurance decimal(10,2) [note: 'Percentage-based cost-sharing amount paid by the member for this pharmacy claim, calculated as a percentage of the allowed cost. Applies when the benefit design uses coinsurance rather than fixed copay. Contributes to OOP/MOOP accumulation.']
  member_copay decimal(10,2) [note: 'Fixed dollar amount paid by the member at point of sale as their cost-sharing obligation for this pharmacy claim. Determined by formulary tier and benefit design. Contributes to member out-of-pocket (OOP) and maximum out-of-pocket (MOOP) accumulation.']
  ndc varchar [note: '11-digit National Drug Code identifying the specific drug product dispensed, including labeler, product, and package segment. Denormalized from the drug master for claim-level auditability and CMS Part D encounter data submission (EDPS). Required for 340B duplicate discount prevention and drug utilization review (DUR).']
  original_claim_number varchar [note: 'Claim number of the original pharmacy claim that this record adjusts or reverses. Populated only for adjusted or reversed claims; null for original claims. Enables claim adjustment chain tracing for financial reconciliation, audit, and CMS Part D encounter data correction submissions.']
  pharmacy_channel varchar [note: 'Channel through which the drug was dispensed. Drives cost-sharing differentials, formulary tier rules, and network adequacy reporting. \'retail\' = community pharmacy; \'mail_order\' = 90-day mail service; \'specialty\' = specialty pharmacy for high-cost/complex drugs; \'long_term_care\' = SNF/LTC pharmacy; \'home_infusion\' = infusion therapy at home.']
  plan_paid_amount decimal(12,2) [note: 'Total amount paid by the health plan for this pharmacy claim after applying member cost-sharing (copay, coinsurance, deductible) and COB adjustments. Net total component of the MONETARY_TRIPLET. Used for 835 remittance, MLR reporting, and CMS Part D encounter data.']
  prescriber_npi varchar [note: '10-digit National Provider Identifier (NPI) of the prescribing provider as submitted on the pharmacy claim. Denormalized for claim-level auditability, NCPDP D.0 compliance, and CMS Part D encounter data submission. Used for prescriber fraud/waste/abuse (FWA) analytics.']
  prescription_written_date date [note: 'Date the prescription was written by the prescriber. Used to validate prescription age, enforce days-supply-from-written-date rules, and support medication adherence analytics. Distinct from fill_date (dispensing date).']
  quantity_dispensed decimal(12,3) [note: 'Actual quantity of the drug dispensed (e.g., number of tablets, milliliters, grams) as reported by the dispensing pharmacy. Used for quantity limit (QL) edits, drug utilization review (DUR), and CMS Part D encounter data submission.']
  quantity_unit_of_measure varchar [note: 'NCPDP standard unit of measure code for the quantity dispensed. EA = each (tablets/capsules); ML = milliliters; GM = grams; UN = units; F2 = international units; ME = milliequivalents. Required for accurate quantity limit (QL) edit enforcement and CMS Part D encounter data.']
  refill_number varchar [note: 'Refill sequence number for this dispensing event. Zero (0) indicates the original fill; subsequent values indicate refill number. Used for refill-too-soon edits, medication adherence tracking, and prescription lifecycle management.']
  reject_code varchar [note: 'NCPDP standard reject code returned by the PBM system when a claim is rejected or denied. Null for paid claims. Used for pharmacy operations, member appeals, and drug utilization review (DUR) outcome tracking. [ENUM-REF-CANDIDATE: promote to reference product — NCPDP reject codes exceed 6 values]']
  sales_tax decimal(10,2) [note: 'Sales tax amount applied to the pharmacy claim where applicable by state law. Included in total claim cost and reported separately for financial reconciliation and statutory accounting (SAP) purposes.']
  step_therapy_override boolean [note: 'Indicates whether a step therapy protocol was overridden for this claim (True = override applied). Step therapy requires trying lower-cost drugs before approving higher-cost alternatives. Override requires prior authorization. Used for utilization management (UM) reporting and CMS step therapy compliance.']
  updated_timestamp timestamp [note: 'Timestamp when this pharmacy claim record was last modified in the Silver layer, such as after a claim adjustment, reversal, or COB update. Supports change data capture (CDC) and audit trail requirements. RECORD_AUDIT_UPDATED category.']

  Note: 'Core transactional record for each pharmacy claim submitted and adjudicated through the PBM system (RxClaim or Argus). Header captures: claim number, member ID, prescriber NPI, dispensing pharmacy NPI, NDC, days supply, quantity dispensed, fill date, adjudication date, claim status, reject codes, ingredient cost, dispensing fee, copay, coinsurance, deductible applied, plan paid amount, and coordination of benefits (COB) details. Line-level detail supports multi-ingredient compound claims and COB line splits: line sequence, per-ingredient NDC, ingredient cost, dispensing fee, sales tax, incentive amount, other payer amount, patient pay amount, and basis of cost determination. Supports NCPDP D.0 transaction standards, 835 remittance, CMS Part D encounter data submissions (EDPS/RAPS), 340B claim identification for duplicate discount prevention, and pharmacy audit trail requirements. This is the SSOT for all pharmacy claim header and line-level transactional data within the pharmacy domain.'
}

Table pharmacy.claim_line {
  claim_line_id varchar [pk, note: 'Primary key for claim_line']
  claim_id varchar [note: 'Reference to the parent pharmacy claim header to which this line belongs. Establishes the header/detail relationship for multi-line and compound drug claims.']
  contract_provider_contract_id varchar [note: 'Foreign key linking to contract.provider_contract. Business justification: Line‑level pricing and cost allocation depend on the specific PBM contract; the FK supports detailed cost breakdowns for audits and CMS reporting.']
  drug_master_id varchar [note: 'Reference to the drug master record for the dispensed drug on this claim line, enabling linkage to formulary, tier, and pricing data.']
  formulary_drug_tier_id varchar [note: 'Foreign key linking to pharmacy.formulary_drug_tier. Business justification: claim_line is the detailed line-level record for pharmacy claims (especially compound claims). It carries a formulary_tier STRING that should be normalized to a FK reference to formulary_drug_tier. Th']
  formulary_id varchar [note: 'Reference to the formulary under which this drug was adjudicated, determining tier assignment, coverage rules, and cost-sharing obligations.']
  prior_authorization_id varchar [note: 'Reference to the prior authorization record approved for this drug line, required for specialty and non-formulary drugs. Null if no PA was required.']
  adjudication_timestamp timestamp [note: 'Date and time when this pharmacy claim line was adjudicated by the PBM system (RxClaim or Argus). Represents the business event timestamp for the adjudication transaction. Used for audit trails and processing SLA measurement.']
  basis_of_cost_determination varchar [note: 'Code indicating the pricing benchmark used to determine the ingredient cost for this claim line. Values include Average Wholesale Price (AWP), Wholesale Acquisition Cost (WAC), Maximum Allowable Cost (MAC), Federal Upper Limit (FUL), NADAC, negotiated rate, usual and customary, or other. Critical for PBM audit and CMS Part D compliance. [ENUM-REF-CANDIDATE: AWP|WAC|MAC|FUL|NADAC|negotiated|usual_and_customary|other — promote to reference product]']
  catastrophic_coverage_indicator boolean [note: 'Indicates whether this claim line was adjudicated under the catastrophic coverage phase of the Part D benefit, where the plan pays a higher percentage of drug costs after the member\'s True Out-of-Pocket (TrOOP) threshold is met.']
  cob_sequence varchar [note: 'Indicates the payer sequence in a Coordination of Benefits (COB) scenario. 1=primary payer, 2=secondary payer, 3=tertiary payer. Used to correctly apply COB rules and calculate each payer\'s liability on this claim line.']
  compound_indicator boolean [note: 'Indicates whether this claim line is part of a compounded drug prescription. When true, multiple ingredient lines will exist under the same claim header, each with its own NDC and ingredient cost.']
  coverage_gap_indicator boolean [note: 'Indicates whether this claim line was adjudicated during the Part D coverage gap (donut hole) phase. Used for manufacturer discount program tracking and CMS Part D benefit phase reporting.']
  days_supply varchar [note: 'Number of days of medication supply dispensed on this claim line as reported by the dispensing pharmacy. Used for refill-too-soon edits, adherence calculations, and HEDIS medication adherence measures.']
  dispense_as_written_code varchar [note: 'NCPDP Dispense As Written (DAW) code indicating whether the prescriber or member requested brand-name dispensing when a generic was available. DAW 0=no product selection indicated, DAW 1=substitution not allowed by prescriber, DAW 2=substitution allowed-patient requested brand. Impacts cost-sharing and GDR calculations.']
  dispensed_date date [note: 'Date the drug was dispensed to the member at the pharmacy. Represents the real-world service event date used for benefit period calculations, days supply tracking, and CMS Part D reporting.']
  dispensing_fee_amount decimal(10,2) [note: 'The fee charged by the dispensing pharmacy for the professional service of dispensing the medication. Negotiated as part of PBM network contracts and reported separately from ingredient cost per CMS Part D requirements.']
  drug_coverage_status varchar [note: 'Coverage determination status for this drug on the applicable formulary at time of adjudication. Indicates whether the drug is covered, non-covered, excluded, subject to step therapy, or requires prior authorization (PA).']
  dur_conflict_code varchar [note: 'NCPDP DUR conflict code identifying the type of drug utilization issue detected during adjudication (e.g., drug-drug interaction, drug-disease contraindication, duplicate therapy, high dose). Supports clinical safety monitoring and regulatory DUR reporting. [ENUM-REF-CANDIDATE: promote to reference product for full NCPDP DUR conflict code set]']
  dur_outcome_code varchar [note: 'NCPDP Drug Utilization Review (DUR) outcome code recorded during adjudication, indicating the pharmacist\'s action taken in response to a DUR alert (e.g., filled as is, filled with prescriber approval, not filled). Supports clinical safety audit trails. [ENUM-REF-CANDIDATE: promote to reference product for full NCPDP DUR outcome code set]']
  fill_number varchar [note: 'Sequential fill number for this prescription across all fills, including original and all refills. Distinct from refill_number in that it counts total fills rather than refill sequence. Used for prescription lifecycle tracking.']
  generic_indicator boolean [note: 'Indicates whether the dispensed drug is a generic equivalent. Used for generic dispensing rate (GDR) reporting, formulary compliance analytics, and PBM performance measurement.']
  gross_drug_cost_amount decimal(12,2) [note: 'Total gross cost of the drug on this claim line, calculated as ingredient cost plus dispensing fee plus sales tax plus incentive amount. Used as the basis for CMS Part D gross drug cost reporting and risk corridor calculations.']
  incentive_amount decimal(10,2) [note: 'Incentive or bonus amount paid to the pharmacy for performance-based or preferred network participation on this claim line. Included in gross drug cost calculations for CMS Part D reporting.']
  ingredient_cost_amount decimal(12,2) [note: 'The drug ingredient cost component of the claim line, representing the cost of the drug itself exclusive of dispensing fee, sales tax, and other charges. Key input for MAC/AWP/WAC-based reimbursement calculations and compound drug cost analysis.']
  line_sequence_number varchar [note: 'Sequential number identifying the position of this line within the parent pharmacy claim. Used to order compound ingredient lines and COB line splits. Starts at 1.']
  line_status varchar [note: 'Current adjudication status of this pharmacy claim line. Drives payment processing, COB resolution, and audit reporting. [ENUM-REF-CANDIDATE: paid|denied|reversed|adjusted|pending|void — promote to reference product if additional statuses are needed]']
  line_type varchar [note: 'Classifies the nature of this claim line: standard single-drug fill, compound ingredient line, COB line split, reversal, or adjustment. Drives compound cost analysis and COB workflows.']
  low_income_subsidy_indicator boolean [note: 'Indicates whether the member received a Low Income Subsidy (LIS) benefit on this claim line, resulting in reduced cost-sharing. Required for CMS Part D PDE reporting and LIS reconciliation.']
  manufacturer_discount_amount decimal(10,2) [note: 'Amount of manufacturer discount applied to this claim line under the CMS Part D Coverage Gap Discount Program. Counts toward the member\'s TrOOP and is reported on the PDE record.']
  ndc_code varchar [note: '11-digit National Drug Code identifying the specific drug product, strength, and package size dispensed on this claim line. Sourced from FDA NDC Directory. PHI when linked to a member.']
  patient_pay_amount decimal(10,2) [note: 'Total amount paid by the member/patient at point of sale, including copay, coinsurance, and deductible contributions. Used for Out-of-Pocket (OOP) accumulator tracking and Maximum Out-of-Pocket (MOOP) calculations.']
  pde_submission_date date [note: 'Date this claim line was submitted to CMS as a Prescription Drug Event (PDE) record for Part D reconciliation and risk adjustment. Null for non-Part D claims. Critical for CMS compliance and audit.']
  pharmacy_channel varchar [note: 'Distribution channel through which the drug was dispensed: retail pharmacy, mail-order pharmacy, specialty pharmacy, long-term care (LTC) pharmacy, or home infusion. Drives network contract application, reimbursement rates, and utilization analytics.']
  plan_paid_amount decimal(10,2) [note: 'Net amount paid by the health plan on this claim line after applying member cost-sharing, COB adjustments, and other payer amounts. Core financial metric for MLR and PMPM reporting.']
  quantity_dispensed decimal(12,3) [note: 'Actual quantity of the drug dispensed (e.g., number of tablets, milliliters, grams) as reported by the pharmacy. Used for quantity limit edits, compound ingredient cost allocation, and drug utilization review (DUR).']
  quantity_limit_indicator boolean [note: 'Indicates whether a quantity limit restriction was applied to this drug claim line during adjudication. When true, the dispensed quantity was subject to plan-defined quantity limit rules.']
  refill_number varchar [note: 'Refill sequence number for this prescription fill. Zero indicates the original fill; subsequent values indicate refill number. Used for refill-too-soon edits, adherence monitoring, and quantity limit enforcement.']
  reversal_timestamp timestamp [note: 'Date and time when this pharmacy claim line was reversed, if applicable. Null for non-reversed lines. Used for financial reconciliation, audit trails, and identifying reversed claims in PMPM and MLR calculations.']
  sales_tax_amount decimal(10,2) [note: 'State or local sales tax applied to this pharmacy claim line where applicable. Reported separately per CMS Part D PDE requirements. Zero or null in states with no drug sales tax.']
  source_system_claim_line_key varchar [note: 'Natural key or transaction identifier for this claim line as assigned by the originating PBM system (RxClaim or Argus). Used for lineage tracing, reconciliation with source system, and EDI transaction matching.']
  specialty_drug_indicator boolean [note: 'Indicates whether the drug dispensed on this line is classified as a specialty drug, typically requiring special handling, storage, or administration and subject to specialty pharmacy channel requirements and PA rules.']
  step_therapy_indicator boolean [note: 'Indicates whether this drug claim line was subject to a step therapy protocol requiring the member to try a preferred or lower-cost drug before coverage of this drug was approved.']
  true_oop_amount decimal(10,2) [note: 'Member\'s True Out-of-Pocket (TrOOP) cost contribution from this claim line, used to track progress toward the Part D catastrophic coverage threshold. Includes patient pay and applicable manufacturer discounts.']

  Note: 'Line-level detail for pharmacy claims supporting multi-ingredient compound claims and coordination of benefits (COB) line splits. Captures line sequence, NDC, ingredient cost, dispensing fee, sales tax, incentive amount, other payer amount, patient pay amount, and basis of cost determination. Enables granular adjudication audit trails and compound drug cost analysis.'
}

Table pharmacy.prior_authorization {
  prior_authorization_id varchar [pk, note: 'Primary key for prior_authorization']
  clinical_criteria_id varchar [note: 'Foreign key linking to utilization.clinical_criteria. Business justification: Pharmacy PA decisions are evaluated against specific clinical criteria sets (e.g., MCG drug criteria, InterQual). Regulatory audits and URAC accreditation require documenting which clinical criteria v']
  condition_registry_id varchar [note: 'Foreign key linking to care.condition_registry. Business justification: PA requests are clinically grounded in a member\'s registered chronic condition (e.g., oncology drug PA tied to cancer in condition registry). Proper FK replaces denormalized icd_diagnosis_code, enable']
  drug_master_id varchar [note: 'Foreign key linking to pharmacy.drug_master. Business justification: A prior authorization is issued for a specific drug identified by NDC. The drug_ndc STRING on prior_authorization should be normalized to a FK referencing the authoritative drug_master record. This en']
  formulary_id varchar [note: 'Identifier of the formulary associated with the member\'s plan at the time of the prior authorization request. Determines drug tier, coverage rules, and applicable PA criteria.']
  member_risk_score_id varchar [note: 'Foreign key linking to risk.member_risk_score. Business justification: Prior‑authorization workflow uses the member\'s risk score to assess clinical necessity and cost containment, mandated by internal utilization management policies.']
  original_pa_prior_authorization_id varchar [note: 'Reference to the original prior authorization record when this record represents a renewal, appeal, or modification. Enables tracking of the full PA lifecycle chain. Null for initial requests.']
  pa_request_id varchar [note: 'Foreign key linking to utilization.pa_request. Business justification: Required for PA audit report linking each prior authorization record to its originating request, enabling traceability of request‑to‑authorization lifecycle.']
  prescriber_provider_id varchar [note: 'Foreign key linking to provider.provider. Business justification: PA requests are submitted by prescribing providers. Linking PA to provider.provider enables credentialing/network status validation at PA adjudication, prescriber-level PA reporting, and regulatory co']
  appeal_indicator boolean [note: 'Indicates whether this prior authorization record is associated with a member or prescriber appeal of a prior denial. True = this PA is an appeal case.']
  approved_days_supply varchar [note: 'Number of days of drug therapy authorized under this prior authorization. Used by the PBM to enforce dispensing limits and by CMS Part D for compliance reporting.']
  approved_quantity decimal(10,3) [note: 'Total quantity of the drug authorized for dispensing under this prior authorization (e.g., number of tablets, milliliters, units). Enforced at point-of-sale by the PBM adjudication system.']
  approved_refills varchar [note: 'Number of refills authorized under this prior authorization in addition to the initial fill. Enforced by the PBM adjudication system at point-of-sale.']
  clinical_criteria_version varchar [note: 'Version of the clinical criteria set (InterQual or MCG) applied at the time of the prior authorization decision. Required for audit trails and appeals to ensure the correct criteria version is referenced.']
  cms_part_d_reportable boolean [note: 'Indicates whether this prior authorization record is subject to CMS Part D PA reporting requirements. True = must be included in CMS Part D PA reporting submissions.']
  created_timestamp timestamp [note: 'Timestamp when this prior authorization record was first created in the Silver Layer data platform. Used for data lineage, audit trail, and Silver Layer processing compliance.']
  criteria_met boolean [note: 'Indicates whether the submitted clinical information met the applicable clinical criteria (InterQual/MCG) for the requested drug. True = criteria met (supports approval); False = criteria not met (supports denial).']
  decision_timestamp timestamp [note: 'Exact date and time the prior authorization decision (approval, denial, or pend) was rendered by the clinical reviewer or automated adjudication engine. Used to calculate turnaround time against CMS and URAC standards.']
  denial_reason_code varchar [note: 'Standardized code indicating the reason for denial of the prior authorization request (e.g., not medically necessary, step therapy not completed, quantity limit exceeded, non-covered drug). Populated only when pa_status = denied. Used for member appeals and CMS Part D reporting.']
  denial_reason_description varchar [note: 'Free-text description of the denial reason, providing clinical or administrative context beyond the denial reason code. Included in member and prescriber denial notices per CMS and state DOI requirements.']
  dispensing_channel varchar [note: 'Pharmacy dispensing channel authorized for this prior authorization (retail, mail-order, specialty pharmacy, long-term care, or home infusion). Determines which pharmacy network is eligible to dispense.']
  drug_tier varchar [note: 'Formulary tier of the requested drug at the time of the prior authorization request. Determines cost-sharing obligations and PA criteria applied.']
  dur_outcome_code varchar [note: 'NCPDP-standardized Drug Utilization Review (DUR) outcome code resulting from prospective DUR screening performed during PA adjudication (e.g., drug-drug interaction, drug-disease contraindication, duplicate therapy). Sourced from PBM system (RxClaim/Argus).']
  effective_end_date date [note: 'Date on which the prior authorization expires and is no longer valid for dispensing. After this date, a new PA request is required. Nullable for open-ended authorizations.']
  effective_start_date date [note: 'Date from which the approved prior authorization is valid for dispensing. Pharmacies and PBM adjudication systems use this date to confirm dispensing eligibility.']
  lob varchar [note: 'Line of Business (LOB) under which the member\'s coverage falls, determining applicable regulatory requirements, formulary rules, and PA criteria (e.g., Commercial, Medicare Part D, Medicaid, ACA Marketplace).']
  notes varchar [note: 'Free-text clinical notes entered by the reviewing clinician during the prior authorization evaluation, capturing clinical rationale, additional context, or instructions for the prescriber or pharmacy. Contains Protected Health Information (PHI).']
  pa_reference_number varchar [note: 'Externally-known, human-readable prior authorization reference number assigned by the Pharmacy Benefit Management (PBM) system (RxClaim or Argus) or Utilization Management (UM) system (InterQual/MCG). Used on Explanation of Benefits (EOB) and communicated to prescribers and pharmacies.']
  pa_status varchar [note: 'Current lifecycle status of the prior authorization request. Drives dispensing eligibility at the pharmacy and CMS Part D PA reporting. [ENUM-REF-CANDIDATE: approved|denied|pending|cancelled|expired|appealed — promote to reference product if additional statuses are needed]']
  pa_type varchar [note: 'Category of prior authorization criteria applied, indicating the clinical or formulary reason the drug requires PA review (e.g., specialty drug, non-preferred tier, step therapy requirement, quantity limit, age restriction, off-label use). [ENUM-REF-CANDIDATE: specialty|non_preferred|step_therapy|quantity_limit|age_restriction|off_label — promote to reference product]']
  quantity_limit_applied boolean [note: 'Indicates whether a quantity limit restriction was a factor in the prior authorization evaluation. True = quantity limit rules were applied during adjudication.']
  received_timestamp timestamp [note: 'Exact date and time the prior authorization request was received by the Utilization Management (UM) system (InterQual/MCG) or PBM system (RxClaim/Argus). Used for precise turnaround time calculation and regulatory compliance.']
  request_date date [note: 'Calendar date on which the prior authorization request was submitted by the prescriber or pharmacy. Used for turnaround time measurement and CMS Part D compliance reporting.']
  request_type varchar [note: 'Classification of the prior authorization request indicating whether it is a new request, renewal of an existing authorization, appeal of a denial, expedited urgent request, or retrospective review.']
  review_level varchar [note: 'Level of clinical review applied to the prior authorization request, indicating whether it was reviewed by a pharmacist, physician, peer-to-peer consultation, or medical director. Escalation level affects turnaround time standards.']
  source_system_pa_code varchar [note: 'Native prior authorization identifier from the originating operational system (RxClaim, Argus, InterQual, or MCG). Preserved for reconciliation, audit, and cross-system traceability in the Silver Layer.']
  specialty_drug_flag boolean [note: 'Indicates whether the requested drug is classified as a specialty drug requiring specialty pharmacy dispensing and enhanced clinical review. Specialty drugs typically have higher cost-sharing and stricter PA criteria.']
  step_therapy_completed boolean [note: 'Indicates whether the member has documented evidence of completing the required step therapy (tried and failed prerequisite drugs) as required by the formulary PA criteria. Populated when step_therapy_required = True.']
  step_therapy_required boolean [note: 'Indicates whether the prior authorization requires the member to have tried and failed one or more preferred or lower-tier drugs (step therapy) before the requested drug is authorized. True = step therapy applies.']
  updated_timestamp timestamp [note: 'Timestamp when this prior authorization record was last modified in the Silver Layer data platform, reflecting status changes, decision updates, or data corrections. Used for change data capture and audit.']

  Note: 'Prior authorization (PA) record for specialty and non-preferred drugs requiring clinical review before dispensing. Captures PA request date, requesting prescriber NPI, member ID, drug NDC, diagnosis codes (ICD), clinical criteria applied (InterQual/MCG), authorization status (approved/denied/pending), approved quantity, approved days supply, effective date range, and denial reason codes. Interfaces with the Utilization Management system and supports CMS Part D PA reporting.'
}

Table pharmacy.dispensing_pharmacy {
  dispensing_pharmacy_id varchar [pk, note: 'Unique surrogate identifier for the dispensing pharmacy record within the PBM network master. Primary key for this entity.']
  account_id varchar [note: 'Foreign key linking to billing.account. Business justification: Network dispensing pharmacies are reimbursed through a billing account for ingredient costs and dispensing fees. Pharmacy network payment operations require a billing account reference to process EFT ']
  contract_provider_contract_id varchar [note: 'Internal pharmacy identifier assigned by the PBM system (RxClaim or Argus) for claim routing and adjudication. May differ from NCPDP ID in multi-PBM environments. Used for system-level reconciliation.']
  facility_id varchar [note: 'Foreign key linking to provider.facility. Business justification: Hospital outpatient pharmacies and specialty pharmacies embedded in facilities must be linked to provider.facility for network credentialing, directory accuracy, and network adequacy reporting. Regula']
  ncpdp_provider_id varchar [note: 'The 7-digit NCPDP pharmacy identifier (formerly NABP number) used as the primary pharmacy identifier in PBM claim transactions, formulary lookups, and pharmacy network directories. Sourced from RxClaim or Argus PBM system.']
  network_service_area_id varchar [note: 'Foreign key linking to network.service_area. Business justification: CMS Part D and state Medicaid regulations require pharmacy network adequacy assessment by service area. Linking dispensing pharmacies to service areas enables geographic access reporting, regulatory f']
  par_agreement_id varchar [note: 'Foreign key linking to network.par_agreement. Business justification: Dispensing pharmacies have formal participation agreements governing network inclusion terms, credentialing, and reimbursement. The PAR agreement is the authoritative record of a pharmacy\'s network pa']
  payment_method_id varchar [note: 'Foreign key linking to billing.payment_method. Business justification: Dispensing pharmacies must have a registered payment method (EFT/ACH bank account) for network reimbursement disbursements. Health insurance pharmacy network operations require payment method registra']
  program_id varchar [note: 'Foreign key linking to care.program. Business justification: Specialty pharmacies are designated as preferred or exclusive dispensers for specific care management programs (e.g., oncology specialty pharmacy, transplant program, hemophilia program). This link en']
  provider_network_id varchar [note: 'Foreign key linking to network.provider_network. Business justification: Required for network participation reporting and CMS network adequacy; each pharmacy must be linked to the provider network it belongs to.']
  tier_id varchar [note: 'Foreign key linking to network.tier. Business justification: Pharmacy network tiering drives member cost-sharing — preferred vs. standard vs. specialty pharmacy tiers determine copay differentials. Benefit design and EOB generation require knowing which network']
  accepts_electronic_prescriptions boolean [note: 'Indicates whether the pharmacy is enabled to receive electronic prescriptions (e-prescribing) via NCPDP SCRIPT standard. Required for controlled substance e-prescribing (EPCS) compliance in many states.']
  address_line1 varchar [note: 'Primary street address of the pharmacy dispensing location. Used for member pharmacy locator, network directory, and regulatory reporting.']
  address_line2 varchar [note: 'Secondary address information (suite, unit, floor) for the pharmacy dispensing location.']
  awp_discount_percent decimal(5,2) [note: 'The contracted discount percentage applied to the AWP for brand drug ingredient cost reimbursement. For example, AWP minus 15% means awp_discount_percent = 15.00. Applies when ingredient_cost_basis is \'awp_discount\'. Commercially sensitive contract term.']
  chain_independent_flag boolean [note: 'Indicates whether the pharmacy is part of a chain organization (e.g., CVS, Walgreens, Rite Aid) or operates as an independent pharmacy. Affects contract terms, reimbursement rates, and network tier assignment.']
  chain_organization_name varchar [note: 'Name of the parent chain organization if the pharmacy is a chain location (e.g., CVS Health, Walgreens Boots Alliance). Null for independent pharmacies. Used for chain-level contract management and performance reporting.']
  city varchar [note: 'City of the pharmacy dispensing location. Used for geographic network analysis, member access reporting, and CMS Part D network adequacy compliance.']
  cold_chain_certified boolean [note: 'Indicates whether the pharmacy holds cold chain certification for temperature-sensitive drug storage and shipping (e.g., biologics, insulin, vaccines). Required for specialty and mail-order pharmacies dispensing refrigerated or frozen medications.']
  contract_effective_date date [note: 'Date on which the pharmacy\'s network participation contract becomes effective. Used to validate claim eligibility by service date and for contract lifecycle management.']
  contract_termination_date date [note: 'Date on which the pharmacy\'s network participation contract ends or was terminated. Null for active open-ended contracts. Used for claim eligibility validation and network adequacy gap analysis.']
  contract_type varchar [note: 'Indicates whether the pharmacy reimbursement contract is negotiated directly with the health plan (direct) or administered through the PBM intermediary (PBM-administered). Affects financial settlement, audit rights, and MAC list applicability.']
  created_timestamp timestamp [note: 'Timestamp when the dispensing pharmacy record was first created in the PBM network master. Supports audit trail, data lineage, and regulatory record retention requirements.']
  dispensing_fee_amount decimal(8,2) [note: 'The contracted per-prescription dispensing fee paid to the pharmacy in addition to ingredient cost reimbursement. Expressed in USD. May vary by pharmacy type, drug type, or days supply. Commercially sensitive contract term.']
  dispensing_state_code varchar [note: 'Two-letter USPS state code of the state in which the pharmacy is licensed to dispense. May differ from the physical address state for mail-order pharmacies licensed in multiple states. Used for state-level regulatory compliance and claim adjudication.']
  doing_business_as_name varchar [note: 'Trade name or DBA name under which the pharmacy operates if different from the legal business name. Used in member-facing directories and communications.']
  fax_number varchar [note: 'Fax number for the pharmacy dispensing location. Used for prior authorization transmissions, prescription transfers, and clinical communications.']
  ingredient_cost_basis varchar [note: 'The pricing benchmark used to calculate ingredient cost reimbursement for drug claims. AWP (Average Wholesale Price) discount is most common for brand drugs; MAC (Maximum Allowable Cost) applies to generics; WAC (Wholesale Acquisition Cost) and NADAC (National Average Drug Acquisition Cost) are alternative benchmarks. Sourced from PBM contract terms in RxClaim/Argus.']
  line_of_business varchar [note: 'The health insurance line of business for which this pharmacy network participation record applies. A pharmacy may have separate network records per LOB with different contract terms. Drives claim adjudication routing and formulary selection.']
  mail_order_capable boolean [note: 'Indicates whether the pharmacy is certified and operationally capable of fulfilling mail-order prescriptions (90-day supply, home delivery). Drives claim routing and member benefit design enforcement.']
  ncpdp_chain_code varchar [note: 'NCPDP-assigned 4-digit chain code identifying the pharmacy chain organization. Used for chain-level contract application and bulk reimbursement rate assignment in the PBM system.']
  network_effective_date date [note: 'Date on which the pharmacy\'s current network participation status became effective. Distinct from contract_effective_date; captures the most recent network status change date (e.g., reactivation after suspension).']
  network_participation_status varchar [note: 'Current status of the pharmacy\'s participation in the PBM network. Drives real-time claim adjudication eligibility checks in RxClaim/Argus. Active pharmacies are eligible to dispense covered drugs; inactive/terminated pharmacies are rejected at point-of-sale.']
  network_termination_date date [note: 'Date on which the pharmacy\'s network participation was or is scheduled to be terminated. Null for currently active network participants. Used for claim eligibility validation and network adequacy gap analysis.']
  performance_audit_provision boolean [note: 'Indicates whether the pharmacy contract includes audit provisions allowing the PBM or health plan to conduct on-site or desk audits of dispensing records, pricing, and compliance. Required for CMS Part D sponsor oversight obligations.']
  pharmacy_name varchar [note: 'Legal business name of the dispensing pharmacy as registered with the state board of pharmacy and NCPDP. Used in member-facing communications, EOB documents, and provider directory.']
  pharmacy_type varchar [note: 'Classification of the pharmacy by dispensing channel and operational model. Drives claim routing, reimbursement logic, and formulary applicability within the PBM system (RxClaim/Argus). [ENUM-REF-CANDIDATE: retail|mail_order|specialty|long_term_care|compounding — promote to reference product if additional types emerge]']
  phone_number varchar [note: 'Primary telephone number for the pharmacy dispensing location. Used for member contact, prior authorization coordination, and provider directory.']
  signature_required_flag boolean [note: 'Indicates whether the pharmacy requires patient or authorized representative signature upon delivery for mail-order or specialty drug shipments. Relevant for controlled substances and high-value specialty medications.']
  source_system_code varchar [note: 'Identifies the operational source system from which this pharmacy record was ingested (e.g., RxClaim, Argus PBM, Cactus credentialing system). Supports data lineage tracking and reconciliation in the Databricks lakehouse Silver layer.']
  specialty_accreditation_code varchar [note: 'Accreditation body certification held by the pharmacy for specialty drug dispensing. URAC, ACHC, and NABP PCAB are the primary specialty pharmacy accreditation bodies recognized by health plans and PBMs. Required for specialty network participation. [ENUM-REF-CANDIDATE: urac|achc|jcaho|nabp_pcab|none — promote to reference product if multi-accreditation tracking is needed]']
  state_code varchar [note: 'Two-letter USPS state abbreviation for the pharmacy dispensing location. Used for state-level licensure validation, network adequacy reporting, and regulatory compliance.']
  twenty_four_hour_flag boolean [note: 'Indicates whether the pharmacy operates 24 hours per day, 7 days per week. Used for network adequacy reporting and member access analysis, particularly for CMS Part D access requirements.']
  updated_timestamp timestamp [note: 'Timestamp when the dispensing pharmacy record was most recently updated. Used for change data capture, data quality monitoring, and audit trail in the Databricks Silver layer.']
  zip_code varchar [note: 'US ZIP or ZIP+4 postal code for the pharmacy dispensing location. Used for geographic network adequacy analysis, member proximity calculations, and CMS Part D access reporting.']

  Note: 'Master record for retail, mail-order, and specialty pharmacies participating in the PBM network. Captures pharmacy identity: NPI, NCPDP provider ID, pharmacy name, chain/independent flag, pharmacy type (retail/mail/specialty/long-term care/compounding), address, phone, DEA number, state license. Captures network participation and contractual reimbursement terms: network tier (preferred/standard/specialty), network participation status, dispensing fee schedule, ingredient cost reimbursement basis (AWP discount/MAC/WAC), contract type (direct/PBM-administered), contract effective date range, performance requirements, audit provisions, mail-order fulfillment capabilities (cold chain certification, signature requirements), and per-pharmacy or per-chain contract variations. This is the SSOT for pharmacy provider identity, network participation, and all pharmacy-level reimbursement contract terms within the pharmacy domain; detailed credentialing lives in the provider/credential domains.'
}

Table pharmacy.pbm_contract {
  pbm_contract_id varchar [pk, note: 'Unique surrogate identifier for the PBM contract record in the pharmacy domain silver layer. Primary key for this entity. Role: MASTER_AGREEMENT.']
  account_id varchar [note: 'Foreign key linking to billing.account. Business justification: PBM contracts are financially administered through a billing account for rebate settlements, administrative fee payments, and performance guarantee true-ups. Every PBM contract in health insurance ope']
  broker_id varchar [note: 'Foreign key linking to employer.broker. Business justification: Brokers negotiate PBM contracts on behalf of employer groups. Required for commission tracking, contract ownership attribution, and broker performance reporting in group sales operations.']
  formulary_id varchar [note: 'Reference to the drug formulary associated with this PBM contract. The formulary defines covered drugs, tier assignments, and utilization management rules governed by this contract.']
  amendment_date date [note: 'Date of the most recent amendment or addendum executed against this PBM contract. Null if no amendments have been made since original execution. Used to track contract evolution and ensure current terms are applied in adjudication.']
  audit_frequency varchar [note: 'Contractually specified frequency at which the health plan may exercise audit rights over the PBM. Relevant only when audit_rights_flag is True. Drives compliance calendar and vendor oversight scheduling.']
  audit_rights_flag boolean [note: 'Indicates whether the health plan has contractual audit rights to inspect PBM financial records, rebate calculations, MAC list pricing, and claims adjudication data. True = audit rights granted; False = not included. Critical for compliance and financial oversight.']
  auto_renewal_flag boolean [note: 'Indicates whether the PBM contract automatically renews at the end of the contract term unless notice of termination is provided. True = auto-renews; False = requires affirmative renewal action.']
  awp_discount_mail_pct decimal(7,4) [note: 'Contracted discount percentage off AWP (Average Wholesale Price) applied to drug ingredient cost reimbursement at mail-order pharmacies. Typically deeper than retail AWP discounts due to mail-order volume.']
  awp_discount_retail_pct decimal(7,4) [note: 'Contracted discount percentage off AWP (Average Wholesale Price) applied to brand and generic drug ingredient cost reimbursement at retail pharmacies. A core financial term in PBM contracts (e.g., AWP minus 18% for generics).']
  cms_contract_number varchar [note: 'CMS (Centers for Medicare and Medicaid Services) contract number associated with the Medicare Part D plan under which this PBM contract operates (e.g., H1234 for MA-PD, S1234 for PDP). Required for CMS Part D reporting and RAPS/EDPS submissions. Null for non-Medicare LOBs.']
  contract_name varchar [note: 'Descriptive name of the PBM contract (e.g., \'Express Scripts ASO Agreement FY2024\'). Used for display in reporting dashboards and contract management workflows.']
  contract_number varchar [note: 'Externally-known, human-readable contract reference number assigned by the health plan or PBM vendor at execution. Used for correspondence, audits, and regulatory filings. Maps to the contract identifier in RxClaim or Argus PBM system.']
  contract_owner_name varchar [note: 'Name of the health plan employee or department responsible for managing this PBM contract relationship. Used for escalation routing, audit coordination, and vendor governance.']
  contract_status varchar [note: 'Current lifecycle state of the PBM contract. Draft indicates the contract is under negotiation; active indicates it is in force; suspended indicates temporarily halted; terminated indicates early cancellation; expired indicates natural end-of-term; pending_renewal indicates renewal is in progress.']
  contract_type varchar [note: 'Classification of the PBM contract arrangement. ASO (Administrative Services Only) means the health plan retains financial risk; full_risk means the PBM assumes drug spend risk; carve_out means pharmacy benefits are separated from medical; pass_through means drug costs are passed at actual cost; hybrid combines elements. [ENUM-REF-CANDIDATE: ASO|full_risk|carve_out|pass_through|hybrid — promote to reference product if additional types emerge]']
  contract_version varchar [note: 'Version identifier for the PBM contract document, incremented with each amendment or renewal (e.g., \'1.0\', \'2.1\', \'Amendment_3\'). Supports contract lifecycle management and audit trail for regulatory examinations.']
  dispensing_fee_mail_order decimal(10,4) [note: 'Contracted dispensing fee in USD paid per prescription claim fulfilled through mail-order pharmacy channels under this PBM contract. Typically lower than retail due to volume efficiencies.']
  dispensing_fee_retail decimal(10,4) [note: 'Contracted dispensing fee in USD paid to retail network pharmacies per prescription claim under this PBM contract. Part of the pharmacy reimbursement formula alongside ingredient cost (AWP/WAC/MAC).']
  dispensing_fee_specialty decimal(10,4) [note: 'Contracted dispensing fee in USD paid per specialty drug prescription claim under this PBM contract. Specialty pharmacy dispensing fees are negotiated separately due to the high-cost, high-touch nature of specialty drugs.']
  dur_program_flag boolean [note: 'Indicates whether Drug Utilization Review (DUR) — including prospective, concurrent, and retrospective DUR — is included as a service under this PBM contract. True = DUR services included; False = not included.']
  effective_date date [note: 'Date on which the PBM contract becomes legally binding and operationally active. Governs when PBM services, pricing schedules, and rebate guarantees take effect. Format: yyyy-MM-dd.']
  generic_dispensing_rate_guarantee decimal(7,4) [note: 'Contractually guaranteed minimum generic dispensing rate (GDR) as a percentage of total prescription claims. If the PBM fails to achieve this rate, financial penalties or credits apply. Key cost-management metric in PBM contracts.']
  governing_state_code varchar [note: 'Two-letter US state code of the state whose laws govern this PBM contract for dispute resolution and regulatory compliance purposes. Relevant for state DOI oversight, MAC transparency laws, and PBM regulation.']
  ingredient_cost_basis varchar [note: 'The drug pricing benchmark used as the basis for ingredient cost reimbursement under this contract. AWP (Average Wholesale Price), WAC (Wholesale Acquisition Cost), MAC (Maximum Allowable Cost), NADAC (National Average Drug Acquisition Cost), or AAC (Actual Acquisition Cost). Determines the reimbursement formula for drug ingredient costs.']
  lob_scope varchar [note: 'Line of Business (LOB) covered under this PBM contract. Determines which member populations and benefit programs are governed by this agreement. A single contract may cover one or multiple LOBs. [ENUM-REF-CANDIDATE: commercial|medicare_part_d|medicaid|exchange|all — promote to reference product for multi-LOB support]']
  mac_list_reference varchar [note: 'Identifier or name of the MAC (Maximum Allowable Cost) list applied under this PBM contract for generic and multi-source drug reimbursement. MAC lists cap reimbursement for generics below AWP. References the specific MAC list version maintained by the PBM.']
  mail_order_flag boolean [note: 'Indicates whether mail-order pharmacy dispensing services are included in the scope of this PBM contract. True = mail order included; False = retail-only or carved out.']
  mail_order_penetration_guarantee decimal(7,4) [note: 'Contractually guaranteed minimum mail-order pharmacy utilization rate as a percentage of eligible maintenance drug claims. Drives cost savings through mail-order channel incentives.']
  performance_guarantee_flag boolean [note: 'Indicates whether the PBM contract includes financial performance guarantees (e.g., generic dispensing rate, mail-order penetration, member satisfaction scores). True = performance guarantees included; False = not included.']
  prior_auth_flag boolean [note: 'Indicates whether prior authorization (PA) requirements for specialty and non-formulary drugs are administered by the PBM under this contract. True = PBM manages PA; False = health plan manages PA internally.']
  quantity_limit_flag boolean [note: 'Indicates whether quantity limit (QL) utilization management rules are in scope under this PBM contract. Quantity limits restrict the amount of a drug dispensed per fill or per time period. True = quantity limits apply; False = not applicable.']
  rebate_guarantee_pmpm decimal(18,4) [note: 'Contractually guaranteed minimum rebate amount expressed as Per Member Per Month (PMPM) in USD that the PBM must remit to the health plan. A key financial performance guarantee in PBM contracts. Used for actuarial reserving and financial reconciliation.']
  rebate_pass_through_pct decimal(7,4) [note: 'Percentage of manufacturer drug rebates that the PBM is contractually obligated to pass through to the health plan (e.g., 100% pass-through vs. spread-based retention). Critical for MLR (Medical Loss Ratio) calculations and CMS Part D compliance.']
  rebate_reconciliation_lag_days varchar [note: 'Number of calendar days after the close of a settlement period within which the PBM must provide rebate invoices and supporting data to the health plan. Used for financial close scheduling and IBNR reserve calculations.']
  rebate_settlement_frequency varchar [note: 'Contractually specified frequency at which the PBM remits drug manufacturer rebates to the health plan. Drives cash flow forecasting, accounts receivable management, and actuarial IBNR (Incurred But Not Reported) rebate estimates.']
  record_created_timestamp timestamp [note: 'Timestamp when this PBM contract record was first created in the data platform. Used for audit trail, data lineage, and compliance with HIPAA record retention requirements. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.']
  record_updated_timestamp timestamp [note: 'Timestamp when this PBM contract record was most recently modified in the data platform. Supports change detection, SCD (Slowly Changing Dimension) processing, and audit trail requirements. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.']
  renewal_notice_days varchar [note: 'Number of calendar days prior to contract termination_date by which either party must provide written notice of intent not to renew. Operationally critical for contract management and vendor transitions.']
  source_system_code varchar [note: 'Identifies the operational source system from which this PBM contract record was ingested into the lakehouse silver layer (e.g., RxClaim, Argus, manual entry). Supports data lineage and reconciliation.']
  specialty_pharmacy_flag boolean [note: 'Indicates whether specialty pharmacy benefit management (high-cost biologics, specialty injectables) is within the scope of this PBM contract. True = specialty pharmacy included; False = carved out or not applicable.']
  step_therapy_flag boolean [note: 'Indicates whether step therapy protocols are included in the scope of this PBM contract. Step therapy requires members to try lower-cost drugs before coverage of higher-cost alternatives is authorized. True = step therapy applies; False = not applicable.']
  termination_date date [note: 'Date on which the PBM contract ends or was terminated. Null for open-ended contracts. Distinguishes between scheduled expiration and early termination when combined with contract_status. Format: yyyy-MM-dd.']

  Note: 'Master record for PBM (Pharmacy Benefit Manager) contracts governing the relationship between the health plan and the PBM (e.g., RxClaim, Argus). Captures contract name, PBM vendor, contract type (ASO/full-risk/carve-out), effective date range, rebate guarantee terms, dispensing fee schedules, MAC list reference, performance guarantees, audit rights, and LOB scope. This is the SSOT for PBM contractual terms within the pharmacy domain.'
}

Table pharmacy.formulary_exception {
  formulary_exception_id varchar [pk, note: 'Primary key for formulary_exception']
  condition_registry_id varchar [note: 'Foreign key linking to care.condition_registry. Business justification: Formulary exceptions are clinically justified by a member\'s diagnosed condition in the condition registry. Proper FK replaces denormalized diagnosis_code, enables clinical justification validation aga']
  drug_master_id varchar [note: 'Foreign key linking to pharmacy.drug_master. Business justification: A formulary exception request is for a specific drug (non-formulary or tier override). The drug_ndc and drug_name STRING columns on formulary_exception should be normalized to a FK referencing drug_ma']
  formulary_id varchar [note: 'Identifier of the specific formulary against which the exception is being evaluated. A plan may maintain multiple formularies (e.g., commercial, Medicare Part D, Medicaid). Links to the formulary master in the PBM system (RxClaim/Argus).']
  group_id varchar [note: 'Identifier of the clinical pharmacist, pharmacy technician, or medical director who reviewed and rendered the decision on the formulary exception request. Links to the workforce/staff entity.']
  header_id varchar [note: 'Identifier of the associated appeal record if the member or prescriber has filed an appeal against a denied formulary exception. Links to the appeals management entity. Null if no appeal has been filed.']
  health_plan_id varchar [note: 'Identifier of the health benefit plan under which the formulary exception is being requested. Determines the applicable formulary, tier structure, and exception adjudication rules.']
  medical_policy_id varchar [note: 'Foreign key linking to utilization.medical_policy. Business justification: Formulary exceptions (coverage determinations) are adjudicated against medical policies — the policy defines whether a non-formulary drug qualifies for exception. CMS Part D coverage determination reg']
  member_identity_id varchar [note: 'Identifier of the health plan member on whose behalf the formulary exception request is submitted. Links to the member master record in the core administration platform (Facets/QNXT).']
  member_risk_score_id varchar [note: 'Foreign key linking to risk.member_risk_score. Business justification: Formulary exception decisions for high-cost specialty drugs require member risk score context to justify clinical necessity, predict cost impact, and support tier exception approvals. Risk scores info']
  plan_id varchar [note: 'Foreign key linking to care.care_plan. Business justification: Formulary exceptions are frequently initiated by care managers as part of a member\'s active care plan (e.g., non-formulary specialty drug needed for care plan treatment goal). This link enables care m']
  prescriber_provider_id varchar [note: 'Foreign key linking to provider.provider. Business justification: Formulary exceptions are initiated by prescribing providers. Linking to provider.provider enables network/credentialing validation, prescriber-level exception rate reporting, and CMS coverage determin']
  prior_authorization_id varchar [note: 'Identifier of an associated Prior Authorization (PA) request in the UM system (InterQual/MCG) when the formulary exception is linked to or triggered by a PA requirement. Null if no PA is associated.']
  appeal_rights_notification_date date [note: 'Date on which the appeal rights notification was sent to the member and prescriber following a denial. Required for CMS Part D compliance tracking and audit purposes.']
  appeal_rights_notified boolean [note: 'Indicates whether the required appeal rights notification was sent to the member and prescriber following a denial decision, as mandated by CMS Part D regulations. True = notification sent; False = notification not yet sent.']
  clinical_justification varchar [note: 'Free-text clinical rationale provided by the prescriber or member supporting the formulary exception request. May include diagnosis, treatment history, contraindications to formulary alternatives, or medical necessity documentation. Treated as confidential clinical information.']
  cms_coverage_determination_type varchar [note: 'CMS-defined classification of the coverage determination process type for Part D reporting. Standard: routine 72-hour review; Expedited: 24-hour urgent review; Reopen: plan-initiated reconsideration; Revised: updated determination on a prior decision.']
  created_timestamp timestamp [note: 'Timestamp when the formulary exception record was first created in the data platform. Used for audit trail, data lineage, and Silver layer ingestion tracking.']
  current_drug_tier varchar [note: 'The formulary tier at which the requested drug is currently placed (or non_formulary if not on the formulary) at the time the exception request is submitted. Used to assess the tier differential and cost-sharing impact of the exception. [ENUM-REF-CANDIDATE: tier_1|tier_2|tier_3|tier_4|tier_5|specialty|non_formulary — 7 candidates stripped; promote to reference product]']
  days_supply_requested varchar [note: 'Number of days of drug supply requested in the formulary exception, applicable for quantity limit or day supply override exceptions. Standard values are 30, 60, or 90 days.']
  decision_date date [note: 'Calendar date on which the final determination (approval or denial) was made on the formulary exception request. Used to calculate turnaround time and assess CMS timeliness compliance.']
  decision_timestamp timestamp [note: 'Precise date and time the exception determination was rendered. Enables exact measurement of response time against CMS 72-hour standard and 24-hour expedited decision deadlines.']
  denial_reason_code varchar [note: 'Standardized code indicating the reason for denial of the formulary exception request (e.g., formulary alternative available, insufficient clinical documentation, drug not medically necessary). Null for approved or pending requests. Used in EOB and appeal rights notifications.']
  denial_reason_description varchar [note: 'Human-readable explanation of the reason for denial of the formulary exception request. Included in the written notice of denial sent to the member and prescriber as required by CMS Part D regulations.']
  effective_end_date date [note: 'Date through which an approved formulary exception remains valid. After this date, the member must reapply or the standard formulary restriction resumes. Null for open-ended approvals or non-approved requests.']
  effective_start_date date [note: 'Date from which an approved formulary exception is valid and the member may obtain the drug at the excepted tier or without the formulary restriction. Null for denied or pending requests.']
  exception_request_number varchar [note: 'Externally-visible, human-readable unique reference number assigned to the formulary exception request at intake. Used by members, prescribers, and pharmacies to track the status of the request. Generated by the PBM system (RxClaim/Argus) or UM system.']
  exception_status varchar [note: 'Current lifecycle status of the formulary exception request. Pending: under review; Approved: exception granted; Denied: exception not granted; Withdrawn: requestor cancelled; Expired: approved exception past effective period; Appealed: denial under appeal review.']
  exception_type varchar [note: 'Classification of the formulary exception request indicating the specific restriction being challenged. Values: non_formulary (drug not on formulary), tier_exception (request lower cost-sharing tier), pa_exception (override Prior Authorization requirement), step_therapy_exception (bypass step therapy protocol), quantity_limit_exception (override quantity/day supply limit), coverage_determination (standard CMS Part D coverage determination). [ENUM-REF-CANDIDATE: non_formulary|tier_exception|pa_exception|step_therapy_exception|quantity_limit_exception|coverage_determination — promote to reference product]']
  formulary_alternative_ndc varchar [note: '11-digit NDC of the formulary-covered alternative drug suggested by the plan when denying a non-formulary or tier exception request. Required by CMS to be communicated to the member and prescriber in the denial notice.']
  is_expedited boolean [note: 'Indicates whether the formulary exception request was submitted and processed under the expedited (24-hour) review pathway, as opposed to the standard (72-hour) pathway. Expedited requests require prescriber attestation that the standard timeframe would seriously jeopardize the member\'s life, health, or ability to regain maximum function.']
  line_of_business varchar [note: 'Line of Business (LOB) under which the formulary exception is processed. Determines applicable regulatory framework, formulary rules, and exception adjudication standards (e.g., CMS Part D rules apply only to Medicare Part D LOB).']
  quantity_requested decimal(10,3) [note: 'The quantity of the drug (in dispensing units) for which the exception is requested, applicable for quantity limit exception requests. Expressed in the drug\'s standard dispensing unit (e.g., tablets, milliliters).']
  request_channel varchar [note: 'Channel through which the formulary exception request was submitted. Values: phone (member/prescriber call), fax (fax submission), portal (member or prescriber web portal), edi (electronic data interchange transaction), mail (paper/postal), prescriber_portal (dedicated prescriber e-prescribing or PBM portal).']
  request_date date [note: 'Calendar date on which the formulary exception request was formally submitted by the member, prescriber, or authorized representative. This is the principal business event date used for CMS timeliness compliance tracking (72-hour standard, 24-hour expedited).']
  request_received_timestamp timestamp [note: 'Precise date and time the formulary exception request was received and logged in the PBM or UM system. Used for exact timeliness measurement against CMS regulatory response deadlines.']
  requested_drug_tier varchar [note: 'The formulary cost-sharing tier to which the requestor is asking the drug to be assigned for this member (e.g., requesting Tier 2 generic pricing for a Tier 3 preferred brand). Applicable for tier exception requests.']
  requestor_type varchar [note: 'Identifies who initiated the formulary exception request. Member: the enrollee themselves; Prescriber: the treating physician or authorized prescriber; Authorized Representative: a legally designated representative acting on behalf of the member; Pharmacy: the dispensing pharmacy acting on behalf of the member.']
  review_level varchar [note: 'Level of clinical review applied to the formulary exception request. Pharmacist: initial review by clinical pharmacist; Medical Director: escalated review by physician medical director; Peer to Peer: prescriber-to-medical-director discussion; Committee: pharmacy and therapeutics committee review.']
  source_system_code varchar [note: 'Code identifying the operational system of record from which this formulary exception record originated. Supports data lineage and reconciliation in the Databricks Silver layer. Values: rxclaim, argus (PBM systems), interqual, mcg (UM systems), facets, qnxt (core admin), manual (manually entered). [ENUM-REF-CANDIDATE: rxclaim|argus|interqual|mcg|facets|qnxt|manual — 7 candidates stripped; promote to reference product]']
  step_therapy_drugs_tried varchar [note: 'Comma-separated list of NDCs or drug names of step therapy prerequisite drugs that the member has already tried and failed, as documented in the step therapy exception request. Supports clinical review and CMS step therapy override requirements.']
  supporting_doc_received boolean [note: 'Indicates whether the required clinical supporting documentation (e.g., prescriber letter of medical necessity, lab results, treatment history) has been received from the prescriber or member. True = documentation received; False = documentation pending or not received.']
  supporting_doc_received_date date [note: 'Date on which the required clinical supporting documentation was received from the prescriber or member. Used to calculate the effective review start date and CMS timeliness compliance.']
  updated_timestamp timestamp [note: 'Timestamp when the formulary exception record was last modified in the data platform. Tracks status changes, decision updates, and documentation additions throughout the exception lifecycle.']

  Note: 'Transactional record for member or prescriber requests to cover a non-formulary drug or override a formulary restriction (tier exception, PA exception, step therapy exception). Captures request date, member ID, prescriber NPI, requested drug NDC, exception type, clinical justification, decision status (approved/denied), effective date range, and appeal rights notification. Supports CMS Part D coverage determination and exception request requirements.'
}

Table billing.premium_invoice {
  premium_invoice_id varchar [pk, note: 'System-generated unique identifier for the premium invoice record.']
  account_id varchar [note: 'Foreign key linking to billing.account. Business justification: A premium invoice is issued to a billing account — account is the master financial relationship entity in this domain. Every invoice must be traceable to its billing account for AR management, collect']
  aptc_subsidy_id varchar [note: 'Foreign key linking to billing.aptc_subsidy. Business justification: For ACA QHP invoices, the premium invoice is directly tied to an APTC/CSR subsidy record that defines the member\'s authorized subsidy amounts. premium_invoice has is_eligible_for_subsidy, subsidy_amou']
  broker_id varchar [note: 'Foreign key linking to employer.broker. Business justification: Premium invoices for broker-sold groups must reference the broker of record for commission calculation, regulatory reporting (MLR), and broker performance tracking. Standard business process: monthly ']
  compliance_regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: Regulatory filing of premium invoices required by state insurance premium reporting obligations.']
  member_identity_id varchar [note: 'Identifier of the individual member associated with the invoice, if applicable.']
  plan_election_id varchar [note: 'Foreign key linking to enrollment.plan_election. Business justification: Premium invoices bill for specific plan elections. Every invoice must reference the coverage election being billed. Essential for premium calculation, billing accuracy, and member coverage verificatio']
  program_id varchar [note: 'Foreign key linking to care.program. Business justification: Premium invoices must track member enrollment in care management programs (disease management, wellness coaching, care coordination) for accurate premium calculation, risk adjustment reporting, and AC']
  transaction_id varchar [note: 'Foreign key linking to enrollment.enrollment_transaction. Business justification: Required for premium invoicing: each invoice must reference the enrollment transaction that generated the premium, enabling audit, reporting, and reconciliation.']
  billing_period_end date [note: 'Last day of the coverage period for which the premium is billed.']
  billing_period_start date [note: 'First day of the coverage period for which the premium is billed.']
  collection_status varchar [note: 'Current state of the collection effort for the invoice.']
  created_timestamp timestamp [note: 'Timestamp when the invoice record was first created in the data lake.']
  currency_code varchar [note: 'Three‑letter ISO currency code for monetary amounts.']
  delivery_method varchar [note: 'Channel used to deliver the invoice to the recipient.']
  discount_amount decimal(12,2) [note: 'Any discount (e.g., early‑pay, promotional) applied to the invoice.']
  due_date date [note: 'Date by which payment must be received to avoid delinquency.']
  grace_period_days varchar [note: 'Number of days after due date before the invoice is considered delinquent.']
  invoice_number varchar [note: 'External invoice number assigned by the billing system, used for member and regulator reference.']
  invoice_status varchar [note: 'Current processing state of the invoice.']
  invoice_type varchar [note: 'Classification of the invoice based on the recipient and billing arrangement.']
  is_eligible_for_subsidy boolean [note: 'Flag indicating whether the member/group qualifies for a premium subsidy.']
  issue_timestamp timestamp [note: 'Exact time the invoice was generated and issued to the recipient.']
  line_of_business varchar [note: 'Business segment to which the invoice belongs.']
  net_amount_due decimal(12,2) [note: 'Final amount the recipient must pay after adjustments.']
  notes varchar [note: 'Optional comments or remarks added by billing staff.']
  payment_channel varchar [note: 'Interface through which the payment was made.']
  payment_method varchar [note: 'Primary instrument used to settle the invoice.']
  refund_amount decimal(12,2) [note: 'Amount returned to the payer for over‑payment or claim reversal.']
  regulatory_reporting_flag boolean [note: 'Indicates if the invoice must be reported to CMS or state DOI for compliance.']
  retroactive_adjustment_amount decimal(12,2) [note: 'Adjustment for prior‑period premium changes applied to the current invoice.']
  source_system_invoice_reference varchar [note: 'Original invoice identifier from the source billing system.']
  statement_number varchar [note: 'Unique identifier for an individual member statement when invoice_type is individual_statement.']
  subsidy_amount decimal(12,2) [note: 'Amount of premium assistance applied (e.g., APTC, state subsidy).']
  subsidy_type varchar [note: 'Classification of the subsidy applied to the premium.']
  tax_amount decimal(12,2) [note: 'Tax applied to the premium, if applicable.']
  total_premium_amount decimal(12,2) [note: 'Gross premium before any subsidies, taxes, or discounts.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to the invoice record.']

  Note: 'Core billing document representing a premium invoice or statement issued to an employer group, individual member (IFP/ACA marketplace direct-pay), COBRA qualified beneficiary, or government sponsor for a specific billing period. Captures invoice number, billing period start/end, total premium due, subsidy/APTC amounts applied, net amount due, invoice status (draft, issued, paid, partially paid, void, delinquent), due date, document type (group list-bill invoice, group self-bill invoice, individual member statement, COBRA invoice, government remittance request), delivery method (mail, email, member portal), line-of-business (LOB), statement-specific fields for IFP direct-pay members (statement number, member reference, plan name, statement delivery preference), and source system reference from HealthEdge or custom billing platform. SSOT for ALL premium billing documents — both group invoices and individual member statements — in the billing domain.'
}

Table billing.invoice_line {
  invoice_line_id varchar [pk, note: 'System-generated unique identifier for the invoice line record.']
  aptc_subsidy_id varchar [note: 'Foreign key linking to billing.aptc_subsidy. Business justification: invoice_line has aptc_subsidy_amount and csr_adjustment_amount fields representing line-level subsidy applications. Linking invoice_line to aptc_subsidy at the line level (per member/subscriber) enabl']
  health_plan_id varchar [note: 'Identifier of the health insurance plan or benefit design associated with the charge.']
  member_identity_id varchar [note: 'Unique identifier of the covered member or subscriber for this premium charge.']
  plan_election_id varchar [note: 'Foreign key linking to enrollment.plan_election. Business justification: Invoice line items detail premium charges for specific plan elections. Required for line-level premium reconciliation, coverage tier billing, and retroactive adjustment processing. Each line represent']
  plan_id varchar [note: 'Foreign key linking to care.care_plan. Business justification: Invoice lines for care management fees, care coordination services, and value-based care arrangements must reference the specific care plan being billed. Essential for VBC contract billing, care manag']
  premium_invoice_id varchar [note: 'Identifier of the parent invoice header to which this line belongs.']
  rate_id varchar [note: 'Foreign key linking to plan.rate. Business justification: Invoice lines calculate premium amounts by applying specific rate tables based on member age, family tier, rating area, and coverage period. Rating is the core actuarial process that translates plan d']
  transaction_id varchar [note: 'Foreign key linking to enrollment.enrollment_transaction. Business justification: Needed for line‑level reconciliation: each invoice line reflects a specific enrollment transaction (plan tier, coverage), supporting detailed financial reporting.']
  adjustment_reason_code varchar [note: 'Code indicating the business reason for a premium adjustment.']
  adjustment_reason_description varchar [note: 'Human‑readable description of the adjustment reason.']
  aptc_subsidy_amount decimal(12,2) [note: 'Advanced Premium Tax Credit amount applied to reduce the member\'s premium.']
  billing_period_end date [note: 'End date of the billing period associated with this line.']
  billing_period_start date [note: 'Start date of the billing period associated with this line.']
  coverage_end_date date [note: 'Last day of coverage for which the premium is billed (nullable for open‑ended coverage).']
  coverage_start_date date [note: 'First day of coverage for which the premium is billed.']
  coverage_tier varchar [note: 'Classification of the coverage level for the member (e.g., employee only, employee + spouse, employee + child, family).']
  created_timestamp timestamp [note: 'Date‑time when the invoice line record was first created in the system.']
  csr_adjustment_amount decimal(12,2) [note: 'Amount of cost-sharing reduction (CSR) applied to the premium.']
  employee_contribution decimal(12,2) [note: 'Portion of the premium paid by the employee (or subscriber).']
  employer_contribution decimal(12,2) [note: 'Portion of the premium paid by the employer on behalf of the member.']
  is_refund boolean [note: 'True if this line represents a refund rather than a charge.']
  line_sequence varchar [note: 'Sequential order of the line within the invoice.']
  payment_due_date date [note: 'Date by which payment for this premium line is due.']
  payment_status varchar [note: 'Current payment status for the premium line.']
  premium_amount decimal(12,2) [note: 'Base premium amount before any contributions, subsidies, or adjustments.']
  premium_currency varchar [note: 'Three‑letter ISO currency code for the premium amounts.']
  premium_line_description varchar [note: 'Free‑form description of the premium line (e.g., "Monthly medical premium for employee only").']
  premium_reconciliation_flag boolean [note: 'Indicates whether the line has been reconciled to the general ledger.']
  premium_source_system varchar [note: 'Name of the source system that generated the premium line (e.g., HealthEdge, CustomBilling).']
  premium_status varchar [note: 'Current processing status of the premium line.']
  rate_type varchar [note: 'Type of premium rate applied to the line (standard, discount, subsidy, retroactive, or other adjustment).']
  refund_amount decimal(12,2) [note: 'Amount refunded to the member or employer for this line (if applicable).']
  regulatory_reporting_flag boolean [note: 'True if this line must be included in regulatory reports (e.g., CMS, state DOI).']
  retroactive_adjustment_flag boolean [note: 'Flag indicating whether this line reflects a retroactive premium adjustment.']
  tax_amount decimal(12,2) [note: 'Tax component applied to the premium line, if applicable.']
  total_amount decimal(12,2) [note: 'Final amount after employer/employee contributions, subsidies, adjustments, and taxes.']
  updated_timestamp timestamp [note: 'Date‑time of the most recent update to the invoice line record.']

  Note: 'Line-item detail within a premium invoice, representing a single member or subscriber coverage charge for a billing period. Captures member/subscriber reference, plan code, coverage tier (EE, EE+SP, EE+CH, FAM), rate type, gross premium, employer contribution, employee contribution, APTC subsidy amount, CSR adjustment, retroactive adjustment indicator, and effective coverage dates. Supports PMPM-level billing reconciliation.'
}

Table billing.premium_payment {
  premium_payment_id varchar [pk, note: 'System-generated unique identifier for the premium payment record.']
  account_id varchar [note: 'Foreign key linking to billing.account. Business justification: A premium payment is made against a billing account. The account is the master billing entity that owns the payment relationship. No existing FK from premium_payment to account exists. payer_account_n']
  care_enrollment_id varchar [note: 'Foreign key linking to care.care_enrollment. Business justification: Premium payments need to track care program enrollment status to apply correct premium rates, care management fees, and value-based adjustments. Operational requirement for billing systems to validate']
  member_identity_id varchar [note: 'Identifier of the member associated with the premium payment.']
  payment_method_id varchar [note: 'Foreign key linking to billing.payment_method. Business justification: premium_payment has a STRING column \'payment_method\' (e.g., \'ACH\', \'CHECK\', \'CREDIT_CARD\') which is a denormalized reference to the payment_method master record. payment_method is the authoritative ma']
  policy_id varchar [note: 'Identifier of the insurance policy to which the premium payment applies.']
  premium_invoice_id varchar [note: 'Identifier of the premium invoice that this payment is applied to.']
  transaction_id varchar [note: 'Foreign key linking to enrollment.enrollment_transaction. Business justification: Payments are applied to invoices tied to an enrollment transaction; linking allows tracking payment against the originating enrollment for compliance and financial analysis.']
  adjustment_amount decimal(12,2) [note: 'Total of fees, discounts, or other adjustments applied to the gross amount.']
  batch_number varchar [note: 'Identifier of the processing batch that included this payment.']
  created_timestamp timestamp [note: 'Timestamp when the payment record was first created in the system.']
  currency_code varchar [note: 'Three‑letter ISO currency code of the payment.']
  fee_amount decimal(12,2) [note: 'Any processing or service fees associated with the payment.']
  net_amount decimal(12,2) [note: 'Final amount after adjustments, representing the amount applied to the invoice.']
  nsf_indicator boolean [note: 'True if the payment was returned due to non‑sufficient funds.']
  payer_account_number varchar [note: 'Account number or identifier used by the payer for the transaction.']
  payer_name varchar [note: 'Legal name of the entity making the payment.']
  payer_type varchar [note: 'Classification of the payer (e.g., employer, individual member, CMS, state Medicaid agency).']
  payment_amount decimal(12,2) [note: 'Total amount received before any adjustments.']
  payment_channel varchar [note: 'Interface through which the payment was submitted.']
  payment_description varchar [note: 'Free‑form description or notes about the payment.']
  payment_number varchar [note: 'Unique payment reference number assigned by the billing system.']
  payment_timestamp timestamp [note: 'Date and time when the payment was received.']
  premium_payment_status varchar [note: 'Current lifecycle state of the payment.']
  reconciliation_status varchar [note: 'Status of the payment in the accounting reconciliation process.']
  resolution_date date [note: 'Date the suspense item was resolved.']
  resolution_due_date date [note: 'Target date by which the suspense item should be resolved.']
  resolution_outcome varchar [note: 'Result of the suspense investigation.']
  suspense_reason_code varchar [note: 'Code indicating why the payment is in suspense (e.g., unidentified payer, amount mismatch).']
  suspense_resolver varchar [note: 'Name of the employee or system responsible for investigating the suspense item.']
  suspense_status varchar [note: 'Current status of the payment within the suspense workflow.']
  tax_amount decimal(12,2) [note: 'Tax component of the payment, if applicable.']
  transaction_type varchar [note: 'Classification of the payment transaction.']
  unapplied_amount decimal(12,2) [note: 'Portion of the payment that could not be matched to an invoice and is placed in suspense.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the payment record.']

  Note: 'Records an actual payment received against a premium invoice, capturing payment date, payment amount, payment method (ACH, check, wire, credit card, EFT), payment reference number, payer type (employer group, individual member, CMS, state Medicaid agency), applied invoice reference, unapplied/suspense balance, NSF/return indicator, reconciliation status, and full suspense management lifecycle (suspense status, suspense reason code — unidentified payer, amount mismatch, duplicate payment, missing invoice reference — received amount, receipt date, payer name, payer account reference, assigned resolver, resolution due date, resolution outcome — applied to invoice, refunded, written off — resolution date). Payments in suspense status are tracked inline with complete resolution workflow rather than in a separate suspense entity. SSOT for all inbound premium cash receipts including suspense items, their investigation, and resolution lifecycle.'
}

Table billing.payment_allocation {
  payment_allocation_id varchar [pk, note: 'System-generated unique identifier for each payment allocation record.']
  invoice_line_id varchar [note: 'Identifier of the invoice line to which the payment amount is allocated.']
  premium_payment_id varchar [note: 'Identifier of the premium payment that is being allocated.']
  allocated_amount decimal(12,2) [note: 'Monetary amount of the premium that is allocated to the invoice line.']
  allocated_quantity decimal(12,2) [note: 'Quantity of premium units (e.g., member‑months) allocated to the invoice line.']
  allocation_date date [note: 'Calendar date on which the allocation was recorded.']
  allocation_sequence varchar [note: 'Sequential order of allocation lines within the same payment.']
  allocation_status varchar [note: 'Current processing status of the allocation record.']
  allocation_type varchar [note: 'Classification of the allocation purpose (e.g., standard payment, partial payment, over‑payment, suspense resolution, adjustment, refund).']
  created_timestamp timestamp [note: 'Timestamp when the allocation record was first created in the system.']
  currency_code varchar [note: 'Three‑letter ISO 4217 code of the currency for the allocated amount.']
  discount_amount decimal(12,2) [note: 'Discount or credit applied to the allocated premium.']
  effective_from date [note: 'Date when the allocation becomes effective for accounting purposes.']
  effective_until date [note: 'Date when the allocation ceases to be effective (null if open‑ended).']
  is_overpayment boolean [note: 'Indicates whether the allocation represents an overpayment scenario.']
  is_suspense_resolution boolean [note: 'True when the allocation resolves a suspense balance.']
  notes varchar [note: 'Free‑form comments or remarks about the allocation.']
  payment_channel varchar [note: 'Channel through which the payment was submitted.']
  payment_method varchar [note: 'Instrument used to make the premium payment.']
  reconciliation_period varchar [note: 'Period identifier (e.g., 2023-04) for the premium reconciliation cycle.']
  reconciliation_status varchar [note: 'Current lifecycle state of the reconciliation record.']
  reconciliation_type varchar [note: 'Frequency classification of the reconciliation (e.g., monthly, quarterly).']
  tax_amount decimal(12,2) [note: 'Tax component associated with the allocated premium.']
  total_adjustments decimal(12,2) [note: 'Aggregate of all adjustments (e.g., refunds, credits) applied during the period.']
  total_billed decimal(12,2) [note: 'Sum of all invoice line amounts billed for the reconciliation period.']
  total_collected decimal(12,2) [note: 'Sum of all payments collected for the reconciliation period.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the allocation record.']
  variance_amount decimal(12,2) [note: 'Difference between total billed and total collected after adjustments.']
  variance_reason varchar [note: 'Explanation for any variance observed in the reconciliation.']

  Note: 'Association and reconciliation entity linking premium payments to invoice lines, tracking line-level allocation, and managing periodic premium reconciliation outcomes. For allocation: captures allocated amount, allocation date, allocation type (standard, partial, overpayment, suspense resolution), and line-level reconciliation status. Supports many-to-many payment-to-invoice matching and enables accurate accounts receivable aging. For periodic reconciliation: captures reconciliation period, total billed, total collected, total adjustments, variance amount, variance reason, reconciliation status (open, in review, approved, closed), approver reference, and reconciliation type (monthly, quarterly, annual). Supports MLR calculation inputs, financial close processes, CMS premium reconciliation, and end-to-end premium reconciliation from individual line-level allocation through period-level summary and variance analysis. SSOT for all payment allocation and premium reconciliation in the billing domain.'
}

Table billing.account {
  account_id varchar [pk, note: 'System-generated unique identifier for the billing account.']
  broker_id varchar [note: 'Foreign key linking to employer.broker. Business justification: Billing accounts track broker of record for commission processing, 1099 reporting, and broker servicing rights. Real business need: accounts must maintain broker assignment history for commission disp']
  facility_id varchar [note: 'Foreign key linking to provider.facility. Business justification: Billing accounts are established at the facility level for hospital systems and outpatient facilities, enabling facility-level billing cycle management, capitation payment setup, and EFT disbursement.']
  network_service_area_id varchar [note: 'Foreign key linking to network.service_area. Business justification: Billing accounts (especially employer group accounts) must track their primary service area for network adequacy compliance, provider access validation, premium rating by geography, and regulatory rep']
  provider_id varchar [note: 'Foreign key linking to provider.provider_provider. Business justification: Needed for Provider Payment Reconciliation report linking each provider to its billing account for electronic fund transfers and regulatory payment tracking.']
  regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: Billing accounts must track governing regulatory obligations for compliance reporting, tax-exempt status validation, regulatory fee assessment, and jurisdiction-specific billing rules. Essential for r']
  account_status varchar [note: 'Current lifecycle status of the billing account.']
  account_type varchar [note: 'Classification of the billing entity (e.g., employer group, individual subscriber, government program).']
  apr_rate decimal(5,2) [note: 'Percentage rate applied to calculate the annual premium for the account.']
  aptc_amount decimal(15,2) [note: 'Amount of ACA premium tax credit applied to the account.']
  auto_pay_authorization_date date [note: 'Date when the auto‑pay authorization was granted.']
  auto_pay_authorization_flag boolean [note: 'Indicates whether the account holder has authorized automatic payments.']
  auto_pay_enrollment boolean [note: 'Indicates whether the account is enrolled in automatic payment processing.']
  auto_renewal_flag boolean [note: 'Indicates whether the account automatically renews at the end of its term.']
  billing_calendar_reference varchar [note: 'Identifier for the calendar configuration governing billing cycles.']
  billing_cycle_type varchar [note: 'Configuration of the recurring billing cycle for the account.']
  billing_frequency varchar [note: 'How often invoices are generated for this account.']
  billing_method varchar [note: 'Method used to deliver bills to the account holder.']
  collection_status varchar [note: 'Current status of the collection effort for overdue balances.']
  created_timestamp timestamp [note: 'Timestamp when the billing account record was first created in the system.']
  credit_limit decimal(15,2) [note: 'Maximum credit amount authorized for the billing entity.']
  currency_code varchar [note: 'Three‑letter ISO currency code for all monetary amounts on the account.']
  current_balance decimal(15,2) [note: 'Outstanding monetary balance on the account as of the latest reconciliation.']
  effective_from date [note: 'Date when the billing account became effective.']
  effective_until date [note: 'Date when the billing account is scheduled to terminate (null if open‑ended).']
  grace_period_days varchar [note: 'Number of days after the due date before the account is considered delinquent.']
  invoice_generation_day varchar [note: 'Day of month when the invoice is generated (1‑31).']
  last_invoice_date date [note: 'Date when the most recent invoice was generated.']
  last_payment_amount decimal(15,2) [note: 'Monetary amount of the most recent payment.']
  last_payment_date date [note: 'Date of the most recent payment received for the account.']
  next_invoice_date date [note: 'Scheduled date for the next invoice issuance.']
  notes varchar [note: 'Free‑form text field for internal comments or special instructions related to the account.']
  number varchar [note: 'External account number assigned to the billing entity for invoicing and payment processing.']
  payment_due_amount decimal(15,2) [note: 'Total amount currently due on the account, including any pending charges.']
  payment_due_day varchar [note: 'Day of month by which payment must be received.']
  payment_terms varchar [note: 'Contractual terms defining when payment is due after invoice issuance.']
  pmpm_rate decimal(5,2) [note: 'Rate used to calculate monthly charges on a per‑member basis.']
  regulatory_reporting_flag boolean [note: 'Indicates whether the account is subject to special regulatory reporting (e.g., CMS, state DOI).']
  subsidy_amount decimal(15,2) [note: 'Total subsidy applied to the account (e.g., employer or government subsidies).']
  tax_exempt_flag boolean [note: 'Indicates whether the account is exempt from sales or other applicable taxes.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the billing account record.']

  Note: 'Master billing account representing the financial relationship between the health plan and a billing entity — employer group, individual subscriber, or government program (Medicare, Medicaid, CHIP). Captures account number, account type, billing frequency (monthly, quarterly, annual), billing method (self-bill, list-bill, direct-bill), payment terms, auto-pay enrollment, current balance, credit limit, account status, assigned billing representative, billing cycle configuration (cycle type — monthly/quarterly/semi-annual/annual, invoice generation date, payment due date, grace period days, next/last invoice dates, auto-renewal flag, billing calendar reference), and registered payment methods (payment method type — ACH/EFT, check, wire transfer, credit card, debit card, HSA/FSA — with masked/tokenized bank routing and account numbers, card last four digits, card expiration date, auto-pay authorization flag, authorization date and reference, active/inactive status per method, PCI-DSS compliant storage). SSOT for billing account identity, billing cycle configuration, and authorized payment methods.'
}

Table billing.grace_period {
  grace_period_id varchar [pk, note: 'System-generated unique identifier for the grace period record.']
  account_id varchar [note: 'Identifier of the billing account to which this grace period applies.']
  member_identity_id varchar [note: 'Identifier of the member associated with the account for this grace period.']
  plan_election_id varchar [note: 'Foreign key linking to enrollment.plan_election. Business justification: Grace periods track non-payment risk for specific coverage elections. Required for termination processing, reinstatement eligibility, and regulatory reporting. Business must know which plan election i']
  premium_invoice_id varchar [note: 'Identifier of the invoice that triggered the grace period.']
  regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: Grace periods are governed by specific state/federal regulations (ACA 90-day grace period rules, state-specific extensions). Linking enables compliance validation, termination decision support, and re']
  resolving_premium_payment_id varchar [note: 'Foreign key linking to billing.premium_payment. Business justification: A grace period is resolved (or terminated) when a premium payment is received. grace_period has payment_received_date (a date field) but no FK to the actual premium_payment record that resolved it. Ad']
  created_timestamp timestamp [note: 'Timestamp when the grace period record was first created in the system.']
  day_count varchar [note: 'Number of days elapsed since the start of the grace period.']
  description varchar [note: 'Free-text description providing additional context for the grace period.']
  end_date date [note: 'Date when the grace period is scheduled to end.']
  extension_end_date date [note: 'New end date if the grace period was extended.']
  extension_flag boolean [note: 'Indicates whether the original grace period was extended.']
  grace_period_status varchar [note: 'Current lifecycle status of the grace period.']
  grace_period_type varchar [note: 'Classification of the grace period based on product or regulatory rules.']
  is_eligible_for_aptc boolean [note: 'Indicates if the member is eligible for Advanced Premium Tax Credit during this grace period.']
  jurisdiction varchar [note: 'Regulatory jurisdiction applicable to the grace period.']
  notes varchar [note: 'Additional free-form notes captured by the billing team.']
  number varchar [note: 'External business identifier for the grace period, used in reporting and member communications.']
  outcome varchar [note: 'Result of the grace period after it ends.']
  payment_due_date date [note: 'The date by which the premium payment was originally due before the grace period started.']
  payment_received_date date [note: 'Date on which the overdue payment was received, if applicable.']
  reason_code varchar [note: 'Code indicating why the grace period was initiated.']
  regulatory_reporting_flag boolean [note: 'Indicates whether this grace period must be reported to CMS or state DOI.']
  start_date date [note: 'Date when the grace period began.']
  state_code varchar [note: 'Two-letter state abbreviation for jurisdictional reporting. [ENUM-REF-CANDIDATE: AL|AK|AZ|AR|CA|CO|CT|DE|FL|GA|HI|ID|IL|IN|IA|KS|KY|LA|ME|MD|MA|MI|MN|MS|MO|MT|NE|NV|NH|NJ|NM|NY|NC|ND|OH|OK|OR|PA|RI|SC|SD|TN|TX|UT|VT|VA|WA|WV|WI|WY — promote to reference product]']
  subsidy_amount decimal(12,2) [note: 'Monetary amount of any subsidy applied during the grace period.']
  termination_warning_issued boolean [note: 'Indicates whether a termination warning has been sent to the member.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the grace period record.']

  Note: 'Tracks the grace period status for a billing account or member when premium payment is overdue. Captures grace period start date, grace period end date (typically 30 days for individual/ACA, 31 days for group), grace period type (ACA APTC grace period is 90 days), triggering invoice reference, current grace period day count, termination warning issued flag, and resolution outcome (paid, terminated, reinstated). Required for ACA compliance and state DOI reporting.'
}

Table billing.aptc_subsidy {
  aptc_subsidy_id varchar [pk, note: 'System-generated unique identifier for the APTC subsidy record.']
  member_identity_id varchar [note: 'Unique identifier of the member receiving the subsidy.']
  plan_election_id varchar [note: 'Foreign key linking to enrollment.plan_election. Business justification: APTC subsidies are calculated and applied to specific plan elections. Required for premium calculation, CMS reconciliation, and subsidy eligibility verification. Each subsidy record must reference the']
  regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: APTC subsidies are governed by specific ACA regulations and IRS reconciliation requirements. Linking enables CMS reconciliation compliance tracking, regulatory reporting validation, and audit support ']
  annual_aptc_cap decimal(12,2) [note: 'Maximum total APTC amount the member may receive in a calendar year.']
  aptc_monthly_amount decimal(12,2) [note: 'Monthly amount of APTC applied to the member\'s premium.']
  aptc_subsidy_status varchar [note: 'Overall lifecycle status of the subsidy record.']
  cms_reconciliation_status varchar [note: 'Current status of the subsidy record in CMS premium remittance reconciliation.']
  created_timestamp timestamp [note: 'Timestamp when the subsidy record was first created in the system.']
  csr_variant varchar [note: 'CSR variant percentage (73%, 87%, or 94%) applicable to the member.']
  exchange_code varchar [note: 'Identifier of the marketplace exchange where the member enrolled.']
  qhp_plan_code varchar [note: 'Code of the Qualified Health Plan associated with the subsidy.']
  subsidy_effective_date date [note: 'Date when the subsidy becomes effective.']
  subsidy_number varchar [note: 'External business identifier assigned to the subsidy agreement.']
  subsidy_termination_date date [note: 'Date when the subsidy ends or is terminated; null if still active.']
  subsidy_type varchar [note: 'Indicates whether the record is an Advance Premium Tax Credit (APTC) or Cost‑Sharing Reduction (CSR) subsidy.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the subsidy record.']
  ytd_aptc_applied decimal(12,2) [note: 'Cumulative APTC amount applied to the member\'s premiums to date.']

  Note: 'Tracks Advance Premium Tax Credit (APTC) and Cost-Sharing Reduction (CSR) subsidy amounts for ACA marketplace members. Captures member reference, QHP plan code, marketplace exchange ID, APTC monthly amount, CSR variant level (73%, 87%, 94%), annual APTC cap, year-to-date APTC applied, subsidy effective date, subsidy termination date, and CMS reconciliation status. Required for ACA Section 1401/1402 compliance and CMS premium remittance reporting.'
}

Table billing.cms_remittance {
  cms_remittance_id varchar [pk, note: 'System-generated unique identifier for each CMS remittance record.']
  account_id varchar [note: 'Foreign key linking to billing.account. Business justification: CMS remittance transactions represent payments from CMS to the health plan\'s billing account for Medicare Advantage, Part D, and ACA QHP plans. Linking cms_remittance to the billing account enables ac']
  broker_id varchar [note: 'Foreign key linking to employer.broker. Business justification: CMS 820 remittances in marketplace/exchange scenarios include broker commission reconciliation data. Issuers must track which broker facilitated enrollment to calculate and report commissions. Real bu']
  cms_submission_id varchar [note: 'Foreign key linking to enrollment.cms_submission. Business justification: CMS remittances reconcile payments against specific enrollment submissions. Required for risk adjustment reconciliation, payment variance analysis, and regulatory audit trails. Each remittance must re']
  facility_id varchar [note: 'Foreign key linking to provider.facility. Business justification: CMS remittance for facility-based services (UB-04/institutional claims) must reference the specific facility for reconciliation, audit, and regulatory reporting. Health plans receive separate CMS remi']
  group_practice_id varchar [note: 'Foreign key linking to provider.group_practice. Business justification: CMS remittance for ACO shared savings, group capitation, and MSSP arrangements is issued at the group practice level, not individual provider level. Group-level CMS remittance reconciliation is a mand']
  health_plan_id varchar [note: 'Identifier of the health plan or benefit package for which the remittance applies.']
  hedis_measure_id varchar [note: 'Foreign key linking to care.hedis_measure. Business justification: CMS remittances for quality bonus payments, star ratings incentives, and HEDIS performance-based payments must reference the specific HEDIS measures that triggered the payment. Required for quality pa']
  member_identity_id varchar [note: 'Unique identifier of the member associated with the remittance.']
  pbm_contract_id varchar [note: 'Foreign key linking to pharmacy.pbm_contract. Business justification: CMS Part D remittance payments are governed by PBM contract terms (rebate pass-through %, dispensing fee guarantees). Reconciling CMS remittances against the applicable PBM contract is a mandatory Par']
  provider_network_id varchar [note: 'Foreign key linking to network.provider_network. Business justification: CMS remittances for risk adjustment payments, MLR rebates, and reinsurance are calculated and reconciled at the provider network level for regulatory reporting to CMS. Network-level aggregation is req']
  raps_submission_id varchar [note: 'Foreign key linking to risk.raps_submission. Business justification: CMS risk adjustment remittances must reference the specific RAPS submission batch that triggered the payment. Critical for reconciling CMS payments to submitted diagnosis data and resolving payment di']
  adjustment_reason varchar [note: 'Free‑text description explaining any manual adjustments applied to the remittance.']
  created_timestamp timestamp [note: 'Timestamp when the remittance record was first loaded into the data lake.']
  currency_code varchar [note: 'Three‑letter ISO 4217 currency code for the remittance amounts (e.g., USD).']
  edi_820_reference varchar [note: 'Reference number of the associated EDI 820 payment file.']
  gross_payment_amount decimal(15,2) [note: 'Total amount paid by CMS before any adjustments or offsets.']
  is_eligible boolean [note: 'Indicates whether the member was eligible for the payment period.']
  mlr_rebate_offset_amount decimal(15,2) [note: 'Medical Loss Ratio rebate offset applied to the gross payment.']
  net_remittance_amount decimal(15,2) [note: 'Final amount after all adjustments, representing the amount to be credited to the insurer.']
  payment_period_end date [note: 'Last day of the payment period for which the remittance applies.']
  payment_period_start date [note: 'First day of the payment period for which the remittance applies.']
  payment_type varchar [note: 'Category of CMS payment such as capitation, risk corridor, reinsurance, or risk adjustment.']
  reconciliation_status varchar [note: 'Current status of the remittance reconciliation process.']
  remittance_number varchar [note: 'External reference number assigned by CMS for the remittance transaction.']
  remittance_status varchar [note: 'Lifecycle state of the remittance record within the insurer\'s system.']
  remittance_timestamp timestamp [note: 'Date and time when the remittance was received from CMS.']
  risk_adjustment_amount decimal(15,2) [note: 'Amount related to risk adjustment transfers included in the remittance.']
  submission_type varchar [note: 'Method by which the remittance data was submitted to the insurer.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the remittance record.']

  Note: 'Records CMS premium remittance transactions for Medicare Advantage (MA), Part D, and ACA QHP plans. Captures CMS payment type (capitation, risk corridor, reinsurance, risk adjustment transfer), payment period, gross payment amount, risk adjustment amount, MLR rebate offset, net remittance amount, CMS transaction ID, 820 EDI transaction reference, and reconciliation status. SSOT for government premium remittance from CMS.'
}

Table billing.payment_method {
  payment_method_id varchar [pk, note: 'System-generated unique identifier for the payment method record.']
  account_id varchar [note: 'Identifier of the billing account to which this payment method is attached.']
  member_identity_id varchar [note: 'Identifier of the member (policyholder) who owns the payment method.']
  authorization_date date [note: 'Date the payment method was authorized for use.']
  authorization_reference varchar [note: 'External reference or token returned by the payment processor confirming authorization.']
  bank_name varchar [note: 'Name of the financial institution that holds the account.']
  billing_address_line1 varchar [note: 'First line of the billing address associated with the payment method.']
  billing_address_line2 varchar [note: 'Second line of the billing address (optional).']
  billing_city varchar [note: 'City component of the billing address.']
  billing_country varchar [note: 'Three‑letter ISO country code for the billing address.']
  billing_postal_code varchar [note: 'Postal/ZIP code of the billing address.']
  billing_state varchar [note: 'State/Province component of the billing address.']
  card_expiration_date date [note: 'Expiration date of the credit/debit card.']
  card_last_four varchar [note: 'Last four digits of the credit/debit card for display purposes.']
  card_type varchar [note: 'Network brand of the credit/debit card.']
  created_timestamp timestamp [note: 'Timestamp when the payment method record was first created in the system.']
  effective_from date [note: 'Date the payment method becomes effective for billing.']
  effective_until date [note: 'Date the payment method expires or is deactivated (null if open‑ended).']
  holder_name varchar [note: 'Legal name of the individual to whom the card is issued.']
  is_auto_pay boolean [note: 'Indicates whether the member has authorized automatic recurring payments using this method.']
  masked_account_number varchar [note: 'Bank account number with middle digits masked for PCI‑DSS compliance.']
  masked_routing_number varchar [note: 'Bank routing number with middle digits masked to meet PCI‑DSS requirements.']
  method_type varchar [note: 'Category of the payment instrument (e.g., ACH, Check, Wire, Credit Card, Debit Card, Health Savings Account).']
  notes varchar [note: 'Free‑form text for operational comments or special handling instructions.']
  payment_method_status varchar [note: 'Current lifecycle state of the payment method.']
  pci_compliance_flag boolean [note: 'Indicates whether the stored payment method meets PCI‑DSS compliance.']
  risk_score decimal(5,2) [note: 'Fraud risk score assigned by the payment processor (0.00‑99.99).']
  tokenized_account_number varchar [note: 'PCI‑token representing the full bank account number for secure storage.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the payment method record.']
  verification_status varchar [note: 'Result of the payment method verification process.']
  verification_timestamp timestamp [note: 'Date‑time when verification was performed.']

  Note: 'Master record of authorized payment methods registered for a billing account, capturing payment method type (ACH/EFT, check, wire transfer, credit card, debit card, HSA/FSA), bank routing number (masked), bank account number (masked/tokenized), card last four digits, card expiration date, auto-pay authorization flag, authorization date, authorization reference, and active/inactive status. Supports PCI-DSS compliant payment processing.'
}

Table utilization.pa_request {
  pa_request_id varchar [pk, note: 'Unique identifier for the prior authorization request.']
  clinical_criteria_id varchar [note: 'Identifier of the specific clinical rule applied.']
  coordinator_id varchar [note: 'Foreign key linking to care.coordinator. Business justification: Care coordinators submit PA requests for members in care management programs. Essential workflow for tracking coordinator-initiated authorization requests and measuring program effectiveness.']
  medical_policy_id varchar [note: 'Foreign key linking to utilization.medical_policy. Business justification: PA requests are evaluated against specific medical policies (e.g., is prior auth required per policy, what coverage limits apply). pa_request currently has clinical_criteria_id but no direct link to t']
  member_risk_score_id varchar [note: 'Foreign key linking to risk.member_risk_score. Business justification: Utilization Management uses member\'s risk score to prioritize prior auth decisions; the \'PA Risk Score Review\' report requires linking each PA request to the member_risk_score record.']
  network_service_area_id varchar [note: 'Foreign key linking to network.service_area. Business justification: PA requests must validate requested services are within member\'s covered service area for authorization determination. PA reviewers check service area eligibility when members request services from ou']
  plan_election_id varchar [note: 'Identifier of the health plan under which the member is covered.']
  primary_pa_provider_id varchar [note: 'Foreign key linking to provider.provider_provider. Business justification: Required for Prior Authorization request processing to link each request to the provider entity for reporting, compliance, and performance metrics.']
  transaction_id varchar [note: 'Foreign key linking to enrollment.enrollment_transaction. Business justification: Prior Authorization requests must verify the member\'s active enrollment transaction to determine coverage and cost‑share, required for CMS PA reporting and claim adjudication.']
  appeal_deadline_date date [note: 'Final date by which an appeal must be filed.']
  clinical_criteria_version varchar [note: 'Version of the clinical criteria set applied to the request.']
  created_timestamp timestamp [note: 'Timestamp when the request record was first created in the data warehouse.']
  currency_code varchar [note: 'Three-letter ISO currency code for the estimated amounts.']
  decision_maker_role varchar [note: 'Professional role of the decision maker.']
  denial_reason_code varchar [note: 'Code representing the reason for denial, if applicable.']
  diagnosis_code varchar [note: 'Diagnosis code supporting the medical necessity of the request.']
  estimated_adjustment_amount decimal(12,2) [note: 'Estimated adjustments (e.g., discounts, co-pays) applied to the gross amount.']
  estimated_gross_amount decimal(12,2) [note: 'Initial estimated gross cost of the requested service before adjustments.']
  estimated_net_amount decimal(12,2) [note: 'Final estimated net cost after adjustments.']
  is_appealable boolean [note: 'Indicates whether the member may appeal a denial.']
  is_duplicate_request boolean [note: 'Indicates whether this request is a duplicate of an existing request.']
  last_air_due_date date [note: 'Due date for the most recent additional information request.']
  last_air_received_date date [note: 'Date the last additional information request was received.']
  notes varchar [note: 'Additional comments or notes related to the request.']
  pa_request_status varchar [note: 'Current lifecycle status of the prior authorization request.']
  patient_age_at_request varchar [note: 'Age of the member at the time of request submission.']
  patient_gender varchar [note: 'Gender of the member at the time of request.']
  prior_auth_decision_date date [note: 'Date the prior authorization decision was made.']
  quantity varchar [note: 'Number of units or sessions requested.']
  request_number varchar [note: 'Business identifier assigned to the prior authorization request.']
  request_timestamp timestamp [note: 'Timestamp when the prior authorization request was submitted.']
  request_type varchar [note: 'Urgency classification of the prior authorization request.']
  service_code varchar [note: 'Procedure, service, or drug code associated with the request.']
  service_type varchar [note: 'Category of the service being requested for prior authorization.']
  submission_channel varchar [note: 'Channel through which the prior authorization request was submitted.']
  turnaround_time_days varchar [note: 'Number of days from submission to final decision.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the request record.']

  Note: 'Core master entity representing a prior authorization (PA) request submitted by a provider or member for a proposed service, procedure, drug, or admission. Captures requesting provider NPI, member ID, requested service codes (CPT/HCPCS/ICD), urgency type (standard, expedited, urgent), submission channel (portal, fax, phone, EDI 278), submission timestamp, current PA status, and full status transition history. Also tracks additional information requests (AIRs) issued during review — information type requested, requested-from party, due date, received date, and TAT clock extension impact. Authoritative SSOT for all PA requests, their status lifecycle, and associated documentation requests.'
}

Table utilization.pa_decision {
  pa_decision_id varchar [pk, note: 'System-generated unique identifier for each prior authorization decision record.']
  clinical_criteria_id varchar [note: 'Foreign key linking to utilization.clinical_criteria. Business justification: A PA decision is made by applying specific clinical criteria (InterQual/MCG). pa_decision currently stores clinical_criteria_set as a free-text string and clinical_criteria_version as a snapshot. Addi']
  coordinator_id varchar [note: 'Foreign key linking to care.coordinator. Business justification: Coordinators track PA decision outcomes to adjust care plans and escalate denials. Critical for care management reporting and member advocacy workflows.']
  medical_policy_id varchar [note: 'Foreign key linking to utilization.medical_policy. Business justification: pa_decision references the medical policy that governs the decision; child (decision) gets FK to parent (medical_policy).']
  member_identity_id varchar [note: 'Unique identifier of the member/patient associated with the request.']
  member_risk_score_id varchar [note: 'Foreign key linking to risk.member_risk_score. Business justification: PA decision approval logic requires member risk score for medical necessity determination, payment accuracy calculation, and CMS risk adjustment reconciliation. Critical for authorization workflow and']
  pa_request_id varchar [note: 'Identifier of the prior‑authorization request to which this decision belongs.']
  provider_id varchar [note: 'Foreign key linking to provider.provider_provider. Business justification: Links PA decision to the originating provider for audit trails, regulatory reporting, and provider‑specific denial analysis.']
  amendment_indicator varchar [note: 'Indicates if this record is the original decision or an amendment/reversal.']
  appeal_eligibility_flag boolean [note: 'Indicates whether the member is eligible to appeal the decision.']
  authorization_end_date date [note: 'Effective end date of the approved authorization period.']
  authorization_period_type varchar [note: 'Specifies if the authorization period is a fixed date range or rolling.']
  authorization_quantity varchar [note: 'Number of units (e.g., days, visits, doses) authorized.']
  authorization_start_date date [note: 'Effective start date of the approved authorization period.']
  authorization_units varchar [note: 'Unit of measure for the authorized quantity.']
  clinical_criteria_version varchar [note: 'Version identifier of the criteria set used for the decision.']
  clinical_rationale varchar [note: 'Free‑text explanation of the clinical reasoning behind the decision.']
  created_timestamp timestamp [note: 'Timestamp when the decision record was first inserted into the data lake.']
  criteria_effective_date date [note: 'Date on which the applied clinical criteria version became effective.']
  criteria_met_flag boolean [note: 'Indicates whether the request met all required clinical criteria (true) or not (false).']
  decision_date timestamp [note: 'Timestamp when the prior authorization decision was rendered.']
  decision_number varchar [note: 'External business identifier assigned to the decision, often used in communications and audit trails.']
  decision_status varchar [note: 'Current lifecycle status of the decision record.']
  decision_type varchar [note: 'Classification of the decision outcome.']
  denial_reason_category varchar [note: 'High‑level category of the denial reason.']
  denial_reason_code varchar [note: 'Standardized code representing the specific reason for denial.']
  denial_regulatory_citation varchar [note: 'Reference to the regulatory or policy citation supporting the denial.']
  diagnosis_codes varchar [note: 'Pipe‑separated list of ICD‑10 diagnosis codes supporting the medical necessity determination.']
  is_telehealth boolean [note: 'True if the service requested is delivered via telehealth.']
  is_urgent boolean [note: 'True if the request was marked urgent.']
  notes varchar [note: 'Free‑form field for any supplemental information.']
  prior_auth_number varchar [note: 'Business number assigned to the prior‑authorization request.']
  regulatory_compliance_flag boolean [note: 'Indicates compliance with NCQA UM accreditation or state PA regulations.']
  reviewer_credentials varchar [note: 'Professional credentials of the reviewer (e.g., MD, RN, PharmD, NP).']
  reviewer_npi varchar [note: 'National Provider Identifier of the clinician or reviewer who rendered the decision.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the decision record.']

  Note: 'Transactional record capturing the authorization decision and underlying medical necessity determination rendered on a PA request. Stores decision date, decision type (approved, denied, partially approved, pended, withdrawn), clinical criteria applied (InterQual/MCG criteria set, version, effective date), criteria met/not met flag, clinical rationale narrative, ICD diagnosis codes supporting the determination, deciding reviewer NPI and credentials (MD, RN, PharmD), denial reason code and category (medical necessity, administrative, benefit exclusion, out-of-network, experimental/investigational), denial regulatory citation, appeal eligibility flag, and effective authorization period (start/end dates). Each PA request may have one or more decision records reflecting amendments, P2P reversals, or appeal overrides. Serves as the single evidentiary record for NCQA audits, state DOI market conduct exams, and denial defense.'
}

Table utilization.auth_service_line {
  auth_service_line_id varchar [pk, note: 'System-generated unique identifier for each line item within a prior authorization request.']
  authorized_facility_id varchar [note: 'Foreign key linking to provider.facility. Business justification: Authorized service lines specify the facility where care is rendered. linking to provider.facility enables network tier validation, accreditation checks, and facility-level cost reporting for autho']
  clinical_criteria_id varchar [note: 'Identifier of the specific clinical rule set (InterQual/MCG) applied to this line.']
  coordinator_id varchar [note: 'Foreign key linking to care.coordinator. Business justification: Coordinators monitor authorized service lines for care plan compliance, utilization tracking, and identifying over/under-utilization patterns in managed populations.']
  fee_schedule_id varchar [note: 'Foreign key linking to contract.fee_schedule. Business justification: Each authorized service line uses a fee schedule to calculate allowed amount; linking enables accurate payment calculation and regulatory fee‑schedule reporting.']
  health_plan_id varchar [note: 'Foreign key linking to plan.health_plan. Business justification: Authorization Service Line Cost Tracking per plan supports financial analysis and rate setting.']
  member_identity_id varchar [note: 'Unique identifier of the member for whom the service is authorized.']
  member_risk_score_id varchar [note: 'Foreign key linking to risk.member_risk_score. Business justification: Service line authorization pricing and approval thresholds vary by member risk tier and HCC status. Essential for accurate authorized_price calculation and risk-adjusted utilization management decisio']
  pa_decision_id varchar [note: 'Foreign key linking to utilization.pa_decision. Business justification: auth_service_line is the line-item detail for services authorized within a PA request. It already references pa_request_id (the request header), but the authorization outcome (approval, denial, partia']
  pa_request_id varchar [note: 'Identifier of the parent prior authorization request to which this service line belongs.']
  provider_id varchar [note: 'Foreign key linking to provider.provider_provider. Business justification: Associates each authorized service line with the ordering provider, enabling utilization analytics and provider reimbursement validation.']
  provider_network_id varchar [note: 'Foreign key linking to network.provider_network. Business justification: Each authorized service line must track rendering provider\'s network participation for accurate claims adjudication and member cost-sharing calculation. Claims systems use service line network assignm']
  reimbursement_policy_id varchar [note: 'Foreign key linking to contract.reimbursement_policy. Business justification: Each authorized service line must comply with applicable reimbursement policies for NCCI edits, bundling rules, modifier logic, and payment methodology. Required for accurate claims adjudication and p']
  authorization_status varchar [note: 'Current status of the service line within the prior authorization workflow.']
  authorized_end_date date [note: 'Expiration date after which the authorization is no longer valid.']
  authorized_price decimal(12,2) [note: 'Maximum reimbursable amount per unit for the authorized service.']
  authorized_quantity decimal(10,2) [note: 'Number of units of the service or product approved for the member.']
  authorized_start_date date [note: 'Effective date when the authorized service may begin.']
  clinical_criteria_version varchar [note: 'Version of the clinical criteria used for medical necessity determination.']
  cpt_code varchar [note: 'Standard CPT code representing the clinical service or procedure authorized.']
  created_timestamp timestamp [note: 'System timestamp when the service line record was first created in the data lake.']
  currency_code varchar [note: 'Three‑letter ISO currency code for the authorized price.']
  decision_timestamp timestamp [note: 'Date‑time when the authorization decision for this line was made.']
  denial_reason varchar [note: 'Explanation code or text why the service line was denied or partially approved.']
  diagnosis_icd_code varchar [note: 'ICD code linking the authorized service to the clinical diagnosis supporting medical necessity.']
  hcpcs_code varchar [note: 'HCPCS code (Level II) for services, supplies, or drugs not covered by CPT.']
  is_emergency boolean [note: 'True if the authorized service is classified as an emergency.']
  is_experimental boolean [note: 'True if the service is considered experimental or investigational.']
  is_partial_approval boolean [note: 'Indicates whether only a portion of the requested service quantity was approved.']
  line_sequence varchar [note: 'Sequential order of the line within the prior authorization request.']
  notes varchar [note: 'Free‑text field for additional comments or special instructions from the reviewer.']
  place_of_service varchar [note: 'Location type where the service is to be rendered.']
  request_submitted_timestamp timestamp [note: 'Date‑time when the prior authorization request containing this line was submitted.']
  service_category varchar [note: 'Broad classification of the authorized service (e.g., inpatient, outpatient, DME, pharmacy).']
  unit_of_measure varchar [note: 'Measurement unit for the authorized quantity (e.g., tablets, sessions, days).']
  updated_timestamp timestamp [note: 'System timestamp of the most recent update to the service line record.']

  Note: 'Line-item detail for each service, procedure, or drug authorized within a PA request. Captures CPT/HCPCS code, ICD diagnosis code, authorized quantity, authorized units of service, service category (inpatient, outpatient, DME, pharmacy, behavioral health), place of service, authorized facility NPI, and approved date range. Supports partial approvals where only a subset of requested services are authorized.'
}

Table utilization.concurrent_review {
  concurrent_review_id varchar [pk, note: 'System-generated unique identifier for the concurrent review record.']
  audit_engagement_id varchar [note: 'Foreign key linking to compliance.audit_engagement. Business justification: Concurrent utilization reviews are often scoped within an audit engagement; the link tracks which engagement oversees each review.']
  contract_provider_contract_id varchar [note: 'Foreign key linking to contract.provider_contract. Business justification: Concurrent reviews validate inpatient services against provider contract terms including authorization requirements, LOS targets, payment methodology, and discharge planning obligations. Essential for']
  coordinator_id varchar [note: 'Identifier of the care coordinator assigned to the member for this episode.']
  group_id varchar [note: 'Foreign key linking to employer.employer_group. Business justification: Employers monitor concurrent reviews of their members; linking enables employer‑specific review metrics.']
  health_plan_id varchar [note: 'Foreign key linking to plan.health_plan. Business justification: Concurrent Review Utilization Management reports require linking each review to the member\'s health plan.']
  inpatient_admission_id varchar [note: 'Identifier of the inpatient admission linked to this review.']
  member_risk_score_id varchar [note: 'Foreign key linking to risk.member_risk_score. Business justification: Concurrent review LOS benchmarking and discharge planning must account for member risk profile and HCC burden. Risk-adjusted readmission_risk_score calculation and care coordination resource allocatio']
  member_subscriber_id varchar [note: 'Unique identifier of the member whose stay is under review.']
  network_service_area_id varchar [note: 'Foreign key linking to network.service_area. Business justification: Concurrent reviews must validate admitting facility is within member\'s covered service area for out-of-area authorization decisions. UM coordinators check service area boundaries when members are admi']
  pa_request_id varchar [note: 'Identifier of the originating prior‑authorization request.']
  plan_election_id varchar [note: 'Foreign key linking to enrollment.plan_election. Business justification: Concurrent reviews require direct access to member\'s current plan election for real-time benefit verification, authorization limit checks, and cost-sharing calculations during ongoing inpatient stays.']
  plan_id varchar [note: 'Foreign key linking to care.care_plan. Business justification: Inpatient concurrent reviews directly inform care plan updates, discharge planning, and post-acute service coordination. Standard clinical workflow for care management programs.']
  provider_id varchar [note: 'Foreign key linking to provider.provider_provider. Business justification: Connects concurrent review records to the admitting provider for LOS benchmarking and clinical oversight reporting.']
  provider_network_id varchar [note: 'Foreign key linking to network.provider_network. Business justification: Concurrent reviews require network validation for authorization and payment determination. UM nurses verify network participation status during inpatient stay reviews to determine coverage levels and ']
  um_case_id varchar [note: 'Identifier of the overarching UM case that this review belongs to.']
  actual_discharge_date date [note: 'Date the member actually left the hospital.']
  admission_date date [note: 'Date the member was admitted to the hospital.']
  approved_length_of_stay varchar [note: 'Maximum number of days approved for continued stay based on the review.']
  authorized_post_acute_service varchar [note: 'Post‑acute care service(s) approved during the review (e.g., physical therapy, home health).']
  benchmark_source varchar [note: 'Source of the LOS benchmark values.']
  benchmark_source_detail varchar [note: 'Free‑text description of the benchmark source (e.g., specific CMS report or Milliman model).']
  clinical_reviewer_npi varchar [note: 'NPI of the clinician performing the review.']
  concurrent_review_status varchar [note: 'Current state of the review workflow.']
  criteria_version varchar [note: 'Version of InterQual or MCG criteria applied.']
  current_length_of_stay varchar [note: 'Number of days the member has been hospitalized to date.']
  discharge_barriers varchar [note: 'Identified obstacles preventing timely discharge (e.g., equipment, placement).']
  discharge_destination varchar [note: 'Intended location after hospital discharge.']
  is_critical boolean [note: 'True if the review is flagged as critical due to high acuity or risk.']
  justification varchar [note: 'Narrative explanation for why continued stay is medically necessary.']
  los_benchmark_mean decimal(5,2) [note: 'Average LOS for the DRG or service line used as a benchmark.']
  los_benchmark_outlier_threshold decimal(5,2) [note: 'Threshold beyond which the stay is considered an outlier.']
  los_benchmark_target decimal(5,2) [note: 'Plan‑specific target LOS for the case.']
  next_review_date date [note: 'Scheduled date for the subsequent concurrent review.']
  planned_discharge_date date [note: 'Projected date for member discharge as determined by the reviewer.']
  readmission_risk_category varchar [note: 'Risk tier derived from the readmission risk score.']
  readmission_risk_score decimal(4,2) [note: 'Predictive score indicating likelihood of readmission within 30 days.']
  record_audit_created timestamp [note: 'Timestamp when the review record was first created in the system.']
  record_audit_updated timestamp [note: 'Timestamp of the most recent modification to the review record.']
  review_end_timestamp timestamp [note: 'Date‑time when the review was completed or closed.']
  review_notes varchar [note: 'Additional free‑text comments entered by the reviewer.']
  review_number varchar [note: 'Human‑readable unique code assigned to the review for tracking and communication.']
  review_start_timestamp timestamp [note: 'Date‑time when the concurrent review was initiated.']
  review_type varchar [note: 'Specifies whether the review is concurrent (ongoing) or retrospective.']
  social_work_involved boolean [note: 'Indicates whether a social worker was consulted for discharge planning.']

  Note: 'Manages inpatient concurrent review records for admitted members — the ongoing UM review process evaluating continued medical necessity during a hospital stay. Captures admission date, current and approved length of stay (LOS), LOS benchmarks by DRG (geometric/arithmetic mean LOS, plan-specific target, outlier threshold, benchmark source — CMS, Milliman, plan actuarial), next review date, clinical reviewer NPI, InterQual/MCG criteria version applied, continued stay justification. Includes integrated discharge planning: planned discharge date, discharge destination (home, SNF, LTAC, home health, hospice), post-acute services authorized, barriers to discharge, social work involvement, care coordinator assigned, actual discharge date, and readmission risk score. Links to the originating PA request, UM case, and inpatient admission.'
}

Table utilization.um_case {
  um_case_id varchar [pk, note: 'System-generated unique identifier for the UM case.']
  care_enrollment_id varchar [note: 'Foreign key linking to care.care_enrollment. Business justification: UM cases for enrolled members require tracking enrollment status for program-specific protocols, acuity-based review criteria, and care management reporting.']
  coordinator_id varchar [note: 'Foreign key linking to care.care_coordinator. Business justification: Case Management Process assigns a care coordinator to each utilization case; linking enables case‑to‑coordinator reporting and workload tracking.']
  inpatient_admission_id varchar [note: 'Foreign key linking to utilization.inpatient_admission. Business justification: For inpatient UM cases, the um_case (overarching workflow container) should directly reference the inpatient_admission it manages. While concurrent_review bridges um_case and inpatient_admission, a di']
  medical_policy_id varchar [note: 'Foreign key linking to utilization.medical_policy. Business justification: A UM case is the overarching workflow container for utilization management, and its clinical determinations are governed by medical policies. um_case currently stores clinical_criteria_set and clinica']
  member_identity_id varchar [note: 'Unique identifier of the member associated with the case.']
  member_risk_score_id varchar [note: 'Foreign key linking to risk.member_risk_score. Business justification: UM case prioritization, severity stratification, and care management resource allocation driven by member risk score. Case_priority and case_severity assignment require risk-adjusted clinical context ']
  network_service_area_id varchar [note: 'Foreign key linking to network.service_area. Business justification: UM cases track geographic service area to determine network adequacy compliance and out-of-area coverage rules. Case managers verify service area coverage when coordinating care across regions, especi']
  pa_request_id varchar [note: 'Foreign key linking to utilization.pa_request. Business justification: um_case may be initiated by a PA request; child (um_case) gets FK to parent (pa_request).']
  plan_id varchar [note: 'Foreign key linking to care.care_plan. Business justification: Case Management Dashboard needs to reference the member\'s care plan to align interventions and report case outcomes against the plan.']
  primary_provider_id varchar [note: 'Identifier of the provider who rendered the service under review.']
  appeal_indicator boolean [note: 'True if the case has been appealed.']
  assigned_nurse_name varchar [note: 'Full name of the UM nurse or case manager handling the case.']
  case_close_date date [note: 'Date the UM case was closed or completed; null if still open.']
  case_number varchar [note: 'Business-visible case number used for tracking and communication.']
  case_open_date date [note: 'Date the UM case was opened and became active.']
  case_priority varchar [note: 'Priority level assigned to the case for workload management.']
  case_severity varchar [note: 'Severity rating reflecting clinical urgency and complexity.']
  case_status varchar [note: 'Current lifecycle status of the UM case.']
  case_type varchar [note: 'Category of the case based on care setting or service type.']
  clinical_criteria_set varchar [note: 'Source set of clinical criteria applied (InterQual or MCG).']
  clinical_criteria_version varchar [note: 'Version identifier of the clinical criteria set used for the case.']
  compliance_flag boolean [note: 'Indicates whether the case meets NCQA UM accreditation requirements.']
  created_timestamp timestamp [note: 'Timestamp when the UM case record was first created in the system.']
  denial_reason_code varchar [note: 'Code indicating why a prior authorization or claim was denied.']
  denial_reason_description varchar [note: 'Textual explanation of the denial reason.']
  disposition_code varchar [note: 'Standard code representing the final outcome of the case.']
  disposition_description varchar [note: 'Human‑readable description of the case outcome.']
  length_of_stay_actual varchar [note: 'Observed length of stay for the episode, expressed in days.']
  length_of_stay_target varchar [note: 'Planned maximum length of stay for the episode, expressed in days.']
  notes varchar [note: 'Free‑text field for clinical or administrative comments.']
  primary_diagnosis_code varchar [note: 'ICD code representing the principal diagnosis driving the case.']
  primary_diagnosis_description varchar [note: 'Text description of the principal diagnosis.']
  primary_provider_npi varchar [note: 'National Provider Identifier of the primary provider.']
  prior_authorization_decision_date date [note: 'Date the prior authorization decision was rendered.']
  prior_authorization_number varchar [note: 'Reference number for the prior authorization request linked to the case.']
  prior_authorization_status varchar [note: 'Current status of the prior authorization request.']
  turnaround_time_days varchar [note: 'Number of days from case open to final disposition.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to the UM case record.']
  urgency_flag boolean [note: 'True if the case requires expedited review per clinical criteria.']

  Note: 'Master entity representing a utilization management (UM) case — the overarching workflow container grouping all UM activities (PA requests, concurrent reviews, retrospective reviews, P2P reviews, appeals) for a single member episode of care. Captures case type (inpatient, outpatient, behavioral health, DME, pharmacy), case open/close dates, assigned UM nurse or case manager, episode of care identifier, primary diagnosis, and case disposition. Enables end-to-end UM workflow tracking, workload management, and NCQA UM accreditation reporting.'
}

Table utilization.inpatient_admission {
  inpatient_admission_id varchar [pk, note: 'System-generated unique identifier for the inpatient admission record.']
  clinical_criteria_id varchar [note: 'Identifier of the specific clinical rule used for concurrent review.']
  coordinator_id varchar [note: 'Foreign key linking to care.coordinator. Business justification: Coordinators manage discharge planning, post-acute transitions, and readmission prevention for assigned members. Standard care management responsibility for inpatient episodes.']
  facility_id varchar [note: 'Foreign key linking to provider.facility. Business justification: Inpatient admissions occur at a specific facility. linking to provider.facility enables DRG benchmarking by facility type, trauma level, and accreditation status — core UM inpatient review and netw']
  member_risk_score_id varchar [note: 'Foreign key linking to risk.member_risk_score. Business justification: Inpatient admission authorization and DRG payment reconciliation requires member risk score for accurate expected_cost_amount calculation and risk-adjusted LOS benchmarking. Essential for payment accu']
  pa_request_id varchar [note: 'Foreign key linking to utilization.pa_request. Business justification: An inpatient admission subject to UM review is typically tied to a prior authorization request. inpatient_admission currently stores authorization_number and payer_authorization_status as free-text st']
  plan_election_id varchar [note: 'Foreign key linking to enrollment.plan_election. Business justification: Admissions require immediate plan benefit verification and authorization status at point of service. Direct link supports real-time eligibility checks and cost-sharing calculations for emergency/urgen']
  plan_id varchar [note: 'Foreign key linking to care.care_plan. Business justification: Admissions trigger mandatory care plan reviews and updates, especially for chronic condition programs. Required for discharge planning and readmission prevention workflows.']
  provider_id varchar [note: 'Foreign key linking to provider.provider. Business justification: Admission eligibility checks need the member\'s enrollment eligibility span to confirm benefit coverage dates, essential for clinical validation and regulatory audit of inpatient services.']
  actual_cost_amount decimal(12,2) [note: 'Final cost incurred for the admission after discharge.']
  actual_los_days varchar [note: 'Number of days the member actually stayed in the facility.']
  admission_date date [note: 'Date the member was admitted to the facility.']
  admission_number varchar [note: 'Business identifier assigned to the admission by the health plan.']
  admission_status varchar [note: 'Current lifecycle status of the admission.']
  admission_type varchar [note: 'Classification of the admission based on urgency.']
  authorization_number varchar [note: 'Unique identifier of the payer\'s authorization for this admission.']
  clinical_criteria_version varchar [note: 'Version of the clinical criteria set (e.g., InterQual v2023) applied to the admission.']
  created_timestamp timestamp [note: 'Timestamp when the admission record was first created in the system.']
  currency_code varchar [note: 'Three‑letter ISO currency code for cost fields.']
  denial_reason_code varchar [note: 'Standardized code representing why the admission was denied.']
  denial_reason_description varchar [note: 'Narrative description of the denial reason.']
  discharge_date date [note: 'Date the member was discharged from the facility.']
  discharge_disposition varchar [note: 'Post‑discharge destination of the member.']
  drg_code varchar [note: 'DRG assignment for the admission used for payment and benchmarking.']
  expected_cost_amount decimal(12,2) [note: 'Projected cost of the admission before services are rendered.']
  expected_los_days varchar [note: 'Projected number of days the member is expected to stay, based on clinical criteria.']
  is_critical_care boolean [note: 'Indicates whether the admission involved critical care services.']
  is_readmission boolean [note: 'True if the admission is a readmission within the defined look‑back period.']
  los_benchmark_met_flag boolean [note: 'Indicates whether actual LOS met the benchmark target.']
  los_target_days varchar [note: 'Benchmark target days for LOS based on plan and diagnosis.']
  payer_authorization_status varchar [note: 'Current status of the payer\'s prior‑authorization for the admission.']
  physician_npi varchar [note: 'NPI of the physician responsible for the admission.']
  primary_diagnosis_code varchar [note: 'ICD code representing the principal diagnosis for the admission.']
  readmission_within_30_days boolean [note: 'True if the admission occurs within 30 days of a prior discharge.']
  review_decision varchar [note: 'Outcome of the utilization management review.']
  review_decision_date date [note: 'Date the UM reviewer rendered a decision.']
  review_status varchar [note: 'Current status of the utilization management review.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the admission record.']

  Note: 'UM-managed inpatient admission record for admissions subject to concurrent review. Captures admitting facility NPI, admitting physician NPI, admission date, admission type (elective, urgent, emergent), primary admitting diagnosis (ICD), DRG assignment, expected LOS, actual discharge date, discharge disposition (home, SNF, rehab, expired), and payer authorization status. Serves as the anchor for concurrent review workflows and LOS benchmark comparisons. Distinct from the claim domain\'s institutional claim — this is the clinical/UM view of the admission, not the billing view.'
}

Table utilization.medical_policy {
  medical_policy_id varchar [pk, note: 'System-generated unique identifier for the medical policy record.']
  clinical_criteria_id varchar [note: 'Foreign key linking to utilization.clinical_criteria. Business justification: Medical policies are backed by specific clinical criteria sets (InterQual, MCG). medical_policy currently stores clinical_criteria_source (e.g., \'InterQual\', \'MCG\') and clinical_criteria_version as st']
  compliance_regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: Medical policies must align with regulatory obligations; linking provides traceability for compliance audits.']
  parent_medical_policy_id varchar [note: 'Self-referencing FK on medical_policy (parent_medical_policy_id)']
  applicable_cpt_codes varchar [note: 'Comma‑separated list of CPT procedure codes covered under the policy.']
  applicable_hcpcs_codes varchar [note: 'Comma‑separated list of HCPCS codes (including drugs) covered under the policy.']
  clinical_category varchar [note: 'High‑level clinical grouping (e.g., cardiology, orthopedics) to which the policy applies.']
  clinical_criteria_version varchar [note: 'Version identifier of the clinical criteria set applied.']
  compliance_status varchar [note: 'Current compliance posture of the policy with respect to external regulations.']
  coverage_limit_amount decimal(12,2) [note: 'Monetary cap applied to the total covered amount for the policy period.']
  coverage_limit_currency varchar [note: 'Three‑letter ISO currency code for the coverage limit amount.']
  coverage_limit_units varchar [note: 'Unit of measure for the coverage limit (e.g., visits, days).']
  created_timestamp timestamp [note: 'Date‑time when the policy record was first created in the system.']
  effective_from date [note: 'Date on which the policy becomes binding for members.']
  effective_until date [note: 'Date on which the policy ceases to be binding; null for open‑ended policies.']
  is_emergency_covered boolean [note: 'Indicates whether emergency services are covered without prior authorization.']
  is_exempt boolean [note: 'True if the policy includes exemptions for specific services or member groups.']
  is_experimental_covered boolean [note: 'True if experimental or investigational services are permitted under the policy.']
  is_prior_auth_required boolean [note: 'Indicates whether a prior authorization must be obtained for services covered by this policy.']
  is_telehealth_covered boolean [note: 'Indicates whether telehealth services are covered under the policy.']
  last_reviewed_by varchar [note: 'Identifier of the user who performed the most recent policy review.']
  last_reviewed_timestamp timestamp [note: 'Date‑time when the policy was last reviewed for clinical or regulatory updates.']
  medical_policy_status varchar [note: 'Current lifecycle state of the policy.']
  notes varchar [note: 'Free‑form text for additional comments, special considerations, or audit remarks.']
  policy_name varchar [note: 'Human‑readable name of the policy for reporting and UI display.']
  policy_number varchar [note: 'External business identifier assigned to the policy, used in member communications and claim adjudication.']
  policy_type varchar [note: 'Category of the policy indicating the primary clinical domain it governs.']
  prior_auth_approval_timeframe_days varchar [note: 'Maximum number of calendar days allowed to approve a prior authorization request.']
  regulatory_reference varchar [note: 'Citation to the regulatory rule or guideline that mandates this policy.']
  updated_timestamp timestamp [note: 'Date‑time of the most recent modification to the policy record.']
  version_effective_date date [note: 'Date when this version of the policy became effective.']
  version_expiration_date date [note: 'Date when this version of the policy was superseded or retired.']
  version_number varchar [note: 'Sequential version identifier for policy revisions.']
  created_by varchar [note: 'Identifier of the user or system that created the policy record.']

  Note: 'Master reference for medical policies and clinical criteria used in utilization management decisions — including medical necessity criteria, clinical guidelines, evidence-based medicine references, and policy effective dates. Captures policy ID, policy name, clinical category, applicable CPT/HCPCS codes, review criteria source (InterQual, MCG, internal), and version history.'
}

Table utilization.clinical_criteria {
  clinical_criteria_id varchar [pk, note: 'Primary key for clinical_criteria']
  parent_clinical_criteria_id varchar [note: 'Self-referencing FK on clinical_criteria (parent_clinical_criteria_id)']
  regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: Clinical criteria must reference regulatory obligations (CMS NCDs/LCDs, state mandates) that legally require specific coverage rules. Accreditation and regulatory audits verify criteria align with app']
  created_timestamp timestamp [note: 'Timestamp when the record was first created in the system.']
  criteria_category varchar [note: 'Broad category indicating the clinical setting or context of the criteria.']
  criteria_code varchar [note: 'Unique code assigned to the clinical criteria, used for lookup and integration.']
  criteria_description varchar [note: 'Detailed description of the clinical criteria, including its purpose and application.']
  criteria_detail varchar [note: 'Textual or structured detail of the rule or logic that defines the criteria.']
  criteria_effective_date date [note: 'Date when the clinical criteria becomes effective and applicable.']
  criteria_expiration_date date [note: 'Date when the clinical criteria is no longer valid or applicable.']
  criteria_limit_unit varchar [note: 'Unit of measurement for the limit value (e.g., days, dollars).']
  criteria_limit_value decimal(10,2) [note: 'Numeric limit value used in the criteria rule (e.g., maximum allowed).']
  criteria_name varchar [note: 'Human-readable name of the clinical criteria.']
  criteria_notes varchar [note: 'Additional notes or comments about the clinical criteria.']
  criteria_reference varchar [note: 'Reference to external standard or guideline that the criteria aligns with.']
  criteria_rule_expression varchar [note: 'Formal expression or logic that defines how the criteria is evaluated.']
  criteria_source varchar [note: 'Originating system or authority that defines the clinical criteria.']
  criteria_status varchar [note: 'Current lifecycle status of the clinical criteria.']
  criteria_subcategory varchar [note: 'More specific classification within the category to refine the criteria context.']
  criteria_threshold_unit varchar [note: 'Unit of measurement for the threshold value (e.g., days, dollars).']
  criteria_threshold_value decimal(10,2) [note: 'Numeric threshold value used in the criteria rule (e.g., maximum days, minimum cost).']
  criteria_type varchar [note: 'Category of the clinical criteria indicating the type of clinical element it applies to.']
  criteria_version varchar [note: 'Version identifier of the clinical criteria to track updates and revisions.']
  record_status varchar [note: 'Current status of the record for data lifecycle management.']
  updated_by varchar [note: 'Identifier of the user or process that last updated the record.']
  updated_timestamp timestamp [note: 'Timestamp when the record was last updated in the system.']
  created_by varchar [note: 'Identifier of the user or process that created the record.']

  Note: 'Master reference table for clinical_criteria. Referenced by clinical_criteria_id.'
}

Table care.program {
  program_id varchar [pk, note: 'System-generated unique identifier for the care program.']
  accreditation_program_id varchar [note: 'Foreign key linking to compliance.accreditation_program. Business justification: Care management programs (disease management, care coordination, utilization management) are evaluated during NCQA and URAC accreditation surveys. Accreditation programs assess whether care programs m']
  facility_id varchar [note: 'Foreign key linking to provider.facility. Business justification: Disease management and case management programs are frequently delivered at or affiliated with specific facilities (hospital-based diabetes programs, SNF transition programs). Program administrators m']
  group_practice_id varchar [note: 'Foreign key linking to provider.group_practice. Business justification: CMS requires linking each care program to its owning provider group for program ownership reporting and reimbursement audits.']
  provider_id varchar [note: 'Foreign key linking to provider.provider_provider. Business justification: Regulatory and operational policies assign a specific provider as program manager, enabling accountability and performance tracking.']
  rate_development_id varchar [note: 'Foreign key linking to risk.rate_development. Business justification: Care management programs (CCM, TCM, disease management) are factored into actuarial rate development as cost trend offsets and administrative loading components. Required for rate filing documentation']
  regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: Program cost allocation to a specific risk pool is required for risk‑adjustment and financial reporting.']
  accreditation_body varchar [note: 'Organization that provides accreditation for the program.']
  accreditation_status varchar [note: 'Current accreditation state of the program (e.g., NCQA, URAC).']
  category varchar [note: 'More granular category within the program type (e.g., diabetes, CHF, COPD).']
  clinical_protocol varchar [note: 'Standardized clinical pathway or guideline applied within the program.']
  code varchar [note: 'Internal code used to reference the program in operational systems.']
  contact_email varchar [note: 'Primary email address for program inquiries.']
  contact_phone varchar [note: 'Primary phone number for program inquiries.']
  created_timestamp timestamp [note: 'Date‑time when the program record was first created.']
  data_source_system varchar [note: 'Operational system that provides the master program data (e.g., Casenet TruCare).']
  description varchar [note: 'Detailed narrative describing the program\'s purpose, services, and scope.']
  eligibility_criteria varchar [note: 'Business rules that determine member eligibility for enrollment in the program.']
  end_date date [note: 'Date the program is retired or no longer offered (nullable for open‑ended).']
  enrollment_cap varchar [note: 'Maximum number of members allowed to enroll in the program.']
  enrollment_current varchar [note: 'Number of members currently enrolled.']
  enrollment_end_date date [note: 'Date when enrollment closes for the program.']
  enrollment_start_date date [note: 'Date when enrollment opens for the program.']
  evidence_source varchar [note: 'Reference to the clinical study or guideline that validates the program.']
  hcc_included varchar [note: 'Comma‑separated list of HCC codes that are counted toward the program\'s risk adjustment.']
  hcc_version varchar [note: 'Version of the HCC model used for the program (e.g., 2024).']
  is_evidence_based boolean [note: 'Indicates whether the program is supported by clinical evidence.']
  last_review_date date [note: 'Date the program was last reviewed for clinical relevance or compliance.']
  line_of_business varchar [note: 'Business line to which the program applies.']
  name varchar [note: 'Human‑readable name of the care program.']
  outcome_actual varchar [note: 'Most recent observed value for the outcome measure.']
  outcome_measure varchar [note: 'Key performance indicator used to evaluate program effectiveness.']
  outcome_target varchar [note: 'Target value or threshold for the outcome measure.']
  program_status varchar [note: 'Current lifecycle status of the program.']
  program_type varchar [note: 'Broad classification of the program offering.']
  review_frequency varchar [note: 'How often the program is scheduled for review.']
  risk_adjustment_factor decimal(5,4) [note: 'Factor used for risk‑adjusted payment calculations (e.g., 0.1234).']
  start_date date [note: 'Date the program becomes effective and available to members.']
  target_population varchar [note: 'Demographic or clinical segment the program is designed for.']
  updated_timestamp timestamp [note: 'Date‑time of the most recent update to the program record.']
  version_number varchar [note: 'Version identifier for the program definition.']

  Note: 'Master registry of all care management, disease management, and case management programs offered by the health plan — including chronic condition programs (diabetes, CHF, COPD, asthma), complex case management, maternity management, behavioral health programs, and population health initiatives. Tracks program type, eligibility criteria, clinical protocols, accreditation standards (NCQA/URAC), program status, and line-of-business applicability. Source: Casenet TruCare or Altruista program configuration.'
}

Table care.care_enrollment {
  care_enrollment_id varchar [pk, note: 'System-generated unique identifier for each care enrollment record.']
  coordinator_id varchar [note: 'Identifier of the care coordinator assigned to the member for this enrollment.']
  eligibility_span_id varchar [note: 'Foreign key linking to member.eligibility_span. Business justification: Care managers must confirm active eligibility before enrolling a member in a care program. Linking care_enrollment to the specific eligibility_span validates coverage at enrollment time and supports r']
  member_enrollment_id varchar [note: 'SSOT reference to member.enrollment (single source of truth)']
  member_risk_score_id varchar [note: 'Foreign key linking to risk.member_risk_score. Business justification: Underwriting uses a member\'s risk score at enrollment; linking provides audit trail for premium determination.']
  member_risk_tier_id varchar [note: 'Foreign key linking to care.member_risk_tier. Business justification: Care enrollments are frequently triggered by a member\'s risk tier assignment — high-risk members are enrolled in disease management or case management programs. Linking care_enrollment to member_risk_']
  plan_election_id varchar [note: 'Foreign key linking to enrollment.plan_election. Business justification: Care program enrollment requires active health plan coverage. Care management systems verify benefits, cost-sharing, and covered services from the member\'s plan election to determine program eligibili']
  policy_id varchar [note: 'Foreign key linking to member.policy. Business justification: Care management program enrollment must be authorized under a specific policy. Insurers track which policy authorizes care management services for billing, utilization management, and audit purposes. ']
  program_id varchar [note: 'Identifier of the care, disease, or case management program to which the member is enrolled.']
  acuity_level varchar [note: 'Clinical acuity assigned to the member for this program.']
  care_manager_assigned_date date [note: 'Date the care manager was officially assigned to the member.']
  consent_status varchar [note: 'Member\'s consent status for participation and data sharing within the program.']
  created_timestamp timestamp [note: 'Timestamp when the enrollment record was first created in the system.']
  disenrollment_date date [note: 'Actual date the member left the program.']
  effective_end_date date [note: 'Planned termination date of the enrollment (null if open‑ended).']
  effective_start_date date [note: 'Date when the enrollment becomes effective.']
  enrollment_number varchar [note: 'Business identifier assigned to the enrollment, used in operational reporting and member communications.']
  enrollment_source varchar [note: 'Origin of the enrollment request, indicating how the member entered the program.']
  enrollment_status varchar [note: 'Current lifecycle state of the enrollment.']
  enrollment_type varchar [note: 'Category of care program (e.g., disease management).']
  hcc_score decimal(5,2) [note: 'Aggregated HCC score associated with the member at enrollment.']
  notes varchar [note: 'Free‑form notes entered by care staff regarding the enrollment.']
  program_tier varchar [note: 'Level of service intensity offered by the program.']
  reason varchar [note: 'Business reason or clinical trigger for enrolling the member.']
  risk_score decimal(5,2) [note: 'Quantitative risk score used for prioritizing outreach (0‑100).']
  status_reason varchar [note: 'Explanation for the current enrollment status (e.g., member request, clinical criteria).']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the enrollment record.']

  Note: 'Tracks member enrollment into specific care management, disease management, or case management programs — capturing enrollment date, disenrollment date, enrollment source (outreach, referral, self-referral, claims-triggered, HRA-triggered), consent status, program tier, enrollment status, and acuity level. Represents the active participation record linking a member to a care program. Coordinator assignment details are maintained on the care_coordinator product. Distinct from health plan enrollment (owned by the enrollment domain). Source: Casenet TruCare or Altruista.'
}

Table care.care_plan {
  care_plan_id varchar [pk, note: 'System-generated unique identifier for the care plan record.']
  care_enrollment_id varchar [note: 'Foreign key linking to care.care_enrollment. Business justification: A care plan is created for a member within the context of a specific care enrollment episode. Linking care_plan to care_enrollment establishes the direct parent-child relationship between the enrollme']
  coordinator_id varchar [note: 'Identifier of the care coordinator assigned to manage the plan.']
  eligibility_span_id varchar [note: 'Foreign key linking to member.eligibility_span. Business justification: A care plan is executed within a specific coverage period. Linking care_plan to eligibility_span enables care managers to validate that planned interventions fall within active coverage, supports care']
  member_risk_score_id varchar [note: 'Foreign key linking to risk.member_risk_score. Business justification: Care plans are developed based on member risk scores; care managers require the triggering risk assessment for plan design and goal setting. Essential for care plan development workflow and audit trai']
  member_risk_tier_id varchar [note: 'Foreign key linking to care.member_risk_tier. Business justification: A care plan is stratified and designed based on the member\'s risk tier at the time of plan creation. Linking care_plan to member_risk_tier captures the risk context that shaped the plan\'s intervention']
  plan_election_id varchar [note: 'Foreign key linking to enrollment.plan_election. Business justification: Care plans are developed within the context of member\'s current coverage. Care coordinators reference plan benefits, formulary coverage, network restrictions, and cost-sharing when creating treatment ']
  practice_location_id varchar [note: 'Foreign key linking to provider.practice_location. Business justification: Care plans are executed at a specific practice location — the member\'s PCP or specialist office. Care coordinators require the physical location for outreach, referral coordination, and care plan deli']
  primary_provider_id varchar [note: 'Foreign key linking to provider.provider_provider. Business justification: Care plans must be overseen by a designated primary care provider to ensure care coordination and meet NCQA quality measures.']
  program_id varchar [note: 'Foreign key linking to care.program. Business justification: Plan belongs to a program; adding program_id FK establishes parent-child relationship and enables join to program attributes.']
  barriers_to_care varchar [note: 'Identified obstacles that may impede goal achievement (e.g., transportation, language).']
  care_plan_status varchar [note: 'Current lifecycle status of the care plan.']
  creation_timestamp timestamp [note: 'Timestamp when the care plan record was first created in the system.']
  effective_end_date date [note: 'Date when the care plan expires or is terminated; null if open‑ended.']
  effective_start_date date [note: 'Date when the care plan becomes effective for the member.']
  high_risk_flag boolean [note: 'Indicates whether the member meets high‑risk criteria for intensive management.']
  last_updated_timestamp timestamp [note: 'Timestamp of the most recent update to the care plan.']
  plan_name varchar [note: 'Descriptive name of the care plan, e.g., "Diabetes Management Plan".']
  plan_number varchar [note: 'External business identifier assigned to the care plan, used in member communications and reporting.']
  plan_type varchar [note: 'Category of the care plan indicating its primary focus area.']
  privacy_consent_flag boolean [note: 'Indicates whether the member has consented to share health information for care planning.']
  progress_notes varchar [note: 'Free‑text notes documenting progress toward the goal.']
  version varchar [note: 'Incremental version number tracking revisions to the care plan.']

  Note: 'Individualized care plan created for a member enrolled in a care or case management program — documenting clinical and behavioral goals (goal description, category, target value, target date, status: active/achieved/abandoned, progress notes), interventions, barriers to care, target dates, care coordinator assignments, plan status, and clinical/progress notes. Goals are modeled as embedded detail records within the care plan with independent status tracking, enabling multi-dimensional progress measurement across clinical, behavioral, and SDOH goal categories. Single source of truth for all care plan goal lifecycle management. Supports longitudinal tracking of member health outcomes. Aligns with NCQA care management standards and CMS chronic care management (CCM) requirements. Source: Casenet TruCare or Altruista.'
}

Table care.plan_goal {
  plan_goal_id varchar [pk, note: 'System-generated unique identifier for the care plan goal.']
  coordinator_id varchar [note: 'Identifier of the staff member responsible for overseeing the goal.']
  gap_id varchar [note: 'Foreign key linking to care.gap. Business justification: Care plan goals are often created specifically to address identified care gaps — for example, a goal to complete a mammogram screening closes a preventive care gap. Linking plan_goal to gap establishe']
  plan_id varchar [note: 'Identifier of the care plan to which this goal belongs.']
  actual_date date [note: 'Date when the actual value was recorded.']
  actual_value decimal(10,2) [note: 'Measured value achieved toward the goal.']
  compliance_flag boolean [note: 'Indicates whether the goal complies with clinical guidelines or regulatory requirements.']
  created_timestamp timestamp [note: 'Timestamp when the goal record was first created in the system.']
  goal_category varchar [note: 'Classification of the goal indicating its domain (e.g., clinical, behavioral, social determinant).']
  goal_code varchar [note: 'Business identifier or code assigned to the goal for reference and reporting.']
  goal_name varchar [note: 'Human‑readable name or title of the care plan goal.']
  measurement_type varchar [note: 'Source or method of the measurement (e.g., lab result, vital sign).']
  plan_goal_status varchar [note: 'Current lifecycle status of the goal.']
  priority varchar [note: 'Priority level assigned to the goal to guide care team focus.']
  progress_notes varchar [note: 'Free‑text notes documenting progress, barriers, or interventions related to the goal.']
  risk_score decimal(5,2) [note: 'Calculated risk score associated with the goal (e.g., based on HCC/RAF models).']
  target_date date [note: 'Date by which the goal is expected to be met.']
  target_unit varchar [note: 'Unit of measure for the target value.']
  target_value decimal(10,2) [note: 'Numeric target the member should achieve (e.g., HbA1c 7.0).']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the goal record.']

  Note: 'Individual clinical or behavioral goals defined within a member care plan — including goal description, goal category (clinical, behavioral, social determinants), target value, target date, goal status (active, achieved, abandoned), and progress notes. Each goal has its own lifecycle independent of the parent care plan, enabling granular tracking of member progress across multiple care dimensions.'
}

Table care.gap {
  gap_id varchar [pk, note: 'Unique identifier for the care gap record.']
  hedis_measure_id varchar [note: 'Foreign key linking to care.hedis_measure. Business justification: gap currently stores hedis_measure_code as a denormalized STRING. hedis_measure is the authoritative reference catalog for HEDIS measures. Adding hedis_measure_id FK normalizes this relationship, allo']
  hedis_result_id varchar [note: 'Foreign key linking to care.hedis_result. Business justification: Care gaps are frequently identified from HEDIS measure results — when a member fails to meet a numerator criterion, a gap is opened. Linking gap to hedis_result establishes the traceability from the m']
  member_identity_id varchar [note: 'Foreign key linking to member.identity. Business justification: HEDIS gap closure requires confirming member eligibility at the identity level during the measurement year. Gap already links to member.subscriber, but NCQA/CMS denominator validation operates on memb']
  member_risk_score_id varchar [note: 'Foreign key linking to risk.member_risk_score. Business justification: Care gap prioritization incorporates the member\'s risk score; FK ties gap records to the underlying risk score.']
  practice_location_id varchar [note: 'Foreign key linking to provider.practice_location. Business justification: Gap closure workflows require knowing which practice location is responsible for delivering missing care. Outreach teams route gap closure tasks to specific office locations. A care gap management rep']
  program_id varchar [note: 'Foreign key linking to care.program. Business justification: Care gaps are tracked within the context of specific care management programs — for example, a HEDIS gap for diabetes eye exam is tracked under the Diabetes Disease Management program. Linking gap to ']
  vbc_contract_id varchar [note: 'Foreign key linking to contract.vbc_contract. Business justification: Care gaps (HEDIS measures, quality metrics) directly impact VBC contract performance, shared savings calculations, and quality gates. Business need: track gap closure against VBC targets, calculate qu']
  actual_resolution_date date [note: 'Date when the care gap was actually resolved.']
  clinical_category varchar [note: 'Clinical domain or condition associated with the gap (e.g., diabetes, cardiovascular).']
  close_date date [note: 'Date when the care gap was resolved or closed (nullable if still open).']
  closure_method varchar [note: 'Method by which the care gap was closed.']
  created_timestamp timestamp [note: 'Timestamp when the care gap record was created in the lakehouse.']
  description varchar [note: 'Narrative description of the identified care gap.']
  documentation_status varchar [note: 'Status of required documentation for the care gap.']
  gap_status varchar [note: 'Current lifecycle status of the care gap.']
  gap_type varchar [note: 'Category of the care gap (e.g., preventive service, chronic condition management).']
  is_critical boolean [note: 'Indicates whether the gap is considered critical for member health.']
  measure_target_value decimal(18,2) [note: 'Expected target value for the measure (e.g., HbA1c <7%).']
  open_date date [note: 'Date when the care gap was first identified.']
  priority_level varchar [note: 'Business-assigned priority for addressing the care gap.']
  risk_score decimal(5,2) [note: 'Quantitative risk score associated with the gap (e.g., based on HCC/RAF).']
  target_date date [note: 'Desired date by which the care gap should be closed.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the care gap record.']

  Note: 'Registry of identified care gaps for members — preventive services, chronic condition management measures, and HEDIS-aligned quality measures that have not been completed (e.g., HbA1c testing, mammography, colorectal cancer screening, medication adherence). Tracks gap type, HEDIS measure code, gap open date, gap close date, closure method (claim, supplemental data, attestation), and gap status. Core to HEDIS performance and Star Ratings improvement programs.'
}

Table care.coordinator {
  coordinator_id varchar [pk, note: 'Surrogate primary key uniquely identifying each care coordinator record.']
  provider_id varchar [note: 'Foreign key linking to provider.provider. Business justification: Credentialing staff for care coordination requires linking each coordinator to their credential record for compliance reporting and audit of licensing/sanctions.']
  assigned_lob varchar [note: 'Business line for which the coordinator primarily provides services.']
  caseload_capacity varchar [note: 'Maximum number of members the coordinator can actively manage.']
  caseload_weight decimal(5,2) [note: 'Weighted factor reflecting case complexity for workload balancing.']
  certification_codes varchar [note: 'Comma‑separated list of professional certifications (e.g., CCM, ACM, CPH).']
  coordinator_status varchar [note: 'Current lifecycle status of the coordinator record.']
  current_caseload_count varchar [note: 'Number of members currently assigned to the coordinator.']
  email_address varchar [note: 'Primary email address used for secure communications with the coordinator.']
  employment_status varchar [note: 'Current employment state of the coordinator.']
  first_name varchar [note: 'Given name of the care coordinator.']
  full_name varchar [note: 'Legal full name of the care coordinator as used in member communications and credentialing.']
  hire_date date [note: 'Date the coordinator was hired by the organization.']
  last_name varchar [note: 'Family name of the care coordinator.']
  last_training_date date [note: 'Date of the most recent mandatory training completed by the coordinator.']
  notes varchar [note: 'Free‑form notes entered by supervisors or administrators about the coordinator.']
  organization_unit varchar [note: 'Department or unit within the health plan where the coordinator is assigned.']
  phone_number varchar [note: 'Primary telephone number for reaching the coordinator.']
  primary_contact_method varchar [note: 'Preferred channel for contacting the coordinator.']
  record_audit_created timestamp [note: 'Timestamp when the coordinator record was first created in the system.']
  record_audit_updated timestamp [note: 'Timestamp of the most recent update to the coordinator record.']
  role_type varchar [note: 'Functional role of the coordinator within the care management domain.']
  specialty_area varchar [note: 'Clinical specialty or disease focus of the coordinator.']
  termination_date date [note: 'Date the coordinator\'s employment ended, if applicable.']
  training_certifications varchar [note: 'Comma‑separated list of completed training programs (e.g., HEDIS, STAR).']

  Note: 'Master record for care coordinators, case managers, disease management nurses, and health coaches — capturing demographics, credentials (RN, LCSW, CHW), certifications (CCM, ACM), caseload capacity, specialty focus areas, assigned LOB, active status, and supervisor hierarchy. Single source of truth for coordinator-to-member assignment history including assignment date, assignment type (primary, backup, specialist), assignment reason, caseload weight, assignment status, reassignment/handoff tracking, and continuity-of-care documentation. Enables caseload management, workload balancing, continuity-of-care reporting, and coordinator performance analytics. Source: Casenet TruCare or Altruista workforce configuration.'
}

Table care.condition_registry {
  condition_registry_id varchar [pk, note: 'System-generated unique identifier for each condition registry record.']
  diagnosing_provider_id varchar [note: 'Foreign key linking to provider.provider. Business justification: Condition registry entries must capture the diagnosing or managing provider for clinical accuracy, risk adjustment audit trails, and care coordination. Role-prefixed \'diagnosing_provider_id\' distingui']
  facility_id varchar [note: 'Foreign key linking to provider.facility. Business justification: Conditions identified during inpatient stays or facility-based encounters must be attributed to the facility for risk adjustment (HCC coding), care coordination, and population health reporting. Hospi']
  hcc_mapping_id varchar [note: 'Foreign key linking to risk.hcc_mapping. Business justification: Chronic condition registry entries must link to HCC mapping for risk adjustment factor calculation and CMS RAPS/EDPS submission. Required for RAF score computation, payment reconciliation, and RADV au']
  member_identity_id varchar [note: 'Unique identifier of the member to whom the condition applies.']
  plan_election_id varchar [note: 'Foreign key linking to enrollment.plan_election. Business justification: Chronic conditions tracked in the registry must be linked to coverage periods for risk adjustment. HCC coding, RAF score calculation, and CMS risk adjustment submissions require associating conditions']
  plan_id varchar [note: 'Identifier of the care plan linked to this condition, if any.']
  active_flag boolean [note: 'Indicates whether the condition is currently active for the member.']
  condition_category varchar [note: 'Business classification of the condition (e.g., HCC‑mapped, HEDIS chronic, behavioral health).']
  condition_code varchar [note: 'Standard ICD-10 diagnosis code representing the clinical condition.']
  condition_description varchar [note: 'Human‑readable description of the condition.']
  confirmation_status varchar [note: 'Current confirmation state of the condition record.']
  created_timestamp timestamp [note: 'Timestamp when the condition record was first created.']
  data_quality_status varchar [note: 'Current data quality assessment of the condition record.']
  effective_end_date date [note: 'Date the condition ceased to be effective (null if still active).']
  effective_start_date date [note: 'Date the condition became effective for care program eligibility.']
  identification_date date [note: 'Date the condition was first identified for the member.']
  identification_method varchar [note: 'Method used to identify the condition for the member.']
  is_chronic boolean [note: 'Flag indicating whether the condition is considered chronic for HEDIS and risk adjustment.']
  last_review_date date [note: 'Date the condition record was last reviewed for accuracy.']
  notes varchar [note: 'Free‑text clinical notes or comments about the condition.']
  onset_date date [note: 'Date when the condition first manifested.']
  population_segment varchar [note: 'Segment of the member population based on the condition\'s risk level.']
  resolution_date date [note: 'Date when the condition was resolved or considered inactive.']
  risk_adjustment_flag boolean [note: 'Indicates if the condition contributes to risk‑adjusted payments.']
  severity varchar [note: 'Clinical severity level of the condition.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the condition record.']

  Note: 'Chronic condition registry identifying members with specific diagnosed conditions — including ICD-10 condition code, condition category (HCC-mapped, HEDIS chronic condition, behavioral health), identification method (claims-based, EHR, provider attestation, HRA), identification date, confirmation status, and active/inactive flag. Serves as the authoritative clinical condition roster within the care domain for care program targeting, population health stratification, and HEDIS measure eligibility determination. References the risk domain for authoritative HCC/RAF scoring. Source: Casenet TruCare or Altruista clinical data.'
}

Table care.hedis_measure {
  hedis_measure_id varchar [pk, note: 'Unique identifier for the HEDIS measure. [_canonical_skip_reason: REFERENCE_LOOKUP - catalog of HEDIS quality measures]']
  accreditation_program_id varchar [note: 'Foreign key linking to compliance.accreditation_program. Business justification: NCQA HEDIS Compliance Audits validate that health plans correctly implement HEDIS measures. Each accreditation engagement reviews specific measures for specification compliance. Links measure definiti']
  compliance_regulatory_obligation_id varchar [note: 'add column compliance_regulatory_obligation_id (BIGINT) with FK to compliance.compliance_regulatory_obligation.compliance_regulatory_obligation_id - HEDIS measures are regulatory quality requirements']
  created_timestamp timestamp [note: 'Timestamp when the measure record was first created in the data lake.']
  data_collection_methodology varchar [note: 'Method used to collect data for the measure (administrative, hybrid, or survey).']
  denominator_definition varchar [note: 'Exact definition of the denominator component of the measure.']
  effective_date date [note: 'Date when the measure became effective for reporting.']
  eligible_population_criteria varchar [note: 'Eligibility rules that define the member cohort for the measure.']
  exclusion_criteria varchar [note: 'Conditions or member attributes that exclude a member from the denominator.']
  last_updated_timestamp timestamp [note: 'Timestamp of the most recent update to the measure record.']
  measure_code varchar [note: 'Official NCQA code that uniquely identifies the measure.']
  measure_denominator_logic varchar [note: 'Detailed logical expression or algorithm used to compute the denominator.']
  measure_description varchar [note: 'Full textual description of what the measure evaluates.']
  measure_domain varchar [note: 'High‑level domain of the measure (e.g., effectiveness of care, access/availability, utilization).']
  measure_exclusion_logic varchar [note: 'Detailed logical expression defining exclusions from the denominator.']
  measure_last_reviewed_date date [note: 'Date when the measure definition was last reviewed for accuracy.']
  measure_last_updated_by varchar [note: 'User or system that performed the most recent update.']
  measure_name varchar [note: 'Descriptive name of the HEDIS quality measure.']
  measure_national_benchmark decimal(5,2) [note: 'National average performance for the measure (percentage).']
  measure_notes varchar [note: 'Free‑form notes or comments about the measure.']
  measure_numerator_logic varchar [note: 'Detailed logical expression or algorithm used to compute the numerator.']
  measure_owner varchar [note: 'Business unit or team responsible for the measure.']
  measure_related_hcc varchar [note: 'Comma‑separated list of Hierarchical Condition Category (HCC) codes relevant to the measure.']
  measure_related_raf varchar [note: 'Comma‑separated list of Risk Adjustment Factor (RAF) variables linked to the measure.']
  measure_reporting_frequency varchar [note: 'How often the measure is reported (annual, semi‑annual, quarterly).']
  measure_scoring_method varchar [note: 'Method used to calculate the final score (e.g., rate, percentage, binary).']
  measure_star_rating_impact varchar [note: 'Explanation of how the measure influences Medicare Star Ratings.']
  measure_state_benchmark decimal(5,2) [note: 'State‑level average performance for the measure (percentage).']
  measure_status varchar [note: 'Current lifecycle status of the measure.']
  measure_target_value decimal(10,2) [note: 'Target performance value or threshold for the measure.']
  measure_url varchar [note: 'Link to the official documentation or specification for the measure.']
  measurement_year varchar [note: 'Calendar year for which the measure is defined.']
  numerator_definition varchar [note: 'Exact definition of the numerator component of the measure.']
  retirement_date date [note: 'Date when the measure was retired or superseded (null if still active).']
  version_number varchar [note: 'Version of the measure definition, incremented on each change.']

  Note: 'Reference catalog of HEDIS (Healthcare Effectiveness Data and Information Set) quality measures maintained by NCQA — including measure ID, measure name, measure domain (effectiveness of care, access/availability, utilization), measurement year, eligible population criteria, numerator definition, denominator definition, exclusion criteria, and data collection methodology (administrative, hybrid, survey). Authoritative reference for HEDIS performance tracking and Star Ratings.'
}

Table care.hedis_result {
  hedis_result_id varchar [pk, note: 'System-generated unique identifier for each HEDIS result record.']
  eligibility_span_id varchar [note: 'Foreign key linking to member.eligibility_span. Business justification: NCQA HEDIS denominator logic requires validating the specific eligibility span that qualified the member for measurement. hedis_result has member_identity_id but no direct eligibility_span reference. ']
  hedis_measure_id varchar [note: 'Standard code for the HEDIS quality measure (e.g., HM-001).']
  member_identity_id varchar [note: 'Unique identifier for the member to whom the HEDIS result applies.']
  member_risk_score_id varchar [note: 'Foreign key linking to risk.member_risk_score. Business justification: HEDIS quality measure results correlate with member risk profiles for Star Ratings analysis and quality-adjusted payment optimization. Enables stratified quality reporting by risk tier and identifies ']
  practice_location_id varchar [note: 'Foreign key linking to provider.practice_location. Business justification: HEDIS quality results must be attributed to specific practice locations for geographic quality reporting, network performance analysis, and provider-site-level quality improvement initiatives. Regulat']
  provider_id varchar [note: 'Identifier of the provider associated with the source claim or service.']
  specialty_id varchar [note: 'Foreign key linking to provider.specialty. Business justification: HEDIS measures are specialty-specific (diabetic eye exam→ophthalmology, colorectal screening→gastroenterology). Linking hedis_result to specialty enables specialty-level quality performance reporting ']
  vbc_contract_id varchar [note: 'Foreign key linking to contract.vbc_contract. Business justification: HEDIS results are primary performance metrics for VBC contracts, determining shared savings eligibility and quality gate achievement. Business need: VBC reconciliation, quality score calculation, shar']
  audit_created timestamp [note: 'Timestamp when the HEDIS result record was first created in the lakehouse.']
  audit_updated timestamp [note: 'Timestamp of the most recent update to the HEDIS result record.']
  collection_method varchar [note: 'Methodology used to collect the underlying data for the measure.']
  compliance_status varchar [note: 'Overall compliance outcome for the member on this measure.']
  data_source varchar [note: 'Origin of the data used to determine the HEDIS result.']
  denominator_criteria_met boolean [note: 'Indicates whether the member satisfied the denominator condition (typically eligibility).']
  eligibility_criteria varchar [note: 'Logical definition of the member population eligible for the measure.']
  exclusion_criteria varchar [note: 'Specific criteria that triggered the member\'s exclusion.']
  exclusion_reason varchar [note: 'Reason or code describing why the member was excluded.']
  is_excluded boolean [note: 'True if the member is excluded from the measure based on exclusion criteria.']
  measure_category varchar [note: 'Category grouping of the measure (e.g., preventive, chronic).']
  measure_score decimal(5,2) [note: 'Numeric score assigned to the member for the measure (if applicable).']
  measure_type varchar [note: 'Classification of the measure as process, outcome, or structure.']
  measure_version varchar [note: 'Version or edition of the measure as published by NCQA.']
  measurement_year varchar [note: 'Calendar year for which the HEDIS measurement is reported.']
  numerator_criteria_met boolean [note: 'Indicates whether the member satisfied the numerator condition for the measure.']
  result_timestamp timestamp [note: 'Date and time when the HEDIS result was calculated.']
  source_record_type varchar [note: 'Type of the source record that supplied data for the result.']

  Note: 'Single source of truth for HEDIS (Healthcare Effectiveness Data and Information Set) quality measure definitions and member-level compliance results. Contains the authoritative NCQA-published measure catalog (measure ID, name, domain: effectiveness of care/access/availability/utilization, measurement year, eligible population criteria, numerator/denominator definitions, exclusion criteria, data collection methodology: administrative/hybrid/survey) and member-level results indicating whether each member met numerator criteria for a given measurement year. Tracks data source (claim, lab, supplemental, medical record), compliance status (compliant, non-compliant, excluded), and hybrid audit trail. Aggregated to produce plan-level HEDIS rates submitted to NCQA for Star Ratings, accreditation, and quality bonus payments.'
}

Table care.member_risk_tier {
  member_risk_tier_id varchar [pk, note: 'System‑generated unique identifier for each risk‑tier record.']
  capitation_arrangement_id varchar [note: 'Foreign key linking to contract.capitation_arrangement. Business justification: Member risk tiers determine capitation payment rates (PMPM varies by risk tier/HCC score) and member attribution to capitated providers. Business need: calculate risk-adjusted capitation payments, val']
  eligibility_span_id varchar [note: 'Foreign key linking to member.eligibility_span. Business justification: Risk tiers are assigned per eligibility period for premium rating, care management targeting, and ACA risk adjustment reporting. member_risk_tier links to member.identity but not to the specific eligi']
  member_identity_id varchar [note: 'Unique identifier of the member to which the tier assignment applies.']
  recommended_care_program_id varchar [note: 'Foreign key linking to care.program. Business justification: member_risk_tier currently stores recommended_care_program as a denormalized STRING. program is the authoritative master registry of all care management programs. Adding recommended_care_program_id FK']
  source_member_risk_score_id varchar [note: 'Foreign key linking to risk.member_risk_score. Business justification: Risk tier assignments are derived from specific risk score calculations; linking to the source score enables tier assignment audit trail, recalibration validation, and appeals resolution. Required for']
  assignment_date date [note: 'Date the tier was assigned to the member.']
  assignment_method varchar [note: 'Method used to assign the tier to a member.']
  chronic_condition_flag boolean [note: 'True if the member has at least one chronic condition flagged.']
  claims_count_last_year varchar [note: 'Number of claims submitted by the member in the prior 12 months.']
  created_timestamp timestamp [note: 'Timestamp when the tier record was first created.']
  demographic_group varchar [note: 'Broad demographic segment of the member.']
  effective_from date [note: 'Date when the tier definition becomes effective.']
  effective_until date [note: 'Date when the tier definition expires (null for open‑ended).']
  inclusion_criteria varchar [note: 'Business rules that determine member eligibility for this tier.']
  is_current boolean [note: 'Indicates whether this row represents the member\'s current active tier.']
  member_risk_tier_status varchar [note: 'Current lifecycle status of the tier definition.']
  model_type varchar [note: 'Type of model used to generate the tier assignment.']
  next_reassessment_date date [note: 'Planned date for the next risk‑tier reassessment.']
  notes varchar [note: 'Free‑form comments or audit notes.']
  pmpm_cost_band varchar [note: 'Per‑Member‑Per‑Month cost band associated with the tier.']
  risk_factor_weight decimal(5,2) [note: 'Weight applied to the risk factor in the predictive model.']
  risk_score_source varchar [note: 'Origin of the risk score used for the assignment.']
  segment_description varchar [note: 'Detailed description of the segment criteria.']
  segment_name varchar [note: 'Name of the population segment definition linked to this tier.']
  tier_band varchar [note: 'Broad risk band classification.']
  tier_code varchar [note: 'Business identifier/code used to reference the tier in downstream systems.']
  tier_name varchar [note: 'Human‑readable name of the risk tier (e.g., "High Risk").']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the tier record.']
  version_number varchar [note: 'Version of the tier definition for change tracking.']

  Note: 'Member-level risk tier assignment and population health stratification — containing population segment definitions (segment name, stratification model: predictive risk model/HCC-based/claims-based, risk tier bands: low/rising risk/high/catastrophic, inclusion criteria, recommended care program, PMPM cost band, effective date) and member-specific tier assignments (risk score, assignment date, assignment method: automated model/manual override/clinical review, next reassessment date). Single source of truth for both population segment configuration and member-level risk tier history. Tracks risk tier changes over time to support longitudinal population health management and care program targeting. Distinct from CMS RAF scores (owned by the risk domain) — this covers all LOBs and internal stratification models. Source: Casenet TruCare or Altruista population health module.'
}

Table network.provider_network {
  provider_network_id varchar [pk, note: 'Unique identifier for the provider network. Primary key for the provider network entity.']
  aco_participation_flag boolean [note: 'Indicates whether this network includes participation in ACO arrangements. True if ACO providers are part of the network, False otherwise.']
  cms_network_code varchar [note: 'The unique identifier assigned by CMS for Medicare Advantage and Part D networks. Required for all Medicare networks. Format: one letter followed by five digits.']
  created_timestamp timestamp [note: 'The timestamp when this provider network record was first created in the system. Used for audit trail and data lineage.']
  effective_date date [note: 'The date when this provider network becomes active and available for member enrollment and provider participation. Start of the network\'s operational lifecycle.']
  facility_count varchar [note: 'The number of hospitals, skilled nursing facilities, and other institutional providers in this network. Used for facility access adequacy assessments.']
  geographic_footprint varchar [note: 'Comma-separated list of states, counties, or service areas where this network operates. Defines the geographic scope of provider availability and member eligibility.']
  last_adequacy_review_date date [note: 'The date of the most recent internal or regulatory network adequacy review. Used to track compliance with annual review requirements.']
  line_of_business varchar [note: 'The primary business segment this network serves. Commercial (employer-sponsored), Medicare (federal beneficiaries), Medicaid (state beneficiaries), Exchange (ACA marketplace), ASO (Administrative Services Only self-funded).']
  member_enrollment_count varchar [note: 'The current number of members enrolled in plans associated with this network. Used for provider-to-member ratio calculations and capacity planning.']
  network_adequacy_filing_date date [note: 'The date when the most recent network adequacy filing was submitted to CMS or state regulators. Required annually for Medicare Advantage and Exchange plans.']
  network_adequacy_status varchar [note: 'Regulatory assessment of whether the network meets time-and-distance and provider-to-member ratio standards. Adequate (meets all standards), Deficient (fails standards), Conditional (approved with corrective action plan), Pending Review (under regulatory evaluation).']
  network_code varchar [note: 'Short alphanumeric code used to identify the network in operational systems, claims processing, and provider directories. Externally-known business identifier.']
  network_description varchar [note: 'Detailed narrative description of the network\'s design, provider composition, geographic coverage, and unique features. Used in member materials and regulatory filings.']
  network_directory_url varchar [note: 'The web URL where members and providers can access the online provider directory for this network. Required for ACA and Medicare Advantage compliance.']
  network_name varchar [note: 'The official business name of the provider network (e.g., \'HMO Narrow Network\', \'PPO Broad Network\', \'Medicare Advantage Network\'). Human-readable identifier used in member communications and plan documents.']
  network_status varchar [note: 'Current operational status of the provider network. Active (accepting enrollments and claims), Inactive (closed to new enrollments), Suspended (temporary hold), Pending (awaiting regulatory approval), Terminated (permanently closed).']
  network_type varchar [note: 'The structural classification of the provider network. HMO (Health Maintenance Organization) requires PCP and referrals; PPO (Preferred Provider Organization) allows out-of-network access; EPO (Exclusive Provider Organization) no out-of-network except emergency; POS (Point of Service) hybrid model; HDHP (High Deductible Health Plan) network; ACO (Accountable Care Organization) value-based network.']
  next_adequacy_review_date date [note: 'The scheduled date for the next network adequacy review. Typically annual for Medicare Advantage and Exchange networks.']
  out_of_network_coverage_flag boolean [note: 'Indicates whether the network allows members to access out-of-network providers with cost-sharing. True for PPO and some POS networks, False for HMO and EPO.']
  pcp_count varchar [note: 'The number of primary care physicians in this network. Key metric for network adequacy and member-to-PCP ratio calculations.']
  pcp_required_flag boolean [note: 'Indicates whether members enrolled in this network are required to select a primary care physician. True for HMO and POS networks, False for PPO and EPO.']
  provider_count varchar [note: 'The total number of unique providers (physicians, facilities, ancillary) participating in this network. Used for network adequacy calculations and member communications.']
  referral_required_flag boolean [note: 'Indicates whether specialist visits require a referral from the PCP. True for HMO networks, False for PPO, EPO, and most POS networks.']
  regulatory_approval_date date [note: 'The date when the network received regulatory approval from CMS or state Department of Insurance to begin operations.']
  service_area_type varchar [note: 'The geographic granularity at which this network is defined. Statewide (entire state), Regional (multi-county region), County (county-level), ZIP (ZIP code level), National (multi-state or nationwide).']
  specialist_count varchar [note: 'The number of specialist physicians in this network. Used for specialty access adequacy assessments.']
  star_rating decimal(2,1) [note: 'The CMS Star Rating for Medicare Advantage networks, ranging from 1.0 to 5.0 stars. Based on quality measures including network access, member satisfaction, and clinical outcomes. Null for non-Medicare networks.']
  termination_date date [note: 'The date when this provider network ceases operations and is no longer available for new enrollments. Nullable for open-ended networks. Existing members may have run-out periods.']
  tier_classification varchar [note: 'The tiering structure of the network for cost-sharing purposes. Tier 1 (lowest cost-sharing, narrow network), Tier 2 (moderate cost-sharing), Tier 3 (highest cost-sharing, broadest access), Single Tier (no tiering), Tiered (multi-tier structure).']
  updated_by varchar [note: 'The user ID or system identifier of the person or process that last modified this network record. Used for audit and accountability.']
  updated_timestamp timestamp [note: 'The timestamp when this provider network record was last modified. Used for audit trail and change tracking.']
  vbc_arrangement_flag boolean [note: 'Indicates whether this network includes value-based care arrangements with providers (e.g., shared savings, bundled payments, capitation). True if VBC arrangements exist, False otherwise.']
  created_by varchar [note: 'The user ID or system identifier of the person or process that created this network record. Used for audit and accountability.']

  Note: 'Master entity representing a named provider network — the structural grouping of providers under a specific network product (e.g., HMO Narrow Network, PPO Broad Network, Medicare Advantage Network). Owns network identity, network type (HMO, PPO, EPO, POS), line of business association, effective/termination dates, geographic footprint, CMS network ID, NCQA accreditation status, and tier classification. SSOT for network identity — distinct from plan (benefit design), provider (provider identity), and contract (reimbursement terms).'
}

Table network.tier {
  tier_id varchar [pk, note: 'Unique identifier for the network tier. Primary key.']
  facility_id varchar [note: 'Foreign key linking to provider.facility. Business justification: Facilities are assigned to network tiers (Tier 1 preferred hospital vs Tier 2 standard). Drives differential member cost-sharing, benefit design, steerage strategies, and value-based contracting arran']
  provider_network_id varchar [note: 'Foreign key linking to network.provider_network. Business justification: Network tier definitions are scoped to a specific provider network; adding provider_network_id FK establishes the parent relationship.']
  code varchar [note: 'Business identifier code for the network tier (e.g., TIER1, TIER2, TIER3, OON). Used in system integrations and member communications.']
  coinsurance_differential_percentage decimal(5,2) [note: 'Percentage coinsurance differential for this tier. Used when cost_share_differential_type is coinsurance or hybrid. Null if not applicable.']
  copay_differential_amount decimal(10,2) [note: 'Fixed dollar copay differential for this tier compared to baseline tier. Used when cost_share_differential_type is copay or hybrid. Null if not applicable.']
  cost_share_differential_type varchar [note: 'Type of cost-sharing differential applied to this tier (copay, coinsurance, deductible, hybrid, or none). Determines how member out-of-pocket (OOP) costs are calculated.']
  created_timestamp timestamp [note: 'Timestamp when this network tier record was first created in the system.']
  deductible_applies_flag boolean [note: 'Indicates whether the plan deductible applies to services rendered by providers in this tier before cost-sharing begins.']
  display_label varchar [note: 'Member-facing display label for the tier shown in EOB, member portal, and Summary of Benefits and Coverage (SBC). May differ from internal tier name for clarity.']
  effective_date date [note: 'Date when this network tier configuration becomes active and applicable to member cost-sharing and provider network assignments.']
  facility_type_applicability varchar [note: 'Defines which facility types this tier applies to (all, hospital, Skilled Nursing Facility (SNF), Durable Medical Equipment (DME), lab, imaging, pharmacy, home health, or custom list). Used to segment tier assignment rules by facility type. [ENUM-REF-CANDIDATE: all|hospital|snf|dme|lab|imaging|pharmacy|home_health|custom — 9 candidates stripped; promote to reference product]']
  internal_notes varchar [note: 'Internal operational notes or comments about this tier configuration. Not visible to members or external parties.']
  last_updated_by varchar [note: 'User identifier or system account that last modified this network tier record.']
  last_updated_timestamp timestamp [note: 'Timestamp when this network tier record was last modified.']
  member_steerage_incentive_description varchar [note: 'Description of any member steerage incentives or rewards offered for using providers in this tier (e.g., reduced cost-sharing, waived deductible, wellness credits).']
  name varchar [note: 'Official name of the network tier as defined in plan documents and contracts.']
  network_adequacy_credit_flag boolean [note: 'Indicates whether providers in this tier count toward CMS network adequacy standards and state Department of Insurance (DOI) access requirements.']
  oop_max_applies_flag boolean [note: 'Indicates whether member cost-sharing for this tier counts toward the plan Maximum Out-of-Pocket (MOOP) limit.']
  prior_authorization_required_flag boolean [note: 'Indicates whether services from providers in this tier require Prior Authorization (PA) or Utilization Management (UM) review.']
  quality_tier_flag boolean [note: 'Indicates whether this tier is designated as a quality tier based on HEDIS, STAR ratings, or other quality performance metrics.']
  rank varchar [note: 'Numeric ranking of the tier indicating preference and cost-share level. Lower rank indicates preferred tier with lower member cost-sharing (e.g., 1=Tier 1 Preferred, 2=Tier 2 Standard, 3=Tier 3 Specialty, 99=Out-of-Network).']
  referral_required_flag boolean [note: 'Indicates whether members must obtain a referral from their Primary Care Provider (PCP) to access providers in this tier. Typically applies to HMO and POS plans.']
  regulatory_filing_reference varchar [note: 'Reference number or identifier for the state Department of Insurance (DOI) or CMS filing that approved this tier structure. Used for compliance audit trails.']
  sbc_disclosure_text varchar [note: 'Standardized disclosure text for this tier that appears in the Summary of Benefits and Coverage (SBC) document provided to members under ACA requirements.']
  specialty_applicability varchar [note: 'Defines which provider specialties this tier applies to (all, primary care only, specialist only, facility, ancillary, behavioral health, or custom list). Used to segment tier assignment rules by provider type. [ENUM-REF-CANDIDATE: all|primary_care|specialist|facility|ancillary|behavioral_health|custom — 7 candidates stripped; promote to reference product]']
  termination_date date [note: 'Date when this network tier configuration is terminated and no longer applicable. Null if currently active.']
  tier_status varchar [note: 'Current lifecycle status of the network tier configuration (active, inactive, pending approval, suspended, or retired).']
  tier_type varchar [note: 'Classification of the tier indicating its strategic purpose within the network design (preferred, standard, specialty, out-of-network, value-based, narrow network).']
  vbc_arrangement_eligible_flag boolean [note: 'Indicates whether this tier is eligible for Value-Based Care (VBC) or Accountable Care Organization (ACO) performance incentives and shared savings arrangements.']

  Note: 'Defines the tier structure within a provider network — Tier 1 (preferred/lowest cost-share), Tier 2 (standard), Tier 3 (specialty/higher cost-share), and out-of-network designations. Captures tier name, tier rank, cost-share differential rules, member-facing display label, and applicability by specialty or facility type. Used to drive member cost-sharing calculations and EOB generation. Distinct from contract fee schedules (owned by contract domain).'
}

Table network.plan_association {
  plan_association_id varchar [pk, note: 'Unique identifier for the plan association record. Primary key for this entity.']
  capitation_arrangement_id varchar [note: 'Foreign key linking to contract.capitation_arrangement. Business justification: When plans use capitated payment models, plan associations must reference the specific capitation arrangement governing PMPM rates and risk-sharing. Critical for financial reconciliation, member attri']
  health_plan_id varchar [note: 'Reference to the health plan product that is associated with this provider network. Links to the plan and benefit domain\'s plan entity.']
  network_service_area_id varchar [note: 'Reference to the geographic service area where this plan-network association is valid. Defines the counties, ZIP codes, or regions where members can access this network under this plan.']
  provider_contract_id varchar [note: 'Foreign key linking to contract.provider_contract. Business justification: Plan associations bind health plans to provider networks and must reference the underlying provider contracts that legally enable network participation. Required for regulatory filings, network adequa']
  provider_network_id varchar [note: 'Reference to the provider network being associated with the health plan product. Links to the network domain\'s network configuration entity.']
  tier_id varchar [note: 'Foreign key linking to network.tier. Business justification: plan_association.network_tier is a denormalized STRING referencing the tier structure associated with this plan-network pairing. The tier table is the authoritative reference for tier definitions with']
  vbc_contract_id varchar [note: 'Foreign key linking to contract.vbc_contract. Business justification: Value-based care contracts are specialized provider arrangements that plan associations must reference for performance tracking, quality measurement, and member attribution to ACOs or VBC programs. Es']
  aco_participation_flag boolean [note: 'Indicates whether this plan-network association includes participation in an Accountable Care Organization arrangement. True means ACO providers are included in this network for this plan; false means no ACO participation.']
  adequacy_certification_date date [note: 'The date when this plan-network association was certified as meeting network adequacy requirements by the regulatory authority or internal compliance review.']
  adequacy_review_date date [note: 'The date of the most recent network adequacy review or assessment for this plan-network association. Used to track compliance monitoring cycles.']
  association_code varchar [note: 'Business identifier code for this plan-to-network association, used in eligibility verification (270/271 EDI transactions) and claims adjudication routing.']
  association_name varchar [note: 'Human-readable name for this plan-to-network association, typically combining plan name and network name for operational reference.']
  association_type varchar [note: 'Classification of the network\'s role for this plan. Primary indicates the main network for member access; supplemental provides additional coverage; specialty covers specific service categories; out-of-area supports members outside primary service area; reciprocal represents shared network arrangements; tertiary provides fallback coverage.']
  auto_assignment_eligible_flag boolean [note: 'Indicates whether members can be automatically assigned to providers in this network under this plan. Relevant for Medicaid and some Medicare programs that use auto-assignment for members who do not actively select a provider. True means eligible for auto-assignment; false means member must actively select.']
  contract_reference_number varchar [note: 'Reference to the master contract or agreement document that governs this plan-network association. Links to contract management systems for terms, rates, and legal provisions.']
  created_timestamp timestamp [note: 'The date and time when this plan-network association record was first created in the system. Used for audit trail and data lineage tracking.']
  directory_publication_flag boolean [note: 'Indicates whether providers in this network for this plan should be published in member-facing provider directories and online search tools. True means include in directory; false means exclude (e.g., for internal or specialty networks).']
  effective_date date [note: 'The date when this plan-to-network association becomes active and members can begin accessing providers in this network under this plan.']
  lob varchar [note: 'The line of business this plan-network association serves. Commercial covers employer-sponsored and individual plans; Medicare includes Medicare Advantage; Medicaid covers state programs; Marketplace represents ACA exchange plans; dual eligible serves Medicare-Medicaid beneficiaries; CHIP covers Children\'s Health Insurance Program.']
  market_segment varchar [note: 'The market segment this plan-network association targets. Individual covers direct-to-consumer; small group typically 2-50 employees; large group 51-999 employees; jumbo group 1000+ employees; government includes federal and state employee plans; student covers university and college plans.']
  member_count varchar [note: 'The number of members currently enrolled in this plan who have access to this network. Used for network adequacy calculations and capacity planning.']
  network_adequacy_status varchar [note: 'Indicates whether this plan-network association meets regulatory network adequacy standards for provider access, time-and-distance requirements, and specialty coverage. Compliant meets all standards; non-compliant fails requirements; under review is being evaluated; exempt has regulatory waiver; conditional meets standards with restrictions.']
  notes varchar [note: 'Free-text field for additional comments, special instructions, or contextual information about this plan-network association. Used for operational notes that do not fit structured fields.']
  out_of_network_coverage_flag boolean [note: 'Indicates whether this plan provides any coverage for out-of-network services when this network is the member\'s assigned network. True means out-of-network benefits exist (typical for PPO); false means no out-of-network coverage (typical for HMO and EPO).']
  pcp_selection_required_flag boolean [note: 'Indicates whether members enrolled in this plan with this network must select a primary care provider. Typically true for HMO and POS plans; false for PPO and EPO plans.']
  plan_association_status varchar [note: 'Current lifecycle status of the plan-network association. Active indicates operational; inactive means temporarily disabled; pending awaits regulatory approval or contract execution; suspended indicates temporary hold; terminated means permanently ended.']
  prior_authorization_required_flag boolean [note: 'Indicates whether services rendered by providers in this network under this plan require prior authorization. True means PA is required; false means no PA requirement. This is a network-level default that may be overridden by specific service or provider rules.']
  priority_rank varchar [note: 'Numeric ranking indicating the priority order of this network when multiple networks are associated with the same plan. Lower numbers indicate higher priority. Used in claims adjudication routing when a member has access to multiple networks.']
  provider_count varchar [note: 'The number of unique providers (individual practitioners and facilities) participating in this network for this plan. Used for network adequacy reporting and member communications.']
  referral_required_flag boolean [note: 'Indicates whether members must obtain a referral from their primary care provider to access specialists in this network under this plan. Typically true for HMO plans; false for PPO and EPO plans.']
  regulatory_approval_date date [note: 'The date when the regulatory authority (CMS or state DOI) approved this plan-network association for use. Required before the association can become effective.']
  star_rating_impact_flag boolean [note: 'Indicates whether provider performance in this network impacts the plan\'s CMS Star Ratings. Applicable primarily to Medicare Advantage plans. True means network performance affects Star metrics; false means no Star impact.']
  termination_date date [note: 'The date when this plan-to-network association ends. Null indicates an open-ended association. After this date, members can no longer access providers in this network under this plan for new services.']
  updated_by varchar [note: 'The user identifier or system account that last modified this plan-network association record. Used for audit trail and accountability.']
  updated_timestamp timestamp [note: 'The date and time when this plan-network association record was last modified. Used for audit trail and change tracking.']
  vbc_arrangement_flag boolean [note: 'Indicates whether this plan-network association operates under a value-based care payment model. True means providers in this network are reimbursed based on quality and outcomes; false means traditional fee-for-service.']
  created_by varchar [note: 'The user identifier or system account that created this plan-network association record. Used for audit trail and accountability.']

  Note: 'Association entity linking a provider network to one or more health plan products, capturing the effective period, LOB, market segment (individual, small group, large group, Medicare, Medicaid), and whether the network is the primary or supplemental network for that plan. Enables plan-to-network resolution for eligibility verification (270/271 EDI) and claims adjudication routing. Owned by the network domain as the structural bridge between network configurations and plan offerings.'
}

Table network.adequacy_standard {
  adequacy_standard_id varchar [pk, note: 'Unique identifier for the network adequacy standard record. Primary key.']
  compliance_regulatory_obligation_id varchar [note: 'add column compliance_regulatory_obligation_id (BIGINT) with FK to compliance.compliance_regulatory_obligation.compliance_regulatory_obligation_id - adequacy standards derive from regulatory requirements']
  adequacy_standard_status varchar [note: 'Current lifecycle status of this adequacy standard: active (currently enforced), inactive (not currently enforced), proposed (pending regulatory approval), superseded (replaced by newer standard), or under-review (being evaluated for changes).']
  after_hours_availability_required boolean [note: 'Indicates whether after-hours availability (evenings, weekends, holidays) is required for this specialty and geography. True if after-hours access is mandated, false otherwise.']
  after_hours_definition varchar [note: 'Definition of what constitutes after-hours for this standard (e.g., weekdays after 5pm, weekends, 24/7 access). Null if after-hours availability is not required.']
  appointment_type varchar [note: 'Type of appointment this wait-time standard applies to: routine (non-urgent care), urgent (same-day/next-day need), preventive (wellness visits), behavioral-health (mental health/substance abuse), specialist (referral appointments), or emergency. Null if standard is not appointment-access based.']
  compliance_reporting_frequency varchar [note: 'How often compliance with this standard must be assessed and reported to regulators: annual, semi-annual, quarterly, monthly, or on-demand (event-triggered).']
  created_timestamp timestamp [note: 'Timestamp when this adequacy standard record was first created in the system. Used for audit trail and data lineage.']
  effective_date date [note: 'Date when this adequacy standard becomes effective and must be met. Standards change over time as regulations evolve.']
  exception_criteria varchar [note: 'Conditions under which an exception or waiver to this standard may be granted (e.g., provider shortage area designation, rural exception, temporary hardship). Null if no exceptions allowed.']
  geographic_classification varchar [note: 'Geographic area classification for which this standard applies: urban (metropolitan areas), suburban (surrounding metro areas), rural (non-metropolitan), or frontier (very low population density areas). Standards vary by geography.']
  last_updated_timestamp timestamp [note: 'Timestamp when this adequacy standard record was last modified. Used for audit trail and change tracking.']
  line_of_business varchar [note: 'Health insurance line of business this standard applies to: medicare-advantage (MA plans), medicaid (state programs), commercial (employer-sponsored), marketplace (ACA exchange plans), dual-eligible (Medicare-Medicaid), or all (applies to all LOBs).']
  maximum_distance_miles decimal(8,2) [note: 'Maximum allowable distance in miles from member residence to nearest in-network provider of this specialty in this geographic area. Null if standard is not distance-based.']
  maximum_travel_time_minutes varchar [note: 'Maximum allowable travel time in minutes from member residence to nearest in-network provider of this specialty in this geographic area. Null if standard is not time-based.']
  maximum_wait_time_days varchar [note: 'Maximum allowable wait time in days from appointment request to appointment date for this appointment type and specialty. Null if standard is not appointment-access based.']
  measurement_methodology varchar [note: 'Description of how compliance with this standard is measured (e.g., GeoAccess analysis, member survey, claims-based appointment tracking, provider attestation). Defines the assessment approach.']
  minimum_provider_count varchar [note: 'Absolute minimum number of providers of this specialty required in the network for this geography, regardless of member count. Null if not applicable.']
  notes varchar [note: 'Additional notes, clarifications, or special instructions related to this adequacy standard. May include implementation guidance, historical context, or regulatory interpretation.']
  penalty_for_non_compliance varchar [note: 'Description of regulatory penalties or consequences for failing to meet this standard (e.g., corrective action plan, fines, enrollment suspension, Star rating impact). Null if no specific penalty defined.']
  plan_type varchar [note: 'Type of health plan this standard applies to: HMO (Health Maintenance Organization), PPO (Preferred Provider Organization), EPO (Exclusive Provider Organization), POS (Point of Service), HDHP (High Deductible Health Plan), or all (applies to all plan types). Standards may vary by plan structure.']
  provider_to_member_ratio varchar [note: 'Required ratio of providers to members for this specialty and geography, expressed as ratio string (e.g., 1:2000 for PCPs, 1:5000 for specialists). Null if standard is not ratio-based.']
  regulatory_source varchar [note: 'Governing body or regulatory authority that mandates this standard: CMS (Centers for Medicare and Medicaid Services), state-DOI (State Department of Insurance), NCQA (National Committee for Quality Assurance), URAC, ACA (Affordable Care Act), or internal (company-defined standard exceeding regulatory minimums).']
  service_area_type varchar [note: 'Geographic unit for which this standard is defined: county (county-level), zip (ZIP code level), state (state-wide), region (multi-state region), or national (nationwide standard).']
  specialty_category varchar [note: 'Provider specialty or facility type this standard applies to (e.g., PCP, cardiology, behavioral-health, hospital, SNF, DME). May be broad category or specific specialty code.']
  standard_category varchar [note: 'Classification of the adequacy standard type: time-distance (geographic access), provider-ratio (provider-to-member ratios), appointment-access (wait time standards), after-hours (availability requirements), telehealth-equivalency (virtual care standards), or network-composition (network mix requirements).']
  standard_code varchar [note: 'Business identifier code for the adequacy standard (e.g., PCP_URBAN_TIME, BH_RURAL_RATIO). Used for external reference and reporting.']
  standard_name varchar [note: 'Human-readable name of the adequacy standard (e.g., Primary Care Physician Urban Time-Distance Standard).']
  standard_version varchar [note: 'Version identifier for this standard, used to track changes over time (e.g., 2024.1, v3.0). Supports historical analysis and regulatory audit trails.']
  telehealth_equivalency_allowed boolean [note: 'Indicates whether telehealth/virtual care providers can be counted toward meeting this adequacy standard. True if telehealth equivalency is permitted, false if only in-person providers count.']
  telehealth_percentage_cap decimal(5,2) [note: 'Maximum percentage of the adequacy requirement that can be met through telehealth providers (e.g., 25.00 means up to 25% of required providers can be telehealth-only). Null if no cap or telehealth not allowed.']
  termination_date date [note: 'Date when this adequacy standard is no longer in effect, either due to regulatory change or supersession by a new standard. Null if currently active with no planned end date.']
  threshold_percentage decimal(5,2) [note: 'Percentage of members or geographic area that must meet this standard (e.g., 90.00 means 90% of members must have access within the specified time/distance). Used for compliance measurement.']

  Note: 'Reference entity defining all network compliance standards by specialty, facility type, and geographic area — encompassing time-distance standards (e.g., 30 miles/30 minutes for PCPs), provider-to-member ratios, appointment access wait-time standards (routine, urgent, preventive, behavioral health), after-hours availability requirements, and telehealth equivalency rules. Captures regulatory source (CMS, state DOI, NCQA, URAC), standard category (time-distance, provider-ratio, appointment-access, after-hours, telehealth-equivalency), specialty category, geographic classification (urban, suburban, rural, frontier), maximum wait time in days, threshold values, and after-hours availability flag. This is the single source of truth for all network adequacy and access compliance standards — both geographic access (time-distance, ratios) and appointment access (wait times, after-hours). Used to evaluate compliance in adequacy assessments, access surveys, and CMS/state regulatory filings.'
}

Table network.adequacy_assessment {
  adequacy_assessment_id varchar [pk, note: 'Unique identifier for the network adequacy assessment record. Primary key.']
  adequacy_standard_id varchar [note: 'Foreign key linking to network.adequacy_standard. Business justification: Each adequacy assessment applies a specific adequacy standard; linking via adequacy_standard_id enables reference to the standard definition.']
  audit_finding_id varchar [note: 'Foreign key linking to compliance.audit_finding. Business justification: Network adequacy assessments that identify gaps (gap_identified_flag=true, gap_severity populated) generate formal audit findings requiring remediation tracking. Assessors document deficiencies as aud']
  compliance_regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: Adequacy assessments are performed to meet a specific regulatory obligation for network adequacy compliance.']
  contract_provider_contract_id varchar [note: 'Foreign key linking to contract.provider_contract. Business justification: Adequacy assessments are performed per contract to verify network adequacy obligations; link enables contract‑level performance dashboards.']
  dispensing_pharmacy_id varchar [note: 'Foreign key linking to pharmacy.dispensing_pharmacy. Business justification: CMS Part D and state regulations require pharmacy-specific network adequacy assessments evaluating dispensing pharmacy coverage within service areas. Adequacy assessments must reference specific dispe']
  facility_id varchar [note: 'Foreign key linking to provider.facility. Business justification: Adequacy assessments evaluate facility availability (hospital beds, emergency services) within service areas. Required for state/federal network adequacy filings, measuring compliance with facility ac']
  health_plan_id varchar [note: 'Identifier of the health plan associated with this network adequacy assessment.']
  network_service_area_id varchar [note: 'Identifier of the geographic service area evaluated in this assessment.']
  practice_location_id varchar [note: 'Foreign key linking to provider.practice_location. Business justification: Adequacy assessments measure time/distance access from member populations to specific practice locations. Core regulatory activity for CMS/state network adequacy certification, identifying geographic ']
  provider_network_id varchar [note: 'Identifier of the provider network being assessed for adequacy compliance.']
  accepting_new_patients_flag boolean [note: 'Indicates whether providers in the assessed specialty or facility type are accepting new patients. True if accepting, False otherwise.']
  appointment_type_requested varchar [note: 'Type of appointment requested during mystery shopper or survey assessment: routine care, urgent care, preventive visit, follow-up visit, new patient intake, or specialist referral.']
  assessment_date date [note: 'Date on which the network adequacy assessment was conducted or completed.']
  assessment_number varchar [note: 'Business identifier for the adequacy assessment, used for external reference and regulatory submissions.']
  assessment_period_end_date date [note: 'End date of the evaluation period covered by this assessment.']
  assessment_period_start_date date [note: 'Start date of the evaluation period covered by this assessment.']
  assessment_type varchar [note: 'Type of network compliance evaluation performed: adequacy (provider count and ratio), access-survey (member experience survey), mystery-shopper (secret shopper call study), gap-analysis (deficiency identification), time-distance (geographic access compliance), or appointment-availability (wait time measurement).']
  assessor_name varchar [note: 'Name of the individual or team responsible for conducting the network adequacy assessment.']
  assessor_organization varchar [note: 'Organization or department that conducted the assessment (e.g., internal network management team, third-party consultant, regulatory auditor).']
  comments varchar [note: 'Additional notes, observations, or context related to the network adequacy assessment, including qualitative findings or special circumstances.']
  compliance_outcome varchar [note: 'Overall compliance result of the network adequacy assessment: compliant (meets all standards), non-compliant (fails standards), partially-compliant (meets some but not all standards), under-review (pending final determination), or remediation-required (corrective action needed).']
  created_timestamp timestamp [note: 'Timestamp when the adequacy assessment record was first created in the system.']
  facility_type varchar [note: 'Type of healthcare facility evaluated in this assessment (e.g., hospital, urgent care, skilled nursing facility (SNF), ambulatory surgery center, imaging center).']
  gap_identified_flag boolean [note: 'Indicates whether network gaps or deficiencies were identified during the assessment. True if gaps exist, False otherwise.']
  gap_severity varchar [note: 'Severity level of identified network gaps: critical (immediate member access risk), high (significant access limitation), moderate (minor access concern), or low (minimal impact).']
  member_to_provider_ratio decimal(10,2) [note: 'Calculated ratio of enrolled members to available providers in the assessed specialty or facility type, expressed as members per provider.']
  provider_count_available varchar [note: 'Number of in-network providers or facilities available in the assessed specialty or facility type within the service area.']
  provider_count_required varchar [note: 'Minimum number of providers or facilities required by regulatory standards to meet network adequacy thresholds for the assessed specialty or facility type.']
  regulatory_submission_type varchar [note: 'Type of regulatory body or framework for which this assessment is being conducted: CMS Medicare, CMS Marketplace, State Department of Insurance (DOI), NCQA accreditation, internal monitoring, or ACA Qualified Health Plan (QHP) certification.']
  remediation_action_taken varchar [note: 'Description of corrective actions taken to address identified network gaps, such as provider recruitment, contract expansion, telehealth deployment, or member outreach.']
  remediation_due_date date [note: 'Target date by which remediation actions must be completed to resolve identified network gaps and achieve compliance.']
  remediation_status varchar [note: 'Current status of remediation efforts: not-started (action plan pending), in-progress (corrective actions underway), completed (actions finished), verified (compliance confirmed), or overdue (past due date).']
  specialty_type varchar [note: 'Medical specialty or provider type being evaluated in this assessment (e.g., primary care, cardiology, orthopedics, behavioral health, pediatrics).']
  submission_date date [note: 'Date on which the network adequacy assessment was submitted to the regulatory body (CMS, State DOI, NCQA).']
  submission_status varchar [note: 'Status of the regulatory submission: draft (not yet submitted), submitted (under review), accepted (approved by regulator), rejected (not approved), or resubmission-required (corrections needed).']
  survey_method varchar [note: 'Methodology used to conduct the assessment: member survey (CAHPS or custom), secret shopper call (mystery shopper study), provider survey (direct provider inquiry), administrative data (claims and enrollment analysis), or geospatial analysis (GIS mapping).']
  telehealth_offered_flag boolean [note: 'Indicates whether telehealth or virtual care options were offered as an alternative during the assessment. True if telehealth was available, False otherwise.']
  time_distance_compliance_percentage decimal(5,2) [note: 'Percentage of members in the service area who have access to the assessed provider specialty or facility type within the required time and distance standards.']
  time_distance_standard_miles decimal(6,2) [note: 'Maximum distance in miles that members should travel to access the assessed provider specialty or facility type, as defined by regulatory standards.']
  time_distance_standard_minutes varchar [note: 'Maximum travel time in minutes that members should travel to access the assessed provider specialty or facility type, as defined by regulatory standards.']
  updated_timestamp timestamp [note: 'Timestamp when the adequacy assessment record was last modified in the system.']
  wait_time_days_routine varchar [note: 'Average number of days members wait for a routine appointment with the assessed provider specialty, measured through survey or mystery shopper methodology.']
  wait_time_days_urgent varchar [note: 'Average number of days members wait for an urgent appointment with the assessed provider specialty, measured through survey or mystery shopper methodology.']

  Note: 'Transactional record of a network compliance evaluation — including network adequacy assessments, access surveys, mystery shopper studies, and gap identification. Captures assessment type (adequacy, access-survey, mystery-shopper), assessment date, regulatory submission type (CMS, state DOI), specialty/facility type evaluated, provider counts, member-to-provider ratios, time-distance compliance results, wait-time measurements, survey method (member survey, secret shopper call), appointment type requested, telehealth offered flag, and overall compliance outcome. Includes detail-level gap findings as child records: specific specialty or facility type shortfalls within a geographic area, gap severity, number of providers available vs. required, remediation actions taken, and resolution status. Supports CMS network adequacy filings, NCQA HEDIS access measures (Getting Care Quickly), CAHPS survey supplementation, and targeted network development. This is the SSOT for all network compliance evaluations and their associated gap findings.'
}

Table network.provider_directory {
  provider_directory_id varchar [pk, note: 'Unique identifier for the provider directory record. Primary key for the published provider directory entry representing the member-facing view of a provider\'s network participation.']
  group_id varchar [note: 'Foreign key linking to employer.group. Business justification: Provider Directory Maintenance: assigns an employee who updates directory entries, required for data quality and audit trails.']
  network_service_area_id varchar [note: 'Foreign key linking to network.service_area. Business justification: A provider directory entry represents a provider at a specific practice location. That location falls within one or more service areas. Linking provider_directory to service_area enables geographic fi']
  par_agreement_id varchar [note: 'Foreign key linking to network.par_agreement. Business justification: A provider directory listing is the member-facing publication of a provider\'s network participation, which is formally authorized by a PAR agreement. Linking provider_directory to par_agreement establ']
  provider_assignment_id varchar [note: 'Foreign key linking to network.provider_assignment. Business justification: The provider directory is the member-facing published view of a provider\'s network participation. The provider_assignment is the internal operational record of that participation. A directory entry sh']
  provider_id varchar [note: 'Reference to the provider master record. Links this directory entry to the provider identity in the provider domain.']
  provider_network_id varchar [note: 'Reference to the network configuration. Identifies which network this provider participates in for member directory searches.']
  accepting_new_patients_flag boolean [note: 'Indicates whether the provider is currently accepting new patients. Critical field for member directory searches and CMS directory accuracy compliance.']
  accessibility_features varchar [note: 'Description of specific accessibility features available at the practice location, such as wheelchair ramps, accessible parking, or assistive listening devices.']
  ada_compliant_flag boolean [note: 'Indicates whether the practice location is ADA-compliant and accessible to individuals with disabilities. Supports member searches for accessible facilities.']
  address_line_1 varchar [note: 'Primary street address of the practice location. First line of the physical address where the provider sees patients.']
  address_line_2 varchar [note: 'Secondary address information such as suite, floor, or building number. Optional address component for practice location.']
  board_certification_status varchar [note: 'Indicates whether the provider is board-certified in their specialty. Used for quality assessment and member directory filtering.']
  city varchar [note: 'City name of the practice location. Used for geographic search and network adequacy reporting.']
  county varchar [note: 'County name of the practice location. Used for CMS network adequacy reporting and geographic access standards.']
  created_timestamp timestamp [note: 'Timestamp when this provider directory record was first created in the system. Used for audit trail and data lineage tracking.']
  data_quality_score decimal(5,2) [note: 'Calculated data quality score for this directory entry based on completeness, accuracy, and recency of verification. Range 0.00 to 100.00. Supports directory quality monitoring.']
  directory_publication_channel varchar [note: 'The channel through which this directory entry is published and accessible to members. Supports multi-channel directory distribution tracking.']
  directory_status varchar [note: 'Current status of the provider directory entry. Indicates whether the entry is actively published, pending verification, or suspended from member-facing display.']
  effective_end_date date [note: 'Date when this provider directory entry was terminated or became inactive. Null for currently active entries. Supports historical directory analysis.']
  effective_start_date date [note: 'Date when this provider directory entry became effective and available for member searches. Supports historical tracking of directory changes.']
  email_address varchar [note: 'Email contact for the practice location. Used for electronic communication and directory verification outreach.']
  fax_number varchar [note: 'Fax number for the practice location. Used for prior authorization and medical records transmission.']
  gender varchar [note: 'Gender of the provider. Used for member preference-based directory searches, particularly for gender-specific care.']
  hospital_affiliation varchar [note: 'Name of the hospital or health system with which the provider has admitting privileges or affiliation. Supports continuity of care and member decision-making.']
  languages_spoken varchar [note: 'Comma-separated list of languages spoken by the provider or available at the practice location. Supports culturally competent care and member language preference searches.']
  last_updated_timestamp timestamp [note: 'Timestamp when this provider directory record was last modified. Supports change tracking and audit compliance.']
  last_verification_method varchar [note: 'Method used for the most recent directory verification. Tracks how the provider information was validated for audit and compliance purposes.']
  last_verification_outcome varchar [note: 'Outcome of the most recent verification attempt. Indicates whether information was confirmed, updated, or if verification was unsuccessful.']
  last_verified_date date [note: 'Date when the provider directory information was last verified. Critical for CMS 90-day directory update mandate and No Surprises Act compliance.']
  next_verification_due_date date [note: 'Date by which the next directory verification must be completed. Supports compliance with CMS 90-day update mandate and quarterly verification tracking.']
  npi varchar [note: 'The 10-digit National Provider Identifier assigned by CMS. Used for provider identification in claims and directory searches.']
  phone_number varchar [note: 'Primary contact phone number for the practice location. Ten-digit phone number displayed in member directory for appointment scheduling.']
  practice_location_name varchar [note: 'Name of the practice location or facility where the provider sees patients. Displayed in member directory for location identification.']
  specialty_primary varchar [note: 'The primary medical specialty or taxonomy classification of the provider. Used for member search and filtering in the directory.']
  specialty_secondary varchar [note: 'Additional specialty or sub-specialty of the provider. Supports multi-specialty provider directory searches.']
  state varchar [note: 'Two-letter state abbreviation of the practice location. Used for geographic filtering and state-level network adequacy compliance.']
  telehealth_available_flag boolean [note: 'Indicates whether the provider offers telehealth or virtual visit services. Supports member search for remote care options.']
  termination_reason varchar [note: 'Reason why the provider directory entry was terminated or inactivated. Examples include provider left network, practice closed, or data quality issue.']
  verified_fields varchar [note: 'Comma-separated list of fields that were verified during the last verification event. Examples include address, phone, accepting_new_patients, specialty.']
  verifying_agent varchar [note: 'Name or identifier of the person or system that performed the last verification. Used for audit trail and quality assurance.']
  website_url varchar [note: 'Website address for the provider or practice location. Displayed in member directory for additional provider information.']
  zip_code varchar [note: 'Five-digit or nine-digit ZIP code of the practice location. Used for proximity-based member searches and geographic access analysis.']

  Note: 'Published provider directory record representing the member-facing view of a provider\'s network participation, including full verification lifecycle tracking. Captures provider name, specialty, practice location, phone, accepting-new-patients status, telehealth availability, languages spoken, accessibility features (ADA compliance), last verified date, and directory publication channel (online, print, API). Embeds complete verification history as child records — including verification method (outbound call, online attestation, EHR/HIE data match, claims-based inference), verification date, verified fields (address, phone, accepting-new-patients, specialty), verification outcome (confirmed, updated, unable to reach), and verifying agent/system. Supports CMS directory accuracy requirements (42 CFR 422.111), No Surprises Act compliance, the 90-day directory update mandate, and quarterly verification tracking. This is the SSOT for member-facing directory data and its verification audit trail.'
}

Table network.par_agreement {
  par_agreement_id varchar [pk, note: 'System-generated unique identifier for the provider participation agreement.']
  facility_id varchar [note: 'Foreign key linking to provider.facility. Business justification: PAR agreements can be facility-specific (hospital participation contracts) distinct from individual provider agreements. Required for facility-level rate negotiation, contract management, credentialin']
  parent_par_agreement_id varchar [note: 'Self-referencing FK on par_agreement (parent_par_agreement_id)']
  provider_id varchar [note: 'Unique identifier of the provider participating in the network.']
  provider_network_id varchar [note: 'Identifier of the provider network to which the agreement applies.']
  tier_id varchar [note: 'Foreign key linking to network.tier. Business justification: par_agreement.provider_tier_assignment is a denormalized STRING storing the tier designation for the participating provider. The tier table is the authoritative reference. A PAR agreement specifies on']
  agreement_number varchar [note: 'External reference number assigned to the agreement by the health plan.']
  agreement_scope_description varchar [note: 'Narrative description of the services, specialties, and geographic areas covered.']
  agreement_type varchar [note: 'Classifies the agreement as individual provider, group practice, or other entity.']
  agreement_version varchar [note: 'Version identifier for the agreement document (e.g., v1, v2).']
  amendment_effective_date date [note: 'Date the amendment becomes effective.']
  amendment_flag boolean [note: 'Indicates whether this record represents an amendment to a prior agreement.']
  amendment_number varchar [note: 'Identifier for the amendment (e.g., A1, A2).']
  amendment_termination_date date [note: 'Date the amendment expires, if different from the base agreement.']
  compliance_status_flag boolean [note: 'Indicates whether the agreement meets all applicable regulatory requirements.']
  contract_reference_number varchar [note: 'Reference to the broader provider contract that governs reimbursement terms.']
  created_timestamp timestamp [note: 'Timestamp when the agreement record was first created in the system.']
  effective_date date [note: 'Date the agreement becomes binding and in‑force.']
  electronic_signature_flag boolean [note: 'True if the agreement was signed electronically.']
  last_updated_by varchar [note: 'User or system that performed the most recent update.']
  last_updated_timestamp timestamp [note: 'Timestamp of the most recent update to the agreement record.']
  notes varchar [note: 'Free‑form notes or comments about the agreement.']
  paper_signature_flag boolean [note: 'True if the agreement was signed on paper.']
  par_agreement_status varchar [note: 'Current lifecycle status of the agreement.']
  provider_credentialing_date date [note: 'Date the provider completed credentialing for the network.']
  provider_credentialing_status varchar [note: 'Credentialing state of the provider for network participation.']
  provider_directory_last_verified_date date [note: 'Date the provider\'s directory information was last verified.']
  provider_directory_listing_flag boolean [note: 'Indicates whether the provider is listed in the public network directory.']
  provider_network_status varchar [note: 'Current network participation status of the provider.']
  provider_participation_role varchar [note: 'Role of the provider within the network (e.g., primary care, specialist).']
  provider_recredentialing_due_date date [note: 'Next scheduled date for provider re‑credentialing.']
  regulatory_approval_date date [note: 'Date the agreement received regulatory approval, if required.']
  regulatory_filing_reference varchar [note: 'Reference number for any required regulatory filing (e.g., CMS network adequacy filing).']
  renewal_date date [note: 'Planned date for renewal of the agreement, if applicable.']
  renewal_flag boolean [note: 'Indicates whether the agreement is set for automatic renewal.']
  signature_date date [note: 'Date the agreement was signed by the provider.']
  signed_by_name varchar [note: 'Legal name of the individual who signed the agreement on behalf of the provider.']
  signed_by_npi varchar [note: 'National Provider Identifier of the signing individual.']
  signed_by_title varchar [note: 'Job title or role of the signing individual.']
  termination_date date [note: 'Date the agreement ends, either by expiration or early termination.']
  termination_reason_code varchar [note: 'Standardized code describing why the agreement was terminated.']
  termination_reason_description varchar [note: 'Free‑text description of the termination reason.']
  created_by varchar [note: 'User or system that created the agreement record.']

  Note: 'Provider participation agreement record — the formal agreement a provider signs to participate in a network. Captures agreement type (individual, group), signature date, effective date, termination provisions, and agreement version. Distinct from the broader provider_contract which covers reimbursement terms.'
}

Table network.network_service_area {
  network_service_area_id varchar [pk, note: 'Unique identifier for the geographic service area. Primary key.']
  plan_service_area_id varchar [note: 'SSOT reference to plan.plan_service_area (single source of truth)']
  provider_network_id varchar [note: 'Identifier of the provider network to which this service area belongs.']
  regulatory_obligation_id varchar [note: 'Identifier of the regulatory filing (e.g., SERFF filing, CMS HPMS submission) that established or modified this service area.']
  cms_service_area_code varchar [note: 'CMS-assigned identifier for the service area, used in Medicare Advantage and Marketplace (QHP) filings.']
  commercial_approved_flag boolean [note: 'Indicates whether this service area is approved for commercial (employer-sponsored and individual) plan enrollment.']
  county_fips_code varchar [note: 'Five-digit Federal Information Processing Standards code uniquely identifying the county. Null for non-county-based service areas.']
  county_name varchar [note: 'Name of the county included in this service area. Null for non-county-based service areas.']
  created_timestamp timestamp [note: 'Timestamp when this service area record was first created in the system.']
  effective_date date [note: 'Date when this service area configuration becomes active and available for member enrollment.']
  geographic_boundary_description varchar [note: 'Textual description of the service area boundaries, used for custom or complex geographic definitions not captured by standard codes.']
  medicaid_approved_flag boolean [note: 'Indicates whether this service area is approved for Medicaid managed care enrollment.']
  medicare_advantage_approved_flag boolean [note: 'Indicates whether this service area is approved for Medicare Advantage plan enrollment.']
  member_residency_required_flag boolean [note: 'Indicates whether members must reside within this service area to be eligible for enrollment in the associated network.']
  msa_code varchar [note: 'Five-digit code identifying the Metropolitan Statistical Area. Null for non-MSA-based service areas.']
  msa_name varchar [note: 'Name of the Metropolitan Statistical Area (e.g., \'San Francisco-Oakland-Hayward, CA\'). Null for non-MSA-based service areas.']
  network_adequacy_approval_date date [note: 'Date when the network adequacy filing was approved by CMS or the state Department of Insurance for this service area.']
  network_adequacy_filing_date date [note: 'Date when the most recent network adequacy filing was submitted to CMS or the state Department of Insurance for this service area.']
  network_adequacy_status varchar [note: 'Indicates whether the service area meets CMS and state network adequacy standards for provider access: compliant, non-compliant, under review, waiver granted, or not applicable.']
  network_service_area_status varchar [note: 'Current lifecycle status of the service area: active (available for enrollment), inactive (not available), pending approval (awaiting regulatory approval), suspended (temporarily unavailable), or terminated (permanently closed).']
  notes varchar [note: 'Free-text notes capturing additional context, exceptions, or special instructions related to this service area configuration.']
  out_of_area_coverage_allowed_flag boolean [note: 'Indicates whether the plan allows coverage for services received outside this service area (e.g., for travel or temporary relocation).']
  population_count varchar [note: 'Estimated total population residing in this service area, used for network adequacy calculations and market sizing.']
  qhp_approved_flag boolean [note: 'Indicates whether this service area is approved for Qualified Health Plan (Marketplace/Exchange) enrollment under the Affordable Care Act.']
  regulatory_approval_number varchar [note: 'Reference number assigned by CMS or the state Department of Insurance when approving this service area configuration.']
  service_area_code varchar [note: 'Business identifier for the service area, used in contracts, filings, and member communications.']
  service_area_name varchar [note: 'Human-readable name of the service area (e.g., \'Northern California Region\', \'Metro Atlanta Service Area\').']
  service_area_type varchar [note: 'Classification of how the service area is defined geographically: county-based, ZIP code-based, Metropolitan Statistical Area (MSA)-based, state-based, custom boundary, or multi-state.']
  state_code varchar [note: 'Two-letter state abbreviation where the service area is located (e.g., \'CA\', \'TX\', \'NY\'). For multi-state service areas, this represents the primary state.']
  termination_date date [note: 'Date when this service area configuration is no longer active. Null for currently active service areas.']
  updated_by varchar [note: 'User ID or system identifier of the person or process that last modified this service area record.']
  updated_timestamp timestamp [note: 'Timestamp when this service area record was last modified.']
  urban_rural_designation varchar [note: 'Classification of the service area as urban, suburban, rural, frontier (very low population density), or mixed.']
  zip_code varchar [note: 'Five-digit ZIP code included in this service area. Null for non-ZIP-based service areas.']
  created_by varchar [note: 'User ID or system identifier of the person or process that created this service area record.']

  Note: 'Defines the geographic service area for a provider network — the counties, ZIP codes, or metropolitan statistical areas (MSAs) where the network is available and where members must reside to enroll. Captures state, county FIPS code, ZIP code, service area type (county-based, ZIP-based), CMS service area ID, effective dates, and whether the area is approved for QHP/Medicare Advantage enrollment. Critical for CMS network adequacy filings and state DOI market conduct compliance.'
}

Table network.provider_assignment {
  provider_assignment_id varchar [pk, note: 'Unique identifier for the network-provider association record. Primary key for this entity.']
  capitation_arrangement_id varchar [note: 'Foreign key linking to contract.capitation_arrangement. Business justification: When providers are assigned under capitated payment models, assignments must reference the specific capitation arrangement for PMPM payment calculation and member attribution. Operational necessity fo']
  facility_id varchar [note: 'Foreign key linking to provider.facility. Business justification: Assignments link providers to facilities where they have admitting/surgical privileges. Required for referral management, care coordination, hospital-based service authorization, and ensuring continui']
  fee_schedule_id varchar [note: 'Foreign key linking to contract.fee_schedule. Business justification: Provider assignments operationalize network participation and must reference the applicable fee schedule for claims adjudication and payment calculation. Core operational link between network particip']
  network_service_area_id varchar [note: 'Foreign key linking to network.service_area. Business justification: provider_assignment.geographic_service_area is a denormalized STRING storing the geographic service area for the provider\'s assignment. The service_area table in the same domain is the authoritative r']
  par_agreement_id varchar [note: 'Foreign key linking to network.par_agreement. Business justification: A provider assignment (the internal record of a provider\'s participation in a network) is authorized by a PAR agreement. The PAR agreement is the contractual basis for the assignment. One PAR agreemen']
  practice_location_id varchar [note: 'Foreign key linking to provider.practice_location. Business justification: Provider assignments specify which practice location(s) serve network members. Essential for accurate provider directory data, member PCP selection, appointment scheduling, and ensuring directory refl']
  provider_id varchar [note: 'Identifier of the provider participating in this network. Links to the provider master entity.']
  provider_network_id varchar [note: 'Identifier of the provider network to which this provider participates. Links to the network master entity.']
  tier_id varchar [note: 'Foreign key linking to network.tier. Business justification: provider_assignment.tier_assignment is a denormalized STRING storing the tier designation. The tier table in the same domain is the authoritative reference for tier definitions. A provider assignment ']
  vbc_contract_id varchar [note: 'Foreign key linking to contract.vbc_contract. Business justification: Provider assignments under value-based care models must reference the VBC contract for performance attribution, quality measurement, and shared savings/risk calculation. Core VBC operations requiremen']
  accepting_new_patients_flag boolean [note: 'Boolean indicator of whether this provider is currently accepting new patients from this network. True indicates accepting new patients.']
  accessibility_ada_compliant_flag boolean [note: 'Boolean indicator of whether this provider\'s facilities meet ADA accessibility requirements for members with disabilities. True indicates ADA compliance.']
  aco_participant_flag boolean [note: 'Boolean indicator of whether this provider participates in an ACO arrangement within this network. True indicates ACO participation.']
  after_hours_availability_flag boolean [note: 'Boolean indicator of whether this provider offers after-hours or extended-hours services to members of this network. True indicates after-hours availability.']
  continuity_of_care_end_date date [note: 'The date through which existing members may continue to see this provider under in-network benefits after network termination, per continuity of care requirements.']
  created_timestamp timestamp [note: 'The timestamp when this network-provider association record was first created in the system.']
  credentialing_date date [note: 'The date on which the provider was most recently credentialed for participation in this network.']
  credentialing_status varchar [note: 'Current credentialing status of the provider for participation in this network. Credentialed indicates all requirements met.']
  current_panel_size varchar [note: 'The current number of members assigned to or served by this provider within this network.']
  directory_last_verified_date date [note: 'The date on which the provider\'s directory information was last verified for accuracy. CMS requires quarterly verification.']
  directory_listing_flag boolean [note: 'Boolean indicator of whether this provider should be included in the published provider directory for this network. True indicates directory inclusion.']
  effective_date date [note: 'The date on which the provider\'s participation in this network became or will become effective.']
  in_network_flag boolean [note: 'Boolean indicator of whether this provider is currently in-network for this network. True indicates in-network status.']
  language_services_available varchar [note: 'Comma-separated list of languages in which this provider offers services to members of this network, supporting cultural and linguistic access requirements.']
  network_adequacy_category varchar [note: 'Classification of this provider\'s role in meeting network adequacy requirements. Essential indicates critical for minimum adequacy standards.']
  network_participation_type varchar [note: 'Classification of the provider\'s participation relationship with this network. PAR indicates participating provider with contracted rates; non-PAR indicates non-participating.']
  npi varchar [note: 'The 10-digit National Provider Identifier assigned by CMS to uniquely identify this provider in the network.']
  panel_capacity varchar [note: 'The maximum number of members this provider can serve within this network. Used for network adequacy calculations.']
  panel_status varchar [note: 'Current status of the provider\'s patient panel for this network. Open indicates capacity for new members; closed indicates no capacity.']
  participation_status varchar [note: 'Current status of the provider\'s participation in this network. Active indicates the provider is currently in-network and accepting members.']
  pcp_flag boolean [note: 'Boolean indicator of whether this provider serves as a Primary Care Provider within this network. True indicates PCP designation.']
  quality_tier_designation varchar [note: 'Quality-based tier assignment for this provider within the network, based on HEDIS or Star Ratings performance metrics.']
  record_active_flag boolean [note: 'Boolean indicator of whether this network-provider association record is currently active in the system. False indicates a logically deleted or superseded record.']
  recredentialing_due_date date [note: 'The date by which the provider must complete recredentialing to maintain participation in this network. Typically every 3 years per NCQA standards.']
  risk_sharing_arrangement_flag boolean [note: 'Boolean indicator of whether this provider participates in risk-sharing financial arrangements within this network. True indicates risk-sharing participation.']
  specialist_flag boolean [note: 'Boolean indicator of whether this provider is designated as a specialist within this network. True indicates specialist designation.']
  telehealth_available_flag boolean [note: 'Boolean indicator of whether this provider offers telehealth services to members of this network. True indicates telehealth availability.']
  termination_date date [note: 'The date on which the provider\'s participation in this network ended or will end. Null for ongoing participation.']
  termination_initiated_by varchar [note: 'Indicates which party initiated the termination of the provider\'s network participation. Null for active participation.']
  termination_reason_code varchar [note: 'Code indicating the reason for termination of the provider\'s participation in this network. Null for active participation. [ENUM-REF-CANDIDATE: voluntary|contract_expiration|quality_issues|credentialing_failure|network_restructure|provider_request|other — 7 candidates stripped; promote to reference product]']
  updated_timestamp timestamp [note: 'The timestamp when this network-provider association record was most recently updated in the system.']
  vbc_participant_flag boolean [note: 'Boolean indicator of whether this provider participates in value-based care arrangements within this network. True indicates VBC participation.']
  weekend_availability_flag boolean [note: 'Boolean indicator of whether this provider offers weekend services to members of this network. True indicates weekend availability.']

  Note: 'Association entity representing the participation of a specific provider (NPI) within a specific provider network, capturing in-network status, effective and termination dates, tier assignment, accepting-new-patients flag, telehealth availability, panel status (open/closed), panel capacity, and credentialing linkage. This is the SSOT for the structural relationship between a provider and a network — distinct from provider identity (provider domain), contract terms (contract domain), and ACO-specific participation (aco_provider). Supports provider directory publication, CMS network adequacy filings, and member eligibility verification.'
}

Table employer.group {
  group_id varchar [pk, note: 'System-generated unique identifier for the employer group record.']
  broker_id varchar [note: 'Reference to the broker or agency that sourced the group.']
  address_line1 varchar [note: 'Primary street address of the employer\'s headquarters.']
  address_line2 varchar [note: 'Secondary address information (suite, floor, etc.).']
  average_claim_cost decimal(12,2) [note: 'Average cost per claim historically incurred by the group.']
  city varchar [note: 'City component of the employer\'s address.']
  contribution_strategy varchar [note: 'Method used to calculate employer contributions to premiums.']
  country varchar [note: 'Country of the employer\'s headquarters (ISO‑3 code).']
  created_timestamp timestamp [note: 'Timestamp when the employer group record was first created in the system.']
  dba_name varchar [note: 'Trade name or DBA under which the employer operates, if different from legal name.']
  domicile_state varchar [note: 'Two‑letter state code where the employer is legally domiciled.']
  effective_date date [note: 'Date the employer group contract becomes binding.']
  email_address varchar [note: 'Primary email address for employer communications.']
  enrollment_count_ec varchar [note: 'Number of employees plus dependent children enrolled.']
  enrollment_count_ef varchar [note: 'Number of employees enrolled with full family coverage (employee, spouse, and children).']
  enrollment_count_eo varchar [note: 'Number of employees enrolled in employee‑only coverage.']
  enrollment_count_es varchar [note: 'Number of employees plus spouses enrolled.']
  erisa_status varchar [note: 'Indicates whether the group is subject to ERISA regulations.']
  funding_arrangement varchar [note: 'How the group pays for coverage: fully insured, ASO, or self‑funded.']
  gfc_code varchar [note: 'Link to the financial control entity responsible for the group\'s accounting.']
  group_status varchar [note: 'Current lifecycle state of the employer group relationship.']
  headcount_current varchar [note: 'Current total number of employees covered under the group plan.']
  headcount_last_month varchar [note: 'Employee headcount as of the end of the previous month.']
  headcount_last_year varchar [note: 'Employee headcount as of the same month in the prior calendar year.']
  last_status_change_timestamp timestamp [note: 'Timestamp when the status field last changed value.']
  legal_name varchar [note: 'Full legal name of the employer organization as registered.']
  line_of_business varchar [note: 'Primary product line(s) offered to the employer group.']
  market_segment varchar [note: 'Regulatory market segment classification for the group.']
  naics_code varchar [note: 'Six‑digit code representing the employer\'s industry sector.']
  number varchar [note: 'Internal identifier assigned to the employer group by the insurer.']
  participation_requirement varchar [note: 'Minimum employee participation level required for the group plan.']
  phone_number varchar [note: 'Primary business telephone number for the employer.']
  postal_code varchar [note: 'ZIP code for the employer\'s address.']
  renewal_date date [note: 'Scheduled date for contract renewal negotiations.']
  risk_adjustment_factor decimal(5,2) [note: 'Factor used in risk‑adjusted pricing for the group.']
  sic_code varchar [note: 'Four‑digit code classifying the employer\'s primary industry.']
  size_tier varchar [note: 'Categorization of the employer based on employee headcount.']
  state varchar [note: 'State component of the employer\'s address.']
  tax_id_ein varchar [note: 'Federal tax identification number for the employer, used for reporting and compliance.']
  termination_date date [note: 'Date the employer group contract is terminated or expires.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the employer group record.']

  Note: 'Master record for employer group accounts — the B2B commercial customers who sponsor health coverage for their employees. Captures group demographics, legal entity name, tax ID (EIN), SIC/NAICS industry classification, group size tier, historical headcount and enrollment counts by coverage tier (EO/ES/EC/EF) tracked at monthly intervals for ACA small/large group market classification, line of business (LOB), funding arrangement (fully-insured vs ASO), ERISA status, domicile state, effective and termination dates, group financial control (GFC) identifiers, and complete lifecycle status transitions (prospect, active, suspended, terminated, reinstated) with status history. Single source of truth for employer group identity, size classification, headcount history, and status history.'
}

Table employer.group_location {
  group_location_id varchar [pk, note: 'Unique surrogate key for each group location record.']
  group_id varchar [note: 'Foreign key linking to employer.employer_group. Business justification: Group locations belong to an employer group; linking enables address normalization and removes duplicate address fields from employer_group.']
  network_service_area_id varchar [note: 'Foreign key linking to network.service_area. Business justification: Needed for Network Adequacy Compliance audit: links employer location to the network service area covering that geography.']
  on_site_facility_id varchar [note: 'Foreign key linking to provider.facility. Business justification: Links employer on‑site clinic locations to provider facilities, enabling employee access reporting and utilization analytics.']
  plan_service_area_id varchar [note: 'Foreign key linking to plan.plan_service_area. Business justification: Each group location must be validated against the plan\'s service area to confirm plan eligibility before enrollment. This is a core eligibility check distinct from network service area coverage (alrea']
  address_line1 varchar [note: 'First line of the street address.']
  address_line2 varchar [note: 'Second line of the street address, if applicable.']
  address_type varchar [note: 'Classifies the purpose of the address (headquarters, billing, satellite, mailing).']
  city varchar [note: 'City of the location.']
  country_code varchar [note: 'Three-letter ISO country code (e.g., USA).']
  county_fips varchar [note: 'Federal Information Processing Standard code for the county.']
  created_timestamp timestamp [note: 'Timestamp when the record was first created in the system.']
  effective_end_date date [note: 'Date when the location ceases to be effective; null if still active.']
  effective_start_date date [note: 'Date when the location becomes effective for billing and regulatory purposes.']
  geocode_accuracy varchar [note: 'Indicates the precision of the latitude/longitude coordinates.']
  group_location_status varchar [note: 'Current lifecycle status of the location record.']
  is_primary boolean [note: 'Indicates whether this is the primary address for the employer group.']
  latitude decimal(9,6) [note: 'Geographic latitude of the location in decimal degrees.']
  location_code varchar [note: 'Business identifier code for the location used in billing and regulatory filings.']
  location_name varchar [note: 'Descriptive name for the location (e.g., Headquarters, West Coast Office).']
  longitude decimal(9,6) [note: 'Geographic longitude of the location in decimal degrees.']
  notes varchar [note: 'Free-text field for additional remarks about the location.']
  rating_area varchar [note: 'Geographic rating area used for premium calculations.']
  state varchar [note: 'Two-letter state abbreviation.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the record.']
  zip_code varchar [note: 'Five-digit postal code.']
  zip_plus4 varchar [note: 'Extended ZIP+4 postal code.']

  Note: 'Physical and mailing addresses associated with an employer group, including headquarters, billing address, and satellite office locations. Tracks address type, street, city, state, ZIP+4, county FIPS code, and effective date range. Supports geographic rating, state regulatory filings, and premium billing address routing.'
}

Table employer.group_contact {
  group_contact_id varchar [pk, note: 'System-generated unique identifier for the group contact record.']
  group_id varchar [note: 'Identifier of the employer group to which this contact belongs.']
  address_line1 varchar [note: 'First line of the contact\'s mailing address.']
  address_line2 varchar [note: 'Second line of the contact\'s mailing address, if applicable.']
  authorization_level varchar [note: 'Level of authority the contact has for enrollment and billing actions.']
  can_bill boolean [note: 'Indicates whether the contact is authorized to initiate billing or premium payment actions.']
  can_enroll boolean [note: 'Indicates whether the contact is authorized to submit enrollment transactions.']
  city varchar [note: 'City component of the contact\'s mailing address.']
  contact_type varchar [note: 'Classification of the contact\'s functional role for the employer group.']
  country varchar [note: 'Three‑letter ISO country code for the contact\'s address.']
  created_timestamp timestamp [note: 'Timestamp when the contact record was first created in the system.']
  department varchar [note: 'Department or business unit where the contact works.']
  effective_end_date date [note: 'Date when the contact\'s authorization expires or is terminated; null if open‑ended.']
  effective_start_date date [note: 'Date when the contact\'s authorization becomes effective.']
  email varchar [note: 'Primary email address used for electronic communications with the contact.']
  first_name varchar [note: 'Given name of the contact.']
  full_name varchar [note: 'Legal full name of the contact person.']
  group_contact_status varchar [note: 'Current lifecycle status of the contact record.']
  is_primary_contact boolean [note: 'Indicates whether this contact is the designated primary point of contact for the group.']
  last_name varchar [note: 'Family name of the contact.']
  last_updated_timestamp timestamp [note: 'Timestamp of the most recent update to the contact record.']
  notes varchar [note: 'Additional free‑form comments or remarks about the contact.']
  phone_number varchar [note: 'Primary telephone number for the contact.']
  postal_code varchar [note: 'Postal or ZIP code of the contact\'s mailing address.']
  preferred_communication_channel varchar [note: 'Contact\'s preferred method for receiving communications.']
  source_system_contact_reference varchar [note: 'Identifier for the contact as defined in the source system.']
  state varchar [note: 'State or province component of the contact\'s mailing address.']
  title varchar [note: 'Professional title or position of the contact within the employer organization.']

  Note: 'Authorized contacts associated with an employer group, including HR administrators, benefits coordinators, payroll contacts, and executive sponsors. Captures contact role type, name, title, phone, email, preferred communication channel, and authorization level for enrollment and billing transactions.'
}

Table employer.group_plan_offering {
  group_plan_offering_id varchar [pk, note: 'System‑generated unique identifier for the group plan offering record.']
  benefit_package_id varchar [note: 'Foreign key linking to plan.benefit_package. Business justification: Group plan offerings must reference a specific benefit_package (metal tier, cost-sharing design) for enrollment, SBC disclosure, and ACA compliance reporting. Benefits administrators and underwriters ']
  contribution_strategy_id varchar [note: 'Foreign key linking to employer.contribution_strategy. Business justification: A group plan offering is governed by a specific contribution strategy that defines employer/employee cost-sharing. contribution_strategy is the SSOT for contribution rules and already has group_id and']
  group_id varchar [note: 'Identifier of the employer group that sponsors this offering.']
  group_renewal_id varchar [note: 'Foreign key linking to employer.open_enrollment_window. Business justification: A group plan offering is available for election during a specific open enrollment window. open_enrollment_window is the SSOT for enrollment period dates and already has group_id and plan_health_plan_i']
  year_id varchar [note: 'Foreign key linking to plan.year. Business justification: A group plan offering is bound to a specific plan year governing open enrollment windows, accumulator resets, and ACA reporting periods. plan_year is a denormalized text value on group_plan_offering; ']
  contribution_effective_end_date date [note: 'Date when the defined contribution strategy expires; null if ongoing.']
  contribution_effective_start_date date [note: 'Date when the defined contribution strategy becomes effective.']
  created_timestamp timestamp [note: 'Timestamp when the offering record was first created in the system.']
  effective_from date [note: 'Date the offering becomes binding for the employer group.']
  effective_until date [note: 'Date the offering ends; null for open‑ended contracts.']
  employee_contribution_amount decimal(12,2) [note: 'Employer contribution amount for employee‑only coverage.']
  family_contribution_amount decimal(12,2) [note: 'Employer contribution amount for family coverage.']
  group_plan_offering_status varchar [note: 'Current lifecycle state of the offering.']
  hra_seed_amount decimal(12,2) [note: 'Employer‑funded seed contribution to employee HRA accounts.']
  hsa_seed_amount decimal(12,2) [note: 'Employer‑funded seed contribution to employee HSA accounts.']
  is_affordable boolean [note: 'True if the offering meets ACA affordability testing for the employer group.']
  measurement_period_end date [note: 'End of the period used to evaluate participation compliance.']
  measurement_period_start date [note: 'Start of the period used to evaluate participation compliance.']
  offering_code varchar [note: 'External code used by the employer and carriers to reference this specific plan offering.']
  offering_description varchar [note: 'Narrative description of the plan offering, including benefits highlights.']
  offering_name varchar [note: 'Human‑readable name of the plan offering as displayed to employees.']
  offering_type varchar [note: 'Category of the health plan offering (e.g., QHP, HMO, PPO, EPO, HDHP, Dental, Vision). [ENUM-REF-CANDIDATE: qhp|hmo|ppo|epo|hdhp|dental|vision — promote to reference product]']
  participation_status varchar [note: 'Current compliance result for the offering\'s participation thresholds.']
  plan_catalog_version varchar [note: 'Version identifier of the plan catalog used for this offering.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the offering record.']
  waiver_criteria_description varchar [note: 'Narrative description of the conditions under which a waiver may be granted.']
  waiver_eligible boolean [note: 'Indicates whether the employer allows waiver of spousal or other coverage.']

  Note: 'The set of health plan products offered by an employer group to its eligible employees during a plan year — the single source of truth for what plans are available, how the employer contributes, and what participation rules apply. Captures which QHP, HMO, PPO, EPO, HDHP, dental, and vision plans are available; employer contribution strategy per plan including contribution type (flat dollar, percentage of premium, tiered by coverage tier), employee-only vs family contribution amounts, HSA/HRA employer seed amounts, and contribution effective date ranges; minimum participation percentage, minimum enrolled headcount, waiver eligibility criteria (e.g., spousal coverage waivers), measurement period, and participation compliance status; and the open enrollment window linkage. Consolidates contribution strategies and participation requirements as attributes of the plan offering. Links employer groups to the plan catalog and drives the enrollment eligibility matrix, premium billing split calculations, and ACA affordability compliance testing.'
}

Table employer.contribution_strategy {
  contribution_strategy_id varchar [pk, note: 'System-generated unique identifier for the contribution strategy record.']
  benefit_package_id varchar [note: 'Foreign key linking to plan.benefit_package. Business justification: Contribution strategies are often defined at the benefit_package level (e.g., employer contributes more toward gold than silver plans). ACA affordability testing and multi-tier employer contribution m']
  group_id varchar [note: 'Unique identifier of the employer group to which this contribution strategy applies.']
  affordability_test_flag boolean [note: 'Indicates whether the contribution satisfies the ACA affordability requirement.']
  contribution_amount decimal(12,2) [note: 'Fixed dollar amount the employer contributes per employee when contribution_type is \'flat\'.']
  contribution_code varchar [note: 'External business code used to reference the contribution strategy in contracts and communications.']
  contribution_frequency varchar [note: 'How often the employer contribution is applied to premium billing.']
  contribution_percentage decimal(5,2) [note: 'Percentage of the premium the employer pays when contribution_type is \'percentage\'.']
  contribution_rule_name varchar [note: 'Descriptive name of the contribution rule for reporting and UI display.']
  contribution_strategy_status varchar [note: 'Current lifecycle state of the contribution strategy.']
  contribution_type varchar [note: 'Method used to calculate the employer contribution: flat dollar amount, percentage of premium, or tiered based on coverage tier.']
  created_timestamp timestamp [note: 'Timestamp when the contribution strategy record was first created in the system.']
  effective_end_date date [note: 'Date on which the contribution strategy expires or is superseded; null for open‑ended.']
  effective_start_date date [note: 'Date on which the contribution strategy becomes active.']
  eligibility_criteria varchar [note: 'Free‑text description of employee eligibility rules (e.g., full‑time status, tenure) for this contribution.']
  employer_contribution_cap decimal(12,2) [note: 'Maximum total amount the employer will contribute per employee per billing period.']
  hra_employer_seed_amount decimal(12,2) [note: 'Employer‑funded seed contribution to a Health Reimbursement Arrangement for eligible employees.']
  hsa_employer_seed_amount decimal(12,2) [note: 'Employer‑funded seed contribution to a Health Savings Account for eligible employees.']
  is_post_tax boolean [note: 'True if the employer contribution is made on a post‑tax basis.']
  is_pre_tax boolean [note: 'True if the employer contribution is made on a pre‑tax basis.']
  last_review_date date [note: 'Date when the contribution strategy was last reviewed for compliance or policy updates.']
  maximum_employee_contribution decimal(12,2) [note: 'Highest amount an employee may be required to pay after employer contribution is applied.']
  minimum_employee_contribution decimal(12,2) [note: 'Lowest amount an employee must pay after employer contribution is applied.']
  notes varchar [note: 'Additional comments or special instructions related to the contribution strategy.']
  review_status varchar [note: 'Result of the most recent compliance review.']
  tax_credit_eligible boolean [note: 'Indicates whether the contribution qualifies for a tax credit under applicable regulations.']
  tier_code varchar [note: 'Code indicating the employee coverage tier (e.g., employee‑only, family) that the contribution amount applies to.']
  updated_by varchar [note: 'User or system identifier that performed the most recent update.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to the contribution strategy record.']
  created_by varchar [note: 'User or system identifier that created the record.']

  Note: 'Employer contribution rules defining how much the employer pays toward employee and dependent premiums for each offered plan. Captures contribution type (flat dollar, percentage of premium, tiered by coverage tier), employee-only vs family contribution amounts, HSA/HRA employer seed amounts, and effective date ranges. Supports premium billing split calculations and ACA affordability compliance testing.'
}

Table employer.group_renewal {
  group_renewal_id varchar [pk, note: 'System-generated unique identifier for the group renewal record.']
  benefit_package_id varchar [note: 'Foreign key linking to plan.benefit_package. Business justification: Renewal processing requires knowing the specific benefit_package being renewed or replaced. ACA and ERISA compliance checks, rate change calculations, and retention analysis all depend on the benefit ']
  broker_id varchar [note: 'Identifier of the broker representing the group.']
  contribution_strategy_id varchar [note: 'Foreign key linking to employer.contribution_strategy. Business justification: group_renewal currently stores contribution_strategy as a denormalized STRING column. The renewal lifecycle record is the single source of truth for all group configuration changes, and the contributi']
  group_id varchar [note: 'Unique identifier of the employer group associated with this renewal.']
  year_id varchar [note: 'Foreign key linking to plan.year. Business justification: Group renewals are executed for a specific plan year; open enrollment windows, premium effective dates, and ACA compliance filings are all governed by the plan.year record. renewal_cycle_year is a den']
  amendment_count varchar [note: 'Total number of amendments applied to this renewal record.']
  amendment_flag boolean [note: 'True if any amendment has been applied to the renewal.']
  audit_created_timestamp timestamp [note: 'Timestamp when the renewal record was first created in the data warehouse.']
  audit_updated_timestamp timestamp [note: 'Timestamp of the most recent update to the renewal record.']
  compliance_check_date date [note: 'Date on which the regulatory compliance check was performed.']
  compliance_status varchar [note: 'Result of the compliance validation for the renewal.']
  erisa_status varchar [note: 'Indicates whether the Employee Retirement Income Security Act applies to the group.']
  funding_arrangement varchar [note: 'Method by which the group finances coverage.']
  group_size varchar [note: 'Total number of covered individuals in the group for the renewal year.']
  latest_amendment_after_value decimal(18,2) [note: 'Value of the changed attribute after the amendment (stored as text).']
  latest_amendment_approval_status varchar [note: 'Approval status of the most recent amendment.']
  latest_amendment_before_value decimal(18,2) [note: 'Value of the changed attribute before the amendment (stored as text).']
  latest_amendment_effective_date date [note: 'Effective date of the most recent amendment.']
  latest_amendment_reason_code varchar [note: 'Standardized reason code for the most recent amendment.']
  latest_amendment_type varchar [note: 'Type of the most recent amendment applied to the renewal.']
  participation_requirement_met boolean [note: 'Indicates whether the group met the minimum participation threshold for the renewal.']
  participation_requirement_outcome varchar [note: 'Result of the participation requirement evaluation.']
  premium_rate_prior_year decimal(12,4) [note: 'Base premium rate applied in the prior renewal year.']
  premium_rate_renewal_year decimal(12,4) [note: 'Base premium rate applied for the renewal year.']
  prior_renewal_effective_date date [note: 'Effective date of the immediately preceding renewal.']
  rate_change_percentage decimal(6,2) [note: 'Percent change between prior year and renewal year premium rates.']
  regulatory_compliance_flag boolean [note: 'Indicates whether the renewal passed all required regulatory validations.']
  renewal_effective_date date [note: 'First day of coverage under the renewed contract.']
  renewal_end_date date [note: 'Last day of coverage for the renewal term.']
  renewal_notes varchar [note: 'Free‑form notes entered by users during the renewal process.']
  renewal_status varchar [note: 'Current workflow status of the renewal.']
  renewal_status_date date [note: 'Date when the current renewal status was set.']
  retention_outcome varchar [note: 'Result of the renewal in terms of group retention.']
  retention_reason_code varchar [note: 'Code describing why a group was retained or lost.']
  sic_code varchar [note: 'Four‑digit industry classification code for the employer.']

  Note: 'Annual renewal lifecycle record and single source of truth for all group configuration changes — both at renewal and between renewal cycles. Captures renewal effective date, prior year vs renewal year premium rates, rate change percentage, benefit modifications, participation requirement outcomes, renewal status (pending, proposed, accepted, declined), and retention outcome. Also captures mid-year and off-cycle amendments including amendment type (benefit change, plan add/drop, contribution change, address update, contact change), amendment effective date, reason code, approval status, and before/after values of changed attributes. Consolidates group amendments as lifecycle events within the renewal record — amendments are tracked against the current plan year\'s renewal. Provides complete audit trail for group retention management, regulatory compliance, and configuration change history.'
}

Table employer.broker_assignment {
  broker_assignment_id varchar [pk, note: 'Unique surrogate key for the broker assignment record.']
  broker_id varchar [note: 'FK to employer.broker']
  group_id varchar [note: 'Unique identifier for the employer group (client) in the core administration system.']
  agency_name varchar [note: 'Legal name of the broker\'s agency or firm.']
  broker_assignment_status varchar [note: 'Current lifecycle status of the broker assignment.']
  commission_basis varchar [note: 'Business metric on which the commission is calculated.']
  commission_rate decimal(5,2) [note: 'Commission rate applicable to the broker for this employer group, expressed as a percentage.']
  commission_type varchar [note: 'Method used to calculate broker commission.']
  created_timestamp timestamp [note: 'Timestamp when the broker assignment record was created in the system.']
  effective_end_date date [note: 'Date when the broker assignment terminates or expires. Null if ongoing.']
  effective_start_date date [note: 'Date when the broker assignment becomes effective.']
  is_primary boolean [note: 'Flag indicating whether this broker is the primary broker for the employer group.']
  notes varchar [note: 'Free-text field for additional comments or remarks about the broker assignment.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the broker assignment record.']

  Note: 'Association between an employer group and its licensed broker(s) or general agent(s), capturing the broker NPN, agency name, commission arrangement type, commission rate, effective and termination dates, and primary vs secondary broker designation. Supports broker compensation processing, group servicing accountability, and regulatory disclosure requirements.'
}

Table employer.rate_quote {
  rate_quote_id varchar [pk, note: 'System‑generated unique identifier for the premium rate quote.']
  benefit_package_id varchar [note: 'Foreign key linking to plan.benefit_package. Business justification: Rate quotes are generated for a specific benefit_package; the deductible, OOP max, and copay structure in the package directly drive actuarial pricing. Underwriting and quoting systems require this li']
  broker_id varchar [note: 'Identifier of the broker or sales agent handling the quote.']
  contribution_strategy_id varchar [note: 'Foreign key linking to employer.contribution_strategy. Business justification: rate_quote currently stores contribution_strategy as a denormalized STRING column. contribution_strategy is a first-class product in the employer domain with its own PK. Normalizing this relationship ']
  group_id varchar [note: 'Identifier of the employer group for which the quote is generated.']
  group_renewal_id varchar [note: 'Foreign key linking to employer.employer_underwriting_case. Business justification: A rate quote is generated as the output of an underwriting evaluation. The employer_underwriting_case is the source of the risk assessment that drives the rate quote. Linking rate_quote to employer_un']
  rate_id varchar [note: 'Foreign key linking to plan.rate. Business justification: A rate quote is derived from a specific base rate record. Underwriting audit trails, regulatory filings, and repricing workflows require tracing each quote back to the plan.rate record used as its bas']
  year_id varchar [note: 'Foreign key linking to plan.year. Business justification: Rate quotes are issued for a specific plan year; the plan year determines rating parameters, regulatory filing deadlines, and premium effective dates. plan_year is a denormalized text field on rate_qu']
  coverage_tier varchar [note: 'Tier of coverage being quoted (e.g., employee only, family).']
  created_timestamp timestamp [note: 'Timestamp when the quote record was first created in the system.']
  currency_code varchar [note: 'Three‑letter ISO 4217 code of the currency used for the quote (e.g., USD).']
  discount_amount decimal(15,2) [note: 'Monetary value of any discounts applied to the gross premium.']
  effective_date date [note: 'First date on which the quoted rates become effective if the quote is accepted.']
  erisa_status varchar [note: 'Indicates whether the employer group is subject to ERISA regulations.']
  expiration_date date [note: 'Date after which the quote is no longer valid.']
  gross_premium_amount decimal(15,2) [note: 'Total premium before any discounts or adjustments, expressed in the quote currency.']
  group_sic_code varchar [note: 'Standard Industrial Classification code describing the employer\'s industry.']
  group_size varchar [note: 'Total number of employees eligible for coverage under the employer group.']
  group_type varchar [note: 'Funding arrangement for the group: Administrative Services Only (ASO) or Fully Insured.']
  issue_timestamp timestamp [note: 'Date‑time when the quote was formally issued to the employer.']
  member_count varchar [note: 'Number of covered lives in the employer group for the quoted period.']
  net_premium_amount decimal(15,2) [note: 'Final premium after discounts, the amount the employer is expected to pay.']
  notes varchar [note: 'Free‑form text for additional comments or special conditions.']
  pmpm_rate decimal(10,4) [note: 'Proposed premium rate expressed as a per‑member‑per‑month amount.']
  quote_number varchar [note: 'External reference number assigned to the quote for tracking and communication with the employer.']
  quote_version varchar [note: 'Version number of the quote, incremented on each revision.']
  rate_quote_status varchar [note: 'Current lifecycle state of the quote (e.g., draft, presented, accepted, expired, rejected).']
  rating_area varchar [note: 'Geographic rating area used to calculate the premium.']
  rating_methodology varchar [note: 'Method used to calculate rates: community, experience, or blended.']
  renewal_date date [note: 'Date when the current policy term ends and renewal is expected.']
  total_group_premium_estimate decimal(15,2) [note: 'Projected total premium for the entire employer group based on the quoted rates.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to the quote record.']

  Note: 'Premium rate quote issued to a prospective or renewing employer group, capturing proposed rates by plan, coverage tier, and rating area. Includes quote effective date, expiration date, rating methodology (community rated, experience rated, blended), proposed PMPM rates, total group premium estimate, and quote status (draft, presented, accepted, expired). Supports the sales and renewal pipeline.'
}

Table employer.stop_loss_policy {
  stop_loss_policy_id varchar [pk, note: 'System‑generated unique identifier for the stop‑loss policy record.']
  benefit_package_id varchar [note: 'Foreign key linking to plan.benefit_package. Business justification: Stop-loss policies for self-funded groups are underwritten against a specific benefit design. Attachment points, covered benefit codes, and aggregate deductibles are calibrated to the benefit_package ']
  contribution_strategy_id varchar [note: 'Foreign key linking to employer.contribution_strategy. Business justification: stop_loss_policy currently stores contribution_strategy as a denormalized STRING column. For self-funded ASO groups, the stop-loss policy is directly tied to the employer\'s contribution strategy — the']
  group_id varchar [note: 'Foreign key linking to employer.employer_group. Business justification: Stop‑loss policy is tied to an employer group; linking creates proper relationship.']
  group_renewal_id varchar [note: 'Foreign key linking to employer.group_renewal. Business justification: Stop-loss policies are negotiated and renewed as part of the annual group renewal process. Linking stop_loss_policy to group_renewal establishes which renewal cycle the policy was issued for, enabling']
  year_id varchar [note: 'Foreign key linking to plan.year. Business justification: Stop-loss policies are underwritten and priced per plan year; the plan year governs the policy period, aggregate deductible reset dates, and claims run-out periods. Stop-loss reinsurance settlements a']
  aggregate_attachment_point decimal(12,2) [note: 'Total deductible amount the employer group must incur before the carrier pays for excess claims.']
  aggregate_deductible_reset_period varchar [note: 'Period after which the aggregate attachment point resets (e.g., annually).']
  attachment_point_type varchar [note: 'Specifies whether attachment points are calculated per individual claim or on an annual basis.']
  carrier_name varchar [note: 'Name of the insurance carrier that provides the stop‑loss coverage.']
  claim_payment_limit decimal(12,2) [note: 'Maximum amount the carrier will pay for a single claim under the stop‑loss policy.']
  claim_payment_limit_currency varchar [note: 'Currency of the claim payment limit.']
  covered_benefit_codes varchar [note: 'Comma‑separated list of benefit codes (e.g., CPT, DRG) that are covered under the stop‑loss policy.']
  created_timestamp timestamp [note: 'Date‑time when the stop‑loss policy record was first created in the system.']
  deductible_amount decimal(12,2) [note: 'General deductible amount defined in the stop‑loss contract (may differ from attachment points).']
  effective_from date [note: 'Date on which the stop‑loss coverage becomes effective.']
  effective_until date [note: 'Date on which the stop‑loss coverage expires (if not renewed).']
  individual_attachment_point decimal(12,2) [note: 'Deductible amount an individual member must incur before the stop‑loss carrier pays.']
  lasering_provision_flag boolean [note: 'Indicates whether the policy includes a lasering provision (reinstatement after a loss).']
  notes varchar [note: 'Free‑form text for additional comments or special conditions related to the policy.']
  policy_number varchar [note: 'External policy number assigned by the carrier; used for billing and claims.']
  policy_type varchar [note: 'Indicates whether the policy provides individual attachment point coverage, aggregate coverage, or both.']
  premium_amount decimal(12,2) [note: 'Periodic premium charged by the carrier for the stop‑loss coverage.']
  premium_currency varchar [note: 'Three‑letter ISO currency code for the premium amount.']
  renewal_date date [note: 'Scheduled date for policy renewal negotiations.']
  risk_adjustment_factor decimal(5,2) [note: 'Factor applied to the premium based on the employer group\'s risk profile.']
  stop_loss_policy_status varchar [note: 'Current lifecycle status of the stop‑loss policy.']
  termination_date date [note: 'Date the policy was terminated prior to its scheduled expiration, if applicable.']
  updated_timestamp timestamp [note: 'Date‑time of the most recent update to the stop‑loss policy record.']

  Note: 'Stop-loss (excess loss) insurance policy associated with a self-funded ASO employer group, providing financial protection against catastrophic claims. Captures stop-loss carrier name, policy number, specific deductible (individual attachment point), aggregate deductible, lasering provisions, covered benefits, policy effective and expiration dates, and premium amounts. Critical for ASO group financial risk management.'
}

Table employer.broker {
  broker_id varchar [pk, note: 'Primary key for broker']
  parent_broker_id varchar [note: 'Self-referencing FK on broker (parent_broker_id)']
  address_line1 varchar [note: 'First line of broker\'s physical address.']
  address_line2 varchar [note: 'Second line of broker\'s physical address.']
  agreement_end_date date [note: 'End date of the broker agreement.']
  agreement_start_date date [note: 'Start date of the broker agreement.']
  agreement_status varchar [note: 'Current status of the broker agreement.']
  agreement_terms varchar [note: 'Detailed terms and conditions of the broker agreement.']
  broker_status varchar [note: 'Current operational status of the broker.']
  broker_type varchar [note: 'Classification of broker (e.g., independent, captive).']
  city varchar [note: 'City of broker\'s address.']
  commission_amount decimal(15,2) [note: 'Commission amount paid to the broker.']
  commission_currency varchar [note: 'Currency in which the commission is paid.']
  commission_end_date date [note: 'End date of the commission period.']
  commission_rate decimal(10,4) [note: 'Commission rate agreed with the broker.']
  commission_start_date date [note: 'Start date of the commission period.']
  country varchar [note: 'Country of broker\'s address.']
  email varchar [note: 'Primary email address for broker communication.']
  end_date date [note: 'Date when the broker relationship ended or is scheduled to end.']
  fax varchar [note: 'Fax number for broker contact.']
  license_number varchar [note: 'License number issued by regulatory authority.']
  name varchar [note: 'Full legal name of the broker.']
  phone varchar [note: 'Primary phone number for broker contact.']
  postal_code varchar [note: 'Postal or ZIP code of broker\'s address.']
  rating decimal(5,2) [note: 'Credit rating or performance score assigned to the broker.']
  record_audit_created timestamp [note: 'Timestamp when the broker record was first created.']
  record_audit_updated timestamp [note: 'Timestamp when the broker record was last updated.']
  region varchar [note: 'Geographic region where the broker operates.']
  registration_number varchar [note: 'Official registration number assigned to the broker.']
  renewal_date date [note: 'Scheduled date for renewing the broker agreement.']
  renewal_status varchar [note: 'Current status of the renewal process.']
  start_date date [note: 'Date when the broker relationship began.']
  state varchar [note: 'State or province of broker\'s address.']
  tax_number varchar [note: 'Tax ID used for regulatory reporting.']
  termination_reason varchar [note: 'Reason for terminating the broker relationship.']

  Note: 'Master reference table for broker. Referenced by broker_id.'
}

Table contract.party {
  party_id varchar [pk, note: 'Unique surrogate identifier for each party record in the provider contract domain. Serves as the primary key for all contractual party references across the health plan enterprise.']
  contract_provider_contract_id varchar [note: 'Reference to the provider contract this party is bound by. Links the party record to its governing contractual agreement within the contract domain.']
  provider_id varchar [note: 'Foreign key linking to provider.provider. Business justification: Party represents a provider entity in a contract; linking to its credential record enables tracking of credential status and compliance per party.']
  aco_indicator boolean [note: 'Indicates whether this party is an Accountable Care Organization (ACO) participating in a value-based care (VBC) arrangement. Triggers ACO-specific contract terms, shared savings calculations, and CMS reporting requirements.']
  capitation_eligible_indicator boolean [note: 'Indicates whether this party is eligible to receive capitation payments (Per Member Per Month - PMPM) under the contract. Drives capitation payment processing and actuarial PMPM rate application.']
  contract_party_number varchar [note: 'Externally-known alphanumeric identifier assigned to this party within the contract management system (e.g., Cactus or ProviderSource provider contract number). Used for cross-system reconciliation, EDI transactions, and provider directory publication.']
  credentialing_date date [note: 'Date on which the party was most recently credentialed or re-credentialed by the health plan. NCQA requires re-credentialing every 36 months. Used to trigger re-credentialing workflows and network compliance reporting.']
  credentialing_status varchar [note: 'Current credentialing status of the party as maintained in the Provider Management System (Cactus/ProviderSource). Determines whether the party is eligible to provide services to plan members. Credentialing must be current for claims to be adjudicated as in-network.']
  delegation_indicator boolean [note: 'Indicates whether this party is a delegated entity authorized to perform functions on behalf of the health plan (e.g., credentialing, utilization management, claims processing). Triggers delegation oversight and audit requirements per NCQA and state DOI standards.']
  delegation_scope varchar [note: 'Specifies the functional scope of delegation authority granted to this party. Applicable only when delegation_indicator is true. Defines which health plan functions the delegated entity is authorized to perform on behalf of the payer.']
  doing_business_as_name varchar [note: 'Trade name or DBA name under which the party operates, if different from the legal entity name. Commonly used for group practices and hospital systems that operate under a brand name distinct from their legal registration.']
  effective_date date [note: 'Date on which this party\'s participation in the contract becomes effective. Drives claims adjudication eligibility windows, network directory publication, and provider credentialing timelines.']
  legal_entity_name varchar [note: 'Full legal name of the contracting party as registered with state or federal authorities. Used for contract execution, credentialing, and regulatory reporting. May be an individual provider name, group practice name, IPA, ACO, or hospital system name.']
  license_expiration_date date [note: 'Date on which the party\'s primary state professional or business license expires. Triggers credentialing re-verification workflows and may result in contract suspension if not renewed. Critical for NCQA and URAC credentialing compliance.']
  license_state varchar [note: 'Two-letter USPS state abbreviation where the party holds its primary professional or business license. Used for network adequacy reporting, credentialing, and state-specific regulatory compliance.']
  line_of_business varchar [note: 'Health plan line of business under which this party is contracted. Determines applicable regulatory requirements, reimbursement methodologies, and network adequacy standards. [ENUM-REF-CANDIDATE: commercial|medicare_advantage|medicaid|marketplace|cobra|fehb — promote to reference product]']
  malpractice_coverage_indicator boolean [note: 'Indicates whether the party maintains active professional liability (malpractice) insurance coverage as required by the contract. Failure to maintain coverage may trigger contract suspension or termination per NCQA credentialing standards.']
  malpractice_expiration_date date [note: 'Date on which the party\'s professional liability (malpractice) insurance policy expires. Triggers credentialing re-verification and contract compliance monitoring workflows.']
  network_participation_type varchar [note: 'Indicates whether the party is a participating (PAR) in-network provider, a non-participating (non-PAR) provider, or an out-of-network provider. Drives member cost-sharing calculations, claims adjudication rules, and EOB generation.']
  notes varchar [note: 'Free-text field for capturing supplemental information about the party that does not fit structured attributes. May include contract negotiation notes, special arrangement details, or credentialing exceptions. Classified as confidential due to potential inclusion of sensitive business information.']
  npi varchar [note: 'The 10-digit National Provider Identifier assigned by CMS to uniquely identify the provider party. Type 1 NPI for individual providers; Type 2 NPI for organizational providers. Required for all HIPAA-covered transactions including 837 claims and 270/271 eligibility inquiries.']
  npi_type varchar [note: 'Indicates whether the NPI is Type 1 (individual/solo practitioner) or Type 2 (organizational entity such as group practice, hospital, or IPA). Determines credentialing requirements and contract structure.']
  oig_exclusion_indicator boolean [note: 'Indicates whether the party appears on the OIG List of Excluded Individuals/Entities (LEIE). Excluded parties are prohibited from participating in Medicare, Medicaid, and other federal healthcare programs. Checked monthly per CMS compliance requirements.']
  party_status varchar [note: 'Current lifecycle status of the party within the contract. Indicates whether the party is actively bound by the contract, pending execution, suspended, terminated, or inactive. Drives eligibility verification and claims adjudication routing.']
  party_type varchar [note: 'Classifies the party as an individual (natural person, e.g., solo practitioner with individual NPI) or an organization (legal entity, e.g., group practice, hospital, IPA, ACO). Drives NPI type assignment and credentialing workflow.']
  primary_specialty_code varchar [note: 'NUCC Health Care Provider Taxonomy Code representing the party\'s primary clinical specialty. Used for network adequacy analysis, claims routing, prior authorization rules, and provider directory classification.']
  raf_applicable_indicator boolean [note: 'Indicates whether Risk Adjustment Factor (RAF) scoring applies to this party\'s contract arrangement. Relevant for Medicare Advantage and ACA marketplace contracts where Hierarchical Condition Category (HCC) risk scores drive capitation payments.']
  record_created_timestamp timestamp [note: 'Timestamp when this party record was first created in the data platform. Supports audit trail, data lineage, and compliance reporting requirements. Formatted as yyyy-MM-ddTHH:mm:ss.SSSXXX.']
  record_updated_timestamp timestamp [note: 'Timestamp when this party record was most recently modified in the data platform. Supports change data capture, audit trail, and SCD Type 2 processing in the Databricks Silver Layer.']
  recredentialing_due_date date [note: 'Date by which the party must complete re-credentialing to maintain active network participation. Calculated as 36 months from the credentialing_date per NCQA standards. Drives automated re-credentialing workflow initiation.']
  role varchar [note: 'Functional role of this party within the contract relationship. Identifies whether the party is the health plan (payer), a contracting provider, a delegated entity, an Independent Practice Association (IPA), an Accountable Care Organization (ACO), a hospital system, or a group practice. [ENUM-REF-CANDIDATE: payer|provider|delegated_entity|ipa|aco|hospital_system|group_practice — promote to reference product]']
  sanction_indicator boolean [note: 'Indicates whether the party has an active sanction, exclusion, or adverse action recorded by OIG, SAM, or state licensing boards. A true value triggers contract suspension review and claims payment hold per CMS and HIPAA compliance requirements.']
  service_area_state varchar [note: 'Two-letter USPS state abbreviation representing the primary state in which this party provides services under the contract. Used for network adequacy reporting, state regulatory compliance, and geographic claims routing.']
  service_area_zip_code varchar [note: 'Primary ZIP code of the party\'s principal service location. Used for network adequacy geo-mapping, member-to-provider distance calculations, and CMS network adequacy submissions.']
  signatory_name varchar [note: 'Full name of the authorized individual who signed or has authority to sign the contract on behalf of this party. Required for contract execution validation and legal enforceability. Typically the CEO, CMO, or designated contracting officer.']
  signatory_title varchar [note: 'Official title or position of the authorized signatory (e.g., Chief Executive Officer, Medical Director, Contracting Officer). Validates the authority level of the individual executing the contract on behalf of the party.']
  source_system_code varchar [note: 'Identifies the operational system of record from which this party record originated (e.g., Cactus, ProviderSource, Facets, QNXT). Supports data lineage tracking, reconciliation, and ETL audit in the Databricks Silver Layer.']
  source_system_party_reference varchar [note: 'The native identifier of this party record in the originating operational system (e.g., Cactus provider ID, ProviderSource contract party key). Enables cross-system reconciliation and traceability from the Silver Layer back to the system of record.']
  state_license_number varchar [note: 'State-issued professional or business license number for the contracting party. Required for credentialing verification and network participation. For individual providers, this is the state medical license; for organizations, the state business license or certificate of authority.']
  termination_date date [note: 'Date on which this party\'s participation in the contract ends. Null for open-ended or currently active parties. Used to determine network participation windows, claims payment eligibility, and member notification requirements.']
  tin varchar [note: 'Federal Tax Identification Number (EIN or SSN) used for payment processing, 1099 reporting, and IRS compliance. Critical for remittance and premium payment routing. Stored as 9-digit numeric string without hyphens.']
  vbc_arrangement_type varchar [note: 'Specifies the payment methodology or value-based care arrangement type applicable to this party under the contract. Drives reimbursement calculation logic, risk-sharing model application, and financial reporting. [ENUM-REF-CANDIDATE: fee_for_service|capitation|bundled_payment|shared_savings|global_risk — promote to reference product]']

  Note: 'Identifies all parties bound by a provider contract — the health plan entity, the contracting provider (individual NPI or organizational NPI), group practice, IPA, ACO, or hospital system. Tracks party role (payer, provider, delegated entity), NPI, TIN, legal entity name, signatory authority, and party effective dates. Supports multi-party and delegated contracting arrangements.'
}

Table contract.term {
  term_id varchar [pk, note: 'Unique surrogate identifier for a contract term record in the provider contract management system (Facets/QNXT or Provider Management System). Serves as the primary key for the term entity.']
  contract_provider_contract_id varchar [note: 'Reference to the parent provider contract to which this term belongs. Links the term to its governing contract in the Provider Network Management system.']
  fee_schedule_id varchar [note: 'Reference to the fee schedule associated with this term when payment_methodology is fee_for_service. Links to the rate table governing allowed amounts for procedure codes under this term.']
  audit_rights_period_years varchar [note: 'The number of years the health plan retains the right to audit provider records under this audit rights term. Typically 7 years per HIPAA and CMS requirements. Applicable when term_type is \'audit_rights\'.']
  auto_renew boolean [note: 'Indicates whether this term automatically renews upon expiration without requiring renegotiation (True). Supports contract lifecycle management and renewal notification workflows.']
  capitation_rate decimal(12,4) [note: 'The Per Member Per Month (PMPM) capitation rate defined by this term when payment_methodology is capitation. Represents the fixed monthly payment per enrolled member to the provider regardless of services rendered. Classified confidential as proprietary pricing.']
  compliance_checkpoint_date date [note: 'The scheduled date for the next compliance review or audit checkpoint associated with this term. Used by the compliance team to track regulatory obligations, CMS audit readiness, and DOI examination preparation.']
  cpt_range_end varchar [note: 'The ending CPT or HCPCS procedure code of the range to which this reimbursement rule term applies. Used in conjunction with cpt_range_start to define the applicable procedure code range for adjudication.']
  cpt_range_start varchar [note: 'The starting CPT or HCPCS procedure code of the range to which this reimbursement rule term applies. Used in conjunction with cpt_range_end to define the applicable procedure code range for adjudication.']
  created_timestamp timestamp [note: 'The timestamp when this contract term record was first created in the system. Supports audit trail, data lineage, and regulatory record retention requirements.']
  dispute_resolution_method varchar [note: 'The contractually agreed method for resolving disputes arising under this term: Arbitration, Mediation, Litigation, or Internal Review. Applicable for hold-harmless, indemnification, and audit rights terms.']
  drg_grouper_version varchar [note: 'The DRG grouper version (e.g., \'MS-DRG v41.0\', \'APR-DRG v39\') applicable to this term when payment_methodology is \'drg_based\'. Ensures adjudication uses the correct DRG weight tables for inpatient reimbursement.']
  effective_date date [note: 'The date on which this contract term becomes legally binding and operationally enforceable. Used to determine applicability during claims adjudication in Facets/QNXT.']
  expiration_date date [note: 'The date on which this contract term ceases to be binding. Null for open-ended terms with no defined end date. Used in adjudication date-range checks.']
  governing_state varchar [note: 'The two-letter US state code whose laws govern this contract term. Determines applicable state DOI regulations, insurance code requirements, and state-specific provider contract mandates.']
  hipaa_baa_required boolean [note: 'Indicates whether this term constitutes or requires a HIPAA Business Associate Agreement (BAA) (True). Triggers compliance tracking and ensures Protected Health Information (PHI) handling obligations are documented per HIPAA 45 CFR Part 164.']
  icd_version varchar [note: 'Specifies the ICD diagnosis coding version applicable to this term when the term references diagnosis-based reimbursement rules or Hierarchical Condition Category (HCC) risk adjustment provisions.']
  incentive_amount decimal(15,2) [note: 'The maximum dollar amount of quality incentive payment available to the provider under this term upon meeting quality_metric_threshold. Applicable for VBC, ACO, and pay-for-performance contract terms. Classified confidential as proprietary financial terms.']
  is_adjudication_rule boolean [note: 'Indicates whether this term directly drives claims adjudication logic in Facets/QNXT (True). When True, the term\'s reimbursement_policy_subtype, cpt_range_start/end, and reduction_percentage are loaded into the adjudication engine.']
  is_negotiable boolean [note: 'Indicates whether this contract term is open to negotiation (True) or is standard non-negotiable boilerplate language (False). Supports contract negotiation workflow and template management.']
  is_standard_boilerplate boolean [note: 'Indicates whether this term is sourced from the organization\'s standard contract template library (True) or is a custom-negotiated term specific to this contract (False). Supports template governance and deviation tracking.']
  lob_applicability varchar [note: 'Specifies which Line of Business (LOB) this contract term applies to. Enables selective application of reimbursement rules and contractual obligations across Commercial, Medicare Advantage, Medicaid, Marketplace (ACA/QHP), or all lines of business.']
  mac_pricing_basis varchar [note: 'The drug pricing benchmark used for pharmacy reimbursement terms: Average Wholesale Price (AWP), Wholesale Acquisition Cost (WAC), Maximum Allowable Cost (MAC), National Average Drug Acquisition Cost (NADAC), or a custom contracted rate. Applicable for terms covering pharmacy benefits.']
  number varchar [note: 'Human-readable external identifier for the term, typically formatted as a section or clause reference (e.g., \'TERM-2024-0042\' or \'Section 4.2.1\'). Used in contract documents and correspondence.']
  payment_methodology varchar [note: 'The reimbursement payment methodology defined by this term when term_type is \'payment_methodology\' or \'reimbursement_rule\'. Drives adjudication logic in Facets/QNXT. Includes Fee-for-Service (FFS), Capitation, Bundled Payment, Case Rate, Per Diem, Diagnosis Related Group (DRG)-based, Reference Based Pricing (RBP), and Value-Based Care (VBC). [ENUM-REF-CANDIDATE: fee_for_service|capitation|bundled_payment|case_rate|per_diem|drg_based|rbp|vbc — 8 candidates stripped; promote to reference product]']
  pos_code varchar [note: 'The CMS Place of Service (POS) code to which this term\'s reimbursement differential applies, when reimbursement_policy_subtype is \'pos_differential\'. Two-digit code per CMS POS code set (e.g., \'11\' for Office, \'21\' for Inpatient Hospital).']
  quality_metric_threshold decimal(5,2) [note: 'The minimum quality performance threshold (expressed as a percentage or score) that the provider must achieve to qualify for incentive payments or avoid penalties under quality incentive terms. Linked to HEDIS or STAR measures.']
  reduction_percentage decimal(5,2) [note: 'The percentage reduction applied to the allowed amount under this reimbursement rule term (e.g., 50.00 for a 50% reduction on secondary procedures under multiple procedure reduction policy). Applicable when reimbursement_policy_subtype is set. Classified confidential as it represents proprietary pricing.']
  reimbursement_policy_subtype varchar [note: 'Granular sub-classification of the reimbursement rule when term_type is \'reimbursement_rule\'. Specifies the specific adjudication policy: Multiple Procedure Reduction, Bilateral Procedure, Assistant Surgeon, Global Surgery, Unbundling Rules, Place-of-Service (POS) Differential, or Modifier Impact. Directly maps to adjudication logic in Facets/QNXT. [ENUM-REF-CANDIDATE: multiple_procedure_reduction|bilateral_procedure|assistant_surgeon|global_surgery|unbundling|pos_differential|modifier_impact — 7 candidates stripped; promote to reference product]']
  renewal_notice_days varchar [note: 'The number of calendar days prior to expiration_date by which either party must provide notice of intent not to renew this term. Applicable when auto_renew is True.']
  risk_sharing_model varchar [note: 'Defines the risk-sharing arrangement under Value-Based Care (VBC) or Accountable Care Organization (ACO) contract terms. Specifies whether the provider participates in shared savings only (upside), shared risk (two-sided), or full risk (global capitation).']
  source_system_term_ref varchar [note: 'The native identifier of this term record in the originating operational system (e.g., Cactus contract clause ID, QNXT reimbursement rule ID, or ProviderSource term reference). Supports data lineage and reconciliation with source systems.']
  summary varchar [note: 'Plain-language operational summary of the term\'s intent and impact, authored by the contracting team. Used for training, audits, and quick reference without reading full legal text.']
  term_status varchar [note: 'Current lifecycle state of the contract term. \'active\' indicates the term is currently in force; \'superseded\' indicates it has been replaced by an amendment; \'expired\' indicates the effective period has lapsed.']
  term_type varchar [note: 'Categorical classification of the contract term defining its legal or operational purpose. Drives downstream adjudication logic and compliance tracking. [ENUM-REF-CANDIDATE: reimbursement_rule|payment_methodology|exclusivity|termination_clause|audit_rights|hold_harmless|indemnification|confidentiality|hipaa_baa|quality_incentive — promote to reference product]']
  termination_cause_type varchar [note: 'Specifies the basis under which termination is permitted by this term: For Cause (material breach, fraud, license revocation), Without Cause (convenience), Mutual Agreement, or Regulatory (required by law or CMS/DOI directive).']
  termination_notice_days varchar [note: 'The number of calendar days of advance written notice required to terminate the contract under this termination clause term. Applicable when term_type is \'termination_clause\'. Typically 30, 60, or 90 days per regulatory requirements.']
  text varchar [note: 'Full verbatim legal text of the contract term as negotiated and executed. Contains the binding contractual language. Classified confidential as it represents proprietary reimbursement and legal obligations.']
  title varchar [note: 'Short descriptive title of the contract term as it appears in the contract document (e.g., \'Multiple Procedure Reduction Policy\', \'Termination for Cause Clause\'). Supports search and display in contract management UIs.']
  updated_timestamp timestamp [note: 'The timestamp when this contract term record was last modified. Supports change tracking, audit trail, and Silver layer incremental processing in the Databricks Lakehouse.']
  withhold_percentage decimal(5,2) [note: 'The percentage of reimbursement withheld from provider payments pending quality performance or risk settlement under VBC or capitation arrangements. Classified confidential as proprietary financial terms.']

  Note: 'Defines the specific terms, conditions, obligations, and reimbursement policies within a provider contract. Captures term type (payment methodology, exclusivity, termination clause, audit rights, hold-harmless, indemnification, confidentiality, HIPAA BAA, reimbursement rule), term text, effective date, expiration date, and whether the term is negotiable or standard boilerplate. For reimbursement rule terms: captures policy sub-type (multiple procedure reduction, bilateral procedure, assistant surgeon, global surgery, unbundling rules, place-of-service differential), applicable CPT/HCPCS ranges, reduction percentage, and LOB applicability. Enables granular tracking of contractual obligations, compliance checkpoints, and reimbursement adjudication rules. Bridges contract terms to claims adjudication logic in Facets/QNXT.'
}

Table contract.fee_schedule {
  fee_schedule_id varchar [pk, note: 'Unique surrogate identifier for the fee schedule record in the contract domain. Primary key for the fee_schedule data product.']
  benefit_package_id varchar [note: 'Foreign key linking to plan.benefit_package. Business justification: Fee schedules are routinely scoped to specific benefit packages in health insurance (e.g., separate fee schedules for HMO Silver vs. PPO Gold). This link drives benefit-package-level reimbursement in ']
  regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: RATE_DEVELOPMENT: Fee schedules are applied within a specific risk pool; linking enables actuarial rate calculations and regulatory filings.']
  superseded_by_fee_schedule_id varchar [note: 'Reference to the fee_schedule_id of the newer fee schedule that replaced this one when schedule_status is \'superseded\'. Enables fee schedule version chain navigation and historical rate lookups.']
  amendment_number varchar [note: 'Identifier for the contract amendment that introduced or modified this fee schedule version. Null for the original fee schedule. Enables traceability between fee schedule versions and contract amendments.']
  anesthesia_applicable boolean [note: 'Indicates whether this fee schedule includes anesthesia service reimbursement, which uses base units plus time units multiplied by a conversion factor rather than standard CPT-based rates.']
  anesthesia_conversion_factor decimal(10,4) [note: 'Dollar amount per anesthesia unit (base units + time units) used to calculate anesthesia reimbursement when anesthesia_applicable is True. Negotiated rate specific to this fee schedule.']
  approval_date date [note: 'Date on which the fee schedule was formally approved by the authorized contracting officer or governance body. Required for audit and regulatory compliance.']
  cms_fee_schedule_year varchar [note: 'The CMS Medicare fee schedule calendar year used as the basis or benchmark for this fee schedule when fee_schedule_source is \'cms_medicare\'. Enables tracking of which CMS annual update cycle the rates are derived from.']
  conversion_factor decimal(10,4) [note: 'Dollar amount multiplied by the total Relative Value Units (RVUs) to calculate the reimbursement amount for RVU-based fee schedules. Applicable when payment_basis is \'rvu_based\'. Sourced from CMS RBRVS conversion factor or negotiated contract rate.']
  coordination_of_benefits_applicable boolean [note: 'Indicates whether Coordination of Benefits (COB) rules apply to claims adjudicated under this fee schedule. When True, COB logic determines primary vs. secondary payer responsibilities.']
  cpt_code_range_end varchar [note: 'Ending CPT procedure code in the range of services covered by this fee schedule. Used in conjunction with cpt_code_range_start to define the scope of applicable procedure codes.']
  cpt_code_range_start varchar [note: 'Starting CPT procedure code in the range of services covered by this fee schedule. Used in conjunction with cpt_code_range_end to define the scope of applicable procedure codes. Null if the fee schedule applies to all CPT codes or uses ICD/DRG-based scoping.']
  created_timestamp timestamp [note: 'Timestamp when this fee schedule record was first created in the system. Audit field capturing the initial record creation event in the Databricks Silver Layer.']
  description varchar [note: 'Free-text narrative description of the fee schedule, including its purpose, scope, special provisions, or notes relevant to adjudication staff and contract analysts.']
  drg_applicable boolean [note: 'Indicates whether this fee schedule uses Diagnosis Related Group (DRG)-based reimbursement for inpatient facility claims. When True, DRG weights and base rates govern payment rather than individual procedure codes.']
  drg_base_rate decimal(12,2) [note: 'The negotiated base dollar rate per DRG weight unit used for inpatient facility reimbursement when drg_applicable is True. Multiplied by the DRG relative weight to calculate the total inpatient payment.']
  effective_date date [note: 'Date on which the fee schedule becomes effective and applicable for claim adjudication and reimbursement calculations. Inclusive start date of the fee schedule validity period.']
  geographic_modifier_applicable boolean [note: 'Indicates whether geographic adjustment factors (e.g., CMS Geographic Practice Cost Indices - GPCI) are applied to rates under this fee schedule. True when locality-based adjustments are in effect; False for flat national rates.']
  global_surgery_applicable boolean [note: 'Indicates whether global surgery payment rules apply under this fee schedule, bundling pre-operative, intra-operative, and post-operative services into a single reimbursement amount.']
  lob_code varchar [note: 'Identifies the Line of Business (LOB) to which this fee schedule applies (e.g., commercial, Medicare Advantage, Medicaid, ACA Marketplace, COBRA, FEHB). Determines which member populations and plan types are subject to this fee schedule during adjudication.']
  locality_code varchar [note: 'CMS Medicare locality code identifying the geographic pricing area applicable to this fee schedule when geographic_modifier_applicable is True. Used to apply GPCI adjustments to RVU-based rates.']
  medicare_crossover_applicable boolean [note: 'Indicates whether this fee schedule applies to Medicare crossover claims where Medicare is the primary payer and the health plan is the secondary payer. Relevant for Medicare Advantage and Medigap plans.']
  modifier_applicable boolean [note: 'Indicates whether CPT or HCPCS modifiers affect reimbursement rates under this fee schedule (e.g., modifier 26 for professional component, modifier TC for technical component, modifier 50 for bilateral procedures).']
  outlier_threshold_amt decimal(12,2) [note: 'Dollar threshold above which a claim qualifies as a cost outlier, triggering additional reimbursement beyond the standard DRG or bundled payment. Applicable for institutional fee schedules with outlier payment provisions.']
  payment_basis varchar [note: 'The methodology used to calculate reimbursement amounts under this fee schedule. Options include: pct_medicare (percentage of Medicare allowable), pct_billed_charges (percentage of provider billed charges), flat_rate (fixed dollar amount per service), rvu_based (Relative Value Unit-based), bundled (bundled payment for episode of care), capitation (per-member per-month), rbp (Reference Based Pricing). [ENUM-REF-CANDIDATE: pct_medicare|pct_billed_charges|flat_rate|rvu_based|bundled|capitation|rbp — promote to reference product]']
  payment_basis_pct decimal(7,4) [note: 'The percentage rate applied when payment_basis is \'pct_medicare\' or \'pct_billed_charges\' (e.g., 110.0000 for 110% of Medicare). Null when payment_basis is flat_rate, rvu_based, bundled, or capitation. Stored as a decimal percentage value.']
  prior_authorization_required boolean [note: 'Indicates whether Prior Authorization (PA) is required for services reimbursed under this fee schedule. When True, claims must have an approved PA on file before adjudication at the scheduled rates.']
  referral_required boolean [note: 'Indicates whether a primary care physician (PCP) referral is required for services covered under this fee schedule. Applicable primarily for HMO and POS plan types.']
  schedule_code varchar [note: 'Externally-known alphanumeric code uniquely identifying the fee schedule within the Core Administration Platform (Facets/QNXT). Used in EDI transactions and cross-system references.']
  schedule_name varchar [note: 'Human-readable name identifying the fee schedule (e.g., \'Commercial PPO Professional 2024\', \'Medicare Advantage Institutional Q1 2024\'). Used for display and reporting in Facets/QNXT Benefits Configuration.']
  schedule_status varchar [note: 'Current lifecycle state of the fee schedule. \'draft\' indicates under review; \'active\' indicates currently in use for adjudication; \'suspended\' indicates temporarily inactive; \'terminated\' indicates permanently closed; \'superseded\' indicates replaced by a newer version.']
  schedule_type varchar [note: 'Categorizes the fee schedule by the type of services covered: professional (physician/practitioner), institutional (hospital/facility), ancillary (therapy/home health), DME (Durable Medical Equipment), lab (laboratory), or pharmacy. Drives claim adjudication logic in Facets/QNXT.']
  service_category varchar [note: 'Broad clinical or administrative category of services covered by this fee schedule (e.g., \'Evaluation and Management\', \'Surgery\', \'Radiology\', \'Pathology\', \'Inpatient Facility\', \'Outpatient Facility\', \'Home Health\', \'Behavioral Health\'). Supports fee schedule segmentation and reporting. [ENUM-REF-CANDIDATE: evaluation_management|surgery|radiology|pathology|inpatient_facility|outpatient_facility|home_health|behavioral_health|physical_therapy|dme — promote to reference product]']
  source varchar [note: 'Identifies the origin or benchmark source of the fee schedule rates: cms_medicare (based on CMS Medicare fee schedule), cms_medicaid (based on state Medicaid fee schedule), negotiated (directly negotiated with provider), custom (health plan proprietary rates), rbp_benchmark (Reference Based Pricing benchmark).']
  state_code varchar [note: 'Two-letter US state code indicating the geographic scope of this fee schedule. Used for state-specific rate variations and regulatory compliance with State Departments of Insurance (DOI) requirements.']
  stop_loss_applicable boolean [note: 'Indicates whether a stop-loss provision applies to this fee schedule, capping the health plan\'s reimbursement liability per claim or per member. Relevant for risk-sharing and capitation arrangements.']
  stop_loss_threshold_amt decimal(12,2) [note: 'Dollar amount per claim or per member above which the stop-loss provision activates, limiting the health plan\'s reimbursement exposure. Applicable when stop_loss_applicable is True.']
  termination_date date [note: 'Date on which the fee schedule expires and is no longer applicable for claim adjudication. Null indicates an open-ended fee schedule with no defined end date.']
  updated_timestamp timestamp [note: 'Timestamp when this fee schedule record was last modified. Audit field supporting change tracking, data lineage, and regulatory audit requirements.']
  version_number varchar [note: 'Version identifier for the fee schedule, enabling tracking of amendments and updates over time (e.g., \'1.0\', \'2.1\', \'3.0\'). Incremented when rates or terms are modified. Supports fee schedule history and audit trail.']

  Note: 'Master fee schedule defining reimbursement rates for covered services under a provider contract. Captures fee schedule name, version, effective and termination dates, payment basis (% of Medicare, % of billed charges, flat rate, RVU-based), geographic modifier applicability, LOB scope, and fee schedule type (professional, institutional, ancillary, DME, lab). SSOT for all fee-for-service reimbursement rates. Sourced from Facets/QNXT Benefits Configuration.'
}

Table contract.fee_schedule_rate {
  fee_schedule_rate_id varchar [pk, note: 'Unique surrogate identifier for each fee schedule rate line record in the contract domain. Primary key for this entity.']
  contract_provider_contract_id varchar [note: 'Reference to the provider contract under which this fee schedule rate is established. Links the rate line to the governing contractual agreement.']
  fee_schedule_id varchar [note: 'Reference to the parent fee schedule header that this rate line belongs to. Links the rate to its governing fee schedule agreement.']
  prior_rate_fee_schedule_rate_id varchar [note: 'Self-referencing identifier pointing to the previous version of this rate record that was superseded by the current record. Enables full rate history chain traversal for audit and compliance purposes.']
  allowed_amount decimal(18,4) [note: 'The contracted allowed amount or maximum reimbursable dollar amount for the specified procedure code, modifier, and place of service combination. This is the principal monetary value used by adjudication systems to price claims against contracted rates. Expressed in USD.']
  awp_percent decimal(7,4) [note: 'When rate_derivation_method is AWP_PCT, this field stores the percentage of the Average Wholesale Price (AWP) used to derive the drug or supply reimbursement rate. For example, 0.8500 represents AWP minus 15%. Commonly used in pharmacy and DME fee schedules.']
  bilateral_indicator boolean [note: 'Indicates whether this rate applies to a bilateral procedure (performed on both sides of the body). When true, the allowed amount may be adjusted per CMS bilateral surgery payment rules (150% of the unilateral rate).']
  bundled_payment_amount decimal(18,4) [note: 'Single episode-of-care payment amount covering all services within a defined clinical episode (e.g., joint replacement, maternity). Applicable when payment_methodology is BUNDLED. Supports Value-Based Care (VBC) and ACO payment models.']
  capitation_rate_pmpm decimal(18,4) [note: 'Fixed monthly payment per enrolled member paid to a provider under a capitation arrangement, regardless of services rendered. Expressed as a Per Member Per Month (PMPM) dollar amount. Applicable only when payment_methodology is CAPITATION.']
  created_timestamp timestamp [note: 'The timestamp when this fee schedule rate record was first created in the system. Used for audit trail, data lineage, and compliance reporting. Conforms to ISO 8601 format (yyyy-MM-ddTHH:mm:ss.SSSXXX).']
  drg_code varchar [note: 'CMS Diagnosis Related Group code used for inpatient hospital reimbursement. When the payment methodology is DRG-based, this code identifies the patient classification group that determines the base payment rate.']
  effective_date date [note: 'The date on which this fee schedule rate becomes effective and applicable for claims adjudication. Claims with service dates on or after this date and before the termination_date will be priced using this rate.']
  geographic_region varchar [note: 'Geographic region or market area to which this rate applies. Rates may vary by state, CMS locality, metropolitan statistical area (MSA), or health plan-defined region. Expressed as a state code, CMS locality code, or internal region identifier.']
  global_surgery_days varchar [note: 'Number of days in the global surgery period for surgical procedure codes. Defines the pre-operative and post-operative period during which related services are bundled into the surgical payment (0=endoscopic/minor, 10=minor, 90=major surgery).']
  line_of_business varchar [note: 'The Line of Business (LOB) to which this fee schedule rate applies. Rates are often differentiated by LOB as Medicare, Medicaid, and commercial plans have distinct reimbursement structures and regulatory requirements.']
  mac_amount decimal(18,4) [note: 'The Maximum Allowable Cost (MAC) dollar amount set as the ceiling for reimbursement of a specific drug or service. When rate_derivation_method is MAC, this value represents the maximum the plan will pay regardless of billed charges.']
  max_units_per_day varchar [note: 'Maximum number of units of this procedure code that will be reimbursed per day per member. Used to enforce utilization limits during claims adjudication and prevent overbilling.']
  max_units_per_year varchar [note: 'Maximum number of units of this procedure code that will be reimbursed per benefit year per member. Enforces annual utilization limits during adjudication for services with frequency restrictions.']
  medicare_fee_schedule_pct decimal(7,4) [note: 'When rate_derivation_method is MEDICARE_PCT, this field stores the percentage of the applicable Medicare fee schedule rate used to derive the allowed amount. For example, 1.1500 represents 115% of Medicare. Used for rate benchmarking and contract analytics.']
  ncci_edit_indicator boolean [note: 'Indicates whether this procedure code is subject to National Correct Coding Initiative (NCCI) bundling edits during claims adjudication. When true, the adjudication system will apply NCCI column 1/column 2 and mutually exclusive code edits.']
  network_tier varchar [note: 'Identifies the provider network tier to which this rate applies. Rates differ by network participation level: IN_NETWORK (contracted), OUT_OF_NETWORK (non-contracted), or tiered preferred network levels (TIER_1, TIER_2, TIER_3, PREFERRED). Drives member cost-sharing calculations.']
  payment_methodology varchar [note: 'The reimbursement methodology governing how the provider is paid for this service. FFS=Fee-for-Service (fixed allowed amount per procedure), CAPITATION=fixed PMPM regardless of utilization, BUNDLED=single payment for episode of care, DRG=Diagnosis Related Group inpatient payment, PER_DIEM=daily rate for facility stays, PERCENT_OF_BILLED=percentage of submitted charges, RBP=Reference Based Pricing, CASE_RATE=flat rate per case. [ENUM-REF-CANDIDATE: FFS|CAPITATION|BUNDLED|DRG|PER_DIEM|PERCENT_OF_BILLED|RBP|CASE_RATE — promote to reference product]']
  per_diem_rate decimal(18,4) [note: 'Daily reimbursement rate paid to a facility provider for each day of an inpatient or residential stay. Applicable when payment_methodology is PER_DIEM. May vary by level of care (e.g., ICU vs. medical/surgical).']
  place_of_service_code varchar [note: 'CMS two-digit place of service code indicating the setting where the service was rendered (e.g., 11=Office, 21=Inpatient Hospital, 22=Outpatient Hospital, 23=Emergency Room). Rates may vary by place of service.']
  procedure_code varchar [note: 'The CPT or HCPCS procedure code identifying the specific medical service, procedure, or supply for which this rate applies. Core identifier used in claims adjudication to match services to contracted rates.']
  procedure_code_type varchar [note: 'Classifies the coding system used for the procedure_code field. Distinguishes between CPT (physician services), HCPCS Level II (supplies/DME), CDT (dental), ICD-10-PCS (inpatient procedures), Revenue Code (facility billing), DRG (diagnosis-related group), APC (ambulatory payment classification), or NDC (drug). [ENUM-REF-CANDIDATE: CPT|HCPCS_II|CDT|ICD_PCS|REVENUE|DRG|APC|NDC — promote to reference product]']
  procedure_modifier_1 varchar [note: 'First CPT or HCPCS modifier code appended to the procedure code to indicate special circumstances affecting the service (e.g., bilateral procedure, assistant surgeon, professional component). Modifiers can alter the allowed reimbursement amount.']
  procedure_modifier_2 varchar [note: 'Second CPT or HCPCS modifier code when multiple modifiers apply to the same procedure code. Used in conjunction with procedure_modifier_1 for complex billing scenarios.']
  product_type varchar [note: 'The health plan product type to which this rate applies. HMO=Health Maintenance Organization, PPO=Preferred Provider Organization, EPO=Exclusive Provider Organization, POS=Point of Service, HDHP=High Deductible Health Plan, INDEMNITY=traditional indemnity plan. Rates may vary by product type.']
  provider_type varchar [note: 'Classification of the provider type to which this rate applies. Distinguishes between physician/professional services, facility (hospital/SNF), ancillary services, Durable Medical Equipment (DME) suppliers, pharmacy, and behavioral health providers.']
  rate_derivation_method varchar [note: 'Describes how the allowed amount was derived or calculated. MEDICARE_PCT=percentage of Medicare fee schedule, AWP_PCT=percentage of Average Wholesale Price, WAC_PCT=percentage of Wholesale Acquisition Cost, MAC=Maximum Allowable Cost, RBP=Reference Based Pricing benchmark, NEGOTIATED=directly negotiated flat rate, COST_PLUS=cost plus margin, BILLED_PCT=percent of billed charges. Critical for audit and rate validation. [ENUM-REF-CANDIDATE: MEDICARE_PCT|AWP_PCT|WAC_PCT|MAC|RBP|NEGOTIATED|COST_PLUS|BILLED_PCT — promote to reference product]']
  rate_line_number varchar [note: 'Sequential line number identifying the position of this rate record within the parent fee schedule. Used for ordering and referencing individual rate lines.']
  rate_note varchar [note: 'Free-text notes or comments providing additional context about this fee schedule rate, such as special billing instructions, exceptions, or conditions under which the rate applies. Used by contracting and claims operations staff.']
  rate_percent_of_billed decimal(7,4) [note: 'Reimbursement rate expressed as a percentage of the provider\'s billed charges, used when the payment methodology is percent-of-billed rather than a fixed allowed amount. For example, 0.8500 represents 85% of billed charges.']
  rate_source varchar [note: 'Identifies the origin or source of this fee schedule rate. CONTRACT=directly negotiated in provider contract, CMS_PUBLISHED=derived from published CMS fee schedule, CROSSWALK=mapped from another code or schedule, MANUAL=manually entered by contracting staff, SYSTEM_GENERATED=automatically generated by the fee schedule management system.']
  rate_status varchar [note: 'Current lifecycle status of this fee schedule rate record. ACTIVE=currently in effect and used for adjudication, INACTIVE=not currently in use, PENDING=approved but not yet effective, SUPERSEDED=replaced by a newer rate version, TERMINATED=permanently ended.']
  rate_version varchar [note: 'Incrementing version number tracking amendments and updates to this fee schedule rate line. Version 1 is the original rate; subsequent amendments increment this counter. Supports rate history and audit trail requirements.']
  rbp_reference_amount decimal(18,4) [note: 'The benchmark dollar amount used as the basis for Reference Based Pricing (RBP) reimbursement. Typically anchored to Medicare rates or a cost-based benchmark. The actual allowed amount is derived as a percentage of this reference amount.']
  revenue_code varchar [note: 'Four-digit UB-04 revenue code identifying the type of accommodation, ancillary service, or billing classification for facility claims. Used in conjunction with or as an alternative to procedure codes for hospital and facility fee schedule rates.']
  service_category varchar [note: 'Broad clinical or administrative category grouping the service type covered by this rate (e.g., Evaluation and Management, Surgery, Radiology, Laboratory, Anesthesia, Durable Medical Equipment, Behavioral Health, Preventive Care). Used for rate analytics and reporting. [ENUM-REF-CANDIDATE: promote to reference product]']
  specialty_code varchar [note: 'CMS three-digit provider specialty code indicating the clinical specialty for which this rate applies. Rates may be differentiated by provider specialty (e.g., 01=General Practice, 06=Cardiology, 93=Emergency Medicine). Null if rate applies to all specialties.']
  state_code varchar [note: 'Two-letter US state code identifying the state jurisdiction in which this fee schedule rate is applicable. Used for state-specific rate differentiation and regulatory compliance reporting.']
  termination_date date [note: 'The date on which this fee schedule rate expires and is no longer applicable for claims adjudication. Null indicates the rate is open-ended with no defined end date. Claims with service dates after this date will not be priced using this rate.']
  units_of_service decimal(10,2) [note: 'The number of units of service to which the allowed_amount applies. For most procedure codes, this is 1 unit. For time-based codes or quantity-based services, this may represent the standard unit quantity (e.g., 15-minute increments for therapy codes).']
  updated_timestamp timestamp [note: 'The timestamp when this fee schedule rate record was last modified. Tracks the most recent update for change management, audit trail, and data synchronization purposes. Conforms to ISO 8601 format (yyyy-MM-ddTHH:mm:ss.SSSXXX).']

  Note: 'Line-level reimbursement rates within a fee schedule. Each record defines the allowed amount or rate for a specific procedure code (CPT/HCPCS), revenue code, DRG, or service category. Captures procedure code, modifier, place of service, allowed amount, MAC/AWP/WAC reference, RBP rate, effective date, and rate derivation method. Enables adjudication systems to price claims against contracted rates.'
}

Table contract.capitation_arrangement {
  capitation_arrangement_id varchar [pk, note: 'Unique surrogate identifier for the capitation arrangement record in the Silver Layer lakehouse. Primary key for this entity.']
  benefit_package_id varchar [note: 'Foreign key linking to plan.benefit_package. Business justification: Capitation arrangements define which benefit package scope a capitated provider is responsible for delivering (e.g., PCP capitation covers the primary care benefit package). Essential for capitation p']
  contract_provider_contract_id varchar [note: 'Reference to the parent provider contract under which this capitation arrangement is established. Links to the contract master record.']
  fee_schedule_id varchar [note: 'Foreign key linking to contract.fee_schedule. Business justification: Capitation arrangements frequently include carved-out services that are reimbursed on a fee-for-service basis using a referenced fee schedule. The capitation_arrangement already has carve_out_services']
  provider_id varchar [note: 'Reference to the capitated provider or provider group receiving the Per Member Per Month (PMPM) payment under this arrangement.']
  vbc_contract_id varchar [note: 'Foreign key linking to contract.vbc_contract. Business justification: capitation_arrangement has vbc_arrangement_flag (BOOLEAN) and aco_arrangement_flag (BOOLEAN) indicating that some capitation arrangements are part of a Value-Based Care or ACO contract. When vbc_arran']
  aco_arrangement_flag boolean [note: 'Indicates whether this capitation arrangement is part of an Accountable Care Organization (ACO) or integrated delivery network model, which may have additional shared savings or risk-sharing components.']
  aggregate_stop_loss_threshold decimal(14,2) [note: 'Total dollar amount for the attributed member population above which the health plan assumes financial responsibility for claims costs. Protects the provider from population-level adverse risk. Expressed in USD.']
  amendment_number varchar [note: 'Identifier of the most recent contract amendment that modified this capitation arrangement. Tracks the amendment history for audit and compliance purposes.']
  annual_rate_escalator decimal(5,2) [note: 'Contractually agreed annual percentage increase applied to the PMPM rate at each rate renewal period (e.g., 3.50 for 3.5% annual escalation). Used for multi-year capitation arrangements.']
  approval_date date [note: 'Date on which the capitation arrangement was formally approved by the health plan\'s contracting authority. Required for audit trail and regulatory compliance documentation.']
  approved_by varchar [note: 'Name or employee identifier of the contracting authority who approved this capitation arrangement. Supports audit trail and delegation-of-authority compliance.']
  arrangement_name varchar [note: 'Human-readable descriptive name for the capitation arrangement (e.g., \'Primary Care Capitation - HMO Commercial 2024\'), used in reporting and provider communications.']
  arrangement_number varchar [note: 'Externally-known business identifier for the capitation arrangement, used in provider communications, payment remittances, and reconciliation processes. Assigned by the Core Administration Platform (Facets/QNXT).']
  arrangement_status varchar [note: 'Current lifecycle status of the capitation arrangement. Controls whether PMPM payments are generated and whether members can be attributed to this arrangement.']
  arrangement_type varchar [note: 'Classification of the capitation arrangement by scope of covered services. Global capitation covers all services; primary care capitation covers PCP services only; specialty capitation covers specialist services; institutional covers facility-based care. [ENUM-REF-CANDIDATE: global_capitation|primary_care_capitation|specialty_capitation|institutional_capitation|behavioral_health_capitation|pharmacy_capitation — promote to reference product]']
  attributed_member_count varchar [note: 'Current number of members attributed to this capitation arrangement for the active payment period. Used to calculate total monthly capitation payment disbursement.']
  attribution_method varchar [note: 'Methodology used to attribute members to this capitation arrangement. PCP assignment uses enrollment data; claims-based uses plurality of visits; voluntary selection allows member choice; geographic assigns by service area.']
  auto_renewal_flag boolean [note: 'Indicates whether this capitation arrangement automatically renews at the end of the contract term unless either party provides notice of termination within the contractually specified notice period.']
  carve_out_services varchar [note: 'Description of services explicitly excluded from the capitation scope and reimbursed separately (e.g., \'Mental Health, Substance Abuse, Transplants, Neonatal ICU\'). Carve-outs are paid fee-for-service or under separate capitation arrangements.']
  created_timestamp timestamp [note: 'Timestamp when this capitation arrangement record was first created in the data platform. Supports audit trail, data lineage, and regulatory compliance requirements.']
  effective_date date [note: 'Date on which the capitation arrangement becomes binding and PMPM payments begin. Aligns with the contract effective period.']
  geographic_service_area varchar [note: 'Description or code of the geographic service area (county, state, or region) within which this capitation arrangement applies. Members outside this area may not be attributed to this arrangement.']
  individual_stop_loss_threshold decimal(12,2) [note: 'Dollar amount per member per year above which the health plan assumes financial responsibility for claims costs, protecting the provider from catastrophic individual member costs. Expressed in USD.']
  lob_code varchar [note: 'Line of Business to which this capitation arrangement applies (e.g., Commercial HMO, Medicare Advantage, Medicaid Managed Care). Determines regulatory requirements and rate-setting methodology.']
  network_tier varchar [note: 'Network tier classification of the provider under this capitation arrangement. Tier 1 providers typically receive higher capitation rates in exchange for meeting quality and cost-efficiency benchmarks.']
  payment_frequency varchar [note: 'Frequency at which capitation payments are disbursed to the provider. Monthly is standard for most capitation arrangements; quarterly or annual may apply for certain specialty or institutional arrangements.']
  payment_methodology varchar [note: 'Specific payment calculation methodology applied to this capitation arrangement. Pure capitation pays flat PMPM; withhold arrangements retain a percentage pending performance; risk-adjusted capitation applies RAF multipliers. [ENUM-REF-CANDIDATE: pure_capitation|capitation_with_withhold|capitation_with_bonus|risk_adjusted_capitation|tiered_capitation — promote to reference product]']
  pmpm_rate decimal(12,4) [note: 'Fixed dollar amount paid to the provider per attributed member per calendar month, regardless of services rendered. The core financial parameter of the capitation arrangement. Expressed in USD.']
  pmpm_rate_currency varchar [note: 'ISO 4217 three-letter currency code for the PMPM rate (typically USD for domestic health plans). Required for multi-currency reporting and regulatory submissions.']
  quality_withhold_release_criteria varchar [note: 'Description of the quality performance benchmarks or HEDIS/STAR measure thresholds that must be met for the provider to receive release of withheld capitation amounts. Defines the performance contract terms.']
  raf_adjustment_factor decimal(8,4) [note: 'Multiplier applied to the base PMPM rate to account for the relative health risk of the attributed member population. A RAF above 1.0 indicates a sicker-than-average population; below 1.0 indicates healthier-than-average.']
  rate_effective_date date [note: 'Date on which the current PMPM rate became effective. Supports rate history tracking when rates are renegotiated mid-contract without creating a new arrangement record.']
  rate_expiration_date date [note: 'Date on which the current PMPM rate expires and is subject to renegotiation or automatic escalation. Null if the rate is open-ended for the arrangement term.']
  risk_adjustment_applicable boolean [note: 'Indicates whether the PMPM rate is subject to risk adjustment based on the attributed member population\'s Hierarchical Condition Category (HCC) Risk Adjustment Factor (RAF) scores. Applicable primarily for Medicare Advantage and ACA Exchange arrangements.']
  risk_pool_participant boolean [note: 'Indicates whether the provider participates in a shared risk pool under this capitation arrangement. Risk pool participants share in surpluses or deficits relative to the capitation budget.']
  risk_share_percentage decimal(5,2) [note: 'Percentage of risk pool surplus or deficit allocated to the provider under this capitation arrangement. Expressed as a percentage (0.00–100.00). Applicable only when risk_pool_participant is True.']
  service_category_scope varchar [note: 'Comma-delimited list or narrative description of the covered service categories included under this capitation arrangement (e.g., \'Primary Care, Preventive Services, Lab, Radiology\'). Defines the scope of services the provider is financially responsible for under capitation.']
  source_system_code varchar [note: 'Code identifying the operational system of record from which this capitation arrangement record was sourced (e.g., FACETS, QNXT for Core Administration Platform; CACTUS or PROVIDER_SOURCE for Provider Management System).']
  source_system_record_reference varchar [note: 'Native record identifier from the operational source system (Facets, QNXT, or Provider Management System) for this capitation arrangement. Supports data lineage, reconciliation, and back-referencing to the system of record.']
  stop_loss_type varchar [note: 'Type of stop-loss protection included in the capitation arrangement. Individual stop-loss limits exposure per member; aggregate stop-loss limits total population exposure; both applies both thresholds.']
  termination_date date [note: 'Date on which the capitation arrangement ends and PMPM payments cease. Null for open-ended arrangements. Distinct from contract termination date when partial termination applies.']
  termination_notice_days varchar [note: 'Number of calendar days advance notice required by either party to terminate this capitation arrangement without cause. Typically 90–180 days for managed care capitation contracts.']
  updated_timestamp timestamp [note: 'Timestamp when this capitation arrangement record was last modified in the data platform. Used for change data capture, incremental processing, and audit trail maintenance.']
  vbc_arrangement_flag boolean [note: 'Indicates whether this capitation arrangement includes Value-Based Care (VBC) performance incentive components such as quality bonuses, shared savings, or outcome-based adjustments beyond the base PMPM.']
  withhold_percentage decimal(5,2) [note: 'Percentage of the PMPM rate withheld from each payment cycle pending performance or quality metric achievement. Withheld amounts are returned upon meeting contractual benchmarks. Expressed as a percentage (0.00–100.00).']

  Note: 'Defines capitation payment arrangements where providers receive a fixed PMPM (Per Member Per Month) payment to cover a defined scope of services. Captures capitation rate, covered service categories, risk pool participation, stop-loss thresholds, carve-out services, attributed member population criteria, LOB applicability, and payment frequency. Supports HMO and managed care capitation models.'
}

Table contract.capitation_payment {
  capitation_payment_id varchar [pk, note: 'Unique surrogate identifier for each capitation payment disbursement record in the Silver Layer lakehouse. Primary key for this entity.']
  capitation_arrangement_id varchar [note: 'Reference to the specific capitation arrangement or rate schedule within the contract, identifying the applicable PMPM rate table, risk pool configuration, and attributed population definition.']
  contract_provider_contract_id varchar [note: 'Reference to the capitation contract under which this payment is made. Links to the provider contract master defining the capitation arrangement, PMPM rates, and risk-sharing terms.']
  health_plan_id varchar [note: 'Reference to the health plan or benefit product under which the attributed members are enrolled. Determines the applicable benefit structure and capitation rate tier.']
  member_risk_score_id varchar [note: 'Foreign key linking to risk.member_risk_score. Business justification: Actual capitation payments apply risk adjustment factors from member risk scores to calculate risk-adjusted PMPM amounts. Payment records must reference the specific risk score version used to determi']
  original_payment_capitation_payment_id varchar [note: 'Reference to the original capitation payment record that this record adjusts, reverses, or supplements. Populated only when prior_period_adjustment_flag is True. Enables audit trail linking of adjustment chains.']
  provider_id varchar [note: 'Reference to the provider (PCP, specialist group, IPA, or ACO) receiving the capitation payment. Corresponds to the credentialed provider entity in the Provider Management System (Cactus/ProviderSource).']
  vbc_contract_id varchar [note: 'Foreign key linking to contract.vbc_contract. Business justification: capitation_payment has vbc_contract_flag (BOOLEAN) indicating that some capitation payments are made under a VBC contract. When vbc_contract_flag=true, the payment should directly reference the govern']
  ap_voucher_number varchar [note: 'Accounts Payable (AP) voucher or invoice number assigned in Oracle Financials when the capitation payment is posted as a payable. Links the capitation disbursement to the AP subledger for financial reporting and audit trail.']
  attributed_member_count varchar [note: 'Total number of members attributed to the provider for the payment period. This is the primary driver of the gross capitation payment calculation (attributed_member_count × pmpm_rate = gross_payment_amount).']
  capitation_rate_tier varchar [note: 'Rate tier or member category applied to determine the PMPM rate for this payment (e.g., adult, pediatric, senior, ESRD, dual-eligible). Different member demographics may attract different PMPM rates under the same contract.']
  check_eft_trace_number varchar [note: 'Check number or EFT/ACH trace number assigned by the financial institution for the actual disbursement of this capitation payment. Used for bank reconciliation in Oracle Financials (AP module) and provider payment dispute resolution.']
  created_timestamp timestamp [note: 'Timestamp when this capitation payment record was first created in the Silver Layer data platform. Supports audit trail, data lineage, and SLA monitoring for payment processing cycles.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for all monetary amounts on this capitation payment record. Typically USD for domestic health insurance operations. Required for multi-currency financial reconciliation and GAAP/SAP reporting.']
  enrollment_adjustment_amount decimal(18,2) [note: 'Dollar adjustment to the gross payment resulting from retroactive enrollment changes (late enrollments, disenrollments, or eligibility corrections) identified after the initial payment calculation. Can be positive (additional payment) or negative (recoupment).']
  gl_cost_center varchar [note: 'General Ledger (GL) cost center code in Oracle Financials to which this capitation payment expense is allocated. Supports financial reporting by LOB, product, and organizational unit per GAAP and SAP statutory reporting requirements.']
  gross_payment_amount decimal(18,2) [note: 'Total gross capitation payment amount before any adjustments, calculated as attributed_member_count multiplied by the pmpm_rate. Represents the base payment obligation for the period prior to retroactive enrollment changes, risk pool withholds, or stop-loss recoveries.']
  line_of_business varchar [note: 'Line of Business (LOB) under which the capitation payment is made. Determines regulatory requirements, rate-setting methodology, and CMS reporting obligations applicable to the payment.']
  net_payment_amount decimal(18,2) [note: 'Final net amount disbursed to the provider after all adjustments: gross_payment_amount + enrollment_adjustment_amount - risk_pool_withhold_amount + stop_loss_recovery_amount + other_adjustment_amount. This is the actual amount reflected in the 835 ERA remittance advice.']
  payment_approval_date date [note: 'Date on which the capitation payment was formally approved for disbursement by the authorized approver in the billing or finance system. Supports segregation of duties controls and audit trail requirements.']
  payment_date date [note: 'Actual date the capitation payment was disbursed to the provider via EFT, check, or ACH. Used for accounts payable reconciliation and provider remittance reporting.']
  payment_method varchar [note: 'Mechanism by which the capitation payment was or will be disbursed to the provider. EFT (Electronic Funds Transfer) and ACH (Automated Clearing House) are most common for capitation arrangements.']
  payment_number varchar [note: 'Externally-visible business identifier for this capitation payment disbursement, used in provider remittance advice (835 ERA), accounts payable records, and provider portal references. Format: CAP-YYYYMM-NNNNNN.']
  payment_period_end_date date [note: 'Last day of the coverage month or period for which this capitation payment is being made. Typically the last day of the calendar month in monthly capitation cycles.']
  payment_period_start_date date [note: 'First day of the coverage month or period for which this capitation payment is being made. Typically the first day of the calendar month in monthly capitation cycles.']
  payment_run_number varchar [note: 'Identifier of the capitation payment run or batch cycle that generated this payment record. Used to group all payments processed in the same cycle for reconciliation, audit, and reprocessing purposes in the Core Administration Platform (Facets/QNXT).']
  payment_status varchar [note: 'Current lifecycle state of the capitation payment disbursement. \'pending\' = calculated but not yet approved; \'approved\' = authorized for payment; \'paid\' = disbursed to provider; \'voided\' = cancelled before disbursement; \'reversed\' = clawed back after disbursement; \'on_hold\' = suspended pending investigation or contract dispute.']
  payment_type varchar [note: 'Classification of the capitation payment by its business purpose. \'standard\' = routine monthly capitation; \'retroactive\' = payment for prior periods due to enrollment changes; \'adjustment\' = correction to a previously issued payment; \'stop_loss_recovery\' = reimbursement under stop-loss provisions; \'risk_pool_settlement\' = periodic risk pool distribution or withhold settlement.']
  pmpm_rate decimal(12,4) [note: 'Per Member Per Month (PMPM) capitation rate applied for this payment period, as defined in the contract rate schedule. This is the contractually negotiated amount paid per attributed member per month. Classified confidential as it represents proprietary contract pricing.']
  prior_period_adjustment_flag boolean [note: 'Indicates whether this capitation payment includes or represents an adjustment to a prior payment period. True when the payment corrects or supplements a previously issued capitation payment due to retroactive enrollment changes or rate corrections.']
  quality_withhold_amount decimal(18,2) [note: 'Amount withheld from the capitation payment pending achievement of quality performance targets (e.g., HEDIS measures, STAR ratings thresholds). Released or forfeited at the end of the performance measurement period based on provider quality scores.']
  remittance_advice_number varchar [note: 'Reference number of the 835 Electronic Remittance Advice (ERA) transaction sent to the provider for this capitation payment. Used to reconcile capitation disbursements with provider accounts receivable and the EDI clearinghouse (Availity/Change Healthcare) transaction log.']
  risk_adjusted_pmpm_rate decimal(12,4) [note: 'PMPM rate after application of the risk adjustment factor (RAF score) to the base contractual PMPM rate. Reflects the risk-adjusted capitation amount per member per month for Medicare Advantage or risk-adjusted commercial arrangements.']
  risk_pool_withhold_amount decimal(18,2) [note: 'Amount withheld from the gross capitation payment and placed into a shared risk pool per the contract terms. Risk pool withholds are held and distributed (or forfeited) at the end of the risk settlement period based on actual utilization versus targets.']
  risk_score decimal(10,4) [note: 'Aggregate Risk Adjustment Factor (RAF) score for the attributed member population used to adjust the capitation rate for this payment period. Derived from Hierarchical Condition Category (HCC) coding and CMS Risk Adjustment Processing System (RAPS/EDPS) submissions.']
  source_system_payment_reference varchar [note: 'Native identifier of this capitation payment record in the originating operational system (Facets, QNXT, or HealthEdge). Used for cross-system reconciliation and data lineage tracing between the Silver Layer and the system of record.']
  stop_loss_recovery_amount decimal(18,2) [note: 'Amount recovered from or credited to the provider under stop-loss provisions of the capitation contract. Positive values indicate plan reimbursement to provider for catastrophic cases exceeding the stop-loss threshold; negative values indicate provider liability adjustments.']
  updated_timestamp timestamp [note: 'Timestamp when this capitation payment record was last modified in the Silver Layer data platform. Tracks the most recent update for change data capture (CDC), audit trail, and reconciliation purposes.']
  vbc_contract_flag boolean [note: 'Indicates whether this capitation payment is made under a Value-Based Care (VBC) or Accountable Care Organization (ACO) contract arrangement, as opposed to a standard fee-for-service capitation. Drives VBC performance reporting and quality incentive calculations.']
  void_reason varchar [note: 'Business reason code or description explaining why this capitation payment was voided or reversed. Populated only when payment_status is \'voided\' or \'reversed\'. Examples: contract_termination, duplicate_payment, enrollment_error, rate_correction.']

  Note: 'Transactional record of each capitation payment disbursed to a provider under a capitation arrangement. Captures payment period (month/year), attributed member count, PMPM rate applied, gross payment amount, adjustments (retroactive enrollment changes, risk pool settlements, stop-loss recoveries), net payment amount, payment date, payment status, and remittance advice reference. Feeds accounts payable, provider remittance reporting (835 ERA), and contract financial summary reconciliation.'
}

Table contract.vbc_contract {
  vbc_contract_id varchar [pk, note: 'Unique surrogate identifier for the Value-Based Care (VBC) contract record in the Silver layer lakehouse. Primary key for all VBC contract master records including ACO agreements, shared savings, bundled payment, and risk-sharing arrangements.']
  contract_provider_contract_id varchar [note: 'Foreign key linking to contract.provider_contract. Business justification: VBC contracts are a subtype of provider contracts; linking them centralizes contract metadata and removes redundant columns.']
  regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: VBC_REPORTING: Value‑based contracts calculate shared savings against a risk pool; required for performance and settlement reports.']
  aco_cms_identifier varchar [note: 'CMS-assigned unique identifier for the ACO participating in the Medicare Shared Savings Program (MSSP) or other CMS Innovation Center models. Required for RAPS/EDPS submissions and CMS regulatory reporting.']
  aco_entity_name varchar [note: 'Legal name of the ACO, IPA, or provider organization that is the counterparty to this VBC contract. Used for regulatory reporting to CMS, network directory maintenance, and reconciliation settlement correspondence.']
  aco_entity_tin varchar [note: 'Federal Tax Identification Number (TIN/EIN) of the ACO or IPA entity party to this contract. Required for CMS regulatory submissions, 1099 reporting, and settlement payment processing.']
  actual_expenditure decimal(18,2) [note: 'Total actual claims expenditure (in USD) incurred by attributed members or episode participants during the performance period. Compared against the benchmark expenditure target to determine shared savings or shared loss amounts.']
  amendment_effective_date date [note: 'Date on which the most recent contract amendment became effective. Used to determine which contract terms apply to claims and reconciliation calculations for a given service date.']
  attributed_member_count varchar [note: 'Number of health plan members attributed to this VBC contract/ACO entity for the current performance period. Used as the denominator for PMPM calculations, benchmark setting, and population health reporting.']
  attribution_methodology varchar [note: 'Method used to assign health plan members to this VBC contract/ACO entity for performance measurement. Prospective: members assigned at start of period based on prior utilization; Retrospective: members assigned at end of period based on actual utilization; Voluntary: member elects assignment.']
  auto_renewal_flag boolean [note: 'Indicates whether this VBC contract is configured to automatically renew at the end of the current term without requiring a new execution. True = auto-renews; False = requires affirmative renewal action.']
  benchmark_expenditure_target decimal(18,2) [note: 'The risk-adjusted, trend-adjusted target expenditure amount (in USD) against which actual expenditures are compared during reconciliation. Calculated using historical claims data, risk scores (HCC/RAF), and applicable trend factors per the contract methodology.']
  cms_program_track varchar [note: 'Specific CMS Innovation Center program track or model under which this contract operates (e.g., \'MSSP_BASIC_A\', \'MSSP_BASIC_E\', \'MSSP_ENHANCED\', \'BPCI_A\', \'CJR\', \'PCF\'). Null for commercial VBC contracts not affiliated with a CMS program. [ENUM-REF-CANDIDATE: MSSP_BASIC_A|MSSP_BASIC_B|MSSP_BASIC_C|MSSP_BASIC_D|MSSP_BASIC_E|MSSP_ENHANCED|BPCI_A|CJR|PCF|DCE — promote to reference product]']
  contract_amendment_number varchar [note: 'Sequential identifier for the most recent amendment to this VBC contract (e.g., \'AMD-003\'). Tracks contract modifications including rate changes, term extensions, quality measure updates, and risk arrangement adjustments. Null for original, unamended contracts.']
  created_timestamp timestamp [note: 'Timestamp when this VBC contract record was first created in the system. Used for audit trail, data lineage, and regulatory record-keeping. Conforms to ISO 8601 format (yyyy-MM-ddTHH:mm:ss.SSSXXX).']
  episode_target_price decimal(18,2) [note: 'The risk-adjusted target price (in USD) for a single bundled payment episode. Calculated from historical claims data with applicable discounts and trend adjustments. Actual episode expenditures are compared to this target for reconciliation. Null for non-bundled VBC models.']
  episode_trigger_code varchar [note: 'The CPT procedure code or DRG (Diagnosis Related Group) code that initiates a bundled payment episode. For example, DRG 470 triggers a major joint replacement episode under BPCI-A. Null for non-bundled VBC models.']
  episode_type varchar [note: 'For bundled payment contracts, the clinical episode category being bundled (e.g., \'joint_replacement\', \'cardiac_surgery\', \'maternity\', \'hip_fracture\', \'spinal_fusion\'). Null for non-bundled VBC models. Determines the trigger event, episode window, and target price methodology. [ENUM-REF-CANDIDATE: joint_replacement|cardiac_surgery|maternity|hip_fracture|spinal_fusion|pneumonia|copd|stroke — promote to reference product]']
  episode_window_days varchar [note: 'Total number of days in the bundled payment episode window, measured from the trigger event (e.g., 90 days post-discharge for BPCI-A). Defines the period during which all included services are attributed to the bundle for reconciliation.']
  hedis_measure_targets varchar [note: 'Pipe-delimited list of HEDIS or CMS STAR measure identifiers and their contractual target thresholds included as quality gate requirements for this VBC contract (e.g., \'CBP:75.0|CDC-HbA1c:80.0|W34:85.0\'). Supports quality performance monitoring and NCQA reporting.']
  line_of_business varchar [note: 'Line of business under which this VBC contract operates. Determines applicable regulatory framework, benchmark methodology, and quality measure set (e.g., HEDIS for commercial, STAR for Medicare Advantage, MSSP for fee-for-service Medicare). [ENUM-REF-CANDIDATE: commercial|medicare_advantage|medicaid|mssp|bpci_a|exchange|dual_eligible — promote to reference product]']
  max_shared_loss_rate decimal(7,4) [note: 'The maximum percentage of benchmark expenditure (expressed as a decimal) that can be assessed as shared loss against the ACO/provider entity. Caps the provider\'s downside financial exposure in two-sided risk arrangements.']
  max_shared_savings_rate decimal(7,4) [note: 'The maximum percentage of benchmark expenditure (expressed as a decimal) that can be distributed as shared savings to the ACO/provider entity, regardless of actual savings achieved. Caps the health plan\'s financial exposure on the upside.']
  minimum_loss_rate decimal(7,4) [note: 'The minimum percentage threshold (expressed as a decimal) by which actual expenditures must exceed the benchmark before any shared loss is assessed. Applicable to two-sided risk arrangements. Symmetric counterpart to the Minimum Savings Rate (MSR).']
  minimum_savings_rate decimal(7,4) [note: 'The minimum percentage threshold (expressed as a decimal, e.g., 0.02 = 2%) by which actual expenditures must fall below the benchmark before any shared savings are distributed. Protects against random variation triggering unearned payments. Required field for MSSP Track 1 and Track 1+ contracts.']
  performance_period_end date [note: 'End date of the current performance measurement period. Marks the close of the measurement window after which actual expenditures are compared to the benchmark target for reconciliation and settlement.']
  performance_period_start date [note: 'Start date of the current performance measurement period for this VBC contract. Defines the window during which attributed member expenditures, quality scores, and utilization are measured against the benchmark.']
  performance_year varchar [note: 'Calendar or contract year for which performance is being measured and reconciled under this VBC contract. Used to track year-over-year performance trends, benchmark updates, and quality score progression. Typically a 4-digit year (e.g., 2024).']
  quality_gate_met boolean [note: 'Indicates whether the ACO/provider entity met the minimum quality performance threshold (quality gate) required to be eligible for shared savings distribution. True = quality gate satisfied; False = quality gate not met, shared savings withheld or reduced.']
  quality_score decimal(7,4) [note: 'Composite quality performance score (expressed as a decimal percentage, e.g., 0.85 = 85%) achieved by the ACO/provider entity during the performance period. Derived from HEDIS measures, STAR ratings, or contract-specific quality metrics. May gate or adjust shared savings distribution.']
  reconciliation_methodology varchar [note: 'Approach used to calculate and settle financial performance under this VBC contract. Prospective: target price set in advance; Retrospective: actual costs compared to historical benchmark after the period; Hybrid: combination of prospective target with retrospective quality adjustment.']
  reconciliation_status varchar [note: 'Current status of the financial reconciliation process for the performance period. Tracks the lifecycle from initial calculation through dispute resolution to final settlement: pending (not yet started), in_progress (under calculation), completed (finalized), disputed (under appeal), settled (payment processed).']
  risk_arrangement_type varchar [note: 'Specifies the financial risk-sharing structure between the health plan and the provider/ACO entity. Upside_only: provider shares in savings only; two_sided: provider shares in both savings and losses; full_risk: provider assumes full financial risk (global capitation); partial_risk: provider assumes a defined portion of risk.']
  risk_corridor_lower decimal(7,4) [note: 'Lower bound of the risk corridor (expressed as a decimal percentage below benchmark) within which no financial settlement occurs. Protects both parties from small random expenditure variations. Equivalent to the Minimum Savings Rate in MSSP terminology.']
  risk_corridor_upper decimal(7,4) [note: 'Upper bound of the risk corridor (expressed as a decimal percentage above benchmark) beyond which the health plan absorbs excess losses (stop-loss protection). Limits the provider\'s maximum financial exposure in two-sided risk arrangements.']
  savings_sharing_rate decimal(7,4) [note: 'The percentage (expressed as a decimal, e.g., 0.50 = 50%) of qualifying shared savings that is distributed to the ACO/provider entity. Negotiated contractually and may vary by quality score tier or performance band.']
  settlement_date date [note: 'Date on which the shared savings distribution or shared loss recoupment payment was or is scheduled to be processed. Used for financial accrual, IBNR reserve release, and cash flow reporting.']
  shared_savings_amount decimal(18,2) [note: 'Net shared savings (positive) or shared loss (negative) amount in USD calculated after reconciliation. Represents the financial settlement due to or owed by the ACO/provider entity based on performance against the benchmark. Positive = savings distribution; negative = loss recoupment.']
  stop_loss_threshold decimal(18,2) [note: 'Maximum dollar amount of shared loss that the ACO/provider entity is obligated to repay in a given performance period. Provides downside protection and is a key negotiated term in two-sided risk VBC contracts.']
  updated_timestamp timestamp [note: 'Timestamp when this VBC contract record was most recently modified. Used for change data capture (CDC), incremental ETL processing, and audit trail maintenance. Conforms to ISO 8601 format (yyyy-MM-ddTHH:mm:ss.SSSXXX).']
  vbc_model_type varchar [note: 'Classification of the VBC payment model governing this contract. Determines the financial risk structure and reconciliation methodology: shared_savings (upside only), shared_risk (two-sided), full_capitation (global budget), bundled_payment (episode-based), pay_for_performance (quality incentive). [ENUM-REF-CANDIDATE: shared_savings|shared_risk|full_capitation|bundled_payment|pay_for_performance|global_budget — promote to reference product if additional models are needed]']

  Note: 'Master record for Value-Based Care (VBC) contracts, ACO agreements, risk-sharing arrangements, and bundled payment programs. Captures VBC model type (shared savings, shared risk, full capitation, bundled payment, pay-for-performance), ACO/IPA entity details, and reconciliation status. Includes performance period definitions with performance year, benchmark expenditure target, actual expenditure, quality score, shared savings or loss amount, reconciliation status, settlement date, minimum savings rate (MSR), maximum shared savings/loss rate, and quality gate requirements (HEDIS/STAR measure targets). For bundled payment models, captures episode definitions including episode type (joint replacement, cardiac surgery, maternity), trigger event (procedure code, DRG), episode window (days pre/post trigger), target price, included/excluded services, reconciliation methodology, and quality metrics. Supports CMS MSSP, BPCI-A, and commercial ACO/VBC reporting. SSOT for all VBC, risk-sharing, episode-based payment contractual structures, performance period tracking, bundled episode definitions, and year-over-year performance trend analysis.'
}

Table contract.reimbursement_policy {
  reimbursement_policy_id varchar [pk, note: 'Unique surrogate identifier for the reimbursement policy record in the Silver Layer lakehouse. Primary key for this entity.']
  benefit_package_id varchar [note: 'Foreign key linking to plan.benefit_package. Business justification: Claims adjudication applies reimbursement policies at the benefit package level — a policy for inpatient coinsurance applies only to specific benefit packages (e.g., Gold PPO). This link is essential ']
  contract_provider_contract_id varchar [note: 'Reference to the provider contract under which this reimbursement policy is established. Links the policy to the contractual agreement governing provider reimbursement terms.']
  fee_schedule_id varchar [note: 'Reference to the fee schedule that serves as the base rate table for this reimbursement policy. The policy reduction or adjustment is applied against the rates defined in the referenced fee schedule.']
  regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: POLICY_COMPLIANCE: Policies may vary by risk pool; linking supports audit trails and CMS risk‑adjustment audits.']
  superseded_policy_reimbursement_policy_id varchar [note: 'Reference to the prior reimbursement policy record that this policy replaces or supersedes. Enables policy lineage tracking and ensures historical adjudication records can be traced to the correct policy version.']
  applies_to_facility boolean [note: 'Indicates whether this reimbursement policy applies to facility (institutional) claims (CMS-1450/UB-04). When True, the policy is enforced on facility claims submitted via 837I transactions.']
  applies_to_professional boolean [note: 'Indicates whether this reimbursement policy applies to professional (physician) claims (CMS-1500). When True, the policy is enforced on professional claims submitted via 837P transactions.']
  cpt_range_end varchar [note: 'Ending CPT or HCPCS procedure code in the range to which this reimbursement policy applies. Used in conjunction with cpt_range_start to define the applicable procedure code range. If equal to cpt_range_start, the policy applies to a single procedure code.']
  cpt_range_start varchar [note: 'Starting CPT or HCPCS procedure code in the range to which this reimbursement policy applies. Used in conjunction with cpt_range_end to define the applicable procedure code range for adjudication logic in Facets/QNXT.']
  created_timestamp timestamp [note: 'Timestamp when this reimbursement policy record was first created in the system. Supports audit trail requirements and policy lifecycle tracking.']
  denial_reason_code varchar [note: 'CARC (Claim Adjustment Reason Code) or RARC (Remittance Advice Remark Code) applied to claims denied or reduced under this policy. Populated on the 835 ERA transaction to communicate the adjudication outcome to providers. Aligns with HIPAA-mandated reason codes.']
  diagnosis_code_required boolean [note: 'Indicates whether a specific ICD diagnosis code must be present on the claim for this reimbursement policy to apply. When True, the adjudication engine validates the presence of qualifying diagnosis codes before applying the policy.']
  effective_date date [note: 'Date on which the reimbursement policy becomes effective and is applied to claims adjudication. Claims with service dates on or after this date are subject to the policy rules.']
  eob_message_code varchar [note: 'Code referencing the EOB message displayed to members when a claim is adjusted or denied under this reimbursement policy. Ensures member-facing communications are clear and compliant with ACA transparency requirements.']
  facets_policy_code varchar [note: 'System-specific policy code as configured in the Facets or QNXT core administration platform. Used to map this Silver Layer record back to the source adjudication system configuration for reconciliation and troubleshooting.']
  global_surgery_period_days varchar [note: 'Number of days in the global surgery package period during which related pre-operative and post-operative services are bundled into the surgical reimbursement. Standard CMS values are 0, 10, or 90 days. Applies only to global surgery policy types.']
  icd_version varchar [note: 'Version of the ICD diagnosis/procedure code set applicable to this reimbursement policy when diagnosis-based adjudication rules are enforced. Ensures correct code set is applied during claims processing.']
  lob varchar [note: 'Line of Business to which this reimbursement policy applies (e.g., Commercial, Medicare Advantage, Medicaid). Determines which claims populations are subject to this policy during adjudication. A policy may be LOB-specific or apply across multiple LOBs.']
  max_procedures_allowed varchar [note: 'Maximum number of procedures that can be reimbursed under this policy in a single claim or service encounter. Procedures exceeding this limit are denied or reduced per adjudication rules. Null indicates no limit.']
  modifier_code varchar [note: 'CPT or HCPCS modifier code associated with this reimbursement policy (e.g., 50=Bilateral, 51=Multiple Procedures, 80=Assistant Surgeon, 62=Two Surgeons). Triggers or qualifies the policy application during claims adjudication.']
  ncci_edit_type varchar [note: 'Indicates the NCCI edit category applicable to this reimbursement policy. Column 1/Column 2 edits identify procedure code pairs where one code is a component of another. Mutually exclusive edits identify code pairs that cannot be billed together. Used for unbundling policy enforcement.']
  network_tier varchar [note: 'Provider network tier to which this reimbursement policy applies. Policies may differ between in-network and out-of-network providers, or across tiered network structures (e.g., Tier 1 preferred, Tier 2 standard). Null indicates the policy applies across all network tiers.']
  override_allowed boolean [note: 'Indicates whether a manual override of this reimbursement policy is permitted during claims adjudication (e.g., by a claims examiner or medical reviewer). When True, authorized users may bypass the policy with documented justification.']
  override_requires_auth boolean [note: 'Indicates whether overriding this reimbursement policy requires a prior authorization (PA) or supervisory approval. When True, an authorization reference must be documented before the override is accepted in Facets/QNXT.']
  payment_methodology varchar [note: 'Reimbursement payment methodology under which this policy operates. Determines the base payment structure to which the policy rules are applied (e.g., fee-for-service rate reduction, bundled payment adjustment).']
  place_of_service_code varchar [note: 'CMS-defined two-digit Place of Service code indicating the setting where services are rendered (e.g., 11=Office, 21=Inpatient Hospital, 22=Outpatient Hospital). Used for place-of-service differential policies to apply site-of-service payment adjustments. Null if the policy applies regardless of setting.']
  policy_description varchar [note: 'Detailed narrative description of the reimbursement policy, including the business rationale, adjudication logic, and any exceptions or special conditions. Used for provider communications, EOB narratives, and internal training documentation.']
  policy_name varchar [note: 'Human-readable name or title of the reimbursement policy (e.g., \'Multiple Procedure Reduction Policy\', \'Bilateral Procedure Policy\'). Used in provider communications, EOB narratives, and adjudication configuration.']
  policy_number varchar [note: 'Externally-known alphanumeric identifier for the reimbursement policy as referenced in Facets/QNXT and communicated to providers. Used for cross-system reconciliation and provider inquiries.']
  policy_source varchar [note: 'Originating authority or source that defines this reimbursement policy. Distinguishes between federally mandated policies (CMS NCCI, MPPR), AMA CPT guidelines, state-mandated rules, and internally plan-defined or contract-specific policies.']
  policy_status varchar [note: 'Current lifecycle state of the reimbursement policy. Controls whether the policy is applied during claims adjudication in Facets/QNXT. Active policies are enforced; retired policies are retained for historical adjudication reference.']
  policy_type varchar [note: 'Categorical classification of the reimbursement policy governing how claims are adjudicated. Drives the adjudication logic applied in Facets/QNXT. [ENUM-REF-CANDIDATE: multiple_procedure_reduction|bilateral_procedure|assistant_surgeon|global_surgery|unbundling|place_of_service_differential|anesthesia|assistant_at_surgery|co_surgery|team_surgery|modifier_impact|site_of_service — promote to reference product]']
  policy_version varchar [note: 'Version identifier for this reimbursement policy, incremented when the policy terms are amended (e.g., \'1.0\', \'2.3\'). Supports policy lifecycle management and historical adjudication audits by identifying which version was active at a given service date.']
  primary_procedure_rank varchar [note: 'Ranking order used to determine which procedure is designated as the primary (highest-paid) procedure when multiple procedures are performed. The procedure with rank 1 is reimbursed at 100%; subsequent ranks receive the reduction percentage. Applies to multiple procedure reduction policies.']
  provider_specialty_code varchar [note: 'CMS or NUCC provider specialty code restricting this reimbursement policy to a specific provider specialty (e.g., 02=General Surgery, 93=Radiation Oncology). Null indicates the policy applies to all specialties. Used for specialty-specific reimbursement rules.']
  reduction_pct decimal(5,2) [note: 'Percentage by which the allowed amount is reduced when this policy is triggered during claims adjudication. For example, a value of 50.00 indicates the secondary procedure is reimbursed at 50% of the contracted rate. Applies to policies such as multiple procedure reduction and assistant surgeon.']
  regulatory_mandate_flag boolean [note: 'Indicates whether this reimbursement policy is mandated by a federal or state regulatory authority (e.g., CMS NCCI edits, state prompt payment laws). Regulatory mandate policies cannot be waived or overridden without regulatory approval.']
  regulatory_reference varchar [note: 'Citation to the specific regulatory rule, CMS manual chapter, state statute, or contractual clause that mandates or governs this reimbursement policy (e.g., \'CMS NCCI Chapter 4, Section 4.2\', \'42 CFR 422.520\'). Populated when regulatory_mandate_flag is True.']
  retroactive_adjustment_allowed boolean [note: 'Indicates whether this reimbursement policy can be applied retroactively to previously adjudicated claims when the policy is newly activated or amended. When True, claims reprocessing may be triggered for the applicable service date range.']
  revenue_code_range_end varchar [note: 'Ending UB-04 revenue code in the range to which this reimbursement policy applies for facility claims. Used in conjunction with revenue_code_range_start to define applicable revenue code ranges for institutional claim adjudication.']
  revenue_code_range_start varchar [note: 'Starting UB-04 revenue code in the range to which this reimbursement policy applies for facility claims. Used in conjunction with revenue_code_range_end to define applicable revenue code ranges for institutional claim adjudication.']
  termination_date date [note: 'Date on which the reimbursement policy expires and is no longer applied to new claims. Null indicates an open-ended policy with no defined end date. Claims with service dates after this date are not subject to this policy.']
  updated_timestamp timestamp [note: 'Timestamp when this reimbursement policy record was last modified. Used for change data capture (CDC) in the Databricks Silver Layer pipeline and for audit trail compliance.']

  Note: 'Defines payer reimbursement policies that govern how claims are adjudicated against contracted rates. Captures policy type (multiple procedure reduction, bilateral procedure, assistant surgeon, global surgery, unbundling rules, place-of-service differential), applicable CPT/HCPCS ranges, reduction percentage, effective date, and LOB applicability. Bridges contract terms to claims adjudication logic in Facets/QNXT.'
}

Table contract.provider_contract {
  provider_contract_id varchar [pk, note: 'Unique surrogate identifier for the provider contract record in the lakehouse Silver layer. Primary key for all contractual agreements between the health plan and providers.']
  fee_schedule_id varchar [note: 'Reference to the fee schedule (rate table) governing reimbursement amounts for specific CPT/HCPCS procedure codes under this contract. Applicable for fee-for-service and bundled payment contracts.']
  provider_id varchar [note: 'Reference to the provider (physician, hospital, clinic, ancillary provider, or DME supplier) who is party to this contract. Sourced from Provider Management System (Cactus/ProviderSource).']
  year_id varchar [note: 'Foreign key linking to plan.year. Business justification: Provider contracts are negotiated, renewed, and reported on a plan-year basis. Linking to plan.year enables plan-year-specific contract reporting, annual renewal tracking, open enrollment alignment, a']
  amendment_date date [note: 'Effective date of the most recent amendment to this contract. Used to determine which contract terms apply for a given date of service. Format: yyyy-MM-dd.']
  amendment_number varchar [note: 'Identifier for the most recent amendment to this contract. Null for original, unamended contracts. Tracks the amendment sequence for audit and compliance purposes. Sourced from Cactus/ProviderSource.']
  aso_flag boolean [note: 'Indicates whether this contract operates under an Administrative Services Only (ASO) arrangement where the employer self-funds claims and the health plan provides administrative services only. True = ASO arrangement.']
  auto_renewal_flag boolean [note: 'Indicates whether this contract is configured to automatically renew upon reaching its termination date without requiring re-execution. True = auto-renews; False = requires manual renewal action.']
  capitation_rate_pmpm decimal(12,4) [note: 'Fixed monthly payment amount per enrolled member (Per Member Per Month - PMPM) paid to the provider under capitation contracts. Applicable only when payment_methodology = capitation. Expressed in USD.']
  carve_out_indicator boolean [note: 'Indicates whether specific services or benefit categories are carved out of this contract and managed under a separate arrangement (e.g., behavioral health carve-out, pharmacy carve-out). True = carve-outs exist.']
  contract_name varchar [note: 'Human-readable descriptive name of the contract as recorded in the Provider Management System. Used for display in contracting workflows, provider communications, and reporting dashboards.']
  contract_number varchar [note: 'Externally-known, human-readable contract identifier assigned by the health plan contracting department. Used in correspondence, amendments, and provider communications. Sourced from Cactus/ProviderSource contract module.']
  contract_status varchar [note: 'Current lifecycle state of the provider contract. Drives eligibility verification, claims adjudication routing, and provider directory inclusion. Values: draft, pending_execution, active, suspended, terminated, expired, under_amendment. [ENUM-REF-CANDIDATE: draft|pending_execution|active|suspended|terminated|expired|under_amendment — promote to reference product]']
  contract_tier varchar [note: 'Tiering classification assigned to this contract, reflecting the provider\'s preferred status and associated member cost-sharing levels. Tier 1/preferred providers typically have lower member cost-sharing. Used in benefit design and member-facing provider directory.']
  contract_type varchar [note: 'Classification of the contractual arrangement by payment and relationship structure. Determines reimbursement methodology and applicable rate tables. Values: fee_for_service (FFS), capitation, bundled_payment, value_based_care (VBC/ACO), letter_of_agreement (LOA), single_case_agreement (SCA), out_of_network_gap_fill. [ENUM-REF-CANDIDATE: fee_for_service|capitation|bundled_payment|value_based_care|letter_of_agreement|single_case_agreement|out_of_network_gap_fill — promote to reference product]']
  cpt_range_end varchar [note: 'Ending CPT or HCPCS procedure code defining the upper bound of the service scope covered under this contract. Used with cpt_range_start to define the range of covered procedures.']
  cpt_range_start varchar [note: 'Starting CPT or HCPCS procedure code defining the lower bound of the service scope covered under this contract. Used with cpt_range_end to define the range of covered procedures. Sourced from AMA CPT code set.']
  created_timestamp timestamp [note: 'Timestamp when this provider contract record was first created in the lakehouse Silver layer. Supports audit trail and data lineage requirements. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.']
  credentialing_required_flag boolean [note: 'Indicates whether the provider must maintain active credentialing status as a condition of this contract. True = credentialing is a contractual requirement. Linked to NCQA credentialing standards.']
  delegation_flag boolean [note: 'Indicates whether credentialing, utilization management, or other health plan functions have been delegated to the provider organization under this contract. True = delegation arrangement exists. Requires NCQA delegation oversight.']
  drg_range_end varchar [note: 'Ending Diagnosis Related Group (DRG) code defining the upper bound of inpatient service scope covered under this contract. Used with drg_range_start to define the range of covered DRGs.']
  drg_range_start varchar [note: 'Starting Diagnosis Related Group (DRG) code defining the lower bound of inpatient service scope covered under this contract. Applicable for hospital contracts with DRG-based payment methodology.']
  effective_date date [note: 'Date on which the contract becomes legally binding and reimbursement terms take effect. Used in claims adjudication to determine applicable rate schedule. Format: yyyy-MM-dd.']
  execution_date date [note: 'Date on which all parties signed and the contract was fully executed. May differ from effective_date for retroactive or prospective contracts. Sourced from Cactus/ProviderSource contract module.']
  lob_applicability varchar [note: 'Line of Business (LOB) to which this contract applies. Determines which member populations and benefit plans are governed by this contract\'s reimbursement terms. Values: commercial, medicare_advantage, medicaid, marketplace, cobra, tricare, all. [ENUM-REF-CANDIDATE: commercial|medicare_advantage|medicaid|marketplace|cobra|tricare|all — promote to reference product]']
  npi varchar [note: 'National Provider Identifier (NPI) of the contracting provider as assigned by CMS NPPES. 10-digit unique identifier used in EDI transactions (837/835) and claims adjudication to identify the contracted provider.']
  payment_methodology varchar [note: 'Specific reimbursement calculation methodology governing how the health plan pays the provider under this contract. Distinct from contract_type in that it specifies the payment calculation approach. Examples: fee_for_service (FFS), capitation (PMPM), per_diem, case_rate, DRG-based, bundled, Reference Based Pricing (RBP), global_budget, salary. [ENUM-REF-CANDIDATE: fee_for_service|capitation|per_diem|case_rate|drg_based|bundled|rbp|global_budget|salary — promote to reference product]']
  provider_type varchar [note: 'Classification of the contracted provider entity type. Drives applicable reimbursement rules, credentialing requirements, and service scope definitions. [ENUM-REF-CANDIDATE: physician|hospital|clinic|ancillary|dme_supplier|behavioral_health|skilled_nursing|home_health|laboratory|radiology — promote to reference product]']
  quality_incentive_flag boolean [note: 'Indicates whether this contract includes quality-based incentive payments tied to HEDIS, STAR ratings, CAHPS, or other quality performance measures. True = quality incentive provisions exist in the contract.']
  raf_applicable_flag boolean [note: 'Indicates whether Risk Adjustment Factor (RAF) / Hierarchical Condition Category (HCC) coding obligations apply to the provider under this contract. True = provider has contractual HCC coding and encounter data submission requirements.']
  renewal_notice_days varchar [note: 'Number of days prior to the termination date by which either party must provide written notice of intent not to renew. Contractually mandated notice period for non-renewal. Typically 30, 60, or 90 days.']
  revenue_code_range_end varchar [note: 'Ending UB-04 revenue code defining the upper bound of facility service categories covered under this contract. Used with revenue_code_range_start to define the range of covered revenue codes.']
  revenue_code_range_start varchar [note: 'Starting UB-04 revenue code defining the lower bound of facility service categories covered under this contract. Used for hospital and facility contracts to define covered service lines.']
  risk_sharing_model varchar [note: 'Specifies the financial risk-sharing arrangement between the health plan and provider under VBC or ACO contracts. Determines how savings and losses are allocated. Values: none, shared_savings, shared_risk, full_risk, upside_only, downside_only.']
  service_exclusion_notes varchar [note: 'Free-text description of specific services, procedures, or conditions explicitly excluded from the scope of this contract. Supplements the CPT/DRG/revenue code ranges with narrative exclusion details.']
  source_system_contract_reference varchar [note: 'Native contract identifier from the originating operational system (Cactus, ProviderSource, Facets, or QNXT). Enables traceability and reconciliation back to the system of record.']
  tax_identification_number varchar [note: 'Federal Tax Identification Number (TIN) or Employer Identification Number (EIN) of the contracting provider entity. Used for 1099 reporting, payment processing, and IRS compliance. 9-digit numeric value.']
  template_code varchar [note: 'Reference to the standard contract template used as the basis for this agreement. Enables tracking of which template version governs the contract terms and supports template-level compliance audits.']
  termination_date date [note: 'Date on which the contract ceases to be binding. Null for open-ended contracts. Used to determine provider in-network status for claims with dates of service at or before this date. Format: yyyy-MM-dd.']
  termination_notice_days varchar [note: 'Number of days advance written notice required by either party to terminate the contract for convenience (without cause). Distinct from renewal_notice_days which applies at contract expiry.']
  tpa_flag boolean [note: 'Indicates whether this contract is administered by a Third Party Administrator (TPA) on behalf of the health plan. True = TPA-administered; False = directly administered by the health plan. Relevant for ASO arrangements.']
  updated_timestamp timestamp [note: 'Timestamp when this provider contract record was last modified in the lakehouse Silver layer. Used for incremental load detection and change data capture. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.']
  vbc_flag boolean [note: 'Indicates whether this contract includes Value-Based Care (VBC) components such as quality bonuses, shared savings, or risk-sharing arrangements beyond standard fee-for-service reimbursement.']

  Note: 'Master record for all contractual agreements between the health plan and providers (physicians, hospitals, clinics, ancillary providers, DME suppliers), including formal contracts, Letters of Agreement (LOAs), Letters of Intent (LOIs), single-case agreements (SCAs), and out-of-network gap-fill arrangements. Captures contract type (fee-for-service, capitation, bundled payment, VBC/ACO, LOA, SCA), contract status, effective and termination dates, line of business (LOB) applicability, TPA/ASO designations, auto-renewal flags, contract tier, owning network, template reference, payment methodology classification, and service scope definitions (covered/excluded service categories, CPT/HCPCS ranges, revenue code ranges, DRG ranges, carve-out indicators, inclusion/exclusion flags). SSOT for all provider reimbursement agreements, interim arrangements, and contracted service scope. Sourced from Provider Management System (Cactus/ProviderSource) and Core Administration Platform (Facets/QNXT).'
}

Table risk.member_risk_score {
  member_risk_score_id varchar [pk, note: 'System-generated unique identifier for the member risk score record.']
  member_identity_id varchar [note: 'Unique identifier of the member to whom the risk score applies.']
  network_service_area_id varchar [note: 'Foreign key linking to network.service_area. Business justification: Risk scores vary by geographic service area for actuarial rate development and risk pool analysis. Required for geographic risk stratification, county-level risk reporting, and service area adequacy o']
  year_id varchar [note: 'Foreign key linking to plan.year. Business justification: Risk scores are calculated per plan year for CMS risk adjustment payment cycles. Linking member_risk_score to plan.year enables joining scores to plan year configurations, accumulator reset dates, and']
  audit_user varchar [note: 'User ID of the person who performed the most recent audit action.']
  cms_published_score decimal(10,4) [note: 'RAF score value as published by CMS after reconciliation.']
  cms_submission_status varchar [note: 'Current status of the score\'s submission to CMS.']
  corrective_action varchar [note: 'Description of actions taken to resolve score variance (e.g., code addendum, data correction).']
  created_timestamp timestamp [note: 'Timestamp when the risk score record was first created in the data lake.']
  demographic_factor_score decimal(10,4) [note: 'Score component derived from member demographics (age, gender, Medicaid status).']
  diagnosis_count varchar [note: 'Number of distinct diagnoses captured for the member in the scoring period.']
  effective_timestamp timestamp [note: 'Exact timestamp when the risk score became effective.']
  expiration_date date [note: 'Date after which the risk score is no longer valid for payment.']
  is_manual_override boolean [note: 'Indicates whether the score was manually overridden.']
  manual_override_reason varchar [note: 'Reason provided for a manual override of the risk score.']
  model_name varchar [note: 'Name of the risk adjustment model (e.g., "CMS‑HCC", "RxHCC", "HHS‑HCC").']
  model_version varchar [note: 'Version identifier of the actuarial model used to generate the score (e.g., "CMS‑HCC v2023").']
  payment_year varchar [note: 'Calendar year for which the risk score is used in CMS payment calculations.']
  plan_calculated_score decimal(10,4) [note: 'RAF score calculated internally by the health plan prior to CMS submission.']
  record_status varchar [note: 'Lifecycle status of the risk score record.']
  resubmission_reference varchar [note: 'Reference identifier for any resubmitted score file to CMS.']
  risk_adjustment_factor_category varchar [note: 'Category of the risk adjustment factor (e.g., "RAF", "HCC", "RxHCC").']
  risk_score_code varchar [note: 'Business identifier code for the risk score record, often composed of member ID, year, and model version.']
  risk_score_confidence_score decimal(5,2) [note: 'Confidence level (0‑100) assigned by the model to the score.']
  risk_score_label varchar [note: 'Human‑readable label describing the risk score record (e.g., "2023 Medicare Advantage RAF").']
  risk_score_notes varchar [note: 'Free‑text field for any additional commentary or observations.']
  risk_score_source varchar [note: 'Data source used to generate the score.']
  risk_score_status varchar [note: 'Current processing status of the risk score.']
  risk_score_type varchar [note: 'Indicates whether the score is projected (prospective), derived from current data (concurrent), or the final CMS‑published value.']
  risk_score_value decimal(10,4) [note: 'Numeric RAF score calculated for the member (e.g., 1.2345).']
  score_components varchar [note: 'Delimited list or JSON string of component scores (e.g., HCC contributions, demographic adjustments).']
  score_effective_date date [note: 'Date on which the risk score becomes effective for payment calculations.']
  score_variance decimal(10,4) [note: 'Numeric difference between the plan‑calculated score and the CMS‑published score.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the risk score record.']
  variance_category varchar [note: 'Root‑cause classification for any variance between plan and CMS scores.']

  Note: 'Authoritative member-level risk score record and reconciliation tracker. Captures RAF (Risk Adjustment Factor) scores, HCC (Hierarchical Condition Category) mappings, CMS reconciliation outcomes, and plan-vs-CMS variance analysis. Stores prospective and concurrent RAF scores derived from actuarial models and encounter data, including score effective dates, payment year, model version (CMS-HCC, RxHCC, HHS-HCC, PACE), score components, CMS submission status, plan-calculated vs. CMS-published RAF variance, root cause category (missing diagnoses, HCC hierarchy differences, demographic factors), corrective actions, and resubmission references. Core SSOT for member-level risk in Medicare Advantage, ACA, and Medicaid risk adjustment programs. Subsumes RAF reconciliation tracking.'
}

Table risk.hcc_mapping {
  hcc_mapping_id varchar [pk, note: 'Primary key for hcc_mapping']
  age_adjustment_factor decimal(5,4) [note: 'Multiplier adjusting the HCC coefficient based on member age.']
  coefficient decimal(10,6) [note: 'Weighting coefficient used in RAF score calculations for the HCC.']
  created_timestamp timestamp [note: 'Timestamp when the mapping record was first loaded into the lakehouse.']
  demographic_adjustment_factor decimal(5,4) [note: 'Factor adjusting the HCC weight for demographic characteristics (age, gender, etc.).']
  disease_interaction_group varchar [note: 'Identifier for a group of diagnoses that have interaction effects.']
  effective_date date [note: 'Date when this mapping becomes effective.']
  expiration_date date [note: 'Date when this mapping expires or is superseded; null if still active.']
  gender_adjustment_factor decimal(5,4) [note: 'Multiplier adjusting the HCC coefficient based on member gender.']
  hcc_code varchar [note: 'CMS-assigned HCC identifier linked to the diagnosis.']
  hcc_description varchar [note: 'Human‑readable description of the HCC.']
  hcc_mapping_status varchar [note: 'Current lifecycle status of the mapping record.']
  hierarchy_level varchar [note: 'Depth of the HCC within the hierarchical structure (0 = top level).']
  icd10_code varchar [note: 'Standard ICD-10 diagnosis code associated with the mapping.']
  icd10_description varchar [note: 'Full textual description of the ICD-10 diagnosis.']
  interaction_flag boolean [note: 'Indicates whether the diagnosis interacts with other HCCs (yes) or not (no).']
  is_excluded boolean [note: 'Indicates whether the diagnosis is excluded from the current model year.']
  is_mapped boolean [note: 'True if the ICD‑10 code has a valid HCC mapping in this version.']
  last_review_date date [note: 'Date when the mapping was last reviewed for accuracy.']
  last_updated_by varchar [note: 'Identifier of the user or process that performed the last update.']
  last_updated_timestamp timestamp [note: 'Timestamp of the most recent update to the mapping record.']
  mapping_source varchar [note: 'Origin of the mapping data.']
  model_year varchar [note: 'Calendar year of the CMS HCC model version to which the mapping applies.']
  notes varchar [note: 'Free‑form comments or audit notes regarding the mapping.']
  parent_hcc_code varchar [note: 'Code of the immediate parent HCC in the hierarchy, if applicable.']
  plan_type_adjustment_factor decimal(5,4) [note: 'Adjustment factor for the HCC based on the member\'s health plan type (e.g., HMO, PPO).']
  region_adjustment_factor decimal(5,4) [note: 'Adjustment factor reflecting geographic cost variations.']
  review_status varchar [note: 'Current status of the most recent review process.']
  risk_score_weight decimal(5,4) [note: 'Weight applied to the HCC when aggregating RAF scores.']
  source_version varchar [note: 'Version identifier of the source CMS model (e.g., V24, V28).']

  Note: 'Maps ICD-10 diagnosis codes to Hierarchical Condition Categories (HCCs) per CMS model version. Stores the ICD-to-HCC crosswalk, HCC hierarchy relationships (parent/child HCC hierarchies), coefficient values by model year, disease interaction flags, and demographic adjustment factors. Supports RAF score calculation, RAPS/EDPS submission validation, and RADV audit defense. Reference entity managed per CMS annual model updates (V24, V28 transition). Source: CMS annual HCC model release files.'
}

Table risk.raps_submission {
  raps_submission_id varchar [pk, note: 'System-generated unique identifier for each RAPS submission batch record.']
  group_practice_id varchar [note: 'Foreign key linking to provider.group_practice. Business justification: Group practices are billing entities in risk adjustment — RAPS submissions are often aggregated at the group practice level. Linking raps_submission to group_practice supports group-level risk adjustm']
  group_renewal_id varchar [note: 'Foreign key linking to employer.group_renewal. Business justification: RAPS submissions are tied to specific renewal cycles for CMS risk adjustment reconciliation and payment year rate setting. Actuaries and compliance teams need to track which renewal period each RAPS b']
  rendering_provider_id varchar [note: 'Foreign key linking to provider.provider. Business justification: RAPS submissions contain diagnosis codes attributed to rendering providers. Linking raps_submission to provider enables provider-level risk adjustment analytics, error rate tracking, and supports CMS ']
  year_id varchar [note: 'Foreign key linking to plan.year. Business justification: RAPS submissions are filed per plan year payment cycle. Linking to plan.year allows joining submissions to plan year configurations, CMS submission deadlines, and open enrollment periods for risk adju']
  accepted_record_count varchar [note: 'Number of records that CMS accepted without error in this submission.']
  batch_number varchar [note: 'External batch identifier assigned by the source system for the RAPS submission.']
  cms_acknowledgment_status varchar [note: 'Acknowledgment status returned by CMS for the submitted batch.']
  created_timestamp timestamp [note: 'Timestamp when the submission record was first created in the data warehouse.']
  error_disposition varchar [note: 'Textual description of any errors or rejections returned by CMS for this batch.']
  payment_year varchar [note: 'Calendar year for which the risk adjustment payment is being calculated.']
  plan_contract_number varchar [note: 'Contract number of the plan submitted to CMS for risk adjustment.']
  plan_type varchar [note: 'Type of health plan associated with the submission (e.g., HMO, PPO).']
  raps_submission_status varchar [note: 'Current processing status of the RAPS submission within the CMS workflow.']
  rejected_record_count varchar [note: 'Number of records that CMS rejected or flagged with errors in this submission.']
  risk_adjustment_factor decimal(5,4) [note: 'Aggregated HCC-derived factor used to compute the plan\'s risk adjustment payment.']
  risk_adjustment_year varchar [note: 'Year for which the risk adjustment factors are being reported.']
  risk_score decimal(10,4) [note: 'Risk Adjustment Factor (RAF) score calculated for the plan in this submission.']
  submission_file_checksum varchar [note: 'SHA-256 checksum of the transmitted file to ensure data integrity.']
  submission_file_name varchar [note: 'Name of the flat file or payload transmitted to CMS for this batch.']
  submission_timestamp timestamp [note: 'Date and time when the RAPS batch was transmitted to the CMS gateway.']
  submission_user_name varchar [note: 'Display name of the user who submitted the batch.']
  total_record_count varchar [note: 'Total number of individual member risk adjustment records included in the batch.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the submission record.']

  Note: 'Tracks Risk Adjustment Processing System (RAPS) submissions to CMS for Medicare Advantage risk adjustment. Captures submission batch ID, submission date, plan contract number, payment year, record counts, accepted/rejected record counts, CMS acknowledgment status, and error disposition. Each record represents a RAPS batch transaction submitted via the CMS RAPS gateway. Source: Milliman MG-ALFA and EDI gateway.'
}

Table risk.rate_development {
  rate_development_id varchar [pk, note: 'System-generated unique identifier for each rate development record.']
  group_renewal_id varchar [note: 'Foreign key linking to employer.group_renewal. Business justification: Rate development outputs feed directly into renewal pricing calculations. Actuaries develop rates for specific renewal cycles, incorporating trend factors and experience rating. Required for renewal p']
  network_service_area_id varchar [note: 'Foreign key linking to network.service_area. Business justification: Rates are developed by service area (rating area) as required by ACA and state insurance regulations. Geographic rating is mandatory for regulatory filings. Service area demographics, provider costs, ']
  regulatory_submission_id varchar [note: 'Foreign key linking to compliance.regulatory_submission. Business justification: Rate filings are regulatory submissions to state insurance departments. Business process: Actuarial rate development results must be filed with DOI; regulatory_submission tracks filing status, due dat']
  year_id varchar [note: 'Foreign key linking to plan.year. Business justification: Rate development is performed per plan year for regulatory filing and actuarial certification. Linking rate_development to plan.year enables joining actuarial assumptions to plan year open enrollment ']
  administrative_loading decimal(6,4) [note: 'Percentage added to cover administrative expenses.']
  age_factor decimal(6,4) [note: 'Multiplicative factor based on member age.']
  approved_timestamp timestamp [note: 'Timestamp when the rate was formally approved for use.']
  base_rate decimal(12,4) [note: 'Fundamental rate before any rating factors are applied.']
  created_timestamp timestamp [note: 'Timestamp when the rate development record was first created.']
  credibility_factor decimal(6,4) [note: 'Weighting factor blending experience data with credibility.']
  development_number varchar [note: 'External reference number assigned to the rate development for tracking and regulatory filing.']
  effective_date date [note: 'Date when the approved rate becomes effective for premium calculations.']
  expiration_date date [note: 'Date when the rate ceases to be effective (nullable for open‑ended rates).']
  final_approved_rate decimal(12,4) [note: 'Rate after all factors, loadings, and regulatory adjustments are applied.']
  gender_factor decimal(6,4) [note: 'Multiplicative factor based on member gender.']
  geographic_factor decimal(6,4) [note: 'Factor reflecting cost differences across rating areas.']
  group_size_factor decimal(6,4) [note: 'Factor based on the size of the employer group.']
  industry_factor decimal(6,4) [note: 'Factor derived from the employer\'s industry classification.']
  line_of_business varchar [note: 'Business segment to which the rate applies (e.g., health, dental).']
  mlr_target decimal(5,2) [note: 'Regulatory MLR target percentage for the product.']
  notes varchar [note: 'Free‑form comments or rationale entered by actuaries.']
  plan_type varchar [note: 'Type of insurance plan for which the rate is calculated.']
  plan_type_loading decimal(6,4) [note: 'Additional loading applied for specific plan designs.']
  profit_margin decimal(6,4) [note: 'Target profit margin applied to the rate.']
  rate_development_status varchar [note: 'Current lifecycle status of the rate development record.']
  rate_methodology varchar [note: 'Method used to calculate the rate (e.g., community rating, experience rating, blended).']
  rating_area varchar [note: 'Geographic region used in rating calculations.']
  rating_period_end date [note: 'Last day of the rating period for which the rate is being developed.']
  rating_period_start date [note: 'First day of the rating period for which the rate is being developed.']
  regulatory_filing_reference varchar [note: 'Identifier of the state or federal filing associated with this rate.']
  tobacco_factor decimal(6,4) [note: 'Factor applied for tobacco use status.']
  trend_factor decimal(6,4) [note: 'Factor used to project future cost trends.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the rate development record.']
  version_number varchar [note: 'Sequential version of the rate development record for change tracking.']

  Note: 'Captures actuarial rate development records and their constituent rating factors for premium rate-setting across plan types, market segments, and rating areas. Stores rate development ID, rating period, LOB, plan type, geographic rating area, base rate, and all applicable rating factors (age/gender, geographic area, tobacco use, group size, industry, plan-type loading). Includes trend factor application, credibility-weighted experience blending, administrative loading, profit margin, MLR target, final approved rate, and regulatory filing reference. Supports ACA community rating and experience rating methodologies. Source: Milliman MG-ALFA rate-setting models. Links to state DOI rate filings.'
}

Table risk.ibnr_reserve {
  ibnr_reserve_id varchar [pk, note: 'Primary key for ibnr_reserve']
  regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: IBNR reserve estimates are calculated per risk pool; linking provides context and allows roll‑up.']
  stop_loss_policy_id varchar [note: 'Foreign key linking to employer.stop_loss_policy. Business justification: IBNR reserves inform stop-loss attachment point decisions and premium calculations for self-funded groups. Actuaries use IBNR estimates to assess group financial exposure and set appropriate stop-loss']
  year_id varchar [note: 'Foreign key linking to plan.year. Business justification: IBNR reserves are calculated per plan year for financial close, MLR reporting, and RBC filings. Linking ibnr_reserve to plan.year enables joining reserve amounts to plan year budget amounts, premium e']
  actuarial_confidence_level decimal(3,2) [note: 'Confidence level (e.g., 0.95) associated with the interval.']
  confidence_interval_lower decimal(15,2) [note: 'Lower bound of the actuarial confidence interval for the IBNR estimate.']
  confidence_interval_upper decimal(15,2) [note: 'Upper bound of the actuarial confidence interval for the IBNR estimate.']
  created_timestamp timestamp [note: 'Timestamp when the reserve record was created in the system.']
  currency_code varchar [note: 'ISO 4217 currency code for monetary amounts.']
  data_quality_score decimal(3,2) [note: 'Score indicating quality of input data used for reserve.']
  development_factor decimal(10,4) [note: 'Factor applied to projected losses to estimate ultimate cost.']
  expected_loss_ratio decimal(5,4) [note: 'Projected loss ratio used in reserve calculation.']
  external_reserve_code varchar [note: 'Identifier used by external actuarial systems to reference this reserve.']
  forecast_horizon_months varchar [note: 'Number of months ahead the reserve projection covers.']
  hcc_weighted_amount decimal(15,2) [note: 'IBNR amount weighted by Hierarchical Condition Category risk scores.']
  ibnr_amount decimal(15,2) [note: 'Estimated Incurred But Not Reported reserve amount in USD.']
  ibnr_pmpm decimal(10,2) [note: 'IBNR reserve expressed on a per member per month basis.']
  ibnr_reserve_status varchar [note: 'Current lifecycle status of the reserve estimate.']
  lob_code varchar [note: 'Code representing the line of business for which the reserve is calculated.']
  notes varchar [note: 'Free-text comments or rationale for the reserve estimate.']
  plan_type varchar [note: 'Type of health insurance plan associated with the reserve.']
  raps_submission_flag boolean [note: 'Indicates if the reserve is included in RAPS submission to CMS.']
  rbc_impact_amount decimal(15,2) [note: 'Impact of the reserve on Risk Based Capital calculations.']
  regulatory_reporting_flag boolean [note: 'True if the reserve is required for regulatory reporting (e.g., GAAP, RBC).']
  reserve_adequacy_flag boolean [note: 'Assessment of whether the reserve is adequate.']
  reserve_methodology varchar [note: 'Actuarial method used to calculate the IBNR reserve.']
  reserve_name varchar [note: 'Human‑readable name or label for the reserve estimate.']
  risk_adjustment_factor decimal(5,4) [note: 'Factor applied to adjust reserve for risk considerations.']
  service_month date [note: 'Month of service for which the IBNR reserve is estimated (first day of month).']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the reserve record.']
  valuation_date date [note: 'Date on which the reserve estimate was calculated.']
  version_number varchar [note: 'Version of the reserve estimate for the same valuation date.']

  Note: 'Stores Incurred But Not Reported (IBNR) reserve estimates by LOB, plan type, service month, and valuation date. Captures reserve methodology (chain-ladder, Bornhuetter-Ferguson, Cape Cod), development factors, expected loss ratios, IBNR amount, IBNR PMPM, actuarial confidence interval, and reserve adequacy assessment. Generated from Milliman MG-ALFA reserving models. Critical for financial close, SAP/GAAP reporting, and RBC calculations.'
}

Table risk.radv_audit {
  radv_audit_id varchar [pk, note: 'Unique surrogate key for each RADV audit record.']
  audited_group_practice_id varchar [note: 'Foreign key linking to provider.group_practice. Business justification: CMS RADV audits are conducted at the group practice level to validate diagnosis submissions. Linking radv_audit to group_practice enables group-level audit tracking, extrapolated payment error calcula']
  cms_submission_id varchar [note: 'Foreign key linking to enrollment.cms_submission. Business justification: RADV audits validate CMS risk adjustment submissions; direct link provides traceability from audit findings to original submission, supports error correction workflows, and enables reconciliation of v']
  eligibility_span_id varchar [note: 'Foreign key linking to member.eligibility_span. Business justification: RADV audits validate HCC codes against medical records for a specific coverage period. The eligibility_span defines the exact enrollment window in scope for the audit year. CMS RADV audit protocols re']
  health_plan_id varchar [note: 'Foreign key linking to plan.health_plan. Business justification: RADV audits are conducted at the health plan/contract level. CMS RADV findings, extrapolated payment errors, and final settlements must be reconciled against the specific health plan. contract_number ']
  member_risk_score_id varchar [note: 'Foreign key linking to risk.member_risk_score. Business justification: RADV (Risk Adjustment Data Validation) audits are CMS-initiated audits that directly validate the accuracy of member-level risk scores submitted for Medicare Advantage payment. Each radv_audit record ']
  member_subscriber_id varchar [note: 'Unique identifier of the member whose records were sampled for the audit.']
  par_agreement_id varchar [note: 'Foreign key linking to network.par_agreement. Business justification: RADV audits trace to specific provider participation agreements for medical record retrieval rights and audit cooperation obligations. PAR agreements define provider responsibilities for audit support']
  plan_election_id varchar [note: 'Foreign key linking to enrollment.plan_election. Business justification: RADV audits validate HCC codes against enrollment records; linking to plan election enables audit scope determination, member eligibility verification during audit period, and ensures audited diagnose']
  provider_network_id varchar [note: 'Foreign key linking to network.provider_network. Business justification: RADV audits validate risk scores against medical records from specific network providers. Network context is required for audit sample stratification, provider documentation quality assessment, and me']
  regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: RADV audits are performed on members within a risk pool; linking provides pool context.']
  rendering_facility_id varchar [note: 'Foreign key linking to provider.facility. Business justification: RADV audits require medical record retrieval from the facility where care was rendered. Linking radv_audit to facility enables auditors to contact the correct facility for record requests and supports']
  rendering_provider_id varchar [note: 'Foreign key linking to provider.provider. Business justification: CMS RADV audits validate HCC codes from specific provider-submitted diagnoses. Auditors must identify the rendering provider whose medical records are under review to request documentation and track p']
  year_id varchar [note: 'Foreign key linking to plan.year. Business justification: RADV audits are scoped to specific plan years (audit_year). Linking to plan.year enables joining audit findings to plan year regulatory filing deadlines, CMS submission windows, and annual risk adjust']
  appeal_status varchar [note: 'Current status of any appeal filed against CMS audit findings.']
  audit_end_timestamp timestamp [note: 'Timestamp when the audit reached final settlement.']
  audit_error_description varchar [note: 'Text description of the error condition when audit_error_flag is true.']
  audit_error_flag boolean [note: 'Indicates whether any processing error was detected for this audit record.']
  audit_notes varchar [note: 'Free‑form notes captured by auditors during the audit process.']
  audit_source varchar [note: 'Origin of the audit request – either CMS‑initiated or internally initiated.']
  audit_start_timestamp timestamp [note: 'Timestamp when the audit process was initiated.']
  audit_status varchar [note: 'Current lifecycle state of the RADV audit.']
  audit_type varchar [note: 'Indicates whether this is an initial RADV audit or a follow‑up audit.']
  audit_updated_by varchar [note: 'User identifier of the analyst who last updated the audit record.']
  audit_year varchar [note: 'Calendar year in which the RADV audit was performed.']
  cms_findings varchar [note: 'Summary of findings and observations reported by CMS for this audit.']
  currency_code varchar [note: 'Three‑letter ISO currency code for monetary amounts.']
  extrapolated_payment_error decimal(15,2) [note: 'Estimated monetary error in payments derived from audit findings, before final settlement.']
  final_settlement_amount decimal(15,2) [note: 'Monetary amount finally paid or recovered after audit resolution.']
  hcc_mapping_version varchar [note: 'Version of the HCC mapping algorithm used for validation.']
  medical_record_receipt_date date [note: 'Date on which the requested medical records were received.']
  medical_record_request_status varchar [note: 'Current status of the request for medical records from providers.']
  record_created timestamp [note: 'Timestamp when this audit record was first captured in the data warehouse.']
  record_updated timestamp [note: 'Timestamp of the most recent modification to this audit record.']
  risk_adjustment_factor decimal(5,4) [note: 'RAF score applied to the member cohort for this audit.']
  sampled_member_count varchar [note: 'Number of members selected for review in this audit.']
  validated_hcc_count varchar [note: 'Number of Hierarchical Condition Categories confirmed as accurate after audit.']

  Note: 'Manages CMS Risk Adjustment Data Validation (RADV) audit records for Medicare Advantage contracts. Captures audit year, contract number, sampled member list, medical record request status, medical record receipt date, CMS audit findings, validated HCC count, extrapolated payment error, appeal status, and final settlement amount. Tracks the full RADV audit lifecycle from CMS notification through final payment reconciliation.'
}

Table risk.member_hcc_assignment {
  member_hcc_assignment_id varchar [pk, note: 'System-generated unique identifier for the member HCC assignment record.']
  hcc_mapping_id varchar [note: 'Foreign key linking to the HCC mapping record (ICD-10 to HCC crosswalk) that applies to this assignment.']
  member_risk_score_id varchar [note: 'Foreign key linking to the member risk score record to which this HCC contributes.']
  coefficient_applied decimal(10,6) [note: 'The actual coefficient value from the hcc_mapping that was applied in this assignment. Stored redundantly to support historical analysis when model coefficients change year-over-year.']
  created_timestamp timestamp [note: 'Timestamp when this HCC assignment record was first created in the data lake.']
  diagnosis_source varchar [note: 'Source system or data collection method from which the diagnosis (and thus the HCC) was captured. Critical for RADV audit defense and data completeness tracking.']
  effective_date date [note: 'Date when this HCC assignment became effective for the member\'s risk score calculation. May differ from the member_risk_score effective_timestamp if HCCs are added/removed during reconciliation.']
  hcc_codes varchar [note: 'Pipe‑separated list of HCC codes contributing to the score. [Moved from member_risk_score: This pipe-separated STRING field on member_risk_score is a denormalized representation of the M:N relationship. By normalizing into member_hcc_assignment, each HCC code becomes a separate record with its own contribution_amount, status, and source. This enables proper HCC-level analytics and eliminates the need to parse delimited strings.]']
  hcc_contribution_amount decimal(10,4) [note: 'The numeric RAF score contribution from this specific HCC to the member\'s total risk score. This is the product of the HCC coefficient and any applicable adjustment factors.']
  hcc_status varchar [note: 'Current processing status of this HCC assignment. Tracks whether the HCC is actively contributing to the RAF score, suppressed by hierarchy rules, excluded by CMS, or pending validation.']
  last_updated_timestamp timestamp [note: 'Timestamp of the most recent update to this HCC assignment record.']
  model_version varchar [note: 'Version identifier of the CMS risk adjustment model used for this HCC assignment (e.g., V24, V28). Must match the model_version on the parent member_risk_score.']

  Note: 'This association product represents the assignment of Hierarchical Condition Categories (HCCs) to member risk scores in CMS risk adjustment programs. It captures the operational linkage between a member\'s RAF score calculation and the specific HCC codes that contribute to that score. Each record links one member_risk_score to one hcc_mapping with attributes that exist only in the context of this relationship: the coefficient applied, the contribution amount to the RAF score, the diagnosis source, and the HCC validation status. This is the normalized representation of the denormalized hcc_codes STRING field currently stored on member_risk_score, enabling HCC-level analytics, RADV audit defense, and CMS submission accuracy tracking.. Existence Justification: In Medicare Advantage risk adjustment, a member\'s RAF score is calculated as the sum of contributions from multiple HCC codes, and each HCC code (via its ICD-10 mapping) contributes to many member risk scores across the population. The business actively manages these HCC assignments through diagnosis capture, coding validation, CMS submission, and RADV audit processes. The relationship has operational data (contribution amounts, effective dates, validation status, diagnosis source) that belongs to neither the member risk score nor the HCC mapping alone.'
}

Table compliance.regulatory_submission {
  regulatory_submission_id varchar [pk, note: 'System-generated unique identifier for each regulatory submission record.']
  breach_incident_id varchar [note: 'Foreign key linking to compliance.breach_incident. Business justification: HIPAA breach notification requirements mandate regulatory submissions to HHS (OCR) and state regulators. A regulatory_submission record for a breach notification should reference the originating breac']
  compliance_regulatory_obligation_id varchar [note: 'Link to the specific regulatory requirement that this submission satisfies.']
  plan_service_area_id varchar [note: 'Foreign key linking to plan.plan_service_area. Business justification: CMS and state service area expansion/contraction filings are directly tied to a specific plan_service_area record. Regulatory submissions for geographic coverage changes require traceability to the se']
  year_id varchar [note: 'Foreign key linking to plan.year. Business justification: CMS annual rate filings, state benefit mandate submissions, and ACA compliance filings are tied to a specific plan year. Direct FK to plan.year enables year-based submission tracking and open enrollme']
  acceptance_date date [note: 'Date the regulator formally accepted the filing.']
  attachment_count varchar [note: 'Number of supporting documents attached to the submission.']
  confirmation_number varchar [note: 'Identifier returned by the regulator confirming receipt of the filing.']
  created_timestamp timestamp [note: 'Timestamp when the submission record was first created in the system.']
  due_date date [note: 'Deadline by which the regulatory filing must be completed.']
  fee_currency_code varchar [note: 'Three‑letter ISO 4217 code of the currency in which the filing fee is expressed.']
  filing_fee_amount decimal(12,2) [note: 'Gross fee charged by the regulator for processing the submission.']
  filing_period_end date [note: 'End date of the reporting period covered by the submission.']
  filing_period_start date [note: 'Start date of the reporting period covered by the submission.']
  is_critical boolean [note: 'Indicates whether the filing is deemed critical for regulatory compliance (true) or routine (false).']
  last_reminder_sent_date date [note: 'Date the most recent reminder was sent to the responsible party.']
  lead_time_days varchar [note: 'Number of days between creation of the submission record and its due date.']
  net_fee_amount decimal(12,2) [note: 'Net fee after any adjustments, discounts, or credits.']
  regulatory_body varchar [note: 'Government or accrediting entity to which the submission is made.']
  regulatory_submission_status varchar [note: 'Current lifecycle state of the regulatory filing.']
  rejection_reason_code varchar [note: 'Standardized code indicating why a filing was rejected by the regulator.']
  reminder_schedule varchar [note: 'Human‑readable description of the reminder cadence (e.g., "30/15/5 days before due").']
  submission_date date [note: 'Actual calendar date the filing was submitted to the regulator.']
  submission_description varchar [note: 'Free‑text notes describing the purpose or special considerations of the filing.']
  submission_method varchar [note: 'Technical or physical channel used to deliver the filing.']
  submission_number varchar [note: 'External reference number assigned to the filing by the organization.']
  submission_type varchar [note: 'Category of the regulatory filing (e.g., annual notice, rate filing).']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to the submission record.']

  Note: 'Transactional record for each regulatory filing or submission — from scheduled deadline through actual filing. Captures submission type, regulatory body, due date, lead time days, reminder schedule, submission date, filing period, submission method (EDI, portal, paper), status (scheduled, draft, submitted, accepted, rejected), and confirmation identifiers. Covers CMS annual notices, state DOI rate filings, NAIC financial statements, NCQA accreditation submissions, OCR breach notifications, MLR rebate filings, ACA marketplace submissions, and ERISA filings (Form 5500, Summary Annual Report, Summary Plan Description, COBRA notices, QMCSO responses). Supports the annual regulatory calendar view used by compliance officers to manage deadlines across CMS, state DOIs, NCQA, OCR, ERISA, and DOL obligations. Links to the regulatory obligation it satisfies.'
}

Table compliance.audit_engagement {
  audit_engagement_id varchar [pk, note: 'Unique identifier for the audit engagement record.']
  accreditation_program_id varchar [note: 'Foreign key linking to compliance.accreditation_program. Business justification: Accreditation programs (NCQA, URAC, HEDIS) involve formal audit/survey engagements. An audit_engagement is a child activity conducted within the scope of an accreditation_program. The audit_engagement']
  benefit_package_id varchar [note: 'Foreign key linking to plan.benefit_package. Business justification: Targeted compliance audits (pharmacy benefit audits, behavioral health benefit package audits, MHPAEA parity audits) are scoped to specific benefit packages. Linking audit_engagement to benefit_packag']
  compliance_regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: Audit engagements are performed to satisfy regulatory obligations; linking creates required hierarchy.']
  facility_id varchar [note: 'Foreign key linking to provider.facility. Business justification: CMS surveys, state inspections, and accreditation surveys are conducted at specific facilities. Audit engagements must reference the facility being audited to support survey scheduling, finding attrib']
  group_practice_id varchar [note: 'Foreign key linking to provider.group_practice. Business justification: Group practice audits (PCMH surveys, NCQA group credentialing audits, CMS group billing audits) are conducted at the group level. Audit engagements must reference the specific group practice to suppor']
  provider_id varchar [note: 'Foreign key linking to provider.provider. Business justification: Provider-level credentialing audits and quality audits are conducted against individual providers. Audit engagements must reference the specific provider being audited to support credentialing audit t']
  audit_body varchar [note: 'Organization or agency conducting the audit.']
  audit_category varchar [note: 'High-level category of the audit focus area.']
  audit_cost_actual decimal(12,2) [note: 'Actual monetary cost incurred for the audit.']
  audit_cost_estimate decimal(12,2) [note: 'Estimated monetary cost associated with conducting the audit.']
  audit_currency varchar [note: 'Currency code for cost fields.']
  audit_document_reference varchar [note: 'Identifier or path to the primary audit report document.']
  audit_engagement_status varchar [note: 'Current lifecycle status of the audit engagement.']
  audit_findings_reference varchar [note: 'Identifier linking to the detailed findings dataset.']
  audit_followup_required boolean [note: 'Indicates whether a follow-up audit is scheduled.']
  audit_location varchar [note: 'Geographic location or business unit where the audit is primarily conducted.']
  audit_methodology varchar [note: 'Methodology or standards used to conduct the audit (e.g., COSO, ISO27001).']
  audit_notes varchar [note: 'Free-text field for additional comments or observations.']
  audit_number varchar [note: 'External reference number assigned to the audit by the auditing body.']
  audit_period_end date [note: 'End date of the audit coverage period.']
  audit_period_start date [note: 'Start date of the audit coverage period.']
  audit_priority varchar [note: 'Priority level assigned to the audit engagement.']
  audit_report_release_date date [note: 'Date when the final audit report was released to stakeholders.']
  audit_scope varchar [note: 'Narrative describing the functional and geographic scope of the audit.']
  audit_type varchar [note: 'Category of audit based on purpose and scope.']
  compliance_framework varchar [note: 'Regulatory framework(s) applicable to the audit.']
  created_timestamp timestamp [note: 'Timestamp when the audit engagement record was first created in the system.']
  critical_findings varchar [note: 'Number of findings classified as critical severity.']
  engagement_end_date date [note: 'Date when the audit engagement concluded or was terminated.']
  engagement_start_date date [note: 'Date when the audit engagement officially began.']
  last_reviewed_timestamp timestamp [note: 'Timestamp when the audit engagement was last reviewed for status or changes.']
  minor_findings varchar [note: 'Number of findings classified as minor severity.']
  overall_outcome varchar [note: 'Final result of the audit after all findings are addressed.']
  regulatory_citation varchar [note: 'Reference to the specific regulation or statute cited for each finding.']
  remediation_plan_due_date date [note: 'Target date by which all remediation actions must be completed.']
  remediation_status varchar [note: 'Current status of remediation activities for audit findings.']
  risk_rating varchar [note: 'Overall risk rating derived from audit findings.']
  significant_findings varchar [note: 'Number of findings classified as significant severity.']
  total_findings varchar [note: 'Total number of findings identified during the audit.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the audit engagement record.']

  Note: 'Master record for each formal audit or examination conducted by or against the health plan — CMS program audits (RADV, Part C/D), state DOI market conduct examinations, OCR HIPAA investigations, NCQA accreditation surveys, SOC 2 audits, internal compliance audits, and external financial audits. Captures audit type, auditing body, audit scope, audit period, lead auditor, engagement start/end dates, status, and overall audit outcome. Includes detailed finding tracking: finding type (condition, cause, effect), severity level (critical, significant, minor), regulatory citation, finding description, affected business area, root cause analysis, recommended remediation, and finding status through the lifecycle from identification through remediation and closure. Serves as the authoritative registry of all audit engagements and their findings.'
}

Table compliance.audit_finding {
  audit_finding_id varchar [pk, note: 'System-generated unique identifier for the audit finding record.']
  audit_engagement_id varchar [note: 'Foreign key linking to compliance.audit_engagement. Business justification: Audit findings belong to an audit engagement; linking provides parent relationship and enables traceability.']
  benefit_package_id varchar [note: 'Foreign key linking to plan.benefit_package. Business justification: ACA EHB compliance audits and cost-sharing accuracy audits target specific benefit packages. Auditors must trace findings to the exact benefit package under review for remediation tracking and regulat']
  affected_business_area varchar [note: 'Business function or area affected by the finding.']
  audit_category varchar [note: 'Regulatory or compliance domain to which the finding relates.']
  audit_finding_status varchar [note: 'Current lifecycle status of the audit finding.']
  closed_timestamp timestamp [note: 'Timestamp when the finding was formally closed after remediation.']
  compliance_area varchar [note: 'Specific compliance domain impacted by the finding.']
  corrective_action_completion_date date [note: 'Date when the corrective action was completed.']
  corrective_action_status varchar [note: 'Current status of the remediation work.']
  created_timestamp timestamp [note: 'Timestamp when the audit finding record was created in the system.']
  description varchar [note: 'Detailed narrative describing the nature of the finding.']
  due_date date [note: 'Date by which remediation actions must be completed.']
  effectiveness_assessment varchar [note: 'Qualitative assessment of remediation effectiveness.']
  effectiveness_score varchar [note: 'Score (0‑100) measuring how effective the remediation was.']
  evidence_document_reference varchar [note: 'Reference (e.g., URL or file ID) to supporting evidence documents.']
  financial_impact_amount decimal(15,2) [note: 'Estimated monetary impact associated with the finding.']
  financial_impact_currency varchar [note: 'Currency code for the financial impact amount.']
  finding_number varchar [note: 'Business identifier assigned to the finding for tracking and reference.']
  finding_type varchar [note: 'Classification of the finding as a condition, cause, or effect.']
  identified_timestamp timestamp [note: 'Timestamp when the finding was first identified during the audit.']
  is_critical boolean [note: 'True if the finding is deemed critical based on severity and impact.']
  is_repeat_finding boolean [note: 'Indicates whether this finding has been observed previously.']
  last_review_timestamp timestamp [note: 'Timestamp of the most recent review of the finding.']
  notes varchar [note: 'Free‑form notes added by auditors or reviewers.']
  priority varchar [note: 'Priority level assigned to the finding for remediation scheduling.']
  regulatory_citation varchar [note: 'Specific regulation, statute, or standard cited for the finding.']
  remediation_action varchar [note: 'Recommended corrective action to address the finding.']
  remediation_due_date date [note: 'Date by which the remediation must be completed.']
  resolution varchar [note: 'Final resolution outcome for the finding.']
  reviewed_by varchar [note: 'Identifier of the person who performed the latest review.']
  risk_score varchar [note: 'Numeric risk score (0‑100) representing the finding\'s risk level.']
  risk_score_source varchar [note: 'Origin of the risk score calculation.']
  root_cause varchar [note: 'Analysis of the underlying cause that led to the finding.']
  severity_level varchar [note: 'Severity rating indicating the potential impact of the finding.']
  source varchar [note: 'Origin of the finding: internal audit, external audit, or regulatory review.']
  tags varchar [note: 'Comma‑separated tags for categorization and search.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the audit finding record.']
  version varchar [note: 'Version number for the finding record to support change tracking.']

  Note: 'Transactional record for each finding, deficiency, or observation identified during an audit engagement. Captures finding type (condition, cause, effect), severity level (critical, significant, minor), regulatory citation, finding description, affected business area, root cause analysis, and recommended remediation. Links to the parent audit engagement and drives the corrective action plan (CAP) process. Tracks finding status through the lifecycle from identification through remediation and closure.'
}

Table compliance.corrective_action_plan {
  corrective_action_plan_id varchar [pk, note: 'Unique system-generated identifier for the corrective action plan.']
  audit_finding_id varchar [note: 'Foreign key linking to compliance.audit_finding. Business justification: A Corrective Action Plan is created in direct response to an audit finding. The existing STRING field \'finding_reference\' is a denormalized text reference that should be replaced by a proper FK. The a']
  benefit_id varchar [note: 'Foreign key linking to plan.benefit. Business justification: Corrective action plans addressing mental health parity violations, preventive services non-compliance, or EHB deficiencies are remediated at the individual benefit level. Linking CAP to the specific ']
  compliance_regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: A Corrective Action Plan may be created in direct response to a regulatory obligation violation (e.g., a state DOI mandate, CMS directive) independent of a specific audit finding. The corrective_actio']
  license_id varchar [note: 'Foreign key linking to provider.license. Business justification: License deficiencies (expired licenses, disciplinary actions, scope violations) directly trigger corrective action plans. Compliance teams must link CAPs to the specific license record to track remedi']
  provider_id varchar [note: 'Foreign key linking to provider.provider. Business justification: Corrective action plans are issued directly to individual providers for credentialing deficiencies, quality failures, or regulatory violations. Compliance teams must link CAPs to the specific provider']
  actual_completion_date date [note: 'Date when the CAP was actually completed.']
  actual_cost_usd decimal(12,2) [note: 'Actual financial cost incurred for the CAP.']
  audit_comments varchar [note: 'Free-text comments from auditors or reviewers regarding the CAP.']
  closed_timestamp timestamp [note: 'Timestamp when the CAP was formally closed.']
  compliance_category varchar [note: 'High-level compliance domain of the issue.']
  compliance_deadline date [note: 'Regulatory deadline by which remediation must be completed.']
  corrective_action_plan_status varchar [note: 'Current lifecycle status of the CAP.']
  created_timestamp timestamp [note: 'Timestamp when the CAP record was created in the system.']
  estimated_cost_usd decimal(12,2) [note: 'Projected financial cost to implement the corrective actions.']
  evidence_document_path varchar [note: 'File system or URL location of supporting evidence artifacts.']
  is_external_audit boolean [note: 'Indicates whether the finding originated from an external audit.']
  is_fwa_monitoring boolean [note: 'Indicates if the CAP is related to FWA monitoring.']
  last_milestone_status varchar [note: 'Status of the most recent milestone.']
  milestone_count varchar [note: 'Total number of milestones defined for the CAP.']
  notes varchar [note: 'Additional free-text notes about the CAP.']
  owner_role varchar [note: 'Role of the owner within the organization.']
  plan_name varchar [note: 'Descriptive name of the corrective action plan.']
  plan_number varchar [note: 'External reference number assigned to the CAP.']
  plan_type varchar [note: 'Category of the CAP based on source of finding.']
  priority varchar [note: 'Priority level assigned to the CAP.']
  regulatory_body varchar [note: 'Regulatory authority associated with the finding. [ENUM-REF-CANDIDATE: CMS|OCR|NAIC|State_DOI|NCQA|URAC|Joint_Commission — 7 candidates stripped; promote to reference product]']
  remediation_strategy varchar [note: 'Planned approach to address the root cause.']
  risk_score varchar [note: 'Numeric risk score assigned to the CAP based on severity and impact.']
  root_cause varchar [note: 'Narrative of the root cause analysis for the finding.']
  severity varchar [note: 'Severity of the underlying finding.']
  target_completion_date date [note: 'Planned date by which the CAP should be completed.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to the CAP record.']

  Note: 'Master record for each Corrective Action Plan (CAP) developed in response to audit findings, regulatory violations, or accreditation deficiencies. Captures the triggering finding or violation, CAP type, remediation strategy, responsible owner, target completion date, and implementation status. Includes granular milestone tracking with individual action items, assigned owners, planned/actual completion dates, milestone status, evidence artifacts, and reviewer sign-off for each milestone. Tracks the full CAP lifecycle from submission to regulatory body through milestone completion, validation, and closure. Critical for CMS audit readiness and NCQA accreditation maintenance.'
}

Table compliance.breach_incident {
  breach_incident_id varchar [pk, note: 'Primary key for breach_incident']
  account_id varchar [note: 'Foreign key linking to billing.account. Business justification: Data breaches often affect specific billing accounts (payment method theft, account takeover). Tracking enables HIPAA notification obligations, remediation scoping, affected member identification, and']
  audit_finding_id varchar [note: 'Identifier of the breach report filed with external regulator.']
  corrective_action_plan_id varchar [note: 'Foreign key linking to compliance.corrective_action_plan. Business justification: A breach incident triggers a Corrective Action Plan to remediate the root cause and prevent recurrence. breach_incident currently has denormalized STRING fields \'corrective_action_plan\' and \'correctiv']
  facility_id varchar [note: 'Foreign key linking to provider.facility. Business justification: Breach incidents commonly originate at specific facilities (hospital data breaches, clinic PHI exposures). Linking breach_incident to facility supports HHS breach reporting, state notification require']
  provider_id varchar [note: 'Foreign key linking to provider.provider. Business justification: HIPAA breach incidents frequently involve providers as business associates (e.g., provider EHR breach exposing member PHI). Breach investigations require linking to the specific provider involved for ']
  regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.baa. Business justification: When a PHI breach involves a business associate, the specific BAA governing that relationship is critical for determining breach notification requirements, liability, and remediation obligations. brea']
  affected_phi_categories varchar [note: 'Comma-separated list of PHI categories impacted (e.g., demographic, clinical, claims).']
  audit_findings varchar [note: 'Summary of audit findings related to the breach.']
  breach_cause_description varchar [note: 'Narrative description of the cause of the breach.']
  breach_discovery_date date [note: 'Date the breach was discovered by the organization.']
  breach_occurrence_date date [note: 'Date the breach actually occurred (if known).']
  breach_report_url varchar [note: 'Link to the external breach report document.']
  breach_resolution_date date [note: 'Date the breach was fully resolved and closed.']
  breach_source varchar [note: 'Origin of the breach (internal staff, external actor, partner, unknown).']
  breach_status varchar [note: 'Current lifecycle status of the breach investigation.']
  breach_type varchar [note: 'Category of the breach event.']
  business_associate_involved boolean [note: 'Indicates whether a Business Associate was involved in the breach.']
  created_timestamp timestamp [note: 'Timestamp when the breach incident record was created in the system.']
  hhs_notification_date date [note: 'Date HHS was notified of the breach.']
  hhs_notified boolean [note: 'Indicates if the U.S. Department of Health & Human Services was notified.']
  notification_content_version varchar [note: 'Version identifier of the notification content used.']
  notification_date date [note: 'Date the notification was sent.']
  notification_delivery_confirmation boolean [note: 'Indicates whether delivery confirmation was received.']
  notification_method varchar [note: 'Delivery channel used for the notification.']
  notification_obligation varchar [note: 'Regulatory notification obligations triggered by the breach.']
  notification_recipient_count varchar [note: 'Number of recipients who received the notification.']
  notification_type varchar [note: 'Type of notification sent.']
  number varchar [note: 'External reference number assigned to the breach incident.']
  number_of_individuals_affected varchar [note: 'Count of distinct individuals whose PHI was compromised.']
  number_of_records_affected varchar [note: 'Total number of PHI records impacted.']
  regulatory_filing_date date [note: 'Date the breach was filed with the regulator.']
  regulatory_filing_status varchar [note: 'Status of required regulatory filings related to the breach.']
  risk_assessment_method varchar [note: 'Methodology used for risk assessment.']
  risk_assessment_score decimal(5,2) [note: 'Quantitative risk score resulting from breach risk assessment.']
  state_notification_date date [note: 'Date the state authority was notified.']
  state_notified boolean [note: 'Indicates if the relevant state authority was notified.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the breach incident record.']

  Note: 'Master record for each PHI (Protected Health Information) breach incident identified under HIPAA Breach Notification Rule (45 CFR §164.400–414). Captures breach discovery date, breach type (unauthorized access, theft, loss, improper disposal), affected PHI categories, number of individuals affected, breach cause, business associate involvement, risk assessment outcome, and notification obligations triggered. Includes full notification tracking: notification type (individual, HHS/OCR, media, state AG), notification method (mail, email, substitute notice), notification date, recipient count, content version, and delivery confirmation. Drives the 60-day OCR notification workflow and annual breach report to HHS. Critical for HIPAA compliance and OCR audit readiness.'
}

Table compliance.hipaa_privacy_request {
  hipaa_privacy_request_id varchar [pk, note: 'System-generated unique identifier for the HIPAA privacy request record.']
  compliance_regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: HIPAA privacy requests are governed by specific regulatory obligations under the HIPAA Privacy Rule (45 CFR Part 164). Linking hipaa_privacy_request to regulatory_obligation is consistent with how all']
  eob_id varchar [note: 'Foreign key linking to claim.eob. Business justification: HIPAA privacy requests (right of access, amendment, restriction of disclosure) most commonly reference EOB documents containing PHI. Linking hipaa_privacy_request to the specific EOB enables privacy o']
  group_id varchar [note: 'Foreign key linking to employer.group. Business justification: Each HIPAA privacy request is processed by a compliance employee; required for audit trails.']
  health_plan_id varchar [note: 'Foreign key linking to plan.health_plan. Business justification: HIPAA privacy requests (access, amendment, accounting of disclosures) are made in the context of a specific health plan that holds the member\'s PHI. Plan-level HIPAA compliance reporting and OCR audit']
  member_subscriber_id varchar [note: 'Unique identifier of the member who submitted the privacy request.']
  appeal_deadline date [note: 'Final date by which an appeal must be filed.']
  appeal_outcome varchar [note: 'Result of the appeal process, if applicable.']
  audit_created_timestamp timestamp [note: 'Timestamp when the privacy request record was first created in the system.']
  audit_updated_timestamp timestamp [note: 'Timestamp of the most recent modification to the privacy request record.']
  denial_reason varchar [note: 'Explanation provided when a request is denied or partially granted.']
  disclosure_authorization_basis varchar [note: 'Legal basis authorizing the PHI disclosure.']
  disclosure_date timestamp [note: 'Timestamp of the PHI disclosure, if one occurred.']
  disclosure_logged boolean [note: 'Indicates whether a PHI disclosure related to this request has been logged.']
  disclosure_phicategories varchar [note: 'Comma‑separated list of PHI categories disclosed (e.g., diagnosis, treatment, payment).']
  disclosure_purpose varchar [note: 'Business or legal purpose for which the PHI was disclosed.']
  disclosure_recipient_type varchar [note: 'Category of the entity receiving the disclosed PHI.']
  disposition varchar [note: 'Outcome of the request (e.g., granted, denied, partially granted).']
  is_appealed boolean [note: 'Indicates whether the member has appealed the request decision.']
  is_confidential_communication boolean [note: 'True when the member requests that communications be handled confidentially.']
  request_channel varchar [note: 'Medium of the request (digital, paper, or phone).']
  request_description varchar [note: 'Free‑text description provided by the member detailing the request.']
  request_number varchar [note: 'Human‑readable reference number assigned to the privacy request.']
  request_received_timestamp timestamp [note: 'Date‑time when the privacy request was initially received.']
  request_source varchar [note: 'Channel through which the request was received (e.g., member portal, email, phone).']
  request_status varchar [note: 'Current processing state of the privacy request.']
  request_type varchar [note: 'Category of the privacy request as defined by HIPAA (e.g., access, amendment, accounting of disclosures, restriction, confidential communication).']
  response_date date [note: 'Date on which the organization completed its response to the request.']
  response_due_date date [note: 'Regulatory deadline by which a response must be provided (typically 30 days from receipt).']

  Note: 'Transactional record for HIPAA privacy operations — member privacy rights requests and PHI disclosure tracking. Covers access requests (right to access PHI), amendment requests, accounting of disclosures, restriction requests, and confidential communication requests under 45 CFR §164.500. Captures request type, member identifier, request receipt date, response due date, response date, request disposition (granted, denied, partially granted), denial reason, and appeal status. Includes PHI disclosure logging: disclosure date, recipient organization, recipient type (public health authority, law enforcement, research, legal), purpose of disclosure, PHI categories disclosed, and disclosure authorization basis. Excludes treatment, payment, and healthcare operations disclosures per HIPAA exemptions. Tracks compliance with HIPAA response timelines and supports OCR audit documentation.'
}

Table compliance.fwa_case {
  fwa_case_id varchar [pk, note: 'Unique system-generated identifier for the FWA case.']
  affiliation_id varchar [note: 'Foreign key linking to provider.affiliation. Business justification: FWA cases frequently involve billing under a specific hospital affiliation (e.g., ghost admissions, upcoding tied to admitting privileges). SIU investigators must link FWA cases to the specific affili']
  benefit_id varchar [note: 'Foreign key linking to plan.benefit. Business justification: FWA cases frequently involve fraudulent billing under specific benefits (DME, mental health, home health). Linking FWA cases to the specific benefit enables benefit-level fraud pattern analysis and ta']
  claim_header_id varchar [note: 'add column claim_header_id (BIGINT) with FK to claim.header.header_id - FWA cases are triggered by suspicious claims']
  compliance_regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: FWA investigations are governed by specific regulatory obligations (CMS FWA program requirements, state fraud statutes, False Claims Act). The fwa_case has a regulatory_reporting_flag boolean and comp']
  facility_id varchar [note: 'Foreign key linking to provider.facility. Business justification: FWA cases frequently involve facility-level fraud (e.g., facility fee unbundling, ghost admissions, inflated facility charges). Linking fwa_case to facility supports facility-level FWA investigations,']
  group_practice_id varchar [note: 'Foreign key linking to provider.group_practice. Business justification: FWA cases can involve group-level billing fraud (e.g., group NPI misuse, group-wide upcoding schemes). Linking fwa_case to group_practice enables group-level FWA pattern detection, CMS group billing f']
  premium_invoice_id varchar [note: 'Foreign key linking to billing.premium_invoice. Business justification: FWA investigations frequently target specific premium invoices for billing fraud detection (phantom enrollments, premium manipulation). Enables case-to-evidence linking for investigations, recovery tr']
  premium_payment_id varchar [note: 'Foreign key linking to billing.premium_payment. Business justification: Payment fraud cases must reference specific premium payments under investigation (check fraud, payment reversals, identity theft). Supports recovery amount tracking, evidence chain documentation, and ']
  provider_id varchar
  specialty_id varchar [note: 'Foreign key linking to provider.specialty. Business justification: FWA cases are frequently specialty-specific (e.g., upcoding in cardiology, unbundling in orthopedics). SIU investigators and analytics teams must link FWA cases to the provider\'s specialty to detect s']
  allegation_description varchar [note: 'Detailed description of the alleged fraud, waste, or abuse.']
  audit_log_url varchar [note: 'Link to the immutable audit log for this case.']
  case_disposition varchar [note: 'Final outcome of the case after investigation.']
  case_number varchar [note: 'Business identifier assigned to the case for external reference and reporting.']
  case_open_timestamp timestamp [note: 'Timestamp when the case was officially opened.']
  case_status varchar [note: 'Current lifecycle status of the case.']
  case_type varchar [note: 'Primary classification of the case as fraud, waste, or abuse.']
  compliance_reference varchar [note: 'Reference identifier used in external compliance filings (e.g., CMS FWA program ID).']
  created_timestamp timestamp [note: 'Timestamp when the case record was first created in the system.']
  currency_code varchar [note: 'Three‑letter ISO currency code for monetary values.']
  disposition_date date [note: 'Date the case disposition was recorded.']
  estimated_exposure_amount decimal(15,2) [note: 'Projected monetary loss associated with the alleged activity.']
  evidence_reference varchar [note: 'Link or identifier to supporting evidence stored in the evidence repository.']
  is_high_risk boolean [note: 'Flag indicating the case is considered high risk based on internal scoring.']
  notes varchar [note: 'Free‑form notes entered by investigators or reviewers.']
  recovery_amount decimal(15,2) [note: 'Amount recovered or expected to be recovered from the subject.']
  referral_date date [note: 'Date the referral was received and the case was created.']
  referral_source varchar [note: 'Origin of the case referral, such as claim edit, data mining, tip line, law enforcement, or employee report.']
  regulatory_reporting_flag boolean [note: 'Indicates whether the case has been reported to a regulatory body (e.g., CMS, state fraud bureau).']
  risk_score decimal(5,2) [note: 'Numeric risk score assigned during triage (0‑100 scale).']
  subject_reference varchar [note: 'Identifier of the subject (member, provider, or employer group) under investigation.']
  subject_type varchar [note: 'Entity type that is the subject of the investigation.']
  triage_outcome varchar [note: 'Result of the initial triage review, indicating next steps.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the case record.']

  Note: 'Master record for each Fraud, Waste, and Abuse (FWA) investigation — from initial referral intake through case disposition. Captures referral source (claim edits, data mining, tip line, law enforcement, employee reports), referral date, allegation description, supporting evidence references, triage outcome, case type (fraud, waste, abuse), subject type (member, provider, employer group), case open date, investigation status, assigned investigator, estimated financial exposure, recovery amount, and case disposition (substantiated, unsubstantiated, referred to law enforcement, civil monetary penalty). Supports CMS FWA program requirements, state insurance fraud bureau reporting, and annual FWA reporting to CMS.'
}

Table compliance.mlr_calculation {
  mlr_calculation_id varchar [pk, note: 'Primary key for mlr_calculation']
  audit_finding_id varchar [note: 'Foreign key linking to compliance.audit_finding. Business justification: The mlr_calculation table has an audit_finding_reference STRING column that is a denormalized text reference to an audit finding. This should be normalized to a proper FK (audit_finding_id → audit_fin']
  compliance_regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: MLR calculations are performed to demonstrate compliance with regulatory obligations; linking ties calculations to obligations.']
  group_id varchar [note: 'Foreign key linking to employer.group. Business justification: MLR calculations are performed by a specific analyst; needed for audit of financial compliance.']
  origin_health_plan_id varchar [note: 'Foreign key to the health plan for which the MLR is being calculated.']
  primary_mlr_product_health_plan_id varchar [note: 'Foreign key to the insurance product (e.g., specific benefit design) tied to the calculation.']
  year_id varchar [note: 'Foreign key linking to plan.year. Business justification: MLR calculations and CMS rebate submissions are plan-year-specific regulatory requirements. Linking mlr_calculation to plan.year enables joining to plan year metadata (open enrollment dates, grace per']
  calculation_date date [note: 'Date on which the MLR calculation was performed.']
  calculation_number varchar [note: 'Human‑readable identifier assigned to the MLR calculation for reporting and audit purposes.']
  created_timestamp timestamp [note: 'Timestamp when the MLR calculation record was first created in the system.']
  earned_premium_amount decimal(15,2) [note: 'Total earned premium dollars for the reporting period, forming the MLR denominator.']
  incurred_claims_amount decimal(15,2) [note: 'Total dollar amount of claims incurred for the reporting period.']
  line_of_business varchar [note: 'Business line (e.g., HMO, PPO, Medicaid) associated with the MLR calculation.']
  market_segment_code varchar [note: 'Code representing the market segment (e.g., individual, group, Medicare) to which the calculation applies.']
  mlr_calculation_status varchar [note: 'Current processing status of the MLR calculation.']
  mlr_percentage decimal(5,2) [note: 'Calculated MLR ratio expressed as a percentage (incurred claims ÷ earned premium).']
  notes varchar [note: 'Free‑form comments or explanations entered by analysts.']
  quality_improvement_expenses_amount decimal(15,2) [note: 'Dollar amount spent on quality improvement activities that count toward the MLR denominator.']
  rebate_amount decimal(15,2) [note: 'Dollar amount of the rebate owed to members or the market segment.']
  rebate_disbursement_date date [note: 'Date on which the rebate payment was or will be disbursed.']
  rebate_disbursement_status varchar [note: 'Current status of the rebate payment process.']
  rebate_eligibility_flag boolean [note: 'True if the calculated MLR exceeds the regulatory threshold and a rebate is required.']
  reporting_year varchar [note: 'Calendar year for which the MLR is being calculated.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the MLR calculation record.']
  version_number varchar [note: 'Incremental version of the calculation record for audit trail purposes.']

  Note: 'Medical Loss Ratio (MLR) calculation and rebate processing record per ACA Section 2718 requirements. Captures reporting year, market segment, LOB, incurred claims, quality improvement expenses, earned premium, MLR percentage, rebate determination, rebate amount, and disbursement tracking.'
}

Table compliance.accreditation_program {
  accreditation_program_id varchar [pk, note: 'Unique system-generated identifier for each accreditation program record.']
  compliance_regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: Accreditation programs are driven by specific regulatory obligations; linking clarifies compliance scope.']
  accountable_owner varchar [note: 'Full name of the person or team accountable for the accreditation.']
  accreditation_program_status varchar [note: 'Current state of the accreditation (e.g., accredited, provisional, denied).']
  accreditation_type varchar [note: 'Classification of the accreditation program (e.g., health plan, provider, pharmacy).']
  accrediting_body varchar [note: 'Name of the organization that issues the accreditation (e.g., NCQA, URAC, CMS).']
  applicable_standards varchar [note: 'List of standards, guidelines, or criteria the program must meet.']
  audit_trail varchar [note: 'Chronological notes capturing audit actions and decisions.']
  benchmark_thresholds varchar [note: 'Target values for performance measures used in the accreditation.']
  completion_percentage decimal(5,2) [note: 'Progress of the accreditation process expressed as a percent.']
  compliance_category varchar [note: 'High‑level classification of the accreditation\'s compliance focus.']
  conditions varchar [note: 'Any remedial actions, monitoring, or conditions required for continued accreditation.']
  created_timestamp timestamp [note: 'Date and time when the accreditation record was first created.']
  decision varchar [note: 'Final decision made by the accrediting body.']
  effective_from date [note: 'Date on which the accreditation starts to be binding.']
  effective_until date [note: 'Date on which the accreditation ends; null if open‑ended.']
  escalated_flag boolean [note: 'True when issues have been escalated to senior management.']
  evidence_documentation_url varchar [note: 'Link to uploaded evidence files used in the accreditation review.']
  final_score decimal(5,2) [note: 'Numeric score (e.g., 0‑100) resulting from the accreditation evaluation.']
  is_critical boolean [note: 'True if the accreditation is essential to business operations.']
  last_modified_by varchar [note: 'Identifier of the person or system that performed the most recent update.']
  last_review_date date [note: 'Date when the accreditation was last reviewed for compliance.']
  level varchar [note: 'Level or tier assigned by the accrediting body (e.g., Level 1, Level 2).']
  measure_thresholds varchar [note: 'Target thresholds for each evaluated measure.']
  measures varchar [note: 'Key performance or quality measures assessed during the accreditation.']
  next_survey_due_date date [note: 'Planned date for the next accreditation survey cycle.']
  notes varchar [note: 'Additional comments or observations about the accreditation.']
  preliminary_findings varchar [note: 'Initial observations and issues identified during the survey.']
  program_code varchar [note: 'Business identifier assigned by the accrediting organization.']
  program_name varchar [note: 'Descriptive name of the accreditation program (e.g., NCQA Health Plan Accreditation).']
  rating varchar [note: 'Star rating or equivalent tier based on the final score.']
  recommendations varchar [note: 'Suggested improvements or corrective actions from the accrediting body.']
  regulatory_reference varchar [note: 'Citation of the specific regulation, statute, or standard governing the accreditation.']
  renewal_cycle_months varchar [note: 'Number of months between required renewal surveys.']
  risk_level varchar [note: 'Risk rating reflecting potential impact of non‑compliance.']
  scope varchar [note: 'Description of the functional and geographic scope covered by the accreditation.']
  survey_end_date date [note: 'Last day of the accreditation survey window.']
  survey_start_date date [note: 'First day of the accreditation survey window.']
  survey_type varchar [note: 'Type of survey associated with the accreditation (initial, renewal, focused).']
  surveyor_contact varchar [note: 'Email address of the primary surveyor or accrediting liaison.']
  surveyor_team varchar [note: 'Name(s) of the surveyor(s) or consulting firm performing the review.']
  updated_timestamp timestamp [note: 'Date and time of the most recent modification to the accreditation record.']

  Note: 'Master record for each accreditation program the health plan participates in — NCQA Health Plan Accreditation, URAC Health Plan Accreditation, NCQA HEDIS, CAHPS survey programs, and CMS Star Ratings. Captures accrediting body, program name, accreditation type, current status (accredited, provisional, denied), accreditation level, effective/expiration dates, accountable business owner, and applicable standards/measures with benchmark thresholds. Includes full survey/review cycle tracking: survey type (initial, renewal, focused), survey date range, surveyor team, scope, preliminary findings, final score/rating, accreditation decision, and conditions or recommendations. Serves as the authoritative registry of all accreditation relationships and their evaluation history.'
}

Table compliance.regulatory_obligation {
  regulatory_obligation_id varchar [pk, note: 'System-generated unique identifier for the regulatory obligation record.']
  audit_findings varchar [note: 'Summary of audit observations related to the obligation.']
  compliance_regulatory_obligation_description varchar [note: 'Full textual description of the regulatory obligation.']
  compliance_regulatory_obligation_status varchar [note: 'Lifecycle status of the regulatory obligation record.']
  compliance_status varchar [note: 'Current compliance state of the obligation.']
  corrective_action_plan varchar [note: 'Planned actions to remediate any compliance gaps.']
  created_timestamp timestamp [note: 'Timestamp when the record was first created.']
  effective_date date [note: 'Date the obligation becomes effective.']
  exemption_allowed boolean [note: 'Indicates whether an exemption from the obligation is possible.']
  exemption_criteria varchar [note: 'Conditions under which an exemption may be granted.']
  expiration_date date [note: 'Date the obligation expires or is superseded (nullable).']
  filing_status varchar [note: 'Current status of required filings.']
  frequency varchar [note: 'How often the obligation must be satisfied.']
  governing_body varchar [note: 'Regulatory authority that issues the obligation (e.g., CMS, OCR, NAIC, State DOI).']
  is_federal boolean [note: 'True if the obligation applies at the federal level.']
  is_state_specific boolean [note: 'True if the obligation is limited to a particular state.']
  jurisdiction varchar [note: 'Geographic scope of the obligation (state, province, or federal).']
  last_assessment_date date [note: 'Date of the most recent compliance assessment.']
  last_modified_by varchar [note: 'User or process that performed the most recent update.']
  next_due_date date [note: 'Date the next compliance action is required.']
  notes varchar [note: 'Additional free‑form comments or observations.']
  obligation_code varchar [note: 'Business identifier code assigned to the regulatory obligation.']
  obligation_type varchar [note: 'Category of the regulatory requirement.']
  penalty_amount decimal(12,2) [note: 'Monetary penalty for non‑compliance.']
  penalty_currency varchar [note: 'Currency of the penalty amount.']
  reference_url varchar [note: 'Link to the official regulation or guidance document.']
  regulatory_framework varchar [note: 'Framework or statute under which the obligation falls (e.g., HIPAA, ACA, Medicare, State Law).']
  reporting_frequency_months varchar [note: 'Number of months between required reports.']
  risk_impact varchar [note: 'Potential business impact if the obligation is not met.']
  risk_likelihood varchar [note: 'Likelihood of non‑compliance occurring.']
  risk_score decimal(5,2) [note: 'Calculated risk score (likelihood × impact).']
  submission_deadline date [note: 'Final date for filing required reports or documents.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the record.']
  version_number varchar [note: 'Version of the obligation definition for change tracking.']

  Note: 'Master record for each regulatory obligation the health plan must fulfill — HIPAA Privacy/Security Rules, ACA market conduct requirements, CMS Medicare/Medicaid mandates, state DOI filings, NCQA/URAC accreditation standards, ERISA requirements, SOC reporting obligations, and state Medicaid fair hearing compliance. Captures the governing body, regulatory framework, obligation type, effective date, jurisdiction, frequency, accountable business owner, compliance status, and obligation risk score (likelihood × impact of non-compliance). Includes tracking of state fair hearing obligations for Medicaid adverse benefit determinations under 42 CFR §438.400. Serves as the authoritative registry of all compliance requirements and the anchor entity linking to submissions, attestations, policies, and corrective actions that demonstrate adherence.'
}

