    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:domicileState rdf:type rdf:Property ;
    rdfs:label 'Domicile State' ;
    rdfs:comment 'Two-letter state code where the employer is legally domiciled.' ;
    rdfs:domain ind:Group ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:enrollmentCountEc rdf:type rdf:Property ;
