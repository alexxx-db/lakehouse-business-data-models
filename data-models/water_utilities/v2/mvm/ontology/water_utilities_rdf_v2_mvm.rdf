ind:filterCondition rdf:type rdf:Property ;
    rdfs:label 'Filter Condition' ;
    rdfs:comment 'Overall health condition of the filter unit.' ;
    rdfs:domain ind:FilterUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:filterEfficiencyPercent rdf:type rdf:Property ;
    rdfs:label 'Filter Efficiency Percent' ;
    rdfs:comment 'Measured removal efficiency of the filter unit expressed as a percentage.' ;
    rdfs:domain ind:FilterUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:filterMediaType rdf:type rdf:Property ;
    rdfs:label 'Filter Media Type' ;
    rdfs:comment 'Material used as the filtering media.' ;
    rdfs:domain ind:FilterUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:filterType rdf:type rdf:Property ;
    rdfs:label 'Filter Type' ;
    rdfs:comment 'Category of filter technology used.' ;
    rdfs:domain ind:FilterUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:flowRateM3PerHour rdf:type rdf:Property ;
    rdfs:label 'Flow Rate M3 Per Hour' ;
    rdfs:comment 'Current operational flow rate through the filter unit.' ;
    rdfs:domain ind:FilterUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:inspectionStatus rdf:type rdf:Property ;
    rdfs:label 'Inspection Status' ;
    rdfs:comment 'Result of the latest inspection.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:installationDate rdf:type rdf:Property ;
    rdfs:label 'Installation Date' ;
    rdfs:comment 'Date the filter unit was installed at the plant.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:isCritical rdf:type rdf:Property ;
    rdfs:label 'Is Critical' ;
    rdfs:comment 'Indicates whether the filter unit is critical to plant operation.' ;
    rdfs:domain ind:FilterUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isRemoteMonitored rdf:type rdf:Property ;
    rdfs:label 'Is Remote Monitored' ;
    rdfs:comment 'True if the filter unit is monitored via a remote SCADA/IoT system.' ;
    rdfs:domain ind:FilterUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastMaintenanceDate rdf:type rdf:Property ;
    rdfs:label 'Last Maintenance Date' ;
    rdfs:comment 'Date the most recent maintenance was performed.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:maintenanceIntervalDays rdf:type rdf:Property ;
    rdfs:label 'Maintenance Interval Days' ;
    rdfs:comment 'Planned number of days between routine maintenance activities.' ;
    rdfs:domain ind:FilterUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:maintenanceStatus rdf:type rdf:Property ;
    rdfs:label 'Maintenance Status' ;
    rdfs:comment 'Current status of the maintenance schedule.' ;
    rdfs:domain ind:FilterUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:manufacturer rdf:type rdf:Property ;
    rdfs:label 'Manufacturer' ;
    rdfs:comment 'Company that manufactured the filter unit.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mediaGrade rdf:type rdf:Property ;
    rdfs:label 'Media Grade' ;
    rdfs:comment 'Specification grade of the filter media (e.g., size, purity).' ;
    rdfs:domain ind:FilterUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modelNumber rdf:type rdf:Property ;
    rdfs:label 'Model Number' ;
    rdfs:comment 'Model designation provided by the manufacturer.' ;
    rdfs:domain ind:FilterUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextMaintenanceDate rdf:type rdf:Property ;
    rdfs:label 'Next Maintenance Date' ;
    rdfs:comment 'Scheduled date for the upcoming maintenance.' ;
    rdfs:domain ind:WaterUtilities ;
