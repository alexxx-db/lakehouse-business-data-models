    rdfs:range xsd:string .

ind:recallType rdf:type rdf:Property ;
    rdfs:label 'Recall Type' ;
    rdfs:comment 'Indicates whether the recall was voluntary by the manufacturer, requested by FDA, or mandated by FDA.' ;
