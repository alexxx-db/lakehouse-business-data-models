ind:heldFlag rdf:type rdf:Property ;
    rdfs:label 'Held Flag' ;
    rdfs:domain ind:Deposit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:installmentCount rdf:type rdf:Property ;
    rdfs:label 'Installment Count' ;
    rdfs:comment 'Number of installments if the deposit is being paid over time.' ;
    rdfs:domain ind:Deposit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:interestAccrued rdf:type rdf:Property ;
    rdfs:label 'Interest Accrued' ;
    rdfs:domain ind:Deposit ;
    rdf:type owl:DatatypeProperty ;
