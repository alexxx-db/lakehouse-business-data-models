ind:allocationCycleId rdf:type rdf:Property ;
    rdfs:label 'Allocation Cycle Id' ;
    rdfs:comment 'Reference to the allocation cycle or batch run during which this allocation was executed.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AllocationCycle .

ind:costEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Cost Employee Id' ;
    rdfs:comment 'User ID of the person who approved this allocation rule. Supports audit trail and governance requirements.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:costReversedAllocationId rdf:type rdf:Property ;
    rdfs:label 'Cost Reversed Allocation Id' ;
    rdfs:comment 'Reference to the original cost allocation transaction that is being reversed by this transaction, if applicable.' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CostAllocation .

ind:fromCostCenterId rdf:type rdf:Property ;
    rdfs:label 'From Cost Center Id' ;
    rdfs:comment 'Foreign key to source cost center' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CostCenter .

ind:primaryCostEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Cost Employee Id' ;
    rdfs:comment 'User ID of the person who approved the cost allocation transaction for posting.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:primarySenderCostCenterId rdf:type rdf:Property ;
    rdfs:label 'Primary Sender Cost Center Id' ;
    rdfs:comment 'FK to finance.cost_center' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CostCenter .

ind:sourceCostAllocationId rdf:type rdf:Property ;
    rdfs:label 'Source Cost Allocation Id' ;
    rdfs:comment 'Self-referencing FK on cost_allocation (source_cost_allocation_id)' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CostAllocation .

ind:tertiaryCostResponsibleManagerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Tertiary Cost Responsible Manager Employee Id' ;
    rdfs:comment 'Employee ID of the manager responsible for this allocation rule. Links to HR system for organizational accountability.' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:toCostCenterId rdf:type rdf:Property ;
    rdfs:label 'To Cost Center Id' ;
    rdfs:comment 'Foreign key to destination cost center' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CostCenter .

ind:allocationCode rdf:type rdf:Property ;
    rdfs:label 'Allocation Code' ;
    rdfs:comment 'Unique business identifier code for the cost allocation method or rule. Used for external reporting and cross-system reference.' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allocationDescription rdf:type rdf:Property ;
    rdfs:label 'Allocation Description' ;
    rdfs:comment 'Detailed description of the allocation rule, including business rationale, methodology, and any special considerations or exceptions.' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allocationDriverUnitOfMeasure rdf:type rdf:Property ;
    rdfs:label 'Allocation Driver Unit Of Measure' ;
    rdfs:comment 'Unit of measure for the allocation driver, such as \'MGD\', \'FTE\', \'USD\', \'square_feet\', \'hours\', \'connections\', or \'gallons\'. Defines how the allocation basis is quantified.' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allocationFormula rdf:type rdf:Property ;
    rdfs:label 'Allocation Formula' ;
    rdfs:comment 'Mathematical formula or expression defining the allocation calculation. May reference allocation drivers, weights, and cost pools. Used for complex or custom allocation logic.' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allocationFrequency rdf:type rdf:Property ;
    rdfs:label 'Allocation Frequency' ;
    rdfs:comment 'Frequency at which this allocation rule is executed: monthly (standard period-end), quarterly (for quarterly closings), annually (year-end only), or on_demand (manual trigger).' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allocationName rdf:type rdf:Property ;
    rdfs:label 'Allocation Name' ;
    rdfs:comment 'Descriptive name of the cost allocation method or rule, such as \'Direct Labor Hours\', \'MGD-Based Allocation\', or \'Asset Value Allocation\'.' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allocationPct rdf:type rdf:Property ;
    rdfs:label 'Allocation Pct' ;
    rdfs:comment 'Allocation percentage' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:allocationPriority rdf:type rdf:Property ;
    rdfs:label 'Allocation Priority' ;
    rdfs:comment 'Execution sequence priority for step-down or cascading allocation methods. Lower numbers execute first. Used to control the order of multi-stage cost allocations.' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:allocationType rdf:type rdf:Property ;
    rdfs:label 'Allocation Type' ;
    rdfs:comment 'Classification of the allocation method used: assessment (fixed percentage), distribution (variable key), periodic (recurring), statistical (based on statistical key figures), activity-based (ABC costing), or direct (one-to-one).' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allocationWeight rdf:type rdf:Property ;
    rdfs:label 'Allocation Weight' ;
    rdfs:comment 'Numeric weight or factor used in weighted allocation calculations. Represents the relative consumption or usage of the allocation driver by the target cost center.' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:capitalExpenditureFlag rdf:type rdf:Property ;
    rdfs:label 'Capital Expenditure Flag' ;
    rdfs:comment 'Indicates whether the allocated costs are capitalized as part of a capital project or asset acquisition.' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:capitalOperatingSplitFlag rdf:type rdf:Property ;
    rdfs:label 'Capital Operating Split Flag' ;
    rdfs:comment 'Indicates whether this allocation rule splits costs between capital expenditures (CAPEX) and operating expenditures (OPEX). True if split allocation is applied.' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:capitalPercentage rdf:type rdf:Property ;
    rdfs:label 'Capital Percentage' ;
    rdfs:comment 'Percentage of allocated costs classified as capital expenditures. Expressed as a decimal (e.g., 0.30 for 30%). Used when capital_operating_split_flag is true.' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:costAllocationDescription rdf:type rdf:Property ;
    rdfs:label 'Cost Allocation Description' ;
    rdfs:comment 'Detailed textual description of the cost allocation transaction, including the purpose and context of the allocation.' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gasbComplianceFlag rdf:type rdf:Property ;
    rdfs:label 'Gasb Compliance Flag' ;
    rdfs:comment 'Indicates whether this allocation method complies with GASB standards for governmental fund accounting and financial reporting. True if GASB-compliant.' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastExecutionDate rdf:type rdf:Property ;
    rdfs:label 'Last Execution Date' ;
    rdfs:comment 'Date on which this allocation rule was last executed in a cost allocation cycle. Used for monitoring and reconciliation.' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nextScheduledExecutionDate rdf:type rdf:Property ;
    rdfs:label 'Next Scheduled Execution Date' ;
    rdfs:comment 'Date on which this allocation rule is next scheduled to execute based on allocation_frequency. Used for planning and period-end close scheduling.' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:operatingPercentage rdf:type rdf:Property ;
    rdfs:label 'Operating Percentage' ;
    rdfs:comment 'Percentage of allocated costs classified as operating expenditures. Expressed as a decimal (e.g., 0.70 for 70%). Used when capital_operating_split_flag is true.' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:postingPeriod rdf:type rdf:Property ;
    rdfs:label 'Posting Period' ;
    rdfs:comment 'Fiscal period to which the cost allocation is posted, in YYYYMM format (e.g., 202312 for December 2023).' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateCaseEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Rate Case Eligible Flag' ;
    rdfs:comment 'Indicates whether the allocated costs are eligible for inclusion in rate case cost-of-service calculations for regulatory rate-setting purposes.' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reciprocalAllocationFlag rdf:type rdf:Property ;
    rdfs:label 'Reciprocal Allocation Flag' ;
    rdfs:comment 'Indicates whether this allocation participates in reciprocal (mutual service) allocation calculations where departments provide services to each other. True if reciprocal method is used.' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:responsibleManagerName rdf:type rdf:Property ;
    rdfs:label 'Responsible Manager Name' ;
    rdfs:comment 'Name of the manager or cost accountant responsible for maintaining and approving this allocation rule. Supports accountability and audit trail.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceCostCenterCode rdf:type rdf:Property ;
    rdfs:label 'Source Cost Center Code' ;
    rdfs:comment 'Cost center code from which costs are being allocated. Represents the originating department or functional area (e.g., \'ADMIN\', \'HR\', \'IT\', \'FLEET\').' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:statisticalKeyFigureCode rdf:type rdf:Property ;
    rdfs:label 'Statistical Key Figure Code' ;
    rdfs:comment 'Code representing the statistical key figure used as the allocation driver (e.g., MGD, customer count, meter count, employee headcount).' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:statisticalKeyFigureValue rdf:type rdf:Property ;
    rdfs:label 'Statistical Key Figure Value' ;
    rdfs:comment 'Numeric value of the statistical key figure for the receiver cost center used to calculate the allocation proportion.' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:targetCostCenterCode rdf:type rdf:Property ;
    rdfs:label 'Target Cost Center Code' ;
    rdfs:comment 'Cost center code to which costs are being allocated. Represents the receiving department or functional area (e.g., \'WTP_OPS\', \'DIST_MAINT\', \'WWTP_OPS\').' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:projectFundingAllocationId rdf:type rdf:Property ;
    rdfs:label 'Project Funding Allocation Id' ;
    rdfs:comment 'Unique identifier for this grant-to-project funding allocation record. Primary key.' ;
    rdfs:domain ind:ProjectFundingAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:allocationCloseoutDate rdf:type rdf:Property ;
    rdfs:label 'Allocation Closeout Date' ;
    rdfs:comment 'Date on which this allocation was formally closed out, indicating all eligible costs have been charged and final reporting completed. Null if allocation is still active.' ;
    rdfs:domain ind:ProjectFundingAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:amountDrawnToDate rdf:type rdf:Property ;
    rdfs:label 'Amount Drawn To Date' ;
    rdfs:comment 'Cumulative dollar amount of grant funds that have been drawn down or reimbursed for this specific project allocation. Should not exceed allocation_amount.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:drawdownScheduleType rdf:type rdf:Property ;
    rdfs:label 'Drawdown Schedule Type' ;
    rdfs:comment 'Type of drawdown schedule governing how funds are requested and disbursed for this allocation: milestone_based (tied to project milestones), monthly_reimbursement (monthly cost reimbursement), quarterly_advance (quarterly advances), completion_based (upon project completion), cost_incurred (as costs are incurred).' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fundingSourceType rdf:type rdf:Property ;
    rdfs:label 'Funding Source Type' ;
    rdfs:comment 'Bond, Grant, Rate Revenue, Contribution, Other' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allocationPurpose rdf:type rdf:Property ;
    rdfs:label 'Allocation Purpose' ;
    rdfs:comment 'Allocation purpose description' ;
    rdfs:domain ind:GrantAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:constructionCost rdf:type rdf:Property ;
    rdfs:label 'Construction Cost' ;
    rdfs:comment 'Total estimated or actual construction cost for the lift station improvements funded by this grant allocation. May exceed allocation_amount if matching funds or other grants are involved.' ;
    rdfs:domain ind:GrantAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:projectMilestone rdf:type rdf:Property ;
    rdfs:label 'Project Milestone' ;
    rdfs:comment 'Current milestone status of the grant-funded lift station project: design_complete, construction_started, construction_complete, operational, closeout. Used for progress reporting to grantor and drawdown eligibility.' ;
    rdfs:domain ind:GrantAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reimbursementAmount rdf:type rdf:Property ;
    rdfs:label 'Reimbursement Amount' ;
    rdfs:comment 'Cumulative dollar amount of grant funds that have been drawn down or reimbursed for this specific lift station project. Tracks expenditure against allocation_amount.' ;
    rdfs:domain ind:GrantAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:grantFundedSegmentId rdf:type rdf:Property ;
    rdfs:label 'Grant Funded Segment Id' ;
    rdfs:comment 'Unique identifier for this grant-segment funding relationship. Primary key.' ;
    rdfs:domain ind:GrantFundedSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:eligibleCostFlag rdf:type rdf:Property ;
    rdfs:label 'Eligible Cost Flag' ;
    rdfs:comment 'Indicates whether costs for this segment are eligible for reimbursement under this grant\'s allowable cost categories and compliance conditions. False if segment work does not meet grantor requirements.' ;
    rdfs:domain ind:GrantFundedSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:matchRequirementAmount rdf:type rdf:Property ;
    rdfs:label 'Match Requirement Amount' ;
    rdfs:comment 'Dollar amount of local matching funds required for this segment based on the grant\'s matching percentage. Calculated as segment_rehabilitation_cost × grant.matching_requirement_percentage.' ;
    rdfs:domain ind:GrantFundedSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:segmentRehabilitationCost rdf:type rdf:Property ;
    rdfs:label 'Segment Rehabilitation Cost' ;
    rdfs:comment 'Total estimated or actual cost of rehabilitation work on this sewer segment funded by this grant. May exceed allocation if multiple funding sources are used.' ;
    rdfs:domain ind:GrantFundedSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:workCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Work Completion Date' ;
    rdfs:comment 'Date when rehabilitation work was completed on this segment. Triggers final expenditure reconciliation and closeout processes for this segment-grant relationship.' ;
    rdfs:domain ind:GrantFundedSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:workStartDate rdf:type rdf:Property ;
    rdfs:label 'Work Start Date' ;
    rdfs:comment 'Date when rehabilitation work began on this segment under this grant. Used for period of performance compliance and project timeline tracking.' ;
    rdfs:domain ind:GrantFundedSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:paymentApprovedByEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Payment Approved By Employee Id' ;
    rdfs:comment 'Approved by employee' ;
    rdfs:domain ind:PaymentRun ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:paymentCreatedByEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Payment Created By Employee Id' ;
    rdfs:comment 'Created by employee' ;
    rdfs:domain ind:PaymentRun ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:reissuedPaymentRunId rdf:type rdf:Property ;
    rdfs:label 'Reissued Payment Run Id' ;
    rdfs:comment 'Self-referencing FK on payment_run (reissued_payment_run_id)' ;
    rdfs:domain ind:PaymentRun ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PaymentRun .

ind:auditTrailReference rdf:type rdf:Property ;
    rdfs:label 'Audit Trail Reference' ;
    rdfs:comment 'Identifier linking to the audit trail record for this payment run.' ;
    rdfs:domain ind:PaymentRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:paymentRunDescription rdf:type rdf:Property ;
    rdfs:label 'Payment Run Description' ;
    rdfs:comment 'Free-text description or notes about the payment run.' ;
    rdfs:domain ind:PaymentRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:failedTransactionsCount rdf:type rdf:Property ;
    rdfs:label 'Failed Transactions Count' ;
    rdfs:comment 'Number of transactions that failed during the run.' ;
    rdfs:domain ind:PaymentRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isAutomated rdf:type rdf:Property ;
    rdfs:label 'Is Automated' ;
    rdfs:comment 'Indicates whether the payment run was generated automatically by the system.' ;
    rdfs:domain ind:PaymentRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPriority rdf:type rdf:Property ;
    rdfs:label 'Is Priority' ;
    rdfs:comment 'Flag indicating if the payment run was marked as high priority.' ;
    rdfs:domain ind:PaymentRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:numberOfTransactions rdf:type rdf:Property ;
    rdfs:label 'Number Of Transactions' ;
    rdfs:comment 'Count of individual payment transactions included in the run.' ;
    rdfs:domain ind:PaymentRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:paymentCount rdf:type rdf:Property ;
    rdfs:label 'Payment Count' ;
    rdfs:comment 'Number of payments' ;
    rdfs:domain ind:PaymentRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:paymentRunNumber rdf:type rdf:Property ;
    rdfs:label 'Payment Run Number' ;
    rdfs:comment 'Payment run number' ;
    rdfs:domain ind:PaymentRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:runName rdf:type rdf:Property ;
    rdfs:label 'Run Name' ;
    rdfs:comment 'Descriptive name for the payment run.' ;
    rdfs:domain ind:PaymentRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:runTimestamp rdf:type rdf:Property ;
    rdfs:label 'Run Timestamp' ;
    rdfs:comment 'Primary business event time for the payment run.' ;
    rdfs:domain ind:PaymentRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:runType rdf:type rdf:Property ;
    rdfs:label 'Run Type' ;
    rdfs:comment 'Classification of the payment run purpose.' ;
    rdfs:domain ind:PaymentRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentRunStatus rdf:type rdf:Property ;
    rdfs:label 'Payment Run Status' ;
    rdfs:comment 'Current lifecycle status of the payment run.' ;
    rdfs:domain ind:PaymentRun ;
