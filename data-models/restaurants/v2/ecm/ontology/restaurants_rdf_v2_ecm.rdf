# RDFS Schema for Business: Restaurants

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix ind: <http://datamodel.lakehouse.org/business/restaurants#> .

# --- Root Business Class ---
ind:Business rdf:type rdfs:Class ;
    rdfs:label 'Business' ;
    rdfs:comment 'Root class for all business entities' .

# --- Specific Business: Restaurants ---
ind:Restaurants rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Business ;
    rdfs:label 'Restaurants' ;
    rdfs:comment 'restaurants industry enterprise data model.' .

# --- Domain Classes ---
ind:Menu rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Restaurants ;
    rdfs:label 'Menu' ;
    rdfs:comment 'Single source of truth for all menu items, recipes, BOMs (Bill of Materials), nutritional data, allergen declarations, pricing, product mix (PMIX), limited time offers (LTO), and menu engineering decisions across dayparts, channels (DT, OLO, 3PD), and restaurant formats (QSR, casual, fine-dining). Governs what the business sells.' .

ind:Guest rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Restaurants ;
    rdfs:label 'Guest' ;
    rdfs:comment 'Single source of truth for customer identity, profiles, preferences, demographics, segments, loyalty membership, and guest engagement across all channels (dine-in, drive-thru, online ordering). Manages CSAT, NPS, lifetime value, and consent/privacy management. Master record for WHO the business serves.' .

ind:Order rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Restaurants ;
    rdfs:label 'Order' ;
    rdfs:comment 'Core transactional domain managing order capture, fulfillment, and delivery across all service channels including POS (Oracle MICROS), drive-thru (DT), online ordering (OLO), third-party delivery (3PD), and catering. Tracks order lifecycle, KDS routing, ticket time, speed of service (SOS), average transaction count (ATC), and average check value (ACV).' .

ind:Supply rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Restaurants ;
    rdfs:label 'Supply' ;
    rdfs:comment 'Manages end-to-end food and non-food supply chain including supplier master data, vendor management, sourcing, purchase orders, inbound logistics, distribution center operations, and ingredient traceability. Tracks COGS, supplier performance, contract compliance, and spend analytics via Coupa Procurement.' .

ind:Inventory rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Restaurants ;
    rdfs:label 'Inventory' ;
    rdfs:comment 'Manages BOH stock levels, SKU tracking, PAR levels (Periodic Automatic Replenishment), waste tracking (Waste%), yield management, receiving, transfers, physical counts, and replenishment orders via MarketMan. Supports COGS% optimization and food cost control across all restaurant units.' .

ind:Restaurant rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Restaurants ;
    rdfs:label 'Restaurant' ;
    rdfs:comment 'Master record for every restaurant unit — company-owned and franchised — including location attributes, format (QSR/casual/fine-dining), FOH/BOH configuration, operating hours, daypart schedules, equipment, throughput capacity, speed-of-service (SOS) benchmarks, table turns, cover counts, AUV, SSS, and comp sales. Operational anchor for brand standards and SOPs.' .

ind:Workforce rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Restaurants ;
    rdfs:label 'Workforce' ;
    rdfs:comment 'Manages employee lifecycle including recruiting, onboarding, scheduling, time and attendance, labor forecasting, Labor% optimization, FTE tracking, certifications (ServSafe), performance management, and payroll integration via Workday HCM and Planday. Optimizes labor deployment across dayparts, BOH/FOH staffing ratios, and restaurant locations.' .

ind:Franchise rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Restaurants ;
    rdfs:label 'Franchise' ;
    rdfs:comment 'SSOT for franchise partner identity, FDD agreements, territory management, royalty rate calculations, franchise fees, compliance tracking, NRO (New Restaurant Opening) pipeline, franchisee performance metrics, and development lifecycle via FranConnect. Ensures adherence to brand standards, IFA best practices, and FTC Franchise Rule.' .

ind:Foodsafety rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Restaurants ;
    rdfs:label 'Foodsafety' ;
    rdfs:comment 'Governs HACCP plan management, food safety audit results, health inspection records, corrective action tracking, temperature monitoring logs, sanitation schedules, allergen management, and SOP compliance via Zenput. Ensures adherence to FDA FSMA, local health department requirements, ISO 22000, and ServSafe standards across all restaurant units.' .

ind:Loyalty rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Restaurants ;
    rdfs:label 'Loyalty' ;
    rdfs:comment 'Manages guest loyalty program enrollment, membership tiers, points accrual and redemption, rewards catalog, promotional offers, personalized campaigns, member engagement, and loyalty analytics. Drives repeat visits, ACV lift, and customer lifetime value through targeted incentives and gamification across OLO and POS channels.' .

ind:Marketing rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Restaurants ;
    rdfs:label 'Marketing' ;
    rdfs:comment 'Manages promotional campaign planning, LTO execution, advertising spend, media channel performance (digital, social, traditional), brand positioning, local store marketing, guest segmentation, and campaign ROI measurement. Drives traffic, average daily transactions (ADT), and comparable store sales (comp sales) lift.' .

ind:Finance rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Restaurants ;
    rdfs:label 'Finance' ;
    rdfs:comment 'Authoritative domain for general ledger (GL), accounts payable (AP), accounts receivable (AR), fixed assets (FA), cost center management, budgeting, P&L reporting, EBITDA tracking, CapEx/OpEx classification, revenue management, royalty income accounting, and multi-entity consolidation via SAP S/4HANA. GAAP/IFRS compliant financial statements.' .

ind:Realestate rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Restaurants ;
    rdfs:label 'Realestate' ;
    rdfs:comment 'Manages site selection, lease negotiations, property acquisition, facility design and construction, CAM (Common Area Maintenance) charges, landlord relationships, lease administration, NRO development pipeline, facility R&M (Repairs and Maintenance), and CapEx planning for new builds and remodels. Tracks lease obligations for IFRS 16 / ASC 842 compliance.' .

ind:Procurement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Restaurants ;
    rdfs:label 'Procurement' ;
    rdfs:comment 'Owns sourcing events, supplier contracts, spend analytics, purchase requisition-to-order workflows, approved vendor lists, contract compliance, and category management for food, packaging, equipment, and services via Coupa Procurement. Distinct from supply domain which tracks physical inventory movement — procurement owns the commercial supplier relationship and contractual terms.' .

# --- Data Product Classes (Tables) ---
ind:MenuItem rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Menu ;
    rdfs:label 'Menu Item' ;
    rdfs:comment 'Individual food or beverage items available for sale on menus' .

ind:Menu rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Menu ;
    rdfs:label 'Menu' ;
    rdfs:comment 'Menu definitions containing collections of menu items' .

ind:Recipe rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Menu ;
    rdfs:label 'Recipe' ;
    rdfs:comment 'Recipe definitions for menu items including preparation instructions' .

ind:RecipeIngredient rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Menu ;
    rdfs:label 'Recipe Ingredient' ;
    rdfs:comment 'Ingredients used in recipes with quantities and specifications' .

ind:ItemPrice rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Menu ;
    rdfs:label 'Item Price' ;
    rdfs:comment 'Pricing information for menu items across locations and channels' .

ind:NutritionProfile rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Menu ;
    rdfs:label 'Nutrition Profile' ;
    rdfs:comment 'Nutritional information for menu items and recipes' .

ind:AllergenDeclaration rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Menu ;
    rdfs:label 'Allergen Declaration' ;
    rdfs:comment 'Allergen declarations for menu items' .

ind:MenuLto rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Menu ;
    rdfs:label 'Menu Lto' ;
    rdfs:comment 'Limited time offer menu items and promotions' .

ind:ModifierGroup rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Menu ;
    rdfs:label 'Modifier Group' ;
    rdfs:comment 'Groups of modifiers that can be applied to menu items' .

ind:MenuModifier rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Menu ;
    rdfs:label 'Menu Modifier' ;
    rdfs:comment 'Individual modifiers that can be applied to menu items' .

ind:PmixRecord rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Menu ;
    rdfs:label 'Pmix Record' ;
    rdfs:comment 'Product mix records tracking sales performance of menu items' .

ind:EngineeringReview rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Menu ;
    rdfs:label 'Engineering Review' ;
    rdfs:comment 'Menu engineering reviews and analysis' .

ind:ItemCost rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Menu ;
    rdfs:label 'Item Cost' ;
    rdfs:comment 'Cost information for menu items' .

ind:ComboMeal rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Menu ;
    rdfs:label 'Combo Meal' ;
    rdfs:comment 'Combo meal definitions bundling multiple menu items' .

ind:Item86Event rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Menu ;
    rdfs:label 'Item 86 Event' ;
    rdfs:comment 'Events when menu items are marked as unavailable (86ed)' .

ind:DietaryTag rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Menu ;
    rdfs:label 'Dietary Tag' ;
    rdfs:comment 'Dietary tags for categorizing menu items' .

ind:ComboComponent rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Menu ;
    rdfs:label 'Combo Component' ;
    rdfs:comment 'Components that make up combo meals' .

ind:DietaryTagAssignment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Menu ;
    rdfs:label 'Dietary Tag Assignment' ;
    rdfs:comment 'Assignments of dietary tags to menu items' .

ind:Profile rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Guest ;
    rdfs:label 'Profile' ;
    rdfs:comment 'Core guest profile containing personal information, contact details, preferences, and loyalty status' .

ind:IdentityResolution rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Guest ;
    rdfs:label 'Identity Resolution' ;
    rdfs:comment 'Identity resolution records for matching and merging guest profiles across systems' .

ind:Address rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Guest ;
    rdfs:label 'Address' ;
    rdfs:comment 'Guest addresses for delivery, billing, and correspondence' .

ind:Preference rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Guest ;
    rdfs:label 'Preference' ;
    rdfs:comment 'Guest preferences for dietary restrictions, communication, and service' .

ind:ConsentRecord rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Guest ;
    rdfs:label 'Consent Record' ;
    rdfs:comment 'Records of guest consent for marketing, data processing, and privacy' .

ind:GuestSegment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Guest ;
    rdfs:label 'Guest Segment' ;
    rdfs:comment 'Guest segments for targeted marketing and personalization' .

ind:GuestSegmentMembership rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Guest ;
    rdfs:label 'Guest Segment Membership' ;
    rdfs:comment 'Guest membership in segments with assignment details and scores' .

ind:Household rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Guest ;
    rdfs:label 'Household' ;
    rdfs:comment 'Household groupings of guest profiles for family marketing' .

ind:HouseholdMember rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Guest ;
    rdfs:label 'Household Member' ;
    rdfs:comment 'Individual members within a household' .

ind:LifetimeValue rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Guest ;
    rdfs:label 'Lifetime Value' ;
    rdfs:comment 'Guest lifetime value calculations and predictions' .

ind:SatisfactionSurvey rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Guest ;
    rdfs:label 'Satisfaction Survey' ;
    rdfs:comment 'Guest satisfaction surveys with NPS and CSAT scores' .

ind:SurveyResponse rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Guest ;
    rdfs:label 'Survey Response' ;
    rdfs:comment 'Individual responses to survey questions' .

ind:Complaint rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Guest ;
    rdfs:label 'Complaint' ;
    rdfs:comment 'Guest complaints and resolution tracking' .

ind:Interaction rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Guest ;
    rdfs:label 'Interaction' ;
    rdfs:comment 'Guest interactions across all touchpoints' .

ind:ChannelIdentity rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Guest ;
    rdfs:label 'Channel Identity' ;
    rdfs:comment 'Guest identities across different channels and platforms' .

ind:Communication rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Guest ;
    rdfs:label 'Communication' ;
    rdfs:comment 'Communications sent to guests across channels' .

ind:Demographic rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Guest ;
    rdfs:label 'Demographic' ;
    rdfs:comment 'Guest demographic information for segmentation and analytics' .

ind:GuestVisit rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Guest ;
    rdfs:label 'Guest Visit' ;
    rdfs:comment 'Guest visit records with transaction and experience details' .

ind:GuestAllergenProfile rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Guest ;
    rdfs:label 'Guest Allergen Profile' ;
    rdfs:comment 'Guest allergen profiles for food safety and personalization' .

ind:DigitalAccount rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Guest ;
    rdfs:label 'Digital Account' ;
    rdfs:comment 'Guest digital accounts for app and online ordering' .

ind:ConsentPolicy rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Guest ;
    rdfs:label 'Consent Policy' ;
    rdfs:comment 'Consent policies defining data processing rules and permissions' .

ind:SurveyQuestion rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Guest ;
    rdfs:label 'Survey Question' ;
    rdfs:comment 'Survey questions for guest feedback collection' .

ind:CorporateAccount rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Guest ;
    rdfs:label 'Corporate Account' ;
    rdfs:comment 'Corporate accounts for business guests and catering' .

ind:GuestOrder rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Order ;
    rdfs:label 'Guest Order' ;
    rdfs:comment 'Core order transaction capturing a guest purchase at a restaurant unit.' .

ind:OrderItem rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Order ;
    rdfs:label 'Order Item' ;
    rdfs:comment 'Individual line item within a guest order.' .

ind:OrderModifier rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Order ;
    rdfs:label 'Order Modifier' ;
    rdfs:comment 'Modifier applied to an order item such as add-ons, substitutions, or removals.' .

ind:Payment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Order ;
    rdfs:label 'Payment' ;
    rdfs:comment 'Payment tendered against a guest order.' .

ind:StatusEvent rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Order ;
    rdfs:label 'Status Event' ;
    rdfs:comment 'State transition event in the order lifecycle.' .

ind:Channel rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Order ;
    rdfs:label 'Channel' ;
    rdfs:comment 'Order channel reference (dine-in, drive-thru, OLO, delivery, etc.).' .

ind:Daypart rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Order ;
    rdfs:label 'Daypart' ;
    rdfs:comment 'Time-window definition for restaurant operations (breakfast, lunch, dinner, late-night).' .

ind:KdsTicket rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Order ;
    rdfs:label 'Kds Ticket' ;
    rdfs:comment 'Kitchen display system ticket tracking preparation of an order.' .

ind:DriveThruEvent rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Order ;
    rdfs:label 'Drive Thru Event' ;
    rdfs:comment 'Sensor-based event capturing vehicle progression through drive-thru lanes.' .

ind:DeliveryOrder rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Order ;
    rdfs:label 'Delivery Order' ;
    rdfs:comment 'Delivery-specific details for an order fulfilled via delivery.' .

ind:CateringOrder rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Order ;
    rdfs:label 'Catering Order' ;
    rdfs:comment 'Catering order with event details, headcount, and delivery logistics.' .

ind:Discount rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Order ;
    rdfs:label 'Discount' ;
    rdfs:comment 'Discount applied to an order or order item.' .

ind:Refund rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Order ;
    rdfs:label 'Refund' ;
    rdfs:comment 'Refund issued against a guest order.' .

ind:SosTarget rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Order ;
    rdfs:label 'Sos Target' ;
    rdfs:comment 'Speed-of-service target configuration by channel, daypart, and format.' .

ind:Tax rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Order ;
    rdfs:label 'Tax' ;
    rdfs:comment 'Tax line applied to a guest order.' .

ind:OrderIngredientUsage rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Order ;
    rdfs:label 'Order Ingredient Usage' ;
    rdfs:comment 'Ingredient consumption record tied to an order item for food cost and waste tracking.' .

ind:CateringPackage rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Order ;
    rdfs:label 'Catering Package' ;
    rdfs:comment 'Pre-configured catering package template with pricing and constraints.' .

ind:DeliveryPlatform rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Order ;
    rdfs:label 'Delivery Platform' ;
    rdfs:comment 'Third-party delivery platform reference (e.g., DoorDash, UberEats).' .

ind:SupplySupplier rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Supply ;
    rdfs:label 'Supply Supplier' ;
    rdfs:comment 'Master record for suppliers providing ingredients and goods to the restaurant supply chain.' .

ind:Ingredient rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Supply ;
    rdfs:label 'Ingredient' ;
    rdfs:comment 'Master catalog of ingredients used in restaurant recipes and menu items.' .

ind:SupplyPurchaseOrder rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Supply ;
    rdfs:label 'Supply Purchase Order' ;
    rdfs:comment 'Purchase orders placed with suppliers for ingredients and supplies.' .

ind:PurchaseOrderLine rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Supply ;
    rdfs:label 'Purchase Order Line' ;
    rdfs:comment 'Individual line items on a supply purchase order specifying ingredient, quantity, and price.' .

ind:GoodsReceipt rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Supply ;
    rdfs:label 'Goods Receipt' ;
    rdfs:comment 'Header record for receiving goods against a purchase order at a restaurant or distribution center.' .

ind:GoodsReceiptLine rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Supply ;
    rdfs:label 'Goods Receipt Line' ;
    rdfs:comment 'Line-level detail for goods received, including quantity, quality, and cost information.' .

ind:Invoice rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Supply ;
    rdfs:label 'Invoice' ;
    rdfs:comment 'Supplier invoices received for goods and services, linked to POs and goods receipts for three-way matching.' .

ind:SupplierContract rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Supply ;
    rdfs:label 'Supplier Contract' ;
    rdfs:comment 'Detailed contract records with suppliers including pricing, terms, compliance, and renewal information.' .

ind:ContractPrice rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Supply ;
    rdfs:label 'Contract Price' ;
    rdfs:comment 'Price schedules within supplier contracts, supporting tiered and time-bound pricing.' .

ind:SupplierPerformance rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Supply ;
    rdfs:label 'Supplier Performance' ;
    rdfs:comment 'Periodic performance measurements for suppliers covering delivery, quality, and compliance metrics.' .

ind:DistributionCenter rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Supply ;
    rdfs:label 'Distribution Center' ;
    rdfs:comment 'Physical distribution centers and warehouses that store and ship ingredients to restaurant units.' .

ind:InboundShipment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Supply ;
    rdfs:label 'Inbound Shipment' ;
    rdfs:comment 'Tracking of inbound shipments from suppliers to distribution centers or restaurant units.' .

ind:IngredientLot rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Supply ;
    rdfs:label 'Ingredient Lot' ;
    rdfs:comment 'Lot-level tracking of ingredients for traceability, quality, and recall management.' .

ind:QualityInspection rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Supply ;
    rdfs:label 'Quality Inspection' ;
    rdfs:comment 'Quality inspections performed on received ingredients and supplies.' .

ind:RecallEvent rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Supply ;
    rdfs:label 'Recall Event' ;
    rdfs:comment 'Product and ingredient recall events tracking affected items, severity, and resolution.' .

ind:CommodityCategory rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Supply ;
    rdfs:label 'Commodity Category' ;
    rdfs:comment 'Hierarchical classification of commodities for spend analysis, sourcing strategy, and supplier categorization.' .

ind:SupplyContract rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Supply ;
    rdfs:label 'Supply Contract' ;
    rdfs:comment 'Supply-specific contracts linking suppliers to sites/categories with pricing and delivery terms.' .

ind:StockItem rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Inventory ;
    rdfs:label 'Stock Item' ;
    rdfs:comment 'Master record for each stockable item tracked in restaurant inventory including allergen flags, storage requirements, and reorder parameters.' .

ind:StockLocation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Inventory ;
    rdfs:label 'Stock Location' ;
    rdfs:comment 'Physical storage locations within restaurants, distribution centers, or facilities where inventory is held.' .

ind:OnHandBalance rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Inventory ;
    rdfs:label 'On Hand Balance' ;
    rdfs:comment 'Current on-hand inventory balance for each stock item at each location, including valuation and par-level tracking.' .

ind:ReceivingOrder rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Inventory ;
    rdfs:label 'Receiving Order' ;
    rdfs:comment 'Records of goods received at a restaurant unit or facility, including quality checks and temperature verification.' .

ind:PhysicalCount rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Inventory ;
    rdfs:label 'Physical Count' ;
    rdfs:comment 'Physical inventory count events performed at restaurant units, tracking count results, variances, and GL postings.' .

ind:WasteLog rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Inventory ;
    rdfs:label 'Waste Log' ;
    rdfs:comment 'Records of inventory waste events including reason, quantity, cost impact, and HACCP compliance.' .

ind:StockTransfer rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Inventory ;
    rdfs:label 'Stock Transfer' ;
    rdfs:comment 'Records of inventory transfers between locations, units, or facilities including shipping and quality inspection details.' .

ind:ReplenishmentOrder rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Inventory ;
    rdfs:label 'Replenishment Order' ;
    rdfs:comment 'Orders placed to replenish inventory at restaurant units, including approval workflow and delivery tracking.' .

ind:YieldRecord rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Inventory ;
    rdfs:label 'Yield Record' ;
    rdfs:comment 'Records of ingredient yield from prep activities, tracking actual vs standard yield and associated costs.' .

ind:InventoryAdjustment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Inventory ;
    rdfs:label 'Inventory Adjustment' ;
    rdfs:comment 'Records of inventory quantity adjustments including reason codes, approval workflow, and financial impact.' .

ind:FoodCostPeriod rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Inventory ;
    rdfs:label 'Food Cost Period' ;
    rdfs:comment 'Periodic food cost calculations for restaurant units including actual vs theoretical cost, variance analysis, and COGS percentages.' .

ind:Uom rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Inventory ;
    rdfs:label 'Uom' ;
    rdfs:comment 'Unit of measure reference table with conversion factors, categorization, and applicability flags.' .

ind:VendorItem rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Inventory ;
    rdfs:label 'Vendor Item' ;
    rdfs:comment 'Mapping of stock items to vendor/supplier catalog items including pricing, lead times, and ordering parameters.' .

ind:LotTracking rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Inventory ;
    rdfs:label 'Lot Tracking' ;
    rdfs:comment 'Lot-level tracking of inventory for traceability, recall management, and HACCP compliance.' .

ind:PrepUsage rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Inventory ;
    rdfs:label 'Prep Usage' ;
    rdfs:comment 'Records of ingredient usage during food preparation, tracking actual vs theoretical consumption and variances.' .

ind:ItemCategory rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Inventory ;
    rdfs:label 'Item Category' ;
    rdfs:comment 'Hierarchical categorization of inventory items with associated management parameters and compliance requirements.' .

ind:InventoryIngredientUsage rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Inventory ;
    rdfs:label 'Inventory Ingredient Usage' ;
    rdfs:comment 'Aggregated ingredient usage records linking inventory consumption to orders, tracking actual vs theoretical usage and variances.' .

ind:Unit rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Restaurant ;
    rdfs:label 'Unit' ;
    rdfs:comment 'Master record for every restaurant unit — company-owned and franchised. The authoritative identity of each physical location including unit number, brand, concept type (QSR/casual/fine-dining), ownership model (company-owned vs. franchised), legal entity name, trade name, opening date, closure date, current operational status, and geographic coordinates. This is the operational anchor for the entire restaurant domain and the primary FK target for all cross-domain joins (order, inventory, workforce, finance, franchise). One row per physical restaurant location. All other restaurant domain products reference this entity.' .

ind:LocationProfile rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Restaurant ;
    rdfs:label 'Location Profile' ;
    rdfs:comment 'Physical and geographic attributes of each restaurant unit including full street address, city, state, province, postal code, country, DMA (Designated Market Area), trade area classification, latitude/longitude, timezone, locale, accessibility features, parking capacity, drive-thru lane count, patio seating availability, and proximity to key landmarks. Supports site analytics, delivery radius configuration, and regional reporting.' .

ind:FormatConfig rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Restaurant ;
    rdfs:label 'Format Config' ;
    rdfs:comment 'Defines the operational format, physical configuration, and total capacity of a restaurant unit. Includes dining format (QSR, fast-casual, casual, fine-dining), service model (counter, table, drive-thru, kiosk), FOH layout (total indoor seating capacity, outdoor/patio seating capacity, bar seating count, private dining room capacity, ADA-compliant seating count, table count, cover count), BOH layout (kitchen footprint sq ft, cooking lines, prep stations), drive-thru configuration (lane count, stacking capacity for vehicles), kiosk count, counter service positions, and maximum cover count per daypart. This is the single source of truth for all physical capacity and layout attributes of a unit — governs brand standard compliance, throughput benchmarking, labor staffing ratios, health department permit compliance, and fire marshal occupancy limits.' .

ind:OperatingHours rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Restaurant ;
    rdfs:label 'Operating Hours' ;
    rdfs:comment 'Scheduled operating hours for each restaurant unit by day of week and daypart (breakfast, lunch, dinner, late-night, 24hr). Captures open time, close time, daypart start/end times, holiday schedule overrides, seasonal hour adjustments, drive-thru-specific hours, delivery window hours, and last-order cutoff times. Used for order routing, labor scheduling, and SSS (Same-Store Sales) period alignment.' .

ind:EquipmentAsset rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Restaurant ;
    rdfs:label 'Equipment Asset' ;
    rdfs:comment 'Inventory of all BOH and FOH equipment assets installed at each restaurant unit including all equipment types (fryer, grill, oven, KDS stations, POS terminals, refrigeration units, ice machines, espresso machines, drive-thru timers). Captures make, model, serial number, installation date, warranty expiry, last service date, next scheduled maintenance date, asset condition rating, replacement cost, software version (for digital equipment), and equipment-specific configuration attributes. Supports R&M (Repairs and Maintenance) planning, CapEx forecasting, PCI DSS compliance for payment terminals, and food safety compliance for temperature-critical equipment.' .

ind:ThroughputBenchmark rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Restaurant ;
    rdfs:label 'Throughput Benchmark' ;
    rdfs:comment 'Defines throughput capacity benchmarks and speed-of-service (SOS) targets for each restaurant unit by service channel (DT drive-thru, counter, OLO online, 3PD third-party delivery) and daypart. Captures target ticket time (seconds), target throughput (covers/hour or transactions/hour), ADT (Average Daily Transactions) target, ATC (Average Transaction Count) target, ACV (Average Check Value) target, table turn target (minutes), and cover count capacity. Used for operational performance benchmarking and SOS compliance.' .

ind:SosMeasurement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Restaurant ;
    rdfs:label 'Sos Measurement' ;
    rdfs:comment 'Transactional records of actual speed-of-service (SOS), throughput measurements, and table turn events captured per service event at each restaurant unit across all channels. For drive-thru/counter/kiosk/OLO: captures measurement timestamp, service channel, daypart, order-to-ready time, order-to-delivery time, ticket time, queue wait time, and measurement source (POS timer, KDS, sensor). For dine-in table service: captures table identifier, cover count, seating time, order-placed time, food-delivered time, check-presented time, table-cleared time, total turn time, server station, party size, and table status transitions. This is the single source of truth for all operational timing and throughput measurements across every service model. Enables unified SOS trend analysis, table turn rate optimization, cover count tracking, FOH throughput benchmarking, and benchmark gap identification.' .

ind:BrandStandard rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Restaurant ;
    rdfs:label 'Brand Standard' ;
    rdfs:comment 'Defines the brand standards and SOPs (Standard Operating Procedures) applicable to each restaurant unit by concept type and ownership model. Captures standard code, standard name, standard category (food quality, cleanliness, service, safety, brand presentation), applicable format (QSR/casual/fine-dining), compliance requirement level (mandatory/recommended), effective date, expiry date, governing body reference (NRA, FDA, OSHA), and linked SOP document reference. Operational anchor for audit and compliance workflows.' .

ind:UnitPerformance rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Restaurant ;
    rdfs:label 'Unit Performance' ;
    rdfs:comment 'Periodic operational and financial performance record for each restaurant unit capturing AUV (Average Unit Volume), SSS (Same-Store Sales) growth %, comp sales (Comparable Store Sales) vs. prior period, ADT (Average Daily Transactions), ATC (Average Transaction Count), ACV (Average Check Value), COGS% (Cost of Goods Sold Percentage), Labor% (Labor Cost Percentage), Waste% (Food Waste Percentage), EBITDA, and net revenue. Sourced from Oracle MICROS POS and SAP S/4HANA. Primary performance scorecard for unit-level P&L management.' .

ind:TableTurnLog rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Restaurant ;
    rdfs:label 'Table Turn Log' ;
    rdfs:comment 'Transactional log of table turn events at each restaurant unit capturing table identifier, cover count seated, seating time, order-placed time, food-delivered time, check-presented time, table-cleared time, total turn time (minutes), daypart, server station, and party size. Enables table turn rate analysis, cover count optimization, and FOH throughput benchmarking for casual and fine-dining formats.' .

ind:CapacityConfig rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Restaurant ;
    rdfs:label 'Capacity Config' ;
    rdfs:comment 'Defines the seating and service capacity configuration for each restaurant unit including total indoor seating capacity, outdoor/patio seating capacity, bar seating count, private dining room capacity, drive-thru stacking capacity (number of vehicles), kiosk count, counter service positions, maximum cover count per daypart, and ADA-compliant seating count. Used for throughput planning, labor staffing ratios, and health department permit compliance.' .

ind:UnitStatusHistory rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Restaurant ;
    rdfs:label 'Unit Status History' ;
    rdfs:comment 'Tracks the full lifecycle status history of each restaurant unit including status transitions (active, temporarily closed, permanently closed, under renovation, pre-opening, soft-open, NRO new restaurant opening), effective date of each status change, reason code, change initiated by (franchise partner, corporate operations, health department), and expected reopen date where applicable. Provides audit trail for unit lifecycle management and SSS eligibility determination.' .

ind:AreaManagement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Restaurant ;
    rdfs:label 'Area Management' ;
    rdfs:comment 'Defines the operational management hierarchy above the restaurant unit level. Captures area/district/region boundaries, area manager assignment (name, employee ID, assignment effective dates), number of units in area, geographic region, division, brand, and area performance targets (AUV target, SSS target, CSAT target, Labor% target). Supports multi-unit management accountability, area manager performance reviews, regional performance rollups, and franchise territory alignment. One row per area/district assignment period.' .

ind:RenovationProject rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Restaurant ;
    rdfs:label 'Renovation Project' ;
    rdfs:comment 'Tracks restaurant unit renovation, remodel, and refresh projects including project type (full remodel, refresh, equipment upgrade, ADA retrofit, brand reimaging), project status (planned, approved, in-progress, completed, cancelled), planned start date, actual start date, planned completion date, actual completion date, estimated CapEx, actual CapEx, contractor name, closure duration (days), and expected AUV lift post-renovation. Coordinates with realestate domain for facility management and finance domain for CapEx tracking.' .

ind:OpsVisit rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Restaurant ;
    rdfs:label 'Ops Visit' ;
    rdfs:comment 'Records operational field visits conducted by area managers, brand consultants, or corporate operations teams at each restaurant unit. Captures visit date, visit type (scheduled, unannounced, follow-up, NRO opening support), visitor name and role, overall visit score, sub-scores by category (food quality, cleanliness, service, speed, safety), critical findings count, corrective actions required flag, and follow-up visit scheduled date. Sourced from Zenput operational compliance platform.' .

ind:OpsVisitFinding rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Restaurant ;
    rdfs:label 'Ops Visit Finding' ;
    rdfs:comment 'Line-item findings recorded during an operational field visit at a restaurant unit. Each record captures the parent visit reference, finding category (food safety, cleanliness, equipment, service, brand standard, labor), finding description, severity level (critical, major, minor, observation), brand standard violated, corrective action required, corrective action due date, corrective action completed flag, and completion date. Enables granular compliance gap tracking and repeat-finding trend analysis.' .

ind:UnitOwnership rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Restaurant ;
    rdfs:label 'Unit Ownership' ;
    rdfs:comment 'Tracks the ownership and operational control history of each restaurant unit including ownership type (company-owned, franchised, licensed, joint-venture), franchise partner reference, ownership effective start date, ownership effective end date, transfer reason (new franchise award, resale, corporate acquisition, closure), and operating entity legal name. Provides the authoritative ownership timeline for royalty calculation, P&L attribution, and franchise compliance reporting. Complements the franchise domain without duplicating franchise partner master data.' .

ind:PerformancePeriod rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Restaurant ;
    rdfs:label 'Performance Period' ;
    rdfs:comment 'Master reference table for performance_period. ' .

ind:PosTerminal rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Restaurant ;
    rdfs:label 'Pos Terminal' ;
    rdfs:comment 'Master reference table for pos_terminal. Referenced by: loyalty.offer_redemption.pos_terminal_id, loyalty.payment_method_link.pos_terminal_id, loyalty.redemption.pos_terminal_id, loyalty.visit.pos_terminal_id, order.drive_thru_event.pos_terminal_id' .

ind:StoreCampaignAssignment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Restaurant ;
    rdfs:label 'Store Campaign Assignment' ;
    rdfs:comment 'Represents the assignment of a marketing campaign to a specific restaurant unit. Each record captures spend, performance, compliance, and other campaign-specific attributes that exist only in the context of that unit-campaign pairing.. Existence Justification: A restaurant unit can participate in multiple marketing campaigns, and each campaign is executed across many units. The business actively tracks per-unit spend, performance metrics, compliance flags, and other campaign-specific details, making the relationship a managed entity rather than a simple reference.' .

ind:KitchenStation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Restaurant ;
    rdfs:label 'Kitchen Station' ;
    rdfs:comment 'Master reference table for kitchen_station. Referenced by station_id.' .

ind:Brand rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Restaurant ;
    rdfs:label 'Brand' ;
    rdfs:comment 'Master reference table for brand. Referenced by brand_id.' .

ind:Department rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Restaurant ;
    rdfs:label 'Department' ;
    rdfs:comment 'Organizational departments within a restaurant unit (kitchen, front-of-house, drive-thru); used for operational management.' .

ind:ChecklistTemplate rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Restaurant ;
    rdfs:label 'Checklist Template' ;
    rdfs:comment 'Master reference table for checklist_template. Referenced by checklist_template_id.' .

ind:Employee rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Workforce ;
    rdfs:label 'Employee' ;
    rdfs:comment 'Master record for every restaurant employee across company-owned and franchised locations. Captures full employee lifecycle data including personal details, employment type (FTE/PTE), BOH/FOH role classification, hire date, termination date, employment status, pay grade, home restaurant assignment, Workday HCM employee ID, declared availability windows (preferred dayparts, max weekly hours, blackout dates, cross-location availability), and current benefit enrollment summary. Single source of truth for workforce identity and worker profile across the enterprise.' .

ind:Position rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Workforce ;
    rdfs:label 'Position' ;
    rdfs:comment 'Defines authorized job positions within the restaurant organization, including role title (e.g., Crew Member, Shift Lead, Kitchen Manager, FOH Supervisor), BOH/FOH classification, pay band, FLSA exemption status, required certifications (e.g., ServSafe), FTE equivalency factor, and whether the position is eligible for overtime. Serves as the job catalog for workforce planning and scheduling.' .

ind:Shift rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Workforce ;
    rdfs:label 'Shift' ;
    rdfs:comment 'Represents a scheduled work shift for an employee at a specific restaurant location, daypart (breakfast, lunch, dinner, late-night), and station assignment (grill, fry, drive-thru, expo, host, bar, dish). Captures planned start/end times, actual clock-in/clock-out times, assigned BOH/FOH station, shift type (regular, overtime, on-call, training), break duration, scheduling source (Planday), and swap/coverage details (original assignee, covering employee, swap request reason, swap approval status, approval timestamp) when shift reassignment occurs. Core operational record for labor deployment, station coverage planning, Speed of Service (SOS) staffing optimization, and Planday shift coverage workflows.' .

ind:Schedule rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Workforce ;
    rdfs:label 'Schedule' ;
    rdfs:comment 'Weekly or period-level labor schedule published for a restaurant location, representing the planned staffing plan across all dayparts. Captures schedule period (start/end dates), restaurant unit, total scheduled hours, scheduled Labor%, FTE count by daypart, publication status (draft/published/locked), and the manager who approved the schedule. Links to individual shifts for granular staffing detail.' .

ind:TimeEntry rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Workforce ;
    rdfs:label 'Time Entry' ;
    rdfs:comment 'Captures actual clock-in and clock-out events for each employee per shift, sourced from Workday HCM time tracking or POS-integrated time clocks. Records regular hours, overtime hours, break time, missed punch flags, and manager approval status. Foundation for payroll processing, Labor% calculation, and compliance with FLSA/OSHA labor regulations.' .

ind:LaborForecast rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Workforce ;
    rdfs:label 'Labor Forecast' ;
    rdfs:comment 'Projected labor demand by restaurant, daypart, and week based on historical transaction volume (ADT/ATC), seasonal patterns, and planned promotions or LTOs. Captures forecasted cover count, expected throughput, recommended FTE count by BOH/FOH, projected Labor%, and the forecasting model version used. Drives Planday schedule generation and labor budget alignment.' .

ind:PayrollRecord rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Workforce ;
    rdfs:label 'Payroll Record' ;
    rdfs:comment 'Period-level payroll summary for each employee, capturing gross pay, net pay, regular hours paid, overtime hours paid, tips declared, deductions (benefits, taxes, garnishments), pay period dates, and payroll run status. Sourced from Workday HCM payroll module. Serves as the authoritative payroll transaction record for finance integration and Labor% reporting.' .

ind:Recruitment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Workforce ;
    rdfs:label 'Recruitment' ;
    rdfs:comment 'Tracks the full recruiting lifecycle for open positions across restaurant locations, including job requisition details, posting channels, candidate information (demographics, source, experience, availability), interview stages, offer status, and time-to-fill metrics. Captures both the requisition workflow and candidate pipeline in a single record per applicant-requisition combination. Sourced from Workday HCM Recruiting module. Supports NRO staffing ramp-up planning, turnover backfill management, diversity hiring tracking, and talent pipeline analytics.' .

ind:Onboarding rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Workforce ;
    rdfs:label 'Onboarding' ;
    rdfs:comment 'Tracks the onboarding process for newly hired employees, including completion status of required tasks (I-9 verification, food handler card submission, uniform issuance, POS system access provisioning, ServSafe enrollment), onboarding start/end dates, assigned onboarding buddy, and manager sign-off. Ensures compliance with FDA food safety and OSHA workplace safety requirements at point of hire.' .

ind:Certification rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Workforce ;
    rdfs:label 'Certification' ;
    rdfs:comment 'Single source of truth for all employee learning credentials, training completions, and regulatory certifications required for foodservice operations. Covers external certifications (ServSafe Food Handler, ServSafe Manager, allergen awareness, HACCP, alcohol service permits, OSHA safety) and internal training completions (new hire orientation, food safety modules, POS/KDS operation, BOH/FOH SOPs, LTO product training, management development). Captures credential type, issuing body (NRA ServSafe, local health department, internal L&D), delivery method (in-person, e-learning, OJT), issue/completion date, expiration date, assessment score, trainer/facilitator, and compliance status. Critical for food safety regulatory compliance, health department inspections, scheduling eligibility validation, and employee development tracking.' .

ind:TrainingCompletion rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Workforce ;
    rdfs:label 'Training Completion' ;
    rdfs:comment 'Records completion of training programs by employees, including new hire orientation, food safety modules, POS operation, KDS usage, BOH/FOH SOPs, LTO product training, and management development programs. Captures training program name, delivery method (in-person, e-learning, OJT), completion date, assessment score, and trainer/facilitator. Supports compliance tracking and performance development.' .

ind:PerformanceReview rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Workforce ;
    rdfs:label 'Performance Review' ;
    rdfs:comment 'Captures all formal employee performance and conduct events including scheduled evaluations (90-day, annual), corrective actions (verbal warnings, written warnings, PIPs, suspensions), and promotion assessments. Records event type, overall rating, competency scores (speed, accuracy, guest service, food safety adherence), infraction details where applicable, reviewer identity, review period, development goals, progressive discipline step, and acknowledgment status. Sourced from Workday HCM Performance module. Serves as the single record of all formal employee assessments for both development and legal compliance.' .

ind:LeaveRequest rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Workforce ;
    rdfs:label 'Leave Request' ;
    rdfs:comment 'Tracks employee requests for time off including vacation, sick leave, FMLA, personal days, and unpaid leave. Captures request type, requested dates, approved dates, leave balance consumed, approval status, approving manager, and return-to-work date. Integrates with Planday scheduling to flag coverage gaps and trigger backfill shift assignments.' .

ind:LaborViolation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Workforce ;
    rdfs:label 'Labor Violation' ;
    rdfs:comment 'Records instances of labor compliance violations detected during operations, including missed meal/rest breaks, overtime threshold breaches, minor labor law violations (under-18 hour restrictions), predictive scheduling violations (where applicable), tip credit violations (failure to meet minimum wage with tips, improper tip pool inclusions), scheduling conflicts with certified food handler requirements, and OSHA-reportable workplace incidents. Captures violation type, severity, regulatory framework violated (FLSA, OSHA, state labor code), restaurant location, employee affected, detection source (automated time system, manager report, employee complaint), remediation deadline, and corrective action taken. Supports OSHA 300 log maintenance, DOL Wage & Hour Division audit responses, and state labor board compliance reporting.' .

ind:LaborBudget rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Workforce ;
    rdfs:label 'Labor Budget' ;
    rdfs:comment 'Period-level labor budget targets by restaurant location, capturing budgeted Labor%, budgeted total labor dollars, budgeted FTE count by BOH/FOH, budgeted hours by daypart, budgeted SPLH (Sales Per Labor Hour), and the fiscal period. Serves as the financial target against which actual labor spend (from payroll_record and time_entry) and forecasted demand (from labor_forecast) are measured. Supports P&L management, AUV optimization, and manager accountability for labor cost control.' .

ind:TipCompliance rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Workforce ;
    rdfs:label 'Tip Compliance' ;
    rdfs:comment 'Tracks tip pooling arrangements, tip credit elections, tip sharing ratios, and employee-level tip declarations required for DOL FLSA §3(m) compliance. Captures tip pool participant roster, contribution percentages, distribution method (hours-based, points-based), tip credit amount claimed per pay period, employee tip declaration forms, and audit trail for tip pool changes. Supports compliance with federal and state tip credit regulations, tip pooling legality verification (front-of-house vs back-of-house eligibility per 2021 DOL final rule), and provides evidence for DOL Wage & Hour Division audits.' .

ind:SchedulingTemplate rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Workforce ;
    rdfs:label 'Scheduling Template' ;
    rdfs:comment 'Master reference table for scheduling_template. Referenced by labor_scheduling_template_id.' .

ind:WorkforceDepartment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Workforce ;
    rdfs:label 'Workforce Department' ;
    rdfs:comment 'Workforce departments for labor scheduling, payroll allocation, and HR organizational structure. [SSOT: canonical source is restaurant.department]' .

ind:PayrollRun rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Workforce ;
    rdfs:label 'Payroll Run' ;
    rdfs:comment 'Master reference table for payroll_run. Referenced by payroll_run_id.' .

ind:PayrollGroup rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Workforce ;
    rdfs:label 'Payroll Group' ;
    rdfs:comment 'Master reference table for payroll_group. Referenced by payroll_group_id.' .

ind:Franchisee rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Franchise ;
    rdfs:label 'Franchisee' ;
    rdfs:comment 'A franchisee entity representing an individual or organization that operates one or more franchise restaurant units under a franchise agreement.' .

ind:Agreement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Franchise ;
    rdfs:label 'Agreement' ;
    rdfs:comment 'A franchise agreement governing the relationship between franchisor and franchisee including terms, fees, and obligations.' .

ind:Territory rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Franchise ;
    rdfs:label 'Territory' ;
    rdfs:comment 'A geographic territory assigned to a franchisee defining the exclusive or protected area for franchise operations.' .

ind:Billing rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Franchise ;
    rdfs:label 'Billing' ;
    rdfs:comment 'Franchise billing records representing invoices sent to franchisees for royalties, marketing fees, and technology fees.' .

ind:SalesReport rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Franchise ;
    rdfs:label 'Sales Report' ;
    rdfs:comment 'Periodic sales reports submitted by franchisees to the franchisor for royalty calculation and performance tracking.' .

ind:NroPipeline rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Franchise ;
    rdfs:label 'Nro Pipeline' ;
    rdfs:comment 'New Restaurant Opening pipeline tracking projects from site selection through grand opening.' .

ind:DevelopmentSchedule rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Franchise ;
    rdfs:label 'Development Schedule' ;
    rdfs:comment 'Development schedule defining the committed timeline for opening new franchise units within a territory.' .

ind:ComplianceAudit rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Franchise ;
    rdfs:label 'Compliance Audit' ;
    rdfs:comment 'Compliance audits conducted on franchise locations to assess adherence to brand standards, food safety, and operational requirements.' .

ind:FranchiseCorrectiveAction rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Franchise ;
    rdfs:label 'Franchise Corrective Action' ;
    rdfs:comment 'Corrective actions issued to franchisees as a result of compliance audits, requiring remediation of identified issues.' .

ind:FeeSchedule rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Franchise ;
    rdfs:label 'Fee Schedule' ;
    rdfs:comment 'Fee schedules defining the various fees (royalty, marketing, technology) applicable to franchise agreements.' .

ind:TrainingEnrollment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Franchise ;
    rdfs:label 'Training Enrollment' ;
    rdfs:comment 'Training enrollments for franchise employees tracking required training programs, completion, and certification.' .

ind:FranchiseRemodelProject rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Franchise ;
    rdfs:label 'Franchise Remodel Project' ;
    rdfs:comment 'Remodel projects for franchise restaurant units tracking scope, budget, timeline, and completion status.' .

ind:TransferEvent rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Franchise ;
    rdfs:label 'Transfer Event' ;
    rdfs:comment 'Transfer events recording the transfer of franchise ownership from one franchisee to another.' .

ind:RenewalEvent rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Franchise ;
    rdfs:label 'Renewal Event' ;
    rdfs:comment 'Renewal events tracking the renewal of franchise agreements including terms, fees, and compliance review.' .

ind:TerminationEvent rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Franchise ;
    rdfs:label 'Termination Event' ;
    rdfs:comment 'Termination events recording the termination of franchise agreements including reason, notice, and financial obligations.' .

ind:PerformanceScorecard rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Franchise ;
    rdfs:label 'Performance Scorecard' ;
    rdfs:comment 'Performance scorecards evaluating franchisee performance across multiple dimensions including sales, compliance, and customer satisfaction.' .

ind:FddDisclosure rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Franchise ;
    rdfs:label 'Fdd Disclosure' ;
    rdfs:comment 'Franchise Disclosure Document (FDD) records tracking the delivery and acknowledgment of disclosure documents to prospects.' .

ind:Prospect rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Franchise ;
    rdfs:label 'Prospect' ;
    rdfs:comment 'Franchise prospects representing potential franchisees in the sales pipeline from initial inquiry through approval.' .

ind:AreaRepresentative rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Franchise ;
    rdfs:label 'Area Representative' ;
    rdfs:comment 'Area representatives who manage and support franchisees within assigned territories on behalf of the franchisor.' .

ind:SupportVisit rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Franchise ;
    rdfs:label 'Support Visit' ;
    rdfs:comment 'Support visits conducted by franchise consultants to franchisee locations for operational support, training, and compliance review.' .

ind:MarketingFundContribution rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Franchise ;
    rdfs:label 'Marketing Fund Contribution' ;
    rdfs:comment 'Marketing fund contributions collected from franchisees based on gross sales for cooperative advertising and brand marketing.' .

ind:LeaseAgreement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Franchise ;
    rdfs:label 'Lease Agreement' ;
    rdfs:comment 'Lease agreements for franchise restaurant locations linking franchisees to their real estate leases.' .

ind:HaccpPlan rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Foodsafety ;
    rdfs:label 'Haccp Plan' ;
    rdfs:comment 'HACCP (Hazard Analysis Critical Control Points) plan documents for food safety management' .

ind:CriticalControlPoint rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Foodsafety ;
    rdfs:label 'Critical Control Point' ;
    rdfs:comment 'Critical control points within HACCP plans where hazards can be prevented or eliminated' .

ind:FoodSafetyAudit rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Foodsafety ;
    rdfs:label 'Food Safety Audit' ;
    rdfs:comment 'Food safety audits conducted at restaurant units or supplier facilities' .

ind:AuditFinding rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Foodsafety ;
    rdfs:label 'Audit Finding' ;
    rdfs:comment 'Individual findings from food safety audits' .

ind:HealthInspection rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Foodsafety ;
    rdfs:label 'Health Inspection' ;
    rdfs:comment 'Health department inspections of restaurant units' .

ind:InspectionViolation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Foodsafety ;
    rdfs:label 'Inspection Violation' ;
    rdfs:comment 'Individual violations found during health inspections' .

ind:FoodsafetyCorrectiveAction rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Foodsafety ;
    rdfs:label 'Foodsafety Corrective Action' ;
    rdfs:comment 'Corrective actions taken in response to food safety findings, deviations, or non-conformances' .

ind:TemperatureLog rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Foodsafety ;
    rdfs:label 'Temperature Log' ;
    rdfs:comment 'Temperature readings for food safety monitoring of equipment and storage areas' .

ind:SanitationSchedule rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Foodsafety ;
    rdfs:label 'Sanitation Schedule' ;
    rdfs:comment 'Sanitation schedules defining cleaning tasks, frequencies, and responsibilities' .

ind:SanitationTaskLog rdf:type rdfs:Class ;
