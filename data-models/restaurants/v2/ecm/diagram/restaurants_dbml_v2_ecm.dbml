  notes varchar [note: 'Free-text notes']
  paid_date date [note: 'Date payment was made']
  payment_status varchar [note: 'Payment status (unpaid, partial, paid)']
  payment_terms varchar [note: 'Payment terms on invoice']
  tax_amount decimal(12,2) [note: 'Tax portion of invoice']
  total_amount decimal(18,2) [note: 'Gross invoice amount']
  updated_timestamp timestamp [note: 'Record last update timestamp']

  Note: 'Supplier invoices received for goods and services, linked to POs and goods receipts for three-way matching.'
}

Table supply.supplier_contract {
  supplier_contract_id varchar [pk, note: 'Primary key']
  contract_id varchar [note: 'FK to procurement contract for SSOT linkage']
  contract_owner_employee_id varchar [note: 'FK to contract owner']
  cost_center_id varchar [note: 'FK to cost center']
  procurement_supplier_id varchar [note: 'FK to supplier']
  compliance_status varchar [note: 'Compliance review status']
  confidentiality_clause boolean [note: 'Whether NDA/confidentiality clause exists']
  contract_description varchar [note: 'Description of contract scope']
  contract_document_url varchar [note: 'URL to contract document']
  contract_type varchar [note: 'Type of contract (blanket, spot, framework)']
  created_timestamp timestamp [note: 'Record creation timestamp']
  currency_code varchar [note: 'Currency ISO code']
  data_protection_clause boolean [note: 'Whether data protection clause exists']
  default_price decimal(18,2) [note: 'Default unit price in contract']
  delivery_terms varchar [note: 'Delivery/shipping terms']
  effective_from date [note: 'Contract effective start date']
  effective_until date [note: 'Contract effective end date']
  exclusivity_flag boolean [note: 'Whether contract grants exclusivity']
  exclusivity_region varchar [note: 'Region of exclusivity if applicable']
  executed_date date [note: 'Date contract was executed']
  governing_law varchar [note: 'Governing law jurisdiction']
  liability_limit decimal(12,2) [note: 'Maximum liability amount']
  payment_terms varchar [note: 'Payment terms']
  rebate_percentage decimal(5,2) [note: 'Volume rebate percentage']
  rebate_threshold_amount decimal(18,2) [note: 'Spend threshold to trigger rebate']
  renewal_notice_period_days varchar [note: 'Days notice required for renewal']
  renewal_type varchar [note: 'Renewal type (auto, manual, none)']
  shipping_method varchar [note: 'Default shipping method']
  signed_date date [note: 'Date contract was signed']
  supplier_contract_status varchar [note: 'Status (draft, active, expired, terminated)']
  termination_notice_period_days varchar [note: 'Days notice required for termination']
  updated_timestamp timestamp [note: 'Record last update timestamp']
  volume_tier_1_min varchar [note: 'Minimum quantity for tier 1 pricing']
  volume_tier_1_price decimal(18,2) [note: 'Price at tier 1 volume']
  volume_tier_2_min varchar [note: 'Minimum quantity for tier 2 pricing']
  volume_tier_2_price decimal(18,2) [note: 'Price at tier 2 volume']

  Note: 'Detailed contract records with suppliers including pricing, terms, compliance, and renewal information.'
}

Table supply.contract_price {
  contract_price_id varchar [pk, note: 'Primary key']
  contract_id varchar [note: 'FK to procurement contract']
  procurement_supplier_id varchar [note: 'FK to supplier']
  stock_item_id varchar [note: 'FK to stock item']
