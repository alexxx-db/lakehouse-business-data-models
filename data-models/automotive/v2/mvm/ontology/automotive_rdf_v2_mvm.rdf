    rdfs:range xsd:decimal .

ind:cycleCountStatus rdf:type rdf:Property ;
    rdfs:label 'Cycle Count Status' ;
    rdfs:comment 'Current status of the scheduled cycle count for the location.' ;
    rdfs:domain ind:ServicePartsStock ;
