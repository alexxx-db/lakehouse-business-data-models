    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DrugMaster .

ind:compoundingBaseSolutionDrugMasterId rdf:type rdf:Property ;
    rdfs:label 'Compounding Base Solution Drug Master Id' ;
    rdfs:comment 'Foreign key linking to pharmacy.drug_master. Business justification: Compounded medications use a base solution from the drug master. The FK is labeled \'base_solution_drug_master_id\' to distinguish from potential other drug references in compounding. Cardinality N:1 (m' ;
    rdfs:domain ind:CompoundingRecord ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DrugMaster .

ind:compoundingDrugMasterId rdf:type rdf:Property ;
    rdfs:label 'Compounding Drug Master Id' ;
    rdfs:domain ind:CompoundingRecord ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DrugMaster .

ind:compoundingPharmacistClinicianId rdf:type rdf:Property ;
    rdfs:label 'Compounding Pharmacist Clinician Id' ;
    rdfs:comment 'Foreign key linking to provider.clinician. Business justification: Compounding pharmacist is a licensed clinician. USP 797/800 compliance requires identification of licensed pharmacist who prepared compounded medication for quality assurance, regulatory inspection, a' ;
    rdfs:domain ind:CompoundingRecord ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:compoundingPharmacistEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Compounding Pharmacist Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: Compounding pharmacist must be traceable to credentialed employee for USP 797/800 compliance, competency assessment, and quality assurance. State boards require employee-level tracking for sterile com' ;
    rdfs:domain ind:CompoundingRecord ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:supplyMaterialMasterId rdf:type rdf:Property ;
    rdfs:label 'Supply Material Master Id' ;
    rdfs:comment 'Foreign key linking to supply.material_master. Business justification: Sterile and hazardous compounding uses medical supplies (syringes, filters, IV bags, tubing, needles) as essential components. USP 797/800 compliance requires tracking all materials used in compoundin' ;
    rdfs:domain ind:CompoundingRecord ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MaterialMaster .

ind:baseSolutionNdc rdf:type rdf:Property ;
    rdfs:label 'Base Solution Ndc' ;
    rdfs:comment 'The NDC of the base solution used in IV admixture compounding (e.g., normal saline, dextrose).' ;
    rdfs:domain ind:CompoundingRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:baseSolutionVolumeMl rdf:type rdf:Property ;
    rdfs:label 'Base Solution Volume Ml' ;
    rdfs:comment 'The volume of the base solution used in the IV admixture, measured in milliliters.' ;
