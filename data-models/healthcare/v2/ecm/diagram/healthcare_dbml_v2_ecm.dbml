  instrument_assessed_by_employee_id varchar
  instrument_assessor_employee_id varchar
  instrument_corrective_action_plan_id varchar [note: 'Corrective action plan addressing findings']
  instrument_id varchar
  monitoring_activity_id varchar
  policy_version_id varchar [note: 'Added to expand thin product compliance.instrument_policy_compliance']
  reviewer_employee_id varchar [note: 'Added to expand thin product workforce.instrument_policy_compliance']
  assessed_by varchar
