// DBML Schema for Business: Media_Broadcasting
// Version: 3
// Generated on: 2026-07-10 21:13:58

Project {
  database_type: 'Databricks Unity Catalog'
  Note: 'Lakehouse data model for Media_Broadcasting - Version 3'
}

Table content.title {
  title_id varchar [pk, note: 'Unique identifier for the content title. Primary key for the title master catalog. Serves as the universal join point referenced by scheduling, distribution, rights, digital asset, and advertising domains.']
  content_rating_id varchar [note: 'Foreign key linking to content.rating. Business justification: title is the master catalog record for all content assets, yet it stores content_rating as a denormalized STRING while every other major content entity (series, season, content_episode, version, windo']
  genre_id varchar [note: 'FK to content.genre']
  primary_rights_holder_id varchar [note: 'Foreign key linking to rights.rights_holder. Business justification: Tracks who owns/controls rights to each title - essential for royalty payments, clearance workflows, and determining who must approve licensing deals. Rights holder is the starting point for all right']
  series_id varchar [note: 'Foreign key reference to the parent series for episodic content. Null for standalone films, clips, and non-episodic content.']
  territory_id varchar [note: 'Foreign key linking to rights.territory. Business justification: Titles have primary production/distribution territories that affect rights clearance, regulatory compliance (content ratings), and default licensing assumptions. Clearance workflows validate against t']
  acquisition_date date [note: 'Date when the content rights were acquired by the organization. Used for rights lifecycle tracking, amortization calculations, and contract management.']
  archive_date date [note: 'Date when the content was moved to archived status. Used for content lifecycle management and digital asset retention policies.']
  aspect_ratio varchar [note: 'Display aspect ratio of the content. Determines presentation format for broadcast, streaming, and theatrical distribution.']
  audio_description_available_flag boolean [note: 'Indicates whether audio description track is available for visually impaired audiences. Required for accessibility compliance and inclusive broadcasting.']
  closed_caption_available_flag boolean [note: 'Indicates whether closed captioning is available for the content. Required for FCC compliance and accessibility standards.']
  color_format varchar [note: 'Indicates whether the content is in color, black and white, or has been colorized. Used for archival classification and presentation metadata.']
  content_status varchar [note: 'Current lifecycle status of the content asset. Determines availability for scheduling, distribution, and monetization. Active content is available for use; archived content is retained but not actively distributed; restricted content has legal or rights limitations.']
  content_type varchar [note: 'Discriminator classifying the fundamental type of content asset. Determines applicable business rules for scheduling, rights windowing, and distribution strategies. [ENUM-REF-CANDIDATE: film|series|episode|clip|music|news|live_event|documentary — 8 candidates stripped; promote to reference product]']
  coppa_child_directed_flag boolean [note: 'Indicates whether the content is directed to children under 13 years of age. Triggers COPPA compliance requirements for data collection, advertising restrictions, and privacy protections.']
  country_of_origin varchar [note: 'ISO 3166-1 alpha-3 code representing the country where the content was originally produced. Used for rights management, regulatory compliance, and content origin reporting.']
  created_timestamp timestamp [note: 'Timestamp when the title record was first created in the system. Used for audit trails, data lineage tracking, and operational reporting.']
  eidr_code varchar [note: 'Universal unique identifier for audiovisual content assigned by the Entertainment Identifier Registry. Used for global content identification and rights management across the media supply chain.']
  episode_number varchar [note: 'Episode number within the season for episodic content. Null for non-episodic content. Used for sequential ordering in playout and Electronic Program Guide (EPG) systems.']
  hd_available_flag boolean [note: 'Indicates whether a high-definition version of the content is available. Used for channel playout decisions and quality-tier distribution strategies.']
  isan varchar [note: 'International standard identifier for audiovisual works. Primarily used for films and television programs for rights management and distribution tracking.']
  isrc varchar [note: 'International standard code for uniquely identifying sound recordings and music video recordings. Used for music tracks and audio content royalty tracking.']
  keywords varchar [note: 'Comma-separated list of keywords and tags describing content themes, subjects, and topics. Used for search optimization, content discovery, and recommendation algorithms.']
  name varchar [note: 'Primary display name of the content title. The human-readable identifier used across all systems and customer-facing platforms.']
  original_language varchar [note: 'ISO 639-2 three-letter code representing the original language of the content production. Used for localization planning, dubbing, and subtitle workflows.']
  original_title varchar [note: 'Original title name in the native language of production. Preserved for rights management, archival, and international distribution purposes.']
  parental_advisory_flag boolean [note: 'Indicates whether the content carries a parental advisory warning for explicit content, violence, or mature themes. Used for compliance with broadcast standards and platform content policies.']
  premiere_flag boolean [note: 'Indicates whether the content is a premiere or first-run broadcast. Used for promotional scheduling, advertising premium pricing, and audience measurement reporting.']
  production_year varchar [note: 'Calendar year in which the content was originally produced or completed. Used for catalog organization, rights windowing calculations, and archival classification.']
  release_date date [note: 'Date when the content was first released to the public or premiered. Used for rights availability calculations, windowing strategies, and anniversary programming.']
  rights_status varchar [note: 'Current rights availability status indicating whether the content can be legally broadcast or distributed. Drives scheduling decisions and geographic blackout enforcement.']
  runtime_seconds varchar [note: 'Total duration of the content in seconds. Used for program scheduling, ad pod allocation, playout automation, and Electronic Program Guide (EPG) generation.']
  season_number varchar [note: 'Season number within the parent series for episodic content. Null for non-episodic content. Used for catalog organization and Electronic Program Guide (EPG) display.']
  studio_name varchar [note: 'Name of the studio or production company that produced the content. Used for rights attribution, royalty calculations, and catalog organization.']
  sub_genre varchar [note: 'Secondary or more granular genre classification providing additional content categorization for advanced audience segmentation and personalization.']
  synopsis_long varchar [note: 'Detailed narrative description of the content. Used for promotional materials, streaming platform detail pages, and comprehensive program guides.']
  synopsis_short varchar [note: 'Brief summary of the content, typically 50-100 characters. Used for Electronic Program Guide (EPG) listings, mobile applications, and quick reference displays.']
  theatrical_release_flag boolean [note: 'Indicates whether the content had a theatrical release. Used for windowing strategy, rights holdback periods, and marketing classification.']
  uhd_4k_available_flag boolean [note: 'Indicates whether an Ultra HD 4K version of the content is available. Used for premium streaming tiers and next-generation broadcast services.']
  updated_timestamp timestamp [note: 'Timestamp when the title record was last modified. Used for change tracking, data synchronization, and audit compliance.']

  Note: 'Master catalog record for every content asset across the enterprise — films, series, episodes, clips, music tracks, news segments, and live events. Serves as the authoritative SSOT for content identity, carrying EIDR, ISAN, and ISRC identifiers, MPA content rating, genre classification, original language, country of origin, production year, content type discriminator (film/series/episode/clip/music/news/live), runtime in seconds, content status (active/archived/restricted), parental advisory flags, COPPA child-directed flag, and lifecycle timestamps. Acts as the universal join point referenced by scheduling, distribution, rights, digital asset, and advertising domains. Format-level technical specifications are managed by the version and digital asset domains.'
}

Table content.series {
  series_id varchar [pk, note: 'Unique identifier for the series. Primary key for the series master record.']
  content_rating_id varchar [note: 'Foreign key linking to content.rating. Business justification: Series have content ratings. Normalizes content_rating string column to reference the enterprise rating taxonomy.']
  genre_id varchar [note: 'Foreign key linking to content.genre. Business justification: Series have genre classification. Normalizes genre_primary/genre_secondary string columns to reference the enterprise genre taxonomy.']
  primary_rights_holder_id varchar [note: 'Foreign key linking to rights.rights_holder. Business justification: Series-level rights ownership (studio/production company) drives all downstream licensing and royalty flows. Franchise management and multi-season deal negotiations require knowing the primary rights ']
  territory_id varchar [note: 'Foreign key linking to rights.territory. Business justification: Series production is facility-based; long-running shows are tied to specific studio facilities for multi-year scheduling, crew allocation, facility cost allocation, and production continuity. Essentia']
  archive_location varchar [note: 'Physical or logical location identifier where the series master content and metadata are archived. Used for Digital Asset Management (DAM) and Media Asset Management (MAM) retrieval.']
  aspect_ratio varchar [note: 'Standard aspect ratio for the series video format. Critical for playout configuration, transcoding workflows, and multi-platform distribution.']
  audio_description_available boolean [note: 'Indicates whether audio description track is available for visually impaired viewers. Required for accessibility compliance in many jurisdictions.']
  audio_format varchar [note: 'Standard audio format and channel configuration for the series. Determines audio encoding requirements for distribution and playout.']
  closed_caption_available boolean [note: 'Indicates whether closed captioning is available for the series. Required for regulatory compliance under FCC accessibility rules and international broadcasting standards.']
  country_of_origin varchar [note: 'ISO 3166-1 alpha-3 country code for the country where the series was originally produced. Used for content quotas, regulatory compliance, and international rights management.']
  created_timestamp timestamp [note: 'Timestamp when the series record was first created in the system. Used for audit trail and data lineage tracking.']
  distributor varchar [note: 'Name of the distribution company responsible for licensing and distributing the series to secondary markets and platforms.']
  eidr_code varchar [note: 'Universal unique identifier for the series registered with EIDR. Enables global content identification and rights management across the entertainment industry supply chain.']
  episode_runtime_minutes varchar [note: 'Standard runtime duration in minutes for a typical episode of the series, excluding commercials. Used for scheduling, ad pod planning, and playout automation.']
  finale_date date [note: 'Date when the final episode of the series aired or was released. Null for ongoing series. Used for syndication eligibility and rights holdback period calculations.']
  franchise_name varchar [note: 'Brand name of the content franchise or show brand. Used for grouping related series, spin-offs, and reboots under a common brand umbrella.']
  hdr_format varchar [note: 'High Dynamic Range format specification for the series. Impacts content delivery network configuration and device compatibility.']
  isan_code varchar [note: 'International standard audiovisual number for the series. Used for audiovisual work identification in rights management and distribution.']
  keywords varchar [note: 'Comma-separated list of searchable keywords and tags for content discovery, Electronic Program Guide (EPG) search, and recommendation engine optimization.']
  language_original varchar [note: 'ISO 639-3 three-letter code for the original production language of the series. Used for localization planning and international distribution.']
  modified_timestamp timestamp [note: 'Timestamp when the series record was last modified. Used for change tracking, audit compliance, and data synchronization across systems.']
  original_network varchar [note: 'Name of the original broadcast network or streaming platform that first aired or released the series. Critical for rights management and syndication deals.']
  premiere_date date [note: 'Date when the first episode of the series originally aired or was released. Marks the beginning of the series lifecycle and is used for rights windowing calculations.']
  production_company varchar [note: 'Name of the primary production company or studio that produced the series. Critical for rights ownership, residuals calculations, and syndication negotiations.']
  resolution_standard varchar [note: 'Standard video resolution for the series master content. Determines transcoding requirements and Adaptive Bitrate (ABR) streaming profile generation.']
  series_status varchar [note: 'Current lifecycle status of the series. Indicates whether the series is actively producing new content, has concluded, or is temporarily paused.']
  series_type varchar [note: 'Classification of the series format and production style. Determines scheduling strategy, audience targeting, and production workflow. [ENUM-REF-CANDIDATE: scripted|unscripted|documentary|news|sports|reality|talk_show|game_show|variety|animated|miniseries|anthology — 12 candidates stripped; promote to reference product]']
  syndication_eligible boolean [note: 'Indicates whether the series meets the minimum episode threshold and rights clearance requirements for syndication to secondary markets and broadcast stations.']
  synopsis_long varchar [note: 'Detailed multi-paragraph description of the series premise, themes, and narrative arc. Used for marketing materials, press releases, and content catalogs.']
  synopsis_short varchar [note: 'Brief one-sentence description of the series premise. Used for Electronic Program Guide (EPG) listings, mobile applications, and social media promotion.']
  target_demographic varchar [note: 'Primary audience demographic segment the series is designed to reach. Used for advertising sales, scheduling strategy, and Target Rating Point (TRP) calculations. [ENUM-REF-CANDIDATE: adults_18_49|adults_25_54|adults_18_34|children_2_11|teens_12_17|women_18_49|men_18_49|total_viewers — promote to reference product]']
  title varchar [note: 'Official title of the series as registered and marketed. Primary human-readable identifier for the content franchise.']
  title_original varchar [note: 'Original title of the series in its native language and market before localization or translation.']
  total_episode_count varchar [note: 'Cumulative count of all episodes produced across all seasons. Includes specials and pilot episodes.']
  total_season_count varchar [note: 'Total number of seasons produced for the series to date. Updated as new seasons are commissioned and produced.']

  Note: 'Master record for a serialized content franchise or show brand — the parent container above seasons and episodes. Captures series title, franchise identifier, series type (scripted/unscripted/documentary/news/sports/reality), total season count, original network/platform, premiere date, finale date, series status (ongoing/ended/cancelled/hiatus), genre taxonomy, target demographic, content rating band, and brand metadata. Enables hierarchical content navigation from series → season → episode and supports scheduling, rights windowing, and syndication deal structures.'
}

Table content.season {
  season_id varchar [pk, note: 'Unique identifier for the season record. Primary key.']
  billing_account_id varchar [note: 'Foreign key linking to billing.billing_account. Business justification: Seasons are independently licensed and billed (e.g., a broadcaster licenses Season 2 separately from Season 1). Season-level billing account assignment enables season-specific revenue attribution, AP ']
  content_rating_id varchar [note: 'Foreign key linking to content.rating. Business justification: Seasons have content ratings. Normalizes content_rating string column to reference the enterprise rating taxonomy.']
  genre_id varchar [note: 'Foreign key linking to content.genre. Business justification: Seasons have genre classification. Normalizes genre_primary/genre_secondary string columns to reference the enterprise genre taxonomy.']
  project_id varchar [note: 'Foreign key linking to production.project. Business justification: Seasons often have dedicated budgets separate from series-level allocations. Network finance teams approve and monitor season budgets independently for greenlight decisions, mid-season adjustments, an']
  rights_holder_id varchar [note: 'Foreign key linking to rights.holder. Business justification: Season-level rights holder identification is required for royalty calculation and residuals management. rights_holder is a plain-text denormalization; a proper FK to holder enables royalty statement g']
  series_id varchar [note: 'Reference to the parent series to which this season belongs.']
  territory_id varchar [note: 'Foreign key linking to rights.rights_territory. Business justification: Season-level rights are territory-specific in broadcasting; rights clearance, holdback enforcement, and distribution planning all require knowing which rights_territory governs a season. rights_territ']
  archive_date date [note: 'Date when the season was moved to archival storage. Used for asset lifecycle management and retrieval planning.']
  archive_location varchar [note: 'Physical or digital archive location where the season\'s master assets are stored. Critical for long-term preservation and retrieval.']
  awards_nominated varchar [note: 'Comma-separated list of major award nominations received by the season. Supports promotional messaging and content valuation.']
  awards_won varchar [note: 'Comma-separated list of major awards won by the season (e.g., Emmy, Golden Globe). Used for marketing and promotional value enhancement.']
  banner_artwork_url varchar [note: 'URL reference to the season\'s banner or hero image for wide-format displays on streaming platforms and websites.']
  created_timestamp timestamp [note: 'Timestamp when the season record was first created in the system. Used for audit trail and data lineage.']
  distributor varchar [note: 'Name of the primary distributor handling the season\'s commercial distribution. Key for carriage agreements and revenue sharing.']
  eidr varchar [note: 'Globally unique EIDR identifier for the season, enabling cross-platform content identification and rights management.']
  episode_count_aired varchar [note: 'Number of episodes that have been broadcast or released to audiences. Used for tracking release progress.']
  episode_count_ordered varchar [note: 'Number of episodes originally ordered or commissioned for this season by the network or platform.']
  episode_count_produced varchar [note: 'Actual number of episodes produced and delivered for this season. May differ from ordered count due to production changes.']
  finale_date date [note: 'Date when the final episode of the season was broadcast or released. Marks the end of the season\'s linear run.']
  isan varchar [note: 'International standard identifier for audiovisual works, used for season-level identification in global distribution and rights management.']
  language_original varchar [note: 'ISO 639-3 three-letter code for the original production language of the season. Critical for localization and distribution planning.']
  modified_timestamp timestamp [note: 'Timestamp when the season record was last modified. Supports change tracking and audit compliance.']
  network_original varchar [note: 'Name of the network or platform that originally commissioned or first aired the season. Used for windowing and exclusivity tracking.']
  original_air_date date [note: 'Date when the first episode of the season was originally broadcast or released. Key for windowing and rights calculations.']
  poster_artwork_url varchar [note: 'URL reference to the season\'s primary poster artwork stored in the Media Asset Management (MAM) system. Used for EPG, VOD, and promotional displays.']
  production_company varchar [note: 'Name of the primary production company responsible for creating the season. Used for rights attribution and royalty calculations.']
  production_year varchar [note: 'Calendar year in which the season was produced. Used for cataloging, rights management, and archival purposes.']
  rights_expiry_date date [note: 'Date when current distribution rights for the season expire. Triggers rights renewal workflows and availability restrictions.']
  season_number varchar [note: 'Sequential number of the season within the series (e.g., 1 for Season 1, 2 for Season 2). Used for ordering and identification.']
  season_status varchar [note: 'Current lifecycle status of the season. Tracks progression from development through archival or cancellation. [ENUM-REF-CANDIDATE: in-development|in-production|post-production|completed|airing|aired|archived|cancelled — 8 candidates stripped; promote to reference product]']
  synopsis_long varchar [note: 'Detailed season-level synopsis providing comprehensive narrative overview. Used for promotional materials, VOD platforms, and press releases.']
  synopsis_short varchar [note: 'Brief season-level synopsis (typically 50-150 characters) used for Electronic Program Guide (EPG) listings and mobile displays.']
  title varchar [note: 'Official title or name of the season. May include thematic or marketing names (e.g., \'The Final Season\', \'Season of Secrets\').']
  total_runtime_minutes varchar [note: 'Cumulative runtime of all episodes in the season, measured in minutes. Used for scheduling blocks and VOD packaging.']

  Note: 'Master record representing a discrete production cycle of a series, grouping episodes into an ordered season. Tracks season number, season title, episode count (ordered and total), production year, original air year, season status (in-production/completed/archived), season-level content rating, season-level synopsis, and promotional artwork references. Bridges the series-to-episode hierarchy and supports season-level rights licensing, scheduling blocks, and VOD packaging.'
}

Table content.content_episode {
  content_episode_id varchar [pk, note: 'Unique identifier for the episode within the content management system. Primary key for the content episode entity.']
  campaign_id varchar [note: 'Foreign key linking to sales.campaign. Business justification: Episode-specific promotional campaigns (weekly tune-in ads, event episodes). Business process: weekly marketing planning, special episode promotion (finales, crossovers), episode-level campaign perfor; FK references sales domain entity; namespace reconciled from advertising context']
  content_rating_id varchar [note: 'Foreign key linking to content.rating. Business justification: Episodes have content ratings (TV-PG, TV-MA). Normalizes content_rating string column to reference the enterprise rating taxonomy.']
  content_season_id varchar [note: 'Reference to the specific season within the series to which this episode belongs. Enables season-level grouping and rights management.']
  content_series_id varchar [note: 'Reference to the parent series to which this episode belongs. Links episode to its series container.']
  genre_id varchar [note: 'Foreign key linking to content.genre. Business justification: Episodes have genre classification. Normalizes genre_primary/genre_secondary string columns to reference the enterprise genre taxonomy.']
  project_id varchar [note: 'Foreign key linking to production.project. Business justification: High-cost episodes (pilots, finales, VFX-heavy episodes) often have dedicated budget line items. Production accountants track episodic costs for above-the-line talent overages, location expenses, and ']
  title_id varchar [note: 'Foreign key linking to content.title. Business justification: Episodes ARE titles in the master catalog. Every episode should reference its title record for unified content identification and metadata management.']
  archive_date date [note: 'Date when the episode master was moved to long-term archive storage. Used for asset lifecycle management and storage optimization.']
  archive_location varchar [note: 'Physical or logical location identifier for the archived master copy in the Media Asset Management (MAM) system. Supports long-term preservation and retrieval.']
  aspect_ratio varchar [note: 'Display aspect ratio of the episode video. Affects playout configuration, transcoding profiles, and distribution format specifications.']
  audio_description_available boolean [note: 'Indicates whether audio description track is available for visually impaired viewers. Required for accessibility compliance.']
  audio_format varchar [note: 'Audio channel configuration and encoding format. Affects playout system configuration and premium content positioning.']
  broadcast_count varchar [note: 'Total number of times this episode has been broadcast on linear television. Used for residuals calculation and syndication rights management.']
  closed_caption_available boolean [note: 'Indicates whether closed captioning is available for this episode. Required for FCC compliance and accessibility standards.']
  content_advisory varchar [note: 'Specific content warnings or advisories for viewer guidance (e.g., violence, language, adult themes). Displayed in Electronic Program Guide (EPG) and Video On Demand (VOD) interfaces.']
  created_timestamp timestamp [note: 'Timestamp when the episode record was first created in the content management system. Used for audit trail and data lineage tracking.']
  eidr_identifier varchar [note: 'Globally unique identifier for the episode registered with the Entertainment Identifier Registry. Enables universal content identification across distribution platforms and rights management systems.']
  episode_number varchar [note: 'Sequential number of the episode within its season. Used for ordering and identification in Electronic Program Guide (EPG) and Video On Demand (VOD) catalogs.']
  episode_status varchar [note: 'Current lifecycle state of the episode. Determines availability for scheduling, playout automation, and distribution to Over-The-Top (OTT) platforms.']
  episode_type varchar [note: 'Classification of the episode format and purpose within the series. Affects scheduling strategy, promotional treatment, and rights valuation. [ENUM-REF-CANDIDATE: standard|special|pilot|finale|recap|bonus|behind_the_scenes — 7 candidates stripped; promote to reference product]']
  keywords varchar [note: 'Comma-separated list of keywords and tags describing episode themes, topics, and notable elements. Supports content search, discovery, and metadata enrichment.']
  modified_timestamp timestamp [note: 'Timestamp when the episode record was last modified. Supports change tracking and data quality monitoring.']
  music_cue_sheet_submitted boolean [note: 'Indicates whether the music cue sheet has been submitted for royalty collection. Required for music rights compliance and royalty distribution.']
  original_air_date date [note: 'The date when the episode was first broadcast on linear television. Critical for rights windowing, residuals calculation, and syndication eligibility.']
  premiere_flag boolean [note: 'Indicates whether this is a premiere episode (first broadcast). Used for promotional planning, upfront advertising sales, and Nielsen sweeps period strategy.']
  primary_language varchar [note: 'ISO 639-3 three-letter code for the primary audio language of the episode. Used for content cataloging, rights clearance, and distribution targeting.']
  production_code varchar [note: 'Internal production identifier assigned during content creation. Used for tracking production workflow, post-production tasks, and archival reference.']
  rerun_flag boolean [note: 'Indicates whether this broadcast is a rerun. Affects advertising rates, Cost Per Rating Point (CPRP) calculations, and residuals payments to talent.']
  rights_clearance_status varchar [note: 'Current status of rights clearance for broadcast and distribution. Determines whether episode can be scheduled for playout or made available on Over-The-Top (OTT) platforms.']
  runtime_seconds varchar [note: 'Total duration of the episode content in seconds, excluding commercial breaks. Used for playout scheduling, ad pod allocation, and Electronic Program Guide (EPG) display.']
  runtime_with_ads_seconds varchar [note: 'Total broadcast duration including commercial ad breaks. Used for linear scheduling and daypart planning.']
  subtitles_available boolean [note: 'Indicates whether subtitle tracks are available for this episode. Supports international distribution and localization strategies.']
  synopsis_long varchar [note: 'Detailed description of the episode plot, themes, and key moments. Used for Video On Demand (VOD) platforms, promotional materials, and content discovery.']
  synopsis_short varchar [note: 'Brief summary of the episode content, typically 50-100 characters. Used for Electronic Program Guide (EPG) listings and mobile applications with limited display space.']
  title varchar [note: 'The official title or name of the episode. Displayed in Electronic Program Guide (EPG), Video On Demand (VOD) interfaces, and promotional materials.']
  video_resolution varchar [note: 'Maximum video resolution available for this episode. Determines distribution channel eligibility and Adaptive Bitrate Streaming (ABR) profile selection.']
  vod_available_from_date date [note: 'Date when the episode becomes available on Video On Demand (VOD) platforms. Part of windowing strategy and rights holdback management.']
  vod_available_until_date date [note: 'Date when the episode is removed from Video On Demand (VOD) platforms. Enforces rights windows and exclusivity periods.']

  Note: 'Master record for an individual episode within a series season. Captures episode number, episode title, production code, original broadcast date, runtime, episode type (standard/special/pilot/finale/recap), episode synopsis, content rating, EIDR episode identifier, closed-caption availability flag, audio description flag, and episode status. Supports EPG scheduling, VOD availability windows, rights clearance at episode level, and residuals calculation for talent reuse payments.'
}

Table content.version {
  version_id varchar [pk, note: 'Primary key for version']
  channel_id varchar [note: 'Foreign key linking to scheduling.channel. Business justification: Each content version is encoded using specific encoder configurations. QC workflows, bitrate ladder validation, delivery troubleshooting, and platform certification require knowing which encoder profi']
  content_episode_id varchar [note: 'Foreign key linking to content.content_episode. Business justification: A version tracks every distinct cut, dub, or localized edit of a content asset. In media broadcasting, versions are frequently episode-specific — a dubbed Spanish version of Episode 3, a censored broa']
  content_rating_id varchar [note: 'Foreign key linking to content.rating. Business justification: Versions have MPA and TV ratings. Normalizes mpa_rating/tv_rating string columns to reference the enterprise rating taxonomy.']
  delivery_channel_id varchar [note: 'Foreign key linking to distribution.delivery_channel. Business justification: Content versions are encoded and QC\'d to meet specific delivery channel technical requirements (bitrate, codec, resolution). version has channel_id (scheduling.channel) but not delivery_channel. Deliv']
  distribution_partner_id varchar [note: 'Foreign key linking to partner.partner. Business justification: Content versions are created for specific distribution partners (partner-specific encodes, DRM configurations, watermarking). Linking version to partner enables partner-specific QC workflows, delivery']
  ott_platform_id varchar [note: 'Foreign key linking to distribution.ott_platform. Business justification: Content versions are prepared for specific OTT platforms with platform-specific encoding, DRM, and QC requirements. version.target_platform is a plain-text denormalization of ott_platform. Platform-sp']
  title_id varchar [note: 'Reference to the master content asset (title, episode, series, film, clip, music, news segment, or live event) that this version belongs to.']
  approved_timestamp timestamp [note: 'Timestamp when this version was approved for distribution and playout.']
  archived_timestamp timestamp [note: 'Timestamp when this version was moved to long-term archive storage.']
  aspect_ratio varchar [note: 'Display aspect ratio of this version (e.g., \'16:9\', \'4:3\', \'21:9\', \'2.39:1\').']
  audio_codec varchar [note: 'Audio compression codec used for this version (e.g., \'AAC\', \'AC-3\', \'E-AC-3\', \'Dolby Atmos\', \'DTS\').']
  audio_description_available boolean [note: 'Indicates whether audio description track is available for visually impaired audiences, supporting accessibility compliance.']
  audio_track_configuration varchar [note: 'Comma-separated list of audio track languages and types available in this version (e.g., \'en:stereo,es:5.1,fr:stereo,en:descriptive\').']
  broadcast_safe boolean [note: 'Indicates whether this version has been certified as broadcast-safe, meeting technical standards for linear transmission (audio levels, video levels, closed captioning).']
  checksum_md5 varchar [note: 'MD5 hash checksum of the version file, used for integrity verification during transfer and archival.']
  closed_caption_available boolean [note: 'Indicates whether closed captioning (CC) is available for this version, supporting accessibility compliance.']
  color_space varchar [note: 'Color space standard used for this version (Rec. 709, Rec. 2020, DCI-P3, sRGB).']
  content_advisory varchar [note: 'Comma-separated list of content advisory flags for this version (e.g., \'violence\', \'language\', \'sexual_content\', \'drug_use\', \'nudity\').']
  created_timestamp timestamp [note: 'Timestamp when this version record was first created in the system.']
  eidr_code varchar [note: 'Unique EIDR identifier for this specific version, enabling global content identification and rights management.']
  file_format varchar [note: 'Container file format for this version (e.g., \'MP4\', \'MXF\', \'MOV\', \'TS\', \'WebM\').']
  file_size_bytes varchar [note: 'Total file size of this version in bytes, used for storage planning and delivery bandwidth estimation.']
  frame_rate decimal(5,2) [note: 'Frame rate of this version in frames per second (e.g., 23.98, 24.00, 25.00, 29.97, 30.00, 50.00, 59.94, 60.00).']
  hdr_format varchar [note: 'High Dynamic Range format used for this version (SDR, HDR10, HDR10+, Dolby Vision, HLG).']
  isan_code varchar [note: 'International Standard Audiovisual Number uniquely identifying this audiovisual work version.']
  isrc_code varchar [note: 'International Standard Recording Code for music or audio content versions, enabling tracking and royalty distribution.']
  label varchar [note: 'Human-readable label identifying this version (e.g., \'Theatrical Cut\', \'Director\'s Cut\', \'Broadcast Safe\', \'Spanish Dub\', \'UK Censored\').']
  modified_timestamp timestamp [note: 'Timestamp when this version record was last modified.']
  primary_language_code varchar [note: 'ISO 639 two or three-letter code for the primary audio language of this version (e.g., \'en\', \'es\', \'fr\').']
  qc_completed_date date [note: 'Date when quality control review was completed for this version.']
  qc_status varchar [note: 'Quality control review status for this version, indicating whether it has passed technical and content quality checks.']
  resolution varchar [note: 'Video resolution classification for this version (SD, HD 720p, HD 1080p, UHD 4K, UHD 8K).']
  runtime_delta_seconds varchar [note: 'Difference in runtime (in seconds) between this version and the master version. Positive values indicate longer runtime, negative indicate shorter.']
  runtime_seconds varchar [note: 'Total runtime of this version in seconds, representing the complete playback duration.']
  storage_location varchar [note: 'Physical or logical storage location identifier where this version is archived (e.g., tape library ID, cloud bucket path, MAM archive reference).']
  subtitle_languages varchar [note: 'Comma-separated list of ISO 639 language codes for subtitle tracks included in this version (e.g., \'en,es,fr,de\').']
  target_territory varchar [note: 'Three-letter ISO country code indicating the primary geographic territory this version is intended for (e.g., USA, GBR, FRA).']
  version_status varchar [note: 'Current lifecycle status of the version indicating its readiness for distribution and playout. [ENUM-REF-CANDIDATE: draft|in_production|qc_pending|approved|active|archived|deprecated|rejected — 8 candidates stripped; promote to reference product]']
  version_type varchar [note: 'Classification of the version type indicating the nature of the edit or adaptation. [ENUM-REF-CANDIDATE: theatrical|broadcast|director|extended|unrated|censored|dubbed|subtitled|localized|preview|trailer — 11 candidates stripped; promote to reference product]']
  video_codec varchar [note: 'Video compression codec used for this version (e.g., \'H.264\', \'H.265/HEVC\', \'VP9\', \'AV1\', \'MPEG-2\').']

  Note: 'Tracks every distinct version of a title — including edits, cuts, localized dubs, censored versions, broadcast-safe edits, theatrical vs. extended cuts, and format variants (SD/HD/4K). Each version record carries version type (theatrical/broadcast/director/unrated/censored/dubbed/subtitled), version label, target territory, target platform, runtime delta from master, language track configuration, subtitle language list, aspect ratio override, and version status. Enables multi-platform distribution where different versions are delivered to different windows and territories.'
}

Table content.genre {
  genre_id varchar [pk, note: 'Unique identifier for the genre. Primary key for the genre reference taxonomy.']
  parent_genre_id varchar [note: 'Reference to the parent genre in the hierarchical taxonomy, enabling multi-level classification such as Drama > Legal Drama or Sports > Football. Null for top-level genres.']
  ad_pod_compatibility boolean [note: 'Indicates whether content in this genre is compatible with Dynamic Ad Insertion (DAI) and ad pod placement. False for genres requiring uninterrupted viewing (e.g., live sports critical moments, news breaking coverage).']
  applicable_content_types varchar [note: 'Comma-separated list of content types to which this genre applies (e.g., series, film, clip, live_event, news_segment, music_video). Enables content-type-specific genre filtering.']
  archive_retention_policy varchar [note: 'Digital asset archival retention policy for content in this genre. Permanent retention for high-value evergreen genres; short-term for time-sensitive news and event content.']
  avod_monetization_potential varchar [note: 'Revenue generation potential for this genre on Advertising-Supported Video On Demand (AVOD) platforms, based on Cost Per Mille (CPM) rates and advertiser demand. High-potential genres command premium ad rates.']
  code varchar [note: 'Short alphanumeric code representing the genre for system integration and Electronic Program Guide (EPG) feeds. Used as a business key across scheduling, distribution, and metadata systems.']
  created_timestamp timestamp [note: 'Timestamp when this genre record was first created in the enterprise content taxonomy system.']
  daypart_affinity varchar [note: 'Comma-separated list of broadcast dayparts where this genre typically performs best (e.g., prime_time, late_night, early_morning, daytime, weekend). Informs program scheduling and playout automation strategies.']
  description varchar [note: 'Detailed textual description of the genre, including defining characteristics, typical content examples, and audience expectations. Used for editorial guidance and content acquisition briefings.']
  effective_end_date date [note: 'Date when this genre classification was retired or superseded. Null for currently active genres. Used for historical content classification and reporting continuity.']
  effective_start_date date [note: 'Date when this genre classification became effective and available for use in content metadata and scheduling systems.']
  eidr_genre_mapping varchar [note: 'Mapping to Entertainment Identifier Registry (EIDR) genre taxonomy for cross-industry content identification and rights management interoperability.']
  fast_channel_applicability boolean [note: 'Indicates whether this genre is suitable for Free Ad-Supported Streaming Television (FAST) linear channel programming. FAST channels require genres with deep catalog availability and consistent audience appeal.']
  geographic_restriction_applicability boolean [note: 'Indicates whether content in this genre is subject to geographic blackout restrictions or regional licensing constraints. Common for sports genres with territorial rights and retransmission consent agreements.']
  iab_content_category varchar [note: 'Mapping to Interactive Advertising Bureau (IAB) content taxonomy for programmatic advertising and contextual ad targeting. Enables Share of Voice (SOV) optimization and Cost Per Mille (CPM) rate alignment.']
  is_active boolean [note: 'Indicates whether this genre is currently active and available for content classification. Inactive genres are retained for historical content but not used for new acquisitions.']
  last_modified_timestamp timestamp [note: 'Timestamp when this genre record was last updated. Used for change tracking and metadata synchronization across Electronic Program Guide (EPG), Media Asset Management (MAM), and distribution systems.']
  linear_broadcast_suitability boolean [note: 'Indicates whether this genre is suitable for traditional linear scheduled broadcasting. Some genres (e.g., interactive, choose-your-own-adventure) are non-linear only.']
  localization_priority varchar [note: 'Priority level for content localization (dubbing, subtitling, cultural adaptation) for this genre. High-priority genres justify investment in multi-language versions for international distribution.']
  metadata_enrichment_priority varchar [note: 'Priority level for metadata enrichment and tagging in Media Asset Management (MAM) systems. Critical genres require comprehensive metadata for content discovery and personalization.']
  mpa_rating_applicability varchar [note: 'Comma-separated list of Motion Picture Association (MPA) ratings typically associated with this genre (e.g., G, PG, PG-13, R, NC-17). Used for content clearance and daypart scheduling compliance.']
  name varchar [note: 'Full display name of the genre as presented to audiences in Electronic Program Guides (EPG), streaming platform interfaces, and content discovery systems.']
  nielsen_genre_code varchar [note: 'Nielsen Media Research genre classification code used for audience measurement, ratings analysis, and Gross Rating Point (GRP) reporting alignment.']
  ott_platform_priority varchar [note: 'Priority level for featuring this genre on Over-The-Top (OTT) streaming platforms and Video On Demand (VOD) services. High priority genres receive prominent placement in content discovery and recommendation engines.']
  parental_guidance_flag boolean [note: 'Indicates whether content in this genre typically requires parental guidance warnings or viewer discretion advisories. Used for compliance with Federal Communications Commission (FCC) broadcast standards and Children\'s Online Privacy Protection Act (COPPA) requirements.']
  svod_performance_tier varchar [note: 'Performance classification for this genre on Subscription Video On Demand (SVOD) platforms. Premium genres drive subscriber acquisition and reduce churn rate; catalog genres provide library depth.']
  syndication_eligibility boolean [note: 'Indicates whether content in this genre is typically eligible for syndication to multiple outlets and resale. Used in rights and royalties management and windowing strategy planning.']
  target_demographic varchar [note: 'Primary audience demographic segment targeted by this genre, expressed in Nielsen demographic notation (e.g., A18-49, M25-54, W18-34). Used for Target Rating Point (TRP) and Gross Rating Point (GRP) planning.']
  tier varchar [note: 'Hierarchical level of the genre within the taxonomy. Primary represents top-level genres, secondary represents sub-genres, and tertiary represents granular classifications.']
  usage_notes varchar [note: 'Internal notes and guidelines for content producers, schedulers, and metadata specialists on proper application of this genre classification. Includes edge cases and disambiguation rules.']

  Note: 'Enterprise reference taxonomy for content genre and sub-genre classification. Captures genre code, genre name, parent genre reference (enabling hierarchical sub-genres like Drama > Legal Drama), genre tier (primary/secondary), applicable content types, IAB content category mapping for ad targeting, and active status. Standardizes genre labeling across EPG systems, streaming platform metadata feeds, and advertising contextual targeting to ensure consistent audience segmentation and content discovery.'
}

Table content.rating {
  rating_id varchar [pk, note: 'Primary key for rating']
  appeal_status varchar [note: 'The current status of any appeal filed by the content producer or distributor to challenge or modify the assigned rating classification.']
  body varchar [note: 'The official name of the regulatory or industry body that issued the rating (e.g., Motion Picture Association, TV Parental Guidelines Monitoring Board, British Board of Film Classification, Freiwillige Selbstkontrolle der Filmwirtschaft).']
  certificate_number varchar [note: 'The unique certificate or reference number issued by the rating body upon classification approval. Used for audit and compliance verification.']
  code varchar [note: 'The official rating classification code assigned to the content (e.g., G, PG, PG-13, R, NC-17 for MPA film ratings; TV-Y, TV-Y7, TV-G, TV-PG, TV-14, TV-MA for TV Parental Guidelines; or international equivalents such as BBFC, FSK, OFLC codes). [ENUM-REF-CANDIDATE: G|PG|PG-13|R|NC-17|TV-Y|TV-Y7|TV-G|TV-PG|TV-14|TV-MA — 11 candidates stripped; promote to reference product]']
  content_descriptor_drug_use boolean [note: 'Boolean flag indicating whether the rating includes a content descriptor for drug use or substance abuse.']
  content_descriptor_fear boolean [note: 'Boolean flag indicating whether the rating includes a content descriptor for frightening or intense scenes that may be unsuitable for younger audiences.']
  content_descriptor_language boolean [note: 'Boolean flag indicating whether the rating includes a content descriptor for strong or offensive language.']
  content_descriptor_nudity boolean [note: 'Boolean flag indicating whether the rating includes a content descriptor for nudity or sexual content.']
  content_descriptor_violence boolean [note: 'Boolean flag indicating whether the rating includes a content descriptor for violence or intense action.']
  created_timestamp timestamp [note: 'The timestamp when this rating record was first created in the system.']
  description varchar [note: 'Detailed textual description of the rating, including the rationale for the classification and any additional context provided by the rating body (e.g., \'Rated PG-13 for intense sequences of violence and action, some suggestive content, and brief strong language\').']
  effective_date date [note: 'The date on which this rating classification became effective and applicable to the content asset.']
  expiration_date date [note: 'The date on which this rating classification expires or is no longer valid. Null if the rating does not expire.']
  minimum_age varchar [note: 'The minimum recommended or legally mandated age (in years) for viewers of content with this rating. Null if no specific age restriction applies.']
  notes varchar [note: 'Additional internal notes or comments regarding the rating classification, including any special considerations, conditional approvals, or compliance requirements.']
  parental_control_enabled boolean [note: 'Boolean flag indicating whether this rating is used to enforce parental control features on linear broadcast, OTT (Over-The-Top), or MVPD (Multichannel Video Programming Distributor) platforms.']
  regulatory_mandate_flag boolean [note: 'Boolean flag indicating whether the rating is legally mandated by a regulatory body (e.g., FCC, Ofcom) or is a voluntary industry classification.']
  submission_date date [note: 'The date on which the content was submitted to the rating body for classification review.']
  system varchar [note: 'The rating system or classification framework under which the rating was assigned (e.g., MPA for Motion Picture Association, TVPG for TV Parental Guidelines, BBFC for British Board of Film Classification, FSK for Freiwillige Selbstkontrolle der Filmwirtschaft, OFLC for Australian Classification Board, CBFC for Central Board of Film Certification India).']
  territory_code varchar [note: 'Three-letter ISO 3166-1 alpha-3 country or territory code indicating the geographic jurisdiction where this rating applies (e.g., USA, GBR, DEU, AUS, IND).']
  updated_timestamp timestamp [note: 'The timestamp when this rating record was last modified or updated.']
  version varchar [note: 'Version number of the rating record, incremented when the rating is re-evaluated or updated due to content edits, appeals, or regulatory changes.']

  Note: 'Reference table for MPA, TV Parental Guidelines, and international content rating classifications applied to titles. Captures rating code (G/PG/PG-13/R/NC-17/TV-Y/TV-G/TV-PG/TV-14/TV-MA and international equivalents), rating system (MPA/TVPG/BBFC/FSK/etc.), rating body, applicable territory, minimum age indicator, content descriptor codes (violence/language/nudity/drug-use), and regulatory mandate flags. Supports FCC compliance, COPPA enforcement, and parental control features across linear and OTT platforms.'
}

Table content.talent_credit {
  talent_credit_id varchar [pk, note: 'Unique identifier for the talent credit record. Primary key for the talent credit association entity.']
  content_episode_id varchar [note: 'Reference to the specific episode within a series for which the talent is credited. Nullable for non-episodic content such as films or specials.']
  contract_id varchar [note: 'Foreign key linking to talent.talent_contract. Business justification: Credits must link to contracts for residual calculation, compensation verification, guild compliance reporting, and billing position validation. Fundamental to talent payment and rights management pro']
  role_id varchar [note: 'Foreign key linking to talent.talent_role. Business justification: Credits reference specific roles for character attribution, billing position validation, and role-specific residual eligibility. Eliminates denormalized role/character data and ensures single source o']
  season_id varchar [note: 'Foreign key linking to content.season. Business justification: talent_credit currently links talent to titles and episodes but lacks a season-level association. In media broadcasting, season-level credits are a standard business concept — showrunners, executive p']
  series_id varchar [note: 'Foreign key linking to content.series. Business justification: talent_credit currently links talent to titles and episodes but lacks a series-level association. In media broadcasting, series-level credits are a fundamental business concept — series creators, fran']
  talent_profile_id varchar [note: 'Reference to the talent master record in the talent domain. Links to the individual or entity receiving credit for their contribution to the content.']
  title_id varchar [note: 'Reference to the content title (film, series, special, documentary) for which the talent is credited. Links to the content master catalog.']
  version_id varchar [note: 'Foreign key linking to content.version. Business justification: talent_credit links talent identities to specific titles and episodes. In media broadcasting, certain talent credits are version-specific — dubbing actors are credited on specific localized versions, ']
  billing_position varchar [note: 'The ordinal position of the talent in the credit sequence, determining the order in which credits are displayed. Lower numbers indicate higher prominence (e.g., 1 = top billing). Used for EPG display and contractual compliance.']
  created_timestamp timestamp [note: 'The timestamp when this talent credit record was first created in the system. Used for audit trails and data lineage tracking.']
  credit_approval_date date [note: 'The date on which the credit was officially approved for publication. Used for audit trails and compliance with guild credit determination timelines.']
  credit_approval_status varchar [note: 'Current approval state of the credit. Pending indicates awaiting review; Approved indicates credit is finalized and ready for publication; Disputed indicates a challenge has been raised; Rejected indicates credit was not approved; Arbitration indicates the credit is under formal guild arbitration process.']
  credit_category varchar [note: 'High-level categorization of the credit by functional area or department. Used for grouping credits in EPG displays, streaming platform interfaces, and analytics. [ENUM-REF-CANDIDATE: cast|director|producer|writer|cinematography|editing|music|sound|production_design|costume|makeup|visual_effects|executive|other — 14 candidates stripped; promote to reference product]']
  credit_display_name varchar [note: 'The exact name as it should appear in credits, EPG metadata, and streaming platform displays. May differ from the talents legal name if a pseudonym or stage name is used. This is the authoritative display value for all public-facing credit presentations.']
  credit_display_order varchar [note: 'The sequence number for displaying this credit within its credit type or section (e.g., within the cast section or crew section). Used for rendering credits in EPG, streaming platforms, and promotional materials.']
  credit_end_timestamp timestamp [note: 'The timestamp marking when this credit ceases to be effective or visible. Nullable for credits that remain active indefinitely. Used for managing credit corrections, disputes, or contractual credit windows.']
  credit_notes varchar [note: 'Free-text field for additional context, special credit requirements, contractual stipulations, or notes related to credit disputes, arbitration outcomes, or special billing arrangements.']
  credit_start_timestamp timestamp [note: 'The timestamp marking when this credit becomes effective or visible in EPG and streaming platform metadata. Used for managing credit changes over time and versioning.']
  credit_type varchar [note: 'Classification of the credit based on how the talent contribution is presented. On-screen credits appear in the visual content; off-screen credits appear in end titles or metadata only; voice credits are for voice-over or dubbing; stunt credits are for stunt performers; archive credits are for archival footage appearances.']
  pseudonym_flag boolean [note: 'Indicates whether the talent is credited under a pseudonym or stage name rather than their legal name. True if pseudonym is used; False if legal name is used. Relevant for guild compliance and contractual credit requirements.']
  residuals_eligibility_flag boolean [note: 'Indicates whether this credit qualifies the talent for residual payments based on content reuse, syndication, or secondary distribution. True if eligible; False otherwise. Triggers residuals calculation workflows in the rights and royalties domain.']
  union_affiliation_flag boolean [note: 'Indicates whether the talent is affiliated with a recognized industry union (SAG-AFTRA, DGA, WGA, IATSE) for this credit. True if union-affiliated; False otherwise. Used for residuals eligibility determination and compliance reporting.']
  updated_timestamp timestamp [note: 'The timestamp when this talent credit record was last modified. Used for audit trails, change tracking, and data quality monitoring.']

  Note: 'Association entity linking talent identities (owned by the talent domain) to specific titles and episodes with their credited role, billing position, character name, credit type (on-screen/off-screen), and credit display order. Captures SAG-AFTRA/WGA/DGA union affiliation flag, residuals eligibility flag, and credit approval status. Serves as the content domain\'s authoritative credit roll for EPG metadata delivery, streaming platform cast display, and residuals calculation triggers. Does not duplicate the talent master record — references it via FK to the talent domain.'
}

Table content.acquisition {
  acquisition_id varchar [pk, note: 'Primary key for acquisition']
  broadcast_license_id varchar [note: 'Foreign key linking to compliance.broadcast_license. Business justification: Content acquisitions for broadcast must be validated against the acquiring station\'s broadcast license to confirm acquired rights match the license\'s service area, frequency band, and conditions. Righ']
  compliance_content_rating_id varchar [note: 'Foreign key linking to compliance.content_rating. Business justification: Content acquisitions must verify existing ratings or budget for rating submissions (MPAA, TV Parental Guidelines) as part of deal clearance and distribution planning. Links acquisition to rating certi']
  content_episode_id varchar [note: 'Foreign key linking to content.content_episode. Business justification: Acquisitions can be episode-specific in media broadcasting — a broadcaster may acquire rights to specific episodes within a season (e.g., acquiring only the first 3 episodes of a series for a promotio']
  content_version_id varchar [note: 'Foreign key linking to content.version. Business justification: Acquisitions often specify which version was acquired (theatrical vs broadcast cut, localized version). This FK allows tracking version-specific acquisition terms and rights.']
  partner_id varchar [note: 'Reference to the external party from whom the content was acquired (studio, independent producer, syndicator, distributor, or content aggregator).']
  series_id varchar [note: 'Foreign key linking to content.series. Business justification: acquisition records the business event of acquiring content from an external source. In media broadcasting, content is frequently acquired at the series level (e.g., acquiring all rights to a complete']
  title_id varchar [note: 'Reference to the content asset being acquired. Links to the master content catalog entry for the title, episode, series, film, clip, or other content asset.']
  acquisition_date date [note: 'The date on which the acquisition transaction was executed and the content rights were legally transferred or licensed to the enterprise. Represents the principal business event timestamp for this transaction.']
  acquisition_status varchar [note: 'Current lifecycle state of the acquisition. Negotiating = deal in discussion; Committed = contract signed but content not yet delivered; Delivered = content received and ingested; Active = content in use; Cancelled = deal terminated before delivery; Expired = license period ended.']
  acquisition_type varchar [note: 'Classification of the acquisition method. Purchase = outright ownership transfer; License = time-limited rights; Co-production = joint production investment; Commission = original content commissioned from producer; Barter = content exchanged for advertising inventory; Syndication = content licensed from syndicator for regional broadcast.']
  ancillary_rights_flag boolean [note: 'Indicates whether ancillary rights (merchandising, soundtrack, publishing, remake, sequel, spin-off, clip licensing) are included in the acquisition (True) or retained by the supplier (False).']
  clearance_status varchar [note: 'Rights verification status confirming that all necessary clearances (music rights, talent rights, third-party content, trademarks) have been obtained for broadcast or distribution. Pending = verification in progress; Cleared = all rights confirmed; Restricted = partial clearance with limitations; Failed = clearance issues prevent exploitation.']
  content_window_type varchar [note: 'The distribution window or rights category acquired. Windowing refers to the sequential release strategy where content is made available through different channels over time. Theatrical = cinema release; Home Video = physical/digital sell-through; SVOD = Subscription Video On Demand; AVOD = Advertising-Supported Video On Demand; TVOD = Transactional Video On Demand; Linear Broadcast = traditional scheduled TV; Syndication = resale to multiple outlets; All Rights = comprehensive rights across all windows. [ENUM-REF-CANDIDATE: theatrical|home_video|svod|avod|tvod|linear_broadcast|syndication|all_rights — 8 candidates stripped; promote to reference product]']
  cost_amount decimal(18,2) [note: 'The total monetary value paid or committed for acquiring the content rights. Represents the base acquisition cost before taxes, fees, or adjustments. For licenses, this is the total license fee; for purchases, the purchase price; for commissions, the production budget committed.']
  cost_currency varchar [note: 'Three-letter ISO 4217 currency code for the acquisition cost amount (e.g., USD, GBP, EUR, JPY).']
  created_timestamp timestamp [note: 'The date and time when this acquisition record was first created in the system. Audit field for data lineage and compliance tracking.']
  delivery_date date [note: 'The date on which the content master files and associated materials (metadata, artwork, closed captions, promotional assets) were delivered by the supplier and ingested into the enterprise Media Asset Management (MAM) system.']
  delivery_format varchar [note: 'The technical format and delivery method used by the supplier to provide the content. Examples: ProRes 422 HQ via FTP, IMF package via Aspera, DCP hard drive, MPEG-4 via CDN, tape (legacy).']
  exclusivity_flag boolean [note: 'Indicates whether the acquired rights are exclusive (True) or non-exclusive (False) within the specified territory and window. Exclusive rights prevent the supplier from licensing the same content to competitors in the same territory/window.']
  format_rights varchar [note: 'The technical formats or delivery specifications covered by the acquisition. May include SD, HD, 4K, HDR, theatrical DCP, broadcast master, streaming-optimized, etc. Defines the quality and format tiers the enterprise is authorized to distribute.']
  holdback_period_days varchar [note: 'The number of days during which the content cannot be exploited in certain windows or territories as stipulated by the acquisition agreement. Holdback periods protect prior windows (e.g., theatrical holdback prevents SVOD release for 90 days post-theatrical).']
  language_rights varchar [note: 'The languages or language versions for which rights were acquired. May specify original language only, dubbed versions, subtitled versions, or all language adaptations. Examples: English, Spanish, French; All Languages; Original + Subtitles.']
  license_end_date date [note: 'The date on which the acquired content rights expire and the enterprise must cease exploitation. Null for perpetual purchases. For time-limited licenses, this defines the end of the license term.']
  license_start_date date [note: 'The date from which the enterprise is authorized to begin exploiting the acquired content rights. For licenses, this is the effective start of the license term; for purchases, typically the acquisition date.']
  minimum_guarantee_amount decimal(18,2) [note: 'The minimum guaranteed payment to the supplier regardless of actual revenue performance. Common in revenue-sharing deals where the enterprise commits to a floor payment even if royalties do not reach this threshold.']
  notes varchar [note: 'Free-text field for additional context, special terms, restrictions, or operational notes related to the acquisition. May include information on promotional obligations, credit requirements, or unique contractual stipulations.']
  payment_terms varchar [note: 'Contractual payment schedule and conditions for the acquisition cost. May include milestone-based payments, installment schedules, advance payments, or revenue-sharing arrangements.']
  reference_number varchar [note: 'External business identifier for this acquisition transaction. May be a purchase order number, deal reference, or contract line item identifier used in communications with the supplier.']
  residuals_obligation_flag boolean [note: 'Indicates whether the enterprise has an obligation to pay residuals (talent reuse payments) to performers, writers, directors, or other rights holders each time the content is rebroadcast or redistributed (True) or if residuals are the supplier\'s responsibility (False).']
  royalty_rate_percent decimal(5,2) [note: 'The percentage of revenue or receipts that must be paid to the supplier as ongoing royalties under a revenue-sharing acquisition model. Null if the acquisition is a flat-fee structure with no revenue share.']
  runs_allowed varchar [note: 'The maximum number of times the content may be broadcast or streamed under the acquisition agreement. Common in linear broadcast licenses (e.g., 3 runs over 2 years). Null indicates unlimited runs within the license period.']
  runs_consumed varchar [note: 'The number of runs (broadcasts or streams) that have been executed to date against the runs_allowed limit. Tracked to ensure compliance with contractual run restrictions.']
  sublicensing_allowed_flag boolean [note: 'Indicates whether the enterprise is permitted to sublicense the acquired content to third parties (True) or must exploit the content directly only (False). Sublicensing enables syndication and secondary distribution deals.']
  updated_timestamp timestamp [note: 'The date and time when this acquisition record was last modified. Audit field for change tracking and data governance.']

  Note: 'Transactional record capturing the business event of acquiring content from an external source — studio, independent producer, syndicator, or distributor. Tracks acquisition type (purchase/license/co-production/commission), acquisition date, source party, acquisition cost, currency, content window acquired, territory scope, exclusivity flag, holdback period, acquisition status (negotiating/committed/delivered/cancelled), and originating deal reference. Serves as the financial and operational anchor for content entering the enterprise catalog from external sources.'
}

Table content.windowing_plan {
  windowing_plan_id varchar [pk, note: 'Unique identifier for the windowing plan record. Primary key for the windowing plan entity.']
  acquisition_deal_id varchar [note: 'Foreign key linking to partner.acquisition_deal. Business justification: Windowing plans are derived from acquisition deals that define runs allowed, holdback periods, and window types. Linking windowing_plan to acquisition_deal enables runs-consumed tracking, holdback enf']
  availability_window_id varchar [note: 'Foreign key linking to rights.rights_availability_window. Business justification: A windowing plan must be grounded in a confirmed rights availability window; distribution teams verify that planned windows fall within rights-available periods. This link supports availability valida']
  broadcast_license_id varchar [note: 'Foreign key linking to compliance.broadcast_license. Business justification: Linear broadcast windowing plans must reference the broadcast license under which content will air. Rights clearance teams verify the license is valid, active, and covers the planned window\'s territor']
  channel_id varchar [note: 'Foreign key linking to scheduling.channel. Business justification: Windowing plans govern when and on which channels content can air. Schedulers must validate schedule slots against active windowing plans for a channel. Direct channel_id FK enables channel-level wind']
  content_episode_id varchar [note: 'Foreign key linking to content.content_episode. Business justification: Windowing plans can be episode-specific in media broadcasting — a series finale or pilot episode may have unique windowing terms (e.g., premiere episode available free on AVOD while remaining episodes']
  content_rating_id varchar [note: 'Foreign key linking to content.rating. Business justification: Windowing plans specify rating requirements for distribution windows. Normalizes rating_code string column to reference the enterprise rating taxonomy.']
  content_version_id varchar [note: 'Foreign key linking to content.version. Business justification: Windowing plans are version-specific (theatrical version has different windows than broadcast version). Links distribution strategy to specific version.']
  content_window_id varchar [note: 'Foreign key linking to rights.rights_content_window. Business justification: A windowing plan operationalizes a rights content window; distribution planners must verify that planned windows align with rights-granted windows. Linking windowing_plan to rights_content_window enab']
  delivery_channel_id varchar [note: 'Foreign key linking to distribution.delivery_channel. Business justification: Windowing plans must specify the delivery channel (FAST, linear, SVOD) through which content is distributed in each window. This is a core content distribution planning requirement — windowing_plan al']
  distribution_agreement_id varchar [note: 'Foreign key linking to partner.distribution_agreement. Business justification: Windowing plans are governed by distribution agreements that define platform rights, territory scope, and window durations. This link enables windowing plan validation against contractual terms, SLA c']
  distribution_partner_id varchar [note: 'Foreign key linking to partner.partner_partner. Business justification: Windowing plans specify distribution partners for each window (theatrical exhibitor, streaming platform, broadcast network). Partner performance tracking, holdback enforcement, exclusivity compliance ']
  governing_license_agreement_id varchar [note: 'Foreign key linking to rights.license_agreement. Business justification: Windowing strategies must comply with license agreement terms (holdbacks, exclusivity windows, platform restrictions). Windowing plan validation and conflict detection require checking against the gov']
  grant_id varchar [note: 'Foreign key linking to rights.rights_grant. Business justification: Each window must map to a specific rights grant that authorizes that exploitation type (SVOD, AVOD, linear broadcast). Clearance systems validate that the window\'s dates and platform fall within grant']
  holdback_id varchar [note: 'Foreign key linking to rights.holdback. Business justification: Windowing plans must respect holdback restrictions; planners need to reference the specific holdback that constrains a window\'s open date or platform scope. This link enables automated holdback enforc']
  marketing_campaign_id varchar [note: 'Reference identifier for the marketing campaign associated with this window release. Links to promotional activities, advertising spend, and audience acquisition efforts.']
  ott_platform_id varchar [note: 'Foreign key linking to distribution.ott_platform. Business justification: Windowing plans define which platform receives content in each release window (theatrical → premium VOD → SVOD → AVOD). Core to revenue maximization strategy and rights holder agreements.']
  release_window_id varchar [note: 'Foreign key linking to distribution.release_window. Business justification: A windowing plan is the planning artifact that defines and sequences release windows. Linking windowing_plan to the specific release_window it governs enables content ops to track plan-to-execution al']
  royalty_rule_id varchar [note: 'Foreign key linking to rights.royalty_rule. Business justification: Revenue planning for a windowing plan requires knowing which royalty rule governs the window type and platform. Linking windowing_plan to royalty_rule enables automated royalty accrual forecasting and']
  season_id varchar [note: 'Foreign key linking to content.season. Business justification: Windowing plans in media broadcasting are commonly defined at the season level — a specific season of a series may have different windowing terms than other seasons (e.g., Season 1 available on AVOD w']
  series_id varchar [note: 'Foreign key linking to content.series. Business justification: windowing_plan defines the content-side release sequencing strategy across distribution channels. In media broadcasting, windowing plans are frequently negotiated and applied at the series level (e.g.']
  syndication_agreement_id varchar [note: 'Foreign key linking to partner.syndication_agreement. Business justification: Windowing plans must enforce holdback windows and exclusivity terms defined in syndication agreements. Linking windowing_plan to syndication_agreement enables automated holdback enforcement, window se']
  territory_id varchar [note: 'Foreign key linking to rights.territory. Business justification: Windows are territory-specific - geo-blocking, regional release strategies, and regulatory compliance require linking each window to its target territory. Clearance validates territorial rights before']
  title_id varchar [note: 'Reference to the content asset (title, episode, series, film, clip) for which this windowing plan is defined. Links to the master content catalog.']
  abr_enabled boolean [note: 'Indicates whether adaptive bitrate streaming is enabled for this window, allowing dynamic quality adjustment based on viewer bandwidth. True=ABR enabled, False=fixed bitrate.']
  approval_timestamp timestamp [note: 'Date and time when this windowing plan was formally approved by authorized stakeholders. Marks transition from draft to confirmed status.']
  audio_configuration varchar [note: 'The audio format specification for this window. Stereo=2-channel, Surround 5.1=5.1 channel surround, Surround 7.1=7.1 channel surround, Dolby Atmos=object-based audio, DTS:X=immersive audio format.']
  blackout_restrictions varchar [note: 'Geographic or temporal blackout rules that restrict content availability in specific regions or time periods within the territory (e.g., sports blackouts, regional exclusions).']
  bundle_eligibility boolean [note: 'Indicates whether this content is eligible for inclusion in subscription bundles or multi-title packages during this window. True=bundle eligible, False=standalone only.']
  concurrent_streams_limit varchar [note: 'Maximum number of simultaneous streams allowed per subscriber account for this content in this window. Used for subscription service tier management.']
  content_format varchar [note: 'The technical format specification for content delivery in this window. SD=standard definition, HD=high definition 1080p, 4K=ultra high definition, 8K=8K resolution, HDR=high dynamic range, Dolby Vision=premium HDR format.']
  created_timestamp timestamp [note: 'Date and time when this windowing plan record was first created in the system. Audit trail for record lifecycle.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts in this windowing plan (e.g., USD, GBP, EUR).']
  download_to_go_enabled boolean [note: 'Indicates whether offline download capability is enabled for this window, allowing viewers to download content for offline viewing. True=downloads allowed, False=streaming only.']
  dubbing_availability boolean [note: 'Indicates whether dubbed audio tracks in alternate languages are available for this window release. True=dubbing provided, False=original language only.']
  exclusivity_tier varchar [note: 'The level of exclusivity granted to the platform during this window. Exclusive=sole distribution rights, Non-Exclusive=concurrent availability on multiple platforms, Shared Exclusive=limited to a defined group of platforms, First Run=premiere window, Second Run=subsequent availability.']
  holdback_duration_days varchar [note: 'The number of days between the close of the previous window and the open of this window, representing the exclusivity period or gap between release phases.']
  language_version varchar [note: 'ISO 639-2 or ISO 639-3 language code for the primary audio/subtitle language version to be released in this window (e.g., eng, spa, fra, deu).']
  last_modified_timestamp timestamp [note: 'Date and time when this windowing plan record was last updated. Audit trail for change tracking.']
  minimum_guarantee_amount decimal(15,2) [note: 'The minimum guaranteed revenue amount (in base currency) that the platform has committed to pay for this window, regardless of actual performance. Used in licensing negotiations.']
  notes varchar [note: 'Free-text field for additional context, special instructions, or strategic rationale for this windowing plan. Used for internal communication and documentation.']
  planned_close_date date [note: 'The intended end date when the content will no longer be available on the specified platform/channel in the specified territory. Nullable for open-ended windows.']
  planned_open_date date [note: 'The intended start date when the content becomes available on the specified platform/channel in the specified territory. Represents the editorial/commercial release plan.']
  price_point decimal(10,2) [note: 'The consumer-facing price for transactional windows (TVOD, EST, PPV) in the specified currency. Represents the retail price charged to end viewers.']
  promotional_pricing_flag boolean [note: 'Indicates whether promotional or discounted pricing is applied for this window. True=promotional pricing active, False=standard pricing.']
  revenue_model varchar [note: 'The monetization approach for this window. Subscription=SVOD model, Advertising=AVOD model, Transactional=TVOD/PPV/EST, Hybrid=combination of models, Free=no direct revenue.']
  streaming_protocol varchar [note: 'The streaming delivery protocol used for OTT windows. HLS=HTTP Live Streaming (Apple), DASH=Dynamic Adaptive Streaming over HTTP (MPEG-DASH), Smooth Streaming=Microsoft, RTMP=Real-Time Messaging Protocol, WebRTC=real-time communication.']
  subtitle_availability boolean [note: 'Indicates whether subtitles or closed captions are available for this window release. True=subtitles provided, False=no subtitles.']
  viewing_window_hours varchar [note: 'For TVOD/rental windows, the number of hours a viewer has to complete watching the content after initiating playback (e.g., 48-hour rental window).']
  window_sequence_number varchar [note: 'Sequential ordering of this window within the overall release strategy for the content. Lower numbers indicate earlier windows (e.g., 1=theatrical, 2=SVOD, 3=AVOD).']
  window_status varchar [note: 'Current lifecycle status of the windowing plan. Planned=initial strategy, Confirmed=approved by stakeholders, Active=currently in release window, Completed=window has closed, Cancelled=window will not execute, Postponed=delayed to future date.']
  window_type varchar [note: 'The distribution window category defining the release channel type. Theatrical=cinema release, SVOD=subscription video on demand, AVOD=advertising-supported video on demand, TVOD=transactional video on demand, Linear Broadcast=traditional scheduled TV, Home Video=physical media, Syndication=content resale to multiple outlets, FAST=free ad-supported streaming television, PPV=pay-per-view, EST=electronic sell-through. [ENUM-REF-CANDIDATE: theatrical|svod|avod|tvod|linear_broadcast|home_video|syndication|fast|vod|ppv|est — 11 candidates stripped; promote to reference product]']

  Note: 'Defines the content-side release sequencing strategy for a title across distribution channels — theatrical, SVOD, AVOD, TVOD, linear broadcast, home video, and syndication. Each record captures window type, platform/channel, territory, planned open date, planned close date, holdback duration, exclusivity tier, and window status. Represents the content team\'s intended release plan that feeds into the rights domain for contractual enforcement and the distribution domain for operational execution. Distinct from rights windows (which are contractual) — this is the editorial/commercial planning artifact.'
}

Table content.metadata_profile {
  metadata_profile_id varchar [pk, note: 'Unique identifier for the metadata profile record. Primary key.']
  channel_id varchar [note: 'Foreign key linking to scheduling.channel. Business justification: Metadata profiles are encoder-specific; different platforms require different encoding + metadata combinations. Delivery validation, platform certification, and QC workflows require encoder linkage. E']
  compliance_content_rating_id varchar [note: 'Foreign key linking to compliance.content_rating. Business justification: Metadata profiles delivered to distribution platforms (Netflix, Hulu, linear broadcast) must include certified content rating for parental control systems and regulatory display requirements. Links pr']
  content_episode_id varchar [note: 'Foreign key linking to content.content_episode. Business justification: metadata_profile contains a denormalized episode_number INT column. Metadata profiles are commonly delivered at the episode level for streaming platforms (e.g., episode-level metadata packages with sy']
  content_version_id varchar [note: 'Foreign key linking to content.version. Business justification: Metadata profiles are version-specific (different metadata for theatrical vs broadcast version, localized versions). Links metadata delivery to specific version.']
  delivery_channel_id varchar [note: 'Foreign key linking to distribution.delivery_channel. Business justification: Metadata profiles are prepared per delivery channel — FAST channel metadata differs from SVOD metadata in format, field requirements, and artwork specs. metadata_profile has channel_id (scheduling dom']
  genre_id varchar [note: 'Foreign key linking to content.genre. Business justification: metadata_profile stores genre_classification as a denormalized STRING. The enterprise genre taxonomy is managed in content.genre, and all other content entities (title, series, season, content_episode']
  ott_platform_id varchar [note: 'Foreign key linking to distribution.ott_platform. Business justification: Metadata profiles are formatted for specific platform ingestion specs (Netflix TDF, iTunes XML, Roku feed). Each platform has unique metadata schema, image specs, and validation rules for content cata']
  partner_id varchar [note: 'Foreign key linking to partner.partner. Business justification: Metadata profiles are created to partner-specific specifications (different partners require different metadata standards, field mappings, and delivery formats). Linking metadata_profile to partner en']
  season_id varchar [note: 'Foreign key linking to content.season. Business justification: metadata_profile contains a denormalized season_number INT column. In media broadcasting, metadata profiles are delivered at the season level (e.g., a season metadata package for a streaming platform)']
  series_id varchar [note: 'Foreign key linking to content.series. Business justification: metadata_profile stores the full descriptive metadata set delivered to a specific platform. Metadata profiles are frequently created at the series level (e.g., a series-level metadata package delivere']
  territory_id varchar [note: 'Foreign key linking to rights.rights_territory. Business justification: Metadata profiles are territory-specific in broadcasting; different territories require localized metadata (language, ratings, regulatory compliance). Linking metadata_profile to rights_territory enab']
  title_id varchar [note: 'Reference to the core content title for which this metadata profile is created. Links to the master title catalog.']
  aspect_ratio varchar [note: 'Visual aspect ratio of the content. Common values include 4:3 (standard definition), 16:9 (HD/widescreen), 21:9 (ultra-widescreen), 1.85:1, 2.39:1 (cinema formats).']
  audio_description_available boolean [note: 'Indicates whether audio description (narration for visually impaired viewers) is available for this content. Used for accessibility compliance and platform requirements.']
  audio_format varchar [note: 'Audio format and channel configuration of the content. Examples: Stereo, 5.1 surround, 7.1 surround, Dolby Atmos, DTS:X, Mono.']
  cast_summary varchar [note: 'Summarized list of principal cast members and their roles. Used for promotional materials and EPG (Electronic Program Guide) displays where full cast lists are impractical.']
  closed_caption_available boolean [note: 'Indicates whether closed captions (subtitles for the deaf and hard of hearing) are available for this content. Used for accessibility compliance and platform requirements.']
  content_rating varchar [note: 'Age or content rating assigned by the Motion Picture Association (MPA) or equivalent rating body, formatted for the target platform. Examples: G, PG, PG-13, R, TV-Y, TV-14.']
  created_timestamp timestamp [note: 'Timestamp when this metadata profile record was first created in the system. Used for audit trails and metadata lifecycle tracking.']
  delivery_date date [note: 'The date on which this metadata profile was delivered or published to the target platform. Used for tracking metadata distribution and compliance with delivery schedules.']
  director_credit varchar [note: 'Name(s) of the director(s) of the content. Used for attribution, promotional materials, and search/discovery.']
  expiration_date date [note: 'Date on which this metadata profile expires or is no longer valid for the target platform. Used for metadata lifecycle management and rights windowing.']
  keyword_tags varchar [note: 'Comma-separated list of keyword tags for content discovery, search indexing, and recommendation engines. Includes themes, topics, moods, and contextual descriptors.']
  long_synopsis varchar [note: 'Extended narrative description of the content title. Typically 200-500 words, used for detailed program guides, press releases, and promotional materials.']
  metadata_language varchar [note: 'ISO 639 language code (2 or 3 letters) with optional ISO 3166 country code for the language in which this metadata profile is written. Examples: en, en-US, fr, es-MX.']
  metadata_standard varchar [note: 'The metadata standard or schema used for this profile. Defines the structure and vocabulary of the metadata package.']
  modified_by varchar [note: 'User or system identifier of the person or process that last modified this metadata profile. Used for audit trails and accountability.']
  modified_timestamp timestamp [note: 'Timestamp when this metadata profile record was last modified. Used for audit trails, change tracking, and metadata version control.']
  original_air_date date [note: 'The date on which the content was originally broadcast or released. Used for historical context, rights windowing, and promotional materials.']
  parental_guidance_notes varchar [note: 'Detailed notes explaining the content rating, including specific content descriptors (violence, language, sexual content, etc.). Used for parental controls and compliance.']
  platform_specific_code varchar [note: 'Unique identifier assigned by the target platform for this metadata profile. Used for cross-referencing and reconciliation with external systems.']
  poster_url varchar [note: 'URL (Uniform Resource Locator) to the poster or cover art image associated with this metadata profile. Used for streaming platform UI, marketing, and promotional materials.']
  production_company varchar [note: 'Name of the production company or studio that produced the content. Used for rights attribution and promotional materials.']
  profile_status varchar [note: 'Current lifecycle status of the metadata profile. Indicates whether the profile is in draft, has been validated, is published to the target platform, rejected due to validation errors, archived, or expired.']
  promotional_tagline varchar [note: 'Short, catchy promotional phrase or slogan used in marketing campaigns, social media, and advertising. Typically 10-30 words.']
  runtime_minutes varchar [note: 'Total runtime of the content in minutes. Used for scheduling, EPG (Electronic Program Guide) display, and audience planning.']
  short_synopsis varchar [note: 'Brief narrative description of the content title. Typically 50-150 words, used for EPG (Electronic Program Guide) listings, mobile apps, and quick reference.']
  thumbnail_url varchar [note: 'URL (Uniform Resource Locator) to the thumbnail image associated with this metadata profile. Used for EPG (Electronic Program Guide) display, streaming platform UI, and promotional materials.']
  trailer_url varchar [note: 'URL (Uniform Resource Locator) to the trailer or preview video associated with this content. Used for promotional campaigns and streaming platform previews.']
  validation_errors varchar [note: 'Detailed list of validation errors or warnings encountered during metadata quality checks. Used for troubleshooting and metadata remediation.']
  validation_status varchar [note: 'Result of automated or manual validation checks against the target metadata standard. Indicates whether the profile meets all required schema and business rules.']
  version_number varchar [note: 'Version number of this metadata profile. Incremented with each update to track metadata evolution and support rollback if needed.']

  Note: 'Stores the full descriptive metadata set for a title as delivered to a specific platform or metadata standard — EPG, streaming platform, MVPD, search index, or press/publicity. Captures metadata standard (EIDR/Dublin Core/EBUCore/TVAnytime/schema.org), target platform, long synopsis, short synopsis, keyword tags, cast summary, director credit, production company, distributor, promotional tagline, metadata language, delivery date, and validation status. Enables platform-specific metadata packaging without polluting the core title master record.'
}

Table production.project {
  project_id varchar [pk, note: 'Primary key for project']
  broadcast_license_id varchar [note: 'Foreign key linking to compliance.broadcast_license. Business justification: Productions must operate under specific broadcast licenses for regulatory compliance, rights clearance, and distribution authorization. Essential for FCC compliance reporting and license renewal proce']
  channel_id varchar [note: 'Foreign key linking to scheduling.channel. Business justification: Projects are commissioned for specific broadcast channels/networks. Network commissioning process requires tracking which channel ordered the content. Essential for content planning, budget allocation']
  production_company_partner_id varchar [note: 'Foreign key linking to partner.partner_partner. Business justification: Production projects are executed by or with external production companies (partners). Linking enables contract management, payment processing, co-production tracking, and rights negotiation. The `prod']
  sales_account_id varchar [note: 'Foreign key linking to sales.opportunity. Business justification: Content licensing and syndication sales opportunities reference specific production projects to verify rights availability, establish cost basis for pricing, coordinate delivery schedules, and ensure ']
  target_ott_platform_id varchar [note: 'Foreign key linking to distribution.ott_platform. Business justification: Productions are commissioned for specific streaming platforms (Netflix Originals, HBO Max Exclusives). Platform determines technical specs, content ratings, delivery windows. Real business process: pl']
  territory_id varchar [note: 'Foreign key linking to rights.territory. Business justification: Production projects are planned and budgeted against specific broadcast facilities for transmission/distribution. Real-world production planning requires facility assignment for capacity planning, tec']
  actual_delivery_date date [note: 'Date on which the final deliverable was actually delivered to the distribution or broadcast platform. Compared against target_delivery_date to measure on-time delivery performance and SLA compliance.']
  actual_spend_usd decimal(18,2) [note: 'Cumulative actual expenditure incurred against this production project to date, denominated in US Dollars. Sourced from SAP S/4HANA cost postings. Compared against approved_budget_usd for variance and financial reconciliation reporting.']
  approved_budget_usd decimal(18,2) [note: 'Total production budget formally approved at greenlight, denominated in US Dollars. Represents the authorized spend ceiling for the project. Used for financial controlling, variance analysis, and EBITDA reporting in SAP S/4HANA.']
  co_production_flag boolean [note: 'Indicates whether this production project is a co-production involving one or more external production partners. Triggers co-production agreement workflows, shared rights structures, and split budget reporting in SAP S/4HANA.']
  content_genre varchar [note: 'Primary genre classification of the content being produced (e.g., drama, comedy, thriller, sports, news, reality). Used for audience targeting, scheduling, advertising sales, and rights windowing strategies. [ENUM-REF-CANDIDATE: drama|comedy|thriller|action|documentary|news|reality|sports|animation|horror — promote to reference product]']
  content_rating varchar [note: 'Official content rating assigned by the Motion Picture Association (MPA) or TV Parental Guidelines system. Governs broadcast scheduling, advertising eligibility, and platform distribution restrictions including COPPA compliance for children\'s content. [ENUM-REF-CANDIDATE: G|PG|PG-13|R|NC-17|TV-Y|TV-Y7|TV-G|TV-PG|TV-14|TV-MA — 11 candidates stripped; promote to reference product]']
  coppa_applicable boolean [note: 'Indicates whether this production is directed at children under 13 and therefore subject to COPPA compliance requirements. Affects data collection practices, advertising eligibility, and platform distribution restrictions.']
  created_timestamp timestamp [note: 'Timestamp when this production project record was first created in the lakehouse Silver layer. Conforms to ISO 8601 format (yyyy-MM-ddTHH:mm:ss.SSSXXX). Used for audit trail and data lineage tracking.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for the budget and spend amounts recorded on this project (e.g., USD, GBP, EUR). Supports multi-currency production environments for international co-productions.']
  dalet_workflow_reference varchar [note: 'Integration reference identifier linking this production project to its corresponding workflow instance in Dalet Galaxy Media Asset Management and Workflow Orchestration system. Enables cross-system traceability for ingest, metadata, archive, and workflow operations.']
  drm_required boolean [note: 'Indicates whether Digital Rights Management (DRM) protection must be applied to the delivered content assets. Drives technical delivery specifications for CDN, streaming platform configuration, and Akamai CDN security settings.']
  eidr varchar [note: 'Entertainment Identifier Registry (EIDR) identifier for this content project. Provides a universal, persistent identifier for the title across supply chain partners, distributors, and platforms.']
  episode_count varchar [note: 'Total number of episodes commissioned for this production project. Applicable to scripted and unscripted series. Used for budget modeling, scheduling, and rights licensing calculations. Null for single-title formats such as feature films.']
  fcc_license_required boolean [note: 'Indicates whether this production requires FCC broadcast licensing compliance review prior to linear broadcast distribution. Applicable to content intended for over-the-air or cable transmission in the United States.']
  greenlight_date date [note: 'Calendar date on which the production project received formal executive greenlight approval. Marks the official start of the production lifecycle and triggers budget release and resource mobilization.']
  greenlight_status varchar [note: 'Executive approval status of the production project. Indicates whether the project has received formal greenlight authorization to proceed, is pending approval, is on hold, or has been cancelled. Controls budget release and resource mobilization.']
  isan varchar [note: 'Globally unique identifier assigned to this audiovisual work under the International Standard Audiovisual Number (ISAN) standard (ISO 15706). Used for rights management, royalty tracking, and cross-platform content identification.']
  original_ip_flag boolean [note: 'Indicates whether this production is based on original intellectual property owned by the organization, as opposed to licensed or adapted IP. Affects rights ownership, residuals obligations, and long-term asset valuation.']
  post_production_start_date date [note: 'Scheduled or actual date on which post-production activities commenced, including editing, VFX, color grading, audio mixing, and transcoding. Used for facility booking and deliverable milestone planning.']
  pre_production_start_date date [note: 'Scheduled or actual date on which pre-production activities commenced, including casting, location scouting, script breakdown, and crew hiring. Used for production planning and milestone tracking.']
  primary_language varchar [note: 'ISO 639-1 or ISO 639-2 language code for the primary language in which the content is produced (e.g., en, es, fr). Drives localization, dubbing, subtitling, and distribution territory planning.']
  principal_photography_end_date date [note: 'Scheduled or actual date on which principal photography concluded (picture wrap). Triggers transition to post-production phase and initiates post-production resource scheduling.']
  principal_photography_start_date date [note: 'Scheduled or actual date on which principal photography (primary filming) commenced. A key production milestone used for crew scheduling, facility booking, and insurance activation.']
  production_country varchar [note: 'ISO 3166-1 alpha-3 country code for the primary country in which the production is being executed. Determines applicable regulatory frameworks, tax incentive eligibility, and co-production treaty benefits.']
  production_format varchar [note: 'Primary technical production format and resolution specification (e.g., 4K UHD, HD 1080p, HDR10). Determines post-production pipeline, transcoding requirements, and delivery specifications for broadcast and streaming platforms. [ENUM-REF-CANDIDATE: 4K_UHD|HD_1080p|HD_720p|SD|HDR10|Dolby_Vision|IMAX — 7 candidates stripped; promote to reference product]']
  production_phase varchar [note: 'Current phase of the content production lifecycle. Tracks the project\'s progression from development through delivery. Used to gate workflow steps, resource allocation, and financial milestone releases.']
  project_type varchar [note: 'Classification of the content production project by format and genre category. Drives production workflow templates, budget models, rights structures, and scheduling logic. [ENUM-REF-CANDIDATE: scripted_series|feature_film|documentary|live_event|news_segment|unscripted_series|short_form — promote to reference product]']
  sap_wbs_element varchar [note: 'SAP S/4HANA Work Breakdown Structure element code that maps this production project to the enterprise financial controlling hierarchy for budget tracking, cost allocation, and financial reconciliation.']
  season_number varchar [note: 'Season number within a series franchise. Used to link this production project to prior seasons for rights continuity, talent residuals, and audience analytics. Null for non-series formats.']
  synopsis varchar [note: 'Short narrative description of the content production project\'s story, subject matter, or editorial concept. Used for internal greenlight documentation, sales pitches, EPG metadata, and Dalet Galaxy asset metadata.']
  target_delivery_date date [note: 'Contractually committed or internally planned date by which the finished content must be delivered to distribution, broadcast, or streaming platforms. Drives post-production scheduling, windowing strategy, and SLA compliance.']
  total_runtime_minutes varchar [note: 'Total planned or delivered runtime of the production in minutes. For series, this is the aggregate runtime across all episodes. Used for scheduling, licensing, and royalty calculations.']
  updated_timestamp timestamp [note: 'Timestamp when this production project record was most recently modified in the lakehouse Silver layer. Conforms to ISO 8601 format (yyyy-MM-ddTHH:mm:ss.SSSXXX). Used for change tracking, incremental processing, and audit compliance.']

  Note: 'Master record for a content production project — the greenlit initiative that drives all production activity. Captures the project title, type (scripted series, feature film, documentary, live event, news segment), greenlight status, production phase (development, pre-production, principal photography, post-production, delivery), approved budget, actual spend, production company, showrunner or executive producer, target delivery date, ISAN identifier, and integration reference to Dalet Galaxy workflow. This is the top-level anchor entity for the entire production domain.'
}

Table production.shoot_schedule {
  shoot_schedule_id varchar [pk, note: 'Unique surrogate identifier for a shoot schedule record in the production domain. Primary key for the shoot_schedule data product.']
  production_episode_id varchar [note: 'Foreign key linking to production.production_episode. Business justification: A shoot schedule day is typically tied to filming a specific episode in a series production. Adding production_episode_id to shoot_schedule allows direct episode-level scheduling queries and links the']
  production_project_id varchar [note: 'Reference to the parent production project to which this shoot schedule day belongs. Links the daily schedule to the overarching production entity.']
  program_schedule_id varchar [note: 'Foreign key linking to scheduling.program_schedule. Business justification: For live broadcasts (news, sports, live events), the shoot schedule must align with the program schedule air date/time. Production coordinators use this link to enforce on-air deadlines and coordinate']
  schedule_slot_id varchar [note: 'Foreign key linking to scheduling.schedule_slot. Business justification: For live studio productions, the shoot schedule maps directly to the on-air schedule slot. Live production coordinators align shoot call times and wrap times with the slot\'s planned_start_time and pla']
  script_id varchar [note: 'Foreign key linking to production.script. Business justification: A shoot schedule day references specific script scenes (captured in scene_numbers STRING). Adding script_id to shoot_schedule formalizes the relationship between the daily shooting schedule and the sc']
  actual_extras_count varchar [note: 'The actual number of background performers (extras) who worked on this shoot day. Used for payroll reconciliation, SAG-AFTRA reporting, and production cost tracking.']
  actual_shoot_hours decimal(5,2) [note: 'The actual number of hours spent in principal photography for the day. Used for budget reconciliation, overtime calculation, and production efficiency analysis.']
  actual_wrap_time timestamp [note: 'The actual time at which principal photography concluded for the day. Compared against scheduled wrap time to calculate overtime and assess schedule adherence.']
  call_time timestamp [note: 'The scheduled time at which cast and crew are required to report to set. Used for crew coordination, transport logistics, and facility readiness planning.']
  cover_set_description varchar [note: 'Description of the alternate interior or cover set designated for use if weather or other conditions prevent the primary shoot. Only applicable when weather_contingency_flag is True.']
  created_timestamp timestamp [note: 'The timestamp at which this shoot schedule record was first created in the system. Supports audit trail, data lineage, and compliance requirements.']
  dalet_workflow_reference varchar [note: 'The workflow instance identifier assigned by Dalet Galaxy for the ingest and orchestration workflow associated with this shoot day\'s deliverables. Enables traceability between the shoot schedule and downstream media asset management processes.']
  day_out_of_days_type varchar [note: 'Industry-standard Day Out of Days (DOOD) designation indicating the cast/crew work status for this shoot day. SW=Start Work, W=Work, WF=Work Finish, F=Finish, H=Hold, D=Drop, SWF=Start Work Finish. Used for talent scheduling, residuals calculation, and SAG-AFTRA compliance. [ENUM-REF-CANDIDATE: SW|W|WF|F|H|D|SWF — 7 candidates stripped; promote to reference product]']
  estimated_extras_count varchar [note: 'The planned number of background performers (extras) required for this shoot day. Used for casting coordination, catering planning, and SAG-AFTRA background performer compliance.']
  estimated_shoot_hours decimal(5,2) [note: 'The planned number of shooting hours for the day, used for budget forecasting, crew scheduling, and facility booking. Expressed in decimal hours (e.g., 10.50 = 10 hours 30 minutes).']
  first_shot_time timestamp [note: 'The scheduled or actual time at which the first camera roll of the day begins. A key production efficiency metric used to assess set readiness and pre-production effectiveness.']
  is_overtime_day boolean [note: 'Indicates whether this shoot day resulted in overtime hours for cast or crew, triggering additional compensation obligations under union agreements (SAG-AFTRA, DGA, IATSE). Derived operationally but stored for compliance and payroll audit purposes.']
  meal_penalty_flag boolean [note: 'Indicates whether a meal penalty was incurred on this shoot day due to failure to provide a meal break within the union-mandated interval (typically 6 hours). Triggers additional compensation obligations under SAG-AFTRA and IATSE agreements.']
  page_count decimal(5,2) [note: 'The number of script pages scheduled for photography on this shoot day, expressed in eighths of a page per industry convention (e.g., 4.625 = 4 and 5/8 pages). A standard production efficiency metric used to assess daily output against industry benchmarks.']
  production_notes varchar [note: 'Free-text field capturing significant events, issues, or observations from the shoot day, including equipment failures, weather delays, cast illness, or creative changes. Sourced from the daily production report.']
  production_unit varchar [note: 'Identifies the filming unit responsible for this shoot day. Main unit is led by the principal director; second unit handles action sequences or supplemental footage; splinter unit shoots simultaneously with main unit on a separate set; insert unit captures close-up or detail shots.']
  revision_date date [note: 'The date on which the current revision of this shoot schedule was issued. Used to track the cadence of schedule changes and identify the most current approved version.']
  revision_version varchar [note: 'The version identifier of this shoot schedule revision (e.g., \'v1\', \'v3-BLUE\', \'Rev-7\'). Production schedules are revised frequently; tracking version enables audit of changes and comparison of planned vs. actual across revisions.']
  scene_numbers varchar [note: 'Comma-separated list of scene numbers from the production script scheduled for photography on this shoot day (e.g., \'12, 13A, 14, 15B\'). Derived from the stripboard and used for script supervisor tracking and editorial planning.']
  schedule_number varchar [note: 'Externally-known alphanumeric identifier for this shoot schedule record, used in production paperwork, call sheets, and cross-system references (e.g., SS-2024-0042).']
  schedule_status varchar [note: 'Current lifecycle state of the shoot schedule day. Drives workflow actions and reporting across production management. [ENUM-REF-CANDIDATE: draft|confirmed|in_progress|completed|cancelled|postponed — promote to reference product if additional states are required]']
  scheduled_wrap_time timestamp [note: 'The planned time at which principal photography is expected to conclude for the day. Used for facility booking, crew scheduling, and overtime cost estimation.']
  shoot_date date [note: 'The calendar date on which principal photography is scheduled or was executed. The primary business event date for this schedule record.']
  shoot_day_number varchar [note: 'Sequential shoot day number within the production (e.g., Day 1, Day 15, Day 42). Used to track production progress against the total approved shoot days and for budget burn-rate analysis.']
  shoot_type varchar [note: 'Classifies the nature of the shoot day environment. Distinguishes between controlled studio environments and on-location shoots, which have different logistical, permitting, and cost implications.']
  total_approved_shoot_days varchar [note: 'The total number of principal photography days approved in the production greenlight. Used to calculate schedule completion percentage and identify overages requiring executive approval.']
  turnaround_hours decimal(4,2) [note: 'The minimum rest period in hours between the wrap of the previous shoot day and the call time of this shoot day. Union agreements (SAG-AFTRA, DGA, IATSE) mandate minimum turnaround periods; violations trigger penalty payments.']
  updated_timestamp timestamp [note: 'The timestamp at which this shoot schedule record was most recently modified. Used for change detection, incremental data loading in the Databricks Silver Layer, and audit trail maintenance.']
  weather_contingency_flag boolean [note: 'Indicates whether this shoot day has a weather contingency plan in place. When True, an alternate interior or cover set is designated in case outdoor conditions prevent the primary shoot. Critical for location shoots and insurance risk management.']

  Note: 'Day-by-day principal photography schedule for a production project. Tracks shoot dates, call times, wrap times, location or studio facility, scene numbers, unit (main unit, second unit, splinter unit), director, first assistant director, estimated vs actual shoot hours, weather contingency flags, and schedule revision version. Integrates with facility booking and crew assignment to coordinate all on-set resources. Distinct from the EPG scheduling domain which governs broadcast playout.'
}

Table production.budget {
  budget_id varchar [pk, note: 'Primary key for budget']
  production_project_id varchar [note: 'Reference to the parent production project this budget record belongs to. Links the financial control baseline to the production entity.']
  regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: Production budgets allocate funds to satisfy specific regulatory obligations (captioning budget for FCC obligations, public file maintenance budget for inspection file obligations). Broadcasters track']
  actual_cost_amount decimal(18,2) [note: 'Cumulative actual costs incurred to date for this cost category, sourced from SAP S/4HANA FI/CO actual postings. Represents real expenditure against the approved budget.']
  approval_status varchar [note: 'Current workflow approval status of this budget record. DRAFT = in preparation; PENDING_APPROVAL = submitted for sign-off; APPROVED = formally authorized; REJECTED = returned for revision; LOCKED = frozen for actuals comparison; CLOSED = production complete.']
  approved_amount decimal(18,2) [note: 'The formally approved budget amount for this cost category and version, representing the financial control baseline authorized by the production greenlight committee.']
  approved_timestamp timestamp [note: 'Date and time when this budget version was formally approved by the authorized signatory. Null if not yet approved.']
  change_reason varchar [note: 'Free-text narrative explaining the business justification for a budget revision (e.g., \'Schedule extension due to weather delays\', \'Additional VFX shots approved by director\'). Mandatory for revised versions.']
  change_request_reference varchar [note: 'Reference number of the formal budget change request (BCR) document that authorized a revision to this budget line, traceable in the production finance approval workflow.']
  code varchar [note: 'Externally-known alphanumeric code uniquely identifying this budget record within the production finance system. Used for cross-system reference and reporting.']
  committed_amount decimal(18,2) [note: 'Total value of open purchase order commitments (obligations) for this cost category that have been raised but not yet invoiced. Represents encumbered funds in the SAP MM/CO commitment ledger.']
  contingency_amount decimal(18,2) [note: 'The absolute monetary value of the contingency reserve allocated for this cost category, derived from the contingency percentage applied to the approved budget amount.']
  contingency_percentage decimal(5,2) [note: 'The percentage of the approved budget allocated as contingency reserve for this cost category, representing the risk buffer approved by the production finance committee.']
  cost_category_code varchar [note: 'SAP cost element or cost category code classifying the type of production expenditure (e.g., ATL-TALENT, BTL-CREW, BTL-EQUIPMENT, POST-VFX, POST-AUDIO). [ENUM-REF-CANDIDATE: ATL-TALENT|ATL-RIGHTS|BTL-CREW|BTL-EQUIPMENT|BTL-FACILITIES|BTL-TRAVEL|POST-VFX|POST-AUDIO|POST-COLOR|CONTINGENCY — promote to reference product]']
  cost_category_name varchar [note: 'Human-readable name of the production cost category (e.g., \'Above-the-Line Talent\', \'Below-the-Line Crew\', \'Visual Effects\', \'Audio Post-Production\').']
  cost_line_type varchar [note: 'High-level classification of the cost line distinguishing above-the-line (ATL) creative costs (writers, directors, producers, talent) from below-the-line (BTL) technical and crew costs, post-production, contingency, and overhead.']
  created_timestamp timestamp [note: 'Timestamp when this budget record was first created in the source system or ingested into the Databricks Silver Layer. Supports audit trail and data lineage.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code in which all monetary amounts on this budget record are denominated (e.g., USD, GBP, EUR).']
  exchange_rate decimal(12,6) [note: 'The foreign exchange rate applied to convert this budget record\'s currency to the production\'s reporting currency at the time of budget approval or revision.']
  fiscal_period varchar [note: 'The fiscal period (month number 1–12 or 1–16 for special periods) within the fiscal year to which this budget line is assigned in SAP CO.']
  fiscal_year varchar [note: 'The four-digit fiscal year to which this budget record belongs in the SAP S/4HANA CO controlling area, used for annual financial planning and SOX reporting.']
  forecast_amount decimal(18,2) [note: 'Latest estimate of the total cost expected to be incurred for this cost category by production completion, incorporating actuals to date and projected remaining spend.']
  is_greenlight_budget boolean [note: 'Indicates whether this budget record represents the original greenlight-approved budget for the production, as distinct from subsequent revisions. The greenlight budget is the primary financial authorization baseline.']
  is_locked boolean [note: 'Indicates whether this budget version has been locked and is no longer open for modification. A locked budget serves as the immutable financial baseline for variance reporting.']
  notes varchar [note: 'Free-text field for additional commentary, assumptions, or clarifications associated with this budget record, entered by the production finance team.']
  period_end_date date [note: 'The end date of the fiscal or production period covered by this budget record. Defines the temporal boundary for cost accumulation and variance measurement.']
  period_start_date date [note: 'The start date of the fiscal or production period covered by this budget record, aligning to the SAP fiscal year/period structure.']
  production_phase varchar [note: 'The production lifecycle phase to which this budget line is attributed (e.g., Development, Pre-Production, Principal Photography, Post-Production, Delivery). Enables phase-level budget tracking.']
  reporting_currency_code varchar [note: 'ISO 4217 three-letter code for the group reporting currency to which all amounts are translated for consolidated financial reporting (e.g., USD for a US-headquartered broadcaster).']
  revised_amount decimal(18,2) [note: 'The most recently revised budget amount for this cost category following a formal budget change request. Null if no revision has been approved since the original budget.']
  sap_cost_object_code varchar [note: 'The SAP S/4HANA CO cost object identifier (Internal Order number or WBS Element ID) that anchors this budget record to the controlling module for financial reconciliation.']
  sap_wbs_element varchar [note: 'SAP Project System Work Breakdown Structure element code that maps this budget line to a specific phase or deliverable within the production project hierarchy (e.g., PRE-PROD, PRINCIPAL, POST-PROD).']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to this budget record in the source system or Silver Layer. Used for incremental load detection and change data capture.']
  variance_amount decimal(18,2) [note: 'The difference between the approved (or revised) budget amount and the sum of actual costs plus commitments. A negative value indicates an over-budget condition; positive indicates underspend.']
  version varchar [note: 'Version label of this budget record, distinguishing the original greenlight budget from subsequent revisions and the locked final version. Supports budget version history tracking.']
  version_number varchar [note: 'Sequential integer version number of this budget record (e.g., 1 = original, 2 = first revision). Enables ordered version history and audit trail.']

  Note: 'Detailed production budget record aligned to the SAP S/4HANA CO (Controlling) module. Captures above-the-line and below-the-line cost categories, approved budget amounts by cost category, revised budget amounts, actual costs to date, purchase order commitments, variance amounts, currency, budget version, and approval status. Serves as the financial control baseline for a production project. Links to SAP cost centers and WBS elements for financial reconciliation.'
}

Table production.budget_line {
  budget_line_id varchar [pk, note: 'Unique surrogate identifier for each individual budget line item within a production budget. Primary key for this entity.']
  budget_id varchar [note: 'Reference to the parent production budget document that contains this line item. A production may have multiple budget versions (e.g., greenlight, revised, final).']
  campaign_id varchar [note: 'Foreign key linking to sales.campaign. Business justification: Budget lines track advertiser-funded production costs for branded content and product integrations. Business process: advertiser co-production cost allocation, campaign-funded production expense track; FK references sales domain entity; namespace reconciled from advertising context']
  partner_id varchar [note: 'Reference to the vendor, supplier, or payee associated with this budget line item (e.g., VFX house, location owner, equipment rental company, music licensor).']
  production_episode_id varchar [note: 'Foreign key linking to production.production_episode. Business justification: Budget lines can be episode-specific in series productions (e.g., VFX costs for Episode 3). budget_line already has a cross-domain content_episode_id → content.content_episode, but a direct in-domain ']
  production_project_id varchar [note: 'Reference to the parent production project to which this budget line belongs. Links the line item to its overarching production context.']
  royalty_rule_id varchar [note: 'Foreign key linking to rights.royalty_rule. Business justification: Residuals budgeting process: budget lines for SAG/WGA residuals and talent royalties are calculated directly from royalty rules. Finance teams must link each royalty cost line to its governing royalty']
  account_code varchar [note: 'Industry-standard production account code identifying the cost category within the budget (e.g., 1100 for Above-the-Line Talent, 2200 for Camera Equipment). Follows standard production accounting chart of accounts (e.g., AICP, Producers Guild).']
  accrued_amount decimal(18,2) [note: 'Costs accrued for work performed or services received but not yet invoiced or formally committed. Supports period-end financial close and accurate cost-to-complete reporting.']
  actual_amount decimal(18,2) [note: 'Total actual costs incurred and posted against this budget line to date, sourced from SAP FI invoice postings and payroll actuals. Used for variance analysis against budgeted and committed amounts.']
  approved_timestamp timestamp [note: 'Date and time when this budget line was formally approved by the authorized approver. Provides an audit trail for financial governance and SOX compliance.']
  budgeted_amount decimal(18,2) [note: 'Original approved budget amount for this line item as established at greenlight or budget approval. Represents the planned cost baseline against which actuals and commitments are measured.']
  committed_amount decimal(18,2) [note: 'Total value of purchase orders, contracts, or binding agreements raised against this budget line but not yet invoiced. Represents financial obligations that reduce available budget.']
  contingency_pct decimal(7,4) [note: 'Contingency percentage applied to this budget line to cover unforeseen cost overruns. Typically 5–15% for production lines. Contributes to the overall production contingency reserve.']
  contract_reference varchar [note: 'Reference number of the underlying contract or deal memo associated with this budget line (e.g., talent agreement, location agreement, VFX services contract). Links to Rightsline or SAP contract management.']
  cost_category varchar [note: 'High-level cost category classifying the budget line within the production budget structure. Above-the-line covers creative talent (writers, directors, producers, cast); below-the-line covers crew, equipment, locations, and production services. [ENUM-REF-CANDIDATE: above_the_line|below_the_line|post_production|music_licensing|vfx|marketing|overhead|contingency|insurance|legal — promote to reference product]']
  cost_sub_category varchar [note: 'Granular sub-classification within the cost category (e.g., \'Cast Fees\', \'Location Fees\', \'Equipment Rental\', \'VFX Compositing\', \'Music Synchronization License\', \'Post-Production Labor\'). Enables detailed variance analysis at the sub-category level.']
  created_timestamp timestamp [note: 'Date and time when this budget line record was first created in the system. Provides audit trail for record provenance and financial governance.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts on this budget line (e.g., USD, GBP, EUR). Supports multi-currency production budgets for international co-productions.']
  forecast_amount decimal(18,2) [note: 'Estimate at Completion (EAC) for this budget line, representing the current best estimate of total cost when the line item is fully complete. Combines actuals to date with estimate to complete.']
  fringe_rate_pct decimal(7,4) [note: 'Percentage applied to labor costs on this line to account for employer fringe benefits (payroll taxes, pension contributions, health insurance, residuals). Standard production accounting practice for above-the-line and below-the-line labor lines.']
  gl_account_code varchar [note: 'SAP S/4HANA General Ledger account number to which this budget line maps for financial reporting and cost center allocation. Enables reconciliation between production budgets and enterprise financial statements.']
  is_above_the_line boolean [note: 'Flag indicating whether this budget line is classified as above-the-line (ATL) cost, covering creative talent such as writers, directors, producers, and principal cast. False indicates below-the-line (BTL) cost.']
  is_union_labor boolean [note: 'Flag indicating whether this budget line involves union or guild labor subject to collective bargaining agreements (DGA, SAG-AFTRA, WGA, IATSE). Drives fringe rate calculations and residuals obligations.']
  line_description varchar [note: 'Free-text description of the specific cost item represented by this budget line (e.g., \'Lead Actor Day Rate — Week 3\', \'Steadicam Rental — Principal Photography\', \'Dolby Atmos Mix — Episode 4\').']
  line_number varchar [note: 'Sequential line number within the parent budget document, used for ordering and referencing individual line items in budget reports and purchase orders.']
  line_status varchar [note: 'Current lifecycle status of the budget line item, tracking its progression from initial draft through approval, commitment, invoicing, and payment. Drives workflow routing and financial reporting. [ENUM-REF-CANDIDATE: draft|approved|committed|invoiced|paid|cancelled|on_hold — 7 candidates stripped; promote to reference product]']
  notes varchar [note: 'Free-text notes or comments entered by the production accountant or line producer providing additional context, assumptions, or justification for this budget line item.']
  production_phase varchar [note: 'Phase of the production workflow during which this cost is incurred. Enables phase-based cost tracking and cash flow forecasting across the full production lifecycle from development through delivery.']
  purchase_order_number varchar [note: 'SAP purchase order number raised against this budget line for vendor commitments. Links the budget line to the formal procurement document and enables three-way matching (PO, goods receipt, invoice).']
  quantity decimal(12,4) [note: 'Quantity of units associated with this budget line (e.g., number of shoot days, number of crew members, number of VFX shots, hours of post-production labor). Combined with unit_rate to derive budgeted amount.']
  revised_budgeted_amount decimal(18,2) [note: 'Most recent approved revision to the budgeted amount, reflecting approved change orders, scope changes, or budget transfers. Null if no revision has been approved since original budget.']
  shoot_date_end date [note: 'Planned or actual end date for the activity or service associated with this budget line. Used for scheduling, resource allocation, and cost accrual period determination.']
  shoot_date_start date [note: 'Planned or actual start date for the activity or service associated with this budget line (e.g., first day of location shoot, start of VFX work, commencement of post-production labor).']
  tax_credit_eligible boolean [note: 'Flag indicating whether this budget line qualifies for production tax credits or incentives (e.g., UK High-End TV Tax Relief, US state film tax credits). Enables automated calculation of eligible spend for tax credit claims.']
  unit_of_measure varchar [note: 'Unit of measure for the quantity field (e.g., day, hour, week, flat_fee, shot, reel, license). Defines how the quantity is counted for rate-based cost calculations. [ENUM-REF-CANDIDATE: day|hour|week|flat_fee|shot|reel|license|unit — 8 candidates stripped; promote to reference product]']
  unit_rate decimal(18,4) [note: 'Rate per unit of measure for this budget line (e.g., daily rate for a crew member, hourly rate for facility hire, per-shot rate for VFX). Multiplied by quantity to derive the budgeted amount.']
  updated_timestamp timestamp [note: 'Date and time when this budget line record was most recently modified. Supports incremental data loading in the Databricks Silver Layer and change data capture from SAP S/4HANA.']
  wbs_element varchar [note: 'SAP Work Breakdown Structure element code that hierarchically positions this budget line within the production project plan (e.g., PRD-2024-001.3.2.1 for a specific post-production task).']

  Note: 'Individual line-item within a production budget, representing a specific cost category or account code (e.g., cast fees, location fees, equipment rental, VFX, music licensing, post-production labor). Captures account code, cost category, sub-category, vendor or payee, budgeted amount, committed amount, actual amount, episode or segment allocation, and SAP G/L account reference. Enables granular cost tracking and variance analysis at the line-item level.'
}

Table production.crew_assignment {
  crew_assignment_id varchar [pk, note: 'Unique surrogate identifier for a crew assignment record in the production domain. Primary key for the crew_assignment data product.']
  loan_out_partner_id varchar [note: 'Foreign key linking to partner.partner_partner. Business justification: Crew members often work through loan-out companies or talent agencies (partners). Linking enables tracking all crew supplied by that partner, payment processing to the loan-out entity, union/guild com']
  production_episode_id varchar [note: 'Foreign key linking to production.production_episode. Business justification: Crew can be assigned to specific episodes within a series production. Optional FK (nullable) — crew may be assigned at project level or episode level. Enables episode-specific crew tracking for episod']
  production_project_id varchar [note: 'Reference to the production project to which this crew member is assigned. Links the assignment to the master production record.']
  shoot_schedule_id varchar [note: 'Foreign key linking to production.shoot_schedule. Business justification: Crew assignments are made for specific shoot days — a crew member\'s call time, turnaround hours, and meal penalty eligibility are all tied to a specific shoot schedule day. Adding shoot_schedule_id to']
  talent_profile_id varchar [note: 'Reference to the crew member\'s master record in the talent domain. Identifies the individual below-the-line crew member being assigned.']
  assignment_number varchar [note: 'Externally-known business identifier for this crew assignment, used in deal memos, call sheets, and payroll processing. Format: CA-{YEAR}-{SEQUENCE}.']
  assignment_status varchar [note: 'Current lifecycle state of the crew assignment. Drives payroll eligibility, call sheet inclusion, and production roster reporting. Values: pending (offer extended, not yet accepted), confirmed (deal memo signed), active (currently on set/in production), on_hold (temporarily suspended), completed (assignment concluded), cancelled (assignment terminated before start).']
  background_check_status varchar [note: 'Status of the crew member\'s background check for this production assignment. Required for productions involving minors (COPPA compliance) or access to secure facilities. Values: not_required, pending, cleared, failed, expired.']
  box_rental_rate decimal(18,4) [note: 'Daily or weekly rate paid to the crew member for the rental of their personal tool box or specialized equipment package (e.g., makeup artist\'s kit, wardrobe supervisor\'s supplies). Distinct from kit_rental_rate which covers technical equipment.']
  contracted_rate decimal(18,4) [note: 'The agreed compensation rate for this crew assignment, expressed in the applicable deal_type unit (per day, per week, or flat total). Stored in the production\'s base currency. Used for budget tracking and payroll processing in SAP S/4HANA.']
  created_timestamp timestamp [note: 'The date and time when this crew assignment record was first created in the system. Used for audit trail, data lineage, and compliance reporting. Conforms to ISO 8601 format with timezone offset.']
  credit_name varchar [note: 'The name as it should appear in the production\'s end credits, which may differ from the crew member\'s legal name (e.g., stage name, preferred professional name). Sourced from the deal memo credit clause.']
  credit_position varchar [note: 'Specifies where the crew member\'s credit appears in the production: main_title (opening credits), end_title (closing credits), both, or none (no contractual credit obligation). Drives post-production credit sequence assembly.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for the contracted_rate (e.g., USD, GBP, EUR). Required for international co-productions where crew may be contracted in local currencies.']
  dalet_workflow_reference varchar [note: 'The workflow instance identifier in Dalet Galaxy that corresponds to this crew assignment\'s production workflow. Enables traceability between the HR/payroll record and the media asset management workflow orchestration system.']
  deal_type varchar [note: 'The compensation structure type for this crew assignment. Daily = per-day rate; Weekly = per-week rate with guaranteed days; Flat = fixed total fee for the engagement; Run of Show = engaged for the full production duration; Episodic = per-episode rate for series production.']
  department varchar [note: 'The production department to which the crew member belongs for this assignment (e.g., camera, grip, electric, art, wardrobe, hair/makeup, post-production, sound, VFX). Drives crew call sheet grouping and budget cost center allocation. [ENUM-REF-CANDIDATE: camera|grip|electric|art|wardrobe|hair_makeup|post_production|sound|vfx|production — 10 candidates stripped; promote to reference product]']
  end_date date [note: 'The contractually agreed last day of work for this crew assignment. Nullable for open-ended or rolling assignments. Used for wrap scheduling and final payroll processing.']
  filming_location_country varchar [note: 'ISO 3166-1 alpha-3 country code for the primary filming location where this crew member will work. Determines applicable labor laws, tax treaties, work permit requirements, and per diem rates.']
  guaranteed_days varchar [note: 'The minimum number of work days guaranteed to the crew member under this assignment deal, regardless of actual production schedule. Relevant for weekly and episodic deal types. Used for take-or-pay liability calculation.']
  kit_rental_rate decimal(18,4) [note: 'Daily or weekly rate paid to the crew member for the rental of their personal professional equipment (kit) used on the production (e.g., camera operator\'s lens kit, sound mixer\'s equipment package). Common in below-the-line crew deals.']
  last_updated_timestamp timestamp [note: 'The date and time when this crew assignment record was most recently modified. Used for change data capture (CDC), audit trail, and Silver layer incremental processing in the Databricks Lakehouse.']
  meal_penalty_eligible boolean [note: 'Indicates whether this crew member is entitled to meal penalty payments if the production fails to provide a meal break within the contractually required interval (typically 6 hours under IATSE/DGA agreements). Drives production scheduling compliance.']
  overtime_eligible boolean [note: 'Indicates whether this crew member is eligible for overtime pay under their union/guild agreement or applicable labor law. True = eligible for overtime; False = flat deal or exempt classification. Drives payroll calculation logic.']
  overtime_rate_multiplier decimal(5,2) [note: 'The multiplier applied to the base contracted_rate for overtime hours (e.g., 1.5 for time-and-a-half, 2.0 for double-time). Applicable only when overtime_eligible is True. Sourced from the applicable union/guild agreement.']
  per_diem_rate decimal(18,4) [note: 'Daily allowance paid to the crew member for meals and incidental expenses when working away from their home base location. Rate varies by filming location and union agreement. Used for production cost budgeting.']
  production_company varchar [note: 'The legal name of the production company or entity that is the employer of record for this crew assignment. Relevant for co-productions where multiple entities may employ different crew members. Used for payroll and tax reporting.']
  residuals_eligible boolean [note: 'Indicates whether this crew member is entitled to residual payments when the production is reused, syndicated, or distributed on additional platforms (e.g., streaming, international broadcast). Residuals are governed by DGA, IATSE, and SAG-AFTRA agreements.']
  role_title varchar [note: 'The specific production role or job title assigned to the crew member (e.g., Director, Director of Photography, Gaffer, Script Supervisor, Editor, Colorist, VFX Supervisor, Sound Mixer, Key Grip, Best Boy). [ENUM-REF-CANDIDATE: director|director_of_photography|gaffer|script_supervisor|editor|colorist|vfx_supervisor|sound_mixer|key_grip|best_boy|production_designer|costume_designer — promote to reference product]']
  safety_training_certified boolean [note: 'Indicates whether the crew member has completed the required on-set safety training certification for this production (e.g., OSHA safety, COVID-19 protocols, stunt safety). Required for insurance compliance and production liability management.']
  sap_personnel_action_code varchar [note: 'The personnel action number in SAP S/4HANA HR that corresponds to this crew assignment. Used for payroll processing, benefits enrollment, and HR compliance reporting. Enables reconciliation between the production data product and the ERP system of record.']
  scheduled_days varchar [note: 'The total number of work days currently scheduled for this crew member on the production, as reflected in the current production schedule. May differ from guaranteed_days if the schedule changes.']
  start_date date [note: 'The contractually agreed first day of work for this crew assignment. Used for payroll calculation, permit verification, and production schedule alignment.']
  travel_allowance decimal(18,4) [note: 'Fixed or estimated travel reimbursement amount for this crew assignment, covering transportation costs to and from the filming location. Distinct from per_diem_rate which covers daily living expenses.']
  turnaround_hours decimal(5,2) [note: 'The minimum number of hours required between the end of one work day and the start of the next for this crew member, as stipulated by their union/guild agreement (e.g., 10 hours for IATSE, 12 hours for DGA). Violation triggers turnaround penalty payments.']
  union_guild_affiliation varchar [note: 'The labor union or guild to which the crew member belongs for this assignment. Determines applicable minimum rates, working conditions, residuals obligations, and benefit fund contributions. DGA = Directors Guild of America; IATSE = International Alliance of Theatrical Stage Employees; SAG-AFTRA = Screen Actors Guild–American Federation of Television and Radio Artists; WGA = Writers Guild of America; NABET = National Association of Broadcast Employees and Technicians; Teamsters = International Brotherhood of Teamsters. [ENUM-REF-CANDIDATE: DGA|IATSE|SAG-AFTRA|WGA|NABET|Teamsters|non_union — 7 candidates stripped; promote to reference product]']
  work_permit_expiry_date date [note: 'The expiration date of the crew member\'s work permit or visa authorization. Used to trigger renewal alerts and ensure continuous legal work authorization throughout the assignment period.']
  work_permit_number varchar [note: 'The official government-issued work permit or visa authorization number for the crew member in the production jurisdiction. Nullable when work_permit_required is False. Required for compliance audits and production insurance.']
  work_permit_required boolean [note: 'Indicates whether a work permit or visa authorization is required for this crew member to legally work on this production in the filming jurisdiction. True = permit required; False = no permit required (domestic/citizen crew). Triggers compliance workflow in HR.']

  Note: 'Assignment of a crew member to a specific production project in a defined role and department. Captures crew role (director, DP, gaffer, script supervisor, editor, colorist, VFX supervisor, sound mixer), department (camera, grip, electric, art, wardrobe, hair/makeup, post-production), start date, end date, deal type (daily, weekly, flat), contracted rate, union or guild affiliation (DGA, IATSE, SAG-AFTRA), overtime eligibility, work permit status, and assignment status. References the talent domain for the crew members master record. Tracks the full below-the-line crew roster for a production.'
}

Table production.production_episode {
  production_episode_id varchar [pk, note: 'Unique surrogate identifier for the production episode record in the lakehouse Silver layer. Serves as the primary key for all downstream joins and lineage tracking.']
  accessibility_obligation_id varchar [note: 'Foreign key linking to compliance.accessibility_obligation. Business justification: Episodes must satisfy specific accessibility obligations based on air date, daypart, and network (prime-time episodes require FCC captioning, children\'s episodes require CVAA descriptive video). Broad']
  broadcast_license_id varchar [note: 'Foreign key linking to compliance.broadcast_license. Business justification: Episodes are produced under specific broadcast licenses (local news episode authorized by station license, network show references originating station license). Broadcasters track which license covers']
  compliance_content_rating_id varchar [note: 'Foreign key linking to compliance.content_rating. Business justification: Episodes require content ratings before broadcast/distribution. Core regulatory workflow linking production output to compliance certification. Drives scheduling decisions and parental control metadat']
  content_episode_id varchar
  delivery_channel_id varchar [note: 'Foreign key linking to distribution.delivery_channel. Business justification: Each production episode is mastered to a specific delivery channel\'s technical specifications (resolution, audio format, aspect ratio, bitrate). Operations teams use this link to pull channel delivery']
  grant_id varchar [note: 'Foreign key linking to rights.grant. Business justification: Episode-level rights grant tracking: each production episode is produced to fulfill a specific exploitation rights grant (theatrical, SVOD, broadcast). This link supports residuals calculation, exploi']
  ott_platform_id varchar [note: 'Foreign key linking to distribution.ott_platform. Business justification: Individual episodes may require COPPA declarations independent of project-level status when content varies by episode. Essential for mixed-audience series with occasional child-directed episodes.']
  project_id varchar [note: 'Reference to the parent production project (series, mini-series, anthology, or episodic documentary) to which this episode belongs. Establishes the episode-to-project hierarchy.']
  regulatory_filing_id varchar [note: 'Foreign key linking to compliance.regulatory_filing. Business justification: Episodes trigger specific regulatory filings (children\'s programming reports reference specific episodes, political programming disclosures reference candidate appearances, quarterly programming repor']
  script_id varchar [note: 'Foreign key linking to production.script. Business justification: Episodes are based on specific scripts. Strong content relationship — script is the source document for episode production. FK links episode to the locked script version used for production.']
  sponsorship_campaign_id varchar [note: 'Foreign key linking to sales.campaign. Business justification: Episodes may have product placement, sponsorship integrations, or branded content campaigns. Broadcasting requires tracking sponsorship obligations, disclosure requirements, and campaign-specific cont']
  sweeps_period_id varchar [note: 'Foreign key linking to audience.sweeps_period. Business justification: Episodes are designated as sweeps programming (stunting) for specific sweeps periods. Programming and production teams track which episodes are slated for sweeps to coordinate scheduling, ratings stra']
  actual_cost_usd decimal(18,2) [note: 'Total actual production cost incurred for this episode in US dollars, as recorded in SAP S/4HANA. Used for budget variance analysis, EBITDA reporting, and production cost per minute calculations.']
  actual_delivery_date date [note: 'Date on which the completed episode master was actually delivered to the distributor, broadcaster, or platform. Compared against scheduled_delivery_date for SLA compliance and penalty assessment.']
  actual_running_time_sec varchar [note: 'Final delivered running time of the episode in seconds as measured from the completed master file. May differ from target due to editorial decisions made during post-production. Used for playout scheduling reconciliation and delivery compliance verification.']
  approved_budget_usd decimal(18,2) [note: 'Total approved production budget for this episode in US dollars, as sanctioned at greenlight. Used for budget vs. actual variance analysis in SAP S/4HANA CO and financial reporting under SOX compliance.']
  audio_language_code varchar [note: 'ISO 639-2 three-letter language code for the primary audio track of this episode. Used for distribution rights matching, subtitle/dubbing workflow triggering, and EPG metadata population.']
  audio_mix_completion_date date [note: 'Date on which the final audio mix (including dialogue, music, and effects) was completed and approved. Prerequisite for final mastering and delivery. Tracked as a post-production milestone in Dalet Galaxy.']
  closed_captioning_compliant boolean [note: 'Indicates whether this episode meets FCC closed captioning requirements (47 CFR Part 79) and Ofcom subtitling standards. Required for broadcast clearance and regulatory compliance reporting.']
  color_grade_completion_date date [note: 'Date on which color grading (digital color correction and finishing) was completed and approved. Required before final mastering and transcode for delivery. Tracked as a post-production milestone in Dalet Galaxy.']
  content_rating varchar [note: 'Audience content rating assigned to this episode per the TV Parental Guidelines system (US) or equivalent regulatory body. Required for EPG metadata, DAI ad targeting restrictions, and COPPA compliance for children\'s content.']
  content_type varchar [note: 'Broad classification of the episode content format. Determines applicable production workflows, rights frameworks, talent residual calculations, and compliance requirements (e.g., COPPA for children\'s content). [ENUM-REF-CANDIDATE: scripted|unscripted|documentary|news|sports|animation|live_event — promote to reference product]']
  created_timestamp timestamp [note: 'Timestamp when this production episode record was first created in the system. Used for audit trail, data lineage, and production workflow initiation tracking. Conforms to ISO 8601 extended format.']
  delivery_date date [note: 'Contractually committed or operationally planned date by which the completed episode master must be delivered to the distributor, broadcaster, or platform. Used for SLA tracking and rights window activation in Rightsline.']
  director_name varchar [note: 'Full name of the credited director for this episode. Used for DGA residuals calculation, talent contract compliance, and creative attribution in production records.']
  eidr_code varchar [note: 'EIDR content identifier for this episode, enabling interoperability across supply chain partners, distributors, and rights management systems. Registered with the Entertainment Identifier Registry.']
  episode_code varchar [note: 'Internal production code assigned by the production team to uniquely identify this episode within the production management system (e.g., Dalet Galaxy asset code). Used for workflow routing, asset tagging, and facility booking references.']
  episode_number varchar [note: 'Sequential production episode number within the season or series. Used for scheduling, EPG metadata, and audience tracking. Corresponds to the broadcast order number.']
  first_air_date date [note: 'Date on which this episode first aired or was made available to audiences on any platform (linear broadcast, VOD, OTT). Marks the start of the content windowing lifecycle and triggers residuals calculation in Rightsline.']
  greenlight_date date [note: 'Date on which executive approval (greenlight) was granted to proceed with production of this episode. Marks the official start of the production lifecycle and triggers budget release in SAP S/4HANA.']
  isan varchar [note: 'Globally unique identifier for this episode as registered with the ISAN International Agency. Used for rights clearance, royalty tracking, and cross-platform content identification. Conforms to ISO 15706-2.']
  master_format varchar [note: 'Technical format specification of the delivered episode master file (e.g., UHD HDR, HD 1080p). Determines transcode profiles required for multi-platform distribution and CDN delivery via Akamai.']
  picture_lock_date date [note: 'Date on which the final edited picture was locked, freezing all visual edits. Triggers downstream post-production workflows including VFX, color grading, and audio mixing. Critical milestone for delivery scheduling.']
  production_company varchar [note: 'Name of the production company or studio responsible for producing this episode. Used for co-production agreements, rights attribution, and financial reconciliation in SAP S/4HANA.']
  production_status varchar [note: 'Current lifecycle stage of the episode within the end-to-end production workflow. Drives workflow routing in Dalet Galaxy and milestone reporting to production management. [ENUM-REF-CANDIDATE: development|pre_production|principal_photography|post_production|picture_lock|delivered|archived — promote to reference product]']
  script_lock_date date [note: 'Date on which the final shooting script was locked, freezing all creative changes. Triggers pre-production scheduling, crew assignments, and facility bookings. Key milestone for production planning.']
  shoot_country_code varchar [note: 'ISO 3166-1 alpha-3 country code for the primary country where principal photography was conducted. Used for production tax credit eligibility, co-production treaty compliance, and content origin classification.']
  shoot_end_date date [note: 'Scheduled or actual end date of principal photography (picture wrap) for this episode. Used to confirm transition to post-production and trigger post-production workflow initiation in Dalet Galaxy.']
  shoot_location varchar [note: 'Primary geographic location where principal photography for this episode was conducted. Used for production tax credit eligibility, location permit compliance, and production logistics reporting.']
  shoot_start_date date [note: 'Scheduled or actual start date of principal photography for this episode. Used for crew scheduling, facility booking, and production budget burn-rate tracking in SAP S/4HANA.']
  showrunner_name varchar [note: 'Full name of the showrunner (executive producer with creative oversight) responsible for this episode. Key accountability reference for production governance and editorial decisions.']
  subtitle_languages varchar [note: 'Comma-separated list of ISO 639-2 three-letter language codes for subtitle tracks available in the delivered master. Used for accessibility compliance (FCC closed captioning rules), distribution rights, and EPG metadata.']
  target_running_time_sec varchar [note: 'Planned editorial running time of the episode in seconds, excluding commercial breaks. Used for scheduling slot allocation, playout automation configuration in Ericsson MediaFirst, and delivery specification compliance.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to this production episode record. Used for incremental data pipeline processing, change data capture, and audit compliance in the Databricks Silver layer.']
  vfx_completion_date date [note: 'Date on which all visual effects shots were completed and approved for integration into the picture lock. Tracked as a post-production milestone. Null if the episode contains no VFX work.']
  writer_name varchar [note: 'Full name of the credited writer(s) for this episode. Used for residuals calculation, WGA/guild compliance reporting, and rights attribution in Rightsline.']

  Note: 'Master record for an individual episode, segment, or installment within a production project (series, mini-series, anthology, or episodic documentary). Captures episode number, episode title, season number, running time target, production status, writer, director, script lock date, picture lock date, audio mix completion date, delivery date, and ISAN episode identifier. Acts as the granular production unit below the project level for episodic content.'
}

Table production.script {
  script_id varchar [pk, note: 'Unique identifier for the production script or screenplay record. Primary key.']
  content_episode_id varchar [note: 'Foreign key linking to content.content_episode. Business justification: Each TV episode script maps to a specific content episode for WGA registration, script lock tracking, and revision management per episode. script→title exists but does not identify the episode. Produc']
  production_project_id varchar [note: 'Reference to the parent production project or episode to which this script belongs.']
  regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: Scripts must comply with specific regulatory obligations (FCC indecency rules, COPPA children\'s programming requirements, political content disclosure rules). Broadcasters track which obligations appl']
  underlying_rights_holder_id varchar [note: 'Foreign key linking to rights.rights_holder. Business justification: Scripts are often based on underlying IP owned by rights holders (novels, plays, life rights, true stories, existing franchises). Real business need: tracking the rights holder of the underlying IP be']
  approval_date date [note: 'The date on which the script was officially approved for production.']
  approved_by varchar [note: 'The name or identifier of the individual or role who approved the script for production.']
  confidentiality_level varchar [note: 'The confidentiality classification of the script document (public, internal, confidential, restricted).']
  copyright_holder varchar [note: 'The legal entity or individual who holds the copyright to the script.']
  copyright_year varchar [note: 'The year in which the script copyright was established or registered.']
  created_timestamp timestamp [note: 'The timestamp when this script record was first created in the system.']
  dalet_document_reference varchar [note: 'The unique document identifier or reference in the Dalet Galaxy Media Asset Management (MAM) system linking this script record to the digital script file.']
  distribution_restriction varchar [note: 'Any restrictions or limitations on the distribution or sharing of the script (e.g., internal use only, NDA required).']
  draft_type varchar [note: 'The classification of the script draft stage (outline, first draft, revised draft, shooting script, post-production script, final draft).']
  estimated_runtime_minutes varchar [note: 'The estimated runtime of the production in minutes based on the script length and pacing.']
  file_format varchar [note: 'The digital file format of the script document (PDF, DOCX, FDX, FOUNTAIN, TXT).']
  file_size_mb decimal(10,2) [note: 'The size of the script file in megabytes.']
  format varchar [note: 'The production format for which the script is intended (feature film, television episode, miniseries, web series, documentary, commercial, short film). [ENUM-REF-CANDIDATE: feature film|television episode|miniseries|web series|documentary|commercial|short film — 7 candidates stripped; promote to reference product]']
  genre varchar [note: 'The genre or category of the script (e.g., drama, comedy, thriller, documentary).']
  language varchar [note: 'The primary language in which the script is written (e.g., English, Spanish, French).']
  lock_date date [note: 'The date on which the script was locked and finalized for production.']
  lock_status boolean [note: 'Indicates whether the script is locked for production (true) or still open for revisions (false).']
  notes varchar [note: 'General notes, comments, or annotations related to the script for production reference.']
  page_count varchar [note: 'The total number of pages in the script document.']
  revision_date date [note: 'The date of the most recent revision or update to the script.']
  revision_notes varchar [note: 'Notes or comments describing the changes made in the current revision of the script.']
  scene_count varchar [note: 'The total number of scenes defined in the script.']
  script_number varchar [note: 'The externally-known unique identifier or code assigned to this script for production tracking and reference purposes.']
  script_status varchar [note: 'Current lifecycle status of the script (draft, in review, approved, locked, archived, rejected).']
  updated_timestamp timestamp [note: 'The timestamp when this script record was last updated or modified.']
  version_number varchar [note: 'The version or revision number of the script (e.g., 1.0, 2.3, Final).']
  wga_registration_number varchar [note: 'The WGA registration number assigned to this script for copyright and intellectual property protection.']
  writer_credits varchar [note: 'The names and credits of the writer(s) who authored or contributed to the script.']

  Note: 'Master record for a production script or screenplay associated with a production project or episode. Captures script title, version number, draft type (outline, first draft, revised draft, shooting script, post-production script), writer credits, WGA registration number, page count, script lock status, lock date, language, and Dalet Galaxy document reference. Tracks the full script revision history and serves as the authoritative script record for production and rights purposes.'
}

Table production.post_production_task {
  post_production_task_id varchar [pk, note: 'Unique identifier for the post-production task within the Dalet Galaxy workflow orchestration pipeline.']
  accessibility_obligation_id varchar [note: 'Foreign key linking to compliance.accessibility_obligation. Business justification: Specific post-production tasks implement accessibility obligations (closed captioning task satisfies FCC captioning obligation, audio description task satisfies CVAA obligation). Broadcasters track wh']
  budget_line_id varchar [note: 'Foreign key linking to production.budget_line. Business justification: Post-production tasks incur costs (estimated_cost_amount, actual_cost_amount on the task record) that should be traceable to a specific budget line for financial control. Adding budget_line_id to post']
  campaign_id varchar [note: 'Foreign key linking to sales.campaign. Business justification: Post-production tasks create campaign-specific deliverables: promotional cuts, trailers, teasers, social media clips, advertiser-approved versions. Workflow management requires linking tasks to the ca']
  clearance_request_id varchar [note: 'Foreign key linking to rights.clearance_request. Business justification: Post-production clearance tracking: post-production tasks involving music sync, archive footage, VFX stock elements, and third-party content require rights clearance. Linking post_production_task to c']
  content_version_id varchar [note: 'Foreign key linking to content.version. Business justification: Post-production tasks (editing, color, audio mix) create specific content versions. Critical for tracking which production tasks generated which distributable versions, version lineage, and linking pr']
  deliverable_id varchar [note: 'Foreign key linking to production.deliverable. Business justification: Post-production tasks produce deliverables. Optional FK (nullable) — not all tasks produce final deliverables (intermediate tasks). When populated, links task output to contractual/operational deliver']
  parent_task_post_production_task_id varchar [note: 'Reference to the parent post-production task if this task is a sub-task or dependent task in a hierarchical workflow.']
  partner_id varchar [note: 'Reference to the external vendor or post-production facility assigned to perform this task, if outsourced.']
  production_episode_id varchar [note: 'Foreign key linking to production.vfx_shot. Business justification: VFX-specific post-production tasks (compositing, rendering, etc.) are shot-specific. Optional FK (nullable) — only VFX tasks populate this. Enables linking Dalet workflow tasks to VFX shot tracking.']
  production_project_id varchar [note: 'Reference to the parent production project that this post-production task belongs to.']
  script_id varchar [note: 'Foreign key linking to production.script. Business justification: Post-production tasks reference scripts for scene/dialogue context. Optional FK (nullable) — provides editorial context for tasks. Enables linking task to script version for continuity.']
  actual_completion_timestamp timestamp [note: 'Actual date and time when the post-production task was completed and submitted for review or approval.']
  actual_cost_amount decimal(15,2) [note: 'Actual cost incurred for completing this post-production task, used for budget variance analysis.']
  actual_duration_hours decimal(8,2) [note: 'Actual number of hours spent completing the post-production task, used for cost tracking and performance analysis.']
  actual_start_timestamp timestamp [note: 'Actual date and time when work on the post-production task commenced.']
  approved_timestamp timestamp [note: 'Date and time when the task output was formally approved and authorized to proceed to the next workflow stage.']
  created_timestamp timestamp [note: 'Date and time when this post-production task record was first created in the workflow system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts associated with this task.']
  dalet_workflow_task_reference varchar [note: 'External system identifier from Dalet Galaxy workflow orchestration system for this specific task instance.']
  dependency_type varchar [note: 'Type of scheduling dependency relationship this task has with its predecessor tasks in the workflow.']
  estimated_cost_amount decimal(15,2) [note: 'Budgeted cost for completing this post-production task, including labor, equipment, and vendor fees.']
  estimated_duration_hours decimal(8,2) [note: 'Planned number of hours required to complete the post-production task, used for resource planning and scheduling.']
  output_media_path varchar [note: 'File system path or MAM location where the completed output files or deliverables from this task are stored.']
  priority varchar [note: 'Business priority level assigned to the task, determining scheduling and resource allocation urgency.']
  qc_pass_flag boolean [note: 'Indicator of whether the task output passed quality control review on first submission without requiring revisions.']
  rejection_reason varchar [note: 'Explanation of why the task output was rejected during review, requiring rework or revision.']
  review_notes varchar [note: 'Feedback, comments, or change requests provided by reviewers or approvers during the quality control or approval process.']
  revision_number varchar [note: 'Version number indicating how many times this task has been revised or reworked due to feedback or quality issues.']
  scheduled_due_date date [note: 'Target completion date for the post-production task as defined in the production schedule.']
  scheduled_start_date date [note: 'Planned date when the post-production task is scheduled to begin.']
  sequence_number varchar [note: 'Ordering position of this task within the overall post-production workflow or within a parent task group.']
  source_media_path varchar [note: 'File system path or Media Asset Management (MAM) location of the source media files or assets for this task.']
  task_notes varchar [note: 'General operational notes, instructions, or context information related to the execution of this post-production task.']
  task_number varchar [note: 'Human-readable business identifier for the post-production task, often used for tracking and communication purposes.']
  task_status varchar [note: 'Current lifecycle status of the post-production task within the workflow pipeline. [ENUM-REF-CANDIDATE: queued|in_progress|review|approved|rejected|complete|on_hold|cancelled — 8 candidates stripped; promote to reference product]']
  task_type varchar [note: 'Classification of the post-production work task indicating the specific type of creative or technical operation being performed. [ENUM-REF-CANDIDATE: offline_edit|online_conform|vfx_composite|color_grade|audio_mix|adr_record|subtitle_burn_in|qc_review|transcode|archive_ingest|foley_record|sound_design|title_graphics|versioning — 14 candidates stripped; promote to reference product]']
  technical_specification varchar [note: 'Detailed technical requirements and parameters for the task output, such as resolution, frame rate, codec, color space, or audio format.']
  updated_timestamp timestamp [note: 'Date and time when this post-production task record was last modified or updated.']
  workstation_code varchar [note: 'Identifier of the specific editing suite, color grading bay, or audio mixing console assigned for this task.']

  Note: 'Individual post-production work task within the Dalet Galaxy workflow orchestration pipeline. Captures task type (offline edit, online conform, VFX composite, color grade, audio mix, ADR record, subtitle burn-in, QC review, transcode, archive ingest), assigned operator or vendor, task status (queued, in-progress, review, approved, rejected, complete), priority, due date, actual completion date, parent episode or deliverable, and Dalet Galaxy workflow task ID. Enables end-to-end post-production workflow tracking.'
}

Table production.deliverable {
  deliverable_id varchar [pk, note: 'Unique identifier for the production deliverable. Primary key.']
  accessibility_obligation_id varchar [note: 'Foreign key linking to compliance.accessibility_obligation. Business justification: Deliverables must comply with specific accessibility obligations (closed captioning, audio description, emergency information access) based on distribution channel and regulatory jurisdiction.']
  campaign_id varchar [note: 'Foreign key linking to sales.campaign. Business justification: Production deliverables include promotional spots, trailers, branded content, and campaign-specific cuts created for advertising campaigns. Trafficking and delivery workflows require tracking which ca']
  channel_id varchar [note: 'Foreign key linking to scheduling.channel. Business justification: Deliverables must be encoded using specific encoder configurations to meet platform technical requirements. Real-world delivery workflows track which encoder profile was used for compliance verificati']
  closed_caption_record_id varchar [note: 'Foreign key linking to compliance.closed_caption_record. Business justification: Deliverables must track closed captioning compliance for FCC accessibility regulations. Required for broadcast clearance and public inspection file documentation.']
  compliance_content_rating_id varchar [note: 'Foreign key linking to compliance.content_rating. Business justification: Deliverables must reference their content rating for distribution compliance verification. Required for platform submission, broadcast clearance, and international distribution workflows.']
  content_delivery_order_id varchar [note: 'Foreign key linking to distribution.content_delivery_order. Business justification: Deliverables fulfill specific content delivery orders to distribution partners. Real business process: fulfillment tracking, delivery confirmation, and partner order management.']
  delivery_channel_id varchar [note: 'Foreign key linking to distribution.delivery_channel. Business justification: Deliverables are physically routed to a specific delivery channel (FAST, linear, SVOD, MVPD). Media ops teams track which delivery channel each deliverable targets to enforce format specs, SLA deadlin']
  grant_id varchar [note: 'Foreign key linking to rights.grant. Business justification: Rights clearance for delivery: each deliverable fulfills a specific rights grant (e.g., SVOD North America, linear broadcast UK). Linking deliverable to grant enables rights clearance verification bef']
  production_episode_id varchar [note: 'Foreign key linking to production.production_episode. Business justification: Deliverables can be episode-specific (e.g., episodic masters for series). Optional FK (nullable) — deliverables may be project-level or episode-level. Enables episode-specific deliverable tracking.']
  production_project_id varchar [note: 'Reference to the parent production project that this deliverable belongs to.']
  program_rundown_id varchar [note: 'Foreign key linking to scheduling.program_rundown. Business justification: For live and news productions, deliverables (packages, VOs, pre-produced segments) are assigned to specific program rundowns. The rundown defines the segment\'s position and timing. Production and traf']
  program_schedule_id varchar [note: 'Foreign key linking to scheduling.program_schedule. Business justification: Deliverables have hard due dates driven by the program schedule air date. Traffic and operations teams track deliverable receipt against program schedule to confirm on-air readiness. This link drives ']
  recipient_partner_id varchar [note: 'Foreign key linking to partner.partner_partner. Business justification: Deliverables are sent to distribution partners, broadcasters, streaming platforms, and licensees. Linking enables delivery obligation tracking, SLA compliance monitoring, acceptance workflow managemen']
  regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: Deliverables must meet specific regulatory obligations before distribution. Links delivery workflow to compliance verification for broadcast standards, platform requirements, and international regulat']
  target_ott_platform_id varchar [note: 'Foreign key linking to distribution.ott_platform. Business justification: Deliverables are formatted for specific platforms with platform-specific technical requirements (resolution, codec, DRM). Real business process: platform-specific asset preparation, transcoding, and d']
  territory_id varchar [note: 'Foreign key linking to rights.rights_territory. Business justification: Territory-specific delivery specification: deliverables are prepared per territory (PAL/NTSC format, subtitle language, content rating compliance, DRM requirements). Operations teams require a direct ']
  actual_delivery_timestamp timestamp [note: 'Actual date and time when the deliverable was successfully delivered or handed off.']
  aspect_ratio varchar [note: 'Display aspect ratio of the video deliverable (e.g., \'16:9\', \'4:3\', \'2.39:1\', \'1:1\'). Null for non-video deliverables.']
  audio_channels varchar [note: 'Audio channel configuration for the deliverable (e.g., \'Stereo\', \'5.1 Surround\', \'7.1 Surround\', \'Mono\', \'Dolby Atmos\'). Null for non-audio deliverables.']
  audio_description_flag boolean [note: 'Indicates whether an audio description track for visually impaired viewers is included. True = audio description present; False = no audio description.']
  checksum_md5 varchar [note: 'MD5 hash of the deliverable file for integrity verification during transfer and storage.']
  closed_caption_flag boolean [note: 'Indicates whether closed captions for accessibility are included in this deliverable. True = closed captions present; False = no closed captions.']
  compliance_certificate_flag boolean [note: 'Indicates whether a regulatory compliance certificate (e.g., FCC, Ofcom, content rating) accompanies this deliverable. True = certificate included; False = no certificate.']
  content_rating varchar [note: 'Age or content rating assigned to this deliverable (e.g., \'TV-PG\', \'TV-14\', \'TV-MA\', \'G\', \'PG\', \'PG-13\', \'R\', \'NC-17\'). Used for compliance and audience targeting.']
  contract_reference varchar [note: 'Reference number or identifier of the contract or agreement that mandates this deliverable.']
  cost_amount decimal(15,2) [note: 'Total cost incurred to produce this deliverable, including labor, equipment, facilities, and post-production services.']
  created_timestamp timestamp [note: 'Date and time when this deliverable record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the cost amount (e.g., \'USD\', \'EUR\', \'GBP\').']
  deliverable_type varchar [note: 'Category of deliverable output. Broadcast master = final linear transmission file; streaming master = OTT/VOD optimized file; promo cut = promotional excerpt; trailer = marketing preview; EPK = Electronic Press Kit; closed caption file = accessibility text; audio description track = visually impaired narration; subtitle file = translation text; M&E track = Music and Effects (no dialogue); textless version = graphics-free master; compliance certificate = regulatory approval document; QC report = Quality Control validation; as-run log = actual playout record. [ENUM-REF-CANDIDATE: broadcast_master|streaming_master|promo_cut|trailer|epk|closed_caption_file|audio_description_track|subtitle_file|me_track|textless_version|compliance_certificate|qc_report|as_run_log|other — 14 candidates stripped; promote to reference product]']
  delivery_location varchar [note: 'Physical address, URL, FTP path, or cloud storage location where the deliverable was sent or made available.']
  delivery_method varchar [note: 'Method or protocol used to deliver the deliverable to the recipient. Physical media = hard drive/tape shipment; FTP = File Transfer Protocol; Aspera = high-speed file transfer; Signiant = media transfer platform; AWS S3 = Amazon cloud storage; Akamai NetStorage = CDN storage; Google Drive/Dropbox = cloud file sharing. [ENUM-REF-CANDIDATE: physical_media|ftp|aspera|signiant|aws_s3|akamai_netstorage|google_drive|dropbox|other — 9 candidates stripped; promote to reference product]']
  delivery_status varchar [note: 'Current lifecycle state of the deliverable. Not started = work has not begun; in progress = actively being produced; QC pending = awaiting quality control review; QC failed = did not pass quality checks; QC passed = approved for delivery; ready for delivery = prepared and awaiting handoff; delivered = sent to recipient; accepted = recipient confirmed receipt and approval; rejected = recipient declined or returned; cancelled = deliverable no longer required. [ENUM-REF-CANDIDATE: not_started|in_progress|qc_pending|qc_failed|qc_passed|ready_for_delivery|delivered|accepted|rejected|cancelled — 10 candidates stripped; promote to reference product]']
  due_date date [note: 'Contractually or operationally required date by which this deliverable must be completed and handed off.']
  duration_seconds decimal(10,3) [note: 'Total runtime duration of the deliverable in seconds (for video/audio deliverables). Null for non-time-based deliverables like documents or images.']
  eidr_code varchar [note: 'Unique universal identifier for the audiovisual content assigned by the Entertainment Identifier Registry. Used for global content identification and rights management.']
  file_size_bytes varchar [note: 'Total file size of the deliverable in bytes. Used for storage planning, transfer time estimation, and CDN capacity management.']
  language_code varchar [note: 'Primary language of the deliverable content using ISO 639-1 or ISO 639-2 two or three-letter code, optionally followed by ISO 3166-1 alpha-2 country code (e.g., \'en\', \'en-US\', \'es-MX\', \'fr-CA\').']
  name varchar [note: 'Human-readable name or title of the deliverable (e.g., \'Broadcast Master HD\', \'Promo Cut 30s\', \'Closed Caption SRT File\').']
  qc_notes varchar [note: 'Detailed notes from the quality control review, including any issues found, corrective actions taken, or validation comments.']
  qc_operator_name varchar [note: 'Name of the quality control technician or automated system that performed the QC validation.']
  qc_pass_flag boolean [note: 'Indicates whether the deliverable passed quality control validation. True = passed QC; False = failed QC or not yet tested.']
  qc_performed_timestamp timestamp [note: 'Date and time when quality control validation was completed for this deliverable.']
  revision_notes varchar [note: 'Description of changes made in this revision of the deliverable (e.g., \'Corrected audio sync issue\', \'Updated end credits\', \'Re-encoded for HDR\').']
  revision_number varchar [note: 'Version or revision number of this deliverable. Increments when the deliverable is updated or redelivered after corrections.']
  scheduled_delivery_timestamp timestamp [note: 'Planned date and time for delivery of this deliverable to the recipient or platform.']
  subtitle_languages varchar [note: 'Comma-separated list of language codes for subtitle tracks included in this deliverable (e.g., \'en,es,fr\'). Null if no subtitles are included.']
  updated_timestamp timestamp [note: 'Date and time when this deliverable record was last modified.']

  Note: 'Contractually or operationally required output deliverable from a production project — the specific media asset or document that must be produced and handed off. Captures deliverable name, deliverable type (broadcast master, streaming master, promo cut, trailer, EPK, closed caption file, audio description track, subtitles, M&E track, textless version, compliance certificate), target format, target platform or recipient, due date, actual delivery date, delivery status, and QC pass/fail flag. Links to the digital asset management domain upon delivery.'
}

Table production.qc_review {
  qc_review_id varchar [pk, note: 'Unique identifier for the quality control review record. Primary key.']
  accessibility_obligation_id varchar [note: 'Foreign key linking to compliance.accessibility_obligation. Business justification: QC reviews verify compliance against specific accessibility obligations. Links quality control processes to regulatory requirements for CVAA, FCC accessibility rules, and international standards.']
  closed_caption_record_id varchar [note: 'Foreign key linking to compliance.closed_caption_record. Business justification: QC reviews verify closed captioning accuracy, synchronization, and completeness against FCC standards. Direct operational link between quality control and accessibility compliance verification.']
  content_version_id varchar [note: 'Foreign key linking to content.version. Business justification: QC reviews validate specific content versions for distribution. Essential for version-level quality tracking, linking production QC to content version records, and ensuring only QC-passed versions are']
  deliverable_id varchar [note: 'Reference to the production deliverable or post-production output being reviewed.']
  delivery_channel_id varchar [note: 'Foreign key linking to distribution.delivery_channel. Business justification: QC reviews are performed against delivery channel-specific technical specifications (loudness standards, resolution requirements, closed caption formats differ between linear broadcast, OTT, and FAST ']
  delivery_obligation_id varchar [note: 'Foreign key linking to partner.delivery_obligation. Business justification: QC reviews validate deliverables against partner technical specifications defined in delivery obligations (resolution, codec, audio channels, closed captions). QC pass/fail status determines obligatio']
  grant_id varchar [note: 'Foreign key linking to rights.grant. Business justification: Rights-compliant QC verification: QC reviews validate that content meets grant-specific technical requirements (DRM enforcement, resolution caps, language versions, run count limits). Rights and QC te']
  post_production_task_id varchar [note: 'Foreign key linking to production.post_production_task. Business justification: QC reviews are performed on post-production task outputs. Optional FK (nullable) — QC may be on final deliverables or intermediate task outputs. When populated, links QC review to the specific Dalet w']
  production_episode_id varchar [note: 'Foreign key linking to production.production_episode. Business justification: QC reviews are performed on episode-level deliverables and post-production outputs. While qc_review links to deliverable and post_production_task (which link to production_episode), a direct productio']
  production_project_id varchar [note: 'Reference to the parent production project this QC review belongs to.']
  release_window_id varchar [note: 'Foreign key linking to distribution.release_window. Business justification: QC certification is window-specific: theatrical DCP, SVOD H.264, and linear broadcast each have distinct loudness, resolution, and accessibility compliance requirements. QC managers track which releas']
  schedule_slot_id varchar [note: 'Foreign key linking to scheduling.schedule_slot. Business justification: QC reviews must be completed before the scheduled air slot. Operations teams track QC pass/fail status against the slot\'s broadcast date to confirm on-air clearance. This link drives QC deadline manag']
  title_id varchar [note: 'Foreign key linking to content.title. Business justification: QC failures that violate broadcast standards, accessibility requirements, or content ratings trigger compliance incidents. Links quality control to incident management and corrective action workflows.']
  audio_channel_configuration varchar [note: 'Audio channel layout (e.g., stereo, 5.1 surround, 7.1 surround, mono).']
  audio_codec varchar [note: 'Audio codec used in the deliverable (e.g., AAC, Dolby Digital, PCM).']
  audio_description_compliance_flag boolean [note: 'Indicates whether audio description track meets accessibility standards. True if compliant, False if missing or non-compliant.']
  closed_caption_compliance_flag boolean [note: 'Indicates whether closed captions meet accessibility and regulatory standards (FCC, CVAA). True if compliant, False if violations detected.']
  created_timestamp timestamp [note: 'Timestamp when the QC review record was first created in the system.']
  dalet_workflow_reference varchar [note: 'Identifier linking this QC review to the corresponding workflow instance in Dalet Galaxy MAM for ingest and workflow orchestration.']
  error_codes varchar [note: 'Comma-separated list of specific error codes identified during the review, aligned with EBU R128, ATSC A/85, and ITU-R BT.1788 standards (e.g., V001 for video freeze, A002 for loudness violation, C003 for closed caption sync error).']
  final_approval_date date [note: 'Date when the deliverable received final approval for distribution. Null if not yet approved.']
  final_approval_status varchar [note: 'Final approval status of the deliverable after QC review and any remediation: approved (ready for distribution), rejected (does not meet standards), pending approval (awaiting sign-off), or conditional approval (approved with minor caveats).']
  loudness_compliance_flag boolean [note: 'Indicates whether the deliverable meets loudness standards (EBU R128 or ATSC A/85). True if compliant, False if violations detected.']
  loudness_lufs decimal(6,2) [note: 'Measured integrated loudness level in LUFS (Loudness Units relative to Full Scale) per EBU R128 or ATSC A/85 standards. Target is typically -23 LUFS for broadcast.']
  p1_critical_error_count varchar [note: 'Number of P1 critical errors that prevent broadcast or distribution (e.g., audio dropout, video corruption, missing segments).']
  p2_major_error_count varchar [note: 'Number of P2 major errors that significantly impact quality but may not prevent distribution (e.g., color grading inconsistencies, audio sync issues).']
  p3_minor_error_count varchar [note: 'Number of P3 minor errors that have minimal impact on viewer experience (e.g., minor subtitle timing issues, cosmetic artifacts).']
  qc_notes varchar [note: 'Free-text notes and observations recorded by the QC operator during the review, including context for errors and recommendations.']
  qc_platform varchar [note: 'Name of the QC platform or tool used to perform the review (e.g., Dalet Galaxy QC module, Tektronix Sentry, Interra Baton).']
  qc_result varchar [note: 'Overall result of the QC review: pass (no issues), fail (critical issues preventing distribution), conditional pass (minor issues requiring remediation), or pending review (awaiting final approval).']
  qc_type varchar [note: 'Type of quality control review performed: technical QC (video/audio quality), editorial QC (content accuracy), compliance QC (regulatory standards), accessibility QC (closed captions, audio description), loudness QC (EBU R128/ATSC A/85), or format QC (file format and codec validation).']
  re_qc_date date [note: 'Date when the deliverable was re-reviewed after remediation. Null if no re-QC has been performed.']
  remediation_notes varchar [note: 'Detailed notes describing the remediation actions required to address identified errors and bring the deliverable into compliance.']
  remediation_required_flag boolean [note: 'Indicates whether the deliverable requires remediation or correction before final approval. True if remediation needed, False if no action required.']
  review_date date [note: 'Date when the QC review was performed.']
  review_duration_minutes decimal(10,2) [note: 'Total duration of the QC review session in minutes.']
  review_end_timestamp timestamp [note: 'Timestamp when the QC operator completed the review session.']
  review_number varchar [note: 'Business identifier for the QC review, typically formatted as a human-readable reference code.']
  review_start_timestamp timestamp [note: 'Timestamp when the QC operator began the review session.']
  review_status varchar [note: 'Current lifecycle status of the QC review process.']
  total_error_count varchar [note: 'Total number of errors identified across all severity levels during the QC review.']
  updated_timestamp timestamp [note: 'Timestamp when the QC review record was last modified.']
  video_codec varchar [note: 'Video codec used in the deliverable (e.g., H.264, H.265/HEVC, ProRes, MPEG-2).']
  video_frame_rate decimal(18,2) [note: 'Measured video frame rate (e.g., 23.976, 25, 29.97, 50, 59.94 fps).']
  video_resolution varchar [note: 'Measured video resolution of the deliverable (e.g., 1920x1080, 3840x2160).']

  Note: 'Quality control review record for a production deliverable or post-production output. Captures QC type (technical QC, editorial QC, compliance QC, accessibility QC, loudness QC), QC operator, review date, pass/fail/conditional result, error count by severity (P1 critical, P2 major, P3 minor), specific error codes per EBU R128/ATSC A/85 loudness standards and ITU-R BT.1788 video quality standards, remediation required flag, re-QC date, and final approval status. Ensures all deliverables meet broadcast and platform technical specifications before distribution. Feeds the deliverable acceptance workflow.'
}

Table production.milestone {
  milestone_id varchar [pk, note: 'Primary key for milestone']
  deliverable_id varchar [note: 'Foreign key linking to production.deliverable. Business justification: Milestones in production are frequently tied to specific deliverables (e.g., \'Picture Lock\', \'Final Delivery\', \'QC Pass\' milestones reference a specific deliverable). Adding deliverable_id normalizes ']
  predecessor_milestone_id varchar [note: 'Reference to another milestone that must be completed before this milestone can begin or be achieved.']
  production_episode_id varchar [note: 'Foreign key linking to production.production_episode. Business justification: Milestones can be episode-specific (e.g., picture lock for episode 3). Optional FK (nullable) — milestones may be project-level or episode-level. Enables episode-specific milestone tracking for episod']
  production_project_id varchar [note: 'Reference to the parent production project or episode for which this milestone is tracked.']
  release_window_id varchar [note: 'Foreign key linking to distribution.release_window. Business justification: Production milestones (picture lock, audio mix complete, QC pass, delivery) are contractually tied to release window open dates. Missing a milestone triggers window date slippage and contractual penal']
  season_id varchar [note: 'Foreign key linking to content.season. Business justification: Season-level milestones (season premiere delivery, season finale picture lock, season delivery to affiliate) are a core broadcast production tracking concept. milestone→title exists but season is the ']
  sweeps_period_id varchar [note: 'Foreign key linking to audience.sweeps_period. Business justification: Production milestones (picture lock, delivery, air-ready) are explicitly scheduled around sweeps periods. Production management teams set critical-path milestones to meet sweeps air dates. This named ']
  title_id varchar [note: 'Foreign key linking to content.title. Business justification: Production milestones track progress toward content title delivery. Essential for content delivery scheduling, windowing plan coordination, and tracking production progress against content distributio']
  actual_date date [note: 'The date on which the milestone was actually achieved or completed. Null if milestone has not yet been reached.']
  approval_authority varchar [note: 'Name or role of the individual or committee authorized to approve this milestone (e.g., Executive Producer, Network Executive, Showrunner).']
  approval_date date [note: 'Date on which formal approval or sign-off was granted for this milestone. Null if approval is not yet obtained.']
  approval_required_flag boolean [note: 'Indicates whether formal approval or sign-off is required before this milestone can be marked as achieved.']
  baseline_date date [note: 'Approved baseline date for the milestone after initial project approval, used for variance tracking and performance measurement.']
  budget_impact_usd decimal(15,2) [note: 'Estimated financial impact or cost associated with achieving this milestone, or cost of delay if milestone is missed.']
  created_timestamp timestamp [note: 'Timestamp when this milestone record was first created in the system.']
  critical_path_flag boolean [note: 'Indicates whether this milestone is on the critical path of the production schedule, meaning any delay directly impacts final delivery date.']
  dalet_workflow_reference varchar [note: 'External identifier linking this milestone to the corresponding workflow or task in Dalet Galaxy Media Asset Management system.']
  dependency_count varchar [note: 'Number of other milestones or tasks that are dependent on the completion of this milestone.']
  forecast_date date [note: 'Current projected or estimated date for milestone completion based on latest production progress and risk assessment.']
  milestone_status varchar [note: 'Current lifecycle status of the milestone indicating whether it is pending, on track, delayed, completed, or no longer applicable.']
  milestone_type varchar [note: 'Categorical classification of the milestone within the production lifecycle. Defines the phase or gate this milestone represents. [ENUM-REF-CANDIDATE: greenlight|pre_production_start|principal_photography_start|principal_photography_end|picture_lock|audio_mix_complete|vfx_complete|color_grading_complete|final_qc_pass|delivery_to_broadcaster|archive_complete|post_production_start|rough_cut_complete|final_cut_complete|mastering_complete — promote to reference product]']
  mitigation_plan varchar [note: 'Description of actions or contingency plans in place to address identified risks and ensure milestone is achieved.']
  name varchar [note: 'Human-readable name or title of the milestone event (e.g., Greenlight Approval, Picture Lock, Final Delivery).']
  notes varchar [note: 'Free-form text field for additional context, comments, or observations related to this milestone event.']
  planned_date date [note: 'Originally scheduled or target date for achieving this milestone as defined during production planning.']
  responsible_department varchar [note: 'The production department or functional area responsible for delivering this milestone. [ENUM-REF-CANDIDATE: production|post_production|vfx|audio|editorial|color|qc|delivery|archive|legal|finance — 11 candidates stripped; promote to reference product]']
  risk_description varchar [note: 'Detailed explanation of identified risks, issues, or blockers that may prevent timely achievement of this milestone.']
  risk_level varchar [note: 'Assessment of the risk that this milestone will not be achieved on time, based on current production status and known issues.']
  sap_wbs_element varchar [note: 'SAP project structure element code linking this milestone to the enterprise project management and financial tracking hierarchy.']
  stakeholder_notification_flag boolean [note: 'Indicates whether stakeholders (network executives, distributors, talent) must be notified when this milestone is achieved or at risk.']
  updated_timestamp timestamp [note: 'Timestamp when this milestone record was last modified or updated.']
  variance_days varchar [note: 'Number of days difference between planned date and actual date (positive indicates delay, negative indicates early completion). Calculated field for reporting purposes.']

  Note: 'Key milestone event in the production lifecycle for a project or episode. Captures milestone type (greenlight, pre-production start, first day of photography, picture lock, audio mix complete, VFX complete, final QC pass, delivery to broadcaster, archive complete), planned date, actual date, milestone status (upcoming, at-risk, achieved, missed), responsible owner, and any associated approval or sign-off requirement. Enables production schedule tracking and stakeholder reporting against key delivery gates.'
}

Table production.cost_transaction {
  cost_transaction_id varchar [pk, note: 'Primary key for cost_transaction']
  accessibility_obligation_id varchar [note: 'Foreign key linking to compliance.accessibility_obligation. Business justification: Costs incurred for accessibility compliance (captioning vendor invoices, audio description production costs) must be tracked against specific accessibility obligations for regulatory cost reporting, t']
  broadcast_license_id varchar [note: 'Foreign key linking to compliance.broadcast_license. Business justification: Every production cost transaction must be assigned to a cost center for GL posting, reconciliation, and audit trail. Mandatory for SAP integration and financial statement preparation. Replaces denorma']
  budget_line_id varchar [note: 'Foreign key linking to production.budget_line. Business justification: Cost transactions are posted against specific budget line items. Currently uses budget_line_reference (STRING) — replacing with FK to budget_line.budget_line_id provides referential integrity and enab']
  partner_id varchar [note: 'Identifier of the vendor or supplier from whom goods or services were procured, if applicable.']
  production_budget_id varchar [note: 'Reference to the specific budget line or cost object this transaction is charged against.']
  production_episode_id varchar [note: 'Foreign key linking to production.production_episode. Business justification: Cost transactions (vendor invoices, POs, payroll) are often incurred at the episode level in series production. Adding production_episode_id enables direct episode-level cost reporting and actuals tra']
  production_project_id varchar [note: 'Reference to the production project against which this cost transaction is posted.']
  regulatory_filing_id varchar [note: 'Foreign key linking to compliance.regulatory_filing. Business justification: Production cost transactions generate or reference journal entries in the financial GL. Required for reconciliation between production spend tracking and financial ledger, mandatory for month-end clos']
  royalty_statement_id varchar [note: 'Foreign key linking to rights.royalty_statement. Business justification: Royalty payment reconciliation: actual royalty payments posted as cost transactions in SAP must be reconciled against issued royalty statements. This link enables finance and rights teams to match pay']
  shoot_schedule_id varchar [note: 'Foreign key linking to production.shoot_schedule. Business justification: Cost transactions are frequently incurred on specific shoot days — location fees, catering, equipment rentals, and overtime costs are all tied to a specific shoot date. Adding shoot_schedule_id to cos']
  approval_date date [note: 'Date on which the transaction was approved for payment.']
  cost_category_code varchar [note: 'Code representing the cost category or expense type (e.g., talent, equipment, location, post-production).']
  cost_category_name varchar [note: 'Descriptive name of the cost category or expense classification.']
  created_timestamp timestamp [note: 'Timestamp when this cost transaction record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the transaction amount.']
  description varchar [note: 'Detailed description or narrative of the cost transaction, including purpose and context.']
  exchange_rate decimal(12,6) [note: 'Exchange rate applied to convert the transaction amount to the reporting currency.']
  fiscal_period varchar [note: 'Fiscal period (month or quarter) within the fiscal year for this transaction.']
  fiscal_year varchar [note: 'Fiscal year in which the transaction was posted for financial reporting purposes.']
  invoice_date date [note: 'Date on the vendor invoice or billing document.']
  invoice_number varchar [note: 'Vendor invoice number or billing reference for this transaction.']
  net_amount decimal(18,2) [note: 'Net transaction amount excluding taxes and other adjustments.']
  notes varchar [note: 'Additional notes, comments, or special instructions related to this transaction.']
  payee_name varchar [note: 'Name of the individual or entity receiving payment for this transaction (e.g., crew member, contractor, petty cash recipient).']
  payment_date date [note: 'Date on which payment was made or is scheduled to be made for this transaction.']
  payment_method varchar [note: 'Method used for payment: wire transfer, check, credit card, petty cash, ACH, or payroll.']
  payment_status varchar [note: 'Current payment status of the transaction: pending, approved, paid, cancelled, on hold, or rejected.']
  posting_date date [note: 'The date on which the transaction was posted to the general ledger in SAP.']
  production_phase varchar [note: 'Phase of production during which this cost was incurred: pre-production, principal photography, post-production, delivery, or closed.']
  purchase_order_number varchar [note: 'Purchase order number associated with this transaction, if applicable.']
  reporting_currency_amount decimal(18,2) [note: 'Transaction amount converted to the standard reporting currency (typically USD) for consolidated financial reporting.']
  reporting_currency_code varchar [note: 'Three-letter ISO 4217 currency code for the reporting currency.']
  sap_document_number varchar [note: 'SAP S/4HANA financial document number (FI/CO posting document) associated with this transaction.']
  sap_line_item_number varchar [note: 'Line item number within the SAP document for granular traceability.']
  sap_wbs_element varchar [note: 'SAP WBS element representing the project structure node for this cost transaction.']
  tax_amount decimal(18,2) [note: 'Tax amount associated with this transaction, if applicable.']
  transaction_amount decimal(18,2) [note: 'The monetary amount of the cost transaction in the original transaction currency.']
  transaction_date date [note: 'The date on which the cost transaction was incurred or posted in the financial system.']
  transaction_number varchar [note: 'Business-facing unique transaction number or document reference for this cost entry.']
  transaction_type varchar [note: 'Classification of the cost transaction: purchase order, vendor invoice, petty cash disbursement, payroll charge, inter-company cost allocation, or credit memo.']
  updated_timestamp timestamp [note: 'Timestamp when this cost transaction record was last updated or modified.']

  Note: 'Individual cost transaction record incurred during production — purchase orders, vendor invoices, petty cash disbursements, payroll charges, and inter-company cost allocations posted against a production project. Captures transaction date, transaction type, vendor or payee, cost category, budget line reference, amount, currency, SAP document number, payment status, and approver. Provides the granular financial audit trail for production spend reconciliation against the production budget.'
}

Table scheduling.channel {
  channel_id varchar [pk, note: 'Unique surrogate identifier for each linear broadcast channel record. Primary key for the channel master data product within the scheduling domain.']
  billing_account_id varchar [note: 'Foreign key linking to billing.account. Business justification: Channels have associated billing accounts for carriage fees, retransmission consent payments, and affiliate revenue. Essential for MVPD/distribution billing, carriage agreement invoicing, and per-subs']
  broadcast_license_id varchar [note: 'Foreign key linking to compliance.broadcast_license. Business justification: Every broadcast channel operates under a regulatory license issued by FCC/Ofcom. License terms govern transmission power, coverage area, must-carry obligations, and renewal cycles. Essential for regul']
  partner_id varchar [note: 'Foreign key linking to partner.partner_partner. Business justification: Channels are owned/operated by broadcast partners (affiliates, network operators, cable systems). Essential for affiliate management, carriage fee calculation, retransmission consent tracking, and net']
  ad_break_duration_sec varchar [note: 'Default duration in seconds of a standard ad pod (ad break) for this channel. Used by Wide Orbit traffic system for ad scheduling, inventory management, and avail calculation. Typical values are 120 (2 minutes) or 180 (3 minutes).']
  affiliate_network_code varchar [note: 'Code identifying the parent broadcast network or affiliate group this channel belongs to (e.g., NBC, CBS, ABC, FOX). Used for network affiliation reporting, retransmission consent negotiations, and carriage fee calculations.']
  blackout_enabled boolean [note: 'Indicates whether geographic broadcast blackout restrictions are applicable to this channel. When true, blackout rules must be enforced during playout and OTT delivery to restrict content in specific geographic markets per rights agreements.']
  broadcast_timezone varchar [note: 'IANA timezone identifier for the channel\'s primary broadcast timezone (e.g., America/New_York, Europe/London). Governs daypart definitions, schedule generation, and EPG time display for the channel\'s primary market.']
  call_sign varchar [note: 'Officially assigned broadcast call sign (e.g., WABC, KNBC) that uniquely identifies the station with the regulatory authority. Serves as the primary external business identifier for the channel as registered with the FCC or Ofcom.']
  carriage_fee_usd decimal(18,4) [note: 'The per-subscriber monthly carriage fee in US dollars charged to MVPDs and vMVPDs for distributing this channel. Commercially sensitive financial data used in revenue assurance, financial reconciliation in SAP S/4HANA, and EBITDA reporting.']
  cdn_origin_url varchar [note: 'The origin ingest URL configured in Akamai CDN for this channel\'s live stream delivery. Used for OTT/streaming distribution, ABR (Adaptive Bitrate Streaming) packaging, and CDN cache configuration.']
  channel_status varchar [note: 'Current operational lifecycle state of the channel. Drives playout automation eligibility, EPG publication, and scheduling availability in Ericsson MediaFirst.']
  channel_type varchar [note: 'Classification of the channel by its distribution and scheduling model. Linear indicates traditional scheduled broadcast; simulcast indicates simultaneous multi-platform broadcast; pop-up indicates temporary event channel; FAST (Free Ad-Supported Streaming Television) indicates ad-supported streaming linear channel; VOD indicates on-demand programming window channel.']
  content_rating_system varchar [note: 'Default content advisory rating applied to the channel\'s programming under the applicable rating system (e.g., US TV Parental Guidelines). Drives V-chip compliance, parental control enforcement, and COPPA-regulated children\'s content restrictions.']
  country_of_origin varchar [note: 'ISO 3166-1 alpha-3 country code identifying the country where the channel is licensed and originates its broadcast signal (e.g., USA, GBR, DEU). Used for regulatory jurisdiction determination, rights windowing, and blackout rule enforcement.']
  created_timestamp timestamp [note: 'The timestamp when this channel record was first created in the system of record. Used for data lineage, audit trail, and record lifecycle tracking in the Silver Layer lakehouse.']
  dai_enabled boolean [note: 'Indicates whether Dynamic Ad Insertion (DAI) is active for this channel, enabling server-side ad replacement for OTT/streaming delivery. Drives ad operations workflow in Wide Orbit and integration with DAI platforms.']
  dalet_channel_code varchar [note: 'The channel identifier as configured in Dalet Galaxy Media Asset Management system. Used to link this channel to content ingest workflows, metadata management, archive operations, and rundown generation in Dalet.']
  decommission_date date [note: 'The date on which this channel was or is scheduled to be permanently decommissioned and removed from broadcast. Nullable for active channels. Used for lifecycle management, licence surrender, and EPG removal planning.']
  drm_enabled boolean [note: 'Indicates whether Digital Rights Management (DRM) encryption is applied to this channel\'s content stream for OTT/streaming delivery. Drives content protection configuration in Akamai CDN and subscriber entitlement enforcement in Zuora.']
  epg_enabled boolean [note: 'Indicates whether this channel is published to the Electronic Program Guide (EPG) for audience-facing schedule display. Channels under testing or decommissioned may be excluded from EPG publication.']
  genre varchar [note: 'Primary programming genre classification of the channel (e.g., News, Sports, Entertainment, Children, Documentary, Music). Used for EPG categorization, audience segmentation, advertising sales targeting, and Nielsen ratings demographic alignment. [ENUM-REF-CANDIDATE: News|Sports|Entertainment|Children|Documentary|Music|General|Movies|Lifestyle|Education — promote to reference product]']
  hls_stream_url varchar [note: 'The HLS (HTTP Live Streaming) manifest URL for this channel\'s live stream, used for Apple device and browser-based OTT delivery via Akamai CDN. Supports ABR (Adaptive Bitrate Streaming) for adaptive quality delivery.']
  launch_date date [note: 'The date on which this channel first went live and began broadcasting. Used for channel lifecycle tracking, anniversary reporting, regulatory licence history, and audience growth analytics.']
  logical_channel_number varchar [note: 'The numeric channel position assigned to this channel in the Electronic Program Guide (EPG) and set-top box channel lineup. Used by MVPDs and vMVPDs for channel navigation and must-carry compliance reporting.']
  max_ad_load_pct decimal(5,2) [note: 'Maximum percentage of total broadcast hour that may be allocated to advertising on this channel. Governs inventory capacity planning, FCC commercial limits compliance (children\'s programming), and upfront/scatter market sales commitments.']
  mediafirst_channel_code varchar [note: 'The channel identifier as configured in the Ericsson MediaFirst playout automation system. Used to link this master channel record to the playout engine for schedule execution, automation triggers, graphics insertion, and failover configuration.']
  mpeg_dash_stream_url varchar [note: 'The MPEG-DASH (Dynamic Adaptive Streaming over HTTP) manifest URL for this channel\'s live stream, used for Android, Smart TV, and cross-platform OTT delivery via Akamai CDN.']
  must_carry_status boolean [note: 'Indicates whether this channel is subject to must-carry obligations requiring MVPDs to include it in their channel lineup. Drives compliance reporting and carriage fee negotiations.']
  network_name varchar [note: 'Human-readable name of the broadcast network or channel brand (e.g., CNN, BBC One, ESPN). Used as the primary identity label for display in EPG, scheduling tools, and audience-facing interfaces.']
  nielsen_station_code varchar [note: 'The unique station identifier assigned by Nielsen Media Research for audience measurement, ratings reporting, and GRP/TRP calculations. Links this channel to Nielsen ratings data for advertising sales and audience analytics.']
  playout_automation_enabled boolean [note: 'Indicates whether the channel is configured for automated playout via Ericsson MediaFirst. When true, schedule execution, ad insertion cues, and failover are handled automatically. When false, manual playout operation is required.']
  primary_language varchar [note: 'ISO 639-1/639-2 language code representing the primary audio language of the channel\'s programming (e.g., \'en\' for English, \'es\' for Spanish, \'fra\' for French). Used for EPG metadata, accessibility compliance, and audience targeting.']
  resolution_profile varchar [note: 'Video resolution classification of the channel output. SD (Standard Definition), HD (High Definition 1080i/720p), UHD (Ultra High Definition 4K/8K). Determines encoding profiles, CDN delivery tiers, and subscriber package eligibility.']
  retransmission_consent_required boolean [note: 'Indicates whether this channel requires retransmission consent from MVPDs before rebroadcasting. Drives carriage fee negotiations and compliance with FCC retransmission consent rules.']
  scte35_enabled boolean [note: 'Indicates whether SCTE-35 digital program insertion cue markers are active on this channel for Dynamic Ad Insertion (DAI). SCTE-35 signals define ad pod boundaries and splice points used by Wide Orbit traffic system and DAI platforms.']
  transmission_standard varchar [note: 'Technical broadcast transmission standard used to deliver the channel signal. ATSC and ATSC 3.0 apply to North American over-the-air broadcast; DVB-T/T2 and DVB-S/S2 apply to European terrestrial and satellite; QAM applies to cable distribution; IP applies to OTT/streaming delivery. [ENUM-REF-CANDIDATE: ATSC|ATSC3|DVB-T|DVB-T2|DVB-S|DVB-S2|QAM|IP — promote to reference product]']
  updated_timestamp timestamp [note: 'The timestamp when this channel record was most recently modified. Used for change data capture (CDC), incremental ETL processing, and audit trail compliance in the Databricks Silver Layer.']
  wide_orbit_station_code varchar [note: 'The station code as configured in the Wide Orbit traffic and billing system. Used to link this channel master record to ad scheduling, sales orders, affidavit generation, and invoicing workflows in Wide Orbit.']

  Note: 'Master record for each linear broadcast channel — capturing network identity, call sign, transmission standard (ATSC, DVB-T/T2, QAM), logical channel number, language, resolution profile (SD/HD/UHD), and playout automation linkage to Ericsson MediaFirst. Serves as the SSOT for channel identity referenced by program schedules, EPG entries, playout events, and simulcast configurations within this domain.'
}

Table scheduling.daypart {
  daypart_id varchar [pk, note: 'Primary key for daypart']
  scheduling_channel_id varchar [note: 'add column scheduling_channel_id (BIGINT) with FK to scheduling.channel.channel_id - dayparts are defined per channel and need explicit channel linkage']
  ad_pod_max_count varchar [note: 'The maximum number of ad pods (commercial breaks) permitted per hour within this daypart. Used by Wide Orbit for ad scheduling capacity planning and by Ericsson MediaFirst for playout rundown validation. Supports FCC commercial time compliance monitoring.']
  ad_pod_max_duration_seconds varchar [note: 'The maximum allowable total duration in seconds for an ad pod (group of ads in a break) within this daypart. Governs commercial break length limits enforced by Ericsson MediaFirst playout automation and Wide Orbit ad scheduling. Aligns with FCC commercial time limits for children\'s programming dayparts.']
  applicable_days varchar [note: 'Pipe-delimited list of days of the week on which this daypart definition applies, using three-letter abbreviations (e.g., MON|TUE|WED|THU|FRI for weekday dayparts, SAT|SUN for weekend). Governs schedule generation in Ericsson MediaFirst and ad inventory availability in Wide Orbit. [ENUM-REF-CANDIDATE: MON|TUE|WED|THU|FRI|SAT|SUN — promote to reference product]']
  avg_audience_000 decimal(12,2) [note: 'The average audience size in thousands of viewers (000s) expected during this daypart, based on Nielsen Media Research Platform historical ratings data. Used as the principal quantitative measurement of daypart audience value for ad sales, GRP calculations, and content scheduling decisions.']
  base_cpm_usd decimal(10,4) [note: 'The baseline CPM (Cost Per Mille) rate in US dollars for advertising inventory sold within this daypart, before application of the rate_multiplier or audience demographic adjustments. Represents the floor pricing reference used in Salesforce Media Cloud upfront and scatter market proposals.']
  blackout_eligible boolean [note: 'Indicates whether geographic broadcast blackout restrictions can be applied to content scheduled within this daypart. When True, blackout rules (e.g., sports rights geographic exclusivity) may be enforced by the distribution platform. Aligns with must-carry and retransmission consent obligations.']
  code varchar [note: 'Short alphanumeric business identifier for the daypart, used as the externally-known reference key across Wide Orbit traffic system, Ericsson MediaFirst playout automation, and Salesforce Media Cloud ad sales. Examples: PRIME, EARLY_AM, DAYTIME, LATE_FRINGE, OVERNIGHT. Aligns with Nielsen daypart taxonomy codes.']
  content_rating_restriction varchar [note: 'The maximum permissible TV content rating (per MPA/TV Parental Guidelines) for programming scheduled within this daypart. Enforces content appropriateness standards — e.g., Prime Time may allow up to TV-14, while Children\'s dayparts are restricted to TV-Y or TV-Y7. Used by Ericsson MediaFirst for schedule validation.']
  coppa_restricted boolean [note: 'Indicates whether this daypart is subject to COPPA (Children\'s Online Privacy Protection Act) restrictions due to programming directed at children under 13. When True, audience data collection, behavioral targeting, and ad pod duration limits are governed by COPPA compliance rules and FCC children\'s television regulations.']
  created_timestamp timestamp [note: 'The timestamp when this daypart record was first created in the scheduling domain data product. Supports audit trail, data lineage tracking, and Silver layer ingestion reconciliation in the Databricks Lakehouse.']
  dai_eligible boolean [note: 'Indicates whether this daypart is eligible for Dynamic Ad Insertion (DAI) on OTT and streaming platforms. When True, ad pods within this daypart can be dynamically replaced with targeted ads during streaming delivery through Akamai CDN, enabling addressable advertising revenue.']
  day_category varchar [note: 'High-level classification of the day-of-week applicability for the daypart. \'weekday\' covers Monday–Friday, \'weekend\' covers Saturday–Sunday, \'all_week\' applies every day, and \'holiday\' applies on designated public holidays. Used for rate card segmentation and audience demographic profiling.']
  daypart_status varchar [note: 'Current lifecycle state of the daypart definition. \'active\' indicates the daypart is in operational use for scheduling and ad sales. \'inactive\' means temporarily suspended. \'draft\' means under review before activation. \'deprecated\' means retired from use but retained for historical reference.']
  daypart_type varchar [note: 'Classifies the daypart by broadcast delivery mode. \'linear\' applies to traditional scheduled broadcast, \'non_linear\' to on-demand programming windows, \'simulcast\' to simultaneous multi-platform broadcast segments, and \'vod_window\' to VOD availability windows governed by this daypart definition.']
  description varchar [note: 'Free-text narrative description of the daypart, including its programming characteristics, audience profile, and scheduling context. Used for internal documentation, Salesforce Media Cloud proposal narratives, and EPG metadata. Example: \'Prime Time (8PM-11PM) — highest-rated evening programming block targeting Adults 18-49.\'']
  duration_minutes varchar [note: 'Total duration of the daypart window expressed in minutes. Derived from start_time and end_time boundaries but stored explicitly for scheduling calculations, ad inventory capacity planning, and rate card generation in Wide Orbit.']
  effective_from date [note: 'The calendar date from which this daypart definition becomes effective for scheduling and ad sales operations. Supports versioned daypart definitions where boundaries or rates change seasonally or following regulatory updates. Used in Wide Orbit and Ericsson MediaFirst schedule generation.']
  effective_until date [note: 'The calendar date on which this daypart definition expires and is no longer applicable for scheduling and ad sales. Null indicates an open-ended definition with no planned expiry. Supports seasonal daypart adjustments (e.g., summer schedule changes) and regulatory compliance updates.']
  end_time timestamp [note: 'The clock time (HH:mm:ss, 24-hour or extended broadcast-day format) at which the daypart ends. Supports broadcast day overflow notation (e.g., 25:59:59 for content airing past midnight within the same broadcast day). Paired with start_time to define the daypart boundary.']
  epg_display_order varchar [note: 'The sequential display order of this daypart within the Electronic Program Guide (EPG) channel grid, used by Ericsson MediaFirst for schedule presentation and by digital EPG distribution systems. Lower values appear earlier in the broadcast day display.']
  grp_index decimal(8,4) [note: 'The GRP (Gross Rating Point) index value representing the expected audience delivery weight for this daypart relative to the total broadcast day. Used in media planning, upfront negotiations, and scatter market pricing. Sourced from Nielsen Media Research Platform ratings data.']
  hut_level decimal(6,4) [note: 'The HUT (Homes Using Television) percentage representing the proportion of TV households actively viewing during this daypart. A key audience measurement metric sourced from Nielsen Media Research Platform, used to benchmark daypart audience potential and inform ad pricing.']
  makegood_eligible boolean [note: 'Indicates whether compensatory ad spots (makegoods) can be scheduled within this daypart to fulfill underdelivered audience guarantees from other dayparts. Governs Wide Orbit makegood scheduling logic and Salesforce Media Cloud campaign reconciliation workflows.']
  name varchar [note: 'Human-readable label for the daypart segment as displayed in the Electronic Program Guide (EPG), ad sales proposals, and scheduling interfaces. Examples: Early Morning, Morning Drive, Daytime, Prime Time, Late Fringe, Overnight.']
  nielsen_daypart_code varchar [note: 'The standardized daypart code as defined by Nielsen Media Research taxonomy (e.g., PRIME, EARLY_NEWS, LATE_NEWS, DAYTIME, EARLY_FRINGE, LATE_FRINGE, OVERNIGHT). Used to align internal scheduling definitions with Nielsen audience measurement reports and ratings data ingested from the Nielsen Media Research Platform.']
  rate_multiplier decimal(6,4) [note: 'Pricing multiplier applied to the base CPM (Cost Per Mille) rate card for ad inventory sold within this daypart. A value of 1.0000 represents the base rate; Prime Time typically carries a multiplier greater than 1.0 (e.g., 2.5000), while Overnight may be below 1.0 (e.g., 0.3000). Used in Salesforce Media Cloud proposal generation and Wide Orbit billing.']
  scatter_eligible boolean [note: 'Indicates whether unsold ad inventory within this daypart is available for scatter market (last-minute) sales. Governs Wide Orbit inventory availability rules for short-notice ad placement and makegood scheduling.']
  scte35_cue_enabled boolean [note: 'Indicates whether SCTE-35 digital program insertion cue markers are enabled for ad break signaling within this daypart. When True, Ericsson MediaFirst playout automation inserts SCTE-35 splice_insert commands at ad pod boundaries, enabling Dynamic Ad Insertion (DAI) for OTT and streaming distribution via Akamai CDN.']
  simulcast_eligible boolean [note: 'Indicates whether content scheduled in this daypart is eligible for simultaneous multi-platform broadcast (simulcast) across linear, OTT, and digital channels. When True, Ericsson MediaFirst can trigger simulcast distribution workflows for this daypart\'s programming.']
  start_time timestamp [note: 'The clock time (HH:mm:ss, 24-hour format) at which the daypart begins each applicable day. Used by Ericsson MediaFirst for automated playout boundary detection and by Wide Orbit for ad scheduling slot assignment. Stored as STRING to support broadcast day conventions (e.g., 25:00:00 for post-midnight).']
  sweeps_period_flag boolean [note: 'Indicates whether this daypart definition has special audience measurement and programming rules applied during Nielsen sweeps periods (intensive ratings measurement periods in February, May, July, and November). When True, enhanced content scheduling and ad pricing rules may apply.']
  target_demographic varchar [note: 'Primary audience demographic profile associated with this daypart, expressed using Nielsen standard demographic notation (e.g., A18-49, W25-54, M18-34, HH, P2+). Drives audience targeting in ad sales proposals, GRP/TRP calculations, and content scheduling decisions. Sourced from Nielsen Media Research Platform audience measurement data.']
  timezone_code varchar [note: 'The IANA timezone identifier (e.g., America/New_York, America/Los_Angeles, Europe/London) governing the clock boundaries of this daypart. Critical for multi-market broadcast operations where the same daypart definition must be applied across different time zones for network affiliates and regional channels.']
  updated_timestamp timestamp [note: 'The timestamp of the most recent modification to this daypart record. Used for change data capture (CDC), incremental ETL processing in the Databricks Lakehouse Silver layer, and audit trail compliance.']
  upfront_eligible boolean [note: 'Indicates whether ad inventory within this daypart is offered during the upfront advance advertising sales event. Prime Time and key dayparts are typically upfront-eligible. Drives Salesforce Media Cloud opportunity and proposal configuration for annual upfront sales cycles.']
  wide_orbit_daypart_code varchar [note: 'The corresponding daypart identifier as configured in the Wide Orbit traffic and billing system. Used to reconcile internal daypart definitions with ad scheduling, sales orders, and affidavit records in Wide Orbit. Enables cross-system traceability for revenue assurance.']

  Note: 'Reference definition of named broadcast time segments (e.g., Early Morning, Morning Drive, Daytime, Prime Time, Late Fringe, Overnight) used to govern ad pricing, content scheduling, and audience targeting. Captures daypart code, start/end time boundaries, day-of-week applicability, audience demographic profile, and rate multiplier. Aligns with Nielsen daypart taxonomy and Wide Orbit traffic system.'
}

Table scheduling.program_schedule {
  program_schedule_id varchar [pk, note: 'Unique surrogate identifier for the program schedule record. One record per channel per broadcast date per schedule version. This is the primary key of the program_schedule data product.']
  broadcast_license_id varchar [note: 'Foreign key linking to compliance.broadcast_license. Business justification: Program schedules must comply with license terms including children\'s programming quotas, must-carry requirements, and public interest obligations. Required for FCC quarterly compliance reports and li']
  channel_id varchar [note: 'Reference to the broadcast channel for which this schedule is defined. Identifies the linear channel in the channel master (e.g., NBC East, CNN HD). Drives Ericsson MediaFirst playout automation for the specific channel.']
  territory_id varchar [note: 'Foreign key linking to rights.territory. Business justification: Schedules executed at specific facilities - required for playout coordination, facility capacity planning, multi-site broadcast operations, and as-run log reconciliation. Essential for distributed bro']
  ad_pod_count varchar [note: 'Total number of ad pods (groups of ads in a break) planned in the schedule for this channel day. An ad pod is a contiguous block of commercial spots within a program break. Used for inventory planning and SCTE-35 cue marker validation.']
  approved_by varchar [note: 'Name or user identifier of the programming operations staff member who approved this schedule version. Required for audit trail and accountability in the schedule approval workflow. Populated when schedule_status transitions to \'approved\'.']
  approved_timestamp timestamp [note: 'Timestamp when this schedule version was formally approved by the programming team. Marks the transition from \'draft\' to \'approved\' status. Used for SLA tracking of schedule readiness lead time before broadcast date.']
  as_run_confirmed_timestamp timestamp [note: 'Timestamp when the as-run log was confirmed and reconciled against the planned schedule. Marks the transition to \'as-run\' status. Used for Wide Orbit affidavit generation, Nielsen ratings reconciliation, and revenue assurance.']
  blackout_flag boolean [note: 'Indicates whether any geographic broadcast blackout restriction applies to this schedule. True = one or more programs in this schedule are subject to blackout in specific markets (e.g., sports rights blackout). Triggers downstream blackout enforcement in distribution and CDN systems.']
  broadcast_date date [note: 'The calendar date for which this program schedule is planned and transmitted. Represents the broadcast day (which may span midnight for overnight programming). Formatted as yyyy-MM-dd per enterprise date convention.']
  broadcast_standard varchar [note: 'The broadcast technical standard under which this schedule is transmitted. ATSC = Advanced Television Systems Committee (North America); DVB = Digital Video Broadcasting (Europe/international); ISDB = Integrated Services Digital Broadcasting (Japan/Brazil); NTSC/PAL = legacy analog standards.']
  content_rating_advisory varchar [note: 'The highest content rating advisory applicable to any program in this schedule for the broadcast day. Used for parental control systems, V-chip compliance, and FCC content standards reporting. Ratings follow the TV Parental Guidelines system mandated by the FCC.']
  created_timestamp timestamp [note: 'Timestamp when this program schedule record was first created in the system. Represents the business event time of schedule initiation. Used for audit trail, SLA measurement of schedule build lead time, and data lineage tracking.']
  dalet_workflow_code varchar [note: 'Reference identifier for the Dalet Galaxy media asset management workflow instance associated with this schedule\'s content preparation and ingest activities. Links the schedule to the MAM workflow for asset readiness validation prior to playout.']
  daypart_code varchar [note: 'Primary daypart classification for the schedule\'s dominant programming block. Daypart is the time segment of the broadcast day used for audience measurement, ad sales, and programming strategy. Values align with Nielsen daypart definitions. [ENUM-REF-CANDIDATE: EARLY_MORNING|MORNING|DAYTIME|EARLY_FRINGE|PRIME_ACCESS|PRIME|LATE_NEWS|LATE_FRINGE|OVERNIGHT — promote to reference product]']
  emergency_alert_ready boolean [note: 'Indicates whether the schedule has been configured with Emergency Alert System (EAS) interrupt capability for this broadcast date. True = EAS interrupt slots are provisioned in the Ericsson MediaFirst rundown. Required for FCC EAS compliance.']
  epg_grid_code varchar [note: 'External identifier assigned to this schedule in the Electronic Program Guide (EPG) distribution system. Used by downstream EPG aggregators, set-top box providers, and digital guide services to reference the channel day grid. Aligns with DVB SI/EIT table identifiers.']
  fcc_children_programming_compliant boolean [note: 'Indicates whether this schedule meets FCC children\'s educational and informational (E/I) programming requirements for the broadcast date. True = minimum required hours of qualifying children\'s programming are scheduled. Required for FCC license renewal compliance reporting.']
  last_modified_timestamp timestamp [note: 'Timestamp of the most recent modification to this program schedule record. Tracks the last update across any field change, version increment, or status transition. Used for change detection in downstream EPG distribution and playout systems.']
  mediafirst_rundown_code varchar [note: 'Reference identifier for the automation rundown object in Ericsson MediaFirst that corresponds to this program schedule. Used to reconcile the planned schedule with the playout automation system\'s rundown for failover and as-run log generation.']
  must_carry_compliant boolean [note: 'Indicates whether this schedule satisfies must-carry obligations for the channel on this broadcast date. Must-carry is the mandatory channel inclusion requirement imposed on cable and satellite MVPDs by the FCC. True = compliant; False = compliance issue requiring resolution.']
  playout_failover_mode varchar [note: 'Indicates the Ericsson MediaFirst playout failover configuration active for this schedule. \'primary\' = normal automated playout; \'backup\' = failover to backup playout server; \'manual_override\' = operator has taken manual control of playout. Used for SLA and incident reporting.']
  rights_clearance_status varchar [note: 'Aggregate rights clearance status for all programs in this schedule as verified against Rightsline rights management. \'cleared\' = all programs have confirmed broadcast rights for this date and territory; \'pending\' = clearance in progress; \'partial\' = some programs cleared; \'failed\' = one or more rights conflicts identified.']
  schedule_end_time timestamp [note: 'The planned end timestamp of the broadcast schedule for this channel day, including timezone offset. Typically 23:59:59 local broadcast time but may extend past midnight for overnight programming blocks. Formatted as yyyy-MM-ddTHH:mm:ss.SSSXXX.']
  schedule_name varchar [note: 'Human-readable label for the schedule, typically combining channel name and broadcast date (e.g., \'CNN-HD 2024-06-15 v2\'). Used by scheduling operations staff to identify and reference the schedule in Ericsson MediaFirst and Wide Orbit Traffic systems.']
  schedule_notes varchar [note: 'Free-text operational notes entered by scheduling staff regarding special instructions, exceptions, or context for this schedule (e.g., \'Breaking news override applied to 8PM slot\', \'Live sports event extends prime block by 30 min\'). Not used for automated processing.']
  schedule_source varchar [note: 'Indicates how this schedule was generated. \'manual\' = built by scheduling staff; \'automated\' = generated by Ericsson MediaFirst automated schedule engine; \'imported\' = ingested from an external programming supplier or network feed; \'template\' = derived from a recurring schedule template.']
  schedule_start_time timestamp [note: 'The planned start timestamp of the broadcast schedule for this channel day, including timezone offset. Typically 00:00:00 local broadcast time but may differ for overnight schedules that begin at a non-midnight boundary. Formatted as yyyy-MM-ddTHH:mm:ss.SSSXXX.']
  schedule_status varchar [note: 'Current lifecycle state of the program schedule. \'draft\' = initial build in progress; \'approved\' = signed off by programming team; \'transmitted\' = sent to Ericsson MediaFirst playout automation; \'as-run\' = actual broadcast log confirmed; \'cancelled\' = schedule voided and replaced.']
  schedule_type varchar [note: 'Classification of the schedule by programming strategy type. \'standard\' = regular broadcast day; \'special_event\' = live event or breaking news override; \'holiday\' = holiday programming grid; \'sweeps\' = Nielsen sweeps period intensive ratings schedule; \'upfront_preview\' = advance advertising sales event programming.']
  schedule_version varchar [note: 'Monotonically incrementing version number for the schedule on a given channel and broadcast date. Enables tracking of schedule revisions from initial draft through final as-run. Version 1 is the initial draft; each approved revision increments the version.']
  scte35_cue_count varchar [note: 'Total number of SCTE-35 digital program insertion cue markers embedded in the schedule for this channel day. SCTE-35 cues signal ad break opportunities for Dynamic Ad Insertion (DAI) in both linear and OTT streams. Used to validate DAI readiness.']
  simulcast_flag boolean [note: 'Indicates whether this schedule is configured for simultaneous multi-platform broadcast (simulcast). True = the schedule is transmitted concurrently across linear broadcast and one or more OTT/streaming platforms. Drives Ericsson MediaFirst simulcast automation configuration.']
  simulcast_platform_count varchar [note: 'Number of platforms on which this schedule is simultaneously broadcast when simulcast_flag is True. Used for multi-platform distribution planning and rights compliance verification across linear, OTT, and vMVPD delivery channels.']
  timezone varchar [note: 'IANA timezone identifier for the broadcast timezone in which this schedule\'s times are expressed (e.g., \'America/New_York\', \'Europe/London\'). Critical for accurate EPG display, daypart classification, and regulatory compliance reporting across markets.']
  total_ad_time_seconds varchar [note: 'Total planned advertising airtime in seconds across all ad pods in the schedule for this channel day. Used for commercial inventory management, FCC commercial limits compliance, and revenue forecasting against Wide Orbit traffic orders.']
  total_program_time_seconds varchar [note: 'Total planned programming (non-commercial) airtime in seconds for this channel day schedule. Equals total_runtime_seconds minus total_ad_time_seconds. Used for content utilization reporting and rights compliance verification.']
  total_runtime_seconds varchar [note: 'Total planned runtime of all program items in the schedule, expressed in seconds. Used to validate that the schedule fills the full broadcast day (86,400 seconds for a 24-hour schedule) and to detect gaps or overlaps in the rundown.']
  transmission_type varchar [note: 'Indicates the primary mode of content delivery for this schedule. \'linear\' = traditional scheduled broadcast; \'vod_window\' = on-demand programming window; \'fast_channel\' = Free Ad-Supported Streaming Television (FAST) channel; \'simulcast\' = simultaneous multi-platform broadcast.']
  transmitted_timestamp timestamp [note: 'Timestamp when the approved schedule was transmitted to the Ericsson MediaFirst playout automation system. Marks the transition from \'approved\' to \'transmitted\' status. Used for playout readiness SLA monitoring and failover preparation.']
  wide_orbit_log_code varchar [note: 'Reference identifier for the corresponding traffic log in Wide Orbit Traffic and Billing system. Links the program schedule to the ad scheduling and affidavit records for commercial break reconciliation and proof-of-broadcast (affidavit) generation.']

  Note: 'The authoritative linear channel grid (EPG backbone) representing the planned broadcast schedule for a channel on a given broadcast date. Captures schedule version, channel, broadcast date, schedule status (draft, approved, transmitted, as-run), total runtime, blackout flags, must-carry compliance status, and the Ericsson MediaFirst automation rundown reference. One record per channel per broadcast day per schedule version.'
}

Table scheduling.schedule_slot {
  schedule_slot_id varchar [pk, note: 'Unique surrogate identifier for each individual schedule slot record within the Electronic Program Guide (EPG) rundown. Primary key for the schedule_slot data product managed in Ericsson MediaFirst.']
  ad_pod_id varchar [note: 'Reference to the ad pod (group of commercials within a break) associated with this slot when the slot type is a commercial break. Populated only for commercial break slots; null for program and promo slots.']
  channel_id varchar [note: 'Reference to the linear broadcast channel on which this schedule slot is programmed. Identifies the originating channel within the EPG grid.']
  compliance_content_rating_id varchar [note: 'Foreign key linking to compliance.content_rating. Business justification: Each scheduled slot requires verified content rating for daypart appropriateness (watershed compliance), V-chip encoding, and parental guidance systems. Real-time compliance verification prevents regu']
  content_episode_id varchar [note: 'Foreign key linking to content.content_episode. Business justification: Schedulers assign specific episodes to slots for EPG accuracy, rights clearance per episode, and as-run log generation. The existing title_id FK is insufficient — episode-level identification is requi']
  daypart_id varchar [note: 'Reference to the daypart classification assigned to this slot (e.g., Prime Time, Late Night, Morning Drive). Dayparts are standard time segments of the broadcast day used for audience targeting and advertising rate-card pricing.']
  grant_id varchar [note: 'Foreign key linking to rights.grant. Business justification: Schedule slots require grant verification for pre-broadcast rights clearance. Critical for automated compliance workflow preventing unauthorized airings. Broadcasters validate grant coverage before fi']
  holdback_id varchar [note: 'Foreign key linking to rights.holdback. Business justification: Slots must check holdback restrictions during scheduling to prevent rights violations. Automated enforcement workflow blocks scheduling content during holdback windows (e.g., theatrical holdbacks, SVO']
  partner_id varchar [note: 'Foreign key linking to partner.partner. Business justification: Slots may require specific transmission equipment for live events, special broadcasts, or equipment-specific configurations - supports technical coordination, equipment allocation, and signal routing ']
  program_schedule_id varchar [note: 'Reference to the parent broadcast schedule or rundown document that contains this slot. Links the atomic slot to its daily or weekly schedule container in Ericsson MediaFirst.']
  talent_profile_id varchar [note: 'Foreign key linking to talent.talent_profile. Business justification: On-air talent (hosts, anchors, guests) are scheduled in broadcast slots. Scheduling systems track which talent appears in which slot for call sheets, union reporting, rights clearance verification, an']
  version_id varchar [note: 'Foreign key linking to content.version. Business justification: Playout automation and QC require knowing which specific technical version (resolution, audio codec, language) is scheduled in each slot. Version-level scheduling drives pre-transmission QC checks and']
  actual_duration_seconds varchar [note: 'Real-world duration of the slot in seconds as recorded in the as-run log. Compared against planned_duration_seconds to identify overruns, underruns, and schedule compliance deviations. Used in affidavit reconciliation and makegoods processing.']
  actual_start_time timestamp [note: 'Real-world start time of the slot as recorded in the as-run log by Ericsson MediaFirst playout automation. May differ from planned_start_time due to live events, technical delays, or schedule overruns. Critical for affidavit generation in Wide Orbit and Nielsen audience measurement reconciliation.']
  aspect_ratio varchar [note: 'Video aspect ratio of the content assigned to this slot. Drives playout automation letterboxing/pillarboxing decisions in Ericsson MediaFirst and ensures compliance with broadcast technical standards.']
  audio_format varchar [note: 'Audio encoding format for the content in this slot (e.g., stereo, Dolby 5.1, Dolby Atmos, mono). Required for playout automation configuration in Ericsson MediaFirst and compliance with broadcast audio loudness standards.']
  automation_event_code varchar [note: 'Ericsson MediaFirst playout automation system event identifier for this slot. The native key from the MediaFirst rundown used for as-run reconciliation, failover event tracking, and technical operations audit.']
  broadcast_date date [note: 'Calendar date on which this slot is scheduled to air, expressed in yyyy-MM-dd format. Used as the primary partition key for EPG queries, Nielsen ratings alignment, and daily schedule reporting. Represents the broadcast day which may span midnight for overnight programming.']
  closed_caption_flag boolean [note: 'Indicates whether closed captioning is present and enabled for this slot (True). Mandatory for FCC compliance under the Twenty-First Century Communications and Video Accessibility Act (CVAA) for applicable programming.']
  created_timestamp timestamp [note: 'Timestamp when this schedule slot record was first created in the EPG system. Supports audit trail requirements, schedule change history analysis, and data lineage tracking in the Databricks Silver Layer.']
  eas_alert_type varchar [note: 'Type of Emergency Alert System (EAS) message associated with this slot when slot_type is \'eas\' (e.g., EAN — Emergency Action Notification, NPT — National Periodic Test, RWT — Required Weekly Test). Null for non-EAS slots. Mandatory for FCC EAS compliance logging. [ENUM-REF-CANDIDATE: EAN|NPT|RWT|SVR|TOR|FFW|HUW|WSW — promote to reference product]']
  is_blackout boolean [note: 'Indicates whether a geographic broadcast restriction (blackout) applies to this slot (True). Blackout rules are enforced at the distribution layer and must be flagged at the slot level for rights compliance and audience measurement exclusion.']
  is_live boolean [note: 'Indicates whether this slot carries a live broadcast event (True) or pre-recorded/taped content (False). Live slots require different playout automation handling, DAI configuration, and rights clearance verification in Rightsline.']
  is_repeat boolean [note: 'Indicates whether this slot is a repeat airing of previously broadcast content (True) rather than a first-run premiere (False). Affects talent residuals calculations in Rightsline and Nielsen audience measurement weighting.']
  is_simulcast boolean [note: 'Indicates whether this slot is simultaneously broadcast across multiple platforms or channels (True). Simulcast slots require coordinated playout across linear and OTT/streaming distribution paths and may trigger additional rights obligations.']
  isan_code varchar [note: 'International Standard Audiovisual Number (ISAN) uniquely identifying the audiovisual work airing in this slot. Enables cross-platform content identification, rights clearance verification in Rightsline, and royalty calculation for residuals.']
  isci_code varchar [note: 'Industry Standard Commercial Identification (ISCI) code for the commercial spot airing in this slot. An 8-character alphanumeric code used by Wide Orbit and ad agencies to uniquely identify a specific commercial creative. Null for non-commercial slot types.']
  must_carry_flag boolean [note: 'Indicates whether this slot is subject to must-carry obligations requiring MVPDs to include this channel/content in their basic tier (True). Flags slots that cannot be blacked out or substituted under FCC must-carry rules.']
  nielsen_program_code varchar [note: 'Nielsen Media Research proprietary program code assigned to the content in this slot. Used to match as-run schedule data with Nielsen ratings data for audience measurement, GRP/TRP calculation, and advertiser reporting.']
  planned_duration_seconds varchar [note: 'Intended duration of the slot in seconds as scheduled in the EPG rundown. Used for schedule integrity validation, ad pod capacity planning, and compliance with broadcast standards for minimum program duration.']
  planned_end_time timestamp [note: 'Scheduled end date and time for this slot as defined in the EPG rundown. Derived from planned_start_time plus planned_duration_seconds but stored explicitly to support EPG grid queries and boundary validation.']
  planned_start_time timestamp [note: 'Scheduled start date and time for this slot as defined in the EPG rundown prior to broadcast. Expressed in ISO 8601 format with timezone offset. Used for EPG publication, audience measurement alignment, and ad trafficking in Wide Orbit.']
  resolution varchar [note: 'Video resolution classification of the content in this slot (SD, HD, UHD, 4K). Determines the playout chain and CDN delivery profile used by Akamai and affects carriage fee agreements with MVPDs.']
  schedule_version varchar [note: 'Version number of the schedule rundown in which this slot was last modified. Incremented each time the EPG rundown is revised in Ericsson MediaFirst. Supports schedule change audit trails and version comparison for compliance reporting.']
  scte35_cue_in_time timestamp [note: 'Timestamp of the SCTE-35 splice_insert cue-in signal marking the return to primary program content after an ad break. Paired with scte35_cue_out_time to define the exact ad avail window for DAI and Wide Orbit ad scheduling.']
  scte35_cue_out_time timestamp [note: 'Timestamp of the SCTE-35 splice_insert cue-out signal marking the start of an ad break or content interruption within this slot. Used by Dynamic Ad Insertion (DAI) systems and downstream distribution platforms to trigger ad replacement. Null for non-break slot types.']
  slot_sequence_number varchar [note: 'Ordinal position of this slot within the daily rundown for the channel. Determines the playout order in Ericsson MediaFirst automation. Sequence numbers are contiguous integers starting at 1 for each broadcast day.']
  slot_status varchar [note: 'Current lifecycle state of the schedule slot within the EPG workflow. Values: scheduled (initial EPG entry), confirmed (locked for playout), on_air (currently broadcasting), completed (as-run recorded), cancelled (removed from schedule), replaced (substituted with alternate content). Drives Ericsson MediaFirst automation state machine.']
  slot_type varchar [note: 'Classification of the schedule slot by content category. Values: program (primary editorial content), promo (promotional spot), commercial_break (paid advertising break), filler (interstitial padding content), psa (Public Service Announcement), eas (Emergency Alert System message). Drives playout automation logic and ad insertion rules in Ericsson MediaFirst.']
  traffic_order_number varchar [note: 'Wide Orbit traffic system order number associated with this slot when it carries a commercial or promotional spot. Links the EPG slot to the ad sales order for affidavit generation, billing reconciliation, and makegood processing.']
  updated_timestamp timestamp [note: 'Timestamp when this schedule slot record was last modified. Tracks EPG edits, schedule revisions, and as-run updates. Used in conjunction with schedule_version for change management and compliance audit.']

  Note: 'Individual time slot within a program schedule representing a single content event or break event on a linear channel. Captures slot sequence number, planned start time, planned duration, actual start time (as-run), actual duration, slot type (program, promo, commercial break, filler, PSA, EAS), content reference, daypart assignment, and live/tape flag. The atomic unit of the EPG rundown managed in Ericsson MediaFirst.'
}

Table scheduling.epg_entry {
  epg_entry_id varchar [pk, note: 'Unique surrogate identifier for each Electronic Program Guide (EPG) entry record in the scheduling domain. Serves as the primary key for this Silver Layer data product.']
  availability_window_id varchar [note: 'Foreign key linking to rights.rights_availability_window. Business justification: EPG publication workflow requires real-time validation that content is within its rights availability window before displaying to viewers. Prevents publishing unavailable content and supports automate']
  channel_id varchar [note: 'Reference to the broadcast channel on which this EPG entry is scheduled for playout. Links to the channel master record in the scheduling domain.']
  compliance_content_rating_id varchar [note: 'Foreign key linking to compliance.content_rating. Business justification: EPG displays must show accurate content ratings for viewer guidance, V-chip filtering, and watershed compliance. Regulatory requirement in UK (Ofcom) and US (FCC) for electronic program guides. Denorm']
  production_episode_id varchar [note: 'Foreign key linking to production.production_episode. Business justification: EPG entries describe airing production episodes. Accurate EPG metadata (runtime, episode number, synopsis) must be sourced from the production episode record. This link enables automated EPG populatio']
  program_schedule_id varchar [note: 'Foreign key linking to scheduling.program_schedule. Business justification: An EPG entry is a published Electronic Program Guide record distributed to MVPDs and set-top boxes. EPG entries are generated from a specific program_schedule version (the authoritative linear channel']
  schedule_slot_id varchar [note: 'Reference to the approved schedule slot from which this EPG entry was derived. Represents the authoritative playout scheduling record in Ericsson MediaFirst.']
  scheduling_daypart_id varchar [note: 'Foreign key linking to scheduling.daypart. Business justification: EPG entries require daypart linkage for audience reach estimation, program discovery optimization, and daypart-based content recommendations. Creates new scheduling_daypart_id FK (role-prefixed to avo']
  series_id varchar [note: 'Foreign key linking to content.series. Business justification: EPG entries carry series_name as a denormalized plain column. Linking to content.series enables accurate series metadata in EPG feed syndication, supports series-level scheduling reports, and removes ']
  version_id varchar [note: 'Foreign key linking to content.version. Business justification: EPG guide data must reflect the specific version being broadcast — HDR availability, language, closed caption status displayed to viewers. Version-level FK enables accurate capability flags in EPG fee']
  ad_pod_count varchar [note: 'The number of ad pods (groups of advertisements within a break) scheduled within this program. Used for advertising inventory planning, Wide Orbit traffic scheduling, and revenue forecasting.']
  blackout_region_codes varchar [note: 'Comma-separated list of geographic region or market codes where this program is subject to broadcast blackout restrictions. Used by distribution systems to suppress EPG entry delivery in restricted markets. Populated only when is_blackout is True.']
  broadcast_date date [note: 'The calendar date on which this program is scheduled to air, in yyyy-MM-dd format. Used for day-level EPG grid display, daypart assignment, and schedule reporting.']
  code varchar [note: 'Externally distributed business identifier for this EPG entry, used in feeds delivered to MVPDs, vMVPDs, set-top boxes, and digital platforms for program discovery. Format: EPG-{CHANNEL}-{YYYYMMDD}-{HHMMSS}.']
  distribution_window varchar [note: 'The distribution window or release strategy under which this EPG entry is being broadcast, reflecting the windowing strategy for sequential content release. Determines rights availability and platform eligibility per Rightsline contract terms.']
  duration_seconds varchar [note: 'The total scheduled duration of the program in seconds, derived from the difference between scheduled start and end times. Used for EPG display, ad pod planning, and playout automation validation.']
  eidr varchar [note: 'The Entertainment Identifier Registry (EIDR) identifier for this content, providing a universal content identifier used across the media supply chain for content tracking, rights management, and EPG data exchange with MVPDs and vMVPDs.']
  entry_status varchar [note: 'The current lifecycle status of this EPG entry within the scheduling workflow. \'draft\' indicates pending review; \'approved\' indicates cleared for distribution; \'published\' indicates actively distributed to EPG feeds; \'cancelled\' indicates removed from schedule; \'expired\' indicates the broadcast window has passed.']
  epg_feed_version varchar [note: 'The version number of this EPG entry record as distributed in the EPG feed. Incremented each time the entry is updated and redistributed to MVPDs, vMVPDs, and digital platforms. Enables downstream systems to detect and apply updates.']
  genre_primary varchar [note: 'The primary content genre classification for this EPG entry as distributed in the EPG feed (e.g., Drama, Comedy, News, Sports, Documentary, Reality). Used for viewer discovery, content filtering, and audience analytics. [ENUM-REF-CANDIDATE: drama|comedy|news|sports|documentary|reality|entertainment|children|film|music — promote to reference product]']
  genre_secondary varchar [note: 'An optional secondary genre sub-classification providing more granular content categorization for EPG discovery and audience targeting (e.g., Crime Drama, Political Comedy, Investigative Documentary).']
  is_blackout boolean [note: 'Indicates whether geographic broadcast restrictions (blackout) apply to this EPG entry (True). When True, the program is subject to blackout rules that restrict distribution in specific geographic markets per rights agreements managed in Rightsline.']
  is_closed_caption boolean [note: 'Indicates whether closed captioning (CC) is available for this program (True). Distributed in EPG feeds for accessibility compliance and viewer information. Required for FCC closed captioning regulatory compliance.']
  is_hdr boolean [note: 'Indicates whether this program is available in High Dynamic Range (HDR) format (True). Distributed in EPG feeds to inform viewers and set-top boxes of enhanced picture quality availability.']
  is_live boolean [note: 'Indicates whether this EPG entry represents a live broadcast event (True) as opposed to a pre-recorded or time-shifted program (False). Drives playout automation configuration in Ericsson MediaFirst and is distributed in EPG feeds for viewer-facing live indicators.']
  is_new_episode boolean [note: 'Indicates whether this EPG entry represents a new, first-run episode (True) or a repeat/rerun broadcast (False). Distributed in EPG feeds for viewer-facing \'NEW\' indicators and drives audience measurement prioritization.']
  is_simulcast boolean [note: 'Indicates whether this program is being simultaneously broadcast across multiple platforms or channels (simulcast). When True, the same content is distributed concurrently on linear and digital/OTT platforms.']
  isan varchar [note: 'The International Standard Audiovisual Number (ISAN) uniquely identifying this audiovisual work globally. Used for rights management, content identification across platforms, and interoperability with Rightsline and international content registries.']
  language_code varchar [note: 'The primary audio language of the program, expressed as a three-letter ISO 639-2 language code (e.g., \'eng\' for English, \'spa\' for Spanish). Used in EPG feeds for language filtering and accessibility compliance.']
  last_updated_timestamp timestamp [note: 'The date and time when this EPG entry record was most recently modified, including schedule changes, metadata updates, or status transitions. Used for change detection in downstream EPG feed distribution and audit trail.']
  program_title varchar [note: 'The primary viewer-facing title of the program as it appears in the Electronic Program Guide. Used for consumer-facing program discovery across all distribution platforms.']
  published_timestamp timestamp [note: 'The date and time when this EPG entry was first published and distributed to external EPG feeds (MVPDs, vMVPDs, set-top boxes, digital platforms). Serves as the record audit created timestamp for this data product.']
  rights_window_end date [note: 'The end date of the broadcast rights window during which this content is cleared for transmission on this channel. After this date, the content enters a holdback period and cannot be broadcast without rights renewal in Rightsline.']
  rights_window_start date [note: 'The start date of the broadcast rights window during which this content is cleared for transmission on this channel. Derived from Rightsline contract availabilities and used to validate schedule compliance.']
  scheduled_end_time timestamp [note: 'The precise date and time at which this program is scheduled to end broadcast on the channel. Used to calculate program duration and to sequence adjacent EPG entries in the linear channel grid.']
  scheduled_start_time timestamp [note: 'The precise date and time at which this program is scheduled to begin broadcast on the channel, expressed in ISO 8601 format with timezone offset. This is the principal business event timestamp for the EPG entry and drives all downstream playout automation in Ericsson MediaFirst.']
  scte35_cue_out_time timestamp [note: 'The timestamp of the SCTE-35 splice_insert cue-out signal marking the start of an ad break opportunity within this program. Used by Dynamic Ad Insertion (DAI) systems and Wide Orbit traffic systems for ad pod placement and automated ad scheduling.']
  synopsis_long varchar [note: 'A detailed program description (typically up to 500 characters) distributed in EPG feeds for display on digital platforms, OTT apps, and web-based program guides. Sourced from Dalet Galaxy content metadata.']
  synopsis_short varchar [note: 'A brief program description (typically up to 100 characters) distributed in EPG feeds for display on set-top boxes and digital platforms with limited screen real estate. Sourced from Dalet Galaxy content metadata.']
  total_ad_break_duration_seconds varchar [note: 'The total cumulative duration in seconds of all scheduled ad breaks within this program. Used for advertising inventory management, compliance with ad load regulations, and Wide Orbit traffic scheduling.']
  video_resolution varchar [note: 'The video resolution format of this program as distributed in the EPG feed (e.g., SD, HD, FHD, UHD/4K). Used for viewer-facing display in EPG interfaces and for platform compatibility routing.']

  Note: 'Published Electronic Program Guide record distributed to MVPDs, vMVPDs, set-top boxes, and digital platforms for viewer-facing program discovery. Captures program title, episode title, series name, genre, content rating (MPA), short and long synopsis, start/end time, channel, language, closed-caption flag, HDR/resolution flag, ISAN/EIDR identifier, and distribution window. Derived from approved schedule slots and enriched with content metadata for consumer-facing EPG feeds.'
}

Table scheduling.ad_break {
  ad_break_id varchar [pk, note: 'Unique surrogate identifier for the ad break (ad pod) record within the scheduling domain. Primary key for this entity.']
  ad_billing_order_id varchar [note: 'Foreign key linking to billing.ad_billing_order. Business justification: Ad breaks are the inventory units sold in ad orders. Direct link required for order-to-inventory reconciliation, flight pacing analysis, and verifying contracted vs. delivered spots in advertising bil']
  channel_id varchar [note: 'Reference to the broadcast channel on which this ad break is scheduled for playout. Supports multi-channel scheduling and channel-level inventory reporting.']
  daypart_id varchar [note: 'Foreign key linking to scheduling.daypart. Business justification: Ad break currently stores daypart_code as a STRING. This should be normalized to FK to the daypart reference table. Ad break pricing, GRP targets, and inventory management all depend on daypart attrib']
  political_ad_record_id varchar [note: 'Foreign key linking to compliance.political_ad_record. Business justification: Political ad breaks require detailed public inspection file documentation per FCC Section 315 (reasonable access, lowest unit charge). Each political ad break must link to compliance record for public']
  program_schedule_id varchar [note: 'The identifier of the SCTE-35 splice_insert or time_signal cue-out marker that signals the start of the ad break to downstream distribution systems and Dynamic Ad Insertion (DAI) platforms. References the specific SCTE-35 message that triggers break entry.']
  schedule_slot_id varchar [note: 'Reference to the parent schedule slot within which this ad break is positioned. Links the ad break to its containing program or interstitial window in the linear channel grid.']
  actual_duration_seconds varchar [note: 'The actual total duration of the ad break as recorded during playout by the Ericsson MediaFirst automation system. Used for post-log reconciliation, affidavit generation, and makegood assessment when actual duration deviates from planned.']
  actual_start_time timestamp [note: 'The actual wall-clock time at which the ad break commenced during playout, as recorded by the Ericsson MediaFirst automation system. Used for affidavit generation and post-log reconciliation against the scheduled start time.']
  affidavit_generated boolean [note: 'Indicates whether a proof-of-broadcast affidavit has been generated for this ad break in the Wide Orbit traffic system following confirmed playout. Affidavits are required for advertiser billing reconciliation and regulatory compliance.']
  automation_event_code varchar [note: 'The event identifier assigned by the Ericsson MediaFirst playout automation system to the break trigger event. Used to correlate the scheduled ad break with the actual playout automation log for post-log reconciliation and technical fault analysis.']
  avail_count varchar [note: 'The total number of individual advertising avail slots (unit positions) within this ad break pod. Each avail represents a discrete sellable unit (e.g., a 30-second spot position). Used for inventory capacity planning and traffic scheduling.']
  blackout_restricted boolean [note: 'Indicates whether this ad break is subject to geographic blackout restrictions that prevent its broadcast or streaming in specific markets or regions. When true, downstream distribution systems must apply blackout logic per rights and regulatory obligations.']
  break_position varchar [note: 'Positional classification of the ad break relative to the surrounding program content. \'pre-roll\' = before program content begins; \'mid-roll\' = within program content; \'post-roll\' = after program content ends; \'interstitial\' = between programs in the schedule grid.']
  break_status varchar [note: 'Current lifecycle status of the ad break within the scheduling and playout workflow. \'scheduled\' = planned but not yet confirmed; \'confirmed\' = traffic-confirmed with sold inventory; \'aired\' = playout completed and affidavit-eligible; \'cancelled\' = removed from schedule; \'hold\' = temporarily suspended pending resolution.']
  break_type varchar [note: 'Classification of the ad break by inventory ownership and commercial purpose. \'local_avail\' = inventory sold by local affiliate; \'network_avail\' = inventory sold by the network; \'promotional\' = house promotional content; \'public_service\' = public service announcements; \'emergency\' = emergency alert system override. Drives revenue attribution and traffic scheduling rules.']
  broadcast_date date [note: 'The calendar date on which this ad break is scheduled to air, expressed in the channel\'s broadcast day convention (which may differ from the wall-clock date for late-night programming). Used for daily traffic scheduling, affidavit generation, and revenue reporting.']
  content_restriction_code varchar [note: 'A code indicating any content category restrictions applicable to advertising within this break (e.g., no alcohol ads during children\'s programming, no competitor ads). Enforced by the traffic system during ad assignment. [ENUM-REF-CANDIDATE: NO_ALCOHOL|NO_GAMBLING|NO_PHARMA|NO_COMPETITOR|CHILDREN_SAFE|NONE — promote to reference product]']
  created_timestamp timestamp [note: 'The timestamp when this ad break record was first created in the scheduling system. Serves as the RECORD_AUDIT_CREATED field for data lineage, audit trail, and Silver layer ingestion tracking.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for the rate card CPM and any monetary values associated with this ad break (e.g., USD, GBP, EUR). Supports multi-currency operations for international broadcast networks.']
  dai_eligible boolean [note: 'Indicates whether this ad break is enabled for Dynamic Ad Insertion (DAI), allowing server-side ad replacement for OTT/streaming simulcast audiences. When true, the break is eligible for addressable advertising via DAI platforms such as those integrated with Akamai CDN.']
  epg_break_label varchar [note: 'The human-readable label or descriptor for this ad break as it appears in the Electronic Program Guide (EPG) and scheduling rundown. Used by traffic coordinators and scheduling operators to identify breaks in the EPG interface.']
  grp_target decimal(8,4) [note: 'The target Gross Rating Point (GRP) value for this ad break, representing the expected total audience delivery as a percentage of the total target population. Used for audience guarantee tracking and campaign delivery reporting against Nielsen ratings.']
  makegood_required boolean [note: 'Indicates whether a makegood (compensatory ad spot) is required for this break due to a failure to air as contracted — for example, due to preemption, technical failure, or underdelivery. Triggers makegood workflow in Wide Orbit.']
  max_duration_seconds varchar [note: 'The maximum allowable duration of the ad break in seconds, representing the hard ceiling for total ad content that may be inserted. Exceeding this value would cause schedule overrun. May differ from planned duration when flex time is permitted.']
  nielsen_program_rating decimal(6,4) [note: 'The Nielsen audience rating for the program surrounding this ad break, representing the percentage of total TV households tuned in. Used for CPM calculation, audience guarantee assessment, and scatter market pricing.']
  planned_duration_seconds varchar [note: 'The planned total duration of the ad break (ad pod) in seconds as defined in the program schedule. Represents the total sellable commercial time allocated to this break. Standard pod durations are typically 30, 60, 90, 120, or 180 seconds.']
  pod_number varchar [note: 'The pod number identifying this ad break within the broadcast day for the channel. Distinct from sequence_number (which is relative to the program); pod_number is the channel-day-level ordinal used in traffic scheduling and affidavit reporting.']
  preemption_reason varchar [note: 'The reason code explaining why this ad break was preempted or cancelled if it did not air as scheduled. Used for makegood processing, revenue assurance, and operational reporting. \'none\' when the break aired as planned.']
  rate_card_cpm decimal(10,4) [note: 'The published rate card CPM (Cost Per Mille — cost per 1,000 audience impressions) for this ad break, expressed in the local currency. Represents the base pricing for inventory in this break before negotiated discounts. Used for revenue forecasting and yield management.']
  scheduled_start_time timestamp [note: 'The planned wall-clock date and time at which the ad break is scheduled to begin on the linear channel. Expressed in the channel\'s broadcast timezone. This is the principal BUSINESS_EVENT_TIMESTAMP for the break.']
  sequence_number varchar [note: 'Ordinal position of this ad break within the parent schedule slot or program. Used to order multiple breaks within a single program (e.g., break 1, break 2, break 3) for traffic scheduling and playout automation.']
  simulcast_eligible boolean [note: 'Indicates whether this ad break is included in the simultaneous multi-platform broadcast (simulcast) of the channel. When false, the break may be suppressed or replaced on simulcast streams (e.g., OTT, vMVPD).']
  sold_avail_count varchar [note: 'The number of individual avail slots within this break that have been sold and assigned to advertiser spots in the Wide Orbit traffic system. Used with avail_count to compute sellout rate and unsold inventory.']
  sold_duration_seconds varchar [note: 'The total duration in seconds of ad inventory within this break that has been sold to advertisers via the Wide Orbit traffic system. Used to calculate unsold (remnant) inventory and sellout rate for revenue assurance reporting.']
  updated_timestamp timestamp [note: 'The timestamp when this ad break record was most recently modified in the scheduling system. Serves as the RECORD_AUDIT_UPDATED field for change tracking, incremental data pipeline processing, and audit compliance.']
  wide_orbit_break_code varchar [note: 'The externally-known break identifier assigned by the Wide Orbit traffic and billing system. Used to reconcile ad break inventory between the scheduling domain and the ad sales/traffic fulfillment workflow. This is the BUSINESS_IDENTIFIER for the break as known to the traffic system.']

  Note: 'Commercial break (ad pod) within a schedule slot — capturing break position (pre-roll, mid-roll, post-roll), sequence number, planned and maximum pod duration, break type (local avail, network avail, promotional), SCTE-35 cue-in/cue-out marker references, DAI eligibility flag, and Wide Orbit traffic system break ID. The structural container for sellable ad inventory within the linear schedule, linking scheduling to advertising sales fulfillment.'
}

Table scheduling.playout_event {
  playout_event_id varchar [pk, note: 'Unique surrogate identifier for each as-run playout event record in the Ericsson MediaFirst as-run log. Serves as the primary key for this table.']
  ad_billing_order_id varchar [note: 'Foreign key linking to billing.ad_billing_order. Business justification: Playout events represent actual aired content that must be reconciled against ad billing orders for affidavit generation, makegood determination, and revenue recognition. Critical for verifying contra']
  ad_pod_id varchar [note: 'Identifier of the advertising pod (Ad Pod) to which this playout event belongs, if the event is a commercial break or advertisement. Links to the Wide Orbit ad scheduling record for billing reconciliation.']
  broadcast_license_id varchar [note: 'Foreign key linking to compliance.broadcast_license. Business justification: Playout events incur transmission and playout automation costs. Transmission cost allocation, actual-vs-budget variance analysis, and operational cost accounting require event-to-cost-center mapping. ']
  channel_id varchar [note: 'Reference to the broadcast channel on which this playout event was transmitted. Links to the channel master record.']
  closed_caption_record_id varchar [note: 'Foreign key linking to compliance.closed_caption_record. Business justification: Each playout event must have corresponding closed caption compliance record for FCC CVAA accessibility reporting. Required for quarterly closed captioning quality reports and complaint response. Links']
  daypart_id varchar [note: 'Foreign key linking to scheduling.daypart. Business justification: Playout event currently stores daypart_code as a STRING. As-run logs need to reference daypart attributes for affidavit generation, Nielsen reporting, and GRP calculation. Normalizing to FK enables JO']
  deliverable_id varchar [note: 'Foreign key linking to production.deliverable. Business justification: A playout event plays out a specific deliverable asset. Operations teams verify the deliverable\'s checksum, QC pass flag, and technical specs at playout. This link enables as-run reconciliation agains']
  grant_id varchar [note: 'Foreign key linking to rights.grant. Business justification: As-run logs require grant tracking for royalty calculation, rights holder reporting, and usage reconciliation. Post-broadcast process matches actual airings to grants for residual payments and revenue']
  invoice_id varchar [note: 'Identifier of the Wide Orbit affidavit document generated for this playout event. Populated when affidavit_generated is true. Used for advertiser billing reconciliation and regulatory proof-of-performance.']
  partner_id varchar [note: 'Foreign key linking to partner.partner. Business justification: Events transmitted via specific equipment - required for technical affidavits, equipment performance tracking, and playout automation diagnostics. Supports as-run reconciliation and equipment maintena']
  primary_playout_title_id varchar [note: 'Reference to the content asset (programme, advertisement, interstitial, or filler) that was transmitted in this playout event. Links to the content master in the Digital Asset Management system.']
  production_episode_id varchar [note: 'Foreign key linking to production.production_episode. Business justification: A playout event airs a specific production episode. As-run logs, residuals calculation, and rights clearance verification all require linking the playout event to the production episode. This is a fun']
  program_rundown_id varchar [note: 'Foreign key linking to scheduling.program_rundown. Business justification: A playout_event is the as-run log from Ericsson MediaFirst capturing actual transmission. For live and studio programs, the playout_event corresponds to a specific program_rundown that was executed. T']
  program_schedule_id varchar [note: 'Reference to the planned program schedule entry from which this playout event was derived. Enables deviation analysis between planned and actual transmission.']
  schedule_slot_id varchar [note: 'Foreign key linking to scheduling.schedule_slot. Business justification: Playout events are as-run logs capturing actual transmission of schedule slots. Currently playout_event links to program_schedule but not to the specific schedule_slot that was transmitted. This FK en']
  version_id varchar [note: 'Foreign key linking to content.version. Business justification: Post-transmission audit and rights compliance verification require knowing which technical version was actually transmitted. Version-territory matching for rights clearance and QC reconciliation betwe']
  actual_duration_seconds varchar [note: 'Actual transmitted duration of the playout event in seconds as recorded in the as-run log. Used for rights usage reporting, billing reconciliation, and compliance verification.']
  actual_end_time timestamp [note: 'Actual transmission end time as recorded in the Ericsson MediaFirst as-run log. Used with actual_start_time to confirm full transmission and calculate actual duration.']
  actual_start_time timestamp [note: 'Actual transmission start time as recorded in the Ericsson MediaFirst as-run log. The authoritative timestamp for affidavit generation, rights usage reporting, and regulatory proof-of-performance.']
  affidavit_generated boolean [note: 'Indicates whether a broadcast affidavit (proof-of-performance document) has been generated for this playout event in Wide Orbit. Affidavits are the evidentiary basis for advertiser billing and regulatory compliance.']
  automation_mode varchar [note: 'Operational mode of the Ericsson MediaFirst playout automation at the time of this event. \'auto\' = fully automated playout; \'manual\' = operator-controlled; \'override\' = scheduled automation overridden by operator; \'failover\' = backup/failover system active.']
  blackout_flag boolean [note: 'Indicates whether this playout event was subject to a geographic broadcast blackout restriction. When true, the event was blacked out in one or more markets per rights or regulatory obligations.']
  broadcast_date date [note: 'Calendar date on which this playout event was transmitted, expressed in the channel\'s local broadcast day (which may differ from UTC date for overnight programming).']
  broadcast_standard varchar [note: 'Technical broadcast standard under which this playout event was transmitted. Determines encoding, modulation, and compliance requirements.']
  content_rating varchar [note: 'Content rating classification of the transmitted asset as defined by the Motion Picture Association (MPA) TV Parental Guidelines. Used for COPPA compliance, watershed enforcement, and FCC children\'s programming obligations.']
  created_timestamp timestamp [note: 'Timestamp when this as-run playout event record was first ingested into the Silver layer from the Ericsson MediaFirst as-run log. Serves as the audit creation timestamp for data lineage.']
  dai_eligible boolean [note: 'Indicates whether this playout event was eligible for Dynamic Ad Insertion (DAI) on OTT/streaming platforms. Used for digital advertising reconciliation and DAI revenue attribution.']
  dalet_asset_code varchar [note: 'Asset identifier in the Dalet Galaxy Media Asset Management system for the content transmitted in this playout event. Used for digital asset reconciliation and archive linkage.']
  event_type varchar [note: 'Classification of the playout event by content category. Determines applicable rights, billing rules, and regulatory requirements. [ENUM-REF-CANDIDATE: program|commercial|promo|interstitial|filler|ident|emergency_alert — promote to reference product]']
  failover_activated boolean [note: 'Indicates whether the Ericsson MediaFirst failover/backup playout system was active during this event. When true, the primary playout chain was unavailable and the backup system handled transmission.']
  isan_code varchar [note: 'International Standard Audiovisual Number (ISAN) identifying the programme or content asset transmitted. Used for rights usage reporting and royalty calculation in Rightsline.']
  isci_code varchar [note: 'Industry Standard Commercial Identification (ISCI) code for the commercial asset transmitted in this playout event. Used for advertiser billing reconciliation and affidavit generation in Wide Orbit.']
  mediafirst_event_code varchar [note: 'Native event identifier assigned by Ericsson MediaFirst automation system for this as-run log entry. Used for reconciliation with the source playout system.']
  must_carry_flag boolean [note: 'Indicates whether this playout event was subject to must-carry obligations requiring mandatory channel inclusion by MVPDs. Used for regulatory compliance reporting to the FCC.']
  playout_status varchar [note: 'Outcome status of the playout event as recorded in the Ericsson MediaFirst as-run log. \'aired\' = transmitted as planned; \'skipped\' = omitted from transmission; \'substituted\' = replaced with alternate content; \'failed\' = transmission error; \'partial\' = incomplete transmission; \'delayed\' = transmitted late.']
  rights_clearance_status varchar [note: 'Rights clearance status of the content asset at the time of transmission. \'cleared\' = rights verified and valid; \'pending\' = clearance in progress; \'expired\' = rights window had lapsed; \'restricted\' = transmission was restricted. Used for rights compliance audit and Rightsline reconciliation.']
  scheduled_duration_seconds varchar [note: 'Planned duration of the playout event in seconds as defined in the program schedule rundown. Used as the baseline for duration deviation analysis.']
  scheduled_start_time timestamp [note: 'Planned transmission start time for this event as defined in the Electronic Program Guide (EPG) and program schedule rundown. Used as the baseline for schedule deviation calculation.']
  simulcast_flag boolean [note: 'Indicates whether this playout event was simultaneously broadcast across multiple platforms (simulcast). When true, the event was transmitted on additional channels or OTT platforms concurrently.']
  start_deviation_seconds varchar [note: 'Difference in seconds between actual_start_time and scheduled_start_time. Positive values indicate late start; negative values indicate early start. Key metric for schedule adherence and SLA reporting.']
  substitution_reason varchar [note: 'Reason code explaining why the originally scheduled content was substituted with alternate content. Populated only when playout_status is \'substituted\'. Used for rights compliance and editorial audit trails.']
  transmission_type varchar [note: 'Mode of content delivery for this playout event. \'linear\' = traditional scheduled broadcast; \'vod\' = Video On Demand; \'simulcast\' = simultaneous multi-platform; \'ott\' = Over-The-Top streaming; \'fast\' = Free Ad-Supported Streaming Television.']
  updated_timestamp timestamp [note: 'Timestamp when this playout event record was last modified in the Silver layer, for example following affidavit generation, rights clearance update, or schedule reconciliation.']
  wide_orbit_log_code varchar [note: 'Corresponding log entry identifier in Wide Orbit Traffic and Billing system. Used for advertiser billing reconciliation and affidavit generation.']

  Note: 'As-run log record from Ericsson MediaFirst capturing actual transmission of each schedule slot as broadcast. Records actual start/end time, duration, content ID, channel, playout status (aired, skipped, substituted, failed), automation mode (auto, manual, override), operator ID, and deviation from planned schedule in seconds. The authoritative as-run record serving as the evidentiary basis for affidavit generation, rights usage reporting, advertiser billing reconciliation, and regulatory proof-of-performance.'
}

Table scheduling.program_rundown {
  program_rundown_id varchar [pk, note: 'Unique surrogate identifier for the program rundown record in the Databricks Silver Layer. Primary key for this entity.']
  channel_id varchar [note: 'Reference to the broadcast channel on which this program rundown is executed. Links to the channel master in the scheduling domain.']
  content_episode_id varchar [note: 'Reference to the episode or content asset in the content domain that this rundown is associated with. Enables linkage to content metadata, rights, and digital asset records.']
  daypart_id varchar [note: 'Foreign key linking to scheduling.daypart. Business justification: Program rundown currently stores daypart_code as a STRING. This should be normalized to FK to the daypart reference table (scheduling_daypart_id). This enables JOIN to retrieve daypart_name, rate_mult']
  grant_id varchar [note: 'Foreign key linking to rights.grant. Business justification: Live production rundowns need real-time rights clearance verification per segment. Control room operators validate grant coverage during live broadcasts to prevent on-air rights violations, especially']
  program_schedule_id varchar [note: 'Reference to the parent program schedule entry (Electronic Program Guide slot) that this rundown fulfills. Aligns with scheduling.program_schedule.']
  schedule_slot_id varchar [note: 'Foreign key linking to scheduling.schedule_slot. Business justification: A program_rundown is the detailed production rundown for a live or studio program that occupies a specific schedule_slot. The schedule_slot is the parent broadcast event; the program_rundown is the op']
  version_id varchar [note: 'Foreign key linking to content.version. Business justification: Rundowns drive playout automation and must reference the specific content version for technical parameter configuration. The dalet_story_code plain column suggests version-level asset referencing; a p']
  ad_pod_count varchar [note: 'Number of commercial break ad pods (groups of ads) planned within this rundown. Used for Wide Orbit traffic scheduling and SCTE-35 cue marker planning.']
  approved_by varchar [note: 'Name or identifier of the producer or scheduling manager who approved the final rundown for transmission. Required for production accountability and compliance audit trails.']
  approved_timestamp timestamp [note: 'The date and time when the rundown was formally approved for playout. Marks the transition from \'approved\' to \'locked\' status in the production workflow.']
  blackout_flag boolean [note: 'Indicates whether geographic broadcast blackout restrictions apply to this program rundown. When True, blackout rules must be enforced by distribution systems per rights agreements managed in Rightsline.']
  broadcast_date date [note: 'The calendar date on which this program rundown is scheduled for transmission. Used for EPG alignment, scheduling compliance, and as-run reconciliation.']
  content_rating varchar [note: 'The TV Parental Guidelines content rating assigned to the program (e.g., TV-G, TV-14, TV-MA). Used for scheduling compliance, COPPA restrictions, and EPG display.']
  created_timestamp timestamp [note: 'The date and time when this rundown record was first created in the system, typically when the production team initiates show preparation in Dalet Galaxy.']
  dai_eligible boolean [note: 'Indicates whether this program rundown is eligible for Dynamic Ad Insertion (DAI) on streaming/OTT platforms. Drives ad tech configuration in Akamai CDN and Adobe Experience Platform.']
  dalet_story_code varchar [note: 'The story or rundown identifier in Dalet Galaxy Media Asset Management system. Enables traceability from the Silver Layer back to the MAM workflow for metadata, archive, and ingest operations.']
  emergency_alert_ready boolean [note: 'Indicates whether the rundown and playout configuration supports Emergency Alert System (EAS) interruption. Required for FCC broadcast compliance and emergency preparedness.']
  last_modified_timestamp timestamp [note: 'The date and time when this rundown record was last updated. Tracks the most recent editorial or operational change to the rundown for audit and version control purposes.']
  live_flag boolean [note: 'Indicates whether the program is transmitted live (True) or is a pre-recorded/tape playback (False). Drives Ericsson MediaFirst live playout mode and affects DAI eligibility and failover configuration.']
  mediafirst_rundown_code varchar [note: 'The native rundown identifier assigned by Ericsson MediaFirst playout automation system. Used for bidirectional reconciliation between the Silver Layer and the operational playout system.']
  playout_failover_mode varchar [note: 'Defines the failover strategy configured in Ericsson MediaFirst if the primary playout source fails during this program. \'none\' = no failover; \'backup_channel\' = switch to backup feed; \'filler_loop\' = play filler content; \'manual\' = operator intervention required.']
  production_format varchar [note: 'Describes the production origination format of the program. \'studio\' = produced in-house studio; \'remote\' = outside broadcast; \'hybrid\' = mixed studio and remote; \'tape\' = pre-recorded playback; \'simulcast\' = simultaneous multi-platform broadcast.']
  program_content_seconds varchar [note: 'Total planned duration of editorial/program content segments in seconds, excluding commercial breaks and credits. Used for content-to-ad ratio compliance reporting.']
  program_title varchar [note: 'The editorial title of the program for which this rundown is prepared (e.g., \'Morning News Live\', \'Prime Time Sports\'). Used for display in production systems and EPG.']
  rights_clearance_status varchar [note: 'Current rights clearance status for the program content in this rundown. \'cleared\' = all rights verified for broadcast; \'pending\' = clearance in progress; \'restricted\' = broadcast blocked; \'expired\' = rights window has lapsed. Sourced from Rightsline.']
  rundown_code varchar [note: 'Externally-known alphanumeric business identifier for the rundown, used by production teams and Ericsson MediaFirst automation to reference the show rundown. Unique within a broadcast date and channel.']
  rundown_notes varchar [note: 'Free-text production notes associated with the rundown, capturing special instructions, last-minute changes, talent notes, or technical advisories for the production and playout teams.']
  rundown_status varchar [note: 'Current lifecycle state of the rundown. \'draft\' = in preparation; \'approved\' = signed off by producer; \'locked\' = no further edits permitted; \'transmitted\' = playout completed; \'archived\' = retained for compliance.']
  rundown_type varchar [note: 'Classification of the program rundown by genre or production format. Drives template selection in Ericsson MediaFirst and informs segment structure expectations. [ENUM-REF-CANDIDATE: news|sports|entertainment|talk_show|documentary|magazine|special — promote to reference product]']
  rundown_version varchar [note: 'Incremental version number of the rundown, incremented each time the rundown is revised. Enables version tracking and rollback for production teams and playout automation.']
  scheduled_end_time timestamp [note: 'The planned transmission end timestamp for the program. Used to calculate total runtime and validate against EPG slot allocation.']
  scheduled_start_time timestamp [note: 'The planned transmission start timestamp for the program, including timezone offset. Used by Ericsson MediaFirst automation for playout triggering and EPG publication.']
  scte35_cue_count varchar [note: 'Number of SCTE-35 digital program insertion cue markers planned in this rundown. Used for Dynamic Ad Insertion (DAI) triggering and ad break signaling to downstream distribution systems.']
  segment_count varchar [note: 'Total number of rundown items (segments) defined in this rundown, including news blocks, interviews, commercial breaks, tosses, and credits. Used for production planning and playout validation.']
  simulcast_flag boolean [note: 'Indicates whether this program rundown is simultaneously broadcast across multiple platforms (linear, OTT, streaming). When True, simulcast platform configurations must be applied.']
  total_ad_time_seconds varchar [note: 'Total planned advertising time in seconds across all ad pods in the rundown. Used for FCC/Ofcom advertising minutage compliance and Wide Orbit traffic reconciliation.']
  total_runtime_seconds varchar [note: 'Total planned duration of the program in seconds, encompassing all segments including program content, commercial breaks, and credits. Must match the EPG slot allocation.']
  transmitted_timestamp timestamp [note: 'The actual date and time when playout of this program rundown commenced transmission. Populated by Ericsson MediaFirst upon broadcast start. Used for as-run reconciliation and affidavit generation.']
  wide_orbit_log_code varchar [note: 'The traffic log identifier in Wide Orbit used to reconcile ad pod placements in this rundown against the ad scheduling and billing system. Supports affidavit generation and as-run confirmation.']

  Note: 'Detailed production rundown for a live or studio program defining the internal segment structure — news blocks, interview segments, commercial breaks, toss segments, and closing credits. Captures program title, episode reference, total runtime, segment count, live/tape flag, rundown status, and the ordered list of rundown items with planned durations. Used by Ericsson MediaFirst automation for live show playout control and by production teams for show preparation.'
}

Table scheduling.rundown_item {
  rundown_item_id varchar [pk, note: 'Unique surrogate identifier for each individual segment or item within a program rundown. Primary key for the rundown_item entity in the Databricks Silver Layer.']
  ad_break_id varchar [note: 'Foreign key linking to scheduling.ad_break. Business justification: A rundown_item can represent an ad pod within a live program rundown (ad_pod_flag: BOOLEAN, ad_pod_duration_seconds: INT, ad_pod_spot_count: INT). When a rundown_item is an ad pod, it corresponds to a']
  content_episode_id varchar [note: 'Foreign key linking to content.content_episode. Business justification: Individual rundown items represent specific episode segments for broadcast. Episode-level linking enables segment-level rights clearance verification, music cue sheet tracking per item, and accurate b']
  deliverable_id varchar [note: 'Foreign key linking to production.deliverable. Business justification: Each rundown item references a specific production deliverable (video package, VO, pre-produced segment) that will be played out. Traffic and operations teams use this link to verify the deliverable\'s']
  program_rundown_id varchar [note: 'Foreign key linking to scheduling.program_rundown. Business justification: Rundown items are individual segments within a program rundown. Currently rundown_item only links to program_schedule, but it should also link to the specific program_rundown that contains it. This pr']
  program_schedule_id varchar [note: 'Reference to the parent program schedule (rundown header) that this item belongs to. Links the atomic rundown item to its containing broadcast schedule.']
  role_id varchar [note: 'Foreign key linking to talent.role. Business justification: Individual rundown segments must track which role is active for script cues, graphics templates, segment-level credit attribution, and scene-specific production notes. Enables granular production coor']
  talent_profile_id varchar [note: 'Foreign key linking to talent.talent_profile. Business justification: Individual rundown segments feature specific talent (correspondents, panelists, guests) requiring tracking for segment-level screen time calculation, residual eligibility determination, and credit att']
  version_id varchar [note: 'Foreign key linking to content.version. Business justification: Each rundown item references a specific content version for playout automation. The dalet_asset_code plain column on rundown_item is a denormalized version reference; a proper FK enables automated pre']
  actual_duration_seconds varchar [note: 'Real elapsed duration of the rundown item in seconds as recorded during or after playout. Compared against planned_duration_seconds for show timing analysis and as-run log reconciliation.']
  actual_end_time timestamp [note: 'Actual wall-clock time at which this rundown item completed playout. Used alongside actual_start_time to compute actual_duration_seconds and to validate show overrun or underrun conditions.']
  actual_start_time timestamp [note: 'Actual wall-clock time at which this rundown item began playout as recorded by the Ericsson MediaFirst automation system. Used for as-run log generation and Wide Orbit affidavit reconciliation.']
  ad_pod_duration_seconds varchar [note: 'Total allocated duration in seconds for the ad pod break associated with this rundown item. Populated only when ad_pod_flag is true. Used for ad load compliance and Wide Orbit traffic scheduling.']
  ad_pod_flag boolean [note: 'Indicates whether this rundown item represents an Ad Pod (a group of commercial spots within a break). When true, triggers SCTE-35 cue marker insertion and Dynamic Ad Insertion (DAI) eligibility checks.']
  ad_pod_spot_count varchar [note: 'Number of individual commercial spots scheduled within this ad pod break. Used for ad load monitoring, Wide Orbit traffic log validation, and FCC children\'s programming ad limit compliance.']
  backtime_flag boolean [note: 'Indicates whether this rundown item is backtimed — i.e., its start time is calculated backwards from a fixed end point (e.g., top-of-hour news break or programme end). Critical for live show timing control in Ericsson MediaFirst.']
  blackout_flag boolean [note: 'Indicates whether geographic broadcast blackout restrictions apply to this rundown item. When true, triggers blackout enforcement logic in the distribution layer per rights agreements managed in Rightsline.']
  content_rating varchar [note: 'Motion Picture Association (MPA) or TV Parental Guidelines content rating applicable to this rundown item. Used for COPPA compliance checks, watershed scheduling enforcement, and EPG advisory display.']
  created_timestamp timestamp [note: 'Timestamp when this rundown item record was first created in the data platform, typically corresponding to the initial rundown build in Dalet Galaxy or Ericsson MediaFirst. Supports audit trail and data lineage.']
  cue_text varchar [note: 'Editorial cue or introduction text read by the presenter or director to introduce this rundown item. Stored as the production script reference for live show execution and post-broadcast archive.']
  dalet_asset_code varchar [note: 'Reference identifier for the content asset in Dalet Galaxy Media Asset Management system associated with this rundown item. Links the production element to its archived media essence, metadata, and workflow history.']
  daypart_code varchar [note: 'Code identifying the broadcast daypart (time segment of the broadcast day) in which this rundown item falls. Links to scheduling.daypart for rate multiplier, demographic targeting, and Nielsen audience measurement context.']
  duration_variance_seconds varchar [note: 'Difference in seconds between actual_duration_seconds and planned_duration_seconds (actual minus planned). Positive values indicate overrun; negative values indicate underrun. Used for show timing analysis and rundown optimisation.']
  eom_timecode varchar [note: 'SMPTE timecode marking the End of Message (EOM) — the precise out-point of the media asset for this rundown item. Used alongside som_timecode for frame-accurate duration calculation and playout control.']
  epg_description varchar [note: 'Short editorial description of this rundown item for display in the Electronic Program Guide (EPG). Populated for story packages and feature segments; used by EPG aggregators and on-screen guide systems.']
  graphics_template_code varchar [note: 'Identifier for the graphics or lower-third template to be rendered by the Ericsson MediaFirst graphics engine for this rundown item. Applicable for graphic and lower_third segment formats.']
  isci_code varchar [note: 'Industry Standard Commercial Identification (ISCI) code for the commercial spot associated with this rundown item. Populated for commercial_break items; used for Wide Orbit affidavit generation and advertiser billing reconciliation.']
  item_status varchar [note: 'Current production lifecycle state of the rundown item as managed in the live show production control system. Drives automation decisions in Ericsson MediaFirst and Dalet Galaxy workflow.']
  item_title varchar [note: 'Human-readable editorial title or slug for the rundown item as displayed in the production control system and Electronic Program Guide (EPG). Used by producers and directors during live show execution.']
  item_type varchar [note: 'Classification of the discrete production element represented by this rundown item. Determines playout behaviour, automation triggers, and ad pod eligibility. [ENUM-REF-CANDIDATE: story_package|live_shot|interview|commercial_break|graphic|music_bed|filler|open|close — promote to reference product]']
  live_flag boolean [note: 'Indicates whether this rundown item is a live production element (true) or a pre-recorded/packaged asset (false). Drives Ericsson MediaFirst automation mode selection and EPG live indicator display.']
  mediafirst_item_code varchar [note: 'Native item identifier assigned by the Ericsson MediaFirst playout automation system for this rundown element. Used for reconciliation between the Silver Layer data product and the operational playout system.']
  planned_duration_seconds varchar [note: 'Scheduled duration of the rundown item in seconds as defined during pre-production rundown preparation. Used for total show timing, backtime calculations, and ad pod compliance checks.']
  planned_start_time timestamp [note: 'Scheduled wall-clock start time for this rundown item based on the pre-production rundown. Used for Electronic Program Guide (EPG) display, backtime calculations, and SCTE-35 cue marker pre-positioning.']
  rights_clearance_status varchar [note: 'Current rights clearance state for the content asset associated with this rundown item as verified against Rightsline. Prevents playout of uncleared content and supports compliance with windowing and holdback obligations.']
  scte35_cue_in_time timestamp [note: 'Timestamp at which the SCTE-35 splice_insert cue-in signal is triggered to mark the return to programme content after an ad break. Used for DAI reconciliation and ad delivery verification.']
  scte35_cue_out_time timestamp [note: 'Timestamp at which the SCTE-35 splice_insert cue-out signal is triggered to mark the start of an ad break for Dynamic Ad Insertion (DAI) and addressable advertising systems. Populated for commercial_break item types.']
  segment_format varchar [note: 'Production format classification of the rundown item using broadcast newsroom terminology. Determines the technical playout configuration and graphics overlay requirements in Ericsson MediaFirst. [ENUM-REF-CANDIDATE: pkg|vo|vosot|sot|live|standup|anchor_read|graphic_full|lower_third — promote to reference product]']
  sequence_number varchar [note: 'Ordinal position of this item within the program rundown, determining the playout order. Used by Ericsson MediaFirst automation to sequence segments during live show production control.']
  simulcast_flag boolean [note: 'Indicates whether this rundown item is simultaneously broadcast across multiple platforms (linear, OTT, streaming). When true, triggers multi-platform distribution workflows and DAI configuration in Akamai CDN.']
  skip_reason varchar [note: 'Reason code explaining why this rundown item was skipped during playout. Populated only when item_status = skipped. Used for post-broadcast editorial review and rights compliance audit.']
  som_timecode varchar [note: 'SMPTE timecode marking the Start of Message (SOM) — the precise in-point of the media asset to be played for this rundown item. Used by Ericsson MediaFirst for frame-accurate playout cueing.']
  tape_number varchar [note: 'Physical or virtual media identifier (tape ID, clip ID, or server ID) for the pre-recorded asset associated with this rundown item in the Dalet Galaxy MAM system. Used for media retrieval and playout server cueing.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to this rundown item record. Tracks editorial changes, status transitions, and timing adjustments throughout the show production lifecycle.']
  wide_orbit_spot_code varchar [note: 'Identifier from the Wide Orbit Traffic and Billing system for commercial spots or ad pod items within this rundown. Populated only for item_type = commercial_break; used for affidavit generation and billing reconciliation.']

  Note: 'Individual segment or item within a program rundown, representing a discrete production element (story package, live shot, interview, commercial break, graphic, music bed, or filler). Captures item sequence, item type, planned duration, actual duration, content asset reference, presenter/anchor assignment, cue text, backtime flag, and item status (ready, on-air, completed, skipped). The atomic unit of live show production control.'
}

Table distribution.ott_platform {
  ott_platform_id varchar [pk, note: 'Unique surrogate identifier for each OTT service platform record in the master registry. Primary key for the ott_platform entity — all downstream distribution products reference this key.']
  accessibility_obligation_id varchar [note: 'Foreign key linking to compliance.accessibility_obligation. Business justification: OTT platforms have platform-wide accessibility obligations (UI accessibility, player controls, caption support). Compliance tracking and regulatory reporting require linking platforms to their specifi']
  billing_account_id varchar [note: 'Foreign key linking to billing.account. Business justification: OTT platforms require billing account linkage for subscription billing setup, revenue recognition by platform, and financial reporting. Media broadcasting operations track platform-level billing confi']
  billing_cycle_id varchar [note: 'Foreign key linking to billing.cycle. Business justification: OTT platforms operate on defined subscription billing cycles (monthly, annual) that govern when subscriber invoices are generated. Linking ott_platform to billing.cycle enables platform-level billing ']
  broadcast_license_id varchar [note: 'Foreign key linking to compliance.broadcast_license. Business justification: OTT platforms retransmitting broadcast content operate under specific broadcast licenses. Retransmission consent agreements and carriage rights require tracking which license authorizes the platform\'s']
  territory_id varchar [note: 'Foreign key linking to rights.territory. Business justification: OTT platforms operate in specific territories with distinct regulatory, content rating, and rights enforcement requirements. Replaces geographic_availability text with structured territory reference. ']
  adobe_property_code varchar [note: 'The unique property identifier assigned to this OTT platform within Adobe Experience Platform (AEP) for audience data collection, segmentation, and personalization. Used to link platform-level engagement events to subscriber profiles and Nielsen cross-platform measurement.']
  arpu decimal(10,4) [note: 'Average monthly revenue generated per active subscriber on this platform, expressed in the platform\'s billing currency. Calculated at the platform level for strategic pricing and investor reporting. Confidential as a key financial performance indicator. Sourced from Zuora revenue recognition data.']
  base_subscription_price decimal(10,2) [note: 'The standard monthly subscription price for this platform in the billing currency. Applicable for SVOD and HYBRID tiers. Null for AVOD and FAST platforms with no subscription fee. Used in Zuora plan configuration and financial forecasting in SAP S/4HANA.']
  billing_currency varchar [note: 'ISO 4217 three-letter currency code for the primary billing currency used on this platform (e.g., \'USD\', \'GBP\', \'EUR\'). Governs Zuora subscription plan pricing, SAP S/4HANA financial reconciliation, and multi-currency revenue reporting.']
  cdn_origin_url varchar [note: 'The base origin URL configured in the CDN for this platform\'s content delivery. Used by Akamai CDN to route requests to the correct media origin server. Critical for CDN configuration audits and incident troubleshooting.']
  cdn_provider varchar [note: 'The primary CDN provider contracted to deliver streaming content for this OTT platform. Drives SLA monitoring, peering agreements, and cost allocation. \'Multi-CDN\' indicates a load-balanced or failover configuration across multiple providers. Maps to Akamai CDN platform configuration records.']
  content_rating_system varchar [note: 'The content classification and rating system applied to content on this platform (e.g., MPAA for USA, BBFC for UK, FSK for Germany). Governs parental control enforcement, COPPA compliance for children\'s content, and MPA anti-piracy obligations.']
  coppa_compliant boolean [note: 'Indicates whether this platform is designated as COPPA-compliant, meaning it is directed at children under 13 and adheres to COPPA data collection restrictions. True = COPPA-compliant children\'s platform; False = general audience platform. Drives data collection policies in Adobe Experience Platform and ad targeting restrictions.']
  created_timestamp timestamp [note: 'The timestamp when this OTT platform record was first created in the master registry. Follows ISO 8601 format (yyyy-MM-ddTHH:mm:ss.SSSXXX). Used for data lineage, audit trails, and Silver layer ingestion tracking.']
  dai_enabled boolean [note: 'Indicates whether Dynamic Ad Insertion is active on this platform, enabling server-side ad stitching into the stream. True = DAI active (relevant for AVOD and HYBRID tiers); False = no DAI. Drives ad operations workflow in Wide Orbit and ad campaign targeting in Salesforce Media Cloud.']
  dai_provider varchar [note: 'The technology vendor or platform providing DAI services for this OTT platform (e.g., \'Google DAI\', \'FreeWheel\', \'Yospace\', \'Brightcove SSAI\'). Null if DAI is not enabled. Used for vendor management, SLA tracking, and ad revenue reconciliation.']
  drm_system varchar [note: 'The DRM technology binding enforced on this platform for content protection. Widevine = Google DRM for Android/Chrome; FairPlay = Apple DRM for iOS/Safari; PlayReady = Microsoft DRM for Windows/Xbox; Multi-DRM = all three enforced simultaneously; NONE = no DRM (e.g., FAST free content). Directly linked to Rightsline rights window enforcement and content clearance workflows.']
  epg_feed_url varchar [note: 'The URL of the Electronic Program Guide data feed for this platform, used by third-party EPG aggregators, smart TV manufacturers, and vMVPD partners to display scheduling information. Null for pure VOD platforms without a linear schedule. Sourced from Ericsson MediaFirst playout system.']
  fast_channel_enabled boolean [note: 'Indicates whether this platform operates or hosts FAST channels — linear-style, ad-supported free streaming channels. True = FAST channel delivery active; False = no FAST channel. Relevant for FAST syndication partnerships and Wide Orbit ad scheduling.']
  free_trial_days varchar [note: 'Number of days in the free trial period offered to new subscribers on this platform. Zero or null if no free trial is offered. Configured in Zuora subscription plans and used in churn rate and LTV analysis.']
  gdpr_applicable boolean [note: 'Indicates whether GDPR data protection obligations apply to this platform based on its geographic availability and subscriber base. True = GDPR applies (EU/EEA territories served); False = GDPR not applicable. Governs consent management, data subject rights workflows, and Adobe Experience Platform profile handling.']
  hdr_supported boolean [note: 'Indicates whether the platform supports High Dynamic Range video delivery (HDR10, Dolby Vision, or HLG). True = HDR delivery supported; False = SDR only. Relevant for premium content licensing negotiations and CTV device compatibility.']
  launch_date date [note: 'The calendar date on which the OTT platform was officially made available to the public or target subscriber base. Used for platform age calculations, anniversary promotions, and regulatory reporting of service commencement.']
  max_concurrent_streams varchar [note: 'The maximum number of simultaneous streams permitted per subscriber account on this platform. Enforced at the entitlement layer to prevent credential sharing and manage CDN bandwidth capacity. A key parameter in Zuora subscription plan configuration.']
  max_download_devices varchar [note: 'The maximum number of devices on which a subscriber may store downloaded content for offline viewing on this platform. Null if offline downloads are not supported. Governed by DRM policy and Rightsline windowing rules.']
  max_video_resolution varchar [note: 'The highest video resolution tier supported for streaming on this platform. SD = Standard Definition (480p); HD = High Definition (720p); FHD = Full HD (1080p); 4K = Ultra HD (2160p); 8K = Super Hi-Vision (4320p). Drives ABR profile configuration, CDN bandwidth planning, and content ingest specifications in Dalet Galaxy.']
  mvpd_carriage_eligible boolean [note: 'Indicates whether this OTT platform\'s content or channels are eligible for carriage by MVPD or vMVPD partners (cable, satellite, virtual pay-TV operators). True = eligible for carriage agreements; False = direct-to-consumer only. Governs retransmission consent and must-carry negotiations.']
  parent_brand varchar [note: 'The overarching corporate or media brand under which this OTT platform operates (e.g., \'Media Broadcasting Group\', \'MB Sports Network\'). Supports brand hierarchy reporting, consolidated audience measurement, and multi-brand advertising sales in Salesforce Media Cloud.']
  platform_code varchar [note: 'Externally-known, human-readable unique code assigned to the OTT platform (e.g., \'MB_SVOD_WEB\', \'MB_AVOD_CTV\'). Used in operational systems, contracts, and partner integrations as the canonical platform identifier. Maps to the platform identifier used in Zuora subscription plans and Akamai CDN configuration.']
  platform_description varchar [note: 'Detailed narrative description of the platform\'s content offering, target audience, and service proposition. Used in partner onboarding documentation, regulatory filings, and internal product catalogues.']
  platform_name varchar [note: 'Official commercial brand name of the OTT platform as presented to subscribers and partners (e.g., \'MediaBroadcast+\', \'MB Sports Live\'). Used in marketing materials, EPG listings, and subscriber-facing interfaces.']
  platform_status varchar [note: 'Current lifecycle state of the OTT platform. \'active\' = live and serving audiences; \'beta\' = limited release for testing; \'sunset\' = scheduled for decommission; \'suspended\' = temporarily offline; \'inactive\' = decommissioned. Governs whether the platform is eligible for new subscriber acquisition, ad campaign targeting, and CDN resource allocation.']
  primary_streaming_protocol varchar [note: 'The primary adaptive bitrate streaming protocol used for content delivery on this platform. HLS = HTTP Live Streaming (Apple standard, widely supported); MPEG-DASH = Dynamic Adaptive Streaming over HTTP (ISO 23009 standard); RTMP = Real-Time Messaging Protocol (legacy live); SRT = Secure Reliable Transport (low-latency live). Drives CDN configuration in Akamai and player SDK selection.']
  service_tier varchar [note: 'Business model classification of the OTT platform. SVOD = Subscription Video On Demand (recurring fee, no ads); AVOD = Advertising-Supported Video On Demand (free with ads); TVOD = Transactional Video On Demand (pay-per-view); FAST = Free Ad-Supported Streaming Television (linear-style free channel); HYBRID = combination of tiers. Drives revenue recognition logic in Zuora and ad inventory management in Wide Orbit.']
  sla_uptime_target_pct decimal(5,2) [note: 'The contractually committed platform availability target expressed as a percentage (e.g., 99.95). Governs CDN SLA enforcement with Akamai, incident escalation thresholds, and operational reporting. Distinct from actual measured uptime.']
  subscriber_count varchar [note: 'Current count of active paying or registered subscribers on this platform as of the last reconciliation cycle. A key operational metric for ARPU calculation, churn rate monitoring, and Zuora revenue reporting. Confidential as it represents commercially sensitive business performance data.']
  sunset_date date [note: 'Planned or actual date on which the OTT platform will be or was decommissioned. Null if the platform has no scheduled end-of-life. Used for subscriber migration planning, contract wind-down, and CDN resource deallocation.']
  supported_device_classes varchar [note: 'Comma-separated list of device categories supported by this platform (e.g., \'web,mobile,ctv,stb,gaming_console\'). Drives device compatibility testing, app store distribution, and audience reach reporting. [ENUM-REF-CANDIDATE: web|mobile|ctv|stb|gaming_console|smart_tv|tablet — promote to reference product]']
  target_start_bitrate_kbps varchar [note: 'The minimum target bitrate in kilobits per second at which the ABR player should initiate playback on this platform. Drives ABR profile ladder configuration in Akamai CDN and QoS monitoring thresholds. Key parameter for streaming quality benchmarking.']
  updated_timestamp timestamp [note: 'The timestamp when this OTT platform record was most recently modified. Follows ISO 8601 format (yyyy-MM-ddTHH:mm:ss.SSSXXX). Used for change data capture (CDC) in the Databricks Silver layer pipeline and audit compliance.']
  zuora_product_code varchar [note: 'The product identifier in Zuora\'s subscription billing platform corresponding to this OTT platform\'s subscription offering. Used for revenue recognition, invoice generation, and subscription lifecycle management. Links the platform master record to Zuora\'s billing product catalogue.']

  Note: 'Master registry of all OTT service platforms operated by Media Broadcasting — web, mobile, connected TV (CTV), and set-top box (STB). Captures platform identity, service tier (SVOD, AVOD, TVOD, FAST), launch date, supported protocols (HLS, MPEG-DASH), DRM system bindings, CDN provider assignments, geographic availability, regulatory jurisdiction, brand identity, and operational status. This is the SSOT anchor for the entire platform domain — all other platform products reference back to this entity.'
}

Table distribution.device_type {
  device_type_id varchar [pk, note: 'Unique identifier for the device type record. Primary key.']
  abr_profile_dash boolean [note: 'Indicates whether the device supports MPEG-DASH (Dynamic Adaptive Streaming over HTTP) adaptive bitrate streaming protocol.']
  abr_profile_hls boolean [note: 'Indicates whether the device supports HLS (HTTP Live Streaming) adaptive bitrate streaming protocol.']
  abr_profile_smooth boolean [note: 'Indicates whether the device supports Microsoft Smooth Streaming adaptive bitrate protocol.']
  active_install_base varchar [note: 'Estimated number of active devices of this type currently accessing the OTT platform, used for capacity planning and analytics.']
  certification_date date [note: 'Date when the device successfully completed OTT platform certification testing.']
  certification_expiry_date date [note: 'Date when the device certification expires and requires re-certification for continued platform support.']
  certification_status varchar [note: 'Current certification status of the device for OTT platform compatibility (certified, pending, failed, not_tested).']
  codec_audio_support varchar [note: 'List of audio codecs supported by the device (e.g., AAC, Dolby Digital, Dolby Atmos, DTS). Pipe-separated list.']
  codec_video_support varchar [note: 'List of video codecs supported by the device (e.g., H.264, H.265/HEVC, VP9, AV1). Pipe-separated list.']
  created_timestamp timestamp [note: 'Timestamp when this device type record was first created in the system.']
  dai_supported boolean [note: 'Indicates whether the device supports DAI (Dynamic Ad Insertion) for server-side ad stitching in streaming content.']
  device_category varchar [note: 'High-level classification of the device type (e.g., smart TV, mobile phone, tablet, desktop browser, streaming stick, gaming console, set-top box). [ENUM-REF-CANDIDATE: smart_tv|mobile_phone|tablet|desktop_browser|streaming_stick|gaming_console|set_top_box — 7 candidates stripped; promote to reference product]']
  drm_fairplay_supported boolean [note: 'Indicates whether the device supports Apple FairPlay DRM for content protection.']
  drm_playready_supported boolean [note: 'Indicates whether the device supports Microsoft PlayReady DRM for content protection.']
  drm_widevine_level varchar [note: 'Google Widevine DRM security level supported (L1 = hardware-backed, L2 = software-backed, L3 = software only, not_supported).']
  form_factor varchar [note: 'Physical form factor of the device (handheld, television, desktop, wearable, embedded).']
  hdr_capable boolean [note: 'Indicates whether the device supports HDR (High Dynamic Range) video playback for enhanced color and contrast.']
  hdr_format varchar [note: 'Specific HDR formats supported by the device (e.g., HDR10, HDR10+, Dolby Vision, HLG). Pipe-separated list if multiple formats are supported.']
  input_method varchar [note: 'Primary input method(s) supported by the device (e.g., touchscreen, remote_control, keyboard_mouse, voice, gamepad). Pipe-separated list if multiple.']
  is_active boolean [note: 'Indicates whether this device type is currently active and supported for OTT platform streaming.']
  manufacturer varchar [note: 'Name of the device manufacturer or brand (e.g., Samsung, Apple, Roku, Amazon, LG, Sony).']
  max_bitrate_mbps decimal(10,2) [note: 'Maximum streaming bitrate supported by the device in megabits per second (Mbps), used for ABR profile selection and QoS (Quality of Service) optimization.']
  model_name varchar [note: 'Specific model name or identifier assigned by the manufacturer (e.g., Galaxy S21, iPhone 13 Pro, Fire TV Stick 4K).']
  model_number varchar [note: 'Technical model number or SKU (Stock Keeping Unit) used for precise device identification and inventory tracking.']
  network_capability varchar [note: 'Network connectivity capabilities of the device (e.g., wifi, ethernet, cellular_4g, cellular_5g). Pipe-separated list if multiple.']
  os_family varchar [note: 'Operating system family running on the device (e.g., Android, iOS, tvOS, webOS, Tizen, Roku OS, Fire OS, Windows, macOS, Linux, PlayStation, Xbox). [ENUM-REF-CANDIDATE: android|ios|tvos|webos|tizen|roku_os|fire_os|windows|macos|linux|playstation|xbox — 12 candidates stripped; promote to reference product]']
  os_version_max varchar [note: 'Maximum OS version tested and certified for compatibility. Null indicates no upper bound.']
  os_version_min varchar [note: 'Minimum OS version required for OTT (Over-The-Top) platform compatibility and playback support.']
  qos_tier varchar [note: 'QoS tier assigned to the device type for streaming quality segmentation and CDN (Content Delivery Network) routing (premium, standard, basic).']
  screen_resolution_class varchar [note: 'Display resolution category supported by the device (SD, HD, Full HD, 4K UHD (Ultra High Definition), 8K UHD).']
  support_end_date date [note: 'Date when platform support for this device type will be discontinued, after which playback may no longer be guaranteed.']
  updated_timestamp timestamp [note: 'Timestamp when this device type record was last modified.']
  user_agent_string varchar [note: 'Standard HTTP user agent string reported by the device, used for device detection and analytics.']

  Note: 'Reference catalog of all device categories and models supported across OTT platforms — smart TVs, mobile phones, tablets, desktop browsers, streaming sticks, gaming consoles, and STBs. Captures device category, manufacturer, OS family, OS version range, screen resolution class, HDR capability, DRM compatibility (Widevine, PlayReady, FairPlay), ABR profile support, and certification status. Used for device-specific playback configuration and QoS segmentation.'
}

Table distribution.streaming_endpoint {
  streaming_endpoint_id varchar [pk, note: 'Unique identifier for the streaming endpoint. Primary key for the streaming endpoint master record.']
  channel_id varchar [note: 'Foreign key linking to scheduling.channel. Business justification: Streaming endpoints use specific CDN configurations. streaming_endpoint.cdn_provider is STRING but should FK to cdn_configuration. Removes cdn_provider STRING.']
  failover_endpoint_streaming_endpoint_id varchar [note: 'Reference to the backup streaming endpoint that should be used if this endpoint becomes unavailable. Supports high availability and disaster recovery.']
  ott_platform_id varchar [note: 'Foreign key linking to distribution.ott_platform. Business justification: Streaming endpoints are provisioned for specific OTT platforms. Each endpoint serves content for a platform. No visible platform_type column but relationship is essential for endpoint management.']
  partner_id varchar [note: 'Foreign key linking to partner.partner. Business justification: Streaming endpoints rely on transmission equipment (encoders, transcoders). Required for equipment failure impact analysis and encoder capacity management.']
  territory_id varchar [note: 'Foreign key linking to rights.territory. Business justification: Streaming endpoints serve specific geographic territories. Essential for enforcing geo-restriction rules per rights grants, validating territory-based rights compliance, and routing playback sessions ']
  activated_timestamp timestamp [note: 'The date and time when this endpoint was first activated and began serving live traffic.']
  bandwidth_limit_gbps decimal(10,2) [note: 'Maximum aggregate bandwidth capacity in gigabits per second allocated to this endpoint. Used for capacity planning and cost management.']
  cache_ttl_seconds varchar [note: 'The duration in seconds that content should be cached at edge locations before refreshing from origin. Balances freshness with CDN efficiency.']
  cost_per_gb decimal(10,4) [note: 'The CDN provider\'s charge per gigabyte of data transferred through this endpoint. Used for cost allocation and financial forecasting.']
  created_timestamp timestamp [note: 'The date and time when this streaming endpoint record was first created in the system.']
  dai_enabled boolean [note: 'Indicates whether this endpoint supports Dynamic Ad Insertion, allowing personalized ads to be stitched into the stream in real-time.']
  deactivated_timestamp timestamp [note: 'The date and time when this endpoint was deactivated or taken out of service. Null if currently active.']
  drm_license_server_url varchar [note: 'URL of the DRM license server that provides decryption keys and enforces content protection policies for this endpoint. Critical for securing premium content.']
  endpoint_name varchar [note: 'Human-readable name or label for the streaming endpoint, used for identification and operational reference.']
  endpoint_type varchar [note: 'Classification of the endpoint role within the CDN architecture. Origin endpoints serve as the source, edge endpoints serve end users, and backup endpoints provide failover capability.']
  endpoint_url varchar [note: 'The full URL address of the streaming endpoint, including protocol, domain, and path. This is the technical delivery address for the stream.']
  geo_restriction_mode varchar [note: 'Defines whether geo_restriction_rules represent an allow list (whitelist) or deny list (blacklist) for content delivery.']
  geo_restriction_rules varchar [note: 'Comma-separated list of ISO country codes or regions where content delivery is allowed or blocked. Enforces territorial licensing and rights management requirements.']
  health_check_interval_seconds varchar [note: 'Frequency in seconds at which automated health checks are performed against this endpoint.']
  health_check_url varchar [note: 'URL endpoint used for automated health monitoring and availability checks. Returns status codes indicating endpoint health.']
  ipv6_enabled boolean [note: 'Indicates whether this endpoint supports IPv6 addressing in addition to IPv4, enabling delivery to modern network infrastructures.']
  last_health_check_timestamp timestamp [note: 'The date and time of the most recent successful health check performed on this endpoint.']
  manifest_format varchar [note: 'The streaming manifest file format used by this endpoint. m3u8 for HLS, mpd for MPEG-DASH, ism for Smooth Streaming, f4m for Adobe HDS.']
  max_bitrate_mbps decimal(10,2) [note: 'The maximum streaming bitrate in megabits per second that this endpoint can deliver. Defines the upper quality limit for adaptive streaming.']
  modified_timestamp timestamp [note: 'The date and time when this streaming endpoint record was last modified or updated.']
  operational_status varchar [note: 'Current operational state of the streaming endpoint. Active endpoints are serving traffic; inactive endpoints are provisioned but not in use; maintenance indicates scheduled downtime.']
  provisioned_date date [note: 'The date when this streaming endpoint was initially provisioned and configured in the CDN infrastructure.']
  sla_uptime_target_percent decimal(5,2) [note: 'The contractual uptime percentage target for this endpoint (e.g., 99.99%). Used for SLA compliance monitoring and vendor accountability.']
  ssl_certificate_expiry_date date [note: 'Expiration date of the SSL/TLS certificate securing this endpoint. Critical for maintaining secure HTTPS delivery and avoiding service disruptions.']
  streaming_protocol varchar [note: 'The streaming protocol used by this endpoint for content delivery. HLS (HTTP Live Streaming) and MPEG-DASH (Dynamic Adaptive Streaming over HTTP) are the most common adaptive bitrate protocols.']
  supported_devices varchar [note: 'Comma-separated list of device types or platforms that this endpoint is optimized to serve (e.g., iOS, Android, Smart TV, Web Browser, Set-Top Box).']
  token_authentication_scheme varchar [note: 'The authentication mechanism used to secure access to the endpoint. Prevents unauthorized access and hotlinking through cryptographic token validation.']

  Note: 'Master record of all streaming origin and edge endpoints managed across the CDN infrastructure (Akamai CDN). Captures endpoint URL, CDN provider, PoP (Point of Presence) region, protocol (HLS, MPEG-DASH), ABR ladder configuration reference, DRM license server URL, token authentication scheme, geo-restriction rules, failover endpoint reference, SLA tier, and operational status. SSOT for the technical delivery address of each stream.'
}

Table distribution.playback_session {
  playback_session_id varchar [pk, note: 'Unique identifier for each individual viewer playback session initiated on the OTT (Over-The-Top) platform. Primary key for the playback session record.']
  audience_profile_id varchar [note: 'Foreign key linking to audience.audience_profile. Business justification: Every OTT playback session is attributed to an audience profile for cross-platform measurement, personalization, and Nielsen streaming measurement. This is a foundational link in OTT audience analytic']
  campaign_id varchar [note: 'Foreign key linking to sales.campaign. Business justification: When playback sessions include ad delivery (dai_enabled), linking to campaign enables campaign reach/frequency measurement, content-adjacency analysis, and cross-domain attribution. Critical for measu; FK references sales domain entity; namespace reconciled from advertising context']
  closed_caption_record_id varchar [note: 'Foreign key linking to compliance.closed_caption_record. Business justification: Individual playback sessions generate closed caption quality metrics (accuracy, synchronization, latency). Session-level caption performance data feeds FCC compliance reporting and quality assurance.']
  content_rating_id varchar [note: 'Foreign key linking to compliance.content_rating. Business justification: Every playback session must enforce content rating restrictions for parental controls, age-gating, and COPPA compliance. Real-time rating validation during session initialization is standard practice.']
  demographic_segment_id varchar [note: 'Foreign key linking to audience.demographic_segment. Business justification: Nielsen C3/C7 ratings, GRP/TRP calculation, and programmatic ad targeting require demographic classification of every playback session. Essential for audience guarantee reconciliation and upfront comm']
  grant_id varchar [note: 'Foreign key linking to rights.rights_grant. Business justification: Playback sessions consume content under specific rights grants. Essential for per-stream royalty calculation, usage reporting to rights holders, and rights compliance verification. Media broadcasting ']
  ott_platform_id varchar [note: 'Foreign key linking to distribution.app_version. Business justification: Playback sessions should FK to app_version master for version tracking and analytics. Removes app_version STRING (derivable from app_version.version_number).']
  primary_playback_device_device_type_id varchar [note: 'Reference to the device used for this playback session. Enables device-level analytics and QoS (Quality of Service) monitoring.']
  streaming_endpoint_id varchar [note: 'Foreign key linking to distribution.streaming_endpoint. Business justification: Playback sessions should FK to streaming_endpoint master to track which endpoint served the session. Removes streaming_endpoint_url STRING (derivable from streaming_endpoint.endpoint_url).']
  subscriber_id varchar [note: 'Reference to the subscriber who initiated this playback session. Links to the subscriber master record for audience measurement and personalization.']
  territory_id varchar [note: 'Foreign key linking to rights.territory. Business justification: Playback sessions occur in specific territories. Essential for territory-based royalty calculation, rights compliance verification, and exploitation reporting to rights holders. Replaces geographic_co']
  ad_breaks_served_count varchar [note: 'Number of ad breaks (ad pods) served during this playback session. Used for advertising inventory management and revenue reconciliation.']
  audio_language varchar [note: 'ISO 639 language code for the audio track selected by the viewer. Supports multi-language content analytics and localization strategy.']
  average_bitrate_kbps varchar [note: 'Average streaming bitrate in kilobits per second during the session. Indicates video quality delivered and network performance.']
  cdn_pop_location varchar [note: 'Geographic location identifier of the CDN point of presence that served this session. Critical for CDN performance optimization and SLA monitoring.']
  closed_captions_enabled boolean [note: 'Indicates whether closed captions were enabled during the session. Critical for accessibility compliance reporting and user preference analysis.']
  completion_percentage decimal(5,2) [note: 'Percentage of content watched relative to total content duration. Key engagement metric for content performance and recommendation algorithms.']
  content_duration_seconds varchar [note: 'Total duration of the content asset in seconds. Used to calculate completion rate and identify partial vs. full viewing sessions.']
  dai_enabled boolean [note: 'Indicates whether Dynamic Ad Insertion was enabled for this playback session. Critical for advertising revenue attribution and campaign measurement.']
  error_code varchar [note: 'Technical error code if the session ended due to an error. Enables root cause analysis and platform stability monitoring.']
  exit_reason varchar [note: 'The reason the playback session ended. Critical for distinguishing intentional exits from technical failures and optimizing viewer experience.']
  geographic_city varchar [note: 'City where the viewer is located during playback. Enables hyper-local audience analytics and targeted advertising campaigns.']
  geographic_postal_code varchar [note: 'Postal code derived from viewer location. Used for demographic overlay and targeted advertising. Subject to privacy regulations.']
  initial_buffering_duration_ms varchar [note: 'Time in milliseconds from session start until playback began. Key QoS metric for measuring time-to-first-frame and viewer experience.']
  platform_type varchar [note: 'The platform category on which the playback session occurred. Enables cross-platform measurement and platform-specific QoS analysis.']
  playback_mode varchar [note: 'The mode of content consumption: live linear broadcast, VOD (Video On Demand), DVR (time-shifted), or restart. Critical for audience measurement methodology and rights management.']
  rebuffering_events_count varchar [note: 'Number of rebuffering (stalling) events that occurred during the session. Critical QoS metric for viewer experience and churn prediction.']
  session_created_timestamp timestamp [note: 'Timestamp when this playback session record was created in the system. Used for data lineage and operational monitoring.']
  session_end_timestamp timestamp [note: 'Precise timestamp when the playback session ended. Used to calculate total watch duration and session completion metrics.']
  session_start_timestamp timestamp [note: 'Precise timestamp when the viewer initiated the playback session. Critical for audience measurement, daypart analysis, and concurrent viewer calculations.']
  session_updated_timestamp timestamp [note: 'Timestamp when this playback session record was last updated. Supports audit trail and data quality monitoring.']
  streaming_protocol varchar [note: 'The ABR (Adaptive Bitrate Streaming) protocol used for content delivery. HLS (HTTP Live Streaming) or MPEG-DASH (Dynamic Adaptive Streaming over HTTP) are most common.']
  subtitle_language varchar [note: 'ISO 639 language code for subtitles displayed during the session. Null if no subtitles were enabled. Supports accessibility and localization analytics.']
  total_ad_duration_seconds varchar [note: 'Cumulative duration of all advertisements served during the session. Essential for advertising billing and viewer experience analysis.']
  total_rebuffering_duration_ms varchar [note: 'Cumulative time in milliseconds spent in rebuffering state during the session. Complements rebuffering count for comprehensive QoS analysis.']
  total_watch_duration_seconds varchar [note: 'Total time in seconds the viewer actively watched content during this session. Primary metric for audience measurement and content engagement analysis.']
  video_resolution varchar [note: 'The video resolution delivered during the session (e.g., 1920x1080, 3840x2160). Indicates quality tier and device capability.']
  viewer_ip_address varchar [note: 'IP address of the viewer during the playback session. Used for geographic analysis, fraud detection, and blackout enforcement. Subject to GDPR and CCPA privacy regulations.']

  Note: 'Transactional record of each individual viewer playback session initiated on the OTT platform. Captures session ID, subscriber/device reference, content asset reference, session start and end timestamps, platform and app version, device type, streaming endpoint used, ABR profile, DRM policy applied, initial buffering duration, average bitrate, rebuffering events count, total watch duration, exit reason (user-initiated, error, completion), CDN PoP served, and geographic location. Primary operational event for QoS monitoring and audience measurement.'
}

Table distribution.distribution_partner {
  distribution_partner_id varchar [pk, note: 'Unique identifier for the distribution partner. Primary key for the distribution partner entity.']
  billing_account_id varchar [note: 'Foreign key linking to billing.account. Business justification: Distribution partners (MVPDs, cable operators, streaming aggregators) are billing customers for carriage fees, retransmission consent, and content licensing. Real business process: partner invoicing, ']
  billing_cycle_id varchar [note: 'Foreign key linking to billing.cycle. Business justification: Distribution partners are billed on defined cycles (monthly carriage fees, quarterly revenue share settlements). The billing cycle governs invoice generation timing, payment due dates, and dunning sch']
  partner_id varchar [note: 'Foreign key linking to partner.partner. Business justification: distribution_partner is a distribution-domain specialization of a partner entity. Linking to the master partner record enables unified partner reporting, credit risk assessment, and strategic tier man']
  regulatory_filing_id varchar [note: 'Foreign key linking to compliance.regulatory_filing. Business justification: Distribution partners independently file regulatory documents (annual EEO reports, must-carry elections, retransmission consent filings). A direct FK from distribution_partner to regulatory_filing sup']
  regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: MVPDs and cable operators are subject to FCC regulatory obligations (must-carry, retransmission consent, EEO reporting). Tracking the primary regulatory_obligation per distribution_partner is essentia']
  territory_id varchar [note: 'Foreign key linking to rights.territory. Business justification: Distribution partners have co-located equipment at broadcaster facilities. Required for partner technical integration coordination and facility access control management.']
  abr_profile_support varchar [note: 'Description of Adaptive Bitrate streaming profiles and quality tiers supported by the distribution partner for OTT and streaming delivery. Includes resolution ranges, bitrate ladders, and codec support.']
  blackout_capability_flag boolean [note: 'Indicates whether the distribution partner has technical capability to enforce geographic broadcast restrictions and content blackouts based on licensing and rights windows.']
  carriage_capacity_channels varchar [note: 'Number of linear channels or content streams that the distribution partner has capacity to carry simultaneously. Relevant for MVPD, vMVPD, and cable operators.']
  carriage_fee_model varchar [note: 'Commercial model for carriage fees paid by or to the distribution partner. Per Subscriber indicates fees based on subscriber count, Flat Rate indicates fixed periodic payment, Revenue Share indicates percentage of advertising or subscription revenue, Hybrid indicates combination of models.']
  cdn_provider varchar [note: 'Name of the Content Delivery Network provider used by the distribution partner for content streaming and delivery. May include Akamai, Cloudflare, AWS CloudFront, or partner-owned CDN infrastructure.']
  contract_end_date date [note: 'Date when the current distribution agreement with the partner expires or is scheduled for renewal. Null indicates open-ended or evergreen agreement.']
  contract_renewal_notice_days varchar [note: 'Number of days advance notice required for contract renewal or termination as specified in the distribution agreement.']
  contract_start_date date [note: 'Date when the current distribution agreement with the partner became effective.']
  created_timestamp timestamp [note: 'Timestamp when this distribution partner record was first created in the system.']
  dai_support_flag boolean [note: 'Indicates whether the distribution partner supports Dynamic Ad Insertion technology for server-side ad stitching in streaming content.']
  drm_capability varchar [note: 'Digital Rights Management systems and encryption standards supported by the distribution partner. May include Widevine, FairPlay, PlayReady, and other DRM technologies.']
  geographic_footprint varchar [note: 'Description of the geographic markets, regions, or territories served by this distribution partner. May include country codes, DMA (Designated Market Area) codes, or regional descriptors.']
  headquarters_address varchar [note: 'Physical address of the distribution partner\'s corporate headquarters or primary business location.']
  headquarters_city varchar [note: 'City where the distribution partner\'s headquarters is located.']
  headquarters_country_code varchar [note: 'Three-letter ISO country code representing the country where the distribution partner\'s headquarters is located.']
  headquarters_postal_code varchar [note: 'Postal or ZIP code for the distribution partner\'s headquarters location.']
  headquarters_state_province varchar [note: 'State, province, or administrative region where the distribution partner\'s headquarters is located.']
  last_modified_timestamp timestamp [note: 'Timestamp when this distribution partner record was most recently updated or modified.']
  must_carry_obligation_flag boolean [note: 'Indicates whether the distribution partner has a must-carry obligation requiring mandatory inclusion of certain broadcast channels under FCC regulations.']
  notes varchar [note: 'Free-form text field for additional notes, special instructions, or contextual information about the distribution partner relationship.']
  partner_tier varchar [note: 'Strategic classification of the partner based on reach, revenue contribution, and business importance. Tier 1 represents largest national/international partners, Tier 2 represents regional significant partners, Tier 3 represents local or niche partners.']
  partner_type varchar [note: 'Classification of the distribution partner based on delivery model. MVPD (Multichannel Video Programming Distributor) includes traditional cable, satellite, and telco providers. vMVPD (Virtual MVPD) includes internet-based multichannel services. OTT Platform includes direct-to-consumer streaming services. FAST Aggregator includes Free Ad-Supported Streaming Television channel aggregators. Syndication Outlet includes broadcast stations and regional networks.']
  payment_terms_days varchar [note: 'Standard payment terms in days for invoices related to carriage fees, revenue share, or other financial transactions with the distribution partner.']
  portal_url varchar [note: 'Web URL for the distribution partner\'s business portal, technical documentation, or partner management system.']
  preferred_currency_code varchar [note: 'Three-letter ISO currency code for financial transactions and reporting with this distribution partner.']
  primary_contact_email varchar [note: 'Email address of the primary business contact for distribution operations, technical coordination, and business communications.']
  primary_contact_name varchar [note: 'Full name of the primary business contact at the distribution partner organization for operational coordination and escalation.']
  primary_contact_phone varchar [note: 'Primary telephone number for reaching the distribution partner contact for urgent operational matters and coordination.']
  qos_monitoring_enabled_flag boolean [note: 'Indicates whether active Quality of Service monitoring and reporting is enabled for content delivery through this distribution partner.']
  relationship_status varchar [note: 'Current state of the commercial relationship and content distribution agreement with the partner.']
  retransmission_consent_status varchar [note: 'Status of retransmission consent authorization allowing the distribution partner to rebroadcast content. Relevant for MVPD and cable operators under FCC regulations.']
  sla_latency_target_ms varchar [note: 'Maximum acceptable latency in milliseconds for content delivery as defined in the distribution Service Level Agreement. Critical for live streaming and low-latency applications.']
  sla_uptime_target_percent decimal(5,2) [note: 'Contractual uptime percentage target defined in the distribution Service Level Agreement. Represents the minimum availability commitment for content delivery.']
  subscriber_reach_estimate varchar [note: 'Estimated number of subscribers, households, or unique users that can access content through this distribution partner. Used for reach analysis and revenue forecasting.']
  technical_delivery_standards varchar [note: 'Comma-separated list of technical broadcast and streaming standards supported by the partner. May include DVB (Digital Video Broadcasting), ATSC (Advanced Television Systems Committee), QAM (Quadrature Amplitude Modulation), HLS (HTTP Live Streaming), MPEG-DASH (Dynamic Adaptive Streaming over HTTP), and other delivery protocols.']

  Note: 'Master record for all distribution partners including MVPDs (cable, satellite, telco), vMVPDs, OTT platform operators, FAST aggregators, and syndication outlets. Captures partner identity, tier classification, distribution footprint (geographic markets served), carriage capacity, technical delivery capabilities (DVB, ATSC, HLS, MPEG-DASH), and commercial relationship status. SSOT for distribution partner identity within the distribution domain — distinct from the enterprise partner domain which owns broader commercial relationships.'
}

Table distribution.carriage_agreement {
  carriage_agreement_id varchar [pk, note: 'Unique identifier for the carriage agreement record. Primary key.']
  billing_account_id varchar [note: 'Foreign key linking to billing.billing_account. Business justification: Carriage agreements define ongoing carriage fees billed to distribution partners. The existing master_invoice_id links to one invoice; the billing_account_id enables credit management, payment terms e']
  broadcast_license_id varchar [note: 'Foreign key linking to compliance.broadcast_license. Business justification: Retransmission consent agreements are legally tied to specific broadcast licenses. Must-carry elections, carriage fees, and retransmission consent status are license-specific regulatory obligations re']
  channel_id varchar [note: 'Reference to the channel or content package covered by this carriage agreement.']
  deal_id varchar [note: 'Foreign key linking to distribution.deal. Business justification: A carriage_agreement is the operational contract governing channel carriage terms with an MVPD/vMVPD, while a deal is the overarching commercial distribution deal negotiated with a partner. In media b']
  distribution_agreement_id varchar [note: 'Foreign key linking to partner.distribution_agreement. Business justification: Carriage agreements are executed under the umbrella of a formal distribution_agreement. Operations teams must trace which distribution_agreement authorizes each carriage_agreement for compliance audit']
  distribution_partner_id varchar [note: 'Reference to the MVPD, vMVPD, or OTT platform carrying the content under this agreement.']
  public_inspection_file_id varchar [note: 'Foreign key linking to compliance.public_inspection_file. Business justification: FCC rules require retransmission consent and carriage agreements to be disclosed in the public inspection file. Linking carriage_agreement to public_inspection_file enables automated compliance verifi']
  agreement_number varchar [note: 'Externally-known unique identifier or contract number for this carriage agreement, used in business communications and legal references.']
  agreement_status varchar [note: 'Current lifecycle status of the carriage agreement: draft (being prepared), active (in force), suspended (temporarily paused), expired (term ended), terminated (cancelled before expiry), or under negotiation (renewal or amendment in progress).']
  agreement_type varchar [note: 'Classification of the carriage agreement: retransmission consent (FCC-regulated authorization for MVPDs to rebroadcast OTA signals), must-carry (mandatory carriage under FCC rules), voluntary carriage (negotiated carriage without must-carry obligation), or platform carriage (OTT/vMVPD distribution agreement).']
  auto_renewal_flag boolean [note: 'Indicates whether the agreement automatically renews at the end of the term unless either party provides termination notice.']
  blackout_provisions varchar [note: 'Geographic or temporal restrictions on content availability, such as sports blackout rules, local market exclusions, or event-specific restrictions required by rights holders or league rules.']
  carriage_fee_amount decimal(15,2) [note: 'Monetary compensation paid by the distribution partner to the content provider for the right to carry the channel or content package. May be per-subscriber, flat fee, or tiered based on subscriber count.']
  carriage_fee_currency varchar [note: 'Three-letter ISO 4217 currency code for the carriage fee amount (e.g., USD, GBP, EUR).']
  carriage_fee_structure varchar [note: 'Pricing model for the carriage fee: per-subscriber (fee per active subscriber), flat monthly (fixed monthly payment), tiered (rate varies by subscriber volume), revenue share (percentage of ad or subscription revenue), or barter (non-cash compensation such as promotional commitments or channel positioning).']
  channel_number_assignment varchar [note: 'The channel number or dial position assigned to the channel on the distribution platform. May vary by market or headend.']
  channel_positioning_tier varchar [note: 'The service tier or package in which the channel is positioned (e.g., basic, expanded basic, premium, sports tier). Affects channel visibility and subscriber reach.']
  compensation_terms varchar [note: 'Detailed description of all compensation provided under the agreement, including cash payments, barter arrangements (e.g., promotional commitments, ad inventory exchange), channel carriage reciprocity, or other non-monetary considerations.']
  created_timestamp timestamp [note: 'Timestamp when this carriage agreement record was first created in the system.']
  dispute_resolution_mechanism varchar [note: 'Agreed method for resolving disputes arising under the agreement: arbitration (binding third-party decision), mediation (facilitated negotiation), litigation (court proceedings), or negotiation (direct party-to-party resolution).']
  drm_requirements varchar [note: 'DRM and content protection requirements mandated under the agreement, such as encryption standards, conditional access systems, watermarking, and anti-piracy measures.']
  effective_date date [note: 'Date when the carriage agreement becomes binding and the distribution partner is authorized to carry the channel or content package.']
  exclusivity_window varchar [note: 'Period during which the distribution partner has exclusive carriage rights within a defined geographic territory or platform category (e.g., exclusive MVPD rights in a DMA, exclusive vMVPD rights nationally).']
  expiration_date date [note: 'Date when the carriage agreement term ends. Nullable for open-ended or evergreen agreements subject to termination notice.']
  geographic_coverage varchar [note: 'Geographic scope of the carriage agreement, typically expressed as authorized DMAs (Designated Market Areas), states, regions, or national coverage. Defines where the distribution partner is authorized to carry the content.']
  governing_law_jurisdiction varchar [note: 'Legal jurisdiction and governing law applicable to the agreement (e.g., State of New York, England and Wales). Determines which courts and laws apply in case of dispute.']
  holdback_restrictions varchar [note: 'Restrictions on when or where content may be made available on other platforms or windows. Protects the distribution partners investment by limiting competing distribution during the agreement term.']
  last_amendment_date date [note: 'Date of the most recent amendment or modification to the carriage agreement.']
  last_modified_timestamp timestamp [note: 'Timestamp when this carriage agreement record was last updated in the system.']
  minimum_subscriber_guarantee varchar [note: 'Minimum number of subscribers the distribution partner guarantees to deliver for the channel. Used in per-subscriber fee calculations and performance commitments.']
  must_carry_election boolean [note: 'Indicates whether the broadcaster has elected must-carry status under FCC rules, requiring the MVPD to carry the signal without negotiation. Applicable to qualified broadcast stations.']
  negotiation_history varchar [note: 'Summary of key negotiation milestones, amendments, and material changes to the agreement over its lifecycle. Provides context for current terms and future renegotiations.']
  promotional_commitment varchar [note: 'Marketing and promotional obligations agreed by either party, such as on-air promotion, co-marketing campaigns, EPG placement guarantees, or cross-platform promotion.']
  renewal_terms varchar [note: 'Conditions and terms governing agreement renewal, including renewal period length, rate adjustments, renegotiation triggers, and notice requirements.']
  retransmission_consent_granted boolean [note: 'Indicates whether retransmission consent has been granted under FCC regulations, authorizing the MVPD to rebroadcast over-the-air signals. Applicable only to retransmission consent agreement types.']
  service_level_agreement varchar [note: 'Performance commitments and service quality standards, including uptime guarantees, signal quality metrics, fault resolution times, and penalties for non-compliance.']
  technical_delivery_requirements varchar [note: 'Technical specifications for content delivery, including signal format (HD, 4K, HDR), encoding standards (MPEG-2, MPEG-4, HEVC), delivery method (satellite, fiber, IP), and quality parameters (bitrate, resolution, audio channels).']
  termination_notice_days varchar [note: 'Number of days advance notice required by either party to terminate the agreement. Protects both parties from abrupt service disruption.']

  Note: 'Contractual record governing the terms under which a channel or content package is carried by an MVPD, vMVPD, or OTT platform. Covers both retransmission consent agreements (FCC-regulated authorization for MVPDs to rebroadcast OTA signals) and standard carriage contracts. Captures agreement type (retransmission consent, must-carry, voluntary carriage), retransmission consent terms, must-carry election status, carriage fee rates, channel positioning tiers, geographic coverage (authorized DMAs), exclusivity windows, holdback restrictions, compensation terms (cash, channel carriage, promotional commitments), contract effective/expiry dates, and negotiation history. Links to distribution partner and channel master. Distinct from rights licensing contracts owned by the rights domain.'
}

Table distribution.delivery_channel {
  delivery_channel_id varchar [pk, note: 'Unique identifier for the delivery channel. Primary key.']
  accessibility_obligation_id varchar [note: 'Foreign key linking to compliance.accessibility_obligation. Business justification: Linear channels have specific closed captioning, audio description, and accessibility compliance obligations under FCC CVAA rules. Each channel tracks its applicable obligations for compliance reporti']
  broadcast_license_id varchar [note: 'Foreign key linking to compliance.broadcast_license. Business justification: Linear delivery channels operate under specific broadcast licenses. FCC compliance, public inspection files, EAS participation, and closed captioning obligations all require linking channels to their ']
  channel_id varchar [note: 'Foreign key linking to scheduling.channel. Business justification: Delivery channels use specific CDN configurations. delivery_channel.cdn_provider is STRING but should FK to cdn_configuration. Removes cdn_provider STRING.']
  territory_id varchar [note: 'Foreign key linking to rights.territory. Business justification: Linear channels originate from specific facilities with master control. Required for FCC license compliance (facility identification) and channel origination tracking.']
  ad_insertion_method varchar [note: 'Technical method used for inserting advertisements into the content stream: server-side stitching, client-side insertion, DAI (Dynamic Ad Insertion), SCTE-35 marker-based, or none for ad-free channels.']
  aspect_ratio varchar [note: 'Display aspect ratio of the channel content (4:3 legacy, 16:9 widescreen standard, 21:9 cinematic).']
  audio_format varchar [note: 'Audio encoding and delivery format supported by the channel (stereo, Dolby Digital 5.1, Dolby Atmos, DTS, AAC).']
  blackout_rules_enabled boolean [note: 'Indicates whether geographic or rights-based blackout restrictions are enforced for this channel (true) or not (false).']
  channel_type varchar [note: 'Classification of the delivery channel by distribution model: linear (traditional broadcast), OTT (over-the-top streaming), FAST (free ad-supported streaming TV), simulcast (simultaneous multi-platform), VOD (video on demand), or hybrid.']
  content_refresh_cadence varchar [note: 'Frequency at which the channel programming lineup or content library is updated with new material.']
  created_timestamp timestamp [note: 'Timestamp when this delivery channel record was first created in the system.']
  delivery_technology varchar [note: 'The technical transmission standard used for content delivery. DVB (Digital Video Broadcasting) variants for European broadcast, ATSC (Advanced Television Systems Committee) for North American broadcast, QAM (Quadrature Amplitude Modulation) for cable, HLS (HTTP Live Streaming) and MPEG-DASH for adaptive bitrate streaming. [ENUM-REF-CANDIDATE: dvb-t|dvb-s|dvb-c|atsc|qam|hls|mpeg-dash|smooth-streaming|rtmp|webrtc — 10 candidates stripped; promote to reference product]']
  epg_source_code varchar [note: 'External identifier linking this channel to its Electronic Program Guide (EPG) metadata feed provider (e.g., Gracenote, Tribune Media Services).']
  fast_aggregator_platform varchar [note: 'Name of the FAST platform aggregator hosting the channel (e.g., \'Pluto TV\', \'Tubi\', \'Samsung TV Plus\', \'Roku Channel\', \'Xumo\'). Applicable only to FAST channel types.']
  fast_playlist_type varchar [note: 'Content scheduling model for FAST channels: linear-loop (repeating content block), scheduled (traditional time-based EPG), dynamic (algorithm-driven), or hybrid. Applicable only to FAST channel types.']
  genre_category varchar [note: 'Primary content genre or programming category of the channel. [ENUM-REF-CANDIDATE: news|sports|entertainment|kids|lifestyle|documentary|music|movies|drama|comedy — 10 candidates stripped; promote to reference product]']
  is_active boolean [note: 'Indicates whether the channel is currently active and operational (true) or inactive/retired (false).']
  launch_date date [note: 'Date when the channel first went live and began broadcasting or streaming to audiences.']
  max_bitrate_mbps decimal(6,2) [note: 'Maximum streaming bitrate supported by the channel in megabits per second, representing the highest quality tier in the ABR ladder.']
  monetization_model varchar [note: 'Revenue model for the channel: AVOD (Advertising-Supported Video On Demand), SVOD (Subscription Video On Demand), TVOD (Transactional Video On Demand), hybrid (multiple models), or free (no monetization).']
  operational_status varchar [note: 'Current operational state of the delivery channel in the distribution infrastructure.']
  parental_control_rating varchar [note: 'TV Parental Guidelines rating assigned to the channel for content filtering and parental control systems.']
  primary_language varchar [note: 'ISO 639-3 three-letter code for the primary broadcast language of the channel (e.g., \'eng\' for English, \'spa\' for Spanish, \'fra\' for French).']
  qos_tier varchar [note: 'Service level tier defining performance guarantees, uptime SLA, and priority for this channel (premium, standard, basic).']
  resolution_format varchar [note: 'Video resolution tier supported by the channel: SD (standard definition 480p), HD (720p), Full HD (1080p), 4K UHD (2160p), 8K UHD (4320p).']
  retirement_date date [note: 'Date when the channel ceased operations or was decommissioned. Null for active channels.']
  retransmission_consent_required boolean [note: 'Indicates whether retransmission consent agreements are required for MVPDs to rebroadcast this channel (true) or if must-carry rules apply (false).']
  sla_uptime_percent decimal(5,2) [note: 'Contractual uptime guarantee for the channel expressed as a percentage (e.g., 99.95 for \'four nines\' availability).']
  streaming_endpoint_url varchar [note: 'Primary streaming endpoint URL or manifest URL for OTT and FAST channels. Confidential operational data.']
  target_market varchar [note: 'ISO 3166-1 alpha-3 country code representing the primary geographic market for the channel (e.g., \'USA\', \'GBR\', \'CAN\').']
  updated_timestamp timestamp [note: 'Timestamp when this delivery channel record was last modified.']

  Note: 'Master definition of a logical distribution channel — a named, configured delivery pathway through which content is transmitted to audiences. Covers linear broadcast channels (DVB-T, DVB-S, ATSC, QAM), OTT streaming channels, FAST channels (Pluto TV, Tubi, Samsung TV Plus, Roku Channel), and simulcast feeds. Captures channel name, call sign, channel number, channel type (linear, OTT, FAST, simulcast), delivery technology standard, resolution/format, language, target market, EPG linkage, operational status, and FAST-specific attributes where applicable (aggregator platform, playlist type, ad insertion method, content refresh cadence, monetization model). SSOT for channel identity within the distribution domain.'
}

Table distribution.release_window {
  release_window_id varchar [pk, note: 'Primary key for release_window']
  accessibility_obligation_id varchar [note: 'Foreign key linking to compliance.accessibility_obligation. Business justification: Release windows specify closed_caption_required and audio_description_required flags. Linking to accessibility_obligation formalizes the governing FCC accessibility mandate per window, enabling compli']
  content_rating_id varchar [note: 'Foreign key linking to compliance.content_rating. Business justification: Distribution windows have rating-specific restrictions (R-rated content excluded from daytime windows, TV-Y required for children\'s blocks). Content rating determines window eligibility and ad inserti']
  demographic_segment_id varchar [note: 'Foreign key linking to audience.demographic_segment. Business justification: Windowing strategies target specific demographics to maximize revenue across release windows. Theatrical windows target A18-49, SVOD windows target families, and AVOD windows target broader demos for ']
  distribution_partner_id varchar [note: 'Foreign key linking to distribution.distribution_partner. Business justification: Release windows are negotiated with distribution partners. release_window.platform_name is STRING but should FK to distribution_partner. Removes platform_name STRING.']
  grant_id varchar [note: 'Foreign key linking to rights.grant. Business justification: Release windows operationalize specific grants (SVOD rights, TVOD rights); direct grant link required for automated clearance validation before window activation, royalty calculation per exploitation ']
  ott_platform_id varchar [note: 'Foreign key linking to distribution.ott_platform. Business justification: Distribution windows for children\'s content require COPPA declarations. Window-specific data collection practices (viewing analytics, personalization) must be declared and parental consent obtained.']
  syndication_agreement_id varchar [note: 'Foreign key linking to partner.syndication_agreement. Business justification: Release windows for syndicated content are directly governed by syndication_agreement terms (run limits, holdback periods, exclusivity windows). Rights operations teams must link each release window t']
  territory_id varchar [note: 'Foreign key linking to rights.rights_territory. Business justification: Release windows are inherently territory-specific (US SVOD window vs UK TVOD window); direct territory FK required for geo-blocking rule enforcement, territory-based availability queries, and regulato']
  ad_insertion_enabled boolean [note: 'Indicates whether Dynamic Ad Insertion (DAI) is enabled for this distribution window, allowing targeted advertising within the content stream.']
  ad_load_minutes decimal(5,2) [note: 'Total minutes of advertising permitted per hour of content in this distribution window. Applicable for AVOD, linear, and FAST windows.']
  audio_description_required boolean [note: 'Indicates whether audio description track is required for visually impaired accessibility in this distribution window.']
  blackout_rules varchar [note: 'Geographic or temporal blackout restrictions applied to this distribution window, preventing broadcast in specific regions or time periods (e.g., sports blackout rules).']
  carriage_fee_amount decimal(15,2) [note: 'Fixed carriage fee paid by the distributor or MVPD for the right to carry this content during the window period.']
  closed_caption_required boolean [note: 'Indicates whether closed captioning is required for accessibility compliance in this distribution window.']
  created_timestamp timestamp [note: 'Timestamp when this distribution window record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for pricing in this distribution window (e.g., USD, EUR, GBP).']
  dubbing_languages varchar [note: 'Comma-separated list of dubbing/audio track languages available for this distribution window (ISO 639-1 codes).']
  effective_timestamp timestamp [note: 'Precise timestamp when this distribution window record became effective and operational for scheduling and delivery systems.']
  exclusivity_flag boolean [note: 'Indicates whether this distribution window grants exclusive rights to the platform, preventing simultaneous distribution on competing platforms during the window period.']
  expiration_timestamp timestamp [note: 'Precise timestamp when this distribution window record expires and is no longer valid for operational use. Nullable for indefinite windows.']
  hdr_enabled boolean [note: 'Indicates whether High Dynamic Range video format is enabled for this distribution window, providing enhanced color and contrast.']
  holdback_period_days varchar [note: 'Number of days between the close of the previous window and the open of this window, enforcing exclusivity periods per rights agreements.']
  language_version varchar [note: 'Primary language version of the content distributed in this window (e.g., English, Spanish, French). ISO 639-1 two-letter language codes preferred.']
  max_resolution varchar [note: 'Maximum video resolution permitted for distribution in this window. SD = Standard Definition (480p); HD = High Definition (720p); Full HD = 1080p; 4K = Ultra HD (2160p); 8K = 4320p.']
  minimum_guarantee_amount decimal(15,2) [note: 'Minimum guaranteed payment amount from the distributor or platform for this distribution window, regardless of actual performance.']
  modified_timestamp timestamp [note: 'Timestamp when this distribution window record was last modified or updated.']
  platform_type varchar [note: 'Classification of the distribution platform. OTT = Over-The-Top streaming; Linear Broadcast = traditional scheduled TV; Theatrical = cinema exhibition; MVPD = Multichannel Video Programming Distributor; vMVPD = Virtual MVPD; FAST Channel = Free Ad-Supported Streaming Television channel; Syndication Network = content resale network. [ENUM-REF-CANDIDATE: ott|linear_broadcast|theatrical|mvpd|vmvpd|fast_channel|syndication_network — 7 candidates stripped; promote to reference product]']
  pricing_model varchar [note: 'Revenue model for this distribution window. Subscription = SVOD flat fee; Transactional = TVOD pay-per-view or rental; Advertising = AVOD ad-supported; Free = no charge to viewer; Hybrid = combination of models.']
  purchase_price decimal(10,2) [note: 'Price charged to viewers for permanent purchase/download during this window (EST model). Nullable if not applicable.']
  rental_price decimal(10,2) [note: 'Price charged to viewers for transactional rental access during this window (TVOD model). Nullable if not applicable.']
  revenue_share_percent decimal(5,2) [note: 'Percentage of revenue shared with the platform or distributor for this window, per the commercial distribution agreement.']
  streaming_protocol varchar [note: 'Primary streaming protocol used for content delivery in this window. HLS = HTTP Live Streaming; MPEG-DASH = Dynamic Adaptive Streaming over HTTP; Smooth Streaming = Microsoft Smooth Streaming; RTMP = Real-Time Messaging Protocol; Progressive Download = traditional file download.']
  subtitle_languages varchar [note: 'Comma-separated list of subtitle languages available for this distribution window (ISO 639-1 codes).']
  territory_scope varchar [note: 'Geographic territory or market where this distribution window applies. May be a single country code (ISO 3166-1 alpha-3), region, or \'WORLDWIDE\' for global distribution.']
  window_close_date date [note: 'Date when the distribution window closes and content is no longer available on the specified platform or channel. Nullable for open-ended windows.']
  window_code varchar [note: 'Business identifier code for the distribution window, used for operational scheduling and reporting.']
  window_open_date date [note: 'Date when the distribution window opens and content becomes available on the specified platform or channel.']
  window_priority varchar [note: 'Numeric priority ranking of this window in the overall release strategy, where 1 = highest priority (typically theatrical), incrementing for subsequent windows.']
  window_status varchar [note: 'Current lifecycle status of the distribution window. Planned = scheduled but not yet open; Active = currently in distribution; Closed = window period has ended; Suspended = temporarily paused; Cancelled = window will not proceed.']
  window_type varchar [note: 'Type of distribution window defining the release strategy. Theatrical = cinema release; SVOD = Subscription Video On Demand; AVOD = Advertising-Supported Video On Demand; TVOD = Transactional Video On Demand; Linear = traditional broadcast; FAST = Free Ad-Supported Streaming Television; Syndication = content resale to multiple outlets; PPV = Pay-Per-View; EST = Electronic Sell-Through. [ENUM-REF-CANDIDATE: theatrical|svod|avod|tvod|linear|fast|syndication|vod|ppv|est — 10 candidates stripped; promote to reference product]']

  Note: 'Master record defining the sequential release windowing strategy for a content title across distribution platforms and channels. Captures window type (theatrical, SVOD, AVOD, TVOD, linear, FAST, syndication), platform or channel assignment, window open date, window close date, holdback period, exclusivity flag, and territory scope. Implements the windowing strategy derived from rights agreements and commercial distribution deals. Complements the rights domain\'s window records by focusing on operational delivery scheduling.'
}

Table distribution.delivery_event {
  delivery_event_id varchar [pk, note: 'Unique identifier for the delivery event record. Primary key.']
  ad_billing_order_id varchar [note: 'Foreign key linking to billing.ad_billing_order. Business justification: Delivery events record actual ad spot delivery (ad_fill_rate_percent, ad_pod_position, scte35_signal_type). Linking to ad_billing_order enables post-log affidavit reconciliation — verifying contracted']
  broadcast_license_id varchar [note: 'Foreign key linking to compliance.broadcast_license. Business justification: Market attribution of delivery events enables DMA-level reporting, geographic blackout enforcement, local advertising compliance, and Nielsen station index measurement for broadcast and streaming conv']
  campaign_id varchar [note: 'Foreign key linking to sales.campaign. Business justification: When delivery_event records ad delivery (dai_enabled flag), linking to campaign enables campaign-level delivery verification and performance tracking. Essential for bridging distribution delivery logs; FK references sales domain entity; namespace reconciled from advertising context']
  channel_id varchar [note: 'Reference to the distribution channel through which content was delivered (linear broadcast channel, OTT platform, FAST channel).']
  closed_caption_record_id varchar [note: 'Foreign key linking to compliance.closed_caption_record. Business justification: FCC closed captioning compliance requires that each captioned delivery event be traceable to its closed_caption_record for accuracy scoring, complaint investigation, and regulatory filing. This link e']
  delivery_channel_id varchar [note: 'Foreign key linking to distribution.delivery_channel. Business justification: delivery_event.delivery_channel_type is a free-text STRING describing the type of delivery channel used for the event. Normalizing this to a FK delivery_channel_id -> delivery_channel.delivery_channel']
  demographic_segment_id varchar [note: 'Foreign key linking to audience.demographic_segment. Business justification: Content delivery logs require demographic context for Nielsen measurement reconciliation, audience guarantee validation, and cross-platform deduplication. Supports C3/C7 commercial ratings and makegoo']
  device_type_id varchar [note: 'Reference to the device type used by the viewer for this delivery event.']
  eas_log_id varchar [note: 'Foreign key linking to compliance.eas_log. Business justification: Delivery events for emergency alert system messages must be logged for FCC compliance. Each EAS delivery creates a compliance log entry documenting transmission, relay, and attention signal.']
  grant_id varchar [note: 'Foreign key linking to rights.rights_grant. Business justification: Delivery events represent actual content delivery under specific rights grants. Essential for usage tracking, run count enforcement, and royalty calculation based on actual exploitation. Enables right']
  partner_id varchar [note: 'Foreign key linking to partner.partner. Business justification: Delivery events link to transmission equipment for performance tracking. Required for equipment performance reporting and failure pattern analysis.']
  playback_session_id varchar [note: 'Reference to the playback session associated with this delivery event for OTT/streaming deliveries.']
  political_ad_record_id varchar [note: 'Foreign key linking to compliance.political_ad_record. Business justification: FCC requires broadcasters to maintain records of political ad airings. Linking delivery_event to political_ad_record enables automated verification that political spots were delivered as contracted, s']
  schedule_slot_id varchar [note: 'Foreign key linking to scheduling.schedule_slot. Business justification: CDN delivery events must tie to scheduled slots for technical delivery SLA monitoring, as-run log reconciliation, and troubleshooting delivery failures against scheduled content. Operations teams need']
  streaming_endpoint_id varchar [note: 'Reference to the streaming endpoint used for OTT delivery events.']
  ad_fill_rate_percent decimal(5,2) [note: 'Percentage of available ad inventory that was successfully filled during this DAI event (0.00 to 100.00).']
  ad_pod_position varchar [note: 'Position of the ad pod within the content stream for DAI events (e.g., pre-roll=1, mid-roll=2, post-roll=3).']
  audio_codec varchar [note: 'Audio codec used for the delivered content (e.g., AAC, AC-3, E-AC-3, Dolby Atmos).']
  bitrate_kbps varchar [note: 'Stream bitrate in kilobits per second at the time of this delivery event.']
  bytes_delivered varchar [note: 'Total number of bytes delivered to the viewer during this event.']
  cdn_cache_status varchar [note: 'CDN cache status for this delivery (hit, miss, stale, bypass).']
  cdn_node_code varchar [note: 'Identifier of the CDN edge node that served the content for this delivery event.']
  cdn_pop_location varchar [note: 'Geographic location identifier of the CDN point of presence that served this delivery.']
  created_timestamp timestamp [note: 'Timestamp when this delivery event record was created in the system.']
  dai_enabled boolean [note: 'Flag indicating whether dynamic ad insertion was enabled for this delivery event.']
  delivery_status varchar [note: 'Outcome status of the delivery event (success, failure, degraded quality, partial delivery).']
  delivery_technology varchar [note: 'Technical protocol or standard used for content delivery (HLS, MPEG-DASH, DVB, ATSC, QAM, Smooth Streaming, RTMP). [ENUM-REF-CANDIDATE: hls|mpeg_dash|dvb|atsc|qam|smooth_streaming|rtmp — 7 candidates stripped; promote to reference product]']
  drm_system varchar [note: 'DRM system applied to protect the content during delivery (Widevine, PlayReady, FairPlay, or none for unprotected content).']
  error_code varchar [note: 'System error code if the delivery event encountered a failure or degradation.']
  error_message varchar [note: 'Human-readable error message describing the delivery failure or issue.']
  event_timestamp timestamp [note: 'Precise timestamp when the delivery event occurred (stream start, broadcast transmission, VOD delivery initiation).']
  event_type varchar [note: 'Type of delivery event being recorded (stream start, VOD delivery, broadcast transmission, DAI insertion, stream end, playback error, buffer event). [ENUM-REF-CANDIDATE: stream_start|vod_delivery|broadcast_tx|dai_insertion|stream_end|playback_error|buffer_event — 7 candidates stripped; promote to reference product]']
  geographic_country_code varchar [note: 'ISO 3166-1 alpha-3 country code where the delivery occurred (e.g., USA, GBR, CAN).']
  geographic_region varchar [note: 'Geographic region where the content was delivered (e.g., North America, EMEA, APAC, or specific country/state codes).']
  network_latency_ms varchar [note: 'Network latency measured in milliseconds between CDN edge and viewer device.']
  origin_server_response_time_ms varchar [note: 'Response time from origin server in milliseconds for cache-miss scenarios.']
  resolution varchar [note: 'Video resolution delivered (e.g., 1920x1080, 3840x2160, 1280x720).']
  scte35_signal_type varchar [note: 'Type of SCTE-35 signal that triggered the DAI event (e.g., splice_insert, time_signal).']
  session_duration_seconds varchar [note: 'Total duration of the delivery session in seconds for streaming events.']
  sla_tier varchar [note: 'SLA tier classification applicable to this delivery event (e.g., premium, standard, basic).']
  streaming_protocol varchar [note: 'Specific streaming protocol used for OTT delivery (HLS, DASH, Smooth Streaming, RTMP, WebRTC).']
  updated_timestamp timestamp [note: 'Timestamp when this delivery event record was last updated.']
  user_agent varchar [note: 'User agent string from the viewer device identifying browser/app and operating system.']
  video_codec varchar [note: 'Video codec used for encoding the delivered content (e.g., H.264, H.265/HEVC, VP9, AV1).']
  viewer_ip_address varchar [note: 'IP address of the viewer device that received the content delivery.']

  Note: 'Transactional record capturing each discrete content delivery event — including stream session initiations, linear broadcast transmissions, VOD asset deliveries, FAST channel playout events, and dynamic ad insertion (DAI) sessions. Captures event timestamp, event type (stream_start, vod_delivery, broadcast_tx, dai_insertion), delivery channel, content asset reference, delivery technology (HLS, MPEG-DASH, DVB, ATSC), CDN node, geographic region, stream quality (bitrate, resolution), delivery status (success, failure, degraded), error codes, and DAI-specific attributes (ad pod position, SCTE-35 signal, fill rate) where applicable. Feeds delivery SLA monitoring, CDN performance reporting, and AVOD/FAST monetization reconciliation.'
}

Table distribution.channel_lineup {
  channel_lineup_id varchar [pk, note: 'Primary key for channel_lineup']
  accessibility_obligation_id varchar [note: 'Foreign key linking to compliance.accessibility_obligation. Business justification: Channel lineup records specify closed_caption_required and audio_description_available. Linking to accessibility_obligation formalizes the governing FCC accessibility mandate per lineup entry, enablin']
  broadcast_license_id varchar [note: 'Foreign key linking to compliance.broadcast_license. Business justification: Channel lineups vary by DMA due to must-carry rules, local station carriage, blackout restrictions, and market-specific programming rights. Required for FCC compliance and retransmission consent enfor']
  carriage_agreement_id varchar [note: 'Foreign key linking to distribution.carriage_agreement. Business justification: Channel lineups are defined by carriage agreements. Lineup terms and channel positioning come from agreements. Removes contract_reference_number STRING (derivable from carriage_agreement.agreement_num']
  carriage_invoice_id varchar [note: 'Foreign key linking to billing.invoice. Business justification: Channel lineups carry per-subscriber carriage fees invoiced monthly to distribution partners. A direct FK to the billing invoice enables carriage fee reconciliation and invoice auditing at the lineup ']
  channel_id varchar [note: 'Reference to the specific broadcast or streaming channel included in this lineup.']
  distribution_partner_id varchar [note: 'Foreign key linking to distribution.distribution_partner. Business justification: Channel lineups belong to distribution partners. channel_lineup.partner_id should FK to distribution_partner. Removes partner_id BIGINT (replaced by distribution_partner_id FK).']
  regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: Channel lineup entries must comply with must-carry obligations and channel positioning rules. Linking channel_lineup to regulatory_obligation supports FCC compliance reporting on must-carry elections ']
  audio_description_available boolean [note: 'Indicates whether audio description (descriptive video service) is available for visually impaired subscribers.']
  blackout_region_codes varchar [note: 'Comma-separated list of geographic region codes where blackout restrictions apply for this channel (e.g., DMA codes, postal codes, state codes).']
  blackout_rules_applicable boolean [note: 'Indicates whether geographic broadcast restriction (blackout) rules apply to this channel within the lineup.']
  carriage_fee_currency_code varchar [note: 'Three-letter ISO 4217 currency code for the carriage fee (e.g., USD, EUR, GBP).']
  carriage_fee_per_subscriber decimal(12,4) [note: 'Monthly fee paid by the MVPD/vMVPD to the content provider per subscriber who has access to this channel within the lineup. Used for carriage fee calculation and revenue assurance.']
  carriage_type varchar [note: 'Legal basis for the channel\'s inclusion in the lineup: must-carry (mandatory FCC requirement), retransmission consent (negotiated rebroadcast authorization), or negotiated carriage agreement.']
  channel_display_name varchar [note: 'The branded name of the channel as displayed to subscribers in the EPG (Electronic Program Guide) for this specific lineup.']
  channel_position_number varchar [note: 'Logical channel number or position assigned to the channel within this lineup (e.g., channel 101, channel 502). Used for Electronic Program Guide (EPG) display and subscriber navigation.']
  closed_caption_required boolean [note: 'Indicates whether closed captioning is mandated for this channel per FCC accessibility requirements.']
  created_timestamp timestamp [note: 'Timestamp when this channel lineup record was first created in the system.']
  dma_code varchar [note: 'Nielsen Designated Market Area code identifying the specific television market where this lineup is offered (e.g., \'501\' for New York).']
  dvr_enabled boolean [note: 'Indicates whether subscribers can record content from this channel using DVR functionality.']
  effective_end_date date [note: 'Date when this channel lineup configuration expires or is replaced. Null indicates an open-ended active lineup.']
  effective_start_date date [note: 'Date when this channel lineup configuration becomes active and available to subscribers.']
  geographic_restriction_rules varchar [note: 'Detailed description of geographic restrictions, including allowed and blocked regions, for subscriber entitlement validation.']
  hd_available boolean [note: 'Indicates whether the channel is available in high definition (HD) format within this lineup.']
  last_modified_timestamp timestamp [note: 'Timestamp when this channel lineup record was most recently updated.']
  lineup_code varchar [note: 'Short alphanumeric code uniquely identifying the lineup within the partner\'s system (e.g., \'BASIC-01\', \'PREM-SPORTS\').']
  lineup_name varchar [note: 'Business name of the channel lineup or package (e.g., \'Basic Cable\', \'Premium Sports Tier\', \'Expanded Basic\').']
  lineup_status varchar [note: 'Current operational status of the channel lineup configuration.']
  market_applicability varchar [note: 'Geographic scope of the lineup: national (available across all markets), regional (multi-state region), local (single market), or DMA-specific (Designated Market Area).']
  modified_by_user varchar [note: 'Username or identifier of the user who last modified this channel lineup record.']
  notes varchar [note: 'Free-text field for additional operational notes, special instructions, or business context related to this channel lineup configuration.']
  parental_control_rating varchar [note: 'Content rating classification for parental control enforcement at the channel level within the lineup. [ENUM-REF-CANDIDATE: TV-Y|TV-Y7|TV-G|TV-PG|TV-14|TV-MA|not_rated — 7 candidates stripped; promote to reference product]']
  priority_rank varchar [note: 'Relative priority or importance ranking of this channel within the lineup, used for EPG display ordering and promotional emphasis.']
  promotional_end_date date [note: 'Date when the promotional offering for this channel expires, after which standard pricing or availability rules apply.']
  promotional_flag boolean [note: 'Indicates whether this channel is being offered as part of a promotional campaign or limited-time offer within the lineup.']
  service_tier varchar [note: 'Service level classification indicating the quality or feature set of the lineup (e.g., standard definition, high definition, 4K).']
  subscriber_count_estimate varchar [note: 'Estimated number of subscribers who have access to this channel through this lineup. Used for carriage fee calculation and audience reach estimation.']
  tier_type varchar [note: 'Classification of the channel tier or package type offered to subscribers. [ENUM-REF-CANDIDATE: basic|expanded_basic|premium|sports|news|entertainment|international|a_la_carte — 8 candidates stripped; promote to reference product]']
  uhd_4k_available boolean [note: 'Indicates whether the channel is available in 4K ultra high definition format within this lineup.']
  vod_enabled boolean [note: 'Indicates whether Video On Demand (VOD) content is available for this channel within the lineup.']

  Note: 'Master record defining the channel package or tier lineup offered by an MVPD or vMVPD partner, specifying which delivery channels are included in each subscriber tier (basic, expanded basic, premium, sports, etc.). Captures partner, tier name, tier type, included channels, channel position number, effective date, and market applicability. Used for carriage fee calculation, blackout enforcement, and subscriber entitlement validation.'
}

Table distribution.deal {
  deal_id varchar [pk, note: 'Primary key for deal']
  billing_account_id varchar [note: 'Foreign key linking to billing.billing_account. Business justification: Distribution deals originate from sales opportunities in the deal lifecycle. Tracks opportunity-to-contract conversion for distribution partnerships, platform licensing, and carriage agreements. Essen']
  broadcast_license_id varchar [note: 'Foreign key linking to compliance.broadcast_license. Business justification: Retransmission consent and carriage deals are directly tied to specific broadcast licenses — the license defines the rights being negotiated. Linking deal to broadcast_license supports deal compliance']
  distribution_agreement_id varchar [note: 'Foreign key linking to partner.distribution_agreement. Business justification: Distribution deals are negotiated and executed under a governing distribution_agreement. Deal management and revenue reporting require linking each deal to its authorizing distribution_agreement — a n']
  distribution_partner_id varchar [note: 'Reference to the OTT platform, FAST aggregator, syndication buyer, or international distributor party to this deal.']
  license_agreement_id varchar [note: 'Foreign key linking to rights.license_agreement. Business justification: Distribution deals with partners are governed by underlying content license agreements. Critical for validating distribution rights chain, ensuring revenue share terms align with license obligations, ']
  auto_renewal_flag boolean [note: 'Indicates whether the deal automatically renews at expiration unless terminated. True = auto-renews; False = requires explicit renewal.']
  content_scope varchar [note: 'Description of the content assets included in this deal. May reference specific titles, series, libraries, or content categories covered by the agreement.']
  created_timestamp timestamp [note: 'Timestamp when this deal record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary values in this deal (e.g., USD, EUR, GBP).']
  deal_number varchar [note: 'Externally-known unique business identifier for the distribution deal, used in contracts and communications.']
  deal_status varchar [note: 'Current lifecycle status of the distribution deal. Tracks progression from initial draft through negotiation, approval, active operation, and eventual closure or renewal. [ENUM-REF-CANDIDATE: draft|negotiation|pending approval|active|suspended|expired|terminated|renewed — 8 candidates stripped; promote to reference product]']
  deal_type varchar [note: 'Classification of the distribution deal structure. SVOD licensing = Subscription Video On Demand content licensing; AVOD revenue share = Advertising-Supported Video On Demand with revenue sharing; FAST syndication = Free Ad-Supported Streaming Television channel syndication; linear carriage = traditional broadcast carriage; TVOD licensing = Transactional Video On Demand licensing; international distribution = cross-border content distribution agreements.']
  dispute_resolution_mechanism varchar [note: 'Agreed method for resolving disputes arising from this deal.']
  drm_requirements varchar [note: 'Specification of DRM systems and protection levels required for content delivery under this deal (e.g., Widevine L1, PlayReady SL3000, FairPlay).']
  effective_date date [note: 'Date when the distribution deal becomes active and content distribution rights commence.']
  exclusivity_flag boolean [note: 'Indicates whether this deal grants exclusive distribution rights to the partner within the specified territory and platform type. True = exclusive; False = non-exclusive.']
  exclusivity_window_days varchar [note: 'Duration in days of the exclusivity period or holdback window during which content cannot be distributed through competing channels.']
  expiration_date date [note: 'Date when the distribution deal expires and content distribution rights terminate. Nullable for open-ended or perpetual deals.']
  flat_fee_amount decimal(15,2) [note: 'Fixed payment amount for flat fee deal structures. Represents total or periodic payment value.']
  governing_law_jurisdiction varchar [note: 'Legal jurisdiction whose laws govern the interpretation and enforcement of this deal (e.g., State of California, England and Wales).']
  last_amendment_date date [note: 'Date of the most recent amendment or modification to the deal terms.']
  minimum_guarantee_amount decimal(15,2) [note: 'Minimum Guarantee amount paid upfront or over the deal term, recoupable against future revenue share or royalties.']
  minimum_subscriber_guarantee varchar [note: 'Minimum number of subscribers or active users the distribution partner guarantees for revenue calculation purposes.']
  name varchar [note: 'Human-readable name or title of the distribution deal for identification and reporting purposes.']
  negotiation_start_date date [note: 'Date when commercial negotiations for this deal commenced.']
  notes varchar [note: 'Free-form text field for additional context, special conditions, or internal comments about the deal.']
  payment_terms varchar [note: 'Description of payment schedule, frequency, and conditions (e.g., net 30, quarterly in arrears, monthly advance).']
  platform_type varchar [note: 'Type of distribution platform. OTT = Over-The-Top streaming; FAST = Free Ad-Supported Streaming Television; MVPD = Multichannel Video Programming Distributor; vMVPD = Virtual MVPD; linear broadcast = traditional broadcast; syndication = content resale; international = cross-border distribution. [ENUM-REF-CANDIDATE: OTT|FAST|MVPD|vMVPD|linear broadcast|syndication|international — 7 candidates stripped; promote to reference product]']
  promotional_commitment varchar [note: 'Description of marketing and promotional activities the distribution partner has committed to perform (e.g., homepage placement, email campaigns, social media promotion).']
  renewal_notice_days varchar [note: 'Number of days advance notice required to exercise or decline renewal option before expiration.']
  reporting_frequency varchar [note: 'Frequency at which the distribution partner must provide performance and revenue reports.']
  revenue_model varchar [note: 'Commercial structure defining how revenue is generated and shared. Flat fee = fixed payment; revenue share = percentage of platform revenue; minimum guarantee = MG against future royalties; hybrid = combination of models; cost per stream = per-view payment; cost per subscriber = per-subscriber payment.']
  revenue_share_percentage decimal(5,2) [note: 'Percentage of revenue allocated to the content owner under revenue share agreements. Expressed as a percentage (e.g., 65.00 represents 65%).']
  signed_date date [note: 'Date when the distribution deal contract was executed by all parties.']
  sla_tier varchar [note: 'Service level tier defining uptime, performance, and support commitments for content delivery under this deal.']
  technical_delivery_requirements varchar [note: 'Technical specifications for content delivery including format, resolution, bitrate, codec, and delivery method (e.g., HLS 1080p H.264, DASH 4K HEVC).']
  term_months varchar [note: 'Duration of the deal term expressed in months. Calculated from effective date to expiration date.']
  termination_notice_days varchar [note: 'Number of days advance notice required by either party to terminate the deal prior to natural expiration.']
  territory varchar [note: 'Geographic territory or territories covered by this distribution deal. May be a single country code, multiple countries, or regional designation (e.g., USA, CAN|MEX, EMEA).']
  updated_timestamp timestamp [note: 'Timestamp when this deal record was last modified in the system.']

  Note: 'Master record for commercial distribution deals negotiated with OTT platforms, FAST aggregators, syndication buyers, and international distributors. Captures deal name, deal type (SVOD licensing, AVOD revenue share, FAST syndication, linear carriage), counterparty, territory, content scope, revenue model (flat fee, revenue share percentage, MG against royalty), deal effective date, expiry date, and deal status. Distinct from carriage_agreement (which is MVPD-specific) — this covers broader OTT and digital distribution commercial arrangements.'
}

Table distribution.content_delivery_order {
  content_delivery_order_id varchar [pk, note: 'Unique identifier for the content delivery order. Primary key for this transactional record representing a formal order to deliver content assets to distribution partners or platforms.']
  carriage_agreement_id varchar [note: 'Reference to the underlying carriage or distribution agreement that authorizes this content delivery. Links order to contractual obligations.']
  delivery_channel_id varchar [note: 'Foreign key linking to distribution.delivery_channel. Business justification: content_delivery_order.target_platform is a STRING field capturing the destination delivery channel for the order. Normalizing this to a FK delivery_channel_id -> delivery_channel.delivery_channel_id ']
  grant_id varchar [note: 'Foreign key linking to rights.grant. Business justification: Delivery orders fulfill specific content exploitation rights; grant link enables pre-delivery clearance verification ("do we have rights to deliver this?"), usage tracking for royalty calculation, and']
  partner_id varchar [note: 'Foreign key linking to partner.partner. Business justification: Delivery orders specify exact rendition (proxy/mezzanine/distribution master) for partner fulfillment. Broadcasters track which version was delivered for audit/quality purposes. Existing content_asset']
  program_schedule_id varchar [note: 'Foreign key linking to scheduling.program_schedule. Business justification: Content delivery orders fulfill scheduled programming requirements. Operations and billing teams must track which delivery orders satisfy which program schedules for fulfillment verification, delivery']
  regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: Content delivery orders for broadcast content must reference the applicable regulatory_obligation (closed captioning delivery, accessibility, EAS) to ensure compliant fulfillment. This link supports c']
  release_window_id varchar [note: 'Foreign key linking to distribution.release_window. Business justification: A content_delivery_order represents a formal order to deliver a content asset to a partner/platform. release_window defines the sequential windowing strategy for a title across distribution platforms,']
  streaming_endpoint_id varchar [note: 'Reference to the target streaming endpoint or Content Delivery Network (CDN) origin where content will be published.']
  actual_delivery_timestamp timestamp [note: 'Timestamp when the content was actually delivered and confirmed received by the distribution partner. Used for SLA performance measurement.']
  approved_by_user varchar [note: 'Username or identifier of the user who approved this delivery order for fulfillment. Tracks authorization and approval workflow.']
  approved_timestamp timestamp [note: 'Timestamp when this delivery order was approved for fulfillment. Marks the transition from draft to active status.']
  audio_configuration varchar [note: 'Audio channel configuration and format for the delivered content. Defines the immersive audio capabilities and speaker layout.']
  audio_languages varchar [note: 'Comma-separated list of ISO 639-2 language codes for audio tracks included in the delivery. Supports multi-language distribution requirements.']
  closed_captions_included boolean [note: 'Indicates whether closed captions are included in the delivered content. Required for FCC compliance and accessibility standards.']
  content_duration_seconds varchar [note: 'Total runtime duration of the content asset being delivered, measured in seconds. Used for capacity planning and delivery time estimation.']
  created_by_user varchar [note: 'Username or identifier of the user who created this delivery order. Provides accountability and audit trail for order origination.']
  created_timestamp timestamp [note: 'Timestamp when this delivery order record was first created in the system. Audit trail for record lifecycle tracking.']
  delivery_deadline_timestamp timestamp [note: 'Precise deadline timestamp for content delivery. Used for Service Level Agreement (SLA) compliance tracking and penalty calculations.']
  delivery_format varchar [note: 'Required content format for delivery. Specifies the container format, codec, and packaging standard expected by the distribution partner. [ENUM-REF-CANDIDATE: hls|mpeg_dash|smooth_streaming|mxf|mp4|prores|imf — 7 candidates stripped; promote to reference product]']
  delivery_method varchar [note: 'Technical method or protocol used to transfer the content to the distribution partner. Defines the transport mechanism for content delivery.']
  delivery_notes varchar [note: 'Free-text notes and special instructions for the delivery order. Captures partner-specific requirements, technical considerations, or operational alerts.']
  estimated_delivery_duration_minutes varchar [note: 'Estimated time required to complete the content delivery, measured in minutes. Based on file size, bandwidth, and delivery method.']
  failure_reason varchar [note: 'Description of the reason for delivery failure if order status is failed. Used for root cause analysis and process improvement.']
  file_size_gb decimal(12,3) [note: 'Total file size of the content package being delivered, measured in gigabytes. Used for bandwidth planning and cost estimation.']
  fulfillment_confirmation_number varchar [note: 'Unique confirmation identifier provided upon successful delivery completion. Used for proof of delivery and reconciliation with distribution partners.']
  geographic_restrictions varchar [note: 'Comma-separated list of ISO 3166-1 alpha-3 country codes where content delivery is restricted or permitted. Enforces territorial rights and blackout rules.']
  hdr_format varchar [note: 'High Dynamic Range format specification for the delivered content. Defines the color space and dynamic range capabilities.']
  order_date timestamp [note: 'Timestamp when the delivery order was created or placed. Represents the principal business event time for this transaction.']
  order_number varchar [note: 'Externally-known unique business identifier for this delivery order. Used for tracking, communication, and reconciliation with distribution partners.']
  order_status varchar [note: 'Current lifecycle status of the delivery order. Tracks the order through its workflow from creation to fulfillment or cancellation. [ENUM-REF-CANDIDATE: draft|pending|approved|in_progress|delivered|failed|cancelled — 7 candidates stripped; promote to reference product]']
  order_type varchar [note: 'Classification of the delivery order type. Indicates the nature and urgency of the content delivery request.']
  priority_level varchar [note: 'Business priority assigned to this delivery order. Determines resource allocation and scheduling precedence in the delivery queue.']
  requested_delivery_date date [note: 'Target date by which the content must be delivered to the distribution partner. Drives scheduling and prioritization of delivery tasks.']
  retry_count varchar [note: 'Number of delivery attempts made for this order. Tracks resilience and reliability of the delivery process.']
  sla_tier varchar [note: 'Service level tier assigned to this delivery order. Determines performance targets, priority, and penalty provisions.']
  subtitle_languages varchar [note: 'Comma-separated list of ISO 639-2 language codes for subtitle tracks included in the delivery. Supports accessibility and international distribution.']
  transcode_profile_code varchar [note: 'Reference to the transcode profile specifying encoding parameters, bitrates, resolutions, and quality settings for content preparation.']
  updated_timestamp timestamp [note: 'Timestamp when this delivery order record was last modified. Tracks the most recent change to any field in the record.']
  video_resolution varchar [note: 'Target video resolution for the delivered content. Specifies the quality tier and display format for the distribution platform.']

  Note: 'Transactional record representing a formal order to deliver a specific content asset or package to a distribution partner or platform by a specified deadline. Captures order type (new release, refresh, replacement, emergency), content asset reference, target distribution platform, required delivery format, transcode profile, DRM policy, delivery deadline, delivery method (CDN push, FTP, Aspera, satellite uplink), order status, and fulfillment confirmation. Operationalizes the distribution deal and window commitments into actionable delivery tasks.'
}

Table rights.license_agreement {
  license_agreement_id varchar [pk, note: 'Unique system identifier for the license agreement record. Primary key. Role: MASTER_AGREEMENT.']
  acquisition_deal_id varchar [note: 'Foreign key linking to partner.acquisition_deal. Business justification: License agreements are the legal formalization of acquisition deals. Deal-to-license traceability is required for MG recoupment audits, deal performance reporting, and regulatory compliance — rights t']
  broadcast_license_id varchar [note: 'Foreign key linking to compliance.broadcast_license. Business justification: License agreements for broadcast content must reference the FCC broadcast license under which content is distributed. Required for regulatory compliance and public inspection file documentation.']
  licensee_sales_account_id varchar [note: 'Foreign key linking to sales.sales_account. Business justification: License agreements are negotiated with sales accounts (distributors, broadcasters, platforms). Real-world licensing operations require tracking which sales account is the licensee for revenue recognit']
  primary_license_holder_id varchar [note: 'Reference to the party granting rights under this agreement (studio, distributor, music publisher, talent guild, production company).']
  primary_licensee_partner_partner_id varchar [note: 'FK to partner.partner_partner']
  regulatory_filing_id varchar [note: 'Foreign key linking to compliance.regulatory_filing. Business justification: Material license agreements (ownership changes, political advertising contracts, significant territory expansions) trigger FCC regulatory filings. Tracks which agreements require public disclosure or ']
  regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: License agreements are governed by specific regulatory obligations (guild residual mandates, music sync rules, FCC licensing requirements). Flags like residuals_obligation_flag and music_sync_license_']
  advance_payment_amount decimal(18,2) [note: 'Upfront payment made upon execution of the agreement, typically recoupable against future royalties or license fees.']
  agreement_number varchar [note: 'Externally-known unique business identifier for the license agreement, used in contracts and communications with rights holders and licensees.']
  agreement_status varchar [note: 'Current lifecycle state of the license agreement. Controls whether rights are available for scheduling and distribution.']
  agreement_type varchar [note: 'Classification of the license agreement based on the nature of the rights transaction. Determines workflow, royalty calculation rules, and windowing strategies. [ENUM-REF-CANDIDATE: acquisition|co-production|syndication|first-run syndication|off-network syndication|international syndication|music sync|output deal — 8 candidates stripped; promote to reference product]']
  auto_renewal_flag boolean [note: 'Indicates whether the agreement automatically renews at expiry unless terminated by either party. True = auto-renews, False = expires at term end.']
  blackout_restrictions varchar [note: 'Geographic or temporal restrictions on content availability (e.g., no broadcast in certain markets during specific events, sports blackout rules). Free-text description.']
  clearance_required_flag boolean [note: 'Indicates whether additional rights clearance verification is required before content can be broadcast or distributed under this agreement. True = clearance workflow required, False = no additional clearance needed.']
  content_rating_restriction varchar [note: 'Content rating limitations imposed by this agreement (e.g., PG-13 and below only, no R-rated content). Comma-separated list of allowed ratings per MPA or TV Parental Guidelines.']
  created_timestamp timestamp [note: 'System timestamp when this license agreement record was first created in Rightsline.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for all monetary amounts in this agreement (e.g., USD, GBP, EUR).']
  effective_date date [note: 'Date when the license agreement becomes legally binding and rights become available for exploitation. Start of the agreement term.']
  exclusivity_flag boolean [note: 'Indicates whether the license grants exclusive rights within the territory and media windows. True = exclusive, False = non-exclusive.']
  expiry_date date [note: 'Date when the license agreement terminates and rights revert to the licensor. End of the agreement term. Nullable for perpetual agreements.']
  governing_law_jurisdiction varchar [note: 'Legal jurisdiction whose laws govern the interpretation and enforcement of this agreement (e.g., State of California, England and Wales, New York).']
  holdback_period_days varchar [note: 'Number of days during which content must be withheld from certain distribution windows to protect exclusivity in other windows (e.g., theatrical holdback before SVOD release).']
  last_modified_timestamp timestamp [note: 'System timestamp when this license agreement record was last updated in Rightsline.']
  media_rights_granted varchar [note: 'Comma-separated list of media exploitation rights included in this agreement (e.g., linear broadcast, SVOD, AVOD, TVOD, theatrical, home video, digital download, mobile streaming).']
  minimum_guarantee_amount decimal(18,2) [note: 'Minimum guaranteed payment to the licensor regardless of actual usage or revenue performance. Common in output deals and syndication agreements.']
  music_sync_license_flag boolean [note: 'Indicates whether this agreement includes music synchronization rights for use of musical compositions in audiovisual content. True = music sync rights included, False = no music sync rights.']
  notes varchar [note: 'Free-text field for additional contractual terms, special conditions, or internal comments about the agreement.']
  payment_schedule_type varchar [note: 'Structure of the payment obligation. Determines how total_license_fee is disbursed over time.']
  per_episode_fee decimal(18,2) [note: 'License fee charged per episode for episodic content. Applicable to syndication and first-run syndication agreements.']
  renewal_term_months varchar [note: 'Duration in months of each automatic renewal period if auto_renewal_flag is true. Null if agreement does not auto-renew.']
  residuals_obligation_flag boolean [note: 'Indicates whether the agreement includes obligations to pay talent residuals for reuse of content. True = residuals required, False = no residuals.']
  royalty_calculation_method varchar [note: 'Method used to calculate ongoing royalty payments to the licensor. Determines how revenue is shared or how usage is monetized.']
  royalty_percentage decimal(5,2) [note: 'Percentage of revenue or receipts paid to the licensor as ongoing royalties. Applicable when royalty_calculation_method is percentage-based.']
  run_count_limit varchar [note: 'Maximum number of times each episode or program may be broadcast or streamed under this agreement. Common in syndication deals. Null indicates unlimited runs.']
  signed_date date [note: 'Date when the agreement was executed by all parties. May differ from effective_date.']
  sublicensing_allowed_flag boolean [note: 'Indicates whether the licensee is permitted to sublicense the rights to third parties. True = sublicensing allowed, False = sublicensing prohibited.']
  termination_notice_days varchar [note: 'Number of days advance notice required by either party to terminate the agreement before expiry or renewal.']
  territory_scope varchar [note: 'Geographic territories covered by this license agreement. Comma-separated list of ISO 3166-1 alpha-3 country codes or region identifiers (e.g., USA,CAN,MEX or WORLDWIDE or EMEA).']
  total_license_fee decimal(18,2) [note: 'Total contractual payment obligation for the license rights over the full term of the agreement. Sum of all payment milestones.']
  windowing_strategy varchar [note: 'Sequential release strategy defining the order and timing of content availability across distribution channels (theatrical, SVOD, AVOD, TVOD, linear, syndication). Free-text description of the windowing plan.']

  Note: 'Master record for all content licensing, acquisition, and syndication agreements managed in Rightsline. Captures the full contractual relationship between Media Broadcasting and rights grantors or licensees (studios, distributors, music publishers, talent guilds, syndication partners). Stores agreement type (acquisition, co-production, syndication, first-run syndication, off-network syndication, international syndication, music sync, output deal), licensor and licensee identities, effective and expiry dates, territory scope, exclusivity flags, total license fee, payment schedule with milestone detail (advances, minimum guarantees, per-episode fees, annual installments), run count limitations for syndication, governing law jurisdiction, and agreement status (draft, executed, expired, terminated). This is the SSOT for all rights-bearing contracts and the anchor entity for all downstream window, royalty, and clearance records.'
}

Table rights.grant {
  grant_id varchar [pk, note: 'Unique identifier for the rights grant record. Primary key.']
  compliance_content_rating_id varchar [note: 'Foreign key linking to compliance.content_rating. Business justification: Rights grants must enforce content rating restrictions by territory. Clearance workflow validates that granted rights comply with rating-based distribution restrictions (e.g., TV-MA content on childre']
  distribution_agreement_id varchar [note: 'Foreign key linking to partner.distribution_agreement. Business justification: Distribution agreements authorize specific rights grants for carriage and streaming. Distribution rights teams need to trace which distribution agreement authorized each grant for carriage fee reconci']
  license_agreement_id varchar [note: 'Reference to the parent license agreement from which this grant is derived.']
  ott_platform_id varchar [note: 'Foreign key linking to distribution.ott_platform. Business justification: Rights grants for children\'s content require verified COPPA compliance before exploitation. Links grant to the COPPA declaration that authorizes distribution to child audiences.']
  regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: Rights grants must comply with regulatory obligations such as territorial quota requirements and must-carry mandates. Grant-level clearance_status and drm_required are driven by specific regulatory ob']
  syndication_agreement_id varchar [note: 'Foreign key linking to partner.syndication_agreement. Business justification: Syndication agreements grant specific exploitation rights to syndication partners. Linking grant to syndication_agreement enables per-agreement royalty calculation, run-limit enforcement, and syndicat']
  territory_id varchar [note: 'Foreign key linking to rights.territory. Business justification: Rights grants apply to specific territories. Each rights grant covers one territory. Normalizing to territory reference eliminates redundant territory string storage and enables consistent territory m']
  blackout_applicable boolean [note: 'Indicates whether geographic or temporal blackout restrictions apply to this grant (e.g., sports blackouts, regional restrictions).']
  carriage_fee_applicable boolean [note: 'Indicates whether a carriage fee (distribution payment) is associated with this grant.']
  clearance_status varchar [note: 'Current clearance status of the grant. Indicates whether all rights verification and legal clearances have been completed.']
  created_timestamp timestamp [note: 'Timestamp when this rights grant record was first created in the system.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for financial amounts in this grant (e.g., USD, GBP, EUR).']
  drm_required boolean [note: 'Indicates whether DRM protection is mandated for content distributed under this grant.']
  end_date date [note: 'The date on which the rights grant expires and exploitation must cease. Nullable for perpetual grants.']
  exclusivity_indicator boolean [note: 'Indicates whether the grant is exclusive (true) or non-exclusive (false). Exclusive grants prevent other parties from exploiting the same rights in the same territory and window.']
  grant_number varchar [note: 'Business identifier for the rights grant, typically a human-readable code used in Rightsline and operational workflows.']
  grant_status varchar [note: 'Current lifecycle status of the rights grant. Reflects whether the grant is currently in force, expired, or otherwise inactive.']
  holdback_applicable boolean [note: 'Indicates whether a holdback period applies to this grant. Holdbacks restrict exploitation during specific windows to protect other distribution channels.']
  holdback_end_date date [note: 'The end date of the holdback period, after which exploitation may resume. Nullable if no holdback applies.']
  holdback_start_date date [note: 'The start date of any holdback period during which exploitation is restricted. Nullable if no holdback applies.']
  language_version varchar [note: 'Language version of the content covered by this grant (e.g., English, Spanish, French). May reference dubbed, subtitled, or original language versions.']
  media_type varchar [note: 'The media format or delivery mechanism covered by this grant (e.g., television, film, digital streaming, audio).']
  minimum_guarantee_amount decimal(15,2) [note: 'Minimum guaranteed payment amount for this grant, regardless of actual revenue. Nullable if no MG applies.']
  modified_timestamp timestamp [note: 'Timestamp when this rights grant record was last modified.']
  music_sync_license_required boolean [note: 'Indicates whether a separate music synchronization license is required for the music tracks embedded in the content.']
  notes varchar [note: 'Free-text notes capturing additional terms, conditions, or operational instructions related to this grant.']
  right_type varchar [note: 'Type of distribution or exploitation right granted. Defines the platform or medium for which the content may be used. [ENUM-REF-CANDIDATE: broadcast|svod|avod|tvod|theatrical|home_video|music_sync|podcast|linear|non_linear|vod — 11 candidates stripped; promote to reference product]']
  royalty_rate_percent decimal(5,2) [note: 'Percentage royalty rate applied to revenue generated under this grant. Used for royalty calculations.']
  start_date date [note: 'The date on which the rights grant becomes effective and exploitation may begin.']
  sublicense_permitted boolean [note: 'Indicates whether the licensee is permitted to sublicense the rights to third parties.']
  talent_residuals_applicable boolean [note: 'Indicates whether talent residual payments (reuse payments to actors, directors, writers) are triggered by this grant.']
  window_name varchar [note: 'Named distribution window (e.g., Theatrical, Premium VOD, Pay-TV, Free-TV) that this grant falls within. Used for windowing strategy enforcement.']

  Note: 'Granular rights entitlement record derived from a license agreement. Each row represents a specific bundle of rights granted for a content asset — capturing right type (broadcast, SVOD, AVOD, TVOD, theatrical, home video, music sync, podcast), media type, territory or territory group, language version, exclusivity indicator, holdback applicability, and the grant period (start and end dates). Multiple grants can exist per agreement and per content asset. Feeds the availability engine in scheduling and distribution domains. Powered by Rightsline availabilities module.'
}

Table rights.content_window {
  content_window_id varchar [pk, note: 'Unique identifier for the content window record. Primary key for the rights content window entity.']
  grant_id varchar [note: 'Foreign key linking to rights.grant. Business justification: A rights_content_window defines the sequential release window strategy derived from a specific grant (the granular rights entitlement). While rights_content_window already links to license_agreement a']
  ott_platform_id varchar [note: 'Foreign key linking to distribution.ott_platform. Business justification: Content windows define platform-specific availability ("Hulu exclusive 45-day window"); direct platform FK required for platform availability APIs, automated clearance in release planning, and platfor']
  territory_id varchar [note: 'Foreign key linking to rights.territory. Business justification: Content windows apply to specific territories. Each window covers one territory. Normalizing to territory reference eliminates redundant territory string storage and enables consistent territory metad']
  active_flag boolean [note: 'Indicates whether this window record is currently active and should be considered in availability calculations. False if the window has been superseded, cancelled, or archived.']
  availability_status varchar [note: 'The computed net availability status of the content for this window, considering window dates, holdbacks, and blackouts. Refreshed whenever upstream rights or holdback records change. Directly consumed by scheduling and distribution domains to validate playout eligibility.']
  blackout_flag boolean [note: 'Indicates whether a geographic or temporal blackout restriction is currently active for this window. True if content is blacked out and cannot be distributed; false otherwise.']
  blackout_reason varchar [note: 'The business or regulatory reason for the blackout restriction (e.g., sports event local blackout, contractual exclusivity, regulatory compliance). Populated only when blackout_flag is true.']
  clearance_notes varchar [note: 'Free-text notes documenting clearance issues, pending approvals, conditional restrictions, or special instructions related to rights clearance for this window.']
  clearance_status varchar [note: 'The current status of the rights clearance workflow for this window. Indicates whether all necessary rights, music licenses, talent approvals, and regulatory clearances have been obtained to authorize distribution.']
  created_by_user varchar [note: 'The username or identifier of the user who created this window record. Audit field for accountability and compliance.']
  created_timestamp timestamp [note: 'The timestamp when this window record was first created in the system. Audit field for data lineage and compliance.']
  drm_requirement varchar [note: 'The DRM technology or protection scheme required for content distribution during this window. Enforces content protection and anti-piracy requirements specified in the rights agreement.']
  exclusivity_tier varchar [note: 'The level of exclusivity granted for this window. Exclusive windows prevent simultaneous distribution on competing platforms; non-exclusive allows parallel exploitation. First and second window designations indicate priority in the windowing hierarchy.']
  geo_blocking_required_flag boolean [note: 'Indicates whether geographic blocking technology must be enforced to restrict access to the specified territory. True if geo-blocking is mandatory; false if not required.']
  holdback_end_date date [note: 'The date when a holdback period ends and distribution is re-authorized. Marks the conclusion of the exclusivity restriction.']
  holdback_start_date date [note: 'The date when a holdback period begins, temporarily restricting distribution even within an open window. Used to enforce exclusivity periods and prevent simultaneous exploitation across competing platforms.']
  last_availability_refresh_timestamp timestamp [note: 'The timestamp when the availability_status was last recalculated. Updated whenever upstream rights, holdback, or blackout records change. Used to track data freshness for scheduling and distribution systems.']
  license_fee_amount decimal(18,2) [note: 'The monetary fee paid by the platform or distributor for the rights to exploit the content during this window. May be a flat fee, minimum guarantee, or advance against royalties.']
  license_fee_currency varchar [note: 'The three-letter ISO 4217 currency code for the license fee amount (e.g., USD, GBP, EUR).']
  minimum_guarantee_amount decimal(18,2) [note: 'The minimum guaranteed payment amount that the distributor or platform must pay regardless of actual revenue or usage. Common in SVOD and licensing deals.']
  modified_by_user varchar [note: 'The username or identifier of the user who last modified this window record. Audit field for accountability and compliance.']
  modified_timestamp timestamp [note: 'The timestamp when this window record was last modified. Audit field for change tracking and data lineage.']
  platform_scope varchar [note: 'The specific platform, channel, service, or outlet authorized for distribution during this window (e.g., Netflix, HBO Max, ABC Network, theatrical chain). May be a single platform or a platform group.']
  revenue_share_percent decimal(5,2) [note: 'The percentage of gross or net revenue that the rights holder receives from exploitation during this window. Common in TVOD, AVOD, and theatrical windows.']
  royalty_rate_percent decimal(5,2) [note: 'The percentage rate applied to revenue or usage to calculate royalty payments for this window. Used when the window operates under a revenue-sharing or usage-based royalty model.']
  sublicense_permitted_flag boolean [note: 'Indicates whether the platform or distributor is authorized to sublicense the content to third parties during this window. True if sublicensing is permitted; false if prohibited.']
  usage_cap_type varchar [note: 'The unit of measure for the usage cap (e.g., streams for SVOD, broadcasts for linear, screenings for theatrical). Defines how usage is counted against the cap.']
  usage_cap_units varchar [note: 'The maximum number of usage units (streams, downloads, broadcasts, screenings) permitted during this window. Used to enforce contractual usage limits.']
  window_close_date date [note: 'The date when this exploitation window ends and the content is no longer authorized for distribution on the specified platform. End of the availability period. Nullable for perpetual windows.']
  window_extension_count varchar [note: 'The number of times this window has been extended beyond its original close date. Tracks amendments and extensions to the original window terms.']
  window_open_date date [note: 'The date when this exploitation window becomes active and the content is authorized for distribution on the specified platform. Start of the availability period.']
  window_priority varchar [note: 'The numeric priority or sequence order of this window in the overall windowing strategy. Lower numbers indicate earlier windows in the release hierarchy (e.g., 1 for theatrical, 2 for PVOD, 3 for SVOD). Used to enforce windowing hierarchy rules.']
  window_type varchar [note: 'The exploitation window category defining the distribution model and platform type. Determines the sequential release strategy position in the windowing hierarchy. [ENUM-REF-CANDIDATE: theatrical|pvod|tvod|svod|avod|linear|fast|home_video|syndication|vod — 10 candidates stripped; promote to reference product]']

  Note: 'Defines the sequential release window strategy (windowing) for a specific content asset across exploitation platforms, and computes the net availability status. Each record captures the window type (theatrical, PVOD, TVOD, SVOD, AVOD, linear, FAST, home video, syndication), platform or channel scope, window open and close dates, holdback start and end dates, territory, exclusivity tier, and computed availability status (available, held-back, blacked-out, expired). Enforces the windowing hierarchy that prevents simultaneous exploitation across competing platforms. The net availability (considering holdbacks and blackouts) is refreshed whenever upstream rights or holdback records change. Directly consumed by scheduling and distribution domains to validate playout eligibility. Powered by Rightsline Windows module.'
}

Table rights.holdback {
  holdback_id varchar [pk, note: 'Unique identifier for the holdback restriction record. Primary key.']
  distribution_agreement_id varchar [note: 'Foreign key linking to partner.distribution_agreement. Business justification: Distribution agreements impose exclusivity-based holdbacks on competing platforms and channels. Rights enforcement teams must link holdbacks to the triggering distribution agreement to enforce blackou']
  grant_id varchar [note: 'Foreign key linking to rights.rights_grant. Business justification: Holdbacks restrict specific rights grants. Each holdback applies to one rights grant, establishing which exploitation rights are being restricted. This FK enables tracing holdback restrictions back to']
  ott_platform_id varchar [note: 'Foreign key linking to distribution.ott_platform. Business justification: Holdbacks frequently restrict specific platforms ("no Netflix for 90 days post-theatrical"); direct platform FK required for automated enforcement in clearance workflows, platform availability filteri']
  regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: Holdbacks are frequently mandated by regulatory obligations (e.g., FCC sports blackout rules, syndication exclusivity regulations). holdback.enforcement_status and automated_enforcement_flag require t']
  subscription_plan_id varchar [note: 'Foreign key linking to subscriber.subscription_plan. Business justification: Holdbacks restrict content from specific subscription tiers (e.g., content held back from basic tier during premium window). Linking holdback to subscription_plan enables tier-level holdback enforceme']
  sweeps_period_id varchar [note: 'Foreign key linking to audience.sweeps_period. Business justification: Sweeps holdback enforcement: holdbacks are frequently triggered or extended during sweeps periods to protect ratings by blocking competitor content. Rights operations teams need to identify holdbacks ']
  syndication_agreement_id varchar [note: 'Foreign key linking to partner.syndication_agreement. Business justification: Syndication agreements impose holdbacks on competing broadcast windows during exclusivity periods. Rights teams must reference the syndication agreement to enforce holdback_period_days, validate exclu']
  territory_id varchar [note: 'Foreign key linking to rights.territory. Business justification: Holdbacks apply to specific territories. Each holdback restricts one territory. Normalizing to territory reference eliminates redundant territory string storage and enables consistent territory metada']
  triggering_rights_content_window_id varchar [note: 'Foreign key linking to rights.rights_content_window. Business justification: holdback already has a triggering_window_type STRING attribute that captures the type of window that triggered the holdback (e.g., theatrical window triggers SVOD holdback). Adding triggering_rights_c']
  automated_enforcement_flag boolean [note: 'Indicates whether this holdback restriction is automatically enforced by scheduling and distribution systems or requires manual review.']
  carriage_negotiation_reference varchar [note: 'Reference identifier to the MVPD or vMVPD carriage negotiation that established this holdback restriction.']
  clearance_workflow_status varchar [note: 'Status of the clearance workflow process that validates whether content can be scheduled or distributed despite this holdback restriction.']
  code varchar [note: 'Business identifier code for the holdback restriction, used for external reference and clearance workflows.']
  conflict_resolution_notes varchar [note: 'Documentation of any conflicts with other rights, windows, or holdbacks and how they were resolved.']
  created_timestamp timestamp [note: 'Timestamp when this holdback restriction record was first created in the system.']
  duration_days varchar [note: 'Total number of days the holdback restriction is in effect, calculated from start to end date.']
  end_date date [note: 'Date when the holdback restriction expires and the content becomes available for exploitation on the previously restricted platform, territory, channel, or format.']
  enforcement_status varchar [note: 'Current enforcement state of the holdback restriction, indicating whether it is actively blocking content exploitation or has been modified.']
  exclusivity_scope varchar [note: 'Scope of exclusivity granted by this holdback, defining whether the restriction is absolute or allows limited exploitation.']
  last_modified_by varchar [note: 'User or system identifier that last modified this holdback restriction record.']
  last_modified_timestamp timestamp [note: 'Timestamp when this holdback restriction record was last updated or modified.']
  notification_sent_flag boolean [note: 'Indicates whether notification of this holdback restriction has been sent to relevant scheduling, distribution, and operations teams.']
  priority_level varchar [note: 'Business priority assigned to this holdback restriction, indicating its importance in windowing strategy and enforcement.']
  restricted_channel varchar [note: 'Specific broadcast or distribution channel that is restricted from airing or distributing the content during the holdback period.']
  restricted_format varchar [note: 'Distribution format or delivery method that is restricted during the holdback period, supporting windowing strategies. [ENUM-REF-CANDIDATE: theatrical|linear_tv|svod|avod|tvod|vod|physical_media|syndication|streaming|broadcast — 10 candidates stripped; promote to reference product]']
  restriction_type varchar [note: 'Classification of the holdback restriction type that defines the nature of the exclusivity period.']
  start_date date [note: 'Date when the holdback restriction becomes effective and the content is blocked from the specified platform, territory, channel, or format.']
  triggering_window_type varchar [note: 'Type of content window that triggers or activates this holdback restriction, defining the sequential release strategy. [ENUM-REF-CANDIDATE: theatrical|svod|avod|tvod|linear|syndication|home_video|pay_per_view|free_tv|premium_tv — 10 candidates stripped; promote to reference product]']
  waiver_approved_by varchar [note: 'Name or identifier of the person or role who authorized the waiver or override of the holdback restriction.']
  waiver_approved_date date [note: 'Date when the waiver or override of the holdback restriction was officially approved.']
  waiver_reason varchar [note: 'Business justification or explanation for waiving or overriding the holdback restriction, if applicable.']
  windowing_strategy_notes varchar [note: 'Additional notes or context explaining how this holdback fits into the overall content windowing and sequential release strategy.']
  created_by varchar [note: 'User or system identifier that created this holdback restriction record.']

  Note: 'Records exclusivity holdback restrictions that prevent a content asset from being exploited on a specific platform, territory, or channel during a defined period. Each holdback captures the restriction type (platform holdback, territory holdback, channel holdback, format holdback), the restricted platform or distributor, holdback start and end dates, the triggering window type and source window reference, the source license agreement, and enforcement status (active, expired, waived, overridden). Holdbacks are enforced by the clearance workflow before any scheduling or distribution action is approved. Critical for MVPD carriage negotiations, OTT windowing compliance, and theatrical-to-home-video sequencing. Links to rights_content_window and license_agreement.'
}

Table rights.territory {
  territory_id varchar [pk, note: 'Unique identifier for the geographic territory. Primary key.']
  broadcast_license_id varchar
  regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: Territory-level rights are governed by specific regulatory obligations (GDPR, COPPA, quota requirements, broadcast standards). rights_territory.regulatory_body is a denormalized string reference to th']
  blackout_restricted_flag boolean [note: 'Indicates whether the territory is subject to geographic blackout restrictions for certain content (e.g., sports events, theatrical windows). True if blackouts apply, False otherwise.']
  broadcast_standard varchar [note: 'Technical broadcast television standard used in the territory (e.g., ATSC for North America, DVB for Europe, ISDB for Japan). Determines encoding and transmission requirements for linear distribution. [ENUM-REF-CANDIDATE: atsc|dvb|isdb|dtmb|ntsc|pal|secam — 7 candidates stripped; promote to reference product]']
  code varchar [note: 'ISO 3166-1 alpha-2 or alpha-3 country code representing the territory (e.g., US, USA, GB, GBR). Standardized identifier used in rights grants and distribution agreements.']
  content_rating_system varchar [note: 'Official content classification and rating system used in the territory (e.g., TV-MA/TV-PG for USA, BBFC for UK, FSK for Germany). Governs age-appropriate content labeling and parental controls.']
  coppa_applicable_flag boolean [note: 'Indicates whether the territory is subject to COPPA regulations governing children\'s data privacy (USA). True if COPPA applies, False otherwise. Enforces parental consent for children\'s content and data collection.']
  created_timestamp timestamp [note: 'Timestamp when the territory record was first created in the system. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for the territory (e.g., USD, GBP, EUR, JPY). Used for royalty calculations, license fee invoicing, and revenue reporting.']
  effective_date date [note: 'Date when the territory record became active and available for rights grants and distribution agreements. Format: yyyy-MM-dd.']
  expiration_date date [note: 'Date when the territory record expires or is no longer valid for new rights grants (nullable for indefinite territories). Format: yyyy-MM-dd.']
  gdpr_applicable_flag boolean [note: 'Indicates whether the territory is subject to GDPR data privacy regulations (EU member states and EEA). True if GDPR applies, False otherwise. Governs audience data collection and consent management.']
  holdback_eligible_flag boolean [note: 'Indicates whether the territory is eligible for holdback periods in windowing strategies (e.g., delaying SVOD release to protect theatrical revenue). True if holdbacks apply, False otherwise.']
  internet_penetration_percent decimal(5,2) [note: 'Percentage of the population with internet access in the territory (e.g., 95.00 for USA, 60.00 for India). Used for OTT and streaming market opportunity assessment.']
  iso_alpha_2_code varchar [note: 'Two-letter ISO 3166-1 alpha-2 country code (e.g., US, GB, CA). Used for system integrations and data exchange with distribution platforms.']
  iso_alpha_3_code varchar [note: 'Three-letter ISO 3166-1 alpha-3 country code (e.g., USA, GBR, CAN). Provides additional clarity for territories with similar two-letter codes.']
  iso_numeric_code varchar [note: 'Three-digit ISO 3166-1 numeric country code (e.g., 840 for USA, 826 for GBR). Language-independent identifier for international systems.']
  language_primary varchar [note: 'ISO 639-1 or ISO 639-2 code for the primary language spoken in the territory (e.g., en for English, es for Spanish, fr for French). Used for metadata localization and subtitle requirements.']
  language_secondary varchar [note: 'ISO 639-1 or ISO 639-2 code for a secondary or co-official language in the territory (e.g., fr for Canada, ca for Spain). Supports multi-language content delivery and compliance.']
  name varchar [note: 'Full official name of the territory (e.g., United States, United Kingdom, Canada). Human-readable identifier used in contracts and reporting.']
  notes varchar [note: 'Free-text field for additional territory-specific information, special handling instructions, or regulatory nuances (e.g., \'Requires local dubbing for theatrical release\', \'Subject to military censorship\').']
  ott_market_maturity varchar [note: 'Classification of the territory\'s OTT streaming market maturity: mature (high penetration, competitive), developing (growing adoption), emerging (early stage), nascent (minimal infrastructure). Informs distribution strategy and rights pricing.']
  population varchar [note: 'Total population of the territory. Used for audience reach estimation, market sizing, and rights valuation.']
  quota_percentage decimal(5,2) [note: 'Minimum percentage of local or regional content required by regulation in the territory (e.g., 30.00 for EU, 0.00 for territories without quotas). Used for compliance reporting and content acquisition planning.']
  quota_requirement_flag boolean [note: 'Indicates whether the territory mandates local content quotas for broadcasters and streaming platforms (e.g., EU Audiovisual Media Services Directive requiring 30% European content). True if quotas apply, False otherwise.']
  rights_territory_status varchar [note: 'Current operational status of the territory in the rights management system: active (available for licensing), inactive (not currently used), restricted (subject to special clearance), pending (under review for activation).']
  territory_group varchar [note: 'Regional grouping of the territory used for rights aggregation and windowing strategies (e.g., EMEA, LATAM, North America, Worldwide, APAC). Enables multi-territory licensing and holdback management. [ENUM-REF-CANDIDATE: worldwide|north_america|latin_america|emea|apac|europe|asia|africa|middle_east|oceania — 10 candidates stripped; promote to reference product]']
  territory_type varchar [note: 'Classification of the territory scope: country (single nation), region (multi-country group), worldwide (global rights), or custom (bespoke territory definition).']
  time_zone varchar [note: 'IANA time zone identifier for the territory (e.g., America/New_York, Europe/London, Asia/Tokyo). Used for scheduling, playout, and live event coordination.']
  updated_timestamp timestamp [note: 'Timestamp when the territory record was last modified. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.']
  vat_applicable_flag boolean [note: 'Indicates whether Value-Added Tax (VAT) or Goods and Services Tax (GST) applies to transactions in the territory. True if VAT/GST applies, False otherwise. Used for royalty and subscription billing calculations.']
  vat_rate_percent decimal(5,2) [note: 'Standard VAT or GST rate percentage applicable in the territory (e.g., 20.00 for UK, 19.00 for Germany, 0.00 for territories without VAT). Used for financial reconciliation and revenue recognition.']
  withholding_tax_rate_percent decimal(5,2) [note: 'Standard withholding tax rate percentage applied to royalty payments to rights holders in the territory (e.g., 30.00 for USA non-resident aliens, 0.00 for domestic). Used for talent residuals and royalty calculations.']

  Note: 'Reference master for geographic territories and territory groups used in rights grants, holdbacks, and royalty calculations. Each record defines a territory by ISO country code, territory name, territory group (e.g., EMEA, LATAM, North America, Worldwide), broadcast regulatory body (FCC, Ofcom, etc.), currency, and whether the territory is subject to blackout restrictions. Provides the standardized territory taxonomy consumed by all rights, scheduling, and distribution products.'
}

Table rights.royalty_rule {
  royalty_rule_id varchar [pk, note: 'Unique identifier for the royalty calculation rule. Primary key.']
  grant_id varchar [note: 'Foreign key linking to rights.rights_grant. Business justification: Royalty rules may apply to specific rights grants. Each rule may apply to one rights grant, defining how royalties are calculated for that grant. This FK enables tracing royalty rules back to the spec']
  guild_affiliation_id varchar [note: 'Foreign key linking to talent.guild_affiliation. Business justification: Guild CBAs (SAG-AFTRA, WGA, DGA) directly dictate royalty calculation formulas and residual rates. Linking royalty_rule to the governing guild_affiliation enables CBA-compliant royalty computation, gu']
  license_agreement_id varchar [note: 'Reference to the parent license agreement or rights grant to which this royalty rule applies. Links this rule to the contract context in Rightsline.']
  regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: Royalty rules in broadcasting are mandated by regulatory obligations (SAG-AFTRA guild agreements, ASCAP/BMI statutory licensing, compulsory license rate schedules). royalty_rule.audit_rights_flag and ']
  subscription_plan_id varchar [note: 'Foreign key linking to subscriber.subscription_plan. Business justification: Royalty rates differ by subscription tier (AVOD vs. SVOD vs. premium). Linking royalty_rule to subscription_plan enables precise per-tier royalty calculation — a contractual requirement in streaming r']
  territory_id varchar [note: 'Foreign key linking to rights.rights_territory. Business justification: Royalty rates vary by territory per license agreements (UK 15%, US 20%, Canada 18%); direct territory FK required for automated royalty calculation engine, territory-based royalty reporting, and curre']
  approval_status varchar [note: 'Approval status of the royalty rule within the rights management workflow (e.g., pending, approved, rejected).']
  approved_by varchar [note: 'Name or identifier of the person or role who approved this royalty rule. Nullable if not yet approved.']
  approved_date date [note: 'Date on which this royalty rule was approved. Nullable if not yet approved.']
  audit_rights_flag boolean [note: 'Indicates whether the rights holder has audit rights to verify royalty calculations under this rule. True if audit rights are granted, False otherwise.']
  calculation_basis varchar [note: 'The financial or usage metric upon which the royalty calculation is based (e.g., gross revenue, net revenue, subscriber count, stream count, GRP). [ENUM-REF-CANDIDATE: gross_revenue|net_revenue|subscriber_count|stream_count|grp|unit_sales|advertising_revenue — 7 candidates stripped; promote to reference product]']
  content_type varchar [note: 'The type of content to which this royalty rule applies (e.g., film, series, episode, music, documentary, sports, news, short-form). [ENUM-REF-CANDIDATE: film|series|episode|music|documentary|sports|news|short_form — 8 candidates stripped; promote to reference product]']
  created_timestamp timestamp [note: 'Timestamp when this royalty rule record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for monetary amounts in this royalty rule (e.g., USD, GBP, EUR).']
  deduction_allowed_flag boolean [note: 'Indicates whether deductions (e.g., distribution costs, marketing expenses) are allowed before calculating the royalty. True if deductions are permitted, False otherwise.']
  deduction_percentage decimal(5,2) [note: 'The percentage of revenue or basis that may be deducted before applying the royalty rate. Nullable if no deduction applies.']
  effective_end_date date [note: 'The date on which this royalty rule ceases to be active. Nullable for open-ended rules.']
  effective_start_date date [note: 'The date from which this royalty rule becomes active and applicable to royalty calculations.']
  last_modified_timestamp timestamp [note: 'Timestamp when this royalty rule record was last updated or modified.']
  maximum_cap_amount decimal(18,2) [note: 'The maximum royalty payment cap for this rule. Royalty calculations will not exceed this amount. Nullable if no cap applies.']
  minimum_guarantee_amount decimal(18,2) [note: 'The minimum guaranteed royalty payment amount for this rule, regardless of calculated royalty. Nullable if no minimum guarantee applies.']
  notes varchar [note: 'Free-text notes or comments about this royalty rule, including special conditions, exceptions, or clarifications.']
  payment_frequency varchar [note: 'The frequency at which royalty payments calculated by this rule are made (e.g., monthly, quarterly, semi-annually, annually, per event, on demand).']
  payment_timing varchar [note: 'The timing of royalty payments relative to the calculation period (e.g., advance, arrears, upon delivery, upon release, milestone-based).']
  platform_type varchar [note: 'The distribution platform or exploitation type to which this royalty rule applies (e.g., SVOD, AVOD, TVOD, linear, theatrical, syndication). [ENUM-REF-CANDIDATE: svod|avod|tvod|linear|theatrical|syndication|vod|ott|fast — 9 candidates stripped; promote to reference product]']
  rate_unit varchar [note: 'The unit of measure for the rate value (e.g., percentage, per stream, per subscriber, per unit, per GRP, flat amount).']
  rate_value decimal(18,6) [note: 'The numeric rate or percentage applied in the royalty calculation. For percentage-based royalties, this is the percentage (e.g., 15.5 for 15.5%). For per-unit rates, this is the amount per unit.']
  recoupment_flag boolean [note: 'Indicates whether this royalty rule includes recoupment provisions (e.g., advance payments must be recouped before additional royalties are paid). True if recoupment applies, False otherwise.']
  recoupment_threshold decimal(18,2) [note: 'The monetary threshold that must be recouped before additional royalty payments are made. Nullable if no recoupment applies.']
  residual_formula varchar [note: 'The formula or calculation logic for residual payments to talent (actors, directors, writers) based on reuse, reruns, or secondary exploitation. Nullable if not applicable.']
  royalty_rule_status varchar [note: 'Current lifecycle status of the royalty rule (e.g., draft, active, suspended, expired, terminated).']
  royalty_type varchar [note: 'The type of royalty calculation method applied by this rule. Determines how the royalty amount is computed.']
  rule_code varchar [note: 'Business-assigned unique code or identifier for this royalty rule, used for reference in contracts and reporting.']
  rule_name varchar [note: 'Human-readable name or title of the royalty rule, describing its purpose or scope (e.g., \'SVOD Revenue Share - Tier 1\', \'Per-Stream Rate - Music Sync\').']
  rule_priority varchar [note: 'The priority or precedence of this royalty rule when multiple rules may apply to the same content or transaction. Lower numbers indicate higher priority.']
  threshold_unit varchar [note: 'The unit of measure for the threshold value (e.g., revenue, subscriber count, stream count, unit count, GRP).']
  threshold_value decimal(18,2) [note: 'The threshold value that triggers a rate tier change or special calculation logic (e.g., revenue threshold for tiered royalty rates).']

  Note: 'Defines the royalty calculation rules and rate structures associated with a license agreement or rights grant. Captures royalty type (flat fee, revenue share percentage, per-stream rate, per-unit rate, residual formula), calculation basis (gross revenue, net revenue, subscriber count, stream count, GRP), applicable platform or exploitation type, rate tiers and thresholds, minimum guarantee amounts, and effective date range. Serves as the configuration engine for the royalty calculation process in Rightsline. Distinct from actual royalty payment transactions.'
}

Table rights.royalty_statement {
  royalty_statement_id varchar [pk, note: 'Unique identifier for the royalty statement. Primary key.']
  acquisition_deal_id varchar [note: 'Foreign key linking to partner.acquisition_deal. Business justification: Royalty statements report exploitation of content acquired under specific acquisition deals. Finance teams reconcile statement gross royalties against deal MG amounts and recoupment thresholds — direc']
  billing_account_id varchar [note: 'Foreign key linking to billing.billing_account. Business justification: Royalty statements are financial obligations issued to rights holders with billing accounts. The royalty operations and AR teams need this link for payment processing, dunning, and outstanding balance']
  guild_affiliation_id varchar [note: 'Foreign key linking to talent.guild_affiliation. Business justification: Guild residual statements (SAG-AFTRA, WGA, DGA) require identification of the applicable guild for pension/health contribution calculations and CBA-mandated residual distribution. This is a direct reg']
  holder_id varchar [note: 'Identifier of the rights holder (licensor, talent guild, music publisher, or syndication partner) to whom this statement is issued. Links to the party receiving royalty payments.']
  license_agreement_id varchar [note: 'Identifier of the underlying rights agreement or contract that governs the royalty terms for this statement.']
  minimum_guarantee_id varchar [note: 'Foreign key linking to partner.minimum_guarantee. Business justification: Royalty statements directly drive MG recoupment calculations — each statement period\'s net royalties reduce the outstanding MG balance. Finance teams must link statements to the specific MG instrument']
  regulatory_filing_id varchar [note: 'Foreign key linking to compliance.regulatory_filing. Business justification: Royalty statements trigger GL postings for royalty expense accrual, payment processing, and advance recoupment. Required for month-end close, royalty expense recognition, and financial audit trail lin']
  regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: Royalty statements must satisfy specific regulatory obligations governing reporting frequency, documentation retention, and financial disclosure (e.g., guild residual reporting mandates, statutory lic']
  sweeps_period_id varchar [note: 'Foreign key linking to audience.sweeps_period. Business justification: Sweeps royalty reconciliation: royalty statements covering sweeps periods have distinct calculation bases and elevated exploitation values. Rights accountants need to identify sweeps-period statements']
  adjustment_amount decimal(18,2) [note: 'Net adjustment amount applied to this statement for corrections, credits, or debits from prior periods.']
  advance_recoupment_amount decimal(18,2) [note: 'Amount deducted from gross royalties to recoup advances previously paid to the rights holder under the agreement.']
  approved_by varchar [note: 'Name or identifier of the person or system that approved this royalty statement for payment.']
  approved_timestamp timestamp [note: 'Date and time when this royalty statement was approved for payment.']
  content_title_breakdown varchar [note: 'Structured breakdown of royalties by content title or asset. Stored as JSON or delimited string for detailed reporting.']
  created_timestamp timestamp [note: 'Date and time when this royalty statement record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code in which royalty amounts are denominated.']
  dispute_date date [note: 'The date on which the rights holder formally disputed this royalty statement.']
  dispute_reason varchar [note: 'Explanation or reason provided by the rights holder if the statement status is disputed. Captures objections to calculations, missing revenues, or contractual interpretation issues.']
  exchange_rate decimal(12,6) [note: 'Exchange rate applied to convert foreign currency revenues to the statement currency, if applicable. Rate is typically the average rate for the statement period.']
  exploitation_type_breakdown varchar [note: 'Structured breakdown of royalties by exploitation type (theatrical, SVOD, AVOD, TVOD, linear, syndication, home video, etc.). Stored as JSON or delimited string for detailed reporting.']
  gross_royalty_amount decimal(18,2) [note: 'Total royalty amount earned by the rights holder before any deductions, recoupments, or adjustments.']
  minimum_guarantee_shortfall decimal(18,2) [note: 'The difference between the contractual minimum guarantee and actual royalties earned for the period. A positive value indicates the rights holder is entitled to a minimum guarantee payment.']
  modified_timestamp timestamp [note: 'Date and time when this royalty statement record was last modified or updated.']
  net_royalty_amount decimal(18,2) [note: 'Final royalty amount payable to the rights holder after all deductions, recoupments, taxes, and adjustments. This is the amount that will be paid.']
  paid_timestamp timestamp [note: 'Date and time when payment for this royalty statement was successfully processed and remitted to the rights holder.']
  payment_method varchar [note: 'The payment instrument or method that will be used to remit the net royalty amount to the rights holder.']
  payment_reference_number varchar [note: 'Reference number or transaction identifier for the payment associated with this statement, once payment has been processed.']
  resolution_date date [note: 'The date on which a disputed statement was resolved and moved to approved or paid status.']
  statement_due_date date [note: 'The date by which payment of the royalties on this statement is contractually due to the rights holder.']
  statement_frequency varchar [note: 'The reporting frequency for this royalty statement as defined in the underlying rights agreement.']
  statement_issue_date date [note: 'The date on which this royalty statement was officially issued to the rights holder.']
  statement_notes varchar [note: 'Free-text notes or comments related to this royalty statement, including explanations of unusual adjustments, special circumstances, or clarifications for the rights holder.']
  statement_number varchar [note: 'Externally-known unique business identifier for this royalty statement, used for reference in correspondence and payment processing.']
  statement_period_end_date date [note: 'The last date of the reporting period covered by this royalty statement.']
  statement_period_start_date date [note: 'The first date of the reporting period covered by this royalty statement.']
  statement_status varchar [note: 'Current lifecycle status of the royalty statement. Draft statements are under review, approved statements are ready for payment, disputed statements have objections from rights holders, paid statements have been settled, and cancelled statements have been voided.']
  territory_breakdown varchar [note: 'Structured breakdown of royalties by geographic territory or market. Stored as JSON or delimited string for detailed reporting.']
  withholding_tax_amount decimal(18,2) [note: 'Tax amount withheld from royalty payment as required by applicable tax treaties and regulations.']

  Note: 'Periodic royalty statement generated for a rights holder (licensor, talent guild, music publisher, or syndication partner) covering a specific reporting period. Captures statement period (monthly, quarterly, semi-annual), total royalties due, breakdown by exploitation type and territory, advance recoupment amounts, minimum guarantee shortfall, currency, exchange rate applied, and statement status (draft, approved, disputed, paid). The SSOT for royalty obligations owed to external rights holders. Feeds the billing domain for payment processing.'
}

Table rights.royalty_statement_line {
  royalty_statement_line_id varchar [pk, note: 'Unique identifier for the royalty statement line item. Primary key for this entity.']
  ad_order_id varchar [note: 'Foreign key linking to sales.ad_order. Business justification: Royalty statement lines represent per-exploitation-event royalty calculations. Auditors and rights holders require traceability from each royalty line to the specific ad order that generated the comme']
  grant_id varchar [note: 'Foreign key linking to rights.grant. Business justification: royalty_statement_line represents a single exploitation event or aggregated exploitation period. Each exploitation event occurs under a specific grant (the granular rights entitlement that authorized ']
  holder_id varchar [note: 'Reference to the party (talent, studio, licensor) entitled to receive the royalty payment for this line. Links to the rights holder master data.']
  invoice_id varchar [note: 'Foreign key linking to billing.invoice. Business justification: Royalty statement lines represent content exploitation that triggers revenue recognition events when content is sublicensed. Required for ASC 606/IFRS 15 compliance for content licensing revenue and p']
  license_agreement_id varchar [note: 'Reference to the underlying rights agreement or contract that governs this royalty calculation. Links to the master rights contract data.']
  nielsen_rating_id varchar [note: 'Foreign key linking to audience.nielsen_rating. Business justification: Impression-based royalty calculation: rights accountants reconcile each royalty line item against the Nielsen audience measurement for that specific air date/episode to validate units_exploited and gr']
  role_id varchar [note: 'Foreign key linking to talent.role. Business justification: Guild CBA residual calculations depend on the specific role category performed (series regular, guest star, day player, stunt performer). Linking statement lines to roles enables accurate CBA-complian']
  royalty_rule_id varchar [note: 'Foreign key linking to rights.royalty_rule. Business justification: Statement lines are calculated using royalty rules. Each line uses one royalty rule that defines the calculation formula. This FK enables tracing royalty calculations back to the authoritative royalty']
  royalty_statement_id varchar [note: 'Reference to the parent royalty statement that contains this line item. Links this line to the header-level statement issued to a rights holder.']
  territory_id varchar [note: 'Foreign key linking to rights.territory. Business justification: Royalty statement lines track exploitation by territory. Each line relates to one territory. Normalizing to territory reference eliminates redundant territory code storage and enables consistent terri']
  title_id varchar [note: 'Foreign key linking to content.title. Business justification: Royalty statements are broken down by title for rights holder reporting and audit. content_title is a plain-text denormalization; replacing with title_id enforces referential integrity and enables tit']
  adjustments_amount decimal(18,2) [note: 'Additional adjustments applied to the royalty calculation, such as corrections from prior periods, contractual bonuses, penalties, or dispute resolutions. Can be positive or negative.']
  advance_recoupment_amount decimal(18,2) [note: 'Portion of the calculated royalty that is applied against outstanding advances previously paid to the rights holder. Reduces the net payable amount.']
  audit_trail_reference varchar [note: 'Reference identifier linking this royalty line to source exploitation data, usage reports, or billing records. Enables granular audit trail and dispute resolution.']
  calculated_royalty_amount decimal(18,2) [note: 'Royalty amount calculated by applying the royalty rate to the net revenue. Represents the gross royalty obligation before advance recoupment or adjustments.']
  created_timestamp timestamp [note: 'Timestamp when this royalty statement line record was first created in the system. Audit field for data lineage and compliance.']
  currency_code varchar [note: 'Three-letter ISO currency code for all monetary amounts on this line. All amounts (gross revenue, deductions, royalties, payable) are denominated in this currency.']
  deductions_amount decimal(18,2) [note: 'Total deductions applied to gross revenue before calculating royalty base. May include distribution fees, marketing costs, platform fees, or other contractually allowed deductions.']
  dispute_status varchar [note: 'Current status of any dispute or query raised by the rights holder regarding this royalty line. Tracks the resolution workflow for contested royalty calculations.']
  eidr_identifier varchar [note: 'Globally unique identifier for the content asset following EIDR standard format. Used for cross-industry content identification and rights tracking.']
  exploitation_period_end_date date [note: 'End date of the period during which the exploitation activity occurred. Defines the end of the reporting window for this royalty line.']
  exploitation_period_start_date date [note: 'Start date of the period during which the exploitation activity occurred. Defines the beginning of the reporting window for this royalty line.']
  exploitation_type varchar [note: 'Type of content exploitation that generated this royalty. Indicates the distribution channel or business model under which the content was used. [ENUM-REF-CANDIDATE: linear_broadcast|svod|avod|tvod|theatrical|syndication|home_video|digital_download — 8 candidates stripped; promote to reference product]']
  gross_revenue_amount decimal(18,2) [note: 'Total gross revenue generated from the exploitation activity before any deductions, adjustments, or royalty calculations. Represents the top-line revenue attributable to this content asset.']
  holdback_status varchar [note: 'Status of any holdback or exclusivity period applicable to this exploitation. Indicates whether the content was exploited within or outside of contractual holdback restrictions.']
  line_number varchar [note: 'Sequential line number within the royalty statement, used for ordering and reference purposes.']
  net_payable_amount decimal(18,2) [note: 'Final net amount payable to the rights holder for this line item after all deductions, advance recoupment, and adjustments. This is the amount that will be paid out.']
  net_revenue_amount decimal(18,2) [note: 'Net revenue after deductions, serving as the base for royalty calculation. Calculated as gross_revenue_amount minus deductions_amount.']
  notes varchar [note: 'Free-text notes or comments regarding this royalty line. May include explanations of adjustments, dispute details, or special calculation circumstances.']
  payment_date date [note: 'Date on which the royalty payment for this line was or will be disbursed to the rights holder. Null if payment has not yet been scheduled.']
  payment_status varchar [note: 'Current payment status for this royalty line item. Indicates whether the net payable amount has been processed for payment.']
  platform_name varchar [note: 'Name of the distribution platform or service where the content was exploited (e.g., Netflix, Hulu, linear network, theatrical chain).']
  residual_type varchar [note: 'Classification of residual payment type for talent royalties. Indicates the nature of the reuse payment under guild agreements (SAG-AFTRA, WGA, DGA). [ENUM-REF-CANDIDATE: initial_use|rerun|foreign|supplemental|new_media|streaming|not_applicable — 7 candidates stripped; promote to reference product]']
  rights_holder_name varchar [note: 'Name of the rights holder receiving the royalty. Denormalized for reporting and audit trail purposes.']
  royalty_rate_percentage decimal(5,2) [note: 'Percentage rate applied to the royalty base to calculate the royalty amount. Derived from the underlying rights agreement and may vary by territory, platform, and exploitation type.']
  unit_of_measure varchar [note: 'Unit type for the units_exploited field. Clarifies how exploitation volume is measured for this line.']
  units_exploited decimal(18,2) [note: 'Quantity of exploitation units for this line item. Interpretation depends on exploitation type: streams for SVOD/AVOD, broadcasts for linear, downloads for TVOD, tickets for theatrical.']
  updated_timestamp timestamp [note: 'Timestamp when this royalty statement line record was last modified. Audit field for tracking changes and dispute resolution history.']
  window_type varchar [note: 'Distribution window classification under which this exploitation occurred. Reflects the sequential release strategy and holdback periods defined in the rights agreement. [ENUM-REF-CANDIDATE: theatrical|home_video|pay_per_view|premium_cable|basic_cable|broadcast|svod|avod|free_streaming — 9 candidates stripped; promote to reference product]']

  Note: 'Line-item detail within a royalty statement, representing a single exploitation event or aggregated exploitation activity for a specific content asset, territory, platform, and period. Captures content asset reference, exploitation type, territory, platform, units exploited (streams, broadcasts, downloads), gross revenue, applicable royalty rate, calculated royalty amount, advance applied, and net payable. Enables granular royalty audit trails and dispute resolution at the asset and territory level.'
}

Table rights.clearance_request {
  clearance_request_id varchar [pk, note: 'Unique identifier for the rights clearance request. Primary key for the clearance request workflow record.']
  availability_window_id varchar [note: 'Reference to the specific rights window (theatrical, SVOD, AVOD, linear, etc.) being verified for availability. Links to windowing strategy definitions in Rightsline.']
  compliance_content_rating_id varchar [note: 'Foreign key linking to compliance.content_rating. Business justification: Clearance workflow validates content rating before approving distribution. Analysts check that requested platform/daypart matches rating restrictions (e.g., TV-14 content not cleared for daytime child']
  distribution_partner_id varchar [note: 'Foreign key linking to distribution.distribution_partner. Business justification: Clearance requests often partner-specific ("can we clear this title for Comcast carriage?"); direct partner FK required for partner-level clearance tracking, carriage negotiation support, and dispute ']
  grant_id varchar [note: 'Foreign key linking to rights.rights_grant. Business justification: Clearance requests validate against specific rights grants to determine if exploitation is permitted. Each clearance request checks one rights grant for authorization. This FK enables validation of ex']
  holdback_id varchar [note: 'Foreign key linking to rights.holdback. Business justification: Clearance requests may be blocked by specific holdbacks. Each clearance request may reference one blocking holdback that prevents exploitation. This FK enables tracing clearance denials back to the sp']
  ott_platform_id varchar [note: 'Foreign key linking to distribution.ott_platform. Business justification: Clearance requests for children\'s content must verify COPPA declaration status before approval. Ensures data collection and advertising practices comply with COPPA before content goes live.']
  regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: Clearance decisions are driven by specific regulatory obligations (music clearance mandates, talent residual rules, FCC content restrictions). clearance_request.music_clearance_required and residuals_']
  talent_profile_id varchar [note: 'Foreign key linking to talent.talent_profile. Business justification: Clearance requests may require music sync licenses. Each request may reference one music sync license that must be validated. This FK enables tracing clearance requirements back to the specific music ']
  territory_id varchar [note: 'Foreign key linking to rights.territory. Business justification: Clearance requests are for specific territories. Each request relates to one territory. Normalizing to territory reference eliminates redundant territory code storage and enables consistent territory ']
  version_id varchar [note: 'Foreign key linking to content.version. Business justification: Clearance requests are filed for specific content versions (e.g., dubbed, HD, edited-for-broadcast). Version-level clearance is a standard broadcasting workflow; without version_id, clearance records ']
  analyst_notes varchar [note: 'Free-text notes and observations recorded by the clearance analyst during review. May include references to specific contract clauses, communications with rights holders, or special handling instructions.']
  blocking_category varchar [note: 'Classification of the primary reason for clearance denial. Enables reporting on common rights obstacles and process improvement. [ENUM-REF-CANDIDATE: holdback_period|territory_restriction|window_unavailable|rights_expired|music_sync_missing|talent_approval_required|residuals_unpaid|clearance_incomplete — promote to reference product]']
  blocking_reason varchar [note: 'Detailed explanation of why a clearance request was blocked or denied. May reference specific contract clauses, holdback periods, territorial restrictions, or missing rights. Null if request is cleared.']
  clearance_decision varchar [note: 'Final determination made by the clearance analyst regarding whether the content may be exploited as requested. Approved with conditions may require specific usage restrictions or additional payments.']
  clearance_status varchar [note: 'Current state of the clearance request workflow. Tracks progression from submission through review to final disposition. Cleared status allows content to proceed to playout; blocked status prevents distribution. [ENUM-REF-CANDIDATE: pending|in_review|cleared|conditionally_cleared|blocked|escalated|expired|cancelled — 8 candidates stripped; promote to reference product]']
  conditional_requirements varchar [note: 'Specific conditions or restrictions that must be met for conditional clearance approval. May include required credits, usage limitations, geographic blackouts, or additional royalty payments.']
  created_timestamp timestamp [note: 'System timestamp when the clearance request record was first created in the database. Part of standard audit trail for data lineage and compliance.']
  escalation_reason varchar [note: 'Explanation of why the clearance request required escalation beyond standard analyst review. May reference contract ambiguity, conflicting rights claims, or high-value strategic decisions.']
  escalation_timestamp timestamp [note: 'Date and time when the clearance request was escalated to senior rights management or legal counsel due to complexity, ambiguity, or high business impact. Null if no escalation occurred.']
  estimated_audience_reach varchar [note: 'Projected number of unique viewers or households expected to access the content in the requested exploitation. Used for royalty calculations and rights holder reporting.']
  estimated_grp decimal(10,2) [note: 'Projected Gross Rating Point value for the scheduled broadcast or streaming event. GRP represents the sum of ratings achieved by the content and may trigger tiered royalty obligations.']
  estimated_residuals_amount decimal(15,2) [note: 'Projected total residual payments owed to talent if the clearance is approved and content is distributed. Used for financial planning and budget approval workflows.']
  exploitation_type varchar [note: 'The intended method of content distribution or monetization requiring clearance. Defines the rights window and licensing requirements that must be verified (e.g., SVOD - Subscription Video On Demand, AVOD - Advertising-Supported Video On Demand, TVOD - Transactional Video On Demand). [ENUM-REF-CANDIDATE: linear_broadcast|svod|avod|tvod|theatrical|syndication|vod|simulcast|fast|digital_download — 10 candidates stripped; promote to reference product]']
  integration_status varchar [note: 'Status of data synchronization between Rightsline clearance system and downstream scheduling and playout systems (Ericsson MediaFirst). Ensures cleared content is automatically released to scheduling workflows.']
  last_modified_timestamp timestamp [note: 'System timestamp of the most recent update to any field in the clearance request record. Enables change tracking and audit trail for compliance and operational monitoring.']
  music_clearance_required boolean [note: 'Indicates whether separate music synchronization licenses must be verified before content can be cleared for distribution. True if content contains licensed music requiring additional clearance.']
  platform_channel varchar [note: 'Specific platform, channel, or outlet where the content is intended to be distributed (e.g., HBO Max, NBC Network, YouTube, Hulu). Used to verify platform-specific licensing restrictions.']
  priority_level varchar [note: 'Business priority assigned to the clearance request based on scheduling urgency, revenue impact, or strategic importance. Urgent requests require expedited review to avoid schedule disruption.']
  request_number varchar [note: 'Human-readable business identifier for the clearance request, typically formatted as CLR-YYYYMMDD sequence for tracking and reference in scheduling and distribution workflows.']
  request_submitted_timestamp timestamp [note: 'Date and time when the clearance request was initially submitted into the workflow system. Marks the start of the clearance review lifecycle and SLA clock.']
  requested_air_date date [note: 'The target date when the content is scheduled to be broadcast, streamed, or published. Critical for verifying that rights are available within the requested window and that no holdback periods are violated.']
  requested_air_time timestamp [note: 'Precise timestamp for the intended broadcast or streaming start time, including time zone. Used for daypart-specific rights verification and scheduling coordination.']
  requesting_department varchar [note: 'Business unit or department initiating the clearance request. Identifies which operational area needs rights verification before proceeding with content exploitation.']
  residuals_triggered boolean [note: 'Indicates whether the requested exploitation will trigger residual payments to talent per guild agreements. True if reuse payments are required for this distribution window.']
  resolution_timestamp timestamp [note: 'Date and time when the clearance request was finalized with a cleared, blocked, or conditionally cleared decision. Marks the end of the clearance workflow and enables SLA compliance measurement.']
  review_started_timestamp timestamp [note: 'Date and time when a clearance analyst began active review of the request. Used to measure queue time and analyst response performance.']
  sla_met boolean [note: 'Indicates whether the clearance request was resolved within the defined SLA target hours. Used for operational performance reporting and process improvement.']
  sla_target_hours varchar [note: 'Number of business hours within which the clearance request must be resolved per service level agreement. Varies by priority level (urgent requests have shorter SLA targets).']
  talent_approval_required boolean [note: 'Indicates whether talent (actors, directors, producers) approval or notification is contractually required before the requested exploitation. True if talent has approval rights per guild agreements or individual contracts.']

  Note: 'Workflow record capturing a rights clearance request initiated before a content asset is scheduled for broadcast, streaming, or distribution. Tracks the requesting department (scheduling, distribution, production), content asset, intended exploitation type and platform, requested air or publish date, territory, clearance status (pending, cleared, conditionally cleared, blocked, escalated), blocking reason if applicable, assigned clearance analyst, and resolution date. Enforces the clearance gate that prevents unlicensed content from reaching playout or distribution systems. Integrates with Ericsson MediaFirst scheduling and Rightsline availabilities.'
}

Table rights.availability_window {
  availability_window_id varchar [pk, note: 'Unique identifier for the computed rights availability window record. Primary key.']
  accessibility_obligation_id varchar [note: 'Foreign key linking to compliance.accessibility_obligation. Business justification: Availability windows must comply with accessibility obligations (captioning, audio description, video description) per platform and content type. Links distribution windows to the specific accessibili']
  content_window_id varchar [note: 'Foreign key linking to rights.rights_content_window. Business justification: rights_availability_window is the computed net exploitable window derived from the windowing strategy defined in rights_content_window. The availability window is the output of applying holdback, terr']
  distribution_agreement_id varchar [note: 'Foreign key linking to partner.distribution_agreement. Business justification: Distribution availability windows are governed by distribution agreement terms (VOD windows, streaming rights, carriage terms). Distribution operations teams must verify availability windows against t']
  grant_id varchar [note: 'Reference to the source rights grant record from which this availability window is derived. Links to the upstream rights grant agreement.']
  holdback_id varchar [note: 'Foreign key linking to rights.holdback. Business justification: rights_availability_window is the computed net exploitable window. Holdback records directly constrain availability by imposing exclusivity restrictions on specific platforms, channels, and formats. r']
  license_agreement_id varchar [note: 'Foreign key linking to rights.license_agreement. Business justification: Availability windows derive from license agreements. Each computed availability window traces back to one license agreement that defines the underlying rights. This FK enables tracing availability bac']
  subscription_plan_id varchar [note: 'Foreign key linking to subscriber.subscription_plan. Business justification: Rights availability windows define platform_type scope; subscription plans define the service tier on that platform. Linking availability windows to subscription plans enables tier-specific rights enf']
  sweeps_period_id varchar [note: 'Foreign key linking to audience.sweeps_period. Business justification: Availability window planning: rights availability windows are operationally scheduled around sweeps periods for premium content. rights_availability_window is the scheduling artifact (distinct from ri']
  territory_id varchar [note: 'Foreign key linking to rights.territory. Business justification: Availability windows apply to specific territories. Each window covers one territory. Normalizing to territory reference eliminates redundant territory code storage and enables consistent territory me']
  advertising_allowed boolean [note: 'Indicates whether advertising insertion (pre-roll, mid-roll, post-roll) is permitted during content playback for this availability window. True = ads allowed, False = ad-free distribution only.']
  availability_end_date date [note: 'The date when the content asset is no longer available for exploitation on the specified platform and territory. Represents the end of the net exploitable window. Nullable for perpetual rights.']
  availability_start_date date [note: 'The date when the content asset becomes available for exploitation on the specified platform and territory. Represents the beginning of the net exploitable window.']
  blackout_indicator boolean [note: 'Indicates whether a geographic broadcast restriction (blackout) applies to this availability window. True = blackout in effect, False = no blackout restriction.']
  carriage_fee_applicable boolean [note: 'Indicates whether a carriage fee (distribution payment to the content provider) applies to this availability window. True = carriage fee required, False = no carriage fee.']
  clearance_status varchar [note: 'Rights verification status indicating whether all necessary clearances (music synchronization, talent, third-party IP) have been obtained for broadcast. Cleared = all rights verified, Pending = clearance in progress, Blocked = clearance denied, Conditional = clearance with restrictions.']
  computed_timestamp timestamp [note: 'The timestamp when this availability window record was computed from the intersection of upstream rights grants, holdbacks, and content windows. Represents the calculation execution time.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for financial amounts associated with this availability window (royalties, minimum guarantees). Defines the monetary unit for rights payments.']
  dai_enabled boolean [note: 'Indicates whether Dynamic Ad Insertion technology is enabled for this availability window, allowing server-side ad stitching into the content stream. True = DAI enabled, False = DAI not permitted.']
  download_to_own_allowed boolean [note: 'Indicates whether permanent download (download-to-own, DTO) is permitted during this availability window. True = DTO allowed, False = streaming-only distribution.']
  drm_requirement varchar [note: 'The level of Digital Rights Management protection required for this availability window. None = no DRM, Basic = minimal protection, Standard = industry-standard encryption, Premium = highest security level.']
  effective_timestamp timestamp [note: 'The timestamp when this availability window record became effective and actionable for scheduling and distribution systems. May differ from computed_timestamp if there is a delay before activation.']
  exclusivity_flag boolean [note: 'Indicates whether this availability window grants exclusive distribution rights on the specified platform and territory. True = exclusive rights, False = non-exclusive rights.']
  expiration_notification_sent boolean [note: 'Indicates whether an expiration notification has been sent to scheduling and distribution systems alerting them that this availability window is approaching its end date. True = notification sent, False = not yet notified.']
  holdback_period_days varchar [note: 'The number of days representing the holdback exclusivity period during which the content cannot be exploited on other platforms. Used to enforce windowing strategies.']
  language_code varchar [note: 'Two-letter ISO 639-1 language code representing the primary language for which this availability window is licensed. Defines the audio/subtitle language requirement.']
  last_verified_timestamp timestamp [note: 'The timestamp when this availability window was last verified against upstream rights and clearance records. Used for audit and compliance tracking.']
  max_resolution varchar [note: 'The maximum video resolution permitted for distribution during this availability window. SD = Standard Definition (480p), HD = High Definition (720p), FHD = Full HD (1080p), UHD = Ultra HD (2160p), 4K = 4K resolution, 8K = 8K resolution.']
  minimum_guarantee_amount decimal(15,2) [note: 'The minimum guaranteed payment amount owed to the rights holder for this availability window, regardless of actual revenue performance. Expressed in the contract currency.']
  notes varchar [note: 'Free-text field for additional notes, exceptions, or special conditions related to this availability window. Used for documenting non-standard terms or manual overrides.']
  offline_viewing_allowed boolean [note: 'Indicates whether temporary offline viewing (download for offline playback with expiration) is permitted during this availability window. True = offline viewing allowed, False = online streaming only.']
  platform_type varchar [note: 'The distribution platform type for which this availability window applies. SVOD = Subscription Video On Demand, AVOD = Advertising-Supported Video On Demand, TVOD = Transactional Video On Demand, linear = traditional scheduled broadcasting, FAST = Free Ad-Supported Streaming Television, MVPD = Multichannel Video Programming Distributor.']
  royalty_rate_percent decimal(5,2) [note: 'The percentage royalty rate applicable to revenue generated during this availability window. Used for royalty calculations and residuals payments to rights holders and talent.']
  simulcast_allowed boolean [note: 'Indicates whether simultaneous multi-platform broadcast (simulcast) is permitted during this availability window. True = simulcast allowed, False = platform-exclusive distribution only.']
  streaming_protocol varchar [note: 'The technical streaming protocol authorized for content delivery during this availability window. HLS = HTTP Live Streaming, MPEG-DASH = Dynamic Adaptive Streaming over HTTP, RTMP = Real-Time Messaging Protocol, smooth = Microsoft Smooth Streaming, progressive = progressive download.']
  subtitle_requirement varchar [note: 'Indicates the subtitle or closed captioning requirement for this availability window. None = no subtitles required, Optional = subtitles available but not mandatory, Mandatory = subtitles must be provided, Closed_caption = closed captioning required for accessibility compliance.']
  syndication_allowed boolean [note: 'Indicates whether the content can be syndicated (resold to multiple outlets) during this availability window. True = syndication permitted, False = syndication prohibited.']
  window_status varchar [note: 'Current lifecycle status of the availability window. Active = currently exploitable, Pending = future window not yet started, Expired = window has ended, Suspended = temporarily unavailable, Revoked = rights withdrawn, Extended = window duration increased.']

  Note: 'Computed availability record representing the net exploitable window for a content asset on a specific platform and territory, derived from the intersection of rights grants, holdbacks, and content windows. Captures asset reference, platform type (SVOD, AVOD, TVOD, linear, FAST, MVPD), territory, availability start and end dates, exclusivity flag, blackout indicator, and the source rights grant and window records. This is the actionable availability feed consumed by scheduling and distribution domains to determine what can be programmed or published. Refreshed whenever upstream rights or window records change.'
}

Table rights.holder {
  holder_id varchar [pk, note: 'Unique identifier for the rights holder entity. Primary key for the rights holder master record.']
  billing_account_id varchar [note: 'Foreign key linking to billing.billing_account. Business justification: Rights holders (studios, guilds, talent) have billing accounts for receiving royalty payments. Finance teams need this link to route royalty disbursements, manage credit limits, and perform AR reconci']
  partner_id varchar [note: 'Foreign key reference to partner entity']
  regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: Rights holders are subject to regulatory obligations such as foreign ownership restrictions, guild affiliation reporting requirements, and tax withholding mandates. holder.guild_affiliation, tax_withh']
  talent_profile_id varchar [note: 'Foreign key linking to talent.talent_profile. Business justification: In media broadcasting, talent (actors, writers, directors) frequently hold rights to their performances and creative works. Linking rights holder to talent_profile enables unified royalty-plus-residua']
  audit_rights_flag boolean [note: 'Indicates whether this rights holder has contractual audit rights to review revenue reporting and royalty calculations. True requires enhanced documentation retention.']
  bank_account_name varchar [note: 'Name on the bank account designated for royalty payments. Must match legal entity name for payment processing compliance.']
  bank_account_number varchar [note: 'Bank account number for royalty payment remittance. Encrypted at rest and in transit per PCI DSS requirements.']
  bank_routing_number varchar [note: 'Bank routing number or SWIFT/BIC code for international wire transfers. Used for automated royalty payment processing.']
  clearance_priority_level varchar [note: 'Priority level assigned to clearance requests for content from this rights holder. VIP and critical levels receive accelerated processing.']
  created_timestamp timestamp [note: 'Timestamp when this rights holder record was first created in the system. Used for audit trail and data lineage tracking.']
  credit_limit_amount decimal(15,2) [note: 'Maximum credit exposure allowed for advance payments or minimum guarantees to this rights holder. Used for financial risk management.']
  default_royalty_rate decimal(5,2) [note: 'Default royalty rate percentage applied to new agreements with this rights holder. Can be overridden at the contract level.']
  entity_type varchar [note: 'Classification of the rights holder by organizational type. Determines applicable contract templates, royalty calculation methods, and clearance workflows. [ENUM-REF-CANDIDATE: film_studio|production_company|music_publisher|performing_rights_organization|talent_guild|record_label|news_agency|individual_creator — 8 candidates stripped; promote to reference product]']
  exclusivity_preference varchar [note: 'Rights holder\'s stated preference for exclusivity terms in licensing agreements. Influences windowing strategy and holdback negotiations.']
  guild_affiliation varchar [note: 'Name of talent guild or performing rights organization (PRO) that this rights holder is affiliated with. Determines residual payment rules and reporting requirements. [ENUM-REF-CANDIDATE: sag_aftra|wga|dga|afm|ascap|bmi|sesac|gema|prs|socan — promote to reference product]']
  last_modified_by varchar [note: 'User identifier of the person who last modified this rights holder record. Used for audit trail and change accountability.']
  last_modified_timestamp timestamp [note: 'Timestamp when this rights holder record was last updated. Used for change tracking and data synchronization.']
  minimum_guarantee_threshold decimal(15,2) [note: 'Minimum guarantee amount threshold below which this rights holder will not enter licensing agreements. Used for deal structuring and negotiation.']
  most_favored_nations_flag boolean [note: 'Indicates whether this rights holder has most favored nations clause requiring rate parity with other similar rights holders. True triggers rate comparison workflows.']
  notes varchar [note: 'Free-text notes capturing special handling instructions, negotiation history, relationship nuances, or other contextual information for this rights holder.']
  payment_method varchar [note: 'Preferred payment method for royalty disbursements. Determines processing fees and settlement timelines.']
  payment_terms_days varchar [note: 'Standard payment terms in days from invoice date for royalty payments to this rights holder. Typical values include 30, 60, or 90 days net.']
  preferred_currency varchar [note: 'Three-letter ISO currency code representing the rights holder\'s preferred currency for royalty payments and contract valuations.']
  primary_contact_email varchar [note: 'Primary email address for the rights holder contact. Used for contract notifications, clearance communications, and royalty statements.']
  primary_contact_name varchar [note: 'Full name of the primary business contact at the rights holder organization for licensing negotiations, clearance requests, and royalty inquiries.']
  primary_contact_phone varchar [note: 'Primary telephone number for the rights holder contact. Used for urgent clearance issues and contract negotiations.']
  registrant_identifier varchar [note: 'The ISAN or ISRC registrant identifier assigned to the rights holder by the respective international registration authority. Used for global rights tracking and content identification.']
  relationship_end_date date [note: 'Date when the business relationship with this rights holder was terminated or suspended. Null for active relationships.']
  relationship_start_date date [note: 'Date when the business relationship with this rights holder was established. Used for historical reporting and relationship tenure analysis.']
  rights_holder_code varchar [note: 'Internal business identifier code assigned to the rights holder for operational reference and system integration across Rightsline and billing systems.']
  rights_holder_name varchar [note: 'The full legal name of the rights holder entity as registered in their territory of incorporation. Used for contract execution and royalty payment identification.']
  rights_holder_status varchar [note: 'Current lifecycle status of the rights holder relationship. Active status is required for new license agreements and royalty payments.']
  royalty_calculation_method varchar [note: 'Standard royalty calculation methodology applied to this rights holder\'s agreements. Determines how residuals and royalties are computed.']
  tax_identification_number varchar [note: 'Tax identification number for the rights holder in their jurisdiction of incorporation. Required for tax reporting and withholding compliance.']
  tax_withholding_classification varchar [note: 'Tax withholding classification for royalty payments. Determines applicable withholding rates based on tax treaties and domestic regulations.']
  tax_withholding_rate decimal(5,2) [note: 'Applicable tax withholding rate percentage for royalty payments to this rights holder. Derived from tax treaties and domestic law based on withholding classification.']
  territory_of_incorporation varchar [note: 'Three-letter ISO country code representing the legal jurisdiction where the rights holder entity is incorporated or registered. Determines applicable tax treaties and withholding requirements.']
  created_by varchar [note: 'User identifier of the person who created this rights holder record. Used for audit trail and accountability.']

  Note: 'Master record for all external entities that hold intellectual property rights licensed to or from Media Broadcasting — including film studios, independent production companies, music publishers, performing rights organizations (PROs), talent guilds, record labels, news agencies, and individual creators. Captures rights holder name, entity type, ISAN or ISRC registrant identifier, primary contact, territory of incorporation, preferred currency, payment terms, and tax withholding classification. This is the SSOT for rights grantor and grantee identity within the rights domain, distinct from the partner domain which manages broader commercial relationships.'
}

Table subscriber.subscriber {
  subscriber_id varchar [pk, note: 'Unique identifier for the subscriber. Primary key for the subscriber master record across all service tiers (SVOD, AVOD, TVOD, bundled). System-generated surrogate key independent of household or device.']
  audience_profile_id varchar [note: 'Foreign key linking to audience.audience_profile. Business justification: Links subscribers to Nielsen panel profiles and ACR measurement identities. Required for cross-platform audience measurement, ratings attribution, and MRC-accredited viewership reporting. Standard pra']
  billing_account_id varchar [note: 'add column billing_billing_account_id (BIGINT) with FK to billing.billing_account.billing_account_id - subscribers must link directly to their billing account for subscription management']
  household_id varchar [note: 'Foreign key linking subscriber to their household group. Multiple subscribers may share a household for family plans and concurrent stream management.']
  territory_id varchar [note: 'Foreign key linking to rights.rights_territory. Business justification: Determining which rights territory a subscriber falls under is fundamental to content access decisions, blackout enforcement, and geo-restriction compliance. Rights operations teams require subscriber']
  account_status varchar [note: 'Current lifecycle status of the subscriber account. Determines access entitlements and billing state. Active subscribers have full access; suspended accounts are temporarily blocked; cancelled accounts are terminated; trial accounts are in promotional period; churned accounts have completed cancellation.']
  adobe_profile_reference varchar [note: 'External identifier linking this subscriber to their unified profile in Adobe Experience Platform. Used for personalization, segmentation, and journey orchestration.']
  arpu decimal(10,2) [note: 'Average monthly revenue generated by this subscriber across all revenue streams (subscription, transactional, advertising). Key metric for subscriber value assessment and segmentation.']
  billing_cycle varchar [note: 'Frequency of subscription billing. Monthly, quarterly, and annual are recurring; lifetime is one-time payment; pay-per-view is transactional.']
  ccpa_opt_out_flag boolean [note: 'Indicates whether California subscriber has opted out of personal data sale. Required for CCPA compliance.']
  ccpa_opt_out_timestamp timestamp [note: 'Date and time when CCPA opt-out was recorded. Required for audit trail and compliance reporting.']
  churn_risk_score decimal(5,4) [note: 'Predictive score (0.0000 to 1.0000) indicating likelihood of subscriber cancellation within next billing cycle. Generated by machine learning model based on engagement, payment history, and behavioral signals.']
  coppa_compliant_flag boolean [note: 'Indicates whether this subscriber account is subject to COPPA restrictions (under 13 years old). When true, data collection and advertising are restricted.']
  country_code varchar [note: 'Three-letter ISO country code representing subscriber\'s primary geographic location. Used for content rights windowing, regional pricing, and regulatory compliance.']
  created_timestamp timestamp [note: 'System timestamp when this subscriber record was first created in the data platform. Used for audit trail and data lineage.']
  date_of_birth date [note: 'Subscriber\'s date of birth. Used for age verification, parental controls, COPPA compliance, and demographic segmentation.']
  email_address varchar [note: 'Primary email address for subscriber communication, authentication, and personalization. Used as primary contact channel and login credential.']
  external_reference_code varchar [note: 'External business identifier for the subscriber, typically used for integration with Zuora billing and Adobe Experience Platform. May be customer-facing account number or external system key.']
  first_name varchar [note: 'Subscriber\'s given name as provided during registration. Used for personalization and customer service interactions.']
  gdpr_consent_flag boolean [note: 'Indicates whether subscriber has provided explicit consent for data processing under GDPR. Required for EU subscribers.']
  gdpr_consent_timestamp timestamp [note: 'Date and time when GDPR consent was obtained. Required for audit trail and consent management.']
  gender varchar [note: 'Subscriber\'s self-identified gender. Used for demographic analytics and content personalization. Optional field respecting subscriber privacy preferences.']
  last_login_timestamp timestamp [note: 'Date and time of subscriber\'s most recent authentication. Used for engagement tracking and churn prediction.']
  last_name varchar [note: 'Subscriber\'s family name as provided during registration. Used for personalization and customer service interactions.']
  last_viewing_timestamp timestamp [note: 'Date and time of subscriber\'s most recent content viewing session. Used for engagement analysis and retention modeling.']
  ltv decimal(12,2) [note: 'Predicted total revenue this subscriber will generate over their entire relationship with the service. Used for acquisition cost justification and retention prioritization.']
  marketing_opt_in boolean [note: 'Indicates whether subscriber has consented to receive marketing communications. Required for GDPR and CCPA compliance.']
  max_concurrent_streams varchar [note: 'Maximum number of simultaneous video streams allowed for this subscriber based on their service tier. Enforced by playout and CDN systems.']
  max_registered_devices varchar [note: 'Maximum number of devices that can be registered to this subscriber account. Used for device management and anti-piracy enforcement.']
  parental_control_enabled boolean [note: 'Indicates whether parental controls are active on this subscriber account. When true, content access is restricted based on rating thresholds and PIN protection.']
  parental_control_pin varchar [note: 'Encrypted PIN code required to access age-restricted content when parental controls are enabled. Stored in hashed format for security.']
  phone_number varchar [note: 'Primary contact phone number for subscriber support and account recovery. May be used for two-factor authentication.']
  postal_code varchar [note: 'Subscriber\'s postal or ZIP code. Used for geographic segmentation, local content recommendations, and blackout enforcement.']
  preferred_language varchar [note: 'Two-letter ISO language code representing subscriber\'s preferred interface and content language. Used for UI localization and content recommendations.']
  registration_source varchar [note: 'Channel through which the subscriber originally registered. Used for acquisition analytics and channel effectiveness measurement.']
  registration_timestamp timestamp [note: 'Date and time when the subscriber account was first created. Used for cohort analysis, LTV calculation, and subscriber lifecycle tracking.']
  service_tier varchar [note: 'Current subscription service tier. SVOD (Subscription Video On Demand) includes basic and premium tiers; AVOD (Advertising-Supported Video On Demand) is free with ads; TVOD (Transactional Video On Demand) is pay-per-view; bundle includes multiple services.']
  subscription_end_date date [note: 'Date when the current subscription is scheduled to end or renew. Null for active recurring subscriptions. Used for churn prediction and retention campaigns.']
  subscription_start_date date [note: 'Date when the current subscription tier became effective. Used for billing cycle calculation and tenure analysis.']
  total_viewing_hours decimal(12,2) [note: 'Cumulative hours of content viewed by this subscriber since registration. Key engagement metric for LTV calculation and content recommendation.']
  updated_timestamp timestamp [note: 'System timestamp when this subscriber record was last modified. Used for change tracking and incremental processing.']
  zuora_account_reference varchar [note: 'External identifier linking this subscriber to their billing account in Zuora subscription management system. Used for payment processing and revenue recognition integration.']

  Note: 'Master identity record for every subscriber across SVOD, AVOD, TVOD, and bundled service tiers. Serves as the SSOT for subscriber identity, capturing registration source, registration timestamp, account status, service tier, demographic attributes, ARPU, LTV, churn risk score, GDPR/CCPA/COPPA consent flags, and integration keys to Zuora (billing) and Adobe Experience Platform (personalization). Each subscriber has a unique identity independent of household or device.'
}

Table subscriber.household {
  household_id varchar [pk, note: 'Unique identifier for the household grouping. Primary key for the household entity.']
  billing_account_id varchar [note: 'Foreign key linking to billing.billing_account. Business justification: In MVPD/OTT operations, the household is the primary billing unit for family and shared-plan accounts. Household-level dunning, invoice delivery, and account status management require a direct househo']
  demographic_segment_id varchar [note: 'Foreign key linking to audience.demographic_segment. Business justification: Household-level demographic classification drives Nielsen HUT (Households Using Television) measurement and audience composition reporting. Broadcasters must classify households into demographic segme']
  distribution_agreement_id varchar [note: 'Foreign key linking to partner.distribution_agreement. Business justification: Households served through MVPD/cable partners are governed by distribution agreements defining service delivery, content access, and billing terms. Partner subscriber counts, carriage fee calculations']
  max_content_rating_id varchar [note: 'Foreign key linking to content.rating. Business justification: Household-level content rating ceiling is a standard parental control enforcement mechanism in broadcasting. household.max_content_rating is a denormalized plain-text field; a FK to content.rating ena']
  territory_id varchar [note: 'Foreign key linking to rights.rights_territory. Business justification: In MVPD/cable contexts, blackout enforcement and geo-rights restrictions operate at the household level. Linking household to rights_territory enables household-level rights territory assignment for b']
  account_created_date date [note: 'Date when the household account was first created in the system. Used for tenure analysis and customer lifetime value (LTV) calculations.']
  address_line_1 varchar [note: 'Primary street address line for the household\'s service location. Used for geographic market assignment and service delivery.']
  address_line_2 varchar [note: 'Secondary address line for apartment, suite, or unit number. Optional field for additional address detail.']
  auto_renew_enabled boolean [note: 'Indicates whether the household subscription automatically renews at the end of each billing period. When false, subscription expires unless manually renewed.']
  average_revenue_per_user decimal(10,2) [note: 'Average monthly revenue generated by this household, calculated as total revenue divided by number of active months. Key metric for household value assessment.']
  billing_cycle_day varchar [note: 'Day of the month when the household\'s recurring subscription charge is processed. Typically set at initial subscription and remains consistent.']
  churn_risk_score decimal(5,2) [note: 'Predictive score (0.00 to 100.00) indicating the likelihood of this household cancelling their subscription in the next billing period. Generated by machine learning models based on engagement and payment patterns.']
  city varchar [note: 'City or municipality where the household is located. Used for geographic segmentation and local content availability.']
  country_code varchar [note: 'Three-letter ISO 3166-1 alpha-3 country code for the household location. Determines applicable content rights, pricing, and regulatory requirements.']
  created_timestamp timestamp [note: 'Timestamp when this household record was first created in the data platform. Used for data lineage and audit purposes.']
  data_sharing_consent boolean [note: 'Indicates whether the household has consented to sharing their viewing data with third parties for analytics and advertising purposes. Required for privacy compliance.']
  dma_code varchar [note: 'Nielsen Designated Market Area code identifying the geographic television market for this household. Used for local content availability, blackout enforcement, and advertising targeting.']
  household_status varchar [note: 'Current lifecycle status of the household account. Determines access rights and billing state.']
  household_type varchar [note: 'Classification of the household based on its composition and purpose. Determines applicable service tier rules and entitlement models.']
  language_preference varchar [note: 'Two-letter ISO 639-1 language code representing the household\'s preferred content and interface language. Used for content recommendations and UI localization.']
  last_login_timestamp timestamp [note: 'Timestamp of the most recent authentication event for any member of this household. Used for engagement tracking and inactive account identification.']
  last_payment_date date [note: 'Date of the most recent successful payment received from this household. Used for delinquency tracking and churn prediction.']
  lifetime_value decimal(12,2) [note: 'Total revenue generated by this household since account creation, including subscription fees, transactional purchases (TVOD), and advertising revenue attribution. Used for customer segmentation and retention investment decisions.']
  marketing_opt_in boolean [note: 'Indicates whether the household has consented to receive marketing communications and promotional offers. Required for GDPR and CCPA compliance.']
  max_concurrent_streams varchar [note: 'Maximum number of simultaneous video streams allowed for this household based on their service plan. Enforced by the streaming platform to prevent account sharing abuse.']
  max_registered_devices varchar [note: 'Maximum number of devices that can be registered to this household account. Used to enforce device limits per service tier.']
  name varchar [note: 'Human-readable name or label for the household, typically derived from the primary account holder\'s name or a custom household designation.']
  parental_control_enabled boolean [note: 'Indicates whether parental control restrictions are active for this household. When enabled, content access is filtered based on rating thresholds and PIN protection.']
  parental_control_pin varchar [note: 'Encrypted PIN code required to access age-restricted content when parental controls are enabled. Stored in hashed format for security.']
  payment_method_type varchar [note: 'Type of payment instrument on file for this household\'s subscription billing. Determines payment processing flow and retry logic. [ENUM-REF-CANDIDATE: credit_card|debit_card|paypal|bank_transfer|gift_card|carrier_billing|app_store — 7 candidates stripped; promote to reference product]']
  postal_code varchar [note: 'Postal or ZIP code for the household address. Used for geographic market (DMA) assignment and service availability determination.']
  primary_subscriber_code varchar [note: 'Reference to the primary account holder or subscriber who owns this household account. This subscriber has administrative privileges for the household.']
  service_tier varchar [note: 'Current subscription service tier for the household. Determines content library access, stream quality (SD/HD/4K), and feature availability.']
  size varchar [note: 'Number of registered members or subscribers within this household. Used for family plan eligibility and simultaneous stream limit enforcement.']
  state_province varchar [note: 'State, province, or region code for the household address. Used for regulatory compliance and regional content licensing.']
  subscription_end_date date [note: 'Date when the household\'s current subscription is scheduled to end or renew. Null for active auto-renewing subscriptions.']
  subscription_start_date date [note: 'Date when the household\'s current paid subscription began. May differ from account creation date if there was a trial period or reactivation.']
  time_zone varchar [note: 'IANA time zone identifier for the household location. Used for scheduling, program guide display, and live event timing.']
  updated_timestamp timestamp [note: 'Timestamp when this household record was last modified in the data platform. Used for change tracking and incremental processing.']
  verification_method varchar [note: 'Method used to verify the household\'s identity and location. Multiple methods may be used in combination for higher confidence.']
  verification_status varchar [note: 'Status of household identity and address verification process. Used to enforce geographic entitlements and prevent fraudulent account creation.']

  Note: 'Represents a logical household grouping of one or more subscribers sharing a service plan. Tracks household-level attributes including address, geographic market (DMA), household size, primary account holder reference, parental control settings, simultaneous stream limits, and household verification status. Supports MVPD household-based entitlement models, family plan billing, and account sharing enforcement.'
}

Table subscriber.subscription_plan {
  subscription_plan_id varchar [pk, note: 'Unique identifier for the subscription plan. Primary key for the subscription plan catalog.']
  accessibility_obligation_id varchar [note: 'Foreign key linking to compliance.accessibility_obligation. Business justification: Subscription plans must meet specific accessibility obligations (closed captioning availability, audio description requirements per FCC mandates). Compliance reporting requires linking each plan to it']
  cycle_id varchar [note: 'Foreign key linking to billing.cycle. Business justification: Subscription plan catalog definitions must reference the billing cycle entity to enforce billing frequency, proration method, and invoice generation day. Product managers and billing architects expect']
  distribution_agreement_id varchar [note: 'Foreign key linking to partner.distribution_agreement. Business justification: Subscription plans offered through distribution partners (cable, MVPD, satellite) are defined and constrained by distribution agreements specifying eligible tiers, pricing, and content scope. Plan con']
  genre_id varchar [note: 'Foreign key linking to content.genre. Business justification: Subscription plans are frequently genre-scoped (Sports tier, Kids tier, Documentary add-on). subscription_plan.content_library_scope is a plain-text denormalization; a FK to content.genre enables stru']
  max_content_rating_id varchar [note: 'Foreign key linking to content.rating. Business justification: Subscription plans enforce parental control content rating ceilings (e.g., Kids plan capped at TV-Y7). Linking subscription_plan to content.rating enables automated content access gating and parental ']
  ott_platform_id varchar [note: 'Foreign key linking to distribution.ott_platform. Business justification: Subscription plans are platform-specific products (Disney+ Basic vs Hulu Live TV). Billing, entitlement provisioning, and subscriber reporting all require knowing which OTT platform a plan belongs to.']
  regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: Subscription plans must comply with specific regulatory obligations (COPPA for kids tiers, CCPA data handling, accessibility mandates). Compliance officers need to trace which regulation governs each ']
  segment_id varchar [note: 'Foreign key linking to audience.segment. Business justification: Subscription plans are designed and activated against specific audience segments for DAI eligibility and targeted plan marketing (e.g., sports tier targets sports-affinity segment). subscription_plan ']
  territory_id varchar [note: 'Foreign key linking to rights.rights_territory. Business justification: Subscription plan geographic availability is governed by rights territory definitions. Replacing the denormalized geographic_availability string with a FK to rights_territory enables accurate geo-righ']
  ad_supported boolean [note: 'Indicates whether this subscription plan includes advertising (AVOD/FAST model) or is ad-free (SVOD model).']
  addon_eligible boolean [note: 'Indicates whether this plan can be purchased as an add-on to another base subscription plan (e.g., premium sports channel add-on).']
  audio_quality_max varchar [note: 'Maximum audio quality format available under this subscription plan (e.g., stereo, surround 5.1, Dolby Atmos, DTS:X).']
  auto_renewal_enabled boolean [note: 'Indicates whether subscriptions under this plan automatically renew at the end of each billing period by default.']
  base_price decimal(12,2) [note: 'Standard recurring price for the subscription plan before any discounts, promotions, or taxes. Expressed in the default currency.']
  blackout_restrictions boolean [note: 'Indicates whether this subscription plan is subject to geographic blackout restrictions for certain live sports or regional content.']
  bundled_plan boolean [note: 'Indicates whether this is a bundled subscription plan that combines multiple services or content packages (e.g., streaming + live TV + music).']
  cancellation_policy varchar [note: 'Policy governing subscriber cancellation: anytime (immediate), end of billing period, no refund, or prorated refund.']
  churn_risk_category varchar [note: 'Assessed churn risk category for subscribers on this plan based on historical churn rate analysis (low, medium, high).']
  concurrent_stream_limit varchar [note: 'Maximum number of simultaneous video streams allowed under this subscription plan. Null indicates unlimited concurrent streams.']
  content_library_scope varchar [note: 'Defines the scope of content library access granted by this plan (e.g., full catalog, limited selection, premium content only, sports only, news only, kids only).']
  contract_term_months varchar [note: 'Minimum contract commitment period in months for this subscription plan. Null indicates month-to-month with no minimum commitment.']
  created_timestamp timestamp [note: 'Timestamp when this subscription plan record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the base price (e.g., USD, EUR, GBP, CAD).']
  device_registration_limit varchar [note: 'Maximum number of devices that can be registered to a subscriber account under this plan. Null indicates unlimited device registrations.']
  download_enabled boolean [note: 'Indicates whether offline download of content is permitted under this subscription plan.']
  download_limit varchar [note: 'Maximum number of titles that can be downloaded for offline viewing at any given time. Null if download_enabled is false or unlimited.']
  early_termination_fee decimal(12,2) [note: 'Fee charged to subscribers who cancel before the end of the contract term. Null if no early termination fee applies.']
  launch_date date [note: 'Date when this subscription plan was first made available to subscribers.']
  modified_by varchar [note: 'Identifier of the user or system process that last modified this subscription plan record.']
  modified_timestamp timestamp [note: 'Timestamp when this subscription plan record was last modified in the system.']
  parental_control_enabled boolean [note: 'Indicates whether parental control features are available under this subscription plan to restrict content based on ratings.']
  plan_code varchar [note: 'Externally-known unique business identifier for the subscription plan used in billing systems and customer communications. Managed in Zuora product catalog.']
  plan_description varchar [note: 'Detailed description of the subscription plan features, benefits, and included content for subscriber-facing materials and internal reference.']
  plan_name varchar [note: 'Human-readable marketing name of the subscription plan displayed to subscribers (e.g., Premium Plus, Family Bundle, Sports Add-On).']
  plan_status varchar [note: 'Current lifecycle status of the subscription plan: active (available for new subscriptions), inactive (temporarily unavailable), deprecated (no longer offered but existing subscriptions continue), sunset (being phased out), coming soon (announced but not yet available).']
  plan_type varchar [note: 'Business model classification: SVOD (Subscription Video On Demand), AVOD (Advertising-Supported Video On Demand), TVOD (Transactional Video On Demand), FAST (Free Ad-Supported Streaming Television), hybrid, or add-on plan.']
  promotional_plan boolean [note: 'Indicates whether this is a limited-time promotional subscription plan offered at a special price or with enhanced features.']
  service_tier varchar [note: 'Classification of the subscription plan tier indicating the level of service and content access (e.g., basic, standard, premium, ultimate, enterprise, family).']
  sunset_date date [note: 'Date when this subscription plan will no longer be available for new subscriptions. Null if the plan is not scheduled for sunset.']
  target_arpu decimal(12,2) [note: 'Target average revenue per user (ARPU) metric for financial planning and performance tracking of this subscription plan.']
  target_ltv decimal(12,2) [note: 'Target lifetime value (LTV) metric representing the projected total revenue from a subscriber over the duration of their subscription to this plan.']
  trial_duration_days varchar [note: 'Number of days for the free trial period if trial_eligible is true. Null if no trial is offered.']
  trial_eligible boolean [note: 'Indicates whether this subscription plan is eligible for a free trial period for new subscribers.']
  video_quality_max varchar [note: 'Maximum video resolution quality available under this subscription plan (e.g., SD, HD, Full HD, 4K, 8K).']

  Note: 'Catalog of all available subscription plans and service tiers offered to subscribers — SVOD, AVOD, TVOD, FAST, bundled, and add-on plans. Captures plan name, tier classification, billing frequency, base price, trial eligibility, concurrent stream limit, download allowance, ad-supported flag, and plan lifecycle status. Managed in Zuora as the product catalog.'
}

Table subscriber.subscription {
  subscription_id varchar [pk, note: 'Unique identifier for the subscription record. Primary key.']
  cycle_id varchar [note: 'Foreign key linking to billing.cycle. Business justification: Subscription billing operations require linking each subscription to the authoritative billing cycle record governing invoice generation timing, proration rules, grace periods, and renewal notices. A ']
  distribution_agreement_id varchar [note: 'Foreign key linking to partner.distribution_agreement. Business justification: Partner-delivered subscriptions (MVPD, cable, satellite) are governed by distribution agreements defining carriage terms and revenue splits. Partner settlement reporting and minimum guarantee reconcil']
  ott_platform_id varchar [note: 'Foreign key linking to distribution.ott_platform. Business justification: Subscriptions are platform-specific (Netflix subscription ≠ Hulu subscription). Essential for platform revenue attribution, subscriber acquisition cost analysis, and platform-specific churn reporting ']
  payment_instrument_id varchar [note: 'Foreign key linking to subscriber.payment_instrument. Business justification: A subscription is billed against a specific stored payment instrument held by the subscriber. While subscription.payment_method_id references the billing-domain payment method, the subscriber domain\'s']
  payment_method_id varchar [note: 'Reference to the payment method used for recurring billing of this subscription.']
  subscriber_id varchar [note: 'Reference to the subscriber who owns this subscription.']
  subscription_plan_id varchar [note: 'Reference to the subscription plan that defines the service tier, features, and pricing structure.']
  acquisition_channel varchar [note: 'Marketing channel or source through which the subscriber acquired this subscription (e.g., web, mobile app, partner referral, promotional campaign).']
  activation_date date [note: 'Date when the subscription was activated and service delivery began. May differ from enrollment date if there was a pending period.']
  arpu decimal(15,2) [note: 'Average Revenue Per User calculated for this subscription over its lifetime, used for subscriber value analysis and forecasting.']
  auto_renew_flag boolean [note: 'Indicates whether the subscription will automatically renew at the end of the current term. True = auto-renew enabled, False = manual renewal required.']
  base_rate_amount decimal(15,2) [note: 'The standard subscription rate amount per billing cycle, in the billing currency, before any discounts or promotions.']
  cancellation_date date [note: 'Date when the subscription was cancelled by the subscriber or system. Null for active subscriptions.']
  cancellation_initiated_by varchar [note: 'Entity that initiated the cancellation: subscriber (voluntary), system (automated), admin (manual intervention), payment_failure (billing issue), fraud_detection (security). Null for active subscriptions.']
  cancellation_reason varchar [note: 'Primary reason for subscription cancellation, used for churn analysis and retention strategy. Null for active subscriptions. [ENUM-REF-CANDIDATE: voluntary|payment_failure|fraud|service_quality|price|content_selection|technical_issues — 7 candidates stripped; promote to reference product]']
  contract_term_months varchar [note: 'Length of the subscription contract term in months. Null for month-to-month or open-ended subscriptions.']
  created_timestamp timestamp [note: 'Timestamp when the subscription record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for subscription billing (e.g., USD, EUR, GBP).']
  current_term_end_date date [note: 'End date of the current billing term or subscription period. Represents the next renewal or expiration date.']
  current_term_start_date date [note: 'Start date of the current billing term or subscription period.']
  enrollment_date date [note: 'Date when the subscriber first enrolled in this subscription plan. Represents the start of the contractual relationship.']
  grace_period_end_date date [note: 'Date when the grace period ends after a payment failure or cancellation, after which access is fully revoked. Null if no grace period applies.']
  last_modified_timestamp timestamp [note: 'Timestamp when the subscription record was last updated or modified.']
  ltv decimal(15,2) [note: 'Lifetime Value representing the total revenue generated or projected from this subscription over its entire lifecycle.']
  max_concurrent_streams varchar [note: 'Maximum number of simultaneous video streams allowed under this subscription plan, enforced by the streaming platform.']
  parental_control_enabled boolean [note: 'Indicates whether parental controls are enabled for this subscription to restrict access to age-inappropriate content. True = enabled, False = disabled.']
  promotional_end_date date [note: 'Date when the promotional rate expires and standard pricing resumes. Null if no promotion is active.']
  promotional_rate_amount decimal(15,2) [note: 'The discounted subscription rate amount during the promotional period, in the billing currency. Null if no promotion is active.']
  promotional_rate_flag boolean [note: 'Indicates whether the subscription is currently on a promotional or discounted rate. True = promotional pricing active, False = standard pricing.']
  renewal_date date [note: 'Date when the subscription is scheduled to renew for the next billing cycle.']
  subscription_number varchar [note: 'Human-readable business identifier for the subscription, displayed to subscribers and customer service representatives.']
  subscription_status varchar [note: 'Current lifecycle state of the subscription: active (in service), suspended (temporarily paused), cancelled (terminated by subscriber or system), expired (end date reached), trialing (in trial period), pending (awaiting activation).']
  subscription_type varchar [note: 'Classification of subscription model: SVOD (Subscription Video On Demand), AVOD (Advertising-Supported Video On Demand), TVOD (Transactional Video On Demand), bundle, premium add-on, or trial.']
  suspension_reason varchar [note: 'Free-text explanation for why the subscription was suspended (e.g., payment failure, subscriber request, fraud investigation). Null for non-suspended subscriptions.']
  termination_date date [note: 'Date when the subscription service was fully terminated and access was revoked. May differ from cancellation date if there is a grace period.']
  trial_end_date date [note: 'Date when the trial period ends and billing begins, if applicable. Null for non-trial subscriptions.']
  trial_start_date date [note: 'Date when the trial period began, if applicable. Null for non-trial subscriptions.']
  zuora_subscription_reference varchar [note: 'External subscription identifier from Zuora billing system for revenue recognition and invoicing integration.']

  Note: 'Active or historical enrollment of a subscriber to a specific subscription plan. Represents the contractual service relationship — capturing plan enrollment date, renewal date, billing cycle, current status (active, suspended, cancelled, trialing), auto-renew flag, promotional rate, and Zuora subscription ID. One subscriber may have multiple subscriptions (e.g., base SVOD + premium add-on).'
}

Table subscriber.device_registration {
  device_registration_id varchar [pk, note: 'Unique identifier for the device registration record. Primary key.']
  audience_profile_id varchar [note: 'Foreign key linking to audience.audience_profile. Business justification: ACR (Automatic Content Recognition) and cross-platform measurement systems link registered streaming devices to audience profiles for viewership attribution. Enables deduplicated reach/frequency repor']
  device_type_id varchar [note: 'Foreign key linking to distribution.device_type. Business justification: Device certification and DRM enforcement require mapping subscriber devices to certified device_type records. QoS tier assignment, ABR profile selection, and DRM security level validation all depend o']
  household_id varchar [note: 'Reference to the household to which this device belongs. Enables household-level device limit enforcement and shared viewing analytics.']
  ott_platform_id varchar [note: 'Foreign key linking to distribution.app_version. Business justification: Feature flag evaluation, force-upgrade enforcement, and A/B test cohort assignment require linking registered devices to specific app_version records. Critical for rollout management and compatibility']
  subscriber_id varchar [note: 'Reference to the subscriber who registered this device. Links to the subscriber master record.']
  ad_tracking_consent boolean [note: 'Indicates whether the user has consented to advertising tracking on this device. Required for GDPR and CCPA compliance.']
  advertising_device_identifier varchar [note: 'Device advertising identifier (IDFA for iOS, AAID for Android). Used for targeted advertising and attribution tracking. Subject to user consent per GDPR and CCPA.']
  audio_codec_support varchar [note: 'Comma-separated list of audio codecs supported by the device (e.g., AAC, Dolby Digital, Dolby Atmos, DTS). Determines audio track selection.']
  concurrent_stream_limit varchar [note: 'Maximum number of concurrent streams allowed for this device under the subscribers plan. Enforced at playback initiation.']
  created_timestamp timestamp [note: 'Timestamp when this device registration record was first created in the system. Follows ISO 8601 format (yyyy-MM-ddTHH:mm:ss.SSSXXX).']
  deregistration_reason varchar [note: 'Reason why the device was deregistered. Used for churn analysis and fraud investigation. [ENUM-REF-CANDIDATE: user_initiated|account_closure|fraud_detected|device_limit_exceeded|inactivity|admin_action|device_lost_stolen — 7 candidates stripped; promote to reference product]']
  deregistration_timestamp timestamp [note: 'Date and time when the device was deregistered or removed from the subscriber account. Null if device is still registered.']
  device_fingerprint varchar [note: 'Unique cryptographic hash or identifier that uniquely identifies the physical device. Used for device authentication and fraud prevention.']
  device_limit_enforcement_flag boolean [note: 'Indicates whether this device counts toward the subscribers per-account device limit. Used to exempt customer service test devices or promotional devices.']
  device_nickname varchar [note: 'User-assigned friendly name for the device (e.g., Living Room TV, Johns iPhone). Improves device management user experience.']
  drm_certificate_reference varchar [note: 'Reference to the DRM device certificate used for secure content decryption. Required for protected content playback.']
  drm_security_level varchar [note: 'Security level of the DRM implementation on the device. Determines maximum content quality and protection level (e.g., Widevine L1 for HD, L3 for SD).']
  fraud_score decimal(5,2) [note: 'Calculated fraud risk score for this device registration (0.00 to 100.00). Higher scores indicate higher likelihood of fraudulent activity.']
  geographic_location varchar [note: 'Geographic location derived from IP address or device GPS (country, region, city). Used for content windowing and blackout restrictions.']
  hdr_support boolean [note: 'Indicates whether the device supports HDR video playback (HDR10, Dolby Vision, HLG). Enables premium content delivery.']
  ip_address varchar [note: 'IP address from which the device was registered. Used for geolocation, fraud detection, and blackout enforcement.']
  last_active_timestamp timestamp [note: 'Date and time of the most recent authenticated activity from this device. Used to identify inactive devices and enforce inactivity policies.']
  max_download_count varchar [note: 'Maximum number of titles that can be downloaded for offline viewing on this device. Enforced per subscription plan terms.']
  max_resolution_supported varchar [note: 'Highest video resolution the device can decode and display. Used for adaptive bitrate streaming (ABR) profile selection.']
  offline_download_enabled boolean [note: 'Indicates whether this device is authorized for offline content downloads. Subject to plan entitlements and DRM restrictions.']
  parental_control_enabled boolean [note: 'Indicates whether parental controls are active on this device. Restricts access to age-inappropriate content per COPPA and content rating standards.']
  parental_control_pin_hash varchar [note: 'Cryptographic hash of the parental control PIN. Used to authenticate access to restricted content without storing the PIN in plaintext.']
  push_notification_token varchar [note: 'Device-specific token for sending push notifications (APNS for iOS, FCM for Android). Used for engagement campaigns and service alerts.']
  registration_source varchar [note: 'Channel or interface through which the device was registered. Used for registration workflow analytics and fraud detection.']
  registration_status varchar [note: 'Current lifecycle status of the device registration. Determines whether the device is authorized for playback.']
  registration_timestamp timestamp [note: 'Date and time when the device was first registered by the subscriber. Follows ISO 8601 format (yyyy-MM-ddTHH:mm:ss.SSSXXX).']
  updated_timestamp timestamp [note: 'Timestamp when this device registration record was last modified. Follows ISO 8601 format (yyyy-MM-ddTHH:mm:ss.SSSXXX).']
  user_agent varchar [note: 'HTTP user agent string reported by the device. Contains detailed device, OS, and browser information for analytics and troubleshooting.']

  Note: 'Records every device registered by a subscriber for authenticated playback. Captures device type (smart TV, mobile, tablet, set-top box, web browser, gaming console), device fingerprint, manufacturer, model, OS platform and version, registration timestamp, last active timestamp, device nickname, device status (active, deregistered, blocked), and DRM device certificate reference. Enforces per-account device limits and supports device management workflows including remote deregistration.'
}

Table subscriber.entitlement {
  entitlement_id varchar [pk, note: 'Unique identifier for the entitlement record. Primary key.']
  acquisition_deal_id varchar [note: 'Foreign key linking to partner.acquisition_deal. Business justification: Subscriber entitlements to specific content are derived from acquisition deals that licensed that content. Rights compliance auditing, royalty calculation, and deal utilization reporting require traci']
  channel_id varchar [note: 'Foreign key linking to scheduling.channel. Business justification: Linear channel access entitlements are core to SVOD/AVOD/MVPD platforms. Subscribers receive entitlements to specific live channels (ESPN, HBO, etc.) based on subscription tier. Required for authoriza']
  compliance_content_rating_id varchar [note: 'Foreign key linking to compliance.content_rating. Business justification: Entitlement authorization must validate content rating against subscriber parental controls and age restrictions. Real business process: streaming platform checks entitlement.compliance_content_rating']
  content_episode_id varchar [note: 'Foreign key linking to content.content_episode. Business justification: Episodic entitlements for serialized content. Essential for SVOD/TVOD episode-level access control, pay-per-episode models, and early-access windows. Complements existing title_id for granular episode']
  content_window_id varchar [note: 'Foreign key linking to rights.rights_content_window. Business justification: Entitlement validity is governed by the rights content window defining the availability period and platform scope. Linking entitlement to the rights content window enables real-time rights window enfo']
  grant_id varchar [note: 'Foreign key linking to rights.grant. Business justification: Subscriber entitlement authorization traceability: every entitlement must be traceable to the specific rights grant that authorizes distribution on that platform. Compliance audits and rights enforcem']
  ott_platform_id varchar [note: 'Reference to the channel package or bundle that this entitlement provides access to.']
  regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: Entitlements are granted or restricted based on regulatory obligations — geographic blackout rules, COPPA restrictions on minors\' content access, and territorial licensing mandates. Compliance audits ']
  release_window_id varchar [note: 'Reference to the content windowing strategy that defines the availability period and distribution channel for this entitlement.']
  season_id varchar [note: 'Foreign key linking to content.season. Business justification: Season-level entitlements support seasonal release windows, partial series access, and season passes. Common in TVOD and premium tier models where seasons are monetized separately.']
  series_id varchar [note: 'Foreign key linking to content.series. Business justification: Series-level entitlements ("access all episodes") common in subscription models. Supports binge-watching, series passes, and franchise-based access. Enables efficient authorization without per-episode']
  subscriber_id varchar [note: 'Reference to the subscriber who holds this entitlement.']
  subscription_id varchar [note: 'Foreign key linking to subscriber.subscription. Business justification: Entitlements are granted based on active subscription enrollment. Currently entitlement links to subscriber and subscription_plan, but not to the actual subscription instance. Adding subscription_id F']
  subscription_plan_id varchar [note: 'Reference to the subscription plan that grants this entitlement.']
  title_id varchar [note: 'Reference to the specific content asset or title to which access is granted.']
  version_id varchar [note: 'Foreign key linking to content.version. Business justification: Subscriber entitlements are granted to specific content versions (HD, 4K, dubbed, SDH-captioned). Linking entitlement to content.version enables version-specific access control enforcement, quality-ti']
  viewer_profile_id varchar [note: 'Foreign key linking to subscriber.viewer_profile. Business justification: Entitlements define content access rights granted to a subscriber, but in multi-profile households, access rights can be scoped to specific viewer profiles (e.g., a kids profile has restricted content']
  windowing_plan_id varchar [note: 'Foreign key linking to content.windowing_plan. Business justification: Subscriber entitlements must be validated against active windowing plans to enforce holdback periods, exclusivity windows, and territory restrictions. Linking entitlement to windowing_plan enables win']
  access_level varchar [note: 'Degree of access granted by this entitlement: full (complete access), preview (sample or trailer only), limited (restricted features or duration), or premium (enhanced quality or early access).']
  activated_timestamp timestamp [note: 'Timestamp when the entitlement transitioned from pending to active status and became usable by the subscriber.']
  ad_free boolean [note: 'Indicates whether this entitlement provides ad-free viewing experience. False indicates AVOD (Advertising-Supported Video On Demand) model applies.']
  authorization_count varchar [note: 'Total number of playback authorization requests processed for this entitlement since activation.']
  auto_renew boolean [note: 'Indicates whether this entitlement will automatically renew upon expiration based on the underlying subscription plan.']
  blackout_exempt boolean [note: 'Indicates whether this entitlement is exempt from geographic blackout restrictions typically applied to live sports or regional content.']
  compliance_flags varchar [note: 'Comma-separated list of compliance requirements applicable to this entitlement (e.g., \'GDPR\', \'CCPA\', \'COPPA\'). Used to enforce data privacy and regulatory obligations.']
  concurrent_stream_limit varchar [note: 'Maximum number of simultaneous streams allowed under this entitlement. Null indicates no stream limit.']
  created_timestamp timestamp [note: 'Timestamp when this entitlement record was first created in the system.']
  device_limit varchar [note: 'Maximum number of concurrent devices that can use this entitlement. Null indicates no device limit.']
  download_enabled boolean [note: 'Indicates whether offline download is permitted for content under this entitlement.']
  early_access_enabled boolean [note: 'Indicates whether this entitlement grants early access to content before general release.']
  effective_date date [note: 'Date when the entitlement becomes active and access rights begin.']
  entitlement_status varchar [note: 'Current lifecycle status of the entitlement: active (currently valid), suspended (temporarily disabled), expired (past end date), revoked (administratively cancelled), or pending (awaiting activation).']
  entitlement_type varchar [note: 'Classification of the entitlement based on how it was granted: subscription (standard plan), promotional (marketing grant), bundle (package deal), addon (premium add-on), mvpd_carriage (Multichannel Video Programming Distributor carriage agreement), or trial (free trial period).']
  expiry_date date [note: 'Date when the entitlement expires and access rights end. Null for perpetual entitlements.']
  external_entitlement_reference varchar [note: 'Unique identifier for this entitlement in the originating external system (e.g., Zuora subscription ID, MVPD authorization token).']
  geographic_restriction varchar [note: 'Comma-separated list of ISO 3166-1 alpha-3 country codes where this entitlement is valid. Empty indicates no geographic restriction.']
  grant_reason varchar [note: 'Business justification or reason code for why this entitlement was granted (e.g., \'Annual Subscription\', \'Promotional Campaign Q4-2024\', \'Customer Retention Offer\', \'MVPD Carriage Agreement\').']
  last_authorization_timestamp timestamp [note: 'Timestamp of the most recent playback authorization request that validated this entitlement at the CDN/DRM layer.']
  modified_timestamp timestamp [note: 'Timestamp when this entitlement record was last updated.']
  notes varchar [note: 'Free-text field for additional administrative notes or special instructions related to this entitlement.']
  parental_control_level varchar [note: 'Maximum content rating level accessible under this entitlement based on parental control settings. Follows Motion Picture Association (MPA) and TV Parental Guidelines ratings. [ENUM-REF-CANDIDATE: none|g|pg|pg13|r|nc17|tv_y|tv_y7|tv_g|tv_pg|tv_14|tv_ma — 12 candidates stripped; promote to reference product]']
  quality_tier varchar [note: 'Maximum video quality level allowed by this entitlement: sd (standard definition), hd (high definition 1080p), 4k (ultra high definition), or 8k (8K resolution).']
  revocation_reason varchar [note: 'Reason why the entitlement was revoked or suspended, if applicable (e.g., \'Payment Failure\', \'Terms of Service Violation\', \'Subscriber Request\', \'Rights Expiration\').']
  revoked_timestamp timestamp [note: 'Timestamp when the entitlement was permanently revoked, if applicable.']
  suspended_timestamp timestamp [note: 'Timestamp when the entitlement was suspended, if applicable.']
  trial_entitlement boolean [note: 'Indicates whether this is a trial entitlement granted as part of a free trial period.']

  Note: 'Defines the specific content access rights granted to a subscriber based on their active subscription plan(s). Maps subscriber to entitled content windows, channel packages, VOD libraries, and premium add-ons. Captures entitlement source (plan, promotional grant, MVPD carriage), effective date, expiry date, and entitlement status. Drives playback authorization decisions at the CDN/DRM layer.'
}

Table subscriber.viewer_profile {
  viewer_profile_id varchar [pk, note: 'Unique identifier for the viewer profile within a subscriber account or household. Primary key.']
  audience_profile_id varchar [note: 'Foreign key linking to audience.audience_profile. Business justification: Individual viewer profiles (e.g., a kids profile on a family account) require independent audience profiles for cross-platform measurement and panel weighting. Streaming measurement standards require ']
  demographic_segment_id varchar [note: 'Foreign key linking to audience.demographic_segment. Business justification: Viewer profiles are classified into Nielsen demographic cells to drive DAI (Dynamic Ad Insertion) targeting and audience composition reporting. Each profile (e.g., kids vs. adult) maps to a distinct d']
  device_registration_id varchar [note: 'Identifier of the last device used to access this viewer profile. Used for device tracking, security monitoring, and cross-device analytics. May reference device registration records.']
  favorite_genre_id varchar [note: 'Foreign key linking to content.genre. Business justification: Personalization and recommendation engines require explicit genre preferences. Drives content discovery, homepage curation, and email marketing. Complements behavioral signals with declared preference']
  maturity_rating_id varchar [note: 'Foreign key linking to content.rating. Business justification: Per-profile maturity rating enforcement is a core OTT parental control process. viewer_profile.maturity_rating_level is a denormalized plain-text field; replacing it with a FK to content.rating enable']
  ott_platform_id varchar [note: 'Foreign key linking to distribution.personalization_engine. Business justification: A/B testing and personalization require tracking which recommendation engine serves each profile. Critical for measuring algorithm performance, cold-start strategy effectiveness, and experimentation i']
  subscriber_id varchar [note: 'Reference to the parent subscriber account that owns this viewer profile. One subscriber may have multiple viewer profiles (e.g., up to 5 profiles per account).']
  aep_segment_ids varchar [note: 'Comma-separated list of Adobe Experience Platform segment IDs that this viewer profile belongs to. Used for personalized content recommendations, targeted advertising, and dynamic user experience customization.']
  audio_language varchar [note: 'ISO 639-1 two-letter language code for preferred audio track language. Used for multi-language content with multiple audio tracks.']
  autoplay_enabled boolean [note: 'Boolean flag indicating whether autoplay of next episode or content is enabled for this profile. True enables automatic playback; false requires manual selection.']
  autoplay_previews_enabled boolean [note: 'Boolean flag indicating whether automatic preview playback is enabled when browsing content. True enables preview autoplay; false disables previews.']
  avatar_url varchar [note: 'URL reference to the profile avatar image stored in the Media Asset Management (MAM) system or Content Delivery Network (CDN). Used for visual identification in profile selection interfaces.']
  ccpa_opt_out_flag boolean [note: 'Boolean flag indicating whether the viewer has opted out of personal data sale under CCPA (California Consumer Privacy Act). True indicates opt-out; false indicates consent. Required for California viewer data privacy compliance.']
  coppa_compliant_flag boolean [note: 'Boolean flag indicating whether this profile is subject to COPPA (Children\'s Online Privacy Protection Act) compliance requirements. True for profiles of children under 13; false for adult profiles. Enforces enhanced privacy protections and parental consent requirements.']
  created_timestamp timestamp [note: 'Timestamp when the viewer profile was first created in the system. Used for audit trail, lifecycle tracking, and compliance reporting. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.']
  data_saver_mode boolean [note: 'Boolean flag indicating whether data saver mode is enabled to reduce bandwidth consumption. True limits video quality and disables high-bandwidth features; false allows full quality streaming.']
  download_enabled boolean [note: 'Boolean flag indicating whether this profile is entitled to download content for offline viewing. True enables download feature; false restricts to streaming only. Controlled by subscription tier and DRM (Digital Rights Management) policies.']
  gdpr_consent_timestamp timestamp [note: 'Timestamp when GDPR (General Data Protection Regulation) consent was obtained for this viewer profile. Required for EU audience data privacy compliance. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.']
  genre_preferences varchar [note: 'Comma-separated list of preferred content genre identifiers for personalization and recommendation algorithms. Derived from viewing history and explicit user selections. Used by Adobe Experience Platform for segment targeting.']
  is_default_profile boolean [note: 'Boolean flag indicating whether this is the default profile that is automatically selected when the subscriber logs in. True for default profile; false for secondary profiles. Only one profile per subscriber should be marked as default.']
  is_kids_profile boolean [note: 'Boolean flag indicating whether this is a dedicated kids profile with enhanced parental controls, age-appropriate content filtering, and COPPA (Children\'s Online Privacy Protection Act) compliance enforcement. True for kids profiles; false for adult/general profiles.']
  language_preference varchar [note: 'ISO 639-1 two-letter language code with optional ISO 3166-1 alpha-2 country code (e.g., \'en\', \'en-US\', \'es-MX\'). Determines the language for user interface, content metadata, and audio/subtitle defaults.']
  last_access_timestamp timestamp [note: 'Timestamp when the viewer profile was last accessed or used for content viewing. Used for engagement analytics, churn prediction, and inactive profile identification. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.']
  last_modified_timestamp timestamp [note: 'Timestamp when the viewer profile was last updated or modified. Used for audit trail, change tracking, and data synchronization. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.']
  last_platform varchar [note: 'Platform type of the last device used to access this viewer profile. Used for platform-specific analytics and Over-The-Top (OTT) distribution tracking. [ENUM-REF-CANDIDATE: web|mobile_ios|mobile_android|smart_tv|roku|fire_tv|apple_tv|chromecast|gaming_console — 9 candidates stripped; promote to reference product]']
  marketing_consent boolean [note: 'Boolean flag indicating whether the viewer profile has consented to receive marketing communications and promotional content. True allows marketing; false opts out. Required for GDPR (General Data Protection Regulation) and CCPA (California Consumer Privacy Act) compliance.']
  max_concurrent_streams varchar [note: 'Maximum number of concurrent video streams allowed for this viewer profile. Enforces Digital Rights Management (DRM) and subscription tier entitlements. Typical values range from 1 to 4 streams.']
  max_downloads varchar [note: 'Maximum number of content titles that can be downloaded for offline viewing on this profile. Enforces subscription tier limits and storage management policies.']
  personalization_enabled boolean [note: 'Boolean flag indicating whether personalized content recommendations and user experience customization are enabled for this profile. True enables Adobe Experience Platform personalization; false provides generic content discovery. Impacts GDPR (General Data Protection Regulation) and CCPA (California Consumer Privacy Act) consent requirements.']
  pin_code_hash varchar [note: 'Hashed PIN code for profile access control and parental lock enforcement. Used to restrict access to mature content or prevent unauthorized profile switching. Stored as cryptographic hash for security.']
  pin_enabled boolean [note: 'Boolean flag indicating whether PIN protection is enabled for this profile. True requires PIN entry for profile access; false allows unrestricted access.']
  profile_name varchar [note: 'Human-readable display name for the viewer profile (e.g., \'Dad\', \'Kids\', \'Guest\'). Used for profile selection and personalization.']
  profile_sort_order varchar [note: 'Integer value determining the display order of this profile in the profile selection interface. Lower values appear first. Used for user experience optimization.']
  profile_status varchar [note: 'Current lifecycle state of the viewer profile. Active profiles can access content; inactive profiles are temporarily disabled; suspended profiles are blocked due to policy violations; deleted profiles are soft-deleted and retained for compliance.']
  profile_type varchar [note: 'Classification of the viewer profile within the household. Primary profiles have full account privileges; secondary profiles may have restricted access; kids profiles enforce parental controls; guest profiles are temporary.']
  subtitle_language varchar [note: 'ISO 639-1 two-letter language code for preferred subtitle language. Used when subtitle_preference is enabled.']
  subtitle_preference varchar [note: 'Default subtitle display preference for this viewer profile. Off disables subtitles; on always displays subtitles; auto displays subtitles based on content language and user language mismatch.']
  total_viewing_hours decimal(12,2) [note: 'Cumulative total viewing hours for this viewer profile across all content and sessions. Used for engagement metrics, Average Revenue Per User (ARPU) analysis, and Lifetime Value (LTV) calculations.']
  video_quality_preference varchar [note: 'Preferred video streaming quality for this profile. Auto uses Adaptive Bitrate Streaming (ABR) based on bandwidth; low/medium/high/ultra_hd enforce specific quality tiers. Impacts Content Delivery Network (CDN) delivery and bandwidth consumption.']
  viewing_history_enabled boolean [note: 'Boolean flag indicating whether viewing history is tracked and stored for this profile. True enables history tracking for recommendations and resume playback; false disables tracking for privacy. Impacts GDPR (General Data Protection Regulation) and CCPA (California Consumer Privacy Act) compliance.']

  Note: 'Individual viewing profile within a subscriber account or household — supporting multi-profile accounts (e.g., up to 5 profiles per account). Captures profile name, avatar, language preference, content genre preferences, maturity rating level, is_kids_profile flag, and Adobe Experience Platform segment IDs for personalization. Distinct from the subscriber master record — one subscriber may have multiple viewer profiles.'
}

Table subscriber.churn_event {
  churn_event_id varchar [pk, note: 'Unique identifier for the subscriber churn event record.']
  billing_account_id varchar [note: 'Foreign key linking to billing.billing_account. Business justification: Finance and retention teams analyze whether dunning escalation (billing_account.dunning_level) caused subscriber churn. Linking churn_event directly to billing_account enables dunning-to-churn correla']
  campaign_id varchar [note: 'Reference to the specific retention or win-back offer that was presented to the subscriber. Null if no offer was presented.']
  churned_due_to_talent_profile_id varchar [note: 'Foreign key linking to talent.talent_profile. Business justification: Talent departure churn attribution: content strategy and subscriber retention teams in media broadcasting formally track subscriber cancellations attributable to a key talent\'s departure (e.g., popula']
  demographic_segment_id varchar [note: 'Foreign key linking to audience.demographic_segment. Business justification: Churn analysis by demographic segment (A18-49, W25-54) is a core retention analytics report. Broadcasters must identify which Nielsen demo cells are churning to target win-back campaigns. No existing ']
  distribution_agreement_id varchar [note: 'Foreign key linking to partner.distribution_agreement. Business justification: Churn from partner-delivered services triggers contractual notification obligations and minimum guarantee recalculations under distribution agreements. Partner churn reporting and SLA compliance track']
  distribution_partner_id varchar [note: 'Reference to the MVPD or vMVPD partner through which the subscription was provisioned. Null for direct-to-consumer subscriptions. Used for partner churn analysis.']
  household_id varchar [note: 'Reference to the household to which the churned subscriber belonged. Used for household-level churn analysis and multi-subscriber household retention strategies.']
  last_viewed_title_id varchar [note: 'Foreign key linking to content.title. Business justification: Churn analysis tracks last content engagement to identify content gaps and inform win-back campaigns. Critical for retention analytics, content investment decisions, and personalized re-engagement off']
  ott_platform_id varchar [note: 'Foreign key linking to distribution.ott_platform. Business justification: Churn attribution by platform is critical for platform-specific retention analytics, executive dashboards, and investor reporting. Enables comparison of churn rates across platforms (e.g., SVOD vs AVO']
  payment_instrument_id varchar [note: 'Foreign key linking to subscriber.payment_instrument. Business justification: A churn event often results from payment failure (churn_event.payment_failure_count captures this). Linking churn_event to the specific payment_instrument that failed enables root-cause analysis of in']
  subscriber_id varchar [note: 'Reference to the subscriber who churned. Links to the subscriber master record.']
  subscription_id varchar [note: 'Reference to the specific subscription that was cancelled. Links to the subscription master record.']
  subscription_invoice_id varchar [note: 'Foreign key linking to billing.subscription_invoice. Business justification: Churn analytics and win-back campaigns require knowing the outstanding balance, payment status, and promotional discount state at the time of churn. churn_event stores denormalized \'last_payment_amoun']
  auto_renew_disabled_date date [note: 'The date when the subscriber disabled auto-renewal for their subscription. Null if auto-renewal was never disabled. Used to identify planned churn versus reactive churn.']
  cancellation_channel varchar [note: 'The interface or channel through which the cancellation was initiated. Supports analysis of churn patterns by customer touchpoint. [ENUM-REF-CANDIDATE: web_self_service|mobile_app|customer_care|email|chat|ivr|mvpd_drop|system_automated — 8 candidates stripped; promote to reference product]']
  cancellation_reason_code varchar [note: 'Standardized code representing the stated reason for cancellation. Used for churn analytics and product improvement initiatives. Empty value_regex indicates reference to external reason code lookup table with more than 6 values.']
  cancellation_reason_description varchar [note: 'Free-text description or additional details provided by the subscriber explaining the reason for cancellation. Supports qualitative churn analysis.']
  ccpa_opt_out_flag boolean [note: 'Boolean indicator of whether the subscriber exercised CCPA opt-out rights regarding data sale or sharing. Used for privacy compliance and marketing eligibility.']
  churn_prediction_score decimal(5,4) [note: 'The machine learning model-generated churn risk score that was assigned to the subscriber prior to the churn event. Range 0.0000 to 1.0000, where higher values indicate higher churn risk. Used for model validation and predictive accuracy assessment.']
  churn_timestamp timestamp [note: 'The exact date and time when the subscriber cancellation or lapse event occurred. This is the business event timestamp representing when the subscriber relationship ended.']
  churn_type varchar [note: 'Classification of the churn event based on the nature of cancellation. Voluntary indicates subscriber-initiated cancellation, involuntary indicates business-initiated termination, payment failure indicates cancellation due to billing issues.']
  competitor_service_mentioned_flag boolean [note: 'Boolean indicator of whether the subscriber mentioned switching to a competitor service during the cancellation process. Used for competitive intelligence and market positioning analysis.']
  created_timestamp timestamp [note: 'The timestamp when this churn event record was first created in the system. Used for audit trail and data lineage tracking.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the last payment amount. Supports multi-currency subscription operations.']
  customer_care_contact_count varchar [note: 'The number of customer care interactions the subscriber had in the 30 days prior to churn. Used to identify service quality issues and early warning signals.']
  days_since_last_viewing varchar [note: 'The number of days between the last viewing activity and the churn event. Used for engagement-based churn prediction models.']
  device_count_at_churn varchar [note: 'The number of registered devices associated with the subscriber at the time of churn. Used for multi-device engagement analysis.']
  final_access_date date [note: 'The last date the subscriber had active access to content and services. May differ from churn_timestamp due to grace periods or paid-through dates.']
  gdpr_data_deletion_requested_flag boolean [note: 'Boolean indicator of whether the subscriber requested deletion of their personal data under GDPR right to erasure at the time of churn. Used for privacy compliance tracking.']
  last_viewing_date date [note: 'The date of the subscribers last content viewing activity before churn. Used to identify engagement drop-off patterns and at-risk subscriber signals.']
  notes varchar [note: 'Free-text field for additional notes, comments, or context about the churn event captured by customer care agents or system processes.']
  parental_control_enabled_flag boolean [note: 'Boolean indicator of whether parental controls were enabled on the subscription at the time of churn. Used for family-oriented subscriber segmentation and churn analysis.']
  payment_failure_count varchar [note: 'The number of consecutive payment failures that occurred before the churn event. Used to identify involuntary churn patterns and dunning effectiveness.']
  promotional_discount_active_flag boolean [note: 'Boolean indicator of whether the subscriber had an active promotional discount at the time of churn. Used to analyze price sensitivity and promotional effectiveness.']
  reactivation_eligibility_date date [note: 'The date when the churned subscriber becomes eligible for reactivation campaigns or promotional offers. Used for win-back campaign targeting and timing.']
  service_tier varchar [note: 'The subscription service tier that was cancelled. SVOD (Subscription Video On Demand), AVOD (Advertising-Supported Video On Demand), TVOD (Transactional Video On Demand).']
  subscription_tenure_months varchar [note: 'The total number of months the subscriber maintained an active subscription before churning. Used for cohort analysis and LTV (Lifetime Value) calculations.']
  total_lifetime_revenue decimal(15,2) [note: 'The cumulative revenue generated from this subscriber across their entire subscription tenure. Used for LTV (Lifetime Value) analysis and churn impact assessment.']
  updated_timestamp timestamp [note: 'The timestamp when this churn event record was last modified. Used for audit trail and change tracking.']
  win_back_offer_accepted_flag boolean [note: 'Boolean indicator of whether the subscriber accepted the win-back offer. True indicates acceptance and retention, False indicates rejection and churn completion. Null if no offer was presented.']
  win_back_offer_presented_flag boolean [note: 'Boolean indicator of whether a retention or win-back offer was presented to the subscriber during the cancellation process. True indicates an offer was made, False indicates no offer was presented.']

  Note: 'Operational record of a subscriber cancellation or lapse event. Captures cancellation timestamp, cancellation channel (self-service, customer care, payment failure, MVPD drop), stated cancellation reason, win-back offer presented flag, win-back offer accepted flag, and reactivation eligibility date. Supports churn rate reporting and retention campaign targeting. Distinct from analytics — this is the operational event record.'
}

Table subscriber.payment_instrument {
  payment_instrument_id varchar [pk, note: 'Unique identifier for the payment instrument record. Primary key.']
  subscriber_id varchar [note: 'Reference to the subscriber who owns this payment instrument. Links to the subscriber master record.']
  zuora_payment_method_id varchar [note: 'External identifier for this payment method in the Zuora subscription billing system. Used for system integration and reconciliation.']
  bank_account_type varchar [note: 'Type of bank account for direct debit or ACH payment methods. Null for card-based payment methods.']
  bank_routing_number varchar [note: 'Bank routing number (ABA number in USA) for direct debit transactions. Masked or tokenized per PCI DSS requirements.']
  billing_address_line1 varchar [note: 'First line of the billing address associated with the payment instrument. Used for address verification and fraud prevention.']
  billing_address_line2 varchar [note: 'Second line of the billing address (apartment, suite, unit number). Optional field for additional address details.']
  billing_city varchar [note: 'City of the billing address associated with the payment instrument.']
  billing_country_code varchar [note: 'Three-letter ISO 3166-1 alpha-3 country code for the billing address (e.g., USA, GBR, CAN).']
  billing_postal_code varchar [note: 'Postal or ZIP code of the billing address. Used for address verification service (AVS) fraud checks.']
  billing_state_province varchar [note: 'State or province of the billing address. Format varies by country (e.g., two-letter state code for USA).']
  card_brand varchar [note: 'The brand of the credit or debit card (Visa, Mastercard, American Express, Discover, JCB, Diners Club). Null for non-card payment methods.']
  cardholder_name varchar [note: 'Name of the cardholder as it appears on the payment instrument. Required for card-based payment methods.']
  created_timestamp timestamp [note: 'Timestamp when the payment instrument record was first created in the system. Follows ISO 8601 format (yyyy-MM-ddTHH:mm:ss.SSSXXX).']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the payment instrument (e.g., USD, GBP, EUR). Determines the currency for all transactions using this instrument.']
  deactivated_timestamp timestamp [note: 'Timestamp when the payment instrument was deactivated or closed. Null for active instruments. Used for lifecycle tracking and compliance reporting.']
  deactivation_reason varchar [note: 'Reason why the payment instrument was deactivated. Used for churn analysis and payment method lifecycle management.']
  expiry_month varchar [note: 'The month (1-12) when the payment instrument expires. Used for card expiration validation and renewal reminders.']
  expiry_year varchar [note: 'The four-digit year when the payment instrument expires. Used for card expiration validation and renewal reminders.']
  failed_transaction_count varchar [note: 'Cumulative count of failed transaction attempts using this payment instrument. Used for fraud detection and payment method health monitoring.']
  gateway_reference_code varchar [note: 'External reference identifier assigned by the payment gateway for this payment instrument. Used for gateway-specific operations and reconciliation.']
  gift_card_balance decimal(10,2) [note: 'Remaining balance on the gift card or prepaid card. Updated after each transaction. Null for non-gift-card payment methods.']
  gift_card_code varchar [note: 'Masked gift card or prepaid card code. Full code is tokenized per PCI DSS requirements.']
  is_default boolean [note: 'Flag indicating whether this is the default payment instrument for the subscriber. Used for automatic billing and subscription renewals.']
  last_transaction_date date [note: 'Date of the most recent successful transaction using this payment instrument. Used for activity tracking and dormancy detection.']
  mandate_acceptance_date date [note: 'Date when the subscriber accepted the direct debit mandate. Required for regulatory compliance and dispute resolution.']
  mandate_reference varchar [note: 'Unique identifier for the direct debit mandate or authorization. Required for SEPA and other direct debit payment methods to comply with banking regulations.']
  masked_account_number varchar [note: 'Masked representation of the card or account number showing only the last 4 digits (e.g., ****1234). Full number is tokenized and stored securely per PCI DSS requirements.']
  payment_gateway varchar [note: 'Name of the payment gateway or processor used for this payment instrument (e.g., Stripe, Braintree, Authorize.Net, Zuora Gateway).']
  payment_instrument_status varchar [note: 'Current lifecycle status of the payment instrument. Active instruments can be charged; expired or suspended instruments require update or replacement.']
  payment_method_type varchar [note: 'The type of payment instrument used for subscription billing. Indicates the payment mechanism (credit card, debit card, PayPal, direct debit, bank transfer, gift card, or MVPD billing).']
  payment_token varchar [note: 'PCI DSS compliant tokenization reference for the actual payment instrument details. Used to process transactions without exposing sensitive cardholder data.']
  paypal_email varchar [note: 'Email address associated with the PayPal account. Used for PayPal payment method identification and processing.']
  paypal_payer_reference varchar [note: 'Unique PayPal payer identifier for the linked PayPal account. Used for PayPal billing agreement reference.']
  updated_timestamp timestamp [note: 'Timestamp when the payment instrument record was last modified. Follows ISO 8601 format (yyyy-MM-ddTHH:mm:ss.SSSXXX). Used for audit trail and change tracking.']
  verification_date date [note: 'Date when the payment instrument was successfully verified. Used for compliance tracking and fraud prevention.']
  verification_status varchar [note: 'Status of payment instrument verification process. Indicates whether the payment method has been successfully validated through AVS, CVV check, or micro-deposit verification.']

  Note: 'Subscriber\'s stored payment instruments used for subscription billing. Captures payment method type (credit card, debit card, PayPal, direct debit, gift card, MVPD billing), masked card/account number, card brand, expiry date, billing address, is_default flag, and PCI DSS tokenization reference. Managed in Zuora as the payment method entity. Distinct from actual payment transactions owned by the billing domain.'
}

Table subscriber.offer_redemption {
  offer_redemption_id varchar [pk, note: 'Unique identifier for the offer redemption transaction. Primary key for the offer redemption record.']
  campaign_id varchar [note: 'Reference to the marketing campaign under which this offer was promoted. Enables campaign-level performance tracking and Return on Investment (ROI) analysis.']
  credit_memo_id varchar [note: 'Foreign key linking to billing.credit_memo. Business justification: When an offer redemption is reversed or results in a promotional credit, a credit memo is issued. Linking offer_redemption to credit_memo enables audit trail for promotional credit issuance, chargebac']
  distribution_agreement_id varchar [note: 'Foreign key linking to partner.distribution_agreement. Business justification: Offers redeemed through distribution partner channels (MVPD bundles, affiliate promotions) are governed by distribution agreements specifying promotional terms and revenue share. Partner settlement an']
  invoice_id varchar [note: 'Foreign key linking to billing.invoice. Business justification: Finance teams reconcile promotional discount amounts applied via offer redemptions against specific invoices for revenue recognition, campaign ROI reporting, and audit compliance. offer_redemption.rev']
  offer_id varchar [note: 'Reference to the promotional offer or discount campaign that was redeemed. Links to the offer master record.']
  partner_id varchar [note: 'Reference to the distribution or retail partner through which the offer was distributed, if applicable. Null for direct-to-consumer offers.']
  qualifying_title_id varchar [note: 'Foreign key linking to content.title. Business justification: Promotional offers often require viewing or purchasing specific titles (e.g., "watch premiere to unlock discount"). Supports campaign attribution, content-driven acquisition, and partnership promotion']
  resulting_subscription_plan_id varchar [note: 'Reference to the subscription plan that the subscriber enrolled in or upgraded to as a result of this offer redemption. Links to the subscription plan master record.']
  subscriber_id varchar [note: 'Reference to the subscriber who redeemed the promotional offer. Links to the subscriber master record.']
  subscription_id varchar [note: 'Reference to the specific subscription instance that was created or modified as a result of this offer redemption. Links to the subscription record.']
  applied_discount_amount decimal(15,2) [note: 'The monetary value of the discount applied to the subscription as a result of this redemption. Expressed in the subscription currency.']
  attribution_source varchar [note: 'The marketing source or touchpoint that led to this offer redemption. Examples include email campaign, social media ad, affiliate link, or organic search. Used for marketing attribution analysis.']
  created_timestamp timestamp [note: 'The date and time when this offer redemption record was first created in the system. Used for audit trail and data lineage tracking.']
  discount_duration_months varchar [note: 'The number of months for which the discount will be applied to the subscription. Null for one-time discounts or permanent pricing changes.']
  discount_percentage decimal(5,2) [note: 'The percentage discount applied when discount_type is percentage. Null for non-percentage discount types. Expressed as a decimal (e.g., 25.00 for 25% off).']
  discount_type varchar [note: 'The type of discount mechanism applied through this offer redemption. Determines how the discount value is calculated and applied to the subscription.']
  eligibility_failure_reason varchar [note: 'Detailed explanation of why the redemption was rejected or marked ineligible. Null if redemption was successful. Used for customer service and offer optimization.']
  eligibility_verified_flag boolean [note: 'Indicates whether the subscribers eligibility for the offer was verified at the time of redemption. True if eligibility checks passed, False otherwise.']
  first_time_subscriber_flag boolean [note: 'Indicates whether this redemption resulted in a new subscriber acquisition (True) or was redeemed by an existing subscriber (False). Critical for Customer Acquisition Cost (CAC) and Lifetime Value (LTV) analysis.']
  offer_expiration_date date [note: 'The date on which the promotional offer expires and can no longer be redeemed. Used to validate redemption eligibility and track expired redemption attempts.']
  redemption_channel varchar [note: 'The platform or channel through which the subscriber redeemed the offer. Enables channel effectiveness analysis for promotional campaigns.']
  redemption_code varchar [note: 'The unique promotional code or voucher code entered by the subscriber at the time of redemption. Used for tracking and validation.']
  redemption_device_type varchar [note: 'The type of device used by the subscriber to redeem the offer. Supports device-specific campaign optimization and user experience analysis.']
  redemption_ip_address varchar [note: 'The IP address from which the redemption request originated. Used for fraud detection and geographic analysis. May be considered Personally Identifiable Information (PII) under General Data Protection Regulation (GDPR).']
  redemption_status varchar [note: 'Current lifecycle status of the offer redemption. Tracks whether the redemption was successfully applied, expired before use, reversed due to policy violation, or rejected due to eligibility failure.']
  redemption_timestamp timestamp [note: 'The exact date and time when the subscriber successfully redeemed the promotional offer. Represents the business event time of redemption.']
  revenue_impact_amount decimal(15,2) [note: 'The estimated impact on revenue resulting from this offer redemption. Negative values represent revenue reduction due to discounts; positive values may represent incremental revenue from new subscriptions or upgrades.']
  reversal_reason varchar [note: 'Explanation of why the offer redemption was reversed. Common reasons include fraud detection, policy violation, subscriber request, or billing dispute. Null if not reversed.']
  reversal_timestamp timestamp [note: 'The date and time when the offer redemption was reversed or cancelled. Null if the redemption remains active. Used for chargeback and refund reconciliation.']
  terms_accepted_flag boolean [note: 'Indicates whether the subscriber explicitly accepted the terms and conditions associated with the promotional offer at the time of redemption. Required for compliance and dispute resolution.']
  terms_version varchar [note: 'The version identifier of the offer terms and conditions that the subscriber agreed to at redemption. Format: v1.0, v2.1, etc. Used for legal audit trails.']
  updated_timestamp timestamp [note: 'The date and time when this offer redemption record was last modified. Used for audit trail and change tracking.']
  zuora_subscription_number varchar [note: 'The subscription identifier in the Zuora billing system that was created or modified as a result of this offer redemption. Used for billing reconciliation and revenue recognition.']

  Note: 'Transactional record of a subscriber redeeming a promotional offer or discount code. Captures subscriber reference, offer reference, redemption timestamp, redemption channel, applied discount amount, resulting subscription plan, and redemption status (applied, expired, reversed). Enables promotion effectiveness tracking and revenue impact reconciliation.'
}

Table subscriber.offer {
  offer_id varchar [pk, note: 'Primary key for offer']
  adobe_experience_segment_id varchar [note: 'External identifier linking this offer to the corresponding audience segment in Adobe Experience Platform for personalization.']
  content_window_id varchar [note: 'Foreign key linking to rights.rights_content_window. Business justification: Promotional offers must reference the rights content window governing the content being offered to ensure the offer is only active while rights are cleared. Rights and marketing teams use this link to']
  demographic_segment_id varchar [note: 'Foreign key linking to audience.demographic_segment. Business justification: Offers are designed for specific Nielsen demographic segments (e.g., student discount for 18-24, senior discount for 55+). The plain-text target_audience column is a denormalization of demographic_seg']
  genre_id varchar [note: 'Foreign key linking to content.genre. Business justification: Offers are routinely scoped to content genres (Sports package, Kids bundle, Horror add-on). Linking offer to content.genre enables genre-targeted offer creation, personalization engine recommendations']
  ott_platform_id varchar [note: 'Foreign key linking to distribution.ott_platform. Business justification: Offers are platform-specific promotional campaigns (Disney+ Black Friday deal vs Paramount+ student discount). Required for campaign ROI analysis, platform marketing spend attribution, and offer eligi']
  superseded_offer_id varchar [note: 'Self-referencing FK on offer (superseded_offer_id)']
  ad_supported_flag boolean [note: 'Indicates whether this offer includes advertising (AVOD model) or is ad-free.']
  auto_renewal_flag boolean [note: 'Indicates whether the subscription automatically renews at the end of the billing cycle.']
  billing_cycle varchar [note: 'The recurring billing frequency for this offer.']
  bundle_eligible_flag boolean [note: 'Indicates whether this offer can be bundled with other service offerings.']
  code varchar [note: 'Externally-known unique alphanumeric code for the offer, used in marketing campaigns and promotional materials.']
  commitment_period_months varchar [note: 'Minimum commitment period in months required for this offer. Nullable for no-commitment offers.']
  concurrent_streams varchar [note: 'Maximum number of simultaneous streams allowed under this offer.']
  content_quality varchar [note: 'Maximum video quality resolution available under this offer (Standard Definition, High Definition, 4K Ultra HD, 8K).']
  created_timestamp timestamp [note: 'Timestamp when this offer record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the offer price.']
  description varchar [note: 'Detailed description of the offer including benefits, features, and terms presented to subscribers.']
  discount_amount decimal(10,2) [note: 'Fixed discount amount applied to the standard price for promotional offers. Nullable for non-promotional offers.']
  discount_percentage decimal(5,2) [note: 'Percentage discount applied to the standard price for promotional offers. Nullable for non-promotional offers.']
  effective_end_date date [note: 'The date when this offer expires and is no longer available for new enrollments. Nullable for evergreen offers.']
  effective_start_date date [note: 'The date when this offer becomes available for subscriber enrollment.']
  geographic_availability varchar [note: 'Comma-separated list of ISO 3166-1 alpha-3 country codes where this offer is available.']
  max_devices varchar [note: 'Maximum number of devices that can be registered under this offer.']
  name varchar [note: 'Human-readable name of the offer displayed to subscribers and in marketing materials.']
  offer_status varchar [note: 'Current lifecycle status of the offer indicating its availability and operational state.']
  offer_type varchar [note: 'Classification of the offer based on its business purpose and target audience.']
  offline_download_enabled boolean [note: 'Indicates whether subscribers can download content for offline viewing under this offer.']
  parental_control_enabled boolean [note: 'Indicates whether parental control features are available under this offer.']
  price_amount decimal(10,2) [note: 'The standard price amount charged for this offer per billing cycle.']
  privacy_policy_version varchar [note: 'Version identifier of the privacy policy applicable to this offer at the time of creation.']
  service_tier varchar [note: 'The subscription service tier associated with this offer (Subscription Video On Demand, Advertising Video On Demand, Transactional Video On Demand, etc.).']
  terms_and_conditions_url varchar [note: 'URL to the legal terms and conditions document for this offer.']
  trial_duration_days varchar [note: 'Number of days for the free trial period included in this offer. Nullable for offers without trial periods.']
  updated_by varchar [note: 'User identifier or system name that last modified this offer record.']
  updated_timestamp timestamp [note: 'Timestamp when this offer record was last modified.']
  zuora_product_rate_plan_code varchar [note: 'External identifier linking this offer to the corresponding product rate plan in Zuora billing system.']
  created_by varchar [note: 'User identifier or system name that created this offer record.']

  Note: 'Master reference table for offer. Referenced by offer_id.'
}

Table audience.nielsen_rating {
  nielsen_rating_id varchar [pk, note: 'Unique surrogate identifier for each Nielsen audience measurement record in the Silver layer. Primary key for the nielsen_rating data product.']
  affiliate_agreement_id varchar [note: 'Foreign key linking to partner.affiliate_agreement. Business justification: Affiliate agreements specify performance_standard_grp_minimum thresholds measured via Nielsen ratings. Networks must link ratings to affiliate agreements to assess compliance, trigger preemption right']
  channel_id varchar [note: 'Reference to the broadcast channel or network on which the program aired and for which this rating was measured.']
  compliance_content_rating_id varchar [note: 'Foreign key linking to compliance.content_rating. Business justification: Nielsen ratings measurement requires content rating context for demographic targeting compliance (COPPA children\'s programming restrictions) and advertiser suitability verification. Essential for regu']
  content_episode_id varchar [note: 'Foreign key linking to content.content_episode. Business justification: Nielsen ratings are captured at the episode level for broadcast measurement, advertiser delivery reporting, and makegood calculations. A ratings analyst would always need to know which specific episod']
  daypart_id varchar [note: 'Reference to the daypart (time segment of the broadcast day) during which the program aired, such as Prime Time, Late Night, or Early Morning. Daypart is a core dimension for ad sales and programming decisions.']
  nielsen_eas_log_id varchar [note: 'Foreign key linking to compliance.eas_log. Business justification: Nielsen measurement windows affected by EAS alert transmissions require correlation for accurate rating adjustments. EAS interruptions impact audience measurement; link enables rating correction and c']
  ott_platform_id varchar [note: 'Foreign key linking to distribution.ott_platform. Business justification: Nielsen now measures streaming audiences per OTT platform (Nielsen ONE). Rating records for streaming content must be attributed to the specific OTT platform for platform-level audience reporting, upf']
  panel_id varchar [note: 'Foreign key linking to audience.panel. Business justification: Nielsen ratings are produced by a specific measurement panel. Linking nielsen_rating to panel establishes the authoritative source of the measurement, enabling panel-level quality analysis (cooperatio']
  partner_id varchar [note: 'Foreign key linking to partner.partner_partner. Business justification: Nielsen ratings for syndicated content must track which distribution partner\'s broadcast generated the rating for syndication performance reporting and partner revenue reconciliation. Essential for pa']
  primary_nielsen_compliance_political_ad_record_id varchar [note: 'Identifier for Nielsen compliance political ad record']
  production_project_id varchar [note: 'Foreign key linking to production.project. Business justification: Nielsen ratings reports measure performance of specific production projects/series. Essential for greenlight decisions, talent negotiations, and advertiser delivery verification. Standard operational ']
  program_schedule_id varchar [note: 'Foreign key linking to scheduling.program_schedule. Business justification: Nielsen ratings are reported against specific program schedules (broadcast day lineups) for FCC regulatory filings, upfront negotiations, station performance analysis, and advertiser makegoods - funda']
  sweeps_period_id varchar [note: 'Foreign key linking to audience.sweeps_period. Business justification: Nielsen ratings during sweeps periods (Feb, May, July, Nov) are the currency for annual upfront negotiations and local ad sales. The sweeps_period_flag indicates relevance, but the specific sweeps per']
  syndication_agreement_id varchar [note: 'Foreign key linking to partner.syndication_agreement. Business justification: Nielsen ratings are the contractual measurement currency for syndication agreement performance guarantees. Syndicators require ratings attributed to specific agreements to trigger makegood provisions,']
  air_date date [note: 'The calendar date on which the program episode aired on the specified channel and market. Used as the principal business event date for this measurement record.']
  air_end_time timestamp [note: 'The precise date and time at which the program finished airing. Combined with air_start_time to derive program duration for audience measurement calculations.']
  air_start_time timestamp [note: 'The precise date and time (including timezone offset) at which the program began airing. Used for exact scheduling alignment and daypart classification.']
  audience_composition_pct decimal(7,4) [note: 'The percentage of the program\'s total audience represented by the primary target demographic (typically A18-49). Indicates how well the program indexes against its target audience and is used in ad sales proposals and programming strategy.']
  average_audience decimal(14,2) [note: 'The average number of persons or households tuned to the program during an average minute of the telecast. Expressed in thousands (000s). AA is the primary audience volume metric used in GRP and CPM calculations for ad sales.']
  cume_audience decimal(14,2) [note: 'The unduplicated number of different persons or households that tuned to the program for at least one minute across all airings within a defined period. Expressed in thousands (000s). Cume measures total reach and is critical for frequency management in ad campaign planning.']
  demo_a18_49_rating decimal(7,4) [note: 'The percentage of Adults aged 18-49 in the measured universe who were tuned to this program. A18-49 is the most commercially valuable and widely traded demographic in US television advertising, serving as the primary currency for primetime ad sales.']
  demo_a25_54_rating decimal(7,4) [note: 'The percentage of Adults aged 25-54 in the measured universe who were tuned to this program. A25-54 is a key secondary demographic used in news programming, cable networks, and certain advertiser categories.']
  demo_k2_11_rating decimal(7,4) [note: 'The percentage of Children aged 2-11 in the measured universe who were tuned to this program. K2-11 is the primary demographic for children\'s programming and toy/food advertisers. Subject to COPPA compliance requirements for data handling.']
  demo_m18_49_rating decimal(7,4) [note: 'The percentage of Men aged 18-49 in the measured universe who were tuned to this program. M18-49 is a primary demographic for sports, automotive, and technology advertisers.']
  demo_w18_49_rating decimal(7,4) [note: 'The percentage of Women aged 18-49 in the measured universe who were tuned to this program. W18-49 is a primary demographic for lifestyle, beauty, and household product advertisers.']
  frequency decimal(7,2) [note: 'The average number of times a unique person or household was exposed to the program within the measurement period. Frequency = GRP / Reach. Used with reach for ad campaign effectiveness analysis and makegoods calculations.']
  grp decimal(10,4) [note: 'The sum of all ratings delivered by an advertising schedule or program, representing total audience delivery without deduplication. GRP = Reach × Frequency. A fundamental currency metric in ad sales negotiations, upfront deals, and scatter market transactions.']
  household_rating decimal(7,4) [note: 'The percentage of all television households in the measured universe that were tuned to this program during the measurement period. Expressed as a decimal percentage (e.g., 5.2 = 5.2%). The foundational Nielsen rating metric used for ad pricing and programming evaluation.']
  household_share decimal(7,4) [note: 'The percentage of households using television (HUT) that were tuned to this program. Share = (Program Audience / HUT) × 100. Measures competitive performance relative to active TV viewers at the same time.']
  hut_level decimal(7,4) [note: 'The percentage of all television households in the universe that had their television sets in use during the measurement period. HUT is the denominator for household share calculations and a key indicator of overall TV viewing activity.']
  impressions decimal(18,2) [note: 'The total number of person-level exposures to the program, calculated as average audience multiplied by the number of airings. Expressed in absolute numbers (not thousands). Impressions are the transactional currency for digital and cross-platform ad sales.']
  ingested_timestamp timestamp [note: 'The timestamp at which this Nielsen rating record was ingested into the Databricks Lakehouse Silver layer from the Nielsen Media Research Platform. Used for data freshness monitoring, SLA tracking, and audit trail.']
  last_updated_timestamp timestamp [note: 'The timestamp of the most recent update to this rating record in the Silver layer, reflecting revisions from Nielsen (e.g., preliminary to final, or restated ratings). Supports change tracking and downstream consumer notification.']
  nielsen_program_code varchar [note: 'Nielsen Media Research Platform\'s proprietary alphanumeric code uniquely identifying the program title within the Nielsen measurement system. Used as the business identifier for cross-referencing ratings data with Nielsen deliverables.']
  nielsen_report_date date [note: 'The date on which Nielsen Media Research officially published or delivered this rating record to the broadcaster. Distinguishes the measurement air date from the data delivery date, which is critical for tracking preliminary vs. final rating release cycles.']
  nielsen_report_week varchar [note: 'The ISO 8601 week identifier (e.g., 2024-W23) of the Nielsen measurement week in which this rating was reported. Nielsen measurement weeks run Monday through Sunday. Used for weekly ratings aggregation and trend analysis.']
  put_level decimal(7,4) [note: 'The percentage of all persons in the measured universe who were watching television during the measurement period. PUT is the denominator for persons share calculations and complements HUT for demographic audience analysis.']
  rating_status varchar [note: 'Lifecycle status of this Nielsen rating record indicating whether the data is preliminary (fast nationals), final, or has been revised. Ad sales and programming decisions must distinguish preliminary from final ratings. Preliminary ratings are typically released within 24 hours; final ratings follow within days.']
  reach decimal(14,2) [note: 'The unduplicated number of unique persons or households exposed to the program at least once within the measurement period. Expressed in thousands (000s). Reach is a core metric for ad campaign planning and audience delivery reporting.']
  source_system_record_code varchar [note: 'The native record identifier assigned by the Nielsen Media Research Platform for this rating record. Preserved in the Silver layer for data lineage, reconciliation, and re-ingestion traceability back to the authoritative source system.']
  sweeps_period_flag boolean [note: 'Indicates whether this rating was measured during a Nielsen Sweeps period (February, May, July, November intensive measurement periods). Sweeps ratings carry elevated importance for affiliate compensation, ad rate setting, and programming strategy.']
  time_spent_viewing_min decimal(10,2) [note: 'The average number of minutes that viewers in the measured audience spent watching the program. A key engagement metric used in programming decisions and content performance analysis. Expressed in minutes.']
  total_audience decimal(14,2) [note: 'The total number of persons or households that tuned to the program for at least six consecutive minutes. Expressed in thousands (000s). TA provides a broader reach measure than AA and is used for program promotion and scheduling decisions.']
  trp decimal(10,4) [note: 'Rating points delivered specifically to a defined target demographic audience (e.g., Adults 18-49). TRP = (Target Audience Impressions / Target Universe) × 100. Used by advertisers to evaluate efficiency of reaching their specific target demographic.']
  universe_estimate_hh decimal(14,2) [note: 'The total estimated number of television households in the measured market or national universe used as the denominator for household rating calculations. Expressed in thousands (000s). Nielsen updates universe estimates annually based on census data.']
  universe_estimate_persons decimal(14,2) [note: 'The total estimated number of persons in the measured market or national universe used as the denominator for persons rating calculations. Expressed in thousands (000s). Segmented by demographic group for TRP calculations.']

  Note: 'Authoritative audience measurement record capturing program-level ratings data including household rating, share, HUT/PUT levels, GRP, TRP, average audience (AA), total audience (TA), cume audience, and demographic breakdowns (A18-49, A25-54, W18-49, M18-49, K2-11, etc.) for a specific program airing on a specific channel, market, and daypart. Sourced from Nielsen Media Research Platform. Includes universe estimates used as denominators for percentage calculations. The SSOT for all ratings intelligence consumed by ad sales, programming, and regulatory reporting. Supports both national and local market measurement.'
}

Table audience.demographic_segment {
  demographic_segment_id varchar [pk, note: 'Unique surrogate identifier for each demographic segment record in the audience measurement reference master. Primary key for the demographic_segment product. [_canonical_skip_reason: Role classified as REFERENCE_LOOKUP — this is a reference master for standardized audience demographic classification cells; per-role minimums are exempt, but MASTER_RESOURCE minimums are applied given the entity carries rich descriptive and lifecycle attributes beyond a simple code list.]']
  adobe_segment_code varchar [note: 'The corresponding segment identifier in Adobe Experience Platform (AEP) for digital audience activation. Enables cross-system reconciliation between Nielsen linear audience measurement and AEP digital audience profiles for cross-platform campaign targeting and DAI (Dynamic Ad Insertion) on OTT/streaming platforms.']
  age_range_max varchar [note: 'Upper bound (inclusive) of the age range defining this demographic cell, expressed in years. For example, 49 for the A18-49 cell. A null value indicates an open-ended upper bound (e.g., Adults 55+). Null for non-age-based segments.']
  age_range_min varchar [note: 'Lower bound (inclusive) of the age range defining this demographic cell, expressed in years. For example, 18 for the A18-49 cell. Null for non-age-based segments such as psychographic or income quintile segments.']
  cpm_index decimal(10,4) [note: 'Relative CPM (Cost Per Mille) pricing index for this demographic segment compared to the baseline segment (index = 100). Premium segments such as A18-49 or W25-54 carry higher indices reflecting advertiser demand. Used in Salesforce Media Cloud ad sales proposals and upfront/scatter market pricing negotiations. Confidential commercial pricing data.']
  created_timestamp timestamp [note: 'The timestamp when this demographic segment record was first created in the Silver Layer data product. Provides audit trail for data governance and lineage tracking in the Databricks Lakehouse environment.']
  daypart_relevance varchar [note: 'Comma-separated list of broadcast dayparts (e.g., \'Prime Time, Late Fringe, Daytime\') for which this demographic segment has primary relevance in programming and ad sales strategy. Informs Ericsson MediaFirst scheduling decisions and Wide Orbit daypart-based ad pod targeting. Null if the segment applies across all dayparts.']
  effective_from date [note: 'The date from which this demographic segment definition is valid and available for use in audience measurement, ad sales targeting, and programming decisions. Supports temporal versioning of segment definitions as Nielsen and IAB standards evolve.']
  effective_until date [note: 'The date after which this demographic segment definition is no longer valid for new audience measurement or ad targeting use. Null for currently active segments with no planned expiry. Enables historical ratings data to reference the correct segment definition vintage.']
  ethnicity_classification varchar [note: 'Standardized ethnicity classification label for ethnicity-based demographic segments (e.g., \'Hispanic/Latino\', \'African American\', \'Asian American\', \'Non-Hispanic White\'). Populated only for ethnicity segment types. Aligned with Nielsen multicultural audience measurement standards and used in targeted content programming and ad sales. [ENUM-REF-CANDIDATE: hispanic_latino|african_american|asian_american|non_hispanic_white|native_american|multiracial|other — promote to reference product]']
  gdpr_special_category boolean [note: 'Indicates whether this demographic segment is based on GDPR Article 9 special category data (e.g., ethnicity, health status). When true, enhanced consent and data processing controls are required for EU audience data associated with this segment. Relevant for pan-European distribution platforms and Ofcom-regulated services.']
  gender_qualifier varchar [note: 'Gender dimension of the demographic cell. \'All\' denotes combined-gender segments (e.g., Adults 18-49, Persons 2+). Aligns with Nielsen standard gender breakdowns used in GRP/TRP calculations and ad sales targeting.']
  geographic_scope varchar [note: 'The geographic level at which this demographic segment definition is applied. National segments are used for network-level ratings and upfront sales; DMA (Designated Market Area) segments apply to local market measurement; local applies to individual station markets; international for global distribution platforms.']
  grp_weight_factor decimal(10,6) [note: 'Weighting factor applied to this demographic segment when calculating Gross Rating Points (GRP) and Target Rating Points (TRP) in audience measurement reports. Reflects the relative population size and measurement panel representation of the segment. Sourced from the Nielsen Media Research Platform and used in Wide Orbit ad scheduling and campaign delivery calculations.']
  household_composition varchar [note: 'Classification of household structure for household-based demographic segments. Used in HUT (Homes Using Television) and PUT (Persons Using Television) audience measurement reporting and in family-oriented programming and advertising targeting strategies.']
  iab_audience_code varchar [note: 'The IAB Audience Taxonomy 2.0 standardized code corresponding to this demographic segment. Enables cross-platform audience targeting alignment between linear broadcast, OTT/AVOD/SVOD digital campaigns, and programmatic advertising systems. Used in Salesforce Media Cloud ad proposals and Adobe Experience Platform segment mapping.']
  income_quintile varchar [note: 'Household income quintile ranking (1=lowest 20%, 5=highest 20%) for income-based demographic segments. Populated only for income quintile segment types. Used in premium CPM pricing tiers and upfront ad sales targeting for high-value audience packages.']
  is_children_segment boolean [note: 'Indicates whether this demographic segment includes individuals under 13 years of age (e.g., K2-11, K2-5). Triggers COPPA compliance controls on data collection, ad targeting restrictions, and content rating enforcement. Critical for regulatory compliance in digital and broadcast advertising.']
  is_key_demo boolean [note: 'Flags whether this segment is designated as a key demographic (key demo) for the organization\'s primary ad sales and programming strategy. Key demos (typically A18-49, W25-54) command premium CPM rates and are the primary currency in upfront and scatter market negotiations.']
  is_nielsen_standard_cell boolean [note: 'Indicates whether this demographic segment corresponds to an official Nielsen standard demographic cell (e.g., A18-49, W25-54). True for Nielsen-defined cells used in GRP/TRP/HUT/PUT ratings calculations; False for custom or proprietary segments defined internally or via Adobe Experience Platform.']
  measurement_methodology varchar [note: 'The audience measurement methodology used to quantify this demographic segment. Panel-based measurement uses Nielsen People Meter panels; census-based uses set-top box or streaming data; hybrid combines both; modeled uses statistical projection. Determines data quality, confidence intervals, and applicability for regulatory reporting.']
  nielsen_cell_label varchar [note: 'The exact Nielsen Media Research standard cell label for this demographic segment (e.g., \'A18-49\', \'W25-54\', \'M18-34\', \'K2-11\', \'P2+\'). Used as the authoritative cross-reference when ingesting Nielsen ratings data and reconciling audience measurement reports from the Nielsen Media Research Platform.']
  nielsen_segment_code varchar [note: 'The native segment identifier assigned by the Nielsen Media Research Platform for this demographic cell. Used for direct API integration with Nielsen ratings data feeds, ensuring accurate mapping of audience measurement data to internal segment definitions.']
  platform_applicability varchar [note: 'Indicates the distribution platforms for which this demographic segment definition is applicable. Linear segments apply to traditional broadcast/cable measurement; digital applies to OTT/streaming (SVOD, AVOD, FAST); cross-platform spans both; all applies universally. Drives segment availability in Wide Orbit (linear) vs. Adobe Experience Platform (digital) targeting.']
  psychographic_profile varchar [note: 'Descriptive label for psychographic segment classification (e.g., \'Early Adopters\', \'Value Seekers\', \'Sports Enthusiasts\', \'News Junkies\'). Populated only for psychographic segment types. Derived from Adobe Experience Platform audience profiling and used in premium ad sales targeting and programming strategy.']
  reach_potential_pct decimal(5,2) [note: 'Estimated maximum reach potential expressed as a percentage of the segment universe achievable across the organization\'s full distribution footprint. Used in media planning to set realistic reach targets for ad campaigns and programming strategies. Sourced from Nielsen reach and frequency models.']
  regulatory_restriction_flag boolean [note: 'Indicates whether this demographic segment is subject to regulatory restrictions on data collection, targeting, or advertising. True for segments including minors (COPPA), sensitive demographic categories under GDPR Article 9, or segments subject to FCC advertising restrictions. Triggers compliance workflow in Adobe Experience Platform and Wide Orbit.']
  segment_code varchar [note: 'Externally-known alphanumeric code uniquely identifying the demographic segment, aligned with Nielsen and IAB standard cell codes (e.g., A18-49, W25-54, M18-34, K2-11, P2+). Used as the business-facing identifier in ad sales proposals, ratings reports, and audience targeting systems.']
  segment_description varchar [note: 'Full narrative description of the demographic segment\'s defining characteristics, measurement criteria, and intended use cases. Provides context for business users in ad sales, programming, and analytics teams on how to correctly apply and interpret the segment in audience measurement and targeting workflows.']
  segment_name varchar [note: 'Human-readable label for the demographic segment (e.g., \'Adults 18-49\', \'Women 25-54\', \'Men 18-34\', \'Kids 2-11\'). Used in reporting dashboards, ad sales presentations, and EPG audience targeting configurations.']
  segment_status varchar [note: 'Current lifecycle state of the demographic segment definition. Active segments are available for audience targeting, ad sales proposals, and ratings reporting. Deprecated segments are retained for historical continuity but no longer used in new campaigns or programming decisions.']
  segment_type varchar [note: 'Classification of the segment by its primary defining dimension. Distinguishes age/gender cells (Nielsen standard cells such as A18-49) from psychographic profiles, income quintiles, ethnicity classifications, behavioral clusters, and household composition segments. Drives which measurement methodology and data source applies.']
  sweeps_priority boolean [note: 'Indicates whether this demographic segment is a priority measurement target during Nielsen sweeps periods (February, May, July, November). Priority segments receive enhanced panel measurement and are the primary basis for affiliate compensation and ad rate card negotiations during sweeps.']
  universe_estimate varchar [note: 'Total estimated population count (universe) for this demographic segment in the measurement geography, as defined by Nielsen. Used as the denominator in ratings calculations (rating = audience / universe × 100). Updated periodically from Nielsen universe estimates and used in GRP, TRP, reach, and frequency reporting.']
  universe_estimate_year varchar [note: 'The calendar year for which the universe estimate is valid. Nielsen updates universe estimates annually; this field identifies the vintage of the estimate to ensure correct ratings calculations and year-over-year audience trend analysis.']
  updated_timestamp timestamp [note: 'The timestamp when this demographic segment record was most recently modified. Used for incremental data pipeline processing, change data capture, and audit compliance in the Databricks Lakehouse Silver Layer.']

  Note: 'Reference master for standardized audience demographic segments used across Nielsen ratings, ad sales, and programming decisions. Defines age/gender cells (A18-49, W25-54, M18-34, K2-11, etc.), psychographic segments, income quintiles, and ethnicity classifications aligned with Nielsen and IAB standards. Used as the authoritative classification for all audience targeting and measurement reporting.'
}

Table audience.sweeps_period {
  sweeps_period_id varchar [pk, note: 'Unique surrogate identifier for each Nielsen sweeps measurement period record in the Media Broadcasting audience data product.']
  daypart_id varchar [note: 'Foreign key linking to scheduling.daypart. Business justification: Sweeps periods define measurement windows where daypart performance drives rate card pricing and upfront negotiations; sweeps analysis is always daypart-stratified for demographic delivery validation ']
  regulatory_filing_id varchar [note: 'Foreign key linking to compliance.regulatory_filing. Business justification: Sweeps period results required in regulatory filings for performance documentation. FCC license renewals and ownership transfer applications reference sweeps ratings as public interest evidence.']
  regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: sweeps_period.regulatory_reporting_required flag indicates a named FCC compliance process. Linking to the specific regulatory_obligation formalizes which rule mandates sweeps measurement and reporting']
  audience_sample_size varchar [note: 'Total number of Nielsen panel respondents (diary participants or PPM device carriers) included in the measurement sample for this sweeps period. Larger sample sizes yield higher statistical confidence in ratings estimates.']
  blackout_markets varchar [note: 'Comma-separated list of DMA market codes where geographic broadcast blackout restrictions apply during this sweeps period. Blackout markets are excluded from certain ratings calculations and ad delivery reporting per FCC and contractual requirements.']
  ccpa_applicable boolean [note: 'Indicates whether CCPA viewer data privacy requirements apply to the measurement data collected during this sweeps period (e.g., for California DMA markets in scope). Governs opt-out rights and data sale restrictions for audience panel data.']
  coppa_applicable boolean [note: 'Indicates whether COPPA restrictions apply to audience data collected during this sweeps period, specifically for children\'s programming dayparts or platforms. Governs collection and use of audience data for viewers under 13.']
  data_release_status varchar [note: 'Indicates the current release state of Nielsen audience data for this sweeps period. \'unreleased\' = data not yet available; \'preliminary\' = fast affiliate estimates published; \'final\' = confirmed ratings delivered; \'revised_final\' = post-delivery corrections applied.']
  daypart_coverage varchar [note: 'Indicates which dayparts (time segments of the broadcast day) are included in the sweeps measurement scope. \'all_dayparts\' covers the full broadcast day; other values indicate restricted measurement windows. Daypart coverage affects which ad inventory can be rated and guaranteed.']
  demographic_breakdowns varchar [note: 'Comma-separated list of demographic segments for which Nielsen will provide audience measurement data during this sweeps period (e.g., \'A18-49,A25-54,W18-34,M18-49,HH\'). Determines which target audience guarantees can be supported for ad sales.']
  diary_return_rate_pct decimal(5,2) [note: 'For diary-methodology sweeps periods, the percentage of distributed Nielsen viewing diaries that were returned by respondents. A key data quality indicator; low return rates may trigger Nielsen data quality warnings or adjustments.']
  dma_list_version varchar [note: 'Version identifier of the Nielsen DMA market list applied during this sweeps period (e.g., \'DMA-2024-v1\'). Nielsen periodically revises DMA boundaries; this field ensures correct market mapping for historical comparisons.']
  duration_days varchar [note: 'Total number of calendar days in the sweeps measurement window (end_date minus start_date inclusive). Typically 28 days for standard Nielsen sweeps periods. Used in pacing and audience guarantee calculations.']
  end_date date [note: 'The official last day of the Nielsen sweeps measurement window as defined by Nielsen Media Research. Audience data collection and ratings calculations conclude on this date.']
  gdpr_applicable boolean [note: 'Indicates whether GDPR audience data privacy requirements apply to the measurement data collected during this sweeps period (e.g., for EU markets included in scope). Governs data retention, consent, and anonymization obligations for audience panel data.']
  grp_guarantee_applicable boolean [note: 'Indicates whether Gross Rating Point (GRP) audience guarantees negotiated during the upfront or scatter market apply to advertising campaigns running within this sweeps period. True = GRP guarantees in effect; False = no guarantees applicable.']
  hut_measurement_included boolean [note: 'Indicates whether Homes Using Television (HUT) level data is captured and reported as part of this sweeps period measurement. HUT data is used to calculate share and contextualize ratings within total available audience.']
  is_special_programming_flag boolean [note: 'Indicates whether special programming (e.g., season premieres, finales, major sporting events, stunting) was scheduled during this sweeps period that may inflate or distort ratings relative to non-sweeps periods. True = special programming present; False = standard schedule.']
  makegood_window_end_date date [note: 'The last date by which makegoods (compensatory ad spots issued when audience guarantees are not met) must be aired following this sweeps period. Defined in advertiser contracts and governed by Wide Orbit traffic system scheduling.']
  market_count varchar [note: 'Total number of Designated Market Areas (DMAs) included in this sweeps measurement period. Used to assess geographic coverage and local affiliate reporting obligations.']
  market_scope varchar [note: 'Indicates whether this sweeps period covers national audience measurement, local market (DMA) measurement, or both. Determines which ad sales rate cards and audience guarantees apply.']
  nielsen_contract_ref varchar [note: 'Reference number of the Nielsen Media Research contract or service agreement under which this sweeps period measurement is conducted. Used for billing reconciliation and SLA enforcement with Nielsen.']
  nielsen_sweep_code varchar [note: 'The externally-assigned Nielsen Media Research Platform identifier for this sweeps period (e.g., \'SWEEP-2024-NOV\'). Used to cross-reference records with Nielsen source data and reconcile audience measurement deliverables.']
  period_status varchar [note: 'Current lifecycle state of the sweeps period record. \'scheduled\' = future period confirmed by Nielsen; \'active\' = measurement currently in progress; \'completed\' = measurement concluded and data delivered; \'cancelled\' = period cancelled (rare); \'revised\' = dates or scope amended post-publication.']
  ppm_compliance_rate_pct decimal(5,2) [note: 'For PPM-methodology sweeps periods, the percentage of PPM panel members who met Nielsen\'s minimum daily wear-time compliance threshold. Low compliance rates may affect the statistical validity of ratings data.']
  preliminary_ratings_date date [note: 'The date on which Nielsen delivers preliminary (fast affiliate) ratings estimates for this sweeps period. Preliminary data is used for early ad sales negotiations before final ratings are confirmed.']
  put_measurement_included boolean [note: 'Indicates whether Persons Using Television (PUT) level data is captured and reported as part of this sweeps period measurement. PUT data enables person-level demographic audience analysis beyond household-level HUT data.']
  ratings_delivery_date date [note: 'The date on which Nielsen is contractually obligated to deliver final audience ratings data for this sweeps period to the broadcaster. Drives downstream ad sales billing, makegoods calculations, and audience guarantee reconciliation.']
  record_created_timestamp timestamp [note: 'The timestamp at which this sweeps period record was first created in the Media Broadcasting Databricks Silver layer data product. Supports audit trail and data lineage tracking.']
  record_updated_timestamp timestamp [note: 'The timestamp at which this sweeps period record was most recently modified in the Media Broadcasting Databricks Silver layer data product. Used for change tracking, SLA monitoring, and downstream refresh orchestration.']
  regulatory_reporting_required boolean [note: 'Indicates whether audience measurement data from this sweeps period must be submitted to a regulatory body (e.g., FCC, Ofcom) as part of broadcast licensing compliance or public interest reporting obligations.']
  source_last_updated_timestamp timestamp [note: 'The timestamp at which the source system (Nielsen Media Research Platform) last updated the record for this sweeps period. Used for incremental data ingestion and change detection in the Databricks Silver layer pipeline.']
  start_date date [note: 'The official first day of the Nielsen sweeps measurement window as defined by Nielsen Media Research. Audience data collection and ratings calculations begin on this date.']
  stunting_description varchar [note: 'Free-text description of any programming stunts or special events scheduled during this sweeps period (e.g., \'Season finale of flagship drama\', \'Super Bowl lead-out programming\'). Populated only when is_special_programming_flag is True.']
  sweep_month varchar [note: 'The calendar month in which the sweeps measurement period falls. Nielsen conducts four sweeps periods annually: February, May, July, and November. Drives programming strategy and ad rate negotiations.']
  sweep_name varchar [note: 'Human-readable label for the sweeps period (e.g., \'November 2024 Sweeps\', \'February 2025 Sweeps\'). Used in reports, ad sales proposals, and programming strategy documents.']
  sweep_year varchar [note: 'The four-digit calendar year in which the sweeps measurement period occurs (e.g., 2024). Used to uniquely identify the period in combination with sweep_month.']
  trp_guarantee_applicable boolean [note: 'Indicates whether Target Rating Point (TRP) audience guarantees for specific demographic targets apply to advertising campaigns running within this sweeps period. True = TRP guarantees in effect; False = no TRP guarantees applicable.']
  upfront_rate_card_applicable boolean [note: 'Indicates whether advertising rates negotiated during the upfront sales event apply to inventory sold within this sweeps period. True = upfront rate cards govern pricing; False = scatter market rates apply.']

  Note: 'Master record for each Nielsen sweeps measurement period (February, May, July, November) defining the official start and end dates, measurement methodology (diary vs. PPM), markets in scope, and special programming flags. Sweeps periods drive programming strategy, ad rate negotiations, and audience guarantee calculations. Sourced from Nielsen Media Research Platform.'
}

Table audience.panel {
  panel_id varchar [pk, note: 'Unique surrogate identifier for the audience measurement panel record in the lakehouse. Primary key for the audience_panel entity.']
  broadcast_license_id varchar [note: 'Foreign key linking to compliance.broadcast_license. Business justification: Panel recruitment and weighting tied to licensed station coverage areas. Nielsen panels structured around broadcast license service contours to ensure representative sampling for ratings currency.']
  territory_id varchar [note: 'Foreign key linking to rights.territory. Business justification: Audience panels are geographically recruited and must link to the primary broadcast facility serving that DMA for local market measurement, signal quality validation, and MRC accreditation audits. Rol']
  adobe_segment_code varchar [note: 'Identifier linking this audience panel definition to a corresponding audience segment or profile group in Adobe Experience Platform (AEP). Enables cross-platform audience activation by mapping Nielsen panel demographics to digital audience segments for personalization and targeted ad delivery.']
  code varchar [note: 'Externally-known alphanumeric code assigned by the measurement provider (e.g., Nielsen) to uniquely identify this panel within their system. Used for cross-system reconciliation with the Nielsen Media Research Platform.']
  cooperation_rate decimal(6,4) [note: 'Percentage of recruited panel households or individuals who are actively and consistently providing usable measurement data. A declining cooperation rate is an early indicator of panel quality degradation and may trigger MRC review. Expressed as a decimal (e.g., 0.8500 = 85%).']
  country_code varchar [note: 'ISO 3166-1 alpha-3 three-letter country code indicating the primary country of coverage for this panel (e.g., USA, GBR, AUS). Required for international panels and regulatory reporting to Ofcom and the European Audiovisual Observatory.']
  created_timestamp timestamp [note: 'Timestamp when this audience panel record was first created in the lakehouse Silver layer. Follows ISO 8601 format (yyyy-MM-ddTHH:mm:ss.SSSXXX). Used for data lineage, audit trails, and compliance with SOX financial reporting controls that require traceability of audience data used in revenue recognition.']
  data_collection_method varchar [note: 'Technical mechanism used to collect viewing data from panel members. Electronic meters (people meters) require active button-pressing; set-top-box (STB) and smart TV ACR (Automatic Content Recognition) are passive; diary is self-reported. Determines the granularity and reliability of minute-by-minute audience data.']
  demographic_composition varchar [note: 'Narrative or structured description of the demographic breakdowns captured by this panel (e.g., \'Age 2+, Adults 18-49, Adults 25-54, Persons 2-17, Households by income quintile\'). Defines which demographic cuts are available for TRP (Target Rating Point) calculations and demographic audience guarantees in ad sales.']
  effective_end_date date [note: 'Date on which this panel was retired or superseded by a newer panel vintage. Null for currently active panels. Used to scope historical ratings queries to the correct panel vintage and to manage panel transitions during sweeps periods.']
  effective_start_date date [note: 'Date on which this panel became the active currency measurement source for audience projections. Marks the beginning of the period for which this panel\'s data is used in ratings reports, ad sales guarantees, and GRP/TRP delivery calculations.']
  geographic_scope varchar [note: 'Breadth of geographic coverage represented by this panel. National panels project to the total US population; DMA (Designated Market Area) panels project to a specific local television market; International panels cover non-US territories.']
  measurement_currency_flag boolean [note: 'Indicates whether this panel is designated as the official currency measurement source for audience guarantees in advertising transactions. True = this panel\'s data is used as the contractual basis for GRP/TRP delivery and makegood calculations in upfront and scatter market deals. False = supplemental or research-only panel.']
  min_reportable_rating decimal(6,4) [note: 'The lowest audience rating value (expressed as a decimal fraction of the universe) that this panel can reliably report without exceeding acceptable statistical error thresholds. Ratings below this threshold are suppressed or flagged as unreliable. Typically expressed as a percentage (e.g., 0.0010 = 0.1%). Governed by MRC minimum cell size requirements.']
  mrc_accreditation_date date [note: 'Date on which the MRC most recently granted or renewed accreditation for this panel. Used to track accreditation currency and schedule renewal audits. Panels must maintain continuous accreditation to support upfront and scatter market ad sales guarantees.']
  mrc_accreditation_expiry_date date [note: 'Date on which the current MRC accreditation for this panel expires and must be renewed. Expiry triggers a mandatory re-audit process. Ad sales teams must be notified of impending expiry to manage risk on guaranteed audience delivery commitments.']
  mrc_accreditation_status varchar [note: 'Current accreditation status granted by the Media Rating Council (MRC) for this panel. MRC accreditation is the industry standard for currency-grade audience measurement. Accredited panels are required for guaranteed ad buys and upfront sales commitments. Non-accredited panels cannot be used as primary currency.']
  name varchar [note: 'Human-readable name of the audience measurement panel (e.g., \'Nielsen National People Meter 2024\', \'Nielsen Local People Meter — New York DMA\'). Used in reporting, dashboards, and ad sales presentations.']
  nielsen_panel_code varchar [note: 'Nielsen\'s proprietary internal identifier for this panel as maintained in the Nielsen Media Research Platform. Used for direct API integration, data feed reconciliation, and cross-referencing Nielsen ratings reports. Distinct from the internal audience_panel_id surrogate key.']
  notes varchar [note: 'Free-text field for capturing operational notes, known data quality issues, methodology changes, or special considerations associated with this panel (e.g., \'Sample boosted in Q3 2023 for Hispanic demographic\', \'Methodology change effective Jan 2024 — includes streaming\'). Used by audience analytics and ad sales teams.']
  out_of_home_measurement_flag boolean [note: 'Indicates whether this panel captures out-of-home (OOH) viewing, such as viewing in bars, hotels, airports, and other public venues. OOH measurement is captured via Portable People Meter (PPM) technology. OOH-inclusive panels produce higher total audience estimates than in-home-only panels.']
  panel_status varchar [note: 'Current lifecycle state of the audience panel. Active panels are used for currency-grade audience projections. Suspended panels are temporarily halted due to quality or compliance issues. Retired panels are decommissioned and replaced by newer vintages.']
  panel_type varchar [note: 'Classification of the audience measurement methodology used by this panel. National People Meter (NPM) and Local People Meter (LPM) are electronic metered panels; Portable People Meter (PPM) captures out-of-home exposure; Diary is self-reported; Return Path Data (RPD) is set-top-box passback data; Hybrid combines multiple methods.']
  recruitment_methodology varchar [note: 'Statistical sampling approach used to recruit panel members. Probability-based sampling (address-based or random-digit-dial) is required for MRC-accredited currency panels. Opt-in panels are used for supplemental or proprietary measurement. Affects the projectability and accreditation status of the panel.']
  refresh_frequency varchar [note: 'Cadence at which panel membership is rotated or refreshed to prevent panel conditioning effects and maintain demographic representativeness. Annual and biennial refreshes are standard for people meter panels; continuous recruitment is used for large-scale return path data panels.']
  reporting_granularity varchar [note: 'Finest time interval at which this panel can produce reliable audience estimates. Minute-by-minute granularity is available from electronic people meter panels and supports DAI (Dynamic Ad Insertion) optimization. Quarter-hour is standard for diary panels. Determines compatibility with EPG-based program-level ratings reporting.']
  sampling_error_pct decimal(6,4) [note: 'Estimated margin of error (as a percentage) for audience projections derived from this panel at a 95% confidence interval. Smaller panels have higher sampling error. Used by ad sales teams to communicate measurement uncertainty to advertisers and to set makegood thresholds for audience delivery shortfalls.']
  size_households varchar [note: 'Total number of sample households actively participating in this panel at any given time. Drives the statistical reliability and margin of error of projected audience estimates. A larger panel size yields lower sampling error for low-rated programs.']
  size_individuals varchar [note: 'Total number of individual persons (panelists) actively measured within this panel. Distinct from household count because multiple individuals per household are measured for demographic breakdowns used in Target Rating Point (TRP) calculations.']
  streaming_measurement_flag boolean [note: 'Indicates whether this panel captures streaming and OTT (Over-The-Top) viewing in addition to linear broadcast. Streaming-enabled panels support cross-platform audience measurement combining linear TV, SVOD, AVOD, and FAST channel viewing for total audience reporting.']
  sweeps_eligible_flag boolean [note: 'Indicates whether this panel is used during Nielsen Sweeps periods (February, May, July, November) for local market ratings measurement. Sweeps data drives local ad rates and program scheduling decisions. Only MRC-accredited panels with sufficient local market sample sizes are sweeps-eligible.']
  universe_estimate varchar [note: 'Total projected population size (in persons or households) that this panel is designed to represent. The universe estimate is the denominator used to convert raw panel viewing counts into ratings percentages (e.g., HUT, PUT, Share). Updated periodically based on census data.']
  universe_estimate_type varchar [note: 'Specifies whether the universe_estimate represents total households, total persons, or TV households (HUT-eligible). TV households are the standard denominator for HUT (Homes Using Television) calculations in broadcast ratings.']
  updated_timestamp timestamp [note: 'Timestamp when this audience panel record was most recently modified in the lakehouse Silver layer. Follows ISO 8601 format (yyyy-MM-ddTHH:mm:ss.SSSXXX). Used to detect stale panel configurations and trigger downstream recalculation of audience projections dependent on this panel.']
  vintage_year varchar [note: 'Calendar year in which this panel sample was designed and recruited. Panels are periodically refreshed to maintain demographic representativeness as the population changes. Vintage year is used to track panel age and schedule mandatory refreshes per MRC accreditation requirements.']
  weighting_factor decimal(10,6) [note: 'Numeric multiplier applied to this panel\'s raw viewing data to project sample observations to the total universe estimate. A weighting factor greater than 1.0 indicates the panel under-represents a demographic segment relative to the population. Used in GRP and TRP calculations.']
  weighting_methodology varchar [note: 'Description of the statistical weighting approach applied to panel data to correct for demographic imbalances and non-response bias (e.g., \'Iterative Proportional Fitting / Raking\', \'Post-stratification weighting by age/sex/race/income\'). Critical for ensuring projected audience estimates are representative of the total population.']

  Note: 'Master record representing a Nielsen or proprietary audience measurement panel — a statistically representative sample of households or individuals used to project viewership to the total population. Captures panel type (Nielsen National People Meter, Nielsen Local People Meter, PPM, Diary, Return Path Data), panel size, geographic coverage (national or DMA-specific), demographic composition, panel vintage, recruitment methodology, weighting factors, and MRC accreditation status. Foundation for all projected audience estimates and the basis for measurement credibility.'
}

Table audience.viewership_record {
  viewership_record_id varchar [pk, note: 'Unique surrogate identifier for each granular viewership record in the Silver Layer lakehouse. Primary key for this entity.']
  affiliate_agreement_id varchar [note: 'Foreign key linking to partner.affiliate_agreement. Business justification: Viewership records for affiliate-carried programming must be attributed to the affiliate agreement to track local insertion rights usage, validate simulcast compliance, and support retransmission reve']
  audience_profile_id varchar [note: 'Foreign key linking to audience.audience_profile. Business justification: audience_profile is the anonymized/pseudonymized audience member identity within this domain. viewership_record already has viewer_profile_id pointing to subscriber.viewer_profile (cross-domain subscr']
  campaign_id varchar [note: 'FK namespace reconciled: column describes advertising concept but references sales domain entity']
  channel_id varchar [note: 'Reference to the broadcast channel or streaming platform channel on which the content was delivered. Used for channel-level ratings aggregation, share calculations, and carriage fee reporting.']
  compliance_content_rating_id varchar [note: 'Foreign key linking to compliance.content_rating. Business justification: Viewership tracking must enforce age-appropriate content delivery based on rating system for parental controls and COPPA compliance. Core requirement for subscriber protection and regulatory adherence']
  daypart_id varchar [note: 'Foreign key linking to scheduling.daypart. Business justification: Viewership records require daypart attribution for CPM calculation, demographic targeting validation, rate card application, and daypart performance analysis - core to ad sales pricing and inventory m']
  delivery_channel_id varchar [note: 'Foreign key linking to distribution.delivery_channel. Business justification: Viewership records must be attributed to the specific delivery channel (FAST, linear, MVPD) for channel-level audience measurement and performance reporting. \'delivery_type\' is a plain string that par']
  demographic_segment_id varchar [note: 'Foreign key linking to audience.demographic_segment. Business justification: Viewership records are classified by demographic segment for aggregation into Nielsen ratings. The demographic_age_band and demographic_gender should be replaced with FK to demographic_segment for con']
  device_type_id varchar [note: 'Hashed device identifier (e.g., hashed advertising ID, set-top box serial hash, or streaming device fingerprint) from which the viewing session originated. Pseudonymized to prevent direct device tracking per GDPR and CCPA. Used for device-level reach and frequency analysis.']
  distribution_partner_id varchar [note: 'Foreign key linking to distribution.distribution_partner. Business justification: Viewership records sourced from MVPD/cable distribution partners must be attributed to the specific distribution partner for partner-level audience reporting, carriage fee reconciliation, and retransm']
  household_id varchar [note: 'Hashed/anonymized identifier representing the household unit from which the viewing event originated, derived from set-top box or ACR data. Pseudonymized per GDPR Article 25 and CCPA Section 1798.100 to prevent direct re-identification. Used for Nielsen household-level ratings aggregation and HUT (Homes Using Television) calculations.']
  nielsen_rating_id varchar [note: 'Foreign key linking to audience.nielsen_rating. Business justification: viewership_record carries a denormalized nielsen_program_rating (DECIMAL) column that duplicates data from the authoritative nielsen_rating record. Adding nielsen_rating_id as a FK to the nielsen_rati']
  panel_id varchar [note: 'Foreign key linking to audience.panel. Business justification: Viewership records sourced from panel measurement (as opposed to ACR or streaming logs) must reference the panel they originate from. The acr_source field indicates multiple data collection methods; p']
  playback_session_id varchar [note: 'External business identifier for the viewing session as assigned by the source system (Adobe Experience Platform, set-top box telemetry, or streaming platform). Used to correlate records across ingestion pipelines and deduplicate events from multiple sources.']
  production_episode_id varchar [note: 'Foreign key linking to production.production_episode. Business justification: Episode-level viewership tracking is standard for streaming platforms. Required for completion rate analysis, binge-watching pattern detection, and dynamic ad insertion targeting. Core operational lin']
  production_project_id varchar [note: 'Foreign key linking to production.project. Business justification: Streaming viewership records must link to production projects for rights reporting, content performance dashboards, and recommendation algorithm training. Essential for VOD/SVOD platform operations an']
  program_schedule_id varchar [note: 'Foreign key linking to scheduling.program_schedule. Business justification: Viewership records must roll up to program_schedule level for daily performance reporting, as-run log reconciliation, schedule effectiveness analysis, and billing verification - essential for broadcas']
  schedule_slot_id varchar [note: 'Reference to the specific scheduled airing or playout event from the Electronic Program Guide (EPG) that the viewer tuned into. Links to the program schedule managed in Ericsson MediaFirst. Null for on-demand (VOD/SVOD) sessions.']
  subscriber_id varchar [note: 'Reference to the authenticated subscriber account from Zuora subscription billing, populated for SVOD and authenticated AVOD sessions. Null for anonymous linear broadcast or unauthenticated OTT viewing.']
  sweeps_period_id varchar [note: 'Foreign key linking to audience.sweeps_period. Business justification: viewership_record currently carries is_sweeps_period as a BOOLEAN flag, which only indicates whether the record falls within a sweeps period but loses the specific period identity. Replacing this with']
  syndication_agreement_id varchar [note: 'Foreign key linking to partner.syndication_agreement. Business justification: Viewership records for syndicated content must be attributed to the specific syndication agreement to validate barter spot obligations, performance guarantees, and per-episode fee calculations. Syndic']
  title_id varchar [note: 'Reference to the content asset being viewed, linking to the content master catalog. Enables join to content metadata including title, genre, production details, and rights windows.']
  version_id varchar [note: 'Foreign key linking to content.version. Business justification: Streaming/VOD viewership must track which content version (resolution, language, platform-specific cut) was consumed for QC reporting, rights compliance verification, and platform-specific audience me']
  viewer_profile_id varchar [note: 'Hashed/anonymized identifier representing an individual viewer within a household, derived from Adobe Experience Platform profile resolution or subscriber login. Pseudonymized per GDPR and CCPA. Used for PUT (Persons Using Television) and individual-level demographic analytics.']
  acr_source varchar [note: 'The data collection methodology or source system that generated this viewership record. ACR = Automatic Content Recognition from smart TV; set_top_box = return-path data from cable/satellite STB; streaming_telemetry = OTT platform event stream via Adobe Experience Platform; panel = Nielsen People Meter panel; return_path = MVPD return-path data.']
  ad_break_count varchar [note: 'Number of ad breaks (ad pods) encountered by the viewer during this viewing session. Used for DAI (Dynamic Ad Insertion) reconciliation, Wide Orbit affidavit verification, and advertiser delivery reporting.']
  ads_viewed_count varchar [note: 'Total number of individual advertisement spots viewed (not skipped) by the viewer during this session. Used for AVOD monetization reporting, CPM impression counting, and advertiser campaign delivery verification against Wide Orbit schedules.']
  audience_share decimal(6,4) [note: 'The percentage of HUT (Homes Using Television) or PUT (Persons Using Television) tuned to this channel/program at the time of viewing, as reported by Nielsen. Share differs from rating in that it measures the proportion of active viewers rather than the total universe. Used for competitive programming analysis.']
  blackout_applied boolean [note: 'Indicates whether a geographic blackout restriction was applied to this viewing session, preventing delivery of specific content in the viewer\'s DMA or region per rights agreements. Used for blackout compliance auditing and retransmission consent reporting.']
  broadcast_date date [note: 'The calendar date (yyyy-MM-dd) of the broadcast or streaming session, in the local broadcast timezone. Used as the primary date dimension for daily ratings aggregation, sweeps period attribution, and Nielsen overnight ratings reporting.']
  cdn_edge_node varchar [note: 'Identifier of the Akamai CDN edge node or point-of-presence (PoP) that served the streaming content for this session. Used for CDN performance analysis, SLA compliance monitoring, and geographic delivery optimization.']
  completion_rate decimal(5,4) [note: 'Proportion of the content asset viewed during this session, expressed as a decimal between 0.0000 and 1.0000 (e.g., 0.7500 = 75% viewed). Sourced directly from platform telemetry; not derived within this product. Used for engagement scoring, programming decisions, and advertiser reporting.']
  content_duration_seconds varchar [note: 'Total runtime in seconds of the full content asset or scheduled airing being viewed. Used as the denominator for completion rate calculations and to determine whether a full viewing occurred.']
  country_code varchar [note: 'Three-letter ISO 3166-1 alpha-3 country code of the viewer\'s geographic location at time of viewing. Used for international rights windowing compliance, GDPR/CCPA jurisdictional determination, and Ofcom/FCC regulatory reporting.']
  data_source_system varchar [note: 'Identifies the operational system of record from which this viewership record was ingested into the Silver Layer. Used for data lineage tracking, quality auditing, and source-system reconciliation.']
  delivery_type varchar [note: 'Classification of how the content was delivered to the viewer. Linear = traditional scheduled broadcast; VOD = on-demand; SVOD = subscription on-demand; AVOD = ad-supported on-demand; TVOD = transactional/pay-per-view; FAST = Free Ad-Supported Streaming Television; Simulcast = simultaneous multi-platform broadcast. Critical for rights windowing compliance and revenue attribution. [ENUM-REF-CANDIDATE: linear|vod|svod|avod|tvod|fast|simulcast — 7 candidates stripped; promote to reference product]']
  device_type varchar [note: 'Category of device used to consume the content. Used for device-level audience segmentation, ad targeting eligibility, and platform-specific reach reporting. [ENUM-REF-CANDIDATE: tv|set_top_box|mobile|tablet|desktop|smart_tv|streaming_stick|gaming_console|dvr — promote to reference product]']
  drm_protected boolean [note: 'Indicates whether the content stream was delivered with DRM (Digital Rights Management) encryption active during this session. Used for rights compliance auditing, anti-piracy reporting to MPA, and content protection SLA verification.']
  duration_viewed_seconds varchar [note: 'Total number of seconds the viewer actively watched the content during this session, as reported by the source telemetry system. Accounts for pauses and buffering exclusions per platform telemetry rules. Used for TSR (Time Spent Reading/Viewing) calculations and completion rate derivation.']
  ingestion_timestamp timestamp [note: 'The date and time when this viewership record was first loaded into the Databricks Silver Layer lakehouse. Used for data freshness monitoring, SLA compliance, and audit trail purposes. Distinct from tune_in_timestamp (business event time).']
  is_authenticated boolean [note: 'Indicates whether the viewer was authenticated (logged in) at the time of viewing. Authenticated sessions enable individual-level audience measurement and subscriber-linked analytics. Unauthenticated sessions rely on household or device-level inference.']
  last_updated_timestamp timestamp [note: 'The date and time when this viewership record was last modified in the Silver Layer, for example due to late-arriving data corrections, Nielsen restatement, or session completion updates. Used for incremental processing and audit trail.']
  platform_type varchar [note: 'The distribution platform category through which the content was delivered. Used for multi-platform audience aggregation, MVPD/vMVPD carriage reporting, and OTT vs. linear audience segmentation. [ENUM-REF-CANDIDATE: broadcast|cable|satellite|ott|mvpd|vmvpd|web|mobile|podcast|social — promote to reference product]']
  playback_position_seconds varchar [note: 'The content offset position in seconds at which the viewer stopped watching (tune-out position within the asset). For linear broadcast, this reflects the offset from the scheduled start of the program. Used for resume-point analytics and mid-roll ad delivery attribution.']
  stream_quality varchar [note: 'The video quality level at which the content was delivered during this session, as reported by the ABR (Adaptive Bitrate Streaming) player or CDN telemetry from Akamai. Used for quality-of-experience reporting, CDN SLA compliance, and premium content delivery analytics.']
  tune_in_timestamp timestamp [note: 'The precise date and time (ISO 8601 with timezone offset) when the viewer began watching the content or tuned to the channel. This is the principal business event timestamp for the viewership record. Used for daypart analysis, time-spent calculations, and sweeps period attribution.']
  tune_out_timestamp timestamp [note: 'The precise date and time (ISO 8601 with timezone offset) when the viewer stopped watching, changed channel, or the session ended. Used in conjunction with tune_in_timestamp to calculate duration_viewed_seconds.']
  viewing_status varchar [note: 'Current lifecycle status of the viewing session record. \'completed\' = viewer watched to end or tune-out cleanly; \'in_progress\' = session still active at ingestion time; \'abandoned\' = viewer left before 10% completion; \'interrupted\' = session ended due to technical failure; \'error\' = telemetry data quality issue flagged.']

  Note: 'Granular transactional record of audience viewing activity for a specific content airing or stream session, capturing tuning start/end timestamps, channel or platform, device type, household or individual viewer identifier (anonymized/hashed per GDPR/CCPA), duration viewed, and completion rate. Aggregated from set-top box data, ACR (Automatic Content Recognition), and streaming platform telemetry via Adobe Experience Platform integration.'
}

Table audience.reach_frequency_report {
  reach_frequency_report_id varchar [pk, note: 'Unique surrogate identifier for each reach and frequency report record in the Silver Layer lakehouse. Primary key for this transactional entity.']
  ad_billing_order_id varchar [note: 'Foreign key linking to billing.ad_billing_order. Business justification: Reach/frequency reports are the primary post-buy validation tool for ad billing orders — they confirm whether ordered GRPs/TRPs were delivered, directly triggering final billing, makegood issuance, or']
  ad_order_id varchar [note: 'Foreign key linking to sales.ad_order. Business justification: Reach/frequency reports are generated per ad order to validate contracted vs. delivered GRP/impressions and trigger makegood determinations. Campaign-level FK exists but order-level reporting is a dis']
  advertiser_id varchar [note: 'FK namespace reconciled: column describes advertising concept but references sales domain entity']
  affiliate_agreement_id varchar [note: 'Foreign key linking to partner.affiliate_agreement. Business justification: Reach/frequency reports measure affiliate station audience delivery against agreement performance standards. Networks use these reports to assess affiliate compliance with minimum clearance percentage']
  campaign_id varchar [note: 'Reference to the advertising campaign for which this reach and frequency report was produced. Links to the campaign master record in Salesforce Media Cloud. Used for post-campaign delivery validation and upfront guarantee reconciliation.']
  channel_id varchar [note: 'Foreign key linking to scheduling.channel. Business justification: Reach/frequency reports are generated for specific networks/channels to measure campaign delivery by channel. Direct channel link enables automated report generation, channel-specific reach analysis, ']
  content_episode_id varchar [note: 'Foreign key linking to content.content_episode. Business justification: Reach and frequency reports for advertisers are built at the episode level — agencies require episode-level R&F to validate GRP delivery against specific program buys and to trigger makegood obligatio']
  daypart_id varchar [note: 'Reference to the daypart (time segment of the broadcast day) for which audience measurement was computed. Links to the daypart reference product. Used to segment reach and frequency metrics by time-of-day for programming and ad sales analysis.']
  demographic_segment_id varchar [note: 'Reference to the demographic segment (e.g., Adults 18-49, Women 25-54) against which reach and frequency metrics are measured. Links to the demographic segment reference product sourced from Nielsen Media Research Platform. Central to Target Rating Point (TRP) calculations and ad sales guarantees.']
  guarantee_id varchar [note: 'Foreign key linking to audience.guarantee. Business justification: Reach and frequency reports are the primary mechanism for reconciling audience delivery guarantees. A reach_frequency_report is generated to measure actual delivery against a guarantee commitment (gua']
  ott_platform_id varchar [note: 'Foreign key linking to distribution.ott_platform. Business justification: Reach/frequency reports are generated per OTT platform for media planning and advertiser delivery reporting. \'platform_type\' is a denormalized string that should be replaced by a proper FK to ott_plat']
  panel_id varchar [note: 'Foreign key linking to audience.panel. Business justification: Reach and frequency reports are computed from panel-based audience measurement. Linking reach_frequency_report to the panel used for measurement enables quality assessment (MRC accreditation, cooperat']
  partner_id varchar [note: 'Foreign key linking to partner.partner_partner. Business justification: Reach/frequency reports are often generated for specific distribution or syndication partners to demonstrate audience delivery against contractual obligations. Required for partner performance reporti']
  political_ad_record_id varchar [note: 'Foreign key linking to compliance.political_ad_record. Business justification: Reach/frequency reports for political campaigns require public inspection file linkage per FCC rules. Demonstrates delivery of reasonable access and documents audience delivery for political advertise']
  regulatory_filing_id varchar [note: 'Foreign key linking to compliance.regulatory_filing. Business justification: Reach/frequency reports are formally submitted in FCC regulatory filings for political advertising equal opportunities compliance and public interest reporting. Compliance teams need this link to asse']
  sweeps_period_id varchar [note: 'Foreign key linking to audience.sweeps_period. Business justification: Reach/frequency reports during sweeps periods are used for guarantee verification and makegood calculations. The is_sweeps_period flag indicates relevance, but the specific sweeps period should be ref']
  syndication_agreement_id varchar [note: 'Foreign key linking to partner.syndication_agreement. Business justification: Reach/frequency reports are generated specifically to validate syndication agreement performance guarantees and revenue share calculations. Syndicators require these reports per agreement to confirm a']
  audience_share_pct decimal(7,4) [note: 'The percentage of the total viewing audience (persons using television) that was watching the specific network or program during the measurement period. Calculated as the program\'s audience divided by the total HUT/PUT audience. Used for competitive programming analysis and ad sales positioning.']
  average_frequency decimal(8,4) [note: 'The average number of times a unique viewer within the target demographic was exposed to the content or campaign during the measurement period. Calculated as total impressions divided by unduplicated reach. Core metric for evaluating campaign saturation and makegoods calculation.']
  cpm decimal(10,4) [note: 'The cost per one thousand audience impressions for the campaign or programming block, expressed in USD. Used by ad sales for post-campaign delivery validation, scatter market pricing justification, and makegood valuation. Confidential as it reflects negotiated commercial pricing.']
  cprp decimal(10,4) [note: 'The cost per one rating point delivered against the target demographic segment, expressed in USD. The primary pricing metric for linear TV advertising transactions. Used for upfront guarantee reconciliation, makegood valuation, and scatter market pricing. Confidential as it reflects negotiated commercial pricing.']
  created_timestamp timestamp [note: 'Audit timestamp recording when this reach and frequency report record was first ingested into the Silver Layer lakehouse. Used for data lineage tracking and pipeline monitoring.']
  currency_code varchar [note: 'The ISO 4217 three-letter currency code for all monetary values in this report (CPM, CPRP). Defaults to USD for domestic US markets. Required for international market reports and multi-currency financial reconciliation under SOX compliance.']
  delivery_variance_pct decimal(7,4) [note: 'The percentage difference between the guaranteed audience delivery (GRP or TRP) and the actual delivered audience for the campaign flight. A negative value indicates under-delivery triggering makegood obligations; a positive value indicates over-delivery. Used for upfront guarantee reconciliation and scatter market adjustments.']
  effective_reach_1plus varchar [note: 'The count of unique persons exposed to the content or campaign at least one time (1+) during the measurement period. Equivalent to reach_persons; included as an explicit effective reach threshold field for consistency with N+ reporting framework used in post-campaign analysis.']
  effective_reach_3plus varchar [note: 'The count of unique persons exposed to the content or campaign at least three times (3+) during the measurement period. The industry-standard effective reach threshold used to assess whether sufficient frequency was achieved for advertising message recall. Critical for makegoods determination and campaign effectiveness evaluation.']
  effective_reach_nplus varchar [note: 'The count of unique persons exposed to the content or campaign at least N times (as defined by effective_reach_threshold) during the measurement period. Provides a configurable effective reach metric for custom campaign guarantee structures and advanced frequency analysis.']
  effective_reach_threshold varchar [note: 'The minimum number of exposures (N) used to define effective reach for this specific report. Configurable per campaign or client agreement (e.g., 3 for standard campaigns, 5 for high-frequency campaigns). Determines the N+ threshold applied in effective reach calculations beyond the standard 1+ and 3+ fields.']
  grp decimal(10,4) [note: 'The sum of all rating points delivered by the campaign or programming block during the measurement period, representing total audience weight without deduplication. Calculated as reach percentage multiplied by average frequency. The primary currency for linear TV advertising transactions and upfront sales guarantees.']
  hut_rating decimal(7,4) [note: 'The percentage of all television households in the market that had their television sets in use during the measurement period. Sourced from Nielsen Media Research Platform. Used as a contextual benchmark for evaluating audience share and competitive programming performance.']
  is_makegood_required boolean [note: 'Indicates whether this reach and frequency report has identified an audience delivery shortfall that requires a makegood (compensatory ad spot) to be issued to the advertiser. Triggers the makegood workflow in Wide Orbit and Salesforce Media Cloud when set to True.']
  is_sweeps_period boolean [note: 'Indicates whether the measurement period falls within a Nielsen sweeps period (an intensive ratings measurement period typically occurring in February, May, July, and November). Sweeps data carries elevated importance for programming decisions, ad rate setting, and affiliate compensation calculations.']
  measurement_period_end_date date [note: 'The last date of the measurement window for which reach and frequency metrics are computed. Defines the end boundary of the campaign flight, programming block, or sweeps period being analyzed.']
  measurement_period_start_date date [note: 'The first date of the measurement window for which reach and frequency metrics are computed. Defines the start boundary of the campaign flight, programming block, or sweeps period being analyzed. Used in conjunction with measurement_period_end_date to bound the audience measurement interval.']
  measurement_type varchar [note: 'Classifies the type of measurement window for which this report was generated. \'campaign_flight\' covers a defined ad campaign run; \'programming_block\' covers a scheduled content block; \'daypart_window\' covers a standard broadcast daypart; \'sweeps_period\' covers an intensive Nielsen ratings measurement period; \'custom_window\' covers an ad hoc analysis window.']
  nielsen_report_code varchar [note: 'The native report identifier assigned by the Nielsen Media Research Platform for this reach and frequency dataset. Used for source system traceability, data lineage, and reconciliation between the lakehouse Silver Layer and the Nielsen source system.']
  put_rating decimal(7,4) [note: 'The percentage of all persons in the target demographic who were watching television during the measurement period. Sourced from Nielsen Media Research Platform. Used alongside HUT to assess total available audience and calculate audience share for programming decisions.']
  reach_pct decimal(7,4) [note: 'The percentage of the target demographic universe reached at least once during the measurement period, calculated as (reach_persons / universe_estimate) × 100. Expressed as a decimal percentage (e.g., 45.2500 = 45.25%). Used by ad sales for post-campaign delivery reporting and scatter market pricing justification.']
  reach_persons varchar [note: 'The unduplicated count of unique persons within the target demographic segment who were exposed to the content or campaign at least once during the measurement period. The primary reach metric sourced from Nielsen Media Research Platform. Used for post-campaign delivery validation and upfront guarantee reconciliation.']
  report_generated_timestamp timestamp [note: 'The principal real-world event timestamp when this reach and frequency report was generated and delivered by the Nielsen Media Research Platform. Represents the business event time, distinct from audit timestamps. Used to track Nielsen data delivery SLAs and post-campaign reporting timeliness.']
  report_number varchar [note: 'Externally-known business identifier for this reach and frequency report, sourced from the Nielsen Media Research Platform. Used by ad sales teams to reference specific post-campaign delivery reports in client communications, makegoods negotiations, and upfront guarantee reconciliation.']
  report_status varchar [note: 'Current lifecycle state of the reach and frequency report. \'draft\' indicates in-progress computation; \'preliminary\' indicates initial Nielsen delivery pending validation; \'final\' indicates validated and approved for client delivery; \'revised\' indicates a corrected reissue; \'superseded\' indicates replaced by a newer version; \'archived\' indicates retired from active use.']
  report_version varchar [note: 'The version number of this reach and frequency report, incremented each time a revised or corrected report is issued by Nielsen or reprocessed in the lakehouse. Version 1 represents the initial delivery; subsequent versions represent corrections or revisions. Used to ensure ad sales teams are working with the most current data.']
  total_impressions varchar [note: 'The total number of audience exposures (duplicated) to the content or campaign during the measurement period. Equals reach_persons multiplied by average_frequency. Used as the gross delivery metric for CPM-based advertising transactions and campaign pacing analysis.']
  trp decimal(10,4) [note: 'The sum of rating points delivered specifically against the target demographic segment during the measurement period. Analogous to GRP but scoped to the defined target audience rather than the total population. Used for targeted advertising guarantee reconciliation and CPRP calculations.']
  universe_estimate varchar [note: 'The total estimated population size (in persons or households) of the target demographic segment in the specified market, as defined by Nielsen. Serves as the denominator for reach percentage calculations and rating point computations. Expressed as an absolute count.']
  updated_timestamp timestamp [note: 'Audit timestamp recording when this reach and frequency report record was last modified in the Silver Layer lakehouse. Tracks revisions, status changes, and data corrections.']

  Note: 'Transactional record capturing computed reach (unduplicated audience count), frequency (average exposures per unique viewer), and effective reach (viewers exposed N+ times) for a defined campaign flight, programming block, or daypart window across a specified demographic segment, market, and measurement period. Sourced from Nielsen Media Research Platform. Used by ad sales for post-campaign delivery validation, makegoods calculation, upfront guarantee reconciliation, and scatter market pricing justification.'
}

Table audience.guarantee {
  guarantee_id varchar [pk, note: 'Unique surrogate identifier for the audience delivery guarantee record. Primary key for the audience_guarantee data product in the Silver Layer lakehouse.']
  ad_order_id varchar [note: 'Foreign key linking to sales.ad_order. Business justification: Audience guarantees are fulfilled through specific ad orders. Operations teams track which ad_order is executing a given GRP guarantee for delivery reconciliation and makegood triggering — a core name']
  advertiser_id varchar [note: 'Reference to the advertiser (party) to whom the audience delivery guarantee is committed. Sourced from Salesforce Media Cloud account records.']
  affiliate_agreement_id varchar [note: 'Foreign key linking to partner.affiliate_agreement. Business justification: Audience guarantees issued to advertisers on affiliate-carried programming are governed by the affiliate agreement\'s local ad avails and clearance obligations. Linking guarantee to affiliate_agreement']
  billing_account_id varchar [note: 'The opportunity identifier in Salesforce Media Cloud CRM linked to this audience guarantee. Enables traceability from the sales pipeline through to audience delivery commitment and reconciliation.']
  campaign_id varchar [note: 'Reference to the advertising campaign for which this audience delivery guarantee is established. Links to the campaign record in Salesforce Media Cloud or Wide Orbit.']
  demographic_segment_id varchar [note: 'Foreign key linking to audience.demographic_segment. Business justification: Guarantees target specific standardized demographic segments (e.g., A18-49, W25-54). The target_demographic_code and target_demographic_description are redundant with demographic_segment reference dat']
  guarantee_channel_id varchar [note: 'Foreign key linking to scheduling.channel. Business justification: Audience guarantees are often negotiated at the network/channel level for upfront deals. Direct channel link enables automated guarantee reconciliation, makegood issuance by channel, and channel-speci']
  guarantee_network_channel_id varchar [note: 'Reference to the television network or channel on which the guaranteed audience delivery is to be achieved. Links to the network/channel master record used in scheduling and playout systems.']
  ott_platform_id varchar [note: 'Foreign key linking to distribution.ott_platform. Business justification: Audience guarantees are platform-specific — an OTT guarantee is tied to a specific platform (e.g., Peacock GRP guarantee). \'platform_type\' is a denormalized string. Linking guarantee to ott_platform e']
  panel_id varchar [note: 'Foreign key linking to audience.panel. Business justification: Audience delivery guarantees are measured against a specific Nielsen or proprietary panel. The panel defines the universe estimate, measurement methodology, and MRC accreditation status that governs w']
  partner_id varchar [note: 'Foreign key linking to partner.partner_partner. Business justification: Audience guarantees are contractual commitments made to specific partners (advertisers, agencies, networks). Tracking the partner receiving the guarantee is essential for makegood fulfillment and cont']
  political_ad_record_id varchar [note: 'Foreign key linking to compliance.political_ad_record. Business justification: Political advertising guarantees require special tracking for equal time and reasonable access compliance. Links guarantee delivery to political ad records for FCC public file documentation.']
  sales_proposal_id varchar [note: 'Foreign key linking to sales.sales_proposal. Business justification: Audience guarantees are negotiated and documented in sales proposals before being formalized in orders. Proposals specify guarantee terms (GRP/TRP thresholds, makegood provisions) that become contract']
  scheduling_daypart_id varchar [note: 'Foreign key linking to scheduling.daypart. Business justification: Upfront guarantees specify daypart-level GRP/TRP commitments (e.g., Prime 18-49 rating guarantee). Direct daypart link enables automated delivery tracking, makegood triggering, and daypart-specific re']
  series_id varchar [note: 'Foreign key linking to content.series. Business justification: Audience guarantees in upfront/scatter sales are negotiated against specific series (e.g., \'guaranteed X GRPs on Series Y\'). The guarantee must reference the series to enable makegood calculations and']
  sweeps_period_id varchar [note: 'Foreign key linking to audience.sweeps_period. Business justification: Audience guarantees are often tied to specific Nielsen sweeps periods for measurement and makegood calculations. The is_sweeps_period flag indicates relevance, but the specific sweeps period should be']
  actual_grp_delivered decimal(10,2) [note: 'The actual total GRP delivered against this guarantee as measured by the designated audience measurement source (e.g., Nielsen). Populated during and after the measurement period through reconciliation with actual delivery records. Used to determine whether the guarantee was met and whether makegoods are required.']
  actual_trp_delivered decimal(10,2) [note: 'The actual total TRP delivered against this guarantee within the target demographic, as measured by the designated audience measurement source. Populated during reconciliation. Used alongside actual_grp_delivered to assess guarantee fulfillment for demographic-specific commitments.']
  approved_timestamp timestamp [note: 'The timestamp when this audience guarantee was formally approved and activated, transitioning from draft to active status. Represents the binding commitment date for revenue recognition and contractual obligation purposes.']
  cprp decimal(12,2) [note: 'The negotiated cost per rating point (CPRP) for this audience guarantee, expressed in the contract currency. CPRP is the standard pricing metric in broadcast advertising used to calculate the total value of the guarantee and to assess makegood compensation amounts.']
  created_timestamp timestamp [note: 'The timestamp when this audience guarantee record was first created in the system. Audit trail field used for data lineage, compliance reporting, and Silver Layer ingestion tracking.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for the financial values associated with this audience guarantee (e.g., USD, GBP, EUR). Used in CPRP and total guarantee value calculations.']
  deal_type varchar [note: 'Classification of the advertising deal under which this guarantee was established. Upfront refers to advance advertising sales events; scatter refers to last-minute ad inventory sales; direct, programmatic, and sponsorship represent other deal structures common in media broadcasting.']
  delivery_shortfall_grp decimal(10,2) [note: 'The calculated difference between the guaranteed GRP level and the actual GRP delivered (guaranteed_grp minus actual_grp_delivered). A positive value indicates under-delivery and potential makegood obligation. Populated during reconciliation.']
  effective_end_date date [note: 'The calendar date on which the audience delivery guarantee measurement period ends. Nullable for open-ended or rolling guarantees. Defines the close of the window during which GRP/TRP delivery is tracked.']
  effective_start_date date [note: 'The calendar date on which the audience delivery guarantee measurement period begins. Defines the start of the window during which GRP/TRP delivery is tracked against the committed level.']
  guarantee_number varchar [note: 'Externally-known business identifier for the audience guarantee, used in advertiser-facing documents, contracts, and reconciliation reports. Typically referenced in Wide Orbit sales orders and Salesforce Media Cloud opportunities.']
  guarantee_status varchar [note: 'Current lifecycle state of the audience guarantee. Draft indicates the guarantee is being negotiated; active indicates it is in-flight; at_risk indicates delivery is trending below threshold; breached indicates the guarantee was not met and makegoods are triggered; fulfilled indicates full delivery was achieved; cancelled indicates the guarantee was voided.']
  guaranteed_frequency decimal(5,2) [note: 'The minimum average number of times a member of the target audience is exposed to the campaign (frequency) committed to the advertiser. Frequency is the average exposures per viewer. Used alongside reach guarantees for campaigns with specific exposure objectives.']
  guaranteed_grp decimal(10,2) [note: 'The total Gross Rating Point (GRP) level committed to the advertiser for delivery over the measurement period. GRP is the sum of ratings for all ad spots in the campaign, representing total audience exposure as a percentage of the target universe. This is the contractually obligated delivery level.']
  guaranteed_reach decimal(15,0) [note: 'The minimum number of unique audience members (reach) committed to the advertiser over the measurement period. Reach is the count of distinct individuals exposed to the campaign at least once. Complements GRP/TRP guarantees for campaigns focused on unique audience coverage.']
  guaranteed_trp decimal(10,2) [note: 'The total Target Rating Point (TRP) level committed to the advertiser, measured specifically against the defined target demographic segment. TRP is the GRP filtered to the target audience. Used when the guarantee is demographic-specific rather than total audience.']
  is_sweeps_period boolean [note: 'Indicates whether the guarantee measurement period falls within a Nielsen sweeps period (intensive ratings measurement period). Sweeps periods (February, May, July, November) carry higher audience measurement scrutiny and may affect guarantee valuation and pricing.']
  makegood_deadline_date date [note: 'The contractual deadline by which makegood spots must be aired to compensate for any audience delivery shortfall. Critical for revenue assurance and advertiser relationship management.']
  makegood_grp_issued decimal(10,2) [note: 'The total GRP value of makegood (compensatory ad spots) issued to the advertiser to compensate for audience delivery shortfall. Tracked for revenue assurance and advertiser relationship management. Zero if no makegoods were required.']
  makegood_trigger_condition varchar [note: 'Textual description of the specific conditions under which makegood (compensatory ad spots) obligations are activated. Defines the contractual rules for when and how makegoods must be provided to the advertiser when guaranteed audience delivery is not met. Sourced from the advertising contract terms.']
  nielsen_order_code varchar [note: 'The external order or tracking identifier assigned by the Nielsen Media Research Platform for the audience measurement order associated with this guarantee. Used to cross-reference Nielsen ratings data and reconciliation reports.']
  notes varchar [note: 'Free-text field for additional business context, special conditions, or operational notes related to this audience guarantee. May include negotiation history, special advertiser requirements, or reconciliation commentary.']
  rating_metric_type varchar [note: 'Specifies the primary audience measurement metric on which this guarantee is based. GRP (Gross Rating Point) measures total audience exposure; TRP (Target Rating Point) measures exposure within the target demographic; HUT (Homes Using Television) and PUT (Persons Using Television) measure set usage; reach measures unique audience count; frequency measures average exposures per viewer.']
  reconciliation_status varchar [note: 'Current status of the reconciliation process comparing guaranteed audience delivery against actual GRP/TRP delivery records. Pending indicates reconciliation has not started; in_progress indicates active comparison; reconciled indicates agreement reached; disputed indicates advertiser has contested the delivery figures; closed indicates the reconciliation cycle is complete.']
  tolerance_threshold_pct decimal(5,2) [note: 'The acceptable percentage shortfall below the guaranteed GRP/TRP level before a makegood obligation is triggered. For example, a value of 5.00 means delivery must be within 5% of the guaranteed level. Defined in the advertising contract and used in reconciliation against actual delivery records.']
  total_guarantee_value decimal(18,2) [note: 'The total contracted monetary value of this audience guarantee, calculated as guaranteed GRP/TRP multiplied by CPRP. Represents the revenue at risk if the guarantee is not met and is central to revenue assurance and financial reconciliation.']
  updated_timestamp timestamp [note: 'The timestamp when this audience guarantee record was last modified. Used for change tracking, incremental data processing in the lakehouse Silver Layer, and audit compliance.']
  wide_orbit_order_code varchar [note: 'The sales order identifier in the Wide Orbit Traffic and Billing system associated with this audience guarantee. Used for cross-system reconciliation between audience delivery records and ad scheduling/invoicing.']

  Note: 'Master record of the audience delivery guarantee committed to an advertiser for a specific campaign or upfront deal — specifying the guaranteed GRP/TRP level, target demographic, measurement period, tolerance threshold, and makegood trigger conditions. Links to ad sales contracts and is reconciled against actual GRP delivery records. Central to revenue assurance and advertiser relationship management.'
}

Table audience.audience_profile {
  audience_profile_id varchar [pk, note: 'Unique surrogate identifier for the audience profile record in the Silver Layer lakehouse. Primary key for this entity.']
  demographic_segment_id varchar [note: 'Foreign key linking to audience.demographic_segment. Business justification: audience_profile carries inferred_age_band, inferred_gender, income_band as inline demographic attributes. demographic_segment is the reference master for standardized demographic segments (with niels']
  genre_id varchar [note: 'Foreign key linking to content.genre. Business justification: Audience profiles track content genre affinity for personalization engines, recommendation systems, and targeted ad delivery. The plain-text content_affinity_genre column is a denormalization of genre']
  nielsen_panel_id varchar [note: 'Pseudonymized identifier assigned by Nielsen Media Research to link this audience profile to a Nielsen panel household or individual. Enables direct integration of Nielsen ratings, GRP/TRP, and demographic data. Null for non-panel profiles.']
  regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: Audience profiles with GDPR consent status, CCPA opt-out, and COPPA protection flags require direct linkage to the governing regulatory_obligation for data governance audits, consent management enforc']
  ad_receptivity_score decimal(5,2) [note: 'Propensity score (0.00–100.00) indicating this audience member\'s likelihood to engage with advertising content, derived from behavioral signals in Adobe AEP and viewing pattern analysis. Used by ad sales teams for premium audience packaging and CPM pricing optimization.']
  aep_profile_code varchar [note: 'Unique profile identifier from Adobe Experience Platform (AEP) used to link behavioral engagement data, segment memberships, and journey analytics to this audience profile. Enables personalization and digital engagement enrichment.']
  avg_session_duration_minutes decimal(8,2) [note: 'Average duration in minutes of a single viewing session for this audience member, derived from set-top box or streaming platform telemetry. Represents Time Spent Viewing (TSV) at the individual level. Used for engagement scoring and content performance analytics.']
  ccpa_opt_out boolean [note: 'Indicates whether this California-resident audience member has exercised their CCPA right to opt out of the sale or sharing of their personal information. When TRUE, this profile must be excluded from data sharing with third-party ad networks and data clean rooms.']
  consent_last_updated_timestamp timestamp [note: 'Timestamp of the most recent change to any consent or privacy flag (GDPR consent status, CCPA opt-out, COPPA flag) for this audience profile. Critical for regulatory audit trails demonstrating timely consent management and data processing compliance.']
  coppa_protected boolean [note: 'Indicates whether this audience profile is subject to COPPA (Children\'s Online Privacy Protection Act) protections, meaning the inferred or declared age is under 13. When TRUE, ad targeting, data sharing, and behavioral tracking are strictly restricted per COPPA compliance requirements.']
  country_code varchar [note: 'ISO 3166-1 alpha-3 country code representing the audience member\'s country of residence. Used for rights windowing, content holdback enforcement, GDPR/CCPA jurisdictional compliance, and international distribution analytics.']
  created_timestamp timestamp [note: 'Timestamp when this audience profile record was first created in the Silver Layer lakehouse, either through initial identity resolution, panel enrollment, or first-party data ingestion. Audit trail for data lineage and GDPR data minimization compliance.']
  data_clean_room_eligible boolean [note: 'Indicates whether this audience profile is eligible for inclusion in data clean room matching operations with advertising partners. Eligibility is determined by consent status, CCPA opt-out flag, COPPA protection status, and contractual data sharing agreements.']
  daypart_preference varchar [note: 'Preferred daypart (time segment of the broadcast day) during which this audience member most frequently views content. Dayparts are standard broadcast industry time segments used for ad scheduling, upfront sales, and audience guarantee reporting.']
  device_graph_code varchar [note: 'Cross-device graph linkage identifier that associates this audience profile with a cluster of known devices (smart TV, mobile, desktop, STB). Sourced from identity resolution providers or Adobe AEP device graph. Enables multi-screen reach and frequency measurement.']
  enrichment_source_version varchar [note: 'Version identifier of the third-party enrichment data package (e.g., Nielsen demographic file version, Adobe AEP segment refresh batch ID) used to populate inferred attributes on this profile. Enables data lineage tracing and reproducibility of audience segment definitions.']
  gdpr_consent_status varchar [note: 'Current GDPR consent status for processing this audience member\'s personal data for audience measurement and advertising purposes. \'granted\' permits processing; \'denied\' or \'withdrawn\' restricts processing; \'not_applicable\' for non-EU audience members. Drives data processing eligibility.']
  household_size varchar [note: 'Estimated number of persons in the audience household, derived from Nielsen panel data or set-top box signals. Used in HUT (Homes Using Television) and PUT (Persons Using Television) calculations for audience measurement reporting.']
  hut_eligible boolean [note: 'Indicates whether this household-level audience profile is eligible to be counted in HUT (Homes Using Television) calculations. HUT measures the percentage of TV-equipped homes actively watching television during a given time period, a foundational metric for broadcast ratings.']
  identity_confidence_score decimal(5,2) [note: 'Confidence score (0.00–100.00) representing the reliability of the identity resolution that constructed this audience profile. Higher scores indicate stronger deterministic matching (e.g., authenticated login); lower scores indicate probabilistic device-graph inference. Used to qualify profiles for premium ad targeting.']
  identity_hash varchar [note: 'SHA-256 pseudonymized hash of the audience member\'s primary identity (e.g., email or subscriber ID) used for cross-platform identity resolution without exposing raw PII. Enables privacy-safe linkage across Nielsen, Adobe AEP, and first-party data sources.']
  identity_source varchar [note: 'Originating source of the audience identity construction: \'first_party\' (subscriber or app registration data), \'nielsen\' (Nielsen Media Research panel linkage), \'adobe_aep\' (Adobe Experience Platform profile), \'set_top_box\' (STB device-level data), \'clean_room\' (data clean room match), or \'modeled\' (probabilistic inference).']
  income_band varchar [note: 'Inferred household income band derived from third-party demographic enrichment (Nielsen, data clean rooms). Used for premium audience segmentation in upfront and scatter market ad sales, enabling CPM pricing differentiation by audience affluence.']
  inferred_age_band varchar [note: 'Inferred age demographic band for the audience member, derived from Nielsen panel data, set-top box signals, or modeled enrichment. Used for GRP/TRP demographic targeting and ad sales audience guarantees. Not directly collected from the individual.']
  inferred_gender varchar [note: 'Inferred gender of the audience member derived from panel data or modeled signals. Used for demographic audience targeting in ad sales (GRP/TRP calculations) and programming decisions. Not directly collected.']
  last_seen_timestamp timestamp [note: 'Timestamp of the most recent observed audience activity event (viewing session, app interaction, or platform login) for this profile. Used to determine audience recency, drive re-engagement campaigns, and calculate viewing recency metrics.']
  nielsen_grp_index decimal(8,4) [note: 'Indexed GRP (Gross Rating Point) score for this audience profile relative to the total population, sourced from Nielsen Media Research. A GRP index above 100 indicates above-average exposure to rated content. Used in ad sales audience guarantees and upfront negotiations.']
  panel_weight_factor decimal(10,6) [note: 'Statistical weighting factor assigned by Nielsen to this panel member profile to project panel observations to the total population. Applied in GRP, TRP, HUT, and PUT calculations. Null for non-panel (modeled or first-party only) profiles.']
  platform_preference varchar [note: 'Primary viewing platform preference inferred from behavioral signals: \'linear_tv\' (traditional scheduled broadcast), \'svod\' (Subscription Video On Demand), \'avod\' (Advertising-Supported VOD), \'tvod\' (Transactional VOD), \'fast\' (Free Ad-Supported Streaming TV), \'ott\' (Over-The-Top), \'mvpd\' (Multichannel Video Programming Distributor), or \'vmvpd\' (Virtual MVPD). Drives distribution strategy and ad product targeting. [ENUM-REF-CANDIDATE: linear_tv|svod|avod|tvod|fast|ott|mvpd|vmvpd — 8 candidates stripped; promote to reference product]']
  primary_device_type varchar [note: 'The primary device type through which this audience member most frequently consumes content, derived from device graph and behavioral data. Used for CDN delivery optimization, ad format targeting, and platform analytics.']
  profile_status varchar [note: 'Current lifecycle state of the audience profile. \'suppressed\' indicates a privacy opt-out or regulatory hold; \'pending_consent\' indicates consent collection is in progress; \'purged\' indicates the record has been anonymized per GDPR/CCPA erasure request.']
  profile_type varchar [note: 'Classification of the audience profile record: \'individual\' (single person identity), \'household\' (aggregated household unit), \'panel_member\' (Nielsen or equivalent panel participant), or \'modeled\' (synthetically constructed from behavioral signals without direct identity linkage).']
  sweeps_period_flag boolean [note: 'Indicates whether this audience profile\'s measurement data was captured during a Nielsen Sweeps period (intensive ratings measurement period: February, May, July, November). Sweeps data carries higher statistical weight in ratings calculations and programming decisions.']
  trp_index decimal(8,4) [note: 'Indexed TRP (Target Rating Point) score representing this audience member\'s contribution to a specific demographic target group\'s rating. Distinct from GRP in that it measures reach within a defined target demographic. Used for demographic-specific ad campaign planning and post-campaign analysis.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to this audience profile record, triggered by enrichment refresh, consent status change, identity graph update, or behavioral signal ingestion. Used for data freshness monitoring and incremental processing.']
  viewing_recency_days varchar [note: 'Number of days since this audience member last engaged with any content on any tracked platform. Used for audience recency segmentation, churn prediction, and re-engagement campaign targeting. Lower values indicate more recently active audiences.']
  weekly_viewing_frequency varchar [note: 'Average number of distinct viewing sessions per week for this audience member, calculated over a rolling 4-week window. Represents the Frequency dimension of audience measurement (average exposures per viewer). Used in reach and frequency reporting for ad campaign delivery.']

  Note: 'Anonymized/pseudonymized master record representing a unique audience member or household identity constructed from first-party data (subscriber records, app registrations, set-top box data) and third-party enrichment (Nielsen, Adobe AEP, data clean rooms). Captures hashed identity, device graph linkage, inferred demographic attributes, content affinity scores, platform preferences, viewing recency/frequency, and consent/privacy flags per GDPR, CCPA, and COPPA. Distinct from the subscriber SSOT in the subscriber domain — this is the audience intelligence and behavioral record, not the billing or subscription identity.'
}

Table audience.segment {
  segment_id varchar [pk, note: 'Unique surrogate identifier for the audience segment record in the Silver Layer lakehouse. Primary key for this master resource entity.']
  demographic_segment_id varchar [note: 'Foreign key linking to audience.demographic_segment. Business justification: segment is a custom/reusable audience segment built from demographic, behavioral, and psychographic criteria. demographic_segment is the Nielsen standard reference cell. A custom segment is often anch']
  genre_id varchar [note: 'Foreign key linking to content.genre. Business justification: Audience segments are defined with content genre affinity for programmatic targeting and DAI (Dynamic Ad Insertion) configuration. The plain-text content_genre_affinity column is a denormalization of ']
  ott_platform_id varchar [note: 'Foreign key linking to distribution.ott_platform. Business justification: Audience segments targeting children must link to COPPA compliance declarations. Ensures parental consent mechanisms are in place before segment activation for advertising or analytics.']
  regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: Audience segments used in DAI and targeted advertising must comply with specific regulatory obligations (COPPA for children\'s segments, GDPR for EU segments). Compliance teams enforce segment eligibil']
  activation_status varchar [note: 'Current lifecycle state of the segment governing whether it is available for use in ad targeting, campaign activation, or content personalization. \'draft\' indicates under construction; \'pending_review\' awaits compliance or data governance approval; \'active\' is live and deployable; \'inactive\' is suspended; \'archived\' is retired.']
  aep_segment_code varchar [note: 'The segment identifier as defined and managed within Adobe Experience Platform (AEP). Used for digital audience activation, personalization journeys, and cross-channel targeting. Enables synchronization between the internal audience_segment master record and the AEP segment definition for OTT and digital platforms.']
  age_range_max varchar [note: 'Maximum age (inclusive) of the primary demographic target for this segment, expressed in years. Used with age_range_min to define the Nielsen demographic cell. A null value indicates an open-ended upper bound (e.g., \'55+\' segments).']
  age_range_min varchar [note: 'Minimum age (inclusive) of the primary demographic target for this segment, expressed in years. Used in conjunction with age_range_max to define the Nielsen demographic cell (e.g., 25 for the \'Adults 25-54\' standard Nielsen demo). Null if the segment is not age-bounded.']
  approved_by varchar [note: 'Name or identifier of the data governance or compliance approver who authorized this segment for activation, particularly for segments involving sensitive demographic data, COPPA-restricted audiences, or GDPR-regulated EU audiences. Supports audit trail requirements.']
  approved_timestamp timestamp [note: 'The date and time when this segment received formal data governance or compliance approval for activation. Distinct from created_timestamp — captures the approval lifecycle event. Required for GDPR accountability documentation and internal audit trails. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.']
  category varchar [note: 'Business-facing category grouping segments for portfolio management and reporting (e.g., \'Ad Targeting\', \'Programming Strategy\', \'Content Personalization\', \'Subscriber Retention\', \'Regulatory Reporting\'). Enables segment library organization in Salesforce Media Cloud and Adobe AEP. [ENUM-REF-CANDIDATE: ad_targeting|programming_strategy|content_personalization|subscriber_retention|regulatory_reporting|audience_research — promote to reference product]']
  code varchar [note: 'Externally-known, human-readable business identifier for the segment used across systems such as Adobe Experience Platform (AEP), Nielsen, and Salesforce Media Cloud. Serves as the canonical cross-system reference code (e.g., \'SEG-DEMO-F25-54-OTT\').']
  created_timestamp timestamp [note: 'The date and time when this audience segment record was first created in the system. Serves as the audit creation timestamp for data lineage, governance, and Silver Layer ingestion tracking. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.']
  data_source varchar [note: 'Identifies the primary data origin used to construct the segment. \'nielsen\' indicates Nielsen Media Research Platform ratings and demographic data; \'adobe_aep\' indicates Adobe Experience Platform behavioral profiles; \'first_party\' indicates proprietary subscriber or registration data; \'third_party\' indicates licensed external data; \'hybrid\' indicates a combination of multiple sources.']
  daypart_applicability varchar [note: 'Broadcast daypart(s) for which this segment is most relevant or has been validated, expressed as a comma-delimited list of standard daypart labels (e.g., \'primetime,late_night\'). Daypart is a standard media-buying time segment of the broadcast day used in ad scheduling and upfront sales. [ENUM-REF-CANDIDATE: early_morning|daytime|early_fringe|primetime|late_news|late_night|overnight — promote to reference product]']
  definition_logic varchar [note: 'The rule-based or SQL/JSON expression that defines segment membership criteria as implemented in Adobe AEP or Nielsen. Captures the inclusion/exclusion logic (e.g., age range, viewing frequency thresholds, content genre affinity, platform usage) used to qualify audience members into this segment.']
  description varchar [note: 'Detailed narrative description of the segment\'s business purpose, defining criteria, and intended use cases. Provides context for ad sales teams, programmers, and data analysts on what the segment represents and how it should be applied.']
  effective_from date [note: 'The date from which this segment definition is considered valid and available for business use. Segments may be pre-built ahead of upfront sales seasons or campaign launches. Enables temporal validity management for segment versioning and historical reporting.']
  effective_until date [note: 'The date after which this segment definition is no longer valid for new activations. Null indicates an open-ended segment with no planned expiry. Used to manage seasonal segments (e.g., sweeps-period segments), campaign-specific segments, and segments tied to expiring data licensing agreements.']
  estimated_reach varchar [note: 'Estimated number of unique individuals (persons or households) who qualify for this segment at the time of last refresh. Reach is a core Nielsen and IAB metric used in ad sales proposals, GRP/TRP calculations, and CPM pricing. Distinct from impressions — counts unique audience members, not exposures.']
  estimated_reach_unit varchar [note: 'Unit of measurement for the estimated_reach figure. \'persons\' aligns with Nielsen PUT (Persons Using Television) methodology; \'households\' aligns with HUT (Homes Using Television); \'devices\' applies to digital/OTT platform segments measured by device-level identity.']
  gender_target varchar [note: 'Gender composition target for the segment as defined in Nielsen demographic cells and ad sales targeting parameters. \'all\' indicates gender-neutral targeting. Used in GRP (Gross Rating Point) and TRP (Target Rating Point) calculations for ad campaign planning.']
  grp_index decimal(10,4) [note: 'The GRP (Gross Rating Point) index value representing this segment\'s relative audience weight as a percentage of the total universe. GRP is a fundamental media planning metric equal to Reach × Frequency. Used in upfront and scatter market ad sales to price inventory and measure campaign delivery against this segment.']
  hut_put_basis varchar [note: 'Indicates whether the segment\'s reach and rating metrics are calculated on a HUT (Homes Using Television) or PUT (Persons Using Television) basis. HUT is household-level measurement; PUT is person-level. This distinction governs how GRP/TRP values are interpreted and how the segment is applied in Nielsen-based ad sales planning.']
  income_bracket varchar [note: 'Household income tier associated with the segment\'s demographic composition, used in premium ad targeting and CPM (Cost Per Mille) pricing. Expressed as a standardized range label (e.g., \'$75K-$100K HHI\', \'$100K+ HHI\'). Sourced from Nielsen MRI-Simmons or first-party subscriber data. [ENUM-REF-CANDIDATE: under_25k|25k_50k|50k_75k|75k_100k|100k_150k|150k_plus — promote to reference product]']
  is_dai_eligible boolean [note: 'Indicates whether this segment is approved and technically configured for use in DAI (Dynamic Ad Insertion) workflows on OTT and streaming platforms. DAI-eligible segments can be activated in real-time ad decisioning systems integrated with Akamai CDN and programmatic ad servers for addressable advertising.']
  is_sweeps_validated boolean [note: 'Indicates whether this segment\'s reach and demographic composition estimates have been validated using Nielsen Sweeps period data (the intensive ratings measurement periods in February, May, July, and November). Sweeps-validated segments carry higher confidence for upfront ad sales commitments and programming decisions.']
  last_refresh_timestamp timestamp [note: 'The date and time when the segment membership, reach estimates, and demographic composition were last recalculated from source data. Used to assess data freshness for ad sales proposals and campaign activation. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.']
  modified_timestamp timestamp [note: 'The date and time when this audience segment record was last updated. Tracks changes to segment definition, status, reach estimates, or compliance flags. Used for change data capture (CDC) in the Databricks Silver Layer pipeline and audit trail maintenance. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.']
  name varchar [note: 'Human-readable display name for the audience segment as it appears in ad sales proposals, programming strategy decks, and campaign targeting UIs (e.g., \'Women 25-54 OTT Heavy Viewers\'). Corresponds to the segment label in Adobe AEP and Salesforce Media Cloud.']
  nielsen_segment_code varchar [note: 'The corresponding segment or audience cell identifier within the Nielsen Media Research Platform. Enables direct linkage to Nielsen ratings data, GRP/TRP delivery reports, and demographic reach/frequency outputs. Used for reconciliation between internal segment definitions and Nielsen-measured audience delivery.']
  notes varchar [note: 'Free-text field for additional business context, caveats, or operational notes about the segment that do not fit structured fields. Examples include data quality warnings, known limitations of the definition logic, special handling instructions for ad sales, or notes on upcoming segment retirement.']
  owner_team varchar [note: 'The business team or department that owns and is accountable for this segment\'s definition, quality, and lifecycle management (e.g., \'Ad Sales Research\', \'Audience Analytics\', \'Programming Strategy\', \'Digital Marketing\'). Used for data governance, access control, and segment portfolio management.']
  platform_applicability varchar [note: 'Comma-delimited list of distribution platforms for which this segment is valid and activated (e.g., \'linear,ott,avod,svod,fast\'). Governs where the segment can be applied for ad targeting or content personalization across Linear, OTT (Over-The-Top), AVOD (Advertising-Supported Video On Demand), SVOD (Subscription Video On Demand), and FAST (Free Ad-Supported Streaming Television) channels. [ENUM-REF-CANDIDATE: linear|ott|avod|svod|tvod|fast|social|digital_display — promote to reference product]']
  refresh_frequency varchar [note: 'How frequently the segment membership and reach estimates are recalculated and updated from source systems (Nielsen, Adobe AEP, or first-party data). Governs data freshness SLAs for ad targeting activation. \'real_time\' applies to DAI-eligible programmatic segments; \'daily\' is standard for digital; \'weekly/monthly\' for Nielsen-based linear segments.']
  segment_type varchar [note: 'Classification of the segment by the primary methodology used to define it. Demographic segments are built on age/gender/HUT criteria; behavioral on viewing patterns; psychographic on interests/attitudes; contextual on content affinity; lookalike on modeled similarity to a seed audience.']
  trp_index decimal(10,4) [note: 'The TRP (Target Rating Point) index value representing this segment\'s rating within its specific target demographic universe. TRP is the targeted equivalent of GRP, measuring delivery efficiency against the defined demographic cell. Critical for ad sales pricing, makegoods calculations, and CPRP (Cost Per Rating Point) negotiations.']
  version_number varchar [note: 'Monotonically incrementing version counter for the segment definition. Incremented each time the segment\'s definition logic, demographic criteria, or platform applicability is materially changed. Enables segment versioning for historical campaign attribution — ad campaigns reference the segment version active at time of booking.']

  Note: 'Master record for a defined, reusable audience segment built from demographic, behavioral, and psychographic criteria for use in ad targeting, programming strategy, and content personalization. Captures segment name, definition logic, estimated size, demographic composition, platform applicability, activation status, and data source (Nielsen, Adobe AEP, first-party). Distinct from demographic_segment (which is a reference classification) — this is an operationally managed, business-owned targeting segment.'
}

Table audience.cross_platform_measurement {
  cross_platform_measurement_id varchar [pk, note: 'Unique surrogate identifier for each cross-platform audience measurement record in the Silver layer lakehouse. Primary key for this transactional entity.']
  ad_order_id varchar [note: 'Foreign key linking to sales.ad_order. Business justification: Cross-platform measurement reports are generated per ad order for delivery reconciliation across linear and digital. The existing campaign_id FK is insufficient for order-level reconciliation — a name']
  billing_account_id varchar [note: 'Foreign key linking to billing.billing_account. Business justification: Cross-platform measurement is a key differentiator in modern media sales, directly referenced when pitching multi-platform opportunities. Sales teams use cross-platform reach data to justify premium p']
  campaign_id varchar [note: 'Reference to the advertising campaign flight for which this cross-platform measurement is being reported. Enables audience currency reconciliation for converged TV buying. Nullable when measurement is content-centric rather than campaign-centric.']
  content_title_id varchar [note: 'Reference to the content title or program for which this cross-platform audience measurement is recorded. Links to the content master data product in the Content domain.']
  demographic_segment_id varchar [note: 'Foreign key linking to audience.demographic_segment. Business justification: Cross-platform measurements target specific demographic segments for deduplicated reach calculations. The target_demographic string should be replaced with FK to demographic_segment for consistency wi']
  distribution_agreement_id varchar [note: 'Foreign key linking to partner.distribution_agreement. Business justification: Cross-platform measurement tracks streaming, MVPD, and OTT impressions that are governed by distribution agreements covering svod_rights_included and streaming_rights_included. Distributors require cr']
  distribution_partner_id varchar [note: 'Foreign key linking to distribution.distribution_partner. Business justification: Cross-platform measurement includes MVPD impressions (\'mvpd_impressions\'). Linking to distribution_partner enables proper MVPD partner attribution in cross-platform reports — essential for partner-lev']
  guarantee_id varchar [note: 'Foreign key linking to audience.guarantee. Business justification: Cross-platform measurement records are used to track audience delivery across linear, OTT, and streaming platforms against advertiser guarantees. Adding guarantee_id to cross_platform_measurement link']
  ott_platform_id varchar [note: 'Foreign key linking to distribution.ott_platform. Business justification: Cross-platform measurement tracks OTT streaming impressions per platform. Linking to ott_platform enables proper attribution of \'ott_streaming_impressions\' to specific platforms (e.g., Peacock vs. Par']
  panel_id varchar [note: 'Foreign key linking to audience.panel. Business justification: cross_platform_measurement carries panel_sample_size as an inline integer but has no FK to the panel entity. Adding panel_id links the cross-platform measurement to the specific panel used for the lin']
  production_episode_id varchar [note: 'Foreign key linking to production.production_episode. Business justification: Episode-level cross-platform measurement is required for total audience delivery verification, especially for time-shifted viewing and multi-platform distribution. Essential for C3/C7 ratings and adve']
  production_project_id varchar [note: 'Foreign key linking to production.project. Business justification: Cross-platform measurement aggregates linear TV + streaming + social video performance for specific production projects. Required for total audience reporting, C3/C7 ratings, and advertiser delivery v']
  regulatory_filing_id varchar [note: 'Foreign key linking to compliance.regulatory_filing. Business justification: Cross-platform measurement data is formally submitted in FCC and MRC regulatory filings to demonstrate measurement methodology compliance. Compliance teams need this link to assemble filing packages a']
  schedule_slot_id varchar [note: 'Foreign key linking to scheduling.schedule_slot. Business justification: Cross-platform measurement tracks unified audience metrics across linear TV (schedule_slot) and digital platforms for advertiser reporting, makegoods, and total audience delivery validation - core to ']
  sweeps_period_id varchar [note: 'Foreign key linking to audience.sweeps_period. Business justification: Cross-platform measurements during sweeps periods are critical for upfront negotiations and guarantee reconciliation. The is_sweeps_period flag indicates relevance, but the specific sweeps period shou']
  upfront_deal_id varchar [note: 'Foreign key linking to sales.upfront_deal. Business justification: Cross-platform measurement validates upfront deal audience commitments across linear TV, OTT, and digital. This is a named business process: \'upfront deal cross-platform audience validation\' — essenti']
  version_id varchar [note: 'Foreign key linking to content.version. Business justification: Cross-platform measurement must identify which content version was delivered on each platform (OTT-specific cut vs. linear broadcast version) to correctly attribute impressions and deduplicate reach —']
  audience_share decimal(8,4) [note: 'Percentage of the total viewing audience (HUT or PUT) that was watching this specific content or channel during the measurement period. Calculated as the program rating divided by HUT or PUT. Key programming performance indicator.']
  average_frequency decimal(8,4) [note: 'Average number of times a unique individual in the deduplicated reach was exposed to the content or campaign across all platforms within the measurement period. Calculated as total impressions divided by deduplicated reach.']
  co_viewing_adjustment_factor decimal(8,6) [note: 'Multiplicative adjustment factor applied to account for co-viewing behavior (multiple persons watching on a single device/screen), particularly relevant for connected TV and OTT platforms. Values greater than 1.0 indicate upward adjustment for co-viewing. Sourced from Nielsen co-viewing methodology.']
  content_genre varchar [note: 'Genre classification of the content title being measured (e.g., Drama, News, Sports, Reality, Comedy, Documentary). Used for audience segmentation analysis and programming strategy reporting. [ENUM-REF-CANDIDATE: drama|news|sports|reality|comedy|documentary|talk|game_show|animation|other — promote to reference product]']
  created_timestamp timestamp [note: 'Audit timestamp recording when this cross-platform measurement record was first ingested into the Silver layer lakehouse.']
  cross_platform_grp decimal(10,4) [note: 'Gross Rating Point (GRP) calculated across all measured platforms, representing the sum of ratings for all platform exposures within the target universe. Equals total impressions divided by the target universe population, multiplied by 100. Primary audience currency for converged TV ad buying.']
  cross_platform_trp decimal(10,4) [note: 'Target Rating Point (TRP) calculated across all measured platforms for the specified target demographic segment. Measures GRP within the defined target audience, used for demographic-specific ad buying and campaign performance evaluation.']
  currency_version varchar [note: 'Version identifier of the audience measurement currency standard applied to this record (e.g., \'Nielsen ONE v2.1\', \'Comscore Campaign Ratings v3.0\'). Supports multi-currency and currency transition tracking as the industry evolves from legacy Nielsen C3/C7 to cross-platform currencies.']
  data_source_systems varchar [note: 'Pipe-delimited list of operational source systems that contributed data to this cross-platform measurement record (e.g., \'Nielsen Media Research Platform|Adobe Experience Platform\'). Supports data lineage, audit, and methodology transparency requirements.']
  daypart_code varchar [note: 'Broadcast daypart classification for the measurement period, representing the time segment of the broadcast day. [ENUM-REF-CANDIDATE: EAM|AM|DAYTIME|EARLY_FRINGE|PRIME|LATE_FRINGE|OVERNIGHT — promote to reference product if additional dayparts are required]']
  deduplicated_reach varchar [note: 'Total count of unique, unduplicated individuals (persons) who were exposed to the content or campaign across all measured platforms within the measurement period. Core audience currency metric for converged TV buying. Expressed as absolute person count.']
  distribution_type varchar [note: 'Primary distribution model classification for the content being measured: \'linear\' for traditional scheduled broadcast; \'vod\' for generic on-demand; \'svod\' for subscription streaming; \'avod\' for ad-supported streaming; \'tvod\' for transactional on-demand; \'fast\' for free ad-supported streaming TV; \'social\' for social video platforms. [ENUM-REF-CANDIDATE: linear|vod|svod|avod|tvod|fast|social — 7 candidates stripped; promote to reference product]']
  fast_channel_impressions varchar [note: 'Audience impressions attributed to Free Ad-Supported Streaming Television (FAST) channels within the measurement period. Represents the growing ad-supported streaming audience segment.']
  hut_rating decimal(8,4) [note: 'Homes Using Television (HUT) rating for the measurement period, representing the percentage of all television households with at least one TV set in use during the measured time period. Used for share calculations and programming decisions.']
  is_data_suppressed boolean [note: 'Indicates whether this measurement record has been suppressed from reporting due to insufficient panel sample size, MRC minimum reporting thresholds, or privacy regulations (GDPR/CCPA). Suppressed records are retained for audit but excluded from audience currency reporting.']
  is_mrc_accredited boolean [note: 'Indicates whether this measurement was produced using a methodology that holds current Media Rating Council (MRC) accreditation for cross-platform measurement. MRC accreditation is required for use as official audience currency in upfront and scatter market ad transactions.']
  is_sweeps_period boolean [note: 'Indicates whether this measurement falls within a Nielsen sweeps period (February, May, July, November), which represents an intensive ratings measurement window used for programming and ad rate decisions.']
  isan_code varchar [note: 'International Standard Audiovisual Number (ISAN) for the content title being measured, providing a globally unique, persistent identifier for the audiovisual work. Enables cross-system content identification and rights reconciliation.']
  linear_impressions varchar [note: 'Audience impressions attributed to traditional linear broadcast television (over-the-air, cable, satellite) within the measurement period. Component of the platform-level audience breakdown.']
  measurement_period_end date [note: 'The last date of the audience measurement observation window, aligned to the content airing schedule or campaign flight end.']
  measurement_period_start date [note: 'The first date of the audience measurement observation window, aligned to the content airing schedule or campaign flight start. Used for sweeps period identification and daypart analysis.']
  measurement_reference_number varchar [note: 'Externally-known business identifier for this cross-platform measurement record, used in reporting, ad sales proposals, and audience currency reconciliation. Sourced from Nielsen Media Research Platform or internal measurement workflow.']
  measurement_status varchar [note: 'Current lifecycle state of the cross-platform measurement record. \'draft\' indicates data is being assembled; \'preliminary\' indicates initial estimate released; \'certified\' indicates MRC-audited final figure; \'revised\' indicates a post-certification correction; \'archived\' indicates superseded by a newer measurement.']
  measurement_timestamp timestamp [note: 'The principal real-world timestamp representing when the audience measurement observation period was captured or the measurement run was executed. Distinct from record audit timestamps.']
  mvpd_impressions varchar [note: 'Audience impressions attributed to Multichannel Video Programming Distributor (MVPD) and virtual MVPD (vMVPD) platforms, including cable, satellite, and virtual pay-TV providers within the measurement period.']
  nielsen_rating decimal(8,4) [note: 'The Nielsen Rating for the content or program within the measurement period, representing the percentage of all television households or persons in the universe tuned to the program. The foundational audience currency metric for linear broadcast.']
  ott_streaming_impressions varchar [note: 'Audience impressions attributed to Over-The-Top (OTT) and Subscription Video On Demand (SVOD) streaming platforms within the measurement period. Includes authenticated streaming on connected TV, mobile, and desktop devices.']
  panel_sample_size varchar [note: 'Number of panel households or persons in the Nielsen (or equivalent vendor) measurement panel that contributed to this cross-platform measurement. Indicates statistical reliability; low sample sizes may trigger data suppression per MRC minimum reporting standards.']
  put_rating decimal(8,4) [note: 'Persons Using Television (PUT) rating for the measurement period, representing the percentage of all persons in the universe who are watching television during the measured time period. Used for person-level audience share calculations.']
  social_video_impressions varchar [note: 'Audience impressions attributed to social video platforms (e.g., YouTube, Facebook Video, TikTok, Instagram Reels) within the measurement period. Enables full cross-platform audience aggregation.']
  target_universe_size varchar [note: 'The estimated total population size of the target demographic universe used as the denominator for GRP and TRP calculations. Sourced from Nielsen universe estimates updated annually.']
  total_impressions varchar [note: 'Total number of audience exposures (impressions) across all platforms within the measurement period, including duplicate exposures across platforms. Used for CPM-based advertising currency and GRP calculation inputs.']
  updated_timestamp timestamp [note: 'Audit timestamp recording when this cross-platform measurement record was last modified, supporting data lineage and revision tracking.']

  Note: 'Transactional record aggregating deduplicated audience measurement across linear broadcast, OTT/SVOD streaming, MVPD/vMVPD, FAST channels, and social video platforms for a specific content title or campaign flight. Captures deduplicated reach, total impressions, platform-level audience breakdown, co-viewing adjustment factor, cross-platform GRP/TRP, and big data + panel fusion methodology indicators. Aligns with Nielsen ONE, Comscore, and MRC cross-platform measurement standards. Enables unified audience currency reporting for converged TV buying.'
}

Table audience.segment_membership {
  segment_membership_id varchar [pk, note: 'Unique surrogate identifier for this segment membership record']
  segment_audience_profile_id varchar [note: 'Foreign key linking to the audience profile being assigned to the segment']
  segment_id varchar [note: 'Foreign key linking to the segment to which the profile is assigned']
  segment_profile_audience_profile_id varchar [note: 'Foreign key linking to the audience profile being assigned to the segment']
  activation_status varchar [note: 'Current lifecycle state of this specific membership governing whether it is available for use in ad targeting and personalization: active, inactive, pending, expired, suppressed']
  aep_segment_membership varchar [note: 'Comma-delimited list of Adobe Experience Platform (AEP) audience segment IDs to which this profile currently belongs. Segments represent behavioral, demographic, or propensity-based audience groups used for personalization, ad targeting, and journey activation. [Moved from audience_profile: This denormalized STRING column in audience_profile contains a comma-delimited list of segment IDs, which is the exact relationship data that should be normalized into the segment_membership association table. Moving this to the association eliminates denormalization and enables proper querying, historical tracking, and attribute management per membership.]']
  assigned_timestamp timestamp [note: 'Timestamp when this profile was first assigned to this segment by the segmentation engine or manual process']
  confidence_score decimal(5,2) [note: 'Statistical confidence score (0.00–100.00) representing the reliability of this profile\'s assignment to this segment, based on data quality, recency, and model accuracy']
  effective_from date [note: 'The date from which this profile-segment membership is considered valid and available for activation in targeting campaigns']
  effective_until date [note: 'The date after which this profile-segment membership is no longer valid for new activations, supporting temporal segment definitions and campaign windows']
  last_evaluated_timestamp timestamp [note: 'Timestamp of the most recent evaluation or refresh of this membership, indicating data freshness for targeting decisions']
  membership_score decimal(5,2) [note: 'Propensity or affinity score (0.00–100.00) indicating the strength or relevance of this profile\'s membership in this segment, used for prioritization in ad targeting and personalization']

  Note: 'This association product represents the assignment of an audience profile to a defined audience segment for use in ad targeting, programming strategy, and content personalization. It captures the membership relationship with scoring, temporal validity, activation status, and confidence metrics that exist only in the context of this specific profile-segment pairing. Each record links one audience_profile to one segment with attributes that govern targeting eligibility and measurement.. Existence Justification: In media broadcasting audience management, a single audience profile is routinely assigned to multiple segments simultaneously for different targeting purposes (e.g., \'Sports Enthusiasts\', \'High Income HH\', \'Prime Time Viewers\'), and each segment contains thousands to millions of profiles. Segment membership is an operationally managed business concept recognized in Adobe Experience Platform (AEP) and Nielsen measurement systems, with membership tracked via scores, temporal validity windows, activation status, and confidence metrics that belong to each specific profile-segment pairing, not to the profile or segment alone.'
}

Table talent.talent_profile {
  talent_profile_id varchar [pk, note: 'Unique identifier for the talent profile record. Primary key for the talent master entity.']
  talent_agency_id varchar [note: 'FK to talent.talent_agency']
  biometric_consent_flag boolean [note: 'Indicates whether the talent has provided consent for collection and use of biometric data (facial recognition, voice prints) for digital effects, deepfake prevention, and AI training. Required for GDPR and CCPA compliance.']
  ccpa_opt_out_flag boolean [note: 'Indicates whether the talent has opted out of the sale or sharing of their personal information under CCPA. Required for California-based talent or productions.']
  clearance_expiration_date date [note: 'The date when the talent\'s current clearance status expires and requires renewal. Used for compliance tracking and production eligibility verification.']
  clearance_status varchar [note: 'The current clearance status of the talent for production work. Indicates whether background checks, work authorization, insurance verification, and legal clearances are complete and current.']
  created_timestamp timestamp [note: 'The date and time when the talent profile record was first created in the system. Used for audit trail and data lineage tracking.']
  date_of_birth date [note: 'The talent\'s date of birth. Required for age verification, child labor law compliance (COPPA), insurance underwriting, and residual payment calculations.']
  email_address varchar [note: 'The primary email address for talent communication, contract delivery, and digital correspondence.']
  exclusivity_clause_flag boolean [note: 'Indicates whether the talent is currently bound by an exclusivity clause that restricts their ability to work with competing networks, studios, or brands. Used for conflict checking during casting and booking.']
  gdpr_consent_status varchar [note: 'The current status of the talent\'s GDPR consent for data processing. Tracks whether the talent has provided, withdrawn, or is pending consent for personal data usage under EU regulations.']
  gender_identity varchar [note: 'The talent\'s self-identified gender. Used for diversity reporting, casting analytics, and compliance with equal opportunity regulations.']
  imdb_identifier varchar [note: 'The talent\'s unique identifier in the Internet Movie Database (IMDb). Used for cross-referencing filmography, public profile linking, and industry data integration.']
  insurance_coverage_flag boolean [note: 'Indicates whether the talent is currently covered by production insurance (liability, workers compensation, errors and omissions). Required for on-set work authorization.']
  insurance_policy_number varchar [note: 'The policy number for the talent\'s production insurance coverage. Used for claims processing and certificate of insurance verification.']
  isni_code varchar [note: 'The International Standard Name Identifier (ISNI) for the talent. A globally unique identifier for creators used in rights management and royalty distribution systems.']
  legal_name varchar [note: 'The full legal name of the talent as it appears on official documents and contracts. Used for contract execution, payroll, and legal compliance.']
  nationality varchar [note: 'The talent\'s nationality represented as a 3-letter ISO country code. Used for work authorization, tax treaty eligibility, and international co-production compliance.']
  notes varchar [note: 'Free-form text field for additional notes, special requirements, or contextual information about the talent. Used for casting notes, production preferences, and internal communication.']
  phone_number varchar [note: 'The primary contact phone number for the talent. Used for production scheduling, emergency contact, and direct communication.']
  primary_language varchar [note: 'The talent\'s primary working language represented as a 2-letter ISO language code. Used for casting, dubbing, and localization workflows.']
  profile_status varchar [note: 'The current lifecycle status of the talent profile. Determines availability for casting, contract execution, and system access.']
  residual_eligibility_flag boolean [note: 'Indicates whether the talent is eligible to receive residual payments for reuse of their work in syndication, streaming, or international distribution. Determined by union status and contract terms.']
  stage_name varchar [note: 'The professional or stage name used by the talent for public appearances, credits, and marketing materials. May differ from legal name.']
  talent_tier varchar [note: 'The classification tier of the talent based on industry recognition, box office draw, and compensation level. Used for budgeting, marketing strategy, and billing rate determination.']
  talent_type varchar [note: 'The primary professional category or role type of the talent. Determines applicable guild rules, contract templates, and credit attribution standards. [ENUM-REF-CANDIDATE: actor|director|writer|producer|host|correspondent|crew|voice_artist|composer|cinematographer — 10 candidates stripped; promote to reference product]']
  tax_id_number varchar [note: 'The talent\'s tax identification number (SSN, EIN, or international equivalent). Required for payroll processing, tax withholding, and IRS 1099 reporting.']
  union_affiliation varchar [note: 'The primary labor union or guild affiliation of the talent. Determines contract terms, minimum compensation, residual eligibility, and working conditions.']
  union_member_number varchar [note: 'The talent\'s membership identifier within their primary union or guild. Required for residual payment processing and contract compliance verification.']
  updated_timestamp timestamp [note: 'The date and time when the talent profile record was last modified. Used for change tracking and data freshness verification.']
  work_authorization_status varchar [note: 'The talent\'s current work authorization status in the primary production jurisdiction. Determines eligibility for employment and production participation.']
  work_visa_expiration_date date [note: 'The expiration date of the talent\'s work visa. Critical for production scheduling and compliance with immigration regulations.']
  work_visa_type varchar [note: 'The specific type of work visa held by the talent (e.g., O-1, P-1, H-1B). Used for compliance tracking and production planning for international talent.']

  Note: 'Master identity record for all on-screen and off-screen talent — actors, directors, writers, producers, hosts, correspondents, crew, and voice artists. Stores legal name, stage name, date of birth, nationality, gender identity, primary language, union membership references, talent tier classification, representation agency references, IMDb/ISNI identifiers, biometric consent flags, data privacy status (GDPR/CCPA), clearance status, and active/inactive lifecycle state. Serves as the authoritative SSOT for talent identity referenced by production, rights, royalty, and scheduling workflows across the enterprise.'
}

Table talent.guild_affiliation {
  guild_affiliation_id varchar [pk, note: 'Unique identifier for the guild affiliation record. Primary key.']
  talent_profile_id varchar [note: 'Reference to the talent (actor, director, writer, producer, crew member) who holds this guild membership.']
  cba_effective_date date [note: 'Date when the current collective bargaining agreement became effective for this membership.']
  cba_expiration_date date [note: 'Date when the current collective bargaining agreement expires. Used to track contract renewal cycles and potential rate changes.']
  cba_version varchar [note: 'Version or year identifier of the collective bargaining agreement that governs this membership. Critical for determining applicable residual rates, working conditions, and compensation structures.']
  created_timestamp timestamp [note: 'Timestamp when this guild affiliation record was first created in the system.']
  dues_payment_status varchar [note: 'Current status of membership dues payment obligations. Current (all dues paid up to date), overdue (payment past due but within grace period), delinquent (significantly past due, may affect standing), exempt (not required to pay dues), waived (dues forgiven by guild).']
  guild_code varchar [note: 'Standardized code identifying the entertainment industry guild or union. SAG-AFTRA (Screen Actors Guild - American Federation of Television and Radio Artists), WGA (Writers Guild of America), DGA (Directors Guild of America), IATSE (International Alliance of Theatrical Stage Employees), AFM (American Federation of Musicians), BECTU (Broadcasting Entertainment Communications and Theatre Union - UK), ACTRA (Alliance of Canadian Cinema Television and Radio Artists). [ENUM-REF-CANDIDATE: SAG-AFTRA|WGA|DGA|IATSE|AFM|BECTU|ACTRA|OTHER — 8 candidates stripped; promote to reference product]']
  guild_name varchar [note: 'Full legal name of the guild or union organization.']
  health_benefits_eligible_flag boolean [note: 'Indicates whether the talent is eligible for guild-provided health insurance benefits based on this membership and earnings thresholds. True if eligible, false otherwise.']
  join_date date [note: 'Date when the talent officially became a member of this guild. Used to determine seniority and eligibility for certain benefits.']
  jurisdiction varchar [note: 'Geographic jurisdiction or country where this guild membership is registered and governed. USA (United States), CAN (Canada), GBR (United Kingdom), AUS (Australia), NZL (New Zealand), IRL (Ireland). [ENUM-REF-CANDIDATE: USA|CAN|GBR|AUS|NZL|IRL|OTHER — 7 candidates stripped; promote to reference product]']
  last_dues_payment_date date [note: 'Date of the most recent membership dues payment received by the guild.']
  local_chapter varchar [note: 'Local chapter, branch, or regional division of the guild to which this membership is assigned. Used for regional governance and event coordination.']
  membership_number varchar [note: 'Unique membership identifier assigned by the guild to the talent member. Required for residual payment processing and production compliance verification.']
  membership_status varchar [note: 'Current standing of the talent within the guild. Good standing (active member in compliance), suspended (temporarily barred due to dues or violations), resigned (voluntarily terminated membership), expelled (involuntarily removed), inactive (not currently active but not terminated), pending (application under review).']
  membership_tier varchar [note: 'Classification of membership level within the guild. Full member (standard active membership with full benefits), fi-core (financial core member with limited participation), apprentice (trainee or provisional member), honorary (recognition membership), lifetime (permanent membership status), emeritus (retired member with recognition).']
  next_dues_payment_date date [note: 'Date when the next membership dues payment is due.']
  notes varchar [note: 'Free-text field for additional context, special conditions, or remarks about this guild membership. May include information about membership restrictions, special accommodations, or historical context.']
  pension_eligible_flag boolean [note: 'Indicates whether the talent is eligible for guild pension plan contributions and benefits. True if eligible, false otherwise.']
  residual_eligibility_flag boolean [note: 'Indicates whether this guild membership makes the talent eligible to receive residual payments for reuse of their work. True if eligible, false otherwise. Critical for royalty calculation workflows.']
  termination_date date [note: 'Date when the guild membership ended, whether through resignation, expulsion, or other termination. Null for active memberships.']
  updated_timestamp timestamp [note: 'Timestamp when this guild affiliation record was last modified in the system.']
  verification_date date [note: 'Date when the guild membership status was last verified with the guild organization. Used to ensure data accuracy for production compliance.']
  verification_method varchar [note: 'Method used to verify the guild membership status. API (automated guild system integration), manual (direct guild contact), document (membership card or certificate scan), self-reported (talent declaration), third-party (verification service).']

  Note: 'Tracks each talent\'s formal membership and standing within entertainment industry guilds and unions — SAG-AFTRA, WGA (Writers Guild of America), DGA (Directors Guild of America), IATSE, AFM (American Federation of Musicians), and international equivalents (BECTU, ACTRA). Records membership number, guild code, membership tier (full member, fi-core, apprentice), join date, current standing (good standing, suspended, resigned), dues payment status, and applicable collective bargaining agreement (CBA) version. Critical for residual eligibility determination and production compliance.'
}

Table talent.contract {
  contract_id varchar [pk, note: 'Unique identifier for the talent contract record. Primary key for the talent contract entity.']
  coproduction_agreement_id varchar [note: 'Foreign key linking to partner.coproduction_agreement. Business justification: Talent contracts in co-productions must be attributed to the specific co-production agreement for budget allocation, credit obligation enforcement, and residuals-sharing formula application. Co-produc']
  partner_id varchar [note: 'Foreign key linking to partner.partner_partner. Business justification: Talent contracts are executed with production partners (studios, networks, streamers) as the contracting entity. Essential for contract administration, payment routing, rights clearance, and partner r']
  production_project_id varchar [note: 'Reference to the production (series, film, episode, special) for which this talent is contracted. Nullable for overall deals and first-look deals not tied to a specific production.']
  representation_agreement_id varchar [note: 'Foreign key linking to talent.representation_agreement. Business justification: Every talent contract is negotiated through the talent\'s representation agreement with their agency. The contract currently stores talent_representative_agency and talent_representative_name as denorm']
  talent_profile_id varchar [note: 'Reference to the talent (actor, director, writer, producer, host, correspondent, crew member) engaged under this contract.']
  amendment_count varchar [note: 'The total number of formal amendments made to this contract since initial execution. Tracks contract modification history.']
  backend_participation_percentage decimal(5,2) [note: 'The percentage of net profits, adjusted gross, or other revenue streams the talent is entitled to receive after recoupment of production costs. Common for above-the-line talent.']
  backend_participation_type varchar [note: 'The revenue calculation basis for backend participation. Net profits are after all costs; adjusted gross is after specific deductions; gross receipts are from first dollar. None indicates no backend participation.']
  base_compensation_amount decimal(18,2) [note: 'The guaranteed base fee or salary payable to the talent for services rendered under this contract, excluding bonuses, backend participation, and residuals.']
  billing_credit_position varchar [note: 'The contractually specified position and format of the talent\'s on-screen credit (e.g., \'First Position Main Title\', \'Shared Card\', \'Single Card\', \'Above the Title\'). Critical for talent reputation and guild compliance.']
  compensation_currency varchar [note: 'Three-letter ISO 4217 currency code for the base compensation amount (e.g., USD, GBP, EUR).']
  compensation_structure varchar [note: 'The payment model for the base compensation. Flat fee is a single lump sum; per-episode is paid per episode produced; weekly/annual/day/hourly rates define periodic payment schedules.']
  contract_number varchar [note: 'Business identifier for the contract, typically assigned by legal or business affairs. Used for external reference and tracking.']
  contract_status varchar [note: 'Current stage of the contract in its lifecycle. Deal memo represents initial short-form agreement; countersigned indicates mutual acceptance; long-form executed is the final detailed contract; amended reflects modifications; suspended indicates temporary hold; terminated is early cancellation; expired is natural end. [ENUM-REF-CANDIDATE: deal_memo|countersigned|long_form_executed|amended|suspended|terminated|expired — 7 candidates stripped; promote to reference product]']
  contract_type varchar [note: 'Classification of the talent engagement type. Series regular deals cover multi-episode commitments; episodic guest agreements are single or limited appearances; overall deals provide exclusive services across multiple projects; first-look deals grant priority rights to talent-developed content; crew contracts cover technical and production staff; talent holding deals reserve talent availability; development deals fund content creation. [ENUM-REF-CANDIDATE: series_regular|episodic_guest|overall_deal|first_look_deal|crew_contract|talent_holding_deal|development_deal — 7 candidates stripped; promote to reference product]']
  created_timestamp timestamp [note: 'The timestamp when this contract record was first created in the system.']
  credit_placement_requirements varchar [note: 'Detailed contractual requirements for credit placement, including main title vs end credits, paid advertising inclusion, promotional materials, and any special formatting or adjacency requirements.']
  credit_size_percentage decimal(5,2) [note: 'The minimum size of the talent\'s on-screen credit as a percentage of the title or other reference credit size. Null if not contractually specified.']
  document_reference_uri varchar [note: 'The storage location or document management system URI for the executed contract document and all amendments. Used for legal reference and audit.']
  effective_end_date date [note: 'The date on which the contract expires or the engagement period ends. Nullable for open-ended overall deals or holding deals with option-based extensions.']
  effective_start_date date [note: 'The date on which the contract becomes binding and the talent engagement period begins.']
  engagement_role varchar [note: 'The specific role or position the talent is contracted to perform (e.g., Lead Actor, Director, Showrunner, Writer, Executive Producer, Director of Photography, Host).']
  exclusivity_flag boolean [note: 'Indicates whether the contract includes exclusivity restrictions preventing the talent from working on competing projects or for other networks/studios during the contract period.']
  exclusivity_scope varchar [note: 'Detailed description of the exclusivity restrictions, including prohibited activities, competing platforms, genre restrictions, and geographic scope. Null if exclusivity_flag is false.']
  governing_cba varchar [note: 'The specific collective bargaining agreement that governs this contract, including version and effective date (e.g., SAG-AFTRA Television Agreement 2020-2023). Defines minimum compensation, working conditions, and residual structures.']
  guaranteed_episodes varchar [note: 'The minimum number of episodes for which the talent is guaranteed compensation, regardless of actual production. Common in series regular deals. Null for non-episodic contracts.']
  guild_affiliation varchar [note: 'The labor union or guild to which the talent belongs. SAG-AFTRA covers actors and broadcasters; WGA covers writers; DGA covers directors; IATSE covers crew and technical staff. Multiple indicates membership in more than one guild. Non-union indicates no guild membership.']
  holdback_period_days varchar [note: 'The number of days after contract end during which the talent is restricted from working on similar projects or for competing entities. Common in overall deals and first-look agreements.']
  last_amendment_date date [note: 'The date of the most recent contract amendment. Null if no amendments have been made.']
  last_modified_timestamp timestamp [note: 'The timestamp when this contract record was most recently updated in the system.']
  option_exercise_deadline date [note: 'The date by which the company must notify the talent of its decision to exercise or decline the next option period. Null if no active option exists.']
  option_exercise_status varchar [note: 'Current status of the most recent option period. Not applicable if no options exist; pending if decision deadline has not passed; exercised if company extended; declined if company chose not to extend; expired if deadline passed without action.']
  option_periods_count varchar [note: 'The number of option periods (typically annual) the company holds to extend the contract beyond the initial term. Common in series regular and overall deals.']
  pay_or_play_flag boolean [note: 'Indicates whether the contract includes a pay-or-play provision, guaranteeing full compensation even if the talent services are not ultimately used or the production is cancelled.']
  residual_eligibility_flag boolean [note: 'Indicates whether the talent is eligible to receive residual payments for reuse of the content (reruns, streaming, international distribution, home video). Governed by guild CBAs.']
  step_up_amount decimal(18,2) [note: 'The incremental increase in base compensation for each exercised option period or season renewal. Null if no step-up provision exists.']
  termination_date date [note: 'The date on which the contract was terminated prior to its natural expiration. Null if contract was not terminated early.']
  termination_reason varchar [note: 'The primary reason for early contract termination. Null if contract was not terminated early. [ENUM-REF-CANDIDATE: mutual_agreement|breach_of_contract|force_majeure|production_cancellation|talent_unavailability|company_convenience|talent_request|other — 8 candidates stripped; promote to reference product]']

  Note: 'Authoritative record of each talent engagement from initial deal memo through executed long-form contract — covering series regular deals, episodic guest agreements, overall deals, first-look deals, and crew contracts. Captures contract lifecycle stage (deal memo, countersigned, long-form executed), compensation structure (base fee, guarantees, backend participation, step-ups, pay-or-play), exclusivity and holdback restrictions, option periods with exercise status, amendment history, billing credit position, governing CBA, and document references. Source of truth for all commercial terms, obligations, and contractual modifications throughout the talent engagement lifecycle.'
}

Table talent.compensation_structure {
  compensation_structure_id varchar [pk, note: 'Unique identifier for the compensation structure record. Primary key.']
  contract_id varchar [note: 'Reference to the parent talent contract to which this compensation structure is attached.']
  guild_affiliation_id varchar [note: 'Foreign key linking to talent.guild_affiliation. Business justification: Compensation structures in the entertainment industry are heavily governed by guild/union CBAs. The guild_affiliation record contains the authoritative cba_version, pension_health_rate eligibility, an']
  role_id varchar [note: 'Foreign key linking to talent.role. Business justification: A compensation structure is attached to a contract, but for multi-role contracts (e.g., a talent contracted as both actor and executive producer), each role may have a distinct compensation structure.']
  backend_gross_participation_pct decimal(5,4) [note: 'The percentage of adjusted gross receipts or backend profits the talent is entitled to receive (e.g., 0.05 for 5% backend participation). Null if no backend participation is granted.']
  base_episode_fee decimal(15,2) [note: 'The guaranteed compensation amount per episode for episodic talent (actors, writers, directors). Expressed in the contract currency.']
  bonus_amount decimal(15,2) [note: 'The fixed or maximum bonus amount payable when the bonus threshold is met. Expressed in the contract currency. Null if no bonus provision exists.']
  bonus_threshold_description varchar [note: 'Textual description of the performance or milestone thresholds that trigger bonus payments (e.g., \'Nielsen rating above 2.0 in key demo\', \'box office exceeds $100M domestic\').']
  compensation_type varchar [note: 'Classification of the compensation arrangement: union scale (SAG-AFTRA, WGA, DGA minimum), over-scale (above union minimum), flat fee, episodic rate, weekly guarantee, daily rate, backend gross participation, deferred compensation, or residual-only deal. [ENUM-REF-CANDIDATE: union_scale|over_scale|flat_fee|episodic|weekly|daily|backend_participation|deferred|residual_only — 9 candidates stripped; promote to reference product]']
  created_timestamp timestamp [note: 'The date and time when this compensation structure record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code in which all monetary amounts in this compensation structure are denominated (e.g., USD, GBP, CAD).']
  daily_rate decimal(15,2) [note: 'The guaranteed daily compensation amount for talent engaged on a day-player or daily basis. Expressed in the contract currency.']
  deferred_compensation_amount decimal(15,2) [note: 'The total amount of compensation deferred to a future payment date or contingent event (e.g., series pickup, profitability milestone). Expressed in the contract currency.']
  deferred_payment_trigger varchar [note: 'The business event or milestone that triggers payment of deferred compensation (e.g., \'series_pickup\', \'profitability_threshold_met\', \'syndication_sale\', \'specific_date\').']
  effective_end_date date [note: 'The date on which this compensation structure ceases to be effective. Null for open-ended structures or those tied to contract termination.']
  effective_start_date date [note: 'The date on which this compensation structure becomes effective and applicable to the talent contract.']
  exclusivity_clause_flag boolean [note: 'Indicates whether this compensation structure includes an exclusivity provision restricting the talent from working on competing projects (True) or not (False).']
  last_modified_timestamp timestamp [note: 'The date and time when this compensation structure record was last updated or modified.']
  notes varchar [note: 'Free-text field for additional notes, special provisions, or clarifications regarding this compensation structure that do not fit into structured fields.']
  overtime_multiplier decimal(5,2) [note: 'The multiplier applied to the base rate for overtime hours worked (e.g., 1.5 for time-and-a-half, 2.0 for double-time). Null if overtime is not applicable.']
  pay_or_play_flag boolean [note: 'Indicates whether this compensation structure includes a pay-or-play provision, guaranteeing payment even if the talent is not used (True) or not (False).']
  pension_health_rate decimal(5,4) [note: 'The percentage rate of gross compensation contributed to the guild pension and health plan (e.g., 0.185 for 18.5% SAG-AFTRA P&H). Used to calculate employer contributions.']
  residual_base_formula varchar [note: 'The formula or method used to calculate the residual base for reuse payments (e.g., \'initial_compensation\', \'applicable_minimum\', \'pro_rata_share\'). Defines how residuals are computed per guild rules.']
  residual_eligibility_flag boolean [note: 'Indicates whether the talent is eligible to receive residual payments for reuse of the content under this compensation structure (True) or not (False). Typically True for union deals, may be False for buyouts.']
  step_up_amount decimal(15,2) [note: 'The incremental compensation increase amount when the step-up trigger is met. Expressed in the contract currency. Null if no step-up provision exists.']
  step_up_trigger varchar [note: 'The condition or event that triggers an automatic increase in compensation (e.g., \'season_2_pickup\', \'episode_13_renewal\', \'ratings_threshold\'). Null if no step-up provision exists.']
  structure_name varchar [note: 'Business-friendly name or label for this compensation structure (e.g., \'Series Regular Season 1\', \'Guest Star Rate Card\').']
  structure_status varchar [note: 'Current lifecycle status of the compensation structure: draft (under negotiation), active (in force), amended (modified after execution), superseded (replaced by a newer structure), or terminated (no longer applicable).']
  usage_rights_scope varchar [note: 'Description of the media usage rights covered by this compensation structure (e.g., \'initial broadcast only\', \'all media in perpetuity\', \'theatrical and SVOD\', \'domestic free television\'). Defines what exploitation is covered by the base compensation.']
  weekly_guarantee decimal(15,2) [note: 'The guaranteed weekly compensation amount for talent engaged on a weekly basis (e.g., series regulars, production staff). Expressed in the contract currency.']

  Note: 'Defines the detailed compensation terms attached to a talent contract — including base episode fee, weekly guarantee, daily rate, overtime multipliers, pension and health (P&H) contribution rates, residual base formula, backend gross participation percentage, deferred compensation schedule, and currency. Supports both union scale (SAG-AFTRA scale, DGA scale) and over-scale deals. Tracks step-up triggers (e.g., series pickup escalators), bonus thresholds, and pay-or-play provisions. Used by payroll and royalty workflows to calculate gross compensation and residual bases.'
}

Table talent.appearance_schedule {
  appearance_schedule_id varchar [pk, note: 'Unique identifier for the appearance schedule record. Primary key for the appearance schedule entity.']
  ad_order_id varchar [note: 'Foreign key linking to sales.ad_order. Business justification: Sponsored segment and branded integration appearances are commissioned via ad orders. Traffic and scheduling teams must confirm talent availability against the specific ad order driving the appearance']
  appearance_invoice_id varchar [note: 'Foreign key linking to billing.invoice. Business justification: Per-appearance fee invoicing: in live, talk, and variety production, talent is billed per appearance rather than per contract. Billing teams generate and reconcile appearance-specific invoices against']
  channel_id varchar [note: 'Foreign key linking to scheduling.channel. Business justification: Talent booking must track which channel the appearance is scheduled for to enforce exclusivity clauses, detect multi-channel conflicts, coordinate travel logistics, and apply channel-specific producti']
  content_episode_id varchar [note: 'Foreign key linking to content.content_episode. Business justification: Appearance schedules for episodic content must specify exact episode for production call sheets, per-episode compensation tracking, and daily production scheduling. Critical for episodic production op']
  contract_id varchar [note: 'Foreign key linking to talent.contract. Business justification: An appearance schedule entry represents a talent booking that is governed by a specific contract. The contract defines the terms, exclusivity clauses, and compensation under which the talent appears. ']
  daypart_id varchar [note: 'Foreign key linking to scheduling.daypart. Business justification: Talent compensation and availability vary by daypart (primetime vs. daytime rates, union rules). Booking systems must track daypart for rate calculation, availability matching, and contract compliance']
  production_project_id varchar [note: 'Reference to the production (film, television episode, live broadcast, promotional event) for which the talent is scheduled.']
  program_schedule_id varchar [note: 'Foreign key linking to scheduling.program_schedule. Business justification: Appearance bookings must link to the specific daily program schedule for production coordination, call-time synchronization, and rundown integration. Enables talent department to track which broadcast']
  rescheduled_from_appearance_schedule_id varchar [note: 'Reference to the original appearance schedule record if this schedule is a rescheduled version of a previous booking.']
  role_id varchar [note: 'Foreign key linking to talent.role. Business justification: Each appearance schedule entry is for a talent performing a specific role (character, host, correspondent, etc.). The role record defines the character_name, role_category, billing_position, and usage']
  schedule_slot_id varchar [note: 'Foreign key linking to scheduling.schedule_slot. Business justification: Each appearance booking must reference the specific schedule slot for precise timing, conflict detection, playout system integration, and as-run confirmation. Enables bidirectional sync between talent']
  sweeps_period_id varchar [note: 'Foreign key linking to audience.sweeps_period. Business justification: Programming strategy concentrates high-profile talent appearances during Nielsen sweeps periods to maximize ratings that set advertising rates. Production schedulers coordinate talent bookings with sw']
  talent_profile_id varchar [note: 'Reference to the talent (actor, director, writer, producer, host, correspondent, crew member) associated with this appearance schedule.']
  target_demographic_segment_id varchar [note: 'Foreign key linking to audience.demographic_segment. Business justification: Talent bookings are made to serve specific demographic targets (e.g., guest booked to lift W25-54). Programming and sales operations track the intended demographic for each appearance to validate guar']
  title_id varchar [note: 'Reference to the content title (series, film, special) associated with this appearance.']
  actual_duration_hours decimal(5,2) [note: 'The actual number of hours the talent was engaged for this appearance, recorded after completion for payroll and residual calculation purposes.']
  appearance_type varchar [note: 'Classification of the type of appearance or activity scheduled for the talent. ADR (Automated Dialogue Replacement) refers to post-production voice recording sessions. [ENUM-REF-CANDIDATE: principal_photography|adr_session|promotional_appearance|press_junket|live_broadcast|table_read|rehearsal|wardrobe_fitting|makeup_test|screen_test — 10 candidates stripped; promote to reference product]']
  availability_window_end date [note: 'The end date of the period during which the talent has indicated availability for scheduling.']
  availability_window_start date [note: 'The start date of the period during which the talent has indicated availability for scheduling.']
  booking_reference varchar [note: 'Externally-known unique booking reference code assigned to this appearance schedule by the production scheduling system.']
  call_date date [note: 'The scheduled date on which the talent is required to appear for the activity. Follows yyyy-MM-dd format.']
  call_time timestamp [note: 'The specific date and time when the talent must report to the location. Follows yyyy-MM-ddTHH:mm:ss.SSSXXX format.']
  cancellation_reason varchar [note: 'Free-text explanation of why the appearance schedule was cancelled, such as production delays, talent unavailability, or budget constraints.']
  cancellation_timestamp timestamp [note: 'The date and time when this appearance schedule was cancelled, if applicable.']
  confirmation_status varchar [note: 'Current lifecycle status of the appearance schedule indicating whether the booking is pending confirmation, confirmed, cancelled, rescheduled, completed, or resulted in a no-show.']
  created_timestamp timestamp [note: 'The date and time when this appearance schedule record was first created in the system.']
  daypart varchar [note: 'The time segment of the broadcast day during which the appearance is scheduled, relevant for live broadcast appearances and promotional activities. [ENUM-REF-CANDIDATE: early_morning|morning|midday|afternoon|prime_time|late_night|overnight — 7 candidates stripped; promote to reference product]']
  estimated_duration_hours decimal(5,2) [note: 'The estimated number of hours the talent is expected to be engaged for this appearance, used for scheduling and compensation planning.']
  exclusivity_conflict_flag boolean [note: 'Boolean flag indicating whether this appearance schedule conflicts with any exclusivity clauses in the talent\'s contract.']
  guild_notification_required boolean [note: 'Boolean flag indicating whether guild notification is required for this appearance per union agreements (SAG-AFTRA, WGA, DGA).']
  guild_notification_sent_timestamp timestamp [note: 'The date and time when notification was sent to the relevant guild regarding this appearance schedule.']
  hold_level varchar [note: 'Priority level of the talent booking indicating the strength of the commitment. First hold is highest priority, second and third holds are lower priority backups, first refusal gives talent right to accept or decline before offering to others.']
  last_modified_by_user varchar [note: 'The username or identifier of the user who most recently modified this appearance schedule record.']
  last_modified_timestamp timestamp [note: 'The date and time when this appearance schedule record was most recently updated.']
  playout_system_sync_status varchar [note: 'Status indicating whether this appearance schedule has been synchronized with the playout and channel management system (Ericsson MediaFirst) for live broadcast coordination.']
  playout_system_sync_timestamp timestamp [note: 'The date and time when this appearance schedule was last synchronized with the playout system.']
  release_tracking_status varchar [note: 'Status of obtaining necessary talent releases, waivers, or permissions required for the appearance, particularly for promotional and publicity activities.']
  scheduling_notes varchar [note: 'Free-text field for additional scheduling information, special requirements, or coordination notes relevant to this appearance.']
  unavailability_reason varchar [note: 'Free-text explanation of why the talent is unavailable during certain periods, such as personal commitments, conflicting bookings, or contractual exclusivity.']
  wrap_time timestamp [note: 'The actual or estimated date and time when the talent completed their scheduled activity and was released from the set or location.']

  Note: 'Operational schedule of talent time allocation — covering confirmed bookings, holds (first/second/third), first refusals, availability windows, and personal unavailability alongside specific call times for principal photography, ADR sessions, promotional appearances, press junkets, and live broadcast slots. Records production reference, call date/time, wrap time, location, appearance type, hold level, confirmation status, and release tracking. Integrates with production scheduling and playout systems to ensure talent availability aligns with broadcast calendars.'
}

Table talent.credit_attribution {
  credit_attribution_id varchar [pk, note: 'Unique identifier for the credit attribution record. Primary key.']
  content_episode_id varchar [note: 'Foreign key linking to content.content_episode. Business justification: Episode-level credits are the most granular operational unit for EPG metadata, streaming platform delivery (streaming_metadata_flag), and guild credit arbitration. credit_attribution already links to ']
  contract_id varchar [note: 'Foreign key linking to talent.contract. Business justification: Credit attribution defines on-screen and promotional credit entitlements that are contractually mandated. The contract contains credit_placement_requirements and credit_size_percentage which are the s']
  coproduction_agreement_id varchar [note: 'Foreign key linking to partner.coproduction_agreement. Business justification: Co-production agreements specify contractual credit obligations (possessory credits, billing positions, card sizes). Credit attribution must be directly traceable to the co-production agreement to ver']
  delivery_channel_id varchar [note: 'Foreign key linking to distribution.delivery_channel. Business justification: Credit display requirements vary by delivery channel — broadcast EPG credits differ from FAST channel metadata and VOD platform credits. Guild contracts specify channel-type-specific credit obligation']
  role_id varchar [note: 'Foreign key linking to talent.talent_role. Business justification: credit_attribution defines on-screen and promotional credits for a talent on a specific production. talent_role defines the role/function performed (role_name, character_name, role_category). Currentl']
  season_id varchar [note: 'Foreign key linking to content.season. Business justification: Season-specific credits (e.g., season showrunner changes, guest producers) require season-level attribution for accurate metadata, season-specific residuals, and platform EPG data.']
  series_id varchar [note: 'Foreign key linking to content.series. Business justification: Series-level credits (Created by, Executive Producer) require direct series link for proper attribution across all episodes, series-level residuals, and metadata distribution to platforms.']
  syndication_agreement_id varchar [note: 'Foreign key linking to partner.syndication_agreement. Business justification: Syndication agreements contain specific credit placement and billing block requirements. Credit attribution records must be verifiable against the syndication agreement\'s credit obligations for partne']
  talent_profile_id varchar [note: 'Reference to the talent (actor, director, writer, producer, host, correspondent, crew member) receiving this credit.']
  title_id varchar [note: 'Reference to the content asset (title, episode, series, production) for which this credit is attributed.']
  approval_date date [note: 'The date on which this credit attribution was formally approved by all relevant parties (talent, guild, production company).']
  billing_block varchar [note: 'The section or block within the credits where this attribution appears: above title, title card, opening sequence, closing sequence, end crawl, or promotional materials.']
  billing_position varchar [note: 'The numerical position of this credit in the credit sequence. Lower numbers indicate higher prominence (e.g., 1 = first position, 2 = second position). Null indicates alphabetical or unordered placement.']
  card_size_percentage decimal(5,2) [note: 'The size of the talent credit card relative to the title card, expressed as a percentage (e.g., 100.00 means same size as title, 75.00 means 75% of title size). Contractually mandated for high-profile talent.']
  created_timestamp timestamp [note: 'The timestamp when this credit attribution record was first created in the system.']
  credit_approval_status varchar [note: 'The current approval status of this credit attribution: draft (not finalized), pending approval (awaiting talent or guild review), approved (finalized and contractually binding), disputed (under arbitration), or waived (talent declined credit).']
  credit_determination_method varchar [note: 'The method by which this credit was determined: contractual (per talent agreement), guild arbitration (resolved by guild dispute process), mutual agreement (negotiated between parties), or statutory (mandated by regulation).']
  credit_duration_seconds decimal(6,2) [note: 'The minimum duration in seconds that the credit card must be displayed on screen, as contractually required.']
  credit_format varchar [note: 'The format in which the credit is displayed: single card (talent alone), shared card (multiple talents on one card), alphabetical (ordered alphabetically with peers), or separate card (dedicated card for this talent).']
  credit_notes varchar [note: 'Additional notes or comments regarding this credit attribution, including special instructions, historical context, or clarifications for production and distribution teams.']
  credit_placement varchar [note: 'Specifies where the credit must appear: opening credits, closing credits, both, or promotional materials only.']
  credit_source_system varchar [note: 'The operational system of record from which this credit attribution was sourced (e.g., Dalet Galaxy, Rightsline, production management system).']
  credit_text varchar [note: 'The exact contractually mandated credit language or text that must appear on screen or in promotional materials (e.g., \'Directed by\', \'Written by\', \'Starring\', \'A Film By\', \'Executive Producer\').']
  credit_type varchar [note: 'The type of credit being attributed: main title (opening credits), end title (closing credits), possessory credit (e.g., \'A Film By\'), and credit, with credit, special appearance, or guest star designation. [ENUM-REF-CANDIDATE: main_title|end_title|possessory_credit|and_credit|with_credit|special_appearance|guest_star — 7 candidates stripped; promote to reference product]']
  credit_waiver_flag boolean [note: 'Indicates whether the talent has waived their contractual right to receive this credit (e.g., for creative or personal reasons).']
  credit_waiver_reason varchar [note: 'The documented reason for the credit waiver, if applicable (e.g., \'Creative decision\', \'Pseudonym requested\', \'Guild arbitration outcome\').']
  effective_end_date date [note: 'The date on which this credit attribution expires or is superseded (e.g., due to contract renegotiation, credit correction, or content retirement). Null indicates indefinite validity.']
  effective_start_date date [note: 'The date from which this credit attribution becomes effective and must be applied to all content distributions and promotional materials.']
  epg_display_flag boolean [note: 'Indicates whether this credit should be displayed in the Electronic Program Guide (EPG) metadata for linear and on-demand platforms.']
  possessory_credit_flag boolean [note: 'Indicates whether this is a possessory credit (e.g., \'A Film By [Name]\'), which is a special contractual entitlement typically reserved for directors or executive producers with significant creative control.']
  promotional_materials_flag boolean [note: 'Indicates whether this credit must appear in promotional materials (posters, trailers, advertisements) as contractually required.']
  pseudonym varchar [note: 'The pseudonym or stage name to be used in the credit if the talent does not wish to use their legal name (e.g., \'Alan Smithee\' for directors, pen names for writers).']
  residual_eligibility_flag boolean [note: 'Indicates whether this credit attribution makes the talent eligible for residual payments (reuse payments) under guild agreements when the content is rebroadcast, syndicated, or distributed on secondary platforms.']
  streaming_metadata_flag boolean [note: 'Indicates whether this credit should be included in streaming platform metadata (e.g., Netflix, Hulu, Disney+) for title cards and cast/crew information.']
  updated_by varchar [note: 'The user or system identifier that last modified this credit attribution record.']
  updated_timestamp timestamp [note: 'The timestamp when this credit attribution record was last modified.']
  created_by varchar [note: 'The user or system identifier that created this credit attribution record.']

  Note: 'Defines the on-screen and promotional credit entitlements for each talent on a specific production or content asset — capturing credit type (main title, end title, possessory credit, \'and\' credit, \'with\' credit), billing position (first position, second position, alphabetical), credit card size relative to title card, credit placement (opening, closing, both), contractually mandated credit language, and any approved credit waivers. Feeds EPG metadata, digital asset packaging, and streaming platform title cards. Governed by DGA, WGA, and SAG-AFTRA credit determination rules.'
}

Table talent.residual_payment {
  residual_payment_id varchar [pk, note: 'Unique identifier for the residual payment transaction.']
  billing_payment_id varchar [note: 'Foreign key linking to billing.payment. Business justification: Residual payment reconciliation: residual_payment tracks the talent-domain disbursement record while billing.payment tracks the actual financial transaction. Media broadcasting finance teams reconcile']
  carriage_agreement_id varchar [note: 'Foreign key linking to distribution.carriage_agreement. Business justification: Cable and satellite retransmission residuals (required under WGA, SAG-AFTRA CBAs) are calculated per carriage agreement. Linking residual payments to the specific carriage agreement enables per-agreem']
  contract_id varchar [note: 'Reference to the talent contract governing this residual payment.']
  distribution_agreement_id varchar [note: 'Foreign key linking to partner.distribution_agreement. Business justification: Residual payments for new media and streaming windows are calculated based on distribution agreement terms (SVOD, AVOD, TVOD windows). Guild audit reports require tracing residuals to the specific dis']
  guild_affiliation_id varchar [note: 'Foreign key linking to talent.guild_affiliation. Business justification: Residual payments are governed by guild/union Collective Bargaining Agreements (CBAs). The guild_affiliation record contains the authoritative cba_version, cba_effective_date, cba_expiration_date, res']
  playout_event_id varchar [note: 'Foreign key linking to scheduling.playout_event. Business justification: Residual calculations are triggered by actual transmissions. Linking payments to specific playout events provides audit trail for exhibition dates, territories, transmission types, and usage required ']
  production_episode_id varchar [note: 'Foreign key linking to production.production_episode. Business justification: Residual calculations for episodic talent (actors, directors, writers) are computed per episode for reruns, streaming, and syndication. Guild reporting and payment processing require episode-level gra']
  project_id varchar [note: 'Foreign key linking to production.project. Business justification: Residual payments triggered by content licensing deals (SVOD/AVOD distribution). Real business process: when content is licensed via sales deal, residuals calculated based on deal\'s distribution metri']
  release_window_id varchar [note: 'Foreign key linking to distribution.release_window. Business justification: Guild residual calculation (SAG-AFTRA, WGA) requires linking each payment to the specific release window (theatrical, SVOD, AVOD) that triggered it. Residual rates differ by window type. The plain-tex']
  representation_agreement_id varchar [note: 'Foreign key linking to talent.representation_agreement. Business justification: Residual payments are routed through talent agencies based on the active representation agreement (representation_agreement.residual_routing_flag). The agent_commission_amount on residual_payment is c']
  role_id varchar [note: 'Foreign key linking to talent.role. Business justification: Residual payments are calculated based on the specific role a talent performed — the role determines the residual_rate_code, usage_rights_media, and usage_rights_territory that govern the payment calc']
  syndication_agreement_id varchar [note: 'Foreign key linking to partner.syndication_agreement. Business justification: Guild-mandated residual payment calculation (SAG-AFTRA, WGA) requires tracing which syndication agreement triggered the exhibition event. Residual rates and use-type classifications are determined by ']
  talent_profile_id varchar [note: 'Reference to the talent receiving the residual payment.']
  title_id varchar [note: 'Foreign key linking to content.title. Business justification: SAG-AFTRA/WGA residual reporting requires direct linkage between a residual payment and the specific title whose reuse triggered it. Residual auditors and guild compliance officers need title-level tr']
  ach_trace_number varchar [note: 'The ACH trace number if the payment method is ACH or direct deposit, used for reconciliation and audit.']
  agent_commission_amount decimal(15,2) [note: 'The agent or manager commission amount deducted from the residual payment, if applicable.']
  audit_report_date date [note: 'The date on which this residual payment was included in a guild audit report.']
  audit_report_flag boolean [note: 'Indicates whether this residual payment has been included in a guild audit report (SAG-AFTRA, WGA, DGA).']
  check_number varchar [note: 'The check number if the payment method is check, used for reconciliation and audit.']
  created_timestamp timestamp [note: 'The timestamp when this residual payment record was first created in the system.']
  exhibition_end_date date [note: 'The end date of the exhibition period for which this residual is calculated.']
  exhibition_start_date date [note: 'The start date of the exhibition period for which this residual is calculated.']
  gross_residual_amount decimal(15,2) [note: 'The gross residual amount calculated before deductions, in the payment currency.']
  net_payment_amount decimal(15,2) [note: 'The net residual payment amount after all deductions, paid to the talent.']
  payment_currency_code varchar [note: 'The three-letter ISO 4217 currency code for the residual payment (e.g., USD, GBP, EUR).']
  payment_date date [note: 'The date on which the residual payment was issued or disbursed to the talent.']
  payment_method varchar [note: 'The method used to disburse the residual payment to the talent.']
  payment_notes varchar [note: 'Free-text notes or comments related to this residual payment, including special circumstances, adjustments, or exceptions.']
  payment_number varchar [note: 'Business identifier for the residual payment, used for external reference and reconciliation.']
  payment_status varchar [note: 'Current lifecycle status of the residual payment transaction.']
  pension_health_amount decimal(15,2) [note: 'The pension and health contribution amount deducted from the gross residual, as required by guild agreements.']
  remittance_advice_sent_date date [note: 'The date on which the remittance advice was sent to the talent.']
  remittance_advice_sent_flag boolean [note: 'Indicates whether a remittance advice document was sent to the talent for this payment.']
  royalty_calculation_reference varchar [note: 'Reference to the Rightsline royalty calculation record that generated this residual payment.']
  updated_timestamp timestamp [note: 'The timestamp when this residual payment record was last modified.']
  use_type varchar [note: 'The type of content reuse triggering the residual payment (broadcast, cable, SVOD, AVOD, TVOD, FAST, home video, foreign distribution, theatrical). [ENUM-REF-CANDIDATE: broadcast|cable|SVOD|AVOD|TVOD|FAST|home_video|foreign|theatrical — 9 candidates stripped; promote to reference product]']
  wire_reference_number varchar [note: 'The wire transfer reference number if the payment method is wire transfer, used for reconciliation and audit.']
  withholding_tax_amount decimal(15,2) [note: 'The tax amount withheld from the residual payment for federal, state, or foreign tax obligations.']

  Note: 'Transactional record of each residual payment issued to talent for reuse of content across broadcast, home video, streaming (SVOD, AVOD, TVOD), FAST, and foreign distribution windows. Captures payment cycle, content asset reference, use type, distribution window, gross residual amount, P&H contribution amount, withholding tax amount, net payment amount, payment method, payment date, check or ACH reference, and remittance advice sent flag. Reconciles against Rightsline royalty calculations and SAP S/4HANA AP postings. Supports SAG-AFTRA and WGA audit requirements.'
}

Table talent.deal_memo {
  deal_memo_id varchar [pk, note: 'Unique identifier for the talent deal memo record. Primary key.']
  advance_invoice_id varchar [note: 'Foreign key linking to billing.invoice. Business justification: Deal memo advance invoicing: deal memos frequently trigger advance or signing-bonus invoices before the long-form contract is executed. Billing teams in media broadcasting must trace which invoice was']
  billing_account_id varchar [note: 'The Salesforce Media Cloud opportunity or proposal record identifier from which this deal memo was generated.']
  campaign_id varchar [note: 'Foreign key linking to sales.campaign. Business justification: In AFP and branded content deals, the talent deal memo is directly funded by a specific advertiser campaign. Linking deal_memo to campaign enables campaign budget reconciliation against talent costs, ']
  coproduction_agreement_id varchar [note: 'Foreign key linking to partner.coproduction_agreement. Business justification: Co-production deal memos must reference the co-production agreement to enforce credit obligations, compensation caps, and residuals-sharing formulas. Without this link, deal memo terms cannot be valid']
  long_form_contract_id varchar [note: 'Reference to the executed long-form talent contract that supersedes this deal memo. Null if the long-form contract has not yet been executed.']
  ott_platform_id varchar [note: 'Foreign key linking to distribution.ott_platform. Business justification: Talent deal memos in streaming-era broadcasting are frequently platform-specific (e.g., a Netflix exclusive deal memo, an Apple TV+ first-look deal). Deal memos precede formal contracts and must refer']
  partner_id varchar [note: 'Foreign key linking to partner.partner_partner. Business justification: Deal memos reference the commissioning partner entity (studio, network, streamer) for deal tracking and relationship management. Critical for converting deal memos to long-form contracts and tracking ']
  production_title_id varchar [note: 'Reference to the production title (series, episode, film, special) for which the talent is engaged.']
  role_id varchar [note: 'Foreign key linking to talent.role. Business justification: A deal memo captures the agreed commercial terms for a talent engagement in a specific role. The role_function string on deal_memo is a denormalized description of the role being engaged. Once the for']
  season_id varchar [note: 'Foreign key linking to content.season. Business justification: Season-level deal memos are standard in TV production — talent is frequently contracted for a specific season (e.g., series regular for Season 3 only). deal_memo already links to series but not season']
  series_id varchar [note: 'Foreign key linking to content.series. Business justification: Deal memos for episodic content reference series for series commitment tracking, multi-season option terms, and episode count guarantees. Essential for TV talent deal management.']
  talent_profile_id varchar [note: 'Reference to the talent (actor, director, writer, producer, host, correspondent, crew member) engaged under this deal memo.']
  agent_contact_email varchar [note: 'Primary email address of the talent agent or representative for deal-related communication.']
  agent_contact_phone varchar [note: 'Primary phone number of the talent agent or representative for deal-related communication.']
  agent_name varchar [note: 'Name of the talent agent or representative who negotiated the deal memo on behalf of the talent.']
  compensation_amount decimal(15,2) [note: 'The primary monetary compensation amount agreed in the deal memo (e.g., total fee, per-episode rate, or guaranteed minimum).']
  compensation_currency varchar [note: 'Three-letter ISO 4217 currency code for the compensation amount (e.g., USD, GBP, EUR).']
  compensation_summary varchar [note: 'High-level summary of the compensation structure agreed in the deal memo (e.g., per-episode fee, flat fee, day rate, backend participation). Detailed breakdowns are captured in the long-form contract.']
  countersigned_date date [note: 'The date on which the deal memo was countersigned by both the talent (or agent) and the production company, making it a binding interim agreement. Null if not yet countersigned.']
  created_timestamp timestamp [note: 'Timestamp when the deal memo record was first created in the system.']
  credit_position varchar [note: 'The agreed on-screen or off-screen credit position and format (e.g., \'Main Title Card\', \'Opening Credits\', \'End Crawl\', \'Shared Card\', \'Single Card\').']
  deal_date date [note: 'The date on which the deal terms were verbally agreed or the deal memo was initially drafted.']
  deal_memo_number varchar [note: 'Externally-known unique business identifier for the deal memo, typically generated by the CRM or legal system.']
  deal_memo_status varchar [note: 'Current lifecycle status of the deal memo: draft (under negotiation), countersigned (binding interim agreement), superseded_by_long_form (replaced by executed contract), expired (lapsed without execution), cancelled (deal fell through).']
  effective_date date [note: 'The date on which the deal memo becomes binding (typically the date of countersignature by both parties).']
  engagement_end_date date [note: 'The date on which the talent engagement is scheduled to end. Null for open-ended or option-based engagements.']
  engagement_start_date date [note: 'The date on which the talent engagement is scheduled to begin (first day of work, rehearsal, or availability).']
  episode_count varchar [note: 'Number of episodes or production units covered by this deal memo. Null if the engagement is for a single film or special.']
  exclusivity_summary varchar [note: 'High-level summary of exclusivity terms (e.g., exclusive to network during production, non-exclusive, first-look, holdback period). Detailed clauses are in the long-form contract.']
  expiration_date date [note: 'The date by which the deal memo must be superseded by a long-form contract or it will expire. Null if no expiration is set.']
  guild_affiliation varchar [note: 'The guild or union to which the talent belongs: SAG-AFTRA (Screen Actors Guild - American Federation of Television and Radio Artists), DGA (Directors Guild of America), WGA (Writers Guild of America), IATSE (International Alliance of Theatrical Stage Employees), or non_union.']
  last_modified_by_user varchar [note: 'Username or identifier of the user who last modified the deal memo record.']
  last_modified_timestamp timestamp [note: 'Timestamp when the deal memo record was last modified in the system.']
  notes varchar [note: 'Free-text notes capturing additional context, special provisions, or negotiation history relevant to the deal memo.']
  option_terms varchar [note: 'Summary of any option clauses (e.g., network option for additional seasons, talent option to extend, mutual option). Null if no options are included.']
  residual_eligibility_flag boolean [note: 'Indicates whether the talent is eligible for residual payments under guild agreements for reuse, syndication, or secondary distribution. True if eligible, False otherwise.']
  superseded_date date [note: 'The date on which the deal memo was superseded by the execution of a long-form contract. Null if not yet superseded.']

  Note: 'Pre-contract deal memo capturing the agreed commercial terms for a talent engagement before the formal long-form contract is executed — including deal date, production title, role or function, episode count, start date, compensation summary, credit position, exclusivity summary, option terms, and deal memo status (draft, countersigned, superseded by long-form). Serves as the binding interim agreement used by production and legal teams during the gap between verbal deal and executed contract. Sourced from Salesforce Media Cloud opportunity and proposal records.'
}

Table talent.role {
  role_id varchar [pk, note: 'Unique identifier for the talent role assignment. Primary key for the talent role entity.']
  campaign_id varchar [note: 'Foreign key linking to sales.campaign. Business justification: In advertiser-funded programming (AFP), a campaign directly commissions specific talent roles (e.g., brand spokesperson, host). Linking role to campaign enables AFP budget tracking, campaign performan']
  content_episode_id varchar [note: 'Foreign key linking to content.content_episode. Business justification: Episode-specific role assignments (guest star in episode 5, day player) are a fundamental casting and guild reporting concept. role already links to season/series/title but not episode. Guild residual']
  contract_id varchar [note: 'Reference to the talent contract governing the terms of this role engagement, including compensation, usage rights, and obligations.']
  talent_profile_id varchar [note: 'Reference to the talent individual performing this role. Links to the talent master entity.']
  above_the_line_flag boolean [note: 'Indicates whether this role is classified as above-the-line (creative principals: actors, directors, writers, producers) or below-the-line (technical crew and support staff). Impacts budget allocation and residual calculations.']
  appearance_count varchar [note: 'Total number of episodes, segments, or appearances in which this talent role is featured. Used for episodic and recurring roles.']
  billing_position varchar [note: 'The numerical order in which the talent appears in the credits (1 = first billed, 2 = second billed, etc.). Determines prominence in marketing materials and on-screen credits.']
  category varchar [note: 'Classification of the role type indicating the nature and scope of the talent\'s engagement. Determines compensation structure, credit placement, and residual eligibility. [ENUM-REF-CANDIDATE: series_regular|recurring|guest_star|day_player|featured_extra|host|correspondent|narrator|voice_artist|director|writer|showrunner|executive_producer|line_producer|cinematographer|editor|composer|production_designer|costume_designer|makeup_artist|stunt_coordinator|other — promote to reference product]']
  character_name varchar [note: 'The name of the character portrayed by the talent for on-screen roles. Null for off-screen roles such as crew, directors, or producers.']
  compensation_amount decimal(15,2) [note: 'The monetary compensation amount for this role engagement in the contract currency. Excludes residuals and backend participation.']
  compensation_currency varchar [note: 'Three-letter ISO 4217 currency code for the compensation amount (e.g., USD, GBP, EUR).']
  compensation_type varchar [note: 'The structure of compensation for this role (flat fee, daily rate, weekly rate, episodic fee, backend participation, royalty, deferred payment). [ENUM-REF-CANDIDATE: flat_fee|daily_rate|weekly_rate|episodic_fee|backend_participation|royalty|deferred|other — 8 candidates stripped; promote to reference product]']
  created_timestamp timestamp [note: 'The date and time when this talent role record was first created in the system.']
  credit_text varchar [note: 'The exact text of the credit as it appears on-screen or in marketing materials, including any special formatting or possessory credits (e.g., \'A Film By\', \'Created By\').']
  credit_type varchar [note: 'Specifies where and how the talent\'s credit appears in the production (opening credits, closing credits, main titles, end titles, special thanks, or no credit).']
  end_date date [note: 'The date on which the talent\'s engagement for this role concludes. Null for ongoing or open-ended engagements.']
  episode_scope_end varchar [note: 'The last episode number in which this talent role appears. Null indicates ongoing engagement or single-episode appearance.']
  episode_scope_start varchar [note: 'The first episode number in which this talent role appears. Used for episodic content to define the scope of the talent\'s engagement.']
  exclusivity_flag boolean [note: 'Indicates whether the talent is bound by exclusivity clauses preventing them from performing similar roles for competing productions during the engagement period.']
  exclusivity_scope varchar [note: 'Description of the scope and limitations of any exclusivity clause (e.g., \'No competing streaming series\', \'No theatrical films during production\').']
  guild_affiliation varchar [note: 'The labor union or guild under whose jurisdiction this role falls (SAG-AFTRA for actors, WGA for writers, DGA for directors, IATSE for crew). Determines minimum compensation, working conditions, and residual eligibility. [ENUM-REF-CANDIDATE: sag_aftra|wga|dga|iatse|mpeg|non_union|other — 7 candidates stripped; promote to reference product]']
  name varchar [note: 'The specific role or function the talent is engaged to perform (e.g., Lead Actor, Director, Executive Producer, Cinematographer, Script Supervisor).']
  notes varchar [note: 'Free-text field for additional notes, special instructions, or contextual information about this talent role assignment (e.g., special credit requirements, scheduling constraints, performance notes).']
  residual_eligible_flag boolean [note: 'Indicates whether this role is eligible for residual payments based on subsequent distribution, reuse, or syndication of the content. Determined by guild agreements and contract terms.']
  residual_rate_code varchar [note: 'Code identifying the residual payment rate schedule applicable to this role based on guild agreements, role category, and distribution windows.']
  role_status varchar [note: 'Current lifecycle status of the talent role assignment indicating the stage of engagement from negotiation through completion. [ENUM-REF-CANDIDATE: confirmed|tentative|in_negotiation|contracted|active|completed|cancelled|suspended — 8 candidates stripped; promote to reference product]']
  screen_time_minutes decimal(8,2) [note: 'Total on-screen time in minutes for this talent role across all appearances. Used for on-screen talent to measure prominence and for residual calculations.']
  start_date date [note: 'The date on which the talent\'s engagement for this role begins, typically the first day of principal photography, recording, or production work.']
  stunt_double_flag boolean [note: 'Indicates whether this role involves stunt work or if a stunt double is used for this character. Impacts insurance, safety protocols, and credit attribution.']
  updated_timestamp timestamp [note: 'The date and time when this talent role record was last modified in the system.']
  usage_rights_duration_years varchar [note: 'Number of years for which usage rights are granted. Null indicates perpetual rights.']
  usage_rights_media varchar [note: 'Media platforms and formats for which usage rights are granted (e.g., \'Theatrical, Home Video, Streaming, Broadcast TV\').']
  usage_rights_territory varchar [note: 'Geographic territories in which the content featuring this talent role may be distributed and exploited (e.g., \'Worldwide\', \'North America\', \'USA and Canada\').']
  voice_only_flag boolean [note: 'Indicates whether this is a voice-only role (voice-over, narration, animation, ADR) with no on-screen physical appearance by the talent.']

  Note: 'Defines the specific role or function a talent is engaged to perform within a production or content asset — capturing role name, character name (for on-screen talent), role category (series regular, recurring, guest star, day player, featured extra, host, correspondent, narrator, voice artist, director, writer, showrunner, executive producer, line producer, DP, editor), above-the-line or below-the-line classification, episode or segment scope, and role status. Provides the granular link between talent identity and their specific creative contribution to each content asset.'
}

Table talent.talent_agency {
  talent_agency_id varchar [pk, note: 'Unique identifier for the talent agency or management company. Primary key for the talent_agency product.']
  partner_id varchar [note: 'Foreign key linking to partner.partner_partner. Business justification: Talent agencies are business partners in the media ecosystem, tracked for commission payment routing, franchise compliance verification, and strategic relationship management. Essential for partner pe']
  regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: Talent agencies are subject to state franchise and licensing regulatory obligations (e.g., California Talent Agencies Act, guild franchise rules). Compliance teams track which regulatory obligation go']
  sales_account_id varchar [note: 'Foreign key linking to sales.sales_account. Business justification: Talent agencies act as licensors/sellers of talent services to networks/advertisers, tracked as sales accounts for commission payments, contract management, and revenue recognition. Real business proc']
  address_line_1 varchar [note: 'The first line of the agency\'s primary business address, typically containing street number and street name.']
  address_line_2 varchar [note: 'The second line of the agency\'s primary business address, typically containing suite, floor, or building information.']
  agency_type varchar [note: 'Classification of the representation entity: talent agency (licensed to procure employment), literary agency (represents writers), management company (career guidance), law firm (legal representation), publicity firm (public relations), or hybrid (multiple services).']
  bank_account_name varchar [note: 'The name on the bank account used for commission and residual payments to the agency.']
  bank_account_number varchar [note: 'The bank account number for electronic funds transfer of commissions and residuals to the agency.']
  bank_routing_number varchar [note: 'The bank routing number (ABA number in the US, sort code in UK, or equivalent) for electronic funds transfer of commissions and residuals.']
  city varchar [note: 'The city or municipality where the agency\'s primary office is located.']
  country_code varchar [note: 'The three-letter ISO country code for the country where the agency\'s primary office is located (e.g., USA, GBR, CAN).']
  created_timestamp timestamp [note: 'The timestamp when this talent agency record was first created in the system. Immutable audit field.']
  dba_name varchar [note: 'The trade name or doing-business-as name under which the agency operates, if different from the legal name.']
  established_date date [note: 'The date on which the talent agency was originally established or incorporated.']
  fax_number varchar [note: 'The fax number for the agency, used for contract transmission and official correspondence in jurisdictions where fax is still required.']
  franchise_effective_date date [note: 'The date on which the SAG-AFTRA franchise agreement became effective for this agency.']
  franchise_expiration_date date [note: 'The date on which the current SAG-AFTRA franchise agreement expires and must be renewed.']
  franchise_number varchar [note: 'The unique franchise identification number issued by SAG-AFTRA to franchised talent agencies.']
  franchise_status varchar [note: 'Indicates whether the agency holds a valid SAG-AFTRA franchise agreement, which authorizes the agency to represent union talent. Franchised agencies agree to standard commission rates and contract terms.']
  legal_name varchar [note: 'The full legal registered name of the talent agency or management company as it appears on contracts and official documents.']
  license_effective_date date [note: 'The date on which the state talent agency license became effective.']
  license_expiration_date date [note: 'The date on which the state talent agency license expires and must be renewed.']
  license_number varchar [note: 'The state-issued license number authorizing the agency to operate as a talent agency. Required in jurisdictions such as California under the Talent Agencies Act.']
  license_state varchar [note: 'The state or province that issued the talent agency license. Use standard two-letter state/province codes.']
  notes varchar [note: 'Free-form notes field for additional context, special handling instructions, historical information, or relationship management details relevant to the agency.']
  payment_terms varchar [note: 'The standard payment terms and conditions for commission remittance, including timing and method of payment (e.g., net 30 days, upon talent payment receipt).']
  postal_code varchar [note: 'The postal or ZIP code for the agency\'s primary business address.']
  primary_contact_name varchar [note: 'The name of the primary contact person at the agency for contract negotiations, deal correspondence, and residual remittances.']
  primary_contact_title varchar [note: 'The job title or role of the primary contact person (e.g., President, Partner, Agent, Business Affairs Manager).']
  primary_email varchar [note: 'The primary email address for official correspondence, contract delivery, and residual payment notifications.']
  primary_phone varchar [note: 'The primary telephone number for the agency, including country and area codes.']
  roster_size varchar [note: 'The approximate number of talent clients currently represented by the agency. Used for agency scale assessment and negotiation context.']
  specialization varchar [note: 'The primary area of talent specialization or focus for the agency (e.g., film and television actors, commercial talent, voice-over artists, writers, directors, below-the-line crew, music artists). Free-text field to accommodate multiple specializations.']
  standard_commission_rate decimal(5,2) [note: 'The standard commission rate percentage that the agency charges for talent representation, typically 10% for franchised agencies under SAG-AFTRA rules. Expressed as a percentage (e.g., 10.00 for 10%).']
  state_province varchar [note: 'The state, province, or region where the agency\'s primary office is located. Use standard two-letter codes where applicable.']
  status_effective_date date [note: 'The date on which the current status became effective.']
  talent_agency_status varchar [note: 'The current operational status of the talent agency: active (currently representing talent), inactive (not currently operating), suspended (temporarily not authorized), pending_verification (under review), or dissolved (permanently closed).']
  tax_identifier varchar [note: 'The tax identification number (EIN in the US, VAT number in EU) for the agency, used for tax reporting and residual payment processing.']
  updated_timestamp timestamp [note: 'The timestamp when this talent agency record was last modified. Updated automatically on any change to the record.']
  verification_date date [note: 'The date on which the agency information was last verified for accuracy and currency, typically through direct contact or regulatory registry check.']
  website_url varchar [note: 'The primary website URL for the talent agency, used for public information and talent roster visibility.']

  Note: 'Master record for talent representation agencies and management companies — capturing agency legal name, agency type (talent agency, literary agency, management company, law firm), primary contact, address, phone, email, franchise status (SAG-AFTRA franchised agency flag), commission rate standard, and active/inactive status. Serves as the reference for routing deal negotiations, contract correspondence, and residual remittances to the correct representative. Distinct from the partner domain which manages distribution and content partners.'
}

Table talent.representation_agreement {
  representation_agreement_id varchar [pk, note: 'Unique identifier for the representation agreement record. Primary key.']
  talent_agency_id varchar [note: 'Foreign key linking to talent.talent_agency. Business justification: representation_agreement currently has agency_name (STRING) duplicating data from talent_agency. Adding FK enables normalization - agency legal name, DBA name, contact details, and franchise status sh']
  talent_profile_id varchar [note: 'Reference to the talent being represented under this agreement.']
  agent_contact_email varchar [note: 'Primary email address for the agent or representative, used for deal negotiation and residual routing communications.']
  agent_contact_phone varchar [note: 'Primary phone number for the agent or representative.']
  agent_name varchar [note: 'Full name of the individual agent, manager, or attorney assigned as primary contact for this representation.']
  agreement_number varchar [note: 'Externally-known unique business identifier for this representation agreement, used for contract reference and audit trails.']
  commission_cap_amount decimal(15,2) [note: 'Maximum commission amount per engagement or per year, if a cap is specified in the agreement. Null if no cap applies.']
  commission_percentage decimal(5,2) [note: 'Percentage of talent earnings paid to the representative as commission (typically 10% for agents, 15% for managers per industry standards).']
  contract_document_uri varchar [note: 'URI or file path to the signed representation agreement contract document stored in the Media Asset Management (MAM) system or document repository.']
  created_timestamp timestamp [note: 'Timestamp when this representation agreement record was first created in the system.']
  effective_end_date date [note: 'Date when the representation agreement expires or terminates. Null for open-ended agreements.']
  effective_start_date date [note: 'Date when the representation agreement becomes binding and the representative begins acting on behalf of the talent.']
  exclusivity_flag boolean [note: 'Indicates whether this representation is exclusive (true) or non-exclusive (false). Exclusive agreements prohibit the talent from engaging other representatives in the same category and territory.']
  guild_franchise_flag boolean [note: 'Indicates whether the agency or representative is franchised by a talent guild (SAG-AFTRA, WGA, DGA). Franchised agents must comply with guild-mandated commission caps and contract terms.']
  notes varchar [note: 'Free-text notes capturing special clauses, amendments, or contextual information about the representation agreement.']
  renewal_option_flag boolean [note: 'Indicates whether the agreement includes an automatic renewal option or requires explicit renegotiation at expiration.']
  renewal_terms varchar [note: 'Description of renewal terms if renewal_option_flag is true, including renewal period length and any modified commission rates.']
  representation_agreement_status varchar [note: 'Current lifecycle status of the representation agreement: active (in force), expired (end date reached), terminated (ended early by either party), suspended (temporarily inactive), or pending (signed but not yet effective).']
  representation_type varchar [note: 'Classification of the representation relationship: exclusive agent (sole representation), co-agent (shared representation), manager (career management), entertainment attorney (legal counsel), business manager (financial management), or publicist (public relations).']
  residual_routing_flag boolean [note: 'Indicates whether residual payments for work performed during this representation period should be routed through this representative for commission deduction.']
  scope_of_services varchar [note: 'Detailed description of services the representative will provide: deal negotiation, career guidance, audition scheduling, contract review, brand partnerships, etc.']
  signing_date date [note: 'Date when the representation agreement was signed by both parties.']
  termination_date date [note: 'Actual date the representation agreement was terminated, if applicable. Used for residual routing cutoff and historical audit trails.']
  termination_notice_period_days varchar [note: 'Number of days advance notice required by either party to terminate the representation agreement (commonly 30, 60, or 90 days).']
  termination_reason varchar [note: 'Reason for early termination of the representation agreement, if applicable. [ENUM-REF-CANDIDATE: mutual_agreement|talent_initiated|agent_initiated|breach_of_contract|expiration|non_performance|conflict_of_interest — 7 candidates stripped; promote to reference product]']
  territory_scope varchar [note: 'Geographic territory or market scope covered by this representation agreement (e.g., worldwide, North America, USA, specific states). Multiple territories may be comma-separated.']
  updated_timestamp timestamp [note: 'Timestamp when this representation agreement record was last modified.']

  Note: 'Records the formal representation relationship between a talent and their agency or management company — capturing representation type (exclusive agent, co-agent, manager, entertainment attorney), territory scope, commission percentage, agreement start and end dates, exclusivity flag, termination notice period, and current status. Tracks historical representation changes to support residual routing and deal negotiation audit trails. A talent may have multiple concurrent representation agreements across different territories or function types.'
}

Table sales.ad_order {
  ad_order_id varchar [pk, note: 'Unique identifier for the advertising sales order. Primary key. System-generated surrogate key for the ad order record.']
  advertiser_id varchar [note: 'Reference to the advertiser (brand or company) placing the advertising order. Links to advertiser master record in Salesforce Media Cloud.']
  affiliate_agreement_id varchar [note: 'Foreign key linking to partner.affiliate_agreement. Business justification: Ad orders for local affiliate insertion avails reference the affiliate agreement governing preemption rights, local_ad_avails_minutes_per_hour, and retransmission_revenue_split. Sales operations requi']
  billing_account_id varchar [note: 'External reference to the originating sales opportunity in Salesforce Media Cloud CRM. 15 or 18 character Salesforce record ID.']
  broadcast_license_id varchar [note: 'Foreign key linking to compliance.broadcast_license. Business justification: Ad orders are sold by sales teams organized into cost centers. Commission calculation, sales performance analysis, and cost center P&L attribution require linking orders to the responsible cost center']
  campaign_id varchar [note: 'Foreign key linking to sales.campaign. Business justification: Normalize campaign reference from STRING name to proper FK. Ad order should be linked to campaign master record for rollup reporting and campaign management. Currently denormalized as campaign_name ST']
  delivery_channel_id varchar [note: 'Foreign key linking to distribution.delivery_channel. Business justification: Ad orders are contracted against specific delivery channels (e.g., FAST channel, OTT tier, linear). Ad trafficking, billing reconciliation, and order fulfillment all require knowing the target deliver']
  demographic_segment_id varchar [note: 'Foreign key linking to audience.demographic_segment. Business justification: Ad orders target specific Nielsen demographic segments (A18-49, W25-54, etc.) for campaign planning, rate card pricing, and GRP/TRP guarantees. Core to media buying operations and upfront/scatter deal']
  ott_platform_id varchar [note: 'Foreign key linking to distribution.ott_platform. Business justification: OTT ad orders are sold against specific OTT platforms (e.g., Peacock, Paramount+). Platform-specific CPM rates, DAI configuration, and billing are tied to the OTT platform. Ad sales reporting by platf']
  partner_id varchar [note: 'Foreign key linking to partner.partner_partner. Business justification: Ad orders often involve content partners (studios, syndicators) whose programming forms the inventory being sold. Real business process: integrated sales where content acquisition and ad sales are coo']
  proposal_id varchar [note: 'Foreign key linking to sales.proposal. Business justification: An ad order is the confirmed execution of an accepted proposal. The proposal captures the pre-sale terms (CPM, GRP targets, flight dates, daypart mix), and the ad_order is the binding commercial recor']
  sales_agency_id varchar [note: 'Reference to the advertising agency representing the advertiser. Nullable if direct advertiser purchase. Links to agency master record.']
  syndication_agreement_id varchar [note: 'Foreign key linking to partner.syndication_agreement. Business justification: Ad orders placed against barter/syndication inventory must reference the syndication agreement governing barter spot allocation, run limits, and clearance obligations. Traffic and billing teams requir']
  territory_id varchar [note: 'Foreign key linking to rights.rights_territory. Business justification: Ad orders are placed against geographic markets governed by rights territory rules (blackout, exclusivity, holdback). Territory-based revenue reporting and rights clearance validation at order level r']
  upfront_deal_id varchar [note: 'Foreign key linking to sales.upfront_deal. Business justification: An advertising order is frequently the execution of a committed upfront deal. The upfront_deal establishes the annual commitment (total spend, audience guarantees, channel mix), and individual ad_orde']
  affidavit_required_flag boolean [note: 'Indicates whether proof of broadcast affidavits must be provided to the advertiser. True = affidavits required; False = not required. Affidavits document actual air times and are often required for political advertising.']
  commission_rate decimal(5,2) [note: 'Agency commission rate as a percentage of gross order value. Standard industry rate is 15%. Applied to calculate net revenue.']
  confirmed_timestamp timestamp [note: 'Date and time when the advertising order was confirmed by the advertiser or agency. Marks transition from pending to confirmed status.']
  contracted_cpm decimal(10,2) [note: 'Contracted Cost Per Mille (cost per thousand impressions) for this advertising order. Key pricing metric for media buying.']
  contracted_cprp decimal(10,2) [note: 'Contracted Cost Per Rating Point. Pricing metric calculated as total cost divided by GRP. Used for market efficiency comparison.']
  created_timestamp timestamp [note: 'Date and time when this advertising order record was first created in the system. Audit trail field.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts in this order (e.g., USD, GBP, EUR).']
  daypart_mix varchar [note: 'Distribution of advertising spots across broadcast dayparts (time segments of broadcast day). Examples: Prime (8pm-11pm), Early Morning (6am-9am), Late Night (11pm-2am). Stored as comma-separated daypart allocations.']
  discount_percentage decimal(5,2) [note: 'Total discount percentage applied to this order. May include volume discounts, promotional discounts, or negotiated rate reductions.']
  flight_end_date date [note: 'Last date the advertising campaign is scheduled to air. End of the contracted broadcast period.']
  flight_start_date date [note: 'First date the advertising campaign is scheduled to air. Beginning of the contracted broadcast period.']
  last_modified_timestamp timestamp [note: 'Date and time when this advertising order record was last updated. Audit trail field for change tracking.']
  makegood_policy varchar [note: 'Policy for providing compensatory ad spots (makegoods) if contracted delivery is not met. Standard = industry-standard makegood terms; Guaranteed = full delivery guarantee; No Makegood = no compensation; Custom = special negotiated terms.']
  net_order_value decimal(18,2) [note: 'Net revenue value after agency commissions, discounts, and adjustments. Amount recognized for revenue reporting.']
  order_notes varchar [note: 'Free-text notes and special instructions for this advertising order. May include trafficking instructions, creative specifications, or client preferences.']
  order_number varchar [note: 'Business identifier for the advertising order. Externally-known unique order number used in Wide Orbit traffic system and client communications. Also called broadcast order number or traffic order number.']
  order_status varchar [note: 'Current lifecycle status of the advertising order. Draft = initial entry; Pending = awaiting approval; Confirmed = accepted by advertiser; Active = currently running; Completed = flight finished; Cancelled = terminated; Invoiced = billed. [ENUM-REF-CANDIDATE: draft|pending|confirmed|active|completed|cancelled|invoiced — 7 candidates stripped; promote to reference product]']
  order_type varchar [note: 'Classification of the advertising order based on sales method. Upfront = advance advertising sales event; Scatter = last-minute ad inventory sales; Direct = direct advertiser purchase; Programmatic = automated bidding; Sponsorship = integrated brand partnership; Barter = trade arrangement.']
  payment_terms varchar [note: 'Contractual payment terms for this order (e.g., Net 30, Net 60, Due on Receipt). Defines when payment is due after invoice date.']
  political_ad_flag boolean [note: 'Indicates whether this order contains political advertising content. True = political advertising; False = commercial advertising. Political ads have special FCC disclosure and equal-time requirements.']
  product_category varchar [note: 'Industry classification of the advertised product or service (e.g., automotive, pharmaceutical, retail, financial services). Used for content clearance and regulatory compliance.']
  target_demographic varchar [note: 'Primary audience demographic segment targeted by this advertising order (e.g., Adults 18-49, Women 25-54, Men 18-34). Used for TRP calculation and spot placement.']
  target_grp decimal(10,2) [note: 'Target Gross Rating Points contracted for this order. GRP = Reach × Frequency, measuring total audience delivery weight. Used for campaign performance evaluation.']
  target_trp decimal(10,2) [note: 'Target Rating Points for specific demographic audience. TRP measures delivery against a defined target audience segment rather than total audience.']
  total_contracted_value decimal(18,2) [note: 'Total monetary value of the advertising order across all spots and placements. Gross revenue before agency commissions and discounts.']
  total_spot_count varchar [note: 'Total number of advertising spots (commercial airings) contracted in this order across all placements and dayparts.']
  wide_orbit_order_reference varchar [note: 'External reference to the corresponding order record in Wide Orbit traffic and billing system. Used for cross-system reconciliation and affidavit generation.']

  Note: 'Master record for an advertising sales order (also called a broadcast order or traffic order) placed by an advertiser or agency. Captures the commercial agreement for a campaign buy including order number, advertiser, agency, account executive, total contracted value, currency, order status (pending, confirmed, cancelled, invoiced), order type (upfront, scatter, direct, programmatic), market, daypart mix, flight dates, billing instructions, Wide Orbit order reference, and Salesforce opportunity linkage. SSOT for the advertising order lifecycle.'
}

Table sales.ad_order_line {
  ad_order_line_id varchar [pk, note: 'Unique identifier for the advertising order line item. Primary key.']
  ad_order_id varchar [note: 'Reference to the parent advertising order header. Links this line item to its containing order.']
  ad_pod_id varchar [note: 'Foreign key linking to sales.ad_pod. Business justification: An ad order line represents a specific buy unit that is often targeted to a particular ad pod (break position within a program). The ad_pod defines the break container with its inventory class, daypar']
  channel_id varchar [note: 'Reference to the broadcast network or channel where this ad line will air. Determines distribution outlet.']
  content_episode_id varchar [note: 'Foreign key linking to content.content_episode. Business justification: Episode-level ad trafficking is standard broadcast operations — order lines are placed against specific episodes for adjacency targeting, competitive separation, and affidavit reporting. The existing ']
  content_rating_id varchar [note: 'Foreign key linking to compliance.content_rating. Business justification: Ad trafficking enforces content-adjacency rules: each order line must reference the content rating of adjacent programming to prevent adult-rated spots airing near children\'s content. Traffic coordina']
  delivery_channel_id varchar [note: 'Foreign key linking to distribution.delivery_channel. Business justification: Ad order lines specify inventory at the channel/daypart level. The delivery channel (FAST, OTT, linear) determines ad insertion method, pricing tier, and trafficking instructions. Line-level delivery ']
  demographic_segment_id varchar [note: 'Foreign key linking to audience.demographic_segment. Business justification: Each line item specifies demographic target for GRP/TRP delivery guarantees, CPM/CPRP pricing, and makegood determination. Essential for trafficking, billing reconciliation, and audience guarantee com']
  makegood_for_line_ad_order_line_id varchar [note: 'Reference to the original ad order line that this line is compensating for (if this is a makegood spot). Null if not a makegood.']
  scheduling_daypart_id varchar [note: 'Foreign key linking to scheduling.daypart. Business justification: Order lines target specific dayparts for inventory allocation and pricing. Fulfillment tracking, avail matching, and rate card application require linking lines to master daypart definitions. Removes ']
  talent_profile_id varchar [note: 'Foreign key linking to talent.talent_profile. Business justification: Normalize creative reference from STRING business key to proper FK. Order line specifies which creative asset to use for the buy. Currently denormalized as isci_code STRING; should FK to isci_creative']
  actual_grp_delivered decimal(10,2) [note: 'Actual Gross Rating Points (GRP) delivered based on Nielsen measurement. Used for campaign performance analysis and makegood calculation.']
  actual_impressions_delivered varchar [note: 'Actual number of impressions delivered for this line. Sourced from DAI (Dynamic Ad Insertion) systems or CDN (Content Delivery Network) logs for digital campaigns.']
  actual_spots_aired varchar [note: 'Actual number of spots that successfully aired for this line. Populated from affidavit reconciliation. Used for billing and makegood determination.']
  competitive_separation_category varchar [note: 'Product or industry category for competitive adjacency restrictions. Prevents competing advertisers from airing in the same pod.']
  contracted_grp decimal(10,2) [note: 'Target Gross Rating Points (GRP) contracted for this line. GRP measures total audience reach multiplied by frequency.']
  contracted_impressions varchar [note: 'Total number of impressions (individual ad views) contracted for this line item. Used for digital and OTT (Over-The-Top) campaigns.']
  contracted_spots varchar [note: 'Total number of ad spots contracted for this line item. Represents the quantity commitment.']
  contracted_trp decimal(10,2) [note: 'Target Rating Points (TRP) contracted for this line. TRP measures reach within a specific demographic target.']
  copy_split_rule varchar [note: 'Rules defining how multiple creative versions should be split across the contracted spots (e.g., 50/50, 70/30). Used for A/B testing or creative variation.']
  cpm decimal(10,2) [note: 'Cost Per Mille (CPM) - the cost per thousand impressions. Key pricing metric for advertising efficiency.']
  cprp decimal(10,2) [note: 'Cost Per Rating Point (CPRP) - the cost to achieve one rating point. Used to compare efficiency across dayparts and programs.']
  created_timestamp timestamp [note: 'Timestamp when this ad order line record was first created in the system. Audit trail for record creation.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary values on this line (e.g., USD, GBP, EUR).']
  discount_percentage decimal(5,2) [note: 'Percentage discount applied to this line (e.g., volume discount, agency commission). Expressed as a percentage (e.g., 15.00 for 15%).']
  flight_end_date date [note: 'End date of the advertising flight window for this line item. Defines when spots must complete airing.']
  flight_start_date date [note: 'Start date of the advertising flight window for this line item. Defines when spots can begin airing.']
  inventory_type varchar [note: 'Classification of ad inventory purchase type. Upfront is advance commitment; scatter is last-minute; preemptible can be bumped; makegood compensates for missed spots.']
  last_modified_timestamp timestamp [note: 'Timestamp when this ad order line record was last updated. Audit trail for record changes.']
  line_number varchar [note: 'Sequential line number within the parent ad order. Determines ordering and display sequence of line items.']
  line_status varchar [note: 'Current lifecycle status of the ad order line. Tracks progression from booking through execution and reconciliation. [ENUM-REF-CANDIDATE: booked|confirmed|scheduled|aired|preempted|makegooded|cancelled|expired — 8 candidates stripped; promote to reference product]']
  line_total_amount decimal(15,2) [note: 'Total revenue amount for this line item (unit rate × contracted spots). Base amount before discounts or adjustments.']
  net_amount decimal(15,2) [note: 'Net revenue amount after discounts and before taxes. Used for revenue recognition and financial reporting.']
  position_preference varchar [note: 'Preferred position within the ad pod (group of ads in a break). Premium positions command higher rates.']
  preemption_priority varchar [note: 'Priority level for preemption protection (1=highest, 10=lowest). Lower-priority spots may be bumped for higher-value inventory.']
  revenue_recognition_date date [note: 'Date on which revenue for this line is recognized for financial reporting. Typically aligned with air date or campaign completion.']
  rotation_instructions varchar [note: 'Instructions for rotating multiple creatives within this line (e.g., even rotation, weighted rotation, sequential). Guides playout system behavior.']
  special_handling_notes varchar [note: 'Free-text instructions for special handling requirements (e.g., live read, sponsorship billboard, product integration). Communicated to playout operators.']
  spot_length_seconds varchar [note: 'Duration of the advertising spot in seconds. Standard lengths are 15, 30, 60, or 120 seconds.']
  trafficking_notes varchar [note: 'Internal notes for trafficking team regarding execution details, creative delivery status, or special coordination requirements.']
  unit_rate decimal(15,2) [note: 'Price per individual ad spot or unit. Base rate before volume discounts or adjustments.']

  Note: 'Individual line item within an advertising order representing a specific buy unit — a combination of network/channel, daypart, program, spot length, unit rate, contracted GRP/TRP/impression target, and flight window. Each line maps to a specific inventory unit and carries its own status (booked, preempted, makegooded, cancelled). Includes trafficking execution details: assigned ISCI creative(s), rotation instructions, copy split rules, position preferences, competitive adjacency restrictions, and special handling notes for the playout system (Wide Orbit). Sourced from Wide Orbit order line detail. Supports revenue recognition at the line level and feeds affidavit reconciliation.'
}

Table sales.campaign {
  campaign_id varchar [pk, note: 'Unique identifier for the advertising campaign. Primary key.']
  advertiser_id varchar [note: 'Reference to the advertiser organization that owns this campaign.']
  affiliate_agreement_id varchar [note: 'Foreign key linking to partner.affiliate_agreement. Business justification: Campaigns targeting affiliate station inventory reference the affiliate agreement for local avail constraints, minimum_clearance_percentage, and performance_standard_grp_minimum. Network sales teams r']
  billing_account_id varchar [note: 'Foreign key linking to billing.billing_account. Business justification: Campaign-level billing account assignment drives invoice routing, credit limit checks, and payment terms enforcement. Media billing operations require knowing which billing account governs a campaign\'']
  broadcast_license_id varchar [note: 'Foreign key linking to compliance.broadcast_license. Business justification: Campaigns are managed by sales teams within cost centers. Campaign ROI analysis and sales team performance measurement require linking campaigns to the responsible cost center for accurate profitabili']
  delivery_channel_id varchar [note: 'Foreign key linking to distribution.delivery_channel. Business justification: Ad sales campaigns are planned and reported against specific delivery channels (FAST, OTT, linear). Campaign performance reporting, pacing, and billing require knowing which delivery channel the campa']
  demographic_segment_id varchar [note: 'Foreign key linking to audience.demographic_segment. Business justification: Campaigns define primary demographic targets that drive all downstream planning, buying, measurement, and guarantee reconciliation. Core to upfront deals, scatter buying, and Nielsen ratings analysis.']
  ott_platform_id varchar [note: 'Foreign key linking to distribution.ott_platform. Business justification: Campaigns targeting children under 13 require COPPA declarations for data collection and privacy compliance. Broadcasters must link campaigns to declarations documenting parental consent mechanisms, d']
  partner_id varchar [note: 'Foreign key linking to partner.partner_partner. Business justification: Campaigns frequently involve co-marketing partnerships with content providers, integrated sponsorships, or campaigns tied to partner-supplied content blocks. Real business process: partnership marketi']
  regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: Campaigns targeting regulated audiences (COPPA for children\'s, political disclosure rules, alcohol advertising restrictions) must reference the applicable regulatory obligation. Compliance teams track']
  sales_agency_id varchar [note: 'Reference to the advertising agency representing the advertiser for this campaign. Nullable if direct advertiser relationship.']
  scheduling_channel_id varchar [note: 'add column scheduling_channel_id (BIGINT) with FK to scheduling.channel.channel_id - campaigns target specific channels and need direct channel linkage for trafficking']
  series_id varchar [note: 'Foreign key linking to content.series. Business justification: Series-level sponsorship campaigns are a core broadcast sales process — an advertiser sponsors an entire series (e.g., \'presented by Brand X\'). Campaign planning, upfront negotiations, and audience de']
  syndication_agreement_id varchar [note: 'Foreign key linking to partner.syndication_agreement. Business justification: Campaigns running on syndicated content reference the syndication agreement for barter spot allocation, exclusivity windows, and revenue share reporting. Campaign managers must link campaigns to syndi']
  talent_profile_id varchar [note: 'Foreign key linking to talent.talent_profile. Business justification: Brand ambassador and celebrity spokesperson campaigns must track featured talent for exclusivity enforcement, usage rights validation, residual calculations, and clearance verification across all camp']
  approved_timestamp timestamp [note: 'Timestamp when the campaign was approved and moved from draft or proposed status to active status.']
  campaign_status varchar [note: 'Current lifecycle status of the advertising campaign. [ENUM-REF-CANDIDATE: draft|proposed|approved|active|paused|completed|cancelled — 7 candidates stripped; promote to reference product]']
  campaign_type varchar [note: 'Classification of the campaign objective and strategy.']
  code varchar [note: 'External business identifier or code for the campaign used in trafficking and billing systems.']
  created_timestamp timestamp [note: 'Timestamp when this campaign record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary values in this campaign.']
  end_date date [note: 'The date when the campaign is scheduled to end. Nullable for ongoing campaigns.']
  makegood_eligible_flag boolean [note: 'Indicates whether this campaign is eligible for makegood compensatory ad spots if contracted delivery targets are not met.']
  market_type varchar [note: 'Geographic market scope classification for the campaign.']
  modified_timestamp timestamp [note: 'Timestamp when this campaign record was last modified.']
  name varchar [note: 'Business name of the advertising campaign used for identification and reporting.']
  notes varchar [note: 'Free-form text field for additional campaign instructions, special requirements, or internal notes.']
  priority_level varchar [note: 'Priority classification for ad inventory allocation and scheduling conflicts.']
  product_brand varchar [note: 'The product, service, or brand being advertised in this campaign.']
  sales_channel varchar [note: 'The sales channel through which the campaign was sold (upfront advance sales, scatter last-minute, programmatic automated, direct negotiated, or sponsorship).']
  salesforce_campaign_reference varchar [note: 'External reference identifier linking to the campaign record in Salesforce Media Cloud CRM system.']
  start_date date [note: 'The date when the campaign is scheduled to begin airing or serving ads.']
  target_cpm decimal(10,2) [note: 'Contracted target Cost Per Mille representing the cost per thousand impressions.']
  target_cprp decimal(10,2) [note: 'Contracted target Cost Per Rating Point representing the cost to achieve one rating point.']
  target_frequency decimal(5,2) [note: 'Contracted average number of times each unique audience member should be exposed to the campaign.']
  target_grp decimal(10,2) [note: 'Contracted target Gross Rating Points representing the total audience reach multiplied by frequency goal for the campaign.']
  target_impressions varchar [note: 'Contracted total number of ad impressions to be delivered across the campaign.']
  target_reach_percent decimal(5,2) [note: 'Contracted percentage of unique audience members to be reached by the campaign.']
  target_sov_percent decimal(5,2) [note: 'Contracted target Share of Voice representing the percentage of total advertising impressions in the category or daypart.']
  target_trp decimal(10,2) [note: 'Contracted target Target Rating Points representing reach and frequency goals for a specific demographic segment.']
  total_budget_amount decimal(18,2) [note: 'The total contracted budget amount for the entire campaign across all flights and orders.']

  Note: 'Advertising campaign master record representing the strategic grouping of ad orders and flights for a single advertiser objective. Tracks campaign name, advertiser, product/brand being advertised, campaign type (brand awareness, direct response, political, sponsorship), total budget, contracted reach and frequency targets, GRP/TRP goals, SOV targets, campaign status, start and end dates, and Salesforce Media Cloud campaign reference. Parent entity above ad orders and flights.'
}

Table sales.advertiser {
  advertiser_id varchar [pk, note: 'Unique identifier for the advertiser record. Primary key.']
  billing_account_id varchar [note: 'Foreign key linking to billing.billing_account. Business justification: Advertiser onboarding requires assigning a billing account for AR management, credit limit enforcement, and invoice delivery. Every media broadcaster links advertisers to billing accounts as the found']
  regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: Advertisers in regulated industries (alcohol, pharmaceuticals, political committees) are subject to specific regulatory obligations tracked at the advertiser level for compliance screening and onboard']
  sales_agency_id varchar [note: 'The identifier of the advertising agency that places media buys on behalf of this advertiser, if applicable. Null if the advertiser buys direct.']
  account_status varchar [note: 'Current lifecycle status of the advertiser account indicating whether the advertiser is actively purchasing inventory.']
  annual_spend_tier varchar [note: 'The classification tier based on annual advertising spend volume, used for pricing, service level, and upfront negotiation priority.']
  billing_address_line1 varchar [note: 'The primary street address line for billing and invoice delivery.']
  billing_address_line2 varchar [note: 'The secondary address line for suite, floor, or building information.']
  billing_city varchar [note: 'The city or municipality for the billing address.']
  billing_country_code varchar [note: 'The three-letter ISO country code for the billing address (e.g., USA, CAN, GBR).']
  billing_postal_code varchar [note: 'The postal or ZIP code for the billing address.']
  billing_state_province varchar [note: 'The state, province, or region for the billing address.']
  contract_end_date date [note: 'The expiration date of the current master advertising services agreement or upfront deal, if applicable.']
  contract_start_date date [note: 'The effective start date of the current master advertising services agreement or upfront deal.']
  created_timestamp timestamp [note: 'The timestamp when this advertiser record was first created in the system.']
  credit_limit_amount decimal(15,2) [note: 'The maximum outstanding balance allowed for this advertiser before credit hold is applied, in USD.']
  credit_status varchar [note: 'The credit approval status indicating whether the advertiser is authorized to purchase advertising on credit terms.']
  industry_category varchar [note: 'The Interactive Advertising Bureau (IAB) taxonomy category classifying the advertiser\'s primary business vertical (e.g., Automotive, Financial Services, Consumer Packaged Goods).']
  is_political_advertiser boolean [note: 'Boolean flag indicating whether this advertiser is a political candidate, party, or issue advocacy group subject to FCC political advertising disclosure requirements.']
  legal_name varchar [note: 'The full legal registered name of the advertising client or brand as it appears on contracts and invoices.']
  notes varchar [note: 'Free-text field for internal notes regarding special handling instructions, account history, or relationship management details.']
  parent_company_name varchar [note: 'The name of the parent or holding company if the advertiser is a subsidiary or brand within a larger corporate structure.']
  payment_terms varchar [note: 'The contractual payment terms specifying when payment is due after invoice date (e.g., Net 30, Net 60).']
  preferred_currency_code varchar [note: 'The three-letter ISO currency code for invoicing and financial reporting (e.g., USD, EUR, GBP).']
  primary_contact_email varchar [note: 'The email address of the primary business contact for campaign communications and invoice delivery.']
  primary_contact_name varchar [note: 'The full name of the primary business contact at the advertiser organization for campaign coordination and billing inquiries.']
  primary_contact_phone varchar [note: 'The business phone number of the primary contact for urgent campaign or billing matters.']
  requires_ad_clearance boolean [note: 'Boolean flag indicating whether this advertiser\'s creative content requires pre-broadcast clearance review due to industry category (e.g., pharmaceuticals, alcohol, financial services).']
  tax_identifier varchar [note: 'The advertiser\'s federal tax identification number (EIN in USA, VAT number in EU) used for tax reporting and invoicing.']
  trade_name varchar [note: 'The doing-business-as (DBA) or brand name used in advertising campaigns and public-facing materials.']
  updated_timestamp timestamp [note: 'The timestamp when this advertiser record was last modified.']
  website_url varchar [note: 'The primary website URL of the advertiser for brand reference and campaign landing page validation.']
  wide_orbit_advertiser_code varchar [note: 'The unique advertiser identifier in the Wide Orbit traffic and billing system, used for ad scheduling, sales orders, and invoicing.']

  Note: 'Master record for an advertising client (brand or direct advertiser) purchasing airtime or digital inventory. Captures advertiser legal name, trade name, industry category (IAB taxonomy), parent company, billing address, credit limit, credit status, payment terms, tax ID, Salesforce account reference, Wide Orbit advertiser code, and account manager assignment. Distinct from the agency that places buys on behalf of the advertiser. SSOT for advertiser identity within the advertising domain.'
}

Table sales.sales_agency {
  sales_agency_id varchar [pk, note: 'Unique identifier for the advertising agency or media buying firm. Primary key.']
  billing_account_id varchar [note: 'Foreign key linking to billing.billing_account. Business justification: Sales agencies are billed for commission adjustments and agency fees via a dedicated billing account. Media broadcasters maintain separate billing accounts for agencies to track agency-level AR, commi']
  accreditation_date date [note: 'Date when the agency was granted accreditation status by the broadcaster or industry body.']
  accreditation_expiry_date date [note: 'Date when the current accreditation status expires and requires renewal. Nullable for indefinite accreditation.']
  accreditation_status varchar [note: 'Current accreditation status of the agency with industry bodies or the broadcaster, indicating creditworthiness and eligibility for commission-based billing.']
  agency_type varchar [note: 'Classification of the agency based on its primary service offering and operational model.']
  billing_address_line1 varchar [note: 'First line of the agency\'s billing address where invoices and financial correspondence should be sent.']
  billing_address_line2 varchar [note: 'Second line of the agency\'s billing address (suite, floor, building name). Nullable.']
  billing_city varchar [note: 'City name for the agency\'s billing address.']
  billing_country_code varchar [note: 'Three-letter ISO 3166-1 alpha-3 country code for the agency\'s billing address (e.g., USA, CAN, GBR).']
  billing_model varchar [note: 'Billing methodology used for this agency. Gross: agency bills advertiser full amount and remits net to broadcaster. Net: broadcaster bills agency net amount. Hybrid: mixed approach.']
  billing_postal_code varchar [note: 'Postal or ZIP code for the agency\'s billing address.']
  billing_state_province varchar [note: 'State or province code for the agency\'s billing address (e.g., NY, CA, ON).']
  commission_rate decimal(5,4) [note: 'Standard commission percentage rate applied to media buys placed by this agency, expressed as a decimal (e.g., 0.1500 for 15%). Used for commission calculation and billing split.']
  created_timestamp timestamp [note: 'Timestamp when this agency record was first created in the system. Follows format yyyy-MM-ddTHH:mm:ss.SSSXXX.']
  credit_limit decimal(15,2) [note: 'Maximum credit amount (in base currency) extended to the agency for outstanding ad orders before payment is required. Used for credit risk management.']
  holding_company_group varchar [note: 'Name of the parent holding company or agency network to which this agency belongs (e.g., WPP, Omnicom, Publicis, IPG, Dentsu). Null if independent.']
  modified_by varchar [note: 'User identifier or system account that last modified this agency record. Used for audit trail and change tracking.']
  modified_timestamp timestamp [note: 'Timestamp when this agency record was last modified. Follows format yyyy-MM-ddTHH:mm:ss.SSSXXX.']
  name varchar [note: 'Full legal or trade name of the advertising agency or media buying firm.']
  notes varchar [note: 'Free-form text field for additional notes, special instructions, or historical context about the agency relationship.']
  onboarding_date date [note: 'Date when the agency was first onboarded and approved to place advertising orders with the broadcaster.']
  payment_terms_days varchar [note: 'Standard number of days allowed for payment after invoice date (e.g., 30, 60, 90). Used for accounts receivable and cash flow forecasting.']
  preferred_currency_code varchar [note: 'Three-letter ISO 4217 currency code for the agency\'s preferred billing currency (e.g., USD, CAD, GBP, EUR).']
  primary_contact_email varchar [note: 'Email address of the primary business contact at the agency for order confirmations, affidavits, and campaign communications.']
  primary_contact_name varchar [note: 'Full name of the primary business contact or account executive at the agency responsible for media buying and campaign coordination.']
  primary_contact_phone varchar [note: 'Primary telephone number for the agency contact, used for urgent campaign coordination and makegood processing.']
  sales_agency_status varchar [note: 'Current operational status of the agency relationship. Active agencies can place orders; inactive/suspended/terminated agencies cannot.']
  status_reason varchar [note: 'Explanation or business reason for the current status, particularly for inactive, suspended, or terminated statuses (e.g., credit issues, contract expiration, voluntary closure).']
  tax_identifier varchar [note: 'Government-issued tax identification number for the agency (e.g., EIN in USA, VAT number in EU) used for tax reporting and compliance.']
  termination_date date [note: 'Date when the agency relationship was terminated or the agency ceased operations. Nullable for active agencies.']
  website_url varchar [note: 'Official website URL of the advertising agency for reference and verification purposes.']
  wide_orbit_agency_code varchar [note: 'Unique agency identifier code used in the Wide Orbit traffic and billing system for ad scheduling, sales orders, and invoicing.']
  created_by varchar [note: 'User identifier or system account that created this agency record. Used for audit trail and data lineage.']

  Note: 'Master record for an advertising agency or media buying firm that places ad orders on behalf of advertisers. Captures agency name, agency type (full-service, media buying, digital, programmatic), holding company group, commission rate, billing model (gross/net), contact details, Wide Orbit agency code, Salesforce account reference, and accreditation status. Tracks the agency-advertiser relationship for commission calculation and billing split.'
}

Table sales.ad_spot {
  ad_spot_id varchar [pk, note: 'Unique identifier for the individual advertisement spot placement. Primary key for the ad spot entity.']
  ad_order_line_id varchar [note: 'Reference to the parent ad order line that booked this spot. Links the spot to the commercial agreement and campaign.']
  ad_pod_id varchar [note: 'Identifier for the ad pod (commercial break) containing this spot. Groups all spots that aired in the same break.']
  advertiser_id varchar [note: 'Identifier for the advertiser (brand or company) whose creative aired in this spot. Links to advertiser master data.']
  affiliate_agreement_id varchar [note: 'Foreign key linking to partner.affiliate_agreement. Business justification: Ad spots inserted at affiliate stations reference the affiliate agreement for local insertion rights compliance, preemption_rights enforcement, and retransmission_revenue_split reporting. Traffic and ']
  campaign_id varchar [note: 'Identifier for the advertising campaign this spot belongs to. Groups related spots for performance analysis and reporting.']
  content_episode_id varchar [note: 'Foreign key linking to content.content_episode. Business justification: Ad spots must be traceable to the specific episode in which they aired for affidavit/proof-of-performance reporting, residuals calculation, and audience measurement reconciliation. The existing title_']
  creative_deliverable_id varchar [note: 'Foreign key linking to production.deliverable. Business justification: Ad spots air specific creative assets (deliverables) produced internally or by agencies. Trafficking systems must link scheduled spots to the actual video/audio deliverable for playout, affidavit gene']
  delivery_channel_id varchar [note: 'Foreign key linking to distribution.delivery_channel. Business justification: Ad spots are aired on specific delivery channels. Affidavit reconciliation, post-log reporting, and billing verification require the exact delivery channel FK. delivery_platform is a plain-text denorm']
  demographic_segment_id varchar [note: 'Foreign key linking to audience.demographic_segment. Business justification: Individual spots are trafficked and measured against specific demographic targets for GRP/TRP delivery, makegood determination, and affidavit reconciliation. Essential for Nielsen ratings matching and']
  device_type_id varchar [note: 'Foreign key linking to distribution.device_type. Business justification: Ad delivery systems track device type per spot to verify creative compatibility (resolution, codec, DRM), measure device-specific performance, and support device-targeted campaigns. Critical for devic']
  original_spot_ad_spot_id varchar [note: 'Reference to the original ad spot that this makegood spot is compensating for. Populated only when makegood_flag is true.']
  regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: Individual aired spots for political, alcohol, or other regulated categories must be traceable to the specific regulatory obligation (e.g., FCC political ad rules, state alcohol restrictions). Complia']
  sales_agency_id varchar [note: 'Identifier for the advertising agency that placed this spot on behalf of the advertiser. May be null for direct advertiser buys.']
  schedule_slot_id varchar [note: 'Foreign key linking to scheduling.schedule_slot. Business justification: Spots air within specific schedule slots. Affidavit generation, as-run reconciliation, and delivery verification require linking each spot to the exact slot it occupied. No existing column fits; creat']
  talent_profile_id varchar [note: 'Foreign key linking to talent.talent_profile. Business justification: Actual aired spots featuring talent trigger residual payment obligations, require talent clearance tracking for compliance, and enable usage rights validation for each exhibition event across linear a']
  territory_id varchar [note: 'Foreign key linking to rights.rights_territory. Business justification: Ad spots are subject to territory-specific blackout restrictions and exclusivity rules defined in rights_territory. Traffic operations must validate each spot against the applicable rights territory b']
  viewer_profile_id varchar [note: 'Foreign key linking to subscriber.viewer_profile. Business justification: DAI ad spot targeting and frequency capping in OTT requires knowing which viewer profile within a household received the spot. Profile-level ad delivery tracking is a standard OTT ad operations requir']
  actual_air_time timestamp [note: 'The actual date and time when this ad spot aired, as recorded in the broadcast affidavit. Used for proof of performance and billing reconciliation.']
  ad_pod_position varchar [note: 'Sequential position of this spot within the ad pod (group of ads in a commercial break). Position 1 is the first ad in the break. Pod position affects viewer attention and pricing.']
  affidavit_reference varchar [note: 'Reference to the broadcast affidavit (proof of performance document) that certifies this spot aired as scheduled. Required for billing and advertiser verification.']
  billing_status varchar [note: 'Current billing status of this spot. Tracks the spot through the billing lifecycle from unbilled through payment or dispute resolution.']
  bonus_spot_flag boolean [note: 'Indicates whether this spot was provided as a bonus (added value) to the advertiser at no additional charge. Used for revenue recognition and campaign value calculation.']
  channel_code varchar [note: 'Code identifying the broadcast channel or network where the spot aired (e.g., ABC, NBC, ESPN). Links to channel master data.']
  cpm_amount decimal(10,2) [note: 'Cost per thousand impressions for this spot. Key pricing metric in advertising sales used to compare efficiency across different placements.']
  created_timestamp timestamp [note: 'Date and time when this ad spot record was first created in the system. Used for audit trail and data lineage.']
  dai_flag boolean [note: 'Indicates whether this spot was delivered via Dynamic Ad Insertion technology, allowing personalized ad delivery to different viewers or platforms.']
  daypart varchar [note: 'Time segment of the broadcast day when the spot aired. Dayparts are used for pricing, audience targeting, and inventory management. Standard dayparts include early morning (6-9am), daytime (9am-4pm), early fringe (4-6pm), prime access (6-8pm), prime time (8-11pm), late fringe (11pm-12am), late night (12-2am), and overnight (2-6am). [ENUM-REF-CANDIDATE: early_morning|daytime|early_fringe|prime_access|prime_time|late_fringe|late_night|overnight — 8 candidates stripped; promote to reference product]']
  grp_value decimal(8,2) [note: 'Gross Rating Point value delivered by this spot. Measures the size of the audience reached relative to the total market population. Sum of all rating points across the campaign.']
  impressions_delivered varchar [note: 'Total number of impressions (views) delivered by this spot. Used for performance measurement and billing reconciliation.']
  makegood_flag boolean [note: 'Indicates whether this spot is a makegood (compensatory ad spot provided to an advertiser due to a previous preemption or underdelivery).']
  modified_timestamp timestamp [note: 'Date and time when this ad spot record was last modified. Tracks changes to scheduling, status, or other attributes.']
  preempted_flag boolean [note: 'Indicates whether this spot was preempted (bumped from its scheduled time slot). Preempted spots typically require makegood compensation.']
  preemption_reason varchar [note: 'Explanation for why the spot was preempted, if applicable. Common reasons include breaking news, technical issues, programming overrun, or higher-priority advertiser.']
  rotation_pattern varchar [note: 'Describes the rotation or sequencing pattern for this spot within the campaign (e.g., ROS - Run of Schedule, fixed position, alternating). Used for inventory management and fulfillment.']
  scheduled_air_date date [note: 'The date on which this ad spot was scheduled to air. Used for planning and inventory management.']
  scheduled_air_time timestamp [note: 'The precise date and time when this ad spot was scheduled to air. Includes timezone information for accurate cross-platform scheduling.']
  separation_requirement varchar [note: 'Specifies any separation rules for this spot (e.g., competitive separation, minimum time between airings). Ensures advertiser requirements are met.']
  spot_length_seconds varchar [note: 'Duration of the advertisement spot in seconds. Common values include 15, 30, 60, 90, and 120 seconds.']
  spot_rate_amount decimal(15,2) [note: 'The rate charged for this individual spot placement. May differ from the order line rate due to daypart, program, or inventory adjustments.']
  spot_rate_currency varchar [note: 'Three-letter ISO 4217 currency code for the spot rate amount (e.g., USD, GBP, EUR).']
  spot_status varchar [note: 'Current lifecycle status of the ad spot. Tracks whether the spot was scheduled, successfully aired, preempted, cancelled, or requires makegood processing.']
  traffic_log_reference varchar [note: 'Reference identifier to the Wide Orbit traffic log entry that scheduled and tracked this spot. Used for audit trail and reconciliation.']
  trp_value decimal(8,2) [note: 'Target Rating Point value delivered by this spot. Measures audience reach within a specific demographic target segment, more precise than GRP.']

  Note: 'Individual scheduled advertisement placement (spot) within a broadcast or digital break. Represents the atomic unit of ad delivery — a single commercial airing with ISCI code, spot length (seconds), scheduled air date and time, channel/network, program, daypart, pod position, actual air time (from affidavit), preemption flag, makegoood flag, DAI flag, and Wide Orbit traffic log reference. Links to the ad order line that booked it and the creative (isci) that aired.'
}

Table sales.ad_pod {
  ad_pod_id varchar [pk, note: 'Unique identifier for the advertising pod. Primary key.']
  ad_title_id varchar [note: 'Foreign key linking to content.title. Business justification: Ad pods are embedded within title airings. Business process: dynamic ad insertion planning, SCTE-35 cue point management, break placement optimization, pod-level inventory forecasting by title.']
  affiliate_agreement_id varchar [note: 'Foreign key linking to partner.affiliate_agreement. Business justification: Ad pods designated for local affiliate insertion reference the affiliate agreement governing local_ad_avails_minutes_per_hour and local_insertion_rights_flag. Traffic systems require this link to corr']
  channel_id varchar [note: 'Reference to the broadcast or streaming channel where this ad pod is scheduled.']
  content_episode_id varchar [note: 'Foreign key linking to content.content_episode. Business justification: Ad pods (commercial breaks) are placed within specific episodes in broadcast trafficking. Episode-level pod assignment is required for scheduling, SCTE-35 cue point management, and DAI configuration. ']
  content_rating_id varchar [note: 'Foreign key linking to compliance.content_rating. Business justification: Ad pods must be validated against the surrounding program\'s content rating to enforce advertiser separation and parental-control requirements. The existing plain `content_rating` column is a denormali']
  delivery_channel_id varchar [note: 'Foreign key linking to distribution.delivery_channel. Business justification: Ad pods are associated with specific delivery channels (FAST channel, linear, OTT). The delivery channel determines ad insertion method (server-side DAI vs. linear SCTE-35), monetization model, and in']
  demographic_segment_id varchar [note: 'Foreign key linking to audience.demographic_segment. Business justification: Ad pods are priced and sold against specific demographic segments — CPM rate cards and inventory class are segment-driven. The plain column audience_target_demo is a denormalized representation; repla']
  ott_platform_id varchar [note: 'Foreign key linking to distribution.ott_platform. Business justification: OTT ad pods are configured per OTT platform with platform-specific DAI rules, max spot counts, and SCTE-35 cue configurations. Ad pod inventory management and DAI yield optimization require knowing wh']
  program_schedule_id varchar [note: 'Reference to the program schedule entry that contains this ad pod.']
  syndication_agreement_id varchar [note: 'Foreign key linking to partner.syndication_agreement. Business justification: Ad pods in syndicated programming reference the syndication agreement to enforce barter_spot_count limits and clearance obligations per break. Scheduling and traffic teams require this link to allocat']
  actual_end_time timestamp [note: 'Actual date and time when the ad pod concluded airing, used for billing reconciliation and performance verification.']
  actual_start_time timestamp [note: 'Actual date and time when the ad pod began airing, captured from playout automation for affidavit generation and makegood processing.']
  alcohol_ad_allowed_flag boolean [note: 'Indicates whether alcohol advertising is permitted within this ad pod, based on daypart restrictions and content adjacency policies.']
  blackout_flag boolean [note: 'Indicates whether this ad pod is subject to geographic broadcast restrictions or blackout rules, preventing distribution in certain markets.']
  break_position varchar [note: 'Position of the ad break within the program content flow. Pre-roll occurs before content starts, mid-roll during content, post-roll after content ends, interstitial between segments, bumper as short transition, and outro at program conclusion.']
  created_timestamp timestamp [note: 'Date and time when this ad pod record was first created in the system, used for audit trail and data lineage.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary values associated with this ad pod (e.g., USD, GBP, EUR).']
  dai_enabled_flag boolean [note: 'Indicates whether this ad pod supports Dynamic Ad Insertion for personalized, server-side ad stitching in streaming environments.']
  daypart varchar [note: 'Time segment of the broadcast day during which this ad pod airs, used for audience targeting and pricing. Early morning (6-9 AM), daytime (9 AM-4 PM), early fringe (4-6 PM), prime access (6-8 PM), prime time (8-11 PM), late fringe (11 PM-midnight), late night (midnight-2 AM), overnight (2-6 AM). [ENUM-REF-CANDIDATE: early_morning|daytime|early_fringe|prime_access|prime_time|late_fringe|late_night|overnight — 8 candidates stripped; promote to reference product]']
  estimated_grp decimal(10,2) [note: 'Projected Gross Rating Points for this ad pod, representing the sum of all rating points delivered across all spots within the pod.']
  estimated_reach varchar [note: 'Projected unique audience count (in thousands) expected to view this ad pod, based on historical ratings and program performance.']
  geographic_market_code varchar [note: 'Nielsen Designated Market Area (DMA) code or equivalent geographic market identifier where this ad pod airs, used for regional targeting and blackout enforcement.']
  inventory_class varchar [note: 'Classification of the ad pod inventory by pricing tier and sales priority. Premium for high-demand slots, standard for regular inventory, remnant for unsold last-minute inventory, bonus for value-added makegoods.']
  last_modified_timestamp timestamp [note: 'Date and time when this ad pod record was most recently updated, used for change tracking and reconciliation.']
  max_spot_count varchar [note: 'Maximum number of individual ad spots that can be scheduled within this pod, governing inventory capacity.']
  notes varchar [note: 'Free-form text field for additional comments, special instructions, or operational notes related to this ad pod.']
  platform_type varchar [note: 'Distribution platform type for this ad pod. Linear for traditional scheduled broadcast, VOD (Video On Demand) for on-demand viewing, SVOD (Subscription Video On Demand) for subscription services, AVOD (Advertising-Supported Video On Demand) for ad-supported streaming, TVOD (Transactional Video On Demand) for pay-per-view, OTT (Over-The-Top) for internet delivery, FAST (Free Ad-Supported Streaming Television) for linear streaming channels. [ENUM-REF-CANDIDATE: linear|vod|svod|avod|tvod|ott|fast — 7 candidates stripped; promote to reference product]']
  pod_code varchar [note: 'Unique business identifier or code for the ad pod used in trafficking and billing systems.']
  pod_duration_seconds varchar [note: 'Total duration of the ad pod in seconds, representing the maximum time allocated for all ad spots within this break.']
  pod_name varchar [note: 'Human-readable name or label for the ad pod, often used for internal identification and trafficking purposes.']
  pod_rate_card_cpm decimal(12,2) [note: 'Standard rate card Cost Per Mille (cost per thousand impressions) for this ad pod, used as the baseline pricing for inventory sales negotiations.']
  pod_status varchar [note: 'Current lifecycle status of the ad pod. Scheduled indicates planned but not locked, confirmed indicates inventory committed, aired indicates successfully broadcast, preempted indicates replaced by higher-priority content, cancelled indicates removed from schedule, makegoods_required indicates compensatory spots needed due to delivery issues.']
  pod_type varchar [note: 'Classification of the ad pod by content purpose. Commercial for paid advertising, promotional for network self-promotion, PSA (Public Service Announcement) for non-profit messaging, network for national inventory, affiliate for station-level inventory, local for regional inventory.']
  political_ad_allowed_flag boolean [note: 'Indicates whether political advertising is permitted within this ad pod, subject to FCC equal time and disclosure requirements.']
  sales_market varchar [note: 'Market channel through which the ad pod inventory was sold. Upfront for advance commitment sales, scatter for last-minute inventory sales, programmatic for automated bidding platforms, direct for one-on-one advertiser deals.']
  scheduled_end_time timestamp [note: 'Planned date and time when the ad pod is scheduled to conclude, calculated from start time plus pod duration.']
  scheduled_start_time timestamp [note: 'Planned date and time when the ad pod is scheduled to begin airing, in ISO 8601 format with timezone.']
  scte35_cue_point_reference varchar [note: 'Reference identifier for the SCTE-35 (Society of Cable Telecommunications Engineers) cue point that triggers this ad pod insertion in the broadcast stream.']

  Note: 'Definition of an advertising break pod within a program or channel schedule — the container that holds a sequence of ad spots. Captures pod ID, channel, program, break position (pre-roll, mid-roll, post-roll, interstitial), pod duration (seconds), maximum spot count, pod type (commercial, promotional, PSA), SCTE-35 cue point reference, and DAI-enabled flag. Governs inventory capacity and break structure for trafficking and DAI systems.'
}

Table sales.proposal {
  proposal_id varchar [pk, note: 'Unique identifier for the sales proposal. Primary key for this entity.']
  affiliate_agreement_id varchar [note: 'Foreign key linking to partner.affiliate_agreement. Business justification: Proposals for local affiliate ad avails must reference the affiliate agreement that defines local_ad_avails_minutes_per_hour and local_insertion_rights_flag. Sales teams must verify available local in']
  broadcast_license_id varchar [note: 'Foreign key linking to compliance.broadcast_license. Business justification: Proposals are prepared against cost center budgets for resource allocation and approval workflows. Enables budget availability checks and cost center-based approval routing in media sales operations.']
  campaign_id varchar [note: 'Foreign key linking to sales.campaign. Business justification: A proposal is the pre-sale document submitted for a specific advertising campaign. Once accepted, the proposal maps directly to a campaign record. Adding campaign_id to proposal formalizes this lifecy']
  channel_id varchar [note: 'Foreign key linking to scheduling.channel. Business justification: Proposals specify primary channel for inventory offering. Sales teams build proposals around channel audience profiles and ratings. Business process: proposal generation, inventory packaging, channel-']
  delivery_channel_id varchar [note: 'Foreign key linking to distribution.delivery_channel. Business justification: Media proposals are built against specific delivery channels to price inventory correctly. Sales planners need the delivery channel FK to pull accurate rate cards, availability, and audience data. pla']
  demographic_segment_id varchar [note: 'Foreign key linking to audience.demographic_segment. Business justification: Proposals specify demographic targets for reach/frequency planning, GRP/TRP projections, and CPM/CPRP pricing. Essential for sales process, rate card application, and client presentation. Replaces den']
  ott_platform_id varchar [note: 'Foreign key linking to distribution.ott_platform. Business justification: OTT-specific proposals require referencing the target OTT platform for accurate inventory availability, pricing, and audience reach estimates. Sales planners building OTT proposals need this FK. platf']
  proposal_advertiser_id varchar [note: 'Reference to the advertiser organization to whom this proposal is being submitted. The ultimate client purchasing the advertising inventory.']
  proposal_sales_advertiser_id varchar
  regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: Pre-sale proposals for regulated categories (political, alcohol, children\'s programming) must reference the applicable regulatory obligation so sales planners can flag compliance requirements before c']
  sales_agency_id varchar [note: 'Reference to the advertising agency representing the advertiser in this proposal negotiation. Nullable if the advertiser is buying direct.']
  accepted_timestamp timestamp [note: 'Timestamp when the proposal was accepted by the advertiser or agency. Null if not yet accepted or if rejected.']
  agency_commission_percentage decimal(5,2) [note: 'Agency commission percentage to be paid to the agency from the gross proposal value. Typically 15% in the industry. Null if direct advertiser buy.']
  approved_timestamp timestamp [note: 'Date and time when this proposal was internally approved for submission to the client.']
  audience_guarantee_flag boolean [note: 'Indicates whether the proposal includes an audience delivery guarantee with makegood provisions if targets are not met.']
  campaign_end_date date [note: 'Proposed end date for the advertising campaign covered by this proposal.']
  campaign_start_date date [note: 'Proposed start date for the advertising campaign covered by this proposal.']
  cancellation_terms varchar [note: 'Terms and conditions for cancellation of the proposal or resulting order, including notice periods and penalties.']
  channel_mix_summary varchar [note: 'High-level summary of the proposed channel distribution (e.g., 60% Linear TV, 30% OTT, 10% Digital). Detailed channel breakdown is in proposal line items.']
  competitive_situation varchar [note: 'Internal notes on competitive dynamics, other bidders, and strategic positioning for this proposal.']
  content_adjacency_preferences varchar [note: 'Client-specified preferences or restrictions for content types adjacent to ad placements (e.g., sports, news, drama, avoid violent content).']
  cpm decimal(10,2) [note: 'Proposed Cost Per Mille (CPM) - the cost per thousand impressions. Key pricing metric for advertising inventory.']
  cprp decimal(10,2) [note: 'Proposed Cost Per Rating Point (CPRP) - the cost to achieve one rating point in the target demographic. Key pricing metric for broadcast advertising.']
  created_timestamp timestamp [note: 'Date and time when this proposal record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary values in this proposal (e.g., USD, GBP, EUR).']
  daypart_mix varchar [note: 'Distribution of proposed ad spots across broadcast dayparts (e.g., Prime Time, Early Morning, Late Night, Weekend), expressed as percentages or spot counts per daypart.']
  daypart_mix_summary varchar [note: 'High-level summary of the proposed daypart distribution (e.g., 40% Prime, 30% Early Fringe, 20% Late Night, 10% Weekend). Detailed daypart breakdown is in proposal line items.']
  demographic_target varchar [note: 'Primary audience demographic segment targeted by this proposal, expressed in standard Nielsen notation (e.g., Adults 25-54, Women 18-49).']
  description varchar [note: 'Detailed narrative description of the proposal, including campaign objectives, creative strategy, and value proposition.']
  discount_amount decimal(18,2) [note: 'Total discount or price reduction offered in the proposal, applied to the total proposed value.']
  discount_percentage decimal(5,2) [note: 'Overall discount percentage applied to the proposal (e.g., volume discount, upfront commitment discount). Null if no discount applied.']
  expiry_date date [note: 'Date when the proposal expires and is no longer valid for acceptance. After this date, pricing and inventory availability must be re-confirmed.']
  flight_end_date date [note: 'Proposed end date for the advertising campaign or content delivery period covered by this proposal.']
  flight_start_date date [note: 'Proposed start date for the advertising campaign or content delivery period covered by this proposal.']
  guaranteed_impressions varchar [note: 'Minimum number of impressions contractually guaranteed to be delivered, triggering makegood obligations if underdelivered.']
  last_modified_timestamp timestamp [note: 'Date and time when this proposal record was last updated or revised.']
  makegood_policy varchar [note: 'Description of the makegood policy for this proposal - the terms under which compensatory ad spots will be provided if delivery guarantees are not met.']
  market_type varchar [note: 'Sales market context for this proposal: upfront (advance commitment sales event), scatter (last-minute inventory sales), programmatic (automated bidding), or direct (one-to-one negotiation).']
  name varchar [note: 'Descriptive name or title of the proposal, typically reflecting the campaign or client name.']
  net_proposed_value decimal(18,2) [note: 'Net revenue value of the proposal after discounts and agency commissions. This is the expected revenue to the broadcaster.']
  notes varchar [note: 'Free-form notes and comments about the proposal, including special terms, negotiation history, or client-specific requirements.']
  platform_mix varchar [note: 'Distribution of proposed inventory across delivery platforms: linear (traditional broadcast), OTT (over-the-top streaming), FAST (free ad-supported streaming TV), AVOD (advertising video on demand), SVOD (subscription video on demand).']
  proposal_date date [note: 'Date when the proposal was created and issued to the advertiser or agency.']
  proposal_number varchar [note: 'Externally-visible unique business identifier for the proposal, used in client communications and internal tracking.']
  proposal_status varchar [note: 'Current lifecycle status of the advertising proposal in the sales workflow.']
  proposal_type varchar [note: 'Category of commercial offer: advertising (spot sales), content licensing (rights acquisition), syndication (content resale), distribution (carriage agreements), sponsorship (branded integration), or upfront (advance commitment).']
  proposed_frequency decimal(10,2) [note: 'Proposed average frequency (number of times) that each reached individual in the target audience will be exposed to the campaign. Frequency = GRP / Reach.']
  proposed_grp decimal(10,2) [note: 'Total Gross Rating Points (GRP) proposed to be delivered across all dayparts and channels. GRP measures the total exposure weight of the campaign.']
  proposed_impressions varchar [note: 'Total number of impressions (ad views) proposed to be delivered across all channels and platforms in this campaign.']
  proposed_reach decimal(10,2) [note: 'Proposed reach as a percentage of the target audience that will be exposed to the campaign at least once. Reach measures unique audience coverage.']
  proposed_trp decimal(10,2) [note: 'Total Target Rating Points (TRP) proposed to be delivered to the specific demographic target audience. TRP measures exposure within the target demo only.']
  rejected_timestamp timestamp [note: 'Timestamp when the proposal was rejected by the advertiser or agency. Null if not rejected.']
  response_due_date date [note: 'Requested or required date by which the client should provide a decision or response to the proposal.']
  source varchar [note: 'Origin or trigger for this proposal: response to RFP (request for proposal), proactive sales pitch, contract renewal, upsell to existing client, or cross-sell of additional services.']
  spot_length_mix_summary varchar [note: 'High-level summary of the proposed spot length distribution (e.g., 80% :30s, 15% :15s, 5% :60s). Detailed spot length breakdown is in proposal line items.']
  submitted_date date [note: 'Date when the proposal was formally submitted to the client or agency for review.']
  submitted_timestamp timestamp [note: 'Timestamp when the proposal was formally submitted to the advertiser or agency. Null if still in draft status.']
  target_cpm decimal(10,2) [note: 'Proposed cost per thousand impressions, a key pricing metric for advertising proposals.']
  target_grp decimal(10,2) [note: 'Proposed total gross rating points representing reach multiplied by frequency, a standard broadcast audience metric.']
  target_impressions varchar [note: 'Total number of ad impressions or exposures proposed to be delivered across all platforms and dayparts.']
  terms_and_conditions varchar [note: 'Legal and commercial terms governing the proposal, including payment terms, cancellation policies, makegood provisions, and liability clauses.']
  total_proposed_value decimal(18,2) [note: 'Total gross revenue value of the proposal in the base currency, before any discounts or agency commissions. Sum of all proposed line items.']
  version_number varchar [note: 'Sequential version number tracking revisions and iterations of the proposal in response to client feedback or negotiation.']
  win_probability_percent decimal(5,2) [note: 'Sales team estimated probability of winning this proposal, expressed as a percentage (0-100).']

  Note: 'Pre-sale advertising proposal submitted to an advertiser or agency in response to an RFP or upfront/scatter negotiation. Captures proposal number, advertiser, agency, account executive, proposal date, expiry date, total proposed value, proposed GRP/TRP/impression delivery, channel mix, daypart mix, spot length mix, CPM/CPRP, audience demographic targets, proposal status (draft, submitted, negotiating, accepted, rejected), and Salesforce opportunity reference. Precedes the formal ad order.'
}

Table sales.upfront_deal {
  upfront_deal_id varchar [pk, note: 'Unique identifier for the upfront advertising deal negotiation record. Primary key. Role: MASTER_AGREEMENT.']
  advertiser_id varchar [note: 'Reference to the advertiser organization purchasing the advertising inventory under this deal. Links to the advertiser master record.']
  affiliate_agreement_id varchar [note: 'Foreign key linking to partner.affiliate_agreement. Business justification: Upfront deals for affiliate network inventory reference the affiliate agreement defining revenue_share_percentage, local_ad_avails_minutes_per_hour, and network_compensation_model. Upfront sales teams']
  billing_account_id varchar [note: 'Foreign key linking to billing.billing_account. Business justification: Upfront deals are multi-million dollar annual commitments billed in installments against a specific billing account. Billing operations require this link to generate quarterly installment invoices, tr']
  campaign_id varchar [note: 'Foreign key linking to sales.campaign. Business justification: An upfront deal commitment is executed against a specific advertising campaign. The upfront_deal tracks the full lifecycle from negotiation to commitment, and the resulting campaign is the execution v']
  demographic_segment_id varchar [note: 'Foreign key linking to audience.demographic_segment. Business justification: Upfront deals commit annual inventory against specific demographic guarantees (e.g., A18-49 GRP at negotiated CPM). Core to annual negotiation cycle, audience guarantee structuring, and scatter conver']
  exclusive_project_id varchar [note: 'Foreign key linking to production.project. Business justification: Upfront deals may commit advertisers to exclusive sponsorship of specific high-value production projects (tentpole events, original series). Deal terms include project-specific inventory guarantees, i']
  ott_platform_id varchar [note: 'Foreign key linking to distribution.ott_platform. Business justification: OTT upfront deals commit advertiser spend against a specific OTT platform for a broadcast year. Platform-specific upfront commitments, audience guarantees, and makegood obligations require this FK. No']
  partner_id varchar [note: 'Foreign key linking to partner.partner_partner. Business justification: Upfront deals in broadcasting often involve content distribution partners (networks, studios) providing programming blocks or inventory commitments. Real business process: upfront negotiation tracking']
  proposal_id varchar [note: 'Foreign key linking to sales.proposal. Business justification: An upfront deal originates from a proposal submitted to the advertiser or agency. The upfront_deal is the child record that formalizes the negotiated commitment from the pre-sale proposal. Adding prop']
  sales_agency_id varchar [note: 'Reference to the media buying agency representing the advertiser in this deal negotiation. Nullable for direct advertiser deals. Links to the agency master record.']
  series_id varchar [note: 'Foreign key linking to content.series. Business justification: Upfront deals in broadcast are negotiated at the series/program level — advertisers commit spend against specific series inventory for the broadcast season. This is a defining characteristic of the up']
  territory_id varchar [note: 'Foreign key linking to rights.rights_territory. Business justification: Upfront deals in broadcasting are negotiated for specific geographic territories with territory-specific pricing, exclusivity, and rights constraints. Sales planning and rights clearance for upfront c']
  audience_guarantee_grp decimal(10,2) [note: 'Total Gross Rating Points (GRP) guaranteed to the advertiser across all flights and dayparts in this deal. GRP = Reach × Frequency, representing the total audience delivery commitment.']
  audience_guarantee_impressions varchar [note: 'Total number of ad impressions guaranteed to the advertiser. Alternative or complementary metric to GRP, especially for digital and cross-platform deals.']
  cancellation_option_window_days varchar [note: 'Number of days before flight start date within which the advertiser may cancel or reduce the commitment without penalty. Common in upfront deals to provide flexibility.']
  channel_mix varchar [note: 'Comma-separated list or description of broadcast channels, networks, or platforms included in this deal (e.g., Network Prime, Cable Bundle, OTT Streaming). Defines the inventory scope.']
  commitment_date date [note: 'Date when the advertiser or agency verbally or formally committed to the deal terms. Nullable until commitment is secured.']
  cpm_rate decimal(10,2) [note: 'Cost per thousand impressions for CPM-based deals. Nullable if pricing basis is not CPM. Represents the unit price for audience delivery.']
  cprp_rate decimal(10,2) [note: 'Cost per rating point for CPRP-based deals. Nullable if pricing basis is not CPRP. Represents the unit price per GRP delivered.']
  created_timestamp timestamp [note: 'Timestamp when this upfront deal record was first created in the system. Audit trail for record lifecycle tracking.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts in this deal. Typically USD for US-based broadcasters.']
  daypart_mix varchar [note: 'Comma-separated list or description of dayparts included in this deal (e.g., Prime Time, Early Morning, Late Night, Weekend). Daypart = time segment of broadcast day with distinct audience characteristics.']
  deal_number varchar [note: 'Externally-known unique business identifier for the upfront deal, typically formatted as prefix-year-sequence (e.g., UF-2024-000123). Used in all client-facing communications and internal references.']
  deal_status varchar [note: 'Current lifecycle state of the upfront deal. Draft = initial creation; Submitted = sent to client; Negotiating = active discussions; Committed = verbal agreement; Executed = signed contract; Cancelled = deal terminated; Expired = proposal lapsed without commitment. [ENUM-REF-CANDIDATE: draft|submitted|negotiating|committed|executed|cancelled|expired — 7 candidates stripped; promote to reference product]']
  deal_type varchar [note: 'Classification of the advertising deal based on sales method and timing. Upfront = annual advance commitment during upfront season; Scatter = short-term last-minute inventory; Direct = negotiated one-off; Programmatic = automated auction-based; Sponsorship = integrated content partnership; Barter = trade arrangement.']
  deal_year varchar [note: 'Broadcast year for which this upfront deal applies, typically representing the September-to-August broadcast season (e.g., 2024 for 2024-2025 season). Critical for upfront planning and inventory allocation.']
  execution_date date [note: 'Date when the deal contract was fully executed (signed by all parties). Nullable until contract is finalized.']
  makegood_provision_flag boolean [note: 'Indicates whether the deal includes makegood provisions for audience delivery shortfalls. True = makegoods required if guaranteed audience is not delivered; False = no makegood obligation.']
  modified_timestamp timestamp [note: 'Timestamp when this upfront deal record was last modified. Audit trail for change tracking and data lineage.']
  negotiation_round_count varchar [note: 'Number of formal negotiation rounds or proposal revisions submitted during the deal lifecycle. Tracks negotiation complexity and sales effort.']
  notes varchar [note: 'Free-text field for capturing additional deal terms, special conditions, negotiation history, or internal comments not captured in structured fields. Used by account executives for context and handoff.']
  option_exercise_deadline date [note: 'Final date by which the advertiser must exercise any options included in the deal (e.g., additional quarters, scatter conversion, renewal). Nullable if no options are included.']
  pricing_basis varchar [note: 'Pricing model used for this deal. CPM (Cost Per Mille) = cost per thousand impressions; CPRP (Cost Per Rating Point) = cost per GRP point; Flat Rate = fixed fee regardless of delivery; Performance = outcome-based pricing.']
  proposal_date date [note: 'Date when the initial deal proposal was formally submitted to the advertiser or agency. Marks the start of the negotiation lifecycle.']
  salesforce_opportunity_reference varchar [note: 'External reference to the corresponding Salesforce Media Cloud Opportunity record. Enables cross-system traceability between the deal negotiation (Salesforce) and trafficking/billing (Wide Orbit).']
  scatter_conversion_rights boolean [note: 'Indicates whether the advertiser has the right to convert unused upfront commitment into scatter market inventory at preferential rates. True = conversion allowed; False = no conversion rights.']
  total_committed_spend decimal(18,2) [note: 'Total dollar value of advertising spend committed by the advertiser after negotiation. Nullable until commitment is secured. This is the final agreed revenue amount.']
  total_proposed_spend decimal(18,2) [note: 'Total dollar value of advertising spend proposed in the initial deal submission. Represents the gross revenue opportunity before negotiation adjustments.']

  Note: 'Master record for an advertising deal negotiation and commitment — covering the full lifecycle from initial proposal/RFP response through negotiation rounds to final commitment. Encompasses upfront bulk buys negotiated during the annual upfront sales event as well as significant scatter and direct deals requiring formal proposal stages. Captures deal ID, advertiser, agency, account executive, deal year, proposal date, total proposed/committed spend, audience guarantee (GRP/TRP/impression), audience demographic, channel/daypart mix, cancellation option windows, scatter conversion rights, pricing basis (CPM or CPRP), deal status (draft, submitted, negotiating, committed, executed, cancelled), option exercise deadlines, and Salesforce opportunity reference. SSOT for the pre-order deal negotiation lifecycle.'
}

Table sales.impression_delivery {
  impression_delivery_id varchar [pk, note: 'Unique identifier for the digital or streaming advertising impression delivery record.']
  ad_billing_order_id varchar [note: 'Foreign key linking to billing.ad_billing_order. Business justification: Impression delivery records are the source of truth for billing reconciliation — actual impressions vs. contracted. Linking to ad_billing_order enables make-good calculations, under-delivery billing a']
  ad_order_line_id varchar [note: 'Reference to the specific ad order line item that this impression fulfills.']
  ad_pod_id varchar [note: 'Foreign key linking to sales.ad_pod. Business justification: An impression delivery record tracks a served ad insertion within a specific ad pod (break). The impression_delivery already has ad_pod_position (the position within the break) but lacks a direct FK t']
  ad_spot_id varchar [note: 'Foreign key linking to sales.ad_spot. Business justification: Impression delivery records track the actual delivery of ad impressions. This FK links delivery metrics back to the specific ad spot that was aired/streamed, enabling performance tracking and billing ']
  campaign_id varchar [note: 'Reference to the advertising campaign under which this impression was delivered.']
  content_episode_id varchar [note: 'Foreign key linking to content.content_episode. Business justification: Episode-level impression attribution is required for audience measurement reporting (Nielsen, Comscore), advertiser billing reconciliation, and campaign delivery verification. Knowing which episode an']
  delivery_channel_id varchar [note: 'Foreign key linking to distribution.delivery_channel. Business justification: Impression delivery reporting by delivery channel (FAST, OTT, linear) is a core ad ops and billing reconciliation report. Advertisers receive channel-level delivery reports. No existing FK covers this']
  device_type_id varchar [note: 'Foreign key linking to distribution.device_type. Business justification: Impression delivery systems track device type for viewability measurement, creative compatibility verification, and device-targeted campaign reporting. Essential for device-level impression analytics ']
  playback_session_id varchar [note: 'Unique identifier for the streaming session during which the impression was delivered.']
  schedule_slot_id varchar [note: 'SCTE-35 cue point identifier that triggered the Dynamic Ad Insertion event, if applicable.']
  segment_id varchar [note: 'Reference to the audience segment targeted for this impression delivery.']
  streaming_endpoint_id varchar [note: 'Foreign key linking to distribution.streaming_endpoint. Business justification: Impression delivery records track where ads were served. In OTT/streaming, impressions are delivered through specific endpoints. Linking enables join to CDN infrastructure, latency analysis, geographi']
  subscriber_id varchar [note: 'Foreign key linking to subscriber.subscriber. Business justification: Impression delivery tracking requires subscriber identity for addressable advertising attribution, cross-device frequency capping, reach/frequency reporting, and subscriber-level ad exposure analysis.']
  syndication_agreement_id varchar [note: 'Foreign key linking to partner.syndication_agreement. Business justification: Impression delivery records for syndicated content reference the syndication agreement for revenue share calculation, reporting_frequency compliance, and recoupment tracking. Finance and partner relat']
  territory_id varchar [note: 'Foreign key linking to rights.rights_territory. Business justification: Impression delivery records must be linked to rights_territory for royalty calculation (territory breakdown in royalty_statement) and rights compliance reporting. Actual delivery must be validated aga']
  viewer_profile_id varchar [note: 'Foreign key linking to subscriber.viewer_profile. Business justification: OTT Dynamic Ad Insertion (DAI) delivers impressions to specific viewer profiles within a household, not just subscribers. Profile-level ad attribution and frequency capping reporting — a named operati']
  ad_pod_position varchar [note: 'Sequential position of this ad within the ad pod (group of ads in a break).']
  browser_type varchar [note: 'Web browser used to view the impression, if applicable.']
  cdn_delivery_confirmed_flag boolean [note: 'Boolean flag indicating whether the CDN confirmed successful delivery of the impression.']
  cdn_node_reference varchar [note: 'Identifier of the CDN edge node that delivered the impression.']
  channel_name varchar [note: 'Name of the streaming channel or digital property where the impression was served.']
  click_through_rate_percent decimal(5,2) [note: 'Percentage of impressions that resulted in a click-through, calculated as click-throughs divided by total impressions served.']
  click_throughs varchar [note: 'Number of times viewers clicked on the ad to visit the advertiser\'s destination.']
  completed_views varchar [note: 'Number of impressions where the viewer watched the ad to completion.']
  completion_rate_percent decimal(5,2) [note: 'Percentage of impressions that were viewed to completion, calculated as completed views divided by total impressions served.']
  content_genre varchar [note: 'Genre of the content during which the ad impression was served.']
  content_rating varchar [note: 'Age-appropriateness rating of the content during which the ad was served. [ENUM-REF-CANDIDATE: G|PG|PG-13|R|TV-Y|TV-Y7|TV-G|TV-PG|TV-14|TV-MA — 10 candidates stripped; promote to reference product]']
  cpm_realized decimal(15,4) [note: 'Actual cost per thousand impressions realized for this delivery event.']
  created_timestamp timestamp [note: 'Timestamp when this impression delivery record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the revenue amount.']
  daypart varchar [note: 'Time segment of the broadcast day during which the impression was delivered.']
  delivery_date date [note: 'Calendar date on which the impression was delivered, used for daily aggregation and reporting.']
  delivery_timestamp timestamp [note: 'Exact date and time when the impression was delivered to the viewer.']
  device_type varchar [note: 'Type of device on which the impression was delivered. [ENUM-REF-CANDIDATE: CTV|Mobile|Tablet|Desktop|Smart TV|Gaming Console|Set-Top Box — 7 candidates stripped; promote to reference product]']
  impression_tracking_url varchar [note: 'URL used to track and verify the impression delivery event.']
  insertion_status varchar [note: 'Status indicating whether the ad was successfully inserted, a fallback was used, or no ad was available.']
  insertion_type varchar [note: 'Technical method used to insert the ad into the content stream or page. [ENUM-REF-CANDIDATE: DAI|SCTE-35|Server-Side|Client-Side|Display|Pre-Roll|Mid-Roll|Post-Roll — 8 candidates stripped; promote to reference product]']
  modified_timestamp timestamp [note: 'Timestamp when this impression delivery record was last modified.']
  operating_system varchar [note: 'Operating system of the device that received the impression.']
  platform_type varchar [note: 'Type of digital platform where the impression was delivered.']
  revenue_amount decimal(15,2) [note: 'Total revenue generated from this impression delivery event.']
  third_party_verification_source varchar [note: 'Name of the third-party verification service that validated this impression delivery.']
  total_impressions_served varchar [note: 'Total number of impressions delivered in this event.']
  verification_status varchar [note: 'Status of third-party verification for this impression.']
  viewability_rate_percent decimal(5,2) [note: 'Percentage of impressions that met viewability standards, calculated as viewable impressions divided by total impressions served.']
  viewable_impressions varchar [note: 'Number of impressions that met the IAB viewability standard (50% of pixels in view for 2+ seconds for display, 50% for 2+ seconds for video).']

  Note: 'Digital and streaming advertising delivery record tracking served impressions and ad insertions across OTT, AVOD, FAST, and digital display campaigns. Covers both Dynamic Ad Insertion (DAI) events triggered by SCTE-35 cues in streaming and standard digital impression serving. Captures delivery date, channel/platform, campaign, ad order line, ISCI creative, insertion type (DAI/SCTE-35, server-side, client-side, display), targeting parameters applied (audience segment, geo, device type), total impressions served, viewable impressions, completed views, click-throughs, CPM realized, insertion status (inserted, fallback, no-fill), CDN delivery confirmation, impression tracking URL, stream session reference, and third-party verification source (IAS, DoubleVerify, Nielsen DAR). Feeds digital billing reconciliation, campaign pacing, and DAI platform reporting.'
}

Table sales.sales_account {
  sales_account_id varchar [pk, note: 'Unique identifier for the sales account record. Primary key for the sales account entity representing advertising agencies, direct advertisers, content licensees, syndication buyers, and distribution partners.']
  billing_account_id varchar [note: 'Foreign key linking to billing.billing_account. Business justification: Sales accounts (CRM entities) must be linked to billing accounts (AR entities) for unified account management. Media broadcasters use this link to synchronize credit limits, payment terms, and account']
  parent_account_sales_account_id varchar [note: 'Reference to the parent sales account in a hierarchical account structure. Used to model agency networks, holding company subsidiaries, and multi-location advertiser organizations.']
  account_name varchar [note: 'The legal or trading name of the sales account organization. This is the primary human-readable identifier for the account.']
  account_status varchar [note: 'Current lifecycle status of the sales account. Active indicates the account is in good standing and can transact; inactive indicates dormant but not closed; suspended indicates temporary hold due to credit or compliance issues; pending indicates account setup in progress; closed indicates permanently terminated relationship.']
  account_tier varchar [note: 'The strategic tier or classification of the account based on revenue potential, relationship depth, and strategic importance. Higher tiers receive preferential pricing, dedicated support, and priority inventory access.']
  account_type varchar [note: 'Classification of the sales account based on its commercial relationship with Media Broadcasting. Agency represents advertising agencies; direct_advertiser represents brands buying media directly; MVPD (Multichannel Video Programming Distributor) and vMVPD (Virtual Multichannel Video Programming Distributor) represent distribution partners; syndicator represents content resale partners; content_licensee represents organizations licensing content rights.']
  agency_commission_rate decimal(5,4) [note: 'The commission percentage paid to advertising agencies for media buys placed on behalf of their clients. Typically expressed as a decimal (e.g., 0.1500 for 15%). Null for non-agency accounts.']
  annual_revenue_potential decimal(18,2) [note: 'The estimated annual revenue opportunity from this account based on historical spend, market share, and sales forecasts. Used for territory planning and quota allocation.']
  auto_renewal_flag boolean [note: 'Indicates whether the master service agreement automatically renews at the end of the contract term. True means the contract renews unless either party provides notice; false means the contract expires and requires renegotiation.']
  billing_address_line1 varchar [note: 'The first line of the billing address where invoices should be sent. Typically contains street number and street name.']
  billing_address_line2 varchar [note: 'The second line of the billing address for suite, floor, or department information.']
  billing_city varchar [note: 'The city component of the billing address.']
  billing_contact_email varchar [note: 'The email address of the primary billing contact for invoice delivery and payment correspondence.']
  billing_contact_name varchar [note: 'The full name of the primary billing contact at the account organization who handles invoices, payment processing, and financial inquiries.']
  billing_contact_phone varchar [note: 'The phone number of the primary billing contact for urgent payment or invoice inquiries.']
  billing_country_code varchar [note: 'The three-letter ISO 3166-1 alpha-3 country code for the billing address (e.g., USA, GBR, CAN).']
  billing_postal_code varchar [note: 'The postal or ZIP code component of the billing address.']
  billing_state_province varchar [note: 'The state or province component of the billing address.']
  blackout_restrictions varchar [note: 'Geographic or temporal restrictions on where or when this account\'s advertising or content may be broadcast. Used to enforce exclusivity agreements, competitive conflicts, or regulatory blackout periods.']
  contract_end_date date [note: 'The expiration date of the current master service agreement or framework contract with this account. Null indicates an evergreen or open-ended agreement.']
  contract_start_date date [note: 'The effective start date of the current master service agreement or framework contract with this account.']
  created_timestamp timestamp [note: 'The date and time when this sales account record was first created in the system. Used for audit trail and data lineage tracking.']
  credit_limit_amount decimal(18,2) [note: 'The maximum outstanding receivables balance allowed for this account before credit hold is applied. Expressed in the account\'s preferred currency.']
  credit_rating varchar [note: 'The credit rating assigned to this account based on payment history, financial stability, and risk assessment. Used to determine payment terms, credit limits, and whether prepayment is required. NR indicates not rated. [ENUM-REF-CANDIDATE: AAA|AA|A|BBB|BB|B|CCC|CC|C|D|NR — 11 candidates stripped; promote to reference product]']
  holding_company_name varchar [note: 'The name of the parent holding company or corporate group to which this account belongs. Used to aggregate spend and manage relationships at the holding company level (e.g., WPP, Omnicom, Publicis Groupe for agencies).']
  industry_vertical varchar [note: 'The primary industry vertical or business sector of the account (e.g., Automotive, Financial Services, Retail, Pharmaceutical, Technology). Used for competitive separation and industry-specific rate cards.']
  last_activity_date date [note: 'The date of the most recent sales activity, campaign, or transaction associated with this account. Used to identify dormant accounts and trigger re-engagement campaigns.']
  last_modified_timestamp timestamp [note: 'The date and time when this sales account record was last updated. Used for change tracking and data synchronization.']
  notes varchar [note: 'Free-form text field for capturing important account-specific information, special handling instructions, relationship history, or strategic context that does not fit structured fields.']
  payment_terms_days varchar [note: 'The number of days allowed for payment after invoice date, as agreed in the master service agreement. Common values include 30, 60, or 90 days. Zero indicates prepayment required.']
  preferred_currency_code varchar [note: 'The three-letter ISO 4217 currency code in which this account prefers to transact and receive invoices (e.g., USD, GBP, EUR, CAD).']
  primary_contact_email varchar [note: 'The email address of the primary business contact for proposals, campaign planning, and general account communication.']
  primary_contact_name varchar [note: 'The full name of the primary business contact or account manager at the client organization who handles day-to-day commercial and operational matters.']
  primary_contact_phone varchar [note: 'The phone number of the primary business contact for urgent campaign or operational matters.']
  salesforce_account_reference varchar [note: 'The source system identifier from Salesforce Media Cloud CRM. This is the external key used to synchronize account data between the lakehouse and the operational CRM system.']
  tax_id_number varchar [note: 'The tax identification number (TIN), employer identification number (EIN), or value-added tax (VAT) registration number for this account. Used for tax reporting and compliance.']

  Note: 'Master record for advertising agencies, direct advertisers, content licensees, syndication buyers, and distribution partners that engage in commercial transactions with Media Broadcasting. Serves as the SSOT for all sales-facing organizational identities — capturing account type (agency, direct, MVPD, syndicator), holding company hierarchy, credit rating, payment terms, assigned sales rep, market territory, agency commission rate, blackout restrictions, preferred currency, and CRM source ID from Salesforce Media Cloud. This is the commercial counterpart to subscriber identity and is the anchor entity for all sales pipeline activity.'
}

Table billing.invoice {
  invoice_id varchar [pk, note: 'Unique identifier for the invoice. Primary key for the invoice entity.']
  ad_order_id varchar [note: 'Foreign key linking to sales.ad_order. Business justification: Invoices are generated for ad orders; the wide_orbit_order_reference plain-text column is a denormalized reference to ad_order. Normalizing to a proper FK enables invoice-to-order reconciliation, orde']
  advertiser_id varchar [note: 'Foreign key linking to sales.advertiser. Business justification: Direct-billed advertiser invoices (no agency intermediary) require advertiser reference for AR aging, credit limit enforcement, payment terms application, and advertiser-level revenue reporting in med. FK namespace reconciled: advertising concept referencing sales domain entity']
  billing_account_id varchar [note: 'Reference to the billing account or subscription account associated with this invoice.']
  billing_cycle_id varchar [note: 'Foreign key linking to billing.cycle. Business justification: Invoice is generated by ONE billing cycle run. Need to track which cycle configuration was used to generate this invoice for audit and reconciliation purposes. No redundant columns to remove.']
  broadcast_license_id varchar [note: 'Foreign key linking to compliance.broadcast_license. Business justification: Station-specific invoices (local ad sales, tower leases) must be attributable to the licensed facility for FCC financial reporting, ownership attribution calculations, and license renewal revenue disc']
  content_window_id varchar [note: 'Reference to the content license window for syndication invoices. Defines the rights period being billed.']
  payment_method_id varchar [note: 'Foreign key linking to billing.payment_method. Business justification: invoice.payment_method is currently a denormalized STRING column. The payment_method table exists in the billing domain and is the authoritative source for payment instrument data. Adding payment_meth']
  sales_agency_id varchar [note: 'Foreign key linking to sales.sales_agency. Business justification: Agency-billed invoices require agency reference for consolidated billing, commission calculation, agency credit limit management, and agency-level AR reporting in advertising operations.. FK namespace reconciled: advertising concept referencing sales domain entity']
  subscriber_id varchar [note: 'Reference to the customer, advertiser, MVPD partner, or syndication licensee being billed.']
  subscription_plan_id varchar [note: 'Reference to the subscription plan for SVOD billing invoices. Null for non-subscription revenue categories.']
  territory_id varchar [note: 'Foreign key linking to rights.territory. Business justification: Facility lease invoices, power bills, and maintenance service charges require facility tracking for cost center allocation, revenue recognition by location, and operational expense reporting in broadc']
  adjustment_amount decimal(18,2) [note: 'Total adjustment amount for credits, makegoods, or billing corrections. Can be positive or negative.']
  amount_paid decimal(18,2) [note: 'Total amount paid against this invoice to date. Used to calculate outstanding balance.']
  billing_period_end_date date [note: 'End date of the billing period covered by this invoice. Relevant for subscription and carriage fee billing.']
  billing_period_start_date date [note: 'Start date of the billing period covered by this invoice. Relevant for subscription and carriage fee billing.']
  created_timestamp timestamp [note: 'Timestamp when this invoice record was first created in the billing system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts on this invoice.']
  discount_amount decimal(18,2) [note: 'Total discount amount applied to this invoice, including promotional discounts, volume discounts, or contractual adjustments.']
  dispute_date date [note: 'Date the invoice was disputed by the customer. Null if never disputed.']
  dispute_reason varchar [note: 'Reason provided by customer for disputing this invoice. Populated when invoice_status is disputed.']
  due_date date [note: 'Date by which payment is expected based on payment terms. Used to calculate overdue status.']
  installment_number varchar [note: 'Installment sequence number for syndication license fees paid over multiple periods. Null for single-payment invoices.']
  invoice_date date [note: 'Date the invoice was issued to the customer, advertiser, or partner. Used as the basis for payment terms calculation.']
  invoice_number varchar [note: 'Externally-visible unique invoice number used for customer communication and payment reference. Generated by billing system (Zuora, Wide Orbit, or SAP S/4HANA).']
  invoice_status varchar [note: 'Current lifecycle status of the invoice in the billing workflow. [ENUM-REF-CANDIDATE: draft|issued|sent|paid|partially_paid|overdue|disputed|void|cancelled — 9 candidates stripped; promote to reference product]']
  isci_codes varchar [note: 'Comma-separated list of ISCI codes for ad spots included in this advertising invoice. Used for affidavit matching and proof of broadcast.']
  mvpd_subscriber_count varchar [note: 'Number of subscribers reported by the MVPD partner as the basis for carriage fee calculation. Relevant for carriage fee invoices.']
  notes varchar [note: 'Free-text notes or comments about this invoice for internal reference or customer communication.']
  outstanding_balance decimal(18,2) [note: 'Remaining unpaid balance on this invoice. Calculated as total_amount_due minus amount_paid.']
  paid_date date [note: 'Date the invoice was fully paid. Null if not yet paid or only partially paid.']
  payment_terms varchar [note: 'Contractual payment terms defining when payment is due relative to invoice date. [ENUM-REF-CANDIDATE: net_15|net_30|net_45|net_60|net_90|due_on_receipt|prepaid — 7 candidates stripped; promote to reference product]']
  proration_flag boolean [note: 'Indicates whether this subscription invoice includes prorated charges due to mid-cycle changes. Relevant for SVOD billing.']
  revenue_recognition_end_date date [note: 'End date of the period over which revenue from this invoice should be recognized per ASC 606 guidelines.']
  revenue_recognition_start_date date [note: 'Start date of the period over which revenue from this invoice should be recognized per ASC 606 guidelines.']
  source_system_invoice_reference varchar [note: 'Original invoice identifier from the source billing system. Used for reconciliation and audit trail.']
  subtotal_amount decimal(18,2) [note: 'Total amount before taxes, fees, and adjustments. Sum of all line item amounts.']
  tax_amount decimal(18,2) [note: 'Total tax amount applied to this invoice, including sales tax, VAT, or other applicable taxes.']
  total_amount_due decimal(18,2) [note: 'Final total amount due after all taxes, discounts, and adjustments. This is the amount the customer must pay.']
  updated_timestamp timestamp [note: 'Timestamp when this invoice record was last modified in the billing system.']
  void_reason varchar [note: 'Reason this invoice was voided or cancelled. Populated when invoice_status is void or cancelled.']

  Note: 'Master billing document representing a formal demand for payment issued to a subscriber, advertiser, MVPD partner, or syndication licensee. Captures invoice number, billing period, total amount due, currency, tax amounts, invoice status (draft, issued, paid, disputed, void), due date, payment terms, revenue category (subscription, advertising, carriage, syndication), ASC 606 revenue recognition period, and source system reference (Zuora, Wide Orbit, SAP S/4HANA). Supports stream-specific extended attributes: subscription plan/proration for SVOD billing, Wide Orbit order ID/ISCI codes for ad billing, MVPD subscriber count basis for carriage fees, and license window/installment schedule for syndication. Serves as the SSOT for all billing documents across all revenue streams.'
}

Table billing.invoice_line {
  invoice_line_id varchar [pk, note: 'Unique identifier for the invoice line item. Primary key for the invoice_line product.']
  ad_billing_order_id varchar [note: 'Foreign key linking to billing.ad_billing_order. Business justification: invoice_line already has ad_order_id → sales.ad_order (cross-domain). The ad_billing_order is the billing-domain representation of a finalized ad sales order from Wide Orbit. Adding ad_billing_order_i']
  ad_campaign_id varchar [note: 'Reference to the advertising campaign associated with this line item, applicable when revenue_category is advertising. Links to campaign details for ad spot billing.']
  ad_order_id varchar [note: 'Reference to the advertising sales order that generated this billing line, used for tracking ad sales fulfillment and billing reconciliation.']
  ad_order_line_id varchar [note: 'Foreign key linking to sales.ad_order_line. Business justification: Granular billing of individual ad order lines (by daypart, program, spot length) requires direct line-level link for accurate invoicing, revenue recognition, and performance reporting in media sales.. FK namespace reconciled: advertising concept referencing sales domain entity']
  ad_spot_id varchar [note: 'Foreign key linking to sales.makegood. Business justification: Makegood spot billing requires direct makegood reference for revenue recognition, fulfillment tracking, and advertiser reporting of makegood delivery in broadcast advertising operations.. FK namespace reconciled: advertising concept referencing sales domain entity']
  content_episode_id varchar [note: 'Foreign key linking to content.content_episode. Business justification: Per-episode billing (syndication fees per episode aired, pay-per-episode VOD, or per-episode licensing charges) requires invoice lines to reference specific episodes. Syndication billing reconciliatio']
  content_version_id varchar [note: 'Foreign key linking to content.version. Business justification: Version-specific licensing fees (HD vs SD rates, dubbed vs subtitled version charges, UHD premium pricing) require invoice lines to reference the specific content version billed. Broadcast licensors r']
  grant_id varchar [note: 'Foreign key linking to rights.grant. Business justification: Invoice lines for content exploitation charges (per-episode fees, streaming royalties, carriage fees) must trace to the specific rights grant authorizing the exploitation. Finance and rights audit tea']
  nielsen_rating_id varchar [note: 'Foreign key linking to audience.nielsen_rating. Business justification: Ad invoice line items reference specific Nielsen ratings for the aired spot to verify CPM/GRP delivery, calculate makegood obligations, and reconcile guaranteed vs actual audience performance. Core ad']
  original_invoice_line_id varchar [note: 'Reference to the original invoice line that this line is adjusting, crediting, or replacing. Used for tracking billing corrections, credits, and makegoods.']
  partner_id varchar [note: 'Foreign key linking to partner.partner. Business justification: Advertising spot delivery invoices reference specific transmission equipment for proof-of-performance documentation, FCC compliance reporting, and affidavit verification required by advertisers and ag']
  political_ad_record_id varchar [note: 'Foreign key linking to compliance.political_ad_record. Business justification: Individual invoice lines for political ads must link to public file records for FCC compliance. Enables auditors to verify lowest unit charge, reasonable access, and equal time obligations at line-ite']
  subscription_id varchar [note: 'Reference to the subscriber subscription record for subscription revenue line items, linking the charge to the active subscription plan.']
  charge_description varchar [note: 'Detailed description of the charge appearing on the invoice line, explaining the service, ad spot, carriage fee period, or license fee installment being billed.']
  cost_center varchar [note: 'Cost center or business unit responsible for this revenue line, used for internal financial reporting and profitability analysis.']
  cpm_rate decimal(18,4) [note: 'Cost per thousand impressions rate for advertising line items, the standard pricing metric for ad inventory sales in broadcasting.']
  created_timestamp timestamp [note: 'Timestamp when this invoice line record was first created in the billing system, used for audit trail and billing cycle tracking.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts on this line (e.g., USD, GBP, EUR, CAD).']
  discount_amount decimal(18,2) [note: 'Total discount applied to this line item, including promotional discounts, volume discounts, makegoods credits, or contractual rate reductions.']
  discount_code varchar [note: 'Code or identifier for the discount program or promotion applied to this line, used for tracking discount effectiveness and revenue impact.']
  dispute_status varchar [note: 'Current status of any billing dispute associated with this line item, tracking customer challenges and resolution workflow.']
  extended_amount decimal(18,2) [note: 'Total amount for this line item including all charges, discounts, and taxes. This is the final billable amount for the line.']
  gl_account_code varchar [note: 'General ledger account code for posting this revenue line item to the financial system, ensuring proper revenue classification in financial statements.']
  grp_delivered decimal(10,2) [note: 'Gross Rating Points delivered for this advertising line item, measuring the total audience reach and frequency achieved for the campaign.']
  isci_code varchar [note: 'Industry Standard Commercial Identification code for the specific ad creative that aired, used for affidavit verification and makegood tracking.']
  last_modified_timestamp timestamp [note: 'Timestamp of the most recent modification to this invoice line record, tracking billing adjustments and corrections for audit purposes.']
  line_item_number varchar [note: 'Business-facing line item identifier displayed on customer invoices and billing statements for reference and dispute resolution.']
  line_number varchar [note: 'Sequential line number within the invoice, used for ordering and referencing specific charges on the invoice document.']
  makegood_flag boolean [note: 'Indicates whether this line item is a makegood (compensatory ad spot) provided to an advertiser due to underdelivery or technical issues with a previous campaign.']
  notes varchar [note: 'Free-form notes or comments about this invoice line, used for documenting special billing arrangements, dispute details, or billing adjustments.']
  quantity decimal(18,4) [note: 'Quantity of units being charged on this line. For ad spots this is the number of impressions or spots; for subscriptions this is typically 1; for usage-based billing this is the measured consumption.']
  revenue_recognition_rule varchar [note: 'Rule or method for recognizing revenue from this line item, such as point-in-time (ad spot delivery), over-time (subscription period), or milestone-based (license installment).']
  service_period_end_date date [note: 'End date of the service period covered by this line item charge. For subscriptions this is the billing cycle end; for ad campaigns this is the flight end date.']
  service_period_start_date date [note: 'Start date of the service period covered by this line item charge. For subscriptions this is the billing cycle start; for ad campaigns this is the flight start date.']
  service_type varchar [note: 'Specific type of service or product being billed on this line, such as premium channel subscription, ad pod placement, carriage agreement tier, or syndication window.']
  spot_count varchar [note: 'Number of ad spots delivered for this line item, used in advertising billing to verify delivery against the sales order commitment.']
  subtotal_amount decimal(18,2) [note: 'Line item subtotal before taxes and discounts, calculated as quantity multiplied by unit rate.']
  tax_amount decimal(18,2) [note: 'Total tax charged on this line item, including sales tax, VAT, GST, or other applicable taxes based on jurisdiction and service type.']
  tax_code varchar [note: 'Tax classification code that determines the tax treatment for this line item, used for tax calculation and compliance reporting.']
  unit_of_measure varchar [note: 'Unit of measure for the quantity field, such as spot (ad placement), impression (ad view), subscriber (subscription count), stream (viewing session), or GB (data transfer).']
  unit_rate decimal(18,4) [note: 'Price per unit for this line item. For advertising this may be CPM (Cost Per Mille) rate; for subscriptions this is the plan price; for carriage this is the per-subscriber fee.']

  Note: 'Individual line-item detail within a billing invoice, representing a discrete charge for a specific service, ad spot, carriage fee period, or license fee installment. Captures line number, charge description, quantity, unit rate, extended amount, revenue category (subscription, advertising, carriage, syndication), performance obligation identifier per ASC 606, tax code, and discount applied. Enables granular revenue recognition and dispute resolution at the charge level.'
}

Table billing.payment {
  payment_id varchar [pk, note: 'Unique identifier for the payment transaction. Primary key for the payment record.']
  ad_billing_order_id varchar [note: 'Foreign key linking to billing.ad_billing_order. Business justification: Advertising payments in media broadcasting are often remitted against specific ad billing orders (Wide Orbit orders), not just against invoices. payment.invoice_id covers invoice-level payment applica']
  advertiser_id varchar [note: 'Foreign key linking to sales.advertiser. Business justification: Payments are remitted by advertisers; direct advertiser_id on payment enables advertiser payment history reports, AR aging dashboards, and cash application workflows. Media billing teams require adver']
  billing_account_id varchar [note: 'Reference to the customer or advertiser account making the payment. Links payment to account holder.']
  broadcast_license_id varchar [note: 'Foreign key linking to compliance.broadcast_license. Business justification: Payments need cost center attribution for cash application tracking and departmental cash flow analysis. Enables media orgs to track cash collection performance by department or business unit for work']
  campaign_id varchar [note: 'Foreign key linking to sales.campaign. Business justification: Campaign-level payment tracking is standard in media billing — payments are often earmarked for specific campaigns (especially political ad campaigns requiring FEC compliance). Direct campaign_id on p']
  invoice_id varchar [note: 'Reference to the invoice against which this payment is applied. Links payment to billing document.']
  partner_id varchar [note: 'Foreign key linking to partner.partner. Business justification: Payments to technology vendors must reference contracts for payment terms validation, accrual matching, milestone-based payment verification, and audit trail compliance required in technology procurem']
  payment_method_id varchar [note: 'Foreign key linking to billing.payment_method. Business justification: Payment is made using ONE payment method (stored payment instrument). Currently duplicates card and bank account details; need FK to the stored payment_method record for single source of truth. Remove']
  royalty_statement_id varchar [note: 'Foreign key linking to rights.royalty_statement. Business justification: Payments made to rights holders settle specific royalty statements. The royalty accounting team tracks which payment cleared which statement for reconciliation, dispute resolution, and statement statu']
  subscription_invoice_id varchar [note: 'Foreign key linking to billing.subscription_invoice. Business justification: Subscription payments (Zuora autopay) are applied against specific subscription invoices. While payment.invoice_id links to the master invoice, a direct payment → subscription_invoice FK enables subsc']
  amount decimal(18,2) [note: 'The monetary amount of the payment transaction in the specified currency. Gross payment value before any adjustments.']
  applied_amount decimal(18,2) [note: 'The portion of the payment amount that has been applied against outstanding invoices or account balances. May differ from payment_amount if partial application or overpayment.']
  authorization_code varchar [note: 'Authorization code returned by the payment processor or card issuer confirming approval of the transaction.']
  bank_transaction_reference varchar [note: 'Reference number provided by the bank for wire transfers, ACH transactions, or check deposits. Used for bank reconciliation.']
  channel varchar [note: 'The channel or interface through which the payment was submitted (web portal, mobile app, IVR, mail, in-person, API, batch import). [ENUM-REF-CANDIDATE: web_portal|mobile_app|ivr|mail|in_person|api|batch_import — 7 candidates stripped; promote to reference product]']
  check_number varchar [note: 'Check number for payments made by paper check. Used for reconciliation and tracking.']
  created_timestamp timestamp [note: 'Timestamp when this payment record was first created in the system. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the payment transaction (e.g., USD, GBP, EUR, CAD).']
  dispute_date date [note: 'Date when the payment dispute or chargeback was initiated. Format: yyyy-MM-dd.']
  failure_reason varchar [note: 'Detailed reason for payment failure if status is failed. Includes processor error codes and messages.']
  gateway varchar [note: 'Name of the payment gateway or processor used to handle the transaction (e.g., Stripe, Authorize.Net, PayPal, Adyen).']
  gateway_transaction_reference varchar [note: 'Unique transaction identifier assigned by the payment gateway or processor. Used for reconciliation and dispute resolution.']
  gl_posting_date date [note: 'Date when the payment was posted to the general ledger in the financial system. Format: yyyy-MM-dd.']
  is_autopay boolean [note: 'Indicates whether this payment was processed automatically through a recurring payment or autopay setup. True if autopay, false if manual.']
  is_disputed boolean [note: 'Indicates whether this payment is currently under dispute or chargeback. True if disputed, false otherwise.']
  method_type varchar [note: 'The type of payment instrument used for the transaction. Indicates the financial mechanism (credit card, ACH, wire, check, etc.). [ENUM-REF-CANDIDATE: credit_card|debit_card|ach|wire_transfer|check|cash|paypal|direct_debit — 8 candidates stripped; promote to reference product]']
  notes varchar [note: 'Free-text notes or comments about the payment transaction. Used for special instructions, dispute details, or reconciliation notes.']
  payment_date date [note: 'The date when the payment transaction was initiated or received by the business. Format: yyyy-MM-dd.']
  payment_number varchar [note: 'Externally visible unique payment transaction number used for customer communication and reconciliation. Format: PAY-XXXXXXXX.']
  payment_status varchar [note: 'Current lifecycle status of the payment transaction. Tracks progression from pending through cleared or failed states. [ENUM-REF-CANDIDATE: pending|processing|cleared|failed|reversed|cancelled|refunded — 7 candidates stripped; promote to reference product]']
  payment_timestamp timestamp [note: 'The precise date and time when the payment transaction was processed. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.']
  refund_amount decimal(18,2) [note: 'Amount refunded to the customer if payment status is refunded. May be partial or full refund.']
  refund_date date [note: 'Date when the refund was processed and issued to the customer. Format: yyyy-MM-dd.']
  reversal_reason varchar [note: 'Reason for payment reversal if status is reversed. Includes chargeback reason codes and dispute details.']
  settlement_date date [note: 'The date when the payment funds were settled and cleared in the business bank account. Format: yyyy-MM-dd.']
  source varchar [note: 'Type of business relationship generating the payment (subscriber, advertiser, distributor, syndicator, licensee, other).']
  unapplied_amount decimal(18,2) [note: 'The portion of the payment amount that remains unapplied and is held as credit on the account. Calculated as payment_amount minus applied_amount.']
  updated_timestamp timestamp [note: 'Timestamp when this payment record was last modified. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.']

  Note: 'Record of a payment transaction received or applied against an outstanding invoice or account balance. Captures payment date, amount, currency, payment method type (credit card, ACH, wire, check), payment status (pending, cleared, failed, reversed), PCI DSS tokenized card reference, bank transaction reference, settlement date, and applied invoice linkage. Integrates with Zuora for subscriber payments and SAP S/4HANA for financial posting. SSOT for all inbound monetary receipts.'
}

Table billing.payment_method {
  payment_method_id varchar [pk, note: 'Unique identifier for the payment method record. Primary key.']
  billing_account_id varchar [note: 'Foreign key linking to billing.billing_account. Business justification: payment_method currently only links to subscriber.subscriber via subscriber_id, covering consumer/SVOD use cases. In media broadcasting, advertisers and agencies also have stored payment methods (ACH,']
  subscriber_id varchar [note: 'Reference to the subscriber or advertiser who owns this payment method. Links to the subscriber master record in Zuora.']
  bank_account_number_last_four varchar [note: 'The last four digits of the bank account number. Used for customer identification without exposing full account details. Applicable for ACH, SEPA, and wire transfer methods.']
  bank_routing_number varchar [note: 'The routing number for ACH or wire transfer payment methods. Stored in masked or tokenized format per PCI DSS requirements. Used for direct debit and electronic funds transfer.']
  billing_address_line1 varchar [note: 'The primary street address line associated with the payment method. Used for Address Verification Service (AVS) checks and fraud prevention.']
  billing_address_line2 varchar [note: 'Secondary address line for apartment, suite, or unit number. Optional field for complete billing address capture.']
  billing_city varchar [note: 'The city or municipality of the billing address. Used for AVS verification and tax jurisdiction determination.']
  billing_country_code varchar [note: 'Three-letter ISO country code for the billing address. Used for international payment processing and regulatory compliance (e.g., GDPR, PCI DSS regional requirements).']
  billing_postal_code varchar [note: 'The postal or ZIP code of the billing address. Critical for AVS verification and accurate sales tax calculation.']
  billing_state_province varchar [note: 'The state, province, or region of the billing address. Used for AVS verification and regional tax compliance.']
  card_brand varchar [note: 'The brand or network of the payment card (e.g., Visa, Mastercard, American Express). Applicable only when payment method type is credit or debit card. [ENUM-REF-CANDIDATE: visa|mastercard|amex|discover|jcb|diners_club|unionpay — 7 candidates stripped; promote to reference product]']
  cardholder_name varchar [note: 'The name of the individual or entity as it appears on the payment card. Used for billing verification and fraud prevention.']
  created_timestamp timestamp [note: 'The date and time when this payment method record was first created in the system. Used for audit trail and payment method age analysis.']
  deactivated_timestamp timestamp [note: 'The date and time when this payment method was deactivated or closed. Null if the payment method is still active. Used for lifecycle tracking and retention analysis.']
  deactivation_reason varchar [note: 'The reason why the payment method was deactivated. Used for churn analysis and process improvement.']
  expiry_alert_date date [note: 'The date when the system should trigger an alert to the subscriber about upcoming payment method expiration. Typically set 30-60 days before card expiry to enable proactive customer outreach and reduce involuntary churn.']
  expiry_month varchar [note: 'The month (1-12) when the payment card expires. Used to validate card validity and trigger expiry alerts for subscription renewals.']
  expiry_year varchar [note: 'The four-digit year when the payment card expires. Used in conjunction with expiry_month to determine card validity and schedule proactive customer outreach.']
  failed_transaction_count varchar [note: 'The cumulative count of failed transaction attempts using this payment method. Used to identify problematic payment methods and trigger dunning workflows.']
  gateway_customer_profile_reference varchar [note: 'The unique customer profile identifier in the payment gateway system. Used to link this payment method to the gateway\'s customer vault for secure transaction processing.']
  gateway_payment_method_reference varchar [note: 'The unique payment method identifier assigned by the payment gateway. Used for transaction processing and reconciliation with gateway records.']
  is_default boolean [note: 'Boolean flag indicating whether this is the default payment method for the subscriber. Used to determine which payment method to charge for recurring subscriptions and invoices.']
  last_failure_date date [note: 'The date of the most recent failed transaction attempt. Used in conjunction with failed_transaction_count to manage retry logic and customer communication.']
  last_failure_reason varchar [note: 'The reason code or message returned by the payment gateway for the most recent failed transaction. Used for troubleshooting and customer support.']
  last_four_digits varchar [note: 'The last four digits of the payment card number. Used for customer identification and verification without exposing full card details. PCI DSS permits storage of last four digits.']
  last_transaction_amount decimal(15,2) [note: 'The amount of the most recent successful transaction in the subscriber\'s billing currency. Used for fraud detection and transaction pattern analysis.']
  last_transaction_date date [note: 'The date of the most recent successful transaction using this payment method. Used for payment method activity tracking and dormancy analysis.']
  mandate_reference varchar [note: 'The unique reference identifier for the direct debit mandate authorizing recurring payments. Required for SEPA Direct Debit and other regulated direct debit schemes.']
  mandate_signed_date date [note: 'The date when the customer signed the direct debit mandate. Required for regulatory compliance and dispute resolution in direct debit transactions.']
  modified_by varchar [note: 'The user or system process that last modified this payment method record. Used for audit trail and compliance reporting.']
  modified_timestamp timestamp [note: 'The date and time when this payment method record was last modified. Used for audit trail and change tracking.']
  payment_gateway varchar [note: 'The payment gateway or processor used to tokenize and process transactions for this payment method (e.g., Stripe, Adyen, Braintree, Authorize.Net). Used for routing transactions and reconciliation.']
  payment_method_status varchar [note: 'The current lifecycle status of the payment method. Determines whether the payment method can be used for new transactions. Inactive or expired methods require customer action to reactivate.']
  payment_method_type varchar [note: 'The type of payment instrument registered. Indicates the payment mechanism used for billing transactions. [ENUM-REF-CANDIDATE: credit_card|debit_card|ach|sepa|wire_transfer|paypal|apple_pay — 7 candidates stripped; promote to reference product]']
  token varchar [note: 'PCI DSS-compliant tokenized representation of the payment instrument. Never stores raw Primary Account Number (PAN). Used for secure payment processing without exposing sensitive cardholder data.']
  verification_date date [note: 'The date when the payment method was last verified. Used to track verification currency and trigger re-verification workflows.']
  verification_status varchar [note: 'The current verification status of the payment method. Indicates whether the payment instrument has been successfully validated through AVS, CVV check, or micro-deposit verification.']
  created_by varchar [note: 'The user or system process that created this payment method record. Used for audit trail and compliance reporting.']

  Note: 'Stored and tokenized payment instrument registered by a subscriber or advertiser for recurring or one-time billing. Captures payment method type (credit card, debit card, ACH, SEPA, wire), PCI DSS-compliant token (never raw PAN), card brand, last four digits, expiry month/year, billing address, bank routing number (masked), mandate reference for direct debit, is_default flag, verification status, and expiry alert date. Managed in Zuora for subscriber billing.'
}

Table billing.billing_account {
  billing_account_id varchar [pk, note: 'Unique identifier for the billing account. Primary key for the billing account entity.']
  billing_cycle_id varchar [note: 'Foreign key linking to billing.cycle. Business justification: Billing account belongs to ONE billing cycle schedule (monthly, quarterly, annual). Currently stores billing_cycle_code as STRING; need FK to cycle table for full cycle configuration. Remove billing_c']
  account_name varchar [note: 'Legal or business name associated with the billing account. For subscriber accounts, this is the account holder name; for corporate accounts, this is the registered business name.']
  account_number varchar [note: 'Externally-visible unique account number assigned to the billing account. Used on invoices, statements, and customer correspondence.']
  account_status varchar [note: 'Current lifecycle status of the billing account. Active accounts are in good standing and can transact; suspended accounts have temporary holds due to payment issues or policy violations; closed accounts are permanently terminated; pending activation accounts are awaiting initial setup completion; delinquent accounts have overdue balances and may face service interruption; write-off accounts have uncollectible balances removed from active receivables.']
  account_type varchar [note: 'Classification of the billing account based on the nature of the billable relationship. Subscriber accounts are for SVOD/AVOD/TVOD end-users; advertiser accounts are for agencies and direct advertisers; MVPD accounts are for multichannel video programming distributors paying carriage fees; syndication licensee accounts are for content resale partners; production vendor accounts are for production service providers; talent accounts are for residuals and royalty payments.']
  auto_pay_enabled_flag boolean [note: 'Indicates whether automatic payment processing is enabled for this account. When true, invoices are automatically charged to the default payment method on the due date.']
  billing_address_line1 varchar [note: 'Primary street address line for billing correspondence and invoice delivery.']
  billing_address_line2 varchar [note: 'Secondary address line for apartment, suite, or unit number.']
  billing_city varchar [note: 'City or municipality for the billing address.']
  billing_country_code varchar [note: 'Three-letter ISO country code for the billing address (e.g., USA, GBR, CAN).']
  billing_currency_code varchar [note: 'Three-letter ISO currency code in which this account is billed (e.g., USD, GBP, EUR). All invoices and payments for this account are denominated in this currency.']
  billing_cycle_day varchar [note: 'Day of the month (1-31) on which recurring invoices are generated for monthly billing cycles. Null for non-monthly cycles.']
  billing_postal_code varchar [note: 'Postal or ZIP code for the billing address.']
  billing_state_province varchar [note: 'State, province, or region for the billing address.']
  closed_date date [note: 'Date on which this billing account was permanently closed. Null for active and suspended accounts.']
  created_timestamp timestamp [note: 'Timestamp when this billing account record was first created in the system.']
  credit_limit_amount decimal(15,2) [note: 'Maximum outstanding balance allowed for this account before credit hold is applied. Null indicates no credit limit (cash-in-advance or unlimited credit).']
  current_balance_amount decimal(15,2) [note: 'Current outstanding balance on the account, calculated as sum of unpaid invoices minus unapplied credits and payments. Positive values indicate amounts owed to the business; negative values indicate credit balances owed to the customer.']
  dunning_level varchar [note: 'Current stage in the collections escalation process for overdue accounts. 0 indicates no dunning (account current); higher values indicate progressive escalation steps (e.g., 1=reminder notice, 2=warning, 3=service suspension notice, 4=final notice before write-off).']
  invoice_delivery_method varchar [note: 'Preferred method for delivering invoices to this account. Email sends PDF invoices; postal mail sends printed invoices; electronic portal makes invoices available for download in customer self-service portal; EDI transmits invoices via Electronic Data Interchange (X12 810 or EDIFACT INVOIC).']
  last_dunning_date date [note: 'Date of the most recent dunning notice or collections contact sent to this account.']
  last_invoice_date date [note: 'Date of the most recent invoice generated for this account. Used for billing cycle tracking and account activity monitoring.']
  last_payment_amount decimal(15,2) [note: 'Amount of the most recent payment received. Used for payment pattern analysis.']
  last_payment_date date [note: 'Date of the most recent payment received and applied to this account. Used for payment behavior analysis and credit risk assessment.']
  opened_date date [note: 'Date on which this billing account was first established and activated.']
  payment_terms_days varchar [note: 'Number of days from invoice date within which payment is due. Common values are 0 (immediate), 15, 30, 60, or 90 days. Used to calculate invoice due dates and aging buckets.']
  primary_contact_email varchar [note: 'Email address of the primary billing contact. Used for invoice delivery, payment reminders, and billing notifications.']
  primary_contact_name varchar [note: 'Name of the primary billing contact or accounts payable representative for this account. Used for billing inquiries and dispute resolution.']
  primary_contact_phone varchar [note: 'Phone number of the primary billing contact. Used for urgent billing inquiries and collections calls.']
  sap_customer_account_number varchar [note: 'Customer master record number in SAP S/4HANA Financial Accounting (FI) module. Used for GL posting, accounts receivable management, and financial reconciliation. This is the authoritative financial system identifier.']
  tax_exempt_flag boolean [note: 'Indicates whether this account is exempt from sales tax, VAT, or other consumption taxes. True for tax-exempt organizations (e.g., non-profits, government entities, resellers with valid exemption certificates); false for standard taxable accounts.']
  tax_exemption_certificate_number varchar [note: 'Government-issued certificate or registration number authorizing tax exemption. Required for audit trail when tax_exempt_flag is true.']
  tax_exemption_expiry_date date [note: 'Date on which the tax exemption certificate expires and must be renewed. Null for permanent exemptions.']
  updated_timestamp timestamp [note: 'Timestamp when this billing account record was last modified.']
  wideorbit_account_reference varchar [note: 'Account identifier in WideOrbit traffic and billing system. Used for advertising sales order management, spot scheduling, and ad billing for advertiser and agency accounts.']
  zuora_account_reference varchar [note: 'Account identifier in Zuora subscription billing platform. Used for subscription lifecycle management, recurring billing, and revenue recognition for SVOD/AVOD subscriber accounts.']

  Note: 'Billing-domain representation of a billable entity — a subscriber household, an advertising agency account, an MVPD operator, or a syndication licensee. Distinct from the subscriber or advertiser master record in their respective domains; this entity owns the financial relationship: billing address, billing currency, payment terms, credit limit, account balance, billing cycle assignment, tax exemption status, dunning level, and SAP customer account number. SSOT for the financial account identity within billing.'
}

Table billing.cycle {
  cycle_id varchar [pk, note: 'Primary key for cycle']
  auto_renew_enabled boolean [note: 'Indicates whether subscriptions on this billing cycle automatically renew at the end of the term. True enables automatic renewal in Zuora subscription management.']
  billing_period_end_day varchar [note: 'Day of the month (1-31) when the service period covered by the invoice ends. Used to calculate service period duration for revenue recognition. Null for non-monthly frequencies.']
  billing_period_start_day varchar [note: 'Day of the month (1-31) when the service period covered by the invoice begins. May differ from cycle_day for advance billing scenarios. Null for non-monthly frequencies.']
  billing_run_day_offset varchar [note: 'Number of days before or after the cycle day when the billing run executes. Positive values indicate days after cycle day; negative values indicate days before. Used to schedule invoice generation in advance of service period.']
  billing_timing varchar [note: 'Indicates whether billing occurs in advance (invoice before service period) or in arrears (invoice after service period). Critical for revenue recognition under ASC 606.']
  code varchar [note: 'Business identifier code for the billing cycle (e.g., MONTHLY_01, QUARTERLY_Q1, ANNUAL_FY). Used in Zuora subscription billing engine for cycle identification.']
  created_by_user varchar [note: 'User identifier or system account that created this billing cycle configuration. Used for audit trail and accountability under SOX compliance requirements.']
  created_timestamp timestamp [note: 'Timestamp when this billing cycle configuration record was first created in the system. Audit trail field for data governance.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for invoices generated under this billing cycle (e.g., USD, GBP, EUR). All charges in the cycle are denominated in this currency.']
  cycle_status varchar [note: 'Current lifecycle status of the billing cycle configuration. Active cycles are available for new subscriptions; inactive cycles are closed to new assignments but continue for existing subscribers; deprecated cycles are phased out; pending cycles are configured but not yet live.']
  cycle_type varchar [note: 'Classification of the billing cycle by revenue stream: subscription (SVOD/AVOD subscriber billing), advertising (ad campaign billing via Wide Orbit), carriage (MVPD/vMVPD distribution fees), syndication (content licensing fees), usage (pay-per-view/TVOD), or custom (non-standard arrangements).']
  day varchar [note: 'Day of the month (1-31) when the billing cycle starts or billing run executes. For monthly cycles, this is the anchor date. Null for non-monthly frequencies.']
  description varchar [note: 'Detailed description of the billing cycle configuration, including business rules, special handling instructions, and usage notes for billing operations team.']
  effective_end_date date [note: 'Date when this billing cycle configuration is retired and no longer available for new assignments. Null for currently active cycles with no planned end date.']
  effective_start_date date [note: 'Date when this billing cycle configuration becomes active and available for assignment to billing accounts or product plans.']
  frequency varchar [note: 'Recurrence interval for invoice generation: daily, weekly, biweekly, monthly, quarterly, semiannual, annual, or custom. Determines how often billing runs execute in Zuora. [ENUM-REF-CANDIDATE: daily|weekly|biweekly|monthly|quarterly|semiannual|annual|custom — 8 candidates stripped; promote to reference product]']
  gl_account_code varchar [note: 'General ledger account code in SAP S/4HANA where revenue from this billing cycle is posted. Used for financial reconciliation and reporting.']
  grace_period_days varchar [note: 'Number of days after payment due date before late fees or service suspension actions are triggered. Provides customer buffer for payment processing delays.']
  invoice_generation_day varchar [note: 'Specific day of the month (1-31) when invoices are generated for this cycle. Calculated from cycle_day and billing_run_day_offset. Null for non-monthly frequencies.']
  last_billing_date date [note: 'Most recent date when a billing run was successfully completed for this cycle. Null if no billing run has occurred yet.']
  modified_by_user varchar [note: 'User identifier or system account that last modified this billing cycle configuration. Used for audit trail and accountability under SOX compliance requirements.']
  modified_timestamp timestamp [note: 'Timestamp when this billing cycle configuration record was last updated. Audit trail field for change tracking and data governance.']
  name varchar [note: 'Human-readable name of the billing cycle (e.g., Monthly Standard, Quarterly Advance, Annual Arrears).']
  next_billing_date date [note: 'Next date when a billing run will execute for accounts assigned to this cycle. Updated after each billing run completion. Used by Zuora billing engine for scheduling.']
  payment_due_days varchar [note: 'Number of days after invoice generation when payment is due. Used to calculate invoice due date. Standard terms are Net 30, Net 15, or immediate (0 days).']
  proration_enabled boolean [note: 'Indicates whether partial-period charges are prorated when subscription starts/ends mid-cycle. True enables proration calculation in Zuora.']
  proration_method varchar [note: 'Method for calculating prorated charges: daily (per-day calculation), monthly (per-month calculation), or none (no proration). Used when proration_enabled is true.']
  renewal_notice_days varchar [note: 'Number of days before cycle renewal when customer notification is sent. Used for auto-renew reminders and cancellation windows. Null if auto_renew_enabled is false.']
  revenue_recognition_rule varchar [note: 'Code identifying the ASC 606 revenue recognition rule applied to invoices generated under this cycle. Determines how revenue is recognized over time (e.g., straight-line, milestone-based). Maps to SAP S/4HANA revenue recognition configuration.']
  tax_calculation_enabled boolean [note: 'Indicates whether automatic tax calculation is enabled for invoices generated under this cycle. True triggers tax engine integration (e.g., Avalara, Vertex) during invoice generation.']

  Note: 'Defines the recurring billing schedule configuration for a billing account or product plan — monthly, quarterly, annual, or custom. Captures cycle name, frequency, cycle start day, billing run date, proration rules, advance vs. arrears billing flag, next bill date, and last bill date. Used by Zuora subscription billing engine to trigger invoice generation. Reference entity that governs when invoices are produced for each account.'
}

Table billing.subscription_invoice {
  subscription_invoice_id varchar [pk, note: 'Unique identifier for the subscription invoice record. Primary key for this entity.']
  billing_account_id varchar [note: 'External billing account identifier from Zuora. Used for multi-subscription account consolidation and billing hierarchy management.']
  billing_cycle_id varchar [note: 'Foreign key linking to billing.cycle. Business justification: Subscription invoice follows ONE billing cycle schedule. Currently stores billing_cycle as STRING; need FK to cycle table for full cycle configuration. Remove billing_cycle string as it can be retriev']
  payment_method_id varchar [note: 'Foreign key linking to billing.payment_method. Business justification: subscription_invoice.payment_method_type is a denormalized STRING. Subscription invoices are auto-paid via a registered payment method (Zuora autopay). Adding payment_method_id FK links the subscripti']
  subscriber_id varchar [note: 'Reference to the subscriber (customer/account holder) who is billed by this invoice.']
  subscription_id varchar [note: 'Reference to the parent subscription account that this invoice bills. Links to the subscription master record.']
  zuora_invoice_id varchar [note: 'Native invoice identifier from Zuora subscription billing system. Used for system reconciliation and API integration.']
  amount_paid decimal(15,2) [note: 'Total amount paid by subscriber against this invoice to date. Used to calculate outstanding balance and track partial payments.']
  auto_pay_enabled boolean [note: 'Indicates whether automatic payment processing is enabled for this invoice. True means payment will be attempted automatically on due date.']
  balance_due decimal(15,2) [note: 'Outstanding amount remaining to be paid on this invoice. Calculated as total_amount minus amount_paid.']
  churn_risk_flag boolean [note: 'Indicates whether the subscriber was flagged as high churn risk at the time of invoice generation. Used for retention campaign targeting and revenue forecasting.']
  churn_risk_score decimal(5,2) [note: 'Predictive churn probability score (0-100) calculated at invoice generation time. Higher scores indicate greater likelihood of cancellation.']
  created_timestamp timestamp [note: 'Date and time when this invoice record was first created in the billing system. Audit field for record lifecycle tracking.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts on this invoice (e.g., USD, EUR, GBP).']
  due_date date [note: 'Date by which payment is expected from the subscriber. Calculated based on invoice date plus payment terms.']
  invoice_delivery_method varchar [note: 'Method by which the invoice is delivered to the subscriber. Determines communication channel and delivery tracking requirements.']
  paid_timestamp timestamp [note: 'Date and time when the invoice was fully paid by the subscriber. Null if invoice is unpaid or partially paid.']
  payment_gateway varchar [note: 'Name of the payment gateway or processor used for this invoice (e.g., Stripe, Adyen, Braintree). Used for reconciliation and troubleshooting.']
  posted_timestamp timestamp [note: 'Date and time when the invoice was posted (finalized and made available to subscriber). Marks transition from draft to official invoice.']
  promotional_discount_amount decimal(15,2) [note: 'Total discount amount applied from promotional campaigns, coupon codes, or special offers. Reduces the net amount due.']
  promotional_discount_code varchar [note: 'Coupon or promotion code applied to this invoice. Used for marketing campaign tracking and discount attribution analysis.']
  proration_amount decimal(15,2) [note: 'Adjustment amount for partial billing periods due to mid-cycle subscription changes, upgrades, downgrades, or cancellations. Can be positive or negative.']
  renewal_type varchar [note: 'Indicates whether this invoice represents an automatic renewal, manual renewal, trial-to-paid conversion, plan upgrade, or plan downgrade.']
  revenue_recognition_date date [note: 'Date on which revenue from this invoice was or will be recognized in financial statements per ASC 606 rules.']
  revenue_recognition_status varchar [note: 'Current status of revenue recognition for this invoice under ASC 606 accounting standards. Tracks whether revenue has been recognized in financial statements.']
  service_period_end_date date [note: 'Last date of the subscription service period covered by this invoice. Defines the performance obligation delivery window.']
  service_period_start_date date [note: 'First date of the subscription service period covered by this invoice. Critical for ASC 606 revenue recognition and proration calculations.']
  subscription_plan_name varchar [note: 'Name of the subscription plan being billed (e.g., Premium Monthly, Basic Annual, Sports Bundle). Identifies the service tier and feature set.']
  subscription_type varchar [note: 'Classification of subscription model: SVOD (Subscription Video On Demand), AVOD (Advertising-Supported Video On Demand), TVOD (Transactional Video On Demand), or bundled offering.']
  subtotal_amount decimal(15,2) [note: 'Base subscription charge amount before taxes, fees, discounts, and credits. Represents the gross recurring revenue component.']
  tax_amount decimal(15,2) [note: 'Total tax amount applied to this invoice based on subscriber location and applicable tax jurisdictions. Includes sales tax, VAT, GST as applicable.']
  total_amount decimal(15,2) [note: 'Final net amount due from subscriber after all charges, prorations, credits, discounts, and taxes. This is the amount the subscriber must pay.']
  trial_period_credit decimal(15,2) [note: 'Credit amount applied for free trial period. Typically offsets the full subscription charge during trial, resulting in zero net amount due.']
  updated_timestamp timestamp [note: 'Date and time when this invoice record was last modified. Audit field for change tracking and data lineage.']

  Note: 'Specialized invoice record for SVOD, AVOD, TVOD, and bundled subscription billing generated through Zuora. Extends the core invoice with subscription-specific attributes: subscription plan name, service period start/end, proration amount, trial period credit, promotional discount code, renewal type (auto-renew vs. manual), churn risk flag at time of billing, and Zuora invoice ID for system reconciliation. Supports ASC 606 revenue recognition for subscription revenue streams.'
}

Table billing.ad_billing_order {
  ad_billing_order_id varchar [pk, note: 'Unique identifier for the advertising billing order record. Primary key for this entity.']
  ad_order_id varchar [note: 'Foreign key linking to sales.ad_order. Business justification: Ad billing orders must link directly to source ad_order for order-to-invoice reconciliation, payment application, and revenue recognition. Critical for billing cycle processing and dispute resolution . FK namespace reconciled: advertising concept referencing sales domain entity']
  advertiser_id varchar [note: 'Reference to the advertiser organization that purchased the advertising inventory.']
  agency_partner_id varchar [note: 'Foreign key linking to partner.partner_partner. Business justification: Ad sales in broadcasting involve agency partners as intermediaries for commission splits, co-op advertising budgets, and consolidated billing. Agency relationship management requires partner domain li']
  billing_account_id varchar [note: 'Foreign key linking to billing.billing_account. Business justification: Ad billing order is billed to ONE billing account (advertiser or agency account). Advertisers and agencies have billing accounts in the billing domain. Need FK to link ad orders to their billing accou']
  broadcast_license_id varchar [note: 'Foreign key linking to compliance.broadcast_license. Business justification: Ad orders are sold against specific licensed stations. Revenue reporting, license renewal applications, and FCC ownership attribution rules require station-level revenue attribution for each order.']
  campaign_id varchar [note: 'Reference to the advertising campaign associated with this billing order.']
  content_episode_id varchar [note: 'Foreign key linking to content.content_episode. Business justification: Ad billing orders for spots aired within specific episodes (e.g., a 30-second spot in Episode 5 of a primetime series) must reference the episode for audience-based billing, Nielsen rating reconciliat']
  credit_memo_id varchar [note: 'Foreign key linking to billing.billing_dispute. Business justification: Ad billing order can have ONE formal billing dispute raised against it. Currently stores dispute_reason and dispute_date as STRING/DATE; need FK to the formal billing_dispute record for full dispute l']
  demographic_segment_id varchar [note: 'Foreign key linking to audience.demographic_segment. Business justification: Ad orders specify the guaranteed target demographic for pricing, rate card application, and delivery measurement. Determines CPM/CPRP rates and is contractually binding for makegood triggers. Core ele']
  nielsen_rating_id varchar [note: 'Foreign key linking to audience.nielsen_rating. Business justification: Ad orders reference expected Nielsen ratings for pricing and actual ratings for delivery verification. Drives makegood determination, billing adjustments, and advertiser reporting. Central to upfront/']
  political_ad_record_id varchar [note: 'Foreign key linking to compliance.political_ad_record. Business justification: FCC requires broadcasters to maintain public inspection files linking political ad orders to disclosure records (candidate name, rate, air dates). Essential for reasonable access and equal time compli']
  program_schedule_id varchar [note: 'Foreign key linking to scheduling.program_schedule. Business justification: Ad billing orders must reference program schedule context for daypart verification, audience delivery confirmation, and rate card validation. Critical for ad sales contract compliance and ensuring spo']
  sales_agency_id varchar [note: 'Reference to the advertising agency representing the advertiser, if applicable.']
  sweeps_period_id varchar [note: 'Foreign key linking to audience.sweeps_period. Business justification: Sweeps periods carry premium rate cards (sweeps_period.upfront_rate_card_applicable). Ad billing orders placed during sweeps are billed at premium rates. Direct link supports sweeps premium billing re']
  affidavit_status varchar [note: 'Status of proof-of-broadcast affidavit documentation for this order. Affidavits provide legal confirmation that contracted spots aired as scheduled.']
  billed_amount decimal(18,2) [note: 'Total amount invoiced to the advertiser or agency for this order, including any adjustments or makegoods.']
  billing_status varchar [note: 'Current status of the billing order in the revenue cycle. Tracks progression from unbilled inventory through invoicing, payment, and dispute resolution.']
  contracted_amount decimal(18,2) [note: 'Total contracted revenue amount for the advertising order as agreed in the sales contract, before any makegoods or adjustments.']
  cpm_rate decimal(10,2) [note: 'Cost per thousand impressions rate applied to this order, if CPM pricing is used.']
  created_timestamp timestamp [note: 'Timestamp when this billing order record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts in this billing order.']
  daypart_breakdown varchar [note: 'Distribution of advertising spots across broadcast dayparts (time segments of the broadcast day such as Prime Time, Early Morning, Late Night). Stored as structured text or JSON showing spot count and value per daypart.']
  flight_end_date date [note: 'The last date on which advertising spots for this order were scheduled to air. Defines the end of the campaign flight period.']
  flight_start_date date [note: 'The first date on which advertising spots for this order were scheduled to air. Defines the beginning of the campaign flight period.']
  grp_rate decimal(10,2) [note: 'Cost per gross rating point applied to this order, if GRP pricing is used.']
  isci_codes varchar [note: 'Comma-separated list of ISCI codes identifying the specific commercial creative assets that aired as part of this order. ISCI is the industry standard for uniquely identifying TV commercials.']
  makegoods_value decimal(18,2) [note: 'Total value of compensatory ad spots provided to the advertiser due to underdelivery, technical issues, or audience guarantee shortfalls.']
  notes varchar [note: 'Free-form text field for additional comments, special instructions, or contextual information about this billing order.']
  order_date date [note: 'The date on which the advertising order was placed or finalized in the traffic system.']
  outstanding_amount decimal(18,2) [note: 'Remaining unpaid balance on this billing order, calculated as billed amount minus paid amount.']
  paid_amount decimal(18,2) [note: 'Total amount received in payment from the advertiser or agency against this billing order.']
  payment_due_date date [note: 'Date by which payment is contractually due from the advertiser or agency.']
  payment_terms varchar [note: 'Contractual payment terms defining when payment is due (e.g., Net 30 = payment due 30 days after invoice date).']
  rate_basis varchar [note: 'Pricing model used for this advertising order. CPM (Cost Per Mille) = cost per thousand impressions, GRP (Gross Rating Point) = reach × frequency, CPRP (Cost Per Rating Point) = cost per single rating point, flat rate = fixed campaign price, cost per spot = per-unit pricing.']
  revenue_recognition_date date [note: 'Date on which revenue from this order is recognized in financial statements, per ASC 606 revenue recognition standards.']
  total_spots_aired varchar [note: 'Total number of advertising spots that successfully aired as confirmed by affidavits and playout logs.']
  total_spots_ordered varchar [note: 'Total number of advertising spots (commercial units) contracted in this order.']
  updated_timestamp timestamp [note: 'Timestamp when this billing order record was last modified.']
  wide_orbit_order_reference varchar [note: 'External order identifier from the Wide Orbit traffic and billing system. Business key linking this billing record to the source ad sales order.']

  Note: 'Advertising billing record derived from Wide Orbit traffic system representing a finalized ad sales order ready for invoicing. Captures Wide Orbit order ID, advertiser name, agency name, campaign flight dates, total contracted amount, makegoods value, affidavit status, ISCI codes for aired spots, daypart breakdown, CPM/GRP rate basis, and billing status (unbilled, invoiced, paid, disputed). Links advertising campaign execution to the financial billing process.'
}

Table billing.credit_memo {
  credit_memo_id varchar [pk, note: 'Unique identifier for the credit memo. Primary key for the credit memo entity.']
  ad_order_id varchar [note: 'Foreign key linking to sales.ad_order. Business justification: Makegoods, underdelivery credits, and preemption adjustments must trace to originating ad_order for accurate credit application, revenue reversal, and advertiser account reconciliation in advertising . FK namespace reconciled: advertising concept referencing sales domain entity']
  ad_order_line_id varchar [note: 'Foreign key linking to sales.ad_order_line. Business justification: Credit memos for preempted, under-delivered, or cancelled spots are issued at the order line level in media billing. The existing credit_memo links to ad_order and ad_spot but not ad_order_line, creat']
  billing_account_id varchar [note: 'Billing account or subscription account to which the credit is applied.']
  campaign_id varchar [note: 'Reference to the advertising campaign for which a makegood credit is being issued due to under-delivery. Null for non-advertising credits.']
  channel_id varchar [note: 'Foreign key linking to scheduling.channel. Business justification: Makegood credits must reference the makegood record for audit trail, revenue reversal tracking, and reconciliation of makegood obligations with actual delivery in advertising billing.. FK namespace reconciled: advertising concept referencing sales domain entity']
  content_episode_id varchar [note: 'Foreign key linking to content.content_episode. Business justification: Credit memos for episode-level billing adjustments (e.g., episode not aired as contracted, per-episode syndication fee reversal, episode delivery failure) must reference the specific episode. Episode-']
  partner_id varchar [note: 'Foreign key linking to partner.partner_partner. Business justification: Credits issued for partner disputes (makegood spots for under-delivery, SLA breach penalties, content delivery failures) require partner attribution for dispute resolution workflows, relationship heal']
  subscriber_id varchar [note: 'Identifier of the customer, advertiser, subscriber, or carriage partner receiving the credit.']
  applied_date date [note: 'Date the credit was actually applied to the customer account or invoice balance. Null if not yet applied.']
  approval_date date [note: 'Date the credit memo was approved by authorized personnel. Required for credits above threshold amounts.']
  bad_debt_write_off_flag boolean [note: 'Indicates whether this credit memo represents a bad debt write-off for an uncollectable balance. True for write-offs, false for other credit types.']
  collection_agency_name varchar [note: 'Name of the third-party collection agency to which the debt was referred, if applicable.']
  collection_agency_referral_flag boolean [note: 'Indicates whether the original debt was referred to a collection agency before write-off. Used for tracking recovery potential.']
  created_timestamp timestamp [note: 'Timestamp when the credit memo record was first created in the billing system.']
  credit_amount decimal(18,2) [note: 'Monetary value of the credit being issued, always positive. Represents the amount to be deducted from customer balance or written off.']
  credit_memo_number varchar [note: 'Externally-visible business identifier for the credit memo, used in customer communications and financial reporting. Typically follows format CM-YYYYMMDD-NNNN.']
  credit_memo_status varchar [note: 'Current lifecycle status of the credit memo in the approval and application workflow.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the credit amount (e.g., USD, GBP, EUR).']
  gl_account_code varchar [note: 'General ledger account code to which the credit or write-off is posted in SAP S/4HANA for financial reporting.']
  issue_date date [note: 'Date the credit memo was formally issued and became effective for accounting purposes.']
  makegood_spots_quantity varchar [note: 'Number of compensatory advertising spots to be provided as makegood for under-delivered campaigns. Null for non-makegood credits.']
  modified_timestamp timestamp [note: 'Timestamp when the credit memo record was last modified, for audit trail and change tracking.']
  net_credit_amount decimal(18,2) [note: 'Net credit amount after tax adjustments. Equals credit_amount minus tax_amount.']
  notes varchar [note: 'Additional internal notes, comments, or special instructions related to the credit memo processing and approval.']
  reason_code varchar [note: 'Business reason category for issuing the credit memo. Makegood refers to compensatory ad spots for under-delivered campaigns; billing_error for invoice corrections; service_outage for subscriber service credits; goodwill for customer retention; bad_debt_write_off for uncollectable balances.']
  reason_description varchar [note: 'Detailed narrative explanation of why the credit memo was issued, including specific circumstances, campaign details, or error descriptions.']
  recovery_amount decimal(18,2) [note: 'Amount subsequently recovered from a written-off debt through collection efforts or customer payment. Null if no recovery occurred.']
  recovery_date date [note: 'Date on which a previously written-off amount was recovered. Null if no recovery occurred.']
  revenue_recognition_impact varchar [note: 'Accounting period impact classification for revenue recognition under ASC 606. Indicates whether the credit affects current, prior, or future period revenue.']
  sap_document_number varchar [note: 'SAP S/4HANA financial document number for the credit memo posting, used for reconciliation and audit trail.']
  sap_posting_date date [note: 'Date the credit memo was posted to SAP S/4HANA general ledger for financial reporting.']
  tax_amount decimal(18,2) [note: 'Tax portion of the credit amount, if applicable. Used for tax reporting and reconciliation.']

  Note: 'Formal credit or write-off document issued to reduce, reverse, or write off a previously billed amount — covering makegoods for under-delivered ad campaigns, billing error corrections, subscriber service credits, carriage fee adjustments, and bad debt write-offs for uncollectable balances. Captures credit memo number, reason code (makegood, billing error, service outage, goodwill, bad_debt_write_off), original invoice reference, credit amount, currency, approval status, applied date, collection agency referral flag, recovery amount if subsequently collected, and SAP credit/bad-debt posting reference. SSOT for all billing credits, adjustments, and write-offs.'
}

Table billing.refund {
  refund_id varchar [pk, note: 'Unique identifier for the refund transaction. Primary key for the refund record.']
  ad_billing_order_id varchar [note: 'Foreign key linking to billing.ad_billing_order. Business justification: Advertising refunds (makegoods, overpayments, rate adjustments) in media broadcasting are issued against specific ad billing orders. refund.invoice_id links to the invoice level, but a direct refund →']
  ad_order_id varchar [note: 'Foreign key linking to sales.ad_order. Business justification: Refunds in ad billing are issued against specific ad orders (e.g., cancelled campaigns, overpayments). The refund product links to campaign but not directly to ad_order, creating a gap in order-level ']
  advertiser_id varchar [note: 'Foreign key linking to sales.advertiser. Business justification: Refunds are issued to advertisers; direct advertiser_id on refund enables advertiser-level refund reporting, AR aging analysis, and regulatory compliance for political advertiser refund disclosures wi']
  billing_account_id varchar [note: 'Reference to the billing account receiving the refund.']
  campaign_id varchar [note: 'Reference to the billing dispute record that triggered this refund, if the refund is the result of a resolved dispute.']
  credit_memo_id varchar [note: 'Foreign key linking to billing.credit_memo. Business justification: Refund can be triggered by ONE credit memo. Credit memos often result in refunds when the credit amount exceeds the outstanding balance. Need direct FK from refund to credit_memo (not just via billing']
  invoice_id varchar [note: 'Reference to the original invoice that this refund is associated with, if applicable.']
  payment_id varchar [note: 'Reference to the original payment transaction that is being refunded.']
  payment_method_id varchar [note: 'Foreign key linking to billing.payment_method. Business justification: Refund is issued to ONE payment method (refund destination). Currently stores payment_method_last_four as STRING; need FK to the stored payment_method record. Remove payment_method_last_four as it can']
  subscriber_id varchar [note: 'Reference to the subscriber who is receiving the refund.']
  amount decimal(18,2) [note: 'Gross monetary amount being refunded to the subscriber or account, before any adjustments or fees.']
  approval_timestamp timestamp [note: 'Date and time when the refund was approved for processing. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.']
  channel varchar [note: 'The channel or interface through which the refund was initiated (web portal, mobile app, call center, retail location, automated system, batch process).']
  created_timestamp timestamp [note: 'Date and time when this refund record was first created in the system. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the refund amount (e.g., USD, GBP, EUR).']
  expected_settlement_date date [note: 'Projected date when the refund is expected to be settled and funds returned to the subscriber. Format: yyyy-MM-dd.']
  fee decimal(18,2) [note: 'Any processing fee deducted from the refund amount, if applicable (e.g., payment gateway fees, administrative charges).']
  is_chargeback_related boolean [note: 'Boolean flag indicating whether this refund is related to a payment chargeback or dispute initiated by the subscriber through their financial institution.']
  is_partial_refund boolean [note: 'Boolean flag indicating whether this is a partial refund (true) or a full refund (false) of the original payment amount.']
  method varchar [note: 'The method by which the refund is being returned to the subscriber: back to original payment instrument, check, account credit, wire transfer, or other mechanism. [ENUM-REF-CANDIDATE: original_payment_method|credit_card|bank_transfer|check|account_credit|wire_transfer|paypal|other — 8 candidates stripped; promote to reference product]']
  net_refund_amount decimal(18,2) [note: 'Net monetary amount actually returned to the subscriber or account after deducting any processing fees (refund_amount - refund_fee).']
  notes varchar [note: 'Free-form text field for additional notes, comments, or context about the refund transaction, used by customer service and finance teams.']
  processing_date date [note: 'Date when the refund was submitted for payment processing. Format: yyyy-MM-dd.']
  reason_code varchar [note: 'Standardized code indicating the reason for the refund (e.g., CANCEL, DISPUTE, OVERPAY, SVCFAIL, GOODWILL).']
  reason_description varchar [note: 'Detailed narrative explanation of why the refund was issued, providing business context beyond the reason code.']
  refund_number varchar [note: 'Externally-visible business identifier for the refund, used in customer communications and financial reconciliation. Format: RFD-XXXXXXXXXX.']
  refund_status varchar [note: 'Current lifecycle status of the refund transaction in the processing workflow. [ENUM-REF-CANDIDATE: pending_approval|approved|processing|completed|failed|cancelled|reversed — 7 candidates stripped; promote to reference product]']
  refund_type varchar [note: 'Classification of the refund based on the revenue stream being reversed: subscription billing, advertising billing, carriage fee, syndication license fee, overpayment, or other.']
  request_date date [note: 'Date when the refund was originally requested by the subscriber or initiated by the system. Format: yyyy-MM-dd.']
  reversal_reason varchar [note: 'Explanation for why a completed refund was reversed or cancelled, if applicable.']
  sap_document_number varchar [note: 'SAP S/4HANA financial document number for the refund posting in the general ledger, used for financial reconciliation and audit trail.']
  sap_posting_date date [note: 'Date when the refund was posted to the SAP S/4HANA general ledger. Format: yyyy-MM-dd.']
  settlement_date date [note: 'Date when the refund funds were actually settled and returned to the subscriber or account. Format: yyyy-MM-dd.']
  updated_timestamp timestamp [note: 'Date and time when this refund record was last modified. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.']
  wideorbit_refund_reference varchar [note: 'External identifier from Wide Orbit traffic and billing system for refunds originating from advertising revenue, used for system integration and reconciliation.']
  zuora_refund_reference varchar [note: 'External identifier from Zuora subscription billing system for refunds originating from subscription revenue, used for system integration and reconciliation.']

  Note: 'Record of a monetary refund issued back to a subscriber or billing account following an overpayment, cancellation, or resolved dispute. Captures refund amount, currency, refund method (original payment method, check, account credit), refund reason, originating payment reference, approval status, processing date, settlement date, and SAP financial posting reference. Distinct from credit memos (which reduce invoice balances) — refunds represent actual cash outflows.'
}

Table billing.tax_record {
  tax_record_id varchar [pk, note: 'Unique identifier for the tax calculation and reporting record. Primary key for the tax_record product.']
  ad_billing_order_id varchar [note: 'Foreign key linking to billing.ad_billing_order. Business justification: Tax records for advertising transactions need to be directly associated with the ad billing order for regulatory reporting and Wide Orbit reconciliation. tax_record.invoice_id provides an indirect pat']
  credit_memo_id varchar [note: 'Foreign key linking to billing.credit_memo. Business justification: Tax record can apply to ONE credit memo (tax on credits or tax reversals). Credit memos have tax implications that need to be tracked separately from invoice tax. Need FK to credit_memo for tax compli']
  invoice_id varchar [note: 'Reference to the billing invoice transaction to which this tax record applies. Links tax calculation to the parent billing document.']
  invoice_line_id varchar [note: 'Foreign key linking to billing.invoice_line. Business justification: Tax record can be calculated at invoice line level (line-level tax calculation). Tax_record has tax_line_number suggesting line-level detail. Need FK to invoice_line for granular tax tracking and comp']
  license_agreement_id varchar [note: 'Foreign key linking to rights.license_agreement. Business justification: Withholding tax on royalty payments is governed by the license agreement\'s territory, governing law, and tax withholding classification. Tax compliance teams need this link to determine correct withho']
  payment_id varchar [note: 'Foreign key linking to billing.payment. Business justification: Tax record can be associated with ONE payment (tax withholding on payments, especially for international syndication payments). Need FK to payment for tax withholding tracking and compliance. No redun']
  regulatory_filing_id varchar [note: 'Foreign key linking to compliance.regulatory_filing. Business justification: Tax records for international syndication (withholding tax, VAT) may require regulatory filing references for cross-border compliance (e.g., IRS Form 1042, EU VAT MOSS filings). Links tax and regulato']
  regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: Tax records must track which regulatory obligation they fulfill (FCC regulatory fees, state sales tax mandates, VAT compliance). Finance teams need to map tax payments to specific regulatory requireme']
  created_timestamp timestamp [note: 'Timestamp when this tax record was first created in the system. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX. Used for audit trail and data lineage.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the taxable and tax amounts (e.g., USD, GBP, EUR, JPY).']
  customer_tax_classification varchar [note: 'Tax classification of the customer for determining applicable tax treatment. Business (B2B), Individual (B2C), Government, Non-Profit, Exempt Organization.']
  customer_tax_number varchar [note: 'The customer\'s tax identification number (TIN, VAT number, GST number, EIN, etc.) used for tax reporting and validation. Format varies by jurisdiction.']
  dispute_flag boolean [note: 'Indicates whether this tax record is under dispute with the tax authority or customer (True = disputed, False = not disputed).']
  dispute_reason varchar [note: 'Description of the reason for the tax dispute (e.g., Incorrect jurisdiction, Rate disagreement, Exemption certificate rejected, Nexus challenge). Populated when dispute_flag is True.']
  nexus_country varchar [note: 'Three-letter ISO 3166-1 alpha-3 country code where tax nexus is established (e.g., USA, GBR, FRA, CAN).']
  nexus_state_province varchar [note: 'State or province where the business has established tax nexus (physical or economic presence triggering tax obligation). Critical for US sales tax and Canadian GST/PST compliance.']
  notes varchar [note: 'Free-text field for additional context, special circumstances, manual adjustments, or audit notes related to this tax calculation.']
  remittance_date date [note: 'Date when the tax amount was remitted (paid) to the tax authority. Null if remittance_status is pending or disputed.']
  remittance_reference_number varchar [note: 'Payment reference or confirmation number from the tax authority acknowledging receipt of the tax remittance. Used for audit trail and reconciliation.']
  remittance_status varchar [note: 'Current status of tax payment to the tax authority. Pending (not yet paid), Remitted (paid in full), Partially Remitted (partial payment made), Disputed (under review or appeal), Waived (exempted or forgiven).']
  reverse_charge_flag boolean [note: 'Indicates whether the reverse charge mechanism applies (True = customer is responsible for self-assessing and remitting VAT/GST, False = supplier charges and remits tax). Common in EU cross-border B2B transactions.']
  source_system_tax_reference varchar [note: 'The unique identifier for this tax record in the source operational system. Enables traceability and reconciliation back to the originating system.']
  tax_amount decimal(18,2) [note: 'Calculated tax amount for this jurisdiction and tax type (taxable_amount × tax_rate). Denominated in the invoice currency.']
  tax_authority varchar [note: 'Name of the governmental tax authority responsible for collection and enforcement (e.g., IRS, HMRC, California Department of Tax and Fee Administration, Direction Générale des Finances Publiques).']
  tax_calculation_method varchar [note: 'Method used to calculate the tax amount. Automated (system-calculated), Manual (finance team entry), Third-Party Service (Avalara, Vertex, TaxJar), Override (manual adjustment to automated calculation).']
  tax_category varchar [note: 'Business categorization of the taxable item or service (e.g., Subscription Services, Advertising Services, Content Licensing, Equipment Rental, Digital Downloads). Used for tax rate determination and reporting segmentation.']
  tax_exemption_certificate_number varchar [note: 'Reference number of the tax exemption certificate on file, if applicable. Required for audit trail when exemption is claimed.']
  tax_exemption_flag boolean [note: 'Indicates whether a tax exemption was applied to this transaction (True = exemption applied, False = no exemption).']
  tax_exemption_reason varchar [note: 'Business reason or regulatory basis for the tax exemption (e.g., Non-profit organization, Government entity, Educational institution, Resale certificate, Export transaction).']
  tax_filing_due_date date [note: 'The statutory due date for filing the tax return that includes this transaction, based on the tax jurisdiction and filing period.']
  tax_filing_period varchar [note: 'The tax reporting period to which this transaction applies, formatted as YYYY-Q# for quarterly or YYYY-M## for monthly (e.g., 2024-Q1, 2024-M03). Aligns with jurisdiction-specific filing schedules.']
  tax_jurisdiction_code varchar [note: 'Code identifying the tax jurisdiction (country, state, province, county, or municipality) where the tax obligation arises. Format: ISO country code optionally followed by subdivision code (e.g., US-CA, GB, FR-75).']
  tax_jurisdiction_name varchar [note: 'Full name of the tax jurisdiction (e.g., California, United Kingdom, Paris) for human-readable reporting and compliance documentation.']
  tax_line_number varchar [note: 'Sequential line number for this tax record within the parent invoice, supporting multiple tax jurisdictions or tax types per invoice.']
  tax_point_date date [note: 'The date when the tax liability arises according to tax regulations (also known as time of supply). May differ from transaction_date based on jurisdiction-specific rules for services, advance payments, or continuous supplies.']
  tax_rate decimal(10,6) [note: 'Tax rate applied to the taxable amount, expressed as a decimal (e.g., 0.0825 for 8.25%). Supports precision to six decimal places for complex multi-jurisdictional calculations.']
  tax_treatment_code varchar [note: 'Internal or regulatory code defining the specific tax treatment applied (e.g., standard rate, reduced rate, zero-rated, exempt, out-of-scope). Maps to jurisdiction-specific tax rules.']
  tax_type varchar [note: 'Type of tax applied to the transaction. Sales Tax (US state/local), VAT (Value-Added Tax, EU/international), GST (Goods and Services Tax), Withholding Tax (international syndication/licensing), Excise Tax (specific content types), Use Tax (cross-border digital services).']
  taxable_amount decimal(18,2) [note: 'The portion of the invoice amount subject to taxation in this jurisdiction, after applying exemptions and exclusions. Denominated in the invoice currency.']
  third_party_tax_service varchar [note: 'Name of the external tax calculation service provider if third-party method was used (e.g., Avalara AvaTax, Vertex Cloud, TaxJar, Thomson Reuters ONESOURCE).']
  transaction_date date [note: 'The date of the underlying billing transaction that triggered the tax calculation. Used to determine applicable tax rates and rules in effect at the time of transaction.']
  updated_timestamp timestamp [note: 'Timestamp when this tax record was last modified. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX. Used for audit trail and change tracking.']

  Note: 'Tax calculation and reporting record associated with a billing transaction — capturing applicable tax jurisdiction, tax type (VAT, GST, sales tax, withholding tax), tax rate applied, taxable amount, tax amount, tax exemption certificate reference, nexus state/country, tax authority, filing period, and remittance status. Supports multi-jurisdiction tax compliance for subscriber billing (CCPA, GDPR jurisdictions) and international syndication license fee withholding.'
}

Table partner.acquisition_deal {
  acquisition_deal_id varchar [pk, note: 'Unique identifier for the content acquisition deal. Primary key for the acquisition deal entity.']
  billing_account_id varchar [note: 'Foreign key linking to billing.billing_account. Business justification: Acquisition deals for content rights often originate from identified sales opportunities when proactively pursuing content for the portfolio. Tracks deal pipeline from opportunity identification throu']
  broadcast_license_id varchar [note: 'Foreign key linking to compliance.broadcast_license. Business justification: Acquisition deals for broadcast distribution must verify licensed coverage matches contracted territories. Compliance officers cross-reference deal territories against FCC-licensed footprints to ensur']
  channel_id varchar [note: 'Foreign key linking to scheduling.channel. Business justification: Acquisition deals often specify target broadcast channels for content placement (e.g., primetime slot on flagship channel). Critical for content scheduling coordination, deal fulfillment tracking, and']
  compliance_content_rating_id varchar [note: 'Foreign key linking to compliance.content_rating. Business justification: Acquisition deals specify required content ratings (TV-MA, TV-14, PG, etc.) as contractual obligations. Buyers require sellers to deliver content with appropriate ratings for licensed territories and ']
  demographic_segment_id varchar [note: 'Foreign key linking to audience.demographic_segment. Business justification: Acquisition deals are evaluated and priced based on target demographic appeal of the content being acquired. Essential for content acquisition ROI analysis and portfolio strategy.']
  ott_platform_id varchar [note: 'Foreign key linking to distribution.ott_platform. Business justification: Acquisition deals for children\'s content (directed to kids under 13) require COPPA compliance declarations covering data collection on associated websites, apps, and interactive platforms. Contracts s']
  partner_id varchar [note: 'Reference to the studio, syndicator, or independent content provider from whom content is being acquired. Links to partner master data.']
  content_delivery_format varchar [note: 'Technical specifications for content delivery including file formats, resolution standards, and delivery methods (e.g., HD 1080p ProRes, 4K HEVC, physical media, digital file transfer).']
  content_package_scope varchar [note: 'Detailed description of the content included in this acquisition deal, including series titles, episode counts, seasons, or film packages.']
  contract_document_reference varchar [note: 'Reference identifier or file path to the executed contract document stored in the document management system.']
  contract_execution_date date [note: 'Date when the acquisition deal contract was formally signed and executed by all parties, marking the transition from negotiation to binding agreement.']
  created_timestamp timestamp [note: 'Timestamp when this acquisition deal record was first created in the system, supporting audit trail and data lineage requirements.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts in this acquisition deal (e.g., USD, GBP, EUR).']
  deal_effective_date date [note: 'Date when the acquisition deal terms become effective and rights begin to accrue, which may differ from execution date.']
  deal_expiration_date date [note: 'Date when the acquisition deal expires and rights revert to the content provider, marking the end of the license period.']
  deal_number varchar [note: 'Externally-known business identifier for the acquisition deal, typically formatted with prefix and sequential number for tracking and reference in contracts and communications.']
  deal_status varchar [note: 'Current lifecycle status of the acquisition deal from initial draft through negotiation, execution, and eventual expiration or termination. [ENUM-REF-CANDIDATE: draft|negotiation|legal_review|approved|executed|active|expired|terminated|cancelled — 9 candidates stripped; promote to reference product]']
  deal_title varchar [note: 'Human-readable name or title of the acquisition deal, typically reflecting the content package or series being acquired.']
  deal_type varchar [note: 'Classification of the deal structure indicating the financial arrangement: flat fee (fixed payment), revenue share (percentage of revenue), minimum guarantee (MG with upside), hybrid (combination), or barter (exchange of services/inventory).']
  deal_value_amount decimal(18,2) [note: 'Total monetary value of the acquisition deal in the specified currency, representing the gross commitment before adjustments.']
  distribution_rights varchar [note: 'Comma-separated list of distribution platforms and methods covered by this deal (e.g., linear, SVOD, AVOD, TVOD, FAST, syndication, VOD).']
  episode_count varchar [note: 'Total number of episodes included in the acquisition deal for episodic content such as television series.']
  exclusivity_flag boolean [note: 'Indicates whether the acquisition deal grants exclusive rights within the specified territory, preventing the content provider from licensing to competitors.']
  exclusivity_scope varchar [note: 'Detailed description of exclusivity terms, including platform restrictions, genre exclusivity, or time-based exclusivity windows.']
  holdback_period_days varchar [note: 'Number of days during which content must be withheld from certain distribution channels or platforms as part of windowing strategy or exclusivity terms.']
  last_modified_timestamp timestamp [note: 'Timestamp when this acquisition deal record was most recently updated, supporting audit trail and change tracking requirements.']
  license_term_months varchar [note: 'Duration of the content license in months, representing the period during which the broadcaster has rights to exploit the acquired content.']
  marketing_materials_included_flag boolean [note: 'Indicates whether the deal includes delivery of marketing and promotional materials such as trailers, key art, press kits, and promotional clips.']
  metadata_requirements varchar [note: 'Specifications for content metadata to be delivered with the content package, including descriptive, technical, and rights metadata standards.']
  minimum_guarantee_amount decimal(18,2) [note: 'Minimum guaranteed payment to the content provider regardless of performance, applicable for minimum guarantee and hybrid deal structures.']
  negotiation_start_date date [note: 'Date when formal negotiations for this acquisition deal commenced.']
  notes varchar [note: 'Free-form text field for additional notes, special terms, or contextual information about the acquisition deal not captured in structured fields.']
  payment_schedule varchar [note: 'Detailed schedule of payment milestones and amounts, including upfront payments, delivery payments, and ongoing royalty schedules.']
  performance_guarantees varchar [note: 'Contractual performance commitments such as minimum broadcast hours, promotional support, or audience delivery guarantees required by the content provider.']
  renewal_option_flag boolean [note: 'Indicates whether the broadcaster has the option to renew or extend the acquisition deal beyond the initial term.']
  renewal_terms varchar [note: 'Detailed terms governing deal renewal, including notice periods, pricing adjustments, and conditions for exercising renewal options.']
  revenue_share_percentage decimal(5,2) [note: 'Percentage of revenue shared with the content provider for revenue share and hybrid deal structures, typically applied after minimum guarantee recoupment.']
  sublicensing_allowed_flag boolean [note: 'Indicates whether the broadcaster is permitted to sublicense the acquired content to third parties such as MVPDs, vMVPDs, or international distributors.']
  sublicensing_terms varchar [note: 'Detailed terms and restrictions governing sublicensing rights, including revenue sharing with original content provider and territorial limitations.']
  territory_coverage varchar [note: 'Geographic territories or markets covered by this acquisition deal, specified as comma-separated ISO 3166-1 alpha-3 country codes or regional designations (e.g., USA, CAN, GBR, or NORTH_AMERICA).']
  total_runtime_hours decimal(10,2) [note: 'Aggregate runtime of all content included in the acquisition deal, measured in hours, used for inventory planning and scheduling.']
  windowing_strategy varchar [note: 'Sequential release strategy defining the order and timing of content availability across different platforms and distribution channels.']

  Note: 'Master record for content acquisition deals negotiated with studios, syndicators, and independent content providers. Captures deal structure (flat fee, revenue share, MG/minimum guarantee), content package scope, exclusivity terms, territory coverage, windowing strategy (SVOD, AVOD, TVOD, linear), and deal status through the full negotiation-to-execution lifecycle. Source of truth for content acquisition commitments feeding into the rights and finance domains.'
}

Table partner.acquisition_deal_line {
  acquisition_deal_line_id varchar [pk, note: 'Unique identifier for the acquisition deal line item. Primary key for this entity.']
  acquisition_deal_id varchar [note: 'Reference to the parent acquisition deal that contains this line item. Links this line to the master deal agreement.']
  compliance_content_rating_id varchar [note: 'Foreign key linking to compliance.content_rating. Business justification: Individual titles and episodes in acquisition deal lines have specific rating requirements for the licensed territory and platform. Compliance verification at the line-item level ensures each delivere']
  content_episode_id varchar [note: 'Foreign key linking to content.content_episode. Business justification: Episode-level licensing is common in broadcast acquisitions (e.g., licensing specific pilot or finale episodes separately). Linking deal lines to episodes enables episode-level rights clearance, per-e']
  content_title_id varchar [note: 'Reference to the specific content title, episode, season, or package being acquired in this line item.']
  season_id varchar [note: 'Foreign key linking to content.season. Business justification: Deal lines are scoped to specific seasons in multi-season acquisitions. Season-level line items are required for per-season license fee invoicing, delivery obligation generation, and rights window man']
  series_id varchar [note: 'Foreign key linking to content.series. Business justification: Individual deal line items frequently reference a series (e.g., \'Series X — all episodes, all territories\'). Series-level line items drive per-series license fee allocation, rights clearance verificat']
  talent_profile_id varchar [note: 'Foreign key linking to talent.talent_profile. Business justification: Content acquisition deals often include attached talent as a key deal point—star power drives content valuation and marketing strategy. Essential for deal valuation models, marketing rights clearance,']
  content_rating varchar [note: 'Age or content rating classification for this content line item (e.g., G, PG, PG-13, R, TV-Y, TV-PG, TV-14, TV-MA). Determines broadcast daypart and audience targeting.']
  content_type varchar [note: 'Classification of the content being acquired in this line item. Determines rights structure and windowing strategy. [ENUM-REF-CANDIDATE: film|series|season|episode|documentary|special|sports_event|news_package|music_video|short_form — 10 candidates stripped; promote to reference product]']
  created_by_user varchar [note: 'Username or identifier of the user who created this acquisition deal line record. Supports audit and accountability.']
  created_timestamp timestamp [note: 'Timestamp when this acquisition deal line record was first created in the system. Audit trail for data lineage.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts in this line item.']
  delivery_due_date date [note: 'The date by which the content provider must deliver the content asset for this line item. Critical for production scheduling and playout planning.']
  delivery_format varchar [note: 'Technical format and delivery method for the content asset associated with this line item. Determines ingest and playout requirements. [ENUM-REF-CANDIDATE: hd|4k|sd|film|digital_file|tape|satellite|ftp|aspera|physical_media — 10 candidates stripped; promote to reference product]']
  delivery_status varchar [note: 'Current status of content delivery for this line item. Tracks the fulfillment lifecycle from order to ingest.']
  distribution_rights varchar [note: 'Comma-separated list of distribution rights granted for this content line item. May include linear, VOD, SVOD, AVOD, TVOD, theatrical, home video, digital download, streaming, broadcast, cable, satellite, OTT, FAST, syndication, etc. [ENUM-REF-CANDIDATE: promote to reference product and junction table for complex rights matrices]']
  dubbing_languages varchar [note: 'Comma-separated list of ISO 639 language codes for dubbed audio tracks included with this content line item. Supports multi-territory distribution.']
  eidr_identifier varchar [note: 'Unique EIDR identifier for the content in this line item. Global standard for audiovisual content identification.']
  episode_count varchar [note: 'Number of episodes included in this line item if the content type is series or season. Null for single-title content.']
  exclusivity_flag boolean [note: 'Indicates whether the rights granted for this line item are exclusive (true) or non-exclusive (false). Impacts windowing and competitive distribution.']
  genre_primary varchar [note: 'Primary genre classification for the content in this line item. Used for programming strategy and audience analytics.']
  holdback_restrictions varchar [note: 'Description of any holdback periods or exclusivity restrictions that limit when or how this content can be exploited. Includes blackout periods and sequential windowing constraints.']
  language_code varchar [note: 'Primary language of the content in this line item. ISO 639 two or three-letter language code.']
  license_duration_months varchar [note: 'Total duration of the license term expressed in months. Calculated from start and end dates for reporting and windowing analysis.']
  license_fee_amount decimal(18,2) [note: 'The base license fee amount for this specific content line item. Represents the core acquisition cost before adjustments.']
  license_term_end_date date [note: 'The date when the license rights for this content line item expire. Marks the end of the rights window.']
  license_term_start_date date [note: 'The date when the license rights for this content line item become effective. Marks the beginning of the rights window.']
  line_number varchar [note: 'Sequential line number within the parent acquisition deal. Used for ordering and referencing specific line items within the deal.']
  line_status varchar [note: 'Current lifecycle status of this acquisition deal line item. Tracks progression from negotiation through fulfillment and expiration.']
  minimum_guarantee_amount decimal(18,2) [note: 'Minimum guarantee payment amount for this line item. Represents the floor payment regardless of performance or usage.']
  modified_by_user varchar [note: 'Username or identifier of the user who last modified this acquisition deal line record. Supports audit and accountability.']
  modified_timestamp timestamp [note: 'Timestamp when this acquisition deal line record was last modified. Audit trail for change tracking.']
  notes varchar [note: 'Free-text notes or comments related to this acquisition deal line item. Captures special terms, exceptions, or operational instructions.']
  payment_schedule varchar [note: 'Payment structure for this line item. Defines when and how license fees and guarantees are paid to the content provider.']
  payment_terms_days varchar [note: 'Number of days from invoice or delivery milestone until payment is due for this line item. Standard commercial payment terms.']
  production_year varchar [note: 'Year the content was originally produced or released. Used for catalog management and rights valuation.']
  royalty_rate_percent decimal(5,2) [note: 'Percentage rate for revenue-sharing or usage-based royalty payments on this content line item. Applied to calculate residuals beyond minimum guarantee.']
  runs_allowed varchar [note: 'Maximum number of broadcast or exhibition runs permitted for this content line item during the license term. Null indicates unlimited runs.']
  runtime_minutes varchar [note: 'Total runtime duration in minutes for the content in this line item. Used for scheduling and inventory management.']
  subtitle_languages varchar [note: 'Comma-separated list of ISO 639 language codes for subtitles or closed captions included with this content line item. Supports accessibility and localization requirements.']
  territory_code varchar [note: 'Geographic territory or market where rights are granted for this content line item. May be country code, region code, or multi-territory identifier. [ENUM-REF-CANDIDATE: promote to reference product for complex territory hierarchies]']

  Note: 'Individual line items within a content acquisition deal, each representing a specific title, episode, season, or content package with its own financial terms, window schedule, territory rights, and delivery obligations. Enables granular tracking of per-title economics within a multi-title deal and feeds rights windowing and royalty calculation processes.'
}

Table partner.distribution_agreement {
  distribution_agreement_id varchar [pk, note: 'Unique identifier for the distribution agreement. Primary key.']
  billing_account_id varchar [note: 'Foreign key linking to billing.billing_account. Business justification: Distribution agreements with MVPDs/cable operators require billing accounts to invoice monthly carriage fees, track retransmission consent payments, and manage receivables. Essential for carriage fee ']
  broadcast_license_id varchar [note: 'Foreign key linking to compliance.broadcast_license. Business justification: Distribution agreements for linear broadcast channels reference specific licensed facilities. Retransmission consent agreements, carriage deals, and network distribution contracts all specify call sig']
  channel_id varchar [note: 'Foreign key linking to scheduling.channel. Business justification: Distribution agreements specify which channels carry content (e.g., cable carriage agreements, affiliate distribution). Fundamental to carriage fee calculation, must-carry compliance, channel position']
  ott_platform_id varchar [note: 'Foreign key linking to distribution.ott_platform. Business justification: Distribution agreements in the streaming era are platform-specific, governing rights for a particular OTT platform. Business affairs and platform operations teams must link distribution_agreements to ']
  partner_id varchar [note: 'Reference to the distribution partner (MVPD, vMVPD, cable operator, satellite provider, OTT aggregator) that is party to this agreement.']
  agreement_number varchar [note: 'Externally-known business identifier for the distribution agreement, used in contracts and communications with distribution partners.']
  agreement_status varchar [note: 'Current lifecycle status of the distribution agreement indicating its operational state. [ENUM-REF-CANDIDATE: draft|negotiation|active|suspended|terminated|expired|renewal_pending — 7 candidates stripped; promote to reference product]']
  agreement_type varchar [note: 'Classification of the distribution agreement based on the nature of the relationship and regulatory framework (e.g., carriage, retransmission consent, must-carry, syndication, OTT distribution, affiliate).']
  approval_date date [note: 'Date when the distribution agreement received final internal approval before execution.']
  approved_by varchar [note: 'Name or identifier of the executive who provided final approval for this distribution agreement.']
  audit_rights_included boolean [note: 'Indicates whether Media Broadcasting retains the right to audit the distributors subscriber counts, revenue reports, and compliance with agreement terms.']
  blackout_restrictions varchar [note: 'Description of geographic or content-based blackout restrictions that apply to this distribution agreement (e.g., sports blackouts, regional exclusions).']
  carriage_fee_amount decimal(15,2) [note: 'Base carriage fee amount per the agreement structure. Interpretation depends on carriage_fee_structure (e.g., per-subscriber monthly rate, annual flat fee).']
  carriage_fee_structure varchar [note: 'Pricing model for carriage fees paid by the distributor to Media Broadcasting (per-subscriber, flat rate, tiered, revenue share, hybrid).']
  channel_positioning_tier varchar [note: 'Service tier or package level where the channels must be positioned in the distributors lineup (basic, expanded basic, digital, premium, sports tier, custom).']
  channels_included varchar [note: 'List or description of Media Broadcasting channels covered by this distribution agreement (e.g., primary network, secondary channels, HD feeds, regional variants).']
  contract_document_url varchar [note: 'URL or file path to the signed distribution agreement contract document stored in the document management system.']
  created_timestamp timestamp [note: 'Timestamp when this distribution agreement record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts in this agreement.']
  effective_date date [note: 'Date when the distribution agreement becomes legally binding and operational.']
  expiration_date date [note: 'Date when the distribution agreement terminates or expires. Nullable for evergreen agreements.']
  last_modified_timestamp timestamp [note: 'Timestamp when this distribution agreement record was last updated in the system.']
  minimum_guarantee_amount decimal(15,2) [note: 'Minimum guaranteed payment amount from the distributor over the agreement term, regardless of actual subscriber counts or usage.']
  must_carry_obligation boolean [note: 'Indicates whether this agreement includes must-carry obligations under FCC regulations requiring the distributor to carry the broadcast signal.']
  negotiated_by varchar [note: 'Name or identifier of the Media Broadcasting executive or team responsible for negotiating this distribution agreement.']
  payment_terms_days varchar [note: 'Number of days from invoice date within which the distributor must remit carriage fees to Media Broadcasting.']
  renewal_terms varchar [note: 'Description of renewal terms including automatic renewal provisions, notice periods, and renegotiation triggers.']
  reporting_frequency varchar [note: 'Frequency at which the distributor must provide subscriber counts, viewership data, and revenue reports to Media Broadcasting.']
  retransmission_consent_granted boolean [note: 'Indicates whether Media Broadcasting has granted retransmission consent allowing the distributor to rebroadcast the signal.']
  sla_response_time_hours varchar [note: 'Maximum response time in hours for addressing service disruptions or technical issues under the SLA.']
  sla_uptime_percentage decimal(5,2) [note: 'Minimum uptime percentage guaranteed under the Service Level Agreement (SLA) for signal delivery and availability.']
  streaming_rights_included boolean [note: 'Indicates whether the agreement includes rights for the distributor to offer live streaming or simulcast of Media Broadcasting channels via OTT platforms.']
  svod_rights_included boolean [note: 'Indicates whether the agreement includes rights for the distributor to offer Subscription Video On Demand (SVOD) access as part of a subscription package.']
  termination_date date [note: 'Actual date when the agreement was terminated, if applicable. Nullable for active agreements.']
  termination_notice_days varchar [note: 'Number of days advance notice required by either party to terminate the agreement prior to expiration.']
  termination_reason varchar [note: 'Reason for early termination of the agreement, if applicable (e.g., breach of contract, mutual agreement, business closure).']
  territory varchar [note: 'Geographic territory or market covered by this distribution agreement. May include country codes, DMA codes, or regional descriptors.']
  tvod_rights_included boolean [note: 'Indicates whether the agreement includes rights for the distributor to offer Transactional Video On Demand (TVOD) access where viewers pay per transaction.']
  vod_rights_included boolean [note: 'Indicates whether the agreement includes rights for the distributor to offer Video On Demand (VOD) access to Media Broadcasting content.']
  vod_window_days varchar [note: 'Number of days that content remains available in the distributors VOD library after initial broadcast, if VOD rights are included.']

  Note: 'Formal distribution agreements with MVPDs, vMVPDs, cable operators, satellite providers, and OTT aggregators governing carriage of Media Broadcasting channels and content. Tracks carriage fee structures, must-carry obligations, retransmission consent terms, blackout restrictions, channel positioning commitments, and SLA obligations. Distinct from content acquisition deals — this governs outbound distribution rather than inbound content.'
}

Table partner.syndication_agreement {
  syndication_agreement_id varchar [pk, note: 'Unique identifier for the syndication agreement. Primary key.']
  billing_account_id varchar [note: 'Foreign key linking to billing.billing_account. Business justification: Syndication agreements for selling content distribution rights originate from sales opportunities when the sales team identifies potential syndication partners. Links the sales pipeline to executed sy']
  broadcast_license_id varchar [note: 'Foreign key linking to compliance.broadcast_license. Business justification: Syndication agreements for broadcast distribution require the syndicating station to hold valid FCC licenses covering the agreed territories. Clearance obligations and territorial exclusivity are defi']
  channel_id varchar [note: 'Foreign key linking to scheduling.channel. Business justification: Syndication deals specify broadcast channels for content airing (e.g., off-network syndication to local stations). Essential for syndication scheduling, clearance tracking, run limit enforcement, and ']
  regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: Syndication agreements grant rights to specific markets/DMAs. Essential for syndication clearance tracking and ensuring syndication partners broadcast only in contracted markets.']
  season_id varchar [note: 'Foreign key linking to content.season. Business justification: Syndication deals frequently cover specific seasons (e.g., \'Seasons 1–3 only\'). Season-level syndication tracking drives per-season royalty calculations, run-limit enforcement, and holdback window man']
  syndication_partner_id varchar [note: 'Reference to the third-party broadcaster, regional station, or international network acquiring syndication rights.']
  talent_profile_id varchar [note: 'Foreign key linking to talent.talent_profile. Business justification: Syndication deals may require talent consent/clearance for promotional use and residual payment routing, especially for above-the-line talent with approval rights. Essential for talent clearance workf']
  agreement_number varchar [note: 'Externally-known business identifier for the syndication agreement, used in contracts and communications with syndication partners.']
  agreement_status varchar [note: 'Current lifecycle status of the syndication agreement. [ENUM-REF-CANDIDATE: draft|negotiation|pending_approval|active|suspended|terminated|expired — 7 candidates stripped; promote to reference product]']
  agreement_type varchar [note: 'Classification of the syndication agreement based on geographic scope and compensation structure.']
  audit_rights_flag boolean [note: 'Indicates whether Media Broadcasting retains the right to audit the syndication partner\'s broadcast logs and financial records.']
  barter_spot_count varchar [note: 'Number of advertising spots retained by Media Broadcasting per episode in barter syndication arrangements.']
  broadcast_standard varchar [note: 'Technical broadcast standard required for content delivery in the syndication territory.']
  clearance_obligation varchar [note: 'Party responsible for obtaining broadcast clearances and rights verification in the syndication territory.']
  created_timestamp timestamp [note: 'Timestamp when this syndication agreement record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts in this agreement.']
  delivery_format varchar [note: 'Technical format and specifications for content delivery to the syndication partner (e.g., HD 1080p, 4K, file-based, tape).']
  effective_end_date date [note: 'Date when the syndication agreement expires and content rights revert. Nullable for open-ended agreements subject to termination clauses.']
  effective_start_date date [note: 'Date when the syndication agreement becomes binding and content rights become available for syndication.']
  episode_count varchar [note: 'Total number of episodes included in the syndication agreement. Applicable for series content.']
  exclusivity_flag boolean [note: 'Indicates whether the syndication partner has exclusive broadcast rights in the granted territory during the agreement period.']
  exclusivity_window_end_date date [note: 'End date of the exclusivity period. Nullable if exclusivity_flag is false.']
  exclusivity_window_start_date date [note: 'Start date of the exclusivity period during which no other syndication partner may broadcast the content in the granted territory. Nullable if exclusivity_flag is false.']
  flat_fee_amount decimal(15,2) [note: 'Total flat fee amount for the entire syndication agreement. Applicable when syndication_fee_structure is flat_fee or hybrid.']
  holdback_period_days varchar [note: 'Number of days after original broadcast during which content cannot be syndicated, protecting the original broadcast window.']
  last_modified_timestamp timestamp [note: 'Timestamp when this syndication agreement record was last updated.']
  minimum_guarantee_amount decimal(15,2) [note: 'Minimum guaranteed payment amount regardless of actual revenue or performance. Applicable in revenue-share agreements.']
  notes varchar [note: 'Free-form notes capturing special terms, amendments, or contextual information about the syndication agreement.']
  payment_terms varchar [note: 'Detailed payment schedule and terms, including milestones, installments, and due dates.']
  per_episode_fee_amount decimal(15,2) [note: 'Fee amount charged per episode. Applicable when syndication_fee_structure is per_episode or hybrid.']
  performance_guarantee varchar [note: 'Minimum performance commitments required from the syndication partner, such as minimum broadcast frequency or audience reach targets.']
  renewal_notice_days varchar [note: 'Number of days prior to expiration that the syndication partner must provide notice to exercise renewal option.']
  renewal_option_flag boolean [note: 'Indicates whether the syndication partner has an option to renew the agreement upon expiration.']
  reporting_frequency varchar [note: 'Frequency at which the syndication partner must provide broadcast logs, audience metrics, and revenue reports.']
  revenue_share_percentage decimal(5,2) [note: 'Percentage of advertising or subscription revenue shared with Media Broadcasting. Applicable when syndication_fee_structure is revenue_share or hybrid.']
  run_limit varchar [note: 'Maximum number of times each episode may be broadcast by the syndication partner during the agreement term.']
  signed_date date [note: 'Date when the syndication agreement was executed by all parties.']
  syndication_fee_structure varchar [note: 'Compensation model governing how the syndication partner pays for content rights.']
  termination_clause varchar [note: 'Conditions and procedures under which either party may terminate the agreement prior to the effective end date.']
  territory_grant varchar [note: 'Geographic territories where the syndication partner is granted broadcast rights. Pipe-separated list of ISO 3166-1 alpha-3 country codes or regional designations. [ENUM-REF-CANDIDATE: USA|CAN|GBR|AUS|DEU|FRA|JPN|BRA|MEX|IND|CHN — promote to reference product]']

  Note: 'Agreements governing the syndication of Media Broadcasting content to third-party broadcasters, regional stations, and international networks. Captures syndication fee structure, exclusivity windows, holdback periods, territory grants, episode count, run limitations, and clearance obligations. Feeds the scheduling and rights domains for cleared content availability.'
}

Table partner.coproduction_agreement {
  coproduction_agreement_id varchar [pk, note: 'Unique identifier for the co-production agreement record. Primary key.']
  billing_account_id varchar [note: 'Foreign key linking to billing.billing_account. Business justification: Co-production partners need billing accounts to track investment contributions, cost-sharing invoices, and revenue distribution settlements. Critical for partner investment invoicing and profit-sharin']
  compliance_content_rating_id varchar [note: 'Foreign key linking to compliance.content_rating. Business justification: Co-production agreements allocate responsibility for obtaining content ratings in different territories (MPAA for US theatrical, TV Parental Guidelines for US broadcast, BBFC for UK, etc.). Partners m']
  lead_talent_profile_id varchar [note: 'Foreign key linking to talent.talent_profile. Business justification: Co-production agreements frequently specify lead talent (star, showrunner, director) as part of the deal structure—attached talent drives financing approval and production greenlight decisions. Critic']
  ott_platform_id varchar [note: 'Foreign key linking to distribution.ott_platform. Business justification: Co-productions targeting children must allocate COPPA compliance responsibilities between production partners, especially for digital/interactive components, companion apps, and online games. Agreemen']
  production_project_id varchar [note: 'Foreign key linking to production.project. Business justification: Co-production agreements directly reference the production project being co-financed and co-produced. Linking enables tracking budget contributions, IP ownership splits, delivery obligations, and fina']
  regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: Coproduction agreements must comply with content regulations, labor laws, cross-border production rules, and local content quotas. Compliance teams track regulatory obligations per coproduction to ens']
  release_window_id varchar [note: 'Foreign key linking to distribution.release_window. Business justification: Co-production agreements define distribution window strategies for co-produced content (e.g., theatrical first, then SVOD). Business affairs teams must link coproduction_agreements to release_windows ']
  agreement_number varchar [note: 'Externally-known business identifier for the co-production agreement, used in contracts and communications.']
  agreement_status varchar [note: 'Current lifecycle status of the co-production agreement. [ENUM-REF-CANDIDATE: draft|negotiation|active|suspended|completed|terminated|expired — 7 candidates stripped; promote to reference product]']
  agreement_type varchar [note: 'Classification of the co-production agreement based on the number and nature of participating parties.']
  amendment_count varchar [note: 'Number of formal amendments made to the original co-production agreement.']
  approval_authority varchar [note: 'Designation of which partner or committee has final approval authority over key creative and business decisions.']
  audit_rights varchar [note: 'Provisions allowing partners to audit financial records and production accounts related to the co-production.']
  budget_currency_code varchar [note: 'Three-letter ISO currency code for the total budget amount.']
  confidentiality_terms varchar [note: 'Non-disclosure obligations and confidentiality requirements binding all co-production partners.']
  created_timestamp timestamp [note: 'Timestamp when this co-production agreement record was first created in the system.']
  creative_control_level varchar [note: 'Degree of creative decision-making authority held by our organization in the production process.']
  credit_obligation varchar [note: 'Contractual requirements for on-screen and promotional credits for each co-production partner.']
  delivery_date date [note: 'Contractual date by which the completed content must be delivered to all co-production partners.']
  dispute_resolution_method varchar [note: 'Agreed-upon mechanism for resolving disputes between co-production partners.']
  distribution_rights_allocation varchar [note: 'Description of how distribution rights are divided among co-production partners by territory and platform.']
  effective_date date [note: 'Date when the co-production agreement becomes legally binding and operational.']
  expiration_date date [note: 'Date when the co-production agreement terminates or expires. Nullable for open-ended agreements.']
  force_majeure_provision varchar [note: 'Contractual terms addressing obligations and liabilities in the event of unforeseeable circumstances preventing performance.']
  governing_law_jurisdiction varchar [note: 'Legal jurisdiction whose laws govern the interpretation and enforcement of the co-production agreement.']
  insurance_requirements varchar [note: 'Mandatory insurance coverage types and amounts required for the co-production.']
  last_amendment_date date [note: 'Date of the most recent amendment to the co-production agreement.']
  notes varchar [note: 'Additional comments, special provisions, or contextual information about the co-production agreement.']
  our_investment_amount decimal(18,2) [note: 'Financial contribution amount committed by our organization to the co-production.']
  our_investment_percentage decimal(5,2) [note: 'Percentage of total production budget contributed by our organization.']
  our_ip_ownership_percentage decimal(5,2) [note: 'Percentage of intellectual property rights owned by our organization in the co-produced content.']
  our_primary_territory varchar [note: 'Geographic territory or territories where our organization holds primary distribution rights.']
  production_end_date date [note: 'Scheduled or actual date when principal photography or production activities are completed.']
  production_start_date date [note: 'Scheduled or actual date when principal photography or production activities commence.']
  production_type varchar [note: 'Category of content being co-produced (film, television series, documentary, etc.).']
  residuals_sharing_formula varchar [note: 'Formula or methodology for distributing residual payments to talent among co-production partners.']
  revenue_sharing_model varchar [note: 'Methodology for distributing revenues generated from the co-produced content among partners.']
  signed_date date [note: 'Date when all parties executed the co-production agreement.']
  termination_clause varchar [note: 'Conditions and procedures under which the co-production agreement may be terminated by any party.']
  total_budget_amount decimal(18,2) [note: 'Total production budget for the co-produced content across all partners.']
  updated_timestamp timestamp [note: 'Timestamp when this co-production agreement record was last modified in the system.']

  Note: 'Co-production arrangements with studios, production houses, and international broadcasters for jointly financed and produced content. Tracks co-production budget splits, creative control provisions, IP ownership percentages, territorial distribution rights allocation, credit obligations, and residuals sharing. Bridges the partner, production, and rights domains.'
}

Table partner.affiliate_agreement {
  affiliate_agreement_id varchar [pk, note: 'Unique identifier for the affiliate agreement record. Primary key.']
  affiliate_station_partner_id varchar [note: 'Foreign key linking to partner.partner_partner. Business justification: affiliate_agreement.affiliate_station_id represents the affiliate station partner. Renaming to affiliate_station_partner_id for clarity (ends with partner_partner_partner_id pattern). Links to partner']
  billing_account_id varchar [note: 'Foreign key linking to billing.billing_account. Business justification: Network-affiliate relationships require billing accounts for monthly affiliation fee invoicing, network compensation payments, and retransmission revenue share settlements. Core business process for a']
  broadcast_license_id varchar [note: 'Foreign key linking to compliance.broadcast_license. Business justification: Network-affiliate agreements are fundamentally tied to the affiliate station\'s FCC broadcast license. The agreement references the station\'s call sign, facility ID, licensed market (DMA), and coverage']
  delivery_channel_id varchar [note: 'Foreign key linking to distribution.delivery_channel. Business justification: Affiliate agreements specify the delivery channel through which the network feeds programming to affiliate stations. Technical operations and affiliate relations teams must link each affiliate_agreeme']
  primary_affiliate_station_channel_id varchar [note: 'Reference to the local broadcast station or regional affiliate partner that is party to this agreement.']
  regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: Affiliate agreements are market-specific; each affiliate station serves a specific DMA. Essential for network-affiliate relationship management and ensuring proper market coverage. Removes denormalize']
  affiliation_fee_amount decimal(15,2) [note: 'Monthly or annual fee paid by the network to the affiliate station for carrying network programming, or reverse compensation paid by affiliate to network. Negative values indicate reverse compensation.']
  affiliation_fee_currency varchar [note: 'Three-letter ISO 4217 currency code for the affiliation fee amount (e.g., USD, CAD, GBP).']
  affiliation_fee_frequency varchar [note: 'Frequency at which affiliation fees are calculated and paid between network and affiliate.']
  agreement_number varchar [note: 'Externally-known unique business identifier for the affiliate agreement, used in contracts, invoicing, and legal correspondence.']
  agreement_status varchar [note: 'Current lifecycle status of the affiliate agreement indicating its operational state and enforceability. [ENUM-REF-CANDIDATE: draft|pending_approval|active|suspended|terminated|expired|renewed — 7 candidates stripped; promote to reference product]']
  agreement_type varchar [note: 'Classification of the affiliate relationship: primary affiliation (main channel), secondary affiliation, multicast channel, digital subchannel, network-owned station, or independent affiliate.']
  auto_renewal_flag boolean [note: 'Indicates whether the agreement automatically renews at expiration unless either party provides notice of non-renewal.']
  created_timestamp timestamp [note: 'Timestamp when this affiliate agreement record was first created in the system.']
  digital_rights_included_flag boolean [note: 'Indicates whether the affiliate agreement includes rights to distribute network content via digital platforms, streaming services, and Over-The-Top (OTT) channels.']
  dispute_resolution_method varchar [note: 'Contractually agreed method for resolving disputes between network and affiliate: litigation, binding arbitration, mediation, or good-faith negotiation.']
  effective_date date [note: 'Date on which the affiliate agreement becomes legally binding and operational obligations commence.']
  exclusivity_flag boolean [note: 'Indicates whether the affiliate has exclusive rights to broadcast network programming within its designated territory, preventing the network from contracting with competing stations in the same market.']
  exclusivity_territory varchar [note: 'Geographic territory within which the affiliate has exclusive rights to broadcast network programming, typically defined by DMA boundaries, county lists, or signal contours.']
  expiration_date date [note: 'Date on which the affiliate agreement terminates unless renewed or extended. Nullable for evergreen agreements.']
  governing_law_jurisdiction varchar [note: 'Legal jurisdiction and governing law that applies to the interpretation and enforcement of the affiliate agreement (e.g., State of New York, State of California).']
  last_modified_timestamp timestamp [note: 'Timestamp when this affiliate agreement record was most recently updated or amended.']
  local_ad_avails_minutes_per_hour decimal(4,2) [note: 'Number of minutes per hour of network programming that the affiliate may use for local advertising insertion, typically 2-4 minutes per hour.']
  local_insertion_rights_flag boolean [note: 'Indicates whether the affiliate has the right to insert local advertising spots during designated network programming breaks (ad pods).']
  minimum_clearance_percentage decimal(5,2) [note: 'Minimum percentage of network programming hours that the affiliate is contractually obligated to broadcast, typically 85-95% for primary affiliates. Expressed as percentage (e.g., 90.00 for 90%).']
  must_air_programming_hours decimal(6,2) [note: 'Minimum number of weekly hours of network programming that the affiliate must broadcast without preemption, including prime-time, news, and sports.']
  network_compensation_model varchar [note: 'Economic model governing compensation flow between network and affiliate: fixed fee paid to affiliate, revenue share from advertising, audience-based payments, hybrid model, or reverse compensation where affiliate pays network.']
  performance_measurement_methodology varchar [note: 'Audience measurement methodology used to assess affiliate performance against contractual standards (Nielsen ratings, Comscore, proprietary measurement, or multi-source approach).']
  performance_standard_grp_minimum decimal(8,2) [note: 'Minimum Gross Rating Points (GRP) that the affiliate must deliver for network programming to meet performance standards and avoid penalties or compensation adjustments.']
  preemption_notice_hours varchar [note: 'Minimum number of hours advance notice the affiliate must provide to the network before preempting scheduled programming, typically 24-72 hours except for breaking news.']
  preemption_rights varchar [note: 'Extent to which the affiliate may preempt scheduled network programming for local content, special events, or breaking news. Preemption typically requires advance notice and makegoods.']
  renewal_notice_days varchar [note: 'Number of days prior to expiration that either party must provide written notice of intent to terminate or renegotiate, typically 90 to 180 days.']
  retransmission_consent_included_flag boolean [note: 'Indicates whether the affiliate agreement includes provisions for retransmission consent negotiations with Multichannel Video Programming Distributors (MVPDs) and virtual MVPDs (vMVPDs).']
  retransmission_revenue_split_percentage decimal(5,2) [note: 'Percentage of retransmission consent fees collected from MVPDs that the affiliate must share with the network. Expressed as percentage (e.g., 30.00 for 30% to network).']
  revenue_share_percentage decimal(5,2) [note: 'Percentage of advertising revenue or other monetization that is shared between network and affiliate under revenue-sharing compensation models. Expressed as percentage (e.g., 15.00 for 15%).']
  signed_date date [note: 'Date on which the affiliate agreement was executed by authorized signatories from both network and affiliate parties.']
  simulcast_requirement_flag boolean [note: 'Indicates whether the affiliate is required to simulcast network programming simultaneously across multiple platforms (linear broadcast, digital streaming, mobile apps).']
  term_length_months varchar [note: 'Duration of the affiliate agreement term expressed in months, typically ranging from 12 to 60 months for broadcast affiliations.']
  termination_for_cause_provisions varchar [note: 'Description of conditions under which either party may terminate the agreement for cause, including breach of clearance obligations, payment defaults, license revocation, or material violations of broadcast standards.']
  termination_notice_days varchar [note: 'Number of days advance written notice required for voluntary termination without cause, typically 90-180 days.']

  Note: 'Affiliate relationship agreements with local broadcast stations, regional affiliates, and network affiliate groups. Tracks affiliation fees, network compensation, programming obligations, local insertion rights, must-air requirements, and affiliate performance standards. Distinct from MVPD distribution agreements — affiliates are broadcast station partners, not pay-TV distributors.'
}

Table partner.delivery_obligation {
  delivery_obligation_id varchar [pk, note: 'Primary key for delivery_obligation']
  acquisition_deal_id varchar [note: 'Foreign key linking to partner.acquisition_deal. Business justification: Delivery obligations arise directly from content acquisition deals — when a studio or syndicator commits to deliver content under an acquisition deal, specific delivery obligations are created. A null']
  broadcast_license_id varchar [note: 'Foreign key linking to compliance.broadcast_license. Business justification: Delivery obligations for broadcast distribution must reference the specific license under which content will air. Required for FCC public inspection file compliance, technical format verification, and']
  compliance_content_rating_id varchar [note: 'Foreign key linking to compliance.content_rating. Business justification: Content delivery specifications include rating certification requirements. Delivered assets must include on-screen rating cards, content descriptor overlays, and rating certification documentation. Ac']
  content_episode_id varchar [note: 'Foreign key linking to content.content_episode. Business justification: Episode-level delivery obligations are the most granular and operationally critical unit — each episode has its own delivery deadline, QC status, and acceptance date. This link drives episode-level de']
  coproduction_agreement_id varchar [note: 'Foreign key linking to partner.coproduction_agreement. Business justification: Co-production agreements generate delivery obligations for jointly produced content — each co-production partner has specific delivery commitments (masters, localized versions, technical assets). A nu']
  delivery_channel_id varchar [note: 'Foreign key linking to distribution.delivery_channel. Business justification: A delivery_obligation specifies the channel through which contractual content delivery must be fulfilled. Operations and partner management teams track obligation fulfillment against specific delivery']
  distribution_agreement_id varchar [note: 'Reference to the parent partner agreement under which this delivery obligation exists.']
  partner_id varchar [note: 'Reference to the partner to whom content must be delivered or from whom content is expected.']
  program_schedule_id varchar [note: 'Foreign key linking to scheduling.program_schedule. Business justification: Content delivery obligations tie to specific broadcast schedules for fulfillment tracking (e.g., deliver episode 3 days before scheduled air date). Critical for partner SLA compliance, on-time deliver']
  regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: Delivery obligations must track compliance with technical standards (closed captioning, audio description, format specifications) mandated by regulations. Essential for SLA tracking, penalty calculati']
  syndication_agreement_id varchar [note: 'Foreign key linking to partner.syndication_agreement. Business justification: Syndication agreements generate delivery obligations for content to be delivered to third-party broadcasters and regional stations. A nullable FK to syndication_agreement enables direct linkage betwee']
  acceptance_date date [note: 'Date on which the partner formally accepted the delivered content as meeting technical and contractual specifications.']
  actual_delivery_date date [note: 'Date on which the content was actually delivered to the partner, null if not yet delivered.']
  audio_description_required boolean [note: 'Indicates whether audio description track must be included for visually impaired audiences.']
  audio_track_languages varchar [note: 'Comma-separated list of audio track languages that must be included in the delivery, using ISO 639 codes.']
  closed_caption_required boolean [note: 'Indicates whether closed captioning must be included in the delivered content to meet accessibility and regulatory requirements.']
  created_timestamp timestamp [note: 'Timestamp when this delivery obligation record was first created in the system.']
  delivery_deadline date [note: 'Contractually agreed date by which the content must be delivered to the partner.']
  delivery_location varchar [note: 'Physical or network location where the content must be delivered, such as FTP server address, CDN endpoint, or facility address.']
  delivery_method varchar [note: 'Technical method or channel through which the content will be delivered to the partner.']
  delivery_status varchar [note: 'Current lifecycle status of the delivery obligation indicating progress toward fulfillment.']
  drm_requirement varchar [note: 'Digital rights management protection required for the delivered content to prevent unauthorized access and distribution.']
  eidr_identifier varchar [note: 'Universal unique identifier from the Entertainment Identifier Registry for the content being delivered.']
  episode_count varchar [note: 'Number of episodes included in this delivery obligation for series or multi-episode content.']
  file_size_gb decimal(12,2) [note: 'Total file size in gigabytes of the content package to be delivered.']
  isan_identifier varchar [note: 'International Standard Audiovisual Number uniquely identifying the audiovisual work being delivered.']
  language_version varchar [note: 'Primary language version of the content to be delivered, using ISO 639 language codes.']
  last_modified_timestamp timestamp [note: 'Timestamp when this delivery obligation record was most recently updated.']
  modified_by_user varchar [note: 'Username or identifier of the user who last modified this delivery obligation record.']
  notes varchar [note: 'Free-form notes capturing additional context, special instructions, or issues related to this delivery obligation.']
  obligation_number varchar [note: 'Business identifier for the delivery obligation, typically referenced in contracts and communications.']
  obligation_type varchar [note: 'Classification of the delivery obligation indicating the direction and nature of content flow.']
  penalty_amount decimal(15,2) [note: 'Financial penalty amount incurred for late delivery or non-compliance with delivery specifications, in the contract currency.']
  priority_level varchar [note: 'Business priority assigned to this delivery obligation to guide resource allocation and scheduling.']
  qc_completion_date date [note: 'Date on which quality control review was completed and content was approved for delivery.']
  quality_control_status varchar [note: 'Status of quality control review process for the content before delivery to ensure technical compliance.']
  redelivery_required boolean [note: 'Indicates whether the content must be redelivered due to rejection or technical issues with the initial delivery.']
  rejection_reason varchar [note: 'Detailed explanation provided by the partner for rejecting the delivered content, typically citing technical or contractual non-compliance.']
  required_bitrate_mbps decimal(10,2) [note: 'Minimum or target bitrate in megabits per second required for the delivered content to meet quality standards.']
  required_codec varchar [note: 'Video and audio codec specifications required for the delivery, such as H.264, H.265, AAC, or Dolby Digital.']
  required_format varchar [note: 'Technical delivery format required by the partner, such as HLS (HTTP Live Streaming), MPEG-DASH (Dynamic Adaptive Streaming over HTTP), or mezzanine file format.']
  required_resolution varchar [note: 'Video resolution specification required for delivery, ranging from standard definition to ultra-high definition.']
  sla_compliance boolean [note: 'Indicates whether the delivery was completed within the service level agreement timeframe specified in the partner contract.']
  subtitle_languages varchar [note: 'Comma-separated list of subtitle language tracks that must be included in the delivery, using ISO 639 codes.']
  technical_standard varchar [note: 'Broadcasting or streaming technical standard that the delivery must comply with, such as ATSC (Advanced Television Systems Committee) or DVB (Digital Video Broadcasting).']

  Note: 'Tracks specific content delivery obligations owed to or from partners under acquisition, syndication, and co-production agreements. Captures required delivery format (HLS, MPEG-DASH, ISAN-tagged mezzanine), delivery deadline, technical specification compliance (ATSC, DVB), delivery status, and acceptance confirmation. Bridges partner agreements with the digital asset and distribution domains.'
}

Table partner.minimum_guarantee {
  minimum_guarantee_id varchar [pk, note: 'Unique identifier for the minimum guarantee commitment within a content acquisition deal.']
  acquisition_deal_id varchar [note: 'Reference to the parent content acquisition deal that contains this minimum guarantee commitment.']
  distribution_agreement_id varchar [note: 'Foreign key linking to partner.distribution_agreement. Business justification: Minimum guarantee commitments exist not only in acquisition deals (existing FK) but also in distribution agreements — distribution_agreement has a minimum_guarantee_amount field indicating MG commitme']
  partner_id varchar [note: 'Reference to the studio, syndicator, or content provider receiving the minimum guarantee payment.']
  production_budget_id varchar [note: 'Foreign key linking to production.budget. Business justification: Minimum guarantee advances from partners (acquisition/distribution deals) are capitalized assets amortized against specific production budgets. Finance teams track MG recoupment per production for ROI']
  recoupment_invoice_id varchar [note: 'Foreign key linking to billing.invoice. Business justification: MG recoupment tracking requires linking actual invoiced revenue (syndication fees, royalty statements) back to the guarantee for overage calculation, royalty true-ups, and partner financial reporting.']
  series_id varchar [note: 'Foreign key linking to content.series. Business justification: Minimum guarantee recoupment calculations require knowing which series generated the revenue being applied against the MG. Series-level MG tracking drives recoupment waterfall calculations, overage ro']
  syndication_agreement_id varchar [note: 'Foreign key linking to partner.syndication_agreement. Business justification: Syndication agreements include minimum guarantee commitments (syndication_agreement has minimum_guarantee_amount field). A nullable FK to syndication_agreement enables the minimum_guarantee product to']
  accounting_treatment_code varchar [note: 'The financial accounting classification for the minimum guarantee: asset (capitalized content cost), expense (immediate P&L impact), deferred expense (amortized over time), prepaid (advance payment), or liability (obligation to provider).']
  amortization_method varchar [note: 'The method used to amortize the minimum guarantee cost over its useful life: straight-line (equal periods), usage-based (viewership-driven), revenue-based (proportional to earnings), accelerated (front-loaded), or none (expensed immediately).']
  contract_reference_number varchar [note: 'The master contract or agreement number that governs this minimum guarantee commitment. Links to the legal contract document for audit and compliance.']
  cost_center_code varchar [note: 'The cost center or business unit responsible for the minimum guarantee commitment. Used for internal financial allocation and performance tracking.']
  created_timestamp timestamp [note: 'The date and time when this minimum guarantee record was first created in the system. Used for audit trail and data lineage.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the minimum guarantee amount (e.g., USD, GBP, EUR).']
  effective_end_date date [note: 'The date when the minimum guarantee commitment expires or the recoupment period ends. After this date, overage terms may continue but the MG obligation is closed.']
  effective_start_date date [note: 'The date when the minimum guarantee commitment becomes active and revenue recoupment begins. Typically aligned with content delivery or first broadcast date.']
  final_payment_date date [note: 'The date when the last scheduled minimum guarantee payment was made or is due. Relevant for installment or milestone-based payment structures.']
  first_payment_date date [note: 'The date when the initial minimum guarantee payment was made or is scheduled to be made to the content provider.']
  fully_recouped_date date [note: 'The date when the minimum guarantee was fully recouped and the outstanding balance reached zero. After this date, overage royalty terms apply to additional revenue.']
  general_ledger_account_code varchar [note: 'The general ledger account code in the ERP system where minimum guarantee transactions are recorded for financial reporting and reconciliation.']
  is_cross_collateralized boolean [note: 'Indicates whether this minimum guarantee can be recouped from revenue generated by other content titles or deals with the same provider (true) or is isolated to this specific deal (false).']
  is_recoupable boolean [note: 'Indicates whether the minimum guarantee can be recouped from revenue (true) or is a non-recoupable floor payment (false). Non-recoupable MGs are paid regardless of performance with no offset.']
  last_modified_timestamp timestamp [note: 'The date and time when this minimum guarantee record was last updated. Tracks changes to amounts, status, or recoupment calculations.']
  last_recoupment_calculation_date date [note: 'The date when the most recent recoupment calculation was performed, updating the recouped to date and outstanding balance amounts.']
  mg_amount decimal(18,2) [note: 'The floor payment amount owed to the content provider regardless of actual viewership or revenue performance. This is the baseline financial commitment.']
  mg_number varchar [note: 'Business identifier for the minimum guarantee commitment, used in contracts and financial reconciliation.']
  mg_status varchar [note: 'Current lifecycle state of the minimum guarantee: draft (under negotiation), active (in effect), partially recouped (some revenue applied), fully recouped (MG threshold met), overage (revenue exceeds MG), expired (term ended), or terminated (contract cancelled). [ENUM-REF-CANDIDATE: draft|active|partially_recouped|fully_recouped|overage|expired|terminated — 7 candidates stripped; promote to reference product]']
  mg_type varchar [note: 'Classification of the minimum guarantee structure: flat (single fixed payment), tiered (stepped payments based on milestones), performance-based (adjusted by viewership), hybrid (combination), recoupable (can be offset by revenue share), or non-recoupable (floor payment regardless of performance).']
  next_recoupment_calculation_date date [note: 'The scheduled date for the next recoupment calculation cycle. Typically aligned with monthly, quarterly, or annual reporting periods.']
  notes varchar [note: 'Free-text field for additional context, special terms, exceptions, or business notes related to the minimum guarantee commitment. Used for operational communication and audit trail.']
  outstanding_balance_amount decimal(18,2) [note: 'Remaining minimum guarantee amount not yet recouped. Calculated as MG amount minus recouped to date amount. When zero, the MG is fully recouped.']
  overage_amount decimal(18,2) [note: 'Revenue earned beyond the minimum guarantee threshold. Once the MG is fully recouped, additional revenue share payments are calculated on this overage amount per the contract terms.']
  overage_royalty_rate decimal(5,2) [note: 'The percentage rate applied to overage revenue to calculate additional royalty payments owed to the content provider after the minimum guarantee is fully recouped. Typically ranges from 0.00 to 100.00 percent.']
  payment_schedule_type varchar [note: 'The timing structure for minimum guarantee payments: upfront (single payment at signing), milestone (tied to delivery/broadcast events), installment (fixed periodic payments), quarterly, annual, upon delivery (when content is delivered), or upon broadcast (when content airs). [ENUM-REF-CANDIDATE: upfront|milestone|installment|quarterly|annual|upon_delivery|upon_broadcast — 7 candidates stripped; promote to reference product]']
  payment_terms_description varchar [note: 'Detailed narrative of the payment schedule, milestones, and conditions governing the minimum guarantee disbursement. Includes specific dates, amounts, and triggering events.']
  recouped_to_date_amount decimal(18,2) [note: 'Cumulative revenue amount that has been applied against the minimum guarantee as of the current reporting period. Tracks progress toward full recoupment.']
  recoupment_basis varchar [note: 'The revenue or performance metric against which the minimum guarantee is recouped: gross revenue (total), net revenue (after costs), advertising revenue (CPM/GRP-based), subscription revenue (SVOD/ARPU), combined revenue (multi-stream), or viewership metric (Nielsen ratings, reach).']
  recoupment_percentage decimal(5,2) [note: 'The percentage of revenue (based on recoupment basis) that is applied toward recouping the minimum guarantee. Typically ranges from 0.00 to 100.00 percent.']
  recoupment_period_months varchar [note: 'The duration in months over which the minimum guarantee can be recouped from revenue. Common periods are 12, 24, 36, or 60 months depending on content type and windowing strategy.']
  recoupment_waterfall_description varchar [note: 'Detailed explanation of the revenue allocation sequence and priority order for recouping the minimum guarantee. Defines which revenue streams are applied first and how costs are deducted before recoupment.']

  Note: 'Minimum guarantee (MG) commitments within content acquisition deals — the floor payment owed to a content provider regardless of actual viewership or revenue performance. Tracks MG amount, recoupment schedule, earned-against-MG balance, recoupment waterfall, and overage terms. Critical for financial reconciliation and royalty management in the finance and rights domains.'
}

Table partner.territory_grant {
  territory_grant_id varchar [pk, note: 'Unique identifier for the territory grant record. Primary key.']
  acquisition_deal_id varchar [note: 'Foreign key linking to partner.acquisition_deal. Business justification: Territory grants define the geographic scope of rights within partner agreements. Acquisition deals are the primary source of territory grants in content acquisition — the deal negotiates which territ']
  broadcast_license_id varchar [note: 'Foreign key linking to compliance.broadcast_license. Business justification: Territory grants in distribution agreements must align with licensed broadcast coverage areas. Grants reference DMA codes, coverage contours, and geographic service areas defined by FCC broadcast lice']
  content_title_id varchar [note: 'Reference to the content title for which territorial rights are granted.']
  distribution_agreement_id varchar [note: 'Foreign key linking to partner.distribution_agreement. Business justification: Distribution agreements with MVPDs and OTT aggregators define territorial distribution rights. Territory grants are the granular records of those geographic grants within a distribution agreement. A n']
  license_agreement_id varchar [note: 'Foreign key linking to rights.license_agreement. Business justification: Territory grants in partner domain represent distribution rights that must align with underlying license_agreement terms for territory scope, exclusivity, and windowing. Direct FK enables rights clear']
  ott_platform_id varchar [note: 'Foreign key linking to distribution.ott_platform. Business justification: Territory grants in partner agreements define where/when content can be scheduled (e.g., exclusive US broadcast rights 2024-2026). Essential for rights-compliant scheduling, avoiding territorial viola']
  partner_id varchar [note: 'Foreign key linking to partner.partner_partner. Business justification: Territory grants license content rights to specific partners (broadcasters, streaming platforms, theatrical distributors) for defined geographic regions. Links rights grants to partner master for righ']
  regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: Territory grants must comply with jurisdiction-specific broadcast regulations, retransmission consent rules, local content quotas, and advertising restrictions. Compliance teams track regulatory oblig']
  release_window_id varchar [note: 'Foreign key linking to distribution.release_window. Business justification: Territory grants are valid only within specific release windows (e.g., a territory grant activates during the SVOD window). Rights management requires linking territory_grant to release_window to enfo']
  season_id varchar [note: 'Foreign key linking to content.season. Business justification: Territory grants are frequently scoped to specific seasons (e.g., granting SVOD rights for Season 1 only in a territory). Season-level territory grants drive rights availability calculations, windowin']
  series_id varchar [note: 'Foreign key linking to content.series. Business justification: Territory grants in broadcasting are primarily made at the series level (granting linear rights to a series in a territory). Series-level territory grant tracking is essential for rights clearance, bl']
  avod_rights_flag boolean [note: 'Indicates whether Advertising-Supported Video On Demand distribution rights are included in this grant.']
  blackout_zone_indicator boolean [note: 'Flag indicating whether this grant defines a blackout zone where distribution is explicitly prohibited rather than authorized.']
  carriage_fee_applicable_flag boolean [note: 'Indicates whether a carriage fee (distribution payment) is required for this territorial grant.']
  clearance_status varchar [note: 'Current rights clearance status for this territorial grant. Pending indicates awaiting verification; cleared indicates rights verified and distribution authorized; restricted indicates conditional clearance with limitations; expired indicates grant period has ended; revoked indicates rights withdrawn.']
  clearance_verification_date date [note: 'Date when rights clearance was last verified for this territorial grant.']
  country_code varchar [note: 'ISO 3166-1 alpha-3 country code for single-country grants (e.g., USA, GBR, CAN). Null for multi-country or regional grants.']
  created_by_user varchar [note: 'Username or identifier of the user who created this territory grant record.']
  created_timestamp timestamp [note: 'Timestamp when this territory grant record was first created in the system.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for financial terms associated with this grant (e.g., USD, GBP, EUR).']
  dma_code varchar [note: 'Nielsen Designated Market Area code for US local market grants. Used for local broadcast and cable distribution rights.']
  effective_end_date date [note: 'Date when the territorial grant expires and distribution rights terminate. Null for perpetual grants.']
  effective_start_date date [note: 'Date when the territorial grant becomes effective and distribution is authorized to begin.']
  grant_reference_code varchar [note: 'Business identifier for the territory grant, used in contracts and rights clearance documentation.']
  grant_type varchar [note: 'Type of territorial grant indicating exclusivity level. Exclusive grants prohibit other licensees in the territory; non-exclusive allows multiple licensees; co-exclusive allows a limited number of licensees; holdback restricts distribution during a specific window; reserved indicates rights retained by licensor.']
  holdback_restriction varchar [note: 'Description of any holdback period or exclusivity restrictions that limit distribution during specific windows or in relation to other platforms. For example, a 90-day theatrical holdback before SVOD release.']
  language_restriction varchar [note: 'Comma-separated list of ISO 639-2 language codes specifying which language versions are covered by this grant. Null if all language versions are included.']
  linear_rights_flag boolean [note: 'Indicates whether traditional scheduled broadcast (linear) distribution rights are included in this grant.']
  media_format_restriction varchar [note: 'Restrictions on media formats or technical specifications (e.g., HD only, 4K excluded, standard definition only). Null if no format restrictions apply.']
  minimum_guarantee_amount decimal(15,2) [note: 'Minimum guaranteed payment amount for this territorial grant, regardless of actual distribution revenue. Null if no minimum guarantee applies.']
  modified_by_user varchar [note: 'Username or identifier of the user who last modified this territory grant record.']
  modified_timestamp timestamp [note: 'Timestamp when this territory grant record was last modified.']
  must_carry_obligation_flag boolean [note: 'Indicates whether this grant is subject to must-carry regulations requiring mandatory channel inclusion by distributors.']
  notes varchar [note: 'Free-text notes capturing additional terms, conditions, or clarifications specific to this territorial grant.']
  platform_scope varchar [note: 'Comma-separated list of distribution platforms covered by this grant. May include: linear (traditional broadcast), SVOD (Subscription Video On Demand), AVOD (Advertising-Supported Video On Demand), TVOD (Transactional Video On Demand), OTT (Over-The-Top), theatrical, home video, FAST (Free Ad-Supported Streaming Television), MVPD (Multichannel Video Programming Distributor), vMVPD (Virtual Multichannel Video Programming Distributor).']
  region_name varchar [note: 'Named region for multi-country grants (e.g., North America, European Union, Asia-Pacific, Latin America). Used when grant covers multiple countries as a group.']
  retransmission_consent_required_flag boolean [note: 'Indicates whether retransmission consent (rebroadcast authorization) is required for this territorial grant under FCC regulations.']
  royalty_rate_percent decimal(5,2) [note: 'Percentage royalty rate applicable to revenue generated from distribution in this territory. Used for royalty calculations in the finance domain.']
  sublicense_permitted_flag boolean [note: 'Indicates whether the licensee is authorized to sublicense the territorial rights to third parties.']
  svod_rights_flag boolean [note: 'Indicates whether Subscription Video On Demand distribution rights are included in this grant.']
  territory_scope varchar [note: 'Geographic scope of the grant. May be a country code (ISO 3166-1 alpha-3), region name, Designated Market Area (DMA) code, or custom territory definition.']
  tvod_rights_flag boolean [note: 'Indicates whether Transactional Video On Demand (pay-per-view, rental, electronic sell-through) distribution rights are included in this grant.']
  window_type varchar [note: 'Distribution window classification indicating the sequential release strategy phase. Windowing controls when content is available on different platforms to maximize revenue across release stages. [ENUM-REF-CANDIDATE: theatrical|home_video|pay_tv|free_tv|svod|avod|tvod|syndication|perpetual — 9 candidates stripped; promote to reference product]']

  Note: 'Specific territorial rights grants within partner agreements — defining the geographic scope (country, region, DMA, blackout zone) for which content rights are licensed or distribution is authorized. Tracks grant type (exclusive, non-exclusive), platform scope (linear, SVOD, AVOD, TVOD), holdback restrictions, and effective window. Feeds the rights domain for clearance and blackout enforcement.'
}

Table partner.renewal {
  renewal_id varchar [pk, note: 'Unique identifier for the partner renewal record. Primary key for tracking renewal lifecycle events across acquisition deals, distribution agreements, affiliate agreements, and syndication contracts.']
  acquisition_deal_id varchar [note: 'Foreign key linking to partner.acquisition_deal. Business justification: The renewal product tracks the renewal lifecycle for expiring partner agreements including acquisition deals. A renewal record must reference the specific acquisition deal being renewed to enable dire']
  affiliate_agreement_id varchar [note: 'Foreign key linking to partner.affiliate_agreement. Business justification: Affiliate agreements with local broadcast stations and regional affiliates are subject to periodic renewal. A nullable FK to affiliate_agreement enables direct linkage when agreement_type = \'affiliate']
  coproduction_agreement_id varchar [note: 'Foreign key linking to partner.coproduction_agreement. Business justification: Co-production arrangements with studios and international broadcasters have defined terms and require renewal tracking. A nullable FK to coproduction_agreement enables direct linkage when agreement_ty']
  distribution_agreement_id varchar [note: 'Foreign key linking to partner.distribution_agreement. Business justification: Renewal tracks lifecycle for distribution agreements with MVPDs, cable operators, and OTT aggregators. A nullable FK to distribution_agreement enables direct linkage when agreement_type = \'distributio']
  partner_id varchar [note: 'Reference to the partner organization whose agreement is up for renewal. Links to the partner master record for studios, syndicators, content providers, MVPDs, and third-party distribution partners.']
  series_id varchar [note: 'Foreign key linking to content.series. Business justification: Contract renewals in broadcasting are driven by series performance. Linking renewal to series enables series-level renewal pipeline reporting, strategic importance assessment based on ratings, and ren']
  syndication_agreement_id varchar [note: 'Foreign key linking to partner.syndication_agreement. Business justification: Syndication agreements with third-party broadcasters and regional stations require renewal tracking. A nullable FK to syndication_agreement enables direct linkage when agreement_type = \'syndication_ag']
  agreement_type varchar [note: 'Classification of the partner agreement being renewed. Determines which business rules, approval workflows, and financial terms apply to the renewal process.']
  approval_workflow_stage varchar [note: 'Current stage in the multi-level approval process. Workflow stages and required approvers vary based on deal value thresholds, strategic importance, and organizational governance policies. [ENUM-REF-CANDIDATE: business_owner_review|legal_review|finance_review|executive_review|board_approval|final_approval|completed — 7 candidates stripped; promote to reference product]']
  auto_renewal_clause_flag boolean [note: 'Indicates whether the original agreement contains an automatic renewal provision. When true, agreement renews automatically unless explicit non-renewal notice is provided by the decision due date.']
  auto_renewal_terms varchar [note: 'Detailed description of automatic renewal provisions including renewal term length, rate escalation clauses, and conditions under which auto-renewal applies. Critical for preventing unintended contract extensions.']
  created_timestamp timestamp [note: 'System timestamp when this renewal record was first created in the system. Typically corresponds to renewal trigger date when automated workflow initiates the renewal evaluation process.']
  decision_due_date date [note: 'Deadline by which the organization must communicate renewal decision to the partner. Failure to meet this date may trigger auto-renewal clauses or result in unintended agreement lapse.']
  key_terms_summary varchar [note: 'Executive summary of material changes and key provisions in the proposed renewal including pricing adjustments, rights modifications, performance guarantees, and strategic commitments.']
  last_modified_timestamp timestamp [note: 'System timestamp of the most recent update to this renewal record. Tracks progression through workflow stages, term modifications, and status changes throughout the renewal lifecycle.']
  non_renewal_reason varchar [note: 'Detailed explanation when renewal outcome is not_renewed or terminated. Captures business rationale such as poor content performance, unfavorable terms, strategic realignment, or partner performance issues.']
  notes varchar [note: 'Free-form text field for capturing negotiation history, stakeholder feedback, special considerations, and contextual information relevant to the renewal decision and process.']
  original_agreement_end_date date [note: 'Expiration date of the current agreement term. Triggers renewal workflow initiation based on advance notice requirements specified in the contract.']
  original_agreement_start_date date [note: 'Effective start date of the current agreement term being renewed. Provides historical context for relationship duration and performance evaluation.']
  original_deal_value_amount decimal(18,2) [note: 'Total financial value of the current agreement term being renewed. Provides baseline for evaluating proposed renewal terms and calculating value change percentage.']
  outcome varchar [note: 'Final disposition of the renewal process. Renewed indicates acceptance of proposed terms; renegotiated indicates material changes from original proposal; not_renewed or terminated indicates relationship conclusion.']
  outcome_date date [note: 'Date when final renewal decision was communicated to the partner. Critical for audit trail, compliance verification, and preventing disputes over notice timing.']
  partner_performance_rating varchar [note: 'Overall assessment of partner performance during the current agreement term. Evaluates content quality, delivery timeliness, audience performance, rights compliance, and relationship collaboration. Key input to renewal decision.']
  proposed_deal_value_amount decimal(18,2) [note: 'Total financial value of the proposed renewed agreement over its full term. Used for budget planning, financial forecasting, and executive approval thresholds.']
  proposed_deal_value_currency_code varchar [note: 'Three-letter ISO 4217 currency code for the proposed deal value. Essential for multi-currency contract management and financial consolidation.']
  proposed_end_date date [note: 'Intended expiration date for the renewed agreement. Calculated from proposed start date plus proposed term length.']
  proposed_payment_terms varchar [note: 'Detailed payment schedule and terms for the renewed agreement including payment frequency, milestone-based payments, minimum guarantees, revenue share percentages, and payment methods.']
  proposed_renewal_term_months varchar [note: 'Duration in months for the proposed renewed agreement. May differ from original term based on negotiation outcomes, market conditions, or strategic relationship objectives.']
  proposed_rights_scope varchar [note: 'Description of content rights, distribution territories, platform exclusivity, windowing strategies, and sublicensing provisions proposed for the renewed agreement. Critical for rights management and content strategy alignment.']
  proposed_start_date date [note: 'Intended effective date for the renewed agreement. Typically aligns with original agreement end date to ensure continuity, but may include gap or overlap periods based on negotiation.']
  renegotiation_priority varchar [note: 'Business priority level for renegotiation efforts. Critical priority indicates strategic partnerships requiring executive involvement; low priority may allow standard renewal terms.']
  renegotiation_required_flag boolean [note: 'Indicates whether material terms must be renegotiated rather than simply renewed under existing terms. Set to true when market conditions, partner performance, or strategic priorities require substantive changes.']
  renewal_number varchar [note: 'Business identifier for this renewal instance. Typically follows a pattern incorporating the original agreement number plus renewal sequence (e.g., ACQ-2023-001-R02 for second renewal).']
  renewal_status varchar [note: 'Current lifecycle state of the renewal process. Tracks progression through review, negotiation, approval workflow stages, and final outcome determination. [ENUM-REF-CANDIDATE: pending_review|under_negotiation|legal_review|finance_approval|executive_approval|approved|declined|expired|cancelled — 9 candidates stripped; promote to reference product]']
  risk_assessment varchar [note: 'Evaluation of risks associated with renewal including financial exposure, rights clearance issues, regulatory compliance concerns, partner stability, and competitive threats. Informs approval requirements and contract protections.']
  strategic_importance varchar [note: 'Assessment of the partners strategic value to the organizations content strategy, audience reach, and competitive positioning. Critical and high importance partners receive priority attention in renewal negotiations.']
  trigger_date date [note: 'Date when the renewal evaluation process was initiated. Typically calculated based on original agreement end date minus advance notice period (e.g., 90 days, 180 days) specified in contract terms.']
  value_change_percentage decimal(5,2) [note: 'Percentage change between original deal value and proposed renewal value. Positive values indicate cost increases; negative values indicate cost reductions. Critical metric for financial impact assessment.']

  Note: 'Tracks the renewal lifecycle for expiring partner agreements — acquisition deals, distribution agreements, affiliate agreements, and syndication contracts. Captures renewal trigger date, auto-renewal clause status, renegotiation flag, proposed new terms, approval workflow stage, and renewal outcome. Enables proactive deal management and prevents unintended agreement lapses.'
}

Table partner.partner {
  partner_id varchar [pk, note: 'Unique identifier for the partner_partner data product (auto-inserted pre-linking).']
  parent_partner_id varchar [note: 'Reference to the parent partner entity in cases where this partner is a subsidiary or division of a larger corporate entity. Enables tracking of corporate hierarchies and consolidated relationships. Null for top-level parent entities.']
  annual_content_volume_hours decimal(12,2) [note: 'Estimated or actual annual volume of content hours acquired from or distributed through this partner. Used for capacity planning, content pipeline forecasting, and partner performance evaluation.']
  annual_revenue_contribution_usd decimal(18,2) [note: 'Estimated or actual annual revenue contribution from this partner relationship in USD. Includes content licensing fees, distribution revenue share, advertising revenue, or other monetization streams. Used for partner valuation and ROI analysis.']
  code varchar [note: 'Externally-known unique business identifier for the partner used in operational systems, contracts, and inter-company communications. Typically assigned during onboarding.']
  content_specialization varchar [note: 'Primary content genres, formats, or categories that the partner specializes in producing or distributing. Examples include scripted drama, unscripted reality, sports, news, children\'s programming, documentary, or multi-genre. Supports content acquisition strategy and partner matching.']
  contract_renewal_date date [note: 'Next scheduled date for master agreement renewal or renegotiation with this partner. Used for relationship management planning, contract pipeline tracking, and ensuring continuity of content supply or distribution.']
  corporate_hierarchy_level varchar [note: 'Numeric level in the corporate hierarchy tree where 1 represents the ultimate parent entity and higher numbers represent deeper subsidiary levels. Used for roll-up reporting and consolidated analytics.']
  created_timestamp timestamp [note: 'Timestamp when this partner record was first created in the system. Used for audit trail, data lineage tracking, and record age analysis.']
  credit_rating varchar [note: 'External credit rating assigned by rating agencies such as Moody\'s, S&P, or Fitch. Used for financial risk assessment, contract negotiation, and determining payment terms or guarantees required.']
  distribution_territories varchar [note: 'Geographic territories or markets where the partner operates or holds distribution rights. Stored as comma-separated list of country codes or region identifiers. Critical for rights management and windowing strategy.']
  domicile_country_code varchar [note: 'Three-letter ISO country code representing the legal domicile jurisdiction where the partner entity is incorporated or registered. Determines applicable regulatory frameworks and tax treaties.']
  duns_number varchar [note: 'Nine-digit unique identifier assigned by Dun & Bradstreet to identify business entities globally. Used for credit assessment, vendor management, and corporate hierarchy tracking.']
  headquarters_address_line1 varchar [note: 'First line of the physical headquarters address including street number and street name. Used for legal correspondence, contract execution, and regulatory filings.']
  headquarters_address_line2 varchar [note: 'Second line of the physical headquarters address for suite, floor, building name, or other secondary address details.']
  headquarters_city varchar [note: 'City or municipality where the partner headquarters is located.']
  headquarters_country_code varchar [note: 'Three-letter ISO country code for the headquarters location. May differ from domicile_country_code if the operational headquarters is in a different jurisdiction than legal incorporation.']
  headquarters_postal_code varchar [note: 'Postal or ZIP code for the headquarters address. Format varies by country postal system.']
  headquarters_state_province varchar [note: 'State, province, or primary administrative subdivision where the partner headquarters is located. Format varies by country.']
  is_exclusive boolean [note: 'Indicates whether the partnership includes exclusivity provisions that restrict either party from engaging with competing partners in specified territories, content categories, or distribution channels. Critical for rights management and competitive strategy.']
  last_modified_by varchar [note: 'User identifier or system account that performed the most recent modification to this partner record. Used for audit trail and accountability.']
  last_modified_timestamp timestamp [note: 'Timestamp when this partner record was most recently updated. Used for change tracking, data freshness monitoring, and audit trail.']
  name varchar [note: 'The full legal name of the partner organization as registered with governing authorities. Used for contracts, invoicing, and legal documentation.']
  notes varchar [note: 'Free-text field for capturing additional context, special considerations, relationship history, or operational notes about the partner that do not fit structured fields. Used by relationship managers for institutional knowledge capture.']
  onboarding_stage varchar [note: 'Current stage in the partner onboarding workflow. Tracks progression from initial prospect through due diligence, contract negotiation, legal review, approval, and final onboarding completion.']
  partner_type varchar [note: 'Primary classification of the partner based on their role in the media ecosystem. Studios produce original content, syndicators distribute content to multiple outlets, content providers supply licensed material, MVPDs are traditional cable/satellite distributors, vMVPDs are virtual distributors, and OTT aggregators operate streaming platforms.']
  preferred_payment_terms varchar [note: 'Standard payment terms negotiated with the partner for content licensing, royalties, or service fees. Examples include Net 30, Net 60, advance against royalties, or milestone-based payments. Feeds into accounts payable and cash flow planning.']
  primary_contact_email varchar [note: 'Primary email address for the main business contact at the partner organization. Used for operational communications, contract notifications, and relationship management.']
  primary_contact_name varchar [note: 'Full name of the primary business contact at the partner organization responsible for day-to-day relationship management and operational coordination.']
  primary_contact_phone varchar [note: 'Primary telephone number for the main business contact at the partner organization. Includes country code and extension where applicable.']
  relationship_end_date date [note: 'Date when the business relationship with this partner was formally terminated or is scheduled to end. Null for active ongoing relationships. Used for historical analysis and transition planning.']
  relationship_start_date date [note: 'Date when the business relationship with this partner was formally established, typically corresponding to the first executed agreement or onboarding completion. Used for relationship tenure analysis and anniversary tracking.']
  relationship_status varchar [note: 'Current lifecycle state of the business relationship. Active indicates ongoing business, pending indicates onboarding in progress, suspended indicates temporary hold, inactive indicates no current agreements, and terminated indicates relationship ended.']
  risk_tier varchar [note: 'Internal risk classification based on financial stability, contract compliance history, operational reliability, and strategic importance. Used for relationship management prioritization and escalation protocols.']
  strategic_tier varchar [note: 'Classification of the partner\'s strategic importance to the business. Tier 1 represents critical strategic partners with significant content volume or distribution reach, Tier 2 represents important but not critical partners, Tier 3 represents transactional relationships, and emerging represents new partners under evaluation.']
  subtype varchar [note: 'Secondary classification providing additional granularity within the partner type. Examples include major studio vs independent studio, first-run syndicator vs off-network syndicator, FAST channel operator, co-production house, or affiliate network.']
  tax_identifier varchar [note: 'Government-issued tax identification number for the partner entity. Format varies by jurisdiction (e.g., EIN in USA, VAT number in EU, GST number in other regions). Used for tax reporting and compliance.']

  Note: 'Master record for all external business partners including studios, syndicators, content providers, MVPDs, vMVPDs, FAST channel operators, and third-party distribution partners. Serves as the SSOT for partner identity, classification, legal entity details, and relationship status. Tracks partner type (studio, syndicator, MVPD, OTT aggregator, co-production house), corporate hierarchy, domicile jurisdiction, and onboarding lifecycle stage.'
}

Table partner.coproduction_participation {
  coproduction_participation_id varchar [pk, note: 'Unique identifier for this co-production participation record. Primary key.']
  coproduction_agreement_id varchar [note: 'Foreign key linking to the co-production agreement that this participation record is associated with.']
  partner_id varchar [note: 'Foreign key linking to the partner organization participating in this co-production agreement.']
  created_timestamp timestamp [note: 'Timestamp when this participation record was first created in the system.']
  credit_obligation varchar [note: 'Specific on-screen and promotional credit requirements for this partner in the co-production. Identified in detection phase as relationship-specific data.']
  effective_date date [note: 'Date when this partner\'s participation in the co-production agreement became effective.']
  investment_percentage decimal(5,2) [note: 'The percentage of total co-production budget contributed by this partner. Must sum to 100% across all participants for a given agreement. Identified in detection phase as relationship-specific data.']
  ip_ownership_percentage decimal(5,2) [note: 'The percentage of intellectual property ownership held by this partner in the co-produced content. Identified in detection phase as relationship-specific data.']
  last_modified_timestamp timestamp [note: 'Timestamp when this participation record was most recently updated.']
  notes varchar [note: 'Additional comments or contextual information about this partner\'s participation in the co-production.']
  participation_status varchar [note: 'Current status of this partner\'s participation in the co-production agreement.']
  partner_role varchar [note: 'The specific role this partner plays in the co-production arrangement (e.g., Lead Producer, Co-Financier, Co-Distributor, Creative Partner). Identified in detection phase as relationship-specific data.']
  revenue_share_percentage decimal(5,2) [note: 'The percentage of revenue from the co-produced content allocated to this partner. Identified in detection phase as relationship-specific data.']
  termination_date date [note: 'Date when this partner\'s participation in the co-production agreement ended or will end. Nullable for ongoing participations.']
  territory_rights_allocation varchar [note: 'Geographic territories or markets where this partner holds distribution rights for the co-produced content. Identified in detection phase as relationship-specific data.']

  Note: 'This association product represents the participation relationship between a co-production agreement and a partner organization. It captures the multi-party nature of co-production arrangements where multiple partners (studios, production houses, international broadcasters) jointly finance and produce content. Each record links one co-production agreement to one participating partner with financial terms (investment percentage, IP ownership percentage, revenue share), creative terms (partner role, credit obligations), and territorial rights allocation that exist only in the context of this specific partnership arrangement.. Existence Justification: In the media broadcasting industry, co-production agreements are inherently multi-party arrangements where multiple partners (studios, production houses, international broadcasters) jointly finance and produce content. Each partner\'s participation has distinct financial terms (investment percentage, IP ownership percentage, revenue share), creative terms (role, credit obligations), and territorial rights. The current model\'s lead_partner_id captures only the primary partner, leaving co-financing and co-distribution partners unmodeled, which fails to represent the fundamental business reality that co-productions involve multiple simultaneous partnerships.'
}

Table compliance.broadcast_license {
  broadcast_license_id varchar [pk, note: 'Unique identifier for the broadcast license record. Primary key for the broadcast license entity.']
  partner_id varchar [note: 'Foreign key linking to partner.partner. Business justification: FCC licenses authorize specific transmission equipment operation. Compliance audits require equipment-level tracking for power output, frequency, and technical parameter verification. Real-world Form ']
  annual_fee_amount decimal(12,2) [note: 'Annual regulatory fee assessed by the governing authority for maintaining this broadcast license.']
  antenna_height_meters decimal(10,2) [note: 'Height of the transmitting antenna above average terrain, measured in meters. Critical factor in determining coverage area.']
  broadcast_license_status varchar [note: 'Current lifecycle status of the broadcast license indicating its operational validity and regulatory standing. [ENUM-REF-CANDIDATE: Active|Pending|Suspended|Expired|Revoked|Cancelled|Under Renewal — 7 candidates stripped; promote to reference product]']
  call_sign varchar [note: 'Unique station identifier assigned by the regulatory authority (e.g., WABC, KPIX-TV). Used for station identification during broadcasts.']
  channel_number varchar [note: 'Assigned broadcast channel number for television licenses (e.g., Channel 2, Channel 7). May include virtual channel numbers for digital broadcasts.']
  closed_captioning_required boolean [note: 'Indicates whether this license requires closed captioning for accessibility compliance.']
  community_of_license varchar [note: 'City or community that the broadcast station is licensed to serve. Determines local content and public interest obligations.']
  compliance_obligations varchar [note: 'Summary of specific regulatory compliance requirements attached to this license (e.g., closed captioning, EAS participation, local content quotas, children\'s programming).']
  coverage_area_contour varchar [note: 'Geographic boundary of the licensed coverage area, typically defined by signal strength contours (e.g., 60 dBu for FM, Grade A/B for TV). May be expressed as coordinates or geographic description.']
  eas_participation_required boolean [note: 'Indicates whether this license requires participation in the Emergency Alert System for public safety broadcasts.']
  effective_date date [note: 'Date when the broadcast license becomes legally effective and operational broadcasting is authorized.']
  expiration_date date [note: 'Date when the current license term expires and renewal is required to continue operations.']
  frequency_band varchar [note: 'Spectrum frequency band allocated to this license (e.g., 88.1 MHz for FM, 470-608 MHz for UHF TV). Expressed in MHz or GHz.']
  grant_date date [note: 'Date when the broadcast license was originally granted or issued by the regulatory authority.']
  jurisdiction_country_code varchar [note: 'Three-letter ISO country code of the jurisdiction where this license is valid (e.g., USA, GBR, AUS).']
  last_inspection_date date [note: 'Date of the most recent regulatory inspection or audit of the licensed facility and operations.']
  last_modification_date date [note: 'Date of the most recent modification or amendment to the license terms, technical parameters, or ownership.']
  license_class varchar [note: 'Regulatory classification of the license indicating power level, coverage area, and operational constraints (e.g., Class A, Class B, Class C for FM; Full-Power, Low-Power for TV).']
  license_number varchar [note: 'Official license number or authorization code issued by the regulatory authority. This is the externally-known unique identifier for the broadcast license.']
  license_type varchar [note: 'Classification of the broadcast license by service type and transmission technology. [ENUM-REF-CANDIDATE: AM Radio|FM Radio|TV Full-Power|TV Low-Power|TV Translator|Satellite|Cable Franchise|IPTV — 8 candidates stripped; promote to reference product]']
  licensee_type varchar [note: 'Legal structure of the licensee organization.']
  modification_type varchar [note: 'Nature of the most recent license modification (e.g., Technical Change, Ownership Transfer, Power Increase, Frequency Change).']
  notes varchar [note: 'Additional notes, conditions, or special provisions attached to this broadcast license by the regulatory authority.']
  ownership_attribution varchar [note: 'Details of attributable ownership interests in the licensee entity, required for regulatory ownership reporting and concentration limits.']
  power_output_erp_watts decimal(12,2) [note: 'Maximum authorized effective radiated power output for the transmitter, measured in watts. Determines the coverage area and signal strength.']
  public_inspection_file_location varchar [note: 'Physical or online location where the stations public inspection file is maintained, as required by regulatory authorities.']
  regulatory_authority varchar [note: 'Governing body that issued and oversees this broadcast license (e.g., FCC for United States, Ofcom for United Kingdom). [ENUM-REF-CANDIDATE: FCC|Ofcom|ACMA|CRTC|ANATEL|IFT|Other — 7 candidates stripped; promote to reference product]']
  renewal_application_date date [note: 'Date when the license renewal application was filed with the regulatory authority.']
  renewal_status varchar [note: 'Current status of the license renewal process, tracking whether renewal application has been filed and its disposition.']
  service_type varchar [note: 'Nature of the broadcast service provided under this license, indicating the operational and content obligations.']
  transmitter_address varchar [note: 'Physical street address of the licensed transmitter facility. Organizational contact data classified as confidential.']
  transmitter_location_latitude decimal(10,7) [note: 'Geographic latitude coordinate of the licensed transmitter site in decimal degrees.']
  transmitter_location_longitude decimal(10,7) [note: 'Geographic longitude coordinate of the licensed transmitter site in decimal degrees.']

  Note: 'Master record for all broadcast licenses and spectrum authorizations issued by regulatory bodies (FCC, Ofcom, ACMA, CRTC) held by the organization. Tracks license type (AM, FM, TV full-power, TV low-power, satellite, cable franchise, IPTV), call sign, facility ID, frequency band, channel number, power output (ERP), coverage area (contour), community of license, license class, grant date, expiration date, renewal status, modification history, and the governing regulatory authority. Serves as the authoritative registry of all spectrum and broadcast operating authorities and the anchor entity for per-station compliance obligations.'
}

Table compliance.license_renewal {
  license_renewal_id varchar [pk, note: 'Unique identifier for the broadcast license renewal application record.']
  broadcast_license_id varchar [note: 'Reference to the underlying broadcast license being renewed.']
  regulatory_filing_id varchar [note: 'Foreign key linking to compliance.regulatory_filing. Business justification: License renewals ARE regulatory filings - the renewal application is submitted as a formal filing to the FCC/Ofcom. This FK links the renewal record to its regulatory filing record. Removes duplicate ']
  regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: license_renewal tracks the lifecycle of broadcast license renewal applications governed by specific FCC/Ofcom regulatory obligations (e.g., FCC 47 CFR §73.3539 for TV license renewals). Adding a FK to']
  approval_date date [note: 'The date the regulatory authority officially granted the license renewal.']
  compliance_certification_submitted boolean [note: 'Indicates whether the required compliance certifications (EEO, children\'s programming, political file, etc.) were submitted as part of the renewal application.']
  conditions_imposed varchar [note: 'Any special conditions, restrictions, or requirements imposed by the regulatory authority as part of the renewal grant (e.g., compliance reporting, technical upgrades, programming commitments).']
  created_timestamp timestamp [note: 'The timestamp when this license renewal record was first created in the system.']
  denial_date date [note: 'The date the regulatory authority officially denied the license renewal application.']
  denial_reason varchar [note: 'The regulatory authority\'s stated reason for denying the license renewal (e.g., failure to meet public interest standard, character qualifications, technical violations).']
  fee_payment_date date [note: 'The date the renewal filing fee was paid to the regulatory authority.']
  fee_payment_status varchar [note: 'The current status of the renewal fee payment obligation.']
  filing_deadline date [note: 'The regulatory deadline by which the renewal application must be submitted to avoid license lapse (typically 4 months prior to expiration for FCC).']
  final_disposition varchar [note: 'The ultimate outcome of the license renewal application process.']
  last_modified_timestamp timestamp [note: 'The timestamp when this license renewal record was most recently updated.']
  license_type varchar [note: 'The category of broadcast license being renewed (television station, radio station, cable system, satellite carrier, Multichannel Video Programming Distributor).']
  new_license_term_end_date date [note: 'The expiration date of the renewed license term, establishing the next renewal cycle.']
  new_license_term_start_date date [note: 'The effective start date of the renewed license term following approval.']
  notes varchar [note: 'Free-text notes capturing additional context, issues, or observations related to the renewal application process.']
  petition_count varchar [note: 'The total number of petitions to deny filed against this renewal application.']
  petition_to_deny_filed boolean [note: 'Indicates whether any party filed a formal petition to deny the license renewal during the public comment period.']
  public_comment_deadline date [note: 'The deadline by which the public may file comments or petitions to deny the renewal application.']
  public_inspection_file_updated boolean [note: 'Indicates whether the station\'s public inspection file has been updated with the renewal application and related documents as required by regulation.']
  public_notice_date date [note: 'The date the regulatory body published public notice of the renewal application, opening the period for public comment and petitions to deny.']
  regulatory_body varchar [note: 'The governing regulatory authority to which the renewal application is submitted (Federal Communications Commission, Office of Communications, etc.).']
  renewal_cycle_end_date date [note: 'The date marking the expiration of the current license term, triggering the renewal requirement.']
  renewal_cycle_start_date date [note: 'The date marking the beginning of the current license term that is subject to renewal.']
  renewal_fee_amount decimal(15,2) [note: 'The regulatory filing fee amount required for processing the license renewal application.']
  renewal_fee_currency varchar [note: 'The three-letter ISO 4217 currency code for the renewal fee (e.g., USD, GBP, CAD).']
  renewal_status varchar [note: 'Current lifecycle status of the license renewal application in the regulatory review process. [ENUM-REF-CANDIDATE: Draft|Submitted|Under Review|Public Notice Issued|Petition Filed|Approved|Denied|Withdrawn — 8 candidates stripped; promote to reference product]']
  review_completion_date date [note: 'The date the regulatory authority completed its review and issued a final decision on the renewal application.']
  review_start_date date [note: 'The date the regulatory authority formally commenced substantive review of the renewal application.']

  Note: 'Tracks the lifecycle of broadcast license renewal applications submitted to the FCC, Ofcom, or other regulatory bodies. Captures renewal cycle, filing deadline, submission date, application status, renewal fee, public notice period, petitions to deny, and final disposition. Ensures no license lapses due to missed renewal windows.'
}

Table compliance.regulatory_filing {
  regulatory_filing_id varchar [pk, note: 'Unique identifier for the regulatory filing record. Primary key.']
  broadcast_license_id varchar [note: 'Foreign key linking to compliance.broadcast_license. Business justification: Regulatory filings are often associated with specific broadcast licenses. The filing has license_number (STRING) which should be replaced by FK to broadcast_license. This allows joining to get call_si']
  original_filing_regulatory_filing_id varchar [note: 'Reference to the original regulatory filing identifier if this submission is an amendment or correction, establishing the lineage of filing revisions.']
  partner_id varchar [note: 'Foreign key linking to partner.partner. Business justification: FCC Form 301/302 filings reference specific transmission equipment for power changes, frequency modifications, and technical upgrades. Real regulatory filing workflow requires equipment-level granular']
  regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: regulatory_filing is the authoritative record of all filings submitted to governing bodies. Each filing fulfills a specific regulatory_obligation from the master catalog (e.g., annual EEO report, lice']
  amendment_flag boolean [note: 'Boolean indicator specifying whether this filing is an amendment or correction to a previously submitted filing.']
  approval_date date [note: 'The date on which the regulatory body officially approved or accepted the filing, marking successful completion of the compliance obligation.']
  audit_trail_reference varchar [note: 'Reference identifier linking this filing to detailed audit trail records capturing all preparation, review, approval, and submission activities for compliance verification.']
  ccpa_applicable boolean [note: 'Boolean indicator specifying whether this filing is subject to California Consumer Privacy Act (CCPA) viewer data privacy requirements for California residents.']
  compliance_category varchar [note: 'The primary regulatory compliance domain or category that this filing addresses, such as broadcast licensing, content standards, data privacy, financial reporting, accessibility mandates, or technical standards.']
  confirmation_number varchar [note: 'The unique confirmation or receipt number issued by the regulatory body upon successful submission of the filing, serving as proof of receipt.']
  coppa_applicable boolean [note: 'Boolean indicator specifying whether this filing is subject to Children\'s Online Privacy Protection Act (COPPA) requirements for children\'s content and data collection practices.']
  created_timestamp timestamp [note: 'The timestamp when this regulatory filing record was first created in the system, supporting audit trail and data lineage requirements.']
  document_url varchar [note: 'The Uniform Resource Locator (URL) or file path to the digital copy of the filed document stored in the Media Asset Management (MAM) system or document repository.']
  due_date date [note: 'The regulatory deadline by which the filing must be submitted to remain in compliance with governing body requirements.']
  filing_date date [note: 'The date on which the regulatory filing was officially submitted to the governing body. This is the principal business event timestamp for the filing.']
  filing_description varchar [note: 'A detailed textual description of the filing content, purpose, and scope, providing context for the regulatory submission.']
  filing_fee_amount decimal(15,2) [note: 'The monetary fee charged by the regulatory body for processing this filing, expressed in the broadcaster\'s reporting currency.']
  filing_fee_currency varchar [note: 'The three-letter International Organization for Standardization (ISO) 4217 currency code for the filing fee amount (e.g., USD, GBP, EUR).']
  filing_number varchar [note: 'The externally-known unique filing number or reference code assigned by the broadcaster or regulatory body for tracking and identification purposes.']
  filing_status varchar [note: 'Current lifecycle status of the regulatory filing indicating its progress through the submission and approval workflow. [ENUM-REF-CANDIDATE: draft|submitted|accepted|rejected|under_review|pending_correction|completed — 7 candidates stripped; promote to reference product]']
  filing_type varchar [note: 'The category or type of regulatory filing being submitted, such as Equal Employment Opportunity (EEO) report, ownership report, political file, children\'s programming report, annual report, license renewal application, or public inspection file entry. [ENUM-REF-CANDIDATE: eeo_report|ownership_report|political_file|childrens_programming_report|annual_report|license_renewal|public_inspection_file — 7 candidates stripped; promote to reference product]']
  form_number varchar [note: 'The official form number or identifier designated by the regulatory body for this filing type (e.g., FCC Form 323, FCC Form 396, Ofcom Form 1).']
  gdpr_applicable boolean [note: 'Boolean indicator specifying whether this filing is subject to General Data Protection Regulation (GDPR) data privacy and protection requirements for European Union (EU) audience data.']
  market_designation varchar [note: 'The designated market area or geographic market served by the broadcast facility, as defined by Nielsen or equivalent measurement authority.']
  modified_timestamp timestamp [note: 'The timestamp when this regulatory filing record was last modified or updated, supporting change tracking and audit requirements.']
  next_filing_due_date date [note: 'The anticipated due date for the next recurring filing of this type, supporting proactive compliance planning and calendar management.']
  payment_confirmation_number varchar [note: 'The confirmation or transaction number for the filing fee payment, linking the financial transaction to the regulatory submission.']
  public_inspection_required boolean [note: 'Boolean indicator specifying whether this filing must be made available for public inspection as required by regulatory transparency mandates.']
  regulatory_body varchar [note: 'The governing body or regulatory authority to which this filing was submitted, such as Federal Communications Commission (FCC), Office of Communications (Ofcom), Motion Picture Association (MPA), Interactive Advertising Bureau (IAB), Advanced Television Systems Committee (ATSC), Digital Video Broadcasting (DVB), Nielsen Media Research, Society of Cable Telecommunications Engineers (SCTE), International Organization for Standardization (ISO), General Data Protection Regulation (GDPR) authority, California Consumer Privacy Act (CCPA) authority, Sarbanes-Oxley Act (SOX) auditor, Payment Card Industry (PCI) council, or Children\'s Online Privacy Protection Act (COPPA) Federal Trade Commission (FTC). [ENUM-REF-CANDIDATE: fcc|ofcom|mpa|iab|atsc|dvb|nielsen|scte|iso|gdpr_authority|ccpa_authority|sox_auditor|pci_council|coppa_ftc — 14 candidates stripped; promote to reference product]']
  rejection_reason varchar [note: 'Detailed explanation provided by the regulatory body for rejecting or requesting corrections to the filing, guiding remediation efforts.']
  reporting_period_end date [note: 'The end date of the time period covered by this regulatory filing, defining the conclusion of the reporting window for compliance data.']
  reporting_period_start date [note: 'The start date of the time period covered by this regulatory filing, defining the beginning of the reporting window for compliance data.']
  sox_applicable boolean [note: 'Boolean indicator specifying whether this filing is subject to Sarbanes-Oxley Act (SOX) financial reporting and internal control requirements.']
  submission_method varchar [note: 'The channel or mechanism through which the filing was submitted to the regulatory body, such as online portal, email, postal mail, fax, electronic filing system, or Application Programming Interface (API).']

  Note: 'Authoritative record of all regulatory filings submitted to governing bodies including FCC, Ofcom, MPA, IAB, and others. Captures filing type (EEO report, ownership report, political file, children\'s programming report, annual report), form number, filing date, due date, submission method, filing status, confirmation number, and the responsible regulatory body. Supports SOX, FCC, and Ofcom compliance obligations.'
}

Table compliance.public_inspection_file {
  public_inspection_file_id varchar [pk, note: 'Unique identifier for the public inspection file record. Primary key for the entity. Role: MASTER_RESOURCE (regulatory document repository).']
  broadcast_license_id varchar [note: 'Foreign key linking to compliance.broadcast_license. Business justification: Public inspection files are maintained per broadcast license per FCC requirements. Each document in the OPIF relates to a specific licensed station. This FK enables tracking which license each documen']
  channel_id varchar [note: 'Reference to the FCC-licensed broadcast station that owns this public inspection file.']
  original_document_public_inspection_file_id varchar [note: 'If this is an amendment, reference to the original public inspection file document being amended or corrected.']
  regulatory_filing_id varchar [note: 'Foreign key linking to compliance.regulatory_filing. Business justification: Many regulatory filings must be included in the station\'s public inspection file. This FK links public file documents to their corresponding regulatory filing records, ensuring disclosure compliance.']
  created_timestamp timestamp [note: 'The date and time when this public inspection file record was first created in the system.']
  document_category varchar [note: 'The FCC-mandated category of the public inspection file document. Categories include political file (advertising records), EEO reports (equal employment opportunity), ownership reports, issues/programs lists, children\'s programming reports, and contour maps.']
  document_description varchar [note: 'Detailed description of the document content, purpose, and any relevant context for public inspection.']
  document_file_format varchar [note: 'The file format of the stored document (e.g., PDF, DOCX, XLSX). FCC typically requires PDF format for OPIF submissions.']
  document_file_path varchar [note: 'The storage location or URI of the document file in the media asset management system or document repository.']
  document_file_size_bytes varchar [note: 'The size of the document file in bytes.']
  document_period_end_date date [note: 'The end date of the reporting period covered by this document.']
  document_period_start_date date [note: 'The start date of the reporting period covered by this document (e.g., for quarterly EEO reports or issues/programs lists).']
  document_title varchar [note: 'The descriptive title or name of the public inspection file document.']
  fcc_opif_sync_status varchar [note: 'Synchronization status with the FCC\'s Online Public Inspection File portal. Indicates whether the document has been successfully transmitted to and accepted by the FCC system.']
  fcc_opif_sync_timestamp timestamp [note: 'The date and time of the last successful synchronization with the FCC OPIF portal.']
  fcc_reference_number varchar [note: 'The unique reference or confirmation number assigned by the FCC OPIF system upon successful document submission.']
  filing_date date [note: 'The date the document was filed or added to the public inspection file. This is the official date of record for compliance purposes.']
  is_amendment boolean [note: 'Indicates whether this document is an amendment or correction to a previously filed public inspection file document.']
  last_modified_timestamp timestamp [note: 'The date and time when this public inspection file record was last updated or modified.']
  notes varchar [note: 'Additional notes, comments, or context about the document, its filing, or any special circumstances related to compliance.']
  political_advertiser_name varchar [note: 'For political file documents, the name of the candidate, campaign, or political organization that purchased advertising time. Required for political file category documents.']
  political_office_sought varchar [note: 'For political file documents, the elected office being sought by the candidate (e.g., President, Senator, Governor, Mayor).']
  public_access_status varchar [note: 'Indicates whether the document is currently available for public inspection. Documents may be restricted during review or removed after retention period expiration.']
  retention_expiration_date date [note: 'The date when the regulatory retention period expires and the document may be removed from the public inspection file.']
  retention_period_years varchar [note: 'The number of years this document must be retained in the public inspection file as mandated by FCC regulations. Varies by document category (e.g., 2 years for political files, 8 years for ownership reports).']
  upload_status varchar [note: 'Current status of the document upload to the FCC OPIF (Online Public Inspection File) portal. Tracks the lifecycle from pending submission through verification and archival.']
  upload_timestamp timestamp [note: 'The date and time when the document was successfully uploaded to the FCC OPIF portal or internal public inspection file system.']
  verification_status varchar [note: 'Internal verification status indicating whether the document has been reviewed for accuracy and compliance before public posting.']
  verification_timestamp timestamp [note: 'The date and time when the document was verified for compliance and accuracy by station staff.']

  Note: 'Manages the FCC-mandated public inspection file (OPIF) for each licensed broadcast station. Tracks document categories (political file, EEO reports, ownership disclosures, children\'s programming reports, issues/programs lists, contour maps), document upload status, retention period, public access status, and FCC OPIF portal sync status. Required for all FCC-licensed stations under 47 CFR §73.3526 and §73.3527.'
}

Table compliance.content_rating {
  content_rating_id varchar [pk, note: 'Primary key for content_rating']
  regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: content_rating tracks ratings issued under specific regulatory frameworks (MPA, TV Parental Guidelines, COPPA). Each rating system is governed by a specific regulatory_obligation in the master catalog']
  accessibility_rating_notes varchar [note: 'Notes regarding accessibility features relevant to the rating, such as closed captioning compliance, audio description availability, or photosensitive epilepsy warnings.']
  appeal_status varchar [note: 'Status of any appeal filed by the content producer to challenge the assigned rating. Not Appealed: no appeal has been filed; Appeal Pending: appeal is under review; Appeal Approved: rating was changed following appeal; Appeal Denied: original rating upheld.']
  content_descriptors varchar [note: 'Comma-separated list of content advisory descriptors that explain the reasons for the rating. Examples: violence, strong language, sexual content, drug use, nudity, adult themes, frightening scenes.']
  coppa_compliant boolean [note: 'Indicates whether the content and its associated data collection practices comply with COPPA requirements for children\'s content.']
  created_timestamp timestamp [note: 'The timestamp when this content rating record was first created in the system.']
  drug_use_descriptor boolean [note: 'Indicates whether the content contains drug use or substance abuse that contributed to the rating.']
  eidr_code varchar [note: 'The EIDR identifier for the content asset, providing a globally unique reference for the audiovisual work.']
  language_descriptor boolean [note: 'Indicates whether the content contains strong or offensive language that contributed to the rating.']
  minimum_age varchar [note: 'The minimum recommended or required age for viewers of this content, as specified by the rating authority. Null if no specific age restriction applies.']
  parental_guidance_required boolean [note: 'Indicates whether parental guidance is recommended or required for viewers under a certain age.']
  previous_rating_value decimal(18,2) [note: 'The rating value that was assigned before the current rating, if the content was re-rated. Null for initial ratings.']
  rating_authority varchar [note: 'The official organization or regulatory body that issued the rating. Examples: Motion Picture Association, TV Parental Guidelines Monitoring Board, British Board of Film Classification, Freiwillige Selbstkontrolle der Filmwirtschaft.']
  rating_certificate_number varchar [note: 'The official certificate or registration number issued by the rating authority for this content rating.']
  rating_date date [note: 'The date on which the rating was officially assigned to the content by the rating authority.']
  rating_expiration_date date [note: 'The date on which the rating expires or requires renewal, if applicable. Null for ratings with no expiration.']
  rating_fee_amount decimal(15,2) [note: 'The fee charged by the rating authority for evaluating and assigning the rating to the content.']
  rating_fee_currency varchar [note: 'Three-letter ISO 4217 currency code for the rating fee. Examples: USD, GBP, EUR, AUD, JPY.']
  rating_notes varchar [note: 'Additional notes or comments regarding the rating, including any special conditions, context, or clarifications provided by the rating authority or compliance team.']
  rating_reason varchar [note: 'Detailed explanation provided by the rating authority describing the specific content elements that led to the assigned rating.']
  rating_review_date date [note: 'The date on which the rating was last reviewed or re-evaluated by the rating authority.']
  rating_status varchar [note: 'Current lifecycle status of the rating. Active: rating is valid and in effect; Expired: rating has passed its expiration date; Revoked: rating has been withdrawn by the authority; Pending: rating application submitted but not yet approved; Under Review: rating is being re-evaluated.']
  rating_submission_date date [note: 'The date on which the content was submitted to the rating authority for evaluation.']
  rating_system varchar [note: 'The rating authority or system that issued this rating. Examples: MPA (Motion Picture Association), TV Parental Guidelines, BBFC (British Board of Film Classification), FSK (Germany), ACB (Australia), EIRIN (Japan), KFCB (Kenya). [ENUM-REF-CANDIDATE: MPA|TV_PARENTAL_GUIDELINES|BBFC|FSK|ACB|EIRIN|KFCB — 7 candidates stripped; promote to reference product]']
  rating_type varchar [note: 'The distribution context for which this rating was assigned. Different ratings may apply to theatrical release, television broadcast, home video, or streaming platforms.']
  rating_value decimal(18,2) [note: 'The specific rating classification assigned to the content. Examples: G, PG, PG-13, R, NC-17 (MPA); TV-Y, TV-Y7, TV-G, TV-PG, TV-14, TV-MA (TV Parental Guidelines); U, PG, 12A, 15, 18 (BBFC). [ENUM-REF-CANDIDATE: G|PG|PG-13|R|NC-17|TV-Y|TV-Y7|TV-G|TV-PG|TV-14|TV-MA|U|12A|15|18|FSK0|FSK6|FSK12|FSK16|FSK18 — promote to reference product]']
  rating_version varchar [note: 'Version number of this rating record. Increments when the rating is re-evaluated or updated due to content changes or appeals.']
  sexual_content_descriptor boolean [note: 'Indicates whether the content contains sexual content or nudity that contributed to the rating.']
  territory_code varchar [note: 'Three-letter ISO 3166-1 alpha-3 country code indicating the geographic territory where this rating is applicable. Examples: USA, GBR, DEU, AUS, JPN.']
  updated_timestamp timestamp [note: 'The timestamp when this content rating record was last modified in the system.']
  violence_descriptor boolean [note: 'Indicates whether the content contains violence that contributed to the rating.']

  Note: 'Master registry of content ratings assigned to programming assets per MPA, TV Parental Guidelines, and international rating systems (BBFC, FSK, etc.). Captures rating system, rating value (G, PG, PG-13, R, NC-17; TV-Y, TV-Y7, TV-G, TV-PG, TV-14, TV-MA), content descriptors (violence, language, sexual content, drug use), rating authority, rating date, and applicability by territory. Links to content assets in the content domain.'
}

Table compliance.closed_caption_record {
  closed_caption_record_id varchar [pk, note: 'Unique identifier for the closed caption compliance record.']
  accessibility_obligation_id varchar [note: 'Foreign key linking to compliance.accessibility_obligation. Business justification: Closed captioning is a specific type of accessibility obligation under FCC/Ofcom rules. This FK links each captioning record to the accessibility obligation it fulfills, enabling compliance reporting ']
  broadcast_license_id varchar [note: 'Foreign key linking to compliance.incident. Business justification: Closed captioning violations (low accuracy, missing captions, complaints) may be recorded as compliance incidents. This FK links the captioning record to any incident it triggered, supporting FCC comp']
  caption_vendor_partner_id varchar [note: 'Foreign key linking to partner.partner_partner. Business justification: Captioning vendor performance and FCC compliance is tracked by partner. Captioning accuracy failures, latency violations, and format errors may trigger vendor SLA breaches, disputes, or vendor substit']
  channel_id varchar [note: 'Foreign key linking to scheduling.channel. Business justification: Caption compliance audits require tracking which encoder processed each stream. Real NOC/compliance workflow for troubleshooting caption failures and demonstrating CVAA compliance to FCC.']
  delivery_channel_id varchar [note: 'Reference to the channel or platform where the captioned content was broadcast or streamed.']
  public_inspection_file_id varchar [note: 'Foreign key linking to compliance.public_inspection_file. Business justification: closed_caption_record has a public_inspection_file_included (BOOLEAN) flag indicating whether the caption record is included in the FCC public inspection file. Adding a direct FK to public_inspection_']
  regulatory_filing_id varchar [note: 'Foreign key linking to compliance.regulatory_filing. Business justification: closed_caption_record has regulatory_filing_required (BOOLEAN) and regulatory_filing_date (DATE) indicating that caption compliance events can trigger formal regulatory filings with the FCC. Adding a ']
  regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: closed_caption_record tracks compliance under FCC rules (47 CFR §79.1) and Ofcom requirements. These are specific entries in the regulatory_obligation master catalog. Adding this FK links each caption']
  air_date date [note: 'The date the captioned content was broadcast or made available to viewers.']
  air_time timestamp [note: 'The precise timestamp when the captioned content began airing or streaming.']
  caption_accuracy_score decimal(5,2) [note: 'Percentage score representing the accuracy of the captions compared to the spoken audio, measured as a percentage from 0.00 to 100.00.']
  caption_completeness_percentage decimal(5,2) [note: 'Percentage of the program duration that was captioned, measured from 0.00 to 100.00.']
  caption_file_format varchar [note: 'The technical format of the closed caption file used for this broadcast. [ENUM-REF-CANDIDATE: SRT|SCC|TTML|WebVTT|CEA-608|CEA-708|DFXP|STL — 8 candidates stripped; promote to reference product]']
  caption_latency_seconds decimal(6,2) [note: 'The average delay in seconds between spoken audio and caption display, critical for live programming compliance.']
  caption_placement_compliance boolean [note: 'Indicates whether caption placement on screen met regulatory standards for visibility and non-obstruction of critical content.']
  caption_quality_review_date date [note: 'Date when the caption quality was formally reviewed for compliance assessment.']
  caption_synchronization_compliance boolean [note: 'Indicates whether captions were properly synchronized with the audio and video content per regulatory requirements.']
  caption_type varchar [note: 'Indicates whether the captions were generated live during broadcast or pre-recorded offline.']
  captioned_duration_minutes varchar [note: 'Total duration in minutes that was actually captioned within the program.']
  complaint_received_date date [note: 'Date when a viewer complaint regarding captioning was received by the broadcaster.']
  complaint_reference_number varchar [note: 'Reference number of any viewer complaint filed regarding caption quality or availability for this broadcast.']
  complaint_type varchar [note: 'Category of the captioning complaint filed by viewers or regulatory bodies.']
  compliance_status varchar [note: 'Current compliance status of the closed captioning for this broadcast record.']
  created_timestamp timestamp [note: 'Timestamp when this closed caption compliance record was first created in the system.']
  daypart varchar [note: 'The broadcast daypart time segment during which the captioned content aired. [ENUM-REF-CANDIDATE: early_morning|morning|daytime|early_fringe|prime_access|prime_time|late_fringe|overnight — 8 candidates stripped; promote to reference product]']
  exemption_basis varchar [note: 'Legal or regulatory basis for exemption from closed captioning requirements, if applicable.']
  exemption_category varchar [note: 'Category of exemption from captioning requirements as defined by regulatory frameworks. [ENUM-REF-CANDIDATE: primarily_textual|late_night|promotional|public_service_announcement|locally_produced|economic_burden|interstitial_material|secondary_audio — promote to reference product]']
  language_code varchar [note: 'Three-letter ISO 639-2 language code indicating the language of the closed captions.']
  last_modified_timestamp timestamp [note: 'Timestamp when this closed caption compliance record was last updated or modified.']
  notes varchar [note: 'Additional notes or comments regarding the closed caption compliance record, quality issues, or special circumstances.']
  program_duration_minutes varchar [note: 'Total duration of the program in minutes for which captioning compliance is being tracked.']
  program_title varchar [note: 'The title of the program that was captioned as it appeared in the broadcast schedule.']
  regulatory_filing_date date [note: 'Date when the caption compliance record was filed with the regulatory authority.']
  regulatory_filing_required boolean [note: 'Indicates whether this caption record requires formal filing with regulatory authorities such as FCC or Ofcom.']
  remediation_completed_date date [note: 'Date when remediation actions to correct captioning issues were completed.']
  remediation_description varchar [note: 'Detailed description of the remediation actions taken to address captioning compliance issues.']
  remediation_status varchar [note: 'Current status of remediation efforts to address captioning deficiencies or complaints.']

  Note: 'Compliance record for closed captioning obligations under FCC rules (47 CFR §79.1) and Ofcom requirements. Tracks program title, air date, channel, caption file format (SRT, SCC, TTML, WebVTT), caption accuracy score, caption latency (for live programming), caption completeness percentage, complaint reference, remediation status, and exemption basis if applicable. Supports FCC caption quality standards and complaint response workflows.'
}

Table compliance.accessibility_obligation {
  accessibility_obligation_id varchar [pk, note: 'Unique identifier for the accessibility compliance obligation record.']
  broadcast_license_id varchar [note: 'Foreign key linking to compliance.broadcast_license. Business justification: Accessibility obligations may be license-specific (e.g., closed captioning requirements vary by license type and market). This FK enables tracking which obligations apply to which licenses.']
  regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: accessibility_obligation is a domain-specific instantiation of a broader regulatory_obligation (e.g., ADA, CVAA, FCC accessibility rules). The regulatory_obligation master catalog contains regulation_']
  compliance_deadline date [note: 'Date by which the organization must achieve full compliance with this accessibility obligation.']
  compliance_percentage decimal(5,2) [note: 'Percentage of content or platform features currently meeting this accessibility obligation (0.00 to 100.00), used for tracking progress toward full compliance.']
  compliance_status varchar [note: 'Current state of the organization\'s compliance with this obligation: compliant (fully meeting requirements), non-compliant (failing to meet requirements), in progress (actively working toward compliance), not started (no action taken), exempt (obligation does not apply), or waiver granted (temporary or permanent exemption approved by regulator).']
  content_type_applicability varchar [note: 'Types of content to which this obligation applies (e.g., all programming, news and emergency information, pre-recorded entertainment, live events, user-generated content exclusions).']
  created_timestamp timestamp [note: 'Timestamp when this accessibility obligation record was first created in the system.']
  effective_date date [note: 'Date when this accessibility obligation became or will become legally binding on the organization.']
  estimated_compliance_cost decimal(15,2) [note: 'Estimated total cost in USD to achieve full compliance with this obligation, including technology implementation, content remediation, training, and ongoing operational costs.']
  exemption_reason varchar [note: 'Explanation of why this obligation does not apply to the organization or why a waiver was granted (e.g., content category exemption, undue burden waiver, technical infeasibility).']
  expiration_date date [note: 'Date when this obligation ceases to apply, if applicable (null for ongoing obligations).']
  geographic_jurisdiction varchar [note: 'Three-letter ISO country code representing the jurisdiction where this obligation is enforceable (e.g., USA for FCC/CVAA, GBR for Ofcom, DEU for German regulations).']
  last_compliance_review_date date [note: 'Date when the organization last conducted an internal review or audit of compliance with this accessibility obligation.']
  last_updated_timestamp timestamp [note: 'Timestamp when this accessibility obligation record was most recently modified.']
  measurement_methodology varchar [note: 'Method used to measure and verify compliance with this obligation (e.g., automated caption quality analysis, manual content audits, user testing, third-party accessibility audits).']
  next_compliance_review_date date [note: 'Scheduled date for the next internal review or audit of compliance with this accessibility obligation.']
  notes varchar [note: 'Additional notes, context, or special considerations related to this accessibility obligation (e.g., pending regulatory changes, coordination with other obligations, vendor dependencies).']
  obligation_code varchar [note: 'Business identifier code for the accessibility obligation, used for external reference and reporting.']
  obligation_name varchar [note: 'Human-readable name of the accessibility obligation (e.g., Closed Captioning for Linear Broadcast, Audio Description for VOD Content).']
  obligation_type varchar [note: 'Category of accessibility requirement: closed captioning (CC), audio description (AD), video description, emergency alert accessibility, online video player accessibility, or keyboard navigation compliance.']
  penalty_for_non_compliance varchar [note: 'Description of regulatory penalties, fines, or sanctions that may be imposed for failure to meet this obligation (e.g., FCC forfeiture up to $100,000 per violation, Ofcom statutory sanctions, license suspension risk).']
  priority_level varchar [note: 'Business priority assigned to achieving compliance with this obligation: critical (regulatory deadline imminent or high penalty risk), high (significant regulatory or reputational risk), medium (standard compliance requirement), or low (minimal risk or long timeline).']
  regulation_section varchar [note: 'Specific section, article, or clause of the regulation that mandates this obligation (e.g., 47 CFR 79.1, WCAG 2.1 Success Criterion 1.2.2).']
  reporting_frequency varchar [note: 'Frequency at which compliance status for this obligation must be reported to the regulator: annual, quarterly, monthly, on-demand (upon request), or not required.']
  responsible_team varchar [note: 'Name of the internal team, department, or business unit responsible for ensuring compliance with this obligation (e.g., Broadcast Operations, Digital Product, Legal Compliance, Content Production).']
  scope varchar [note: 'Distribution platform scope to which this obligation applies: linear broadcast, VOD (Video On Demand), SVOD (Subscription Video On Demand), AVOD (Advertising-Supported Video On Demand), TVOD (Transactional Video On Demand), OTT (Over-The-Top), FAST (Free Ad-Supported Streaming Television), MVPD (Multichannel Video Programming Distributor), vMVPD (Virtual Multichannel Video Programming Distributor), or all platforms. [ENUM-REF-CANDIDATE: linear|vod|svod|avod|tvod|ott|fast|mvpd|vmvpd|all_platforms — 10 candidates stripped; promote to reference product]']
  target_compliance_percentage decimal(5,2) [note: 'Required percentage of content or platform features that must meet this accessibility obligation to achieve regulatory compliance (typically 100.00, but may be lower for phased implementation schedules).']
  technical_standard varchar [note: 'Technical standard or specification that defines how this accessibility feature must be implemented (e.g., CEA-608 for closed captioning, TTML for web captions, WCAG 2.1 AA for player accessibility).']
  waiver_expiration_date date [note: 'Date when a granted waiver or exemption expires and the obligation becomes enforceable again (null for permanent exemptions).']

  Note: 'Master record of accessibility compliance obligations applicable to the organization\'s content and platforms, including closed captioning, audio description (AD), video description, emergency alert accessibility, and online video player accessibility under CVAA, ADA, and Ofcom accessibility codes. Captures obligation type, applicable regulation, scope (linear, VOD, OTT), compliance deadline, responsible team, and current compliance status.'
}

Table compliance.eas_log {
  eas_log_id varchar [pk, note: 'Unique identifier for the EAS log entry. Primary key for the EAS log record.']
  broadcast_license_id varchar [note: 'Foreign key linking to compliance.broadcast_license. Business justification: EAS logs track Emergency Alert System activations for FCC-licensed broadcast stations. Each log entry relates to a specific broadcast license. This FK links the operational log to the license record.']
  channel_id varchar [note: 'Identifier of the broadcast station that received or transmitted the EAS alert.']
  public_inspection_file_id varchar [note: 'Foreign key linking to compliance.public_inspection_file. Business justification: eas_log has a public_inspection_file_entry (BOOLEAN) flag indicating whether the EAS log entry is included in the FCC public inspection file. Adding a direct FK to public_inspection_file normalizes th']
  regulatory_filing_id varchar [note: 'Foreign key linking to compliance.regulatory_filing. Business justification: eas_log records FCC-mandated Emergency Alert System activations and tests. EAS compliance events can generate formal regulatory filings (e.g., EAS test reports submitted to the FCC). Adding a FK to re']
  regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.compliance_calendar. Business justification: Scheduled EAS tests are tracked in the compliance calendar. This FK links each EAS log entry to the calendar entry for the scheduled test, enabling verification that required tests were performed on t']
  alert_duration_seconds varchar [note: 'Duration of the EAS alert transmission in seconds, from start to end of the alert message.']
  alert_text varchar [note: 'Full text content of the EAS alert message that was transmitted or received, including any instructions to the public.']
  alert_timestamp timestamp [note: 'Date and time when the EAS alert was activated or received by the station. This is the principal business event timestamp for the alert.']
  alert_type varchar [note: 'Classification of the EAS alert by geographic scope: national emergency, state emergency, local emergency, or test alert.']
  attention_signal_transmitted boolean [note: 'Indicates whether the two-tone attention signal was transmitted as part of the EAS alert.']
  audio_message_transmitted boolean [note: 'Indicates whether the audio message portion of the EAS alert was transmitted.']
  cap_message_received boolean [note: 'Indicates whether the alert was received in Common Alerting Protocol (CAP) format via IPAWS or other digital alert system.']
  compliance_status varchar [note: 'Compliance status of the EAS alert or test: compliant (met all requirements), missed (alert not transmitted), late (transmitted after required time), or failed (technical failure).']
  created_timestamp timestamp [note: 'Timestamp when this EAS log record was first created in the system for audit and compliance tracking.']
  end_of_message_transmitted boolean [note: 'Indicates whether the End of Message (EOM) code was transmitted to signal completion of the EAS alert.']
  equipment_used varchar [note: 'Description or model identifier of the EAS equipment (encoder/decoder) used to process and transmit the alert.']
  event_code varchar [note: 'Three-letter EAS event code identifying the nature of the emergency (e.g., EAN for Emergency Action Notification, RWT for Required Weekly Test, RMT for Required Monthly Test, TOR for Tornado Warning).']
  failure_reason varchar [note: 'Detailed explanation of why an EAS alert transmission failed or was missed, including technical or operational reasons.']
  ipaws_message_code varchar [note: 'Unique message identifier from FEMA IPAWS system for alerts originated through the national alert infrastructure.']
  location_code varchar [note: 'Six-digit FIPS code identifying the geographic area affected by the alert (county or equivalent subdivision).']
  modified_timestamp timestamp [note: 'Timestamp when this EAS log record was last modified, supporting audit trail requirements.']
  notes varchar [note: 'Free-form notes entered by station personnel regarding the EAS alert, including any special circumstances, corrective actions taken, or follow-up required.']
  originator_code varchar [note: 'Three-letter code identifying the entity that originated the alert (e.g., PEP for Primary Entry Point, CIV for Civil Authority, WXR for National Weather Service, EAS for EAS Participant).']
  originator_name varchar [note: 'Full name of the authority or organization that originated the EAS alert (e.g., FEMA IPAWS, National Weather Service, State Emergency Management Agency).']
  relay_chain_position varchar [note: 'Position of this station in the EAS relay chain, indicating how many hops the alert has traveled from the originator (1 for direct receipt, 2+ for relayed).']
  retention_expiry_date date [note: 'Date when this EAS log record is eligible for deletion based on FCC retention requirements (minimum 2 years for EAS logs).']
  test_compliance_type varchar [note: 'Type of EAS test compliance this log entry satisfies: Required Weekly Test (RWT), Required Monthly Test (RMT), National Periodic Test, or none if not a test.']
  test_scheduled_date date [note: 'Date when the EAS test was scheduled to occur, used for tracking compliance with required weekly and monthly test schedules.']
  transmission_status varchar [note: 'Status of the EAS alert transmission indicating whether the station successfully transmitted, received, relayed, failed to transmit, or missed the alert.']
  upstream_source_callsign varchar [note: 'Call sign of the upstream station or source from which this station received the EAS alert for relay.']
  valid_time_period varchar [note: 'Four-digit code indicating the valid time period for the alert in 15-minute increments (e.g., 0030 for 30 minutes, 0100 for 1 hour).']

  Note: 'Operational log of Emergency Alert System (EAS) activations and tests for FCC-licensed broadcast stations. Captures alert type (national, state, local), alert originator (FEMA IPAWS, NWS, state/local authority), activation timestamp, relay chain, transmission status, duration, required monthly/weekly test compliance, and any missed alert incidents. Required under FCC 47 CFR Part 11 for all EAS participants.'
}

Table compliance.political_ad_record {
  political_ad_record_id varchar [pk, note: 'Unique identifier for the political advertising compliance record. Primary key for tracking FCC political broadcasting obligations under 47 CFR §73.1940-73.1942.']
  ad_order_id varchar [note: 'Reference to the advertising sales order in the traffic system that originated this political ad placement.']
  broadcast_license_id varchar [note: 'Foreign key linking to compliance.broadcast_license. Business justification: Political ad records are tied to specific broadcast licenses under FCC political broadcasting rules. The record has broadcast_station_call_sign which should be replaced by FK to broadcast_license to g']
  content_version_id varchar [note: 'Foreign key linking to content.version. Business justification: FCC political file compliance requires tracking the exact content version (creative) of each political ad aired. Linking political_ad_record to the specific content version enables compliance teams to']
  partner_id varchar [note: 'Foreign key linking to partner.partner_partner. Business justification: Political ad records must identify the buying partner/agency for FCC public inspection file disclosure and reasonable access/equal time administration. The advertiser entity (campaign, PAC, party comm']
  public_inspection_file_id varchar [note: 'Foreign key linking to compliance.public_inspection_file. Business justification: Political ad records must be included in the station\'s public inspection file per FCC rules. This FK links each political ad record to its corresponding public file document, ensuring disclosure compl']
  regulatory_obligation_id varchar [note: 'Foreign key linking to compliance.regulatory_obligation. Business justification: political_ad_record tracks compliance under FCC political broadcasting rules (47 CFR §73.1940, §73.1941, §73.1943). These rules are entries in the regulatory_obligation master catalog. Adding this FK ']
  talent_profile_id varchar [note: 'Foreign key linking to talent.talent_profile. Business justification: Political ads featuring talent require disclosure of talent identity, compensation, and sponsorship identification in public inspection files. Ad clearance teams document talent appearing in political']
  advertiser_type varchar [note: 'Classification of the political advertiser entity type for regulatory reporting and rate determination purposes.']
  affidavit_issued_flag boolean [note: 'Indicates whether a broadcast affidavit (proof of performance) has been issued to the advertiser confirming that this political ad aired as scheduled.']
  air_date date [note: 'Calendar date on which the political advertisement was broadcast or is scheduled to broadcast.']
  air_time timestamp [note: 'Precise timestamp when the political advertisement aired or is scheduled to air, including time zone. Required for public inspection file and affidavit of performance.']
  candidate_name varchar [note: 'Name of the political candidate featured or referenced in the advertisement, if applicable. Null for issue advocacy ads without candidate reference.']
  compliance_notes varchar [note: 'Free-text field for documenting compliance issues, remediation actions, equal opportunities requests, reasonable access determinations, or other regulatory notes related to this political ad placement.']
  compliance_status varchar [note: 'Current regulatory compliance status of this political ad record indicating whether all FCC political broadcasting requirements have been met.']
  created_timestamp timestamp [note: 'Timestamp when this political ad compliance record was first created in the system. Part of audit trail for regulatory record-keeping.']
  daypart varchar [note: 'Broadcast daypart segment during which the ad aired (e.g., Prime Time, Early Morning, Late Fringe). Used for rate class determination and Lowest Unit Charge (LUC) comparison.']
  election_date date [note: 'Scheduled date of the election to which this political advertisement relates. Critical for determining Lowest Unit Charge (LUC) period applicability (45 days before primary, 60 days before general election).']
  election_type varchar [note: 'Type of election for which the political advertisement is being aired.']
  equal_opportunities_request_flag boolean [note: 'Indicates whether this ad placement was triggered by an equal opportunities request under Section 315 of the Communications Act, requiring equal treatment of opposing candidates.']
  isci_code varchar [note: 'Industry Standard Commercial Identification code uniquely identifying the creative asset aired. Standard 12-character alphanumeric code used for ad tracking and affidavit verification.']
  jurisdiction_level varchar [note: 'Governmental jurisdiction level of the race or ballot measure (federal, state, or local) for compliance categorization and public file organization.']
  last_modified_timestamp timestamp [note: 'Timestamp of the most recent update to this political ad compliance record. Tracks changes for audit and compliance verification purposes.']
  luc_period_flag boolean [note: 'Indicates whether this ad aired during the Lowest Unit Charge (LUC) period (45 days before primary or 60 days before general election) when special rate protections apply to candidate ads.']
  luc_rate decimal(15,2) [note: 'The lowest unit charge rate applicable to this spot based on the rate class and daypart during the pre-election window (45 days before primary, 60 days before general election). Null if outside LUC period.']
  makegood_flag boolean [note: 'Indicates whether this ad spot is a compensatory makegood placement provided due to a previous preemption or technical failure.']
  market_name varchar [note: 'Designated Market Area (DMA) or Nielsen market name where the political advertisement aired. Used for geographic compliance tracking.']
  office_sought varchar [note: 'The elected office or ballot measure that the political advertisement relates to (e.g., President, U.S. Senate, Governor, State Representative, Proposition 22).']
  preemption_flag boolean [note: 'Indicates whether this scheduled political ad spot was preempted and did not air as originally scheduled. Triggers makegood obligations.']
  program_name varchar [note: 'Name of the television or radio program during which the political advertisement aired. Required for public file disclosure.']
  public_file_disclosure_date date [note: 'Date when this political ad record was uploaded to the stations online public inspection file as required by FCC rules. Must occur immediately upon ad placement.']
  rate_charged decimal(15,2) [note: 'Actual dollar amount charged to the political advertiser for this spot placement. Must comply with Lowest Unit Charge (LUC) requirements during pre-election windows.']
  rate_class varchar [note: 'Commercial rate classification applied to this spot (e.g., Fixed, Preemptible-1, Preemptible-2, Run-of-Schedule). Determines Lowest Unit Charge (LUC) eligibility and comparison group.']
  reasonable_access_request_flag boolean [note: 'Indicates whether this ad placement was the result of a federal candidate reasonable access request under Section 312(a)(7) of the Communications Act, requiring broadcasters to provide reasonable access to federal candidates.']
  sponsor_address varchar [note: 'Mailing address of the political advertiser or sponsor. Required for public inspection file disclosure.']
  sponsor_contact_name varchar [note: 'Name of the individual or organization contact person responsible for the political advertisement purchase. Required for public file records.']
  sponsor_email varchar [note: 'Email address of the political advertiser or sponsor contact for correspondence and compliance communication.']
  sponsor_phone varchar [note: 'Contact telephone number for the political advertiser or sponsor. Required for public file records.']
  sponsorship_identification varchar [note: 'The on-air sponsorship disclosure statement identifying who paid for the advertisement (e.g., \'Paid for by Committee to Elect Jane Smith\'). Required by FCC sponsorship identification rules.']
  spot_length_seconds varchar [note: 'Duration of the political advertisement spot in seconds (e.g., 15, 30, 60, 120). Used for rate calculation and inventory management.']

  Note: 'Compliance record for political advertising under FCC political broadcasting rules (47 CFR §73.1940, §73.1941, §73.1942). Tracks candidate or issue advertiser, federal/state/local race, lowest unit charge (LUC) rate applied, equal opportunities requests, reasonable access requests, sponsorship identification, air date and time, and public file disclosure. Mandatory for all FCC-licensed stations during election periods.'
}

Table compliance.regulatory_obligation {
  regulatory_obligation_id varchar [pk, note: 'Unique identifier for the regulatory obligation record. Primary key.']
  superseded_by_obligation_regulatory_obligation_id varchar [note: 'Reference to the regulatory obligation that supersedes this one, if applicable. Null if not superseded.']
  applicability_scope varchar [note: 'Business units, platforms, or services to which this obligation applies (e.g., linear TV, OTT platforms, radio, digital publishers, SVOD services, AVOD platforms, FAST channels).']
  audit_trail_required boolean [note: 'Indicates whether an audit trail of compliance activities and decisions must be maintained for this obligation.']
  automation_status varchar [note: 'Degree to which compliance monitoring and reporting for this obligation is automated: manual, partially automated, fully automated, or not applicable.']
  compliance_frequency varchar [note: 'How often compliance with this obligation must be demonstrated or reported: ongoing (continuous), annual, quarterly, monthly, event-driven (triggered by specific events), or biennial.']
  compliance_status varchar [note: 'Current compliance status of the organization with respect to this obligation: compliant, non-compliant, in progress, not applicable, under review, or remediation required.']
  created_timestamp timestamp [note: 'Timestamp when this regulatory obligation record was first created in the system.']
  documentation_required boolean [note: 'Indicates whether formal documentation, records, or evidence must be maintained to demonstrate compliance with this obligation.']
  documentation_retention_years varchar [note: 'Number of years that compliance documentation must be retained, as mandated by the regulation or internal policy.']
  effective_date date [note: 'Date when this regulatory obligation became or becomes effective and enforceable.']
  expiration_date date [note: 'Date when this obligation expires or is superseded, if applicable. Null for ongoing obligations.']
  external_reporting_required boolean [note: 'Indicates whether compliance with this obligation requires formal reporting or filing to an external regulatory body.']
  filing_deadline_description varchar [note: 'Human-readable description of the filing deadline (e.g., \'April 1 annually\', \'10 days after broadcast\', \'within 30 days of license expiration\').']
  filing_deadline_type varchar [note: 'Type of deadline for compliance filing or reporting: fixed date (specific calendar date), rolling (X days from event), event-based (triggered by business event), or not applicable.']
  is_active boolean [note: 'Indicates whether this regulatory obligation is currently active and enforceable. False if the obligation has been superseded, repealed, or is no longer applicable.']
  jurisdiction varchar [note: 'Geographic jurisdiction where this obligation applies, using 3-letter ISO country code (e.g., USA, GBR, DEU) or regional code (e.g., EUR for EU-wide regulations).']
  last_compliance_review_date date [note: 'Date when compliance with this obligation was last reviewed or assessed.']
  last_modified_timestamp timestamp [note: 'Timestamp when this regulatory obligation record was last updated or modified.']
  maximum_penalty_amount decimal(18,2) [note: 'Maximum monetary penalty or fine amount that can be imposed for non-compliance, in the currency specified.']
  monitoring_system varchar [note: 'Name of the system or tool used to monitor compliance with this obligation (e.g., GRC platform, compliance management system, manual tracking).']
  next_compliance_review_date date [note: 'Scheduled date for the next compliance review or assessment of this obligation.']
  notes varchar [note: 'Additional notes, comments, or context about this regulatory obligation, including implementation guidance or special considerations.']
  obligation_code varchar [note: 'Unique business identifier code for the regulatory obligation, used for external reference and reporting.']
  obligation_description varchar [note: 'Detailed description of the regulatory obligation, including what must be done, reported, or maintained to achieve compliance.']
  obligation_name varchar [note: 'Short descriptive name of the regulatory obligation.']
  obligation_type varchar [note: 'Category of regulatory obligation: licensing (broadcast licenses, spectrum), content standards (ratings, COPPA), data privacy (GDPR, CCPA), financial reporting (SOX), accessibility (closed captioning), or technical standards (ATSC, DVB).']
  penalty_currency varchar [note: 'Currency code for the penalty amount, using ISO 4217 3-letter code (e.g., USD, GBP, EUR).']
  penalty_description varchar [note: 'Description of penalties, fines, or sanctions that may be imposed for non-compliance with this obligation.']
  public_disclosure_required boolean [note: 'Indicates whether compliance information or related documents must be made publicly available (e.g., in FCC Online Public Inspection File).']
  regulation_name varchar [note: 'Full name of the regulation, law, or standard that mandates this obligation (e.g., Communications Act Section 73, GDPR Article 30, SOX Section 404).']
  regulation_reference_number varchar [note: 'Official citation or reference number of the regulation (e.g., 47 CFR 73.3526, GDPR Art. 30, SOX §404).']
  regulatory_body varchar [note: 'Name of the governing body or agency that enforces this obligation (e.g., FCC, Ofcom, European Audiovisual Observatory, MPA, Nielsen, IAB, SCTE, ISO).']
  responsible_department varchar [note: 'Department or business unit accountable for this obligation (e.g., Legal, Compliance, Broadcast Operations, Finance, IT Security).']
  risk_level varchar [note: 'Assessed risk level of non-compliance with this obligation, based on potential business impact, regulatory scrutiny, and penalty severity.']

  Note: 'Master catalog of all regulatory obligations applicable to the organization, mapped to specific regulations, governing bodies, and business units. Captures obligation type, regulation name, regulatory body, jurisdiction, obligation description, applicability scope (linear TV, OTT, radio, digital), compliance frequency (ongoing, annual, quarterly, event-driven), responsible owner, and current compliance status. Serves as the compliance obligation register.'
}

