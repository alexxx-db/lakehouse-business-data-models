ind:testDate rdf:type rdf:Property ;
    rdfs:label 'Test Date' ;
    rdfs:comment 'Date test was performed. Ref: Sensus AMI.' ;
    rdfs:domain ind:AccuracyTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:testEquipmentCalibrationDate rdf:type rdf:Property ;
    rdfs:label 'Test Equipment Calibration Date' ;
    rdfs:comment 'Calibration date of test equipment. Ref: Sensus AMI.' ;
    rdfs:domain ind:AccuracyTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:testFlowRateGpm rdf:type rdf:Property ;
    rdfs:label 'Test Flow Rate Gpm' ;
    rdfs:comment 'The test flow rate gpm value recorded for each accuracy test in the metering domain.' ;
    rdfs:domain ind:AccuracyTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:testLocation rdf:type rdf:Property ;
    rdfs:label 'Test Location' ;
    rdfs:comment 'The test location value recorded for each accuracy test in the metering domain.' ;
    rdfs:domain ind:AccuracyTest ;
    rdf:type owl:DatatypeProperty ;
