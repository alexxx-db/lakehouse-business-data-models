ind:applicantPersonId rdf:type rdf:Property ;
    rdfs:label 'Applicant Person Id' ;
    rdfs:comment 'Foreign key linking to customer.person. Business justification: Service applications capture applicant details that should reference the person master record. This eliminates data duplication and ensures applicant identity is properly managed. The person table con. Ref: AWWA.' ;
    rdfs:domain ind:ServiceApplication ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Person .

ind:primaryServiceCustomerAccountId rdf:type rdf:Property ;
    rdfs:label 'Primary Service Customer Account Id' ;
    rdfs:comment 'Reference to the customer (applicant) who submitted this service application. Links to the customer master record. Ref: AWWA.' ;
    rdfs:domain ind:ServiceApplication ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CustomerAccount .

ind:resultingServiceAgreementId rdf:type rdf:Property ;
    rdfs:label 'Resulting Service Agreement Id' ;
    rdfs:comment 'Foreign key linking to customer.service_agreement. Business justification: A service application, once approved, results in the creation of a service agreement. Linking service_application to the resulting service_agreement captures the full customer lifecycle from applicati' ;
    rdfs:domain ind:ServiceApplication ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ServiceAgreement .

ind:servingFacilityId rdf:type rdf:Property ;
    rdfs:label 'Serving Facility Id' ;
    rdfs:comment 'Foreign key linking to treatment.facility. Business justification: New service connection approval requires verifying which treatment facility will serve the premise and confirming available capacity (design_capacity_mgd vs current_avg_flow_mgd). Capacity planning an' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Facility .

ind:sewerServiceConnectionId rdf:type rdf:Property ;
    rdfs:label 'Sewer Service Connection Id' ;
    rdfs:comment 'Foreign key linking to wastewater.sewer_service_connection. Business justification: A sewer service application, when approved, results in creation of a sewer_service_connection. Linking the application to the resulting connection supports new service provisioning workflows, connecti' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SewerServiceConnection .

ind:applicationNumber rdf:type rdf:Property ;
    rdfs:label 'Application Number' ;
    rdfs:comment 'Externally-visible unique application number assigned when the customer submits a service application. Used for customer communication and tracking. Ref: AWWA.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicationStatus rdf:type rdf:Property ;
    rdfs:label 'Application Status' ;
    rdfs:comment 'Current lifecycle status of the service application: submitted (initial state), under review (being processed by utility staff), approved (ready for service establishment), rejected (application denied), withdrawn (applicant cancelled), or pending payment (awaiting deposit or connection fee). Ref: AWWA.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicationType rdf:type rdf:Property ;
    rdfs:label 'Application Type' ;
    rdfs:comment 'Type of service application: new service establishment, transfer of service to new occupant, service upgrade (larger meter or additional service), service downgrade, service termination, or reconnection after disconnection. Ref: AWWA.' ;
    rdfs:domain ind:ServiceApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvalDate rdf:type rdf:Property ;
    rdfs:label 'Approval Date' ;
    rdfs:comment 'Date when the service application was approved by the utility, authorizing service establishment. Ref: AWWA.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:approvalTimestamp rdf:type rdf:Property ;
    rdfs:label 'Approval Timestamp' ;
    rdfs:comment 'Precise date and time when the service application was approved. Ref: AWWA.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:connectionFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Connection Fee Amount' ;
    rdfs:comment 'One-time connection or service establishment fee charged to the applicant for initiating water or wastewater service at the premise. Ref: AWWA.' ;
    rdfs:domain ind:ServiceApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:creditCheckResult rdf:type rdf:Property ;
    rdfs:label 'Credit Check Result' ;
    rdfs:comment 'Outcome of the credit check: pass (credit meets utility standards), fail (credit does not meet standards, deposit required), insufficient history (no credit history available), or not applicable (credit check not performed). Ref: AWWA.' ;
    rdfs:domain ind:ServiceApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:creditCheckStatus rdf:type rdf:Property ;
    rdfs:label 'Credit Check Status' ;
    rdfs:comment 'Status of credit check for the applicant: not required (based on service class or policy), pending (credit check requested), completed (credit check results received), or waived (credit check requirement waived by management). Ref: AWWA.' ;
    rdfs:domain ind:ServiceApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:creditScore rdf:type rdf:Property ;
    rdfs:label 'Credit Score' ;
    rdfs:comment 'Numeric credit score obtained from credit bureau for the applicant, used to determine deposit requirements and service approval. Ref: AWWA.' ;
    rdfs:domain ind:ServiceApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:meterSizeRequested rdf:type rdf:Property ;
    rdfs:label 'Meter Size Requested' ;
    rdfs:comment 'Size of water meter requested by the applicant or recommended by utility staff based on anticipated usage (e.g., 5/8 inch, 3/4 inch, 1 inch, 1.5 inch, 2 inch, etc.). Ref: AWWA.' ;
    rdfs:domain ind:ServiceApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:processingNotes rdf:type rdf:Property ;
    rdfs:label 'Processing Notes' ;
    rdfs:comment 'Free-text notes entered by utility staff during application review and processing, documenting special circumstances, follow-up actions, or additional context. Ref: AWWA.' ;
    rdfs:domain ind:ServiceApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rejectionDate rdf:type rdf:Property ;
    rdfs:label 'Rejection Date' ;
    rdfs:comment 'Date when the service application was rejected by the utility. Null if application was not rejected. Ref: AWWA.' ;
    rdfs:domain ind:ServiceApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:rejectionReason rdf:type rdf:Property ;
    rdfs:label 'Rejection Reason' ;
    rdfs:comment 'Detailed explanation of why the service application was rejected (e.g., failed credit check, incomplete documentation, service not available at address, outstanding balance from previous account). Ref: AWWA.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rejectionReasonCode rdf:type rdf:Property ;
    rdfs:label 'Rejection Reason Code' ;
    rdfs:comment 'Standardized code categorizing the reason for application rejection: credit failure, incomplete documentation, service unavailable at location, outstanding balance from prior account, duplicate application, or invalid service address. Ref: AWWA.' ;
    rdfs:domain ind:ServiceApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestedServiceStartDate rdf:type rdf:Property ;
    rdfs:label 'Requested Service Start Date' ;
    rdfs:comment 'Date when the applicant requests water or wastewater service to begin at the service address. Ref: AWWA.' ;
    rdfs:domain ind:ServiceApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reviewCompletedDate rdf:type rdf:Property ;
    rdfs:label 'Review Completed Date' ;
    rdfs:comment 'Date when the application review process was completed and a decision (approved or rejected) was made. Ref: AWWA.' ;
    rdfs:domain ind:ServiceApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reviewStartDate rdf:type rdf:Property ;
    rdfs:label 'Review Start Date' ;
    rdfs:comment 'Date when utility staff began reviewing and processing the service application. Ref: AWWA.' ;
    rdfs:domain ind:ServiceApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:serviceClassRequested rdf:type rdf:Property ;
    rdfs:label 'Service Class Requested' ;
    rdfs:comment 'Customer segment or service class requested: residential (single-family or multi-family), commercial (retail, office), industrial (manufacturing, processing), municipal (government facilities), agricultural (irrigation, livestock), or institutional (schools, hospitals). Ref: AWWA.' ;
    rdfs:domain ind:ServiceApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceTypeRequested rdf:type rdf:Property ;
    rdfs:label 'Service Type Requested' ;
    rdfs:comment 'Type of utility service requested by the applicant: water only, wastewater (sewer) only, or combined water and wastewater service. Ref: AWWA.' ;
    rdfs:domain ind:ServiceApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:slaDueDate rdf:type rdf:Property ;
    rdfs:label 'Sla Due Date' ;
    rdfs:comment 'Target date by which the application should be reviewed and processed according to utility service level agreement standards. Ref: AWWA.' ;
    rdfs:domain ind:ServiceApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:submissionChannel rdf:type rdf:Property ;
    rdfs:label 'Submission Channel' ;
    rdfs:comment 'Channel through which the customer submitted the service application: online customer portal, phone call to customer service, walk-in at utility office, postal mail, mobile app, or email. Ref: AWWA.' ;
    rdfs:domain ind:ServiceApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submissionDate rdf:type rdf:Property ;
    rdfs:label 'Submission Date' ;
    rdfs:comment 'Date when the customer submitted the service application. Ref: AWWA.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:submissionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Submission Timestamp' ;
    rdfs:comment 'Precise date and time when the service application was submitted by the customer or entered into the system. Ref: AWWA.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:withdrawnDate rdf:type rdf:Property ;
    rdfs:label 'Withdrawn Date' ;
    rdfs:comment 'Date when the applicant withdrew or cancelled the service application. Null if application was not withdrawn. Ref: AWWA.' ;
    rdfs:domain ind:ServiceApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:withdrawnReason rdf:type rdf:Property ;
    rdfs:label 'Withdrawn Reason' ;
    rdfs:comment 'Reason provided by the applicant for withdrawing the service application (e.g., changed mind, moved to different location, service no longer needed). Ref: AWWA.' ;
    rdfs:domain ind:ServiceApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interactionId rdf:type rdf:Property ;
    rdfs:label 'Interaction Id' ;
    rdfs:comment 'Unique identifier for each customer interaction record. Primary key. Ref: AWWA.' ;
    rdfs:domain ind:Interaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:contactPersonId rdf:type rdf:Property ;
    rdfs:label 'Contact Person Id' ;
    rdfs:comment 'Foreign key linking to customer.person. Business justification: Customer interactions capture contact details that should reference the person master when the contact is a known person. This eliminates duplication of person contact information. Nullable as some in. Ref: AWWA.' ;
    rdfs:domain ind:Interaction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Person .

ind:highUsageAlertId rdf:type rdf:Property ;
    rdfs:label 'High Usage Alert Id' ;
    rdfs:comment 'Foreign key linking to metering.high_usage_alert. Business justification: Customer service interactions are frequently initiated when a customer calls about a high-usage alert notification (high bill, suspected leak). Linking the interaction to the triggering alert supports' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:HighUsageAlert .

ind:hydrantId rdf:type rdf:Property ;
    rdfs:label 'Hydrant Id' ;
    rdfs:comment 'Foreign key linking to distribution.hydrant. Business justification: Customer reports about hydrant problems (leaking, damaged, blocked access, vandalism) reference specific hydrant assets. Enables tracking of public-reported hydrant defects, prioritizing inspection/re. Ref: AWWA.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Hydrant .

ind:invoiceId rdf:type rdf:Property ;
    rdfs:label 'Invoice Id' ;
    rdfs:comment 'Foreign key linking to billing.invoice. Business justification: Customer service interactions (billing dispute calls, high-bill inquiries) reference a specific invoice. Direct FK enables billing dispute resolution workflow, first-contact resolution tracking, and r' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Invoice .

ind:networkValveId rdf:type rdf:Property ;
    rdfs:label 'Network Valve Id' ;
    rdfs:comment 'Foreign key linking to distribution.network_valve. Business justification: Customer reports about valve issues (leaking valve box, exposed valve, damaged cover) reference specific valve assets. Enables public-sourced defect identification, prioritizes valve maintenance, and. Ref: AWWA.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:NetworkValve .

ind:paymentId rdf:type rdf:Property ;
    rdfs:label 'Payment Id' ;
    rdfs:comment 'Foreign key linking to billing.payment. Business justification: Customer interactions about payment confirmations, NSF fee disputes, and payment reversal inquiries reference a specific payment record. Direct FK enables payment dispute resolution tracking, customer' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Payment .

ind:accessibilityAccommodation rdf:type rdf:Property ;
    rdfs:label 'Accessibility Accommodation' ;
    rdfs:comment 'Description of any accessibility accommodations provided during the interaction (e.g., TTY, large print, sign language). Null if no accommodation was required. Ref: AWWA.' ;
    rdfs:domain ind:Interaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agentName rdf:type rdf:Property ;
    rdfs:label 'Agent Name' ;
    rdfs:comment 'Full name of the customer service agent who handled the interaction. Null for self-service interactions. Ref: AWWA.' ;
    rdfs:domain ind:Interaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:callbackCompletedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Callback Completed Timestamp' ;
    rdfs:comment 'Date and time when the requested callback was completed. Null if callback was not requested or not yet completed. Ref: AWWA.' ;
    rdfs:domain ind:Interaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:callbackRequestedFlag rdf:type rdf:Property ;
    rdfs:label 'Callback Requested Flag' ;
    rdfs:comment 'Indicates whether the customer requested a callback from the utility. Ref: AWWA.' ;
    rdfs:domain ind:Interaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:caseNumber rdf:type rdf:Property ;
    rdfs:label 'Case Number' ;
    rdfs:comment 'Reference to a formal case or complaint record created in the CRM system as a result of this interaction. Null if no case was created. Ref: AWWA.' ;
    rdfs:domain ind:Interaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:channel rdf:type rdf:Property ;
    rdfs:label 'Channel' ;
    rdfs:comment 'Channel through which the interaction occurred: inbound call, outbound call, web portal, mobile app, email, chat, walk-in visit, IVR self-service, or SMS. [ENUM-REF-CANDIDATE: inbound_call|outbound_call|web_portal|mobile_app|email|chat|walk_in|ivr|sms — 9 candidates stripped; promote to reference product]. Ref: AWWA.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:closedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Closed Timestamp' ;
    rdfs:comment 'Date and time when the interaction was formally closed. Null if interaction is not yet closed. Ref: AWWA.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:customerSatisfactionScore rdf:type rdf:Property ;
    rdfs:label 'Customer Satisfaction Score' ;
    rdfs:comment 'Customer satisfaction rating provided by the customer after the interaction, typically on a scale of 1 to 5. Null if not captured. Ref: AWWA.' ;
    rdfs:domain ind:Interaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:durationSeconds rdf:type rdf:Property ;
    rdfs:label 'Duration Seconds' ;
    rdfs:comment 'Total duration of the interaction in seconds, applicable primarily to call and chat channels. Null for asynchronous channels like email. Ref: AWWA.' ;
    rdfs:domain ind:Interaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:escalationFlag rdf:type rdf:Property ;
    rdfs:label 'Escalation Flag' ;
    rdfs:comment 'Indicates whether the interaction was escalated to a supervisor, specialist, or higher tier of support.' ;
    rdfs:domain ind:Interaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:escalationReason rdf:type rdf:Property ;
    rdfs:label 'Escalation Reason' ;
    rdfs:comment 'Reason for escalating the interaction, such as complex technical issue, customer dissatisfaction, or policy exception required. Null if not escalated. Ref: AWWA.' ;
    rdfs:domain ind:Interaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:firstContactResolutionFlag rdf:type rdf:Property ;
    rdfs:label 'First Contact Resolution Flag' ;
    rdfs:comment 'Indicates whether the interaction was resolved during the first contact without requiring follow-up. Key customer service performance indicator. Ref: AWWA.' ;
    rdfs:domain ind:Interaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:interactionNumber rdf:type rdf:Property ;
    rdfs:label 'Interaction Number' ;
    rdfs:comment 'Business-facing unique identifier for the interaction, used for tracking and reference in customer communications. Ref: AWWA.' ;
    rdfs:domain ind:Interaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interactionStatus rdf:type rdf:Property ;
    rdfs:label 'Interaction Status' ;
    rdfs:comment 'Current lifecycle status of the interaction: open, in progress, pending customer response, pending internal action, resolved, closed, or cancelled. [ENUM-REF-CANDIDATE: open|in_progress|pending_customer|pending_internal|resolved|closed|cancelled — 7 candidates stripped; promote to reference product]. Ref: AWWA.' ;
    rdfs:domain ind:Interaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interactionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Interaction Timestamp' ;
    rdfs:comment 'Date and time when the interaction was initiated or received by the utility. Primary business event timestamp for the interaction. Ref: AWWA.' ;
    rdfs:domain ind:Interaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:interactionType rdf:type rdf:Property ;
    rdfs:label 'Interaction Type' ;
    rdfs:comment 'Classification of the interaction purpose: billing inquiry, service request, complaint, outage report, payment arrangement, or general inquiry. Ref: AWWA.' ;
    rdfs:domain ind:Interaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interpreterRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Interpreter Required Flag' ;
    rdfs:comment 'Indicates whether a language interpreter was required or used during the interaction. Ref: AWWA.' ;
    rdfs:domain ind:Interaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:languageCode rdf:type rdf:Property ;
    rdfs:label 'Language Code' ;
    rdfs:comment 'Three-letter ISO 639-2 language code indicating the language used during the interaction. [ENUM-REF-CANDIDATE: ENG|SPA|FRE|CHI|VIE|KOR|RUS|ARA|POR|GER — 10 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Interaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:netPromoterScore rdf:type rdf:Property ;
    rdfs:label 'Net Promoter Score' ;
    rdfs:comment 'Net Promoter Score provided by the customer, typically on a scale of 0 to 10, measuring likelihood to recommend the utility. Null if not captured. Ref: AWWA.' ;
    rdfs:domain ind:Interaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:priority rdf:type rdf:Property ;
    rdfs:label 'Priority' ;
    rdfs:comment 'Priority level assigned to the interaction based on urgency and impact: low, medium, high, urgent, or critical. Ref: AWWA.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resolutionNotes rdf:type rdf:Property ;
    rdfs:label 'Resolution Notes' ;
    rdfs:comment 'Detailed notes documenting the resolution provided, actions taken, and any follow-up required. Populated when interaction is resolved or closed. Ref: AWWA.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resolutionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Resolution Timestamp' ;
    rdfs:comment 'Date and time when the interaction was marked as resolved. Null if interaction is still open or in progress. Ref: AWWA.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:sourceSystemCode rdf:type rdf:Property ;
    rdfs:label 'Source System Code' ;
    rdfs:comment 'Unique identifier of the interaction record in the source system, used for traceability and reconciliation. Ref: AWWA.' ;
    rdfs:domain ind:Interaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subcategory rdf:type rdf:Property ;
    rdfs:label 'Subcategory' ;
    rdfs:comment 'Detailed subcategory within the interaction category, providing granular classification for analytics (e.g., high bill inquiry, leak report, water pressure issue). Ref: AWWA.' ;
    rdfs:domain ind:Customer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subject rdf:type rdf:Property ;
    rdfs:label 'Subject' ;
    rdfs:comment 'Brief subject or title summarizing the purpose or topic of the interaction. Ref: AWWA.' ;
    rdfs:domain ind:Interaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surveyCompletedFlag rdf:type rdf:Property ;
    rdfs:label 'Survey Completed Flag' ;
    rdfs:comment 'Indicates whether the customer completed a post-interaction satisfaction survey. Ref: AWWA.' ;
    rdfs:domain ind:Interaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:complaintId rdf:type rdf:Property ;
    rdfs:label 'Complaint Id' ;
    rdfs:comment 'Unique identifier for the customer complaint record. Primary key. Ref: AWWA.' ;
    rdfs:domain ind:Complaint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:accuracyTestId rdf:type rdf:Property ;
    rdfs:label 'Accuracy Test Id' ;
    rdfs:comment 'Foreign key linking to metering.accuracy_test. Business justification: Customer complaints about meter accuracy or billing disputes directly trigger meter accuracy tests (accuracy_test.complaint_triggered flag confirms this process). Linking complaint to the resulting ac' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AccuracyTest .

ind:originatingInteractionId rdf:type rdf:Property ;
    rdfs:label 'Originating Interaction Id' ;
    rdfs:comment 'Foreign key linking to customer.interaction. Business justification: A customer complaint is typically initiated through a customer interaction (phone call, in-person visit, online submission). Linking customer_complaint to the originating interaction via originating_i' ;
    rdfs:domain ind:Complaint ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Interaction .

ind:primaryCustomerAccountId rdf:type rdf:Property ;
    rdfs:label 'Primary Customer Account Id' ;
    rdfs:comment 'Reference to the customer account associated with this complaint. Ref: AWWA.' ;
    rdfs:domain ind:Complaint ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CustomerAccount .

ind:reportedByPersonId rdf:type rdf:Property ;
    rdfs:label 'Reported By Person Id' ;
    rdfs:comment 'Foreign key linking to customer.person. Business justification: Complaints capture reporter details that should reference the person master when the reporter is a known person. This eliminates duplication and enables proper reporter tracking. Nullable as some comp. Ref: AWWA.' ;
    rdfs:domain ind:Complaint ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Person .

ind:sewerNetworkId rdf:type rdf:Property ;
    rdfs:label 'Sewer Network Id' ;
    rdfs:comment 'Foreign key linking to wastewater.sewer_network. Business justification: Complaints about sewer odors, backups, or overflows must be mapped to the specific sewer network segment for infrastructure condition analysis, maintenance prioritization, and SSO risk reporting. Mirr' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SewerNetwork .

ind:triggeringHighUsageAlertId rdf:type rdf:Property ;
    rdfs:label 'Triggering High Usage Alert Id' ;
    rdfs:comment 'Foreign key linking to metering.high_usage_alert. Business justification: A high-usage alert frequently generates a customer complaint (high bill dispute, suspected leak). Linking the complaint directly to the alert that triggered it closes the alert-to-complaint lifecycle,' ;
    rdfs:domain ind:Complaint ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:HighUsageAlert .

ind:waterSampleId rdf:type rdf:Property ;
    rdfs:label 'Water Sample Id' ;
    rdfs:comment 'Foreign key linking to quality.water_sample. Business justification: Complaint-driven sampling is a named operational workflow: when a customer reports taste, odor, or color issues, the utility collects a water sample at the premise. Direct FK enables complaint-to-samp' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:WaterSample .

ind:wtpFacilityId rdf:type rdf:Property ;
    rdfs:label 'Wtp Facility Id' ;
    rdfs:comment 'Foreign key linking to treatment.facility. Business justification: Water quality complaints require facility-specific investigation and operator response. Linking complaints to serving facility enables proper routing to facility operators, coordinated sampling, and f. Ref: AWWA.' ;
    rdfs:domain ind:Complaint ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Facility .

ind:actualResolutionDate rdf:type rdf:Property ;
    rdfs:label 'Actual Resolution Date' ;
    rdfs:comment 'Actual date when the complaint was resolved and closed. Ref: AWWA.' ;
    rdfs:domain ind:Complaint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:assignedDate rdf:type rdf:Property ;
    rdfs:label 'Assigned Date' ;
    rdfs:comment 'Date when the complaint was assigned to a resolution owner. Ref: AWWA.' ;
    rdfs:domain ind:Complaint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:assignedToDepartment rdf:type rdf:Property ;
    rdfs:label 'Assigned To Department' ;
    rdfs:comment 'Department or functional area responsible for resolving the complaint, such as Customer Service, Water Quality, Distribution Operations and Maintenance (O&M), Billing, or Laboratory. Ref: AWWA.' ;
    rdfs:domain ind:Complaint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingAdjustmentAmount rdf:type rdf:Property ;
    rdfs:label 'Billing Adjustment Amount' ;
    rdfs:comment 'Dollar amount of billing adjustment or credit issued to the customer as a result of the complaint resolution, if applicable. Ref: AWWA.' ;
    rdfs:domain ind:Complaint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:compensationProvidedFlag rdf:type rdf:Property ;
    rdfs:label 'Compensation Provided Flag' ;
    rdfs:comment 'Indicates whether any form of compensation, credit, or goodwill gesture was provided to the customer as part of the complaint resolution. Ref: AWWA.' ;
    rdfs:domain ind:Complaint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:complaintNumber rdf:type rdf:Property ;
    rdfs:label 'Complaint Number' ;
    rdfs:comment 'Externally visible unique complaint tracking number assigned by the Customer Information System (CIS) or Customer Care and Billing (CC&B) system. Ref: AWWA.' ;
    rdfs:domain ind:Complaint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complaintStatus rdf:type rdf:Property ;
    rdfs:label 'Complaint Status' ;
    rdfs:comment 'Current lifecycle status of the complaint in the resolution workflow. [ENUM-REF-CANDIDATE: open|in_progress|pending_customer|pending_investigation|resolved|closed|escalated|withdrawn — 8 candidates stripped; promote to reference product]. Ref: AWWA.' ;
    rdfs:domain ind:Complaint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactMethod rdf:type rdf:Property ;
    rdfs:label 'Contact Method' ;
    rdfs:comment 'Channel through which the complaint was received by the utility. [ENUM-REF-CANDIDATE: phone|email|web_portal|mobile_app|in_person|mail|social_media — 7 candidates stripped; promote to reference product]. Ref: AWWA.' ;
    rdfs:domain ind:Complaint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:correctiveAction rdf:type rdf:Property ;
    rdfs:label 'Corrective Action' ;
    rdfs:comment 'Specific corrective action taken to address the root cause and prevent recurrence, such as infrastructure repair, meter replacement, billing adjustment, or process improvement. Ref: AWWA.' ;
    rdfs:domain ind:Complaint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:customerSatisfactionComments rdf:type rdf:Property ;
    rdfs:label 'Customer Satisfaction Comments' ;
    rdfs:comment 'Free-text feedback provided by the customer regarding their satisfaction with the complaint resolution process and outcome. Ref: AWWA.' ;
    rdfs:domain ind:Complaint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:customerSatisfactionRating rdf:type rdf:Property ;
    rdfs:label 'Customer Satisfaction Rating' ;
    rdfs:comment 'Customer satisfaction score provided by the customer after complaint resolution, typically on a scale of 1 to 5 or 1 to 10. Ref: AWWA.' ;
    rdfs:domain ind:Complaint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:followUpDate rdf:type rdf:Property ;
    rdfs:label 'Follow Up Date' ;
    rdfs:comment 'Scheduled date for follow-up action or customer contact to verify sustained resolution. Ref: AWWA.' ;
    rdfs:domain ind:Complaint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:followUpRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Follow Up Required Flag' ;
    rdfs:comment 'Indicates whether additional follow-up action or monitoring is required after initial complaint resolution. Ref: AWWA.' ;
    rdfs:domain ind:Complaint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:internalNotes rdf:type rdf:Property ;
    rdfs:label 'Internal Notes' ;
    rdfs:comment 'Internal notes and comments for staff use, not visible to the customer, documenting investigation steps, coordination with other departments, and operational context. Ref: AWWA.' ;
    rdfs:domain ind:Complaint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryAgency rdf:type rdf:Property ;
    rdfs:label 'Regulatory Agency' ;
    rdfs:comment 'Name of the regulatory agency involved if the complaint was escalated, such as state Department of Environmental Quality, Public Utilities Commission (PUC), or U.S. Environmental Protection Agency (EPA). Ref: AWWA.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryCaseNumber rdf:type rdf:Property ;
    rdfs:label 'Regulatory Case Number' ;
    rdfs:comment 'Case or reference number assigned by the regulatory agency for tracking the escalated complaint. Ref: AWWA.' ;
    rdfs:domain ind:Complaint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryEscalationFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Escalation Flag' ;
    rdfs:comment 'Indicates whether the complaint was escalated to or originated from a regulatory agency such as state primacy agency, Public Utilities Commission (PUC), or U.S. Environmental Protection Agency (EPA). Ref: AWWA.' ;
    rdfs:domain ind:Complaint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryResponseDueDate rdf:type rdf:Property ;
    rdfs:label 'Regulatory Response Due Date' ;
    rdfs:comment 'Date by which the utility must provide a formal response to the regulatory agency regarding the escalated complaint. Ref: AWWA.' ;
    rdfs:domain ind:Complaint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reportedDate rdf:type rdf:Property ;
    rdfs:label 'Reported Date' ;
    rdfs:comment 'Date when the complaint was first reported to the utility by the customer. Ref: AWWA.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Reported Timestamp' ;
    rdfs:comment 'Precise date and time when the complaint was logged into the system, including time zone offset. Ref: AWWA.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:resolutionDescription rdf:type rdf:Property ;
    rdfs:label 'Resolution Description' ;
    rdfs:comment 'Detailed narrative of the actions taken to resolve the complaint, including investigation findings, corrective actions, and customer communication. Ref: AWWA.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rootCause rdf:type rdf:Property ;
    rdfs:label 'Root Cause' ;
    rdfs:comment 'Identified root cause of the complaint issue, such as main break, meter malfunction, billing system error, water treatment process deviation, or customer misunderstanding. Ref: AWWA.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ssotRole rdf:type rdf:Property ;
    rdfs:label 'Ssot Role' ;
    rdfs:comment 'SSOT cross-domain reconciliation link. Ref: AWWA.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetResolutionDate rdf:type rdf:Property ;
    rdfs:label 'Target Resolution Date' ;
    rdfs:comment 'Target date by which the complaint should be resolved, based on Service Level Agreement (SLA) commitments and regulatory requirements. Ref: AWWA.' ;
    rdfs:domain ind:Complaint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:waterQualityTestRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Water Quality Test Required Flag' ;
    rdfs:comment 'Indicates whether a water quality test was required or performed as part of the complaint investigation, particularly for complaints involving taste, odor, discoloration, or suspected contamination. Ref: AWWA.' ;
    rdfs:domain ind:Complaint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pmScheduleId rdf:type rdf:Property ;
    rdfs:label 'Pm Schedule Id' ;
    rdfs:comment 'Foreign key linking to asset.pm_schedule. Business justification: Pipe mains have scheduled maintenance programs (cathodic protection checks, condition inspections, flushing). Linking pipe_main to its PM schedule enables automated work order generation and complianc' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PmSchedule .

ind:assetOwner rdf:type rdf:Property ;
    rdfs:label 'Asset Owner' ;
    rdfs:comment 'The asset owner value recorded for each pipe main in the distribution domain.' ;
    rdfs:domain ind:PipeMain ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:averageDailyFlowGpm rdf:type rdf:Property ;
    rdfs:label 'Average Daily Flow Gpm' ;
    rdfs:comment 'The average daily flow gpm value recorded for each pipe main in the distribution domain.' ;
    rdfs:domain ind:PipeMain ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:beddingType rdf:type rdf:Property ;
    rdfs:label 'Bedding Type' ;
    rdfs:comment 'The bedding type value recorded for each pipe main in the distribution domain.' ;
    rdfs:domain ind:PipeMain ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:breakHistoryCount rdf:type rdf:Property ;
    rdfs:label 'Break History Count' ;
    rdfs:comment 'The break history count value recorded for each pipe main in the distribution domain.' ;
    rdfs:domain ind:PipeMain ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:cathodicProtectionFlag rdf:type rdf:Property ;
    rdfs:label 'Cathodic Protection Flag' ;
    rdfs:comment 'The cathodic protection flag value recorded for each pipe main in the distribution domain.' ;
    rdfs:domain ind:PipeMain ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:coatingType rdf:type rdf:Property ;
    rdfs:label 'Coating Type' ;
    rdfs:comment 'The coating type value recorded for each pipe main in the distribution domain.' ;
    rdfs:domain ind:PipeMain ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conditionAssessmentDate rdf:type rdf:Property ;
    rdfs:label 'Condition Assessment Date' ;
    rdfs:comment 'The condition assessment date associated with each pipe main record in the distribution domain.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:conditionGrade rdf:type rdf:Property ;
    rdfs:label 'Condition Grade' ;
    rdfs:comment 'The condition grade value recorded for each pipe main in the distribution domain.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:criticalityRating rdf:type rdf:Property ;
    rdfs:label 'Criticality Rating' ;
    rdfs:comment 'The criticality rating value recorded for each pipe main in the distribution domain.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:depthFeet rdf:type rdf:Property ;
    rdfs:label 'Depth Feet' ;
    rdfs:comment 'The depth feet value recorded for each pipe main in the distribution domain.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:downstreamNodeCode rdf:type rdf:Property ;
    rdfs:label 'Downstream Node Code' ;
    rdfs:comment 'The downstream node code value recorded for each pipe main in the distribution domain.' ;
    rdfs:domain ind:PipeMain ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fireFlowCapableFlag rdf:type rdf:Property ;
    rdfs:label 'Fire Flow Capable Flag' ;
    rdfs:comment 'The fire flow capable flag value recorded for each pipe main in the distribution domain.' ;
    rdfs:domain ind:PipeMain ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:gisGeometryWkt rdf:type rdf:Property ;
    rdfs:label 'Gis Geometry Wkt' ;
    rdfs:comment 'The gis geometry wkt value recorded for each pipe main in the distribution domain.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hazenWilliamsCFactor rdf:type rdf:Property ;
    rdfs:label 'Hazen Williams C Factor' ;
    rdfs:comment 'The hazen williams c factor value recorded for each pipe main in the distribution domain.' ;
    rdfs:domain ind:PipeMain ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:installationYear rdf:type rdf:Property ;
    rdfs:label 'Installation Year' ;
    rdfs:comment 'The installation year value recorded for each pipe main in the distribution domain.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:jointType rdf:type rdf:Property ;
    rdfs:label 'Joint Type' ;
    rdfs:comment 'The joint type value recorded for each pipe main in the distribution domain.' ;
    rdfs:domain ind:PipeMain ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastBreakDate rdf:type rdf:Property ;
    rdfs:label 'Last Break Date' ;
    rdfs:comment 'The last break date associated with each pipe main record in the distribution domain.' ;
    rdfs:domain ind:PipeMain ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lengthFeet rdf:type rdf:Property ;
    rdfs:label 'Length Feet' ;
    rdfs:comment 'The length feet value recorded for each pipe main in the distribution domain.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lifecycleStatus rdf:type rdf:Property ;
    rdfs:label 'Lifecycle Status' ;
    rdfs:comment 'The lifecycle status value recorded for each pipe main in the distribution domain.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:liningType rdf:type rdf:Property ;
    rdfs:label 'Lining Type' ;
    rdfs:comment 'The lining type value recorded for each pipe main in the distribution domain.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maintenanceResponsibility rdf:type rdf:Property ;
    rdfs:label 'Maintenance Responsibility' ;
    rdfs:comment 'The maintenance responsibility value recorded for each pipe main in the distribution domain.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:material rdf:type rdf:Property ;
    rdfs:label 'Material' ;
    rdfs:comment 'The material value recorded for each pipe main in the distribution domain.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maxFlowCapacityGpm rdf:type rdf:Property ;
    rdfs:label 'Max Flow Capacity Gpm' ;
    rdfs:comment 'The max flow capacity gpm value recorded for each pipe main in the distribution domain.' ;
    rdfs:domain ind:PipeMain ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mutatorNote rdf:type rdf:Property ;
    rdfs:label 'Mutator Note' ;
    rdfs:comment 'The mutator note value recorded for each pipe main in the distribution domain.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nominalDiameterInches rdf:type rdf:Property ;
    rdfs:label 'Nominal Diameter Inches' ;
    rdfs:comment 'The nominal diameter inches value recorded for each pipe main in the distribution domain.' ;
    rdfs:domain ind:PipeMain ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:operatingPressurePsi rdf:type rdf:Property ;
    rdfs:label 'Operating Pressure Psi' ;
    rdfs:comment 'The operating pressure psi value recorded for each pipe main in the distribution domain.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pipeNumber rdf:type rdf:Property ;
    rdfs:label 'Pipe Number' ;
    rdfs:comment 'The pipe number value recorded for each pipe main in the distribution domain.' ;
    rdfs:domain ind:PipeMain ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pipeType rdf:type rdf:Property ;
    rdfs:label 'Pipe Type' ;
    rdfs:comment 'The pipe type value recorded for each pipe main in the distribution domain.' ;
    rdfs:domain ind:PipeMain ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pressureClassPsi rdf:type rdf:Property ;
    rdfs:label 'Pressure Class Psi' ;
    rdfs:comment 'The pressure class psi value recorded for each pipe main in the distribution domain.' ;
    rdfs:domain ind:PipeMain ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:streetName rdf:type rdf:Property ;
    rdfs:label 'Street Name' ;
    rdfs:comment 'The street name used to identify each pipe main record in the distribution domain.' ;
    rdfs:domain ind:PipeMain ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:warrantyExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Warranty Expiration Date' ;
    rdfs:comment 'The warranty expiration date associated with each pipe main record in the distribution domain.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingAccountId rdf:type rdf:Property ;
    rdfs:label 'Billing Account Id' ;
    rdfs:comment 'Foreign key linking to billing.billing_account. Business justification: Shutoff/reconnect field operations and consumption billing require direct linkage from the physical service line to its billing account. Enables account lookup from GIS field tools and supports servic' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BillingAccount .

ind:connectionStatus rdf:type rdf:Property ;
    rdfs:label 'Connection Status' ;
    rdfs:comment 'The connection status value recorded for each service line in the distribution domain.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:curbStopInstalled rdf:type rdf:Property ;
    rdfs:label 'Curb Stop Installed' ;
    rdfs:comment 'The curb stop installed value recorded for each service line in the distribution domain.' ;
    rdfs:domain ind:ServiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:curbStopLocation rdf:type rdf:Property ;
    rdfs:label 'Curb Stop Location' ;
    rdfs:comment 'The curb stop location value recorded for each service line in the distribution domain.' ;
    rdfs:domain ind:ServiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:diameterInches rdf:type rdf:Property ;
    rdfs:label 'Diameter Inches' ;
    rdfs:comment 'The diameter inches value recorded for each service line in the distribution domain.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lastLeakRepairDate rdf:type rdf:Property ;
    rdfs:label 'Last Leak Repair Date' ;
    rdfs:comment 'The last leak repair date associated with each service line record in the distribution domain.' ;
    rdfs:domain ind:ServiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lcrrClassification rdf:type rdf:Property ;
    rdfs:label 'Lcrr Classification' ;
    rdfs:comment 'The lcrr classification value recorded for each service line in the distribution domain.' ;
    rdfs:domain ind:ServiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lcrrInventoryVerified rdf:type rdf:Property ;
    rdfs:label 'Lcrr Inventory Verified' ;
    rdfs:comment 'The lcrr inventory verified value recorded for each service line in the distribution domain.' ;
    rdfs:domain ind:ServiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lcrrVerificationDate rdf:type rdf:Property ;
    rdfs:label 'Lcrr Verification Date' ;
    rdfs:comment 'The lcrr verification date associated with each service line record in the distribution domain.' ;
    rdfs:domain ind:ServiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lcrrVerificationMethod rdf:type rdf:Property ;
    rdfs:label 'Lcrr Verification Method' ;
    rdfs:comment 'The lcrr verification method value recorded for each service line in the distribution domain.' ;
    rdfs:domain ind:ServiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:leakHistoryCount rdf:type rdf:Property ;
    rdfs:label 'Leak History Count' ;
    rdfs:comment 'The leak history count value recorded for each service line in the distribution domain.' ;
    rdfs:domain ind:ServiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:materialType rdf:type rdf:Property ;
    rdfs:label 'Material Type' ;
    rdfs:comment 'The material type value recorded for each service line in the distribution domain.' ;
    rdfs:domain ind:ServiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:replacementMethod rdf:type rdf:Property ;
    rdfs:label 'Replacement Method' ;
    rdfs:comment 'The replacement method value recorded for each service line in the distribution domain.' ;
    rdfs:domain ind:ServiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:replacementPriorityScore rdf:type rdf:Property ;
    rdfs:label 'Replacement Priority Score' ;
    rdfs:comment 'The replacement priority score value recorded for each service line in the distribution domain.' ;
    rdfs:domain ind:ServiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:serviceLineNumber rdf:type rdf:Property ;
    rdfs:label 'Service Line Number' ;
    rdfs:comment 'The service line number value recorded for each service line in the distribution domain.' ;
    rdfs:domain ind:ServiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tapSizeInches rdf:type rdf:Property ;
    rdfs:label 'Tap Size Inches' ;
    rdfs:comment 'The tap size inches value recorded for each service line in the distribution domain.' ;
    rdfs:domain ind:ServiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:arcgisFeatureCode rdf:type rdf:Property ;
    rdfs:label 'Arcgis Feature Code' ;
    rdfs:comment 'Corresponding feature identifier in the Esri ArcGIS Geographic Information System (GIS) for spatial representation and network topology management. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:PressureZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:averageDailyDemandMgd rdf:type rdf:Property ;
    rdfs:label 'Average Daily Demand Mgd' ;
    rdfs:comment 'Average daily water demand in Million Gallons per Day (MGD) for the pressure zone, used for capacity planning and hydraulic modeling. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:PressureZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:averageElevationFt rdf:type rdf:Property ;
    rdfs:label 'Average Elevation Ft' ;
    rdfs:comment 'Average ground elevation in feet above sea level across the pressure zone, used for hydraulic modeling and demand allocation. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:PressureZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:boundaryDescription rdf:type rdf:Property ;
    rdfs:label 'Boundary Description' ;
    rdfs:comment 'Textual description of the geographic or infrastructure boundaries defining the pressure zone, including major streets, landmarks, or infrastructure features. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:customerCount rdf:type rdf:Property ;
    rdfs:label 'Customer Count' ;
    rdfs:comment 'Total number of active customer service connections within the pressure zone, used for demand forecasting and revenue allocation. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:PressureZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:designPressurePsi rdf:type rdf:Property ;
    rdfs:label 'Design Pressure Psi' ;
    rdfs:comment 'Design or nominal operating pressure in Pounds per Square Inch (PSI) for which the zone infrastructure was engineered and constructed. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:PressureZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:elevationMaxFt rdf:type rdf:Property ;
    rdfs:label 'Elevation Max Ft' ;
    rdfs:comment 'Maximum ground elevation in feet above sea level within the pressure zone boundary, critical for pressure management and PRV settings. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:PressureZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:elevationMinFt rdf:type rdf:Property ;
    rdfs:label 'Elevation Min Ft' ;
    rdfs:comment 'Minimum ground elevation in feet above sea level within the pressure zone boundary, used for hydraulic gradient calculations. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:PressureZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fireFlowCapacityGpm rdf:type rdf:Property ;
    rdfs:label 'Fire Flow Capacity Gpm' ;
    rdfs:comment 'Minimum fire flow capacity in Gallons per Minute (GPM) that the pressure zone must maintain at specified residual pressure for fire protection, per Insurance Services Office (ISO) and NFPA standards.' ;
    rdfs:domain ind:PressureZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:hydraulicModelLastCalibratedDate rdf:type rdf:Property ;
    rdfs:label 'Hydraulic Model Last Calibrated Date' ;
    rdfs:comment 'Date when the hydraulic model for this pressure zone was last calibrated against field measurements, ensuring model accuracy for planning and operational decisions. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:PressureZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:infowaterModelZoneCode rdf:type rdf:Property ;
    rdfs:label 'Infowater Model Zone Code' ;
    rdfs:comment 'Corresponding pressure zone identifier in the Innovyze InfoWater hydraulic model, used for synchronization between operational systems and modeling platforms. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:PressureZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastBoundaryReviewDate rdf:type rdf:Property ;
    rdfs:label 'Last Boundary Review Date' ;
    rdfs:comment 'Date when the pressure zone boundaries were last reviewed and validated for accuracy, typically as part of GIS updates or hydraulic model recalibration. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:PressureZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nrwPercentage rdf:type rdf:Property ;
    rdfs:label 'Nrw Percentage' ;
    rdfs:comment 'Percentage of Non-Revenue Water (NRW) within the pressure zone, calculated as the difference between water supplied and billed consumption, used for loss control and efficiency analysis. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:PressureZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:peakHourDemandMgd rdf:type rdf:Property ;
    rdfs:label 'Peak Hour Demand Mgd' ;
    rdfs:comment 'Peak hourly water demand in Million Gallons per Day (MGD) for the pressure zone, critical for sizing infrastructure and ensuring adequate pressure during high-demand periods. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:PressureZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:residualPressureFirePsi rdf:type rdf:Property ;
    rdfs:label 'Residual Pressure Fire Psi' ;
    rdfs:comment 'Minimum residual pressure in Pounds per Square Inch (PSI) that must be maintained during fire flow conditions to ensure adequate service to other customers and fire suppression effectiveness. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:PressureZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scadaZoneTag rdf:type rdf:Property ;
    rdfs:label 'Scada Zone Tag' ;
    rdfs:comment 'SCADA system tag or point identifier for real-time monitoring of pressure, flow, and operational status within this zone via OSIsoft PI Historian or similar SCADA platforms.' ;
    rdfs:domain ind:PressureZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceAreaSqMi rdf:type rdf:Property ;
    rdfs:label 'Service Area Sq Mi' ;
    rdfs:comment 'Geographic area in square miles covered by the pressure zone, used for demand density calculations and infrastructure planning. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:PressureZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:storageCapacityMg rdf:type rdf:Property ;
    rdfs:label 'Storage Capacity Mg' ;
    rdfs:comment 'Total storage capacity in Million Gallons (MG) of all tanks and reservoirs serving the pressure zone, used for emergency supply and pressure stabilization. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:PressureZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:targetPressureMaxPsi rdf:type rdf:Property ;
    rdfs:label 'Target Pressure Max Psi' ;
    rdfs:comment 'Maximum target operating pressure in Pounds per Square Inch (PSI) to prevent infrastructure damage, excessive leakage, and customer service issues. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:PressureZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:targetPressureMinPsi rdf:type rdf:Property ;
    rdfs:label 'Target Pressure Min Psi' ;
    rdfs:comment 'Minimum target operating pressure in Pounds per Square Inch (PSI) that must be maintained throughout the zone to ensure adequate service delivery and regulatory compliance. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:PressureZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ufwPercentage rdf:type rdf:Property ;
    rdfs:label 'Ufw Percentage' ;
    rdfs:comment 'Percentage of Unaccounted-for Water (UFW) within the pressure zone, representing water losses that cannot be attributed to known uses, critical for leak detection and infrastructure assessment. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:PressureZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:zoneCode rdf:type rdf:Property ;
    rdfs:label 'Zone Code' ;
    rdfs:comment 'Unique alphanumeric code or identifier for the pressure zone used in GIS, SCADA, and hydraulic modeling systems. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:PressureZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:zoneName rdf:type rdf:Property ;
    rdfs:label 'Zone Name' ;
    rdfs:comment 'Business name or designation of the pressure zone used for operational reference and communication. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:PressureZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:zoneType rdf:type rdf:Property ;
    rdfs:label 'Zone Type' ;
    rdfs:comment 'Classification of the pressure zone based on the primary method of pressure maintenance: gravity-fed from elevated storage, pumped from pump stations, combination of both, elevated tank-fed, or booster zone. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:PressureZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:averagePressurePsi rdf:type rdf:Property ;
    rdfs:label 'Average Pressure Psi' ;
    rdfs:comment 'Average operating pressure within the DMA measured in Pounds per Square Inch. Pressure management is critical for leakage control; excessive pressure increases leak rates and pipe stress. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:Dma ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dmaStatus rdf:type rdf:Property ;
    rdfs:label 'Dma Status' ;
    rdfs:comment 'Current operational status of the DMA. Active DMAs are fully operational and monitored; inactive or decommissioned DMAs are no longer in use; planned DMAs are in design phase; under review indicates reconfiguration or audit in progress. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:Dma ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:establishedDate rdf:type rdf:Property ;
    rdfs:label 'Established Date' ;
    rdfs:comment 'Date when the DMA was first established and commissioned for operational monitoring. Represents the start of the DMAs lifecycle. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:Dma ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:gisPolygonBoundary rdf:type rdf:Property ;
    rdfs:label 'Gis Polygon Boundary' ;
    rdfs:comment 'GIS polygon geometry defining the spatial boundary of the DMA. Typically stored as WKT (Well-Known Text) or reference to GIS layer feature ID for integration with Esri ArcGIS. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:Dma ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:inletMeterCount rdf:type rdf:Property ;
    rdfs:label 'Inlet Meter Count' ;
    rdfs:comment 'Number of inlet flow meters installed at entry points to the DMA. Inlet meters measure total water entering the zone and are critical for NRW calculation. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:Dma ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isolationValveCount rdf:type rdf:Property ;
    rdfs:label 'Isolation Valve Count' ;
    rdfs:comment 'Number of isolation valves installed at the DMA boundary. Isolation valves enable hydraulic isolation of the DMA for accurate flow measurement and leakage detection.' ;
    rdfs:domain ind:Dma ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lastLeakageSurveyDate rdf:type rdf:Property ;
    rdfs:label 'Last Leakage Survey Date' ;
    rdfs:comment 'Date of the most recent active leakage detection survey conducted within the DMA. Used to track compliance with leakage management programs. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:Dma ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:leakageDetectionFrequencyDays rdf:type rdf:Property ;
    rdfs:label 'Leakage Detection Frequency Days' ;
    rdfs:comment 'Frequency in days at which active leakage detection surveys are conducted within the DMA. High-risk or high-leakage DMAs may be surveyed more frequently. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:Dma ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:mainLengthMiles rdf:type rdf:Property ;
    rdfs:label 'Main Length Miles' ;
    rdfs:comment 'Total length of water mains (distribution pipes) within the DMA measured in miles. Used for calculating leakage per mile of main and infrastructure density metrics. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:Dma ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumNightFlowThresholdGpm rdf:type rdf:Property ;
    rdfs:label 'Minimum Night Flow Threshold Gpm' ;
    rdfs:comment 'Minimum Night Flow threshold in Gallons per Minute. MNF is the lowest flow rate measured during nighttime hours (typically 2 AM to 4 AM) when legitimate consumption is minimal. Elevated MNF indicates leakage within the DMA. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:Dma ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nextScheduledSurveyDate rdf:type rdf:Property ;
    rdfs:label 'Next Scheduled Survey Date' ;
    rdfs:comment 'Scheduled date for the next active leakage detection survey within the DMA. Used for planning and resource allocation. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:Dma ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:outletMeterCount rdf:type rdf:Property ;
    rdfs:label 'Outlet Meter Count' ;
    rdfs:comment 'Number of outlet flow meters installed at exit points from the DMA. Outlet meters are used in complex DMA configurations where water may flow to adjacent zones. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:Dma ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:prvCount rdf:type rdf:Property ;
    rdfs:label 'Prv Count' ;
    rdfs:comment 'Number of Pressure Reducing Valves installed within or at the boundary of the DMA. PRVs control pressure to reduce leakage and pipe stress. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:Dma ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:scadaMonitoredFlag rdf:type rdf:Property ;
    rdfs:label 'Scada Monitored Flag' ;
    rdfs:comment 'Indicates whether the DMA is actively monitored by the SCADA system. SCADA-monitored DMAs provide real-time flow, pressure, and alarm data for proactive leakage management. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:serviceConnectionCount rdf:type rdf:Property ;
    rdfs:label 'Service Connection Count' ;
    rdfs:comment 'Total number of active service connections (customer meters) within the DMA. Used for calculating per-connection leakage rates and NRW metrics. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:Dma ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:targetNrwPercentage rdf:type rdf:Property ;
    rdfs:label 'Target Nrw Percentage' ;
    rdfs:comment 'Target threshold for Non-Revenue Water as a percentage of total water supplied to the DMA. NRW includes physical losses (leakage) and commercial losses (metering inaccuracies, theft). Typical industry targets range from 10% to 20%. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:Dma ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:targetUfwPercentage rdf:type rdf:Property ;
    rdfs:label 'Target Ufw Percentage' ;
    rdfs:comment 'Target threshold for Unaccounted-for Water as a percentage of total water supplied. UFW is a broader measure than NRW and includes all water that cannot be accounted for through billing or authorized use. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:Dma ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:networkRegistryId rdf:type rdf:Property ;
    rdfs:label 'Network Registry Id' ;
    rdfs:comment 'Reference to the asset registry record in the Computerized Maintenance Management System (CMMS). Links this valve to IBM Maximo Asset Management for maintenance tracking, work orders, and lifecycle management.' ;
    rdfs:domain ind:NetworkValve ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Registry .

ind:burialDepthFeet rdf:type rdf:Property ;
    rdfs:label 'Burial Depth Feet' ;
    rdfs:comment 'Depth in feet from ground surface to the valve operating nut. Used for excavation planning, valve box sizing, and accessibility assessment. Typical range is 3-8 feet depending on frost line and main depth. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:NetworkValve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:currentPosition rdf:type rdf:Property ;
    rdfs:label 'Current Position' ;
    rdfs:comment 'Actual current position of the valve as of the last field verification or SCADA reading. May differ from normal_position during maintenance, emergencies, or operational adjustments. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:NetworkValve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exercisingFrequencyMonths rdf:type rdf:Property ;
    rdfs:label 'Exercising Frequency Months' ;
    rdfs:comment 'Planned frequency in months for valve exercising activities. Typically 12 months for standard valves, 6 months for critical isolation valves, and 24 months for low-priority valves. Drives preventive maintenance scheduling in CMMS.' ;
    rdfs:domain ind:NetworkValve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isBuried rdf:type rdf:Property ;
    rdfs:label 'Is Buried' ;
    rdfs:comment 'Indicates whether the valve is buried underground (True) or above ground in a vault or building (False). Buried valves require valve box access and are more difficult to exercise; above-ground valves are more accessible but require weather protection. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:NetworkValve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isMotorized rdf:type rdf:Property ;
    rdfs:label 'Is Motorized' ;
    rdfs:comment 'Indicates whether the valve is equipped with a motor or actuator for remote operation. True for SCADA-controlled valves; False for manual valves requiring field crew operation. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:NetworkValve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastExercisedBy rdf:type rdf:Property ;
    rdfs:label 'Last Exercised By' ;
    rdfs:comment 'Name or identifier of the crew member or contractor who last exercised the valve. Supports accountability and quality assurance in valve maintenance programs. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:NetworkValve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastExercisedDate rdf:type rdf:Property ;
    rdfs:label 'Last Exercised Date' ;
    rdfs:comment 'Date the valve was last exercised (opened and closed through its full range of motion). Regular valve exercising prevents seizing and ensures operability during emergencies. AWWA recommends annual exercising for critical valves.' ;
    rdfs:domain ind:NetworkValve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:normalPosition rdf:type rdf:Property ;
    rdfs:label 'Normal Position' ;
    rdfs:comment 'Standard operating position of the valve under normal conditions. Critical for hydraulic modeling, isolation planning, and Supervisory Control and Data Acquisition (SCADA) monitoring. Most distribution valves are normally open; some isolation and control valves are normally closed or throttled.' ;
    rdfs:domain ind:NetworkValve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pressureRatingPsi rdf:type rdf:Property ;
    rdfs:label 'Pressure Rating Psi' ;
    rdfs:comment 'Maximum rated working pressure of the valve in Pounds per Square Inch (PSI) as specified by the manufacturer. Must exceed operating_pressure_psi with adequate safety margin. Common ratings are 150, 200, 250, and 300 PSI. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:NetworkValve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scadaTag rdf:type rdf:Property ;
    rdfs:label 'Scada Tag' ;
    rdfs:comment 'SCADA system tag identifier for automated valves with remote monitoring and control capability. Links to OSIsoft PI Historian for real-time position monitoring, alarm management, and operational analytics. Only populated for motorized or actuated valves integrated with SCADA.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:turnsToClose rdf:type rdf:Property ;
    rdfs:label 'Turns To Close' ;
    rdfs:comment 'Number of complete turns required to fully close the valve from the fully open position. Used by field crews during valve exercising programs and emergency isolation procedures. Typical range is 5-50 turns depending on valve size and type.' ;
    rdfs:domain ind:NetworkValve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:usefulLifeYears rdf:type rdf:Property ;
    rdfs:label 'Useful Life Years' ;
    rdfs:comment 'Expected useful life of the valve in years from installation date. Used for depreciation calculations per Generally Accepted Accounting Principles (GAAP) and Governmental Accounting Standards Board (GASB) standards, and for long-term replacement planning. Typical range is 50-75 years for distribution valves. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:valveBoxType rdf:type rdf:Property ;
    rdfs:label 'Valve Box Type' ;
    rdfs:comment 'Type of valve box or access structure protecting the buried valve. Standard boxes for sidewalk/lawn areas; traffic-rated boxes for roadways; extension boxes for deep valves; vaults for large valves; none for above-ground installations. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:NetworkValve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:valveFunction rdf:type rdf:Property ;
    rdfs:label 'Valve Function' ;
    rdfs:comment 'Primary operational function of the valve in the distribution network. Isolation valves segment the network for maintenance; control valves regulate flow; pressure reducing valves (PRV) manage pressure zones; check valves prevent backflow; air release valves expel trapped air; blowoff valves drain sections.' ;
    rdfs:domain ind:NetworkValve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:valveNumber rdf:type rdf:Property ;
    rdfs:label 'Valve Number' ;
    rdfs:comment 'Externally-known business identifier for the valve, typically painted or tagged on the valve in the field. Used by operations and maintenance crews for identification. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:NetworkValve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:valveType rdf:type rdf:Property ;
    rdfs:label 'Valve Type' ;
    rdfs:comment 'Classification of the valve mechanism. Gate valves provide full flow with minimal pressure drop; butterfly valves are compact and quick-operating; ball valves offer tight shutoff; check valves prevent backflow; plug, cone, and needle valves provide throttling control. [ENUM-REF-CANDIDATE: gate|butterfly|ball|check|plug|cone|needle — 7 candidates stripped; promote to reference product]. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:NetworkValve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hydrantMainPipePipeMainId rdf:type rdf:Property ;
    rdfs:label 'Hydrant Main Pipe Pipe Main Id' ;
    rdfs:comment 'Identifier of the nearest or connected water main pipe from which the hydrant is fed, used for hydraulic modeling and network topology analysis. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:Hydrant ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PipeMain .

ind:hydrantPipeMainId rdf:type rdf:Property ;
    rdfs:label 'Hydrant Pipe Main Id' ;
    rdfs:comment 'Identifier of the nearest or connected water main pipe from which the hydrant is fed, used for hydraulic modeling and network topology analysis. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:Hydrant ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PipeMain .

ind:buryDepthFeet rdf:type rdf:Property ;
    rdfs:label 'Bury Depth Feet' ;
    rdfs:comment 'Depth in feet from ground surface to the hydrant valve or base, critical for freeze protection and installation specifications. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:Hydrant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:conditionStatus rdf:type rdf:Property ;
    rdfs:label 'Condition Status' ;
    rdfs:comment 'Current physical condition assessment of the hydrant based on inspection findings: excellent (like new), good (minor wear), fair (functional with moderate wear), poor (requires repair), critical (non-functional or unsafe). Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fireDistrict rdf:type rdf:Property ;
    rdfs:label 'Fire District' ;
    rdfs:comment 'Name or code of the fire protection district or fire department jurisdiction responsible for this hydrant, used for emergency response coordination. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:Hydrant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:flowCapacityGpm rdf:type rdf:Property ;
    rdfs:label 'Flow Capacity Gpm' ;
    rdfs:comment 'Rated fire flow capacity of the hydrant in gallons per minute (GPM) at 20 pounds per square inch (PSI) residual pressure, determined by flow testing per NFPA 291. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:Hydrant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:flowClassColor rdf:type rdf:Property ;
    rdfs:label 'Flow Class Color' ;
    rdfs:comment 'Color coding per NFPA 291 indicating fire flow capacity class: Red (<500 GPM), Orange (500-999 GPM), Green (1000-1499 GPM), Blue (>=1500 GPM), Light Blue (>=2500 GPM). Used for visual identification by fire departments. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:Hydrant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:flushingProgramFlag rdf:type rdf:Property ;
    rdfs:label 'Flushing Program Flag' ;
    rdfs:comment 'Boolean flag indicating whether this hydrant is included in the routine unidirectional flushing program for water quality maintenance and sediment removal. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:Hydrant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hydrantNumber rdf:type rdf:Property ;
    rdfs:label 'Hydrant Number' ;
    rdfs:comment 'External business identifier or asset tag number assigned to the hydrant for field operations, maintenance tracking, and municipal records. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:Hydrant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hydrantType rdf:type rdf:Property ;
    rdfs:label 'Hydrant Type' ;
    rdfs:comment 'Classification of hydrant design. Dry barrel hydrants drain after use (freeze-resistant for cold climates), wet barrel hydrants remain charged with water (warm climates), flush hydrants are below-grade, wall hydrants are building-mounted. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:Hydrant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastFlowTestDate rdf:type rdf:Property ;
    rdfs:label 'Last Flow Test Date' ;
    rdfs:comment 'Date of the most recent fire flow test conducted on the hydrant per NFPA 291 standards, used to verify flow capacity and pressure performance. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:Hydrant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastFlushingDate rdf:type rdf:Property ;
    rdfs:label 'Last Flushing Date' ;
    rdfs:comment 'Date when the hydrant was last used for system flushing or water quality maintenance activities. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:Hydrant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:mainDiameterInches rdf:type rdf:Property ;
    rdfs:label 'Main Diameter Inches' ;
    rdfs:comment 'Diameter of the connected water main pipe in inches, critical for fire flow capacity calculations and hydraulic modeling. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:Hydrant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nextInspectionDueDate rdf:type rdf:Property ;
    rdfs:label 'Next Inspection Due Date' ;
    rdfs:comment 'Scheduled date for the next routine inspection of the hydrant, based on preventive maintenance (PM) schedule and regulatory requirements. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:outletCount rdf:type rdf:Property ;
    rdfs:label 'Outlet Count' ;
    rdfs:comment 'Total number of discharge outlets (nozzles) on the hydrant, typically 2-5 outlets including pumper and hose connections. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:Hydrant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:outletSizeInches rdf:type rdf:Property ;
    rdfs:label 'Outlet Size Inches' ;
    rdfs:comment 'Sizes of hydrant outlets in inches, typically formatted as a comma-separated list (e.g., \'2.5,2.5,4.5\' for two 2.5-inch hose outlets and one 4.5-inch pumper outlet). Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:Hydrant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:residualPressurePsi rdf:type rdf:Property ;
    rdfs:label 'Residual Pressure Psi' ;
    rdfs:comment 'Residual water pressure at the hydrant in pounds per square inch (PSI) during flow testing at rated capacity, used to assess available fire flow. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:Hydrant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:staticPressurePsi rdf:type rdf:Property ;
    rdfs:label 'Static Pressure Psi' ;
    rdfs:comment 'Static water pressure at the hydrant location in pounds per square inch (PSI) when no water is flowing, measured during flow testing. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:Hydrant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:valveTurnsToOpen rdf:type rdf:Property ;
    rdfs:label 'Valve Turns To Open' ;
    rdfs:comment 'Number of complete turns required to fully open the hydrant main valve, used for operational training and maintenance documentation. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:Hydrant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pumpStationId rdf:type rdf:Property ;
    rdfs:label 'Pump Station Id' ;
    rdfs:comment 'Unique identifier for the booster pump station within the distribution network. Primary key. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PumpStation .

ind:backupGeneratorAvailable rdf:type rdf:Property ;
    rdfs:label 'Backup Generator Available' ;
    rdfs:comment 'Indicates whether the pump station has a backup generator for emergency power supply. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:PumpStation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:backupGeneratorCapacityKw rdf:type rdf:Property ;
    rdfs:label 'Backup Generator Capacity Kw' ;
    rdfs:comment 'Capacity of the backup generator in kilowatts (kW) if available. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:PumpStation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:designFlowCapacityGpm rdf:type rdf:Property ;
    rdfs:label 'Design Flow Capacity Gpm' ;
    rdfs:comment 'Maximum design flow capacity of the pump station measured in gallons per minute (GPM). Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:PumpStation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:designFlowCapacityMgd rdf:type rdf:Property ;
    rdfs:label 'Design Flow Capacity Mgd' ;
    rdfs:comment 'Maximum design flow capacity of the pump station measured in million gallons per day (MGD). Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:PumpStation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dischargePressurePsi rdf:type rdf:Property ;
    rdfs:label 'Discharge Pressure Psi' ;
    rdfs:comment 'Target discharge pressure in pounds per square inch (PSI) maintained by the pump station. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:PumpStation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hydraulicModelNodeCode rdf:type rdf:Property ;
    rdfs:label 'Hydraulic Model Node Code' ;
    rdfs:comment 'Node identifier in the Innovyze InfoWater hydraulic model representing this pump station. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:numberOfDutyPumps rdf:type rdf:Property ;
    rdfs:label 'Number Of Duty Pumps' ;
    rdfs:comment 'Count of pumps designated for normal operational duty at the station. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:PumpStation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:numberOfPumps rdf:type rdf:Property ;
    rdfs:label 'Number Of Pumps' ;
    rdfs:comment 'Total count of pump units installed at the station, including duty and standby pumps. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:PumpStation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:numberOfStandbyPumps rdf:type rdf:Property ;
    rdfs:label 'Number Of Standby Pumps' ;
    rdfs:comment 'Count of pumps designated as standby or backup units for redundancy. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:PumpStation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:powerSupplyPhase rdf:type rdf:Property ;
    rdfs:label 'Power Supply Phase' ;
    rdfs:comment 'Electrical power supply phase configuration for the pump station. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:PumpStation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:powerSupplyVoltage rdf:type rdf:Property ;
    rdfs:label 'Power Supply Voltage' ;
    rdfs:comment 'Electrical power supply voltage specification for the pump station (e.g., 480V, 4160V). Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:PumpStation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scadaIntegrated rdf:type rdf:Property ;
    rdfs:label 'Scada Integrated' ;
    rdfs:comment 'Indicates whether the pump station is integrated with the SCADA system for remote monitoring and control. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:PumpStation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:stationCode rdf:type rdf:Property ;
    rdfs:label 'Station Code' ;
    rdfs:comment 'Unique alphanumeric code assigned to the pump station for asset tracking and SCADA integration. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:PumpStation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stationName rdf:type rdf:Property ;
    rdfs:label 'Station Name' ;
    rdfs:comment 'Business name or designation of the pump station for operational reference and reporting. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:PumpStation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stationType rdf:type rdf:Property ;
    rdfs:label 'Station Type' ;
    rdfs:comment 'Classification of the pump station based on its operational function within the distribution network. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:PumpStation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:suctionPressurePsi rdf:type rdf:Property ;
    rdfs:label 'Suction Pressure Psi' ;
    rdfs:comment 'Inlet or suction pressure in pounds per square inch (PSI) at the pump station intake. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:PumpStation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalDynamicHeadFt rdf:type rdf:Property ;
    rdfs:label 'Total Dynamic Head Ft' ;
    rdfs:comment 'Total dynamic head (TDH) in feet that the pump station must overcome, including elevation and friction losses. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:PumpStation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:vfdConfiguration rdf:type rdf:Property ;
    rdfs:label 'Vfd Configuration' ;
    rdfs:comment 'Description of the VFD configuration including number of drives and control strategy. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:PumpStation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vfdEquipped rdf:type rdf:Property ;
    rdfs:label 'Vfd Equipped' ;
    rdfs:comment 'Indicates whether the pump station is equipped with Variable Frequency Drive (VFD) technology for flow and pressure control. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:PumpStation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:storageTankId rdf:type rdf:Property ;
    rdfs:label 'Storage Tank Id' ;
    rdfs:comment 'Unique identifier for the potable water storage facility. Primary key for the storage tank master record. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:StorageTank .

ind:primaryStorageDistrictMeteredAreaDmaId rdf:type rdf:Property ;
    rdfs:label 'Primary Storage District Metered Area Dma Id' ;
    rdfs:comment 'Reference to the District Metered Area (DMA) that this storage tank serves. DMAs are discrete zones used for water balance analysis and Non-Revenue Water (NRW) management. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:StorageTank ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Dma .

ind:sourceFacilityId rdf:type rdf:Property ;
    rdfs:label 'Source Facility Id' ;
    rdfs:comment 'Foreign key linking to treatment.facility. Business justification: Storage tanks receive treated water from a specific treatment facility. This link supports water age tracking, DBP (TTHM/HAA5) compliance reporting, and finished water quality audits. Role-prefix \'sou' ;
    rdfs:domain ind:StorageTank ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Facility .

ind:assetCriticalityRating rdf:type rdf:Property ;
    rdfs:label 'Asset Criticality Rating' ;
    rdfs:comment 'Risk-based criticality classification of the storage tank based on consequence of failure analysis considering population served, redundancy, and system impact: critical (single point of failure for large population), high (significant impact), medium (moderate impact), or low (minimal impact with redundancy available). Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:baseElevationFeet rdf:type rdf:Property ;
    rdfs:label 'Base Elevation Feet' ;
    rdfs:comment 'Ground or foundation elevation (in feet above mean sea level or local datum) at the base of the storage tank structure. Used for hydraulic gradient calculations. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:StorageTank ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:capacityGallons rdf:type rdf:Property ;
    rdfs:label 'Capacity Gallons' ;
    rdfs:comment 'Total storage capacity of the tank measured in gallons. Represents the maximum volume of potable water the tank can hold at overflow elevation. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:StorageTank ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:capacityMillionGallons rdf:type rdf:Property ;
    rdfs:label 'Capacity Million Gallons' ;
    rdfs:comment 'Total storage capacity expressed in million gallons (MG), the standard unit for water utility storage reporting and system adequacy analysis. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:StorageTank ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:coatingCondition rdf:type rdf:Property ;
    rdfs:label 'Coating Condition' ;
    rdfs:comment 'Assessment of the current condition of the tank\'s protective coating system based on the most recent inspection: excellent (no defects), good (minor wear), fair (localized deterioration), poor (widespread deterioration), or failed (coating breakdown requiring immediate attention). Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:StorageTank ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:emergencyStorageGallons rdf:type rdf:Property ;
    rdfs:label 'Emergency Storage Gallons' ;
    rdfs:comment 'Volume of water (in gallons) reserved for emergency supply during system outages, treatment plant failures, or other contingencies. Separate from fire flow reserve and operational storage. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:StorageTank ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fireFlowReserveGallons rdf:type rdf:Property ;
    rdfs:label 'Fire Flow Reserve Gallons' ;
    rdfs:comment 'Volume of water (in gallons) reserved in the storage tank to meet fire protection requirements and emergency fire flow demands as defined by local fire codes and insurance standards. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:StorageTank ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:inletPipeDiameterInches rdf:type rdf:Property ;
    rdfs:label 'Inlet Pipe Diameter Inches' ;
    rdfs:comment 'Diameter (in inches) of the primary inlet pipe supplying water to the storage tank. Used for hydraulic modeling and flow capacity analysis. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:StorageTank ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lastCleaningDate rdf:type rdf:Property ;
    rdfs:label 'Last Cleaning Date' ;
    rdfs:comment 'Date when the storage tank interior was last drained, cleaned, and disinfected. Regular cleaning is required to maintain water quality and prevent sediment accumulation. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:StorageTank ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastCoatingDate rdf:type rdf:Property ;
    rdfs:label 'Last Coating Date' ;
    rdfs:comment 'Date when the interior or exterior protective coating was last applied or rehabilitated. Coating maintenance is critical for corrosion prevention and structural longevity. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:StorageTank ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:maximumOperatingLevelFeet rdf:type rdf:Property ;
    rdfs:label 'Maximum Operating Level Feet' ;
    rdfs:comment 'Highest water level (in feet) at which the tank should operate under normal conditions, typically set below overflow elevation to provide freeboard and prevent overflow events. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:StorageTank ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumOperatingLevelFeet rdf:type rdf:Property ;
    rdfs:label 'Minimum Operating Level Feet' ;
    rdfs:comment 'Lowest water level (in feet) at which the tank should operate under normal conditions to maintain adequate system pressure and prevent pump cavitation or structural stress. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:StorageTank ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mixingSystemInstalled rdf:type rdf:Property ;
    rdfs:label 'Mixing System Installed' ;
    rdfs:comment 'Indicates whether an active mixing system is installed in the storage tank to prevent water age stratification and maintain disinfectant residual throughout the tank volume. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:StorageTank ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mixingSystemType rdf:type rdf:Property ;
    rdfs:label 'Mixing System Type' ;
    rdfs:comment 'Type of mixing system installed: mechanical (motor-driven mixer), hydraulic (jet mixing using inlet flow), or none (no active mixing). Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:StorageTank ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outletPipeDiameterInches rdf:type rdf:Property ;
    rdfs:label 'Outlet Pipe Diameter Inches' ;
    rdfs:comment 'Diameter (in inches) of the primary outlet pipe distributing water from the storage tank to the distribution network. Used for hydraulic modeling and flow capacity analysis. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:StorageTank ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:overflowElevationFeet rdf:type rdf:Property ;
    rdfs:label 'Overflow Elevation Feet' ;
    rdfs:comment 'Elevation (in feet above mean sea level or local datum) at which the tank overflow pipe is located. Represents the absolute maximum water level before overflow discharge occurs. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:StorageTank ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:overflowPipeDiameterInches rdf:type rdf:Property ;
    rdfs:label 'Overflow Pipe Diameter Inches' ;
    rdfs:comment 'Diameter (in inches) of the overflow pipe that prevents tank overfilling by discharging excess water when the maximum level is reached. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:StorageTank ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recordCreatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Record Created Timestamp' ;
    rdfs:comment 'Timestamp when this storage tank record was first created in the system. Used for data lineage and audit trail purposes. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:recordUpdatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Record Updated Timestamp' ;
    rdfs:comment 'Timestamp when this storage tank record was last modified. Used for data lineage, change tracking, and audit trail purposes. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:regulatoryInspectionStatus rdf:type rdf:Property ;
    rdfs:label 'Regulatory Inspection Status' ;
    rdfs:comment 'Current compliance status with state drinking water program and EPA inspection requirements: compliant (meets all requirements), non-compliant (deficiencies identified), pending-review (inspection submitted awaiting approval), or not-applicable (exempt from inspection requirements). Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:StorageTank ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scadaFlowMeterTag rdf:type rdf:Property ;
    rdfs:label 'Scada Flow Meter Tag' ;
    rdfs:comment 'OSIsoft PI Historian tag name for the flow meter measuring inflow or outflow (GPM or MGD) from this storage tank. Used for demand analysis and water balance calculations.' ;
    rdfs:domain ind:StorageTank ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scadaLevelSensorTag rdf:type rdf:Property ;
    rdfs:label 'Scada Level Sensor Tag' ;
    rdfs:comment 'OSIsoft PI Historian tag name for the real-time water level sensor monitoring this storage tank. Used to retrieve current level, historical trends, and alarm conditions from the SCADA system.' ;
    rdfs:domain ind:StorageTank ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scadaPressureSensorTag rdf:type rdf:Property ;
    rdfs:label 'Scada Pressure Sensor Tag' ;
    rdfs:comment 'OSIsoft PI Historian tag name for the pressure sensor monitoring outlet pressure (PSI) from this storage tank. Used for hydraulic performance monitoring and pressure zone management.' ;
    rdfs:domain ind:StorageTank ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:securitySystemInstalled rdf:type rdf:Property ;
    rdfs:label 'Security System Installed' ;
    rdfs:comment 'Indicates whether physical security systems (fencing, locks, intrusion detection, surveillance cameras) are installed to protect the storage tank from unauthorized access and potential contamination threats. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:StorageTank ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:structuralCondition rdf:type rdf:Property ;
    rdfs:label 'Structural Condition' ;
    rdfs:comment 'Overall structural integrity assessment of the storage tank based on the most recent inspection: excellent (no defects), good (minor issues), fair (moderate deterioration), poor (significant deterioration requiring repair), or critical (unsafe condition requiring immediate action). Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:StorageTank ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tankMaterial rdf:type rdf:Property ;
    rdfs:label 'Tank Material' ;
    rdfs:comment 'Primary construction material of the storage tank structure: steel (welded or bolted), concrete (cast-in-place or precast), prestressed concrete, composite (steel and concrete), or fiberglass. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:StorageTank ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tankName rdf:type rdf:Property ;
    rdfs:label 'Tank Name' ;
    rdfs:comment 'Common name or designation of the storage tank, often referencing geographic location or service area (e.g., \'Hillside Elevated Tank\', \'Downtown Reservoir\'). Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:StorageTank ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tankNumber rdf:type rdf:Property ;
    rdfs:label 'Tank Number' ;
    rdfs:comment 'Business identifier or asset tag assigned to the storage tank for operational reference and field identification. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:StorageTank ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tankType rdf:type rdf:Property ;
    rdfs:label 'Tank Type' ;
    rdfs:comment 'Classification of storage tank by structural configuration: elevated (water tower), ground-level (surface reservoir), standpipe (tall cylindrical), reservoir (large capacity ground storage), clearwell (treated water storage at WTP), or hydropneumatic (pressure tank). Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:StorageTank ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:usableCapacityGallons rdf:type rdf:Property ;
    rdfs:label 'Usable Capacity Gallons' ;
    rdfs:comment 'Effective storage capacity available for distribution operations, calculated as the volume between minimum operating level and overflow elevation. Excludes dead storage below minimum operating level. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:StorageTank ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:flowReadingId rdf:type rdf:Property ;
    rdfs:label 'Flow Reading Id' ;
    rdfs:comment 'Unique identifier for the flow measurement record. Primary key for the flow reading transaction. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:FlowReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:alarmFlag rdf:type rdf:Property ;
    rdfs:label 'Alarm Flag' ;
    rdfs:comment 'Indicates whether this flow reading triggered an alarm condition in the SCADA system (e.g., flow exceeds threshold, negative flow, meter communication failure). Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:FlowReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:alarmType rdf:type rdf:Property ;
    rdfs:label 'Alarm Type' ;
    rdfs:comment 'Classification of the alarm condition if alarm_flag is true. [ENUM-REF-CANDIDATE: high_flow|low_flow|no_flow|reverse_flow|communication_failure|meter_fault|pressure_deviation|temperature_anomaly|data_gap|validation_failure — promote to reference product]. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:FlowReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingFlag rdf:type rdf:Property ;
    rdfs:label 'Billing Flag' ;
    rdfs:comment 'Indicates whether this flow reading is used for bulk water billing or wholesale customer invoicing (e.g., inter-utility transfers, industrial bulk customers). Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:calibrationDate rdf:type rdf:Property ;
    rdfs:label 'Calibration Date' ;
    rdfs:comment 'Date of the most recent meter calibration prior to this reading. Used to assess measurement reliability and schedule recalibration. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:estimatedFlag rdf:type rdf:Property ;
    rdfs:label 'Estimated Flag' ;
    rdfs:comment 'Indicates whether the flow value is an estimated or interpolated value rather than a direct meter reading. True when meter communication fails or reading is missing. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:estimationMethod rdf:type rdf:Property ;
    rdfs:label 'Estimation Method' ;
    rdfs:comment 'Method used to estimate the flow value when direct measurement is unavailable. None indicates a direct measured value. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:flowDirection rdf:type rdf:Property ;
    rdfs:label 'Flow Direction' ;
    rdfs:comment 'Direction of water flow at the measurement point. Inflow = water entering the zone/DMA, Outflow = water leaving the zone/DMA, Bidirectional = flow can reverse direction. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:flowValue rdf:type rdf:Property ;
    rdfs:label 'Flow Value' ;
    rdfs:comment 'The raw flow measurement value as captured by the meter. Represents instantaneous flow rate or cumulative volume depending on measurement type. Used with engineering_unit to interpret the measurement. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:FlowReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hydraulicModelFlag rdf:type rdf:Property ;
    rdfs:label 'Hydraulic Model Flag' ;
    rdfs:comment 'Indicates whether this flow reading is used for hydraulic model calibration in Innovyze InfoWater or similar distribution network modeling software. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:FlowReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:intervalDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Interval Duration Minutes' ;
    rdfs:comment 'Time interval in minutes over which the flow measurement was aggregated or averaged. Common values: 15, 30, 60 minutes for SCADA polling intervals. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:measurementType rdf:type rdf:Property ;
    rdfs:label 'Measurement Type' ;
    rdfs:comment 'Classification of the flow measurement: instantaneous (real-time snapshot), cumulative (totalizer reading), average (calculated over interval), peak (maximum in interval), or minimum (lowest in interval). Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:FlowReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:meterAccuracyPercent rdf:type rdf:Property ;
    rdfs:label 'Meter Accuracy Percent' ;
    rdfs:comment 'The rated accuracy of the flow meter at the time of this reading, expressed as a percentage. Used to calculate measurement uncertainty for water balance calculations. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:FlowReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nrwCalculationFlag rdf:type rdf:Property ;
    rdfs:label 'Nrw Calculation Flag' ;
    rdfs:comment 'Indicates whether this flow reading is included in Non-Revenue Water (NRW) or Unaccounted-for Water (UFW) balance calculations for the associated DMA. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:FlowReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pressurePsi rdf:type rdf:Property ;
    rdfs:label 'Pressure Psi' ;
    rdfs:comment 'Water pressure measurement in PSI at the flow measurement point, captured concurrently with the flow reading. Used for hydraulic model calibration and pressure zone analysis. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scadaTagName rdf:type rdf:Property ;
    rdfs:label 'Scada Tag Name' ;
    rdfs:comment 'The SCADA system tag or point identifier that sourced this flow reading. Used for traceability back to the PI Historian or SCADA historian database. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:FlowReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:temperatureF rdf:type rdf:Property ;
    rdfs:label 'Temperature F' ;
    rdfs:comment 'Water temperature in degrees Fahrenheit at the measurement point. Used for flow compensation calculations and water quality correlation analysis. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:FlowReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalizerReading rdf:type rdf:Property ;
    rdfs:label 'Totalizer Reading' ;
    rdfs:comment 'Cumulative volume reading from the meter totalizer register. Used to calculate interval consumption by differencing consecutive readings. Typically in gallons or cubic meters. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:FlowReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:validatedBy rdf:type rdf:Property ;
    rdfs:label 'Validated By' ;
    rdfs:comment 'User ID or system process name that performed the validation of this flow reading. Used for audit trail and accountability. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:validationStatus rdf:type rdf:Property ;
    rdfs:label 'Validation Status' ;
    rdfs:comment 'Current validation state of the flow reading. Pending = awaiting review, Validated = approved by operator or automated validation, Rejected = failed validation rules, Corrected = manually adjusted after validation. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:validationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Validation Timestamp' ;
    rdfs:comment 'Date and time when the flow reading was validated or reviewed by an operator or automated validation process. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:leakDetectionSurveyId rdf:type rdf:Property ;
    rdfs:label 'Leak Detection Survey Id' ;
    rdfs:comment 'Unique identifier for the leak detection survey record. Primary key. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:LeakDetectionSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:conditionAssessmentId rdf:type rdf:Property ;
    rdfs:label 'Condition Assessment Id' ;
    rdfs:comment 'Foreign key linking to asset.condition_assessment. Business justification: Leak survey findings inform asset condition grades, remaining useful life estimates, and repair/replace decisions. Direct linkage supports proactive asset management and CIP prioritization in water ut. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ConditionAssessment .

ind:inspectionEventId rdf:type rdf:Property ;
    rdfs:label 'Inspection Event Id' ;
    rdfs:comment 'Foreign key linking to asset.inspection_event. Business justification: Leak detection surveys are a formal type of inspection event in asset management systems. Linking leak_detection_survey to inspection_event enables unified inspection reporting, regulatory submission ' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:InspectionEvent .

ind:ambientNoiseLevel rdf:type rdf:Property ;
    rdfs:label 'Ambient Noise Level' ;
    rdfs:comment 'Qualitative assessment of ambient noise levels during the survey, which can affect acoustic leak detection effectiveness. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:LeakDetectionSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvedBy rdf:type rdf:Property ;
    rdfs:label 'Approved By' ;
    rdfs:comment 'Name or identifier of the supervisor or manager who reviewed and approved the survey results.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Approved Timestamp' ;
    rdfs:comment 'Timestamp when the survey results were officially approved by a supervisor or manager.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:completedDate rdf:type rdf:Property ;
    rdfs:label 'Completed Date' ;
    rdfs:comment 'The date on which the leak detection survey was marked as completed and results were finalized. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:equipmentUsed rdf:type rdf:Property ;
    rdfs:label 'Equipment Used' ;
    rdfs:comment 'Description or list of specific leak detection equipment and instruments used during the survey (e.g., model numbers, device names). Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:LeakDetectionSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedLeakRateGpm rdf:type rdf:Property ;
    rdfs:label 'Estimated Leak Rate Gpm' ;
    rdfs:comment 'Estimated total leak flow rate for all leaks detected during this survey, measured in Gallons Per Minute (GPM). Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:LeakDetectionSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:leakLocationsGis rdf:type rdf:Property ;
    rdfs:label 'Leak Locations Gis' ;
    rdfs:comment 'Geographic coordinates or GIS feature identifiers for each leak location detected during the survey, typically stored as comma-separated latitude/longitude pairs or GIS asset IDs. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:LeakDetectionSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:leaksFoundCount rdf:type rdf:Property ;
    rdfs:label 'Leaks Found Count' ;
    rdfs:comment 'Total number of leaks identified during this survey. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:LeakDetectionSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:repairWorkOrderGenerated rdf:type rdf:Property ;
    rdfs:label 'Repair Work Order Generated' ;
    rdfs:comment 'Indicates whether a repair work order was automatically or manually generated as a result of leaks found during this survey. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:LeakDetectionSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:scheduledDate rdf:type rdf:Property ;
    rdfs:label 'Scheduled Date' ;
    rdfs:comment 'The originally planned or scheduled date for this leak detection survey, which may differ from the actual survey date. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:LeakDetectionSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:surveyCostCurrency rdf:type rdf:Property ;
    rdfs:label 'Survey Cost Currency' ;
    rdfs:comment 'Currency code for the survey cost amount. Defaults to USD for U.S. water utilities. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:LeakDetectionSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:surveyDate rdf:type rdf:Property ;
    rdfs:label 'Survey Date' ;
    rdfs:comment 'The calendar date on which the leak detection survey was conducted in the field. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:LeakDetectionSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:surveyEndTime rdf:type rdf:Property ;
    rdfs:label 'Survey End Time' ;
    rdfs:comment 'Timestamp when the field crew completed the leak detection survey activity. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:LeakDetectionSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:surveyLengthFeet rdf:type rdf:Property ;
    rdfs:label 'Survey Length Feet' ;
    rdfs:comment 'Total linear length of pipe surveyed during this leak detection activity, measured in feet. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:LeakDetectionSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:surveyMethod rdf:type rdf:Property ;
    rdfs:label 'Survey Method' ;
    rdfs:comment 'The technology or technique used to conduct the leak detection survey (e.g., acoustic correlator, listening stick, ground-penetrating radar, leak noise logger). Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:LeakDetectionSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surveyNotes rdf:type rdf:Property ;
    rdfs:label 'Survey Notes' ;
    rdfs:comment 'Free-text field for technician observations, special conditions, challenges encountered, or additional context about the survey. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:LeakDetectionSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surveyNumber rdf:type rdf:Property ;
    rdfs:label 'Survey Number' ;
    rdfs:comment 'Business-facing unique identifier or reference number assigned to this leak detection survey for tracking and reporting purposes. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:LeakDetectionSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surveyOutcome rdf:type rdf:Property ;
    rdfs:label 'Survey Outcome' ;
    rdfs:comment 'Final outcome or result classification of the leak detection survey activity. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:LeakDetectionSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surveyPriority rdf:type rdf:Property ;
    rdfs:label 'Survey Priority' ;
    rdfs:comment 'Priority level assigned to this leak detection survey based on factors such as DMA performance, customer complaints, or infrastructure criticality. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:LeakDetectionSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surveyStartTime rdf:type rdf:Property ;
    rdfs:label 'Survey Start Time' ;
    rdfs:comment 'Timestamp when the field crew began the leak detection survey activity. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:LeakDetectionSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:surveyStatus rdf:type rdf:Property ;
    rdfs:label 'Survey Status' ;
    rdfs:comment 'Current lifecycle status of the leak detection survey activity. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:LeakDetectionSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:technicianName rdf:type rdf:Property ;
    rdfs:label 'Technician Name' ;
    rdfs:comment 'Name of the lead technician or operator who conducted the leak detection survey. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:LeakDetectionSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:weatherConditions rdf:type rdf:Property ;
    rdfs:label 'Weather Conditions' ;
    rdfs:comment 'Description of weather conditions during the survey, which may impact detection accuracy (e.g., rain, wind, temperature). Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mainBreakId rdf:type rdf:Property ;
    rdfs:label 'Main Break Id' ;
    rdfs:comment 'Unique identifier for the distribution main break event. Primary key for the main break record. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:MainBreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:actualRestorationAt rdf:type rdf:Property ;
    rdfs:label 'Actual Restoration At' ;
    rdfs:comment 'Actual service restoration timestamp. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:MainBreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:affectedCustomerCount rdf:type rdf:Property ;
    rdfs:label 'Affected Customer Count' ;
    rdfs:comment 'Number of customer accounts affected by the incident. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:MainBreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:affectedDmas rdf:type rdf:Property ;
    rdfs:label 'Affected Dmas' ;
    rdfs:comment 'Comma-separated list of affected DMA IDs. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:MainBreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:affectedPressureZones rdf:type rdf:Property ;
    rdfs:label 'Affected Pressure Zones' ;
    rdfs:comment 'Comma-separated list of affected pressure zone IDs. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:MainBreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:affectedZones rdf:type rdf:Property ;
    rdfs:label 'Affected Zones' ;
    rdfs:comment 'Comma-separated list of affected pressure zones per VREQ-023. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:MainBreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:boilWaterAdvisoryIssued rdf:type rdf:Property ;
    rdfs:label 'Boil Water Advisory Issued' ;
    rdfs:comment 'Indicates whether a boil water advisory was issued to affected customers due to potential water quality compromise. True if advisory was issued, False otherwise.' ;
    rdfs:domain ind:MainBreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:breakNumber rdf:type rdf:Property ;
    rdfs:label 'Break Number' ;
    rdfs:comment 'Business identifier for the main break event, typically formatted as MB-YYYYNNNNNN for external reference and reporting. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:MainBreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:breakStatus rdf:type rdf:Property ;
    rdfs:label 'Break Status' ;
    rdfs:comment 'Current lifecycle status of the main break event: reported, dispatched, in progress, repaired, closed, or deferred. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:MainBreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:breakTimestamp rdf:type rdf:Property ;
    rdfs:label 'Break Timestamp' ;
    rdfs:comment 'Date and time when the main break was first detected or reported. Principal business event timestamp for the break occurrence. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:MainBreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:breakType rdf:type rdf:Property ;
    rdfs:label 'Break Type' ;
    rdfs:comment 'Classification of the main break failure mode: circumferential crack, longitudinal crack, blowout, joint failure, service line break, or corrosion pinhole. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:MainBreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:customersAffectedCount rdf:type rdf:Property ;
    rdfs:label 'Customers Affected Count' ;
    rdfs:comment 'Number of customer accounts impacted by service disruption due to the main break. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dispatchTimestamp rdf:type rdf:Property ;
    rdfs:label 'Dispatch Timestamp' ;
    rdfs:comment 'Date and time when field crew was dispatched to the main break location. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:MainBreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:expectedRestorationAt rdf:type rdf:Property ;
    rdfs:label 'Expected Restoration At' ;
    rdfs:comment 'Expected service restoration timestamp per VREQ-023. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:MainBreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:expectedRestorationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Expected Restoration Timestamp' ;
    rdfs:comment 'Expected service restoration timestamp. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:MainBreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:locationAddress rdf:type rdf:Property ;
    rdfs:label 'Location Address' ;
    rdfs:comment 'Street address or nearest intersection where the main break occurred. Organizational location data classified as confidential. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:MainBreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:locationLatitude rdf:type rdf:Property ;
    rdfs:label 'Location Latitude' ;
    rdfs:comment 'Geographic latitude coordinate (decimal degrees) of the main break location for GIS mapping and spatial analysis. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:MainBreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:locationLongitude rdf:type rdf:Property ;
    rdfs:label 'Location Longitude' ;
    rdfs:comment 'Geographic longitude coordinate (decimal degrees) of the main break location for GIS mapping and spatial analysis. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:MainBreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pipeAgeYears rdf:type rdf:Property ;
    rdfs:label 'Pipe Age Years' ;
    rdfs:comment 'Estimated age of the pipe at the time of break, calculated from installation date to break date, measured in years. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:MainBreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:pipeDiameterInches rdf:type rdf:Property ;
    rdfs:label 'Pipe Diameter Inches' ;
    rdfs:comment 'Nominal diameter of the failed pipe in inches. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pipeMaterial rdf:type rdf:Property ;
    rdfs:label 'Pipe Material' ;
    rdfs:comment 'Material composition of the failed pipe: cast iron, ductile iron, PVC (polyvinyl chloride), HDPE (high-density polyethylene), steel, concrete, asbestos cement, or copper. [ENUM-REF-CANDIDATE: cast_iron|ductile_iron|pvc|hdpe|steel|concrete|asbestos_cement|copper — 8 candidates stripped; promote to reference product]. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:populationAtRisk rdf:type rdf:Property ;
    rdfs:label 'Population At Risk' ;
    rdfs:comment 'Estimated population affected by incident per VREQ-023. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:MainBreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:regulatoryReportRequired rdf:type rdf:Property ;
    rdfs:label 'Regulatory Report Required' ;
    rdfs:comment 'Indicates whether the main break requires regulatory reporting to EPA, state primacy agency, or Public Utilities Commission. True if reporting is required, False otherwise. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:MainBreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:repairCompleteTimestamp rdf:type rdf:Property ;
    rdfs:label 'Repair Complete Timestamp' ;
    rdfs:comment 'Date and time when repair work was completed and the main was returned to service. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:MainBreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:repairDurationHours rdf:type rdf:Property ;
    rdfs:label 'Repair Duration Hours' ;
    rdfs:comment 'Total duration of the repair activity from start to completion, measured in hours. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:MainBreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:repairMethod rdf:type rdf:Property ;
    rdfs:label 'Repair Method' ;
    rdfs:comment 'Method used to repair the main break: clamp, sleeve, pipe replacement, joint repair, valve replacement, or temporary bypass. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:MainBreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:repairStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Repair Start Timestamp' ;
    rdfs:comment 'Date and time when repair work commenced on the main break. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:MainBreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:reportedBy rdf:type rdf:Property ;
    rdfs:label 'Reported By' ;
    rdfs:comment 'Source of the main break report: customer, field crew, SCADA alert, patrol, third party, or internal inspection. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:MainBreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:soilCondition rdf:type rdf:Property ;
    rdfs:label 'Soil Condition' ;
    rdfs:comment 'Soil condition at the break location: clay, sand, gravel, rock, mixed, corrosive, saturated, or unknown. Influences corrosion rates and pipe stability. [ENUM-REF-CANDIDATE: clay|sand|gravel|rock|mixed|corrosive|saturated|unknown — 8 candidates stripped; promote to reference product]. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:MainBreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trafficImpact rdf:type rdf:Property ;
    rdfs:label 'Traffic Impact' ;
    rdfs:comment 'Impact of the main break on traffic and road access: none, lane closure, road closure, detour required, or emergency access restricted. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:MainBreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waterLostGallons rdf:type rdf:Property ;
    rdfs:label 'Water Lost Gallons' ;
    rdfs:comment 'Estimated volume of water lost during the break event, measured in gallons. Critical for NRW (Non-Revenue Water) and UFW (Unaccounted-for Water) reporting. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:MainBreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:weatherCondition rdf:type rdf:Property ;
    rdfs:label 'Weather Condition' ;
    rdfs:comment 'Weather condition at the time of the break: normal, freezing, extreme cold, heavy rain, drought, snow, or extreme heat. Relevant for freeze-thaw and soil movement analysis. [ENUM-REF-CANDIDATE: normal|freezing|extreme_cold|heavy_rain|drought|snow|extreme_heat — 7 candidates stripped; promote to reference product]. Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateScheduleId rdf:type rdf:Property ;
    rdfs:label 'Rate Schedule Id' ;
    rdfs:comment 'Foreign key linking to billing.billing_rate_schedule. Business justification: invoice.rate_schedule_code is a denormalized STRING reference to the billing_rate_schedule table, which has its own rate_schedule_code attribute. Adding a proper FK billing_rate_schedule_id normalizes' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RateSchedule .

ind:adjustmentAmount rdf:type rdf:Property ;
    rdfs:label 'Adjustment Amount' ;
    rdfs:comment 'Net adjustment amount applied to the invoice, including credits for billing errors, leak adjustments, service quality issues, or promotional discounts. Positive values increase invoice total; negative values decrease it. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:balanceDueUsd rdf:type rdf:Property ;
    rdfs:label 'Balance Due Usd' ;
    rdfs:comment 'The balance due usd value recorded for each invoice in the billing domain.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:billingPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Billing Period End Date' ;
    rdfs:comment 'Last day of the consumption period covered by this invoice. Typically aligns with the current meter read date or service period end. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:billingPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Billing Period Start Date' ;
    rdfs:comment 'First day of the consumption period covered by this invoice. Typically aligns with the prior meter read date or service period start. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ccrIncluded rdf:type rdf:Property ;
    rdfs:label 'Ccr Included' ;
    rdfs:comment 'Boolean flag indicating whether the annual Consumer Confidence Report (water quality report) was included with this invoice mailing. Required annually under Safe Drinking Water Act (SDWA). Ref: Oracle CC&B.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:conservationMessage rdf:type rdf:Property ;
    rdfs:label 'Conservation Message' ;
    rdfs:comment 'Optional water conservation message or tip printed on the invoice to encourage efficient water use. May vary seasonally or based on drought conditions. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:createdByUser rdf:type rdf:Property ;
    rdfs:label 'Created By User' ;
    rdfs:comment 'User ID or system process name that created this invoice record. For automated cycle billing, typically a batch process identifier; for manual invoices, the billing staff user ID. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:currencyCode rdf:type rdf:Property ;
    rdfs:label 'Currency Code' ;
    rdfs:comment 'Three-letter ISO 4217 currency code for all monetary amounts on this invoice. Typically USD for U.S. water utilities.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deliveryMethod rdf:type rdf:Property ;
    rdfs:label 'Delivery Method' ;
    rdfs:comment 'Method by which the invoice was delivered to the customer. Options include postal mail (paper bill), email (electronic bill), customer web portal, or SMS notification with portal link. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disconnectionDate rdf:type rdf:Property ;
    rdfs:label 'Disconnection Date' ;
    rdfs:comment 'Date on which service may be disconnected if payment is not received. Typically set 10-15 days after due date, subject to regulatory notice requirements and customer protections. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disputeFlag rdf:type rdf:Property ;
    rdfs:label 'Dispute Flag' ;
    rdfs:comment 'Boolean flag indicating whether the customer has formally disputed charges on this invoice. Triggers dispute resolution workflow and may suspend collection activities. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dueDate rdf:type rdf:Property ;
    rdfs:label 'Due Date' ;
    rdfs:comment 'Date by which payment must be received to avoid late fees or service disconnection. Calculated based on invoice date plus payment terms (typically 15-30 days). Ref: Oracle CC&B.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:generationMethod rdf:type rdf:Property ;
    rdfs:label 'Generation Method' ;
    rdfs:comment 'Method by which the invoice was generated. Automated cycle invoices are produced by scheduled batch billing runs; manual invoices are created by billing staff; off-cycle invoices are generated outside normal schedules; estimated invoices use projected consumption; corrected invoices replace prior errors. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:invoiceDate rdf:type rdf:Property ;
    rdfs:label 'Invoice Date' ;
    rdfs:comment 'Date the invoice was generated and issued to the customer. This is the official invoice date printed on the bill and used for aging calculations. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:invoiceNumber rdf:type rdf:Property ;
    rdfs:label 'Invoice Number' ;
    rdfs:comment 'Externally visible, human-readable invoice number printed on customer bills and used for customer service inquiries. Must be unique across all invoices. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:invoiceStatus rdf:type rdf:Property ;
    rdfs:label 'Invoice Status' ;
    rdfs:comment 'Current lifecycle state of the invoice. Draft invoices are pending finalization; issued invoices have been sent to customers; paid invoices are fully settled; partial_paid invoices have received some payment; overdue invoices are past due date; cancelled invoices are nullified before payment; void invoices are nullified after issuance. [ENUM-REF-CANDIDATE: draft|issued|paid|partial_paid|overdue|cancelled|void — 7 candidates stripped; promote to reference product]. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:invoiceType rdf:type rdf:Property ;
    rdfs:label 'Invoice Type' ;
    rdfs:comment 'Classification of the invoice based on billing circumstances. Regular cycle invoices are standard periodic bills; final invoices are issued upon service termination; estimated invoices use projected consumption when actual reads are unavailable; corrected invoices replace erroneous prior bills; off-cycle invoices are generated outside normal billing cycles; adjustment invoices correct prior billing errors. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isEstimated rdf:type rdf:Property ;
    rdfs:label 'Is Estimated' ;
    rdfs:comment 'Boolean flag indicating whether consumption values on this invoice are estimated rather than based on actual meter readings. True when meter is inaccessible or malfunctioning. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isFinal rdf:type rdf:Property ;
    rdfs:label 'Is Final' ;
    rdfs:comment 'Boolean flag indicating whether this is a final invoice issued upon service termination or account closure. Final invoices settle all outstanding charges and close the billing relationship. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lateFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Late Fee Amount' ;
    rdfs:comment 'Late payment penalty assessed if payment is not received by due date. Calculated as a percentage of outstanding balance or flat fee per utility policy and regulatory limits. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:modifiedByUser rdf:type rdf:Property ;
    rdfs:label 'Modified By User' ;
    rdfs:comment 'User ID or system process name that last modified this invoice record. Used for audit trail and accountability. Ref: Oracle CC&B.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:periodEndDate rdf:type rdf:Property ;
    rdfs:label 'Period End Date' ;
    rdfs:comment 'The period end date associated with each invoice record in the billing domain.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:periodStartDate rdf:type rdf:Property ;
    rdfs:label 'Period Start Date' ;
    rdfs:comment 'The period start date associated with each invoice record in the billing domain.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:previousBalanceAmount rdf:type rdf:Property ;
    rdfs:label 'Previous Balance Amount' ;
    rdfs:comment 'Outstanding balance carried forward from prior billing periods. Represents unpaid or partially paid amounts from previous invoices. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:printDate rdf:type rdf:Property ;
    rdfs:label 'Print Date' ;
    rdfs:comment 'Date the invoice was physically printed or electronically rendered for delivery to the customer. May differ from invoice date for batch processing. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:stormwaterArea rdf:type rdf:Property ;
    rdfs:label 'Stormwater Area' ;
    rdfs:comment 'Total impervious surface area (in square feet or square meters) used to calculate stormwater management fees. Applicable for properties subject to stormwater utility charges. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:stormwaterChargeAmount rdf:type rdf:Property ;
    rdfs:label 'Stormwater Charge Amount' ;
    rdfs:comment 'Charges for stormwater management services, typically calculated based on impervious surface area. Supports stormwater infrastructure maintenance and regulatory compliance. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:taxAmount rdf:type rdf:Property ;
    rdfs:label 'Tax Amount' ;
    rdfs:comment 'Total tax charges applied to the invoice, including sales tax, utility tax, franchise fees, or other regulatory taxes as required by jurisdiction. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalAmountDue rdf:type rdf:Property ;
    rdfs:label 'Total Amount Due' ;
    rdfs:comment 'Total amount the customer must pay, calculated as sum of current period charges (water, wastewater, stormwater, other), taxes, adjustments, and previous balance. This is the headline amount printed on the invoice. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalAmountUsd rdf:type rdf:Property ;
    rdfs:label 'Total Amount Usd' ;
    rdfs:comment 'The total amount usd value recorded for each invoice in the billing domain.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:vibeMutationFlag rdf:type rdf:Property ;
    rdfs:label 'Vibe Mutation Flag' ;
    rdfs:comment 'Flag added by VIBE mutator to ensure entity touched. Ref: Oracle CC&B.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:wastewaterChargeAmount rdf:type rdf:Property ;
    rdfs:label 'Wastewater Charge Amount' ;
    rdfs:comment 'Total charges for wastewater collection and treatment services during the billing period. May include volumetric charges, fixed fees, and strength-of-waste surcharges for industrial users. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:wastewaterVolume rdf:type rdf:Property ;
    rdfs:label 'Wastewater Volume' ;
    rdfs:comment 'Volume of wastewater discharged during the billing period, typically calculated as a percentage of water consumption or measured separately for industrial customers. Measured in same unit as water consumption. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:waterChargeAmount rdf:type rdf:Property ;
    rdfs:label 'Water Charge Amount' ;
    rdfs:comment 'Total charges for potable water service during the billing period, including volumetric consumption charges and fixed service fees. Calculated based on applicable rate schedule and tier structure. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:waterConsumptionUom rdf:type rdf:Property ;
    rdfs:label 'Water Consumption Uom' ;
    rdfs:comment 'Unit of measure for water consumption volume. Common units include gallons, cubic meters (m³), hundred cubic feet (CCF), or thousand gallons (kgal). Ref: Oracle CC&B.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waterConsumptionVolume rdf:type rdf:Property ;
    rdfs:label 'Water Consumption Volume' ;
    rdfs:comment 'Total volume of potable water consumed during the billing period, measured in gallons or cubic meters depending on utility standard. Derived from meter readings or estimated when actual reads unavailable. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:invoiceLineId rdf:type rdf:Property ;
    rdfs:label 'Invoice Line Id' ;
    rdfs:comment 'Unique identifier for the invoice line item. Primary key for the invoice line product. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:InvoiceLine .

ind:rateComponentId rdf:type rdf:Property ;
    rdfs:label 'Rate Component Id' ;
    rdfs:comment 'Foreign key linking to billing.rate_component. Business justification: Each invoice_line represents a discrete billable component (base charge, volumetric tier, stormwater fee, etc.) that is generated by a specific rate_component within the billing_rate_schedule. invoice' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RateComponent .

ind:adjustmentReasonCode rdf:type rdf:Property ;
    rdfs:label 'Adjustment Reason Code' ;
    rdfs:comment 'Code indicating the reason for billing adjustments, credits, or special charges. Used for adjustment and dispute tracking. [ENUM-REF-CANDIDATE: BILLING_ERROR|METER_MALFUNCTION|LEAK_ADJUSTMENT|CUSTOMER_DISPUTE|RATE_CHANGE|PRORATION|CREDIT_MEMO|WRITE_OFF|GOODWILL|OTHER — 10 candidates stripped; promote to reference product]. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:adjustmentReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Adjustment Reference Number' ;
    rdfs:comment 'Reference number linking this line to an adjustment request, dispute case, or credit memo. Provides audit trail for non-standard charges. Ref: Oracle CC&B.' ;
    rdfs:domain ind:InvoiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingDeterminant rdf:type rdf:Property ;
    rdfs:label 'Billing Determinant' ;
    rdfs:comment 'The basis or method used to calculate this charge. Identifies whether charge is based on metered usage, property characteristics, flat rate, or other factors. [ENUM-REF-CANDIDATE: METERED_CONSUMPTION|ESTIMATED_CONSUMPTION|FLAT_RATE|METER_SIZE|PROPERTY_SIZE|IMPERVIOUS_AREA|FIXTURE_COUNT|CONNECTION_SIZE|CUSTOMER_CLASS|OTHER — 10 candidates stripped; promote to reference product]. Ref: Oracle CC&B.' ;
    rdfs:domain ind:InvoiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:chargeDescription rdf:type rdf:Property ;
    rdfs:label 'Charge Description' ;
    rdfs:comment 'Detailed textual description of the charge as it appears on the customer invoice. Provides human-readable explanation of the line item. Ref: Oracle CC&B.' ;
    rdfs:domain ind:InvoiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:chargeType rdf:type rdf:Property ;
    rdfs:label 'Charge Type' ;
    rdfs:comment 'The charge type value recorded for each invoice line in the billing domain.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:chargeTypeCode rdf:type rdf:Property ;
    rdfs:label 'Charge Type Code' ;
    rdfs:comment 'Classification of the charge line item by billing component type. Distinguishes between consumption charges, fixed fees, taxes, adjustments, and other billing elements. [ENUM-REF-CANDIDATE: WATER_CONSUMPTION|WASTEWATER_SERVICE|STORMWATER_FEE|BASE_SERVICE|METER_CHARGE|CONNECTION_FEE|LATE_FEE|ADJUSTMENT|TAX|SURCHARGE|PENALTY|CREDIT|REBATE|DEPOSIT|OTHER — 15 candidates stripped; promote to reference product]. Ref: Oracle CC&B.' ;
    rdfs:domain ind:InvoiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isDisputed rdf:type rdf:Property ;
    rdfs:label 'Is Disputed' ;
    rdfs:comment 'Indicates whether this charge is currently under customer dispute. True if disputed, false otherwise. Used for dispute tracking and collections management. Ref: Oracle CC&B.' ;
    rdfs:domain ind:InvoiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isProrated rdf:type rdf:Property ;
    rdfs:label 'Is Prorated' ;
    rdfs:comment 'Indicates whether this charge has been prorated due to partial billing period, service start/stop, or rate change. True if prorated, false otherwise. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isTaxable rdf:type rdf:Property ;
    rdfs:label 'Is Taxable' ;
    rdfs:comment 'Indicates whether this line item is subject to taxation. True if taxable, false if tax-exempt. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastModifiedByUser rdf:type rdf:Property ;
    rdfs:label 'Last Modified By User' ;
    rdfs:comment 'User identifier or system process that last modified this invoice line record. Supports audit and accountability requirements. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lineAmount rdf:type rdf:Property ;
    rdfs:label 'Line Amount' ;
    rdfs:comment 'Calculated charge amount for this line item before taxes and adjustments. Typically consumption_quantity multiplied by unit_rate for consumption charges, or fixed amount for service fees. Ref: Oracle CC&B.' ;
    rdfs:domain ind:InvoiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lineNumber rdf:type rdf:Property ;
    rdfs:label 'Line Number' ;
    rdfs:comment 'The line number value recorded for each invoice line in the billing domain.' ;
    rdfs:domain ind:InvoiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lineSequenceNumber rdf:type rdf:Property ;
    rdfs:label 'Line Sequence Number' ;
    rdfs:comment 'Sequential ordering of line items within the parent invoice. Determines display order on customer bill. Ref: Oracle CC&B.' ;
    rdfs:domain ind:InvoiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lineStatus rdf:type rdf:Property ;
    rdfs:label 'Line Status' ;
    rdfs:comment 'Current status of the invoice line item in the billing lifecycle. Tracks whether the charge is active, has been adjusted, disputed, or reversed. Ref: Oracle CC&B.' ;
    rdfs:domain ind:InvoiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:printSequence rdf:type rdf:Property ;
    rdfs:label 'Print Sequence' ;
    rdfs:comment 'Display order for this line item on printed or electronic invoices. Controls the presentation sequence for customer-facing billing documents. Ref: Oracle CC&B.' ;
    rdfs:domain ind:InvoiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:prorationFactor rdf:type rdf:Property ;
    rdfs:label 'Proration Factor' ;
    rdfs:comment 'Decimal factor applied for prorated charges. Represents the portion of the full billing period or rate being charged (e.g., 0.5000 for half period). Ref: Oracle CC&B.' ;
    rdfs:domain ind:InvoiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rateUsd rdf:type rdf:Property ;
    rdfs:label 'Rate Usd' ;
    rdfs:comment 'The rate usd value recorded for each invoice line in the billing domain.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:revenueClass rdf:type rdf:Property ;
    rdfs:label 'Revenue Class' ;
    rdfs:comment 'Classification of revenue type for financial reporting and regulatory compliance. Distinguishes between operating revenue, capital contributions, and other revenue categories. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceDays rdf:type rdf:Property ;
    rdfs:label 'Service Days' ;
    rdfs:comment 'Number of days in the billing period for this charge. Used for proration calculations and billing cycle analysis. Ref: Oracle CC&B.' ;
    rdfs:domain ind:InvoiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:taxAmountUsd rdf:type rdf:Property ;
    rdfs:label 'Tax Amount Usd' ;
    rdfs:comment 'The tax amount usd value recorded for each invoice line in the billing domain.' ;
    rdfs:domain ind:InvoiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:taxRatePercentage rdf:type rdf:Property ;
    rdfs:label 'Tax Rate Percentage' ;
    rdfs:comment 'Tax rate percentage applied to calculate the tax amount. Expressed as decimal (e.g., 0.0825 for 8.25% tax rate). Ref: Oracle CC&B.' ;
    rdfs:domain ind:InvoiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalLineAmount rdf:type rdf:Property ;
    rdfs:label 'Total Line Amount' ;
    rdfs:comment 'Total amount for this line item including taxes and adjustments. Sum of line_amount and tax_amount. Contributes to invoice total. Ref: Oracle CC&B.' ;
    rdfs:domain ind:InvoiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:unitRate rdf:type rdf:Property ;
    rdfs:label 'Unit Rate' ;
    rdfs:comment 'Price per unit of consumption or service. The rate applied to calculate the line charge amount. Expressed in currency per consumption_unit_of_measure. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentBillInvoiceId rdf:type rdf:Property ;
    rdfs:label 'Payment Bill Invoice Id' ;
    rdfs:comment 'Reference to the specific bill or invoice that this payment is intended to satisfy. May be null for advance payments or account credits. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Invoice .

ind:paymentInvoiceId rdf:type rdf:Property ;
    rdfs:label 'Payment Invoice Id' ;
    rdfs:comment 'Reference to the specific bill or invoice that this payment is intended to satisfy. May be null for advance payments or account credits. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Invoice .

ind:paymentPlanId rdf:type rdf:Property ;
    rdfs:label 'Payment Plan Id' ;
    rdfs:comment 'Reference to the payment plan or payment arrangement under which this payment was made. Null for non-plan payments. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PaymentPlan .

ind:reversedByPaymentId rdf:type rdf:Property ;
    rdfs:label 'Reversed By Payment Id' ;
    rdfs:comment 'Reference to the reversal payment transaction that cancelled or reversed this payment. Null for non-reversed payments. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Payment .

ind:amount rdf:type rdf:Property ;
    rdfs:label 'Amount' ;
    rdfs:comment 'Total monetary amount of the payment received from the customer, in the utility\'s base currency. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:appliedAmount rdf:type rdf:Property ;
    rdfs:label 'Applied Amount' ;
    rdfs:comment 'The portion of the payment amount that has been applied to outstanding account balances. May differ from payment_amount if payment is partially applied or held as credit. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:authorizationCode rdf:type rdf:Property ;
    rdfs:label 'Authorization Code' ;
    rdfs:comment 'Authorization or approval code returned by the payment processor for credit card or ACH transactions. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bankAccountLastFour rdf:type rdf:Property ;
    rdfs:label 'Bank Account Last Four' ;
    rdfs:comment 'Last four digits of the bank account number used for ACH or electronic payments. Used for customer verification without exposing full account number. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cardLastFour rdf:type rdf:Property ;
    rdfs:label 'Card Last Four' ;
    rdfs:comment 'Last four digits of the credit or debit card number used for card payments. Used for customer verification without exposing full card number. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cardType rdf:type rdf:Property ;
    rdfs:label 'Card Type' ;
    rdfs:comment 'The credit or debit card brand for card payments (e.g., Visa, MasterCard, American Express, Discover). Null for non-card payments. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:checkNumber rdf:type rdf:Property ;
    rdfs:label 'Check Number' ;
    rdfs:comment 'The check number for check payments. Null for non-check payment methods. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clearedDate rdf:type rdf:Property ;
    rdfs:label 'Cleared Date' ;
    rdfs:comment 'The date on which the payment cleared the bank or financial institution, confirming funds availability. Null for cash payments. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:isAutoPay rdf:type rdf:Property ;
    rdfs:label 'Is Auto Pay' ;
    rdfs:comment 'Boolean flag indicating whether this payment was processed automatically through an auto-pay enrollment (True) or was a manual customer-initiated payment (False). Ref: Oracle CC&B.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isRecurring rdf:type rdf:Property ;
    rdfs:label 'Is Recurring' ;
    rdfs:comment 'Boolean flag indicating whether this payment is part of a recurring payment plan or schedule (True) or a one-time payment (False). Ref: Oracle CC&B.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:locationCode rdf:type rdf:Property ;
    rdfs:label 'Location Code' ;
    rdfs:comment 'Code identifying the physical location or office where the payment was received (e.g., branch office, payment center). Null for remote payments. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lockboxNumber rdf:type rdf:Property ;
    rdfs:label 'Lockbox Number' ;
    rdfs:comment 'Bank lockbox number or identifier for payments received through lockbox processing services. Null for non-lockbox payments. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:method rdf:type rdf:Property ;
    rdfs:label 'Method' ;
    rdfs:comment 'The financial instrument or tender type used to make the payment (e.g., check, ACH bank draft, credit card, debit card, cash, money order). Ref: Oracle CC&B.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nsfFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Nsf Fee Amount' ;
    rdfs:comment 'The fee charged to the customer account for a returned NSF payment. Null if no NSF occurred or no fee was assessed. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nsfIndicator rdf:type rdf:Property ;
    rdfs:label 'Nsf Indicator' ;
    rdfs:comment 'Boolean flag indicating whether this payment was returned due to non-sufficient funds (True) or processed successfully (False). Ref: Oracle CC&B.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:paymentDate rdf:type rdf:Property ;
    rdfs:label 'Payment Date' ;
    rdfs:comment 'The date on which the payment was received or processed by the utility. This is the business event date for revenue recognition. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:paymentNumber rdf:type rdf:Property ;
    rdfs:label 'Payment Number' ;
    rdfs:comment 'Business-facing unique reference number for the payment transaction, used for customer inquiries and reconciliation. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentStatus rdf:type rdf:Property ;
    rdfs:label 'Payment Status' ;
    rdfs:comment 'Current lifecycle status of the payment transaction indicating whether it has been posted to the account, cleared by the bank, or reversed. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentTimestamp rdf:type rdf:Property ;
    rdfs:label 'Payment Timestamp' ;
    rdfs:comment 'Precise date and time when the payment transaction was received or recorded in the system. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:paymentType rdf:type rdf:Property ;
    rdfs:label 'Payment Type' ;
    rdfs:comment 'Classification of the payment purpose (e.g., regular bill payment, advance payment, deposit, refund, billing adjustment). Ref: Oracle CC&B.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postingDate rdf:type rdf:Property ;
    rdfs:label 'Posting Date' ;
    rdfs:comment 'The date on which the payment was posted to the customer account and applied against outstanding balances. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:processorName rdf:type rdf:Property ;
    rdfs:label 'Processor Name' ;
    rdfs:comment 'Name of the third-party payment processor or gateway that handled the electronic payment transaction (e.g., Stripe, PayPal, bank lockbox service). Ref: Oracle CC&B.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reversalReason rdf:type rdf:Property ;
    rdfs:label 'Reversal Reason' ;
    rdfs:comment 'Explanation or reason code for why the payment was reversed or cancelled. Null for non-reversed payments. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unappliedAmount rdf:type rdf:Property ;
    rdfs:label 'Unapplied Amount' ;
    rdfs:comment 'The portion of the payment amount that remains unapplied and is held as account credit or pending allocation. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentApplicationId rdf:type rdf:Property ;
    rdfs:label 'Payment Application Id' ;
    rdfs:comment 'Unique identifier for the payment application record. Primary key. Ref: Oracle CC&B.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:primaryPaymentInvoiceLineId rdf:type rdf:Property ;
    rdfs:label 'Primary Payment Invoice Line Id' ;
    rdfs:comment 'Reference to the specific invoice line item to which this payment is applied. Enables line-level payment allocation. Ref: Oracle CC&B.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:InvoiceLine .

ind:adjustmentDate rdf:type rdf:Property ;
    rdfs:label 'Adjustment Date' ;
    rdfs:comment 'The date on which an adjustment was made to this payment application. Null if no adjustment occurred. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:adjustmentIndicator rdf:type rdf:Property ;
    rdfs:label 'Adjustment Indicator' ;
    rdfs:comment 'Flag indicating whether this payment application was adjusted after initial processing due to billing correction or dispute resolution. Ref: Oracle CC&B.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:allocationMethod rdf:type rdf:Property ;
    rdfs:label 'Allocation Method' ;
    rdfs:comment 'The method or rule used to allocate the payment across outstanding charges (e.g., FIFO, oldest invoice first, pro-rata across all balances). [ENUM-REF-CANDIDATE: fifo|lifo|oldest_first|highest_balance|pro_rata|manual|system_default — 7 candidates stripped; promote to reference product]. Ref: Oracle CC&B.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicationDate rdf:type rdf:Property ;
    rdfs:label 'Application Date' ;
    rdfs:comment 'The business date on which the payment was applied to the invoice or account balance. This is the effective date for accounts receivable (AR) reconciliation. Ref: Oracle CC&B.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicationSequence rdf:type rdf:Property ;
    rdfs:label 'Application Sequence' ;
    rdfs:comment 'Sequential order in which this application was processed for a given payment. Supports scenarios where a single payment is split across multiple invoices. Ref: Oracle CC&B.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:applicationSource rdf:type rdf:Property ;
    rdfs:label 'Application Source' ;
    rdfs:comment 'Source or channel through which the payment application was initiated (e.g., automated system rule, manual CSR entry, batch process, customer self-service portal). [ENUM-REF-CANDIDATE: automated|manual|batch|api|customer_portal|ivr|mobile_app — 7 candidates stripped; promote to reference product]. Ref: Oracle CC&B.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Application Timestamp' ;
    rdfs:comment 'The precise date and time when the payment application transaction was processed in the billing system. Ref: Oracle CC&B.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:appliedAmountUsd rdf:type rdf:Property ;
    rdfs:label 'Applied Amount Usd' ;
    rdfs:comment 'The applied amount usd value recorded for each payment application in the billing domain.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:arReconciliationStatus rdf:type rdf:Property ;
    rdfs:label 'Ar Reconciliation Status' ;
    rdfs:comment 'Status indicating whether this payment application has been successfully reconciled in the accounts receivable ledger. Ref: Oracle CC&B.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:balanceBucketCode rdf:type rdf:Property ;
    rdfs:label 'Balance Bucket Code' ;
    rdfs:comment 'Code identifying the account balance bucket or aging category to which the payment was applied (e.g., current, 30-day, 60-day, 90-day past due). Ref: Oracle CC&B.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disputeIndicator rdf:type rdf:Property ;
    rdfs:label 'Dispute Indicator' ;
    rdfs:comment 'Flag indicating whether this payment application is associated with a billing dispute or customer challenge. Ref: Oracle CC&B.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:glAccountCode rdf:type rdf:Property ;
    rdfs:label 'Gl Account Code' ;
    rdfs:comment 'General ledger account code to which this payment application is posted for financial accounting and revenue recognition. Ref: Oracle CC&B.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isOverpayment rdf:type rdf:Property ;
    rdfs:label 'Is Overpayment' ;
    rdfs:comment 'Flag indicating whether this payment application resulted in an overpayment or credit balance on the account. Ref: Oracle CC&B.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPrepayment rdf:type rdf:Property ;
    rdfs:label 'Is Prepayment' ;
    rdfs:comment 'Flag indicating whether this payment application represents a prepayment applied to future charges rather than outstanding invoices. Ref: Oracle CC&B.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:overpaymentHandling rdf:type rdf:Property ;
    rdfs:label 'Overpayment Handling' ;
    rdfs:comment 'Indicates how overpayment or excess credit is handled: refunded to customer, held as credit, transferred to another account, or held pending customer instruction. Ref: Oracle CC&B.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revenueRecognitionDate rdf:type rdf:Property ;
    rdfs:label 'Revenue Recognition Date' ;
    rdfs:comment 'The date on which the applied payment amount is recognized as revenue in the general ledger, per GASB revenue recognition standards. Ref: Oracle CC&B.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reversalDate rdf:type rdf:Property ;
    rdfs:label 'Reversal Date' ;
    rdfs:comment 'The date on which this payment application was reversed. Null if not reversed. Ref: Oracle CC&B.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reversalIndicator rdf:type rdf:Property ;
    rdfs:label 'Reversal Indicator' ;
    rdfs:comment 'Flag indicating whether this payment application has been reversed due to payment failure, dispute, or correction. Ref: Oracle CC&B.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reversalReasonCode rdf:type rdf:Property ;
    rdfs:label 'Reversal Reason Code' ;
    rdfs:comment 'Code indicating the reason for reversing the payment application (e.g., NSF, dispute, system error, customer request). Ref: Oracle CC&B.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:canonicalCustomerAccountId rdf:type rdf:Property ;
    rdfs:label 'Canonical Customer Account Id' ;
    rdfs:comment 'Unique identifier for the canonical customer account referenced by each billing account record in the billing domain.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CustomerAccount .

ind:aging30Days rdf:type rdf:Property ;
    rdfs:label 'Aging 30 Days' ;
    rdfs:comment 'Portion of the account balance that is 1-30 days past due. Used for delinquency tracking and collections workflow triggers. Ref: Oracle CC&B.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:aging60Days rdf:type rdf:Property ;
    rdfs:label 'Aging 60 Days' ;
    rdfs:comment 'Portion of the account balance that is 31-60 days past due. Indicates escalating delinquency requiring more aggressive collection actions. Ref: Oracle CC&B.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:aging90Days rdf:type rdf:Property ;
    rdfs:label 'Aging 90 Days' ;
    rdfs:comment 'Portion of the account balance that is 61-90 days past due. Typically triggers final notice and service disconnection warnings. Ref: Oracle CC&B.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:agingCurrent rdf:type rdf:Property ;
    rdfs:label 'Aging Current' ;
    rdfs:comment 'Portion of the account balance that is current and not yet past due. Part of the aging analysis for accounts receivable management. Ref: Oracle CC&B.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:agingOver90Days rdf:type rdf:Property ;
    rdfs:label 'Aging Over 90 Days' ;
    rdfs:comment 'Portion of the account balance that is more than 90 days past due. Highest risk category for write-off and may result in service termination or legal action. Ref: Oracle CC&B.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:autopayEnrolled rdf:type rdf:Property ;
    rdfs:label 'Autopay Enrolled' ;
    rdfs:comment 'Indicates whether the customer is enrolled in automatic payment processing where bills are automatically paid from a bank account or credit card on the due date. Ref: Oracle CC&B.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:autopayMethod rdf:type rdf:Property ;
    rdfs:label 'Autopay Method' ;
    rdfs:comment 'Payment instrument used for automatic payment processing if autopay is enabled. Specifies whether payments are drawn from bank account or charged to card. Ref: Oracle CC&B.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:balanceForward rdf:type rdf:Property ;
    rdfs:label 'Balance Forward' ;
    rdfs:comment 'Previous balance carried forward from the prior billing cycle before current period charges are applied. Used for aging analysis and delinquency tracking. Ref: Oracle CC&B.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:budgetBillingAmount rdf:type rdf:Property ;
    rdfs:label 'Budget Billing Amount' ;
    rdfs:comment 'Fixed monthly amount charged under budget billing program. Calculated based on historical consumption patterns and reconciled annually. Ref: Oracle CC&B.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:budgetBillingEnrolled rdf:type rdf:Property ;
    rdfs:label 'Budget Billing Enrolled' ;
    rdfs:comment 'Indicates whether the customer is enrolled in budget billing program where monthly bills are averaged to provide consistent payment amounts throughout the year. Ref: Oracle CC&B.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:closedDate rdf:type rdf:Property ;
    rdfs:label 'Closed Date' ;
    rdfs:comment 'Date when the billing account was closed and final bill was issued. Null for active accounts. Ref: Oracle CC&B.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:collectionStatus rdf:type rdf:Property ;
    rdfs:label 'Collection Status' ;
    rdfs:comment 'Current stage in the collections workflow for delinquent accounts. Indicates escalation level and next collection action required. Ref: Oracle CC&B.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:creditBalanceAmount rdf:type rdf:Property ;
    rdfs:label 'Credit Balance Amount' ;
    rdfs:comment 'The credit balance amount value recorded for each billing account in the billing domain.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:creditLimit rdf:type rdf:Property ;
    rdfs:label 'Credit Limit' ;
    rdfs:comment 'Maximum outstanding balance allowed before service restrictions or additional deposits are required. Based on credit rating and payment history. Ref: Oracle CC&B.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:currentBalance rdf:type rdf:Property ;
    rdfs:label 'Current Balance' ;
    rdfs:comment 'Total outstanding balance on the billing account including all charges, fees, adjustments, and payments. Positive values indicate amounts owed by the customer; negative values indicate credit balances. Ref: Oracle CC&B.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:currentCharges rdf:type rdf:Property ;
    rdfs:label 'Current Charges' ;
    rdfs:comment 'Total charges for the current billing period including water consumption, wastewater service, stormwater fees, and other utility charges before adjustments. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:customerAccountRefCode rdf:type rdf:Property ;
    rdfs:label 'Customer Account Ref Code' ;
    rdfs:comment 'Foreign key linking to customer.customer_account. Business justification: Billing accounts must reference their originating customer account for customer service inquiries, account consolidation, customer history tracking, and cross-system reconciliation. This is the founda. Ref: Oracle CC&B.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:depositOnFile rdf:type rdf:Property ;
    rdfs:label 'Deposit On File' ;
    rdfs:comment 'Security deposit amount held by the utility to mitigate credit risk. May be applied to final bill or returned to customer upon account closure with good payment history. Ref: Oracle CC&B.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:finalBillIssued rdf:type rdf:Property ;
    rdfs:label 'Final Bill Issued' ;
    rdfs:comment 'Indicates whether a final bill has been generated for this account upon closure. Used to ensure proper account settlement and deposit refund processing. Ref: Oracle CC&B.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastBillDate rdf:type rdf:Property ;
    rdfs:label 'Last Bill Date' ;
    rdfs:comment 'Date when the most recent bill was generated for this account. Used to calculate next billing cycle and track billing cadence. Ref: Oracle CC&B.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lateFeeAssessed rdf:type rdf:Property ;
    rdfs:label 'Late Fee Assessed' ;
    rdfs:comment 'Total late payment fees assessed on this account for the current billing period. Applied when payment is not received by due date. Ref: Oracle CC&B.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nextBillDate rdf:type rdf:Property ;
    rdfs:label 'Next Bill Date' ;
    rdfs:comment 'Scheduled date for the next bill generation based on billing cycle and frequency. Used for billing run planning and customer communication. Ref: Oracle CC&B.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:openedDate rdf:type rdf:Property ;
    rdfs:label 'Opened Date' ;
    rdfs:comment 'Date when the billing account was first established. Used for customer tenure analysis and lifecycle reporting. Ref: Oracle CC&B.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:paperlessBilling rdf:type rdf:Property ;
    rdfs:label 'Paperless Billing' ;
    rdfs:comment 'Indicates whether the customer has opted for electronic bill delivery instead of printed paper bills. Reduces mailing costs and supports environmental sustainability. Ref: Oracle CC&B.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:paymentPlanActive rdf:type rdf:Property ;
    rdfs:label 'Payment Plan Active' ;
    rdfs:comment 'Indicates whether the customer is currently on a payment plan to pay down past due balances in installments. Used to prevent service disconnection during plan compliance. Ref: Oracle CC&B.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:paymentPlanBalance rdf:type rdf:Property ;
    rdfs:label 'Payment Plan Balance' ;
    rdfs:comment 'Remaining balance to be paid under the active payment plan. Tracks progress toward full payment of delinquent amounts. Ref: Oracle CC&B.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentTerms rdf:type rdf:Property ;
    rdfs:label 'Payment Terms' ;
    rdfs:comment 'Standard payment terms for this billing account specifying the number of days from invoice date until payment is due. Ref: Oracle CC&B.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reconnectionFee rdf:type rdf:Property ;
    rdfs:label 'Reconnection Fee' ;
    rdfs:comment 'Fee charged to restore service after disconnection. Must be paid along with outstanding balance before service is restored. Ref: Oracle CC&B.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ssotResolutionType rdf:type rdf:Property ;
    rdfs:label 'Ssot Resolution Type' ;
    rdfs:comment 'The ssot resolution type value recorded for each billing account in the billing domain.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ssotSyncTimestamp rdf:type rdf:Property ;
    rdfs:label 'Ssot Sync Timestamp' ;
    rdfs:comment 'The ssot sync timestamp associated with each billing account record in the billing domain.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:taxExempt rdf:type rdf:Property ;
    rdfs:label 'Tax Exempt' ;
    rdfs:comment 'Indicates whether this account is exempt from utility taxes and fees. Typically applies to government entities, non-profits, or other qualifying organizations. Ref: Oracle CC&B.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:taxExemptCertificate rdf:type rdf:Property ;
    rdfs:label 'Tax Exempt Certificate' ;
    rdfs:comment 'Certificate or permit number documenting the tax exemption status. Required for audit compliance and revenue reporting. Ref: Oracle CC&B.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supersededByRateScheduleBillingRateScheduleId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Rate Schedule Billing Rate Schedule Id' ;
    rdfs:comment 'Foreign key reference to the rate schedule that supersedes this one. Nullable if this rate schedule is current or retired without replacement. Ref: Oracle CC&B.' ;
    rdfs:domain ind:RateSchedule ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RateSchedule .

ind:baseChargeAmount rdf:type rdf:Property ;
    rdfs:label 'Base Charge Amount' ;
    rdfs:comment 'Fixed monthly or periodic base charge (service charge) applied to customers under this rate schedule, regardless of consumption. Expressed in local currency. Ref: Oracle CC&B.' ;
    rdfs:domain ind:RateSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:baseChargeUsd rdf:type rdf:Property ;
    rdfs:label 'Base Charge Usd' ;
    rdfs:comment 'The base charge usd value recorded for each billing rate schedule in the billing domain.' ;
    rdfs:domain ind:RateSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:billingRateScheduleDescription rdf:type rdf:Property ;
    rdfs:label 'Billing Rate Schedule Description' ;
    rdfs:comment 'Detailed description of the rate schedule, including its purpose, applicability, and any special conditions or notes. Ref: Oracle CC&B.' ;
    rdfs:domain ind:RateSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:billingRateScheduleStatus rdf:type rdf:Property ;
    rdfs:label 'Billing Rate Schedule Status' ;
    rdfs:comment 'Current lifecycle status of the rate schedule (draft, pending approval, active, superseded, retired). Lifecycle status of the tariff. Ref: Oracle CC&B.' ;
    rdfs:domain ind:RateSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:conservationRateIndicator rdf:type rdf:Property ;
    rdfs:label 'Conservation Rate Indicator' ;
    rdfs:comment 'Indicates whether this rate schedule is designed to promote water conservation through inclining block or penalty pricing (true) or not (false). Ref: Oracle CC&B.' ;
    rdfs:domain ind:RateSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:consumptionUnitOfMeasure rdf:type rdf:Property ;
    rdfs:label 'Consumption Unit Of Measure' ;
    rdfs:comment 'Unit of measure for consumption used in this rate schedule (e.g., gallons, cubic feet, cubic meters, kiloliters, hundred cubic feet (CCF)). Ref: Oracle CC&B.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deprecatedFlag rdf:type rdf:Property ;
    rdfs:label 'Deprecated Flag' ;
    rdfs:comment 'The deprecated flag value recorded for each billing rate schedule in the billing domain.' ;
    rdfs:domain ind:RateSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:droughtSurchargeApplicable rdf:type rdf:Property ;
    rdfs:label 'Drought Surcharge Applicable' ;
    rdfs:comment 'Indicates whether a drought surcharge or emergency rate adjustment can be applied under this rate schedule (true) or not (false). Ref: Oracle CC&B.' ;
    rdfs:domain ind:RateSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:jurisdiction rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction' ;
    rdfs:comment 'Geographic or regulatory jurisdiction where this rate schedule applies (e.g., city, county, state, service territory name). Defines the geographic scope of the tariff. Ref: Oracle CC&B.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maximumChargeAmount rdf:type rdf:Property ;
    rdfs:label 'Maximum Charge Amount' ;
    rdfs:comment 'Maximum total charge amount per billing period under this rate schedule (cap). Nullable if no maximum applies. Ref: Oracle CC&B.' ;
    rdfs:domain ind:RateSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:meterSizeApplicability rdf:type rdf:Property ;
    rdfs:label 'Meter Size Applicability' ;
    rdfs:comment 'Meter size(s) or range this rate schedule applies to (e.g., \'5/8 inch\', \'1 inch\', \'2 inch and above\'). Nullable if not meter-size-specific. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minimumChargeAmount rdf:type rdf:Property ;
    rdfs:label 'Minimum Charge Amount' ;
    rdfs:comment 'Minimum total charge amount per billing period under this rate schedule, regardless of consumption. Nullable if no minimum applies. Ref: Oracle CC&B.' ;
    rdfs:domain ind:RateSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rateStructureType rdf:type rdf:Property ;
    rdfs:label 'Rate Structure Type' ;
    rdfs:comment 'Type of rate structure used for billing calculations (e.g., flat, tiered/inclining block, seasonal, time-of-use, budget-based, uniform, declining block). Defines the pricing methodology. [ENUM-REF-CANDIDATE: flat|tiered|seasonal|time_of_use|budget_based|uniform|declining_block — 7 candidates stripped; promote to reference product]. Ref: Oracle CC&B.' ;
    rdfs:domain ind:RateSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Regulatory Approval Date' ;
    rdfs:comment 'Date when the regulatory body (e.g., Public Utilities Commission) approved this rate schedule. Ref: Oracle CC&B.' ;
    rdfs:domain ind:RateSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:regulatoryApprovalReference rdf:type rdf:Property ;
    rdfs:label 'Regulatory Approval Reference' ;
    rdfs:comment 'Reference number or identifier for the regulatory approval (e.g., Public Utilities Commission (PUC) order number, resolution number) authorizing this rate schedule. Ref: Oracle CC&B.' ;
    rdfs:domain ind:RateSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduleCode rdf:type rdf:Property ;
    rdfs:label 'Schedule Code' ;
    rdfs:comment 'The schedule code value recorded for each billing rate schedule in the billing domain.' ;
    rdfs:domain ind:RateSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduleName rdf:type rdf:Property ;
    rdfs:label 'Schedule Name' ;
    rdfs:comment 'The schedule name used to identify each billing rate schedule record in the billing domain.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:seasonalIndicator rdf:type rdf:Property ;
    rdfs:label 'Seasonal Indicator' ;
    rdfs:comment 'Indicates whether this rate schedule has seasonal rate variations (true) or is uniform year-round (false). Ref: Oracle CC&B.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:volumetricRateUsd rdf:type rdf:Property ;
    rdfs:label 'Volumetric Rate Usd' ;
    rdfs:comment 'The volumetric rate usd value recorded for each billing rate schedule in the billing domain.' ;
    rdfs:domain ind:RateSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:approvalAuthority rdf:type rdf:Property ;
    rdfs:label 'Approval Authority' ;
    rdfs:comment 'Name of the regulatory body or internal authority that approved this rate component. Examples: State Public Utilities Commission, City Council, Utility Board of Directors. Ref: Oracle CC&B.' ;
    rdfs:domain ind:RateComponent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billPrintLabel rdf:type rdf:Property ;
    rdfs:label 'Bill Print Label' ;
    rdfs:comment 'Customer-facing label text displayed on the bill for this component. Should be clear and understandable to customers. Examples: Monthly Service Charge, Water Usage - First 5 CCF, Stormwater Fee. Ref: Oracle CC&B.' ;
    rdfs:domain ind:RateComponent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:calculationFormula rdf:type rdf:Property ;
    rdfs:label 'Calculation Formula' ;
    rdfs:comment 'Custom calculation expression for formula-based components. Contains the algorithmic logic used to compute the charge amount, referencing other rate components, usage data, or account attributes. Null for standard calculation methods. Ref: Oracle CC&B.' ;
    rdfs:domain ind:RateComponent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:calculationMethod rdf:type rdf:Property ;
    rdfs:label 'Calculation Method' ;
    rdfs:comment 'Algorithm used to calculate the charge amount. Flat amount applies a fixed charge regardless of usage, per-unit multiplies usage by unit rate, tiered block applies different rates to usage ranges, percentage applies a rate to another charge, and formula uses a custom calculation expression. Ref: Oracle CC&B.' ;
    rdfs:domain ind:RateComponent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:componentCode rdf:type rdf:Property ;
    rdfs:label 'Component Code' ;
    rdfs:comment 'Business identifier code for the rate component used in billing systems and rate books. Examples: BASE_CHG, TIER1_VOL, DEMAND_CHG, STORMWATER_FEE. Ref: Oracle CC&B.' ;
    rdfs:domain ind:RateComponent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:componentName rdf:type rdf:Property ;
    rdfs:label 'Component Name' ;
    rdfs:comment 'Human-readable name of the rate component. Examples: Base Service Charge, First Tier Volumetric Charge, Peak Demand Charge, Stormwater Management Fee. Ref: Oracle CC&B.' ;
    rdfs:domain ind:RateComponent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:componentType rdf:type rdf:Property ;
    rdfs:label 'Component Type' ;
    rdfs:comment 'Classification of the rate component defining its billing purpose. Base charges are fixed monthly fees, volumetric charges are consumption-based, demand charges are based on peak usage, tier charges apply to usage blocks, surcharges are additional fees, taxes are regulatory levies, fees are service-specific charges, adjustments modify base amounts, and credits reduce charges. [ENUM-REF-CANDIDATE: base_charge|volumetric_charge|demand_charge|tier_charge|surcharge|tax|fee|adjustment|credit — 9 candidates stripped; promote to reference product]. Ref: Oracle CC&B.' ;
    rdfs:domain ind:RateComponent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conservationTierFlag rdf:type rdf:Property ;
    rdfs:label 'Conservation Tier Flag' ;
    rdfs:comment 'Indicates whether this component is part of a conservation-oriented inclining block rate structure designed to discourage excessive water use. True for higher-tier volumetric charges that increase with consumption. Ref: Oracle CC&B.' ;
    rdfs:domain ind:RateComponent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:costCenter rdf:type rdf:Property ;
    rdfs:label 'Cost Center' ;
    rdfs:comment 'Cost center code for internal cost allocation and profitability analysis. Links revenue to the organizational unit or service line responsible for the charge. Ref: Oracle CC&B.' ;
    rdfs:domain ind:RateComponent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:flatAmount rdf:type rdf:Property ;
    rdfs:label 'Flat Amount' ;
    rdfs:comment 'Fixed charge amount for flat-rate components such as base service charges, connection fees, or fixed surcharges. Null for volumetric or percentage-based components. Ref: Oracle CC&B.' ;
    rdfs:domain ind:RateComponent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isVolumetric rdf:type rdf:Property ;
    rdfs:label 'Is Volumetric' ;
    rdfs:comment 'Indicates whether the component is consumption-based (volumetric) or fixed. True for components that vary with usage (per-unit, tiered block). False for fixed charges (base charges, flat fees). Used to distinguish variable from fixed revenue components. Ref: Oracle CC&B.' ;
    rdfs:domain ind:RateComponent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:percentageRate rdf:type rdf:Property ;
    rdfs:label 'Percentage Rate' ;
    rdfs:comment 'Percentage rate applied for percentage-based components such as taxes, surcharges, or adjustments. Expressed as a decimal (e.g., 0.0825 for 8.25% sales tax). Null for non-percentage components. Ref: Oracle CC&B.' ;
    rdfs:domain ind:RateComponent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:printOnBillFlag rdf:type rdf:Property ;
    rdfs:label 'Print On Bill Flag' ;
    rdfs:comment 'Indicates whether this component should be displayed as a separate line item on customer bills. True for components that require transparency and customer visibility. False for internal calculation components. Ref: Oracle CC&B.' ;
    rdfs:domain ind:RateComponent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rateCaseNumber rdf:type rdf:Property ;
    rdfs:label 'Rate Case Number' ;
    rdfs:comment 'Regulatory rate case docket number or internal rate change request identifier associated with this component. Links the component to the formal rate approval process. Ref: Oracle CC&B.' ;
    rdfs:domain ind:RateComponent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateComponentStatus rdf:type rdf:Property ;
    rdfs:label 'Rate Component Status' ;
    rdfs:comment 'Current lifecycle status of the rate component. Active components are in use for billing. Inactive components are temporarily disabled. Pending approval components await regulatory approval. Superseded components have been replaced by newer versions. Retired components are no longer used and retained for historical reference only. Ref: Oracle CC&B.' ;
    rdfs:domain ind:RateComponent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryReportingCategory rdf:type rdf:Property ;
    rdfs:label 'Regulatory Reporting Category' ;
    rdfs:comment 'Classification code for regulatory financial reporting and rate case filings. Maps the component to standardized reporting categories required by state public utilities commissions. Ref: Oracle CC&B.' ;
    rdfs:domain ind:RateComponent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sequenceNumber rdf:type rdf:Property ;
    rdfs:label 'Sequence Number' ;
    rdfs:comment 'Ordering sequence for component calculation and display within the rate schedule. Lower numbers are calculated and displayed first. Critical for components with dependencies (e.g., base charge calculated before percentage surcharge). Ref: Oracle CC&B.' ;
    rdfs:domain ind:RateComponent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:tierHighThreshold rdf:type rdf:Property ;
    rdfs:label 'Tier High Threshold' ;
    rdfs:comment 'Upper bound of the usage quantity range for tiered block rate components. Defines the maximum consumption level (inclusive) to which this tier rate applies. Measured in the component\'s unit of measure. Null indicates no upper limit (open-ended tier). Null for non-tiered components. Ref: Oracle CC&B.' ;
    rdfs:domain ind:RateComponent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tierLowThreshold rdf:type rdf:Property ;
    rdfs:label 'Tier Low Threshold' ;
    rdfs:comment 'Lower bound of the usage quantity range for tiered block rate components. Defines the minimum consumption level (inclusive) to which this tier rate applies. Measured in the component\'s unit of measure. Null for non-tiered components. Ref: Oracle CC&B.' ;
    rdfs:domain ind:RateComponent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:adjustmentId rdf:type rdf:Property ;
    rdfs:label 'Adjustment Id' ;
    rdfs:comment 'Unique identifier for the billing adjustment record. Primary key. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:originalAdjustmentId rdf:type rdf:Property ;
    rdfs:label 'Original Adjustment Id' ;
    rdfs:comment 'Reference to the original adjustment record being reversed, if this is a reversal entry. Null if this is not a reversal. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Adjustment .

ind:adjustmentNumber rdf:type rdf:Property ;
    rdfs:label 'Adjustment Number' ;
    rdfs:comment 'Externally visible unique adjustment reference number used for customer communication and audit trails. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:adjustmentStatus rdf:type rdf:Property ;
    rdfs:label 'Adjustment Status' ;
    rdfs:comment 'Current lifecycle status of the adjustment: pending (awaiting approval), approved (authorized but not yet applied), rejected (denied), applied (posted to account), reversed (undone), cancelled (voided before application). Ref: Oracle CC&B.' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:adjustmentType rdf:type rdf:Property ;
    rdfs:label 'Adjustment Type' ;
    rdfs:comment 'Classification of the adjustment indicating the nature of the correction: credit (reduces balance), debit (increases balance), write-off (uncollectible), leak_adjustment (leak allowance), rate_correction (tariff error), estimated_to_actual (true-up from estimated to actual meter reading), courtesy_credit (goodwill), penalty_reversal (late fee removal). [ENUM-REF-CANDIDATE: credit|debit|write-off|leak_adjustment|rate_correction|estimated_to_actual|courtesy_credit|penalty_reversal — 8 candidates stripped; promote to reference product]. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appliedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Applied Timestamp' ;
    rdfs:comment 'Date and time when the adjustment was actually posted to the customer account and reflected in the account balance. Null if not yet applied. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:approvalRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Approval Required Flag' ;
    rdfs:comment 'Indicates whether supervisory approval is required for this adjustment based on amount thresholds or adjustment type. True if approval is required, False if auto-approved.' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:approvalStatus rdf:type rdf:Property ;
    rdfs:label 'Approval Status' ;
    rdfs:comment 'The approval status value recorded for each adjustment in the billing domain.' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvalThresholdAmount rdf:type rdf:Property ;
    rdfs:label 'Approval Threshold Amount' ;
    rdfs:comment 'The monetary threshold above which supervisory approval is required for this adjustment type. Null if no threshold applies.' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:chargeCategory rdf:type rdf:Property ;
    rdfs:label 'Charge Category' ;
    rdfs:comment 'The billing charge category being adjusted: consumption (usage-based charges), base_charge (fixed monthly fee), connection_fee (new service fees), late_fee (delinquency charges), penalty (violation fines), surcharge (special assessments), tax (sales or utility tax), other (miscellaneous). [ENUM-REF-CANDIDATE: consumption|base_charge|connection_fee|late_fee|penalty|surcharge|tax|other — 8 candidates stripped; promote to reference product]. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consumptionVolumeAdjusted rdf:type rdf:Property ;
    rdfs:label 'Consumption Volume Adjusted' ;
    rdfs:comment 'The volume of water or wastewater consumption being adjusted, measured in the utility\'s standard unit (typically gallons or cubic meters). Null if adjustment is not consumption-related. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:costCenterCode rdf:type rdf:Property ;
    rdfs:label 'Cost Center Code' ;
    rdfs:comment 'Cost center or department code responsible for this adjustment, used for internal cost allocation and management reporting. Ref: Oracle CC&B.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:customerNotificationSentFlag rdf:type rdf:Property ;
    rdfs:label 'Customer Notification Sent Flag' ;
    rdfs:comment 'Indicates whether the customer has been notified of this adjustment via bill message, email, or letter. True if notification sent, False otherwise. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:disputeReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Dispute Reference Number' ;
    rdfs:comment 'Reference number of the customer billing dispute or complaint that triggered this adjustment. Null if not dispute-related. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:externalReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'External Reference Number' ;
    rdfs:comment 'External reference number from third-party systems (e.g., payment processor, collection agency, regulatory agency) related to this adjustment. Null if no external reference. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isReversal rdf:type rdf:Property ;
    rdfs:label 'Is Reversal' ;
    rdfs:comment 'Boolean flag indicating whether the is reversal condition applies to the adjustment record.' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:leakAllowanceFlag rdf:type rdf:Property ;
    rdfs:label 'Leak Allowance Flag' ;
    rdfs:comment 'Indicates whether this adjustment is a leak allowance credit granted to the customer for documented plumbing leaks. True if leak allowance, False otherwise. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:leakVerificationDate rdf:type rdf:Property ;
    rdfs:label 'Leak Verification Date' ;
    rdfs:comment 'Date when the plumbing leak was verified by utility staff or licensed plumber, supporting the leak allowance adjustment. Null if not a leak adjustment. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:notificationSentTimestamp rdf:type rdf:Property ;
    rdfs:label 'Notification Sent Timestamp' ;
    rdfs:comment 'Date and time when customer notification of the adjustment was sent. Null if notification not yet sent. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:rateCaseReference rdf:type rdf:Property ;
    rdfs:label 'Rate Case Reference' ;
    rdfs:comment 'Reference number of the regulatory rate case or tariff filing that mandated this adjustment. Null if not rate-case-related. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reasonCode rdf:type rdf:Property ;
    rdfs:label 'Reason Code' ;
    rdfs:comment 'Standardized code indicating the specific business reason for the adjustment (e.g., BILLING_ERROR, METER_MALFUNCTION, LEAK_ALLOWANCE, CUSTOMER_DISPUTE, RATE_CHANGE, GOODWILL, REGULATORY_COMPLIANCE). Maps to internal reason code table. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reasonDescription rdf:type rdf:Property ;
    rdfs:label 'Reason Description' ;
    rdfs:comment 'Detailed free-text explanation of the reason for the adjustment, providing context for audit and customer service purposes. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryComplianceFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Compliance Flag' ;
    rdfs:comment 'Indicates whether this adjustment was made to comply with regulatory requirements or rate case orders. True if regulatory-driven, False otherwise. Ref: Oracle CC&B.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reversalFlag rdf:type rdf:Property ;
    rdfs:label 'Reversal Flag' ;
    rdfs:comment 'Indicates whether this adjustment is a reversal of a previous adjustment. True if this is a reversal entry, False otherwise. Ref: Oracle CC&B.' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:brokenDate rdf:type rdf:Property ;
    rdfs:label 'Broken Date' ;
    rdfs:comment 'Date when the payment plan was marked as broken due to missed payment or violation of terms. Nullable if plan has never been broken. Ref: Oracle CC&B.' ;
    rdfs:domain ind:PaymentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:brokenReason rdf:type rdf:Property ;
    rdfs:label 'Broken Reason' ;
    rdfs:comment 'Reason the payment plan was marked as broken: missed installment (customer failed to pay on time), late payment (payment received after grace period), new charges unpaid (customer failed to pay current charges while on plan), customer request (customer asked to cancel), or administrative (utility-initiated termination). Ref: Oracle CC&B.' ;
    rdfs:domain ind:PaymentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cancellationReason rdf:type rdf:Property ;
    rdfs:label 'Cancellation Reason' ;
    rdfs:comment 'Free-text explanation of why the payment plan was cancelled, capturing business context for audit and reporting purposes. Ref: Oracle CC&B.' ;
    rdfs:domain ind:PaymentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cancelledDate rdf:type rdf:Property ;
    rdfs:label 'Cancelled Date' ;
    rdfs:comment 'Date when the payment plan was cancelled by the utility or customer before completion. Nullable if plan was not cancelled. Ref: Oracle CC&B.' ;
    rdfs:domain ind:PaymentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:completedInstallments rdf:type rdf:Property ;
    rdfs:label 'Completed Installments' ;
    rdfs:comment 'Number of installment payments successfully made by the customer to date. Ref: Oracle CC&B.' ;
    rdfs:domain ind:PaymentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:downPaymentAmount rdf:type rdf:Property ;
    rdfs:label 'Down Payment Amount' ;
    rdfs:comment 'Initial down payment amount required to establish the payment plan, paid at enrollment. Nullable if no down payment was required. Ref: Oracle CC&B.' ;
    rdfs:domain ind:PaymentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:downPaymentReceivedDate rdf:type rdf:Property ;
    rdfs:label 'Down Payment Received Date' ;
    rdfs:comment 'Date when the down payment was received and the payment plan was activated. Nullable if no down payment was required. Ref: Oracle CC&B.' ;
    rdfs:domain ind:PaymentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:enrolledBalanceAmount rdf:type rdf:Property ;
    rdfs:label 'Enrolled Balance Amount' ;
    rdfs:comment 'Total delinquent balance amount enrolled in the payment plan at the time of plan establishment. Represents the arrears being repaid through installments. Ref: Oracle CC&B.' ;
    rdfs:domain ind:PaymentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:gracePeriodDays rdf:type rdf:Property ;
    rdfs:label 'Grace Period Days' ;
    rdfs:comment 'Number of days after the installment due date during which a late payment is accepted without breaking the plan. Ref: Oracle CC&B.' ;
    rdfs:domain ind:PaymentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:installmentAmount rdf:type rdf:Property ;
    rdfs:label 'Installment Amount' ;
    rdfs:comment 'Fixed amount the customer is required to pay per installment period to satisfy the payment plan terms. Ref: Oracle CC&B.' ;
    rdfs:domain ind:PaymentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:installmentAmountUsd rdf:type rdf:Property ;
    rdfs:label 'Installment Amount Usd' ;
    rdfs:comment 'The installment amount usd value recorded for each payment plan in the billing domain.' ;
    rdfs:domain ind:PaymentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:installmentFrequency rdf:type rdf:Property ;
    rdfs:label 'Installment Frequency' ;
    rdfs:comment 'Frequency at which installment payments are due: weekly, biweekly, monthly, or quarterly. Ref: Oracle CC&B.' ;
    rdfs:domain ind:PaymentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:liheapEligible rdf:type rdf:Property ;
    rdfs:label 'Liheap Eligible' ;
    rdfs:comment 'Indicates whether the customer on this payment plan is eligible for LIHEAP or similar low-income energy assistance coordination. True if eligible; false otherwise. Ref: Oracle CC&B.' ;
    rdfs:domain ind:PaymentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nextInstallmentDueDate rdf:type rdf:Property ;
    rdfs:label 'Next Installment Due Date' ;
    rdfs:comment 'Date when the next installment payment is due from the customer. Ref: Oracle CC&B.' ;
    rdfs:domain ind:PaymentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:numberOfInstallments rdf:type rdf:Property ;
    rdfs:label 'Number Of Installments' ;
    rdfs:comment 'The number of installments value recorded for each payment plan in the billing domain.' ;
    rdfs:domain ind:PaymentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:planEndDate rdf:type rdf:Property ;
    rdfs:label 'Plan End Date' ;
    rdfs:comment 'Scheduled date when the payment plan is expected to be completed if all installments are paid on time. Nullable for open-ended plans. Ref: Oracle CC&B.' ;
    rdfs:domain ind:PaymentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:planNumber rdf:type rdf:Property ;
    rdfs:label 'Plan Number' ;
    rdfs:comment 'Externally visible unique business identifier for the payment plan, formatted as PP-XXXXXXXX. Ref: Oracle CC&B.' ;
    rdfs:domain ind:PaymentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planStartDate rdf:type rdf:Property ;
    rdfs:label 'Plan Start Date' ;
    rdfs:comment 'Date when the payment plan becomes effective and the first installment is due. Ref: Oracle CC&B.' ;
    rdfs:domain ind:PaymentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:planStatus rdf:type rdf:Property ;
    rdfs:label 'Plan Status' ;
    rdfs:comment 'Current lifecycle status of the payment plan: active (customer is making payments on schedule), broken (customer missed payment and violated terms), completed (all installments paid), cancelled (plan terminated by utility or customer), suspended (temporarily paused), or pending approval (awaiting credit review). Ref: Oracle CC&B.' ;
    rdfs:domain ind:PaymentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planType rdf:type rdf:Property ;
    rdfs:label 'Plan Type' ;
    rdfs:comment 'Classification of the payment plan arrangement: budget billing (level monthly payments), deferred payment agreement (short-term installment), low-income assistance (subsidized plan), arrearage management (long-term debt forgiveness plan), seasonal payment (adjusted for seasonal usage), or extended payment (custom extended terms). Ref: Oracle CC&B.' ;
    rdfs:domain ind:PaymentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requiresCurrentChargesPaid rdf:type rdf:Property ;
    rdfs:label 'Requires Current Charges Paid' ;
    rdfs:comment 'Indicates whether the customer must pay all new current charges in addition to installment payments to remain in good standing on the plan. True if current charges must be paid; false if only installments are required. Ref: Oracle CC&B.' ;
    rdfs:domain ind:PaymentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalInstallments rdf:type rdf:Property ;
    rdfs:label 'Total Installments' ;
    rdfs:comment 'Total number of scheduled installment payments required to complete the payment plan. Ref: Oracle CC&B.' ;
    rdfs:domain ind:PaymentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:collectionNoticeId rdf:type rdf:Property ;
    rdfs:label 'Collection Notice Id' ;
    rdfs:comment 'Primary key for collection_notice. Ref: Oracle CC&B.' ;
    rdfs:domain ind:CollectionNotice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:amountDue rdf:type rdf:Property ;
    rdfs:label 'Amount Due' ;
    rdfs:comment 'Total amount due on notice. Ref: Oracle CC&B.' ;
    rdfs:domain ind:CollectionNotice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:amountDueUsd rdf:type rdf:Property ;
    rdfs:label 'Amount Due Usd' ;
    rdfs:comment 'The amount due usd value recorded for each collection notice in the billing domain.' ;
    rdfs:domain ind:CollectionNotice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:collectionNoticeNumber rdf:type rdf:Property ;
    rdfs:label 'Collection Notice Number' ;
    rdfs:comment 'The collection notice number value recorded for each collection notice in the billing domain.' ;
    rdfs:domain ind:CollectionNotice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collectionNoticeStatus rdf:type rdf:Property ;
    rdfs:label 'Collection Notice Status' ;
    rdfs:comment 'Lifecycle status of the record. Ref: Oracle CC&B.' ;
    rdfs:domain ind:CollectionNotice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collectionNoticeType rdf:type rdf:Property ;
    rdfs:label 'Collection Notice Type' ;
    rdfs:comment 'The collection notice type value recorded for each collection notice in the billing domain.' ;
    rdfs:domain ind:CollectionNotice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:customerResponseDate rdf:type rdf:Property ;
    rdfs:label 'Customer Response Date' ;
    rdfs:comment 'Date customer responded to the notice. Ref: Oracle CC&B.' ;
    rdfs:domain ind:CollectionNotice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:customerResponseType rdf:type rdf:Property ;
    rdfs:label 'Customer Response Type' ;
    rdfs:comment 'Payment, payment plan, dispute, no response. Ref: Oracle CC&B.' ;
    rdfs:domain ind:CollectionNotice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:daysDelinquent rdf:type rdf:Property ;
    rdfs:label 'Days Delinquent' ;
    rdfs:comment 'Number of days the account has been delinquent at time of notice generation. Ref: Oracle CC&B.' ;
    rdfs:domain ind:CollectionNotice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:daysPastDue rdf:type rdf:Property ;
    rdfs:label 'Days Past Due' ;
    rdfs:comment 'Number of days past due. Ref: Oracle CC&B.' ;
    rdfs:domain ind:CollectionNotice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:delinquencyDays rdf:type rdf:Property ;
    rdfs:label 'Delinquency Days' ;
    rdfs:comment 'The delinquency days value recorded for each collection notice in the billing domain.' ;
    rdfs:domain ind:CollectionNotice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:deliveryAddress rdf:type rdf:Property ;
    rdfs:label 'Delivery Address' ;
    rdfs:comment 'Address notice was delivered to. Ref: Oracle CC&B.' ;
    rdfs:domain ind:CollectionNotice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deliveryConfirmed rdf:type rdf:Property ;
    rdfs:label 'Delivery Confirmed' ;
    rdfs:comment 'Whether delivery was confirmed. Ref: Oracle CC&B.' ;
    rdfs:domain ind:CollectionNotice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:deliveryDate rdf:type rdf:Property ;
    rdfs:label 'Delivery Date' ;
    rdfs:comment 'Date notice was delivered. Ref: Oracle CC&B.' ;
    rdfs:domain ind:CollectionNotice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:deliveryStatus rdf:type rdf:Property ;
    rdfs:label 'Delivery Status' ;
    rdfs:comment 'The delivery status value recorded for each collection notice in the billing domain.' ;
    rdfs:domain ind:CollectionNotice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deliveryTimestamp rdf:type rdf:Property ;
    rdfs:label 'Delivery Timestamp' ;
    rdfs:comment 'The delivery timestamp associated with each collection notice record in the billing domain.' ;
    rdfs:domain ind:CollectionNotice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:disconnectionScheduledDate rdf:type rdf:Property ;
    rdfs:label 'Disconnection Scheduled Date' ;
    rdfs:comment 'The disconnection scheduled date associated with each collection notice record in the billing domain.' ;
    rdfs:domain ind:CollectionNotice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:disconnectionScheduledFlag rdf:type rdf:Property ;
    rdfs:label 'Disconnection Scheduled Flag' ;
    rdfs:comment 'The disconnection scheduled flag value recorded for each collection notice in the billing domain.' ;
    rdfs:domain ind:CollectionNotice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:escalationLevel rdf:type rdf:Property ;
    rdfs:label 'Escalation Level' ;
    rdfs:comment 'Escalation level: 1=first notice, 2=final, 3=shutoff. Ref: Oracle CC&B.' ;
    rdfs:domain ind:CollectionNotice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:holdReason rdf:type rdf:Property ;
    rdfs:label 'Hold Reason' ;
    rdfs:comment 'Reason for shutoff hold: medical, winter moratorium, etc. Ref: Oracle CC&B.' ;
    rdfs:domain ind:CollectionNotice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isLowIncomeProtected rdf:type rdf:Property ;
    rdfs:label 'Is Low Income Protected' ;
    rdfs:comment 'Indicates whether the account is protected from disconnection under low-income assistance rules. Ref: Oracle CC&B.' ;
    rdfs:domain ind:CollectionNotice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isMedicalHold rdf:type rdf:Property ;
    rdfs:label 'Is Medical Hold' ;
    rdfs:comment 'Flag indicating a medical hold prevents disconnection. Ref: Oracle CC&B.' ;
    rdfs:domain ind:CollectionNotice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isShutoffHold rdf:type rdf:Property ;
    rdfs:label 'Is Shutoff Hold' ;
    rdfs:comment 'Whether a shutoff hold is in place. Ref: Oracle CC&B.' ;
    rdfs:domain ind:CollectionNotice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isShutoffProtected rdf:type rdf:Property ;
    rdfs:label 'Is Shutoff Protected' ;
    rdfs:comment 'Whether account is protected from shutoff (medical, weather). Ref: Oracle CC&B.' ;
    rdfs:domain ind:CollectionNotice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isWinterMoratorium rdf:type rdf:Property ;
    rdfs:label 'Is Winter Moratorium' ;
    rdfs:comment 'Flag indicating a winter moratorium prevents disconnection. Ref: Oracle CC&B.' ;
    rdfs:domain ind:CollectionNotice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:issueDate rdf:type rdf:Property ;
    rdfs:label 'Issue Date' ;
    rdfs:comment 'Date notice was issued. Ref: Oracle CC&B.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:issuedDate rdf:type rdf:Property ;
    rdfs:label 'Issued Date' ;
    rdfs:comment 'The issued date associated with each collection notice record in the billing domain.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:lateFeeUsd rdf:type rdf:Property ;
    rdfs:label 'Late Fee Usd' ;
    rdfs:comment 'The late fee usd value recorded for each collection notice in the billing domain.' ;
    rdfs:domain ind:CollectionNotice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumPaymentAmount rdf:type rdf:Property ;
    rdfs:label 'Minimum Payment Amount' ;
    rdfs:comment 'Minimum payment to avoid shutoff. Ref: Oracle CC&B.' ;
    rdfs:domain ind:CollectionNotice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumPaymentRequired rdf:type rdf:Property ;
    rdfs:label 'Minimum Payment Required' ;
    rdfs:comment 'Minimum payment required to avoid disconnection. Ref: Oracle CC&B.' ;
    rdfs:domain ind:CollectionNotice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:noticeDate rdf:type rdf:Property ;
    rdfs:label 'Notice Date' ;
    rdfs:comment 'The notice date associated with each collection notice record in the billing domain.' ;
    rdfs:domain ind:CollectionNotice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:noticeNumber rdf:type rdf:Property ;
    rdfs:label 'Notice Number' ;
    rdfs:comment 'Unique collection notice number. Ref: Oracle CC&B.' ;
    rdfs:domain ind:CollectionNotice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:noticeStatus rdf:type rdf:Property ;
    rdfs:label 'Notice Status' ;
    rdfs:comment 'Status (generated, sent, acknowledged, resolved, escalated). Ref: Oracle CC&B.' ;
    rdfs:domain ind:CollectionNotice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:noticeType rdf:type rdf:Property ;
    rdfs:label 'Notice Type' ;
    rdfs:comment 'Type of notice (reminder, warning, final, shutoff). Ref: Oracle CC&B.' ;
    rdfs:domain ind:CollectionNotice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentReceivedDate rdf:type rdf:Property ;
    rdfs:label 'Payment Received Date' ;
    rdfs:comment 'The payment received date associated with each collection notice record in the billing domain.' ;
    rdfs:domain ind:CollectionNotice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:resolutionType rdf:type rdf:Property ;
    rdfs:label 'Resolution Type' ;
    rdfs:comment 'Paid, Payment Plan, Assistance, Cancelled, Shutoff. Ref: Oracle CC&B.' ;
    rdfs:domain ind:CollectionNotice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resolvedDate rdf:type rdf:Property ;
    rdfs:label 'Resolved Date' ;
    rdfs:comment 'Date notice was resolved. Ref: Oracle CC&B.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:responseDate rdf:type rdf:Property ;
    rdfs:label 'Response Date' ;
    rdfs:comment 'Date the customer responded to the notice. Ref: Oracle CC&B.' ;
    rdfs:domain ind:CollectionNotice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:responseDeadlineDate rdf:type rdf:Property ;
    rdfs:label 'Response Deadline Date' ;
    rdfs:comment 'Deadline for customer response. Ref: Oracle CC&B.' ;
    rdfs:domain ind:CollectionNotice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:responseReceived rdf:type rdf:Property ;
    rdfs:label 'Response Received' ;
    rdfs:comment 'Flag indicating a customer response was received. Ref: Oracle CC&B.' ;
    rdfs:domain ind:CollectionNotice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:responseReceivedDate rdf:type rdf:Property ;
    rdfs:label 'Response Received Date' ;
    rdfs:comment 'Date customer responded. Ref: Oracle CC&B.' ;
    rdfs:domain ind:CollectionNotice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:shutoffDate rdf:type rdf:Property ;
    rdfs:label 'Shutoff Date' ;
    rdfs:comment 'Scheduled service shutoff date if applicable. Ref: Oracle CC&B.' ;
    rdfs:domain ind:CollectionNotice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:shutoffScheduledFlag rdf:type rdf:Property ;
    rdfs:label 'Shutoff Scheduled Flag' ;
    rdfs:comment 'The shutoff scheduled flag value recorded for each collection notice in the billing domain.' ;
    rdfs:domain ind:CollectionNotice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:wwtpId rdf:type rdf:Property ;
    rdfs:label 'Wwtp Id' ;
    rdfs:comment 'Identifier of the Wastewater Treatment Plant (WWTP) that receives flow from this sewer segment. Supports load allocation and treatment capacity planning. Ref: EPA SDWA.' ;
    rdfs:domain ind:Wastewater ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Wwtp .

ind:assetTag rdf:type rdf:Property ;
    rdfs:label 'Asset Tag' ;
    rdfs:comment 'Physical asset tag or barcode identifier affixed to the segment or associated manhole for field identification and work order tracking in IBM Maximo.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coordinateSystem rdf:type rdf:Property ;
    rdfs:label 'Coordinate System' ;
    rdfs:comment 'Spatial reference system identifier (e.g., EPSG code) for the GIS geometry. Ensures spatial data interoperability and accurate georeferencing. Ref: EPA SDWA.' ;
    rdfs:domain ind:SewerNetwork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataSource rdf:type rdf:Property ;
    rdfs:label 'Data Source' ;
    rdfs:comment 'Identifier of the source system or data collection method that provided this record (e.g., Esri ArcGIS, field survey, as-built drawings, CCTV inspection). Ref: EPA SDWA.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:downstreamInvertElevationFeet rdf:type rdf:Property ;
    rdfs:label 'Downstream Invert Elevation Feet' ;
    rdfs:comment 'Elevation of the inside bottom of the pipe at the downstream end in feet above mean sea level. Used with upstream invert to calculate slope and hydraulic capacity. Ref: EPA SDWA.' ;
    rdfs:domain ind:SewerNetwork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:easementRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Easement Required Flag' ;
    rdfs:comment 'Indicates whether a legal easement is required for utility access to the sewer segment. Critical for maintenance planning and right-of-way management. Ref: EPA SDWA.' ;
    rdfs:domain ind:SewerNetwork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fogRiskFlag rdf:type rdf:Property ;
    rdfs:label 'Fog Risk Flag' ;
    rdfs:comment 'Indicates whether the segment is at elevated risk for FOG (Fats, Oils, and Grease) blockages based on upstream land use (restaurants, food processing). Drives preventive maintenance frequency. Ref: EPA SDWA.' ;
    rdfs:domain ind:Wastewater ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:generated rdf:type rdf:Property ;
    rdfs:label 'Generated' ;
    rdfs:comment 'Auto-generated attribute for sewer_network. Ref: EPA SDWA.' ;
    rdfs:domain ind:Wastewater ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hydrogenSulfideRiskFlag rdf:type rdf:Property ;
    rdfs:label 'Hydrogen Sulfide Risk Flag' ;
    rdfs:comment 'Indicates elevated risk of hydrogen sulfide gas generation and corrosion. Common in force mains and long gravity sewers with low flow velocity. Ref: EPA SDWA.' ;
    rdfs:domain ind:SewerNetwork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:liningInstallationDate rdf:type rdf:Property ;
    rdfs:label 'Lining Installation Date' ;
    rdfs:comment 'Date when pipe lining or rehabilitation was completed. Resets the effective age for condition assessment and extends asset useful life. Ref: EPA SDWA.' ;
    rdfs:domain ind:SewerNetwork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:peakFlowGpm rdf:type rdf:Property ;
    rdfs:label 'Peak Flow Gpm' ;
    rdfs:comment 'Maximum observed or modeled flow rate in Gallons per Minute (GPM) during peak wet weather or high demand periods. Critical for SSO risk assessment. Ref: EPA SDWA.' ;
    rdfs:domain ind:SewerNetwork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:replacementCostUsd rdf:type rdf:Property ;
    rdfs:label 'Replacement Cost Usd' ;
    rdfs:comment 'Estimated current replacement cost of the sewer segment in US Dollars. Used for asset valuation, insurance, and capital improvement program (CIP) budgeting. Ref: EPA SDWA.' ;
    rdfs:domain ind:Wastewater ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rootIntrusionFlag rdf:type rdf:Property ;
    rdfs:label 'Root Intrusion Flag' ;
    rdfs:comment 'Indicates whether tree root intrusion has been observed or is a known risk for this segment. Common in older vitrified clay and concrete pipes. Ref: EPA SDWA.' ;
    rdfs:domain ind:SewerNetwork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:segmentIdentifier rdf:type rdf:Property ;
    rdfs:label 'Segment Identifier' ;
    rdfs:comment 'Externally-known unique identifier for the sewer segment used in GIS systems, field operations, and regulatory reporting. Aligns with Esri ArcGIS feature identifiers. Ref: EPA SDWA.' ;
    rdfs:domain ind:SewerNetwork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:segmentType rdf:type rdf:Property ;
    rdfs:label 'Segment Type' ;
    rdfs:comment 'Classification of the sewer segment by conveyance method and network hierarchy. Gravity sewers use slope for flow; force mains use pumps; interceptors and trunk lines are major collectors. Ref: EPA SDWA.' ;
    rdfs:domain ind:SewerNetwork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:slopePercent rdf:type rdf:Property ;
    rdfs:label 'Slope Percent' ;
    rdfs:comment 'Gradient of the sewer pipe expressed as a percentage. Critical for gravity sewer hydraulic performance and self-cleansing velocity calculations. Ref: EPA SDWA.' ;
    rdfs:domain ind:SewerNetwork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ssoHistoryCount rdf:type rdf:Property ;
    rdfs:label 'Sso History Count' ;
    rdfs:comment 'Number of Sanitary Sewer Overflow (SSO) events recorded for this segment. High counts trigger regulatory scrutiny and prioritize capacity upgrades. Ref: EPA SDWA.' ;
    rdfs:domain ind:SewerNetwork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:trafficImpactLevel rdf:type rdf:Property ;
    rdfs:label 'Traffic Impact Level' ;
    rdfs:comment 'Assessment of traffic disruption risk if the segment requires excavation or repair. High-traffic segments require special permitting and coordination. Ref: EPA SDWA.' ;
    rdfs:domain ind:SewerNetwork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:upstreamInvertElevationFeet rdf:type rdf:Property ;
    rdfs:label 'Upstream Invert Elevation Feet' ;
    rdfs:comment 'Elevation of the inside bottom of the pipe at the upstream end in feet above mean sea level. Essential for hydraulic grade line analysis and I&I (Inflow and Infiltration) assessment. Ref: EPA SDWA.' ;
    rdfs:domain ind:SewerNetwork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:manholeId rdf:type rdf:Property ;
    rdfs:label 'Manhole Id' ;
    rdfs:comment 'Unique identifier for the manhole structure in the wastewater collection system. Primary key. Ref: EPA SDWA.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Manhole .

ind:assetClassCode rdf:type rdf:Property ;
    rdfs:label 'Asset Class Code' ;
    rdfs:comment 'Code identifying the asset class or category to which this manhole belongs in the utility\'s asset hierarchy. Used for financial reporting, depreciation, and capital planning. Ref: EPA SDWA.' ;
    rdfs:domain ind:Manhole ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:basinCode rdf:type rdf:Property ;
    rdfs:label 'Basin Code' ;
    rdfs:comment 'Code identifying the drainage basin or sewershed that this manhole serves. Used for hydraulic modeling and capacity planning. Ref: EPA SDWA.' ;
    rdfs:domain ind:Manhole ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:confinedSpaceFlag rdf:type rdf:Property ;
    rdfs:label 'Confined Space Flag' ;
    rdfs:comment 'Indicates whether the manhole is classified as a permit-required confined space under OSHA regulations. True if the manhole requires a confined space entry permit; false otherwise. Critical for worker safety and entry procedures.' ;
    rdfs:domain ind:Manhole ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:coverType rdf:type rdf:Property ;
    rdfs:label 'Cover Type' ;
    rdfs:comment 'Type of cover installed on the manhole. Watertight covers prevent Inflow and Infiltration (I&I); bolted covers provide security; vented covers allow gas release; traffic-rated covers support vehicular loads. Ref: EPA SDWA.' ;
    rdfs:domain ind:Manhole ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dmaCode rdf:type rdf:Property ;
    rdfs:label 'Dma Code' ;
    rdfs:comment 'Code identifying the District Metered Area (DMA) or pressure zone to which this manhole belongs. Used for network segmentation and performance monitoring. Ref: EPA SDWA.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gisFeatureReference rdf:type rdf:Property ;
    rdfs:label 'Gis Feature Reference' ;
    rdfs:comment 'Unique identifier for the manhole feature in the utility\'s GIS system. Used to link asset management data with spatial data layers in ArcGIS or other GIS platforms. Ref: EPA SDWA.' ;
    rdfs:domain ind:Wastewater ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:inflowInfiltrationFlag rdf:type rdf:Property ;
    rdfs:label 'Inflow Infiltration Flag' ;
    rdfs:comment 'Indicates whether the manhole has been identified as a source of Inflow and Infiltration (I&I) into the wastewater collection system. True if I&I has been observed or suspected; false otherwise. Used for prioritizing I&I reduction programs. Ref: EPA SDWA.' ;
    rdfs:domain ind:Manhole ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:invertElevationFeet rdf:type rdf:Property ;
    rdfs:label 'Invert Elevation Feet' ;
    rdfs:comment 'Elevation of the lowest point inside the manhole where wastewater flows, measured in feet above a reference datum. Critical for calculating pipe slopes and flow gradients. Ref: EPA SDWA.' ;
    rdfs:domain ind:Manhole ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:macpScore rdf:type rdf:Property ;
    rdfs:label 'Macp Score' ;
    rdfs:comment 'Numerical condition score assigned using the NASSCO Manhole Assessment and Certification Program (MACP) methodology. Higher scores indicate worse condition. Used for prioritizing rehabilitation and capital planning. Ref: EPA SDWA.' ;
    rdfs:domain ind:Manhole ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:manholeNumber rdf:type rdf:Property ;
    rdfs:label 'Manhole Number' ;
    rdfs:comment 'Business identifier or asset tag assigned to the manhole for field operations and maintenance tracking. Typically displayed on manhole covers or in field maps. Ref: EPA SDWA.' ;
    rdfs:domain ind:Manhole ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:manholeStatus rdf:type rdf:Property ;
    rdfs:label 'Manhole Status' ;
    rdfs:comment 'Current operational status of the manhole in the wastewater collection system lifecycle. Active manholes are in service; inactive are temporarily out of service; abandoned are no longer used but not removed; planned are in design phase; under construction are being installed; decommissioned are permanently removed from service. Ref: EPA SDWA.' ;
    rdfs:domain ind:Manhole ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:manholeType rdf:type rdf:Property ;
    rdfs:label 'Manhole Type' ;
    rdfs:comment 'Classification of the manhole based on its function in the wastewater collection network. Standard manholes provide access; drop manholes accommodate elevation changes; junction manholes connect multiple pipes; terminal manholes mark the end of a line; diversion manholes route flow; metering manholes house flow measurement equipment. [ENUM-REF-CANDIDATE: standard|drop|junction|terminal|diversion|metering|special — 7 candidates stripped; promote to reference product]. Ref: EPA SDWA.' ;
    rdfs:domain ind:Manhole ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ownership rdf:type rdf:Property ;
    rdfs:label 'Ownership' ;
    rdfs:comment 'Entity that owns the manhole asset. Utility-owned assets are maintained by the water utility; municipal assets may be owned by the city; private assets are on private property; joint ownership involves shared responsibility. Ref: EPA SDWA.' ;
    rdfs:domain ind:Manhole ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rimElevationFeet rdf:type rdf:Property ;
    rdfs:label 'Rim Elevation Feet' ;
    rdfs:comment 'Elevation of the manhole rim (top of cover) above a reference datum, typically mean sea level, measured in feet. Used for hydraulic modeling and flood risk assessment. Ref: EPA SDWA.' ;
    rdfs:domain ind:Manhole ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ssoHistoryFlag rdf:type rdf:Property ;
    rdfs:label 'Sso History Flag' ;
    rdfs:comment 'Indicates whether the manhole has a history of Sanitary Sewer Overflows (SSO). True if SSO events have occurred at this location; false otherwise. Used for identifying high-risk locations and prioritizing capacity improvements. Ref: EPA SDWA.' ;
    rdfs:domain ind:Wastewater ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:trafficLoadRating rdf:type rdf:Property ;
    rdfs:label 'Traffic Load Rating' ;
    rdfs:comment 'Load rating classification of the manhole cover based on expected vehicular traffic. Light duty for pedestrian areas; medium duty for residential streets; heavy duty for arterial roads; extra heavy duty for highways and industrial areas. Ref: EPA SDWA.' ;
    rdfs:domain ind:Manhole ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:biosolidsClass rdf:type rdf:Property ;
    rdfs:label 'Biosolids Class' ;
    rdfs:comment 'Class A or Class B. Ref: EPA SDWA.' ;
    rdfs:domain ind:Wastewater ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:biosolidsManagementMethod rdf:type rdf:Property ;
    rdfs:label 'Biosolids Management Method' ;
    rdfs:comment 'Land application, landfill, incineration. Ref: EPA SDWA.' ;
    rdfs:domain ind:Wwtp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:effluentDischargePoint rdf:type rdf:Property ;
    rdfs:label 'Effluent Discharge Point' ;
    rdfs:comment 'Outfall identifier. Ref: EPA SDWA.' ;
    rdfs:domain ind:Wwtp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facilityCode rdf:type rdf:Property ;
    rdfs:label 'Facility Code' ;
    rdfs:comment 'Unique facility code. Ref: EPA SDWA.' ;
    rdfs:domain ind:Wwtp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facilityEmail rdf:type rdf:Property ;
    rdfs:label 'Facility Email' ;
    rdfs:comment 'Facility email. Ref: EPA SDWA.' ;
    rdfs:domain ind:Wwtp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facilityName rdf:type rdf:Property ;
    rdfs:label 'Facility Name' ;
    rdfs:comment 'WWTP name. Ref: EPA SDWA.' ;
    rdfs:domain ind:Wwtp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facilityPhone rdf:type rdf:Property ;
    rdfs:label 'Facility Phone' ;
    rdfs:comment 'Facility phone number. Ref: EPA SDWA.' ;
    rdfs:domain ind:Wwtp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:operatorCertificationRequired rdf:type rdf:Property ;
    rdfs:label 'Operator Certification Required' ;
    rdfs:comment 'Operator certification required. Ref: EPA SDWA.' ;
    rdfs:domain ind:Wwtp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:peakFlowMgd rdf:type rdf:Property ;
    rdfs:label 'Peak Flow Mgd' ;
    rdfs:comment 'Peak flow in MGD. Ref: EPA SDWA.' ;
    rdfs:domain ind:Wwtp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:permitEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Permit Effective Date' ;
    rdfs:comment 'Permit effective date. Ref: EPA SDWA.' ;
    rdfs:domain ind:Wwtp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:receivingWaterClassification rdf:type rdf:Property ;
    rdfs:label 'Receiving Water Classification' ;
    rdfs:comment 'Water body classification. Ref: EPA SDWA.' ;
    rdfs:domain ind:Wwtp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryJurisdiction rdf:type rdf:Property ;
    rdfs:label 'Regulatory Jurisdiction' ;
    rdfs:comment 'EPA Region or state agency. Ref: EPA SDWA.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scadaSystemReference rdf:type rdf:Property ;
    rdfs:label 'Scada System Reference' ;
    rdfs:comment 'SCADA system reference. Ref: EPA SDWA.' ;
    rdfs:domain ind:Wwtp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:treatmentLevel rdf:type rdf:Property ;
    rdfs:label 'Treatment Level' ;
    rdfs:comment 'Primary, secondary, tertiary, advanced. Ref: EPA SDWA.' ;
    rdfs:domain ind:Wwtp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:treatmentProcessDescription rdf:type rdf:Property ;
    rdfs:label 'Treatment Process Description' ;
    rdfs:comment 'Treatment process description. Ref: EPA SDWA.' ;
    rdfs:domain ind:Wwtp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:effluentDischargeEventId rdf:type rdf:Property ;
    rdfs:label 'Effluent Discharge Event Id' ;
    rdfs:comment 'Unique identifier for the effluent discharge event record. Primary key for tracking individual discharge occurrences from WWTP outfalls. Ref: EPA SDWA.' ;
    rdfs:domain ind:Wastewater ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EffluentDischargeEvent .

ind:dischargeLocationId rdf:type rdf:Property ;
    rdfs:label 'Discharge Location Id' ;
    rdfs:comment 'Foreign key linking to asset.location. Business justification: Effluent discharge events occur at permitted discharge points that are registered locations. Role-prefix \'discharge_\' used because effluent_discharge_event has inline lat/lon but no location FK. Named' ;
    rdfs:domain ind:EffluentDischargeEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Location .

ind:bypassNotificationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Bypass Notification Timestamp' ;
    rdfs:comment 'Date and time when regulatory authorities were notified of an emergency bypass or unauthorized discharge event, as required by NPDES permit conditions. Ref: EPA SDWA.' ;
    rdfs:domain ind:EffluentDischargeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:bypassReasonCode rdf:type rdf:Property ;
    rdfs:label 'Bypass Reason Code' ;
    rdfs:comment 'Standardized code indicating the reason for a treatment bypass or emergency discharge (e.g., equipment failure, extreme weather, power outage). Ref: EPA SDWA.' ;
    rdfs:domain ind:EffluentDischargeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dischargeAuthorizationNumber rdf:type rdf:Property ;
    rdfs:label 'Discharge Authorization Number' ;
    rdfs:comment 'External authorization or permit number assigned by the regulatory agency for this discharge event or outfall. Ref: EPA SDWA.' ;
    rdfs:domain ind:EffluentDischargeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dischargeDurationHours rdf:type rdf:Property ;
    rdfs:label 'Discharge Duration Hours' ;
    rdfs:comment 'Total duration of the discharge event measured in hours. Calculated from start and end timestamps. Ref: EPA SDWA.' ;
    rdfs:domain ind:EffluentDischargeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dischargeEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Discharge End Timestamp' ;
    rdfs:comment 'Date and time when the effluent discharge event ended. Used to calculate total discharge duration and volume. Ref: EPA SDWA.' ;
    rdfs:domain ind:EffluentDischargeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:dischargeFlowRateGpm rdf:type rdf:Property ;
    rdfs:label 'Discharge Flow Rate Gpm' ;
    rdfs:comment 'Average flow rate of effluent discharge measured in gallons per minute during the event. Ref: EPA SDWA.' ;
    rdfs:domain ind:EffluentDischargeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dischargePointLatitude rdf:type rdf:Property ;
    rdfs:label 'Discharge Point Latitude' ;
    rdfs:comment 'Geographic latitude coordinate of the outfall discharge point in decimal degrees. Ref: EPA SDWA.' ;
    rdfs:domain ind:EffluentDischargeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dischargePointLongitude rdf:type rdf:Property ;
    rdfs:label 'Discharge Point Longitude' ;
    rdfs:comment 'Geographic longitude coordinate of the outfall discharge point in decimal degrees. Ref: EPA SDWA.' ;
    rdfs:domain ind:EffluentDischargeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dischargeStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Discharge Start Timestamp' ;
    rdfs:comment 'Date and time when the effluent discharge event began. Critical for calculating discharge duration and compliance with permit limits. Ref: EPA SDWA.' ;
    rdfs:domain ind:EffluentDischargeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:dischargeStatus rdf:type rdf:Property ;
    rdfs:label 'Discharge Status' ;
    rdfs:comment 'Current operational status of the discharge event indicating whether it was authorized under permit conditions, an emergency bypass, or an unauthorized release. Ref: EPA SDWA.' ;
    rdfs:domain ind:EffluentDischargeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dischargeVolumeMgd rdf:type rdf:Property ;
    rdfs:label 'Discharge Volume Mgd' ;
    rdfs:comment 'Total volume of treated effluent discharged during this event, measured in million gallons per day. Core metric for NPDES permit compliance and DMR reporting. Ref: EPA SDWA.' ;
    rdfs:domain ind:EffluentDischargeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dmrReportingPeriod rdf:type rdf:Property ;
    rdfs:label 'Dmr Reporting Period' ;
    rdfs:comment 'The monthly or quarterly DMR reporting period to which this discharge event will be aggregated for regulatory submission. Ref: EPA SDWA.' ;
    rdfs:domain ind:Wastewater ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dmrSubmissionDate rdf:type rdf:Property ;
    rdfs:label 'Dmr Submission Date' ;
    rdfs:comment 'Date when the DMR containing this discharge event data was submitted to the regulatory authority. Ref: EPA SDWA.' ;
    rdfs:domain ind:Wastewater ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:dmrSubmittedFlag rdf:type rdf:Property ;
    rdfs:label 'Dmr Submitted Flag' ;
    rdfs:comment 'Indicates whether this discharge event has been included in a submitted DMR to the regulatory authority. Ref: EPA SDWA.' ;
    rdfs:domain ind:EffluentDischargeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:operatorCertificationNumber rdf:type rdf:Property ;
    rdfs:label 'Operator Certification Number' ;
    rdfs:comment 'State-issued certification number of the operator responsible for monitoring the discharge event. Ref: EPA SDWA.' ;
    rdfs:domain ind:EffluentDischargeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:permitLimitApplicableFlag rdf:type rdf:Property ;
    rdfs:label 'Permit Limit Applicable Flag' ;
    rdfs:comment 'Indicates whether NPDES permit discharge limits apply to this specific discharge event. False for emergency bypasses or non-permitted discharges. Ref: EPA SDWA.' ;
    rdfs:domain ind:EffluentDischargeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rainfallAmountInches rdf:type rdf:Property ;
    rdfs:label 'Rainfall Amount Inches' ;
    rdfs:comment 'Total rainfall measured in inches during or immediately preceding the discharge event. Relevant for wet weather discharge analysis and CSO/SSO correlation. Ref: EPA SDWA.' ;
    rdfs:domain ind:Wastewater ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:receivingWaterBodyClassification rdf:type rdf:Property ;
    rdfs:label 'Receiving Water Body Classification' ;
    rdfs:comment 'Regulatory classification of the receiving water body (e.g., Class A, Class B, impaired waters, sensitive ecosystem) that determines applicable discharge standards. Ref: EPA SDWA.' ;
    rdfs:domain ind:EffluentDischargeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:receivingWaterBodyName rdf:type rdf:Property ;
    rdfs:label 'Receiving Water Body Name' ;
    rdfs:comment 'Name of the river, stream, lake, ocean, or other water body into which the treated effluent was discharged. Ref: EPA SDWA.' ;
    rdfs:domain ind:Wastewater ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scadaEventReference rdf:type rdf:Property ;
    rdfs:label 'Scada Event Reference' ;
    rdfs:comment 'Identifier linking this discharge event to the corresponding SCADA system event record for process data correlation. Ref: EPA SDWA.' ;
    rdfs:domain ind:EffluentDischargeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:treatmentLevelAchieved rdf:type rdf:Property ;
    rdfs:label 'Treatment Level Achieved' ;
    rdfs:comment 'Level of wastewater treatment achieved prior to discharge (primary, secondary, tertiary, advanced, or partial treatment during bypass). Ref: EPA SDWA.' ;
    rdfs:domain ind:EffluentDischargeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:violationDescription rdf:type rdf:Property ;
    rdfs:label 'Violation Description' ;
    rdfs:comment 'Detailed description of any permit violations or exceedances that occurred during this discharge event, including parameters exceeded and magnitude. Ref: EPA SDWA.' ;
    rdfs:domain ind:EffluentDischargeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:violationFlag rdf:type rdf:Property ;
    rdfs:label 'Violation Flag' ;
    rdfs:comment 'Indicates whether this discharge event resulted in one or more NPDES permit violations or exceedances of discharge limits. Ref: EPA SDWA.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:effluentParameterResultId rdf:type rdf:Property ;
    rdfs:label 'Effluent Parameter Result Id' ;
    rdfs:comment 'Unique identifier for the effluent parameter measurement result record. Ref: Sensus AMI.' ;
    rdfs:domain ind:EffluentParameterResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:analysisDate rdf:type rdf:Property ;
    rdfs:label 'Analysis Date' ;
    rdfs:comment 'Date when the laboratory analysis was performed on the sample. Ref: Sensus AMI.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:analysisMethod rdf:type rdf:Property ;
    rdfs:label 'Analysis Method' ;
    rdfs:comment 'EPA-approved analytical method used to measure the parameter (e.g., EPA 405.1 for BOD, EPA 160.2 for TSS, SM 4500-H+ for pH). Ref: Sensus AMI.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dataValidationStatus rdf:type rdf:Property ;
    rdfs:label 'Data Validation Status' ;
    rdfs:comment 'Internal validation status of the result data before regulatory submission (draft, validated by supervisor, approved for submission, or rejected).' ;
    rdfs:domain ind:EffluentParameterResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:detectionLimit rdf:type rdf:Property ;
    rdfs:label 'Detection Limit' ;
    rdfs:comment 'Minimum concentration that the analytical method can reliably detect for this parameter. Ref: Sensus AMI.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dmrSubmissionStatus rdf:type rdf:Property ;
    rdfs:label 'Dmr Submission Status' ;
    rdfs:comment 'Status of the DMR submission that includes this result (pending, submitted to EPA, accepted by EPA, or rejected). Ref: Sensus AMI.' ;
    rdfs:domain ind:EffluentParameterResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exceedancePercentage rdf:type rdf:Property ;
    rdfs:label 'Exceedance Percentage' ;
    rdfs:comment 'Percentage by which the measured value exceeds the permit limit, calculated as ((measured_value - permit_limit_value) / permit_limit_value) * 100. Null if result is in compliance. Ref: Sensus AMI.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:flowRateMgd rdf:type rdf:Property ;
    rdfs:label 'Flow Rate Mgd' ;
    rdfs:comment 'Effluent discharge flow rate in million gallons per day at the time of sample collection, used for mass loading calculations. Ref: Sensus AMI.' ;
    rdfs:domain ind:EffluentParameterResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:laboratoryBatchNumber rdf:type rdf:Property ;
    rdfs:label 'Laboratory Batch Number' ;
    rdfs:comment 'Laboratory-assigned batch or run number for quality control and traceability purposes. Ref: Sensus AMI.' ;
    rdfs:domain ind:EffluentParameterResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:massLoadingLbsPerDay rdf:type rdf:Property ;
    rdfs:label 'Mass Loading Lbs Per Day' ;
    rdfs:comment 'Calculated mass loading of the parameter in pounds per day, derived from concentration and flow rate (concentration * flow * 8.34). Ref: Sensus AMI.' ;
    rdfs:domain ind:EffluentParameterResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:qualityControlFlag rdf:type rdf:Property ;
    rdfs:label 'Quality Control Flag' ;
    rdfs:comment 'Indicates the outcome of quality control checks (e.g., duplicate analysis, spike recovery, blank contamination) for this result. Ref: Sensus AMI.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:quantitationLimit rdf:type rdf:Property ;
    rdfs:label 'Quantitation Limit' ;
    rdfs:comment 'Minimum concentration that the analytical method can reliably quantify with acceptable precision and accuracy. Ref: Sensus AMI.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:resultQualifier rdf:type rdf:Property ;
    rdfs:label 'Result Qualifier' ;
    rdfs:comment 'Laboratory qualifier code indicating special conditions of the result (e.g., < for below detection limit, > for above quantitation limit, J for estimated value). Ref: Sensus AMI.' ;
    rdfs:domain ind:EffluentParameterResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sampleCollectionDate rdf:type rdf:Property ;
    rdfs:label 'Sample Collection Date' ;
    rdfs:comment 'Date when the effluent sample was collected from the discharge point. Ref: Sensus AMI.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sampleCollectionTime rdf:type rdf:Property ;
    rdfs:label 'Sample Collection Time' ;
    rdfs:comment 'Precise timestamp when the effluent sample was collected, including time zone. Ref: Sensus AMI.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:sampleType rdf:type rdf:Property ;
    rdfs:label 'Sample Type' ;
    rdfs:comment 'Method by which the effluent sample was collected (e.g., grab sample, 24-hour composite, flow-weighted composite, continuous monitoring). Ref: Sensus AMI.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:validationDate rdf:type rdf:Property ;
    rdfs:label 'Validation Date' ;
    rdfs:comment 'Date when the result was validated and approved for regulatory reporting. Ref: Sensus AMI.' ;
    rdfs:domain ind:EffluentParameterResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ssoEventId rdf:type rdf:Property ;
    rdfs:label 'Sso Event Id' ;
    rdfs:comment 'Unique identifier for the sanitary sewer overflow event. Primary key. Ref: EPA SDWA.' ;
    rdfs:domain ind:SsoEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ssoRegistryId rdf:type rdf:Property ;
    rdfs:label 'Sso Registry Id' ;
    rdfs:comment 'Foreign key reference to the infrastructure asset (pipe, pump station, lift station) associated with the overflow event. Ref: EPA SDWA.' ;
    rdfs:domain ind:SsoEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Registry .

ind:causeCategory rdf:type rdf:Property ;
    rdfs:label 'Cause Category' ;
    rdfs:comment 'Primary category of the root cause of the overflow event. [ENUM-REF-CANDIDATE: blockage|capacity_exceedance|equipment_failure|power_failure|operator_error|vandalism|inflow_infiltration|structural_failure|maintenance_activity|unknown — promote to reference product]. Ref: EPA SDWA.' ;
    rdfs:domain ind:SsoEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:causeCode rdf:type rdf:Property ;
    rdfs:label 'Cause Code' ;
    rdfs:comment 'Detailed cause code identifying the specific reason for the overflow (e.g., grease blockage, root intrusion, pump failure, wet weather overload). Ref: EPA SDWA.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:causeDescription rdf:type rdf:Property ;
    rdfs:label 'Cause Description' ;
    rdfs:comment 'Detailed narrative description of the cause and circumstances of the overflow event. Ref: EPA SDWA.' ;
    rdfs:domain ind:SsoEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:correctiveActionTaken rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Taken' ;
    rdfs:comment 'Description of immediate corrective actions taken to stop the overflow and mitigate environmental impact (e.g., cleared blockage, repaired pump, deployed vacuum truck). Ref: EPA SDWA.' ;
    rdfs:domain ind:SsoEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:discoveredBy rdf:type rdf:Property ;
    rdfs:label 'Discovered By' ;
    rdfs:comment 'Source or party that discovered and reported the overflow event. Ref: EPA SDWA.' ;
    rdfs:domain ind:SsoEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:discoveryTimestamp rdf:type rdf:Property ;
    rdfs:label 'Discovery Timestamp' ;
    rdfs:comment 'Date and time when the overflow event was first discovered or reported. Ref: EPA SDWA.' ;
    rdfs:domain ind:SsoEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:dmrReported rdf:type rdf:Property ;
    rdfs:label 'Dmr Reported' ;
    rdfs:comment 'Boolean flag indicating whether the overflow event was included in the monthly Discharge Monitoring Report (DMR) submitted under the NPDES permit. Ref: EPA SDWA.' ;
    rdfs:domain ind:SsoEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:durationMinutes rdf:type rdf:Property ;
    rdfs:label 'Duration Minutes' ;
    rdfs:comment 'Total duration of the overflow event in minutes, calculated from start to end timestamp. Ref: EPA SDWA.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:enforcementActionTaken rdf:type rdf:Property ;
    rdfs:label 'Enforcement Action Taken' ;
    rdfs:comment 'Type of enforcement action taken by regulatory agencies in response to the overflow event. Ref: EPA SDWA.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedVolumeGallons rdf:type rdf:Property ;
    rdfs:label 'Estimated Volume Gallons' ;
    rdfs:comment 'Estimated volume of untreated or partially treated wastewater discharged during the SSO event, measured in gallons. Critical metric for regulatory reporting and environmental impact assessment. Ref: EPA SDWA.' ;
    rdfs:domain ind:SsoEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:eventEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Event End Timestamp' ;
    rdfs:comment 'Date and time when the sanitary sewer overflow event was stopped or contained. Ref: EPA SDWA.' ;
    rdfs:domain ind:SsoEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:eventNumber rdf:type rdf:Property ;
    rdfs:label 'Event Number' ;
    rdfs:comment 'Externally-known business identifier for the SSO event, typically formatted as SSO-YYYY-NNNNNN for regulatory reporting and tracking. Ref: EPA SDWA.' ;
    rdfs:domain ind:SsoEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Event Start Timestamp' ;
    rdfs:comment 'Date and time when the sanitary sewer overflow event began, representing the principal business event time for regulatory reporting. Ref: EPA SDWA.' ;
    rdfs:domain ind:SsoEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:eventStatus rdf:type rdf:Property ;
    rdfs:label 'Event Status' ;
    rdfs:comment 'Current lifecycle status of the SSO event in the incident management workflow. Ref: EPA SDWA.' ;
    rdfs:domain ind:SsoEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:overflowLocationType rdf:type rdf:Property ;
    rdfs:label 'Overflow Location Type' ;
    rdfs:comment 'Type of infrastructure asset where the overflow occurred. Ref: EPA SDWA.' ;
    rdfs:domain ind:SsoEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:penaltyAmount rdf:type rdf:Property ;
    rdfs:label 'Penalty Amount' ;
    rdfs:comment 'Monetary penalty assessed by regulatory agencies for the overflow event, in US dollars. Ref: EPA SDWA.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:preventiveActionPlanned rdf:type rdf:Property ;
    rdfs:label 'Preventive Action Planned' ;
    rdfs:comment 'Description of long-term preventive measures planned to prevent recurrence (e.g., pipe replacement, capacity upgrade, enhanced maintenance). Ref: EPA SDWA.' ;
    rdfs:domain ind:SsoEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:publicNotificationRequired rdf:type rdf:Property ;
    rdfs:label 'Public Notification Required' ;
    rdfs:comment 'Boolean flag indicating whether public notification (posting, media alert, direct contact) is required based on overflow volume, location, or receiving environment. Ref: EPA SDWA.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:publicNotificationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Public Notification Timestamp' ;
    rdfs:comment 'Date and time when public notification was issued regarding the overflow event. Ref: EPA SDWA.' ;
    rdfs:domain ind:SsoEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:reachedSurfaceWater rdf:type rdf:Property ;
    rdfs:label 'Reached Surface Water' ;
    rdfs:comment 'Boolean flag indicating whether the overflow reached a surface water body, triggering enhanced regulatory reporting requirements. Ref: EPA SDWA.' ;
    rdfs:domain ind:SsoEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:receivingEnvironment rdf:type rdf:Property ;
    rdfs:label 'Receiving Environment' ;
    rdfs:comment 'Type of environment that received the discharged wastewater: surface water body, storm drainage system, land surface, building interior, or other. Ref: EPA SDWA.' ;
    rdfs:domain ind:SsoEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryNotificationRequired rdf:type rdf:Property ;
    rdfs:label 'Regulatory Notification Required' ;
    rdfs:comment 'Boolean flag indicating whether the overflow event meets thresholds requiring notification to state or federal regulatory agencies. Ref: EPA SDWA.' ;
    rdfs:domain ind:SsoEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryNotificationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Regulatory Notification Timestamp' ;
    rdfs:comment 'Date and time when the overflow event was reported to the regulatory agency (EPA, state primacy agency), typically required within 24 hours. Ref: EPA SDWA.' ;
    rdfs:domain ind:SsoEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:responseTimestamp rdf:type rdf:Property ;
    rdfs:label 'Response Timestamp' ;
    rdfs:comment 'Date and time when utility personnel arrived on-site to respond to the overflow event. Ref: EPA SDWA.' ;
    rdfs:domain ind:SsoEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:responsibleParty rdf:type rdf:Property ;
    rdfs:label 'Responsible Party' ;
    rdfs:comment 'Name or identifier of the utility staff member or contractor responsible for managing the response to the overflow event. Ref: EPA SDWA.' ;
    rdfs:domain ind:SsoEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:volumeEstimationMethod rdf:type rdf:Property ;
    rdfs:label 'Volume Estimation Method' ;
    rdfs:comment 'Method used to determine the spill volume: measured (flow meter), calculated (hydraulic model), or estimated (visual observation). Ref: EPA SDWA.' ;
    rdfs:domain ind:SsoEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:volumeRecoveredGallons rdf:type rdf:Property ;
    rdfs:label 'Volume Recovered Gallons' ;
    rdfs:comment 'Volume of spilled wastewater that was recovered and returned to the collection system or treatment plant, measured in gallons. Ref: EPA SDWA.' ;
    rdfs:domain ind:SsoEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:weatherRelated rdf:type rdf:Property ;
    rdfs:label 'Weather Related' ;
    rdfs:comment 'Boolean flag indicating whether the overflow was caused or exacerbated by wet weather conditions, inflow, or infiltration (I&I). Ref: EPA SDWA.' ;
    rdfs:domain ind:SsoEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:industrialUserPermitId rdf:type rdf:Property ;
    rdfs:label 'Industrial User Permit Id' ;
    rdfs:comment 'Unique identifier for the industrial user permit record. Primary key for the IUP registry. Ref: EPA SDWA.' ;
    rdfs:domain ind:Wastewater ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:IndustrialUserPermit .

ind:dischargeMeteringMeteringMeterId rdf:type rdf:Property ;
    rdfs:label 'Discharge Metering Metering Meter Id' ;
    rdfs:comment 'Foreign key linking to metering.metering_meter. Business justification: Industrial pretreatment permits require discharge volume monitoring for compliance and flow-based surcharge calculations. Utilities install dedicated wastewater discharge meters at industrial faciliti. Ref: EPA SDWA.' ;
    rdfs:domain ind:IndustrialUserPermit ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Meter .

ind:facilityLocationId rdf:type rdf:Property ;
    rdfs:label 'Facility Location Id' ;
    rdfs:comment 'Foreign key linking to asset.asset_location. Business justification: Industrial user permits are tied to specific facility locations for inspection scheduling, compliance tracking, and enforcement actions. Asset location integration enables spatial analysis of pretreat. Ref: EPA SDWA.' ;
    rdfs:domain ind:IndustrialUserPermit ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Location .

ind:samplingScheduleId rdf:type rdf:Property ;
    rdfs:label 'Sampling Schedule Id' ;
    rdfs:comment 'Foreign key linking to quality.sampling_schedule. Business justification: Pretreatment program regulations require each industrial user permit to have an associated monitoring/sampling schedule. Linking industrial_user_permit to sampling_schedule enables tracking of IU comp' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SamplingSchedule .

ind:bodLimitMgPerL rdf:type rdf:Property ;
    rdfs:label 'Bod Limit Mg Per L' ;
    rdfs:comment 'Maximum permitted concentration of BOD in milligrams per liter that the industrial user may discharge to the wastewater collection system. Ref: EPA SDWA.' ;
    rdfs:domain ind:IndustrialUserPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cadmiumLimitMgPerL rdf:type rdf:Property ;
    rdfs:label 'Cadmium Limit Mg Per L' ;
    rdfs:comment 'Maximum permitted concentration of cadmium in milligrams per liter. Heavy metal limit for metal finishing and plating industries. Ref: EPA SDWA.' ;
    rdfs:domain ind:IndustrialUserPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:categoricalStandardApplicable rdf:type rdf:Property ;
    rdfs:label 'Categorical Standard Applicable' ;
    rdfs:comment 'Indicates whether federal categorical pretreatment standards apply to this industrial user based on SIC code and discharge characteristics. Ref: EPA SDWA.' ;
    rdfs:domain ind:IndustrialUserPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:categoricalStandardCitation rdf:type rdf:Property ;
    rdfs:label 'Categorical Standard Citation' ;
    rdfs:comment 'Specific CFR citation for the applicable categorical pretreatment standard (e.g., 40 CFR Part 433 for Metal Finishing). Null if non-categorical. Ref: EPA SDWA.' ;
    rdfs:domain ind:IndustrialUserPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:chromiumLimitMgPerL rdf:type rdf:Property ;
    rdfs:label 'Chromium Limit Mg Per L' ;
    rdfs:comment 'Maximum permitted concentration of total chromium in milligrams per liter. Heavy metal limit for metal finishing and plating industries. Ref: EPA SDWA.' ;
    rdfs:domain ind:IndustrialUserPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:codLimitMgPerL rdf:type rdf:Property ;
    rdfs:label 'Cod Limit Mg Per L' ;
    rdfs:comment 'Maximum permitted concentration of COD in milligrams per liter that the industrial user may discharge to the wastewater collection system. Ref: EPA SDWA.' ;
    rdfs:domain ind:IndustrialUserPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:complianceScheduleFinalDate rdf:type rdf:Property ;
    rdfs:label 'Compliance Schedule Final Date' ;
    rdfs:comment 'Final date by which the industrial user must achieve full compliance with all permit discharge limits. Null if no compliance schedule is required. Ref: EPA SDWA.' ;
    rdfs:domain ind:IndustrialUserPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:complianceScheduleRequired rdf:type rdf:Property ;
    rdfs:label 'Compliance Schedule Required' ;
    rdfs:comment 'Indicates whether the permit includes a compliance schedule with milestones for achieving full compliance with discharge limits. Ref: EPA SDWA.' ;
    rdfs:domain ind:IndustrialUserPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:copperLimitMgPerL rdf:type rdf:Property ;
    rdfs:label 'Copper Limit Mg Per L' ;
    rdfs:comment 'Maximum permitted concentration of copper in milligrams per liter. Heavy metal limit for metal finishing and plating industries. Ref: EPA SDWA.' ;
    rdfs:domain ind:IndustrialUserPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:flowLimitGpd rdf:type rdf:Property ;
    rdfs:label 'Flow Limit Gpd' ;
    rdfs:comment 'Maximum permitted daily discharge flow rate in gallons per day (GPD) that the industrial user may discharge to the wastewater collection system. Ref: EPA SDWA.' ;
    rdfs:domain ind:IndustrialUserPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fogLimitMgPerL rdf:type rdf:Property ;
    rdfs:label 'Fog Limit Mg Per L' ;
    rdfs:comment 'Maximum permitted concentration of FOG in milligrams per liter that the industrial user may discharge. Critical for food service and processing facilities. Ref: EPA SDWA.' ;
    rdfs:domain ind:IndustrialUserPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:inspectionFrequency rdf:type rdf:Property ;
    rdfs:label 'Inspection Frequency' ;
    rdfs:comment 'Required frequency at which the pretreatment authority will conduct on-site inspections of the industrial facility and pretreatment system. Ref: EPA SDWA.' ;
    rdfs:domain ind:IndustrialUserPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:issuanceDate rdf:type rdf:Property ;
    rdfs:label 'Issuance Date' ;
    rdfs:comment 'Date on which the permit was officially issued by the pretreatment authority. Ref: EPA SDWA.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:issuingAuthority rdf:type rdf:Property ;
    rdfs:label 'Issuing Authority' ;
    rdfs:comment 'Name of the governmental or utility entity that issued the industrial user permit (e.g., municipal wastewater utility, state environmental agency). Ref: EPA SDWA.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:leadLimitMgPerL rdf:type rdf:Property ;
    rdfs:label 'Lead Limit Mg Per L' ;
    rdfs:comment 'Maximum permitted concentration of lead in milligrams per liter. Heavy metal limit for metal finishing and plating industries. Ref: EPA SDWA.' ;
    rdfs:domain ind:IndustrialUserPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mercuryLimitMgPerL rdf:type rdf:Property ;
    rdfs:label 'Mercury Limit Mg Per L' ;
    rdfs:comment 'Maximum permitted concentration of mercury in milligrams per liter. Heavy metal limit for dental and medical facilities. Ref: EPA SDWA.' ;
    rdfs:domain ind:IndustrialUserPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:monitoringFrequency rdf:type rdf:Property ;
    rdfs:label 'Monitoring Frequency' ;
    rdfs:comment 'Required frequency at which the industrial user must conduct self-monitoring and submit discharge monitoring reports (DMR) to the pretreatment authority. Ref: EPA SDWA.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nickelLimitMgPerL rdf:type rdf:Property ;
    rdfs:label 'Nickel Limit Mg Per L' ;
    rdfs:comment 'Maximum permitted concentration of nickel in milligrams per liter. Heavy metal limit for metal finishing and plating industries. Ref: EPA SDWA.' ;
    rdfs:domain ind:IndustrialUserPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:permitStatus rdf:type rdf:Property ;
    rdfs:label 'Permit Status' ;
    rdfs:comment 'Current lifecycle status of the industrial user permit. Active permits are in force; expired permits require renewal; suspended or revoked permits indicate enforcement action. Ref: EPA SDWA.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:phMaximum rdf:type rdf:Property ;
    rdfs:label 'Ph Maximum' ;
    rdfs:comment 'Maximum permitted pH level for industrial discharge. Typically 9.0 to 12.5 per local limits. Ref: EPA SDWA.' ;
    rdfs:domain ind:IndustrialUserPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:phMinimum rdf:type rdf:Property ;
    rdfs:label 'Ph Minimum' ;
    rdfs:comment 'Minimum permitted pH level for industrial discharge. Typically 5.0 to 6.0 per local limits. Ref: EPA SDWA.' ;
    rdfs:domain ind:IndustrialUserPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pretreatmentRequired rdf:type rdf:Property ;
    rdfs:label 'Pretreatment Required' ;
    rdfs:comment 'Indicates whether the industrial user is required to install and operate an on-site pretreatment system to meet discharge limits. Ref: EPA SDWA.' ;
    rdfs:domain ind:IndustrialUserPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pretreatmentSystemDescription rdf:type rdf:Property ;
    rdfs:label 'Pretreatment System Description' ;
    rdfs:comment 'Description of the on-site pretreatment system installed by the industrial user (e.g., oil-water separator, pH neutralization, metals precipitation). Null if no pretreatment is required. Ref: EPA SDWA.' ;
    rdfs:domain ind:IndustrialUserPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:silverLimitMgPerL rdf:type rdf:Property ;
    rdfs:label 'Silver Limit Mg Per L' ;
    rdfs:comment 'Maximum permitted concentration of silver in milligrams per liter. Heavy metal limit for photographic and metal finishing industries. Ref: EPA SDWA.' ;
    rdfs:domain ind:IndustrialUserPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalNitrogenLimitMgPerL rdf:type rdf:Property ;
    rdfs:label 'Total Nitrogen Limit Mg Per L' ;
    rdfs:comment 'Maximum permitted concentration of total nitrogen in milligrams per liter that the industrial user may discharge. Ref: EPA SDWA.' ;
    rdfs:domain ind:IndustrialUserPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalPhosphorusLimitMgPerL rdf:type rdf:Property ;
    rdfs:label 'Total Phosphorus Limit Mg Per L' ;
    rdfs:comment 'Maximum permitted concentration of total phosphorus in milligrams per liter that the industrial user may discharge. Ref: EPA SDWA.' ;
    rdfs:domain ind:IndustrialUserPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tssLimitMgPerL rdf:type rdf:Property ;
    rdfs:label 'Tss Limit Mg Per L' ;
    rdfs:comment 'Maximum permitted concentration of TSS in milligrams per liter that the industrial user may discharge to the wastewater collection system. Ref: EPA SDWA.' ;
    rdfs:domain ind:IndustrialUserPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:zincLimitMgPerL rdf:type rdf:Property ;
    rdfs:label 'Zinc Limit Mg Per L' ;
    rdfs:comment 'Maximum permitted concentration of zinc in milligrams per liter. Heavy metal limit for metal finishing and plating industries. Ref: EPA SDWA.' ;
    rdfs:domain ind:IndustrialUserPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:biosolidsBatchId rdf:type rdf:Property ;
    rdfs:label 'Biosolids Batch Id' ;
    rdfs:comment 'Unique identifier for the biosolids production batch. Primary key for the biosolids batch record. Ref: EPA SDWA.' ;
    rdfs:domain ind:BiosolidsBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dispositionLocationId rdf:type rdf:Property ;
    rdfs:label 'Disposition Location Id' ;
    rdfs:comment 'Foreign key linking to asset.location. Business justification: Biosolids disposition sites (land application fields, composting facilities, landfills) are registered locations. disposition_site_name is a denormalized location reference. Role-prefix \'disposition_\'' ;
    rdfs:domain ind:BiosolidsBatch ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Location .

ind:treatmentProcessUnitId rdf:type rdf:Property ;
    rdfs:label 'Treatment Process Unit Id' ;
    rdfs:comment 'Reference to the specific treatment process unit (digester, dewatering equipment, stabilization system) that produced this batch. Ref: EPA SDWA.' ;
    rdfs:domain ind:BiosolidsBatch ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProcessUnit .

ind:workOrderId rdf:type rdf:Property ;
    rdfs:label 'Work Order Id' ;
    rdfs:comment 'Foreign key linking to asset.work_order. Business justification: Biosolids processing operations generate maintenance work orders when equipment (centrifuges, belt presses, dryers) fails during batch processing. Work order linkage enables equipment failure cost all. Ref: EPA SDWA.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:WorkOrder .

ind:arsenicConcentrationMgPerKg rdf:type rdf:Property ;
    rdfs:label 'Arsenic Concentration Mg Per Kg' ;
    rdfs:comment 'Arsenic concentration in milligrams per kilogram dry weight. Ceiling concentration limit: 75 mg/kg per 40 CFR Part 503 Table 1. Ref: EPA SDWA.' ;
    rdfs:domain ind:BiosolidsBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:batchDate rdf:type rdf:Property ;
    rdfs:label 'Batch Date' ;
    rdfs:comment 'The date when this biosolids batch was produced and removed from the treatment process. Critical for regulatory compliance and shelf-life tracking. Ref: EPA SDWA.' ;
    rdfs:domain ind:BiosolidsBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:batchEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Batch End Timestamp' ;
    rdfs:comment 'Timestamp when the biosolids batch production process was completed and the material was ready for disposition. Ref: EPA SDWA.' ;
    rdfs:domain ind:BiosolidsBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:batchStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Batch Start Timestamp' ;
    rdfs:comment 'Timestamp when the biosolids batch production process began, including dewatering or stabilization initiation. Ref: EPA SDWA.' ;
    rdfs:domain ind:BiosolidsBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:cadmiumConcentrationMgPerKg rdf:type rdf:Property ;
    rdfs:label 'Cadmium Concentration Mg Per Kg' ;
    rdfs:comment 'Cadmium concentration in milligrams per kilogram dry weight. Ceiling concentration limit: 85 mg/kg per 40 CFR Part 503 Table 1. Ref: EPA SDWA.' ;
    rdfs:domain ind:BiosolidsBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:copperConcentrationMgPerKg rdf:type rdf:Property ;
    rdfs:label 'Copper Concentration Mg Per Kg' ;
    rdfs:comment 'Copper concentration in milligrams per kilogram dry weight. Ceiling concentration limit: 4,300 mg/kg per 40 CFR Part 503 Table 1. Ref: EPA SDWA.' ;
    rdfs:domain ind:BiosolidsBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dispositionDate rdf:type rdf:Property ;
    rdfs:label 'Disposition Date' ;
    rdfs:comment 'The date when this biosolids batch was disposed of, applied to land, or transferred for beneficial reuse. Required for regulatory tracking and chain-of-custody documentation. Ref: EPA SDWA.' ;
    rdfs:domain ind:BiosolidsBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:dispositionMethod rdf:type rdf:Property ;
    rdfs:label 'Disposition Method' ;
    rdfs:comment 'The final disposition method for this biosolids batch. Determines applicable regulatory requirements under 40 CFR Part 503 Subparts B, C, D, or E. Ref: EPA SDWA.' ;
    rdfs:domain ind:BiosolidsBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dispositionSitePermitNumber rdf:type rdf:Property ;
    rdfs:label 'Disposition Site Permit Number' ;
    rdfs:comment 'Regulatory permit number for the disposition site (land application permit, landfill permit, incinerator air permit, etc.). Ref: EPA SDWA.' ;
    rdfs:domain ind:BiosolidsBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dryTons rdf:type rdf:Property ;
    rdfs:label 'Dry Tons' ;
    rdfs:comment 'dry tons. Ref: EPA SDWA.' ;
    rdfs:domain ind:BiosolidsBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dryWeightTons rdf:type rdf:Property ;
    rdfs:label 'Dry Weight Tons' ;
    rdfs:comment 'Total dry weight of the biosolids batch in US tons (2,000 lbs). Used for regulatory reporting, disposal tracking, and beneficial use application rate calculations. Ref: EPA SDWA.' ;
    rdfs:domain ind:BiosolidsBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:exceptionalQualityFlag rdf:type rdf:Property ;
    rdfs:label 'Exceptional Quality Flag' ;
    rdfs:comment 'Indicates whether this batch meets Exceptional Quality criteria (Class A pathogen reduction, pollutant concentration limits per Table 3, and vector attraction reduction). EQ biosolids have no federal land application restrictions. Ref: EPA SDWA.' ;
    rdfs:domain ind:BiosolidsBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fecalColiformDensityMpnPerGram rdf:type rdf:Property ;
    rdfs:label 'Fecal Coliform Density Mpn Per Gram' ;
    rdfs:comment 'Fecal coliform density in MPN per gram of total solids (dry weight basis). Class A requires <1,000 MPN/g; Class B requires <2,000,000 MPN/g. Ref: EPA SDWA.' ;
    rdfs:domain ind:BiosolidsBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:laboratoryAnalysisDate rdf:type rdf:Property ;
    rdfs:label 'Laboratory Analysis Date' ;
    rdfs:comment 'Date when laboratory analysis of this batch was completed. Used to verify compliance with monitoring frequency requirements. Ref: EPA SDWA.' ;
    rdfs:domain ind:BiosolidsBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:leadConcentrationMgPerKg rdf:type rdf:Property ;
    rdfs:label 'Lead Concentration Mg Per Kg' ;
    rdfs:comment 'Lead concentration in milligrams per kilogram dry weight. Ceiling concentration limit: 840 mg/kg per 40 CFR Part 503 Table 1. Ref: EPA SDWA.' ;
    rdfs:domain ind:BiosolidsBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mercuryConcentrationMgPerKg rdf:type rdf:Property ;
    rdfs:label 'Mercury Concentration Mg Per Kg' ;
    rdfs:comment 'Mercury concentration in milligrams per kilogram dry weight. Ceiling concentration limit: 57 mg/kg per 40 CFR Part 503 Table 1. Ref: EPA SDWA.' ;
    rdfs:domain ind:BiosolidsBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nickelConcentrationMgPerKg rdf:type rdf:Property ;
    rdfs:label 'Nickel Concentration Mg Per Kg' ;
    rdfs:comment 'Nickel concentration in milligrams per kilogram dry weight. Ceiling concentration limit: 420 mg/kg per 40 CFR Part 503 Table 1. Ref: EPA SDWA.' ;
    rdfs:domain ind:BiosolidsBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pathogenClass rdf:type rdf:Property ;
    rdfs:label 'Pathogen Class' ;
    rdfs:comment 'Classification of pathogen reduction achieved: Class A (unrestricted use, meets PFRP requirements) or Class B (restricted use, meets PSRP requirements) per 40 CFR Part 503. Ref: EPA SDWA.' ;
    rdfs:domain ind:BiosolidsBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:percentSolids rdf:type rdf:Property ;
    rdfs:label 'Percent Solids' ;
    rdfs:comment 'Percentage of total solids content in the biosolids batch. Typical range: 15-30% for dewatered cake, 90%+ for dried pellets. Critical for vector attraction reduction Option 7 (75% solids minimum). Ref: EPA SDWA.' ;
    rdfs:domain ind:BiosolidsBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:salmonellaDensityMpnPer4Grams rdf:type rdf:Property ;
    rdfs:label 'Salmonella Density Mpn Per 4 Grams' ;
    rdfs:comment 'Salmonella sp. bacteria density in MPN per 4 grams of total solids (dry weight basis). Class A requires <3 MPN/4g. Ref: EPA SDWA.' ;
    rdfs:domain ind:BiosolidsBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:seleniumConcentrationMgPerKg rdf:type rdf:Property ;
    rdfs:label 'Selenium Concentration Mg Per Kg' ;
    rdfs:comment 'Selenium concentration in milligrams per kilogram dry weight. Ceiling concentration limit: 100 mg/kg per 40 CFR Part 503 Table 1. Ref: EPA SDWA.' ;
    rdfs:domain ind:BiosolidsBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:stabilizationMethod rdf:type rdf:Property ;
    rdfs:label 'Stabilization Method' ;
    rdfs:comment 'stabilization method. Ref: EPA SDWA.' ;
    rdfs:domain ind:BiosolidsBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalNitrogenPercent rdf:type rdf:Property ;
    rdfs:label 'Total Nitrogen Percent' ;
    rdfs:comment 'Total nitrogen content as percentage of dry weight. Important for agronomic application rate calculations and nutrient management planning. Ref: EPA SDWA.' ;
    rdfs:domain ind:BiosolidsBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalPhosphorusPercent rdf:type rdf:Property ;
    rdfs:label 'Total Phosphorus Percent' ;
    rdfs:comment 'Total phosphorus content as percentage of dry weight. Critical for land application planning and nutrient management compliance. Ref: EPA SDWA.' ;
    rdfs:domain ind:BiosolidsBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalPotassiumPercent rdf:type rdf:Property ;
    rdfs:label 'Total Potassium Percent' ;
    rdfs:comment 'Total potassium content as percentage of dry weight. Used for fertilizer value assessment and agronomic rate calculations. Ref: EPA SDWA.' ;
    rdfs:domain ind:BiosolidsBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:treatmentProcess rdf:type rdf:Property ;
    rdfs:label 'Treatment Process' ;
    rdfs:comment 'treatment process. Ref: EPA SDWA.' ;
    rdfs:domain ind:BiosolidsBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vectorAttractionReductionMethod rdf:type rdf:Property ;
    rdfs:label 'Vector Attraction Reduction Method' ;
    rdfs:comment 'The specific vector attraction reduction option (1-10) applied per 40 CFR Part 503.33. Options include volatile solids reduction, digestion, pH adjustment, moisture reduction, and others. Ref: EPA SDWA.' ;
    rdfs:domain ind:BiosolidsBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:volatileSolidsReductionPercent rdf:type rdf:Property ;
    rdfs:label 'Volatile Solids Reduction Percent' ;
    rdfs:comment 'Percentage reduction in volatile solids achieved during treatment. Required for vector attraction reduction Options 1 and 2 (38% minimum reduction). Ref: EPA SDWA.' ;
    rdfs:domain ind:BiosolidsBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:wetWeightTons rdf:type rdf:Property ;
    rdfs:label 'Wet Weight Tons' ;
    rdfs:comment 'Total wet weight (as-hauled) of the biosolids batch in US tons. Used for transportation logistics and disposal facility invoicing. Ref: EPA SDWA.' ;
    rdfs:domain ind:BiosolidsBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:zincConcentrationMgPerKg rdf:type rdf:Property ;
    rdfs:label 'Zinc Concentration Mg Per Kg' ;
    rdfs:comment 'Zinc concentration in milligrams per kilogram dry weight. Ceiling concentration limit: 7,500 mg/kg per 40 CFR Part 503 Table 1. Ref: EPA SDWA.' ;
    rdfs:domain ind:BiosolidsBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:abandonmentDate rdf:type rdf:Property ;
    rdfs:label 'Abandonment Date' ;
    rdfs:comment 'Date when the service connection was permanently abandoned and removed from active service. Abandoned connections are typically capped or filled. Ref: EPA SDWA.' ;
    rdfs:domain ind:SewerServiceConnection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:activationDate rdf:type rdf:Property ;
    rdfs:label 'Activation Date' ;
    rdfs:comment 'Date when the service connection was activated and began receiving wastewater service. May differ from installation date if there was a delay between construction and service commencement. Ref: EPA SDWA.' ;
    rdfs:domain ind:SewerServiceConnection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:backflowPreventionFlag rdf:type rdf:Property ;
    rdfs:label 'Backflow Prevention Flag' ;
    rdfs:comment 'backflow prevention flag. Ref: EPA SDWA.' ;
    rdfs:domain ind:SewerServiceConnection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:backwaterValveInstalledFlag rdf:type rdf:Property ;
    rdfs:label 'Backwater Valve Installed Flag' ;
    rdfs:comment 'Indicates whether a backwater valve (backflow preventer) is installed on the service lateral to prevent sewage backup into the premise during system surcharge events. Ref: EPA SDWA.' ;
    rdfs:domain ind:SewerServiceConnection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cleanoutAvailableFlag rdf:type rdf:Property ;
    rdfs:label 'Cleanout Available Flag' ;
    rdfs:comment 'Indicates whether a cleanout access point is available on the service lateral for maintenance and inspection purposes. Cleanouts facilitate camera inspection and clearing blockages. Ref: EPA SDWA.' ;
    rdfs:domain ind:SewerServiceConnection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:connectionDate rdf:type rdf:Property ;
    rdfs:label 'Connection Date' ;
    rdfs:comment 'The connection date associated with each sewer service connection record in the wastewater domain.' ;
    rdfs:domain ind:SewerServiceConnection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:connectionNumber rdf:type rdf:Property ;
    rdfs:label 'Connection Number' ;
    rdfs:comment 'connection number. Ref: EPA SDWA.' ;
    rdfs:domain ind:SewerServiceConnection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:connectionType rdf:type rdf:Property ;
    rdfs:label 'Connection Type' ;
    rdfs:comment 'Type of sewer service connection based on conveyance method. Gravity connections rely on slope; grinder pump and ejector pump connections serve properties below the sewer main elevation; low-pressure and vacuum systems are specialized collection methods. Ref: EPA SDWA.' ;
    rdfs:domain ind:SewerServiceConnection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deactivationDate rdf:type rdf:Property ;
    rdfs:label 'Deactivation Date' ;
    rdfs:comment 'Date when the service connection was deactivated or taken out of service, either temporarily or permanently. Ref: EPA SDWA.' ;
    rdfs:domain ind:SewerServiceConnection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:grinderPumpInstallationDate rdf:type rdf:Property ;
    rdfs:label 'Grinder Pump Installation Date' ;
    rdfs:comment 'Date when the grinder pump was installed at this service connection. Used for warranty tracking and lifecycle management. Ref: EPA SDWA.' ;
    rdfs:domain ind:SewerServiceConnection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:grinderPumpManufacturer rdf:type rdf:Property ;
    rdfs:label 'Grinder Pump Manufacturer' ;
    rdfs:comment 'Manufacturer name of the grinder pump installed at this service connection, if applicable. Ref: EPA SDWA.' ;
    rdfs:domain ind:SewerServiceConnection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grinderPumpModel rdf:type rdf:Property ;
    rdfs:label 'Grinder Pump Model' ;
    rdfs:comment 'Model number or designation of the grinder pump installed at this service connection, if applicable. Ref: EPA SDWA.' ;
    rdfs:domain ind:SewerServiceConnection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grinderPumpSerialNumber rdf:type rdf:Property ;
    rdfs:label 'Grinder Pump Serial Number' ;
    rdfs:comment 'Manufacturer serial number of the grinder pump installed at this service connection, if applicable. Used for warranty tracking, maintenance scheduling, and parts ordering. Ref: EPA SDWA.' ;
    rdfs:domain ind:SewerServiceConnection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lateralDiameterInches rdf:type rdf:Property ;
    rdfs:label 'Lateral Diameter Inches' ;
    rdfs:comment 'Internal diameter of the service lateral pipe measured in inches. Typical residential laterals range from 4 to 6 inches; commercial and industrial connections may be larger. Ref: EPA SDWA.' ;
    rdfs:domain ind:SewerServiceConnection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lateralLengthFeet rdf:type rdf:Property ;
    rdfs:label 'Lateral Length Feet' ;
    rdfs:comment 'Total length of the service lateral pipe from the premise connection point to the public sewer main, measured in feet. Used for capacity analysis, maintenance planning, and replacement cost estimation. Ref: EPA SDWA.' ;
    rdfs:domain ind:SewerServiceConnection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lateralMaterial rdf:type rdf:Property ;
    rdfs:label 'Lateral Material' ;
    rdfs:comment 'lateral material. Ref: EPA SDWA.' ;
    rdfs:domain ind:SewerServiceConnection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lateralOwnership rdf:type rdf:Property ;
    rdfs:label 'Lateral Ownership' ;
    rdfs:comment 'lateral ownership. Ref: EPA SDWA.' ;
    rdfs:domain ind:SewerServiceConnection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lateralPipeMaterial rdf:type rdf:Property ;
    rdfs:label 'Lateral Pipe Material' ;
    rdfs:comment 'Material composition of the service lateral pipe. Common materials include PVC (polyvinyl chloride), vitrified clay, cast iron, ductile iron, concrete, Orangeburg (bituminized fiber), ABS (acrylonitrile butadiene styrene), and HDPE (high-density polyethylene). Material affects durability, corrosion resistance, and maintenance needs. [ENUM-REF-CANDIDATE: pvc|vitrified_clay|cast_iron|ductile_iron|concrete|orangeburg|abs|hdpe — 8 candidates stripped; promote to reference product]. Ref: EPA SDWA.' ;
    rdfs:domain ind:SewerServiceConnection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:parcelIdentifier rdf:type rdf:Property ;
    rdfs:label 'Parcel Identifier' ;
    rdfs:comment 'Tax parcel number or assessor parcel number (APN) for the property served by this connection. Used for cross-referencing with municipal tax and GIS records. Ref: EPA SDWA.' ;
    rdfs:domain ind:SewerServiceConnection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceConnectionNumber rdf:type rdf:Property ;
    rdfs:label 'Service Connection Number' ;
    rdfs:comment 'Business identifier for the sewer service connection, typically used in field operations, customer service, and billing. May follow utility-specific numbering conventions. Ref: EPA SDWA.' ;
    rdfs:domain ind:SewerServiceConnection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceStatus rdf:type rdf:Property ;
    rdfs:label 'Service Status' ;
    rdfs:comment 'Current operational status of the sewer service connection. Active connections are in use; inactive connections are temporarily out of service; abandoned connections are permanently closed; capped connections are physically sealed; pending activation connections are installed but not yet in service. Ref: EPA SDWA.' ;
    rdfs:domain ind:SewerServiceConnection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:amiCompatibleFlag rdf:type rdf:Property ;
    rdfs:label 'Ami Compatible Flag' ;
    rdfs:comment 'The ami compatible flag value recorded for each metering meter in the metering domain.' ;
    rdfs:domain ind:Meter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cumulativeVolumeGallons rdf:type rdf:Property ;
    rdfs:label 'Cumulative Volume Gallons' ;
    rdfs:comment 'The cumulative volume gallons value recorded for each metering meter in the metering domain.' ;
    rdfs:domain ind:Meter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:firmwareVersion rdf:type rdf:Property ;
    rdfs:label 'Firmware Version' ;
    rdfs:comment 'The firmware version value recorded for each metering meter in the metering domain.' ;
    rdfs:domain ind:Metering ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastTestAccuracyPct rdf:type rdf:Property ;
    rdfs:label 'Last Test Accuracy Pct' ;
    rdfs:comment 'The last test accuracy pct value recorded for each metering meter in the metering domain.' ;
    rdfs:domain ind:Meter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lastTestDate rdf:type rdf:Property ;
    rdfs:label 'Last Test Date' ;
    rdfs:comment 'The last test date associated with each metering meter record in the metering domain.' ;
    rdfs:domain ind:Meter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:manufactureDate rdf:type rdf:Property ;
    rdfs:label 'Manufacture Date' ;
    rdfs:comment 'The manufacture date associated with each metering meter record in the metering domain.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:maxFlowRateGpm rdf:type rdf:Property ;
    rdfs:label 'Max Flow Rate Gpm' ;
    rdfs:comment 'The max flow rate gpm value recorded for each metering meter in the metering domain.' ;
    rdfs:domain ind:Meter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:meterNumber rdf:type rdf:Property ;
    rdfs:label 'Meter Number' ;
    rdfs:comment 'The meter number value recorded for each metering meter in the metering domain.' ;
    rdfs:domain ind:Meter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:meterType rdf:type rdf:Property ;
    rdfs:label 'Meter Type' ;
    rdfs:comment 'The meter type value recorded for each metering meter in the metering domain.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:model rdf:type rdf:Property ;
    rdfs:label 'Model' ;
    rdfs:comment 'The model value recorded for each metering meter in the metering domain.' ;
    rdfs:domain ind:Meter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:numberOfDials rdf:type rdf:Property ;
    rdfs:label 'Number Of Dials' ;
    rdfs:comment 'The number of dials value recorded for each metering meter in the metering domain.' ;
    rdfs:domain ind:Meter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:pitCondition rdf:type rdf:Property ;
    rdfs:label 'Pit Condition' ;
    rdfs:comment 'The pit condition value recorded for each metering meter in the metering domain.' ;
    rdfs:domain ind:Meter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:purchaseDate rdf:type rdf:Property ;
    rdfs:label 'Purchase Date' ;
    rdfs:comment 'The purchase date associated with each metering meter record in the metering domain.' ;
    rdfs:domain ind:Meter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:registerMultiplier rdf:type rdf:Property ;
    rdfs:label 'Register Multiplier' ;
    rdfs:comment 'The register multiplier value recorded for each metering meter in the metering domain.' ;
    rdfs:domain ind:Meter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:registerType rdf:type rdf:Property ;
    rdfs:label 'Register Type' ;
