ind:PharmacogenomicsResult rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Genomics ;
    rdfs:label 'Pharmacogenomics Result' ;
    rdfs:comment '' .

ind:PsychiatricAssessment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:BehavioralHealth ;
    rdfs:label 'Psychiatric Assessment' ;
    rdfs:comment 'PHQ-9, GAD-7, C-SSRS scoring' .

ind:SudEpisode rdf:type rdfs:Class ;
    rdfs:subClassOf ind:BehavioralHealth ;
    rdfs:label 'Sud Episode' ;
    rdfs:comment 'Substance use disorder episode of care' .

ind:MatTreatment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:BehavioralHealth ;
    rdfs:label 'Mat Treatment' ;
    rdfs:comment 'Medication-assisted treatment (buprenorphine/methadone/naltrexone)' .

ind:OtpEnrollment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:BehavioralHealth ;
    rdfs:label 'Otp Enrollment' ;
    rdfs:comment 'Opioid treatment program enrollment' .

ind:CrisisEpisode rdf:type rdfs:Class ;
    rdfs:subClassOf ind:BehavioralHealth ;
    rdfs:label 'Crisis Episode' ;
