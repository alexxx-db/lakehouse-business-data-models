    rdfs:comment 'Latest timestamp when the predicted failure is expected to occur.' ;
    rdfs:domain ind:PredictiveMaintenanceAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:predictedFailureStart rdf:type rdf:Property ;
    rdfs:label 'Predicted Failure Start' ;
    rdfs:comment 'Earliest timestamp when the predicted failure is expected to occur.' ;
    rdfs:domain ind:PredictiveMaintenanceAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:recommendedServiceAction rdf:type rdf:Property ;
    rdfs:label 'Recommended Service Action' ;
    rdfs:comment 'Prescribed maintenance or repair action to address the predicted issue.' ;
    rdfs:domain ind:PredictiveMaintenanceAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resolutionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Resolution Timestamp' ;
    rdfs:comment 'Timestamp when the alert was marked resolved or closed.' ;
    rdfs:domain ind:PredictiveMaintenanceAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:temperatureCelsius rdf:type rdf:Property ;
    rdfs:label 'Temperature Celsius' ;
    rdfs:comment 'Ambient temperature recorded by the vehicle sensor when the alert was generated.' ;
    rdfs:domain ind:PredictiveMaintenanceAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:inspectionCharacteristicId rdf:type rdf:Property ;
    rdfs:label 'Inspection Characteristic Id' ;
    rdfs:comment 'Primary key for the inspection characteristic association record.' ;
    rdfs:domain ind:InspectionCharacteristic ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .
