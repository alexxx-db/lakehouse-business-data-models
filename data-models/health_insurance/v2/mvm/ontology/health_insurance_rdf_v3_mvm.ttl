ind:groupPlanOfferingId rdf:type rdf:Property ;
    rdfs:label 'Group Plan Offering Id' ;
    rdfs:comment 'Foreign key linking to employer.group_plan_offering. Business justification: A member policy is created from a specific employer group plan offering — the exact product selected during open enrollment. This link drives renewal processing, ACA affordability determination, emplo' ;
    rdfs:domain ind:HealthInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GroupPlanOffering .

ind:parentPolicyId rdf:type rdf:Property ;
