  Note: 'Comprehensive employee performance management, talent development, and conduct records. Captures performance evaluation cycles (annual, mid-year, probationary), overall ratings, goal achievement, competency ratings, manager feedback, self-assessments, development goals, and review completion status. Includes talent profile data: education history, skills inventory, career interests, mobility preferences, mentorship participation, succession plan inclusion, and high-potential designation. Encompasses progressive discipline records: verbal/written warnings, performance improvement plans (PIPs), suspensions, terminations for cause, policy violations, appeal status, and resolution outcomes. Supports merit increases, promotion eligibility, internal mobility, succession management, workforce planning, and HR compliance documentation. SSOT for all employee performance, talent, and disciplinary data. Sourced from Workday HCM Talent Management.'
}

Table workforce.recruitment {
  recruitment_id varchar [pk, note: 'Unique identifier for the recruitment record']
  applicant_id varchar [note: 'FK to the applicant record']
  care_site_id varchar [note: 'FK to the hiring facility']
  job_profile_id varchar [note: 'FK to the job profile being recruited for']
  position_id varchar [note: 'FK to the position being filled']
  primary_recruitment_employee_id varchar [note: 'FK to the recruiter employee']
  recruitment_hiring_manager_employee_id varchar
  workforce_org_unit_id varchar [note: 'FK to the organizational unit with the opening']
  actual_start_date date [note: 'Actual start date of the new hire']
  applicant_count varchar
  applicant_email varchar [note: 'Email address of the applicant']
  applicant_phone varchar [note: 'Phone number of the applicant']
  application_date date [note: 'Date the application was submitted']
  background_check_date date [note: 'Date background check was completed']
  background_check_status varchar [note: 'Status of background check (pending, clear, flagged)']
  badge_issued boolean [note: 'Whether employee badge has been issued']
  close_date date
  cost_per_hire decimal(10,2) [note: 'Total recruitment cost for this hire']
  created_timestamp timestamp [note: 'Timestamp when the recruitment record was created']
  credentialing_initiated boolean [note: 'Whether credentialing process has been initiated for clinical hires']
  drug_screen_status varchar [note: 'Status of pre-employment drug screening']
  employment_type varchar [note: 'Type of employment (full-time, part-time, PRN)']
  fire_safety_training_completed boolean [note: 'Whether fire safety training is completed']
  fte_value decimal(5,2) [note: 'FTE value of the position being recruited']
  hipaa_training_completed boolean [note: 'Whether HIPAA privacy training is completed']
  hire_date date [note: 'Official hire date']
  hire_decision varchar [note: 'Final hiring decision (hire, no-hire, hold)']
  i9_completion_date date [note: 'Date I-9 employment verification was completed']
  i9_verification_status varchar [note: 'Status of I-9 employment eligibility verification']
  infection_control_training_completed boolean [note: 'Whether infection control training is completed']
  interview_count varchar
  interview_date date [note: 'Date of the most recent interview']
  interview_stage varchar [note: 'Current interview stage (phone screen, panel, peer)']
  is_clinical_position boolean [note: 'Whether the position is a clinical role']
  license_verified boolean [note: 'Whether professional license has been verified']
  mutator_applied_flag boolean [note: 'Flag set by mutator to indicate modification']
  number_of_openings varchar
  offer_accepted_date date [note: 'Date the offer was accepted']
  offer_count varchar
  offer_date date [note: 'Date the employment offer was extended']
  offer_status varchar [note: 'Status of the offer (pending, accepted, declined, rescinded)']
  offered_salary decimal(12,2) [note: 'Annual salary or hourly rate offered']
  oig_exclusion_checked boolean [note: 'Whether OIG exclusion list was checked']
  onboarding_completion_date date [note: 'Date all onboarding tasks were completed']
  onboarding_status varchar [note: 'Overall onboarding status (not started, in progress, complete)']
  onboarding_target_completion_date date [note: 'Target date for onboarding completion']
  open_date date
  orientation_completion_date date [note: 'Date orientation was completed']
  orientation_status varchar [note: 'Status of new employee orientation']
  pay_grade varchar [note: 'Pay grade level for the position']
  pipeline_stage varchar [note: 'Current stage in the recruitment pipeline']
  policy_acknowledgment_completed boolean [note: 'Whether all policy acknowledgments are signed']
  posting_date date [note: 'Date the job was posted externally']
  recruiter_name varchar
  reference_check_status varchar [note: 'Status of professional reference checks']
  relocation_assistance_amount decimal(10,2) [note: 'Relocation assistance amount offered']
  required_license_type varchar [note: 'Professional license type required for the role']
  requisition_number varchar [note: 'Unique requisition number for the job opening']
  requisition_open_date date [note: 'Date the requisition was opened']
  requisition_status varchar [note: 'Status of the requisition (open, filled, cancelled)']
  signing_bonus_amount decimal(10,2) [note: 'Signing bonus amount offered']
  source_channel varchar
  source_of_hire varchar [note: 'Recruitment source (job board, referral, agency, internal)']
  system_access_provisioned boolean [note: 'Whether IT system access has been provisioned']
  target_fill_date date
  target_start_date date [note: 'Target start date for the new hire']
  time_to_fill_days varchar [note: 'Number of days from requisition open to hire']
  updated_timestamp timestamp [note: 'Timestamp of last update to the recruitment record']
  vibe_mutation_marker varchar [note: 'Added by VIBE mutator to ensure a change']
  vibe_structure_marker varchar [note: 'Structure enforcement marker for 22-domain/541-product superset.']
  workday_candidate_code varchar [note: 'Candidate identifier in Workday HRIS']

  Note: 'End-to-end recruitment and onboarding lifecycle from job requisition through productive employee. Captures requisition details, posting channels, applicant pipeline, interview stages, offer details, background check status, pre-employment screening results, and hire decision. Includes complete onboarding process: I-9 verification, orientation attendance, policy acknowledgments, system access provisioning, required training completions (HIPAA, infection control, fire safety), badge issuance, department-specific orientation, onboarding start date, target completion date, and task-level completion status. Tracks time-to-fill, source of hire, cost per hire, recruiter assignment. Links to authorized positions for headcount control. SSOT for all hiring and onboarding data. Sourced from Workday HCM Recruiting.'
}

