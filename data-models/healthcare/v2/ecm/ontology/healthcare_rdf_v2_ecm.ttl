    rdfs:range xsd:string .

ind:recallScope rdf:type rdf:Property ;
    rdfs:label 'Recall Scope' ;
    rdfs:comment 'Distribution level to which the recall extends: consumer (patient), retail (pharmacy), or wholesale (distributor).' ;
