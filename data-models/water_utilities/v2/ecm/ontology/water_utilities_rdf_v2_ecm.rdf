ind:containerType rdf:type rdf:Property ;
    rdfs:label 'Container Type' ;
    rdfs:comment 'Type of sample container used (e.g., glass bottle, plastic bottle, sterile bag). Must be appropriate for the analytes being tested and comply with EPA protocols.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:containerVolumeMl rdf:type rdf:Property ;
    rdfs:label 'Container Volume Ml' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waterSampleDescription rdf:type rdf:Property ;
    rdfs:label 'Water Sample Description' ;
    rdfs:domain ind:WaterSample ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fieldChlorineResidualMgL rdf:type rdf:Property ;
    rdfs:label 'Field Chlorine Residual Mg L' ;
