  investigational_trainer_employee_id varchar [note: 'Employee who provided training']
  research_study_id varchar [note: 'Research study associated with this training requirement.']
  study_site_id varchar
  training_id varchar
  accountability_certified boolean [note: 'Whether trainee is certified for accountability procedures']
  administration_competency_verified boolean
  assessment_score decimal(5,2) [note: 'Score achieved on the post-training competency assessment.']
  attempt_number varchar [note: 'Added to expand thin product research.investigational_product_training']
  certificate_number varchar [note: 'Added to expand thin product research.investigational_product_training']
  certificate_reference varchar
  certification_authority varchar
  certification_number varchar
  competency_assessment_passed boolean [note: 'Whether trainee passed competency assessment']
  competency_assessment_score decimal(5,2) [note: 'Score on competency assessment']
  completion_date date
  completion_flag boolean
  completion_status varchar
  created_timestamp timestamp
  delegation_log_reference varchar [note: 'Added to expand thin product with domain-appropriate detail.']
  dispensation_certified boolean [note: 'Whether trainee is certified for dispensation']
  effective_date date
  expiration_date date
  extra_attr_1 varchar
  extra_attr_2 varchar
  extra_attr_3 varchar
  extra_attr_4 varchar
  extra_attr_5 varchar
  gcp_certified_flag boolean [note: 'Added to expand thin product with domain-appropriate detail.']
  handling_certification_date date
  investigational_product_training_status varchar
  last_modified_timestamp timestamp
  mutator_applied_flag boolean
  pass_flag boolean [note: 'Added to expand thin product research.investigational_product_training']
  passing_score_required decimal(5,2) [note: 'Minimum passing score required']
  passing_score_threshold decimal(5,2) [note: 'Minimum score required to pass the competency assessment.']
  product_specific_training_status varchar
  protocol_version varchar
  recertification_due_date date
  record_notes varchar
  regulatory_requirement varchar [note: 'Regulatory requirement mandating training (FDA, ICH-GCP, protocol)']
  retraining_required_flag boolean [note: 'Added to expand thin product with domain-appropriate detail.']
  score decimal(5,2) [note: 'Added to expand thin product research.investigational_product_training']
  storage_handling_certified boolean [note: 'Indicates certification for storage and handling']
  storage_handling_certified_flag boolean [note: 'Indicates whether the trainee is certified for IP storage and handling.']
  training_completion_percentage decimal(5,2) [note: 'Added to expand thin product with domain-appropriate detail.']
  training_date date
  training_duration_hours decimal(5,2) [note: 'Duration of training in hours']
  training_duration_minutes varchar [note: 'Duration of the training session in minutes.']
  training_materials_version varchar [note: 'Version of training materials used']
  training_method varchar [note: 'Method of training delivery (e.g., in-person, online, simulation).']
  training_module_code varchar [note: 'Added to expand thin product research.investigational_product_training']
  training_notes varchar
  training_outcome varchar [note: 'Added to expand thin product with domain-appropriate detail.']
  training_status varchar
  training_topic varchar
  training_type varchar
  training_version varchar
  updated_timestamp timestamp [note: 'Record last update timestamp']
  vibe_expanded_flag boolean [note: 'Flag added by VIBE batch to expand thin product attribute set.']
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutation to ensure change']
  vibe_mutation_marker varchar [note: 'Marker added by VIBE mutator to ensure change']
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']

  Note: 'This association product represents the training certification relationship between investigational products and compliance training programs. It captures product-specific training requirements, competency verification, and certification status for staff handling investigational products in clinical trials. Each record links one investigational product to one training program with attributes tracking certification dates, competency verification, training version compliance, and recertification schedules specific to that product-training combination.. Existence Justification: In clinical trial operations, investigational products require multiple types of training (handling hazardous materials, administering complex dosage forms, storage/temperature monitoring, controlled substance protocols), and each training program applies to multiple investigational products with similar characteristics. The business actively manages product-specific training certifications as operational records, tracking which staff are certified to handle which products, with certification dates, competency verification, and recertification schedules that exist only in the context of each product-training combination.'
}

