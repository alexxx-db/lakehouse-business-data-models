    rdfs:range xsd:string .

ind:depositType rdf:type rdf:Property ;
    rdfs:label 'Deposit Type' ;
    rdfs:comment 'Type of deposit (new_service, credit_risk, construction)' ;
    rdfs:domain ind:Deposit ;
    rdf:type owl:DatatypeProperty ;
