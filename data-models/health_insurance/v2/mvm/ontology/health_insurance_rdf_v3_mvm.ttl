    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clinicalRationale rdf:type rdf:Property ;
    rdfs:label 'Clinical Rationale' ;
    rdfs:comment 'Free-text explanation of the clinical reasoning behind the decision.' ;
