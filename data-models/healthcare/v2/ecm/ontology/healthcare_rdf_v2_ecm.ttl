    rdfs:domain ind:PharmacyLocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dispensingCapabilityNonSterile rdf:type rdf:Property ;
    rdfs:label 'Dispensing Capability Non Sterile' ;
