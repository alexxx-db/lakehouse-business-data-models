  employee_id varchar [note: 'Requesting employee.']
  franchisee_id varchar [note: 'Franchisee if applicable.']
  primary_requisition_approved_by_employee_id varchar [note: 'Alternative approver reference.']
  requisition_restaurant_unit_id varchar [note: 'Restaurant unit requesting.']
  requisition_unit_id varchar [note: 'Unit reference.']
  stock_item_id varchar [note: 'Stock item being requested.']
  tertiary_requisition_employee_id varchar [note: 'Employee associated with requisition.']
  approval_status varchar [note: 'Current approval status.']
  approved_timestamp timestamp [note: 'When the requisition was approved.']
  budget_code decimal(18,2) [note: 'Budget code for the requisition.']
  compliance_flag boolean [note: 'Whether the requisition is compliant.']
  compliance_notes varchar [note: 'Notes on compliance.']
  created_timestamp timestamp [note: 'Record creation timestamp.']
  currency_code varchar [note: 'Currency for the requisition.']
  delivery_method varchar [note: 'Preferred delivery method.']
  discount_estimate decimal(18,2) [note: 'Estimated discount.']
  expected_delivery_date date [note: 'Expected delivery date.']
  justification_text varchar [note: 'Business justification.']
  line_item_count varchar [note: 'Number of line items.']
  net_estimated_amount decimal(18,2) [note: 'Net estimated amount.']
  payment_terms decimal(18,2) [note: 'Payment terms.']
  priority_level varchar [note: 'Priority level of the requisition.']
  procurement_method varchar [note: 'Method of procurement.']
  required_by_date date [note: 'Date by which items are needed.']
  requisition_number varchar [note: 'Unique requisition number.']
  requisition_status varchar [note: 'Current status.']
  spend_category_code decimal(18,2) [note: 'Spend category code.']
  supplier_preference varchar [note: 'Preferred supplier if any.']
  tax_estimate decimal(18,2) [note: 'Estimated tax amount.']
  tax_exempt_flag boolean [note: 'Whether the requisition is tax exempt.']
  tax_exempt_reason decimal(18,2) [note: 'Reason for tax exemption.']
  total_estimated_amount decimal(18,2) [note: 'Total estimated amount.']
  updated_timestamp timestamp [note: 'Record last update timestamp.']
  urgency_flag boolean [note: 'Whether the requisition is urgent.']

  Note: 'Purchase requisitions initiated by restaurant units or departments requesting goods or services.'
}

Table procurement.procurement_purchase_order {
  procurement_purchase_order_id varchar [pk, note: 'Primary key for the purchase order.']
  contract_id varchar [note: 'Associated contract.']
