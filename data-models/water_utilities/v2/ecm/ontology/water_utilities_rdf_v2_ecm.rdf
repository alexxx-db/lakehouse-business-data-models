    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sampleMatrix rdf:type rdf:Property ;
    rdfs:label 'Sample Matrix' ;
    rdfs:comment 'The physical medium or matrix of the sample collected (drinking water, raw water, wastewater, effluent, sludge, biosolids). Determines applicable analytical methods and regulatory thresholds.' ;
