    rdfs:comment 'Reference code for the notification/message template applied when formatting the distributed report.' ;
    rdfs:domain ind:DistributionRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modalityScope rdf:type rdf:Property ;
    rdfs:label 'Modality Scope' ;
