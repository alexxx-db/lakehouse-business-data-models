    rdfs:range xsd:date .

ind:recallReason rdf:type rdf:Property ;
    rdfs:label 'Recall Reason' ;
    rdfs:comment 'Detailed explanation of the reason for the recall, including defect type, contamination, labeling error, or other safety concern.' ;
