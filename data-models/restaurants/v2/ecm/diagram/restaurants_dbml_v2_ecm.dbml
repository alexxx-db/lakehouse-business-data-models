  Note: 'Invoices received from suppliers for goods and services delivered.'
}

Table procurement.supplier_scorecard {
  supplier_scorecard_id decimal(10,2) [pk, note: 'Primary key for the scorecard.']
  evaluator_employee_id varchar [note: 'Employee who performed the evaluation.']
  procurement_supplier_id varchar [note: 'Supplier being evaluated.']
  average_lead_time_days decimal(5,2) [note: 'Average lead time during the period.']
  comments varchar [note: 'Evaluator comments.']
  compliance_status varchar [note: 'Compliance status during the period.']
  contract_number varchar [note: 'Associated contract number.']
  corrective_action_count varchar [note: 'Number of corrective actions issued.']
  cost_savings_percent decimal(5,2) [note: 'Cost savings achieved.']
  evaluation_period_end date [note: 'End of evaluation period.']
  evaluation_period_start date [note: 'Start of evaluation period.']
  evaluation_timestamp timestamp [note: 'When the evaluation was performed.']
  evaluator_department varchar [note: 'Department of the evaluator.']
  fill_rate decimal(5,2) [note: 'Order fill rate percentage.']
  invoice_accuracy_rate decimal(5,2) [note: 'Invoice accuracy rate.']
  next_review_due_date date [note: 'When next review is due.']
  on_time_delivery_rate decimal(5,2) [note: 'On-time delivery percentage.']
  overall_score decimal(5,2) [note: 'Overall scorecard score.']
  quality_rejection_rate decimal(5,2) [note: 'Quality rejection rate.']
  record_created timestamp [note: 'Record creation timestamp.']
  record_updated timestamp [note: 'Record update timestamp.']
  region varchar [note: 'Geographic region.']
  responsiveness_score decimal(5,2) [note: 'Supplier responsiveness score.']
  risk_level varchar [note: 'Risk level assessment.']
  scorecard_number decimal(10,2) [note: 'Unique scorecard reference.']
  scorecard_version decimal(10,2) [note: 'Version of the scorecard template.']
  supplier_category varchar [note: 'Category of the supplier.']
  supplier_scorecard_status decimal(10,2) [note: 'Status of the scorecard.']
  sustainability_score decimal(5,2) [note: 'Sustainability performance score.']

  Note: 'Periodic supplier performance scorecards measuring delivery, quality, cost, and compliance metrics.'
}

Table procurement.supplier_risk {
  supplier_risk_id varchar [pk, note: 'Primary key for the risk assessment.']
  procurement_supplier_id varchar [note: 'Supplier being assessed.']
  assessment_timestamp timestamp [note: 'When the assessment was performed.']
  compliance_fda_flag boolean [note: 'Whether supplier is FDA compliant.']
  compliance_osha_flag boolean [note: 'Whether supplier is OSHA compliant.']
  created_timestamp timestamp [note: 'Record creation timestamp.']
  dependency_percentage decimal(5,2) [note: 'Percentage of supply dependent on this supplier.']
  financial_stability_score decimal(5,2) [note: 'Financial stability score.']
  geographic_region varchar [note: 'Geographic region of the supplier.']
  mitigation_plan varchar [note: 'Risk mitigation plan.']
  next_review_date date [note: 'Next scheduled review date.']
  review_frequency_days varchar [note: 'How often the risk is reviewed.']
  risk_category varchar [note: 'Category of risk.']
  risk_description varchar [note: 'Description of the risk.']
  risk_factor_details decimal(18,6) [note: 'Detailed risk factor value.']
  risk_score decimal(5,2) [note: 'Calculated risk score.']
  risk_status varchar [note: 'Current risk status.']
  risk_tier varchar [note: 'Risk tier classification.']
  single_source_dependency boolean [note: 'Whether this is a single-source dependency.']
  supplier_financial_rating varchar [note: 'Supplier financial rating.']
  supplier_primary_contact varchar [note: 'Primary contact for risk matters.']
  updated_timestamp timestamp [note: 'Record last update timestamp.']

  Note: 'Risk assessments for suppliers covering financial, operational, compliance, and geographic risks.'
}

Table procurement.item_specification {
  item_specification_id varchar [pk, note: 'Primary key for the item specification.']
  category_id varchar [note: 'Category this item belongs to.']
  allergen_declaration decimal(9,4) [note: 'Allergen declaration code.']
