    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fieldConductivityUsCm rdf:type rdf:Property ;
    rdfs:label 'Field Conductivity Us Cm' ;
    rdfs:comment 'Electrical conductivity measured at the time of collection in microsiemens per centimeter. Indicates total dissolved solids and water mineralization.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fieldDissolvedOxygenMgL rdf:type rdf:Property ;
    rdfs:label 'Field Dissolved Oxygen Mg L' ;
    rdfs:comment 'Dissolved oxygen concentration measured at the time of collection in mg/L. Important for wastewater treatment process control and environmental discharge monitoring.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fieldPh rdf:type rdf:Property ;
    rdfs:label 'Field Ph' ;
    rdfs:comment 'pH level measured at the time of collection. Indicates acidity or alkalinity of the water sample. Required field measurement for many regulatory programs.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fieldTemperatureC rdf:type rdf:Property ;
    rdfs:label 'Field Temperature C' ;
    rdfs:comment 'Water temperature measured at the time of collection in degrees Celsius. Critical field parameter for sample integrity and regulatory compliance.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fieldTurbidityNtu rdf:type rdf:Property ;
    rdfs:label 'Field Turbidity Ntu' ;
    rdfs:comment 'Turbidity measured at the time of collection in NTU. Key indicator of water clarity and treatment effectiveness, with strict regulatory limits for drinking water.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:holdTimeHours rdf:type rdf:Property ;
    rdfs:label 'Hold Time Hours' ;
    rdfs:domain ind:Quality ;
