  critical_control_point_code varchar [note: 'Unique code for the CCP']
  critical_control_point_name varchar [note: 'Name of the critical control point']
  critical_control_point_status varchar [note: 'Current status of the CCP']
  critical_limit_max decimal(10,2) [note: 'Maximum critical limit value']
  critical_limit_min decimal(10,2) [note: 'Minimum critical limit value']
  deviation_count varchar [note: 'Number of deviations recorded']
  effective_end_date date [note: 'End date of CCP effectiveness']
  effective_start_date date [note: 'Start date of CCP effectiveness']
  haccp_plan_version varchar [note: 'Version of the parent HACCP plan']
  hazard_type varchar [note: 'Type of hazard (biological, chemical, physical)']
  is_critical boolean [note: 'Whether this is a critical point']
  last_monitored_timestamp timestamp [note: 'Timestamp of last monitoring']
  last_verification_timestamp timestamp [note: 'Timestamp of last verification']
  monitoring_frequency varchar [note: 'How often monitoring occurs']
  monitoring_method varchar [note: 'Method used for monitoring']
  notes varchar [note: 'Additional notes']
  process_step varchar [note: 'Process step where CCP applies']
  regulatory_reference varchar [note: 'Regulatory reference for this CCP']
  responsible_role varchar [note: 'Role responsible for monitoring']
  unit_of_measure varchar [note: 'Unit of measure for critical limits']
  updated_timestamp timestamp [note: 'Record last updated timestamp']
  verification_frequency varchar [note: 'How often verification occurs']
  verification_method varchar [note: 'Method used for verification']

  Note: 'Critical control points within HACCP plans where hazards can be prevented or eliminated'
}

