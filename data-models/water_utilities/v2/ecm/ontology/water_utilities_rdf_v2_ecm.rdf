    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ecologicalRiskFlag rdf:type rdf:Property ;
    rdfs:label 'Ecological Risk Flag' ;
    rdfs:comment 'Indicates ecological risk pathway present' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exposurePathwayRiskType rdf:type rdf:Property ;
    rdfs:label 'Exposure Pathway Risk Type' ;
    rdfs:comment 'Type of exposure pathway risk (human_health, ecological, combined) as classified in the ontology.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
