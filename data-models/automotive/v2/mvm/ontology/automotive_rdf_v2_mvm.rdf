ind:tirePressureFrontRightPsi rdf:type rdf:Property ;
    rdfs:label 'Tire Pressure Front Right Psi' ;
    rdfs:comment 'Air pressure of the front-right tire measured in pounds per square inch.' ;
    rdfs:domain ind:TelemetryEvent ;
    rdf:type owl:DatatypeProperty ;
