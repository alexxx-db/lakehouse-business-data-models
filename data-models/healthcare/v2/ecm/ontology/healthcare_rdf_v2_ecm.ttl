    rdfs:comment 'The date when the next scheduled activity is due to be generated from this recurring schedule.' ;
    rdfs:domain ind:RecurringSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:occurrenceCount rdf:type rdf:Property ;
    rdfs:label 'Occurrence Count' ;
    rdfs:comment 'The total number of times activities have been generated from this recurring schedule since its inception.' ;
    rdfs:domain ind:RecurringSchedule ;
    rdf:type owl:DatatypeProperty ;
