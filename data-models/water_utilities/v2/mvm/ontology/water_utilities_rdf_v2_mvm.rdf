ind:testMethod rdf:type rdf:Property ;
    rdfs:label 'Test Method' ;
    rdfs:comment 'AWWA M6, OIML R49' ;
    rdfs:domain ind:AccuracyTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:testNotes rdf:type rdf:Property ;
    rdfs:label 'Test Notes' ;
    rdfs:comment 'The test notes value recorded for each accuracy test in the metering domain.' ;
    rdfs:domain ind:AccuracyTest ;
    rdf:type owl:DatatypeProperty ;
