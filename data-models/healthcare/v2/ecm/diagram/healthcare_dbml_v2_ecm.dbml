  osha_safety_program_id varchar [note: 'OSHA safety program governing study operations']
  payer_id varchar [note: 'Primary payer for study billing']
  primary_diagnosis_icd_code_id varchar [note: 'Primary diagnosis ICD code for study population']
  primary_procedure_cpt_code_id varchar [note: 'Primary procedure CPT code for study interventions']
