  enrollment_number varchar [note: 'Enrollment number']
  enrollment_scope varchar
  enrollment_source varchar [note: 'Enrollment source']
  enrollment_status varchar [note: 'Enrollment status']
  enrollment_type varchar [note: 'Enrollment type']
  group_npi varchar [note: 'Group NPI']
  license_state varchar [note: 'License state']
  medicaid_provider_number varchar [note: 'Medicaid provider number']
  network_status varchar [note: 'Network status']
  notes varchar [note: 'Notes']
  oig_exclusion_check_date date [note: 'OIG exclusion check date']
  oig_exclusion_checked boolean [note: 'OIG exclusion checked']
  pay_to_address_line1 varchar [note: 'Pay to address line 1']
  payer_plan_name varchar [note: 'Payer plan name']
  payer_type varchar [note: 'Payer type']
  provider_number varchar
  provider_payer_enrollment_status varchar
  provider_type varchar [note: 'Provider type']
  ptan varchar [note: 'PTAN']
  revalidation_due_date date [note: 'Revalidation due date']
  sam_exclusion_checked boolean [note: 'SAM exclusion checked']
  service_address_line1 varchar [note: 'Service address line 1']
  service_city varchar [note: 'Service city']
  service_state varchar [note: 'Service state']
  service_zip_code varchar [note: 'Service zip code']
  ssot_canonical_reference varchar [note: 'SSOT canonical: insurance.insurance_payer_enrollment (duplicate reconciled to canonical)']
  state_license_number varchar [note: 'State license number']
  tax_identification_number varchar [note: 'TIN']
  termination_date date [note: 'Termination date']
  termination_reason varchar [note: 'Termination reason']
  updated_timestamp timestamp [note: 'Record update timestamp']
  vibe_structure_marker varchar

  Note: 'Provider enrollment with payers (Medicare, Medicaid, commercial plans)'
}

Table provider.provider_network_participation {
  provider_network_participation_id varchar [pk, note: 'Primary key']
  clinician_id varchar
  network_participation_id varchar
  org_provider_id varchar
  provider_network_id varchar
  consolidated_target varchar
  created_timestamp timestamp
  effective_date date
  participant_type varchar [note: 'participant_type=provider']
  participation_status varchar
  provider_network_participation_status varchar
  ssot_canonical_reference varchar [note: 'SSOT canonical: insurance.network_participation (consolidated network_participation participant_type=provider)']
  ssot_consolidation_note varchar
  termination_date date
  updated_timestamp timestamp
  vibe_structure_marker varchar

  Note: 'DEPRECATED - consolidate into insurance.network_participation (participant_type=\'provider\'). Retained for backward compatibility. Consolidated into insurance.network_participation (participant_type=\'provider\').'
}

