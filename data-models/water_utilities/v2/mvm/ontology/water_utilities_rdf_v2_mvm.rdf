ind:shutoffEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Shutoff Eligible Flag' ;
    rdfs:comment 'The shutoff eligible flag value recorded for each customer account in the customer domain.' ;
    rdfs:domain ind:CustomerAccount ;
    rdf:type owl:DatatypeProperty ;
