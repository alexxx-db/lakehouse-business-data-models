    rdfs:domain ind:Policy ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Policy .

ind:rateId rdf:type rdf:Property ;
    rdfs:label 'Rate Id' ;
    rdfs:comment 'Foreign key linking to plan.rate. Business justification: A policy\'s premium is calculated from a specific rate record. Linking policy to rate enables premium reconciliation, rate change impact analysis, and actuarial audits. The denormalized premium_amount/' ;
    rdfs:domain ind:HealthInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Rate .

ind:yearId rdf:type rdf:Property ;
    rdfs:label 'Year Id' ;
    rdfs:comment 'Foreign key linking to plan.year. Business justification: Policies align to plan years for accumulator resets, ACA MLR reporting, and renewal processing. The plan year governs deductible reset dates and open enrollment eligibility. A domain expert would expe' ;
    rdfs:domain ind:HealthInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Year .

ind:coverageLimitAmount rdf:type rdf:Property ;
    rdfs:label 'Coverage Limit Amount' ;
