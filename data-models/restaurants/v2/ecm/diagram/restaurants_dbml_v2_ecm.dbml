Table order.guest_order {
  guest_order_id varchar [pk, note: 'Primary key for the guest order.']
  campaign_id varchar [note: 'FK to marketing campaign associated with this order.']
  channel_id varchar [note: 'FK to the order channel.']
  cost_center_id varchar [note: 'FK to finance cost center.']
  coupon_id varchar [note: 'FK to marketing coupon applied.']
  franchisee_id varchar [note: 'FK to franchisee operating the unit.']
  guest_profile_id varchar [note: 'FK to guest profile (alternate).']
  illness_report_id varchar [note: 'FK to food safety illness report if applicable.']
  local_store_marketing_id varchar [note: 'FK to local store marketing effort.']
  loyalty_member_id varchar [note: 'FK to loyalty member.']
  loyalty_program_id varchar [note: 'FK to loyalty program.']
  marketing_guest_segment_id varchar [note: 'FK to marketing guest segment.']
  menu_id varchar [note: 'FK to menu active at time of order.']
  primary_guest_profile_id varchar [note: 'FK to guest profile.']
  promotion_id varchar [note: 'FK to promotion applied.']
  server_employee_id varchar [note: 'FK to employee who served the order.']
  site_id varchar [note: 'FK to real estate site.']
  unit_id varchar [note: 'FK to restaurant unit.']
  cancelled_at timestamp [note: 'Timestamp when order was cancelled.']
  created_at timestamp [note: 'Timestamp when order record was created.']
  currency_code varchar [note: 'ISO currency code for the order.']
  daypart varchar [note: 'Daypart during which order was placed.']
  delivery_address_line1 varchar [note: 'First line of delivery address.']
  delivery_postal_code varchar [note: 'Postal code for delivery.']
  delivery_provider varchar [note: 'Third-party delivery provider name.']
  discount_amount decimal(18,2) [note: 'Total discount applied to the order.']
  fulfilled_at timestamp [note: 'Timestamp when order was fulfilled.']
  is_lto boolean [note: 'Whether order contains LTO items.']
  is_voided boolean [note: 'Whether the order has been voided.']
  item_count varchar [note: 'Number of items in the order.']
  kds_routed_at timestamp [note: 'Timestamp when order was routed to KDS.']
  loyalty_points_earned varchar [note: 'Points earned from this order.']
  loyalty_points_redeemed varchar [note: 'Points redeemed on this order.']
  olo_order_ref varchar [note: 'Online ordering platform reference.']
  order_status varchar [note: 'Current status of the order.']
  order_type varchar [note: 'Type of order (dine-in, takeout, delivery, etc.).']
  party_size varchar [note: 'Number of guests in the party.']
  payment_status decimal(18,2) [note: 'Current payment status of the order.']
  placed_at timestamp [note: 'Timestamp when order was placed.']
  pos_transaction_ref varchar [note: 'POS system transaction reference.']
  ready_at timestamp [note: 'Timestamp when order was ready.']
  sos_seconds varchar [note: 'Speed of service in seconds.']
  special_instructions varchar [note: 'Guest special instructions for the order.']
  subtotal_amount decimal(18,2) [note: 'Order subtotal before tax and tip.']
  table_number varchar [note: 'Table number for dine-in orders.']
  tax_amount decimal(18,2) [note: 'Total tax amount on the order.']
  tender_type varchar [note: 'Primary tender type used.']
  ticket_number varchar [note: 'POS ticket number.']
  ticket_time_seconds varchar [note: 'Total ticket time in seconds.']
  tip_amount decimal(18,2) [note: 'Tip amount on the order.']
  total_amount decimal(18,2) [note: 'Total order amount including tax and tip.']
  updated_at timestamp [note: 'Timestamp of last update.']
  void_reason varchar [note: 'Reason for voiding the order.']

  Note: 'Core order transaction capturing a guest purchase at a restaurant unit.'
}

Table order.order_item {
  order_item_id varchar [pk, note: 'Primary key for the order item.']
  discount_id varchar [note: 'FK to discount applied.']
  guest_order_id varchar [note: 'FK to parent guest order.']
