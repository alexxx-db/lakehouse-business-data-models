    rdfs:range xsd:string .

ind:specialInstructions rdf:type rdf:Property ;
    rdfs:label 'Special Instructions' ;
    rdfs:comment 'Free-text field for any special instructions, notes, or requirements related to notifying the third party (e.g., specific contact hours, escalation procedures, accessibility accommodations).' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:thirdPartyName rdf:type rdf:Property ;
    rdfs:label 'Third Party Name' ;
    rdfs:comment 'Full legal or organizational name of the third party designated to receive notifications (e.g., social service agency, property manager, medical guardian, landlord).' ;
    rdfs:domain ind:ThirdPartyNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:thirdPartyOrganizationName rdf:type rdf:Property ;
    rdfs:label 'Third Party Organization Name' ;
    rdfs:comment 'Name of the organization the third party represents, if applicable (e.g., county social services department, property management company).' ;
    rdfs:domain ind:ThirdPartyNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accountDocumentId rdf:type rdf:Property ;
    rdfs:label 'Account Document Id' ;
    rdfs:comment 'Unique identifier for the account document record. Primary key.' ;
    rdfs:domain ind:AccountDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:accountApprovedByUserEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Account Approved By User Employee Id' ;
    rdfs:comment 'Identifier of the user who approved the document.' ;
    rdfs:domain ind:AccountDocument ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:accountLastModifiedByUserEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Account Last Modified By User Employee Id' ;
    rdfs:comment 'Identifier of the user who last modified the document record.' ;
    rdfs:domain ind:AccountDocument ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:enforcementActionId rdf:type rdf:Property ;
    rdfs:label 'Enforcement Action Id' ;
    rdfs:comment 'Foreign key linking to compliance.enforcement_action. Business justification: Enforcement action documents (NOVs, consent orders, compliance schedules) are stored with affected customer accounts—regulatory document retention requirement and operational necessity for account man' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EnforcementAction .

ind:relatedInvoiceId rdf:type rdf:Property ;
    rdfs:label 'Related Invoice Id' ;
    rdfs:comment 'Reference to an invoice associated with this document, such as billing statements or payment receipts.' ;
    rdfs:domain ind:AccountDocument ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Invoice .

ind:relatedServiceOrderId rdf:type rdf:Property ;
    rdfs:label 'Related Service Order Id' ;
    rdfs:comment 'Reference to a service order associated with this document, such as service application approvals or connection agreements.' ;
    rdfs:domain ind:AccountDocument ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Order .

ind:relatedWorkOrderId rdf:type rdf:Property ;
    rdfs:label 'Related Work Order Id' ;
    rdfs:comment 'Reference to a work order associated with this document, such as meter installation reports or service connection documentation.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:WorkOrder .

ind:supersededAccountDocumentId rdf:type rdf:Property ;
    rdfs:label 'Superseded Account Document Id' ;
    rdfs:comment 'Self-referencing FK on account_document (superseded_account_document_id)' ;
    rdfs:domain ind:AccountDocument ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AccountDocument .

ind:tertiaryAccountCreatedByUserEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Tertiary Account Created By User Employee Id' ;
    rdfs:comment 'Identifier of the user or system that created this document record. Audit trail field.' ;
    rdfs:domain ind:AccountDocument ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:accessRestrictionNotes rdf:type rdf:Property ;
    rdfs:label 'Access Restriction Notes' ;
    rdfs:comment 'Free-text notes describing any special access restrictions, handling instructions, or confidentiality requirements for the document.' ;
    rdfs:domain ind:AccountDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accessibilityFormatFlag rdf:type rdf:Property ;
    rdfs:label 'Accessibility Format Flag' ;
    rdfs:comment 'Indicates whether the document is available in an accessible format such as large print, braille, or audio for customers with disabilities.' ;
    rdfs:domain ind:AccountDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:approvedByUserName rdf:type rdf:Property ;
    rdfs:label 'Approved By User Name' ;
    rdfs:comment 'Full name of the user who approved the document for audit and accountability purposes.' ;
    rdfs:domain ind:AccountDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Approved Timestamp' ;
    rdfs:comment 'Timestamp when the document was officially approved for use or distribution.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:ccrDeliveryFlag rdf:type rdf:Property ;
    rdfs:label 'Ccr Delivery Flag' ;
    rdfs:comment 'Indicates whether this document is part of the annual Consumer Confidence Report (CCR) delivery requirement under the Safe Drinking Water Act (SDWA).' ;
    rdfs:domain ind:AccountDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:checksumHash rdf:type rdf:Property ;
    rdfs:label 'Checksum Hash' ;
    rdfs:comment 'Cryptographic hash (e.g., SHA-256) of the document file to ensure integrity and detect tampering or corruption.' ;
    rdfs:domain ind:AccountDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceProgramCode rdf:type rdf:Property ;
    rdfs:label 'Compliance Program Code' ;
    rdfs:comment 'Code identifying the regulatory compliance program or requirement that this document supports. Examples include LCRR (Lead and Copper Rule Revisions), IUP (Industrial User Permit), NPDES (National Pollutant Discharge Elimination System), SDWA (Safe Drinking Water Act), CWA (Clean Water Act), and PUC audit requirements. [ENUM-REF-CANDIDATE: LCRR|IUP|NPDES|SDWA|CWA|PUC_AUDIT|LOW_INCOME_ASSISTANCE|OTHER — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:AccountDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:confidentialityLevel rdf:type rdf:Property ;
    rdfs:label 'Confidentiality Level' ;
    rdfs:comment 'Classification level indicating the sensitivity and access restrictions for the document. Aligns with organizational data classification policy.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:digitalSignaturePresentFlag rdf:type rdf:Property ;
    rdfs:label 'Digital Signature Present Flag' ;
    rdfs:comment 'Indicates whether the document contains a digital signature for authentication and non-repudiation purposes.' ;
    rdfs:domain ind:AccountDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:documentCategory rdf:type rdf:Property ;
    rdfs:label 'Document Category' ;
    rdfs:comment 'High-level categorization of the document for organizational and retrieval purposes.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentDate rdf:type rdf:Property ;
    rdfs:label 'Document Date' ;
    rdfs:comment 'The official date of the document as indicated on the document itself, such as the signature date, issuance date, or effective date. Represents the business event date of the document.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:documentDescription rdf:type rdf:Property ;
    rdfs:label 'Document Description' ;
    rdfs:comment 'Detailed description of the document content, purpose, or context. Provides additional information beyond the title.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentNotes rdf:type rdf:Property ;
    rdfs:label 'Document Notes' ;
    rdfs:comment 'General free-text notes or comments about the document. Used for additional context, processing instructions, or special handling requirements.' ;
    rdfs:domain ind:AccountDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentNumber rdf:type rdf:Property ;
    rdfs:label 'Document Number' ;
    rdfs:comment 'Business-assigned unique identifier or reference number for the document, used for tracking and retrieval purposes.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentStatus rdf:type rdf:Property ;
    rdfs:label 'Document Status' ;
    rdfs:comment 'Current lifecycle status of the document. Indicates whether the document is pending review, verified, approved, rejected, expired, superseded by a newer version, or archived. [ENUM-REF-CANDIDATE: PENDING_REVIEW|VERIFIED|APPROVED|REJECTED|EXPIRED|SUPERSEDED|ARCHIVED — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentTitle rdf:type rdf:Property ;
    rdfs:label 'Document Title' ;
    rdfs:comment 'Human-readable title or name of the document, providing a brief description of its content or purpose.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentType rdf:type rdf:Property ;
    rdfs:label 'Document Type' ;
    rdfs:comment 'Classification of the document type. Examples include service agreements, rate schedules, Consumer Confidence Reports (CCR), Industrial User Permits (IUP), backflow prevention certificates, meter test reports, and compliance notices. [ENUM-REF-CANDIDATE: service_agreement|rate_schedule|tariff|deposit_receipt|payment_plan|lien_notice|ccr|iup_permit|backflow_certificate|meter_test_report|compliance_notice|correspondence|other — 13 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentTypeCode rdf:type rdf:Property ;
    rdfs:label 'Document Type Code' ;
    rdfs:comment 'Classification code indicating the type of document. Examples include service agreements, signed applications, identity verification documents, income certification forms, Lead and Copper Rule Revisions (LCRR) lead service line notification acknowledgments, Industrial User Permit (IUP) permits, and legal correspondence. [ENUM-REF-CANDIDATE: SERVICE_AGREEMENT|APPLICATION|IDENTITY_VERIFICATION|INCOME_CERTIFICATION|LCRR_NOTIFICATION|IUP_PERMIT|LEGAL_CORRESPONDENCE|PAYMENT_ARRANGEMENT|BACKFLOW_PERMIT|EASEMENT|METER_INSTALLATION|CONSTRUCTION_PERMIT|WAIVER_FORM|CONSENT_FORM|OTHER — promote to reference product]' ;
    rdfs:domain ind:AccountDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fileFormat rdf:type rdf:Property ;
    rdfs:label 'File Format' ;
    rdfs:comment 'File format or MIME type of the document. Common formats include PDF, DOCX, JPEG, PNG, TIFF, and XML. [ENUM-REF-CANDIDATE: PDF|DOCX|DOC|JPEG|JPG|PNG|TIFF|TIF|XML — 9 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fileName rdf:type rdf:Property ;
    rdfs:label 'File Name' ;
    rdfs:comment 'Original file name of the uploaded document, including file extension. Preserves the name provided at upload time.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fileSizeBytes rdf:type rdf:Property ;
    rdfs:label 'File Size Bytes' ;
    rdfs:comment 'Size of the document file in bytes. Used for storage management and validation purposes.' ;
    rdfs:domain ind:AccountDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:notarizationDate rdf:type rdf:Property ;
    rdfs:label 'Notarization Date' ;
    rdfs:comment 'Date when the document was notarized. Null if not notarized or notarization not required.' ;
    rdfs:domain ind:AccountDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:notarizationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Notarization Required Flag' ;
    rdfs:comment 'Boolean flag indicating whether the document requires notarization. True if notarization is required.' ;
    rdfs:domain ind:AccountDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Regulatory Reference Number' ;
    rdfs:comment 'External reference number assigned by a regulatory agency or governing body, such as permit numbers, docket numbers, or compliance case identifiers.' ;
    rdfs:domain ind:AccountDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryRequirementFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Requirement Flag' ;
    rdfs:comment 'Boolean flag indicating whether this document is required for regulatory compliance purposes (e.g., LCRR lead notification documentation, IUP compliance records, PUC audit requirements). True if the document is regulatory-mandated.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:retentionExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Retention Expiration Date' ;
    rdfs:comment 'Date when the document retention period expires and the document may be eligible for deletion or archival per records retention policy. Supports compliance with Public Utilities Commission (PUC) audit requirements and regulatory retention schedules.' ;
    rdfs:domain ind:AccountDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:retentionPeriodYears rdf:type rdf:Property ;
    rdfs:label 'Retention Period Years' ;
    rdfs:comment 'Number of years the document must be retained per regulatory or internal policy requirements before eligible for destruction.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:signatureCapturedFlag rdf:type rdf:Property ;
    rdfs:label 'Signature Captured Flag' ;
    rdfs:comment 'Boolean flag indicating whether a signature has been captured on the document. True if signature is present.' ;
    rdfs:domain ind:AccountDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:signatureDate rdf:type rdf:Property ;
    rdfs:label 'Signature Date' ;
    rdfs:comment 'Date when the document was signed by the customer or authorized party. Null if not signed or signature not required.' ;
    rdfs:domain ind:AccountDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:signatureRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Signature Required Flag' ;
    rdfs:comment 'Boolean flag indicating whether the document requires a customer or authorized party signature. True if signature is required.' ;
    rdfs:domain ind:AccountDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:storageLocationUri rdf:type rdf:Property ;
    rdfs:label 'Storage Location Uri' ;
    rdfs:comment 'Uniform Resource Identifier (URI) or path to the physical or cloud storage location where the document is stored.' ;
    rdfs:domain ind:AccountDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:storageReference rdf:type rdf:Property ;
    rdfs:label 'Storage Reference' ;
    rdfs:comment 'Reference path or key to the physical document storage location. May be a document management system (DMS) path, object store key (e.g., S3 bucket path), or file system path. Used for document retrieval.' ;
    rdfs:domain ind:AccountDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:uploadChannel rdf:type rdf:Property ;
    rdfs:label 'Upload Channel' ;
    rdfs:comment 'Channel or method through which the document was submitted or uploaded. Examples include web portal, mobile app, email, fax, mail scan, in-person submission, call center, or field service. [ENUM-REF-CANDIDATE: WEB_PORTAL|MOBILE_APP|EMAIL|FAX|MAIL_SCAN|IN_PERSON|CALL_CENTER|FIELD_SERVICE — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:AccountDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:uploadTimestamp rdf:type rdf:Property ;
    rdfs:label 'Upload Timestamp' ;
    rdfs:comment 'Date and time when the document was uploaded or received into the system. Represents the business event timestamp for document receipt.' ;
    rdfs:domain ind:AccountDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:uploadedByName rdf:type rdf:Property ;
    rdfs:label 'Uploaded By Name' ;
    rdfs:comment 'Name of the person or system that uploaded the document. Provides human-readable context for the uploader.' ;
    rdfs:domain ind:AccountDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:uploadedByUserName rdf:type rdf:Property ;
    rdfs:label 'Uploaded By User Name' ;
    rdfs:comment 'Full name of the user who uploaded the document for audit and accountability purposes.' ;
    rdfs:domain ind:AccountDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:uploadedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Uploaded Timestamp' ;
    rdfs:comment 'Timestamp when the document was uploaded or ingested into the system.' ;
    rdfs:domain ind:AccountDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:verifiedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Verified Timestamp' ;
    rdfs:comment 'Date and time when the document was verified. Null if the document has not yet been verified.' ;
    rdfs:domain ind:AccountDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:versionNumber rdf:type rdf:Property ;
    rdfs:label 'Version Number' ;
    rdfs:comment 'Version number of the document. Increments when a new version of the same document is uploaded. Supports document version control.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:customerProgramEnrollmentId rdf:type rdf:Property ;
    rdfs:label 'Customer Program Enrollment Id' ;
    rdfs:comment 'Primary key for customer_program_enrollment' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:canonicalServiceProgramEnrollmentId rdf:type rdf:Property ;
    rdfs:label 'Canonical Service Program Enrollment Id' ;
    rdfs:domain ind:CustomerProgramEnrollment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ServiceProgramEnrollment .

ind:coApplicantPersonId rdf:type rdf:Property ;
    rdfs:label 'Co Applicant Person Id' ;
    rdfs:comment 'Co-applicant person if applicable' ;
    rdfs:domain ind:CustomerProgramEnrollment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Person .

ind:conservationProgramId rdf:type rdf:Property ;
    rdfs:label 'Conservation Program Id' ;
    rdfs:comment 'Foreign key linking to the conservation program in which the customer is enrolled' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ConservationProgram .

ind:customerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Customer Employee Id' ;
    rdfs:comment 'FK to employee who processed enrollment' ;
    rdfs:domain ind:CustomerProgramEnrollment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:customerVerifiedByEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Customer Verified By Employee Id' ;
    rdfs:comment 'Employee who verified enrollment eligibility' ;
    rdfs:domain ind:CustomerProgramEnrollment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

