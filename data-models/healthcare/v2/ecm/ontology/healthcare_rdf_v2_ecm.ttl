    rdfs:domain ind:ProviderLocation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Specialty .

ind:absorbedLocationSpecialtyFlag rdf:type rdf:Property ;
    rdfs:label 'Absorbed Location Specialty Flag' ;
    rdfs:domain ind:ProviderLocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPrimarySpecialty rdf:type rdf:Property ;
    rdfs:label 'Is Primary Specialty' ;
    rdfs:domain ind:Provider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:locationName rdf:type rdf:Property ;
    rdfs:label 'Location Name' ;
    rdfs:comment 'Human-readable name of the pharmacy location (e.g., Main Hospital Pharmacy, Outpatient Retail Pharmacy, Oncology Satellite Pharmacy).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:locationPhone rdf:type rdf:Property ;
    rdfs:label 'Location Phone' ;
    rdfs:domain ind:ProviderLocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:locationScope rdf:type rdf:Property ;
    rdfs:label 'Location Scope' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:locationSpecialtyDescription rdf:type rdf:Property ;
    rdfs:label 'Location Specialty Description' ;
    rdfs:domain ind:ProviderLocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:locationStatus rdf:type rdf:Property ;
    rdfs:label 'Location Status' ;
    rdfs:comment 'Current operational lifecycle status of the provider location. Determines whether the location is published in provider directories, eligible for patient scheduling, and included in network adequacy calculations.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:locationType rdf:type rdf:Property ;
    rdfs:label 'Location Type' ;
    rdfs:comment 'Classification of the pharmacy location by service model and operational scope. [ENUM-REF-CANDIDATE: inpatient|outpatient_retail|specialty|satellite|automated_dispensing_cabinet|central_fill|compounding|emergency_department|operating_room — promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerLocationStatus rdf:type rdf:Property ;
    rdfs:label 'Provider Location Status' ;
    rdfs:domain ind:ProviderLocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:locationSpecialtyId rdf:type rdf:Property ;
    rdfs:label 'Location Specialty Id' ;
    rdfs:domain ind:LocationSpecialty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:diagnosisId rdf:type rdf:Property ;
    rdfs:label 'Diagnosis Id' ;
    rdfs:comment 'Unique surrogate identifier for each clinical diagnosis record in the system. Primary key for the clinical_diagnosis data product.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Diagnosis .

ind:patientRiskScoreId rdf:type rdf:Property ;
    rdfs:label 'Patient Risk Score Id' ;
    rdfs:comment 'Link to patient risk score' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PatientRiskScore .

ind:admitDiagnosisFlag rdf:type rdf:Property ;
    rdfs:label 'Admit Diagnosis Flag' ;
    rdfs:comment 'Indicates whether this diagnosis was the stated reason for inpatient admission as documented at the time of admission. The admitting diagnosis may differ from the principal discharge diagnosis and is required on UB-04 claim form field 69.' ;
    rdfs:domain ind:Diagnosis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:aiSuggestedFlag rdf:type rdf:Property ;
    rdfs:label 'Ai Suggested Flag' ;
    rdfs:comment 'Whether diagnosis was suggested by clinical AI/NLP' ;
    rdfs:domain ind:Diagnosis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:behavioralHealthAddedFlag rdf:type rdf:Property ;
    rdfs:label 'Behavioral Health Added Flag' ;
    rdfs:comment 'Flag indicating behavioral health domain was added via mutator.' ;
    rdfs:domain ind:Diagnosis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:behavioralHealthDomainCode rdf:type rdf:Property ;
    rdfs:label 'Behavioral Health Domain Code' ;
    rdfs:comment 'Link to behavioral health domain (placeholder)' ;
    rdfs:domain ind:Diagnosis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:behavioralHealthFlag rdf:type rdf:Property ;
    rdfs:label 'Behavioral Health Flag' ;
    rdfs:comment 'Indicates presence of behavioral health data' ;
    rdfs:domain ind:Clinical ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:behavioralHealthIntegrationMarker rdf:type rdf:Property ;
    rdfs:label 'Behavioral Health Integration Marker' ;
    rdfs:comment 'Flag indicating integration with behavioral health domain' ;
    rdfs:domain ind:Diagnosis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:behavioralHealthProtectedFlag rdf:type rdf:Property ;
    rdfs:label 'Behavioral Health Protected Flag' ;
    rdfs:comment '42 CFR Part 2 protected data flag' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cdiQueryFlag rdf:type rdf:Property ;
    rdfs:label 'Cdi Query Flag' ;
    rdfs:comment 'Indicates whether a CDI specialist has issued a physician query related to this diagnosis for clarification or specificity improvement. Supports CDI workflow tracking and documentation quality metrics.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cdiQueryStatus rdf:type rdf:Property ;
    rdfs:label 'Cdi Query Status' ;
    rdfs:comment 'Current status of the CDI physician query associated with this diagnosis. Tracks whether the provider has responded and whether the diagnosis was amended based on the query outcome.' ;
    rdfs:domain ind:Clinical ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clinicalStatus rdf:type rdf:Property ;
    rdfs:label 'Clinical Status' ;
    rdfs:comment 'Current clinical state of the diagnosis as documented by the provider. Active indicates an ongoing condition; resolved indicates the condition has been treated or cleared; chronic conditions may persist across encounters.' ;
    rdfs:domain ind:Clinical ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:codingDate rdf:type rdf:Property ;
    rdfs:label 'Coding Date' ;
    rdfs:comment 'The date on which the ICD-10-CM code was assigned or finalized by the HIM coder. Used for coding turnaround time reporting, revenue cycle management, and compliance audits.' ;
    rdfs:domain ind:Diagnosis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:complicationComorbidityFlag rdf:type rdf:Property ;
    rdfs:label 'Complication Comorbidity Flag' ;
    rdfs:comment 'Indicates whether this secondary diagnosis qualifies as a Complication (CC) or Major Complication/Comorbidity (MCC) under CMS DRG grouping logic. CC/MCC status elevates DRG weight and reimbursement.' ;
    rdfs:domain ind:Diagnosis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:diagnosisDate rdf:type rdf:Property ;
    rdfs:label 'Diagnosis Date' ;
    rdfs:comment 'The date on which the diagnosis was formally documented in the EHR by the clinician. Distinct from onset date (when the condition began) and encounter date. Used as the principal business event date for this transaction record.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:dischargeDiagnosisFlag rdf:type rdf:Property ;
    rdfs:label 'Discharge Diagnosis Flag' ;
    rdfs:comment 'Indicates whether this diagnosis was finalized as a discharge diagnosis at the conclusion of the inpatient encounter. Discharge diagnoses are used for final DRG assignment, claim submission, and discharge summary documentation.' ;
    rdfs:domain ind:Diagnosis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:encounterDiagnosisSource rdf:type rdf:Property ;
    rdfs:label 'Encounter Diagnosis Source' ;
    rdfs:comment 'Identifies the role of the person who entered or assigned this diagnosis in the EHR. Supports CDI workflow analysis, coding quality audits, and provider attribution reporting.' ;
    rdfs:domain ind:Diagnosis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:encounterType rdf:type rdf:Property ;
    rdfs:label 'Encounter Type' ;
    rdfs:comment 'Classifies the type of encounter in which this diagnosis was documented. Inpatient diagnoses are subject to POA reporting and DRG grouping; outpatient diagnoses follow CMS-1500 coding guidelines. Denormalized from the encounter for direct diagnosis-level analytics.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:genomicsRelevantFlag rdf:type rdf:Property ;
    rdfs:label 'Genomics Relevant Flag' ;
    rdfs:comment 'Indicates whether this diagnosis has associated genomic/precision medicine relevance' ;
    rdfs:domain ind:Diagnosis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hacFlag rdf:type rdf:Property ;
    rdfs:label 'Hac Flag' ;
    rdfs:comment 'Indicates whether this diagnosis qualifies as a CMS-designated Hospital-Acquired Condition (HAC). HAC-flagged diagnoses that were not present on admission may trigger payment reductions under the HAC Reduction Program.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mccFlag rdf:type rdf:Property ;
    rdfs:label 'Mcc Flag' ;
    rdfs:comment 'Indicates whether this diagnosis specifically qualifies as a Major Complication or Comorbidity (MCC) — the highest severity tier in CMS DRG grouping. Distinct from the general CC flag; MCC status drives the highest DRG weight tier.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mutatorAppliedFlag rdf:type rdf:Property ;
    rdfs:label 'Mutator Applied Flag' ;
    rdfs:comment 'Flag set by mutator to indicate modification' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:noteText rdf:type rdf:Property ;
    rdfs:label 'Note Text' ;
    rdfs:comment 'Free-text clinical note or comment associated with this diagnosis entry, as documented by the provider or CDI specialist. May include clinical rationale, specificity details, or query responses. Classified as confidential due to clinical content.' ;
    rdfs:domain ind:Diagnosis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:part2ConsentId rdf:type rdf:Property ;
    rdfs:label 'Part2 Consent Id' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Part2Consent .

ind:part2ConsentWorkflowPart2ConsentId rdf:type rdf:Property ;
    rdfs:label 'Part2 Consent Workflow Part2 Consent Id' ;
    rdfs:comment 'Link to 42 CFR Part 2 consent workflow' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Part2Consent .

ind:pharmacogenomicsImpactFlag rdf:type rdf:Property ;
    rdfs:label 'Pharmacogenomics Impact Flag' ;
    rdfs:comment 'Indicates whether pharmacogenomic considerations apply to treatment of this diagnosis' ;
    rdfs:domain ind:Diagnosis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:presentOnAdmission rdf:type rdf:Property ;
    rdfs:label 'Present On Admission' ;
    rdfs:comment 'CMS-required Present on Admission (POA) indicator for inpatient diagnoses. Y=present at admission, N=not present at admission, U=unknown, W=clinically undetermined, 1=unreported/not used. Affects hospital-acquired condition (HAC) payment adjustments and quality reporting.' ;
    rdfs:domain ind:Clinical ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:principalDiagnosisFlag rdf:type rdf:Property ;
    rdfs:label 'Principal Diagnosis Flag' ;
    rdfs:comment 'Indicates whether this diagnosis is designated as the principal diagnosis for the encounter (True). The principal diagnosis is the condition established after study to be chiefly responsible for the admission and drives DRG assignment.' ;
    rdfs:domain ind:Diagnosis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:problemListFlag rdf:type rdf:Property ;
    rdfs:label 'Problem List Flag' ;
    rdfs:comment 'Indicates whether this diagnosis is part of the patient\'s longitudinal problem list (True) or is encounter-specific only (False). Problem list diagnoses persist across encounters and drive chronic disease management workflows.' ;
    rdfs:domain ind:Diagnosis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rank rdf:type rdf:Property ;
    rdfs:label 'Rank' ;
    rdfs:comment 'Numeric sequence indicating the ordering of diagnoses within an encounter (1 = principal, 2 = first secondary, etc.). Used for UB-04 claim form sequencing, DRG optimization, and CDI prioritization.' ;
    rdfs:domain ind:Diagnosis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:recordedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Recorded Timestamp' ;
    rdfs:comment 'The precise date and time when this diagnosis record was first created in the source EHR system (Epic ClinDoc or Cerner PowerChart). Supports audit trails, CDI workflow timing, and data lineage.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:sourceSystemDiagnosisCode rdf:type rdf:Property ;
    rdfs:label 'Source System Diagnosis Code' ;
    rdfs:comment 'The native identifier for this diagnosis record in the originating source system (e.g., Epic diagnosis ID, Cerner diagnosis ID). Enables bidirectional traceability between the lakehouse and the operational EHR.' ;
    rdfs:domain ind:Diagnosis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:diagnosisStatus rdf:type rdf:Property ;
    rdfs:label 'Diagnosis Status' ;
    rdfs:domain ind:Diagnosis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vibeMutationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Vibe Mutation Timestamp' ;
    rdfs:comment 'Auto-added by VIBE mutator to register a change' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:procedureEventId rdf:type rdf:Property ;
    rdfs:label 'Procedure Event Id' ;
    rdfs:comment 'Unique surrogate identifier for each clinical procedure event record in the Silver Layer lakehouse. Primary key for this entity.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProcedureEvent .

ind:drugMasterId rdf:type rdf:Property ;
    rdfs:label 'Drug Master Id' ;
    rdfs:comment 'Foreign key linking to pharmacy.drug_master. Business justification: Surgical procedures require specific medications (anesthesia agents, prophylactic antibiotics, contrast media). Perioperative medication protocols and surgical safety checklists depend on procedure-to' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DrugMaster .

ind:orRoomId rdf:type rdf:Property ;
    rdfs:label 'Or Room Id' ;
    rdfs:comment 'Reference to the specific operating room, procedure room, or interventional suite where the procedure was performed. Used for OR utilization reporting, room turnover analytics, and facility scheduling.' ;
    rdfs:domain ind:ProcedureEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Room .

ind:originatingClinicalOrderId rdf:type rdf:Property ;
    rdfs:label 'Originating Clinical Order Id' ;
    rdfs:comment 'Foreign key linking to order.clinical_order. Business justification: Procedures fulfill clinical orders. Real workflow: surgeon orders appendectomy, OR performs procedure. Critical for order-to-fulfillment tracking, charge reconciliation, turnaround time analysis, and ' ;
    rdfs:domain ind:ProcedureEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ClinicalOrder .

ind:primaryProcedureClinicianId rdf:type rdf:Property ;
    rdfs:label 'Primary Procedure Clinician Id' ;
    rdfs:comment 'Reference to the licensed clinician (surgeon, interventionalist, or proceduralist) who performed the procedure. Used for credentialing validation, RVU attribution, and quality measurement.' ;
    rdfs:domain ind:ProcedureEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:procedureClinicianId rdf:type rdf:Property ;
    rdfs:label 'Procedure Clinician Id' ;
    rdfs:domain ind:Clinical ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:tertiaryProcedureAnesthesiaProviderClinicianId rdf:type rdf:Property ;
    rdfs:label 'Tertiary Procedure Anesthesia Provider Clinician Id' ;
    rdfs:comment 'Reference to the anesthesiologist or CRNA responsible for anesthesia administration during the procedure. Required for anesthesia professional fee billing and credentialing compliance.' ;
    rdfs:domain ind:ProcedureEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:approach rdf:type rdf:Property ;
    rdfs:label 'Approach' ;
    rdfs:comment 'Technique or access method used to perform the procedure (e.g., open, laparoscopic, robotic-assisted, endoscopic). Captured in ICD-10-PCS character 5 and used for surgical quality benchmarking and OR resource planning.' ;
    rdfs:domain ind:ProcedureEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:asaClassification rdf:type rdf:Property ;
    rdfs:label 'Asa Classification' ;
    rdfs:comment 'ASA Physical Status Classification (I–VI) assigned by the anesthesiologist to assess patient pre-operative risk. Required for anesthesia billing, surgical risk stratification, and quality benchmarking (ACS NSQIP).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cdmCode rdf:type rdf:Property ;
    rdfs:label 'Cdm Code' ;
    rdfs:comment 'Internal facility CDM (Charge Description Master) code identifying the specific charge item for this procedure. Links clinical documentation to the revenue cycle charge capture process.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:digitalHealthRelevantFlag rdf:type rdf:Property ;
    rdfs:label 'Digital Health Relevant Flag' ;
    rdfs:comment 'Whether this record is relevant to digital health/RPM/telehealth workflows' ;
    rdfs:domain ind:Clinical ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:estimatedBloodLossMl rdf:type rdf:Property ;
    rdfs:label 'Estimated Blood Loss Ml' ;
    rdfs:comment 'Estimated blood loss in milliliters recorded by the surgical team during the procedure. Used for post-operative care planning, transfusion trigger assessment, and surgical quality benchmarking (ACS NSQIP).' ;
    rdfs:domain ind:ProcedureEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:genomicTestFlag rdf:type rdf:Property ;
    rdfs:label 'Genomic Test Flag' ;
    rdfs:comment 'Indicates whether this procedure is a genomic/genetic test' ;
    rdfs:domain ind:ProcedureEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:procedureCategory rdf:type rdf:Property ;
    rdfs:label 'Procedure Category' ;
    rdfs:comment 'High-level clinical category classifying the nature of the procedure. Used for service-line analytics, OR scheduling resource allocation, and population health stratification.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:procedureEndDatetime rdf:type rdf:Property ;
    rdfs:label 'Procedure End Datetime' ;
    rdfs:comment 'Date and time when the procedure was completed (wound closure for surgical cases, or final intervention for non-surgical). Used with start time to calculate procedure duration for OR scheduling, staffing, and quality metrics.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:procedureStartDatetime rdf:type rdf:Property ;
    rdfs:label 'Procedure Start Datetime' ;
    rdfs:comment 'Date and time when the procedure was initiated (knife-to-skin for surgical cases, or first intervention for non-surgical). Principal BUSINESS_EVENT_TIMESTAMP for this transaction. Used for OR utilization, LOS calculation, and quality measure timing.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:scheduledStartDatetime rdf:type rdf:Property ;
    rdfs:label 'Scheduled Start Datetime' ;
    rdfs:comment 'Originally scheduled date and time for the procedure. Compared against actual start time to measure on-time starts, OR schedule adherence, and first-case delay metrics.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:snomedCtCode rdf:type rdf:Property ;
    rdfs:label 'Snomed Ct Code' ;
    rdfs:comment 'SNOMED CT concept code representing the clinical procedure. Supports interoperability via HL7 FHIR and HIE exchange, and enables clinical decision support and population health analytics beyond billing code sets.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:specimenCollected rdf:type rdf:Property ;
    rdfs:label 'Specimen Collected' ;
    rdfs:comment 'Indicates whether a tissue specimen or pathology sample was collected during the procedure. Triggers downstream laboratory/pathology order workflow and chain-of-custody documentation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:procedureEventStatus rdf:type rdf:Property ;
    rdfs:label 'Procedure Event Status' ;
    rdfs:domain ind:ProcedureEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:timeoutPerformed rdf:type rdf:Property ;
    rdfs:label 'Timeout Performed' ;
    rdfs:comment 'Indicates whether the pre-procedure surgical time-out (Universal Protocol) was completed and documented. Mandatory for Joint Commission accreditation and CMS Conditions of Participation to prevent wrong-site, wrong-procedure, wrong-patient events.' ;
    rdfs:domain ind:ProcedureEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:woundClassification rdf:type rdf:Property ;
    rdfs:label 'Wound Classification' ;
    rdfs:comment 'CDC/ACS wound classification (Clean, Clean-Contaminated, Contaminated, Dirty/Infected) assigned at time of procedure. Used for SSI (Surgical Site Infection) surveillance, HAI reporting, and infection control quality metrics.' ;
    rdfs:domain ind:ProcedureEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:noteClinicianId rdf:type rdf:Property ;
    rdfs:label 'Note Clinician Id' ;
    rdfs:domain ind:Note ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:noteTemplateId rdf:type rdf:Property ;
    rdfs:label 'Note Template Id' ;
    rdfs:comment 'The identifier of the EHR documentation template used to author this note (e.g., Epic SmartText or Cerner PowerNote template ID). Supports template utilization analytics and standardization initiatives.' ;
    rdfs:domain ind:Clinical ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:NoteTemplate .

ind:parentNoteId rdf:type rdf:Property ;
    rdfs:label 'Parent Note Id' ;
    rdfs:comment 'Reference to the original clinical note to which this addendum or amendment is attached. Null for original notes. Enables reconstruction of the complete note history and amendment chain.' ;
    rdfs:domain ind:Note ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Note .

ind:primaryNoteAttendingProviderClinicianId rdf:type rdf:Property ;
    rdfs:label 'Primary Note Attending Provider Clinician Id' ;
    rdfs:comment 'Reference to the attending physician of record for the encounter at the time the note was authored. May differ from the note author (e.g., resident authors, attending co-signs). Used for CMS billing attribution and quality measure assignment.' ;
    rdfs:domain ind:Note ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:tertiaryNoteCosignerProviderClinicianId rdf:type rdf:Property ;
    rdfs:label 'Tertiary Note Cosigner Provider Clinician Id' ;
    rdfs:comment 'Reference to the supervising or co-signing provider who attests to the note content. Required for resident/trainee notes per CMS teaching physician rules. Nullable when no co-signature is required.' ;
    rdfs:domain ind:Note ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:amendedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Amended Timestamp' ;
    rdfs:comment 'The date and time when the note was last amended (corrected). Amendments replace erroneous content while preserving the original for audit purposes. Nullable for notes that have never been amended.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:authorRole rdf:type rdf:Property ;
    rdfs:label 'Author Role' ;
    rdfs:comment 'The clinical role of the provider who authored the note. Determines co-signature requirements, billing eligibility (incident-to rules), and CDI workflow routing. [ENUM-REF-CANDIDATE: attending|resident|fellow|nurse_practitioner|physician_assistant|registered_nurse|medical_student|clinical_pharmacist|case_manager|social_worker — promote to reference product]' ;
    rdfs:domain ind:Note ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authoredTimestamp rdf:type rdf:Property ;
    rdfs:label 'Authored Timestamp' ;
    rdfs:comment 'The date and time when the provider began authoring or first saved the clinical note in the EHR. Represents the business event timestamp for note creation. Used for timeliness compliance reporting (e.g., H&P within 24 hours of admission per TJC).' ;
    rdfs:domain ind:Note ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:behavioralHealthNoteFlag rdf:type rdf:Property ;
    rdfs:label 'Behavioral Health Note Flag' ;
    rdfs:comment 'Flag indicating linkage to behavioral health data' ;
    rdfs:domain ind:Note ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cosignedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Cosigned Timestamp' ;
    rdfs:comment 'The date and time when the supervising provider co-signed the note. Required for resident and mid-level provider notes under CMS teaching physician and incident-to billing rules. Nullable when co-signature is not required.' ;
    rdfs:domain ind:Note ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:dictationMethod rdf:type rdf:Property ;
    rdfs:label 'Dictation Method' ;
    rdfs:comment 'The method by which the note content was entered into the EHR. Supports provider efficiency analytics, scribe program management, and AI-assisted documentation quality assessment.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:drgImpactFlag rdf:type rdf:Property ;
    rdfs:label 'Drg Impact Flag' ;
    rdfs:comment 'Indicates whether the documentation in this note has been identified as having a potential impact on the assigned DRG and associated reimbursement. Used by CDI and HIM teams to prioritize review queues.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:format rdf:type rdf:Property ;
    rdfs:label 'Format' ;
    rdfs:comment 'Indicates whether the note content is unstructured free text, fully structured (discrete data elements), semi-structured (narrative with embedded structured fields), or authored from a predefined template. Drives NLP/AI processing pipelines and CDI tool integration.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isAddendum rdf:type rdf:Property ;
    rdfs:label 'Is Addendum' ;
    rdfs:comment 'Indicates whether this note record is an addendum appended to a previously signed note rather than an original note. Addenda supplement but do not replace the original note content.' ;
    rdfs:domain ind:Note ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isCopyForwarded rdf:type rdf:Property ;
    rdfs:label 'Is Copy Forwarded' ;
    rdfs:comment 'Indicates whether the note content was copied or cloned from a prior note rather than independently authored. Copy-forward documentation is an OIG audit target and a CDI quality concern affecting medical necessity and billing integrity.' ;
    rdfs:domain ind:Note ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isLateEntry rdf:type rdf:Property ;
    rdfs:label 'Is Late Entry' ;
    rdfs:comment 'Indicates whether the note was authored after the standard documentation timeliness window (e.g., H&P authored more than 24 hours after admission). Late entries must be identified per TJC and CMS medical record standards.' ;
    rdfs:domain ind:Note ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nlpProcessedFlag rdf:type rdf:Property ;
    rdfs:label 'Nlp Processed Flag' ;
    rdfs:comment 'Whether note has been processed by clinical NLP pipeline' ;
    rdfs:domain ind:Note ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:noteStatus rdf:type rdf:Property ;
    rdfs:label 'Note Status' ;
    rdfs:comment 'Current workflow state of the clinical note in the EHR documentation lifecycle. Draft notes are incomplete; signed notes are legally attested; amended notes reflect corrections; addended notes have supplemental content appended; retracted notes have been withdrawn from the medical record.' ;
    rdfs:domain ind:Note ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:noteType rdf:type rdf:Property ;
    rdfs:label 'Note Type' ;
    rdfs:comment 'Classification of the clinical note by its documentation purpose and clinical context. Drives CDI workflows, HIM coding queues, and regulatory reporting. [ENUM-REF-CANDIDATE: History and Physical|Progress Note|Discharge Summary|Operative Note|Consult Note|Nursing Note|Procedure Note|Radiology Report|Pathology Report|Transfer Note|Referral Note|Telephone Encounter Note — promote to reference product]' ;
    rdfs:domain ind:Clinical ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:precisionMedicineFlag rdf:type rdf:Property ;
    rdfs:label 'Precision Medicine Flag' ;
    rdfs:comment 'Indicates whether this note relates to precision medicine or genomic findings' ;
    rdfs:domain ind:Note ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sensitiveNoteType rdf:type rdf:Property ;
    rdfs:label 'Sensitive Note Type' ;
    rdfs:comment 'Identifies whether the note contains sensitive clinical content subject to heightened privacy protections beyond standard HIPAA requirements. Drives break-the-glass access controls and consent management workflows.' ;
    rdfs:domain ind:Note ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:signedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Signed Timestamp' ;
    rdfs:comment 'The date and time when the author electronically signed and attested to the clinical note, making it a legally authenticated entry in the medical record. Nullable for draft notes.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:sourceSystemNoteCode rdf:type rdf:Property ;
    rdfs:label 'Source System Note Code' ;
    rdfs:comment 'The native identifier of this note in the originating EHR system (Epic ClinDoc note ID or Cerner PowerChart document ID). Used for cross-system reconciliation and ETL lineage tracing.' ;
    rdfs:domain ind:Note ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:specialty rdf:type rdf:Property ;
    rdfs:label 'Specialty' ;
    rdfs:comment 'The medical or clinical specialty associated with the note (e.g., Cardiology, Orthopedics, Nursing, Anesthesiology). Derived from the authoring provider\'s specialty or the ordering service. Used for specialty-specific CDI and quality reporting.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:text rdf:type rdf:Property ;
    rdfs:label 'Text' ;
    rdfs:comment 'The full free-text or structured narrative content of the clinical note. Contains Protected Health Information (PHI) including clinical findings, diagnoses, treatment plans, and patient history. Subject to HIPAA minimum necessary standard and access controls. Core to CDI and HIM coding workflows.' ;
    rdfs:domain ind:Note ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:title rdf:type rdf:Property ;
    rdfs:label 'Title' ;
    rdfs:comment 'The human-readable title or subject line of the clinical note as displayed in the EHR (e.g., \'Cardiology Consult Note\', \'Post-Op Day 1 Progress Note\'). Supports note navigation and CDI workflow queuing.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:version rdf:type rdf:Property ;
    rdfs:label 'Version' ;
    rdfs:comment 'Monotonically incrementing version number for the note record, incremented with each amendment or addendum. Enables reconstruction of the complete note history and supports audit trail requirements.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wordCount rdf:type rdf:Property ;
    rdfs:label 'Word Count' ;
    rdfs:comment 'The total number of words in the clinical note text. Used for documentation quality metrics, CDI completeness scoring, and identifying copy-paste or cloned note patterns flagged by OIG compliance programs.' ;
    rdfs:domain ind:Note ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:problemId rdf:type rdf:Property ;
    rdfs:label 'Problem Id' ;
    rdfs:comment 'Unique surrogate identifier for the patient problem list entry in the lakehouse silver layer. Primary key for this entity.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Problem .

ind:prescriptionId rdf:type rdf:Property ;
    rdfs:label 'Prescription Id' ;
    rdfs:comment 'Foreign key linking to pharmacy.prescription. Business justification: Chronic conditions on problem lists drive ongoing prescription management. Used to validate prescription appropriateness, manage polypharmacy, and track medication adherence against chronic disease ma' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Prescription .

ind:primaryProblemAddedByProviderClinicianId rdf:type rdf:Property ;
    rdfs:label 'Primary Problem Added By Provider Clinician Id' ;
    rdfs:comment 'Reference to the clinician who originally added this problem to the patient\'s problem list. Distinct from ordering_provider_id which reflects the current responsible provider. Supports audit and CDI workflows.' ;
    rdfs:domain ind:Problem ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:problemClinicianId rdf:type rdf:Property ;
    rdfs:label 'Problem Clinician Id' ;
    rdfs:domain ind:Problem ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:tertiaryProblemLastUpdatedByProviderClinicianId rdf:type rdf:Property ;
    rdfs:label 'Tertiary Problem Last Updated By Provider Clinician Id' ;
    rdfs:comment 'Reference to the clinician who most recently modified this problem record. Supports Clinical Documentation Improvement (CDI) audit trails and accountability tracking.' ;
    rdfs:domain ind:Problem ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:triggeringClinicalOrderId rdf:type rdf:Property ;
    rdfs:label 'Triggering Clinical Order Id' ;
    rdfs:comment 'Foreign key linking to order.clinical_order. Business justification: Active problems trigger standing and recurring orders. Real workflow: diabetes problem triggers quarterly A1C orders. Essential for chronic disease management protocols, population health order compli' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ClinicalOrder .

ind:bodySiteCode rdf:type rdf:Property ;
    rdfs:label 'Body Site Code' ;
    rdfs:comment 'SNOMED CT code identifying the anatomical body site associated with this problem (e.g., 368209003 = Right arm). Supports surgical planning, radiology ordering, and clinical specificity in documentation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bodySiteDescription rdf:type rdf:Property ;
    rdfs:label 'Body Site Description' ;
    rdfs:comment 'Human-readable description of the anatomical body site corresponding to body_site_code. Stored for reporting and display purposes.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:comment rdf:type rdf:Property ;
    rdfs:label 'Comment' ;
    rdfs:comment 'Free-text clinical comment or note associated with this problem list entry, as entered by the clinician in the Electronic Health Record (EHR). May include clinical context, treatment notes, or documentation improvement remarks.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:confidentialFlag rdf:type rdf:Property ;
    rdfs:label 'Confidential Flag' ;
    rdfs:comment 'Indicates whether this problem has been marked as confidential in the Electronic Health Record (EHR), restricting access to authorized users only. Commonly applied to sensitive diagnoses such as HIV/AIDS, substance use disorders, and psychiatric conditions per 42 CFR Part 2 and state privacy laws.' ;
    rdfs:domain ind:Problem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fhirConditionReference rdf:type rdf:Property ;
    rdfs:label 'Fhir Condition Reference' ;
    rdfs:comment 'The HL7 Fast Healthcare Interoperability Resources (FHIR) Condition resource identifier for this problem, used in Health Information Exchange (HIE) and interoperability workflows. Supports CMS Interoperability and Patient Access Rule compliance.' ;
    rdfs:domain ind:Problem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geneticConditionFlag rdf:type rdf:Property ;
    rdfs:label 'Genetic Condition Flag' ;
    rdfs:comment 'Indicates whether this problem is a known genetic/hereditary condition' ;
    rdfs:domain ind:Problem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isEncounterDiagnosis rdf:type rdf:Property ;
    rdfs:label 'Is Encounter Diagnosis' ;
    rdfs:comment 'Indicates whether this problem list entry was also used as an encounter-level diagnosis for billing and claims purposes. Distinguishes longitudinal problem list entries from encounter-specific diagnoses used in revenue cycle management.' ;
    rdfs:domain ind:Problem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:listDisplayOrder rdf:type rdf:Property ;
    rdfs:label 'List Display Order' ;
    rdfs:comment 'Numeric sequence indicating the display order of this problem on the patient\'s problem list as configured in the Electronic Health Record (EHR). Lower numbers appear first. Supports clinical workflow and provider-defined prioritization.' ;
    rdfs:domain ind:Problem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:notedDate rdf:type rdf:Property ;
    rdfs:label 'Noted Date' ;
    rdfs:comment 'The date on which the problem was first documented or noted in the Electronic Health Record (EHR) problem list by a clinician. May differ from onset_date if the condition predates the current care relationship.' ;
    rdfs:domain ind:Problem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:onsetAgeYears rdf:type rdf:Property ;
    rdfs:label 'Onset Age Years' ;
    rdfs:comment 'Patient\'s age in years at the time of problem onset, as documented or calculated. Useful for population health stratification and epidemiological analytics when exact onset date is unavailable or approximate.' ;
    rdfs:domain ind:Problem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:principalProblemFlag rdf:type rdf:Property ;
    rdfs:label 'Principal Problem Flag' ;
    rdfs:comment 'Indicates whether this problem is designated as the principal or primary problem driving the current episode of care or encounter. Used in Diagnosis-Related Group (DRG) assignment and revenue cycle workflows.' ;
    rdfs:domain ind:Problem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:problemStatus rdf:type rdf:Property ;
    rdfs:label 'Problem Status' ;
    rdfs:comment 'Current clinical lifecycle status of the problem on the patient\'s longitudinal problem list. \'active\' indicates an ongoing condition; \'resolved\' indicates the condition has been addressed; \'inactive\' indicates the condition is not currently being managed; \'deleted\' or \'entered-in-error\' indicates administrative correction.' ;
    rdfs:domain ind:Problem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:problemType rdf:type rdf:Property ;
    rdfs:label 'Problem Type' ;
    rdfs:comment 'Clinical classification of the problem by its temporal and clinical nature. \'chronic\' indicates a long-standing condition; \'acute\' indicates a short-term condition; \'historical\' indicates a past condition no longer active; \'social\' indicates a social determinant of health (SDOH); \'surgical\' indicates a surgical history item; \'psychiatric\' indicates a behavioral health condition. [ENUM-REF-CANDIDATE: chronic|acute|historical|social|surgical|psychiatric|functional|genetic — promote to reference product]' ;
    rdfs:domain ind:Problem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemProblemCode rdf:type rdf:Property ;
    rdfs:label 'Source System Problem Code' ;
    rdfs:comment 'Native identifier for this problem record in the originating Electronic Health Record (EHR) system (e.g., Epic problem list ID or Cerner problem instance ID). Used for lineage tracing and reconciliation during ETL.' ;
    rdfs:domain ind:Problem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stageCode rdf:type rdf:Property ;
    rdfs:label 'Stage Code' ;
    rdfs:comment 'Clinical staging code for the problem where applicable (e.g., cancer TNM staging, chronic kidney disease stage, heart failure NYHA class). Supports oncology registries, chronic disease management, and quality reporting.' ;
    rdfs:domain ind:Problem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stageDescription rdf:type rdf:Property ;
    rdfs:label 'Stage Description' ;
    rdfs:comment 'Human-readable description of the clinical stage corresponding to stage_code (e.g., \'Stage III Non-Small Cell Lung Cancer\', \'CKD Stage 4\'). Stored for reporting clarity.' ;
    rdfs:domain ind:Problem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allergyId rdf:type rdf:Property ;
    rdfs:label 'Allergy Id' ;
    rdfs:comment 'Unique surrogate identifier for each patient allergy or adverse reaction record in the clinical data product. Primary key for the allergy entity in the Silver Layer lakehouse.' ;
    rdfs:domain ind:Allergy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:allergenDrugMasterId rdf:type rdf:Property ;
    rdfs:label 'Allergen Drug Master Id' ;
    rdfs:comment 'Foreign key linking to pharmacy.drug_master. Business justification: Allergy checking against ordered/dispensed medications is critical patient safety function. Every CPOE and pharmacy system implements drug-allergy interaction screening. Required for meaningful use an' ;
    rdfs:domain ind:Allergy ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DrugMaster .

ind:allergyClinicianId rdf:type rdf:Property ;
    rdfs:label 'Allergy Clinician Id' ;
    rdfs:domain ind:Allergy ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:confirmatoryTestResultId rdf:type rdf:Property ;
    rdfs:label 'Confirmatory Test Result Id' ;
    rdfs:comment 'Foreign key linking to laboratory.test_result. Business justification: Drug/food allergies confirmed via lab testing (specific IgE panels, tryptase levels). Role prefix \'confirmatory_\' indicates diagnostic purpose. Important for allergy verification and de-labeling initi' ;
    rdfs:domain ind:Allergy ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TestResult .

ind:ndcDrugId rdf:type rdf:Property ;
    rdfs:label 'Ndc Drug Id' ;
    rdfs:comment 'Foreign key linking to reference.ndc_drug. Business justification: Drug allergy identification for medication reconciliation, e-prescribing safety checks, and formulary management. Pharmacy systems use NDC codes to link allergies to specific drug products and active ' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:NdcDrug .

ind:pharmacogenomicsResultId rdf:type rdf:Property ;
    rdfs:label 'Pharmacogenomics Result Id' ;
    rdfs:comment 'Link to pharmacogenomics result if allergy is genetically determined' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PharmacogenomicsResult .

ind:primaryAllergyClinicianId rdf:type rdf:Property ;
    rdfs:label 'Primary Allergy Clinician Id' ;
    rdfs:comment 'Reference to the clinician (physician, nurse, pharmacist) who documented or entered this allergy record into the Electronic Health Record (EHR). Supports audit and Clinical Documentation Improvement (CDI) workflows.' ;
    rdfs:domain ind:Allergy ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:alertOverrideReason rdf:type rdf:Property ;
    rdfs:label 'Alert Override Reason' ;
    rdfs:comment 'Clinical justification documented when a provider overrides a drug allergy alert during Computerized Physician Order Entry (CPOE). Required for regulatory compliance and medication safety audits. Null if no override has occurred.' ;
    rdfs:domain ind:Allergy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allergenName rdf:type rdf:Property ;
    rdfs:label 'Allergen Name' ;
    rdfs:comment 'The free-text or standardized name of the substance causing the allergic or adverse reaction (e.g., \'Penicillin\', \'Peanuts\', \'Latex\', \'Iodinated Contrast Media\'). Primary human-readable identifier for the allergen.' ;
    rdfs:domain ind:Allergy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allergenType rdf:type rdf:Property ;
    rdfs:label 'Allergen Type' ;
    rdfs:comment 'Classification of the allergen category. Drives clinical decision support rules and patient safety alerts. [ENUM-REF-CANDIDATE: drug|food|environmental|contrast_media|latex|insect_venom|other — promote to reference product]' ;
    rdfs:domain ind:Allergy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allergyCategory rdf:type rdf:Property ;
    rdfs:label 'Allergy Category' ;
    rdfs:comment 'Distinguishes between a true immunological allergy, a non-immunological intolerance (e.g., GI upset from NSAIDs), and a documented side effect. Critical for appropriate clinical decision support alert configuration and pharmacy dispensing rules.' ;
    rdfs:domain ind:Allergy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:criticality rdf:type rdf:Property ;
    rdfs:label 'Criticality' ;
    rdfs:comment 'Assessment of the potential clinical risk if the patient is re-exposed to the allergen. \'High\' indicates risk of life-threatening reaction. Distinct from severity (which describes the past reaction); criticality predicts future risk. Aligns with HL7 FHIR AllergyIntolerance.criticality.' ;
    rdfs:domain ind:Allergy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataQualityFlag rdf:type rdf:Property ;
    rdfs:label 'Data Quality Flag' ;
    rdfs:comment 'Indicates the data quality assessment status of this allergy record as determined during ETL processing into the Silver Layer. Supports data stewardship workflows and Clinical Documentation Improvement (CDI) initiatives.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:deletedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Deleted Timestamp' ;
    rdfs:comment 'The date and timestamp when this allergy record was soft-deleted in the source EHR system. Null if the record has not been deleted. Supports audit trail requirements under HIPAA and HIM standards.' ;
    rdfs:domain ind:Allergy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:fhirResourceReference rdf:type rdf:Property ;
    rdfs:label 'Fhir Resource Reference' ;
    rdfs:comment 'The HL7 Fast Healthcare Interoperability Resources (FHIR) AllergyIntolerance resource identifier. Enables interoperability with Health Information Exchanges (HIE), patient portals, and external clinical systems via FHIR APIs.' ;
    rdfs:domain ind:Clinical ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:informationSource rdf:type rdf:Property ;
    rdfs:label 'Information Source' ;
    rdfs:comment 'Identifies who provided the allergy information (e.g., patient self-report, caregiver, prior medical record, pharmacy records). Affects the confidence level and verification workflow for the allergy record.' ;
    rdfs:domain ind:Allergy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isDeleted rdf:type rdf:Property ;
    rdfs:label 'Is Deleted' ;
    rdfs:comment 'Indicates whether this allergy record has been soft-deleted in the source EHR system. Soft-deleted records are retained in the Silver Layer for audit and Health Information Management (HIM) compliance purposes rather than being physically removed.' ;
    rdfs:domain ind:Allergy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isNoKnownAllergy rdf:type rdf:Property ;
    rdfs:label 'Is No Known Allergy' ;
    rdfs:comment 'Indicates that the patient has been explicitly assessed and confirmed to have No Known Allergies (NKA). Distinct from an empty allergy list, which may indicate incomplete documentation. Critical for patient safety and Joint Commission compliance.' ;
    rdfs:domain ind:Allergy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isNoKnownDrugAllergy rdf:type rdf:Property ;
    rdfs:label 'Is No Known Drug Allergy' ;
    rdfs:comment 'Indicates that the patient has been explicitly assessed and confirmed to have No Known Drug Allergies (NKDA). Specifically scoped to drug allergens to support pharmacy safety checks and CPOE alert configuration.' ;
    rdfs:domain ind:Allergy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ndfRtCode rdf:type rdf:Property ;
    rdfs:label 'Ndf Rt Code' ;
    rdfs:comment 'The National Drug File – Reference Terminology (NDF-RT) code for drug allergens, enabling pharmacological class-level allergy checking (e.g., all penicillin-class antibiotics). Used in drug allergy cross-sensitivity analysis.' ;
    rdfs:domain ind:Allergy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:note rdf:type rdf:Property ;
    rdfs:label 'Note' ;
    rdfs:comment 'Free-text clinical notes or additional comments documented by the clinician regarding this allergy record (e.g., details about the reaction, treatment administered, cross-sensitivity concerns). Supports Clinical Documentation Improvement (CDI) workflows.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:overrideTimestamp rdf:type rdf:Property ;
    rdfs:label 'Override Timestamp' ;
    rdfs:comment 'Date and time when the allergy alert was overridden by the provider during CPOE. Supports medication safety audit trails. Null if no override has occurred.' ;
    rdfs:domain ind:Allergy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:pharmacogenomicBasisFlag rdf:type rdf:Property ;
    rdfs:label 'Pharmacogenomic Basis Flag' ;
    rdfs:comment 'Indicates whether this allergy/intolerance has a pharmacogenomic basis' ;
    rdfs:domain ind:Allergy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:phiAccessRestricted rdf:type rdf:Property ;
    rdfs:label 'Phi Access Restricted' ;
    rdfs:comment 'Indicates whether access to this allergy record is subject to additional Protected Health Information (PHI) access restrictions (e.g., VIP patient, sensitive condition). When true, row-level security controls are applied per HIPAA Privacy Rule requirements.' ;
    rdfs:domain ind:Allergy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reactionDescription rdf:type rdf:Property ;
    rdfs:label 'Reaction Description' ;
    rdfs:comment 'Free-text clinical description of the adverse reaction observed or reported by the patient (e.g., \'hives and facial swelling\', \'anaphylactic shock requiring epinephrine\'). Captured from clinical documentation in Epic ClinDoc or Cerner PowerChart.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reactionRoute rdf:type rdf:Property ;
    rdfs:label 'Reaction Route' ;
    rdfs:comment 'The route of exposure through which the allergic reaction occurred (e.g., oral ingestion, intravenous administration, topical contact). Informs clinical decision support rules for route-specific allergy alerts. [ENUM-REF-CANDIDATE: oral|intravenous|topical|inhalation|subcutaneous|intramuscular|other — promote to reference product]' ;
    rdfs:domain ind:Allergy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reactionSnomedCode rdf:type rdf:Property ;
    rdfs:label 'Reaction Snomed Code' ;
    rdfs:comment 'The SNOMED CT concept code representing the clinical manifestation of the allergic reaction (e.g., urticaria, anaphylaxis, angioedema). Enables structured clinical reporting and interoperability via HL7 FHIR.' ;
    rdfs:domain ind:Allergy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reconciliationDate rdf:type rdf:Property ;
    rdfs:label 'Reconciliation Date' ;
    rdfs:comment 'The date on which this allergy record was last reviewed and reconciled as part of a medication reconciliation process. Supports compliance with The Joint Commission NPSG.03.06.01 and CMS discharge planning requirements.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reconciliationStatus rdf:type rdf:Property ;
    rdfs:label 'Reconciliation Status' ;
    rdfs:comment 'Indicates whether this allergy has been reviewed and reconciled during a medication reconciliation process (e.g., at admission, discharge, or care transitions). Supports Transitions of Care compliance and The Joint Commission NPSG requirements.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recordedDate rdf:type rdf:Property ;
    rdfs:label 'Recorded Date' ;
    rdfs:comment 'The date and timestamp when this allergy record was first entered into the Electronic Health Record (EHR) system. Represents the RECORD_AUDIT_CREATED canonical category for this entity. Used for audit trails and Clinical Documentation Improvement (CDI) workflows.' ;
    rdfs:domain ind:Allergy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:sourceSystemAllergyCode rdf:type rdf:Property ;
    rdfs:label 'Source System Allergy Code' ;
    rdfs:comment 'The native identifier for this allergy record in the originating operational system (e.g., Epic allergy ID, Cerner allergy ID). Enables traceability back to the system of record for reconciliation and audit.' ;
    rdfs:domain ind:Allergy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allergyStatus rdf:type rdf:Property ;
    rdfs:label 'Allergy Status' ;
    rdfs:domain ind:Allergy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:immunizationId rdf:type rdf:Property ;
    rdfs:label 'Immunization Id' ;
    rdfs:comment 'Unique surrogate identifier for each immunization administration record in the lakehouse silver layer. Primary key for this data product.' ;
    rdfs:domain ind:Immunization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:immunizationClinicianId rdf:type rdf:Property ;
    rdfs:label 'Immunization Clinician Id' ;
    rdfs:domain ind:Immunization ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:primaryCarePhysicianClinicianId rdf:type rdf:Property ;
    rdfs:label 'Primary Care Physician Clinician Id' ;
    rdfs:comment 'Reference to the patient\'s Primary Care Physician (PCP) at the time of immunization. Supports care coordination, preventive care gap closure, and HEDIS reporting for immunization measures.' ;
    rdfs:domain ind:Immunization ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:tertiaryImmunizationOrderingProviderClinicianId rdf:type rdf:Property ;
    rdfs:label 'Tertiary Immunization Ordering Provider Clinician Id' ;
    rdfs:comment 'Reference to the provider who ordered or authorized the immunization, which may differ from the administering provider. Supports Computerized Physician Order Entry (CPOE) traceability.' ;
    rdfs:domain ind:Immunization ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:vaccineDrugMasterId rdf:type rdf:Property ;
    rdfs:label 'Vaccine Drug Master Id' ;
    rdfs:comment 'Foreign key linking to pharmacy.drug_master. Business justification: Immunizations are pharmaceutical products tracked in inventory and formulary systems. Vaccine administration requires drug master reference for lot tracking, expiration management, recall notification' ;
    rdfs:domain ind:Immunization ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DrugMaster .

ind:administrationRouteCode rdf:type rdf:Property ;
    rdfs:label 'Administration Route Code' ;
    rdfs:comment 'The coded route by which the vaccine was administered (e.g., \'IM\' for intramuscular, \'SC\' for subcutaneous, \'PO\' for oral, \'IN\' for intranasal). Follows NCI Thesaurus / HL7 route of administration codes.' ;
    rdfs:domain ind:Immunization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:administrationSiteCode rdf:type rdf:Property ;
    rdfs:label 'Administration Site Code' ;
    rdfs:comment 'Coded anatomical site where the vaccine was injected or administered (e.g., \'LA\' for left arm deltoid, \'RT\' for right thigh). Uses HL7 v2 or SNOMED CT body site codes. Required for adverse event documentation. [ENUM-REF-CANDIDATE: LA|RA|LT|RT|LG|RG|ABD|NASAL|ORAL — promote to reference product]' ;
    rdfs:domain ind:Immunization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:administrationStatus rdf:type rdf:Property ;
    rdfs:label 'Administration Status' ;
    rdfs:comment 'Current lifecycle status of the immunization record indicating whether the vaccine was successfully administered, not given, or entered in error. Aligns with HL7 FHIR Immunization.status value set.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:administrationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Administration Timestamp' ;
    rdfs:comment 'The exact date and time the vaccine was administered to the patient. This is the principal real-world event timestamp for the immunization record. Sourced from Epic or Cerner immunization module.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:clinicalNote rdf:type rdf:Property ;
    rdfs:label 'Clinical Note' ;
    rdfs:comment 'Free-text clinical notes or comments documented by the administering provider regarding the immunization event, patient response, or special circumstances. Supports Clinical Documentation Improvement (CDI) workflows.' ;
    rdfs:domain ind:Clinical ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cohortOutreachFlag rdf:type rdf:Property ;
    rdfs:label 'Cohort Outreach Flag' ;
    rdfs:comment 'Whether immunization was result of population cohort outreach' ;
    rdfs:domain ind:Immunization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:doseNumberInSeries rdf:type rdf:Property ;
    rdfs:label 'Dose Number In Series' ;
    rdfs:comment 'The sequential dose number within the immunization series (e.g., 1 for first dose, 2 for second dose, 3 for booster). Used to track series completion and determine next dose eligibility.' ;
    rdfs:domain ind:Immunization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:doseQuantity rdf:type rdf:Property ;
    rdfs:label 'Dose Quantity' ;
    rdfs:comment 'The numeric quantity of vaccine administered in the specified dose unit of measure (e.g., 0.5 mL). Supports clinical documentation and adverse event investigation.' ;
    rdfs:domain ind:Immunization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:doseUnit rdf:type rdf:Property ;
    rdfs:label 'Dose Unit' ;
    rdfs:comment 'The unit of measure for the administered vaccine dose quantity (e.g., \'mL\', \'mg\'). Follows UCUM (Unified Code for Units of Measure) standards as used in HL7 FHIR.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fundingSourceCode rdf:type rdf:Property ;
    rdfs:label 'Funding Source Code' ;
    rdfs:comment 'Code identifying the funding source for the administered vaccine. \'VFC\' indicates Vaccines for Children program eligibility; \'317\' indicates CDC Section 317 public health grant funding. Required for state IIS reporting and VFC program compliance.' ;
    rdfs:domain ind:Immunization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:iisReported rdf:type rdf:Property ;
    rdfs:label 'Iis Reported' ;
    rdfs:comment 'Indicates whether this immunization record has been successfully reported to the state Immunization Information System (IIS) / immunization registry. Supports public health reporting compliance tracking.' ;
    rdfs:domain ind:Immunization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:iisReportedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Iis Reported Timestamp' ;
    rdfs:comment 'The date and time this immunization record was transmitted to the state Immunization Information System (IIS). Supports audit trail for public health reporting obligations.' ;
    rdfs:domain ind:Immunization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:lotNumber rdf:type rdf:Property ;
    rdfs:label 'Lot Number' ;
    rdfs:comment 'The manufacturer-assigned lot number for the specific vaccine vial or unit administered. Critical for adverse event tracking, FDA recall management, and Vaccine Adverse Event Reporting System (VAERS) reporting.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notGivenReasonCode rdf:type rdf:Property ;
    rdfs:label 'Not Given Reason Code' ;
    rdfs:comment 'Coded reason why the immunization was not administered when administration_status is \'not-done\'. Examples include patient refusal, contraindication, or vaccine unavailability. SNOMED CT coded.' ;
    rdfs:domain ind:Immunization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:precisionMedicineConsideration rdf:type rdf:Property ;
    rdfs:label 'Precision Medicine Consideration' ;
    rdfs:comment 'Notes on precision medicine considerations for immunization (e.g., immunocompromised genetic conditions)' ;
    rdfs:domain ind:Immunization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reactionDetail rdf:type rdf:Property ;
    rdfs:label 'Reaction Detail' ;
    rdfs:comment 'Free-text or coded description of the adverse reaction observed following vaccine administration. Supports VAERS reporting and clinical documentation. SNOMED CT coded when structured.' ;
    rdfs:domain ind:Immunization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reactionObserved rdf:type rdf:Property ;
    rdfs:label 'Reaction Observed' ;
    rdfs:comment 'Indicates whether an adverse reaction or side effect was observed following vaccine administration. When true, triggers adverse event documentation workflow and potential VAERS reporting.' ;
    rdfs:domain ind:Immunization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:seriesCompletionStatus rdf:type rdf:Property ;
    rdfs:label 'Series Completion Status' ;
    rdfs:comment 'Indicates the patient\'s current completion status for the immunization series as of this administration event. Supports population health management, HEDIS measure reporting, and preventive care outreach.' ;
    rdfs:domain ind:Immunization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:seriesDosesRequired rdf:type rdf:Property ;
    rdfs:label 'Series Doses Required' ;
    rdfs:comment 'The total number of doses required to complete the immunization series as defined by the CDC Advisory Committee on Immunization Practices (ACIP) schedule (e.g., 2 for Hepatitis B, 3 for HPV).' ;
    rdfs:domain ind:Immunization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:seriesName rdf:type rdf:Property ;
    rdfs:label 'Series Name' ;
    rdfs:comment 'The name of the immunization series or protocol to which this dose belongs (e.g., \'COVID-19 Primary Series\', \'Hepatitis B 3-Dose Series\', \'Childhood Immunization Schedule\'). Supports series completion tracking.' ;
    rdfs:domain ind:Immunization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:immunizationStatus rdf:type rdf:Property ;
    rdfs:label 'Immunization Status' ;
    rdfs:domain ind:Immunization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vaersReported rdf:type rdf:Property ;
    rdfs:label 'Vaers Reported' ;
    rdfs:comment 'Indicates whether an adverse event following this immunization was reported to the FDA/CDC Vaccine Adverse Event Reporting System (VAERS). Required for pharmacovigilance and regulatory compliance.' ;
    rdfs:domain ind:Immunization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:vfcEligibilityCode rdf:type rdf:Property ;
    rdfs:label 'Vfc Eligibility Code' ;
    rdfs:comment 'CDC-assigned Vaccines for Children (VFC) eligibility category code for the patient at time of administration (e.g., V01=Medicaid eligible, V02=Uninsured, V03=American Indian/Alaska Native, V04=Underinsured). Required for VFC program billing and compliance reporting.' ;
    rdfs:domain ind:Immunization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:visDocumentType rdf:type rdf:Property ;
    rdfs:label 'Vis Document Type' ;
    rdfs:comment 'The type or name of the CDC Vaccine Information Statement (VIS) provided to the patient or guardian prior to administration (e.g., \'Influenza VIS\', \'COVID-19 mRNA VIS\'). Required by the National Childhood Vaccine Injury Act (NCVIA).' ;
    rdfs:domain ind:Immunization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:visPresentationDate rdf:type rdf:Property ;
    rdfs:label 'Vis Presentation Date' ;
    rdfs:comment 'The date the Vaccine Information Statement (VIS) was presented to the patient or legal guardian. Documents informed consent compliance per NCVIA requirements.' ;
    rdfs:domain ind:Immunization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:visPublicationDate rdf:type rdf:Property ;
    rdfs:label 'Vis Publication Date' ;
    rdfs:comment 'The CDC publication date of the Vaccine Information Statement (VIS) provided to the patient. Required for NCVIA compliance documentation and immunization registry reporting.' ;
    rdfs:domain ind:Immunization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:vitalSignId rdf:type rdf:Property ;
    rdfs:label 'Vital Sign Id' ;
    rdfs:comment 'Unique surrogate identifier for each vital sign measurement record in the lakehouse silver layer. Primary key for the vital_sign data product.' ;
    rdfs:domain ind:VitalSign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:equipmentAssetId rdf:type rdf:Property ;
    rdfs:label 'Equipment Asset Id' ;
    rdfs:comment 'Reference to the medical device (bedside monitor, pulse oximeter, thermometer, sphygmomanometer) used to capture the measurement. Supports device integration pipeline traceability and device-level quality audits.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EquipmentAsset .

ind:marRecordId rdf:type rdf:Property ;
    rdfs:label 'Mar Record Id' ;
    rdfs:comment 'Foreign key linking to pharmacy.mar_record. Business justification: Vital signs documented at medication administration time for high-risk medications (BP before antihypertensives, HR before beta-blockers, glucose before insulin). Required for safe medication administ' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MarRecord .

ind:previousVitalSignId rdf:type rdf:Property ;
    rdfs:label 'Previous Vital Sign Id' ;
    rdfs:comment 'Reference to the prior version of this vital sign record when observation_status is \'amended\' or \'corrected\'. Enables amendment chain traceability and supports audit requirements for clinical documentation integrity.' ;
    rdfs:domain ind:VitalSign ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:VitalSign .

ind:rpmDeviceReadingId rdf:type rdf:Property ;
    rdfs:label 'Rpm Device Reading Id' ;
    rdfs:comment 'Link to RPM device reading if vital originated from remote monitoring' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RpmDeviceReading .

ind:abnormalFlag rdf:type rdf:Property ;
    rdfs:label 'Abnormal Flag' ;
    rdfs:comment 'Interpretation flag indicating whether the measured value falls within, below, or above the reference range. \'critical_low\' and \'critical_high\' trigger immediate clinical notification per facility policy. Supports sepsis screening, EWS alerting, and clinical deterioration detection workflows.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:amendedReason rdf:type rdf:Property ;
    rdfs:label 'Amended Reason' ;
    rdfs:comment 'The clinical or administrative reason provided when a vital sign record is amended, corrected, or marked as entered-in-error (e.g., \'transcription error\', \'wrong patient\', \'device malfunction\', \'duplicate entry\'). Populated only when observation_status is \'amended\', \'corrected\', or \'entered-in-error\'. Supports CDI audit trails and data quality governance.' ;
    rdfs:domain ind:VitalSign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:careUnit rdf:type rdf:Property ;
    rdfs:label 'Care Unit' ;
    rdfs:comment 'The clinical care unit or department where the patient was located when the vital sign was measured (e.g., \'ICU\', \'ED\', \'Medical/Surgical\', \'OR\', \'PACU\', \'Step-Down\'). Supports unit-level benchmarking, staffing analytics, and HAI surveillance.' ;
    rdfs:domain ind:VitalSign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Documented Timestamp' ;
    rdfs:comment 'The date and time when the vital sign measurement was entered or finalized in the EHR system (Epic ClinDoc flowsheet or Cerner PowerChart). May differ from measurement_timestamp when documentation is retrospective. Used for CDI audit trails and documentation timeliness reporting.' ;
    rdfs:domain ind:Clinical ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:ewsScoreContribution rdf:type rdf:Property ;
    rdfs:label 'Ews Score Contribution' ;
    rdfs:comment 'The numeric score contribution of this individual vital sign measurement to the composite Early Warning Score (EWS), Modified Early Warning Score (MEWS), or National Early Warning Score (NEWS/NEWS2). Scored 0–3 per parameter per NEWS2 methodology. Supports real-time clinical deterioration detection and rapid response team activation.' ;
    rdfs:domain ind:VitalSign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ewsScoreType rdf:type rdf:Property ;
    rdfs:label 'Ews Score Type' ;
    rdfs:comment 'Identifies the specific early warning scoring system used to derive the ews_score_contribution for this vital sign (e.g., NEWS2 for adult inpatients, PEWS for pediatric patients, MEWS for general ward use). Allows multi-system EWS coexistence in the same dataset.' ;
    rdfs:domain ind:VitalSign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:flowsheetRowCode rdf:type rdf:Property ;
    rdfs:label 'Flowsheet Row Code' ;
    rdfs:comment 'The source system flowsheet row identifier from Epic ClinDoc or Cerner PowerChart that uniquely identifies the flowsheet template row from which this vital sign was extracted. Supports ETL lineage, source system reconciliation, and re-ingestion deduplication.' ;
    rdfs:domain ind:VitalSign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gcsComponent rdf:type rdf:Property ;
    rdfs:label 'Gcs Component' ;
    rdfs:comment 'Identifies which component of the Glasgow Coma Scale (GCS) is represented when observation_type is \'gcs_total\' or a GCS sub-score (Eye Opening E1-E4, Verbal Response V1-V5, Motor Response M1-M6, or Total 3-15). Null for non-GCS vital sign observations. Supports neurological assessment trending and ICU severity scoring.' ;
    rdfs:domain ind:VitalSign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isPatientReported rdf:type rdf:Property ;
    rdfs:label 'Is Patient Reported' ;
    rdfs:comment 'Indicates whether the vital sign value was self-reported by the patient (True), such as home blood pressure readings, pain scores, or weight from a patient portal or remote monitoring program. Distinguishes patient-generated health data (PGHD) from clinician-measured values for analytics and clinical decision support.' ;
    rdfs:domain ind:VitalSign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isTelemetryDerived rdf:type rdf:Property ;
    rdfs:label 'Is Telemetry Derived' ;
    rdfs:comment 'Indicates whether the vital sign measurement was automatically captured from a continuous bedside telemetry or patient monitoring device (True) versus manually entered by a clinician (False). Supports differentiation of high-frequency device-generated data from manually documented assessments in time-series analytics.' ;
    rdfs:domain ind:VitalSign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:measurementMethod rdf:type rdf:Property ;
    rdfs:label 'Measurement Method' ;
    rdfs:comment 'The clinical method used to obtain the vital sign measurement (e.g., \'auscultation\' for BP, \'pulse oximetry\' for SpO2, \'tympanic\' or \'oral\' or \'rectal\' or \'axillary\' for temperature, \'Doppler\' for BP). Encoded using SNOMED CT method codes where applicable. Affects clinical interpretation and normal range thresholds.' ;
    rdfs:domain ind:VitalSign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:measurementTimestamp rdf:type rdf:Property ;
    rdfs:label 'Measurement Timestamp' ;
    rdfs:comment 'The precise date and time when the vital sign measurement was physically taken from the patient. This is the principal clinical event time, distinct from the documentation timestamp. Critical for time-series trending, EWS/MEWS/NEWS calculations, and sepsis screening time-to-treatment metrics. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.' ;
    rdfs:domain ind:VitalSign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:numericValue rdf:type rdf:Property ;
    rdfs:label 'Numeric Value' ;
    rdfs:comment 'The principal quantitative measured value of the vital sign observation (e.g., 120 for systolic BP in mmHg, 98.6 for temperature in °F, 98 for SpO2 in %). Stored as a decimal to accommodate fractional values such as temperature and BMI. Null when the observation is non-numeric (e.g., qualitative pain descriptors).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:observationType rdf:type rdf:Property ;
    rdfs:label 'Observation Type' ;
    rdfs:comment 'Standardized enumeration of the vital sign observation category captured in this record. Each row represents a single atomic observation. Supports time-series analytics, EWS/MEWS/NEWS scoring, and sepsis screening. [ENUM-REF-CANDIDATE: blood_pressure_systolic|blood_pressure_diastolic|heart_rate|respiratory_rate|temperature|spo2|height|weight|bmi|pain_score|gcs_total — promote to reference product]' ;
    rdfs:domain ind:VitalSign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:oxygenDeliveryMethod rdf:type rdf:Property ;
    rdfs:label 'Oxygen Delivery Method' ;
    rdfs:comment 'The supplemental oxygen delivery method in use at the time of SpO2 or respiratory rate measurement (e.g., room air, nasal cannula, simple mask, non-rebreather mask, high-flow nasal cannula, mechanical ventilator). Null for non-respiratory vital signs. Critical context for SpO2 interpretation and NEWS2 scoring (Scale 1 vs Scale 2).' ;
    rdfs:domain ind:VitalSign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:patientPosition rdf:type rdf:Property ;
    rdfs:label 'Patient Position' ;
    rdfs:comment 'The patient\'s body position at the time of the vital sign measurement (e.g., sitting, standing, supine). Particularly relevant for blood pressure and orthostatic vital sign assessments. Encoded using SNOMED CT observable entity codes. [ENUM-REF-CANDIDATE: sitting|standing|supine|prone|left_lateral|right_lateral|semi-recumbent — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referenceRangeHigh rdf:type rdf:Property ;
    rdfs:label 'Reference Range High' ;
    rdfs:comment 'The upper bound of the normal reference range for this vital sign observation type, in the same unit of measure as numeric_value. Used for clinical alerting, EWS/MEWS/NEWS scoring, and out-of-range flagging.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:referenceRangeLow rdf:type rdf:Property ;
    rdfs:label 'Reference Range Low' ;
    rdfs:comment 'The lower bound of the normal reference range for this vital sign observation type, in the same unit of measure as numeric_value. Used for clinical alerting, EWS/MEWS/NEWS scoring, and out-of-range flagging. Age- and condition-adjusted ranges may differ from population norms.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rpmDeviceSourceFlag rdf:type rdf:Property ;
    rdfs:label 'Rpm Device Source Flag' ;
    rdfs:comment 'Indicates whether this vital sign was captured from a remote patient monitoring device' ;
    rdfs:domain ind:VitalSign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:vitalSignStatus rdf:type rdf:Property ;
    rdfs:label 'Vital Sign Status' ;
    rdfs:domain ind:VitalSign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supplementalOxygenFlowRate rdf:type rdf:Property ;
    rdfs:label 'Supplemental Oxygen Flow Rate' ;
    rdfs:comment 'The flow rate of supplemental oxygen in liters per minute (L/min) being administered to the patient at the time of the SpO2 or respiratory vital sign measurement. Null when oxygen_delivery_method is \'room_air\' or for non-respiratory observations. Supports NEWS2 Scale 2 scoring and respiratory therapy documentation.' ;
    rdfs:domain ind:VitalSign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:textValue rdf:type rdf:Property ;
    rdfs:label 'Text Value' ;
    rdfs:comment 'Free-text or coded string value for vital sign observations that are qualitative or semi-quantitative (e.g., pain descriptor \'mild\', \'moderate\', \'severe\'; GCS verbal response \'oriented\'; SpO2 trend \'improving\'). Null when numeric_value is populated.' ;
    rdfs:domain ind:VitalSign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:unitOfMeasure rdf:type rdf:Property ;
    rdfs:label 'Unit Of Measure' ;
    rdfs:comment 'The unit of measure for the numeric vital sign value using UCUM (Unified Code for Units of Measure) notation (e.g., \'mm[Hg]\' for blood pressure, \'/min\' for heart/respiratory rate, \'Cel\' or \'[degF]\' for temperature, \'%\' for SpO2, \'cm\' or \'[in_i]\' for height, \'kg\' or \'[lb_av]\' for weight, \'kg/m2\' for BMI, \'{score}\' for pain/GCS).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:observationId rdf:type rdf:Property ;
    rdfs:label 'Observation Id' ;
    rdfs:comment 'Unique surrogate identifier for each clinical observation record in the lakehouse silver layer. Primary key for the observation data product.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Observation .

ind:flowsheetRowId rdf:type rdf:Property ;
    rdfs:label 'Flowsheet Row Id' ;
    rdfs:comment 'The source EHR flowsheet row or template identifier that defines the observation type in the originating system (e.g., Epic ClinDoc flowsheet row ID, Cerner PowerChart flowsheet mnemonic). Enables precise source system reconciliation and CDI workflow support.' ;
    rdfs:domain ind:Clinical ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FlowsheetRow .

ind:aiDerivedFlag rdf:type rdf:Property ;
    rdfs:label 'Ai Derived Flag' ;
    rdfs:comment 'Indicates whether this observation was derived from an AI/ML model inference' ;
    rdfs:domain ind:Observation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:amendmentReason rdf:type rdf:Property ;
    rdfs:label 'Amendment Reason' ;
    rdfs:comment 'Free-text or coded reason provided by the clinician for amending or correcting this observation after initial documentation. Required for CDI audit trails and HIPAA amendment compliance. Null when is_amended is false.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assessmentComponent rdf:type rdf:Property ;
    rdfs:label 'Assessment Component' ;
    rdfs:comment 'The specific sub-component or domain of a multi-part assessment tool being scored in this observation record (e.g., \'Sensory Perception\' for Braden Scale, \'Eye Opening\' for GCS, \'Mood\' for PHQ-9 item 1). Enables granular component-level analysis.' ;
    rdfs:domain ind:Observation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assessmentScore rdf:type rdf:Property ;
    rdfs:label 'Assessment Score' ;
    rdfs:comment 'Total composite score produced by the standardized assessment tool identified in assessment_tool (e.g., Braden Scale total score 6-23, Morse Fall Scale score 0-125, PHQ-9 score 0-27, GCS total 3-15). Drives clinical decision support thresholds and quality metric calculations.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:assessmentTool rdf:type rdf:Property ;
    rdfs:label 'Assessment Tool' ;
    rdfs:comment 'Name of the standardized clinical assessment instrument or scoring tool used to generate this observation (e.g., Braden Scale, Morse Fall Scale, PHQ-9, GCS, Barthel Index, CAGE-AID, Columbia Suicide Severity Rating Scale, FIM). Supports nursing quality metrics and regulatory compliance reporting. [ENUM-REF-CANDIDATE: Braden Scale|Morse Fall Scale|PHQ-9|GCS|Barthel Index|CAGE-AID|Columbia Suicide Severity|FIM|SDOH Screening|Discharge Readiness — promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bodySystem rdf:type rdf:Property ;
    rdfs:label 'Body System' ;
    rdfs:comment 'Clinical body system or organ system to which this observation pertains (e.g., cardiovascular, respiratory, neurological, integumentary, musculoskeletal, gastrointestinal). Supports head-to-toe nursing assessment documentation and clinical analytics segmentation. [ENUM-REF-CANDIDATE: cardiovascular|respiratory|neurological|integumentary|musculoskeletal|gastrointestinal|genitourinary|endocrine|hematologic|psychiatric — promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:observationCategory rdf:type rdf:Property ;
    rdfs:label 'Observation Category' ;
    rdfs:comment 'High-level clinical category classifying the type of observation per HL7 FHIR value set (e.g., vital-signs, nursing, functional, screening, exam). Drives downstream routing, analytics segmentation, and FHIR Observation.category mapping. [ENUM-REF-CANDIDATE: vital-signs|laboratory|nursing|functional|screening|exam|social-history|imaging — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Observation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:createdDatetime rdf:type rdf:Property ;
    rdfs:label 'Created Datetime' ;
    rdfs:comment 'The date and time when this observation record was first created in the source system or ingested into the lakehouse. Supports audit trail requirements, data lineage, and HIPAA access log compliance.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:criticalValueNotifiedDatetime rdf:type rdf:Property ;
    rdfs:label 'Critical Value Notified Datetime' ;
    rdfs:comment 'Date and time when the responsible clinician was notified of a critical observation value, as required by The Joint Commission NPSG.02.03.01. Null when is_critical_value is false. Supports compliance auditing and response time measurement.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:dataAbsentReason rdf:type rdf:Property ;
    rdfs:label 'Data Absent Reason' ;
    rdfs:comment 'Coded reason explaining why an expected observation value is missing or not available (e.g., patient declined, not performed, error in collection). Required for FHIR conformance and supports data quality monitoring and completeness reporting. [ENUM-REF-CANDIDATE: unknown|asked-unknown|temp-unknown|not-asked|asked-declined|masked|not-applicable|error|not-performed — 9 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Observation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:datetime rdf:type rdf:Property ;
    rdfs:label 'Datetime' ;
    rdfs:comment 'The clinically effective date and time when the observation was made, measured, or assessed (not when it was entered into the system). This is the principal real-world event timestamp used for clinical trending, time-series analytics, and regulatory reporting.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:deviceType rdf:type rdf:Property ;
    rdfs:label 'Device Type' ;
    rdfs:comment 'Type of medical device or instrument used to obtain the observation (e.g., pulse oximeter, electronic thermometer, sphygmomanometer, glucometer, bedside monitor). Supports device performance tracking and FDA medical device reporting.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:externalObservationCode rdf:type rdf:Property ;
    rdfs:label 'External Observation Code' ;
    rdfs:comment 'Source system identifier for this observation as assigned by the originating Electronic Health Record (EHR) system (e.g., Epic ClinDoc flowsheet row ID, Cerner PowerChart result ID). Enables traceability back to the system of record.' ;
    rdfs:domain ind:Observation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interpretationFlag rdf:type rdf:Property ;
    rdfs:label 'Interpretation Flag' ;
    rdfs:comment 'Clinical interpretation of the observation value relative to the reference range (e.g., normal, abnormal, critical-high, critical-low). Drives clinical alerting, nursing escalation workflows, and quality metric calculations. Maps to HL7 FHIR Observation.interpretation. [ENUM-REF-CANDIDATE: normal|abnormal|critical-high|critical-low|high|low|indeterminate — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Observation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isAmended rdf:type rdf:Property ;
    rdfs:label 'Is Amended' ;
    rdfs:comment 'Boolean flag indicating whether this observation record has been amended or corrected after initial documentation. Supports Clinical Documentation Improvement (CDI) workflows, audit trails, and HIPAA amendment request tracking.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isCriticalValue rdf:type rdf:Property ;
    rdfs:label 'Is Critical Value' ;
    rdfs:comment 'Boolean flag indicating whether this observation result constitutes a critical (panic) value requiring immediate clinical notification per facility policy (e.g., GCS < 8, SpO2 < 85%). Drives critical value notification workflows and Joint Commission NPSG compliance.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:issuedDatetime rdf:type rdf:Property ;
    rdfs:label 'Issued Datetime' ;
    rdfs:comment 'The date and time the observation result was made available or released in the EHR system (e.g., when a nurse signed and released the flowsheet entry). Distinct from observation_datetime which captures when the measurement occurred.' ;
    rdfs:domain ind:Observation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:localCode rdf:type rdf:Property ;
    rdfs:label 'Local Code' ;
    rdfs:comment 'Facility- or system-specific code for the observation as defined in the source EHR (e.g., Epic flowsheet row ID, Cerner mnemonic). Used for source system reconciliation when a standard LOINC code is not yet mapped.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:methodCode rdf:type rdf:Property ;
    rdfs:label 'Method Code' ;
    rdfs:comment 'SNOMED CT or LOINC method code describing the technique or procedure used to obtain the observation (e.g., \'371911009\' for auscultation, \'113011001\' for palpation, non-invasive vs invasive blood pressure measurement). Supports clinical accuracy and reproducibility.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:presenceStatus rdf:type rdf:Property ;
    rdfs:label 'Presence Status' ;
    rdfs:comment 'Indicates whether the clinical finding or condition being observed is present, absent, or unknown for this patient at the time of observation. Critical for problem list management, SNOMED CT post-coordination, and population health stratification.' ;
    rdfs:domain ind:Observation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subcategory rdf:type rdf:Property ;
    rdfs:label 'Subcategory' ;
    rdfs:comment 'Finer-grained clinical classification within the observation_category (e.g., fall-risk, pressure-injury, neurological, wound, intake-output, behavioral-health, sdoh, discharge-readiness). Supports nursing quality metrics and Joint Commission compliance reporting. [ENUM-REF-CANDIDATE: fall-risk|pressure-injury|neurological|wound|intake-output|behavioral-health|sdoh|discharge-readiness|pain|functional-status — promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:updatedDatetime rdf:type rdf:Property ;
    rdfs:label 'Updated Datetime' ;
    rdfs:comment 'The date and time when this observation record was most recently modified in the source system or updated in the lakehouse silver layer. Supports incremental ETL processing, CDI workflows, and audit trail requirements.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:valueCoded rdf:type rdf:Property ;
    rdfs:label 'Value Coded' ;
    rdfs:comment 'The coded result value when the observation is expressed as a standardized code (e.g., SNOMED CT code \'260385009\' for negative, \'10828004\' for positive, or a LOINC answer list code). Used for coded clinical findings, presence/absence, and assessment scale responses.' ;
    rdfs:domain ind:Observation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:valueCodedSystem rdf:type rdf:Property ;
    rdfs:label 'Value Coded System' ;
    rdfs:comment 'The coding system used for the coded observation value when the result is expressed as a code rather than a number (e.g., SNOMED-CT for clinical findings, LOINC answer lists). Null when value_numeric or value_text is used.' ;
    rdfs:domain ind:Observation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:valueNumeric rdf:type rdf:Property ;
    rdfs:label 'Value Numeric' ;
    rdfs:comment 'The quantitative measured value of the observation when the result is numeric (e.g., 98.6 for temperature, 120 for systolic blood pressure, 7 for GCS eye response score, 15 for Braden Scale total). Null when the observation result is coded or free-text.' ;
    rdfs:domain ind:Observation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:valueText rdf:type rdf:Property ;
    rdfs:label 'Value Text' ;
    rdfs:comment 'Free-text narrative value for observations that cannot be expressed numerically or as a coded value (e.g., wound description, clinical impression, nursing note excerpt). Contains Protected Health Information (PHI) and must be handled per HIPAA requirements.' ;
    rdfs:domain ind:Observation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:valueUnit rdf:type rdf:Property ;
    rdfs:label 'Value Unit' ;
    rdfs:comment 'The unit of measure for the numeric observation value using UCUM (Unified Code for Units of Measure) notation (e.g., \'degF\', \'mm[Hg]\', \'kg\', \'/min\', \'%\', \'mL\'). Required when value_numeric is populated.' ;
    rdfs:domain ind:Observation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accreditationSurveyId rdf:type rdf:Property ;
    rdfs:label 'Accreditation Survey Id' ;
    rdfs:comment 'Foreign key linking to quality.accreditation_survey. Business justification: Care plan documentation is reviewed during accreditation surveys for compliance with care planning standards. Surveyors assess care plan quality during tracer methodology. Essential for accreditation ' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AccreditationSurvey .

ind:activatedOrderSetId rdf:type rdf:Property ;
    rdfs:label 'Activated Order Set Id' ;
    rdfs:comment 'Foreign key linking to order.order_set. Business justification: Care plans activate order sets. Real workflow: CHF care plan triggers CHF admission order set. Essential for care pathway compliance tracking, order set utilization analysis, population health protoco' ;
    rdfs:domain ind:CarePlan ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Set .

ind:careClinicianId rdf:type rdf:Property ;
    rdfs:label 'Care Clinician Id' ;
    rdfs:comment 'Unique surrogate identifier for an individual care team member record (line item within the care team). Each member has their own assignment lifecycle within the parent team. Supports the member-level detail model described in the product specification.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:primaryCareCoordinatorClinicianId rdf:type rdf:Property ;
    rdfs:label 'Primary Care Coordinator Clinician Id' ;
    rdfs:comment 'Reference to the care coordinator or case manager assigned to oversee execution of this care plan, distinct from the authoring provider. Supports ACO care coordination workflows and population health management.' ;
    rdfs:domain ind:CarePlan ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:tertiaryCarePcpClinicianId rdf:type rdf:Property ;
    rdfs:label 'Tertiary Care Pcp Clinician Id' ;
    rdfs:comment 'Reference to the patient\'s Primary Care Physician (PCP) who should receive care plan summary and transition communications. Supports care continuity, ACO attribution, and CMS transitions of care quality measures.' ;
    rdfs:domain ind:CarePlan ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:authoredDate rdf:type rdf:Property ;
    rdfs:label 'Authored Date' ;
    rdfs:comment 'The calendar date on which the care plan was originally authored or first documented in the EHR. Distinct from the effective start date; captures the documentation event timestamp at day granularity.' ;
    rdfs:domain ind:CarePlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:behavioralHealthEpisodeLink rdf:type rdf:Property ;
    rdfs:label 'Behavioral Health Episode Link' ;
    rdfs:comment 'Link to behavioral health episode (SUD or crisis) for integrated care plans' ;
    rdfs:domain ind:CarePlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cdiReviewStatus rdf:type rdf:Property ;
    rdfs:label 'Cdi Review Status' ;
    rdfs:comment 'Status of the Clinical Documentation Improvement (CDI) review process for this care plan. CDI specialists review care plans to ensure diagnoses and clinical findings are accurately and completely documented to support appropriate DRG assignment and quality reporting.' ;
    rdfs:domain ind:CarePlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:carePlanDescription rdf:type rdf:Property ;
    rdfs:label 'Care Plan Description' ;
    rdfs:comment 'Free-text narrative description of the overall care plan, including clinical rationale, patient-specific context, and summary of the care approach. Authored by the clinician in the EHR.' ;
    rdfs:domain ind:CarePlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:externalPlanCode rdf:type rdf:Property ;
    rdfs:label 'External Plan Code' ;
    rdfs:comment 'The externally-known or source-system identifier for this care plan as assigned by the originating EHR (e.g., Epic Healthy Planet plan ID, Cerner PowerChart plan number). Supports HIE interoperability and cross-system reconciliation.' ;
    rdfs:domain ind:CarePlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:goalCount rdf:type rdf:Property ;
    rdfs:label 'Goal Count' ;
    rdfs:comment 'Total number of patient goals documented within this care plan. Supports care plan completeness scoring, CDI quality metrics, and population health reporting without requiring aggregation of goal detail records.' ;
    rdfs:domain ind:CarePlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:goalsAchievedCount rdf:type rdf:Property ;
    rdfs:label 'Goals Achieved Count' ;
    rdfs:comment 'Number of goals within this care plan that have reached \'achieved\' status. Used for outcomes reporting, VBP performance measurement, and ACO quality scoring.' ;
    rdfs:domain ind:CarePlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:intent rdf:type rdf:Property ;
    rdfs:label 'Intent' ;
    rdfs:comment 'Indicates the degree of authority and actionability of the care plan per HL7 FHIR intent value set. \'proposal\' is a suggestion; \'plan\' is an agreed-upon plan; \'order\' is a directive; \'option\' is a contingency.' ;
    rdfs:domain ind:CarePlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:patientConsentDate rdf:type rdf:Property ;
    rdfs:label 'Patient Consent Date' ;
    rdfs:comment 'Date on which the patient or authorized representative provided consent for this care plan. Required for HIPAA documentation and CMS regulatory compliance.' ;
    rdfs:domain ind:CarePlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:planStatus rdf:type rdf:Property ;
    rdfs:label 'Plan Status' ;
    rdfs:comment 'Current lifecycle state of the care plan per HL7 FHIR CarePlan status value set. \'draft\' indicates not yet activated; \'active\' is in use; \'on-hold\' is temporarily suspended; \'completed\' indicates all goals met; \'revoked\' indicates cancelled before completion.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planTitle rdf:type rdf:Property ;
    rdfs:label 'Plan Title' ;
    rdfs:comment 'Human-readable title or name of the care plan as displayed in the EHR (e.g., \'Diabetes Management Plan\', \'Post-Surgical Discharge Plan\', \'CHF Chronic Disease Management\').' ;
    rdfs:domain ind:CarePlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:populationHealthProgram rdf:type rdf:Property ;
    rdfs:label 'Population Health Program' ;
    rdfs:comment 'Name or code of the population health management program (e.g., \'Diabetes Registry\', \'CHF Disease Management\', \'Hypertension Control\', \'Preventive Care Outreach\') under which this care plan is managed. Supports HEDIS measure attribution and ACO program reporting.' ;
    rdfs:domain ind:CarePlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:precisionMedicinePlanFlag rdf:type rdf:Property ;
    rdfs:label 'Precision Medicine Plan Flag' ;
    rdfs:comment 'Indicates whether this care plan incorporates precision medicine/genomic findings' ;
    rdfs:domain ind:CarePlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:readmissionRiskLevel rdf:type rdf:Property ;
    rdfs:label 'Readmission Risk Level' ;
    rdfs:comment 'Clinician-assigned or algorithmically-derived readmission risk stratification for this patient at the time of care plan creation. Drives care management intensity and post-discharge follow-up scheduling. Supports CMS Hospital Readmissions Reduction Program (HRRP) compliance.' ;
    rdfs:domain ind:CarePlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewFrequency rdf:type rdf:Property ;
    rdfs:label 'Review Frequency' ;
    rdfs:comment 'Prescribed frequency at which this care plan should be formally reviewed and updated by the care team. Drives scheduling of care plan review encounters and supports NCQA PCMH and CMS chronic care management billing requirements. [ENUM-REF-CANDIDATE: daily|weekly|biweekly|monthly|quarterly|annually|as_needed — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:carePlanStatus rdf:type rdf:Property ;
    rdfs:label 'Care Plan Status' ;
    rdfs:domain ind:CarePlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transitionsOfCareFlag rdf:type rdf:Property ;
    rdfs:label 'Transitions Of Care Flag' ;
    rdfs:comment 'Indicates whether this care plan was created or updated specifically to support a transition of care event (e.g., hospital discharge to home, SNF transfer, ED to inpatient admission). Supports CMS Transitions of Care quality measures and readmission reduction programs.' ;
    rdfs:domain ind:Clinical ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:carePlanGoalId rdf:type rdf:Property ;
    rdfs:label 'Care Plan Goal Id' ;
    rdfs:comment 'Unique surrogate identifier for each individual clinical goal within a care plan. Primary key for this entity in the Silver Layer lakehouse.' ;
    rdfs:domain ind:CarePlanGoal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:supportingClinicalOrderId rdf:type rdf:Property ;
    rdfs:label 'Supporting Clinical Order Id' ;
    rdfs:comment 'Foreign key linking to order.clinical_order. Business justification: Care plan goals drive specific orders. Real workflow: goal to reduce A1C below 7 triggers quarterly lab orders. Essential for goal-directed care tracking, care gap closure, value-based care reporting,' ;
    rdfs:domain ind:CarePlanGoal ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ClinicalOrder .

ind:targetMeasureLoincCodeId rdf:type rdf:Property ;
    rdfs:label 'Target Measure Loinc Code Id' ;
    rdfs:comment 'Foreign key linking to reference.loinc_code. Business justification: Measurable goal definition for care plan tracking, outcome measurement, and patient engagement. Care coordinators use LOINC-coded goals to automatically track progress from lab results, vital signs, a' ;
    rdfs:domain ind:CarePlanGoal ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:LoincCode .

ind:targetObservationId rdf:type rdf:Property ;
    rdfs:label 'Target Observation Id' ;
    rdfs:comment 'Foreign key linking to clinical.observation. Business justification: Care plan goals often target specific observable measures (e.g., \'reduce HbA1c to <7%\', \'maintain systolic BP <140\'). Linking care_plan_goal to observation allows tracking goal achievement against act' ;
    rdfs:domain ind:CarePlanGoal ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Observation .

ind:targetTestResultId rdf:type rdf:Property ;
    rdfs:label 'Target Test Result Id' ;
    rdfs:comment 'Foreign key linking to laboratory.test_result. Business justification: Goal achievement measured by lab values (HbA1c<7% for diabetes control). Role prefix \'target_\' indicates goal measurement. Essential for value-based care reporting and patient engagement dashboards.' ;
    rdfs:domain ind:CarePlanGoal ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TestResult .

ind:achievedDate rdf:type rdf:Property ;
    rdfs:label 'Achieved Date' ;
    rdfs:comment 'The date on which the clinical goal was documented as achieved. Populated only when goal_status is \'achieved\'. Used for outcome measurement and quality reporting.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:achievementStatus rdf:type rdf:Property ;
    rdfs:label 'Achievement Status' ;
    rdfs:comment 'Clinical assessment of the degree to which the patient is progressing toward or has achieved the goal. Distinct from lifecycle status — captures clinical trajectory rather than workflow state. Aligns with HL7 FHIR R4 Goal.achievementStatus.' ;
    rdfs:domain ind:CarePlanGoal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:barrierNotes rdf:type rdf:Property ;
    rdfs:label 'Barrier Notes' ;
    rdfs:comment 'Free-text documentation of identified barriers preventing the patient from achieving this goal (e.g., financial constraints, transportation issues, health literacy). Supports Social Determinants of Health (SDOH) analysis and care coordination.' ;
    rdfs:domain ind:CarePlanGoal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cancelledDate rdf:type rdf:Property ;
    rdfs:label 'Cancelled Date' ;
    rdfs:comment 'The date on which this clinical goal was cancelled or discontinued. Populated only when goal_status is \'cancelled\'. Supports care plan audit and quality review.' ;
    rdfs:domain ind:CarePlanGoal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:careGapRelated rdf:type rdf:Property ;
    rdfs:label 'Care Gap Related' ;
    rdfs:comment 'Indicates whether this goal was created in response to an identified care gap (e.g., overdue preventive screening, uncontrolled chronic condition measure). Supports HEDIS gap closure tracking and value-based care reporting.' ;
    rdfs:domain ind:CarePlanGoal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:careTeamRole rdf:type rdf:Property ;
    rdfs:label 'Care Team Role' ;
    rdfs:comment 'Clinical role of the care team member primarily responsible for this goal (e.g., \'Primary Care Physician\', \'Care Manager\', \'Registered Nurse\', \'Dietitian\'). Supports care team coordination and workload analytics.' ;
    rdfs:domain ind:CarePlanGoal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:currentValue rdf:type rdf:Property ;
    rdfs:label 'Current Value' ;
    rdfs:comment 'Most recently recorded value for the LOINC-coded target measure, representing the patient\'s current status relative to the goal target. Enables real-time progress tracking and gap analysis.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:currentValueDate rdf:type rdf:Property ;
    rdfs:label 'Current Value Date' ;
    rdfs:comment 'Date on which the current measured value was recorded. Used to assess recency of progress data and identify goals with stale measurements.' ;
    rdfs:domain ind:CarePlanGoal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:expressedByType rdf:type rdf:Property ;
    rdfs:label 'Expressed By Type' ;
    rdfs:comment 'Indicates who expressed or originated this goal — the patient themselves, a practitioner, a related person (family member), or a caregiver. Supports patient-centered care analytics and CAHPS reporting.' ;
    rdfs:domain ind:CarePlanGoal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fhirGoalReference rdf:type rdf:Property ;
    rdfs:label 'Fhir Goal Reference' ;
    rdfs:comment 'HL7 FHIR R4 logical resource ID for this goal, enabling interoperability with external systems, Health Information Exchanges (HIE), and patient-facing applications via FHIR APIs.' ;
    rdfs:domain ind:CarePlanGoal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:genomicTargetFlag rdf:type rdf:Property ;
    rdfs:label 'Genomic Target Flag' ;
    rdfs:comment 'Indicates whether this goal is based on genomic/biomarker targets' ;
    rdfs:domain ind:CarePlanGoal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:goalCategoryDisplay rdf:type rdf:Property ;
    rdfs:label 'Goal Category Display' ;
    rdfs:comment 'Human-readable display name corresponding to the SNOMED CT goal category code (e.g., \'Dietary Goal\', \'Exercise Goal\', \'Medication Adherence\'). Used in clinical reporting and care plan summaries.' ;
    rdfs:domain ind:CarePlanGoal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:goalCategorySnomedCode rdf:type rdf:Property ;
    rdfs:label 'Goal Category Snomed Code' ;
    rdfs:comment 'SNOMED CT coded category classifying the clinical domain of this goal (e.g., dietary goal, exercise goal, medication adherence goal, physiological goal). Enables standardized population health analytics and HEDIS reporting.' ;
    rdfs:domain ind:CarePlanGoal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:goalExternalCode rdf:type rdf:Property ;
    rdfs:label 'Goal External Code' ;
    rdfs:comment 'Source system identifier for this goal as assigned by the originating Electronic Health Record (EHR) system (e.g., Epic Healthy Planet goal ID). Supports cross-system reconciliation and audit traceability.' ;
    rdfs:domain ind:CarePlanGoal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:goalStatus rdf:type rdf:Property ;
    rdfs:label 'Goal Status' ;
    rdfs:comment 'Current lifecycle status of the clinical goal reflecting its progression from proposal through achievement or cancellation. Aligns with HL7 FHIR R4 Goal.lifecycleStatus value set.' ;
    rdfs:domain ind:CarePlanGoal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:goalTitle rdf:type rdf:Property ;
    rdfs:label 'Goal Title' ;
    rdfs:comment 'Short, human-readable title summarizing the clinical goal (e.g., \'Reduce HbA1c to below 7%\', \'Achieve 10,000 steps daily\'). Used in clinical dashboards and patient-facing care plan summaries.' ;
    rdfs:domain ind:CarePlanGoal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:patientAgreement rdf:type rdf:Property ;
    rdfs:label 'Patient Agreement' ;
    rdfs:comment 'Indicates whether the patient has agreed to and accepted this clinical goal as part of their care plan. Supports shared decision-making documentation and patient engagement analytics.' ;
    rdfs:domain ind:CarePlanGoal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sdohRelated rdf:type rdf:Property ;
    rdfs:label 'Sdoh Related' ;
    rdfs:comment 'Indicates whether this goal is related to Social Determinants of Health (SDOH) factors such as food insecurity, housing instability, or transportation barriers. Enables SDOH-stratified population health reporting.' ;
    rdfs:domain ind:CarePlanGoal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:carePlanGoalStatus rdf:type rdf:Property ;
    rdfs:label 'Care Plan Goal Status' ;
    rdfs:domain ind:CarePlanGoal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:statusChangedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Status Changed Timestamp' ;
    rdfs:comment 'Timestamp when the goal_status was most recently changed (e.g., from \'proposed\' to \'accepted\', or from \'in-progress\' to \'achieved\'). Enables lifecycle duration analytics and care management SLA reporting.' ;
    rdfs:domain ind:CarePlanGoal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:targetDate rdf:type rdf:Property ;
    rdfs:label 'Target Date' ;
    rdfs:comment 'The date by which the patient is expected to achieve this clinical goal. Used for care plan timeline management, overdue goal identification, and population health reporting.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:targetValue rdf:type rdf:Property ;
    rdfs:label 'Target Value' ;
    rdfs:comment 'Numeric target value the patient is expected to achieve for the specified LOINC-coded measure (e.g., 7.0 for HbA1c percentage, 130 for systolic blood pressure in mmHg). Used in progress tracking and outcome analytics.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:targetValueComparator rdf:type rdf:Property ;
    rdfs:label 'Target Value Comparator' ;
    rdfs:comment 'Relational comparator indicating the direction of the target (e.g., \'<=\' means the measured value should be less than or equal to the target). Enables precise goal evaluation logic in clinical decision support.' ;
    rdfs:domain ind:CarePlanGoal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetValueUnit rdf:type rdf:Property ;
    rdfs:label 'Target Value Unit' ;
    rdfs:comment 'Unit of measure for the numeric target value, expressed using UCUM (Unified Code for Units of Measure) notation (e.g., \'%\', \'mm[Hg]\', \'kg\', \'steps/d\'). Required for clinical interpretation and interoperability.' ;
    rdfs:domain ind:CarePlanGoal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:improvementInitiativeId rdf:type rdf:Property ;
    rdfs:label 'Improvement Initiative Id' ;
    rdfs:comment 'Foreign key linking to quality.improvement_initiative. Business justification: Quality initiatives often involve specific care teams (sepsis team, stroke team). Direct linkage enables tracking team-based initiative impact. Essential for care team performance improvement and acco' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ImprovementInitiative .

ind:primaryContactProviderClinicianId rdf:type rdf:Property ;
    rdfs:label 'Primary Contact Provider Clinician Id' ;
    rdfs:comment 'Reference to the care team member designated as the primary point of contact for the patient and family. May differ from the attending provider (e.g., a care coordinator or NP may be the primary contact). Supports care coordination and patient communication workflows.' ;
    rdfs:domain ind:CareTeam ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:careCoordinationLevel rdf:type rdf:Property ;
    rdfs:label 'Care Coordination Level' ;
    rdfs:comment 'Classification of the intensity of care coordination required for this team, based on patient complexity and care needs. Drives resource allocation, staffing decisions, and care management program enrollment.' ;
    rdfs:domain ind:CareTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cdiReviewFlag rdf:type rdf:Property ;
    rdfs:label 'Cdi Review Flag' ;
    rdfs:comment 'Indicates whether this care team record has been flagged for Clinical Documentation Improvement (CDI) review. CDI specialists use this flag to identify cases where care team documentation may require clarification to support accurate coding, DRG assignment, and reimbursement.' ;
    rdfs:domain ind:CareTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:coverageEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Coverage End Timestamp' ;
    rdfs:comment 'Precise timestamp when this care team member\'s coverage period ended. Used in conjunction with coverage_start_timestamp to define shift-level coverage windows and identify coverage gaps.' ;
    rdfs:domain ind:CareTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:coverageStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Coverage Start Timestamp' ;
    rdfs:comment 'Precise timestamp when this care team member\'s coverage period began (e.g., start of a shift or on-call rotation). More granular than member_start_date; used for shift-level coverage gap analysis and handoff documentation.' ;
    rdfs:domain ind:CareTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:ehrCareTeamCsn rdf:type rdf:Property ;
    rdfs:label 'Ehr Care Team Csn' ;
    rdfs:comment 'Epic-specific Contact Serial Number (CSN) uniquely identifying the care team context within an Epic encounter. Used for cross-referencing Epic ClinDoc records during ETL and data reconciliation.' ;
    rdfs:domain ind:CareTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:genomicsSpecialistIncluded rdf:type rdf:Property ;
    rdfs:label 'Genomics Specialist Included' ;
    rdfs:comment 'Indicates whether a genetics counselor or genomics specialist is on the care team' ;
    rdfs:domain ind:CareTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hieShared rdf:type rdf:Property ;
    rdfs:label 'Hie Shared' ;
    rdfs:comment 'Indicates whether this care team record has been shared via a Health Information Exchange (HIE) to external care partners (e.g., referring providers, ACO partners, post-acute facilities). Supports care coordination across organizational boundaries and HIE participation reporting.' ;
    rdfs:domain ind:CareTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isMultidisciplinary rdf:type rdf:Property ;
    rdfs:label 'Is Multidisciplinary' ;
    rdfs:comment 'Indicates whether this care team is formally designated as a multidisciplinary team (MDT), involving providers from two or more distinct clinical disciplines. MDT designation is relevant for complex case management, oncology tumor boards, and regulatory quality reporting.' ;
    rdfs:domain ind:CareTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isOnCall rdf:type rdf:Property ;
    rdfs:label 'Is On Call' ;
    rdfs:comment 'Indicates whether this care team member is currently designated as on-call for the patient. On-call designation determines who is contacted for urgent clinical decisions outside of normal coverage hours.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPrimaryContact rdf:type rdf:Property ;
    rdfs:label 'Is Primary Contact' ;
    rdfs:comment 'Indicates whether this care team member is designated as the primary point of contact for the patient and family within the team. Only one member per team should hold this designation at any given time.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPrimaryTeam rdf:type rdf:Property ;
    rdfs:label 'Is Primary Team' ;
    rdfs:comment 'Indicates whether this is the patient\'s primary care team (as opposed to a consulting or specialty team). A patient may have multiple concurrent care teams; this flag identifies the team with primary clinical accountability.' ;
    rdfs:domain ind:CareTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:memberEndDate rdf:type rdf:Property ;
    rdfs:label 'Member End Date' ;
    rdfs:comment 'Date on which this individual member\'s participation in the care team ended (e.g., due to rotation, discharge, or reassignment). Null for currently active members. Supports member lifecycle and coverage gap analysis.' ;
    rdfs:domain ind:CareTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:memberRoleCode rdf:type rdf:Property ;
    rdfs:label 'Member Role Code' ;
    rdfs:comment 'Standardized role code for the care team member\'s function within the team (e.g., SNOMED CT role codes or Epic-defined role codes such as \'ATT\' for Attending, \'RES\' for Resident, \'CON\' for Consultant). More granular than member_type.' ;
    rdfs:domain ind:CareTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:memberRoleName rdf:type rdf:Property ;
    rdfs:label 'Member Role Name' ;
    rdfs:comment 'Human-readable name of the care team member\'s role (e.g., \'Attending Physician\', \'Consulting Cardiologist\', \'Charge Nurse\', \'Clinical Pharmacist\'). Complements member_role_code for display in EHR panels and reports.' ;
    rdfs:domain ind:CareTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:memberStartDate rdf:type rdf:Property ;
    rdfs:label 'Member Start Date' ;
    rdfs:comment 'Date on which this individual member began participating in the care team. Supports member-level assignment lifecycle tracking, transitions of care documentation, and care coordination analytics.' ;
    rdfs:domain ind:CareTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:memberStatus rdf:type rdf:Property ;
    rdfs:label 'Member Status' ;
    rdfs:comment 'Current status of the individual care team member\'s participation. Active indicates current participation; inactive indicates the member has left the team; on_leave indicates temporary absence (e.g., vacation, LOA); removed indicates the member was explicitly removed from the team.' ;
    rdfs:domain ind:Clinical ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:memberType rdf:type rdf:Property ;
    rdfs:label 'Member Type' ;
    rdfs:comment 'Classification of the care team member by clinical role category. Physician includes MDs and DOs; NP = Nurse Practitioner; PA = Physician Assistant; RN = Registered Nurse; social_worker covers licensed clinical social workers; pharmacist covers clinical pharmacy staff; care_coordinator covers non-clinical coordination roles. [ENUM-REF-CANDIDATE: physician|np|pa|rn|social_worker|pharmacist|care_coordinator — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Clinical ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reasonDescription rdf:type rdf:Property ;
    rdfs:label 'Reason Description' ;
    rdfs:comment 'Free-text or decoded description of the clinical reason for the care team assignment (e.g., \'Complex heart failure management\', \'Post-surgical recovery\'). Complements reason_code for human-readable reporting.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemTeamCode rdf:type rdf:Property ;
    rdfs:label 'Source System Team Code' ;
    rdfs:comment 'Native identifier of the care team record in the originating operational system (e.g., Epic internal care team CSN or Cerner care team ID). Enables traceability back to the source EHR for reconciliation and audit.' ;
    rdfs:domain ind:CareTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:careTeamStatus rdf:type rdf:Property ;
    rdfs:label 'Care Team Status' ;
    rdfs:domain ind:CareTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:teamEndDate rdf:type rdf:Property ;
    rdfs:label 'Team End Date' ;
    rdfs:comment 'Date on which the care team was dissolved or the patient was discharged/transitioned out of this team\'s care. Null for currently active teams. Aligns with FHIR CareTeam.period.end.' ;
    rdfs:domain ind:CareTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:teamName rdf:type rdf:Property ;
    rdfs:label 'Team Name' ;
    rdfs:comment 'Human-readable name or label assigned to the care team (e.g., \'Cardiology Inpatient Team A\', \'Primary Care Team — Dr. Smith\'). Used for display in EHR care team panels and care coordination dashboards.' ;
    rdfs:domain ind:CareTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:teamStartDate rdf:type rdf:Property ;
    rdfs:label 'Team Start Date' ;
    rdfs:comment 'Date on which the care team became active and assumed clinical accountability for the patient. Used for transitions of care documentation and care coordination reporting. Aligns with FHIR CareTeam.period.start.' ;
    rdfs:domain ind:CareTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:teamStatus rdf:type rdf:Property ;
    rdfs:label 'Team Status' ;
    rdfs:comment 'Current lifecycle status of the care team record. Active indicates the team is currently providing care; inactive indicates the team has been dissolved or the patient discharged; proposed indicates a team pending activation; suspended indicates temporary pause; entered-in-error supports data correction workflows.' ;
    rdfs:domain ind:CareTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:teamType rdf:type rdf:Property ;
    rdfs:label 'Team Type' ;
    rdfs:comment 'Classification of the care team by care setting and organizational model. Inpatient teams are hospital-based; outpatient teams support ambulatory care; primary teams represent the patient\'s longitudinal PCP-led team; specialty teams are disease- or organ-specific; multidisciplinary teams span disciplines; transitional teams support transitions of care (e.g., discharge to SNF).' ;
    rdfs:domain ind:CareTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vbpProgramCode rdf:type rdf:Property ;
    rdfs:label 'Vbp Program Code' ;
    rdfs:comment 'Code identifying the value-based purchasing or alternative payment model (APM) program under which this care team operates (e.g., MSSP, BPCI-A, CPC+). Supports VBP performance tracking and regulatory reporting to CMS.' ;
    rdfs:domain ind:CareTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:careTeamMemberId rdf:type rdf:Property ;
    rdfs:label 'Care Team Member Id' ;
    rdfs:comment 'Unique surrogate identifier for each care team member record in the silver layer lakehouse. Primary key for this entity.' ;
    rdfs:domain ind:CareTeamMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:primaryCareClinicianId rdf:type rdf:Property ;
    rdfs:label 'Primary Care Clinician Id' ;
    rdfs:comment 'Reference to the clinician or provider record for this care team member. Identifies the individual practitioner (physician, NP, PA, RN, pharmacist, social worker, care coordinator, etc.) assigned to the team.' ;
    rdfs:domain ind:CareTeamMember ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:primaryCareEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Care Employee Id' ;
    rdfs:comment 'The system user identifier of the clinician or staff member who added this provider to the care team. Used for audit trail, accountability, and CDI (Clinical Documentation Improvement) workflows.' ;
    rdfs:domain ind:CareTeamMember ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:primaryCareTeamId rdf:type rdf:Property ;
    rdfs:label 'Primary Care Team Id' ;
    rdfs:comment 'Reference to the parent care team to which this member belongs. Links the individual membership record to the overarching care team construct.' ;
    rdfs:domain ind:CareTeamMember ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CareTeam .

ind:assignmentEndDate rdf:type rdf:Property ;
    rdfs:label 'Assignment End Date' ;
    rdfs:comment 'The date on which this provider\'s membership on the care team ended or is scheduled to end. Nullable for open-ended assignments. Used for historical care team queries and transitions of care documentation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:assignmentStartDate rdf:type rdf:Property ;
    rdfs:label 'Assignment Start Date' ;
    rdfs:comment 'The date on which this provider\'s membership on the care team became effective. Used to determine the period of clinical responsibility and for transitions of care documentation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:careTeamCategory rdf:type rdf:Property ;
    rdfs:label 'Care Team Category' ;
    rdfs:comment 'Classifies the care team type to which this member belongs: longitudinal (ongoing primary care), episode-based (specific inpatient stay), event-based (single procedure or visit), or condition-based (chronic disease management). Aligns with HL7 FHIR CareTeam.category.' ;
    rdfs:domain ind:CareTeamMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geneticCounselorFlag rdf:type rdf:Property ;
    rdfs:label 'Genetic Counselor Flag' ;
    rdfs:comment 'Indicates whether this team member is a genetic counselor' ;
    rdfs:domain ind:CareTeamMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:handoffTimestamp rdf:type rdf:Property ;
    rdfs:label 'Handoff Timestamp' ;
    rdfs:comment 'The date and time at which clinical responsibility was formally handed off from this care team member to another provider. Supports transitions of care documentation, Joint Commission handoff communication standards, and care continuity analytics.' ;
    rdfs:domain ind:CareTeamMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:isAttending rdf:type rdf:Property ;
    rdfs:label 'Is Attending' ;
    rdfs:comment 'Indicates whether this care team member holds the attending physician designation for the encounter or care episode. The attending physician bears primary clinical and legal responsibility for the patient\'s care. Critical for billing, documentation, and regulatory reporting.' ;
    rdfs:domain ind:CareTeamMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPcp rdf:type rdf:Property ;
    rdfs:label 'Is Pcp' ;
    rdfs:comment 'Indicates whether this care team member is the patient\'s designated Primary Care Physician (PCP). Used in population health management, care coordination, and payer attribution workflows.' ;
    rdfs:domain ind:CareTeamMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:removalReason rdf:type rdf:Property ;
    rdfs:label 'Removal Reason' ;
    rdfs:comment 'The reason this care team member was removed or deactivated from the care team (e.g., patient discharge, transfer, provider request, coverage end, credentialing issue). Used for care team audit trails and transitions of care documentation. [ENUM-REF-CANDIDATE: discharge|transfer|provider_request|patient_request|coverage_end|credentialing|other — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:roleCode rdf:type rdf:Property ;
    rdfs:label 'Role Code' ;
    rdfs:comment 'Standardized code representing the specific functional role of this member within the care team (e.g., attending physician, consulting physician, primary nurse, case manager). Sourced from Epic or Cerner role code tables and aligned with HL7 FHIR CareTeam participant role codes.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:roleName rdf:type rdf:Property ;
    rdfs:label 'Role Name' ;
    rdfs:comment 'Human-readable display name for the care team member\'s role (e.g., \'Attending Physician\', \'Primary Care Nurse\', \'Clinical Pharmacist\', \'Discharge Planner\'). Used in clinical documentation and care coordination interfaces.' ;
    rdfs:domain ind:CareTeamMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:snomedRoleCode rdf:type rdf:Property ;
    rdfs:label 'Snomed Role Code' ;
    rdfs:comment 'The SNOMED CT concept code representing the clinical role of this care team member. Enables semantic interoperability with FHIR-compliant systems and clinical decision support engines.' ;
    rdfs:domain ind:CareTeamMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemMemberCode rdf:type rdf:Property ;
    rdfs:label 'Source System Member Code' ;
    rdfs:comment 'The native identifier for this care team member record in the originating operational system (Epic ClinDoc, Cerner PowerChart, etc.). Used for data lineage, cross-system reconciliation, and ETL traceability.' ;
    rdfs:domain ind:CareTeamMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:careTeamMemberStatus rdf:type rdf:Property ;
    rdfs:label 'Care Team Member Status' ;
    rdfs:domain ind:CareTeamMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cdiQueryId rdf:type rdf:Property ;
    rdfs:label 'Cdi Query Id' ;
    rdfs:comment 'Unique surrogate identifier for each CDI query record issued to a provider. Primary key for the cdi_query data product. Entity role: TRANSACTION_HEADER — represents a discrete CDI workflow event with a full lifecycle (open, answered, expired, withdrawn).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CdiQuery .

ind:associatedIcd10CodeIcdCodeId rdf:type rdf:Property ;
    rdfs:label 'Associated Icd10 Code Icd Code Id' ;
    rdfs:comment 'Foreign key linking to reference.icd_code. Business justification: CDI query diagnosis validation for clinical documentation improvement, CC/MCC capture, and SOI/ROM assignment. CDI specialists use ICD-10 code attributes (CC flag, MCC flag, POA exempt) to identify do' ;
    rdfs:domain ind:CdiQuery ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:IcdCode .

ind:cdiWorksheetId rdf:type rdf:Property ;
    rdfs:label 'Cdi Worksheet Id' ;
    rdfs:comment 'Reference to the CDI encounter review worksheet from which this query was generated. Links individual queries to the broader encounter-level CDI review activity for holistic CDI program reporting.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CdiWorksheet .

ind:claimId rdf:type rdf:Property ;
    rdfs:label 'Claim Id' ;
    rdfs:comment 'Foreign key linking to claim.claim. Business justification: CDI queries directly impact claim DRG assignment and reimbursement. Revenue integrity requires linking query to claim for tracking documentation improvement impact, measuring query effectiveness, and ' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Claim .

ind:complianceAuditId rdf:type rdf:Property ;
    rdfs:label 'Compliance Audit Id' ;
    rdfs:comment 'Foreign key linking to compliance.audit. Business justification: CDI query programs are audited for appropriateness, physician response rates, and compliance with CMS guidelines. Compliance teams conduct audits of CDI query practices, requiring links between audit ' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Audit .

ind:invoiceId rdf:type rdf:Property ;
    rdfs:label 'Invoice Id' ;
    rdfs:comment 'Foreign key linking to billing.invoice. Business justification: CDI queries impact final DRG assignment and reimbursement for specific invoices. Revenue integrity operations track which invoices had CDI intervention to measure program ROI. Query outcomes directly ' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Invoice .

ind:queriedClinicalOrderId rdf:type rdf:Property ;
    rdfs:label 'Queried Clinical Order Id' ;
    rdfs:comment 'Foreign key linking to order.clinical_order. Business justification: CDI queries reference orders for documentation clarification. Real workflow: CDI specialist queries why antibiotic ordered without documented infection. Essential for clinical documentation improvemen' ;
    rdfs:domain ind:CdiQuery ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ClinicalOrder .

ind:radiologyReportId rdf:type rdf:Property ;
    rdfs:label 'Radiology Report Id' ;
    rdfs:comment 'Foreign key linking to radiology.report. Business justification: CDI specialists review radiology reports to identify undocumented diagnoses from incidental findings. Critical for DRG optimization, documentation improvement programs, and ensuring clinical documenta' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Report .

ind:supportingTestResultId rdf:type rdf:Property ;
    rdfs:label 'Supporting Test Result Id' ;
    rdfs:comment 'Foreign key linking to laboratory.test_result. Business justification: CDI queries reference lab results to support diagnosis clarification (elevated troponin→query for MI). Role prefix \'supporting_\' indicates documentation evidence. Critical for DRG optimization and com' ;
    rdfs:domain ind:Clinical ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TestResult .

ind:actualReimbursementImpact rdf:type rdf:Property ;
    rdfs:label 'Actual Reimbursement Impact' ;
    rdfs:comment 'Realized change in reimbursement (in USD) based on the final DRG assigned after CDI query resolution. Compared against expected_reimbursement_impact to measure CDI program effectiveness and forecast accuracy.' ;
    rdfs:domain ind:CdiQuery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:appealSupportFlag rdf:type rdf:Property ;
    rdfs:label 'Appeal Support Flag' ;
    rdfs:comment 'Indicates whether this CDI query was issued or retained specifically to support a payer denial appeal or Recovery Audit Contractor (RAC) audit response. Flags queries with dual-purpose CDI and denial management utility.' ;
    rdfs:domain ind:CdiQuery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ccMccStatus rdf:type rdf:Property ;
    rdfs:label 'Cc Mcc Status' ;
    rdfs:comment 'Indicates whether the diagnosis associated with this CDI query qualifies as a Complication or Comorbidity (CC) or Major Complication or Comorbidity (MCC) under CMS DRG grouping rules. CC/MCC capture is a primary driver of DRG weight and reimbursement optimization.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:codingImpactFlag rdf:type rdf:Property ;
    rdfs:label 'Coding Impact Flag' ;
    rdfs:comment 'Indicates whether the resolution of this CDI query resulted in a change to the coded diagnoses or procedures on the claim. True when the query outcome led to a coding modification. Used to measure CDI program effectiveness on coding accuracy.' ;
    rdfs:domain ind:CdiQuery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:complianceReviewFlag rdf:type rdf:Property ;
    rdfs:label 'Compliance Review Flag' ;
    rdfs:comment 'Indicates whether this CDI query has been flagged for compliance review due to potential leading query language, inappropriate query format, or OIG audit risk. Supports CDI compliance program monitoring and AHIMA/ACDIS query format auditing.' ;
    rdfs:domain ind:CdiQuery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:concurrentReviewFlag rdf:type rdf:Property ;
    rdfs:label 'Concurrent Review Flag' ;
    rdfs:comment 'Indicates whether this CDI query was issued during a concurrent (real-time, while patient is still admitted) review as opposed to a retrospective review after discharge. Concurrent CDI is the preferred model for maximizing documentation accuracy and DRG optimization.' ;
    rdfs:domain ind:CdiQuery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:documentationGapDescription rdf:type rdf:Property ;
    rdfs:label 'Documentation Gap Description' ;
    rdfs:comment 'Narrative description of the specific clinical documentation deficiency or opportunity identified by the CDI specialist that prompted this query. Examples include missing specificity for a diagnosis, absent linkage between conditions, or undocumented clinical indicators.' ;
    rdfs:domain ind:CdiQuery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expectedDrgCode rdf:type rdf:Property ;
    rdfs:label 'Expected Drg Code' ;
    rdfs:comment 'The DRG code anticipated if the provider responds affirmatively and documentation is improved per the CDI query. Used to calculate expected DRG impact and projected reimbursement change.' ;
    rdfs:domain ind:CdiQuery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expectedDrgDescription rdf:type rdf:Property ;
    rdfs:label 'Expected Drg Description' ;
    rdfs:comment 'Human-readable description of the expected DRG if the CDI query results in documentation improvement. Supports revenue impact analysis and CDI program ROI reporting.' ;
    rdfs:domain ind:CdiQuery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expectedReimbursementImpact rdf:type rdf:Property ;
    rdfs:label 'Expected Reimbursement Impact' ;
    rdfs:comment 'Projected change in reimbursement (in USD) if the CDI query results in a DRG change. Calculated as the difference between the expected DRG payment weight and the working DRG payment weight multiplied by the applicable base rate. Satisfies MONETARY_TRIPLET / QUANTITATIVE_RESULT category for TRANSACTION_HEADER role. Critical for CDI program ROI and revenue integrity reporting.' ;
    rdfs:domain ind:Clinical ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:finalDrgCode rdf:type rdf:Property ;
    rdfs:label 'Final Drg Code' ;
    rdfs:comment 'The DRG code actually assigned to the encounter after the CDI query was resolved and coding was finalized. Used to measure actual DRG change rate and realized revenue impact versus expected.' ;
    rdfs:domain ind:Clinical ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:genomicDocumentationGapFlag rdf:type rdf:Property ;
    rdfs:label 'Genomic Documentation Gap Flag' ;
    rdfs:comment 'Indicates whether this CDI query relates to genomic test documentation gaps' ;
    rdfs:domain ind:CdiQuery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:physicianQueryMethod rdf:type rdf:Property ;
    rdfs:label 'Physician Query Method' ;
    rdfs:comment 'Method by which the CDI query was delivered to the provider (electronic via EHR, verbal, written paper form, or secure message). Affects response rate tracking and compliance with AHIMA/ACDIS query format guidelines.' ;
    rdfs:domain ind:CdiQuery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerResponseText rdf:type rdf:Property ;
    rdfs:label 'Provider Response Text' ;
    rdfs:comment 'Free-text or structured response provided by the queried physician or provider. Captures the clinical clarification or documentation addendum. Classified as confidential due to clinical content.' ;
    rdfs:domain ind:CdiQuery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:queryCategory rdf:type rdf:Property ;
    rdfs:label 'Query Category' ;
    rdfs:comment 'Clinical category or topic area of the query (e.g., principal diagnosis clarification, secondary diagnosis specificity, procedure clarification, POA status, CC/MCC capture, clinical validity). Used for trend analysis and CDI program focus areas. [ENUM-REF-CANDIDATE: principal_diagnosis|secondary_diagnosis|procedure|poa_status|cc_mcc_capture|clinical_validity|discharge_disposition|severity_of_illness — promote to reference product]' ;
    rdfs:domain ind:CdiQuery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:queryIssueDate rdf:type rdf:Property ;
    rdfs:label 'Query Issue Date' ;
    rdfs:comment 'Calendar date on which the CDI query was formally issued to the provider. Satisfies BUSINESS_EVENT_TIMESTAMP category for TRANSACTION_HEADER role. Used to calculate response turnaround time and query aging.' ;
    rdfs:domain ind:CdiQuery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:queryNumber rdf:type rdf:Property ;
    rdfs:label 'Query Number' ;
    rdfs:comment 'Externally-known alphanumeric identifier for the CDI query, as assigned by the source system (3M CDI or Epic CDI). Used for cross-system reference, audit trails, and provider communication. Satisfies BUSINESS_IDENTIFIER category for TRANSACTION_HEADER role.' ;
    rdfs:domain ind:CdiQuery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:queryOpportunityFlag rdf:type rdf:Property ;
    rdfs:label 'Query Opportunity Flag' ;
    rdfs:comment 'Indicates whether the CDI review identified a query opportunity for this encounter. True when a documentation gap with potential DRG or quality impact was identified. Used to calculate query opportunity rates and CDI program reach.' ;
    rdfs:domain ind:Clinical ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:queryOutcome rdf:type rdf:Property ;
    rdfs:label 'Query Outcome' ;
    rdfs:comment 'Final disposition of the CDI query after provider response. Indicates whether the provider agreed with the CDI specialist\'s suggested documentation change, disagreed, or the query had no DRG impact. Drives DRG change rate and revenue impact reporting.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:queryResponseDate rdf:type rdf:Property ;
    rdfs:label 'Query Response Date' ;
    rdfs:comment 'Date on which the queried provider responded to the CDI query. Null if the query is still open, expired, or withdrawn. Used to calculate response turnaround time and provider response rate metrics.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:queryText rdf:type rdf:Property ;
    rdfs:label 'Query Text' ;
    rdfs:comment 'Full narrative text of the CDI query as presented to the provider. Contains the clinical question, supporting documentation references, and response options. Classified as confidential due to clinical content and potential PHI context.' ;
    rdfs:domain ind:CdiQuery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responseTurnaroundHours rdf:type rdf:Property ;
    rdfs:label 'Response Turnaround Hours' ;
    rdfs:comment 'Number of hours elapsed between query issuance and provider response. Used to measure CDI program efficiency, provider engagement, and compliance with internal SLA targets for query response time.' ;
    rdfs:domain ind:CdiQuery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:retrospectiveReviewFlag rdf:type rdf:Property ;
    rdfs:label 'Retrospective Review Flag' ;
    rdfs:comment 'Indicates whether this CDI query was issued during a retrospective review after the patient was discharged. Retrospective queries may have limited impact on DRG assignment if coding is already finalized but are used for denial management and appeal support.' ;
    rdfs:domain ind:CdiQuery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:riskOfMortalityLevel rdf:type rdf:Property ;
    rdfs:label 'Risk Of Mortality Level' ;
    rdfs:comment 'APR-DRG risk of mortality subclass for the encounter at the time of CDI query issuance (1=Minor, 2=Moderate, 3=Major, 4=Extreme). Supports quality reporting, mortality review, and CDI program impact on risk-adjusted outcomes.' ;
    rdfs:domain ind:CdiQuery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:severityOfIllnessLevel rdf:type rdf:Property ;
    rdfs:label 'Severity Of Illness Level' ;
    rdfs:comment 'APR-DRG severity of illness subclass for the encounter at the time of CDI query issuance (1=Minor, 2=Moderate, 3=Major, 4=Extreme). Used in APR-DRG environments to assess documentation completeness and CDI opportunity.' ;
    rdfs:domain ind:CdiQuery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemQueryCode rdf:type rdf:Property ;
    rdfs:label 'Source System Query Code' ;
    rdfs:comment 'Native identifier of this CDI query record in the originating source system (3M CDI or Epic CDI). Enables cross-system reconciliation, ETL traceability, and support case resolution without exposing internal surrogate keys.' ;
    rdfs:domain ind:CdiQuery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vibeMutationAdded rdf:type rdf:Property ;
    rdfs:label 'Vibe Mutation Added' ;
    rdfs:comment 'Marker added by VIBE mutator to ensure non-empty diff.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryCdiEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Cdi Employee Id' ;
    rdfs:comment 'Reference to the CDI specialist who performed the documentation review. Used for workload tracking and performance reporting.' ;
    rdfs:domain ind:CdiWorksheet ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:admitDate rdf:type rdf:Property ;
    rdfs:label 'Admit Date' ;
    rdfs:comment 'The date the patient was admitted for the encounter under CDI review. Used to calculate Length of Stay (LOS) at time of review and to sequence concurrent CDI reviews.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ccMccCaptured rdf:type rdf:Property ;
    rdfs:label 'Cc Mcc Captured' ;
    rdfs:comment 'Indicates whether the CDI review successfully captured a CC or MCC that was not previously documented, resulting in a DRG upgrade. Key metric for CDI program performance reporting.' ;
    rdfs:domain ind:CdiWorksheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:completedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Completed Timestamp' ;
    rdfs:comment 'The date and time when the CDI specialist marked the worksheet review as completed. Distinct from created and updated timestamps; used to measure CDI review cycle time and productivity.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:documentationGapCount rdf:type rdf:Property ;
    rdfs:label 'Documentation Gap Count' ;
    rdfs:comment 'Number of distinct clinical documentation gaps identified during the CDI review (e.g., unspecified diagnoses, missing severity qualifiers, undocumented comorbidities). Supports CDI program gap analysis.' ;
    rdfs:domain ind:CdiWorksheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:documentationGapNotes rdf:type rdf:Property ;
    rdfs:label 'Documentation Gap Notes' ;
    rdfs:comment 'Free-text narrative describing the specific clinical documentation gaps identified by the CDI specialist during review. Supports CDI education and physician feedback programs. Treated as confidential clinical operational data.' ;
    rdfs:domain ind:CdiWorksheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:drgGrouperVersion rdf:type rdf:Property ;
    rdfs:label 'Drg Grouper Version' ;
    rdfs:comment 'Version identifier of the DRG grouper software (e.g., CMS MS-DRG v41.0 or 3M APR-DRG v39) used to assign working and final DRG codes. Required for audit reproducibility.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:drgWeightChange rdf:type rdf:Property ;
    rdfs:label 'Drg Weight Change' ;
    rdfs:comment 'The arithmetic difference between the final DRG relative weight and the working DRG relative weight (final minus working). Positive values indicate a CDI-driven DRG upgrade; negative values indicate a downgrade. Key CDI program performance metric.' ;
    rdfs:domain ind:CdiWorksheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:finalDrgDescription rdf:type rdf:Property ;
    rdfs:label 'Final Drg Description' ;
    rdfs:comment 'Human-readable description of the final DRG code after CDI review completion, providing clinical context for the post-CDI grouping.' ;
    rdfs:domain ind:CdiWorksheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:finalDrgWeight rdf:type rdf:Property ;
    rdfs:label 'Final Drg Weight' ;
    rdfs:comment 'The CMS-published relative weight associated with the final DRG after CDI review. Compared against working DRG weight to quantify CDI program impact on Case Mix Index (CMI).' ;
    rdfs:domain ind:CdiWorksheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hacRiskFlag rdf:type rdf:Property ;
    rdfs:label 'Hac Risk Flag' ;
    rdfs:comment 'Indicates whether the CDI review identified a potential Hospital-Acquired Condition (HAC) that could affect DRG payment under CMS HAC Reduction Program. Triggers compliance review workflow.' ;
    rdfs:domain ind:CdiWorksheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:losAtReview rdf:type rdf:Property ;
    rdfs:label 'Los At Review' ;
    rdfs:comment 'Number of inpatient days elapsed from admission to the CDI review date. Used to assess timeliness of CDI intervention relative to the encounter Length of Stay (LOS).' ;
    rdfs:domain ind:CdiWorksheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:poaStatus rdf:type rdf:Property ;
    rdfs:label 'Poa Status' ;
    rdfs:comment 'Present on Admission (POA) indicator for the principal diagnosis as assessed during CDI review. Values follow CMS POA guidelines: Y=present on admission, N=not present, U=unknown, W=clinically undetermined, 1=exempt from POA reporting.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:precisionMedicineReviewFlag rdf:type rdf:Property ;
    rdfs:label 'Precision Medicine Review Flag' ;
    rdfs:comment 'Indicates whether CDI worksheet includes precision medicine documentation review' ;
    rdfs:domain ind:CdiWorksheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:queryCount rdf:type rdf:Property ;
    rdfs:label 'Query Count' ;
    rdfs:comment 'Total number of physician queries generated from this CDI worksheet review. Used to measure CDI specialist productivity and query volume per encounter.' ;
    rdfs:domain ind:CdiWorksheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:queryResponseStatus rdf:type rdf:Property ;
    rdfs:label 'Query Response Status' ;
    rdfs:comment 'Aggregate status of physician query responses for this worksheet: not_applicable (no query issued), pending (awaiting response), agreed (physician confirmed CDI suggestion), disagreed (physician declined), unable_to_determine (physician could not clarify).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewDate rdf:type rdf:Property ;
    rdfs:label 'Review Date' ;
    rdfs:comment 'The calendar date on which the CDI specialist performed the documentation review for the encounter. Principal business event date for the worksheet.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reviewNotes rdf:type rdf:Property ;
    rdfs:label 'Review Notes' ;
    rdfs:comment 'Free-text clinical notes entered by the CDI specialist summarizing review findings, clinical reasoning, and recommended documentation improvements. Confidential clinical operational data used for CDI education and physician engagement.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewStatus rdf:type rdf:Property ;
    rdfs:label 'Review Status' ;
    rdfs:comment 'Current lifecycle state of the CDI worksheet: open (assigned, not started), in_progress (review underway), pending_query (awaiting physician query response), completed (review finalized), or cancelled.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewTimestamp rdf:type rdf:Property ;
    rdfs:label 'Review Timestamp' ;
    rdfs:comment 'Precise date and time when the CDI specialist initiated or completed the review session, used for audit trail and productivity measurement.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:reviewType rdf:type rdf:Property ;
    rdfs:label 'Review Type' ;
    rdfs:comment 'Classifies the stage of the CDI review cycle: initial (first review on admission), concurrent (ongoing during stay), follow_up (subsequent concurrent review), final (pre-discharge), or post_discharge (retrospective). Drives workflow routing in 3M CDI.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemWorksheetCode rdf:type rdf:Property ;
    rdfs:label 'Source System Worksheet Code' ;
    rdfs:comment 'The native worksheet identifier assigned by the 3M Health Information Systems CDI source system. Preserved for data lineage, reconciliation, and audit trail back to the operational system of record.' ;
    rdfs:domain ind:CdiWorksheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cdiWorksheetStatus rdf:type rdf:Property ;
    rdfs:label 'Cdi Worksheet Status' ;
    rdfs:domain ind:CdiWorksheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:worksheetNumber rdf:type rdf:Property ;
    rdfs:label 'Worksheet Number' ;
    rdfs:comment 'Externally visible alphanumeric identifier assigned to the CDI worksheet by the 3M Health Information Systems CDI module. Used for cross-referencing with source system records.' ;
    rdfs:domain ind:CdiWorksheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:functionalStatusId rdf:type rdf:Property ;
    rdfs:label 'Functional Status Id' ;
    rdfs:comment 'Unique surrogate identifier for each functional status assessment record in the clinical data product. Primary key for the functional_status table in the Databricks Silver Layer.' ;
    rdfs:domain ind:FunctionalStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:functionalClinicianId rdf:type rdf:Property ;
    rdfs:label 'Functional Clinician Id' ;
    rdfs:domain ind:FunctionalStatus ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:medicationTherapyMgmtId rdf:type rdf:Property ;
    rdfs:label 'Medication Therapy Mgmt Id' ;
    rdfs:comment 'Foreign key linking to pharmacy.medication_therapy_mgmt. Business justification: Functional assessments (ADL scores, fall risk, cognitive status) inform MTM interventions for medication optimization in elderly and complex patients. Required for comprehensive medication reviews and' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MedicationTherapyMgmt .

ind:primaryFunctionalClinicianId rdf:type rdf:Property ;
    rdfs:label 'Primary Functional Clinician Id' ;
    rdfs:comment 'Reference to the licensed clinician (nurse, therapist, physician, social worker) who performed and documented the functional status assessment. Supports accountability and care team attribution.' ;
    rdfs:domain ind:FunctionalStatus ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:resultingTherapyOrderId rdf:type rdf:Property ;
    rdfs:label 'Resulting Therapy Order Id' ;
    rdfs:comment 'Foreign key linking to order.therapy_order. Business justification: Functional assessments drive therapy orders. Real workflow: ADL score shows mobility deficit, triggers PT order. Essential for therapy medical necessity documentation, authorization support, outcome t' ;
    rdfs:domain ind:FunctionalStatus ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TherapyOrder .

ind:adlScore rdf:type rdf:Property ;
    rdfs:label 'Adl Score' ;
    rdfs:comment 'Sub-score measuring the patient\'s ability to perform basic Activities of Daily Living (ADL) including bathing, dressing, grooming, toileting, transferring, and feeding. Core component of Barthel Index, Katz ADL, and FIM assessments.' ;
    rdfs:domain ind:FunctionalStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:assessingDiscipline rdf:type rdf:Property ;
    rdfs:label 'Assessing Discipline' ;
    rdfs:comment 'Clinical discipline of the licensed professional who performed the functional status assessment. Determines scope of practice, assessment tool applicability, and care plan ownership. Required for interdisciplinary team documentation. [ENUM-REF-CANDIDATE: nursing|physical_therapy|occupational_therapy|speech_therapy|social_work|physician|psychology — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:FunctionalStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assessmentDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Assessment Duration Minutes' ;
    rdfs:comment 'Total time in minutes required to complete the functional status assessment. Used for therapy billing (timed CPT codes), productivity reporting, and staffing analysis. Required for Medicare Part B therapy billing documentation.' ;
    rdfs:domain ind:FunctionalStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:assessmentLocation rdf:type rdf:Property ;
    rdfs:label 'Assessment Location' ;
    rdfs:comment 'Physical or virtual location where the functional status assessment was conducted (e.g., bedside, therapy gym, outpatient clinic, telehealth). Supports operational reporting and care setting analytics.' ;
    rdfs:domain ind:FunctionalStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assessmentType rdf:type rdf:Property ;
    rdfs:label 'Assessment Type' ;
    rdfs:comment 'Classification of when in the care continuum the assessment was performed. Admission assessments establish baseline; discharge assessments support post-acute placement; interim assessments track progress; annual assessments support population health programs.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cageAidScore rdf:type rdf:Property ;
    rdfs:label 'Cage Aid Score' ;
    rdfs:comment 'Total score from the CAGE-AID (Cut down, Annoyed, Guilty, Eye-opener — Adapted to Include Drugs) substance use disorder screening tool, ranging from 0 to 4. A score of 2 or higher is considered a positive screen for alcohol or drug use disorder.' ;
    rdfs:domain ind:FunctionalStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:caregiverSupportAvailable rdf:type rdf:Property ;
    rdfs:label 'Caregiver Support Available' ;
    rdfs:comment 'Indicates whether the patient has an identified informal caregiver (family member, friend, or unpaid caregiver) available to assist with post-discharge care needs. Critical factor in discharge planning and community care placement decisions.' ;
    rdfs:domain ind:FunctionalStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:clinicalNotes rdf:type rdf:Property ;
    rdfs:label 'Clinical Notes' ;
    rdfs:comment 'Free-text narrative documentation by the assessing clinician providing qualitative context, clinical observations, and nuanced findings beyond the structured scoring fields. Contains Protected Health Information (PHI) and is subject to HIPAA minimum necessary standards.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cognitiveScore rdf:type rdf:Property ;
    rdfs:label 'Cognitive Score' ;
    rdfs:comment 'Sub-score measuring cognitive function including orientation, memory, attention, language, and executive function. Derived from MMSE (0–30), MoCA (0–30), FIM cognitive subscale, or BIMS (Brief Interview for Mental Status). Supports dementia screening and care planning.' ;
    rdfs:domain ind:FunctionalStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dischargeDispositionRecommended rdf:type rdf:Property ;
    rdfs:label 'Discharge Disposition Recommended' ;
    rdfs:comment 'Clinician-recommended post-discharge care setting based on functional status assessment findings. Drives discharge planning workflows, post-acute care referrals, and transitions of care coordination. Supports CMS Discharge Planning Rule compliance. [ENUM-REF-CANDIDATE: home|home_with_services|snf|inpatient_rehab|ltach|hospice|assisted_living — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:FunctionalStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fallRiskLevel rdf:type rdf:Property ;
    rdfs:label 'Fall Risk Level' ;
    rdfs:comment 'Clinician-assigned fall risk stratification based on Morse Fall Scale, Hendrich II, or equivalent validated tool. Drives fall prevention care plan interventions and is a required safety metric under TJC National Patient Safety Goals (NPSG.09.02.01).' ;
    rdfs:domain ind:FunctionalStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:iadlScore rdf:type rdf:Property ;
    rdfs:label 'Iadl Score' ;
    rdfs:comment 'Sub-score measuring the patient\'s ability to perform Instrumental Activities of Daily Living (IADL) such as managing medications, finances, transportation, meal preparation, and housekeeping. Assessed via Lawton IADL Scale. Critical for community discharge planning.' ;
    rdfs:domain ind:FunctionalStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isBaselineAssessment rdf:type rdf:Property ;
    rdfs:label 'Is Baseline Assessment' ;
    rdfs:comment 'Indicates whether this assessment represents the initial baseline functional status evaluation for the patient within the current episode of care. Baseline assessments anchor longitudinal functional trajectory analysis and rehabilitation goal-setting.' ;
    rdfs:domain ind:FunctionalStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mobilityScore rdf:type rdf:Property ;
    rdfs:label 'Mobility Score' ;
    rdfs:comment 'Sub-score quantifying the patient\'s mobility status including ambulation, transfers, stair climbing, and wheelchair use. Derived from FIM motor subscale, Barthel mobility items, or Berg Balance Scale. Informs physical therapy referrals and fall risk management.' ;
    rdfs:domain ind:FunctionalStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mobilityStatus rdf:type rdf:Property ;
    rdfs:label 'Mobility Status' ;
    rdfs:comment 'Categorical classification of the patient\'s overall mobility level using CMS MDS-aligned coding. Supports post-acute care placement criteria, physical therapy orders, and fall prevention protocols.' ;
    rdfs:domain ind:Clinical ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nutritionalStatus rdf:type rdf:Property ;
    rdfs:label 'Nutritional Status' ;
    rdfs:comment 'Clinician-assessed nutritional status of the patient as determined during functional assessment. Malnutrition directly impacts functional recovery, wound healing, and rehabilitation outcomes. Supports dietitian referrals and care plan development.' ;
    rdfs:domain ind:FunctionalStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:painLevel rdf:type rdf:Property ;
    rdfs:label 'Pain Level' ;
    rdfs:comment 'Patient-reported pain intensity score on a standardized numeric rating scale (NRS 0–10) or equivalent validated tool (Wong-Baker FACES, FLACC). Functional pain assessment is integral to ADL performance and mobility evaluation. Required by TJC pain management standards.' ;
    rdfs:domain ind:FunctionalStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:phq9Score rdf:type rdf:Property ;
    rdfs:label 'Phq9 Score' ;
    rdfs:comment 'Total score from the Patient Health Questionnaire-9 (PHQ-9) depression screening tool, ranging from 0 to 27. Scores of 5, 10, 15, and 20 represent mild, moderate, moderately severe, and severe depression thresholds respectively. Required for HEDIS MDD measures and CMS quality reporting.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:postAcuteCareSetting rdf:type rdf:Property ;
    rdfs:label 'Post Acute Care Setting' ;
    rdfs:comment 'Post-acute care setting where assessment was performed (SNF, home health, hospice)' ;
    rdfs:domain ind:FunctionalStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postAcuteSetting rdf:type rdf:Property ;
    rdfs:label 'Post Acute Setting' ;
    rdfs:comment 'Post-acute care setting: SNF, home_health, hospice, LTACH' ;
    rdfs:domain ind:FunctionalStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pressureInjuryRisk rdf:type rdf:Property ;
    rdfs:label 'Pressure Injury Risk' ;
    rdfs:comment 'Risk stratification for pressure injury (decubitus ulcer) development based on Braden Scale or Norton Scale score. Supports wound prevention care planning and is tracked as a Hospital-Acquired Condition (HAC) under CMS quality programs.' ;
    rdfs:domain ind:FunctionalStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorLevelOfFunction rdf:type rdf:Property ;
    rdfs:label 'Prior Level Of Function' ;
    rdfs:comment 'Patient\'s functional status prior to the current illness, injury, or hospitalization as reported by patient, family, or prior care records. Establishes rehabilitation goals and discharge planning targets. Standard component of physical and occupational therapy evaluations.' ;
    rdfs:domain ind:FunctionalStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rehabilitationPotential rdf:type rdf:Property ;
    rdfs:label 'Rehabilitation Potential' ;
    rdfs:comment 'Clinician\'s assessment of the patient\'s potential to improve functional status through rehabilitation services. Influences therapy authorization, post-acute care placement, and Medicare skilled care eligibility determinations.' ;
    rdfs:domain ind:FunctionalStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scoreInterpretation rdf:type rdf:Property ;
    rdfs:label 'Score Interpretation' ;
    rdfs:comment 'Clinically validated categorical interpretation of the total assessment score based on the tool\'s published scoring bands. Supports rapid clinical triage, care plan development, and post-acute care placement decisions.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sdohScreeningResult rdf:type rdf:Property ;
    rdfs:label 'Sdoh Screening Result' ;
    rdfs:comment 'Overall result of the Social Determinants of Health (SDOH) screening indicating whether unmet social needs (food insecurity, housing instability, transportation barriers, financial strain, social isolation) were identified. Supports population health management and care coordination referrals.' ;
    rdfs:domain ind:FunctionalStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:functionalStatusStatus rdf:type rdf:Property ;
    rdfs:label 'Functional Status Status' ;
    rdfs:domain ind:FunctionalStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalScore rdf:type rdf:Property ;
    rdfs:label 'Total Score' ;
    rdfs:comment 'Composite numeric score derived from the assessment tool\'s scoring algorithm. Score range and interpretation vary by tool (e.g., Barthel Index 0–100; PHQ-9 0–27; FIM 18–126). Used for clinical decision-making, discharge planning, and population health stratification.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:advanceDirectiveId rdf:type rdf:Property ;
    rdfs:label 'Advance Directive Id' ;
    rdfs:comment 'Unique surrogate identifier for the advance directive record in the lakehouse silver layer. Primary key for this entity.' ;
    rdfs:domain ind:AdvanceDirective ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:attachmentId rdf:type rdf:Property ;
    rdfs:label 'Attachment Id' ;
    rdfs:comment 'Foreign key linking to claim.claim_attachment. Business justification: Advance directives are required documentation for hospice and palliative care claims. Compliance teams must link directive to claim attachment for Medicare hospice election validation and end-of-life ' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Attachment .

ind:compliancePolicyId rdf:type rdf:Property ;
    rdfs:label 'Compliance Policy Id' ;
    rdfs:comment 'Foreign key linking to compliance.policy. Business justification: Advance directive management is governed by organizational policies implementing state/federal regulations (Patient Self-Determination Act). Healthcare organizations must link advance directive record' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CompliancePolicy .

ind:supersededByDirectiveAdvanceDirectiveId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Directive Advance Directive Id' ;
    rdfs:comment 'Reference to the newer advance directive record that supersedes this one. Null if this directive has not been superseded. Enables directive version chain tracking and ensures the most current directive is applied in care decisions.' ;
    rdfs:domain ind:AdvanceDirective ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AdvanceDirective .

ind:artificiallyAdministeredNutrition rdf:type rdf:Property ;
    rdfs:label 'Artificially Administered Nutrition' ;
    rdfs:comment 'Patient\'s documented preference regarding artificially administered nutrition and hydration (e.g., feeding tubes, IV fluids) as specified in the advance directive or POLST/MOLST. Critical for end-of-life care planning.' ;
    rdfs:domain ind:AdvanceDirective ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capacityAssessmentResult rdf:type rdf:Property ;
    rdfs:label 'Capacity Assessment Result' ;
    rdfs:comment 'The result of the formal patient decision-making capacity assessment conducted at the time of advance directive documentation. Determines whether the patient could legally execute or modify the directive.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clinicalAiNote rdf:type rdf:Property ;
    rdfs:label 'Clinical Ai Note' ;
    rdfs:domain ind:AdvanceDirective ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:codeStatus rdf:type rdf:Property ;
    rdfs:label 'Code Status' ;
    rdfs:comment 'The patient\'s current resuscitation code status as documented in the advance directive. Full Code = all resuscitative measures; DNR = Do Not Resuscitate; DNR/DNI = Do Not Resuscitate / Do Not Intubate; Comfort Care = palliative measures only; Limited Interventions = selective resuscitative measures as specified.' ;
    rdfs:domain ind:AdvanceDirective ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:directiveStatus rdf:type rdf:Property ;
    rdfs:label 'Directive Status' ;
    rdfs:comment 'Current lifecycle status of the advance directive document. Active = currently in force; Revoked = patient has withdrawn the directive; Superseded = replaced by a newer directive; Expired = past the expiration date; Pending Verification = documented but not yet clinically verified.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:directiveType rdf:type rdf:Property ;
    rdfs:label 'Directive Type' ;
    rdfs:comment 'Classification of the advance directive document type. DNR = Do Not Resuscitate; POLST = Physician Orders for Life-Sustaining Treatment; MOLST = Medical Orders for Life-Sustaining Treatment; Living Will = written legal document; Healthcare Power of Attorney = proxy designation; Comfort Care Order = palliative/comfort-focused care order.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentLocation rdf:type rdf:Property ;
    rdfs:label 'Document Location' ;
    rdfs:comment 'Indicates where the physical or electronic copy of the advance directive document is stored or held. Supports retrieval during care transitions and emergency situations.' ;
    rdfs:domain ind:AdvanceDirective ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ethicsConsultRequested rdf:type rdf:Property ;
    rdfs:label 'Ethics Consult Requested' ;
    rdfs:comment 'Indicates whether an ethics committee consultation was requested in connection with this advance directive. Supports quality reporting, compliance tracking, and clinical ethics workflows.' ;
    rdfs:domain ind:AdvanceDirective ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fhirConsentReference rdf:type rdf:Property ;
    rdfs:label 'Fhir Consent Reference' ;
    rdfs:comment 'The FHIR Consent resource identifier corresponding to this advance directive, enabling interoperability with Health Information Exchange (HIE) platforms and FHIR-compliant systems.' ;
    rdfs:domain ind:AdvanceDirective ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hospiceElectionLinkedFlag rdf:type rdf:Property ;
    rdfs:label 'Hospice Election Linked Flag' ;
    rdfs:comment 'Indicates whether this advance directive is linked to a hospice election' ;
    rdfs:domain ind:AdvanceDirective ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hospiceEnrolled rdf:type rdf:Property ;
    rdfs:label 'Hospice Enrolled' ;
    rdfs:comment 'Indicates whether the patient is currently enrolled in a hospice program at the time of advance directive documentation. Relevant for care plan alignment and CMS hospice benefit compliance.' ;
    rdfs:domain ind:AdvanceDirective ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hospitalizationPreference rdf:type rdf:Property ;
    rdfs:label 'Hospitalization Preference' ;
    rdfs:comment 'Patient\'s documented preference regarding hospitalization and transfer to acute care settings as specified in the POLST/MOLST. Guides care transitions and Emergency Department (ED) triage decisions.' ;
    rdfs:domain ind:AdvanceDirective ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interpreterUsed rdf:type rdf:Property ;
    rdfs:label 'Interpreter Used' ;
    rdfs:comment 'Indicates whether a language interpreter was used during the advance directive discussion and documentation process. Supports compliance with Title VI of the Civil Rights Act and CMS language access requirements.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lifeSustainingTreatmentPreference rdf:type rdf:Property ;
    rdfs:label 'Life Sustaining Treatment Preference' ;
    rdfs:comment 'Patient\'s documented preference regarding life-sustaining treatment as captured in the POLST/MOLST or living will. Full Treatment = all medically appropriate interventions; Selective Treatment = specific interventions as detailed; Comfort Measures Only = palliative and comfort-focused care only. Core clinical decision support field.' ;
    rdfs:domain ind:AdvanceDirective ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mechanicalVentilationPreference rdf:type rdf:Property ;
    rdfs:label 'Mechanical Ventilation Preference' ;
    rdfs:comment 'Patient\'s documented preference regarding mechanical ventilation and intubation as specified in the advance directive or POLST/MOLST. Directly informs DNR/DNI code status decisions.' ;
    rdfs:domain ind:AdvanceDirective ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notarized rdf:type rdf:Property ;
    rdfs:label 'Notarized' ;
    rdfs:comment 'Indicates whether the advance directive document has been notarized. Some state jurisdictions require notarization for legal validity of living wills and healthcare power of attorney designations.' ;
    rdfs:domain ind:AdvanceDirective ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:organDonationPreference rdf:type rdf:Property ;
    rdfs:label 'Organ Donation Preference' ;
    rdfs:domain ind:AdvanceDirective ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:palliativeCareReferral rdf:type rdf:Property ;
    rdfs:label 'Palliative Care Referral' ;
    rdfs:comment 'Indicates whether a palliative care referral was initiated in conjunction with the advance directive documentation. Supports care coordination, population health management, and quality measure reporting.' ;
    rdfs:domain ind:AdvanceDirective ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:patientCapacityAssessed rdf:type rdf:Property ;
    rdfs:label 'Patient Capacity Assessed' ;
    rdfs:comment 'Indicates whether the patient\'s decision-making capacity was formally assessed at the time the advance directive was documented or verified. Relevant for legal validity and ethical compliance.' ;
    rdfs:domain ind:AdvanceDirective ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:proxyAlternatePhone rdf:type rdf:Property ;
    rdfs:label 'Proxy Alternate Phone' ;
    rdfs:comment 'Alternate or secondary contact phone number for the designated healthcare proxy. Used when the primary proxy phone number is unreachable during urgent care decisions.' ;
    rdfs:domain ind:AdvanceDirective ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:proxyName rdf:type rdf:Property ;
    rdfs:label 'Proxy Name' ;
    rdfs:comment 'Full name of the designated healthcare proxy or healthcare power of attorney agent authorized to make medical decisions on behalf of the patient when the patient lacks decision-making capacity.' ;
    rdfs:domain ind:AdvanceDirective ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resuscitationPreference rdf:type rdf:Property ;
    rdfs:label 'Resuscitation Preference' ;
    rdfs:domain ind:AdvanceDirective ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revocationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Revocation Timestamp' ;
    rdfs:comment 'The date and time when the patient formally revoked the advance directive. Null if the directive has not been revoked. Triggers status transition to \'revoked\' and inactivates the directive for care decisions.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:scannedDocumentUrl rdf:type rdf:Property ;
    rdfs:label 'Scanned Document Url' ;
    rdfs:comment 'Secure URL or document management system path to the scanned or electronic copy of the advance directive document stored in the document management system or EHR. Supports retrieval for clinical review and legal reference.' ;
    rdfs:domain ind:AdvanceDirective ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemDirectiveCode rdf:type rdf:Property ;
    rdfs:label 'Source System Directive Code' ;
    rdfs:comment 'The native identifier of the advance directive record in the originating operational system (e.g., Epic advance care planning record ID). Supports bidirectional traceability between the lakehouse and the source Electronic Health Record (EHR).' ;
    rdfs:domain ind:AdvanceDirective ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateOfExecution rdf:type rdf:Property ;
    rdfs:label 'State Of Execution' ;
    rdfs:comment 'The U.S. state (two-letter USPS abbreviation) in which the advance directive was legally executed. Determines which state-specific legal requirements and forms apply to the directive\'s validity.' ;
    rdfs:domain ind:AdvanceDirective ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:advanceDirectiveStatus rdf:type rdf:Property ;
    rdfs:label 'Advance Directive Status' ;
    rdfs:domain ind:AdvanceDirective ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vibeAiMarker rdf:type rdf:Property ;
    rdfs:label 'Vibe Ai Marker' ;
    rdfs:comment 'Marker added by VIBE AI mutation' ;
    rdfs:domain ind:AdvanceDirective ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:witnessName rdf:type rdf:Property ;
    rdfs:label 'Witness Name' ;
    rdfs:comment 'Full name of the witness who attested to the patient\'s execution of the advance directive document. Required by many state laws to validate the legal standing of the directive.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nursingAssessmentId rdf:type rdf:Property ;
    rdfs:label 'Nursing Assessment Id' ;
    rdfs:comment 'Unique surrogate identifier for each nursing assessment record in the lakehouse silver layer. Primary key for this data product.' ;
    rdfs:domain ind:NursingAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:nurseEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Nurse Employee Id' ;
    rdfs:domain ind:NursingAssessment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:nursingClinicianId rdf:type rdf:Property ;
    rdfs:label 'Nursing Clinician Id' ;
    rdfs:domain ind:NursingAssessment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:primaryNursingClinicianId rdf:type rdf:Property ;
    rdfs:label 'Primary Nursing Clinician Id' ;
    rdfs:comment 'Reference to the licensed nurse (RN or LPN) who completed and signed this nursing assessment. Used for accountability, staffing analytics, and Joint Commission compliance.' ;
    rdfs:domain ind:NursingAssessment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:resultingDietOrderId rdf:type rdf:Property ;
    rdfs:label 'Resulting Diet Order Id' ;
    rdfs:comment 'Foreign key linking to order.diet_order. Business justification: Nursing assessments drive diet orders. Real workflow: swallow assessment shows aspiration risk, triggers pureed diet order. Essential for nutrition care compliance, aspiration prevention protocols, sp' ;
    rdfs:domain ind:NursingAssessment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DietOrder .

ind:reviewedTestResultId rdf:type rdf:Property ;
    rdfs:label 'Reviewed Test Result Id' ;
    rdfs:comment 'Foreign key linking to laboratory.test_result. Business justification: Nursing assessments review recent lab results for care planning (potassium levels→cardiac monitoring). Role prefix \'reviewed_\' indicates assessment input. Essential for nursing flowsheet integration a' ;
    rdfs:domain ind:NursingAssessment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TestResult .

ind:assessmentDatetime rdf:type rdf:Property ;
    rdfs:label 'Assessment Datetime' ;
    rdfs:domain ind:NursingAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:assessmentIntervalHours rdf:type rdf:Property ;
    rdfs:label 'Assessment Interval Hours' ;
    rdfs:comment 'The required reassessment interval in hours as defined by the care setting protocol and assessment type (e.g., every 4 hours for ICU, every 8 hours for medical-surgical). Used to monitor reassessment compliance and timeliness.' ;
    rdfs:domain ind:NursingAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:assessmentNotes rdf:type rdf:Property ;
    rdfs:label 'Assessment Notes' ;
    rdfs:comment 'Free-text narrative clinical notes entered by the assessing nurse to supplement structured assessment findings. May include abnormal findings, patient responses, and clinical reasoning. Contains Protected Health Information (PHI).' ;
    rdfs:domain ind:NursingAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bradenScore rdf:type rdf:Property ;
    rdfs:label 'Braden Score' ;
    rdfs:comment 'Numeric pressure injury risk score calculated using the Braden Scale (range 6–23). Lower scores indicate higher risk. Required for pressure injury prevention protocol activation and CMS HAC reporting.' ;
    rdfs:domain ind:NursingAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:cardiovascularStatus rdf:type rdf:Property ;
    rdfs:label 'Cardiovascular Status' ;
    rdfs:comment 'Documented cardiovascular assessment findings including heart rate regularity and rhythm. Core component of the head-to-toe nursing assessment and cardiac monitoring documentation.' ;
    rdfs:domain ind:NursingAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:careRecommendations rdf:type rdf:Property ;
    rdfs:label 'Care Recommendations' ;
    rdfs:comment 'Nursing care recommendations and planned interventions documented as part of the assessment (e.g., reposition every 2 hours, initiate fall prevention bundle, consult wound care). Feeds into the nursing care plan.' ;
    rdfs:domain ind:NursingAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:continenceStatus rdf:type rdf:Property ;
    rdfs:label 'Continence Status' ;
    rdfs:comment 'Patient\'s urinary and bowel continence status as documented in the nursing assessment. Relevant to Catheter-Associated Urinary Tract Infection (CAUTI) prevention protocols and skin integrity management.' ;
    rdfs:domain ind:NursingAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dischargeBarriers rdf:type rdf:Property ;
    rdfs:label 'Discharge Barriers' ;
    rdfs:comment 'Free-text or structured documentation of identified barriers to patient discharge (e.g., awaiting placement, transportation, caregiver availability, Social Determinants of Health (SDOH) factors). Supports care coordination and discharge planning workflows.' ;
    rdfs:domain ind:NursingAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dischargeReadinessScore rdf:type rdf:Property ;
    rdfs:label 'Discharge Readiness Score' ;
    rdfs:comment 'Numeric score from a validated discharge readiness assessment tool (e.g., Readiness for Hospital Discharge Scale) indicating the patient\'s preparedness for discharge. Supports discharge planning, Length of Stay (LOS) management, and readmission reduction initiatives.' ;
    rdfs:domain ind:NursingAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fallRiskCategory rdf:type rdf:Property ;
    rdfs:label 'Fall Risk Category' ;
    rdfs:comment 'Categorical fall risk classification derived from the fall risk score (Low, Moderate, High). Drives nursing care plan interventions, bed alarm activation, and fall prevention bundle compliance reporting.' ;
    rdfs:domain ind:NursingAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fallRiskTool rdf:type rdf:Property ;
    rdfs:label 'Fall Risk Tool' ;
    rdfs:comment 'The validated fall risk assessment instrument used to calculate the fall risk score (e.g., Morse Fall Scale, Hendrich II Fall Risk Model). Ensures comparability of scores across units and facilities.' ;
    rdfs:domain ind:NursingAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ivAccessType rdf:type rdf:Property ;
    rdfs:label 'Iv Access Type' ;
    rdfs:comment 'Type of intravenous access device present and assessed during the nursing assessment (Peripheral IV, Central Line, PICC, Port, or None). Critical for Central Line-Associated Bloodstream Infection (CLABSI) prevention bundle compliance and HAI reporting.' ;
    rdfs:domain ind:NursingAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ivSiteCondition rdf:type rdf:Property ;
    rdfs:label 'Iv Site Condition' ;
    rdfs:comment 'Condition of the intravenous access site as assessed by the nurse (Patent, Infiltrated, Phlebitis, Occluded, Removed). Drives IV site care interventions and CLABSI prevention bundle documentation.' ;
    rdfs:domain ind:NursingAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jointCommissionCompliant rdf:type rdf:Property ;
    rdfs:label 'Joint Commission Compliant' ;
    rdfs:comment 'Indicates whether this nursing assessment meets all applicable Joint Commission documentation requirements for the assessment type (e.g., all required fields completed, completed within required timeframe). Used for quality reporting and survey readiness.' ;
    rdfs:domain ind:NursingAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:neurologicalStatus rdf:type rdf:Property ;
    rdfs:label 'Neurological Status' ;
    rdfs:comment 'Documented neurological status of the patient at the time of assessment, reflecting level of consciousness and orientation. Core component of head-to-toe nursing assessment and change-of-condition monitoring.' ;
    rdfs:domain ind:NursingAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nursingUnit rdf:type rdf:Property ;
    rdfs:label 'Nursing Unit' ;
    rdfs:comment 'The specific nursing unit or department (e.g., 4 North Medical-Surgical, MICU, PACU) where the patient was located at the time of the assessment. Used for unit-level quality benchmarking and staffing analysis.' ;
    rdfs:domain ind:NursingAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nutritionStatus rdf:type rdf:Property ;
    rdfs:label 'Nutrition Status' ;
    rdfs:comment 'Nursing assessment of the patient\'s nutritional status and feeding method. Drives dietary consult referrals and nutrition care plan interventions. Supports malnutrition quality reporting.' ;
    rdfs:domain ind:NursingAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:orientationLevel rdf:type rdf:Property ;
    rdfs:label 'Orientation Level' ;
    rdfs:comment 'Patient orientation level documented during neurological assessment: x1 (person), x2 (person and place), x3 (person, place, and time), x4 (person, place, time, and event). Standard clinical notation used in nursing documentation.' ;
    rdfs:domain ind:NursingAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postAcuteTransitionFlag rdf:type rdf:Property ;
    rdfs:label 'Post Acute Transition Flag' ;
    rdfs:comment 'Indicates whether this assessment is for post-acute care transition planning' ;
    rdfs:domain ind:NursingAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pressureInjuryLocation rdf:type rdf:Property ;
    rdfs:label 'Pressure Injury Location' ;
    rdfs:comment 'Anatomical body site location of the identified pressure injury (e.g., sacrum, coccyx, heel, occiput). Documented using standardized anatomical terminology. Required for wound care documentation and HAC reporting.' ;
    rdfs:domain ind:NursingAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pressureInjuryStage rdf:type rdf:Property ;
    rdfs:label 'Pressure Injury Stage' ;
    rdfs:comment 'National Pressure Injury Advisory Panel (NPIAP) staging classification for any identified pressure injury (Stage 1 through Stage 4, Unstageable, or Deep Tissue Pressure Injury). Required for CMS Hospital-Acquired Condition (HAC) reporting and quality metrics.' ;
    rdfs:domain ind:NursingAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:respiratoryStatus rdf:type rdf:Property ;
    rdfs:label 'Respiratory Status' ;
    rdfs:comment 'Documented respiratory status of the patient including breathing pattern and effort. Part of the head-to-toe body system assessment. Triggers escalation protocols when abnormal.' ;
    rdfs:domain ind:NursingAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:restraintIndication rdf:type rdf:Property ;
    rdfs:label 'Restraint Indication' ;
    rdfs:comment 'Clinical justification documented by the nurse for restraint application (e.g., risk of self-harm, removal of life-sustaining devices, violent behavior). Required by CMS and Joint Commission for every restraint episode.' ;
    rdfs:domain ind:NursingAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:restraintType rdf:type rdf:Property ;
    rdfs:label 'Restraint Type' ;
    rdfs:comment 'Type of restraint applied to the patient as documented in the restraint assessment (Physical, Chemical, Soft Limb, Vest, Mitts, or None). Required for CMS Conditions of Participation restraint documentation and Joint Commission compliance.' ;
    rdfs:domain ind:NursingAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:safetyCheckCompleted rdf:type rdf:Property ;
    rdfs:label 'Safety Check Completed' ;
    rdfs:comment 'Indicates whether the nursing safety check (e.g., bed in lowest position, call light within reach, side rails up, ID band verified) was completed and documented as part of this assessment. Supports Joint Commission National Patient Safety Goal compliance.' ;
    rdfs:domain ind:NursingAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:skinIntegrityStatus rdf:type rdf:Property ;
    rdfs:label 'Skin Integrity Status' ;
    rdfs:comment 'Overall skin integrity assessment finding indicating whether the patient\'s skin is intact or compromised. Triggers wound care protocols and pressure injury prevention bundles. Required for HAI reporting.' ;
    rdfs:domain ind:NursingAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemAssessmentCode rdf:type rdf:Property ;
    rdfs:label 'Source System Assessment Code' ;
    rdfs:comment 'The native identifier of this nursing assessment record in the originating Electronic Health Record (EHR) system (e.g., Epic ClinDoc flowsheet row ID or Cerner PowerChart documentation ID). Supports data lineage and reconciliation.' ;
    rdfs:domain ind:NursingAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nursingAssessmentStatus rdf:type rdf:Property ;
    rdfs:label 'Nursing Assessment Status' ;
    rdfs:domain ind:NursingAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:haiEventId rdf:type rdf:Property ;
    rdfs:label 'Hai Event Id' ;
    rdfs:comment 'Unique surrogate identifier for each Healthcare-Associated Infection (HAI) surveillance event record in the silver layer lakehouse. Primary key for this entity.' ;
    rdfs:domain ind:Clinical ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:HaiEvent .

ind:correctiveActionId rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Id' ;
    rdfs:comment 'Foreign key linking to quality.corrective_action. Business justification: HAI events trigger corrective actions (process improvements, staff education). Direct linkage enables tracking corrective action effectiveness. Essential for infection prevention quality improvement a' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CorrectiveAction .

ind:linkedProcedureProcedureEventId rdf:type rdf:Property ;
    rdfs:label 'Linked Procedure Procedure Event Id' ;
    rdfs:comment 'Reference to the surgical or invasive procedure associated with this HAI event. Mandatory for Surgical Site Infection (SSI) events per NHSN SSI protocol; nullable for device-associated infections (CLABSI, CAUTI, VAP).' ;
    rdfs:domain ind:HaiEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProcedureEvent .

ind:microbiologyCultureId rdf:type rdf:Property ;
    rdfs:label 'Microbiology Culture Id' ;
    rdfs:comment 'Foreign key linking to laboratory.microbiology_culture. Business justification: HAI events identified/confirmed by positive cultures - infection control core process. Role prefix \'diagnostic_\' indicates event confirmation. Required for NHSN reporting and outbreak investigation. R' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MicrobiologyCulture .

ind:reportingEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Reporting Employee Id' ;
    rdfs:domain ind:HaiEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:responseClinicalOrderId rdf:type rdf:Property ;
    rdfs:label 'Response Clinical Order Id' ;
    rdfs:comment 'Foreign key linking to order.clinical_order. Business justification: HAI events trigger response orders. Real workflow: CLABSI identified, orders placed for line removal and antibiotics. Essential for infection control tracking, HAI response protocol compliance, NHSN r' ;
    rdfs:domain ind:HaiEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ClinicalOrder .

ind:susceptibilityResultId rdf:type rdf:Property ;
    rdfs:label 'Susceptibility Result Id' ;
    rdfs:comment 'Foreign key linking to laboratory.susceptibility_result. Business justification: Antibiotic selection for HAI treatment based on susceptibility results. Essential for antibiotic stewardship and MDRO tracking. Removes denormalized resistance profile data in favor of proper FK relat' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SusceptibilityResult .

ind:treatmentDrugMasterId rdf:type rdf:Property ;
    rdfs:label 'Treatment Drug Master Id' ;
    rdfs:comment 'Foreign key linking to pharmacy.drug_master. Business justification: Healthcare-acquired infections treated with specific antimicrobials. Antibiotic stewardship programs track drug-bug relationships, resistance patterns, and treatment outcomes. Required for NHSN report' ;
    rdfs:domain ind:HaiEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DrugMaster .

ind:attributedLosDays rdf:type rdf:Property ;
    rdfs:label 'Attributed Los Days' ;
    rdfs:comment 'Number of additional inpatient days clinically attributed to this HAI event beyond the expected Length of Stay (LOS). Used for cost-of-infection analysis, quality improvement, and VBP impact assessments. Distinct from total encounter LOS.' ;
    rdfs:domain ind:HaiEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:deviceDays rdf:type rdf:Property ;
    rdfs:label 'Device Days' ;
    rdfs:comment 'Total number of device-days (central line days, catheter days, or ventilator days) for the patient during the relevant surveillance period. Used as the denominator in NHSN device-associated infection rate calculations (infections per 1,000 device days).' ;
    rdfs:domain ind:HaiEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:eventDate rdf:type rdf:Property ;
    rdfs:label 'Event Date' ;
    rdfs:comment 'The date on which the Healthcare-Associated Infection (HAI) event was identified or the infection onset date as defined by NHSN criteria. This is the principal real-world event date used for NHSN reporting, rate calculations, and CMS submission windows.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:infectionOnsetSetting rdf:type rdf:Property ;
    rdfs:label 'Infection Onset Setting' ;
    rdfs:comment 'Clinical setting in which the infection is determined to have originated: inpatient (hospital-acquired), outpatient, community-acquired, long-term care facility (LTCF), or unknown. Supports NHSN attribution rules and population health analysis.' ;
    rdfs:domain ind:HaiEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:infectionSite rdf:type rdf:Property ;
    rdfs:label 'Infection Site' ;
    rdfs:domain ind:HaiEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:infectionType rdf:type rdf:Property ;
    rdfs:label 'Infection Type' ;
    rdfs:comment 'Classification of the HAI event per NHSN definitions: Central Line-Associated Bloodstream Infection (CLABSI), Catheter-Associated Urinary Tract Infection (CAUTI), Surgical Site Infection (SSI), Methicillin-Resistant Staphylococcus aureus (MRSA) bacteremia, Clostridioides difficile Infection (CDI), or Ventilator-Associated Pneumonia (VAP). Drives NHSN module routing and CMS VBP penalty calculations.' ;
    rdfs:domain ind:HaiEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ipReviewDate rdf:type rdf:Property ;
    rdfs:label 'Ip Review Date' ;
    rdfs:comment 'Date on which the infection preventionist completed their clinical review of this HAI event. Used for workflow tracking, timeliness metrics, and audit trail documentation.' ;
    rdfs:domain ind:HaiEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ipReviewNotes rdf:type rdf:Property ;
    rdfs:label 'Ip Review Notes' ;
    rdfs:comment 'Free-text clinical notes entered by the infection preventionist during review of this HAI event. May include rationale for confirmation, rejection, or amendment of the event classification. Supports CDI and quality review workflows.' ;
    rdfs:domain ind:HaiEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ipReviewStatus rdf:type rdf:Property ;
    rdfs:label 'Ip Review Status' ;
    rdfs:comment 'Status of the infection preventionist\'s clinical review of this HAI event. Tracks whether the IP has reviewed, approved, or disputed the event classification prior to NHSN submission. Required for regulatory audit trails.' ;
    rdfs:domain ind:HaiEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nhsnDefinitionMet rdf:type rdf:Property ;
    rdfs:label 'Nhsn Definition Met' ;
    rdfs:comment 'Indicates whether this event meets the CDC NHSN surveillance definition criteria for the specified infection type. True = confirmed HAI per NHSN criteria; False = under review or criteria not fully met. Determines reportability to CMS and state health departments.' ;
    rdfs:domain ind:HaiEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nhsnEventNumber rdf:type rdf:Property ;
    rdfs:label 'Nhsn Event Number' ;
    rdfs:comment 'Unique event number assigned by the CDC National Healthcare Safety Network (NHSN) upon submission of this HAI event. Used for regulatory tracking, CMS reporting reconciliation, and state mandatory reporting.' ;
    rdfs:domain ind:HaiEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nhsnProcedureCode rdf:type rdf:Property ;
    rdfs:label 'Nhsn Procedure Code' ;
    rdfs:comment 'NHSN-specific procedure category code for the operative procedure linked to an SSI event (e.g., COLO for colon surgery, HPRO for hip prosthesis). Distinct from CPT codes; used specifically for NHSN SSI risk index calculation and benchmarking.' ;
    rdfs:domain ind:HaiEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nhsnReported rdf:type rdf:Property ;
    rdfs:label 'Nhsn Reported' ;
    rdfs:domain ind:HaiEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nhsnReportingStatus rdf:type rdf:Property ;
    rdfs:label 'Nhsn Reporting Status' ;
    rdfs:comment 'Indicates the submission and acceptance status of this HAI event with the CDC National Healthcare Safety Network (NHSN). Tracks whether the event has been reported, accepted, or rejected by NHSN. Critical for CMS HAI reporting compliance and VBP penalty avoidance.' ;
    rdfs:domain ind:HaiEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nhsnSubmissionDate rdf:type rdf:Property ;
    rdfs:label 'Nhsn Submission Date' ;
    rdfs:comment 'Date on which this HAI event was submitted to the CDC National Healthcare Safety Network (NHSN). Used to verify timely reporting compliance with CMS and state mandatory reporting deadlines.' ;
    rdfs:domain ind:HaiEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:organismName rdf:type rdf:Property ;
    rdfs:label 'Organism Name' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outbreakFlag rdf:type rdf:Property ;
    rdfs:label 'Outbreak Flag' ;
    rdfs:comment 'Indicates whether this HAI event has been associated with a declared infection outbreak investigation at the facility. True = linked to an active or closed outbreak; False = sporadic/isolated event. Supports epidemiological cluster analysis.' ;
    rdfs:domain ind:HaiEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:outbreakId rdf:type rdf:Property ;
    rdfs:label 'Outbreak Id' ;
    rdfs:comment 'Identifier linking this HAI event to a specific outbreak investigation record when outbreak_flag is True. Enables grouping of related HAI events for epidemiological analysis and root cause investigation.' ;
    rdfs:domain ind:Clinical ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:patientDays rdf:type rdf:Property ;
    rdfs:label 'Patient Days' ;
    rdfs:comment 'Total number of patient-days in the unit or facility during the surveillance period associated with this HAI event. Used as the denominator for non-device-associated infection rates (e.g., CDI, MRSA per 10,000 patient days) per NHSN methodology.' ;
    rdfs:domain ind:HaiEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:patientOutcome rdf:type rdf:Property ;
    rdfs:label 'Patient Outcome' ;
    rdfs:comment 'Clinical outcome of the patient attributed to or associated with this HAI event: recovered, transferred to higher level of care, expired, or unknown. Used for mortality analysis, quality reporting, and NHSN outcome tracking.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postAcuteFacilityAcquiredFlag rdf:type rdf:Property ;
    rdfs:label 'Post Acute Facility Acquired Flag' ;
    rdfs:comment 'Indicates whether HAI was acquired in a post-acute care facility' ;
    rdfs:domain ind:HaiEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:secondaryInfectionType rdf:type rdf:Property ;
    rdfs:label 'Secondary Infection Type' ;
    rdfs:comment 'Secondary or co-occurring HAI type when a patient experiences more than one concurrent infection event (e.g., a patient with both CLABSI and CAUTI). Nullable; populated only when a secondary infection is clinically documented and meets NHSN criteria.' ;
    rdfs:domain ind:HaiEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ssiDepth rdf:type rdf:Property ;
    rdfs:label 'Ssi Depth' ;
    rdfs:comment 'NHSN classification of the depth/anatomical level of the Surgical Site Infection (SSI): Superficial Incisional, Deep Incisional, or Organ/Space. Applicable only when infection_type = \'SSI\'. Determines NHSN SSI category and CMS reporting classification.' ;
    rdfs:domain ind:HaiEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ssiWoundClass rdf:type rdf:Property ;
    rdfs:label 'Ssi Wound Class' ;
    rdfs:comment 'NHSN wound classification for Surgical Site Infection (SSI) events: Clean, Clean-Contaminated, Contaminated, or Dirty/Infected. Applicable only when infection_type = \'SSI\'. Used for SSI risk stratification and NHSN SSI rate calculations.' ;
    rdfs:domain ind:HaiEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateReportDate rdf:type rdf:Property ;
    rdfs:label 'State Report Date' ;
    rdfs:comment 'Date on which this HAI event was reported to the state health department, when state_reportable_flag is True. Used to verify compliance with state mandatory reporting timelines.' ;
    rdfs:domain ind:HaiEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:stateReportableFlag rdf:type rdf:Property ;
    rdfs:label 'State Reportable Flag' ;
    rdfs:comment 'Indicates whether this HAI event is subject to mandatory reporting to the state health department under applicable state law. True = state reporting required; False = not subject to state mandatory reporting. Varies by infection type and state jurisdiction.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:haiEventStatus rdf:type rdf:Property ;
    rdfs:label 'Hai Event Status' ;
    rdfs:domain ind:HaiEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unitLocationCode rdf:type rdf:Property ;
    rdfs:label 'Unit Location Code' ;
    rdfs:comment 'NHSN-mapped location code identifying the patient care unit or ward where the HAI event occurred (e.g., ICU, medical-surgical, step-down). Used for unit-level infection rate calculations, benchmarking, and targeted prevention interventions.' ;
    rdfs:domain ind:HaiEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unitLocationDescription rdf:type rdf:Property ;
    rdfs:label 'Unit Location Description' ;
    rdfs:comment 'Human-readable description of the patient care unit or ward where the HAI event occurred (e.g., \'Medical ICU\', \'Surgical Step-Down Unit\'). Complements the NHSN location code for reporting and operational dashboards.' ;
    rdfs:domain ind:HaiEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vbpPenaltyFlag rdf:type rdf:Property ;
    rdfs:label 'Vbp Penalty Flag' ;
    rdfs:comment 'Indicates whether this HAI event contributes to a CMS Value-Based Purchasing (VBP) HAI domain penalty calculation for the facility. True = event is included in VBP HAI scoring; False = excluded from VBP calculation.' ;
    rdfs:domain ind:HaiEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:clinicalFindingId rdf:type rdf:Property ;
    rdfs:label 'Clinical Finding Id' ;
    rdfs:comment 'Unique surrogate identifier for the clinical finding record in the lakehouse silver layer.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ClinicalFinding .

ind:fhirObservationId rdf:type rdf:Property ;
    rdfs:label 'Fhir Observation Id' ;
    rdfs:comment 'FHIR Observation resource identifier assigned during FHIR-based clinical data exchange, enabling semantic interoperability with external Health Information Exchange (HIE) partners and APIs.' ;
    rdfs:domain ind:ClinicalFinding ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Observation .

ind:icd10FindingIcdCodeId rdf:type rdf:Property ;
    rdfs:label 'Icd10 Finding Icd Code Id' ;
    rdfs:comment 'Foreign key linking to reference.icd_code. Business justification: Findings may be mapped to ICD-10 codes for billing support, incidental finding tracking, and diagnosis-based population health cohort identification. Links enable finding-to-diagnosis crosswalks for a' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:IcdCode .

ind:radiologyStudyId rdf:type rdf:Property ;
    rdfs:label 'Radiology Study Id' ;
    rdfs:comment 'FK to radiology study when finding_domain=RADIOLOGY' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RadiologyStudy .

ind:reportId rdf:type rdf:Property ;
    rdfs:label 'Report Id' ;
    rdfs:comment 'Reference to the parent radiology report from which this finding was extracted or coded. Links the finding to its source narrative report for audit and traceability.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Report .

ind:sourceTestResultId rdf:type rdf:Property ;
    rdfs:label 'Source Test Result Id' ;
    rdfs:comment 'Foreign key linking to laboratory.test_result. Business justification: Clinical findings often derived from/supported by lab results (finding=\'hyperkalemia\' sourced from test_result). Role prefix \'source_\' indicates data origin. Removes denormalized lab value fields in f' ;
    rdfs:domain ind:ClinicalFinding ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TestResult .

ind:accessionNumber rdf:type rdf:Property ;
    rdfs:label 'Accession Number' ;
    rdfs:comment 'Externally-known unique identifier assigned by the Radiology Information System (RIS) to the imaging order/study from which this finding was extracted. Used as the primary cross-system business key linking findings to their parent imaging study in Epic Radiant and Cerner RadNet.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:acrScoreType rdf:type rdf:Property ;
    rdfs:label 'Acr Score Type' ;
    rdfs:comment 'Identifies the ACR (American College of Radiology) standardized scoring system applied to this finding. LUNG_RADS for lung nodules, BI_RADS for breast imaging, TI_RADS for thyroid nodules, LI_RADS for liver observations, PI_RADS for prostate, C_RADS for colon. NONE if no ACR scoring system applies. [ENUM-REF-CANDIDATE: LUNG_RADS|BI_RADS|TI_RADS|LI_RADS|PI_RADS|C_RADS|NONE — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:acrScoreValue rdf:type rdf:Property ;
    rdfs:label 'Acr Score Value' ;
    rdfs:comment 'The specific score or category value assigned under the applicable ACR scoring system (e.g., \'3\' for Lung-RADS 3, \'4B\' for BI-RADS 4B, \'M\' for LI-RADS M). Stored as STRING to accommodate alphanumeric category designations across different ACR systems.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:aiDetectedFlag rdf:type rdf:Property ;
    rdfs:label 'Ai Detected Flag' ;
    rdfs:comment 'Whether finding was detected by AI/ML model' ;
    rdfs:domain ind:ClinicalFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:aiModelSource rdf:type rdf:Property ;
    rdfs:label 'Ai Model Source' ;
    rdfs:comment 'Name/version of AI model that generated this finding, if applicable' ;
    rdfs:domain ind:ClinicalFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:chronicFindingFlag rdf:type rdf:Property ;
    rdfs:label 'Chronic Finding Flag' ;
    rdfs:comment 'Indicates whether this clinical finding represents a chronic or persistent condition rather than an acute or transient observation. Supports population health management and chronic disease registries.' ;
    rdfs:domain ind:ClinicalFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dataSourceMethod rdf:type rdf:Property ;
    rdfs:label 'Data Source Method' ;
    rdfs:comment 'Indicates how this structured finding was captured: NLP_EXTRACTED = derived via natural language processing from free-text report; RADIOLOGIST_CODED = directly coded by the radiologist using structured reporting tools; STRUCTURED_TEMPLATE = populated via a structured reporting template (e.g., Epic Radiant SmartForms); MANUAL_ENTRY = manually entered by HIM or CDI staff.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dicomSeriesUid rdf:type rdf:Property ;
    rdfs:label 'Dicom Series Uid' ;
    rdfs:comment 'DICOM Series Instance UID identifying the specific image series within the PACS (Picture Archiving and Communication System) where this finding was identified. Enables direct PACS image retrieval and viewer deep-linking for clinical review.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dicomSopInstanceUid rdf:type rdf:Property ;
    rdfs:label 'Dicom Sop Instance Uid' ;
    rdfs:comment 'DICOM SOP Instance UID identifying the specific image instance (slice/frame) within the PACS where this finding is most prominently visualized. Supports precise image-level annotation and AI/ML training data linkage.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentationDate rdf:type rdf:Property ;
    rdfs:label 'Documentation Date' ;
    rdfs:comment 'Calendar date on which the clinical finding was documented by the provider in the Electronic Health Record (EHR). Used for longitudinal clinical tracking and quality measure date attribution.' ;
    rdfs:domain ind:ClinicalFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:escalationStatus rdf:type rdf:Property ;
    rdfs:label 'Escalation Status' ;
    rdfs:comment 'Indicates whether this finding has been escalated beyond standard notification workflows (e.g., escalated to department chief, patient safety officer, or risk management). Supports critical finding management and patient safety reporting.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:escalationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Escalation Timestamp' ;
    rdfs:comment 'Date and time when this finding was escalated. Populated when escalation_status transitions to ESCALATED. Supports patient safety audit trails and risk management workflows.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:findingCategory rdf:type rdf:Property ;
    rdfs:label 'Finding Category' ;
    rdfs:comment 'High-level category classifying the type of clinical finding. [ENUM-REF-CANDIDATE: exam|symptom|history|functional|laboratory|imaging|social|vital-sign|assessment — promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:findingComment rdf:type rdf:Property ;
    rdfs:label 'Finding Comment' ;
    rdfs:comment 'Free-text narrative comment or clinical note addendum provided by the documenting provider to further qualify or contextualize the finding beyond structured coded fields.' ;
    rdfs:domain ind:ClinicalFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:findingDescription rdf:type rdf:Property ;
    rdfs:label 'Finding Description' ;
    rdfs:comment 'Human-readable clinical description of the discrete finding as documented or extracted from the radiology report (e.g., \'Solitary pulmonary nodule, right upper lobe, 8mm\'). Supports clinical review, CDI workflows, and NLP validation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:findingDomain rdf:type rdf:Property ;
    rdfs:label 'Finding Domain' ;
    rdfs:comment 'Domain discriminator: CLINICAL or RADIOLOGY' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:findingStatus rdf:type rdf:Property ;
    rdfs:label 'Finding Status' ;
    rdfs:comment 'Clinical assertion status indicating whether the finding is present, absent, unknown, indeterminate, or not assessed for this patient at this encounter. Core semantic qualifier per SNOMED CT post-coordination.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:followUpCompletedDate rdf:type rdf:Property ;
    rdfs:label 'Follow Up Completed Date' ;
    rdfs:comment 'Date on which the recommended follow-up action was completed. Populated when follow_up_status transitions to COMPLETED. Used for compliance reporting and outcome tracking.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:followUpModality rdf:type rdf:Property ;
    rdfs:label 'Follow Up Modality' ;
    rdfs:comment 'Specific imaging modality recommended for follow-up when follow_up_type is IMAGING (e.g., \'CT Chest with contrast\', \'MRI Brain without contrast\', \'PET/CT\'). Free-text or coded value per ACR guidelines.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:followUpRecommended rdf:type rdf:Property ;
    rdfs:label 'Follow Up Recommended' ;
    rdfs:comment 'Indicates whether the radiologist has recommended follow-up action for this finding. When TRUE, the follow-up recommendation fields are expected to be populated. Supports ACR incidental finding tracking and CMS quality measures.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:followUpStatus rdf:type rdf:Property ;
    rdfs:label 'Follow Up Status' ;
    rdfs:comment 'Current status of the follow-up recommendation lifecycle. PENDING = not yet acted upon; SCHEDULED = follow-up appointment or order placed; COMPLETED = follow-up performed; OVERDUE = past due date without completion; CANCELLED = follow-up cancelled; NOT_REQUIRED = no follow-up needed.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:followUpTimeframeDays rdf:type rdf:Property ;
    rdfs:label 'Follow Up Timeframe Days' ;
    rdfs:comment 'Recommended timeframe in days within which the follow-up action should be completed, as specified by the radiologist or derived from ACR guidelines (e.g., 90 days for Lung-RADS 3, 30 days for Lung-RADS 4A). Used for follow-up scheduling and compliance tracking.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:followUpType rdf:type rdf:Property ;
    rdfs:label 'Follow Up Type' ;
    rdfs:comment 'Type of follow-up action recommended by the radiologist for this finding. IMAGING = repeat or additional imaging; BIOPSY = tissue sampling; CLINICAL_EVALUATION = provider assessment; LABORATORY = lab workup; REFERRAL = specialist referral; NO_ACTION = no further action needed. [ENUM-REF-CANDIDATE: IMAGING|BIOPSY|CLINICAL_EVALUATION|LABORATORY|REFERRAL|NO_ACTION|OTHER — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:imagingModality rdf:type rdf:Property ;
    rdfs:label 'Imaging Modality' ;
    rdfs:comment 'The imaging modality used to produce the study from which this finding was identified (e.g., CT, MRI, XRAY, ULTRASOUND, PET). Supports modality-specific analytics, ACR scoring applicability, and scheduling workflows. [ENUM-REF-CANDIDATE: CT|MRI|XRAY|ULTRASOUND|PET|PET_CT|MAMMOGRAPHY|FLUOROSCOPY|NUCLEAR_MED|DEXA|ANGIO|OTHER — promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interpretationCode rdf:type rdf:Property ;
    rdfs:label 'Interpretation Code' ;
    rdfs:comment 'Standardized interpretation flag for the finding value relative to reference ranges (e.g., N=Normal, H=High, L=Low, HH=Critical High, LL=Critical Low, POS=Positive, NEG=Negative, IND=Indeterminate). Aligns with HL7 v2 OBX-8. [ENUM-REF-CANDIDATE: N|A|H|L|HH|LL|POS|NEG|IND — 9 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isCriticalResult rdf:type rdf:Property ;
    rdfs:label 'Is Critical Result' ;
    rdfs:comment 'Indicates whether this finding meets the organization\'s criteria for a critical/urgent result requiring immediate communication to the ordering provider. Drives critical result notification workflows per TJC NPSG.02.03.01.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isIncidentalFinding rdf:type rdf:Property ;
    rdfs:label 'Is Incidental Finding' ;
    rdfs:comment 'Indicates whether this finding was identified incidentally (outside the primary clinical indication for the imaging study). Drives ACR incidental finding management workflows and population health tracking.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:measurementUnit rdf:type rdf:Property ;
    rdfs:label 'Measurement Unit' ;
    rdfs:comment 'Unit of measure for the measurement_value (e.g., mm for nodule diameter, HU for Hounsfield units on CT, SUV for PET standardized uptake value). Follows UCUM (Unified Code for Units of Measure) standards.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:measurementValue rdf:type rdf:Property ;
    rdfs:label 'Measurement Value' ;
    rdfs:comment 'Principal quantitative measurement associated with the finding (e.g., nodule size in mm, lesion diameter, SUV max for PET findings). The unit is specified in measurement_unit. Supports size-based ACR scoring, trending, and growth rate analytics.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nlpConfidenceScore rdf:type rdf:Property ;
    rdfs:label 'Nlp Confidence Score' ;
    rdfs:comment 'Confidence score (0.0000–1.0000) assigned by the NLP engine when data_source_method is NLP_EXTRACTED. Indicates the model\'s certainty in the extracted finding. Used for quality filtering, human review routing, and AI/ML model validation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:patientNotificationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Patient Notification Timestamp' ;
    rdfs:comment 'Date and time when the patient was notified of this finding (e.g., via patient portal, phone, or letter). Supports 21st Century Cures Act compliance and patient engagement analytics.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:patientNotified rdf:type rdf:Property ;
    rdfs:label 'Patient Notified' ;
    rdfs:comment 'Indicates whether the patient has been notified of this finding and any associated follow-up recommendations. Supports patient engagement, portal communication tracking, and regulatory compliance.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:providerNotificationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Provider Notification Timestamp' ;
    rdfs:comment 'Date and time when the ordering or responsible provider was notified of this finding. Supports critical result communication audit trails and TJC compliance documentation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:providerNotified rdf:type rdf:Property ;
    rdfs:label 'Provider Notified' ;
    rdfs:comment 'Indicates whether the ordering or responsible provider has been notified of this finding and its follow-up recommendation. Required for critical result communication compliance per TJC NPSG.02.03.01.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reportFinalizedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Report Finalized Timestamp' ;
    rdfs:comment 'Date and time when the radiology report containing this finding was finalized (signed/attested) by the interpreting radiologist. Used for turnaround time measurement, SLA compliance, and MIPS quality reporting.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:sensitiveFindingType rdf:type rdf:Property ;
    rdfs:label 'Sensitive Finding Type' ;
    rdfs:comment 'Classifies the finding as belonging to a sensitive clinical category subject to heightened privacy protections beyond standard HIPAA PHI rules (e.g., behavioral health, substance use disorder per 42 CFR Part 2, HIV status, sexual health, genetic information). \'none\' indicates no special sensitivity.' ;
    rdfs:domain ind:ClinicalFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemFindingCode rdf:type rdf:Property ;
    rdfs:label 'Source System Finding Code' ;
    rdfs:comment 'Native identifier of this clinical finding in the originating operational system (Epic or Cerner internal ID), used for lineage and reconciliation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clinicalFindingStatus rdf:type rdf:Property ;
    rdfs:label 'Clinical Finding Status' ;
    rdfs:domain ind:ClinicalFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:studyDate rdf:type rdf:Property ;
    rdfs:label 'Study Date' ;
    rdfs:comment 'The calendar date on which the imaging study was performed. Principal business event date for the finding. Used for follow-up interval calculation, trending, and population health reporting.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:valueCode rdf:type rdf:Property ;
    rdfs:label 'Value Code' ;
    rdfs:comment 'Coded value for the finding when the result is expressed as a coded concept rather than a numeric quantity (e.g., a SNOMED CT code for \'positive\', \'negative\', or a specific coded finding result).' ;
    rdfs:domain ind:ClinicalFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:valueString rdf:type rdf:Property ;
    rdfs:label 'Value String' ;
    rdfs:comment 'Free-text string value for the finding when the result cannot be expressed as a numeric quantity or coded concept (e.g., \'Grade II/VI systolic murmur\', \'Coarse breath sounds bilaterally\').' ;
    rdfs:domain ind:ClinicalFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vibeMutationFlag rdf:type rdf:Property ;
    rdfs:label 'Vibe Mutation Flag' ;
    rdfs:comment 'Added by VIBE mutator to ensure model change.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:procedureEquipmentUsageId rdf:type rdf:Property ;
    rdfs:label 'Procedure Equipment Usage Id' ;
    rdfs:comment 'Unique surrogate identifier for each procedure-equipment usage record. Primary key.' ;
    rdfs:domain ind:ProcedureEquipmentUsage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:procedureDocumentedByClinicianId rdf:type rdf:Property ;
    rdfs:label 'Procedure Documented By Clinician Id' ;
    rdfs:comment 'Reference to the clinician (surgeon, nurse, surgical tech) who documented this equipment usage in the clinical system. Supports audit trail and accountability.' ;
    rdfs:domain ind:ProcedureEquipmentUsage ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:chargeCapturedFlag rdf:type rdf:Property ;
    rdfs:label 'Charge Captured Flag' ;
    rdfs:comment 'Indicates whether a revenue cycle charge was generated for this equipment usage. Links equipment utilization to charge capture and revenue integrity.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:documentationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Documentation Timestamp' ;
    rdfs:comment 'Date and time when this equipment usage record was documented in the source system. Supports audit trail and data quality assessment.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:equipmentMalfunctionFlag rdf:type rdf:Property ;
    rdfs:label 'Equipment Malfunction Flag' ;
    rdfs:comment 'Indicates whether the equipment experienced a malfunction, failure, or performance issue during this procedure. Triggers biomedical engineering investigation and potential FDA Medical Device Reporting (MDR).' ;
    rdfs:domain ind:ProcedureEquipmentUsage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:genomicSequencerFlag rdf:type rdf:Property ;
    rdfs:label 'Genomic Sequencer Flag' ;
    rdfs:comment 'Indicates whether equipment used is a genomic sequencing instrument' ;
    rdfs:domain ind:ProcedureEquipmentUsage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:implantUsed rdf:type rdf:Property ;
    rdfs:label 'Implant Used' ;
    rdfs:comment 'Indicates whether a medical implant or device was used during the procedure. Triggers implant log documentation requirements, FDA device tracking obligations, and supply chain charge capture. [Moved from procedure_event: The implant_used flag in procedure_event is a procedure-level aggregate indicator, but the actual implant usage is equipment-specific. A procedure may use multiple equipment assets, only some of which are implants. The implant_used_flag and udi belong in the association to track which specific equipment assets were implanted, enabling FDA traceability at the device level rather than just the procedure level.]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:implantUsedFlag rdf:type rdf:Property ;
    rdfs:label 'Implant Used Flag' ;
    rdfs:comment 'Indicates whether this specific equipment asset was used as an implantable device during the procedure. Critical for FDA traceability requirements and patient implant registries.' ;
    rdfs:domain ind:ProcedureEquipmentUsage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:malfunctionDescription rdf:type rdf:Property ;
    rdfs:label 'Malfunction Description' ;
    rdfs:comment 'Free-text description of the equipment malfunction or performance issue if equipment_malfunction_flag is true. Used for root cause analysis and FDA reporting.' ;
    rdfs:domain ind:ProcedureEquipmentUsage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:quantityUsed rdf:type rdf:Property ;
    rdfs:label 'Quantity Used' ;
    rdfs:comment 'Numeric quantity of the material item consumed during the surgical case, expressed in the material\'s stocking unit of measure. Used for inventory depletion, cost calculation, and utilization analytics.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:procedureEquipmentUsageStatus rdf:type rdf:Property ;
    rdfs:label 'Procedure Equipment Usage Status' ;
    rdfs:domain ind:ProcedureEquipmentUsage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sterilizationLotNumber rdf:type rdf:Property ;
    rdfs:label 'Sterilization Lot Number' ;
    rdfs:comment 'Lot or batch number from the sterilization cycle that processed this equipment prior to use in this procedure. Critical for infection control tracking and sterile processing quality assurance.' ;
    rdfs:domain ind:ProcedureEquipmentUsage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:usageDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Usage Duration Minutes' ;
    rdfs:comment 'Total elapsed time in minutes that the equipment was actively used during the procedure. Derived from usage_start_timestamp and usage_end_timestamp. Supports utilization rate calculations and capacity planning.' ;
    rdfs:domain ind:ProcedureEquipmentUsage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:usageEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Usage End Timestamp' ;
    rdfs:comment 'Date and time when the equipment usage concluded and the asset was released from the procedure. Used to calculate actual usage duration and equipment turnover time.' ;
    rdfs:domain ind:ProcedureEquipmentUsage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:usageRole rdf:type rdf:Property ;
    rdfs:label 'Usage Role' ;
    rdfs:comment 'Role or function of the equipment during the procedure (primary, backup, standby, ancillary). Distinguishes between primary surgical equipment and supporting devices.' ;
    rdfs:domain ind:ProcedureEquipmentUsage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:usageStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Usage Start Timestamp' ;
    rdfs:comment 'Date and time when the equipment was deployed and began being used during the procedure. Critical for utilization tracking and equipment availability management.' ;
    rdfs:domain ind:ProcedureEquipmentUsage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:planCareCoordinationId rdf:type rdf:Property ;
    rdfs:label 'Plan Care Coordination Id' ;
    rdfs:comment 'Unique surrogate identifier for this care plan-health plan coordination record' ;
    rdfs:domain ind:PlanCareCoordination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:planClinicianId rdf:type rdf:Property ;
    rdfs:label 'Plan Clinician Id' ;
    rdfs:comment 'Reference to the health plan\'s case manager or care coordinator assigned to this care plan. May be different from the provider organization\'s care coordinator.' ;
    rdfs:domain ind:PlanCareCoordination ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:planCoordinatorClinicianId rdf:type rdf:Property ;
    rdfs:label 'Plan Coordinator Clinician Id' ;
    rdfs:domain ind:PlanCareCoordination ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:careManagementTier rdf:type rdf:Property ;
    rdfs:label 'Care Management Tier' ;
    rdfs:comment 'The level of care management intensity required by the health plan for this care plan. Values: basic, enhanced, intensive, complex. Drives care coordinator assignment and contact frequency requirements.' ;
    rdfs:domain ind:PlanCareCoordination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coordinationEndDate rdf:type rdf:Property ;
    rdfs:label 'Coordination End Date' ;
    rdfs:comment 'Date when coordination between this care plan and health plan ended. Null if coordination is ongoing.' ;
    rdfs:domain ind:PlanCareCoordination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:coordinationStartDate rdf:type rdf:Property ;
    rdfs:label 'Coordination Start Date' ;
    rdfs:comment 'Date when coordination between this care plan and health plan began. May differ from enrollment_date if coordination started before formal program enrollment.' ;
    rdfs:domain ind:PlanCareCoordination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:coordinationStatus rdf:type rdf:Property ;
    rdfs:label 'Coordination Status' ;
    rdfs:domain ind:PlanCareCoordination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coordinationType rdf:type rdf:Property ;
    rdfs:label 'Coordination Type' ;
    rdfs:domain ind:PlanCareCoordination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastPayerReviewDate rdf:type rdf:Property ;
    rdfs:label 'Last Payer Review Date' ;
    rdfs:comment 'Date of the most recent review or audit of this care plan by the health plan. Used for tracking payer engagement and compliance reviews.' ;
    rdfs:domain ind:PlanCareCoordination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nextPayerReviewDate rdf:type rdf:Property ;
    rdfs:label 'Next Payer Review Date' ;
    rdfs:comment 'Scheduled date for the next review of this care plan by the health plan. Drives care coordination workflow reminders.' ;
    rdfs:domain ind:PlanCareCoordination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:planSpecificGoalCount rdf:type rdf:Property ;
    rdfs:label 'Plan Specific Goal Count' ;
    rdfs:comment 'Number of care plan goals that are specifically required by this health plan\'s care management program. Subset of total care plan goals.' ;
    rdfs:domain ind:PlanCareCoordination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:postAcuteCoordinationFlag rdf:type rdf:Property ;
    rdfs:label 'Post Acute Coordination Flag' ;
    rdfs:comment 'Indicates whether this coordination activity involves post-acute care transitions' ;
    rdfs:domain ind:PlanCareCoordination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:primaryCoverageFlag rdf:type rdf:Property ;
    rdfs:label 'Primary Coverage Flag' ;
    rdfs:comment 'Indicates whether this health plan is the primary payer for this care plan. True for primary coverage, false for secondary/tertiary. Drives coordination of benefits and billing priority.' ;
    rdfs:domain ind:PlanCareCoordination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:planCareCoordinationStatus rdf:type rdf:Property ;
    rdfs:label 'Plan Care Coordination Status' ;
    rdfs:domain ind:PlanCareCoordination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvedByUserEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Approved By User Employee Id' ;
    rdfs:comment 'Identifier of the authorized user who approved this template for clinical use.' ;
    rdfs:domain ind:NoteTemplate ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:parentNoteTemplateId rdf:type rdf:Property ;
    rdfs:label 'Parent Note Template Id' ;
    rdfs:comment 'Self-referencing FK on note_template (parent_note_template_id)' ;
    rdfs:domain ind:NoteTemplate ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:NoteTemplate .

ind:autoPopulateFields rdf:type rdf:Property ;
    rdfs:label 'Auto Populate Fields' ;
    rdfs:comment 'Comma-separated list of field names that are automatically populated from patient record data when the template is opened.' ;
    rdfs:domain ind:NoteTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cdiEnabled rdf:type rdf:Property ;
    rdfs:label 'Cdi Enabled' ;
    rdfs:comment 'Indicates whether this template includes Clinical Documentation Improvement prompts and quality checks.' ;
    rdfs:domain ind:NoteTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:noteTemplateDescription rdf:type rdf:Property ;
    rdfs:label 'Note Template Description' ;
    rdfs:comment 'Detailed description of the templates purpose, intended use cases, and any special instructions for clinicians.' ;
    rdfs:domain ind:NoteTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedCompletionMinutes rdf:type rdf:Property ;
    rdfs:label 'Estimated Completion Minutes' ;
    rdfs:comment 'Average time in minutes required for a clinician to complete documentation using this template.' ;
    rdfs:domain ind:NoteTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fkFixMarker rdf:type rdf:Property ;
    rdfs:label 'Fk Fix Marker' ;
    rdfs:comment 'Marks self-referencing FK normalization (parent_note_template_id).' ;
    rdfs:domain ind:NoteTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:formatType rdf:type rdf:Property ;
    rdfs:label 'Format Type' ;
    rdfs:comment 'Technical format in which the template body content is stored and rendered.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:genomicsReportTemplateFlag rdf:type rdf:Property ;
    rdfs:label 'Genomics Report Template Flag' ;
    rdfs:comment 'Indicates whether this template is for genomic/pharmacogenomic reporting' ;
    rdfs:domain ind:NoteTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isDefaultForSpecialty rdf:type rdf:Property ;
    rdfs:label 'Is Default For Specialty' ;
    rdfs:comment 'Indicates whether this template is the default selection for its assigned clinical specialty.' ;
    rdfs:domain ind:NoteTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isSharedAcrossFacilities rdf:type rdf:Property ;
    rdfs:label 'Is Shared Across Facilities' ;
    rdfs:comment 'Indicates whether this template is available for use across multiple facilities within the healthcare organization.' ;
    rdfs:domain ind:NoteTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isStructured rdf:type rdf:Property ;
    rdfs:label 'Is Structured' ;
    rdfs:comment 'Indicates whether the template uses structured data entry fields with discrete data elements versus free-text narrative.' ;
    rdfs:domain ind:NoteTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:keywords rdf:type rdf:Property ;
    rdfs:label 'Keywords' ;
    rdfs:comment 'Comma-separated list of keywords and tags to facilitate template search and discovery by clinicians.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:macrosEnabled rdf:type rdf:Property ;
    rdfs:label 'Macros Enabled' ;
    rdfs:comment 'Indicates whether this template supports text expansion macros and shortcuts for efficient documentation.' ;
    rdfs:domain ind:NoteTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryRequirement rdf:type rdf:Property ;
    rdfs:label 'Regulatory Requirement' ;
    rdfs:comment 'Specific regulatory or compliance requirement that this template is designed to satisfy (e.g., CMS documentation requirements, Joint Commission standards).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requiredSections rdf:type rdf:Property ;
    rdfs:label 'Required Sections' ;
    rdfs:comment 'Comma-separated list of mandatory sections that must be completed before the note can be signed and finalized.' ;
    rdfs:domain ind:NoteTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requiresAttestation rdf:type rdf:Property ;
    rdfs:label 'Requires Attestation' ;
    rdfs:comment 'Indicates whether notes created from this template require formal clinician attestation and signature.' ;
    rdfs:domain ind:NoteTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:retirementDate rdf:type rdf:Property ;
    rdfs:label 'Retirement Date' ;
    rdfs:comment 'Date when this template was officially retired and removed from active use.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:noteTemplateStatus rdf:type rdf:Property ;
    rdfs:label 'Note Template Status' ;
    rdfs:comment 'Current lifecycle status of the note template indicating its availability for clinical use.' ;
    rdfs:domain ind:NoteTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supportsVoiceDictation rdf:type rdf:Property ;
    rdfs:label 'Supports Voice Dictation' ;
    rdfs:comment 'Indicates whether this template is optimized for voice dictation and speech recognition input.' ;
    rdfs:domain ind:NoteTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:templateBody rdf:type rdf:Property ;
    rdfs:label 'Template Body' ;
    rdfs:comment 'The structured content and layout of the clinical note template including sections, prompts, and data entry fields.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outbreakCreatedByUserEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Outbreak Created By User Employee Id' ;
    rdfs:comment 'Reference to the user who created the outbreak record.' ;
    rdfs:domain ind:Outbreak ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:outbreakEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Outbreak Employee Id' ;
    rdfs:comment 'Reference to the healthcare professional or epidemiologist leading the outbreak investigation.' ;
    rdfs:domain ind:Outbreak ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:outbreakReportingEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Outbreak Reporting Employee Id' ;
    rdfs:domain ind:Outbreak ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:outbreakUpdatedByUserEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Outbreak Updated By User Employee Id' ;
    rdfs:comment 'Reference to the user who last updated the outbreak record.' ;
    rdfs:domain ind:Outbreak ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:parentOutbreakId rdf:type rdf:Property ;
    rdfs:label 'Parent Outbreak Id' ;
    rdfs:comment 'Self-referencing FK on outbreak (parent_outbreak_id)' ;
    rdfs:domain ind:Outbreak ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Outbreak .

ind:caseCount rdf:type rdf:Property ;
    rdfs:label 'Case Count' ;
    rdfs:domain ind:Outbreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:caseFatalityRate rdf:type rdf:Property ;
    rdfs:label 'Case Fatality Rate' ;
    rdfs:comment 'Percentage of cases that resulted in death, calculated as (death_count / total_case_count) * 100.' ;
    rdfs:domain ind:Outbreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:outbreakCode rdf:type rdf:Property ;
    rdfs:label 'Outbreak Code' ;
    rdfs:comment 'Externally-known unique business identifier for the outbreak, typically assigned by public health authorities or internal epidemiology teams.' ;
    rdfs:domain ind:Outbreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:confirmedCaseCount rdf:type rdf:Property ;
    rdfs:label 'Confirmed Case Count' ;
    rdfs:comment 'Number of laboratory-confirmed cases associated with this outbreak.' ;
    rdfs:domain ind:Outbreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:containmentDate rdf:type rdf:Property ;
    rdfs:label 'Containment Date' ;
    rdfs:comment 'Date when the outbreak was successfully contained (no new cases for defined period).' ;
    rdfs:domain ind:Outbreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:controlMeasures rdf:type rdf:Property ;
    rdfs:label 'Control Measures' ;
    rdfs:comment 'Description of infection control and public health measures implemented to contain and resolve the outbreak.' ;
    rdfs:domain ind:Outbreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deathCount rdf:type rdf:Property ;
    rdfs:label 'Death Count' ;
    rdfs:comment 'Number of deaths attributed to the outbreak.' ;
    rdfs:domain ind:Outbreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:declarationDate rdf:type rdf:Property ;
    rdfs:label 'Declaration Date' ;
    rdfs:comment 'Date when the outbreak was formally declared by the responsible health authority.' ;
    rdfs:domain ind:Outbreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:declaredDate rdf:type rdf:Property ;
    rdfs:label 'Declared Date' ;
    rdfs:domain ind:Outbreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:detectionDate rdf:type rdf:Property ;
    rdfs:label 'Detection Date' ;
    rdfs:comment 'Date when the outbreak was officially detected and recognized by public health or infection control authorities.' ;
    rdfs:domain ind:Outbreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:diseaseCode rdf:type rdf:Property ;
    rdfs:label 'Disease Code' ;
    rdfs:comment 'ICD-10 code representing the disease or condition associated with the outbreak.' ;
    rdfs:domain ind:Outbreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:diseaseName rdf:type rdf:Property ;
    rdfs:label 'Disease Name' ;
    rdfs:comment 'Full clinical name of the disease or condition causing the outbreak (e.g., \'Salmonella Enteritidis Infection\', \'COVID-19\').' ;
    rdfs:domain ind:Outbreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geneticSequencingPerformedFlag rdf:type rdf:Property ;
    rdfs:label 'Genetic Sequencing Performed Flag' ;
    rdfs:comment 'Indicates whether genetic sequencing (e.g., whole genome sequencing) was performed to characterize the outbreak strain.' ;
    rdfs:domain ind:Outbreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:genomicSequencingLinkedFlag rdf:type rdf:Property ;
    rdfs:label 'Genomic Sequencing Linked Flag' ;
    rdfs:comment 'Indicates whether outbreak investigation includes pathogen genomic sequencing data' ;
    rdfs:domain ind:Outbreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:geographicScope rdf:type rdf:Property ;
    rdfs:label 'Geographic Scope' ;
    rdfs:comment 'Geographic extent of the outbreak spread.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hospitalizationCount rdf:type rdf:Property ;
    rdfs:label 'Hospitalization Count' ;
    rdfs:comment 'Number of cases requiring hospital admission due to the outbreak-related illness.' ;
    rdfs:domain ind:Outbreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:indexCaseDate rdf:type rdf:Property ;
    rdfs:label 'Index Case Date' ;
    rdfs:comment 'Date when the first case (index case) of the outbreak was identified or symptom onset occurred.' ;
    rdfs:domain ind:Outbreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:investigationStatus rdf:type rdf:Property ;
    rdfs:label 'Investigation Status' ;
    rdfs:comment 'Current status of the epidemiological investigation into the outbreak.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:laboratoryConfirmationMethod rdf:type rdf:Property ;
    rdfs:label 'Laboratory Confirmation Method' ;
    rdfs:comment 'Description of the laboratory testing method(s) used to confirm the outbreak pathogen (e.g., PCR, culture, serology, whole genome sequencing).' ;
    rdfs:domain ind:Outbreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mediaNotificationFlag rdf:type rdf:Property ;
    rdfs:label 'Media Notification Flag' ;
    rdfs:comment 'Indicates whether the outbreak was communicated to media or made public.' ;
    rdfs:domain ind:Outbreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:outbreakName rdf:type rdf:Property ;
    rdfs:label 'Outbreak Name' ;
    rdfs:comment 'Human-readable descriptive name or title of the outbreak event (e.g., \'Salmonella Outbreak - Regional Hospital Q2 2024\').' ;
    rdfs:domain ind:Outbreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outbreakStatus rdf:type rdf:Property ;
    rdfs:label 'Outbreak Status' ;
    rdfs:comment 'Current lifecycle status of the outbreak investigation and response.' ;
    rdfs:domain ind:Outbreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outbreakType rdf:type rdf:Property ;
    rdfs:label 'Outbreak Type' ;
    rdfs:domain ind:Outbreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pathogenType rdf:type rdf:Property ;
    rdfs:label 'Pathogen Type' ;
    rdfs:comment 'Classification of the causative agent responsible for the outbreak.' ;
    rdfs:domain ind:Outbreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryLocationType rdf:type rdf:Property ;
    rdfs:label 'Primary Location Type' ;
    rdfs:comment 'Type of setting where the outbreak primarily occurred or originated.' ;
    rdfs:domain ind:Outbreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:probableCaseCount rdf:type rdf:Property ;
    rdfs:label 'Probable Case Count' ;
    rdfs:comment 'Number of probable cases (meeting clinical criteria without laboratory confirmation) associated with this outbreak.' ;
    rdfs:domain ind:Outbreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:publicHealthAlertIssuedFlag rdf:type rdf:Property ;
    rdfs:label 'Public Health Alert Issued Flag' ;
    rdfs:comment 'Indicates whether a public health alert or advisory was issued to the community or healthcare providers.' ;
    rdfs:domain ind:Outbreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reportingJurisdiction rdf:type rdf:Property ;
    rdfs:label 'Reporting Jurisdiction' ;
    rdfs:comment 'State, territory, or country code of the jurisdiction responsible for outbreak reporting (ISO 3166-1 alpha-2 or alpha-3).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:severityLevel rdf:type rdf:Property ;
    rdfs:label 'Severity Level' ;
    rdfs:comment 'Classification of the outbreak severity based on case count, mortality, transmission rate, and public health impact.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceDescription rdf:type rdf:Property ;
    rdfs:label 'Source Description' ;
    rdfs:comment 'Detailed description of the identified or suspected source of the outbreak (e.g., contaminated food item, infected healthcare worker, environmental reservoir).' ;
    rdfs:domain ind:Outbreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceIdentifiedFlag rdf:type rdf:Property ;
    rdfs:label 'Source Identified Flag' ;
    rdfs:comment 'Indicates whether the source or origin of the outbreak has been definitively identified.' ;
    rdfs:domain ind:Outbreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:totalCaseCount rdf:type rdf:Property ;
    rdfs:label 'Total Case Count' ;
    rdfs:comment 'Total number of confirmed and probable cases associated with this outbreak.' ;
    rdfs:domain ind:Outbreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:transmissionMode rdf:type rdf:Property ;
    rdfs:label 'Transmission Mode' ;
    rdfs:comment 'Primary mode of disease transmission identified for this outbreak.' ;
    rdfs:domain ind:Outbreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:flowsheetTemplateId rdf:type rdf:Property ;
    rdfs:label 'Flowsheet Template Id' ;
    rdfs:comment 'Reference to the parent flowsheet template that contains this row. Links to the flowsheet template master table.' ;
    rdfs:domain ind:Clinical ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FlowsheetTemplate .

ind:parentFlowsheetRowId rdf:type rdf:Property ;
    rdfs:label 'Parent Flowsheet Row Id' ;
    rdfs:comment 'Self-referencing FK on flowsheet_row (parent_flowsheet_row_id)' ;
    rdfs:domain ind:FlowsheetRow ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FlowsheetRow .

ind:alertEnabled rdf:type rdf:Property ;
    rdfs:label 'Alert Enabled' ;
    rdfs:comment 'Indicates whether automated clinical alerts are enabled when values fall outside defined thresholds for this flowsheet row.' ;
    rdfs:domain ind:FlowsheetRow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:alertSeverity rdf:type rdf:Property ;
    rdfs:label 'Alert Severity' ;
    rdfs:comment 'Severity classification for clinical alerts generated by abnormal values in this flowsheet row.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:calculationFormula rdf:type rdf:Property ;
    rdfs:label 'Calculation Formula' ;
    rdfs:comment 'Mathematical or logical formula used to automatically calculate values for this flowsheet row from other clinical data elements.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:criticalHighThreshold rdf:type rdf:Property ;
    rdfs:label 'Critical High Threshold' ;
    rdfs:comment 'Critical high threshold value that triggers immediate clinical alerts when measurements exceed this level.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:criticalLowThreshold rdf:type rdf:Property ;
    rdfs:label 'Critical Low Threshold' ;
    rdfs:comment 'Critical low threshold value that triggers immediate clinical alerts when measurements fall below this level.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dataType rdf:type rdf:Property ;
    rdfs:label 'Data Type' ;
    rdfs:comment 'The data type expected for values recorded in this flowsheet row (numeric, text, date, selection list, etc.).' ;
    rdfs:domain ind:FlowsheetRow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:flowsheetRowDescription rdf:type rdf:Property ;
    rdfs:label 'Flowsheet Row Description' ;
    rdfs:comment 'Detailed description of the clinical measurement or observation captured by this flowsheet row, including clinical context and usage guidance.' ;
    rdfs:domain ind:FlowsheetRow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:displayFormat rdf:type rdf:Property ;
    rdfs:label 'Display Format' ;
    rdfs:comment 'Format specification for displaying values in clinical user interfaces (e.g., decimal precision, date format, text length).' ;
    rdfs:domain ind:FlowsheetRow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:displaySequence rdf:type rdf:Property ;
    rdfs:label 'Display Sequence' ;
    rdfs:comment 'Numeric sequence controlling the display order of flowsheet rows in clinical documentation interfaces.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:documentationFrequency rdf:type rdf:Property ;
    rdfs:label 'Documentation Frequency' ;
    rdfs:comment 'Expected or required frequency for documenting this measurement in clinical workflows (e.g., hourly for critical care vital signs).' ;
    rdfs:domain ind:FlowsheetRow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interfaceCode rdf:type rdf:Property ;
    rdfs:label 'Interface Code' ;
    rdfs:comment 'External system interface code used for mapping this flowsheet row to medical devices, laboratory systems, or other clinical data sources.' ;
    rdfs:domain ind:FlowsheetRow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isBillable rdf:type rdf:Property ;
    rdfs:label 'Is Billable' ;
    rdfs:comment 'Indicates whether documentation of this flowsheet row contributes to billable clinical services or procedures.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isCalculated rdf:type rdf:Property ;
    rdfs:label 'Is Calculated' ;
    rdfs:comment 'Indicates whether the value for this flowsheet row is automatically calculated from other measurements rather than manually entered.' ;
    rdfs:domain ind:FlowsheetRow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isRequired rdf:type rdf:Property ;
    rdfs:label 'Is Required' ;
    rdfs:comment 'Indicates whether documentation of this flowsheet row is mandatory for specific clinical workflows or regulatory compliance.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:modifiedBy rdf:type rdf:Property ;
    rdfs:label 'Modified By' ;
    rdfs:comment 'Identifier of the system user or administrator who last modified this flowsheet row configuration.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:normalRangeHigh rdf:type rdf:Property ;
    rdfs:label 'Normal Range High' ;
    rdfs:comment 'Upper bound of the normal reference range for this measurement. Used for clinical decision support and alerting.' ;
    rdfs:domain ind:FlowsheetRow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:normalRangeLow rdf:type rdf:Property ;
    rdfs:label 'Normal Range Low' ;
    rdfs:comment 'Lower bound of the normal reference range for this measurement. Used for clinical decision support and alerting.' ;
    rdfs:domain ind:FlowsheetRow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:privacyLevel rdf:type rdf:Property ;
    rdfs:label 'Privacy Level' ;
    rdfs:comment 'Privacy classification level for data in this flowsheet row, determining access controls and disclosure restrictions under HIPAA and organizational policies.' ;
    rdfs:domain ind:FlowsheetRow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qualityMeasureIndicator rdf:type rdf:Property ;
    rdfs:label 'Quality Measure Indicator' ;
    rdfs:comment 'Indicates whether this flowsheet row is used in clinical quality measure reporting (e.g., CMS quality programs, Joint Commission measures).' ;
    rdfs:domain ind:FlowsheetRow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rowCode rdf:type rdf:Property ;
    rdfs:label 'Row Code' ;
    rdfs:comment 'Unique code identifying the flowsheet row within the Electronic Health Record (EHR) system. Used for system-level identification and mapping.' ;
    rdfs:domain ind:FlowsheetRow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rowLabel rdf:type rdf:Property ;
    rdfs:label 'Row Label' ;
    rdfs:domain ind:FlowsheetRow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rowName rdf:type rdf:Property ;
    rdfs:label 'Row Name' ;
    rdfs:comment 'Human-readable name of the flowsheet row measurement or observation type (e.g., Heart Rate, Blood Pressure Systolic, Temperature).' ;
    rdfs:domain ind:FlowsheetRow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rowType rdf:type rdf:Property ;
    rdfs:label 'Row Type' ;
    rdfs:comment 'Classification of the flowsheet row indicating the category of clinical data being captured (e.g., vital sign, laboratory result, intake/output measurement).' ;
    rdfs:domain ind:FlowsheetRow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rowValue rdf:type rdf:Property ;
    rdfs:label 'Row Value' ;
    rdfs:domain ind:FlowsheetRow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rpmDataSourceFlag rdf:type rdf:Property ;
    rdfs:label 'Rpm Data Source Flag' ;
    rdfs:comment 'Indicates whether this flowsheet row captures remote patient monitoring data' ;
    rdfs:domain ind:FlowsheetRow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:flowsheetRowStatus rdf:type rdf:Property ;
    rdfs:label 'Flowsheet Row Status' ;
    rdfs:comment 'Current lifecycle status of this flowsheet row in the master reference table. Inactive or deprecated rows are no longer available for new documentation.' ;
    rdfs:domain ind:FlowsheetRow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:validationRule rdf:type rdf:Property ;
    rdfs:label 'Validation Rule' ;
    rdfs:comment 'Business rules and constraints applied to validate data entry for this flowsheet row (e.g., range checks, format validation, conditional logic).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:createdBy rdf:type rdf:Property ;
    rdfs:label 'Created By' ;
    rdfs:comment 'Identifier of the system user or administrator who created this flowsheet row configuration.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:parentFlowsheetTemplateId rdf:type rdf:Property ;
    rdfs:label 'Parent Flowsheet Template Id' ;
    rdfs:comment 'Self-referencing FK on flowsheet_template (parent_flowsheet_template_id)' ;
    rdfs:domain ind:FlowsheetTemplate ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FlowsheetTemplate .

ind:allowsCustomFields rdf:type rdf:Property ;
    rdfs:label 'Allows Custom Fields' ;
    rdfs:comment 'Indicates whether clinicians can add ad-hoc custom fields when using this flowsheet template for documentation.' ;
    rdfs:domain ind:FlowsheetTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:flowsheetTemplateCategory rdf:type rdf:Property ;
    rdfs:label 'Flowsheet Template Category' ;
    rdfs:comment 'High-level grouping or category for organizing flowsheet templates (e.g., assessments, monitoring, interventions).' ;
    rdfs:domain ind:FlowsheetTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:copyrightNotice rdf:type rdf:Property ;
    rdfs:label 'Copyright Notice' ;
    rdfs:comment 'Copyright and intellectual property notice associated with this flowsheet template if applicable.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:flowsheetTemplateDescription rdf:type rdf:Property ;
    rdfs:label 'Flowsheet Template Description' ;
    rdfs:comment 'Detailed description of the flowsheet template purpose, clinical use case, and documentation guidelines.' ;
    rdfs:domain ind:FlowsheetTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentationIntervalMinutes rdf:type rdf:Property ;
    rdfs:label 'Documentation Interval Minutes' ;
    rdfs:comment 'Standard time interval in minutes between flowsheet documentation entries when used for continuous monitoring.' ;
    rdfs:domain ind:FlowsheetTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:frequencyDefault rdf:type rdf:Property ;
    rdfs:label 'Frequency Default' ;
    rdfs:comment 'Recommended or default frequency for completing this flowsheet (e.g., every 4 hours, once per shift, continuous).' ;
    rdfs:domain ind:FlowsheetTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isArchived rdf:type rdf:Property ;
    rdfs:label 'Is Archived' ;
    rdfs:comment 'Indicates whether this flowsheet template has been archived for historical reference but is no longer available for new documentation.' ;
    rdfs:domain ind:FlowsheetTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isElectronicSignatureRequired rdf:type rdf:Property ;
    rdfs:label 'Is Electronic Signature Required' ;
    rdfs:comment 'Indicates whether an electronic signature is required when completing this flowsheet for regulatory or policy compliance.' ;
    rdfs:domain ind:FlowsheetTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isMandatory rdf:type rdf:Property ;
    rdfs:label 'Is Mandatory' ;
    rdfs:comment 'Indicates whether completion of this flowsheet is required for specific care protocols or regulatory compliance.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isSystemDefault rdf:type rdf:Property ;
    rdfs:label 'Is System Default' ;
    rdfs:comment 'Indicates whether this flowsheet template is a system-provided default template versus a custom user-created template.' ;
    rdfs:domain ind:FlowsheetTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:patientPopulation rdf:type rdf:Property ;
    rdfs:label 'Patient Population' ;
    rdfs:comment 'Target patient population for which this flowsheet template is designed and validated.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postAcuteCareTemplateFlag rdf:type rdf:Property ;
    rdfs:label 'Post Acute Care Template Flag' ;
    rdfs:comment 'Indicates whether this template is designed for post-acute care documentation' ;
    rdfs:domain ind:FlowsheetTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:printLayoutTemplate rdf:type rdf:Property ;
    rdfs:label 'Print Layout Template' ;
    rdfs:comment 'Reference to the print layout or report template used when generating printed versions of flowsheet data.' ;
    rdfs:domain ind:FlowsheetTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:publisher rdf:type rdf:Property ;
    rdfs:label 'Publisher' ;
    rdfs:comment 'Organization or entity responsible for publishing and maintaining this flowsheet template.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requiresCosignature rdf:type rdf:Property ;
    rdfs:label 'Requires Cosignature' ;
    rdfs:comment 'Indicates whether entries using this template require verification or cosignature by a supervising clinician.' ;
    rdfs:domain ind:FlowsheetTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:retiredTimestamp rdf:type rdf:Property ;
    rdfs:label 'Retired Timestamp' ;
    rdfs:comment 'Date and time when this flowsheet template was retired from active clinical use. Null indicates template is still active.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:reviewFrequencyDays rdf:type rdf:Property ;
    rdfs:label 'Review Frequency Days' ;
    rdfs:comment 'Number of days between required periodic reviews of this flowsheet template for clinical accuracy and relevance.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:flowsheetTemplateStatus rdf:type rdf:Property ;
    rdfs:label 'Flowsheet Template Status' ;
    rdfs:comment 'Current lifecycle status of the flowsheet template indicating whether it is available for clinical use.' ;
    rdfs:domain ind:FlowsheetTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:orderingCostCenterId rdf:type rdf:Property ;
    rdfs:label 'Ordering Cost Center Id' ;
    rdfs:comment 'Foreign key linking to finance.cost_center. Business justification: Clinical orders must be charged to departmental cost centers for accurate cost allocation, profitability analysis, and departmental budgeting. Essential for activity-based costing and service line fin' ;
    rdfs:domain ind:ClinicalOrder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CostCenter .

ind:parentOrderClinicalOrderId rdf:type rdf:Property ;
    rdfs:label 'Parent Order Clinical Order Id' ;
    rdfs:comment 'Reference to the parent clinical order when this order is a child or linked order in a chained order relationship (e.g., a reflex lab order triggered by a parent panel, or a follow-up order linked to an original). Null for top-level independent orders.' ;
    rdfs:domain ind:ClinicalOrder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ClinicalOrder .

ind:primaryClinicalCareSiteId rdf:type rdf:Property ;
    rdfs:label 'Primary Clinical Care Site Id' ;
    rdfs:comment 'Reference to the clinical department or unit from which the order was placed (e.g., ICU, ED, Cardiology Clinic). Used for departmental utilization reporting, cost allocation, and operational analytics.' ;
    rdfs:domain ind:ClinicalOrder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CareSite .

ind:primaryClinicalClinicianId rdf:type rdf:Property ;
    rdfs:label 'Primary Clinical Clinician Id' ;
    rdfs:comment 'Reference to the clinician who entered or authorized this order via Computerized Physician Order Entry (CPOE). Corresponds to the ordering provider NPI-linked record in the provider master.' ;
    rdfs:domain ind:ClinicalOrder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:setItemId rdf:type rdf:Property ;
    rdfs:label 'Set Item Id' ;
    rdfs:comment 'Identifier of the clinical order set or protocol from which this order was generated, if applicable. Order sets are pre-defined bundles of evidence-based orders (e.g., \'Sepsis Bundle\', \'AMI Order Set\'). Null if the order was placed individually outside an order set.' ;
    rdfs:domain ind:Order ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SetItem .

ind:tertiaryClinicalAuthorizingProviderClinicianId rdf:type rdf:Property ;
    rdfs:label 'Tertiary Clinical Authorizing Provider Clinician Id' ;
    rdfs:comment 'Reference to the provider who authorized or approved the order when different from the ordering provider (e.g., attending physician authorizing a resident-entered order). Supports order authentication and supervision compliance tracking.' ;
    rdfs:domain ind:ClinicalOrder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:cancelledDatetime rdf:type rdf:Property ;
    rdfs:label 'Cancelled Datetime' ;
    rdfs:comment 'Timestamp when the order was cancelled or discontinued. Null for active or completed orders. Used for order lifecycle analytics, duplicate order detection, and medication safety reporting.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:clinicalDecisionSupportAlert rdf:type rdf:Property ;
    rdfs:label 'Clinical Decision Support Alert' ;
    rdfs:comment 'Indicates whether a Clinical Decision Support (CDS) alert was triggered at order entry and the provider\'s response. Supports medication safety monitoring, duplicate order detection, and CDS effectiveness analytics per AHRQ and ONC requirements.' ;
    rdfs:domain ind:ClinicalOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clinicalIndicationText rdf:type rdf:Property ;
    rdfs:label 'Clinical Indication Text' ;
    rdfs:comment 'Free-text clinical rationale or indication entered by the ordering provider to justify the order. Supplements the ICD-10 indication code with narrative context. Used by Clinical Documentation Improvement (CDI) and utilization management teams.' ;
    rdfs:domain ind:ClinicalOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:completedDatetime rdf:type rdf:Property ;
    rdfs:label 'Completed Datetime' ;
    rdfs:comment 'Timestamp when the order was fulfilled and marked as completed by the performing department or system. Used for turnaround time (TAT) measurement and order fulfillment analytics.' ;
    rdfs:domain ind:Order ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:cosignCompletedDatetime rdf:type rdf:Property ;
    rdfs:label 'Cosign Completed Datetime' ;
    rdfs:comment 'Timestamp when the required co-signature for a verbal or telephone order was completed by the authorizing provider. Used to measure compliance with TJC verbal order authentication requirements.' ;
    rdfs:domain ind:ClinicalOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:cosignDueDatetime rdf:type rdf:Property ;
    rdfs:label 'Cosign Due Datetime' ;
    rdfs:comment 'Deadline by which a verbal or telephone order must be co-signed by the authorizing provider per TJC and CMS requirements (typically within 24-48 hours). Null for electronically-entered orders that do not require co-signature.' ;
    rdfs:domain ind:ClinicalOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:frequencyCode rdf:type rdf:Property ;
    rdfs:label 'Frequency Code' ;
    rdfs:comment 'Standardized frequency code specifying how often a recurring order should be executed (e.g., \'QD\' for daily, \'BID\' for twice daily, \'Q4H\' for every 4 hours, \'PRN\' for as needed). Applicable primarily to pharmacy, nursing, and timed lab orders.' ;
    rdfs:domain ind:Order ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isCpoeEntered rdf:type rdf:Property ;
    rdfs:label 'Is Cpoe Entered' ;
    rdfs:comment 'Indicates whether the order was entered directly by the ordering provider via Computerized Physician Order Entry (CPOE) (True) versus entered by a nurse, pharmacist, or other staff on behalf of the provider (False). Key metric for CPOE adoption and Meaningful Use/Promoting Interoperability reporting.' ;
    rdfs:domain ind:ClinicalOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isOrderSetMember rdf:type rdf:Property ;
    rdfs:label 'Is Order Set Member' ;
    rdfs:comment 'Indicates whether this order was placed as part of a clinical order set or protocol bundle (True) versus as a standalone individual order (False). Used for order set utilization analytics and evidence-based practice reporting.' ;
    rdfs:domain ind:ClinicalOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isRecurring rdf:type rdf:Property ;
    rdfs:label 'Is Recurring' ;
    rdfs:comment 'Indicates whether this order is a recurring or standing order (True) that repeats on a defined schedule, versus a one-time order (False). Relevant for nursing, pharmacy, and lab orders with scheduled frequencies.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isVerbalOrder rdf:type rdf:Property ;
    rdfs:label 'Is Verbal Order' ;
    rdfs:comment 'Indicates whether this order was received verbally (True) and requires subsequent written or electronic authentication per TJC and CMS standards. Drives co-signature workflow and compliance monitoring.' ;
    rdfs:domain ind:Order ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:numberOfOccurrences rdf:type rdf:Property ;
    rdfs:label 'Number Of Occurrences' ;
    rdfs:comment 'Total number of times a recurring order is to be executed before automatic discontinuation. For example, a lab order for \'CBC x3 days\' would have number_of_occurrences = 3. Null for open-ended standing orders.' ;
    rdfs:domain ind:ClinicalOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:orderCatalogCode rdf:type rdf:Property ;
    rdfs:label 'Order Catalog Code' ;
    rdfs:comment 'Internal order catalog or procedure code from the source EHR system (Epic procedure ID or Cerner catalog item code). Used for order set management, CDM mapping, and charge capture reconciliation.' ;
    rdfs:domain ind:ClinicalOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:orderClass rdf:type rdf:Property ;
    rdfs:label 'Order Class' ;
    rdfs:comment 'Patient care setting classification for the order, indicating the clinical context in which the order was placed. Inpatient orders originate from admitted patients; ED orders from Emergency Department encounters; ambulatory from clinic visits.' ;
    rdfs:domain ind:ClinicalOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:orderDatetime rdf:type rdf:Property ;
    rdfs:label 'Order Datetime' ;
    rdfs:comment 'The principal real-world timestamp when the clinical order was placed or entered into the CPOE system. Serves as the BUSINESS_EVENT_TIMESTAMP for this transaction. Used for turnaround time (TAT) calculations and regulatory reporting.' ;
    rdfs:domain ind:Order ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:orderEnteredDatetime rdf:type rdf:Property ;
    rdfs:label 'Order Entered Datetime' ;
    rdfs:comment 'Timestamp when the order was physically entered into the EHR system, which may differ from order_datetime (the clinically intended order time) for verbal or backdated orders. Used for CPOE compliance auditing and order authentication tracking.' ;
    rdfs:domain ind:ClinicalOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:orderMode rdf:type rdf:Property ;
    rdfs:label 'Order Mode' ;
    rdfs:comment 'Method by which the clinical order was entered or communicated. Electronic orders are entered directly via CPOE; verbal and telephone orders require co-signature per regulatory requirements. Supports compliance auditing and order authentication tracking.' ;
    rdfs:domain ind:Order ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:orderName rdf:type rdf:Property ;
    rdfs:label 'Order Name' ;
    rdfs:comment 'Human-readable name or description of the ordered item or service as displayed in the EHR (e.g., \'CBC with Differential\', \'Chest X-Ray PA and Lateral\', \'Metoprolol 25mg PO\'). Sourced from the Charge Description Master (CDM) or order catalog.' ;
    rdfs:domain ind:ClinicalOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:orderNumber rdf:type rdf:Property ;
    rdfs:label 'Order Number' ;
    rdfs:comment 'Externally-known, human-readable order identifier assigned by the source system (Epic Orders or Cerner Millennium). Used for cross-system reconciliation, audit trails, and communication with clinical staff. Serves as the BUSINESS_IDENTIFIER for this transaction.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:orderPriority rdf:type rdf:Property ;
    rdfs:label 'Order Priority' ;
    rdfs:comment 'Clinical urgency classification for the order. STAT indicates immediate action required; timed indicates a specific scheduled execution time. Embedded enum per product design specification. Drives turnaround time (TAT) SLA monitoring.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:orderStatus rdf:type rdf:Property ;
    rdfs:label 'Order Status' ;
    rdfs:comment 'Current workflow lifecycle state of the clinical order. Drives downstream fulfillment routing and reporting. Values align with Epic Orders and HL7 FHIR ServiceRequest status codes.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:orderType rdf:type rdf:Property ;
    rdfs:label 'Order Type' ;
    rdfs:comment 'Classification of the clinical order by modality or service category. Determines routing to the appropriate fulfillment system: Beaker (LIS) for lab, Radiant (RIS) for radiology, Willow for pharmacy, etc. Embedded enum per product design specification. [ENUM-REF-CANDIDATE: lab|radiology|pharmacy|referral|nursing|dietary|consult — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:orderingProviderNpi rdf:type rdf:Property ;
    rdfs:label 'Ordering Provider Npi' ;
    rdfs:comment '10-digit National Provider Identifier (NPI) of the clinician who placed the order. Stored denormalized on the order for regulatory reporting, claims submission, and audit purposes per CMS requirements. Distinct from the FK to the provider master.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:patientMrn rdf:type rdf:Property ;
    rdfs:label 'Patient Mrn' ;
    rdfs:comment 'Medical Record Number (MRN) of the patient for whom the order was placed. Stored denormalized on the order for cross-system reconciliation, HL7 ADT message processing, and regulatory audit trails. Sourced from the Master Patient Index (MPI).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:quantityOrdered rdf:type rdf:Property ;
    rdfs:label 'Quantity Ordered' ;
    rdfs:comment 'Numeric quantity of the ordered item or service (e.g., number of lab panels, number of imaging views, medication dose quantity). Unit of measure is captured in quantity_unit. Used for supply chain, pharmacy dispensing, and charge capture.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:quantityUnit rdf:type rdf:Property ;
    rdfs:label 'Quantity Unit' ;
    rdfs:comment 'Unit of measure for the quantity_ordered field (e.g., \'mg\', \'mL\', \'units\', \'each\', \'tablet\'). Follows UCUM (Unified Code for Units of Measure) standards for interoperability with HL7 FHIR.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recordNumber rdf:type rdf:Property ;
    rdfs:label 'Record Number' ;
    rdfs:comment 'Foreign key linking to consent.consent_record. Business justification: Procedures, surgeries, and high-risk treatments require documented informed consent. Pre-procedure verification workflows mandate linking orders to the authorizing consent record. Core HIPAA and state' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:startDatetime rdf:type rdf:Property ;
    rdfs:label 'Start Datetime' ;
    rdfs:comment 'Datetime when the order is scheduled to begin or when fulfillment should commence. For timed orders, this is the precise execution start time. Distinct from order_datetime (when placed) and order_datetime (when entered).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:clinicalOrderStatus rdf:type rdf:Property ;
    rdfs:label 'Clinical Order Status' ;
    rdfs:domain ind:ClinicalOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stopDatetime rdf:type rdf:Property ;
    rdfs:label 'Stop Datetime' ;
    rdfs:comment 'Datetime when the order expires, is discontinued, or fulfillment should cease. Critical for pharmacy and nursing orders to prevent over-administration. Nullable for one-time orders.' ;
    rdfs:domain ind:ClinicalOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:orderAuthorizationId rdf:type rdf:Property ;
    rdfs:label 'Order Authorization Id' ;
    rdfs:comment 'Reference to the payer prior authorization record associated with this referral, when authorization is required. Links to the encounter authorization entity.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:OrderAuthorization .

ind:primaryReferralClinicianId rdf:type rdf:Property ;
    rdfs:label 'Primary Referral Clinician Id' ;
    rdfs:comment 'Reference to the clinician who originated and placed the referral order. Typically the patient\'s Primary Care Physician (PCP) or treating provider.' ;
    rdfs:domain ind:ReferralOrder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:receivingProviderClinicianId rdf:type rdf:Property ;
    rdfs:label 'Receiving Provider Clinician Id' ;
    rdfs:comment 'Reference to the specialist or external provider to whom the patient is being referred. May be null if the receiving provider has not yet been assigned.' ;
    rdfs:domain ind:ReferralOrder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:referralCostCenterId rdf:type rdf:Property ;
    rdfs:label 'Referral Cost Center Id' ;
    rdfs:comment 'Foreign key linking to finance.cost_center. Business justification: Referral management programs operate within specific departments with associated cost centers. Tracking referral costs by cost center enables ROI analysis of referral programs, network leakage cost as' ;
    rdfs:domain ind:ReferralOrder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CostCenter .

ind:sourceClinicalOrderId rdf:type rdf:Property ;
    rdfs:label 'Source Clinical Order Id' ;
    rdfs:comment 'The native order identifier from the originating operational system (e.g., Epic order ID, Salesforce referral record ID). Enables cross-system reconciliation and traceability back to the system of record.' ;
    rdfs:domain ind:ReferralOrder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ClinicalOrder .

ind:authorizationRequired rdf:type rdf:Property ;
    rdfs:label 'Authorization Required' ;
    rdfs:comment 'Indicates whether the patient\'s payer requires prior authorization before the referral can be fulfilled. When True, the referral workflow is gated on obtaining a payer authorization number before scheduling.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:authorizedVisits rdf:type rdf:Property ;
    rdfs:label 'Authorized Visits' ;
    rdfs:comment 'The number of specialist visits or service encounters approved by the payer under this referral authorization. Used to track utilization against the authorized limit and trigger re-authorization workflows.' ;
    rdfs:domain ind:ReferralOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dispositionDate rdf:type rdf:Property ;
    rdfs:label 'Disposition Date' ;
    rdfs:comment 'The date on which the referral disposition was recorded by the receiving provider or care coordinator. Used to measure referral loop closure timeliness and time-to-specialist metrics.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:dispositionNotes rdf:type rdf:Property ;
    rdfs:label 'Disposition Notes' ;
    rdfs:comment 'Free-text notes from the receiving provider or care coordinator documenting the reason for the referral disposition, particularly for declined or cancelled referrals. Supports clinical documentation improvement (CDI) and care coordination workflows.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:firstAvailableDate rdf:type rdf:Property ;
    rdfs:label 'First Available Date' ;
    rdfs:comment 'The earliest available appointment date offered by the receiving provider at the time the referral was processed. Used to measure access to specialty care and network adequacy.' ;
    rdfs:domain ind:ReferralOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:isStatOrder rdf:type rdf:Property ;
    rdfs:label 'Is Stat Order' ;
    rdfs:comment 'Indicates whether the referral order was placed as a STAT (immediate/urgent) order requiring expedited processing and scheduling. Distinct from urgency_level as this is the operational flag used by scheduling and authorization workflows.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:loopClosedDate rdf:type rdf:Property ;
    rdfs:label 'Loop Closed Date' ;
    rdfs:comment 'The date on which the referral communication loop was closed, meaning the referring provider received the specialist\'s consultation report or outcome documentation.' ;
    rdfs:domain ind:ReferralOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:orderPlacedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Order Placed Timestamp' ;
    rdfs:comment 'The date and time when the referring provider placed the referral order via Computerized Physician Order Entry (CPOE) in the Electronic Health Record (EHR). This is the principal business event timestamp for the referral lifecycle.' ;
    rdfs:domain ind:ReferralOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:orderSourceSystem rdf:type rdf:Property ;
    rdfs:label 'Order Source System' ;
    rdfs:comment 'The operational system of record from which the referral order was originated or ingested into the lakehouse. Supports data lineage, reconciliation, and multi-system integration auditing.' ;
    rdfs:domain ind:ReferralOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:receivingFacilityName rdf:type rdf:Property ;
    rdfs:label 'Receiving Facility Name' ;
    rdfs:comment 'Name of the external facility or organization where the referred services will be rendered. Captured when the receiving provider is affiliated with an external organization not in the internal provider master.' ;
    rdfs:domain ind:ReferralOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:receivingProviderNpi rdf:type rdf:Property ;
    rdfs:label 'Receiving Provider Npi' ;
    rdfs:comment 'The 10-digit National Provider Identifier (NPI) of the specialist or receiving provider to whom the patient is referred. Required for payer authorization and claims adjudication.' ;
    rdfs:domain ind:ReferralOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referralLoopClosed rdf:type rdf:Property ;
    rdfs:label 'Referral Loop Closed' ;
    rdfs:comment 'Indicates whether the referring provider has received and acknowledged the specialist\'s consultation report, closing the referral communication loop. A key quality metric for NCQA HEDIS and PCMH accreditation.' ;
    rdfs:domain ind:ReferralOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:referralReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Referral Reason Description' ;
    rdfs:comment 'Free-text clinical narrative describing the reason for the referral, supplementing the ICD-10 code. Captures clinical context not fully expressed by the diagnosis code, such as symptom progression, treatment failure, or specific clinical question for the specialist.' ;
    rdfs:domain ind:ReferralOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referringProviderNpi rdf:type rdf:Property ;
    rdfs:label 'Referring Provider Npi' ;
    rdfs:comment 'The 10-digit National Provider Identifier (NPI) of the referring provider as registered with CMS. Required on CMS-1500 and UB-04 claim forms and payer authorization requests.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduledAppointmentDate rdf:type rdf:Property ;
    rdfs:label 'Scheduled Appointment Date' ;
    rdfs:comment 'The date on which the patient\'s appointment with the receiving specialist or provider has been scheduled. Used to measure time-to-appointment and referral fulfillment timeliness.' ;
    rdfs:domain ind:ReferralOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:visitsUsed rdf:type rdf:Property ;
    rdfs:label 'Visits Used' ;
    rdfs:comment 'The number of authorized visits that have been consumed against this referral to date. Compared against authorized_visits to determine remaining utilization and trigger re-authorization alerts.' ;
    rdfs:domain ind:ReferralOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:primarySetEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Set Employee Id' ;
    rdfs:comment 'Identifier of the user who created this order set item. Supports accountability and audit requirements for clinical content governance.' ;
    rdfs:domain ind:SetItem ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:setId rdf:type rdf:Property ;
    rdfs:label 'Set Id' ;
    rdfs:comment 'Reference to the parent order set that contains this item. Links this item to its containing order set bundle.' ;
    rdfs:domain ind:Order ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Set .

ind:ageMaxYears rdf:type rdf:Property ;
    rdfs:label 'Age Max Years' ;
    rdfs:comment 'Maximum patient age in years for which this order item is appropriate. Used for age-based inclusion rules. Null indicates no maximum age restriction.' ;
    rdfs:domain ind:SetItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ageMinYears rdf:type rdf:Property ;
    rdfs:label 'Age Min Years' ;
    rdfs:comment 'Minimum patient age in years for which this order item is appropriate. Used for age-based inclusion rules. Null indicates no minimum age restriction.' ;
    rdfs:domain ind:SetItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:alternativeOrderOptions rdf:type rdf:Property ;
    rdfs:label 'Alternative Order Options' ;
    rdfs:comment 'Comma-separated list of alternative order codes that can be substituted for this item. Supports clinical flexibility and formulary management.' ;
    rdfs:domain ind:SetItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clinicalRationale rdf:type rdf:Property ;
    rdfs:label 'Clinical Rationale' ;
    rdfs:comment 'Evidence-based justification for including this order in the care pathway. May reference clinical guidelines, protocols, or best practices. Supports clinical decision support.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collectionMethod rdf:type rdf:Property ;
    rdfs:label 'Collection Method' ;
    rdfs:comment 'Method by which the specimen should be collected for laboratory orders (e.g., venipuncture, clean catch, biopsy). Ensures proper specimen quality.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conditionExpression rdf:type rdf:Property ;
    rdfs:label 'Condition Expression' ;
    rdfs:comment 'Formal expression defining the conditional logic criteria (e.g., age > 65, weight < 50kg, diagnosis = ICD-10:E11.9). Uses clinical decision support (CDS) rule syntax.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conditionType rdf:type rdf:Property ;
    rdfs:label 'Condition Type' ;
    rdfs:comment 'Category of conditional logic applied to this item. Determines which patient data elements are evaluated for inclusion/exclusion decisions. [ENUM-REF-CANDIDATE: age_based|weight_based|diagnosis_based|lab_value|allergy|medication_interaction|none — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:SetItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conditionalInclusionLogic rdf:type rdf:Property ;
    rdfs:label 'Conditional Inclusion Logic' ;
    rdfs:comment 'Rule expression defining when this item should be automatically included or excluded from the order set. Evaluated at order set activation time based on patient context.' ;
    rdfs:domain ind:SetItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contrastIndicator rdf:type rdf:Property ;
    rdfs:label 'Contrast Indicator' ;
    rdfs:comment 'Indicates whether contrast media should be used for radiology imaging orders. Affects patient preparation and allergy screening requirements.' ;
    rdfs:domain ind:SetItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:defaultDose rdf:type rdf:Property ;
    rdfs:label 'Default Dose' ;
    rdfs:comment 'Pre-configured dose amount for medication orders. May include numeric value and unit (e.g., 500 mg, 10 mL). Can be overridden at order entry.' ;
    rdfs:domain ind:SetItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:defaultDuration rdf:type rdf:Property ;
    rdfs:label 'Default Duration' ;
    rdfs:comment 'Pre-configured duration for time-limited orders (e.g., 7 days, 2 weeks). Primarily used for medication orders with a defined treatment period.' ;
    rdfs:domain ind:SetItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:defaultFrequency rdf:type rdf:Property ;
    rdfs:label 'Default Frequency' ;
    rdfs:comment 'Pre-configured administration or execution frequency for this order (e.g., BID, TID, QD, Q4H). Primarily used for medication and nursing orders.' ;
    rdfs:domain ind:SetItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:defaultPriority rdf:type rdf:Property ;
    rdfs:label 'Default Priority' ;
    rdfs:comment 'Pre-configured priority level for this order item. Can be overridden by the ordering provider at the time of order entry.' ;
    rdfs:domain ind:Order ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:defaultQuantity rdf:type rdf:Property ;
    rdfs:label 'Default Quantity' ;
    rdfs:comment 'Pre-configured quantity for orders that require a count or volume (e.g., number of units to dispense, volume of fluid to administer).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:defaultRoute rdf:type rdf:Property ;
    rdfs:label 'Default Route' ;
    rdfs:comment 'Pre-configured administration route for medication orders (e.g., oral, intravenous, intramuscular, subcutaneous). Can be overridden at order entry.' ;
    rdfs:domain ind:SetItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:diagnosisCriteria rdf:type rdf:Property ;
    rdfs:label 'Diagnosis Criteria' ;
    rdfs:comment 'ICD-10 diagnosis codes or diagnosis categories that must be present for this item to be included. Supports comma-separated list for multiple diagnoses.' ;
    rdfs:domain ind:SetItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:instructionText rdf:type rdf:Property ;
    rdfs:label 'Instruction Text' ;
    rdfs:comment 'Additional instructions or guidance for the ordering provider or fulfillment team. Displayed during order entry and on order requisitions.' ;
    rdfs:domain ind:SetItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isDefaultSelected rdf:type rdf:Property ;
    rdfs:label 'Is Default Selected' ;
    rdfs:comment 'Indicates whether this item is pre-selected by default when the order set is opened. Providers can deselect optional items.' ;
    rdfs:domain ind:SetItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:orderCode rdf:type rdf:Property ;
    rdfs:label 'Order Code' ;
    rdfs:comment 'Standard code identifying the specific orderable item (e.g., LOINC for lab tests, CPT for procedures, NDC for medications). The vocabulary depends on order_type.' ;
    rdfs:domain ind:SetItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:orderDescription rdf:type rdf:Property ;
    rdfs:label 'Order Description' ;
    rdfs:comment 'Human-readable description of the order item. Displayed to clinicians during order set selection and order entry.' ;
    rdfs:domain ind:SetItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:patientInstructionText rdf:type rdf:Property ;
    rdfs:label 'Patient Instruction Text' ;
    rdfs:comment 'Instructions intended for the patient regarding this order (e.g., fasting requirements, preparation steps, post-procedure care). May be printed on patient education materials.' ;
    rdfs:domain ind:SetItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requiresAuthorization rdf:type rdf:Property ;
    rdfs:label 'Requires Authorization' ;
    rdfs:comment 'Indicates whether this order item requires prior authorization from the payer before it can be performed. Used for revenue cycle and utilization management.' ;
    rdfs:domain ind:SetItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:setItemStatus rdf:type rdf:Property ;
    rdfs:label 'Set Item Status' ;
    rdfs:comment 'Current lifecycle status of this order set item. Only active items are available for use in clinical order entry.' ;
    rdfs:domain ind:SetItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:specimenType rdf:type rdf:Property ;
    rdfs:label 'Specimen Type' ;
    rdfs:comment 'Type of biological specimen required for laboratory orders (e.g., blood, urine, tissue, swab). Used for specimen collection and handling instructions.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:weightMaxKg rdf:type rdf:Property ;
    rdfs:label 'Weight Max Kg' ;
    rdfs:comment 'Maximum patient weight in kilograms for which this order item is appropriate. Used for weight-based dosing and inclusion rules. Null indicates no maximum weight restriction.' ;
    rdfs:domain ind:SetItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:weightMinKg rdf:type rdf:Property ;
    rdfs:label 'Weight Min Kg' ;
    rdfs:comment 'Minimum patient weight in kilograms for which this order item is appropriate. Used for weight-based dosing and inclusion rules. Null indicates no minimum weight restriction.' ;
    rdfs:domain ind:SetItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:routingId rdf:type rdf:Property ;
    rdfs:label 'Routing Id' ;
    rdfs:comment 'Unique identifier for the order routing record. Primary key.' ;
    rdfs:domain ind:Routing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:routingOrgUnitId rdf:type rdf:Property ;
    rdfs:label 'Routing Org Unit Id' ;
    rdfs:comment 'Identifier of the department or unit to which the order was routed for fulfillment. May be lab, radiology, pharmacy, or other ancillary service.' ;
    rdfs:domain ind:Routing ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:OrgUnit .

ind:routingPreviousDestinationDepartmentOrgUnitId rdf:type rdf:Property ;
    rdfs:label 'Routing Previous Destination Department Org Unit Id' ;
    rdfs:comment 'Identifier of the department from which the order was rerouted. Populated only for rerouted orders to maintain routing history.' ;
    rdfs:domain ind:Routing ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:OrgUnit .

ind:routingRuleId rdf:type rdf:Property ;
    rdfs:label 'Routing Rule Id' ;
    rdfs:comment 'Identifier of the routing rule or algorithm applied to determine the destination. Links to routing rule configuration for audit and optimization.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RoutingRule .

ind:securityRiskHipaaSecurityRiskId rdf:type rdf:Property ;
    rdfs:label 'Security Risk Hipaa Security Risk Id' ;
    rdfs:comment 'Foreign key linking to compliance.hipaa_security_risk. Business justification: Order routing systems handle ePHI and are subject to security risk assessments (interface vulnerabilities, access control weaknesses, encryption gaps). Security risk register tracks routing system ris' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:HipaaSecurityRisk .

ind:sourceDepartmentOrgUnitId rdf:type rdf:Property ;
    rdfs:label 'Source Department Org Unit Id' ;
    rdfs:comment 'Identifier of the department or unit from which the order originated. Typically the ordering clinician\'s department.' ;
    rdfs:domain ind:Routing ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:OrgUnit .

ind:acknowledgementDatetime rdf:type rdf:Property ;
    rdfs:label 'Acknowledgement Datetime' ;
    rdfs:comment 'Timestamp when the receiving department or system acknowledged receipt of the routed order. Used to measure queue wait time.' ;
    rdfs:domain ind:Routing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:autoRouteEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Auto Route Eligible Flag' ;
    rdfs:comment 'Indicates whether the order was eligible for automatic routing based on order type, priority, and system configuration. False if manual routing was required.' ;
    rdfs:domain ind:Routing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:completionDatetime rdf:type rdf:Property ;
    rdfs:label 'Completion Datetime' ;
    rdfs:comment 'Timestamp when the routing event was marked complete, indicating the order reached its fulfillment destination and processing began.' ;
    rdfs:domain ind:Routing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:delayMinutes rdf:type rdf:Property ;
    rdfs:label 'Delay Minutes' ;
    rdfs:comment 'Number of minutes the routing event exceeded the SLA target. Null if SLA was met. Used for bottleneck analysis and process improvement.' ;
    rdfs:domain ind:Routing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:destinationWorkstationCode rdf:type rdf:Property ;
    rdfs:label 'Destination Workstation Code' ;
    rdfs:comment 'Identifier of the specific workstation, instrument, or device to which the order was routed within the destination department. Used for lab analyzers, imaging modalities, and pharmacy dispensing systems.' ;
    rdfs:domain ind:Routing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedCompletionDatetime rdf:type rdf:Property ;
    rdfs:label 'Estimated Completion Datetime' ;
    rdfs:comment 'Predicted timestamp when the order fulfillment will be completed, based on current queue depth, workload, and historical turnaround times.' ;
    rdfs:domain ind:Routing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:method rdf:type rdf:Property ;
    rdfs:label 'Method' ;
    rdfs:comment 'Method by which the order was routed. Distinguishes between automated rule-based routing, manual clinician override, load balancing algorithms, and emergency escalation paths.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:patientLocationAtRouting rdf:type rdf:Property ;
    rdfs:label 'Patient Location At Routing' ;
    rdfs:comment 'Patient location (unit, room, bed) at the time the order was routed. Used to optimize routing for point-of-care services and specimen collection.' ;
    rdfs:domain ind:Routing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorityOverrideFlag rdf:type rdf:Property ;
    rdfs:label 'Priority Override Flag' ;
    rdfs:comment 'Indicates whether the routing priority was manually overridden by a clinician or supervisor. True if priority was escalated or de-escalated from the original order priority.' ;
    rdfs:domain ind:Routing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:priorityOverrideReason rdf:type rdf:Property ;
    rdfs:label 'Priority Override Reason' ;
    rdfs:comment 'Free-text explanation for why the routing priority was overridden. Captures clinical justification for escalation or de-escalation.' ;
    rdfs:domain ind:Routing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:queueName rdf:type rdf:Property ;
    rdfs:label 'Queue Name' ;
    rdfs:comment 'Name of the work queue to which the order was assigned within the destination department. Examples include \'STAT Lab Queue\', \'Routine Radiology Queue\', \'Pharmacy Verification Queue\'.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:queuePosition rdf:type rdf:Property ;
    rdfs:label 'Queue Position' ;
    rdfs:comment 'Position of the order within the assigned queue at the time of routing. Used to track queue depth and wait times.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:rerouteCount rdf:type rdf:Property ;
    rdfs:label 'Reroute Count' ;
    rdfs:comment 'Number of times this order has been rerouted to different destinations. High reroute counts indicate routing rule issues or capacity constraints.' ;
    rdfs:domain ind:Routing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:rerouteReason rdf:type rdf:Property ;
    rdfs:label 'Reroute Reason' ;
    rdfs:comment 'Reason why the order was rerouted from its original destination. Supports root cause analysis of routing failures and capacity planning. [ENUM-REF-CANDIDATE: capacity_exceeded|equipment_unavailable|staff_unavailable|patient_location_change|order_modification|system_error|clinical_decision — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Routing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:routingStatus rdf:type rdf:Property ;
    rdfs:label 'Routing Status' ;
    rdfs:comment 'Current lifecycle status of the routing event. Tracks progression from initial queue assignment through fulfillment or failure. [ENUM-REF-CANDIDATE: queued|acknowledged|in_progress|completed|rerouted|failed|cancelled — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Routing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:slaComplianceFlag rdf:type rdf:Property ;
    rdfs:label 'Sla Compliance Flag' ;
    rdfs:comment 'Indicates whether the routing event met the defined SLA target. True if acknowledgement or completion occurred within the target timeframe.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:slaTargetMinutes rdf:type rdf:Property ;
    rdfs:label 'Sla Target Minutes' ;
    rdfs:comment 'Target turnaround time in minutes from routing to acknowledgement or completion, based on order priority and type. Used for SLA compliance monitoring.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:specimenCollectionRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Specimen Collection Required Flag' ;
    rdfs:comment 'Indicates whether the routed order requires specimen collection before fulfillment. True for lab orders requiring phlebotomy or other collection procedures.' ;
    rdfs:domain ind:Routing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:systemSource rdf:type rdf:Property ;
    rdfs:label 'System Source' ;
    rdfs:comment 'Source system that generated or processed the routing event. Identifies whether routing originated from Epic Orders, Beaker LIS, Radiant RIS, Willow Pharmacy, or other integrated systems. [ENUM-REF-CANDIDATE: epic_orders|beaker_lis|radiant_ris|willow_pharmacy|cerner_orders|interface_engine|manual_entry — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transportRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Transport Required Flag' ;
    rdfs:comment 'Indicates whether patient transport is required to fulfill the order. True for imaging or procedure orders where the patient must be moved to the destination department.' ;
    rdfs:domain ind:Routing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:workloadScore rdf:type rdf:Property ;
    rdfs:label 'Workload Score' ;
    rdfs:comment 'Calculated workload score of the destination department or queue at the time of routing. Used by load balancing algorithms to distribute orders across available resources.' ;
    rdfs:domain ind:Routing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fulfillmentId rdf:type rdf:Property ;
    rdfs:label 'Fulfillment Id' ;
    rdfs:comment 'Unique identifier for the order fulfillment record. Primary key.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Fulfillment .

ind:primaryFulfillmentClinicianId rdf:type rdf:Property ;
    rdfs:label 'Primary Fulfillment Clinician Id' ;
    rdfs:comment 'Foreign key reference to the provider, technician, or clinician who performed or completed the fulfillment. May be a lab technician, radiologist, pharmacist, or other clinical staff.' ;
    rdfs:domain ind:Fulfillment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:schedulingAppointmentId rdf:type rdf:Property ;
    rdfs:label 'Scheduling Appointment Id' ;
    rdfs:comment 'Foreign key linking to scheduling.scheduling_appointment. Business justification: Order fulfillment events (imaging studies, procedures, infusions) occur during scheduled appointments. Linking fulfillment to appointment enables turnaround time tracking, no-show impact analysis, and' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SchedulingAppointment .

ind:specimenId rdf:type rdf:Property ;
    rdfs:label 'Specimen Id' ;
    rdfs:comment 'Unique identifier for the specimen collected and used for fulfillment. Primarily applicable to laboratory and pathology orders. Links to specimen tracking systems.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Specimen .

ind:vendorId rdf:type rdf:Property ;
    rdfs:label 'Vendor Id' ;
    rdfs:comment 'Foreign key linking to supply.vendor. Business justification: Fulfillment records may track which vendor supplied the item, especially for consignment inventory or vendor-managed stock. Essential for vendor performance metrics, rebate tracking, and consignment r' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Vendor .

ind:chargeCaptureFlag rdf:type rdf:Property ;
    rdfs:label 'Charge Capture Flag' ;
    rdfs:comment 'Boolean indicator of whether a billable charge was captured for this fulfillment event. Used for revenue cycle management and billing reconciliation.' ;
    rdfs:domain ind:Fulfillment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exceptionReasonCode rdf:type rdf:Property ;
    rdfs:label 'Exception Reason Code' ;
    rdfs:comment 'Standardized code indicating why the order was not fulfilled as originally ordered. Used when status is cancelled, failed, or partial. Maps to internal exception reason reference data.' ;
    rdfs:domain ind:Fulfillment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exceptionReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Exception Reason Description' ;
    rdfs:comment 'Free-text description of the exception or reason why the order was not fulfilled as ordered. Provides additional context beyond the standardized exception reason code.' ;
    rdfs:domain ind:Fulfillment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fulfilledQuantity rdf:type rdf:Property ;
    rdfs:label 'Fulfilled Quantity' ;
    rdfs:comment 'The actual quantity or amount fulfilled by the performing department. May differ from ordered quantity in cases of partial fulfillment, substitution, or unavailability.' ;
    rdfs:domain ind:Fulfillment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fulfillmentNumber rdf:type rdf:Property ;
    rdfs:label 'Fulfillment Number' ;
    rdfs:comment 'Business identifier for the fulfillment event. Human-readable unique number assigned by the fulfilling department or system (e.g., lab accession number, radiology case number, pharmacy dispense number).' ;
    rdfs:domain ind:Fulfillment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fulfillmentStatus rdf:type rdf:Property ;
    rdfs:label 'Fulfillment Status' ;
    rdfs:comment 'Current status of the fulfillment event. Indicates whether the order was fully completed, partially fulfilled, cancelled, failed, or is still in progress.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modifierCodes rdf:type rdf:Property ;
    rdfs:label 'Modifier Codes' ;
    rdfs:comment 'Comma-separated list of CPT or HCPCS modifier codes applied to the procedure. Modifiers provide additional information about the service performed (e.g., bilateral procedure, multiple procedures).' ;
    rdfs:domain ind:Fulfillment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:orderedQuantity rdf:type rdf:Property ;
    rdfs:label 'Ordered Quantity' ;
    rdfs:comment 'The quantity or amount originally ordered by the ordering provider. Used for comparison with actual fulfilled quantity to detect partial fulfillments.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:partialFulfillmentFlag rdf:type rdf:Property ;
    rdfs:label 'Partial Fulfillment Flag' ;
    rdfs:comment 'Boolean indicator of whether the order was partially fulfilled (True) or fully fulfilled (False). Set to True when fulfilled quantity is less than ordered quantity.' ;
    rdfs:domain ind:Fulfillment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:performingDepartmentCode rdf:type rdf:Property ;
    rdfs:label 'Performing Department Code' ;
    rdfs:comment 'Standardized code identifying the department or service line that performed the fulfillment (e.g., LAB, RAD, PHARM, PT, OT). Maps to organizational department reference data.' ;
    rdfs:domain ind:Fulfillment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorityCode rdf:type rdf:Property ;
    rdfs:label 'Priority Code' ;
    rdfs:comment 'The priority level assigned to the order at the time of fulfillment. Indicates urgency and expected turnaround time (STAT = immediate, urgent = within hours, routine = standard processing).' ;
    rdfs:domain ind:Fulfillment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qualityFlag rdf:type rdf:Property ;
    rdfs:label 'Quality Flag' ;
    rdfs:comment 'Boolean indicator of whether this fulfillment event has been flagged for quality review or audit. Used for quality assurance, compliance monitoring, and performance improvement initiatives.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:resultAvailabilityDatetime rdf:type rdf:Property ;
    rdfs:label 'Result Availability Datetime' ;
    rdfs:comment 'The date and time when the results of the fulfilled order became available for review. May differ from fulfillment datetime for orders requiring processing time (e.g., lab cultures, pathology).' ;
    rdfs:domain ind:Fulfillment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:revenueCode rdf:type rdf:Property ;
    rdfs:label 'Revenue Code' ;
    rdfs:comment 'The UB-04 revenue code associated with the fulfillment for hospital billing. Identifies the department or type of service for institutional claims.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:turnaroundTimeMinutes rdf:type rdf:Property ;
    rdfs:label 'Turnaround Time Minutes' ;
    rdfs:comment 'Calculated elapsed time in minutes from order placement to fulfillment completion. Key performance indicator for order processing efficiency and departmental performance measurement.' ;
    rdfs:domain ind:Fulfillment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:verbalOrderId rdf:type rdf:Property ;
    rdfs:label 'Verbal Order Id' ;
    rdfs:comment 'Unique identifier for the verbal order or co-signature event record. Primary key.' ;
    rdfs:domain ind:VerbalOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:primaryVerbalClinicianId rdf:type rdf:Property ;
    rdfs:label 'Primary Verbal Clinician Id' ;
    rdfs:comment 'Reference to the provider who originated the clinical order. For verbal/telephone orders, this is the provider who gave the order. For co-signatures, this is the primary ordering provider (e.g., resident or trainee).' ;
    rdfs:domain ind:VerbalOrder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:receivingClinicianId rdf:type rdf:Property ;
    rdfs:label 'Receiving Clinician Id' ;
    rdfs:comment 'Reference to the clinician (nurse, physician assistant, or other licensed provider) who received and documented the verbal or telephone order. Required for verbal/telephone orders; null for co-signature events.' ;
    rdfs:domain ind:VerbalOrder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:authenticationDatetime rdf:type rdf:Property ;
    rdfs:label 'Authentication Datetime' ;
    rdfs:comment 'Date and time when the ordering provider authenticated the verbal or telephone order, or when the co-signer completed the co-signature. Null if not yet authenticated.' ;
    rdfs:domain ind:VerbalOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:authenticationDeadlineDatetime rdf:type rdf:Property ;
    rdfs:label 'Authentication Deadline Datetime' ;
    rdfs:comment 'Date and time by which the ordering provider must authenticate the verbal or telephone order. Typically 24-48 hours per TJC and CMS policy. Null for co-signature events.' ;
    rdfs:domain ind:VerbalOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:coSignatureDatetime rdf:type rdf:Property ;
    rdfs:label 'Co Signature Datetime' ;
    rdfs:comment 'Date and time when the required co-signer completed the co-signature or countersignature. Null if co-signature is pending or not required.' ;
    rdfs:domain ind:VerbalOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:coSignatureDeadlineDatetime rdf:type rdf:Property ;
    rdfs:label 'Co Signature Deadline Datetime' ;
    rdfs:comment 'Date and time by which the co-signature must be completed per organizational policy or regulatory requirement. Null if no co-signature is required.' ;
    rdfs:domain ind:VerbalOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:coSignerNpi rdf:type rdf:Property ;
    rdfs:label 'Co Signer Npi' ;
    rdfs:comment 'National Provider Identifier (NPI) of the co-signer or countersigner. Null if no co-signature is required.' ;
    rdfs:domain ind:VerbalOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coSignerRole rdf:type rdf:Property ;
    rdfs:label 'Co Signer Role' ;
    rdfs:comment 'Role or credential type of the required co-signer. Indicates the supervisory relationship (attending supervising resident, pharmacist verifying controlled substance, etc.).' ;
    rdfs:domain ind:VerbalOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:controlledSubstanceFlag rdf:type rdf:Property ;
    rdfs:label 'Controlled Substance Flag' ;
    rdfs:comment 'Indicates whether the order involves a DEA-controlled substance requiring additional countersignature per DEA regulations.' ;
    rdfs:domain ind:VerbalOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:orderContent rdf:type rdf:Property ;
    rdfs:label 'Order Content' ;
    rdfs:comment 'Free-text description of the clinical order content as received verbally or by telephone. Includes medication name, dose, route, frequency, or procedure/test details. Business-confidential clinical information.' ;
    rdfs:domain ind:VerbalOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:orderReceivedDatetime rdf:type rdf:Property ;
    rdfs:label 'Order Received Datetime' ;
    rdfs:comment 'Date and time when the verbal or telephone order was received by the clinician. Principal business event timestamp for verbal/telephone orders.' ;
    rdfs:domain ind:VerbalOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:overdueFlag rdf:type rdf:Property ;
    rdfs:label 'Overdue Flag' ;
    rdfs:comment 'Indicates whether the authentication or co-signature is overdue (current datetime exceeds the deadline). Calculated flag for compliance monitoring.' ;
    rdfs:domain ind:VerbalOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:readBackConfirmedFlag rdf:type rdf:Property ;
    rdfs:label 'Read Back Confirmed Flag' ;
    rdfs:comment 'Indicates whether the receiving clinician performed a read-back confirmation of the verbal or telephone order to the ordering provider. Required by TJC for patient safety.' ;
    rdfs:domain ind:VerbalOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:readBackDatetime rdf:type rdf:Property ;
    rdfs:label 'Read Back Datetime' ;
    rdfs:comment 'Date and time when the read-back confirmation was performed. Null if read-back was not completed.' ;
    rdfs:domain ind:VerbalOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:receivingClinicianNpi rdf:type rdf:Property ;
    rdfs:label 'Receiving Clinician Npi' ;
    rdfs:comment 'National Provider Identifier (NPI) of the clinician who received the verbal or telephone order. Null for co-signature events.' ;
    rdfs:domain ind:VerbalOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryBasis rdf:type rdf:Property ;
    rdfs:label 'Regulatory Basis' ;
    rdfs:comment 'Regulatory or policy basis requiring the co-signature or authentication. Examples: resident supervision per GME requirements, DEA controlled substance countersignature, TJC verbal order authentication.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verbalOrderType rdf:type rdf:Property ;
    rdfs:label 'Verbal Order Type' ;
    rdfs:comment 'Discriminator indicating the type of dual-authorization event: verbal order (in-person), telephone order (remote), co-signature (resident/trainee supervision), or countersignature (DEA controlled substance).' ;
    rdfs:domain ind:VerbalOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waiverDatetime rdf:type rdf:Property ;
    rdfs:label 'Waiver Datetime' ;
    rdfs:comment 'Date and time when the waiver was granted. Null if not waived.' ;
    rdfs:domain ind:VerbalOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:waiverFlag rdf:type rdf:Property ;
    rdfs:label 'Waiver Flag' ;
    rdfs:comment 'Indicates whether the authentication or co-signature requirement was waived per organizational policy or regulatory exception.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:waiverReason rdf:type rdf:Property ;
    rdfs:label 'Waiver Reason' ;
    rdfs:comment 'Free-text explanation of why the authentication or co-signature requirement was waived. Null if not waived.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:standingOrderId rdf:type rdf:Property ;
    rdfs:label 'Standing Order Id' ;
    rdfs:comment 'Unique identifier for the standing order record. Primary key.' ;
    rdfs:domain ind:StandingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:coveragePolicyId rdf:type rdf:Property ;
    rdfs:label 'Coverage Policy Id' ;
    rdfs:comment 'Foreign key linking to insurance.coverage_policy. Business justification: Standing order protocols must align with payer coverage policies to ensure reimbursement and avoid denials. Real-world process: protocol committees review payer policies when creating standing orders ' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CoveragePolicy .

ind:formTemplateId rdf:type rdf:Property ;
    rdfs:label 'Form Template Id' ;
    rdfs:comment 'Foreign key linking to consent.consent_form_template. Business justification: Standing orders (nurse-initiated protocols, vaccination programs) specify which consent template must be used. Protocol compliance workflow ensures correct consent form is obtained before protocol exe' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FormTemplate .

ind:primaryStandingEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Standing Employee Id' ;
    rdfs:comment 'Identifier of the system user who created this standing order record.' ;
    rdfs:domain ind:StandingOrder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:activationCondition rdf:type rdf:Property ;
    rdfs:label 'Activation Condition' ;
    rdfs:comment 'Specific clinical trigger or condition that must be met before the standing order can be executed (e.g., \'Systolic BP >180\', \'Blood glucose <70 mg/dL\').' ;
    rdfs:domain ind:StandingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicablePopulationCriteria rdf:type rdf:Property ;
    rdfs:label 'Applicable Population Criteria' ;
    rdfs:comment 'Clinical criteria defining which patient populations are eligible for this standing order (e.g., \'Adults age 18+ with suspected sepsis\', \'Pediatric patients with fever >38.5C\').' ;
    rdfs:domain ind:StandingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorizedRole rdf:type rdf:Property ;
    rdfs:label 'Authorized Role' ;
    rdfs:comment 'Clinical role or credential level authorized to execute this standing order (e.g., \'Registered Nurse\', \'Licensed Practical Nurse\', \'Respiratory Therapist\').' ;
    rdfs:domain ind:StandingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contraindication rdf:type rdf:Property ;
    rdfs:label 'Contraindication' ;
    rdfs:comment 'Clinical conditions or circumstances under which this standing order should NOT be executed.' ;
    rdfs:domain ind:StandingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentationRequirement rdf:type rdf:Property ;
    rdfs:label 'Documentation Requirement' ;
    rdfs:comment 'Specific documentation that must be completed when this standing order is executed (e.g., vital signs, assessment findings, patient response).' ;
    rdfs:domain ind:StandingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:evidenceBasedGuidelineReference rdf:type rdf:Property ;
    rdfs:label 'Evidence Based Guideline Reference' ;
    rdfs:comment 'Citation or reference to clinical practice guidelines, research studies, or evidence-based protocols supporting this standing order.' ;
    rdfs:domain ind:StandingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maximumDurationDays rdf:type rdf:Property ;
    rdfs:label 'Maximum Duration Days' ;
    rdfs:comment 'Maximum number of days this standing order remains active before requiring renewal or expiration.' ;
    rdfs:domain ind:StandingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:medicationDose rdf:type rdf:Property ;
    rdfs:label 'Medication Dose' ;
    rdfs:comment 'Dosage amount and unit for medication orders (e.g., \'500 mg\', \'10 units\').' ;
    rdfs:domain ind:StandingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicationFrequency rdf:type rdf:Property ;
    rdfs:label 'Medication Frequency' ;
    rdfs:comment 'Frequency of medication administration (e.g., \'BID\', \'TID\', \'Q4H\', \'PRN\').' ;
    rdfs:domain ind:StandingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicationName rdf:type rdf:Property ;
    rdfs:label 'Medication Name' ;
    rdfs:comment 'Generic or brand name of the medication if this standing order is for pharmacy orders.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicationRoute rdf:type rdf:Property ;
    rdfs:label 'Medication Route' ;
    rdfs:comment 'Route of administration for medication orders. [ENUM-REF-CANDIDATE: oral|intravenous|intramuscular|subcutaneous|topical|inhalation|rectal|sublingual|transdermal|ophthalmic|otic|nasal — 12 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:StandingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notificationRecipientRole rdf:type rdf:Property ;
    rdfs:label 'Notification Recipient Role' ;
    rdfs:comment 'Role or position of the clinician who should be notified when this standing order is executed (e.g., \'Attending Physician\', \'Hospitalist\', \'Charge Nurse\').' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notificationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Notification Required Flag' ;
    rdfs:comment 'Indicates whether the authorizing provider or other clinician must be notified when this standing order is executed.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:orderDetail rdf:type rdf:Property ;
    rdfs:label 'Order Detail' ;
    rdfs:comment 'Detailed specification of the order including drug name and dose, lab test panel, imaging modality, or intervention description.' ;
    rdfs:domain ind:StandingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:protocolCode rdf:type rdf:Property ;
    rdfs:label 'Protocol Code' ;
    rdfs:comment 'Unique alphanumeric code identifying the standing order protocol within the organization\'s order catalog.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:protocolName rdf:type rdf:Property ;
    rdfs:label 'Protocol Name' ;
    rdfs:comment 'The official name of the standing order protocol (e.g., \'Sepsis Bundle\', \'Chest Pain Protocol\', \'Fall Prevention Standing Orders\').' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:protocolVersion rdf:type rdf:Property ;
    rdfs:label 'Protocol Version' ;
    rdfs:comment 'Version identifier for the standing order protocol to track revisions and updates over time.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryComplianceNote rdf:type rdf:Property ;
    rdfs:label 'Regulatory Compliance Note' ;
    rdfs:comment 'Notes regarding compliance with regulatory requirements, accreditation standards, or organizational policies related to this standing order.' ;
    rdfs:domain ind:StandingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:renewalFrequencyDays rdf:type rdf:Property ;
    rdfs:label 'Renewal Frequency Days' ;
    rdfs:comment 'Number of days between required renewals if renewal is required.' ;
    rdfs:domain ind:StandingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:renewalRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Renewal Required Flag' ;
    rdfs:comment 'Indicates whether this standing order requires periodic renewal by the authorizing provider.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:specialInstructions rdf:type rdf:Property ;
    rdfs:label 'Special Instructions' ;
    rdfs:comment 'Additional clinical guidance, precautions, or instructions for executing this standing order.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cpoeAlertId rdf:type rdf:Property ;
    rdfs:label 'Cpoe Alert Id' ;
    rdfs:comment 'Unique identifier for the CPOE clinical decision support alert event.' ;
    rdfs:domain ind:Order ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CpoeAlert .

ind:alertRuleId rdf:type rdf:Property ;
    rdfs:label 'Alert Rule Id' ;
    rdfs:comment 'Unique identifier of the specific clinical decision support rule or logic that triggered this alert, used for rule performance tracking and optimization.' ;
    rdfs:domain ind:Order ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AlertRule .

ind:alertAcknowledgedFlag rdf:type rdf:Property ;
    rdfs:label 'Alert Acknowledged Flag' ;
    rdfs:comment 'Boolean indicator of whether the provider explicitly acknowledged viewing the alert before taking action.' ;
    rdfs:domain ind:CpoeAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:alertDisplayDurationSeconds rdf:type rdf:Property ;
    rdfs:label 'Alert Display Duration Seconds' ;
    rdfs:comment 'Number of seconds the alert was displayed on screen before the provider responded, used for alert fatigue analysis.' ;
    rdfs:domain ind:CpoeAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:alertFireTimestamp rdf:type rdf:Property ;
    rdfs:label 'Alert Fire Timestamp' ;
    rdfs:comment 'Date and time when the clinical decision support alert was triggered during CPOE order entry workflow.' ;
    rdfs:domain ind:CpoeAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:alertMessage rdf:type rdf:Property ;
    rdfs:label 'Alert Message' ;
    rdfs:comment 'Full text message content of the alert explaining the clinical concern and recommended action.' ;
    rdfs:domain ind:CpoeAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alertPriority rdf:type rdf:Property ;
    rdfs:label 'Alert Priority' ;
    rdfs:comment 'Priority level assigned to the alert based on clinical significance and potential patient harm.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alertRuleVersion rdf:type rdf:Property ;
    rdfs:label 'Alert Rule Version' ;
    rdfs:comment 'Version number of the CDS rule at the time the alert was fired, supporting rule change tracking and historical analysis.' ;
    rdfs:domain ind:CpoeAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alertSourceSystem rdf:type rdf:Property ;
    rdfs:label 'Alert Source System' ;
    rdfs:comment 'Name of the clinical decision support system or knowledge base that generated the alert (e.g., Epic CDS, First Databank, Medi-Span, Micromedex).' ;
    rdfs:domain ind:CpoeAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alertSuppressedFlag rdf:type rdf:Property ;
    rdfs:label 'Alert Suppressed Flag' ;
    rdfs:comment 'Boolean indicator of whether the alert was suppressed by system configuration or provider preference settings and not displayed to the ordering provider.' ;
    rdfs:domain ind:CpoeAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:alertTitle rdf:type rdf:Property ;
    rdfs:label 'Alert Title' ;
    rdfs:comment 'Short descriptive title of the alert displayed to the ordering provider in the CPOE interface.' ;
    rdfs:domain ind:CpoeAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alertTriggerDetail rdf:type rdf:Property ;
    rdfs:label 'Alert Trigger Detail' ;
    rdfs:comment 'Detailed information about what triggered the alert, such as specific drug names in an interaction, allergy substance, or duplicate order details.' ;
    rdfs:domain ind:CpoeAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alertType rdf:type rdf:Property ;
    rdfs:label 'Alert Type' ;
    rdfs:comment 'Category of clinical decision support alert fired during order entry. [ENUM-REF-CANDIDATE: drug_drug_interaction|drug_allergy|duplicate_order|dose_range_check|contraindication|formulary_substitution|critical_lab_value|renal_dosing|pregnancy_warning|age_based_warning|therapeutic_duplication|black_box_warning — promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allergySubstance rdf:type rdf:Property ;
    rdfs:label 'Allergy Substance' ;
    rdfs:comment 'Allergen or substance that triggered a drug-allergy alert, matched against the patient\'s documented allergy list.' ;
    rdfs:domain ind:CpoeAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clinicalContext rdf:type rdf:Property ;
    rdfs:label 'Clinical Context' ;
    rdfs:comment 'Additional clinical context at the time of alert such as patient location, care setting, or clinical indication that may influence alert interpretation.' ;
    rdfs:domain ind:CpoeAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:duplicateOrderTimeframeHours rdf:type rdf:Property ;
    rdfs:label 'Duplicate Order Timeframe Hours' ;
    rdfs:comment 'Number of hours within which a duplicate order was detected, used for duplicate order alerts to indicate how recently a similar order was placed.' ;
    rdfs:domain ind:CpoeAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:formularyStatus rdf:type rdf:Property ;
    rdfs:label 'Formulary Status' ;
    rdfs:comment 'Formulary classification of the ordered medication that triggered a formulary substitution alert.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interactingMedication1 rdf:type rdf:Property ;
    rdfs:label 'Interacting Medication 1' ;
    rdfs:comment 'First medication involved in a drug-drug interaction alert, typically the newly ordered medication.' ;
    rdfs:domain ind:CpoeAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interactingMedication2 rdf:type rdf:Property ;
    rdfs:label 'Interacting Medication 2' ;
    rdfs:comment 'Second medication involved in a drug-drug interaction alert, typically an existing active medication on the patient\'s medication list.' ;
    rdfs:domain ind:CpoeAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:orderedDose rdf:type rdf:Property ;
    rdfs:label 'Ordered Dose' ;
    rdfs:comment 'Medication dose that was ordered and triggered a dose range check alert.' ;
    rdfs:domain ind:CpoeAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:orderedDoseUnit rdf:type rdf:Property ;
    rdfs:label 'Ordered Dose Unit' ;
    rdfs:comment 'Unit of measure for the ordered dose (e.g., mg, mL, units) that triggered the dose range check alert.' ;
    rdfs:domain ind:CpoeAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:overrideReasonCode rdf:type rdf:Property ;
    rdfs:label 'Override Reason Code' ;
    rdfs:comment 'Standardized code indicating the reason the provider chose to override the alert, required for soft stop alerts that are dismissed.' ;
    rdfs:domain ind:CpoeAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:overrideReasonText rdf:type rdf:Property ;
    rdfs:label 'Override Reason Text' ;
    rdfs:comment 'Free-text explanation provided by the ordering provider justifying why the alert was overridden.' ;
    rdfs:domain ind:CpoeAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:patientAgeAtAlert rdf:type rdf:Property ;
    rdfs:label 'Patient Age At Alert' ;
    rdfs:comment 'Patient\'s age in years at the time the alert was fired, relevant for age-based dosing and contraindication alerts.' ;
    rdfs:domain ind:CpoeAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:patientWeightKg rdf:type rdf:Property ;
    rdfs:label 'Patient Weight Kg' ;
    rdfs:comment 'Patient\'s weight in kilograms at the time of alert, used for weight-based dosing calculations in dose range check alerts.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:providerResponse rdf:type rdf:Property ;
    rdfs:label 'Provider Response' ;
    rdfs:comment 'Action taken by the ordering provider in response to the alert: accepted (order changed per alert), overridden (alert dismissed and order continued), modified (order adjusted), cancelled (order abandoned), or deferred (decision postponed).' ;
    rdfs:domain ind:CpoeAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recommendedDoseMax rdf:type rdf:Property ;
    rdfs:label 'Recommended Dose Max' ;
    rdfs:comment 'Maximum recommended dose from the clinical decision support knowledge base for dose range check alerts.' ;
    rdfs:domain ind:CpoeAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recommendedDoseMin rdf:type rdf:Property ;
    rdfs:label 'Recommended Dose Min' ;
    rdfs:comment 'Minimum recommended dose from the clinical decision support knowledge base for dose range check alerts.' ;
    rdfs:domain ind:CpoeAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cpoeAlertStatus rdf:type rdf:Property ;
    rdfs:label 'Cpoe Alert Status' ;
    rdfs:domain ind:CpoeAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:suggestedAlternativeMedication rdf:type rdf:Property ;
    rdfs:label 'Suggested Alternative Medication' ;
    rdfs:comment 'Formulary-preferred alternative medication suggested by the alert as a therapeutic substitution.' ;
    rdfs:domain ind:CpoeAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:suppressionReason rdf:type rdf:Property ;
    rdfs:label 'Suppression Reason' ;
    rdfs:comment 'Reason why the alert was suppressed, such as provider preference override, alert fatigue reduction rule, or duplicate alert within session.' ;
    rdfs:domain ind:CpoeAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reconciliationId rdf:type rdf:Property ;
    rdfs:label 'Reconciliation Id' ;
    rdfs:comment 'Unique identifier for the order reconciliation event. Primary key for the order reconciliation product.' ;
    rdfs:domain ind:Reconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:allergyReviewIndicator rdf:type rdf:Property ;
    rdfs:label 'Allergy Review Indicator' ;
    rdfs:comment 'Boolean flag indicating whether patient allergies were reviewed during the reconciliation process. True if reviewed, false otherwise.' ;
    rdfs:domain ind:Reconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:attestationDatetime rdf:type rdf:Property ;
    rdfs:label 'Attestation Datetime' ;
    rdfs:comment 'Date and time when the provider attested to the accuracy and completeness of the reconciliation.' ;
    rdfs:domain ind:Reconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:attestationSignature rdf:type rdf:Property ;
    rdfs:label 'Attestation Signature' ;
    rdfs:comment 'Electronic signature or attestation identifier of the provider who completed the reconciliation, confirming accuracy and completeness.' ;
    rdfs:domain ind:Reconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:completionIndicator rdf:type rdf:Property ;
    rdfs:label 'Completion Indicator' ;
    rdfs:comment 'Boolean flag indicating whether the reconciliation was fully completed per regulatory requirements. True if completed, false otherwise.' ;
    rdfs:domain ind:Reconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:complianceIndicator rdf:type rdf:Property ;
    rdfs:label 'Compliance Indicator' ;
    rdfs:comment 'Boolean flag indicating whether the reconciliation met all regulatory and accreditation requirements. True if compliant, false otherwise.' ;
    rdfs:domain ind:Reconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:discrepancyDescription rdf:type rdf:Property ;
    rdfs:label 'Discrepancy Description' ;
    rdfs:comment 'Detailed description of any discrepancies identified during the reconciliation process, including medication omissions, duplications, dosing errors, or therapeutic substitutions.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:discrepancyIdentifiedIndicator rdf:type rdf:Property ;
    rdfs:label 'Discrepancy Identified Indicator' ;
    rdfs:comment 'Boolean flag indicating whether any discrepancies were identified during reconciliation. True if discrepancies found, false otherwise.' ;
    rdfs:domain ind:Reconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:discrepancySeverity rdf:type rdf:Property ;
    rdfs:label 'Discrepancy Severity' ;
    rdfs:comment 'Clinical severity level of identified discrepancies. High for potentially life-threatening, medium for clinically significant, low for minor, none if no discrepancies.' ;
    rdfs:domain ind:Reconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentationLocation rdf:type rdf:Property ;
    rdfs:label 'Documentation Location' ;
    rdfs:comment 'Location or section within the EMR where the reconciliation documentation is stored (e.g., admission note, discharge summary, medication administration record).' ;
    rdfs:domain ind:Reconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:drugInteractionCheckIndicator rdf:type rdf:Property ;
    rdfs:label 'Drug Interaction Check Indicator' ;
    rdfs:comment 'Boolean flag indicating whether drug-drug interaction screening was performed during reconciliation. True if performed, false otherwise.' ;
    rdfs:domain ind:Reconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:formularyCheckIndicator rdf:type rdf:Property ;
    rdfs:label 'Formulary Check Indicator' ;
    rdfs:comment 'Boolean flag indicating whether formulary status was checked for medications during reconciliation. True if checked, false otherwise.' ;
    rdfs:domain ind:Reconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:homeMedicationListReviewedIndicator rdf:type rdf:Property ;
    rdfs:label 'Home Medication List Reviewed Indicator' ;
    rdfs:comment 'Boolean flag indicating whether the patient\'s home medication list was reviewed during reconciliation. True if reviewed, false otherwise.' ;
    rdfs:domain ind:Reconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastUpdatedDatetime rdf:type rdf:Property ;
    rdfs:label 'Last Updated Datetime' ;
    rdfs:comment 'Date and time when this reconciliation record was last modified. Audit trail timestamp for record updates.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:nextProviderCommunicationIndicator rdf:type rdf:Property ;
    rdfs:label 'Next Provider Communication Indicator' ;
    rdfs:comment 'Boolean flag indicating whether the reconciled medication list was communicated to the next provider of care. True if communicated, false otherwise.' ;
    rdfs:domain ind:Reconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nonComplianceReason rdf:type rdf:Property ;
    rdfs:label 'Non Compliance Reason' ;
    rdfs:comment 'Reason for non-compliance if the reconciliation did not meet regulatory requirements (e.g., patient refused, clinically unstable, incomplete information).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ordersAddedCount rdf:type rdf:Property ;
    rdfs:label 'Orders Added Count' ;
    rdfs:comment 'Number of new orders added during the reconciliation process.' ;
    rdfs:domain ind:Reconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ordersContinuedCount rdf:type rdf:Property ;
    rdfs:label 'Orders Continued Count' ;
    rdfs:comment 'Number of orders continued without modification during reconciliation.' ;
    rdfs:domain ind:Reconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ordersDiscontinuedCount rdf:type rdf:Property ;
    rdfs:label 'Orders Discontinued Count' ;
    rdfs:comment 'Number of orders discontinued during the reconciliation process.' ;
    rdfs:domain ind:Reconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ordersModifiedCount rdf:type rdf:Property ;
    rdfs:label 'Orders Modified Count' ;
    rdfs:comment 'Number of orders modified during the reconciliation process (dose changes, frequency adjustments, route changes).' ;
    rdfs:domain ind:Reconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ordersReviewedCount rdf:type rdf:Property ;
    rdfs:label 'Orders Reviewed Count' ;
    rdfs:comment 'Total number of orders reviewed during the reconciliation process.' ;
    rdfs:domain ind:Reconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:patientCommunicationIndicator rdf:type rdf:Property ;
    rdfs:label 'Patient Communication Indicator' ;
    rdfs:comment 'Boolean flag indicating whether the reconciled medication list was communicated to the patient or caregiver. True if communicated, false otherwise.' ;
    rdfs:domain ind:Reconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reconciliationType rdf:type rdf:Property ;
    rdfs:label 'Reconciliation Type' ;
    rdfs:comment 'Type of care transition event that triggered the reconciliation process. Admission, transfer, discharge, pre-procedure, post-procedure, or outpatient visit.' ;
    rdfs:domain ind:Reconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reconcilingProviderNpi rdf:type rdf:Property ;
    rdfs:label 'Reconciling Provider Npi' ;
    rdfs:comment 'National Provider Identifier of the clinician who performed the medication reconciliation. Ten-digit unique identifier.' ;
    rdfs:domain ind:Reconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceMedicationListType rdf:type rdf:Property ;
    rdfs:label 'Source Medication List Type' ;
    rdfs:comment 'Source of the medication list used for reconciliation. Patient reported, pharmacy records, prior EMR, PCP records, family reported, or medication bottles.' ;
    rdfs:domain ind:Reconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transitionEvent rdf:type rdf:Property ;
    rdfs:label 'Transition Event' ;
    rdfs:comment 'Specific care transition event that triggered the reconciliation requirement. Admit, transfer in, transfer out, discharge, pre-op, post-op, ED arrival, or ED departure. [ENUM-REF-CANDIDATE: admit|transfer_in|transfer_out|discharge|pre_op|post_op|ed_arrival|ed_departure — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Reconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dietOrderId rdf:type rdf:Property ;
    rdfs:label 'Diet Order Id' ;
    rdfs:comment 'Unique identifier for the diet order record. Primary key for the diet order entity.' ;
    rdfs:domain ind:DietOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:primaryDietClinicianId rdf:type rdf:Property ;
    rdfs:label 'Primary Diet Clinician Id' ;
    rdfs:comment 'Reference to the clinician who ordered the diet. Links to the provider master record.' ;
    rdfs:domain ind:DietOrder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:supersededDietOrderId rdf:type rdf:Property ;
    rdfs:label 'Superseded Diet Order Id' ;
    rdfs:comment 'Self-referencing FK on diet_order (superseded_diet_order_id)' ;
    rdfs:domain ind:DietOrder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DietOrder .

ind:allergenExclusions rdf:type rdf:Property ;
    rdfs:label 'Allergen Exclusions' ;
    rdfs:comment 'Comma-separated list of food allergens that must be excluded from the diet such as peanuts, tree nuts, shellfish, dairy, eggs, soy, wheat, or fish. Cross-referenced with patient allergy records.' ;
    rdfs:domain ind:DietOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:calorieTarget rdf:type rdf:Property ;
    rdfs:label 'Calorie Target' ;
    rdfs:comment 'Target daily caloric intake in kilocalories prescribed for the patient based on nutritional assessment and clinical needs.' ;
    rdfs:domain ind:DietOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dietType rdf:type rdf:Property ;
    rdfs:label 'Diet Type' ;
    rdfs:comment 'The primary classification of the diet order such as regular, cardiac, diabetic, renal, low sodium, clear liquid, full liquid, or NPO (nothing by mouth). Standardized using SNOMED CT diet codes where applicable.' ;
    rdfs:domain ind:DietOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dietTypeCode rdf:type rdf:Property ;
    rdfs:label 'Diet Type Code' ;
    rdfs:comment 'Standardized code representing the diet type from SNOMED CT or institutional diet catalog.' ;
    rdfs:domain ind:DietOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feedingRoute rdf:type rdf:Property ;
    rdfs:label 'Feeding Route' ;
    rdfs:comment 'The route by which nutrition is delivered to the patient including oral intake, enteral tube feeding, or parenteral nutrition.' ;
    rdfs:domain ind:DietOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fluidConsistency rdf:type rdf:Property ;
    rdfs:label 'Fluid Consistency' ;
    rdfs:comment 'The required consistency level for liquids to prevent aspiration in patients with swallowing disorders.' ;
    rdfs:domain ind:DietOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fluidRestrictionMl rdf:type rdf:Property ;
    rdfs:label 'Fluid Restriction Ml' ;
    rdfs:comment 'Maximum daily fluid intake allowed in milliliters. Used for patients with heart failure, renal disease, or other conditions requiring fluid management.' ;
    rdfs:domain ind:DietOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:foodPreferences rdf:type rdf:Property ;
    rdfs:label 'Food Preferences' ;
    rdfs:comment 'Patient-reported food preferences, cultural dietary requirements, or religious restrictions such as vegetarian, vegan, kosher, halal, or specific food dislikes.' ;
    rdfs:domain ind:DietOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mealSchedule rdf:type rdf:Property ;
    rdfs:label 'Meal Schedule' ;
    rdfs:comment 'Prescribed meal timing and frequency such as three meals daily, six small meals, continuous feeding, or NPO except medications.' ;
    rdfs:domain ind:DietOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:npoReason rdf:type rdf:Property ;
    rdfs:label 'Npo Reason' ;
    rdfs:comment 'Clinical rationale for NPO status such as pre-operative fasting, aspiration risk, bowel rest, or diagnostic testing requirements.' ;
    rdfs:domain ind:DietOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:npoStatus rdf:type rdf:Property ;
    rdfs:label 'Npo Status' ;
    rdfs:comment 'Indicates whether the patient is NPO (nothing by mouth) typically in preparation for surgery, procedures, or due to clinical contraindications for oral intake.' ;
    rdfs:domain ind:DietOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:proteinTargetGrams rdf:type rdf:Property ;
    rdfs:label 'Protein Target Grams' ;
    rdfs:comment 'Target daily protein intake in grams prescribed for the patient to support healing, muscle maintenance, or disease management.' ;
    rdfs:domain ind:DietOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sourceSystemOrderReference rdf:type rdf:Property ;
    rdfs:label 'Source System Order Reference' ;
    rdfs:comment 'The unique identifier for this diet order in the source operational system used for data lineage and reconciliation.' ;
    rdfs:domain ind:Order ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dietOrderStatus rdf:type rdf:Property ;
    rdfs:label 'Diet Order Status' ;
    rdfs:domain ind:DietOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supplementFrequency rdf:type rdf:Property ;
    rdfs:label 'Supplement Frequency' ;
    rdfs:comment 'Frequency of nutritional supplement administration such as once daily, twice daily, three times daily, with meals, or between meals.' ;
    rdfs:domain ind:DietOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supplementName rdf:type rdf:Property ;
    rdfs:label 'Supplement Name' ;
    rdfs:comment 'Name of the prescribed oral nutritional supplement such as Ensure, Boost, Glucerna, or specialized formulas for enteral nutrition support.' ;
    rdfs:domain ind:DietOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:textureModification rdf:type rdf:Property ;
    rdfs:label 'Texture Modification' ;
    rdfs:comment 'Specification of food texture modifications required for safe swallowing such as pureed, mechanical soft, minced, ground, or chopped. Used for patients with dysphagia or chewing difficulties.' ;
    rdfs:domain ind:DietOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:therapyOrderId rdf:type rdf:Property ;
    rdfs:label 'Therapy Order Id' ;
    rdfs:comment 'Unique identifier for the therapy order. Primary key for the therapy order product.' ;
    rdfs:domain ind:TherapyOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:primaryTherapyClinicianId rdf:type rdf:Property ;
    rdfs:label 'Primary Therapy Clinician Id' ;
    rdfs:comment 'Reference to the provider who ordered the therapy service.' ;
    rdfs:domain ind:TherapyOrder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:supersededTherapyOrderId rdf:type rdf:Property ;
    rdfs:label 'Superseded Therapy Order Id' ;
    rdfs:comment 'Self-referencing FK on therapy_order (superseded_therapy_order_id)' ;
    rdfs:domain ind:TherapyOrder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TherapyOrder .

ind:therapyCostCenterId rdf:type rdf:Property ;
    rdfs:label 'Therapy Cost Center Id' ;
    rdfs:comment 'Foreign key linking to finance.cost_center. Business justification: Therapy services (PT, OT, speech, respiratory) are delivered by departments with dedicated cost centers. Essential for therapy department financial performance monitoring, productivity analysis (cost ' ;
    rdfs:domain ind:TherapyOrder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CostCenter .

ind:authorizationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Authorization Required Flag' ;
    rdfs:comment 'Indicates whether payer authorization or prior approval is required before the therapy service can be performed.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:durationUnit rdf:type rdf:Property ;
    rdfs:label 'Duration Unit' ;
    rdfs:comment 'Unit of measure for the duration value (e.g., minutes, hours).' ;
    rdfs:domain ind:TherapyOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:durationValue rdf:type rdf:Property ;
    rdfs:label 'Duration Value' ;
    rdfs:comment 'Numeric value representing the length of time for each therapy session.' ;
    rdfs:domain ind:TherapyOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:frequencyDescription rdf:type rdf:Property ;
    rdfs:label 'Frequency Description' ;
    rdfs:comment 'Human-readable description of the therapy frequency, providing additional detail beyond the frequency code.' ;
    rdfs:domain ind:TherapyOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:patientInstructions rdf:type rdf:Property ;
    rdfs:label 'Patient Instructions' ;
    rdfs:comment 'Instructions or guidance to be provided to the patient regarding the therapy service, such as preparation steps or what to expect.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sessionsCompleted rdf:type rdf:Property ;
    rdfs:label 'Sessions Completed' ;
    rdfs:comment 'The number of therapy sessions that have been completed to date.' ;
    rdfs:domain ind:TherapyOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sessionsRemaining rdf:type rdf:Property ;
    rdfs:label 'Sessions Remaining' ;
    rdfs:comment 'The number of therapy sessions remaining from the total authorized sessions.' ;
    rdfs:domain ind:TherapyOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:therapyServiceCode rdf:type rdf:Property ;
    rdfs:label 'Therapy Service Code' ;
    rdfs:comment 'Standardized code representing the specific therapy service ordered, typically from a clinical terminology system.' ;
    rdfs:domain ind:TherapyOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:therapyServiceDescription rdf:type rdf:Property ;
    rdfs:label 'Therapy Service Description' ;
    rdfs:comment 'Human-readable description of the therapy service being ordered.' ;
    rdfs:domain ind:TherapyOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:therapyType rdf:type rdf:Property ;
    rdfs:label 'Therapy Type' ;
    rdfs:comment 'The type of therapy service ordered: physical therapy, occupational therapy, speech therapy, or respiratory therapy.' ;
    rdfs:domain ind:TherapyOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalSessionsOrdered rdf:type rdf:Property ;
    rdfs:label 'Total Sessions Ordered' ;
    rdfs:comment 'The total number of therapy sessions authorized or ordered for this treatment plan.' ;
    rdfs:domain ind:TherapyOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:treatmentGoal rdf:type rdf:Property ;
    rdfs:label 'Treatment Goal' ;
    rdfs:comment 'The intended therapeutic outcome or goal for the therapy service, such as improving mobility, restoring function, or enhancing communication.' ;
    rdfs:domain ind:TherapyOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alertApprovedByUserEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Alert Approved By User Employee Id' ;
    rdfs:comment 'Identifier of the clinical or administrative user who approved this alert rule for production use.' ;
    rdfs:domain ind:AlertRule ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:alertEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Alert Employee Id' ;
    rdfs:comment 'Identifier of the user or system account that created this alert rule record.' ;
    rdfs:domain ind:AlertRule ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:alertLastModifiedByUserEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Alert Last Modified By User Employee Id' ;
    rdfs:comment 'Identifier of the user or system account that last modified this alert rule record.' ;
    rdfs:domain ind:AlertRule ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:parentAlertRuleId rdf:type rdf:Property ;
    rdfs:label 'Parent Alert Rule Id' ;
    rdfs:comment 'Self-referencing FK on alert_rule (parent_alert_rule_id)' ;
    rdfs:domain ind:AlertRule ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AlertRule .

ind:alertFatigueRiskScore rdf:type rdf:Property ;
    rdfs:label 'Alert Fatigue Risk Score' ;
    rdfs:comment 'Calculated risk score (0-100) indicating likelihood this alert contributes to clinician alert fatigue based on fire frequency and override rate.' ;
    rdfs:domain ind:AlertRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:alertMessageTemplate rdf:type rdf:Property ;
    rdfs:label 'Alert Message Template' ;
    rdfs:comment 'Standardized message text template displayed to clinicians when the alert fires, may include placeholders for dynamic values.' ;
    rdfs:domain ind:AlertRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Approved Timestamp' ;
    rdfs:comment 'Date and time when this alert rule was approved for activation in production systems.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:autoDismissSeconds rdf:type rdf:Property ;
    rdfs:label 'Auto Dismiss Seconds' ;
    rdfs:comment 'Number of seconds after which the alert automatically dismisses if not acknowledged. Null means no auto-dismiss.' ;
    rdfs:domain ind:AlertRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:clinicalSpecialtyScope rdf:type rdf:Property ;
    rdfs:label 'Clinical Specialty Scope' ;
    rdfs:comment 'Comma-separated list of clinical specialties or departments where this rule is active. Empty means applies to all specialties.' ;
    rdfs:domain ind:AlertRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:displayPriority rdf:type rdf:Property ;
    rdfs:label 'Display Priority' ;
    rdfs:comment 'Numeric ranking used to determine display order when multiple alerts fire simultaneously. Lower numbers indicate higher priority.' ;
    rdfs:domain ind:AlertRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:evidenceSource rdf:type rdf:Property ;
    rdfs:label 'Evidence Source' ;
    rdfs:comment 'Citation or reference to the clinical evidence, guideline, or regulatory requirement that justifies this alert rule.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:evidenceStrengthLevel rdf:type rdf:Property ;
    rdfs:label 'Evidence Strength Level' ;
    rdfs:comment 'Classification of the strength of clinical evidence supporting this alert rule based on evidence-based medicine hierarchy.' ;
    rdfs:domain ind:AlertRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:externalRuleCode rdf:type rdf:Property ;
    rdfs:label 'External Rule Code' ;
    rdfs:comment 'Identifier for this alert rule in the source operational system, used for system integration and reconciliation.' ;
    rdfs:domain ind:AlertRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fireCountTotal rdf:type rdf:Property ;
    rdfs:label 'Fire Count Total' ;
    rdfs:comment 'Cumulative number of times this alert rule has fired since activation, used for alert fatigue analysis.' ;
    rdfs:domain ind:AlertRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:hardStopFlag rdf:type rdf:Property ;
    rdfs:label 'Hard Stop Flag' ;
    rdfs:comment 'Indicates whether this alert prevents order completion until resolved (hard stop) or is advisory only (soft stop).' ;
    rdfs:domain ind:AlertRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:integrationSystemCode rdf:type rdf:Property ;
    rdfs:label 'Integration System Code' ;
    rdfs:comment 'Code identifying the source clinical system where this alert rule is configured (e.g., Epic, Beaker, Radiant, Willow).' ;
    rdfs:domain ind:AlertRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:orderTypeScope rdf:type rdf:Property ;
    rdfs:label 'Order Type Scope' ;
    rdfs:comment 'Comma-separated list of order types this rule applies to (e.g., medication, lab, radiology, procedure). Empty means applies to all order types.' ;
    rdfs:domain ind:AlertRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:overrideAllowedFlag rdf:type rdf:Property ;
    rdfs:label 'Override Allowed Flag' ;
    rdfs:comment 'Indicates whether clinicians are permitted to override or dismiss this alert without taking action.' ;
    rdfs:domain ind:AlertRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:overrideCountTotal rdf:type rdf:Property ;
    rdfs:label 'Override Count Total' ;
    rdfs:comment 'Cumulative number of times clinicians have overridden this alert, used to assess alert appropriateness.' ;
    rdfs:domain ind:AlertRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:overrideRatePercent rdf:type rdf:Property ;
    rdfs:label 'Override Rate Percent' ;
    rdfs:comment 'Percentage of alert fires that resulted in clinician override, calculated as (override_count / fire_count) * 100.' ;
    rdfs:domain ind:AlertRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:overrideReasonRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Override Reason Required Flag' ;
    rdfs:comment 'Indicates whether a documented reason is mandatory when a clinician overrides this alert.' ;
    rdfs:domain ind:AlertRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:patientPopulationFilter rdf:type rdf:Property ;
    rdfs:label 'Patient Population Filter' ;
    rdfs:comment 'Criteria defining which patient populations this rule applies to (e.g., age range, gender, diagnosis codes). Empty means applies to all patients.' ;
    rdfs:domain ind:AlertRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recommendedAction rdf:type rdf:Property ;
    rdfs:label 'Recommended Action' ;
    rdfs:comment 'Clinical guidance or recommended action for the clinician to take when this alert is triggered.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryRequirementFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Requirement Flag' ;
    rdfs:comment 'Indicates whether this alert rule is mandated by regulatory or accreditation requirements and cannot be disabled.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reviewFrequencyMonths rdf:type rdf:Property ;
    rdfs:label 'Review Frequency Months' ;
    rdfs:comment 'Number of months between scheduled reviews of this alert rule for clinical and operational validation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ruleCategory rdf:type rdf:Property ;
    rdfs:label 'Rule Category' ;
    rdfs:comment 'Classification of the alert rule by clinical domain or purpose.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ruleCode rdf:type rdf:Property ;
    rdfs:label 'Rule Code' ;
    rdfs:comment 'Unique business identifier code for the alert rule, used for external reference and system integration.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ruleDescription rdf:type rdf:Property ;
    rdfs:label 'Rule Description' ;
    rdfs:comment 'Detailed clinical and operational description of what the alert rule detects and why it is important for patient safety.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ruleName rdf:type rdf:Property ;
    rdfs:label 'Rule Name' ;
    rdfs:comment 'Human-readable name of the alert rule displayed to clinicians and administrators.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ruleStatus rdf:type rdf:Property ;
    rdfs:label 'Rule Status' ;
    rdfs:comment 'Current lifecycle status of the alert rule indicating whether it is actively firing in production systems.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alertRuleStatus rdf:type rdf:Property ;
    rdfs:label 'Alert Rule Status' ;
    rdfs:domain ind:AlertRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:triggerCondition rdf:type rdf:Property ;
    rdfs:label 'Trigger Condition' ;
    rdfs:comment 'Business logic expression or criteria that must be met for the alert to fire, expressed in human-readable format.' ;
    rdfs:domain ind:AlertRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:parentRoutingRuleId rdf:type rdf:Property ;
    rdfs:label 'Parent Routing Rule Id' ;
    rdfs:comment 'Self-referencing FK on routing_rule (parent_routing_rule_id)' ;
    rdfs:domain ind:RoutingRule ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RoutingRule .

ind:primaryFallbackRoutingRuleId rdf:type rdf:Property ;
    rdfs:label 'Primary Fallback Routing Rule Id' ;
    rdfs:comment 'Identifier of an alternative routing rule to apply if this rule cannot be executed due to capacity, availability, or other constraints.' ;
    rdfs:domain ind:RoutingRule ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RoutingRule .

ind:approvalRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Approval Required Flag' ;
    rdfs:comment 'Indicates whether orders routed by this rule require additional clinical or administrative approval before fulfillment.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:capacityThreshold rdf:type rdf:Property ;
    rdfs:label 'Capacity Threshold' ;
    rdfs:comment 'Maximum capacity or workload threshold at the target department or facility that triggers alternative routing when exceeded.' ;
    rdfs:domain ind:RoutingRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dayOfWeek rdf:type rdf:Property ;
    rdfs:label 'Day Of Week' ;
    rdfs:comment 'Comma-separated list of days of week (Monday, Tuesday, etc.) when this routing rule is active, used for schedule-based routing.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:diagnosisCode rdf:type rdf:Property ;
    rdfs:label 'Diagnosis Code' ;
    rdfs:comment 'ICD-10 diagnosis code or code pattern that triggers this routing rule, used for condition-based routing.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:insurancePlanType rdf:type rdf:Property ;
    rdfs:label 'Insurance Plan Type' ;
    rdfs:comment 'Type of insurance plan or payer category for which this routing rule applies, used for network-based routing decisions.' ;
    rdfs:domain ind:RoutingRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isStatOverride rdf:type rdf:Property ;
    rdfs:label 'Is Stat Override' ;
    rdfs:comment 'Indicates whether this routing rule overrides normal routing for STAT or emergency priority orders.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:notificationRecipient rdf:type rdf:Property ;
    rdfs:label 'Notification Recipient' ;
    rdfs:comment 'Role, user, or group to be notified when an order is routed using this rule, used for alerting and workflow coordination.' ;
    rdfs:domain ind:RoutingRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:orderCategory rdf:type rdf:Property ;
    rdfs:label 'Order Category' ;
    rdfs:comment 'Clinical order category or service type to which this routing rule applies, such as diagnostic imaging, laboratory test, or medication order.' ;
    rdfs:domain ind:RoutingRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:orderingProviderSpecialty rdf:type rdf:Property ;
    rdfs:label 'Ordering Provider Specialty' ;
    rdfs:comment 'Specialty of the ordering provider for which this routing rule applies, used to route orders based on ordering physician specialty.' ;
    rdfs:domain ind:RoutingRule ;
    rdf:type owl:DatatypeProperty ;
