    rdfs:domain ind:DbpMonitoringEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:trichloroaceticAcidConcentrationUgL rdf:type rdf:Property ;
    rdfs:label 'Trichloroacetic Acid Concentration Ug L' ;
    rdfs:comment 'Measured concentration of trichloroacetic acid (TCAA), a haloacetic acid species, in micrograms per liter.' ;
