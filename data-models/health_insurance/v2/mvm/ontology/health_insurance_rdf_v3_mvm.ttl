    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:replacementDate rdf:type rdf:Property ;
    rdfs:label 'Replacement Date' ;
    rdfs:comment 'Date a replacement card was issued, if applicable.' ;
