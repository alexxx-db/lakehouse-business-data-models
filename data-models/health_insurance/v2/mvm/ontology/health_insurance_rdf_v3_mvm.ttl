    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:csrVariant rdf:type rdf:Property ;
    rdfs:label 'Csr Variant' ;
    rdfs:comment 'CSR variant percentage (73%, 87%, or 94%) applicable to the member.' ;
