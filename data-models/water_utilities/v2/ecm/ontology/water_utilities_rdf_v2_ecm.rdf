    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:thirdPartyNotificationId rdf:type rdf:Property ;
    rdfs:label 'Third Party Notification Id' ;
    rdfs:comment 'Unique identifier for the third-party notification arrangement. Primary key.' ;
    rdfs:domain ind:ThirdPartyNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:createdByUserEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Created By User Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: Third-party notification arrangements (for elderly/disabled customers) are set up by CSR staff. Regulatory requirement for vulnerable populations under state PUC rules. New FK needed; created_by_user ' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:thirdPartyPersonId rdf:type rdf:Property ;
    rdfs:label 'Third Party Person Id' ;
    rdfs:comment 'Foreign key linking to customer.person. Business justification: Third parties receiving notifications may be persons already in the system (e.g., family members, social workers). This FK links to person master when applicable. Nullable as many third parties are ex' ;
    rdfs:domain ind:ThirdPartyNotification ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Person .

ind:advanceNoticeDays rdf:type rdf:Property ;
    rdfs:label 'Advance Notice Days' ;
    rdfs:comment 'Number of days in advance the third party should be notified before a disconnection or service action, as required by regulation or agreement.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:arrangementStatus rdf:type rdf:Property ;
    rdfs:label 'Arrangement Status' ;
    rdfs:comment 'Current lifecycle status of the third-party notification arrangement.' ;
    rdfs:domain ind:ThirdPartyNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentDate rdf:type rdf:Property ;
    rdfs:label 'Consent Date' ;
    rdfs:comment 'Date on which the account holder provided consent for this third-party notification arrangement.' ;
    rdfs:domain ind:ThirdPartyNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:consentDocumentationReference rdf:type rdf:Property ;
    rdfs:label 'Consent Documentation Reference' ;
    rdfs:comment 'Reference identifier or document number for the signed consent form or authorization from the account holder permitting third-party notification.' ;
    rdfs:domain ind:ThirdPartyNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentMethod rdf:type rdf:Property ;
    rdfs:label 'Consent Method' ;
    rdfs:comment 'Method by which the account holder provided consent for third-party notification (e.g., written form, electronic signature, recorded verbal consent).' ;
    rdfs:domain ind:ThirdPartyNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastNotificationSentDate rdf:type rdf:Property ;
    rdfs:label 'Last Notification Sent Date' ;
    rdfs:comment 'Timestamp of the most recent notification sent to the third party under this arrangement.' ;
    rdfs:domain ind:ThirdPartyNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:lastNotificationType rdf:type rdf:Property ;
    rdfs:label 'Last Notification Type' ;
    rdfs:comment 'Type or category of the most recent notification sent to the third party (e.g., pre-disconnect, outage, boil-water notice).' ;
    rdfs:domain ind:ThirdPartyNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lowIncomeAssistanceFlag rdf:type rdf:Property ;
    rdfs:label 'Low Income Assistance Flag' ;
    rdfs:comment 'Indicates whether this third-party notification arrangement is associated with a low-income assistance or affordability program.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mailingAddressLine1 rdf:type rdf:Property ;
    rdfs:label 'Mailing Address Line 1' ;
    rdfs:comment 'First line of the mailing address for postal notification delivery to the third party.' ;
    rdfs:domain ind:ThirdPartyNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mailingAddressLine2 rdf:type rdf:Property ;
    rdfs:label 'Mailing Address Line 2' ;
    rdfs:comment 'Second line of the mailing address (suite, apartment, building) for postal notification delivery to the third party.' ;
    rdfs:domain ind:ThirdPartyNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mailingCity rdf:type rdf:Property ;
    rdfs:label 'Mailing City' ;
    rdfs:comment 'City name for the third party mailing address.' ;
    rdfs:domain ind:ThirdPartyNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mailingCountryCode rdf:type rdf:Property ;
    rdfs:label 'Mailing Country Code' ;
    rdfs:comment 'Three-letter ISO country code for the third party mailing address.' ;
    rdfs:domain ind:ThirdPartyNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mailingPostalCode rdf:type rdf:Property ;
    rdfs:label 'Mailing Postal Code' ;
    rdfs:comment 'Postal or ZIP code for the third party mailing address.' ;
    rdfs:domain ind:ThirdPartyNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mailingStateCode rdf:type rdf:Property ;
    rdfs:label 'Mailing State Code' ;
    rdfs:comment 'Two-letter state or province code for the third party mailing address.' ;
    rdfs:domain ind:ThirdPartyNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicalBaselineProgramFlag rdf:type rdf:Property ;
    rdfs:label 'Medical Baseline Program Flag' ;
    rdfs:comment 'Indicates whether this third-party notification arrangement is associated with a medical baseline or life-support equipment program requiring special disconnection protections.' ;
    rdfs:domain ind:ThirdPartyNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:notificationArrangementNumber rdf:type rdf:Property ;
    rdfs:label 'Notification Arrangement Number' ;
    rdfs:comment 'Business-facing unique identifier or reference number for this third-party notification arrangement, used in customer service interactions and correspondence.' ;
    rdfs:domain ind:ThirdPartyNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notificationDeliveryStatus rdf:type rdf:Property ;
    rdfs:label 'Notification Delivery Status' ;
    rdfs:comment 'Status of the most recent notification delivery attempt to the third party.' ;
    rdfs:domain ind:ThirdPartyNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notificationLanguagePreference rdf:type rdf:Property ;
    rdfs:label 'Notification Language Preference' ;
    rdfs:comment 'Preferred language for delivering notifications to the third party (e.g., English, Spanish, Chinese).' ;
    rdfs:domain ind:ThirdPartyNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notificationTriggerType rdf:type rdf:Property ;
    rdfs:label 'Notification Trigger Type' ;
    rdfs:comment 'Type of event or condition that triggers notification to the third party (e.g., pre-disconnection notice, service outage, boil-water advisory, high consumption alert). [ENUM-REF-CANDIDATE: pre_disconnect|service_outage|boil_water_notice|water_quality_alert|high_usage_alert|payment_delinquency|all_service_alerts — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:ThirdPartyNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorityNotificationFlag rdf:type rdf:Property ;
    rdfs:label 'Priority Notification Flag' ;
    rdfs:comment 'Indicates whether this third-party notification arrangement requires priority or expedited notification due to medical, safety, or regulatory reasons.' ;
    rdfs:domain ind:ThirdPartyNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:relationshipToAccountHolder rdf:type rdf:Property ;
    rdfs:label 'Relationship To Account Holder' ;
    rdfs:comment 'Type of relationship the third party has to the account holder, defining their role and authority in the notification arrangement. [ENUM-REF-CANDIDATE: social_service_agency|property_manager|medical_guardian|landlord|family_member|legal_representative|caregiver|other — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:ThirdPartyNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revocationDate rdf:type rdf:Property ;
    rdfs:label 'Revocation Date' ;
    rdfs:comment 'Date on which the account holder or third party revoked the notification arrangement, if applicable.' ;
