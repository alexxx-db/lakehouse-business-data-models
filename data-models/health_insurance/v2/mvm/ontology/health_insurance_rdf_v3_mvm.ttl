ind:authorizedFacilityId rdf:type rdf:Property ;
    rdfs:label 'Authorized Facility Id' ;
    rdfs:comment 'Foreign key linking to provider.facility. Business justification: Authorized service lines specify the facility where care is rendered. linking to provider.facility enables network tier validation, accreditation checks, and facility-level cost reporting for autho' ;
    rdfs:domain ind:AuthServiceLine ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Facility .

ind:authorizationStatus rdf:type rdf:Property ;
    rdfs:label 'Authorization Status' ;
    rdfs:comment 'Current status of the service line within the prior authorization workflow.' ;
