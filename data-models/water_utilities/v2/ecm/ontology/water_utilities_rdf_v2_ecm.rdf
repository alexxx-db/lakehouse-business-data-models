    rdfs:domain ind:Deposit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:depositStatus rdf:type rdf:Property ;
    rdfs:label 'Deposit Status' ;
    rdfs:comment 'Status (held, partially_refunded, fully_refunded, forfeited)' ;
    rdfs:domain ind:WaterUtilities ;
