ind:budgetTransferId rdf:type rdf:Property ;
    rdfs:label 'Budget Transfer Id' ;
    rdfs:comment 'Unique identifier for the budget transfer transaction. Primary key for the budget transfer record.' ;
    rdfs:domain ind:BudgetTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:budgetEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Budget Employee Id' ;
    rdfs:comment 'System user identifier of the person who created this budget transfer record in the system. Part of standard audit trail.' ;
    rdfs:domain ind:BudgetTransfer ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:budgetModifiedByUserEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Budget Modified By User Employee Id' ;
    rdfs:comment 'System user identifier of the person who last modified this budget transfer record. Part of standard audit trail for accountability.' ;
    rdfs:domain ind:BudgetTransfer ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:destinationBudgetLineId rdf:type rdf:Property ;
    rdfs:label 'Destination Budget Line Id' ;
    rdfs:comment 'Identifier of the specific budget line item to which funds are being transferred. Links to the budget line master data.' ;
    rdfs:domain ind:BudgetTransfer ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BudgetLine .

ind:destinationCostCenterId rdf:type rdf:Property ;
    rdfs:label 'Destination Cost Center Id' ;
    rdfs:comment 'Identifier of the cost center, department, or organizational unit to which budget funds are being transferred. Links to the cost center master data.' ;
    rdfs:domain ind:BudgetTransfer ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CostCenter .

ind:destinationGlAccountChartOfAccountsId rdf:type rdf:Property ;
    rdfs:label 'Destination Gl Account Chart Of Accounts Id' ;
    rdfs:comment 'Identifier of the general ledger account to which budget funds are being transferred. Links to the chart of accounts.' ;
    rdfs:domain ind:BudgetTransfer ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ChartOfAccounts .

ind:primaryBudgetChartOfAccountsId rdf:type rdf:Property ;
    rdfs:label 'Primary Budget Chart Of Accounts Id' ;
    rdfs:comment 'Identifier of the general ledger account from which budget funds are being transferred. Links to the chart of accounts.' ;
    rdfs:domain ind:BudgetTransfer ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ChartOfAccounts .

ind:primaryBudgetRequestorEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Budget Requestor Employee Id' ;
    rdfs:comment 'Identifier of the employee who initiated or requested the budget transfer. Links to the employee master data for accountability tracking.' ;
    rdfs:domain ind:BudgetTransfer ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:primaryOriginalTransferBudgetTransferId rdf:type rdf:Property ;
    rdfs:label 'Primary Original Transfer Budget Transfer Id' ;
    rdfs:comment 'If this transfer is a reversal or correction of a previous transfer, this field contains the budget_transfer_id of the original transfer being reversed. Null for original transfers.' ;
    rdfs:domain ind:BudgetTransfer ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BudgetTransfer .

ind:sourceBudgetLineId rdf:type rdf:Property ;
    rdfs:label 'Source Budget Line Id' ;
    rdfs:comment 'Identifier of the specific budget line item from which funds are being transferred. Links to the budget line master data.' ;
    rdfs:domain ind:BudgetTransfer ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BudgetLine .

ind:sourceCostCenterId rdf:type rdf:Property ;
    rdfs:label 'Source Cost Center Id' ;
    rdfs:comment 'Identifier of the cost center, department, or organizational unit from which budget funds are being transferred. Links to the cost center master data.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CostCenter .

ind:approvalLevel rdf:type rdf:Property ;
    rdfs:label 'Approval Level' ;
    rdfs:comment 'The organizational level at which the budget transfer was approved, indicating the authority level required based on transfer amount and type: department_manager, director, vice_president, chief_financial_officer (CFO), or board_of_directors.' ;
    rdfs:domain ind:BudgetTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestorDepartment rdf:type rdf:Property ;
    rdfs:label 'Requestor Department' ;
    rdfs:comment 'Name of the department or organizational unit of the employee who requested the transfer, for organizational analysis and reporting.' ;
    rdfs:domain ind:BudgetTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestorName rdf:type rdf:Property ;
    rdfs:label 'Requestor Name' ;
    rdfs:comment 'Full name of the employee who requested the budget transfer, captured for audit trail and reporting purposes.' ;
    rdfs:domain ind:BudgetTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reversalFlag rdf:type rdf:Property ;
    rdfs:label 'Reversal Flag' ;
    rdfs:comment 'Boolean indicator of whether this budget transfer has been reversed or undone. True if reversed, False if still in effect.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:transferAmount rdf:type rdf:Property ;
    rdfs:label 'Transfer Amount' ;
    rdfs:comment 'The monetary value being transferred from the source budget line to the destination budget line. Always positive; direction is indicated by source/destination fields.' ;
    rdfs:domain ind:BudgetTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:transferDate rdf:type rdf:Property ;
    rdfs:label 'Transfer Date' ;
    rdfs:comment 'The business date when the budget transfer was initiated or became effective. This is the principal business event timestamp for the transaction, distinct from audit timestamps.' ;
    rdfs:domain ind:BudgetTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:transferNumber rdf:type rdf:Property ;
    rdfs:label 'Transfer Number' ;
    rdfs:comment 'Externally-visible unique business identifier for the budget transfer, typically formatted as BT-YYYYNNNN for tracking and audit purposes.' ;
    rdfs:domain ind:BudgetTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transferReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Transfer Reason Description' ;
    rdfs:comment 'Detailed narrative explanation of the business justification for the budget transfer, including context, impact, and supporting rationale. Critical for audit trail and management review.' ;
    rdfs:domain ind:BudgetTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:creditedApInvoiceId rdf:type rdf:Property ;
    rdfs:label 'Credited Ap Invoice Id' ;
    rdfs:comment 'Self-referencing FK on ap_invoice (credited_ap_invoice_id)' ;
    rdfs:domain ind:ApInvoice ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ApInvoice .

ind:primaryApEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Ap Employee Id' ;
    rdfs:comment 'Identifier of the employee who approved this invoice for payment.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:apInvoiceDescription rdf:type rdf:Property ;
    rdfs:label 'Ap Invoice Description' ;
    rdfs:comment 'A free-text description of the goods or services covered by this invoice.' ;
    rdfs:domain ind:ApInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:functionalCurrencyAmount rdf:type rdf:Property ;
    rdfs:label 'Functional Currency Amount' ;
    rdfs:comment 'The total invoice amount converted to the organization\'s functional currency using the exchange rate, for consolidated financial reporting.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:glDate rdf:type rdf:Property ;
    rdfs:label 'Gl Date' ;
    rdfs:comment 'The accounting period date when this invoice is posted to the general ledger.' ;
    rdfs:domain ind:ApInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:holdReasonCode rdf:type rdf:Property ;
    rdfs:label 'Hold Reason Code' ;
    rdfs:comment 'The code indicating why the invoice is on hold (e.g., pricing variance, missing receipt, duplicate invoice, vendor on hold, budget exceeded).' ;
    rdfs:domain ind:ApInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:holdReleasedDate rdf:type rdf:Property ;
    rdfs:label 'Hold Released Date' ;
    rdfs:comment 'The date the hold was released and the invoice was returned to normal processing.' ;
    rdfs:domain ind:ApInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:invoiceAmount rdf:type rdf:Property ;
    rdfs:label 'Invoice Amount' ;
    rdfs:comment 'The gross total amount of the invoice before taxes and freight, representing the base charge for goods or services.' ;
    rdfs:domain ind:ApInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:invoiceCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Invoice Currency Code' ;
    rdfs:comment 'The three-letter ISO 4217 currency code in which the invoice is denominated (e.g., USD, EUR, GBP).' ;
    rdfs:domain ind:ApInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:invoiceDate rdf:type rdf:Property ;
    rdfs:label 'Invoice Date' ;
    rdfs:comment 'The date the vendor issued the invoice. This is the principal business event timestamp for the invoice transaction.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:invoiceSource rdf:type rdf:Property ;
    rdfs:label 'Invoice Source' ;
    rdfs:comment 'The channel through which the invoice was received: manual_entry (keyed by AP clerk), edi (Electronic Data Interchange), email (scanned attachment), ocr (Optical Character Recognition from paper), supplier_portal (vendor self-service portal), or api (system-to-system integration).' ;
    rdfs:domain ind:ApInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:invoiceType rdf:type rdf:Property ;
    rdfs:label 'Invoice Type' ;
    rdfs:comment 'The classification of the invoice transaction: standard invoice for goods/services, credit memo for returns/adjustments, debit memo for additional charges, prepayment for advance payments, expense report for employee reimbursements, or recurring for subscription-based invoices.' ;
    rdfs:domain ind:ApInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Payment Reference Number' ;
    rdfs:comment 'The check number, ACH trace number, wire confirmation number, or other payment transaction identifier.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:poMatchIndicator rdf:type rdf:Property ;
    rdfs:label 'Po Match Indicator' ;
    rdfs:comment 'Boolean flag indicating whether this invoice has been matched to a purchase order (True) or is a non-PO invoice (False).' ;
    rdfs:domain ind:ApInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:taxCode rdf:type rdf:Property ;
    rdfs:label 'Tax Code' ;
    rdfs:comment 'The tax jurisdiction or tax rate code applied to this invoice for sales tax, VAT, or GST calculation.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:voucherNumber rdf:type rdf:Property ;
    rdfs:label 'Voucher Number' ;
    rdfs:comment 'The internal accounting voucher number assigned to this invoice for general ledger posting and audit trail purposes.' ;
    rdfs:domain ind:ApInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:apInvoiceLineId rdf:type rdf:Property ;
    rdfs:label 'Ap Invoice Line Id' ;
    rdfs:comment 'Unique identifier for the accounts payable invoice line item. Primary key for this entity.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ApInvoiceLine .

ind:creditedApInvoiceLineId rdf:type rdf:Property ;
    rdfs:label 'Credited Ap Invoice Line Id' ;
    rdfs:comment 'Self-referencing FK on ap_invoice_line (credited_ap_invoice_line_id)' ;
    rdfs:domain ind:ApInvoiceLine ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ApInvoiceLine .

ind:assetCategory rdf:type rdf:Property ;
    rdfs:label 'Asset Category' ;
    rdfs:comment 'Asset category or class for capital items. Determines depreciation method, useful life, and financial statement classification for capitalized purchases.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assetFlag rdf:type rdf:Property ;
    rdfs:label 'Asset Flag' ;
    rdfs:comment 'Indicates whether this line item represents a capital asset purchase that should be capitalized rather than expensed. Triggers asset tracking and depreciation processes.' ;
    rdfs:domain ind:ApInvoiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:holdFlag rdf:type rdf:Property ;
    rdfs:label 'Hold Flag' ;
    rdfs:comment 'Indicates whether this line item is on hold and blocked from payment. Used to prevent payment pending resolution of issues or additional approvals.' ;
    rdfs:domain ind:ApInvoiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:itemCode rdf:type rdf:Property ;
    rdfs:label 'Item Code' ;
    rdfs:comment 'Vendor or internal catalog item code identifying the specific product or service being purchased. Used for inventory tracking and spend analysis.' ;
    rdfs:domain ind:ApInvoiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lineAmount rdf:type rdf:Property ;
    rdfs:label 'Line Amount' ;
    rdfs:comment 'Total amount for this line item before taxes and adjustments. Typically calculated as quantity multiplied by unit price.' ;
    rdfs:domain ind:ApInvoiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:matchExceptionReason rdf:type rdf:Property ;
    rdfs:label 'Match Exception Reason' ;
    rdfs:comment 'Reason code or description for match exceptions or variances. Documents why the invoice line does not match the PO or receipt (e.g., price variance, quantity variance).' ;
    rdfs:domain ind:ApInvoiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:servicePeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Service Period End Date' ;
    rdfs:comment 'End date of the service period covered by this line item. Used with start date to determine expense allocation across accounting periods for prepaid services.' ;
    rdfs:domain ind:ApInvoiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:servicePeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Service Period Start Date' ;
    rdfs:comment 'Start date of the service period covered by this line item. Used for service-based invoices to determine the period of benefit and expense recognition timing.' ;
    rdfs:domain ind:ApInvoiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:totalLineAmount rdf:type rdf:Property ;
    rdfs:label 'Total Line Amount' ;
    rdfs:comment 'Final total amount for this line item including taxes and discounts. Represents the net amount payable to the vendor for this line.' ;
    rdfs:domain ind:ApInvoiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:apPaymentId rdf:type rdf:Property ;
    rdfs:label 'Ap Payment Id' ;
    rdfs:comment 'Unique identifier for the accounts payable payment transaction. Primary key.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ApPayment .

ind:paymentBatchId rdf:type rdf:Property ;
    rdfs:label 'Payment Batch Id' ;
    rdfs:comment 'Identifier of the payment batch or payment run in which this payment was processed. Used for grouping payments processed together.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PaymentBatch .

ind:primaryApVendorBankAccountId rdf:type rdf:Property ;
    rdfs:label 'Primary Ap Vendor Bank Account Id' ;
    rdfs:comment 'Identifier of the vendor bank account to which this payment was sent. Links to vendor banking information.' ;
    rdfs:domain ind:ApPayment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BankAccount .

ind:tertiaryApModifiedByUserEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Tertiary Ap Modified By User Employee Id' ;
    rdfs:comment 'Identifier of the user who last modified this payment record. Links to user or employee master. Audit trail field.' ;
    rdfs:domain ind:ApPayment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:voidedApPaymentId rdf:type rdf:Property ;
    rdfs:label 'Voided Ap Payment Id' ;
    rdfs:comment 'Self-referencing FK on ap_payment (voided_ap_payment_id)' ;
    rdfs:domain ind:ApPayment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ApPayment .

ind:achTraceNumber rdf:type rdf:Property ;
    rdfs:label 'Ach Trace Number' ;
    rdfs:comment 'ACH trace number assigned by the bank for ACH/EFT payments. Used for tracking and reconciliation. Null for non-ACH payment methods.' ;
    rdfs:domain ind:ApPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:checkNumber rdf:type rdf:Property ;
    rdfs:label 'Check Number' ;
    rdfs:comment 'Physical check number if payment method is check. Null for electronic payment methods.' ;
    rdfs:domain ind:ApPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clearedDate rdf:type rdf:Property ;
    rdfs:label 'Cleared Date' ;
    rdfs:comment 'Date on which the payment cleared the bank and funds were successfully transferred to the vendor. Null if payment has not yet cleared.' ;
    rdfs:domain ind:ApPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:discountTakenAmount rdf:type rdf:Property ;
    rdfs:label 'Discount Taken Amount' ;
    rdfs:comment 'Total early payment discount amount taken on this payment if vendor offered discount terms (e.g., 2% discount for payment within 10 days).' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentDescription rdf:type rdf:Property ;
    rdfs:label 'Payment Description' ;
    rdfs:comment 'Free-text description or memo field providing additional context about the payment purpose or contents.' ;
    rdfs:domain ind:ApPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentNumber rdf:type rdf:Property ;
    rdfs:label 'Payment Number' ;
    rdfs:comment 'Business-facing unique payment identifier or check number assigned by the financial system. Used for external reference and reconciliation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentPriority rdf:type rdf:Property ;
    rdfs:label 'Payment Priority' ;
    rdfs:comment 'Priority level assigned to the payment for processing. Values: standard (normal processing), urgent (high priority), expedited (rush processing).' ;
    rdfs:domain ind:ApPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentReconciliationStatus rdf:type rdf:Property ;
    rdfs:label 'Payment Reconciliation Status' ;
    rdfs:comment 'Bank reconciliation status of the payment. Values: unreconciled (not yet matched to bank statement), reconciled (matched and cleared), exception (discrepancy identified).' ;
    rdfs:domain ind:ApPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentSourceSystem rdf:type rdf:Property ;
    rdfs:label 'Payment Source System' ;
    rdfs:comment 'Name or identifier of the source financial system that originated this payment record (e.g., SAP S/4HANA FI, Epic Resolute PB).' ;
    rdfs:domain ind:ApPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentType rdf:type rdf:Property ;
    rdfs:label 'Payment Type' ;
    rdfs:comment 'Classification of the payment transaction type. Values: invoice_payment (standard vendor invoice payment), prepayment (advance payment), refund (return of funds), expense_reimbursement (employee expense reimbursement).' ;
    rdfs:domain ind:ApPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reconciledDate rdf:type rdf:Property ;
    rdfs:label 'Reconciled Date' ;
    rdfs:comment 'Date on which the payment was reconciled against the bank statement. Null if not yet reconciled.' ;
    rdfs:domain ind:ApPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:remittanceAdviceReference rdf:type rdf:Property ;
    rdfs:label 'Remittance Advice Reference' ;
    rdfs:comment 'Reference number or identifier for the remittance advice document sent to the vendor detailing which invoices this payment settles.' ;
    rdfs:domain ind:ApPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wireConfirmationNumber rdf:type rdf:Property ;
    rdfs:label 'Wire Confirmation Number' ;
    rdfs:comment 'Bank confirmation or reference number for wire transfer payments. Null for non-wire payment methods.' ;
    rdfs:domain ind:ApPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:parentArAccountId rdf:type rdf:Property ;
    rdfs:label 'Parent Ar Account Id' ;
    rdfs:comment 'Self-referencing FK on ar_account (parent_ar_account_id)' ;
    rdfs:domain ind:ArAccount ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ArAccount .

ind:primaryArEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Ar Employee Id' ;
    rdfs:comment 'Identifier of the internal staff member or external collection agency assigned to manage collection activities for this account. Used for workload distribution, performance tracking, and accountability.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:tertiaryArLastModifiedByUserEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Tertiary Ar Last Modified By User Employee Id' ;
    rdfs:comment 'The system user identifier of the person or process that most recently modified this AR account record. Used for accountability, audit trail, and change management.' ;
    rdfs:domain ind:ArAccount ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:agingBucket rdf:type rdf:Property ;
    rdfs:label 'Aging Bucket' ;
    rdfs:comment 'Categorization of the receivable based on the number of days outstanding since the original invoice or billing date. Used for aging analysis, collection prioritization, and allowance for doubtful accounts estimation. Current indicates not yet due; subsequent buckets indicate days past due.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collectionAgencyName rdf:type rdf:Property ;
    rdfs:label 'Collection Agency Name' ;
    rdfs:comment 'Name of the external third-party collection agency to which this account has been referred, if applicable. Null if account is managed internally or not yet in collections.' ;
    rdfs:domain ind:ArAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:currentBalance rdf:type rdf:Property ;
    rdfs:label 'Current Balance' ;
    rdfs:comment 'The outstanding receivable balance as of the current date. Reflects original balance minus payments received, plus any adjustments, interest, or fees. This is the amount currently owed. Denominated in USD unless otherwise specified in currency_code.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:daysOutstanding rdf:type rdf:Property ;
    rdfs:label 'Days Outstanding' ;
    rdfs:comment 'The number of calendar days that have elapsed since the original invoice or billing date. Used to calculate aging bucket and assess collection risk. Key metric for Days Sales Outstanding (DSO) reporting.' ;
    rdfs:domain ind:ArAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:debtorName rdf:type rdf:Property ;
    rdfs:label 'Debtor Name' ;
    rdfs:comment 'The legal or business name of the entity or individual that owes payment on this receivable account. May be a payer organization, self-pay patient, affiliated entity, grantor, or other debtor.' ;
    rdfs:domain ind:ArAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:debtorType rdf:type rdf:Property ;
    rdfs:label 'Debtor Type' ;
    rdfs:comment 'Categorical classification of the debtor entity. Segments debtors into commercial insurance payers, government payers (Medicare, Medicaid), self-pay individuals, affiliated healthcare entities, grant-making organizations, corporate tenants, and other categories for reporting and collection strategy purposes. [ENUM-REF-CANDIDATE: commercial_payer|government_payer|self_pay_individual|affiliated_entity|grant_organization|corporate_tenant|other — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:ArAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disputeDate rdf:type rdf:Property ;
    rdfs:label 'Dispute Date' ;
    rdfs:comment 'The date on which the debtor formally notified the organization of the dispute. Used to track dispute aging and ensure timely resolution per regulatory requirements.' ;
    rdfs:domain ind:ArAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:disputeFlag rdf:type rdf:Property ;
    rdfs:label 'Dispute Flag' ;
    rdfs:comment 'Boolean indicator of whether the debtor has formally disputed the receivable amount or validity. True indicates an active dispute; false indicates no dispute. Disputed accounts typically require special handling and may be placed on hold pending resolution.' ;
    rdfs:domain ind:ArAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:interestRate rdf:type rdf:Property ;
    rdfs:label 'Interest Rate' ;
    rdfs:comment 'The annual interest rate applied to overdue balances on this account, expressed as a decimal (e.g., 0.0500 for 5%). Null if no interest is charged. Used to calculate interest charges on past-due amounts per contractual terms or state regulations.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lastActivityDate rdf:type rdf:Property ;
    rdfs:label 'Last Activity Date' ;
    rdfs:comment 'The most recent date on which any activity occurred on this account, including payments received, adjustments posted, collection calls made, correspondence sent, or status changes. Used to identify dormant accounts and prioritize follow-up.' ;
    rdfs:domain ind:ArAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:legalActionDate rdf:type rdf:Property ;
    rdfs:label 'Legal Action Date' ;
    rdfs:comment 'The date on which legal action was initiated for collection of this receivable. Null if no legal action has been taken. Used for legal case tracking and statute of limitations monitoring.' ;
    rdfs:domain ind:ArAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:legalActionFlag rdf:type rdf:Property ;
    rdfs:label 'Legal Action Flag' ;
    rdfs:comment 'Boolean indicator of whether legal action (lawsuit, lien, garnishment) has been initiated to collect this receivable. True indicates active legal proceedings; false indicates no legal action. Used for legal department coordination and risk management.' ;
    rdfs:domain ind:ArAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:originalBalance rdf:type rdf:Property ;
    rdfs:label 'Original Balance' ;
    rdfs:comment 'The initial receivable amount established when the account was opened. Represents the total amount originally owed before any payments, adjustments, or write-offs. Denominated in USD unless otherwise specified in currency_code.' ;
    rdfs:domain ind:ArAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:settlementAcceptedFlag rdf:type rdf:Property ;
    rdfs:label 'Settlement Accepted Flag' ;
    rdfs:comment 'Boolean indicator of whether the debtor has accepted a settlement offer. True indicates acceptance; false indicates no acceptance or no offer made. Used to track settlement negotiations and finalize account closure.' ;
    rdfs:domain ind:ArAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:settlementOfferAmount rdf:type rdf:Property ;
    rdfs:label 'Settlement Offer Amount' ;
    rdfs:comment 'The reduced amount offered to the debtor as a settlement to close the account, if applicable. Typically less than current_balance. Null if no settlement has been offered. Denominated in the account\'s currency_code.' ;
    rdfs:domain ind:ArAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalAdjustments rdf:type rdf:Property ;
    rdfs:label 'Total Adjustments' ;
    rdfs:comment 'The cumulative sum of all adjustments (positive or negative) applied to this account, including billing corrections, contractual allowances, courtesy adjustments, and dispute resolutions. Denominated in the account\'s currency_code.' ;
    rdfs:domain ind:ArAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalFeesAssessed rdf:type rdf:Property ;
    rdfs:label 'Total Fees Assessed' ;
    rdfs:comment 'The cumulative amount of late fees, collection fees, administrative fees, or other charges assessed on this account. Included in the current_balance. Denominated in the account\'s currency_code.' ;
    rdfs:domain ind:ArAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalInterestAccrued rdf:type rdf:Property ;
    rdfs:label 'Total Interest Accrued' ;
    rdfs:comment 'The cumulative amount of interest that has accrued on this account due to late payment. Included in the current_balance. Denominated in the account\'s currency_code.' ;
    rdfs:domain ind:ArAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalPaymentsReceived rdf:type rdf:Property ;
    rdfs:label 'Total Payments Received' ;
    rdfs:comment 'The cumulative sum of all payments received on this account since inception. Used to calculate current_balance and assess payment history. Denominated in the account\'s currency_code.' ;
    rdfs:domain ind:ArAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:writeOffReason rdf:type rdf:Property ;
    rdfs:label 'Write Off Reason' ;
    rdfs:comment 'Explanation or categorization of why the receivable was written off, such as debtor bankruptcy, inability to locate debtor, cost of collection exceeds balance, statute of limitations expired, or management decision. Used for root cause analysis and process improvement.' ;
    rdfs:domain ind:ArAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:arAppliedToTransactionId rdf:type rdf:Property ;
    rdfs:label 'Ar Applied To Transaction Id' ;
    rdfs:comment 'Reference to the charge transaction that this payment, credit memo, or adjustment is applied against. Enables payment application tracking and open item reconciliation.' ;
    rdfs:domain ind:ArTransaction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ArTransaction .

ind:primaryReversedTransactionArTransactionId rdf:type rdf:Property ;
    rdfs:label 'Primary Reversed Transaction Ar Transaction Id' ;
    rdfs:comment 'Reference to the original AR transaction that this entry reverses. Null for non-reversal transactions. Creates audit trail for transaction corrections.' ;
    rdfs:domain ind:ArTransaction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ArTransaction .

ind:transactionBatchId rdf:type rdf:Property ;
    rdfs:label 'Transaction Batch Id' ;
    rdfs:comment 'Identifier for the batch or group of transactions processed together. Used for batch reconciliation and control totals validation.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TransactionBatch .

ind:adjustmentReasonCode rdf:type rdf:Property ;
    rdfs:label 'Adjustment Reason Code' ;
    rdfs:comment 'Standardized code indicating the business reason for adjustment transactions: billing error, pricing correction, contractual adjustment, goodwill credit. Null for non-adjustment transactions.' ;
    rdfs:domain ind:ArTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:functionalAmount rdf:type rdf:Property ;
    rdfs:label 'Functional Amount' ;
    rdfs:comment 'The transaction amount converted to the organization\'s functional reporting currency (typically USD) using the exchange rate at transaction date. Used for consolidated financial reporting.' ;
    rdfs:domain ind:ArTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:referenceDocumentNumber rdf:type rdf:Property ;
    rdfs:label 'Reference Document Number' ;
    rdfs:comment 'External reference number linking this AR transaction to source documents such as invoices, payment receipts, credit memos, or adjustment authorizations.' ;
    rdfs:domain ind:ArTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemTransactionReference rdf:type rdf:Property ;
    rdfs:label 'Source System Transaction Reference' ;
    rdfs:comment 'The unique transaction identifier from the source system. Used for data lineage tracking and reconciliation back to operational systems.' ;
    rdfs:domain ind:ArTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transactionDescription rdf:type rdf:Property ;
    rdfs:label 'Transaction Description' ;
    rdfs:comment 'Free-text business description of the AR transaction providing context about the nature of the charge, payment, or adjustment.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:writeOffReasonCode rdf:type rdf:Property ;
    rdfs:label 'Write Off Reason Code' ;
    rdfs:comment 'Standardized code indicating the business reason for write-off transactions: bad debt, small balance, bankruptcy, deceased, statute of limitations. Null for non-write-off transactions.' ;
    rdfs:domain ind:ArTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:parentFixedAssetId rdf:type rdf:Property ;
    rdfs:label 'Parent Fixed Asset Id' ;
    rdfs:comment 'Self-referencing FK on fixed_asset (parent_fixed_asset_id)' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FixedAsset .

ind:accumulatedDepreciation rdf:type rdf:Property ;
    rdfs:label 'Accumulated Depreciation' ;
    rdfs:comment 'Total depreciation expense recognized to date since the asset was placed in service. Contra-asset account that reduces the gross book value. Recorded in USD.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:acquisitionDate rdf:type rdf:Property ;
    rdfs:label 'Acquisition Date' ;
    rdfs:comment 'Date on which the healthcare organization legally acquired ownership or control of the fixed asset through purchase, donation, or construction completion.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:assetDescription rdf:type rdf:Property ;
    rdfs:label 'Asset Description' ;
    rdfs:comment 'Detailed description of the fixed asset including specifications, model information, and distinguishing characteristics.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assetSubcategory rdf:type rdf:Property ;
    rdfs:label 'Asset Subcategory' ;
    rdfs:comment 'Secondary classification providing additional granularity within the asset category (e.g., MRI scanner, CT scanner, ultrasound machine for medical equipment category).' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assetTagNumber rdf:type rdf:Property ;
    rdfs:label 'Asset Tag Number' ;
    rdfs:comment 'Unique physical identifier affixed to the asset for tracking and inventory purposes. Externally visible barcode or RFID tag number used in physical audits.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capitalizationThresholdMet rdf:type rdf:Property ;
    rdfs:label 'Capitalization Threshold Met' ;
    rdfs:comment 'Flag indicating whether the asset acquisition cost met or exceeded the organization\'s capitalization threshold policy. True indicates the asset was properly capitalized; False would indicate an expense treatment.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:disposalProceeds rdf:type rdf:Property ;
    rdfs:label 'Disposal Proceeds' ;
    rdfs:comment 'Cash or fair value of consideration received from disposal of the fixed asset. Used to calculate gain or loss on disposal. Recorded in USD.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fdaRegulatedIndicator rdf:type rdf:Property ;
    rdfs:label 'Fda Regulated Indicator' ;
    rdfs:comment 'Flag indicating whether the fixed asset is a medical device or equipment subject to FDA regulatory oversight and compliance requirements. True for FDA-regulated medical equipment.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastPhysicalInventoryDate rdf:type rdf:Property ;
    rdfs:label 'Last Physical Inventory Date' ;
    rdfs:comment 'Date of the most recent physical inventory audit or verification confirming the existence and condition of the fixed asset.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:leaseEndDate rdf:type rdf:Property ;
    rdfs:label 'Lease End Date' ;
    rdfs:comment 'Date on which the lease agreement for the fixed asset expires. Null for owned assets. Used for lease renewal planning and return logistics.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:leaseIndicator rdf:type rdf:Property ;
    rdfs:label 'Lease Indicator' ;
    rdfs:comment 'Flag indicating whether the fixed asset is leased (True) or owned (False). Determines accounting treatment under ASC 842 lease accounting standards.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:leaseType rdf:type rdf:Property ;
    rdfs:label 'Lease Type' ;
    rdfs:comment 'Classification of the lease agreement if the asset is leased. Operating lease transfers use rights; finance/capital lease transfers substantially all risks and rewards of ownership. Not applicable for owned assets.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maintenanceSchedule rdf:type rdf:Property ;
    rdfs:label 'Maintenance Schedule' ;
    rdfs:comment 'Frequency of scheduled preventive maintenance required for the fixed asset to ensure safe operation and regulatory compliance. Critical for medical equipment and life safety systems. [ENUM-REF-CANDIDATE: daily|weekly|monthly|quarterly|semi_annual|annual|as_needed — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:netBookValue rdf:type rdf:Property ;
    rdfs:label 'Net Book Value' ;
    rdfs:comment 'Current carrying value of the fixed asset calculated as acquisition cost minus accumulated depreciation. Represents the undepreciated balance on the balance sheet. Recorded in USD.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:physicalLocation rdf:type rdf:Property ;
    rdfs:label 'Physical Location' ;
    rdfs:comment 'Current physical location of the fixed asset including facility name, building, floor, room number, or department where the asset is deployed and in use.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:placedInServiceDate rdf:type rdf:Property ;
    rdfs:label 'Placed In Service Date' ;
    rdfs:comment 'Date on which the fixed asset was ready and available for its intended use and depreciation began. May differ from acquisition date for assets requiring installation or construction.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:purchaseOrderNumber rdf:type rdf:Property ;
    rdfs:label 'Purchase Order Number' ;
    rdfs:comment 'Purchase order number under which the fixed asset was procured. Links the asset to the original procurement transaction and vendor contract.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:salvageValue rdf:type rdf:Property ;
    rdfs:label 'Salvage Value' ;
    rdfs:comment 'Estimated residual value of the fixed asset at the end of its useful life. Amount expected to be recovered through sale or disposal. Recorded in USD.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:usefulLifeYears rdf:type rdf:Property ;
    rdfs:label 'Useful Life Years' ;
    rdfs:comment 'Estimated number of years the fixed asset is expected to provide economic benefit to the healthcare organization. Used to calculate depreciation expense.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:depreciationScheduleId rdf:type rdf:Property ;
    rdfs:label 'Depreciation Schedule Id' ;
    rdfs:comment 'Unique identifier for the depreciation schedule entry. Primary key for this transactional record of periodic depreciation calculation and posting.' ;
    rdfs:domain ind:DepreciationSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:depreciationRunId rdf:type rdf:Property ;
    rdfs:label 'Depreciation Run Id' ;
    rdfs:comment 'Reference to the batch depreciation calculation run that generated this entry. Links all depreciation entries processed together.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DepreciationRun .

ind:priorDepreciationScheduleId rdf:type rdf:Property ;
    rdfs:label 'Prior Depreciation Schedule Id' ;
    rdfs:comment 'Self-referencing FK on depreciation_schedule (prior_depreciation_schedule_id)' ;
    rdfs:domain ind:DepreciationSchedule ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DepreciationSchedule .

ind:accumulatedDepreciationBalance rdf:type rdf:Property ;
    rdfs:label 'Accumulated Depreciation Balance' ;
    rdfs:comment 'The cumulative total of all depreciation expense recognized on this asset from acquisition through the current period. Contra-asset account balance.' ;
    rdfs:domain ind:DepreciationSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:accumulatedDepreciationGlAccount rdf:type rdf:Property ;
    rdfs:label 'Accumulated Depreciation Gl Account' ;
    rdfs:comment 'The general ledger account code credited for accumulated depreciation. Contra-asset account that offsets the fixed asset account.' ;
    rdfs:domain ind:DepreciationSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:adjustmentFlag rdf:type rdf:Property ;
    rdfs:label 'Adjustment Flag' ;
    rdfs:comment 'Indicates whether this entry represents an adjustment to a previously posted depreciation calculation. True if adjustment, False if original entry.' ;
    rdfs:domain ind:DepreciationSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:adjustmentReason rdf:type rdf:Property ;
    rdfs:label 'Adjustment Reason' ;
    rdfs:comment 'The business reason for the depreciation adjustment, such as asset revaluation, useful life change, or error correction. Null if not an adjustment.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:beginningNetBookValue rdf:type rdf:Property ;
    rdfs:label 'Beginning Net Book Value' ;
    rdfs:comment 'The net book value of the asset at the beginning of the depreciation period. Calculated as original cost minus accumulated depreciation from prior periods.' ;
    rdfs:domain ind:DepreciationSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bookTaxDifference rdf:type rdf:Property ;
    rdfs:label 'Book Tax Difference' ;
    rdfs:comment 'The difference between book depreciation expense and tax depreciation amount for this period. Used for deferred tax calculations.' ;
    rdfs:domain ind:DepreciationSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:depreciationDate rdf:type rdf:Property ;
    rdfs:label 'Depreciation Date' ;
    rdfs:comment 'The specific date on which this depreciation calculation was performed and recognized. Typically the last day of the fiscal period.' ;
    rdfs:domain ind:DepreciationSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:depreciationExpenseAmount rdf:type rdf:Property ;
    rdfs:label 'Depreciation Expense Amount' ;
    rdfs:comment 'The depreciation expense amount calculated and recognized for this period. This amount is debited to the depreciation expense account.' ;
    rdfs:domain ind:DepreciationSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:endingNetBookValue rdf:type rdf:Property ;
    rdfs:label 'Ending Net Book Value' ;
    rdfs:comment 'The net book value of the asset at the end of the depreciation period. Calculated as beginning net book value minus current period depreciation expense.' ;
    rdfs:domain ind:DepreciationSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:impairmentAdjustmentAmount rdf:type rdf:Property ;
    rdfs:label 'Impairment Adjustment Amount' ;
    rdfs:comment 'Any impairment loss recognized in this period that reduces the carrying value of the asset below its recoverable amount. Zero if no impairment occurred.' ;
    rdfs:domain ind:DepreciationSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:postedBy rdf:type rdf:Property ;
    rdfs:label 'Posted By' ;
    rdfs:comment 'The user ID or name of the person who posted this depreciation entry to the general ledger. Supports audit trail and accountability.' ;
    rdfs:domain ind:DepreciationSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postedDate rdf:type rdf:Property ;
    rdfs:label 'Posted Date' ;
    rdfs:comment 'The date on which this depreciation entry was posted to the general ledger. May differ from the depreciation date for timing reasons.' ;
    rdfs:domain ind:DepreciationSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:taxDepreciationAmount rdf:type rdf:Property ;
    rdfs:label 'Tax Depreciation Amount' ;
    rdfs:comment 'The depreciation amount calculated for tax reporting purposes, which may differ from book depreciation due to tax regulations such as MACRS.' ;
    rdfs:domain ind:DepreciationSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:usefulLifeRemainingMonths rdf:type rdf:Property ;
    rdfs:label 'Useful Life Remaining Months' ;
    rdfs:comment 'The number of months of useful life remaining for the asset after this depreciation period. Used for forecasting future depreciation.' ;
    rdfs:domain ind:DepreciationSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:capitalEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Capital Employee Id' ;
    rdfs:comment 'Identifier of the user who created this capital project record. Links to the employee or user record for audit purposes.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:capitalModifiedByEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Capital Modified By Employee Id' ;
    rdfs:comment 'Identifier of the user who last modified this capital project record. Links to the employee or user record for audit purposes.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:parentCapitalProjectId rdf:type rdf:Property ;
    rdfs:label 'Parent Capital Project Id' ;
    rdfs:comment 'Self-referencing FK on capital_project (parent_capital_project_id)' ;
    rdfs:domain ind:CapitalProject ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CapitalProject .

ind:primaryCapitalEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Capital Employee Id' ;
    rdfs:comment 'Identifier of the employee serving as project manager, responsible for day-to-day execution, schedule, and deliverables.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:approvedCapitalBudget rdf:type rdf:Property ;
    rdfs:label 'Approved Capital Budget' ;
    rdfs:comment 'Total capital budget amount approved by the board or authorized approver for this project. Represents the spending authority ceiling.' ;
    rdfs:domain ind:CapitalProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bondIssueNumber rdf:type rdf:Property ;
    rdfs:label 'Bond Issue Number' ;
    rdfs:comment 'Bond issue identifier if this project is funded through bond financing. Links to the bond issuance record for debt service tracking.' ;
    rdfs:domain ind:CapitalProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capitalizationStatus rdf:type rdf:Property ;
    rdfs:label 'Capitalization Status' ;
    rdfs:comment 'Accounting treatment status for project costs: not_capitalized (project not yet eligible), in_progress (costs accumulating in construction-in-progress), capitalized (asset placed in service and capitalized), or expensed (costs expensed rather than capitalized).' ;
    rdfs:domain ind:CapitalProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expectedAnnualRevenue rdf:type rdf:Property ;
    rdfs:label 'Expected Annual Revenue' ;
    rdfs:comment 'Projected annual revenue to be generated by this capital project once operational. Used for return on investment analysis.' ;
    rdfs:domain ind:CapitalProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:expectedAnnualSavings rdf:type rdf:Property ;
    rdfs:label 'Expected Annual Savings' ;
    rdfs:comment 'Projected annual cost savings or expense reduction resulting from this capital project (e.g., energy efficiency, labor reduction, supply chain optimization).' ;
    rdfs:domain ind:CapitalProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isRegulatoryRequired rdf:type rdf:Property ;
    rdfs:label 'Is Regulatory Required' ;
    rdfs:comment 'Indicates whether this capital project is required to meet regulatory compliance, accreditation standards, or legal mandates (e.g., Joint Commission, CMS Conditions of Participation, OSHA, fire code).' ;
    rdfs:domain ind:CapitalProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:projectDescription rdf:type rdf:Property ;
    rdfs:label 'Project Description' ;
    rdfs:comment 'Detailed narrative description of the capital project scope, objectives, and deliverables. Provides context for stakeholders and auditors.' ;
    rdfs:domain ind:CapitalProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:projectName rdf:type rdf:Property ;
    rdfs:label 'Project Name' ;
    rdfs:comment 'Descriptive name of the capital project for identification and reporting purposes.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:projectNotes rdf:type rdf:Property ;
    rdfs:label 'Project Notes' ;
    rdfs:comment 'Free-text field for additional notes, comments, or context about the capital project. Used for project history and knowledge transfer.' ;
    rdfs:domain ind:CapitalProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:projectNumber rdf:type rdf:Property ;
    rdfs:label 'Project Number' ;
    rdfs:comment 'Business identifier for the capital project, used for external reference and reporting. Unique across all capital projects.' ;
    rdfs:domain ind:CapitalProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:projectPhase rdf:type rdf:Property ;
    rdfs:label 'Project Phase' ;
    rdfs:comment 'Current phase of the project lifecycle: initiation (concept development), planning (detailed planning), design (architectural/engineering design), procurement (vendor selection), construction (build/implementation), testing (commissioning), or closeout (final documentation). [ENUM-REF-CANDIDATE: initiation|planning|design|procurement|construction|testing|closeout — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:projectPriority rdf:type rdf:Property ;
    rdfs:label 'Project Priority' ;
    rdfs:comment 'Strategic priority level assigned to this capital project for resource allocation and scheduling: critical (immediate need), high (near-term priority), medium (planned investment), or low (deferred opportunity).' ;
    rdfs:domain ind:CapitalProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:projectStartDate rdf:type rdf:Property ;
    rdfs:label 'Project Start Date' ;
    rdfs:comment 'Date when the capital project officially commenced or is scheduled to commence. Represents the beginning of the project timeline.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:projectStatus rdf:type rdf:Property ;
    rdfs:label 'Project Status' ;
    rdfs:comment 'Current lifecycle status of the capital project: planning (initial scoping), approved (budget authorized), in progress (active construction or implementation), on hold (temporarily suspended), completed (project closed), or cancelled (project terminated).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:projectType rdf:type rdf:Property ;
    rdfs:label 'Project Type' ;
    rdfs:comment 'Classification of the capital project by nature of investment: construction (new building), renovation (facility upgrade), equipment acquisition (medical or operational equipment), IT implementation (technology systems), leasehold improvement (tenant improvements), or infrastructure (utilities, parking, grounds).' ;
    rdfs:domain ind:CapitalProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:projectedCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Projected Completion Date' ;
    rdfs:comment 'Planned or forecasted date for project completion. Updated as project progresses and schedule changes occur.' ;
    rdfs:domain ind:CapitalProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:strategicInitiative rdf:type rdf:Property ;
    rdfs:label 'Strategic Initiative' ;
    rdfs:comment 'Name or identifier of the strategic initiative or program that this capital project supports. Links project to organizational strategy.' ;
    rdfs:domain ind:CapitalProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalActualCosts rdf:type rdf:Property ;
    rdfs:label 'Total Actual Costs' ;
    rdfs:comment 'Cumulative amount of actual expenditures incurred and recorded against this project. Represents cash outflows and accrued expenses.' ;
    rdfs:domain ind:CapitalProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalCommittedCosts rdf:type rdf:Property ;
    rdfs:label 'Total Committed Costs' ;
    rdfs:comment 'Cumulative amount of costs committed through purchase orders, contracts, and other binding obligations for this project. Represents encumbered funds.' ;
    rdfs:domain ind:CapitalProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:variancePercent rdf:type rdf:Property ;
    rdfs:label 'Variance Percent' ;
    rdfs:comment 'Current budget variance expressed as a percentage of approved budget. Used for variance threshold monitoring and escalation.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:capitalExpenditureId rdf:type rdf:Property ;
    rdfs:label 'Capital Expenditure Id' ;
    rdfs:comment 'Unique identifier for the capital expenditure transaction record.' ;
    rdfs:domain ind:CapitalExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reversedCapitalExpenditureId rdf:type rdf:Property ;
    rdfs:label 'Reversed Capital Expenditure Id' ;
    rdfs:comment 'Self-referencing FK on capital_expenditure (reversed_capital_expenditure_id)' ;
    rdfs:domain ind:CapitalExpenditure ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CapitalExpenditure .

ind:assetPlacedInServiceFlag rdf:type rdf:Property ;
    rdfs:label 'Asset Placed In Service Flag' ;
    rdfs:comment 'Indicates whether the capital asset associated with this expenditure has been placed into active service and is ready for depreciation.' ;
    rdfs:domain ind:CapitalExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:capitalizationEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Capitalization Eligible Flag' ;
    rdfs:comment 'Indicates whether this expenditure meets the criteria for capitalization as a fixed asset per GAAP standards.' ;
    rdfs:domain ind:CapitalExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cipCategory rdf:type rdf:Property ;
    rdfs:label 'Cip Category' ;
    rdfs:comment 'Classification of the capital expenditure within the Construction In Progress accounting category, used for tracking costs before capitalization.' ;
    rdfs:domain ind:CapitalExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expenditureAmount rdf:type rdf:Property ;
    rdfs:label 'Expenditure Amount' ;
    rdfs:comment 'Monetary value of the capital expenditure transaction in the specified currency.' ;
    rdfs:domain ind:CapitalExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:expenditureDate rdf:type rdf:Property ;
    rdfs:label 'Expenditure Date' ;
    rdfs:comment 'The date on which the capital expenditure transaction occurred or was recorded.' ;
    rdfs:domain ind:CapitalExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:expenditureDescription rdf:type rdf:Property ;
    rdfs:label 'Expenditure Description' ;
    rdfs:comment 'Detailed narrative description of the capital expenditure transaction, including purpose and justification.' ;
    rdfs:domain ind:CapitalExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expenditureNumber rdf:type rdf:Property ;
    rdfs:label 'Expenditure Number' ;
    rdfs:comment 'Business identifier for the capital expenditure transaction, used for tracking and reference.' ;
    rdfs:domain ind:CapitalExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expenditureStatus rdf:type rdf:Property ;
    rdfs:label 'Expenditure Status' ;
    rdfs:comment 'Current lifecycle status of the capital expenditure transaction in the financial system.' ;
    rdfs:domain ind:CapitalExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expenditureType rdf:type rdf:Property ;
    rdfs:label 'Expenditure Type' ;
    rdfs:comment 'Classification of the capital expenditure transaction indicating the nature of the cost incurred.' ;
    rdfs:domain ind:CapitalExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:internalLaborFlag rdf:type rdf:Property ;
    rdfs:label 'Internal Labor Flag' ;
    rdfs:comment 'Indicates whether this expenditure represents internal labor costs allocated to the capital project.' ;
    rdfs:domain ind:CapitalExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:laborRate rdf:type rdf:Property ;
    rdfs:label 'Labor Rate' ;
    rdfs:comment 'Hourly rate applied to internal labor hours for calculating the labor cost component of this capital expenditure.' ;
    rdfs:domain ind:CapitalExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:costAllocationId rdf:type rdf:Property ;
    rdfs:label 'Cost Allocation Id' ;
    rdfs:comment 'Unique identifier for the cost allocation transaction record.' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:allocationMethodId rdf:type rdf:Property ;
    rdfs:label 'Allocation Method Id' ;
    rdfs:comment 'FK to finance.allocation_method' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AllocationMethod .

ind:allocationRunId rdf:type rdf:Property ;
    rdfs:label 'Allocation Run Id' ;
    rdfs:comment 'Identifier for the batch allocation run that generated this allocation record. Groups all allocations processed in a single execution cycle.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AllocationRun .

ind:primaryCostEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Cost Employee Id' ;
    rdfs:comment 'Reference to the finance manager or controller who approved this allocation for posting.' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:primaryOriginalAllocationCostAllocationId rdf:type rdf:Property ;
    rdfs:label 'Primary Original Allocation Cost Allocation Id' ;
    rdfs:comment 'Reference to the original cost allocation record that this entry reverses or corrects. Null if this is not a reversal.' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CostAllocation .

ind:targetCostCenterId rdf:type rdf:Property ;
    rdfs:label 'Target Cost Center Id' ;
    rdfs:comment 'The direct patient care or revenue-generating cost center receiving the allocated costs. Represents departments such as surgery, emergency, radiology, or inpatient units.' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CostCenter .

ind:tertiaryCostModifiedByEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Tertiary Cost Modified By Employee Id' ;
    rdfs:comment 'Reference to the user who last modified this allocation record.' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:allocationAdjustmentAmount rdf:type rdf:Property ;
    rdfs:label 'Allocation Adjustment Amount' ;
    rdfs:comment 'Any manual adjustment applied to the calculated allocated amount. Used for corrections, policy adjustments, or rounding reconciliation.' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:allocationAmount rdf:type rdf:Property ;
    rdfs:label 'Allocation Amount' ;
    rdfs:comment 'Allocation amount' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:allocationBasisPercentage rdf:type rdf:Property ;
    rdfs:label 'Allocation Basis Percentage' ;
    rdfs:comment 'The percentage of the total allocation basis that the target cost center represents. Calculated as target quantity divided by sum of all target quantities. Used to distribute source costs proportionally.' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:allocationBasisQuantity rdf:type rdf:Property ;
    rdfs:label 'Allocation Basis Quantity' ;
    rdfs:comment 'The numeric quantity of the allocation basis metric for the target cost center. For example, 5000 square feet, 25.5 FTEs, 1200 patient days, or 8500 RVUs.' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:allocationCategory rdf:type rdf:Property ;
    rdfs:label 'Allocation Category' ;
    rdfs:comment 'The functional category of overhead cost being allocated. Groups allocations by the type of support service provided. [ENUM-REF-CANDIDATE: facilities|information_technology|human_resources|administration|finance|legal|compliance|quality|marketing — 9 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allocationDate rdf:type rdf:Property ;
    rdfs:label 'Allocation Date' ;
    rdfs:comment 'The business date on which this cost allocation was executed and recorded. Typically the last day of the fiscal period being allocated.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:allocationNotes rdf:type rdf:Property ;
    rdfs:label 'Allocation Notes' ;
    rdfs:comment 'Free-text field for documenting special circumstances, adjustments, or explanations related to this specific allocation transaction.' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allocationRunStatus rdf:type rdf:Property ;
    rdfs:label 'Allocation Run Status' ;
    rdfs:comment 'The current lifecycle status of this allocation record. Draft indicates preliminary calculation, pending approval awaits finance review, approved is ready for posting, posted means committed to GL, reversed indicates correction, and cancelled means voided.' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allocationSequence rdf:type rdf:Property ;
    rdfs:label 'Allocation Sequence' ;
    rdfs:comment 'The order in which this allocation was processed within the allocation run. Critical for step-down methodology where sequence determines which cost centers allocate first.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:allocationTier rdf:type rdf:Property ;
    rdfs:label 'Allocation Tier' ;
    rdfs:comment 'The hierarchical tier or level of this allocation in multi-tier allocation methodologies. Tier 1 represents first-level overhead, tier 2 represents second-level, and so on.' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:allocationVersion rdf:type rdf:Property ;
    rdfs:label 'Allocation Version' ;
    rdfs:comment 'Version identifier for the allocation run. Supports multiple allocation scenarios such as budget, forecast, actual, or what-if analysis.' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isMedicareReportable rdf:type rdf:Property ;
    rdfs:label 'Is Medicare Reportable' ;
    rdfs:comment 'Indicates whether this allocation must be reported on the Medicare Cost Report (CMS-2552-10) for reimbursement calculation purposes.' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isReciprocalAllocation rdf:type rdf:Property ;
    rdfs:label 'Is Reciprocal Allocation' ;
    rdfs:comment 'Indicates whether this allocation is part of a reciprocal allocation cycle where two or more cost centers provide mutual services to each other.' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sourceAmount rdf:type rdf:Property ;
    rdfs:label 'Source Amount' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sourceCostPoolAmount rdf:type rdf:Property ;
    rdfs:label 'Source Cost Pool Amount' ;
    rdfs:comment 'The total amount of costs available in the source cost center for allocation before distribution. Represents the full overhead pool being allocated across all target cost centers.' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:statisticQuantity rdf:type rdf:Property ;
    rdfs:label 'Statistic Quantity' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:statisticType rdf:type rdf:Property ;
    rdfs:label 'Statistic Type' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:statisticalDriver rdf:type rdf:Property ;
    rdfs:label 'Statistical Driver' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalPoolAmount rdf:type rdf:Property ;
    rdfs:label 'Total Pool Amount' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:allocationEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Allocation Employee Id' ;
    rdfs:comment 'Identifier of the user who created this allocation method record. Links to workforce or user management system for accountability.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:allocationModifiedByEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Allocation Modified By Employee Id' ;
    rdfs:comment 'Identifier of the user who last modified this allocation method record. Links to workforce or user management system for accountability.' ;
    rdfs:domain ind:AllocationMethod ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:parentAllocationMethodId rdf:type rdf:Property ;
    rdfs:label 'Parent Allocation Method Id' ;
    rdfs:domain ind:AllocationMethod ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AllocationMethod .

ind:primaryAllocationEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Allocation Employee Id' ;
    rdfs:comment 'Identifier of the finance executive or cost accounting manager who approved this allocation method. Links to workforce or user management system for accountability and audit trail.' ;
    rdfs:domain ind:AllocationMethod ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:primarySupersededMethodAllocationMethodId rdf:type rdf:Property ;
    rdfs:label 'Primary Superseded Method Allocation Method Id' ;
    rdfs:comment 'Identifier of the previous allocation method that this method replaces. Creates a lineage chain for tracking method evolution and supporting historical cost report reconstruction.' ;
    rdfs:domain ind:AllocationMethod ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AllocationMethod .

ind:activityDriverDescription rdf:type rdf:Property ;
    rdfs:label 'Activity Driver Description' ;
    rdfs:comment 'For activity-based costing (ABC) methods, describes the specific activity or cost driver that causes costs to be incurred. Examples include number of purchase orders processed, number of patient admissions, number of surgical procedures performed. Provides transparency into ABC methodology.' ;
    rdfs:domain ind:AllocationMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allocationBasisType rdf:type rdf:Property ;
    rdfs:label 'Allocation Basis Type' ;
    rdfs:comment 'The statistical or financial measure used as the basis for distributing costs. Square footage for facility costs; FTE (Full-Time Equivalent) count for HR costs; revenue for administrative overhead; RVU (Relative Value Unit) for physician services; patient days for nursing; procedures for surgical services; direct cost for proportional allocation; labor hours for labor-intensive departments; visits for outpatient services; discharges for inpatient services. [ENUM-REF-CANDIDATE: square_footage|fte_count|revenue|rvu|patient_days|procedures|direct_cost|labor_hours|visits|discharges — 10 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:AllocationMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allocationFrequency rdf:type rdf:Property ;
    rdfs:label 'Allocation Frequency' ;
    rdfs:comment 'How often this allocation method is executed. Monthly for routine cost accounting; quarterly for less frequent allocations; annually for year-end adjustments; as needed for special allocations; real-time for continuous allocation in advanced systems.' ;
    rdfs:domain ind:AllocationMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allocationPercentageCap rdf:type rdf:Property ;
    rdfs:label 'Allocation Percentage Cap' ;
    rdfs:comment 'Maximum percentage of source cost that can be allocated to any single target cost center. Used to prevent disproportionate allocation and ensure equitable distribution. Expressed as a percentage (e.g., 25.00 for 25%).' ;
    rdfs:domain ind:AllocationMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:auditTrailRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Audit Trail Required Flag' ;
    rdfs:comment 'Indicates whether detailed audit trail logging is required for allocations using this method. True for regulatory or high-value allocations requiring full traceability; false for routine internal allocations.' ;
    rdfs:domain ind:AllocationMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:basisDataSource rdf:type rdf:Property ;
    rdfs:label 'Basis Data Source' ;
    rdfs:comment 'The system, report, or data source from which the allocation basis statistics are obtained. Examples include facility management system for square footage, HR system for FTE counts, general ledger for revenue, clinical system for RVUs and patient days.' ;
    rdfs:domain ind:AllocationMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cmsCostReportSchedule rdf:type rdf:Property ;
    rdfs:label 'Cms Cost Report Schedule' ;
    rdfs:comment 'The specific Medicare Cost Report worksheet or schedule to which this allocation method applies. Examples include Worksheet A (Reclassification and Adjustment of Trial Balance), Worksheet B (Cost Allocation), Worksheet C (Departmental Cost Allocation). Critical for regulatory compliance and reimbursement.' ;
    rdfs:domain ind:AllocationMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:decimalPrecision rdf:type rdf:Property ;
    rdfs:label 'Decimal Precision' ;
    rdfs:comment 'Number of decimal places to which allocation amounts are calculated and stored. Typically 2 for dollar amounts, but may be higher for statistical allocations or percentage calculations.' ;
    rdfs:domain ind:AllocationMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:driverMetric rdf:type rdf:Property ;
    rdfs:label 'Driver Metric' ;
    rdfs:domain ind:AllocationMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gaapCompliantFlag rdf:type rdf:Property ;
    rdfs:label 'Gaap Compliant Flag' ;
    rdfs:comment 'Indicates whether this allocation method complies with Generally Accepted Accounting Principles (GAAP) for financial statement preparation. True for methods acceptable under GAAP; false for methods used only for internal or regulatory purposes.' ;
    rdfs:domain ind:AllocationMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:methodDescription rdf:type rdf:Property ;
    rdfs:label 'Method Description' ;
    rdfs:comment 'Detailed narrative description of the allocation method, including business rationale, calculation approach, and any special considerations. Used for documentation, training, and audit support.' ;
    rdfs:domain ind:AllocationMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:methodName rdf:type rdf:Property ;
    rdfs:label 'Method Name' ;
    rdfs:comment 'Full descriptive name of the cost allocation method. Human-readable label used in financial reports and cost accounting documentation.' ;
    rdfs:domain ind:AllocationMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:methodStatus rdf:type rdf:Property ;
    rdfs:label 'Method Status' ;
    rdfs:comment 'Current lifecycle status of the allocation method. Active methods are in use; inactive methods are retired; pending approval methods await finance leadership sign-off; deprecated methods are being phased out; under review methods are being evaluated for changes.' ;
    rdfs:domain ind:AllocationMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorPeriodAdjustmentFlag rdf:type rdf:Property ;
    rdfs:label 'Prior Period Adjustment Flag' ;
    rdfs:comment 'Indicates whether this allocation method supports retroactive adjustments to prior accounting periods. True for methods that allow historical corrections; false for methods that only allocate current period costs.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reciprocalAllocationFlag rdf:type rdf:Property ;
    rdfs:label 'Reciprocal Allocation Flag' ;
    rdfs:comment 'Indicates whether this method supports reciprocal allocation where departments can allocate costs to each other. True for methods that handle mutual service exchanges; false for unidirectional allocation methods.' ;
    rdfs:domain ind:AllocationMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reciprocalFlag rdf:type rdf:Property ;
    rdfs:label 'Reciprocal Flag' ;
    rdfs:domain ind:AllocationMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:roundingRule rdf:type rdf:Property ;
    rdfs:label 'Rounding Rule' ;
    rdfs:comment 'Specifies how calculated allocation amounts are rounded. Round half up rounds 0.5 and above up; round half down rounds 0.5 and below down; round up always rounds up; round down always rounds down; truncate drops decimals; no rounding preserves full precision. Critical for ensuring allocation totals reconcile to source costs.' ;
    rdfs:domain ind:AllocationMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceCostCenterCategory rdf:type rdf:Property ;
    rdfs:label 'Source Cost Center Category' ;
    rdfs:comment 'Classification of the cost centers from which costs are allocated using this method. Overhead includes facilities and utilities; administrative includes finance and HR; support services includes IT and housekeeping; ancillary includes lab and radiology; clinical includes nursing and therapy; revenue-producing vs non-revenue-producing distinguishes direct patient care from support functions. [ENUM-REF-CANDIDATE: overhead|administrative|support_services|ancillary|clinical|revenue_producing|non_revenue_producing — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:AllocationMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:statisticSource rdf:type rdf:Property ;
    rdfs:label 'Statistic Source' ;
    rdfs:domain ind:AllocationMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:statisticalSource rdf:type rdf:Property ;
    rdfs:label 'Statistical Source' ;
    rdfs:domain ind:AllocationMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stepDownSequence rdf:type rdf:Property ;
    rdfs:label 'Step Down Sequence' ;
    rdfs:domain ind:AllocationMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:targetCostCenterCategory rdf:type rdf:Property ;
    rdfs:label 'Target Cost Center Category' ;
    rdfs:comment 'Classification of the cost centers to which costs are allocated using this method. Defines the recipient departments for overhead distribution. Patient care only excludes further allocation to administrative departments.' ;
    rdfs:domain ind:AllocationMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:weightingFactor rdf:type rdf:Property ;
    rdfs:label 'Weighting Factor' ;
    rdfs:comment 'Numeric multiplier applied to the allocation basis to adjust for intensity, complexity, or other factors. Used to refine allocation precision when raw statistics do not fully reflect cost consumption patterns.' ;
    rdfs:domain ind:AllocationMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bankAccountId rdf:type rdf:Property ;
    rdfs:label 'Bank Account Id' ;
    rdfs:comment 'Unique identifier for the bank account record. Primary key.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BankAccount .

ind:bankCashChartOfAccountsId rdf:type rdf:Property ;
    rdfs:label 'Bank Cash Chart Of Accounts Id' ;
    rdfs:comment 'Foreign key linking to finance.chart_of_accounts. Business justification: bank_account has gl_cash_account_code (STRING) which should be normalized to FK to chart_of_accounts. Enables joining to get the GL cash account details. Using \'cash_chart_of_accounts_id\' as the FK na' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ChartOfAccounts .

ind:bankChartOfAccountsId rdf:type rdf:Property ;
    rdfs:label 'Bank Chart Of Accounts Id' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ChartOfAccounts .

ind:parentBankAccountId rdf:type rdf:Property ;
    rdfs:label 'Parent Bank Account Id' ;
    rdfs:comment 'Self-referencing FK on bank_account (parent_bank_account_id)' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BankAccount .

ind:primaryBankEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Bank Employee Id' ;
    rdfs:comment 'Identifier of the system user who created this bank account record.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:accountClosedDate rdf:type rdf:Property ;
    rdfs:label 'Account Closed Date' ;
    rdfs:comment 'The date on which the bank account was officially closed and is no longer available for transactions. Null if the account is still active.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:accountNotes rdf:type rdf:Property ;
    rdfs:label 'Account Notes' ;
    rdfs:comment 'Free-text field for capturing additional information, special instructions, or operational notes related to the bank account.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accountNumberMasked rdf:type rdf:Property ;
    rdfs:label 'Account Number Masked' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accountOpenedDate rdf:type rdf:Property ;
    rdfs:label 'Account Opened Date' ;
    rdfs:comment 'The date on which the bank account was originally opened with the financial institution.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:accountPurpose rdf:type rdf:Property ;
    rdfs:label 'Account Purpose' ;
    rdfs:comment 'The designated business purpose or functional use of the bank account within the healthcare organization\'s treasury operations.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:achEnabledFlag rdf:type rdf:Property ;
    rdfs:label 'Ach Enabled Flag' ;
    rdfs:comment 'Indicates whether the account is enabled to send and receive ACH electronic funds transfers for payroll, vendor payments, and other automated transactions.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:availableBalance rdf:type rdf:Property ;
    rdfs:label 'Available Balance' ;
    rdfs:comment 'The amount of funds available for immediate withdrawal or payment, accounting for pending transactions and holds.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bankBranchAddress rdf:type rdf:Property ;
    rdfs:label 'Bank Branch Address' ;
    rdfs:comment 'The physical street address of the bank branch where the account is maintained.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bankBranchName rdf:type rdf:Property ;
    rdfs:label 'Bank Branch Name' ;
    rdfs:comment 'The name of the specific bank branch where the account is domiciled and serviced.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bankContactEmail rdf:type rdf:Property ;
    rdfs:label 'Bank Contact Email' ;
    rdfs:comment 'The email address of the bank relationship manager or primary contact for electronic communication regarding the account.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bankContactName rdf:type rdf:Property ;
    rdfs:label 'Bank Contact Name' ;
    rdfs:comment 'The name of the primary relationship manager or contact person at the financial institution for this account.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bankContactPhone rdf:type rdf:Property ;
    rdfs:label 'Bank Contact Phone' ;
    rdfs:comment 'The telephone number of the bank relationship manager or primary contact for account inquiries and issue resolution.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bankName rdf:type rdf:Property ;
    rdfs:label 'Bank Name' ;
    rdfs:comment 'The legal name of the financial institution where the account is maintained.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bankSwiftCode rdf:type rdf:Property ;
    rdfs:label 'Bank Swift Code' ;
    rdfs:comment 'The Society for Worldwide Interbank Financial Telecommunication (SWIFT) Business Identifier Code (BIC) used for international wire transfers and cross-border payments.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dualSignatureRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Dual Signature Required Flag' ;
    rdfs:comment 'Indicates whether transactions above a certain threshold require two authorized signatures for approval and execution.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dualSignatureThresholdAmount rdf:type rdf:Property ;
    rdfs:label 'Dual Signature Threshold Amount' ;
    rdfs:comment 'The monetary threshold above which dual signature authorization is required for transactions on this account.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fdicCertificateNumber rdf:type rdf:Property ;
    rdfs:label 'Fdic Certificate Number' ;
    rdfs:comment 'The unique FDIC certificate number assigned to the financial institution, used to verify insurance coverage.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fdicInsuredFlag rdf:type rdf:Property ;
    rdfs:label 'Fdic Insured Flag' ;
    rdfs:comment 'Indicates whether the bank account is covered by FDIC insurance protection up to the statutory limit.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:iban rdf:type rdf:Property ;
    rdfs:label 'Iban' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interestCalculationMethod rdf:type rdf:Property ;
    rdfs:label 'Interest Calculation Method' ;
    rdfs:comment 'The frequency and methodology used by the financial institution to calculate and credit interest to the account.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isDisbursementAccount rdf:type rdf:Property ;
    rdfs:label 'Is Disbursement Account' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isOperatingAccount rdf:type rdf:Property ;
    rdfs:label 'Is Operating Account' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastReconciledDate rdf:type rdf:Property ;
    rdfs:label 'Last Reconciled Date' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastReconciliationDate rdf:type rdf:Property ;
    rdfs:label 'Last Reconciliation Date' ;
    rdfs:comment 'The date of the most recent bank reconciliation performed for this account, ensuring alignment between bank statement and general ledger balances.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:minimumBalanceRequired rdf:type rdf:Property ;
    rdfs:label 'Minimum Balance Required' ;
    rdfs:comment 'The minimum account balance that must be maintained to avoid fees or meet contractual requirements with the financial institution.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bankAccountName rdf:type rdf:Property ;
    rdfs:label 'Bank Account Name' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextReconciliationDueDate rdf:type rdf:Property ;
    rdfs:label 'Next Reconciliation Due Date' ;
    rdfs:comment 'The scheduled date by which the next bank reconciliation must be completed per organizational policy and internal controls.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:onlineBankingEnabledFlag rdf:type rdf:Property ;
    rdfs:label 'Online Banking Enabled Flag' ;
    rdfs:comment 'Indicates whether online banking access and electronic transaction capabilities are enabled for this account.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:openingDate rdf:type rdf:Property ;
    rdfs:label 'Opening Date' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:positivePayEnabledFlag rdf:type rdf:Property ;
    rdfs:label 'Positive Pay Enabled Flag' ;
    rdfs:comment 'Indicates whether positive pay fraud prevention service is enabled, requiring pre-authorization of checks and ACH transactions before they are honored by the bank.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:primarySignatoryName rdf:type rdf:Property ;
    rdfs:label 'Primary Signatory Name' ;
    rdfs:comment 'The name of the primary authorized signatory who has authority to execute transactions and sign checks on this bank account.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primarySignatoryTitle rdf:type rdf:Property ;
    rdfs:label 'Primary Signatory Title' ;
    rdfs:comment 'The job title or position of the primary authorized signatory within the healthcare organization.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:restrictedFundFlag rdf:type rdf:Property ;
    rdfs:label 'Restricted Fund Flag' ;
    rdfs:comment 'Indicates whether the account holds restricted funds that are subject to donor restrictions, grant requirements, or regulatory limitations on use.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:secondarySignatoryName rdf:type rdf:Property ;
    rdfs:label 'Secondary Signatory Name' ;
    rdfs:comment 'The name of the secondary authorized signatory who has backup authority to execute transactions on this bank account.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:swiftCode rdf:type rdf:Property ;
    rdfs:label 'Swift Code' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wireTransferEnabledFlag rdf:type rdf:Property ;
    rdfs:label 'Wire Transfer Enabled Flag' ;
    rdfs:comment 'Indicates whether the account is authorized to initiate and receive domestic and international wire transfers.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bankReconciliationId rdf:type rdf:Property ;
    rdfs:label 'Bank Reconciliation Id' ;
    rdfs:comment 'Unique identifier for the bank reconciliation record. Primary key for the bank reconciliation transaction.' ;
    rdfs:domain ind:BankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:primaryPriorPeriodReconciliationBankReconciliationId rdf:type rdf:Property ;
    rdfs:label 'Primary Prior Period Reconciliation Bank Reconciliation Id' ;
    rdfs:comment 'Reference to the previous month\'s or period\'s bank reconciliation record. Enables tracking of reconciliation continuity and resolution of prior period outstanding items.' ;
    rdfs:domain ind:BankReconciliation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BankReconciliation .

ind:primaryReconEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Recon Employee Id' ;
    rdfs:domain ind:BankReconciliation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:adjustedBankBalance rdf:type rdf:Property ;
    rdfs:label 'Adjusted Bank Balance' ;
    rdfs:domain ind:BankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:autoReconciliationFlag rdf:type rdf:Property ;
    rdfs:label 'Auto Reconciliation Flag' ;
    rdfs:comment 'Indicates whether this reconciliation was performed automatically by the system using matching algorithms or manually by an accountant. True indicates automated reconciliation, false indicates manual reconciliation.' ;
    rdfs:domain ind:BankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bankErrorsTotal rdf:type rdf:Property ;
    rdfs:label 'Bank Errors Total' ;
    rdfs:comment 'Total amount of errors identified on the bank statement, such as incorrect charges, duplicate transactions, or processing mistakes by the bank. Positive values indicate bank overstatements, negative values indicate understatements.' ;
    rdfs:domain ind:BankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bankServiceCharges rdf:type rdf:Property ;
    rdfs:label 'Bank Service Charges' ;
    rdfs:comment 'Total bank fees and service charges deducted by the bank during the statement period, including monthly maintenance fees, transaction fees, and wire transfer charges.' ;
    rdfs:domain ind:BankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bankStatementBalance rdf:type rdf:Property ;
    rdfs:label 'Bank Statement Balance' ;
    rdfs:domain ind:BankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bookBalance rdf:type rdf:Property ;
    rdfs:label 'Book Balance' ;
    rdfs:comment 'Book balance' ;
    rdfs:domain ind:BankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bookErrorsTotal rdf:type rdf:Property ;
    rdfs:label 'Book Errors Total' ;
    rdfs:comment 'Total amount of errors identified in the organization\'s general ledger records, such as recording errors, duplicate entries, or omitted transactions. Requires correcting journal entries.' ;
    rdfs:domain ind:BankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:depositsInTransit rdf:type rdf:Property ;
    rdfs:label 'Deposits In Transit' ;
    rdfs:domain ind:BankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:depositsInTransitTotal rdf:type rdf:Property ;
    rdfs:label 'Deposits In Transit Total' ;
    rdfs:comment 'Total amount of deposits recorded in the GL but not yet reflected on the bank statement as of the statement date. Represents timing differences between internal recording and bank processing.' ;
    rdfs:domain ind:BankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:differenceAmount rdf:type rdf:Property ;
    rdfs:label 'Difference Amount' ;
    rdfs:domain ind:BankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:endingBalance rdf:type rdf:Property ;
    rdfs:label 'Ending Balance' ;
    rdfs:domain ind:BankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:glBookBalance rdf:type rdf:Property ;
    rdfs:label 'Gl Book Balance' ;
    rdfs:comment 'The cash account balance as recorded in the general ledger for the reconciliation period. This is the organization\'s internal record of the account balance.' ;
    rdfs:domain ind:BankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:interestEarned rdf:type rdf:Property ;
    rdfs:label 'Interest Earned' ;
    rdfs:comment 'Interest income earned on the bank account during the statement period as reported by the bank. Requires recording in the general ledger if not previously captured.' ;
    rdfs:domain ind:BankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nsfChecksTotal rdf:type rdf:Property ;
    rdfs:label 'Nsf Checks Total' ;
    rdfs:comment 'Total amount of checks deposited by the organization that were returned by the bank due to insufficient funds in the payer\'s account. Requires reversal of the original deposit entry.' ;
    rdfs:domain ind:BankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:otherAdjustmentsTotal rdf:type rdf:Property ;
    rdfs:label 'Other Adjustments Total' ;
    rdfs:comment 'Total amount of miscellaneous adjustments not categorized elsewhere, including electronic fund transfers, automatic payments, or other reconciling items identified during the reconciliation process.' ;
    rdfs:domain ind:BankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:outstandingChecksAmount rdf:type rdf:Property ;
    rdfs:label 'Outstanding Checks Amount' ;
    rdfs:domain ind:BankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:outstandingChecksTotal rdf:type rdf:Property ;
    rdfs:label 'Outstanding Checks Total' ;
    rdfs:comment 'Total amount of checks issued by the organization that have been recorded in the GL but have not yet cleared the bank as of the statement date.' ;
    rdfs:domain ind:BankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:outstandingItemsCount rdf:type rdf:Property ;
    rdfs:label 'Outstanding Items Count' ;
    rdfs:comment 'Total number of outstanding reconciling items identified during the reconciliation process, including outstanding checks, deposits in transit, and other uncleared transactions.' ;
    rdfs:domain ind:BankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:preparerName rdf:type rdf:Property ;
    rdfs:label 'Preparer Name' ;
    rdfs:comment 'Full name of the employee who prepared the bank reconciliation. Provides human-readable identification for reporting and audit purposes.' ;
    rdfs:domain ind:BankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reconciledBalance rdf:type rdf:Property ;
    rdfs:label 'Reconciled Balance' ;
    rdfs:comment 'The final adjusted balance after applying all reconciling items to either the bank statement balance or the GL book balance. Both adjusted balances should equal this amount when reconciliation is complete.' ;
    rdfs:domain ind:BankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reconciledBy rdf:type rdf:Property ;
    rdfs:label 'Reconciled By' ;
    rdfs:domain ind:BankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reconciliationNotes rdf:type rdf:Property ;
    rdfs:label 'Reconciliation Notes' ;
    rdfs:comment 'Free-text field for documenting significant findings, unusual items, explanations of variances, or other relevant information discovered during the reconciliation process. Supports audit trail and knowledge transfer.' ;
    rdfs:domain ind:BankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reconciliationNumber rdf:type rdf:Property ;
    rdfs:label 'Reconciliation Number' ;
    rdfs:comment 'Business identifier for the reconciliation transaction, typically formatted as a sequential or date-based reference number used for tracking and audit purposes.' ;
    rdfs:domain ind:BankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:statementBalance rdf:type rdf:Property ;
    rdfs:label 'Statement Balance' ;
    rdfs:comment 'Statement balance' ;
    rdfs:domain ind:BankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:statementDate rdf:type rdf:Property ;
    rdfs:label 'Statement Date' ;
    rdfs:comment 'The ending date of the bank statement being reconciled. Represents the cutoff date for transactions included in the bank statement.' ;
    rdfs:domain ind:BankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:statementEndingBalance rdf:type rdf:Property ;
    rdfs:label 'Statement Ending Balance' ;
    rdfs:comment 'The ending balance as reported on the bank statement for the statement date. This is the bank\'s record of the account balance.' ;
    rdfs:domain ind:BankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:statementEndingDate rdf:type rdf:Property ;
    rdfs:label 'Statement Ending Date' ;
    rdfs:domain ind:BankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:statementStartingDate rdf:type rdf:Property ;
    rdfs:label 'Statement Starting Date' ;
    rdfs:domain ind:BankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:unreconciledVariance rdf:type rdf:Property ;
    rdfs:label 'Unreconciled Variance' ;
    rdfs:comment 'The remaining difference between the adjusted bank balance and adjusted book balance after all known reconciling items have been applied. A non-zero variance indicates unresolved discrepancies requiring investigation.' ;
    rdfs:domain ind:BankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:financialPeriodCloseId rdf:type rdf:Property ;
    rdfs:label 'Financial Period Close Id' ;
    rdfs:comment 'Unique identifier for the financial period close record. Primary key.' ;
    rdfs:domain ind:FinancialPeriodClose ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:financialEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Financial Employee Id' ;
    rdfs:comment 'Reference to the user who created this financial period close record.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:financialModifiedByEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Financial Modified By Employee Id' ;
    rdfs:comment 'Reference to the user who last modified this financial period close record.' ;
    rdfs:domain ind:FinancialPeriodClose ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:primaryCloseEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Close Employee Id' ;
    rdfs:domain ind:FinancialPeriodClose ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:primaryFinancialEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Financial Employee Id' ;
    rdfs:comment 'Reference to the employee or user responsible for managing and completing this period close.' ;
    rdfs:domain ind:FinancialPeriodClose ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:priorFinancialPeriodCloseId rdf:type rdf:Property ;
    rdfs:label 'Prior Financial Period Close Id' ;
    rdfs:comment 'Self-referencing FK on financial_period_close (prior_financial_period_close_id)' ;
    rdfs:domain ind:FinancialPeriodClose ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FinancialPeriodClose .

ind:accountsPayableCloseStatus rdf:type rdf:Property ;
    rdfs:label 'Accounts Payable Close Status' ;
    rdfs:comment 'Status of accounts payable close activities, including vendor invoice processing and accrual verification.' ;
    rdfs:domain ind:FinancialPeriodClose ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accrualCompletionStatus rdf:type rdf:Property ;
    rdfs:label 'Accrual Completion Status' ;
    rdfs:comment 'Status of accrual entries for the period, ensuring all revenue and expenses are recorded in the correct period per accrual accounting.' ;
    rdfs:domain ind:FinancialPeriodClose ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actualCloseDate rdf:type rdf:Property ;
    rdfs:label 'Actual Close Date' ;
    rdfs:comment 'Actual date when the financial period close was completed and the period was locked.' ;
    rdfs:domain ind:FinancialPeriodClose ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:auditFindingsCount rdf:type rdf:Property ;
    rdfs:label 'Audit Findings Count' ;
    rdfs:comment 'Number of audit findings or exceptions identified during the close process that require resolution.' ;
    rdfs:domain ind:FinancialPeriodClose ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:balanceSheetReconciliationStatus rdf:type rdf:Property ;
    rdfs:label 'Balance Sheet Reconciliation Status' ;
    rdfs:comment 'Status of balance sheet account reconciliations for this period, ensuring all asset, liability, and equity accounts are reconciled.' ;
    rdfs:domain ind:FinancialPeriodClose ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:budgetVarianceReviewStatus rdf:type rdf:Property ;
    rdfs:label 'Budget Variance Review Status' ;
    rdfs:comment 'Status of budget-to-actual variance analysis and review for this period.' ;
    rdfs:domain ind:FinancialPeriodClose ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:closeChecklistCompletedItems rdf:type rdf:Property ;
    rdfs:label 'Close Checklist Completed Items' ;
    rdfs:comment 'Number of checklist items that have been completed for this period close.' ;
    rdfs:domain ind:FinancialPeriodClose ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:closeChecklistCompletionPercentage rdf:type rdf:Property ;
    rdfs:label 'Close Checklist Completion Percentage' ;
    rdfs:comment 'Percentage of close checklist items completed, calculated as (completed_items / total_items) * 100.' ;
    rdfs:domain ind:FinancialPeriodClose ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:closeChecklistTotalItems rdf:type rdf:Property ;
    rdfs:label 'Close Checklist Total Items' ;
    rdfs:comment 'Total number of checklist items that must be completed for this period close.' ;
    rdfs:domain ind:FinancialPeriodClose ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:closeCompletedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Close Completed Timestamp' ;
    rdfs:comment 'Date and time when the period close process was fully completed.' ;
    rdfs:domain ind:FinancialPeriodClose ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:closeDelayReason rdf:type rdf:Property ;
    rdfs:label 'Close Delay Reason' ;
    rdfs:comment 'Explanation for any delay in completing the period close beyond the planned close date.' ;
    rdfs:domain ind:FinancialPeriodClose ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:closeEfficiencyRating rdf:type rdf:Property ;
    rdfs:label 'Close Efficiency Rating' ;
    rdfs:comment 'Qualitative assessment of the efficiency and timeliness of this period close process.' ;
    rdfs:domain ind:FinancialPeriodClose ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:closeInitiatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Close Initiated Timestamp' ;
    rdfs:comment 'Date and time when the period close process was initiated.' ;
    rdfs:domain ind:FinancialPeriodClose ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:closeNotes rdf:type rdf:Property ;
    rdfs:label 'Close Notes' ;
    rdfs:comment 'Additional notes, comments, or observations related to this period close process.' ;
    rdfs:domain ind:FinancialPeriodClose ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:closeNumber rdf:type rdf:Property ;
    rdfs:label 'Close Number' ;
    rdfs:comment 'Business identifier for the period close event, typically formatted as YYYY-MM-CLOSE or similar.' ;
    rdfs:domain ind:FinancialPeriodClose ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:closeStatus rdf:type rdf:Property ;
    rdfs:label 'Close Status' ;
    rdfs:comment 'Current status of the period close process. Soft close allows limited adjustments; hard close is final and locked.' ;
    rdfs:domain ind:FinancialPeriodClose ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:closeType rdf:type rdf:Property ;
    rdfs:label 'Close Type' ;
    rdfs:comment 'Type of financial close being performed: monthly, quarterly, annual, or adjustment period close.' ;
    rdfs:domain ind:FinancialPeriodClose ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cmsCostReportStatus rdf:type rdf:Property ;
    rdfs:label 'Cms Cost Report Status' ;
    rdfs:comment 'Status of CMS cost report preparation and submission for this period, required for Medicare reimbursement.' ;
    rdfs:domain ind:FinancialPeriodClose ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:externalAuditStatus rdf:type rdf:Property ;
    rdfs:label 'External Audit Status' ;
    rdfs:comment 'Status of external audit review for this period, typically applicable for year-end closes.' ;
    rdfs:domain ind:FinancialPeriodClose ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:financialStatementPreparationStatus rdf:type rdf:Property ;
    rdfs:label 'Financial Statement Preparation Status' ;
    rdfs:comment 'Status of financial statement preparation for this period, including balance sheet, income statement, and cash flow statement.' ;
    rdfs:domain ind:FinancialPeriodClose ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fixedAssetsCloseStatus rdf:type rdf:Property ;
    rdfs:label 'Fixed Assets Close Status' ;
    rdfs:comment 'Status of fixed asset close activities, including depreciation calculation and asset reconciliation.' ;
    rdfs:domain ind:FinancialPeriodClose ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hardCloseDate rdf:type rdf:Property ;
    rdfs:label 'Hard Close Date' ;
    rdfs:comment 'Date when the period was permanently closed and locked from further adjustments.' ;
    rdfs:domain ind:FinancialPeriodClose ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:intercompanyReconciliationStatus rdf:type rdf:Property ;
    rdfs:label 'Intercompany Reconciliation Status' ;
    rdfs:comment 'Status of intercompany account reconciliation for this period, ensuring balances between entities are matched.' ;
    rdfs:domain ind:FinancialPeriodClose ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:openItemsCount rdf:type rdf:Property ;
    rdfs:label 'Open Items Count' ;
    rdfs:comment 'Number of outstanding issues or tasks that must be resolved before the period can be closed.' ;
    rdfs:domain ind:FinancialPeriodClose ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:payrollCloseStatus rdf:type rdf:Property ;
    rdfs:label 'Payroll Close Status' ;
    rdfs:comment 'Status of payroll close activities for this period, ensuring all payroll expenses and liabilities are properly recorded.' ;
    rdfs:domain ind:FinancialPeriodClose ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:plannedCloseDate rdf:type rdf:Property ;
    rdfs:label 'Planned Close Date' ;
    rdfs:comment 'Target date by which the financial period close should be completed per the close calendar.' ;
    rdfs:domain ind:FinancialPeriodClose ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:regulatoryReportingStatus rdf:type rdf:Property ;
    rdfs:label 'Regulatory Reporting Status' ;
    rdfs:comment 'Status of regulatory reporting submissions required for this period, such as CMS cost reports or state financial filings.' ;
    rdfs:domain ind:FinancialPeriodClose ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revenueCycleCloseStatus rdf:type rdf:Property ;
    rdfs:label 'Revenue Cycle Close Status' ;
    rdfs:comment 'Status of revenue cycle close activities, including patient accounts receivable reconciliation and revenue recognition.' ;
    rdfs:domain ind:FinancialPeriodClose ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:softCloseDate rdf:type rdf:Property ;
    rdfs:label 'Soft Close Date' ;
    rdfs:comment 'Date when the period was soft closed, allowing limited adjustments before final hard close.' ;
    rdfs:domain ind:FinancialPeriodClose ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:tasksCompletedCount rdf:type rdf:Property ;
    rdfs:label 'Tasks Completed Count' ;
    rdfs:domain ind:FinancialPeriodClose ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:tasksTotalCount rdf:type rdf:Property ;
    rdfs:label 'Tasks Total Count' ;
    rdfs:domain ind:FinancialPeriodClose ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:unpostedJournalsCount rdf:type rdf:Property ;
    rdfs:label 'Unposted Journals Count' ;
    rdfs:comment 'Number of journal entries that have been entered but not yet posted to the general ledger for this period.' ;
    rdfs:domain ind:FinancialPeriodClose ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:vibeMutationTest rdf:type rdf:Property ;
    rdfs:label 'Vibe Mutation Test' ;
    rdfs:comment 'Added by VIBE mutation to ensure product is touched' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:intercompanyTransactionId rdf:type rdf:Property ;
    rdfs:label 'Intercompany Transaction Id' ;
    rdfs:comment 'Unique identifier for the intercompany transaction record within the integrated delivery network (IDN).' ;
    rdfs:domain ind:IntercompanyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fromFinancialEntityId rdf:type rdf:Property ;
    rdfs:label 'From Financial Entity Id' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FinancialEntity .

ind:intercompanyAgreementId rdf:type rdf:Property ;
    rdfs:label 'Intercompany Agreement Id' ;
    rdfs:comment 'Reference to the master intercompany agreement or service level agreement that governs the terms of this transaction.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:IntercompanyAgreement .

ind:intercompanyEliminationJournalEntryId rdf:type rdf:Property ;
    rdfs:label 'Intercompany Elimination Journal Entry Id' ;
    rdfs:comment 'Reference to the consolidation elimination journal entry that offsets this intercompany transaction in the consolidated financial statements.' ;
    rdfs:domain ind:IntercompanyTransaction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:JournalEntry .

ind:intercompanyJournalEntryId rdf:type rdf:Property ;
    rdfs:label 'Intercompany Journal Entry Id' ;
    rdfs:comment 'FK to journal entry' ;
    rdfs:domain ind:IntercompanyTransaction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:JournalEntry .

ind:originatingChartOfAccountsId rdf:type rdf:Property ;
    rdfs:label 'Originating Chart Of Accounts Id' ;
    rdfs:comment 'Foreign key linking to finance.chart_of_accounts. Business justification: intercompany_transaction has originating_gl_account_code (STRING) which should be normalized to FK to chart_of_accounts. Using \'originating_chart_of_accounts_id\' as the FK name to distinguish from the' ;
    rdfs:domain ind:IntercompanyTransaction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ChartOfAccounts .

ind:primaryIntercompanyEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Intercompany Employee Id' ;
    rdfs:comment 'Identifier of the user or manager who approved the intercompany transaction for processing.' ;
    rdfs:domain ind:IntercompanyTransaction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:primaryIntercompanyFinancialEntityId rdf:type rdf:Property ;
    rdfs:label 'Primary Intercompany Financial Entity Id' ;
    rdfs:comment 'Identifier of the legal entity within the IDN that initiated or is the source of the intercompany transaction.' ;
    rdfs:domain ind:IntercompanyTransaction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FinancialEntity .

ind:primaryReversedTransactionIntercompanyTransactionId rdf:type rdf:Property ;
