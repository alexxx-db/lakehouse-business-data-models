    rdfs:comment 'Percentage of the asset\'s total cost that is funded by this grant (e.g., 75.00 means 75% grant-funded, 25% utility match). Used for matching requirement calculations.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
