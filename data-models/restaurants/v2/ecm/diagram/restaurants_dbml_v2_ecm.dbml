  freight_amount decimal(18,2) [note: 'Freight/shipping amount.']
  internal_comments varchar [note: 'Internal comments.']
  is_consolidated boolean [note: 'Whether this is a consolidated PO.']
  is_urgent boolean [note: 'Whether the PO is urgent.']
  last_received_timestamp timestamp [note: 'Last goods receipt timestamp.']
  line_item_count varchar [note: 'Number of line items.']
  net_amount decimal(18,2) [note: 'Net PO amount.']
  notes varchar [note: 'Additional notes.']
  order_date date [note: 'Date the PO was placed.']
  payment_due_date date [note: 'Payment due date.']
  payment_terms decimal(18,2) [note: 'Payment terms.']
  po_status varchar [note: 'Current PO status.']
  po_type varchar [note: 'Type of purchase order.']
  priority varchar [note: 'PO priority level.']
  promised_delivery_date date [note: 'Supplier promised delivery date.']
  purchase_order_number varchar [note: 'Unique PO number.']
  receipt_status varchar [note: 'Goods receipt status.']
  regulatory_approval_status varchar [note: 'Regulatory approval status.']
  requested_delivery_date date [note: 'Requested delivery date.']
  tax_amount decimal(18,2) [note: 'Total tax amount.']
  tax_rate decimal(5,2) [note: 'Applicable tax rate.']
  total_amount_gross decimal(18,2) [note: 'Gross total amount.']
  total_weight_kg decimal(18,2) [note: 'Total weight in kilograms.']
  updated_timestamp timestamp [note: 'Record last update timestamp.']

  Note: 'Purchase orders issued to suppliers for goods and services in the procurement process.'
}

Table procurement.po_line {
  po_line_id varchar [pk, note: 'Primary key for the PO line.']
  budget_line_id varchar [note: 'Associated budget line.']
  contract_line_id varchar [note: 'Associated contract line.']
