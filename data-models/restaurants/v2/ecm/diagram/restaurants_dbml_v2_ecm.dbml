  kds_sent_timestamp timestamp [note: 'When item was sent to KDS.']
  line_discount_amount decimal(18,2) [note: 'Discount applied to this line.']
  line_gross_amount decimal(18,2) [note: 'Gross amount before discounts.']
  line_net_amount decimal(18,2) [note: 'Net amount after discounts.']
  line_sequence varchar [note: 'Sequence number of the line item.']
  loyalty_points_earned varchar [note: 'Points earned from this item.']
  menu_item_id varchar [note: 'FK to menu item ordered.']
  modifier_price decimal(18,2) [note: 'Price of modifiers on this item.']
  pmix_category varchar [note: 'Product mix category.']
  preparation_instructions decimal(9,4) [note: 'Special preparation instructions.']
  promo_code varchar [note: 'Promotional code applied.']
  quantity decimal(10,3) [note: 'Quantity ordered.']
  refund_amount decimal(18,2) [note: 'Amount refunded for this item.']
  refund_flag boolean [note: 'Whether item was refunded.']
  service_channel varchar [note: 'Channel through which item was ordered.']
  source_system_item_ref varchar [note: 'Source system item reference.']
  tax_amount decimal(18,2) [note: 'Tax on this line item.']
  tax_exempt_flag boolean [note: 'Whether item is tax exempt.']
  ticket_time_seconds varchar [note: 'Time to prepare this item.']
  unit_price decimal(18,2) [note: 'Price per unit.']
  updated_timestamp timestamp [note: 'Last update timestamp.']
  void_reason_code varchar [note: 'Reason code if item was voided.']
  waste_flag boolean [note: 'Whether item resulted in waste.']
  waste_reason_code varchar [note: 'Reason for waste.']

  Note: 'Individual line item within a guest order.'
}

