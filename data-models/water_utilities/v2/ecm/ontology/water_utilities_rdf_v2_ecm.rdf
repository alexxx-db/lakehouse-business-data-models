    rdfs:comment 'Reference to primary billing.billing_rate_schedule for SSOT alignment.' ;
    rdfs:domain ind:ServiceRateSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:billingPeriodType rdf:type rdf:Property ;
    rdfs:label 'Billing Period Type' ;
    rdfs:comment 'Monthly, bi-monthly, quarterly' ;
    rdfs:domain ind:ServiceRateSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingUnit rdf:type rdf:Property ;
    rdfs:label 'Billing Unit' ;
    rdfs:comment 'Unit of measure for volumetric billing (CCF, 1000_gallons, cubic_meter).' ;
    rdfs:domain ind:ServiceRateSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceRateScheduleCategory rdf:type rdf:Property ;
    rdfs:label 'Service Rate Schedule Category' ;
    rdfs:domain ind:ServiceRateSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceRateScheduleCode rdf:type rdf:Property ;
    rdfs:label 'Service Rate Schedule Code' ;
    rdfs:domain ind:ServiceRateSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commodityChargeDescription rdf:type rdf:Property ;
