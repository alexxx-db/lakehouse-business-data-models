    rdfs:range xsd:decimal .

ind:aptcSubsidyStatus rdf:type rdf:Property ;
    rdfs:label 'Aptc Subsidy Status' ;
    rdfs:comment 'Overall lifecycle status of the subsidy record.' ;
    rdfs:domain ind:AptcSubsidy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cmsReconciliationStatus rdf:type rdf:Property ;
    rdfs:label 'Cms Reconciliation Status' ;
