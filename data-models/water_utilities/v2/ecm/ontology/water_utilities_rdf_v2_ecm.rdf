ind:mvmTier rdf:type rdf:Property ;
    rdfs:label 'Mvm Tier' ;
    rdfs:domain ind:Laboratory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qcLevel rdf:type rdf:Property ;
    rdfs:label 'Qc Level' ;
    rdfs:domain ind:LabSample ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:receivedDatetime rdf:type rdf:Property ;
    rdfs:label 'Received Datetime' ;
    rdfs:comment 'Date and time when custody was received by the receiving party. Critical for establishing unbroken custody chain and hold time compliance.' ;
    rdfs:domain ind:Laboratory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:sampleCondition rdf:type rdf:Property ;
    rdfs:label 'Sample Condition' ;
    rdfs:domain ind:LabSample ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sampleConditionNotes rdf:type rdf:Property ;
    rdfs:label 'Sample Condition Notes' ;
    rdfs:domain ind:LabSample ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sampleOrigin rdf:type rdf:Property ;
    rdfs:label 'Sample Origin' ;
    rdfs:domain ind:LabSample ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:turnaroundTimeHours rdf:type rdf:Property ;
    rdfs:label 'Turnaround Time Hours' ;
    rdfs:domain ind:LabSample ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sampleEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Sample Employee Id' ;
    rdfs:comment 'Reference to the certified analyst or field technician who performed the sample collection. Must be a certified individual per regulatory requirements.' ;
    rdfs:domain ind:SampleCollectionEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:ambientTemperatureC rdf:type rdf:Property ;
    rdfs:label 'Ambient Temperature C' ;
    rdfs:comment 'Air temperature at the time of sample collection in degrees Celsius. Documented for quality assurance and environmental context.' ;
    rdfs:domain ind:SampleCollectionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:collectionEquipmentCode rdf:type rdf:Property ;
    rdfs:label 'Collection Equipment Code' ;
    rdfs:comment 'Reference to the equipment or instrument used for sample collection (e.g., autosampler, grab sample kit, composite sampler). Links to asset management and calibration records.' ;
    rdfs:domain ind:SampleCollectionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:collectionEquipmentDescription rdf:type rdf:Property ;
    rdfs:label 'Collection Equipment Description' ;
    rdfs:comment 'Description of the equipment used for sample collection, including make, model, and serial number if applicable.' ;
    rdfs:domain ind:SampleCollectionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collectionEventNumber rdf:type rdf:Property ;
    rdfs:label 'Collection Event Number' ;
    rdfs:comment 'Business identifier for the collection event, typically generated by LIMS or field data collection system. Used for tracking and chain of custody documentation.' ;
    rdfs:domain ind:SampleCollectionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collectionLatitude rdf:type rdf:Property ;
    rdfs:label 'Collection Latitude' ;
    rdfs:comment 'Geographic latitude coordinate of the sample collection point in decimal degrees. Used for spatial analysis and regulatory reporting.' ;
    rdfs:domain ind:SampleCollectionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:collectionLocationName rdf:type rdf:Property ;
    rdfs:label 'Collection Location Name' ;
    rdfs:comment 'Human-readable name or description of the collection location (e.g., Entry Point 1, Distribution System Site 12A, WWTP Effluent Outfall).' ;
    rdfs:domain ind:SampleCollectionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collectionLongitude rdf:type rdf:Property ;
    rdfs:label 'Collection Longitude' ;
    rdfs:comment 'Geographic longitude coordinate of the sample collection point in decimal degrees. Used for spatial analysis and regulatory reporting.' ;
    rdfs:domain ind:SampleCollectionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:collectionMethodCode rdf:type rdf:Property ;
    rdfs:label 'Collection Method Code' ;
    rdfs:comment 'Standardized code identifying the sample collection method used (e.g., grab sample, composite sample, continuous monitoring). Must align with EPA-approved methods.' ;
    rdfs:domain ind:SampleCollectionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collectionMethodDescription rdf:type rdf:Property ;
    rdfs:label 'Collection Method Description' ;
    rdfs:comment 'Detailed description of the collection method, including any deviations from standard protocols or special handling requirements.' ;
    rdfs:domain ind:SampleCollectionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collectorCertificationNumber rdf:type rdf:Property ;
    rdfs:label 'Collector Certification Number' ;
    rdfs:comment 'Certification or license number of the sample collector, demonstrating qualification to perform regulated sample collection activities.' ;
    rdfs:domain ind:Laboratory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collectorName rdf:type rdf:Property ;
    rdfs:label 'Collector Name' ;
    rdfs:comment 'Full name of the individual who collected the sample. Required for chain of custody documentation and regulatory audit trails.' ;
    rdfs:domain ind:SampleCollectionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceMonitoringFlag rdf:type rdf:Property ;
    rdfs:label 'Compliance Monitoring Flag' ;
    rdfs:comment 'Indicates whether this sample is part of regulatory compliance monitoring (true) or operational/investigative monitoring (false). Compliance samples have stricter QA/QC and reporting requirements.' ;
    rdfs:domain ind:Laboratory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fieldResidualChlorineMgL rdf:type rdf:Property ;
    rdfs:label 'Field Residual Chlorine Mg L' ;
    rdfs:comment 'Free or total chlorine residual measured at the time of collection in mg/L. Critical disinfection parameter for drinking water distribution system monitoring.' ;
    rdfs:domain ind:SampleCollectionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:preservativeUsed rdf:type rdf:Property ;
    rdfs:label 'Preservative Used' ;
    rdfs:comment 'Chemical preservative added to the sample at the time of collection (e.g., sulfuric acid, nitric acid, sodium thiosulfate). Required for certain analytes to maintain sample integrity.' ;
    rdfs:domain ind:SampleCollectionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collectedByEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Collected By Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: Chain of custody regulatory compliance requires documented employee accountability for sample collection. EPA and state regulations mandate traceable custody records with employee identification for l' ;
    rdfs:domain ind:ChainOfCustody ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:collectionDatetime rdf:type rdf:Property ;
    rdfs:label 'Collection Datetime' ;
    rdfs:comment 'Date and time when the sample was originally collected from the field location. Critical for hold time compliance and regulatory defensibility.' ;
    rdfs:domain ind:ChainOfCustody ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:collectorSignature rdf:type rdf:Property ;
    rdfs:label 'Collector Signature' ;
    rdfs:comment 'Digital or scanned signature of the sample collector. Required for legal chain of custody documentation.' ;
    rdfs:domain ind:ChainOfCustody ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:containerCount rdf:type rdf:Property ;
    rdfs:label 'Container Count' ;
    rdfs:comment 'Number of sample containers included in this custody transfer. Used to verify completeness of sample delivery.' ;
    rdfs:domain ind:ChainOfCustody ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:courierName rdf:type rdf:Property ;
    rdfs:label 'Courier Name' ;
    rdfs:comment 'Name of the courier service or individual responsible for transporting samples. Applicable when transfer involves third-party transport.' ;
    rdfs:domain ind:ChainOfCustody ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:courierTrackingNumber rdf:type rdf:Property ;
    rdfs:label 'Courier Tracking Number' ;
    rdfs:comment 'Tracking number provided by courier service for shipment traceability. Used to verify delivery and resolve custody disputes.' ;
    rdfs:domain ind:ChainOfCustody ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:custodyDocumentNumber rdf:type rdf:Property ;
    rdfs:label 'Custody Document Number' ;
    rdfs:comment 'Externally-known unique document number for the chain of custody form. Used for legal traceability and audit purposes. Format: COC-YYYYMMDD-XXXXXX.' ;
    rdfs:domain ind:ChainOfCustody ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:custodyStatus rdf:type rdf:Property ;
    rdfs:label 'Custody Status' ;
    rdfs:comment 'Current lifecycle status of the chain of custody record. Tracks progression from sample collection through final disposition.' ;
    rdfs:domain ind:ChainOfCustody ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:discrepancyDescription rdf:type rdf:Property ;
    rdfs:label 'Discrepancy Description' ;
    rdfs:comment 'Detailed description of any discrepancies noted during custody transfer. Required for corrective action and regulatory reporting.' ;
    rdfs:domain ind:ChainOfCustody ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:discrepancyNoted rdf:type rdf:Property ;
    rdfs:label 'Discrepancy Noted' ;
    rdfs:comment 'Indicates whether any discrepancies were noted during the custody transfer (e.g., missing samples, damaged containers, documentation errors).' ;
    rdfs:domain ind:ChainOfCustody ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:icePresent rdf:type rdf:Property ;
    rdfs:label 'Ice Present' ;
    rdfs:comment 'Indicates whether ice or cooling packs were present in the sample cooler at the time of receipt. Required for temperature-sensitive samples.' ;
    rdfs:domain ind:ChainOfCustody ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:preservationVerified rdf:type rdf:Property ;
    rdfs:label 'Preservation Verified' ;
    rdfs:comment 'Indicates whether the sample preservation was verified at receipt (e.g., pH check for acid preservation). Required for regulatory compliance.' ;
    rdfs:domain ind:ChainOfCustody ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:receivedBy rdf:type rdf:Property ;
    rdfs:label 'Received By' ;
    rdfs:comment 'Full name of the person receiving custody of the sample during this transfer event. Part of the legal custody chain.' ;
    rdfs:domain ind:ChainOfCustody ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:receivedSignature rdf:type rdf:Property ;
    rdfs:label 'Received Signature' ;
    rdfs:comment 'Digital or scanned signature of the person receiving custody. Required for legal chain of custody documentation.' ;
    rdfs:domain ind:ChainOfCustody ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relinquishedBy rdf:type rdf:Property ;
    rdfs:label 'Relinquished By' ;
    rdfs:comment 'Full name of the person relinquishing custody of the sample during this transfer event. Part of the legal custody chain.' ;
    rdfs:domain ind:ChainOfCustody ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relinquishedDatetime rdf:type rdf:Property ;
    rdfs:label 'Relinquished Datetime' ;
    rdfs:comment 'Date and time when custody was relinquished by the transferring party. Critical for establishing unbroken custody chain.' ;
    rdfs:domain ind:ChainOfCustody ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:relinquishedSignature rdf:type rdf:Property ;
    rdfs:label 'Relinquished Signature' ;
    rdfs:comment 'Digital or scanned signature of the person relinquishing custody. Required for legal chain of custody documentation.' ;
    rdfs:domain ind:ChainOfCustody ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sampleConditionAtTransfer rdf:type rdf:Property ;
    rdfs:label 'Sample Condition At Transfer' ;
    rdfs:comment 'Observed physical condition of the sample at the time of custody transfer. Critical for determining sample integrity and data usability.' ;
    rdfs:domain ind:ChainOfCustody ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:sealIntact rdf:type rdf:Property ;
    rdfs:label 'Seal Intact' ;
    rdfs:comment 'Indicates whether the custody seal on the sample container or cooler was intact at the time of transfer. Critical for establishing sample integrity.' ;
    rdfs:domain ind:ChainOfCustody ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:temperatureAtReceiptC rdf:type rdf:Property ;
    rdfs:label 'Temperature At Receipt C' ;
    rdfs:comment 'Measured temperature of the sample or cooler at the time of receipt. Must be within acceptable range (typically 0-6°C) for regulatory compliance.' ;
    rdfs:domain ind:ChainOfCustody ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:temperatureCompliant rdf:type rdf:Property ;
    rdfs:label 'Temperature Compliant' ;
    rdfs:comment 'Indicates whether the sample temperature at receipt was within the acceptable range specified by the analytical method. Non-compliance may invalidate results.' ;
    rdfs:domain ind:ChainOfCustody ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:transferType rdf:type rdf:Property ;
    rdfs:label 'Transfer Type' ;
    rdfs:comment 'Classification of the custody transfer event. Identifies the stage in the sample lifecycle where custody changed hands.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accreditationBody rdf:type rdf:Property ;
    rdfs:label 'Accreditation Body' ;
    rdfs:comment 'Name of the accreditation or certification body that granted laboratory certification for this method (e.g., State Department of Health, EPA, NELAC, A2LA).' ;
    rdfs:domain ind:Laboratory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accreditationDate rdf:type rdf:Property ;
    rdfs:label 'Accreditation Date' ;
    rdfs:comment 'Date on which the laboratory received accreditation for this test method.' ;
    rdfs:domain ind:TestMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:accreditationExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Accreditation Expiration Date' ;
    rdfs:comment 'Date on which the current accreditation for this test method expires and requires renewal.' ;
    rdfs:domain ind:Laboratory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:accreditationStatus rdf:type rdf:Property ;
    rdfs:label 'Accreditation Status' ;
    rdfs:comment 'Current accreditation status of the laboratory for this specific test method under state or federal certification programs.' ;
    rdfs:domain ind:Laboratory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:analysisCost rdf:type rdf:Property ;
    rdfs:label 'Analysis Cost' ;
    rdfs:comment 'Standard cost per sample analysis for this method, used for budgeting and billing purposes.' ;
    rdfs:domain ind:TestMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:analystCertificationRequired rdf:type rdf:Property ;
    rdfs:label 'Analyst Certification Required' ;
    rdfs:comment 'Indicates whether analysts must hold specific certification or training credentials to perform this method.' ;
    rdfs:domain ind:TestMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:analyteGroup rdf:type rdf:Property ;
    rdfs:label 'Analyte Group' ;
    rdfs:comment 'The specific analyte or group of analytes measured by this method (e.g., Trace Metals, Volatile Organic Compounds, Total Coliform, Turbidity, PFAS).' ;
    rdfs:domain ind:Laboratory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicableMatrixTypes rdf:type rdf:Property ;
    rdfs:label 'Applicable Matrix Types' ;
    rdfs:comment 'Comma-separated list of sample matrix types for which this method is validated and approved (e.g., drinking water, wastewater, source water, groundwater, soil, sludge, biosolids).' ;
    rdfs:domain ind:TestMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:detectionTechnique rdf:type rdf:Property ;
    rdfs:label 'Detection Technique' ;
    rdfs:comment 'The analytical detection or measurement technique employed by the method (e.g., ICP-MS, GC-MS, LC-MS/MS, colorimetric, titration, UV spectrophotometry, membrane filtration, enzyme substrate).' ;
    rdfs:domain ind:TestMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:instrumentRequired rdf:type rdf:Property ;
    rdfs:label 'Instrument Required' ;
    rdfs:comment 'Type of analytical instrument required to perform this method (e.g., ICP-MS, GC-MS, UV-Vis Spectrophotometer, Incubator).' ;
    rdfs:domain ind:TestMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interferences rdf:type rdf:Property ;
    rdfs:label 'Interferences' ;
    rdfs:comment 'Known interferences or matrix effects that may impact method accuracy or precision, as documented in the method reference.' ;
    rdfs:domain ind:TestMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:limsMethodCode rdf:type rdf:Property ;
    rdfs:label 'Lims Method Code' ;
    rdfs:comment 'Unique identifier for this test method in the laboratory LIMS system (LabWare or equivalent), used for system integration and data traceability.' ;
    rdfs:domain ind:TestMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mdlUnit rdf:type rdf:Property ;
    rdfs:label 'Mdl Unit' ;
    rdfs:comment 'Unit of measure for the MDL value (e.g., mg/L, µg/L, CFU/100mL, NTU, MPN/100mL).' ;
    rdfs:domain ind:Laboratory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mdlValue rdf:type rdf:Property ;
    rdfs:label 'Mdl Value' ;
    rdfs:comment 'The Method Detection Limit - the minimum concentration of an analyte that can be measured and reported with 99% confidence that the value is greater than zero.' ;
    rdfs:domain ind:TestMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:methodCategory rdf:type rdf:Property ;
    rdfs:label 'Method Category' ;
    rdfs:comment 'High-level classification of the test method by analyte category (inorganic, organic, microbiological, physical, radiological, emerging contaminants).' ;
    rdfs:domain ind:TestMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:methodCode rdf:type rdf:Property ;
    rdfs:label 'Method Code' ;
    rdfs:comment 'Standardized code identifying the analytical test method (e.g., EPA 200.8, SM 2130B, EPA 524.2, ASTM D1067). This is the externally-recognized identifier used in regulatory reporting and laboratory documentation.' ;
    rdfs:domain ind:TestMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:methodDescription rdf:type rdf:Property ;
    rdfs:label 'Method Description' ;
    rdfs:comment 'Detailed technical description of the analytical procedure, including sample preparation, analysis steps, and calculation methods.' ;
    rdfs:domain ind:TestMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:methodSource rdf:type rdf:Property ;
    rdfs:label 'Method Source' ;
    rdfs:comment 'The authoritative source or publishing organization of the method (e.g., EPA, Standard Methods, ASTM, ISO, USGS).' ;
    rdfs:domain ind:TestMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:methodStatus rdf:type rdf:Property ;
    rdfs:label 'Method Status' ;
    rdfs:comment 'Current operational status of the test method in the laboratory (active, inactive, under validation, obsolete, suspended).' ;
    rdfs:domain ind:TestMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:methodVersion rdf:type rdf:Property ;
    rdfs:label 'Method Version' ;
    rdfs:comment 'Version or revision number of the method (e.g., Rev 5.4, 23rd Edition, 2017 version).' ;
    rdfs:domain ind:TestMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pqlUnit rdf:type rdf:Property ;
    rdfs:label 'Pql Unit' ;
    rdfs:comment 'Unit of measure for the PQL value (e.g., mg/L, µg/L, CFU/100mL, NTU, MPN/100mL).' ;
    rdfs:domain ind:TestMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pqlValue rdf:type rdf:Property ;
    rdfs:label 'Pql Value' ;
    rdfs:comment 'The Practical Quantitation Limit - the lowest concentration that can be reliably measured within specified limits of precision and accuracy during routine laboratory operations.' ;
    rdfs:domain ind:TestMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:preservationRequirements rdf:type rdf:Property ;
    rdfs:label 'Preservation Requirements' ;
    rdfs:comment 'Required sample preservation techniques and conditions (e.g., cool to 4°C, acidify to pH<2 with HNO3, add sodium thiosulfate, protect from light).' ;
    rdfs:domain ind:TestMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:proficiencyTestingRequired rdf:type rdf:Property ;
    rdfs:label 'Proficiency Testing Required' ;
    rdfs:comment 'Indicates whether successful proficiency testing is required for laboratory certification for this method.' ;
    rdfs:domain ind:Laboratory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:qcRequirements rdf:type rdf:Property ;
    rdfs:label 'Qc Requirements' ;
    rdfs:comment 'Summary of quality control requirements for the method including frequency of blanks, duplicates, spikes, and control standards.' ;
    rdfs:domain ind:TestMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryAcceptance rdf:type rdf:Property ;
    rdfs:label 'Regulatory Acceptance' ;
    rdfs:comment 'Comma-separated list of regulatory programs that accept this method for compliance monitoring (e.g., SDWA, CWA, NPDES, state-specific programs).' ;
    rdfs:domain ind:TestMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportingLimit rdf:type rdf:Property ;
    rdfs:label 'Reporting Limit' ;
    rdfs:comment 'The minimum concentration at which results are reported to clients or regulatory agencies, typically equal to or greater than the PQL.' ;
    rdfs:domain ind:Laboratory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reportingLimitUnit rdf:type rdf:Property ;
    rdfs:label 'Reporting Limit Unit' ;
    rdfs:comment 'Unit of measure for the reporting limit (e.g., mg/L, µg/L, CFU/100mL, NTU).' ;
    rdfs:domain ind:TestMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supersededByMethodCode rdf:type rdf:Property ;
    rdfs:label 'Superseded By Method Code' ;
    rdfs:comment 'Method code of the replacement method if this method has been superseded. Null if still current.' ;
    rdfs:domain ind:TestMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:turnaroundTimeDays rdf:type rdf:Property ;
    rdfs:label 'Turnaround Time Days' ;
    rdfs:comment 'Standard turnaround time in business days from sample receipt to result reporting for routine analysis.' ;
    rdfs:domain ind:TestMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:calibrationCurveId rdf:type rdf:Property ;
    rdfs:label 'Calibration Curve Id' ;
    rdfs:comment 'Reference to the instrument calibration curve used to convert raw instrument response to analyte concentration. Links to calibration standards, curve coefficients, and correlation coefficient (R²).' ;
    rdfs:domain ind:Laboratory ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CalibrationCurve .

ind:primaryAnalyticalCertifiedAnalystId rdf:type rdf:Property ;
    rdfs:label 'Primary Analytical Certified Analyst Id' ;
    rdfs:comment 'Reference to the certified laboratory analyst who performed the test. Used for quality assurance, proficiency tracking, and regulatory audit trails.' ;
    rdfs:domain ind:AnalyticalTest ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CertifiedAnalyst .

ind:tertiaryAnalyticalApprovedByAnalystCertifiedAnalystId rdf:type rdf:Property ;
    rdfs:label 'Tertiary Analytical Approved By Analyst Certified Analyst Id' ;
    rdfs:comment 'Reference to the laboratory director or authorized signatory who provided final approval for the test result. Approved results are certified for regulatory reporting and external release.' ;
    rdfs:domain ind:AnalyticalTest ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CertifiedAnalyst .

ind:accreditationNumber rdf:type rdf:Property ;
    rdfs:label 'Accreditation Number' ;
    rdfs:comment 'Unique certificate or license number issued by the accreditation body authorizing the laboratory to perform this test method. Must be current and valid for regulatory reporting.' ;
    rdfs:domain ind:Laboratory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:holdTimeCompliantFlag rdf:type rdf:Property ;
    rdfs:label 'Hold Time Compliant Flag' ;
    rdfs:comment 'Indicates whether the test was performed within the maximum allowable time between sample collection and analysis. Hold times vary by analyte and method (e.g., 48 hours for bacteria, 28 days for metals). Non-compliance may invalidate results for regulatory reporting.' ;
    rdfs:domain ind:AnalyticalTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:limsImportTimestamp rdf:type rdf:Property ;
    rdfs:label 'Lims Import Timestamp' ;
    rdfs:comment 'Date and time when this test record was imported from the source Laboratory Information Management System (LabWare) into the enterprise data lakehouse. Used for data lineage and reconciliation.' ;
    rdfs:domain ind:AnalyticalTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:matrixType rdf:type rdf:Property ;
    rdfs:label 'Matrix Type' ;
    rdfs:comment 'Classification of the sample medium being analyzed. Matrix type affects method selection, quality control requirements, and regulatory applicability. Different matrices may require different preparation techniques and have different interference profiles. [ENUM-REF-CANDIDATE: drinking_water|raw_water|wastewater|groundwater|surface_water|biosolids|soil|sediment — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:AnalyticalTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rawInstrumentResponse rdf:type rdf:Property ;
    rdfs:label 'Raw Instrument Response' ;
    rdfs:comment 'Uncorrected measurement value directly from the analytical instrument before applying dilution factors, calibration curves, or other corrections. Retained for audit trails and method validation.' ;
    rdfs:domain ind:AnalyticalTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:resultUnit rdf:type rdf:Property ;
    rdfs:label 'Result Unit' ;
    rdfs:comment 'Unit of measure for the result value (e.g., mg/L, ug/L, NTU, MPN/100mL, pH units, CFU/100mL). Must align with regulatory reporting requirements and Maximum Contaminant Level (MCL) units.' ;
    rdfs:domain ind:AnalyticalTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewTimestamp rdf:type rdf:Property ;
    rdfs:label 'Review Timestamp' ;
    rdfs:comment 'Date and time when the test result was reviewed and validated by a senior analyst or supervisor. Marks transition from preliminary to reviewed status.' ;
    rdfs:domain ind:Laboratory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:testComments rdf:type rdf:Property ;
    rdfs:label 'Test Comments' ;
    rdfs:comment 'Free-text field for analyst notes, observations, or explanations regarding unusual conditions, deviations from standard procedures, or result interpretation. May include details on matrix interference, instrument issues, or quality control anomalies.' ;
    rdfs:domain ind:AnalyticalTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:testCompletionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Test Completion Timestamp' ;
    rdfs:comment 'Date and time when the analytical test procedure was completed and raw results were recorded. Used to calculate turnaround time and verify hold time compliance.' ;
    rdfs:domain ind:AnalyticalTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:testPriority rdf:type rdf:Property ;
    rdfs:label 'Test Priority' ;
    rdfs:comment 'Business priority classification for the analytical test. STAT tests require immediate processing for operational decisions; regulatory tests support compliance reporting deadlines; routine tests follow standard turnaround times.' ;
    rdfs:domain ind:AnalyticalTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:testStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Test Start Timestamp' ;
    rdfs:comment 'Date and time when the analytical test procedure was initiated. Critical for hold time compliance and contact time (CT) calculations for disinfection validation.' ;
    rdfs:domain ind:AnalyticalTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:uncertaintyValue rdf:type rdf:Property ;
    rdfs:label 'Uncertainty Value' ;
    rdfs:comment 'Quantified estimate of the doubt associated with the measurement result, expressed in the same units as the result. Includes contributions from sampling, sample preparation, calibration, and instrument variability.' ;
    rdfs:domain ind:AnalyticalTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:originalResultTestResultId rdf:type rdf:Property ;
    rdfs:label 'Original Result Test Result Id' ;
    rdfs:comment 'Reference to the original test result record if this result is a reanalysis. Links reanalysis results back to the initial result for audit trail and comparison purposes. Null if this is the first analysis.' ;
    rdfs:domain ind:TestResult ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TestResult .

ind:accreditationFlag rdf:type rdf:Property ;
    rdfs:label 'Accreditation Flag' ;
    rdfs:comment 'Boolean flag indicating whether this result was produced under laboratory accreditation (e.g., ISO/IEC 17025, state certification program). True indicates the result was produced by an accredited laboratory using an accredited method; False indicates non-accredited analysis.' ;
    rdfs:domain ind:TestResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:approvedResultFlag rdf:type rdf:Property ;
    rdfs:label 'Approved Result Flag' ;
    rdfs:comment 'Boolean flag indicating whether this result has been reviewed and approved by a qualified analyst or laboratory supervisor. True indicates the result has passed all quality control checks and is released for reporting; False indicates the result is pending review or has been rejected.' ;
    rdfs:domain ind:TestResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:blankContaminationFlag rdf:type rdf:Property ;
    rdfs:label 'Blank Contamination Flag' ;
    rdfs:comment 'Boolean flag indicating whether the method blank analyzed in the same batch showed detectable contamination of the target analyte. True indicates blank contamination was detected, which may affect result interpretation.' ;
    rdfs:domain ind:TestResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:detectionStatus rdf:type rdf:Property ;
    rdfs:label 'Detection Status' ;
    rdfs:comment 'Indicates whether the analyte was detected in the sample. Values: detected (analyte present above Method Detection Limit), non-detect (analyte not detected or below MDL), trace (analyte detected but below quantitation limit), below_mdl (result below Method Detection Limit), above_mdl (result above Method Detection Limit and quantifiable).' ;
    rdfs:domain ind:TestResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:duplicateRelativePercentDifference rdf:type rdf:Property ;
    rdfs:label 'Duplicate Relative Percent Difference' ;
    rdfs:comment 'Relative percent difference between the sample result and its duplicate, calculated as (|Sample - Duplicate| / Average) × 100. Indicates the precision of the analytical method. Acceptable ranges are method-specific (typically <20%).' ;
    rdfs:domain ind:Laboratory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:holdingTimeComplianceFlag rdf:type rdf:Property ;
    rdfs:label 'Holding Time Compliance Flag' ;
    rdfs:comment 'Boolean flag indicating whether the sample was analyzed within the method-specified holding time (time between sample collection and analysis). True indicates compliance; False indicates holding time was exceeded, which may affect result validity.' ;
    rdfs:domain ind:Laboratory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:matrixSpikeRecoveryPercent rdf:type rdf:Property ;
    rdfs:label 'Matrix Spike Recovery Percent' ;
    rdfs:comment 'Percent recovery of the analyte from the matrix spike sample analyzed in the same batch. Indicates the accuracy of the method in the presence of the sample matrix. Acceptable ranges are method-specific (typically 75-125%).' ;
    rdfs:domain ind:TestResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:methodDetectionLimit rdf:type rdf:Property ;
    rdfs:label 'Method Detection Limit' ;
    rdfs:comment 'The minimum concentration of an analyte that can be measured and reported with 99% confidence that the value is greater than zero. Specific to the test method and laboratory instrumentation used.' ;
    rdfs:domain ind:TestResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:proficiencyTestFlag rdf:type rdf:Property ;
    rdfs:label 'Proficiency Test Flag' ;
    rdfs:comment 'Boolean flag indicating whether this result is from a proficiency testing (PT) sample used to evaluate laboratory performance. True indicates this is a PT result; False indicates a routine sample result.' ;
    rdfs:domain ind:Laboratory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reanalysisFlag rdf:type rdf:Property ;
    rdfs:label 'Reanalysis Flag' ;
    rdfs:comment 'Boolean flag indicating whether this result is from a reanalysis of the sample. True indicates the sample was reanalyzed due to quality control failure, holding time exceedance, or other issue with the initial analysis; False indicates this is the first analysis.' ;
    rdfs:domain ind:TestResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryThresholdUnit rdf:type rdf:Property ;
    rdfs:label 'Regulatory Threshold Unit' ;
    rdfs:comment 'Unit of measure for the regulatory threshold value. Must be compatible with the reporting_unit to enable valid comparison. [ENUM-REF-CANDIDATE: mg/L|ug/L|NTU|CFU/100mL|MPN/100mL|pH units|percent|ppm|ppb|SU — 10 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:TestResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryThresholdValue rdf:type rdf:Property ;
    rdfs:label 'Regulatory Threshold Value' ;
    rdfs:comment 'The applicable regulatory limit against which this result is compared (e.g., Maximum Contaminant Level (MCL), Maximum Contaminant Level Goal (MCLG), National Pollutant Discharge Elimination System (NPDES) effluent limit). Captured at the time of result approval to preserve the threshold in effect.' ;
    rdfs:domain ind:TestResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reportingTimestamp rdf:type rdf:Property ;
    rdfs:label 'Reporting Timestamp' ;
    rdfs:comment 'Date and time when the result was officially reported to the client or regulatory agency. Distinct from approval_timestamp which is internal laboratory validation; this marks external release.' ;
    rdfs:domain ind:TestResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:reportingUnit rdf:type rdf:Property ;
    rdfs:label 'Reporting Unit' ;
    rdfs:comment 'Unit of measure in which the result value is reported. Common units include milligrams per liter (mg/L), micrograms per liter (ug/L), Nephelometric Turbidity Units (NTU), Colony Forming Units per 100 milliliters (CFU/100mL), Most Probable Number per 100 milliliters (MPN/100mL), pH units, percent, parts per million (ppm), parts per billion (ppb), Standard Units (SU). [ENUM-REF-CANDIDATE: mg/L|ug/L|NTU|CFU/100mL|MPN/100mL|pH units|percent|ppm|ppb|SU — 10 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:TestResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:uncertaintyEstimate rdf:type rdf:Property ;
    rdfs:label 'Uncertainty Estimate' ;
    rdfs:comment 'Quantitative estimate of the uncertainty associated with the reported result, expressed in the same units as the result. Represents the range within which the true value is expected to lie with a specified confidence level (typically 95%).' ;
    rdfs:domain ind:TestResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:certifiedAnalystRequired rdf:type rdf:Property ;
    rdfs:label 'Certified Analyst Required' ;
    rdfs:comment 'Indicates whether samples under this plan must be analyzed by a state-certified or EPA-certified analyst. True for regulatory compliance samples; false for operational monitoring.' ;
    rdfs:domain ind:SamplingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:chainOfCustodyRequired rdf:type rdf:Property ;
    rdfs:label 'Chain Of Custody Required' ;
    rdfs:comment 'Indicates whether formal chain of custody documentation is required for samples collected under this plan. True for regulatory, legal, or enforcement-related samples; false for routine operational monitoring.' ;
    rdfs:domain ind:SamplingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:complianceThresholdReference rdf:type rdf:Property ;
    rdfs:label 'Compliance Threshold Reference' ;
    rdfs:comment 'Reference to the regulatory standard or internal guideline defining acceptable limits for analytes in this sampling plan (e.g., MCL, MCLG, NPDES permit limits, internal action levels). Detailed thresholds are managed in the quality domain.' ;
    rdfs:domain ind:SamplingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:limsIntegrationFlag rdf:type rdf:Property ;
    rdfs:label 'Lims Integration Flag' ;
    rdfs:comment 'Indicates whether this sampling plan is integrated with the LabWare LIMS system for automated sample tracking, result entry, and reporting. True for plans with LIMS integration; false for manual tracking.' ;
    rdfs:domain ind:Laboratory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:planCode rdf:type rdf:Property ;
    rdfs:label 'Plan Code' ;
    rdfs:comment 'Externally-known unique business identifier for the sampling plan, used in LIMS and regulatory reporting systems.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planName rdf:type rdf:Property ;
    rdfs:label 'Plan Name' ;
    rdfs:comment 'Human-readable name of the sampling plan describing its purpose and scope.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qaqcProtocol rdf:type rdf:Property ;
    rdfs:label 'Qaqc Protocol' ;
    rdfs:comment 'Reference to the QA/QC protocol or standard operating procedure governing quality control measures for this sampling plan (e.g., blank samples, duplicate samples, spike recovery, proficiency testing frequency).' ;
    rdfs:domain ind:Laboratory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryDriver rdf:type rdf:Property ;
    rdfs:label 'Regulatory Driver' ;
    rdfs:comment 'Primary regulatory framework or permit requirement driving this sampling plan: SDWA (Safe Drinking Water Act), NPDES (National Pollutant Discharge Elimination System), LCRR (Lead and Copper Rule Revisions), state primacy agency requirements, local ordinance, or none for operational plans.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revisionReason rdf:type rdf:Property ;
    rdfs:label 'Revision Reason' ;
    rdfs:comment 'Brief description of the reason for the most recent revision to this sampling plan (e.g., regulatory change, permit update, operational improvement, corrective action). Supports change control and audit trail.' ;
    rdfs:domain ind:Laboratory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:samplingPlanStatus rdf:type rdf:Property ;
    rdfs:label 'Sampling Plan Status' ;
    rdfs:comment 'Current lifecycle status of the sampling plan: draft (under development), active (in use), suspended (temporarily paused), retired (no longer used), archived (historical record).' ;
    rdfs:domain ind:SamplingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:samplingAssetRegistryId rdf:type rdf:Property ;
    rdfs:label 'Sampling Asset Registry Id' ;
    rdfs:comment 'Reference to the specific asset (pipe segment, valve, tank, outfall structure) at which sampling occurs. Links to IBM Maximo asset registry.' ;
    rdfs:domain ind:SamplingLocation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Registry .

ind:samplingRegistryId rdf:type rdf:Property ;
    rdfs:label 'Sampling Registry Id' ;
    rdfs:comment 'Reference to the specific asset (pipe segment, valve, tank, outfall structure) at which sampling occurs. Links to IBM Maximo asset registry.' ;
    rdfs:domain ind:SamplingLocation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Registry .

ind:accessibilityNotes rdf:type rdf:Property ;
    rdfs:label 'Accessibility Notes' ;
    rdfs:comment 'Free-text notes describing access requirements, restrictions, or special instructions for field sampling crews (e.g., key required, gate code, contact property owner).' ;
    rdfs:domain ind:SamplingLocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isComplianceLocation rdf:type rdf:Property ;
    rdfs:label 'Is Compliance Location' ;
    rdfs:comment 'Boolean flag indicating whether this location is designated for regulatory compliance monitoring (true) or operational monitoring only (false).' ;
    rdfs:domain ind:SamplingLocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lcrrTierClassification rdf:type rdf:Property ;
    rdfs:label 'Lcrr Tier Classification' ;
    rdfs:comment 'Tier classification under EPA Lead and Copper Rule Revisions (LCRR). Determines sampling frequency and priority for lead service line locations.' ;
    rdfs:domain ind:SamplingLocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:limsLocationCode rdf:type rdf:Property ;
    rdfs:label 'Lims Location Code' ;
    rdfs:comment 'Location code used in the LabWare LIMS system for sample tracking and chain of custody. May differ from the utility\'s internal location code.' ;
    rdfs:domain ind:SamplingLocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:npdesOutfallNumber rdf:type rdf:Property ;
    rdfs:label 'Npdes Outfall Number' ;
    rdfs:comment 'EPA-assigned NPDES permit outfall identifier for wastewater discharge points. Required for DMR reporting and compliance monitoring.' ;
    rdfs:domain ind:SamplingLocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryDesignation rdf:type rdf:Property ;
    rdfs:label 'Regulatory Designation' ;
    rdfs:comment 'Additional regulatory classification or designation for the sampling location (e.g., compliance monitoring point, operational monitoring point, special study site).' ;
    rdfs:domain ind:SamplingLocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:samplePointDescription rdf:type rdf:Property ;
    rdfs:label 'Sample Point Description' ;
    rdfs:comment 'Detailed description of the physical sampling point (e.g., tap type, valve location, manhole ID, outfall structure details).' ;
    rdfs:domain ind:SamplingLocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceArea rdf:type rdf:Property ;
    rdfs:label 'Service Area' ;
    rdfs:comment 'Service area or district designation for the sampling location. Used for operational reporting and customer communication.' ;
    rdfs:domain ind:Laboratory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:siteContactName rdf:type rdf:Property ;
    rdfs:label 'Site Contact Name' ;
    rdfs:comment 'Name of the on-site contact person or property owner who can provide access to the sampling location.' ;
    rdfs:domain ind:SamplingLocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:siteContactPhone rdf:type rdf:Property ;
    rdfs:label 'Site Contact Phone' ;
    rdfs:comment 'Phone number for the on-site contact person or property owner.' ;
    rdfs:domain ind:SamplingLocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:labAssetRegistryId rdf:type rdf:Property ;
    rdfs:label 'Lab Asset Registry Id' ;
    rdfs:comment 'Reference to the enterprise asset registry for this instrument, linking laboratory equipment to the broader asset management system for depreciation, warranty, and disposal tracking.' ;
    rdfs:domain ind:LabInstrument ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Registry .

ind:labRegistryId rdf:type rdf:Property ;
    rdfs:label 'Lab Registry Id' ;
    rdfs:comment 'Reference to the enterprise asset registry for this instrument, linking laboratory equipment to the broader asset management system for depreciation, warranty, and disposal tracking.' ;
    rdfs:domain ind:LabInstrument ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Registry .

ind:primaryLabCertifiedAnalystId rdf:type rdf:Property ;
    rdfs:label 'Primary Lab Certified Analyst Id' ;
    rdfs:comment 'Reference to the certified laboratory analyst who is the primary operator or custodian of this instrument, responsible for routine operation, calibration verification, and performance monitoring.' ;
    rdfs:domain ind:LabInstrument ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CertifiedAnalyst .

ind:annualServiceCost rdf:type rdf:Property ;
    rdfs:label 'Annual Service Cost' ;
    rdfs:comment 'Annual cost in USD for vendor service contract, preventive maintenance, and consumables for this instrument. Used for OPEX (Operating Expenditure) budgeting and total cost of ownership analysis.' ;
    rdfs:domain ind:LabInstrument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:certificationExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Certification Expiration Date' ;
    rdfs:comment 'Date the instrument\'s regulatory certification expires, after which it cannot be used for compliance testing until recertified. Applicable for instruments used in SDWA, NPDES, or state-mandated testing programs.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:labLocation rdf:type rdf:Property ;
    rdfs:label 'Lab Location' ;
    rdfs:comment 'Physical location of the instrument within the laboratory facility (e.g., \'Main Lab - Room 201\', \'WTP Lab - Bench 3\', \'WWTP Lab - Instrument Room\'). Used for operational logistics and sample routing.' ;
    rdfs:domain ind:LabInstrument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:limsInstrumentCode rdf:type rdf:Property ;
    rdfs:label 'Lims Instrument Code' ;
    rdfs:comment 'Unique instrument identifier in the laboratory\'s LIMS (Laboratory Information Management System), such as LabWare. Used for electronic data integration, sample tracking, and result validation workflows.' ;
    rdfs:domain ind:LabInstrument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextMaintenanceDueDate rdf:type rdf:Property ;
    rdfs:label 'Next Maintenance Due Date' ;
    rdfs:comment 'Scheduled date for the next preventive maintenance activity, calculated based on maintenance frequency and last maintenance date. Used for work order scheduling in CMMS (Computerized Maintenance Management System).' ;
    rdfs:domain ind:LabInstrument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:primaryTestMethod rdf:type rdf:Property ;
    rdfs:label 'Primary Test Method' ;
    rdfs:comment 'Primary analytical test method or Standard Method number that this instrument is configured to perform (e.g., \'EPA 200.8\', \'SM 2540 C\', \'EPA 300.0\', \'SM 2130 B\'). Links the instrument to specific regulatory-approved analytical procedures.' ;
    rdfs:domain ind:LabInstrument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:purchaseCost rdf:type rdf:Property ;
    rdfs:label 'Purchase Cost' ;
    rdfs:comment 'Original acquisition cost of the instrument in USD, used for asset valuation, depreciation calculations, and capital budgeting. Excludes installation and training costs unless capitalized.' ;
    rdfs:domain ind:LabInstrument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:secondaryTestMethods rdf:type rdf:Property ;
    rdfs:label 'Secondary Test Methods' ;
    rdfs:comment 'Comma-separated list of additional test methods or Standard Method numbers that this instrument can perform, beyond the primary method. Used for multi-parameter instruments or instruments with multiple configurations.' ;
    rdfs:domain ind:LabInstrument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceContractExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Service Contract Expiration Date' ;
    rdfs:comment 'Date the current vendor service contract expires, after which service calls will be billed separately or a new contract must be negotiated. Used for budgeting and contract renewal planning.' ;
    rdfs:domain ind:LabInstrument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:laboratoryAnalystEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Laboratory Analyst Employee Id' ;
    rdfs:comment 'Analyst who performed calibration' ;
    rdfs:domain ind:LaboratoryInstrumentCalibration ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:laboratoryCreatedByEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Laboratory Created By Employee Id' ;
    rdfs:domain ind:Laboratory ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:laboratoryEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Laboratory Employee Id' ;
    rdfs:comment 'FK to the employee who performed the calibration' ;
    rdfs:domain ind:LaboratoryInstrumentCalibration ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:laboratoryReagentStandardId rdf:type rdf:Property ;
    rdfs:label 'Laboratory Reagent Standard Id' ;
    rdfs:domain ind:LaboratoryInstrumentCalibration ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ReagentStandard .

ind:laboratoryResponsibleEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Laboratory Responsible Employee Id' ;
    rdfs:comment 'Employee responsible for implementing the corrective action.' ;
    rdfs:domain ind:Laboratory ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:acceptanceCriteriaHigh rdf:type rdf:Property ;
    rdfs:label 'Acceptance Criteria High' ;
    rdfs:domain ind:LaboratoryInstrumentCalibration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:acceptanceCriteriaLow rdf:type rdf:Property ;
    rdfs:label 'Acceptance Criteria Low' ;
    rdfs:domain ind:LaboratoryInstrumentCalibration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:adjustmentDescription rdf:type rdf:Property ;
    rdfs:label 'Adjustment Description' ;
    rdfs:comment 'Description of adjustment made' ;
    rdfs:domain ind:LaboratoryInstrumentCalibration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:adjustmentMade rdf:type rdf:Property ;
    rdfs:label 'Adjustment Made' ;
    rdfs:comment 'Whether an adjustment was made during calibration' ;
    rdfs:domain ind:LaboratoryInstrumentCalibration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:calibrationCurveRSquared rdf:type rdf:Property ;
    rdfs:label 'Calibration Curve R Squared' ;
    rdfs:comment 'R-squared value of the calibration curve' ;
    rdfs:domain ind:LaboratoryInstrumentCalibration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:calibrationLevel rdf:type rdf:Property ;
    rdfs:label 'Calibration Level' ;
    rdfs:comment 'Calibration level (single_point, multi_point, full_curve)' ;
    rdfs:domain ind:LaboratoryInstrumentCalibration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:calibrationRangeHigh rdf:type rdf:Property ;
    rdfs:label 'Calibration Range High' ;
    rdfs:comment 'High end of calibration range' ;
    rdfs:domain ind:LaboratoryInstrumentCalibration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:calibrationRangeLow rdf:type rdf:Property ;
    rdfs:label 'Calibration Range Low' ;
    rdfs:comment 'Low end of calibration range' ;
    rdfs:domain ind:LaboratoryInstrumentCalibration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:calibrationUnit rdf:type rdf:Property ;
    rdfs:label 'Calibration Unit' ;
    rdfs:comment 'Unit of calibration range' ;
    rdfs:domain ind:LaboratoryInstrumentCalibration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:canonicalQualityInstrumentCalibrationId rdf:type rdf:Property ;
    rdfs:label 'Canonical Quality Instrument Calibration Id' ;
    rdfs:domain ind:LaboratoryInstrumentCalibration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:laboratoryInstrumentCalibrationCategory rdf:type rdf:Property ;
    rdfs:label 'Laboratory Instrument Calibration Category' ;
    rdfs:domain ind:LaboratoryInstrumentCalibration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:laboratoryInstrumentCalibrationCode rdf:type rdf:Property ;
    rdfs:label 'Laboratory Instrument Calibration Code' ;
    rdfs:comment 'code for laboratory_instrument_calibration.' ;
    rdfs:domain ind:LaboratoryInstrumentCalibration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:continuingCalibrationVerificationPct rdf:type rdf:Property ;
    rdfs:label 'Continuing Calibration Verification Pct' ;
    rdfs:comment 'CCV recovery percentage' ;
    rdfs:domain ind:LaboratoryInstrumentCalibration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:correlationCoefficient rdf:type rdf:Property ;
    rdfs:label 'Correlation Coefficient' ;
    rdfs:comment 'R-squared value for calibration curve' ;
    rdfs:domain ind:LaboratoryInstrumentCalibration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:laboratoryInstrumentCalibrationDescription rdf:type rdf:Property ;
    rdfs:label 'Laboratory Instrument Calibration Description' ;
    rdfs:domain ind:LaboratoryInstrumentCalibration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deviationFromStandard rdf:type rdf:Property ;
    rdfs:label 'Deviation From Standard' ;
    rdfs:comment 'Percent deviation from expected standard value' ;
    rdfs:domain ind:LaboratoryInstrumentCalibration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:expectedResponse rdf:type rdf:Property ;
    rdfs:label 'Expected Response' ;
    rdfs:comment 'Expected instrument response' ;
    rdfs:domain ind:LaboratoryInstrumentCalibration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:initialCalibrationVerificationPct rdf:type rdf:Property ;
    rdfs:label 'Initial Calibration Verification Pct' ;
    rdfs:comment 'ICV recovery percentage' ;
    rdfs:domain ind:LaboratoryInstrumentCalibration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:intercept rdf:type rdf:Property ;
    rdfs:label 'Intercept' ;
    rdfs:comment 'Calibration curve intercept' ;
    rdfs:domain ind:LaboratoryInstrumentCalibration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:laboratoryInstrumentCalibrationNumber rdf:type rdf:Property ;
    rdfs:label 'Laboratory Instrument Calibration Number' ;
    rdfs:domain ind:LaboratoryInstrumentCalibration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:laboratoryInstrumentCalibrationType rdf:type rdf:Property ;
    rdfs:label 'Laboratory Instrument Calibration Type' ;
    rdfs:domain ind:LaboratoryInstrumentCalibration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:measuredResponse rdf:type rdf:Property ;
    rdfs:label 'Measured Response' ;
    rdfs:comment 'Instrument response to standard' ;
    rdfs:domain ind:LaboratoryInstrumentCalibration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:methodReference rdf:type rdf:Property ;
    rdfs:label 'Method Reference' ;
    rdfs:comment 'Analytical method requiring this calibration (e.g., EPA 524.2, SM 4500-Cl G).' ;
    rdfs:domain ind:LaboratoryInstrumentCalibration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:laboratoryInstrumentCalibrationName rdf:type rdf:Property ;
    rdfs:label 'Laboratory Instrument Calibration Name' ;
    rdfs:comment 'name for laboratory_instrument_calibration.' ;
    rdfs:domain ind:LaboratoryInstrumentCalibration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:numberOfCalibrationPoints rdf:type rdf:Property ;
    rdfs:label 'Number Of Calibration Points' ;
    rdfs:comment 'Number of calibration curve points' ;
    rdfs:domain ind:LaboratoryInstrumentCalibration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:numberOfStandards rdf:type rdf:Property ;
    rdfs:label 'Number Of Standards' ;
    rdfs:comment 'Number of calibration standards used.' ;
    rdfs:domain ind:LaboratoryInstrumentCalibration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:postCalibrationResponse rdf:type rdf:Property ;
    rdfs:label 'Post Calibration Response' ;
    rdfs:comment 'Instrument response after calibration adjustment' ;
    rdfs:domain ind:LaboratoryInstrumentCalibration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:preCalibrationResponse rdf:type rdf:Property ;
    rdfs:label 'Pre Calibration Response' ;
    rdfs:comment 'Instrument response before calibration adjustment' ;
    rdfs:domain ind:LaboratoryInstrumentCalibration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rSquaredAcceptanceLimit rdf:type rdf:Property ;
    rdfs:label 'R Squared Acceptance Limit' ;
    rdfs:comment 'Minimum acceptable R-squared value' ;
    rdfs:domain ind:LaboratoryInstrumentCalibration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rSquaredValue rdf:type rdf:Property ;
    rdfs:label 'R Squared Value' ;
    rdfs:comment 'R-squared value of calibration curve' ;
    rdfs:domain ind:LaboratoryInstrumentCalibration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:softwareVersion rdf:type rdf:Property ;
    rdfs:label 'Software Version' ;
    rdfs:comment 'Instrument software version' ;
    rdfs:domain ind:LaboratoryInstrumentCalibration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:standardExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Standard Expiry Date' ;
    rdfs:comment 'Expiry date of calibration standard' ;
    rdfs:domain ind:LaboratoryInstrumentCalibration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:standardReferenceMaterial rdf:type rdf:Property ;
    rdfs:label 'Standard Reference Material' ;
    rdfs:comment 'Reference material used for calibration' ;
    rdfs:domain ind:LaboratoryInstrumentCalibration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:standardVendor rdf:type rdf:Property ;
    rdfs:label 'Standard Vendor' ;
    rdfs:comment 'Vendor/manufacturer of calibration standard.' ;
    rdfs:domain ind:LaboratoryInstrumentCalibration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:laboratoryInstrumentCalibrationStatus rdf:type rdf:Property ;
    rdfs:label 'Laboratory Instrument Calibration Status' ;
    rdfs:comment 'Lifecycle status of the record.' ;
    rdfs:domain ind:LaboratoryInstrumentCalibration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qcEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Qc Employee Id' ;
    rdfs:comment 'Reference to the laboratory supervisor or QA officer who reviewed and approved the batch QC results. Ensures accountability for data validation decisions.' ;
    rdfs:domain ind:QcBatch ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:batchCompletionDatetime rdf:type rdf:Property ;
    rdfs:label 'Batch Completion Datetime' ;
    rdfs:comment 'Date and time when all analytical work for the batch was completed and results were recorded. Used to calculate batch processing time and ensure timely reporting.' ;
    rdfs:domain ind:QcBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:batchPreparationDatetime rdf:type rdf:Property ;
    rdfs:label 'Batch Preparation Datetime' ;
    rdfs:comment 'Date and time when the batch preparation or analytical run was initiated. Critical for hold time compliance and method-specific timing requirements.' ;
    rdfs:domain ind:QcBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:batchReviewDatetime rdf:type rdf:Property ;
    rdfs:label 'Batch Review Datetime' ;
    rdfs:comment 'Date and time when the QC batch was reviewed and acceptance status was assigned by the laboratory supervisor or quality assurance officer.' ;
    rdfs:domain ind:QcBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:batchSize rdf:type rdf:Property ;
    rdfs:label 'Batch Size' ;
    rdfs:comment 'Total number of samples (including field samples and QC samples) processed together in this batch. Used to verify batch integrity and compliance with method-specific batch size limits.' ;
    rdfs:domain ind:QcBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:duplicateAcceptanceStatus rdf:type rdf:Property ;
    rdfs:label 'Duplicate Acceptance Status' ;
    rdfs:comment 'QC acceptance status for the duplicate sample based on RPD limits. Fail status may indicate sample heterogeneity or analytical imprecision.' ;
    rdfs:domain ind:QcBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:duplicateSampleIncluded rdf:type rdf:Property ;
    rdfs:label 'Duplicate Sample Included' ;
    rdfs:comment 'Indicates whether a duplicate field sample was analyzed in this batch. Duplicates assess overall analytical precision for unspiked samples.' ;
    rdfs:domain ind:QcBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fieldSampleCount rdf:type rdf:Property ;
    rdfs:label 'Field Sample Count' ;
    rdfs:comment 'Number of actual field samples (non-QC samples) included in this batch. Excludes method blanks, laboratory control samples, and other QC samples.' ;
    rdfs:domain ind:QcBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lcsAcceptanceStatus rdf:type rdf:Property ;
    rdfs:label 'Lcs Acceptance Status' ;
    rdfs:comment 'QC acceptance status for the LCS based on percent recovery limits. Fail status indicates systematic bias and may require corrective action or batch reanalysis.' ;
    rdfs:domain ind:QcBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lcsExpectedValue rdf:type rdf:Property ;
    rdfs:label 'Lcs Expected Value' ;
    rdfs:comment 'Known or true concentration of the analyte in the laboratory control sample. Used to calculate percent recovery.' ;
    rdfs:domain ind:QcBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lcsIncluded rdf:type rdf:Property ;
    rdfs:label 'Lcs Included' ;
    rdfs:comment 'Indicates whether a laboratory control sample was included in this batch. LCS is a known-concentration standard used to verify method accuracy and instrument performance.' ;
    rdfs:domain ind:QcBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lcsMeasuredValue rdf:type rdf:Property ;
    rdfs:label 'Lcs Measured Value' ;
    rdfs:comment 'Analytical result obtained for the laboratory control sample. Compared against expected value to calculate percent recovery.' ;
    rdfs:domain ind:QcBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lcsPercentRecovery rdf:type rdf:Property ;
    rdfs:label 'Lcs Percent Recovery' ;
    rdfs:comment 'Calculated percent recovery for the LCS: (measured_value / expected_value) * 100. Must fall within method-specific acceptance limits (typically 80-120%) to validate batch accuracy.' ;
    rdfs:domain ind:QcBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:limsBatchCode rdf:type rdf:Property ;
    rdfs:label 'Lims Batch Code' ;
    rdfs:comment 'External batch identifier from the laboratory information management system (LabWare or similar). Used for integration and cross-system traceability.' ;
    rdfs:domain ind:Laboratory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:matrixSpikeAcceptanceStatus rdf:type rdf:Property ;
    rdfs:label 'Matrix Spike Acceptance Status' ;
    rdfs:comment 'QC acceptance status for the matrix spike based on percent recovery limits. Fail status may indicate matrix interference requiring method modification or result qualification.' ;
    rdfs:domain ind:QcBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:matrixSpikeDuplicateIncluded rdf:type rdf:Property ;
    rdfs:label 'Matrix Spike Duplicate Included' ;
    rdfs:comment 'Indicates whether a matrix spike duplicate was included in this batch. MSD is a second spiked aliquot of the same sample used to assess analytical precision through relative percent difference (RPD) calculation.' ;
    rdfs:domain ind:QcBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:matrixSpikeIncluded rdf:type rdf:Property ;
    rdfs:label 'Matrix Spike Included' ;
    rdfs:comment 'Indicates whether a matrix spike sample was included in this batch. Matrix spike is a field sample spiked with known analyte concentration to assess matrix interference and method accuracy in real sample matrices.' ;
    rdfs:domain ind:QcBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:matrixSpikePercentRecovery rdf:type rdf:Property ;
    rdfs:label 'Matrix Spike Percent Recovery' ;
    rdfs:comment 'Calculated percent recovery for the matrix spike. Evaluates the effect of sample matrix on analytical accuracy. Acceptance limits are method-specific.' ;
    rdfs:domain ind:QcBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:methodBlankAcceptanceStatus rdf:type rdf:Property ;
    rdfs:label 'Method Blank Acceptance Status' ;
    rdfs:comment 'QC acceptance status for the method blank based on method-specific criteria. Fail status indicates contamination and may require batch reanalysis.' ;
    rdfs:domain ind:QcBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:methodBlankIncluded rdf:type rdf:Property ;
    rdfs:label 'Method Blank Included' ;
    rdfs:comment 'Indicates whether a method blank (reagent blank) was included in this batch. Method blanks are required to detect contamination from reagents, glassware, or the analytical process.' ;
    rdfs:domain ind:QcBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:methodBlankResult rdf:type rdf:Property ;
    rdfs:label 'Method Blank Result' ;
    rdfs:comment 'Analytical result for the method blank. Should be below the method detection limit (MDL) to confirm no contamination. Elevated blank results may invalidate the entire batch.' ;
    rdfs:domain ind:QcBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:msdAcceptanceStatus rdf:type rdf:Property ;
    rdfs:label 'Msd Acceptance Status' ;
    rdfs:comment 'QC acceptance status for the MSD based on RPD limits. Fail status indicates poor precision and may require investigation or reanalysis.' ;
    rdfs:domain ind:QcBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:msdPercentRecovery rdf:type rdf:Property ;
    rdfs:label 'Msd Percent Recovery' ;
    rdfs:comment 'Calculated percent recovery for the matrix spike duplicate. Used in conjunction with MS recovery to calculate relative percent difference.' ;
    rdfs:domain ind:QcBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:msdRelativePercentDifference rdf:type rdf:Property ;
    rdfs:label 'Msd Relative Percent Difference' ;
    rdfs:comment 'Calculated RPD between matrix spike and matrix spike duplicate: |MS - MSD| / ((MS + MSD) / 2) * 100. Measures analytical precision; must meet method-specific limits (typically <20%).' ;
    rdfs:domain ind:QcBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:overallBatchAcceptanceStatus rdf:type rdf:Property ;
    rdfs:label 'Overall Batch Acceptance Status' ;
    rdfs:comment 'Final QC acceptance status for the entire batch based on all QC sample results. Accepted batches have all QC criteria met; rejected batches require reanalysis; conditional batches may have qualified results.' ;
    rdfs:domain ind:QcBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qcComments rdf:type rdf:Property ;
    rdfs:label 'Qc Comments' ;
    rdfs:comment 'Free-text field for documenting QC issues, corrective actions taken, deviations from standard procedures, or explanations for conditional acceptance. Critical for audit trail and regulatory compliance.' ;
    rdfs:domain ind:Laboratory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surrogateAcceptanceStatus rdf:type rdf:Property ;
    rdfs:label 'Surrogate Acceptance Status' ;
    rdfs:comment 'QC acceptance status for surrogate standards based on recovery limits. Fail status may indicate sample preparation problems or matrix interference.' ;
    rdfs:domain ind:QcBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surrogateIncluded rdf:type rdf:Property ;
    rdfs:label 'Surrogate Included' ;
    rdfs:comment 'Indicates whether surrogate standards were added to all samples in this batch. Surrogates are analyte-like compounds added before sample processing to monitor extraction and analytical efficiency.' ;
    rdfs:domain ind:QcBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:surrogatePercentRecovery rdf:type rdf:Property ;
    rdfs:label 'Surrogate Percent Recovery' ;
    rdfs:comment 'Average percent recovery for surrogate standards across the batch. Used to assess sample preparation and extraction efficiency. Method-specific acceptance limits apply.' ;
    rdfs:domain ind:QcBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:qcSampleId rdf:type rdf:Property ;
    rdfs:label 'Qc Sample Id' ;
    rdfs:comment 'Unique identifier for the quality control sample record. Primary key.' ;
    rdfs:domain ind:QcSample ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:primaryQcCertifiedAnalystId rdf:type rdf:Property ;
    rdfs:label 'Primary Qc Certified Analyst Id' ;
    rdfs:comment 'Reference to the certified laboratory analyst who performed the QC sample analysis. Required for chain of custody and accreditation compliance.' ;
    rdfs:domain ind:QcSample ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CertifiedAnalyst .

ind:concentrationUnit rdf:type rdf:Property ;
    rdfs:label 'Concentration Unit' ;
    rdfs:comment 'Unit of measure for the expected and measured concentration values. Common units include milligrams per liter (mg/L), micrograms per liter (ug/L), nanograms per liter (ng/L), parts per million (ppm), parts per billion (ppb), parts per trillion (ppt), Nephelometric Turbidity Units (NTU), Colony Forming Units per 100 milliliters (CFU/100mL), Most Probable Number per 100 milliliters (MPN/100mL), pH units, percent, and Standard Units (SU). [ENUM-REF-CANDIDATE: mg/L|ug/L|ng/L|ppm|ppb|ppt|NTU|CFU/100mL|MPN/100mL|pH_units|percent|SU — 12 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Laboratory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expectedConcentration rdf:type rdf:Property ;
    rdfs:label 'Expected Concentration' ;
    rdfs:comment 'The known or target concentration value for the QC sample. For LCS and CRM, this is the certified value; for matrix spikes, this is the spiked amount plus the native sample concentration; for blanks, this is typically zero.' ;
    rdfs:domain ind:QcSample ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:limsSampleNumber rdf:type rdf:Property ;
    rdfs:label 'Lims Sample Number' ;
    rdfs:comment 'Unique sample identifier assigned by the Laboratory Information Management System (LIMS), such as LabWare. Used for integration and cross-referencing between the data warehouse and the operational LIMS system.' ;
    rdfs:domain ind:QcSample ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lowerAcceptanceLimit rdf:type rdf:Property ;
    rdfs:label 'Lower Acceptance Limit' ;
    rdfs:comment 'Lower bound of the acceptable range for percent recovery or Relative Percent Difference (RPD). Defined by the analytical method, laboratory Standard Operating Procedure (SOP), or regulatory requirement. QC samples below this limit fail acceptance criteria.' ;
    rdfs:domain ind:QcSample ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:measuredConcentration rdf:type rdf:Property ;
    rdfs:label 'Measured Concentration' ;
    rdfs:comment 'The actual concentration value obtained from laboratory analysis of the QC sample. Used to calculate recovery and evaluate method performance.' ;
    rdfs:domain ind:QcSample ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nativeConcentration rdf:type rdf:Property ;
    rdfs:label 'Native Concentration' ;
    rdfs:comment 'Original concentration of the analyte in the sample before spiking, applicable to matrix spike and matrix spike duplicate QC types. Used in recovery calculations: recovery = (measured - native) / spike * 100.' ;
    rdfs:domain ind:QcSample ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:proficiencyTestProvider rdf:type rdf:Property ;
    rdfs:label 'Proficiency Test Provider' ;
    rdfs:comment 'Name of the external proficiency testing provider if this QC sample is part of a proficiency test (e.g., EPA, AWWA, Environmental Resource Associates). Null for routine internal QC samples.' ;
    rdfs:domain ind:QcSample ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qcSampleType rdf:type rdf:Property ;
    rdfs:label 'Qc Sample Type' ;
    rdfs:comment 'Type of quality control sample. Method blank verifies absence of contamination; Laboratory Control Sample (LCS) verifies method accuracy; Matrix Spike (MS) and Matrix Spike Duplicate (MSD) verify matrix interference and precision; field duplicate and field blank verify field collection procedures; surrogate spike verifies extraction efficiency; Certified Reference Material (CRM) verifies instrument calibration. [ENUM-REF-CANDIDATE: method_blank|laboratory_control_sample|matrix_spike|matrix_spike_duplicate|field_duplicate|field_blank|surrogate_spike|certified_reference_material — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:QcSample ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:spikeConcentration rdf:type rdf:Property ;
    rdfs:label 'Spike Concentration' ;
    rdfs:comment 'Concentration of analyte added to the sample for matrix spike, matrix spike duplicate, or surrogate spike QC types. Null for other QC types. Used to calculate percent recovery in the presence of sample matrix.' ;
    rdfs:domain ind:Laboratory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:upperAcceptanceLimit rdf:type rdf:Property ;
    rdfs:label 'Upper Acceptance Limit' ;
    rdfs:comment 'Upper bound of the acceptable range for percent recovery or Relative Percent Difference (RPD). Defined by the analytical method, laboratory Standard Operating Procedure (SOP), or regulatory requirement. QC samples above this limit fail acceptance criteria.' ;
    rdfs:domain ind:QcSample ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:certifiedEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Certified Employee Id' ;
    rdfs:comment 'Reference to the employee ID of the analysts direct supervisor or laboratory manager. Used for organizational hierarchy and approval workflows.' ;
    rdfs:domain ind:CertifiedAnalyst ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:primaryCertifiedEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Certified Employee Id' ;
    rdfs:comment 'Reference to the employee record in the workforce domain. Links the laboratory certification record to the underlying employee master data.' ;
    rdfs:domain ind:CertifiedAnalyst ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:analystFirstName rdf:type rdf:Property ;
    rdfs:label 'Analyst First Name' ;
    rdfs:comment 'First name of the certified laboratory analyst. Used for identification on laboratory reports and chain of custody documentation.' ;
    rdfs:domain ind:CertifiedAnalyst ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:analystLastName rdf:type rdf:Property ;
    rdfs:label 'Analyst Last Name' ;
    rdfs:comment 'Last name of the certified laboratory analyst. Used for identification on laboratory reports and chain of custody documentation.' ;
    rdfs:domain ind:CertifiedAnalyst ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:analystMiddleInitial rdf:type rdf:Property ;
    rdfs:label 'Analyst Middle Initial' ;
    rdfs:comment 'Middle initial of the certified laboratory analyst. Optional field for complete name identification.' ;
    rdfs:domain ind:CertifiedAnalyst ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:backgroundCheckDate rdf:type rdf:Property ;
    rdfs:label 'Background Check Date' ;
    rdfs:comment 'Date of the most recent background check or security clearance verification. Required for analysts working with sensitive data or in facilities subject to security regulations.' ;
    rdfs:domain ind:CertifiedAnalyst ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:certificationLevel rdf:type rdf:Property ;
    rdfs:label 'Certification Level' ;
    rdfs:comment 'Hierarchical level or grade of the certification indicating the complexity of analytical work the analyst is authorized to perform. Higher levels typically authorize more complex testing methods and supervisory responsibilities.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:certificationNumber rdf:type rdf:Property ;
    rdfs:label 'Certification Number' ;
    rdfs:comment 'Unique certification number or license number issued by the certifying body. This is the official credential identifier that must be referenced on laboratory reports and regulatory submissions.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:certificationType rdf:type rdf:Property ;
    rdfs:label 'Certification Type' ;
    rdfs:comment 'Type of laboratory certification held by the analyst. Categories include state drinking water analyst certification, wastewater operator certification, NELAC (National Environmental Laboratory Accreditation Conference) signatory authority, laboratory director certification, quality assurance officer certification, or specialty method certification.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:certifyingBody rdf:type rdf:Property ;
    rdfs:label 'Certifying Body' ;
    rdfs:comment 'Name of the organization or agency that issued the certification. Examples include state environmental agencies, EPA regional offices, NELAC accreditation bodies, or professional associations such as AWWA or WEF.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:continuingEducationHours rdf:type rdf:Property ;
    rdfs:label 'Continuing Education Hours' ;
    rdfs:comment 'Total number of continuing education hours or professional development units earned by the analyst in the current certification period. Required for certification renewal.' ;
    rdfs:domain ind:Laboratory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:instrumentQualifications rdf:type rdf:Property ;
    rdfs:label 'Instrument Qualifications' ;
    rdfs:comment 'Comma-separated list of laboratory instruments the analyst is trained and qualified to operate. Examples include ICP-MS (Inductively Coupled Plasma Mass Spectrometry), GC-MS (Gas Chromatography Mass Spectrometry), IC (Ion Chromatography), UV-Vis spectrophotometer, TOC (Total Organic Carbon) analyzer, etc.' ;
    rdfs:domain ind:CertifiedAnalyst ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:laboratoryAssignment rdf:type rdf:Property ;
    rdfs:label 'Laboratory Assignment' ;
    rdfs:comment 'Name or code of the laboratory facility or work center where the analyst is primarily assigned. Examples include Central Laboratory, WTP (Water Treatment Plant) Lab, WWTP (Wastewater Treatment Plant) Lab, or Field Testing Unit.' ;
    rdfs:domain ind:CertifiedAnalyst ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastProficiencyTestDate rdf:type rdf:Property ;
    rdfs:label 'Last Proficiency Test Date' ;
    rdfs:comment 'Date of the most recent proficiency testing event completed by the analyst. Used to track compliance with annual or semi-annual PT requirements.' ;
    rdfs:domain ind:Laboratory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:limsUserCode rdf:type rdf:Property ;
    rdfs:label 'Lims User Code' ;
    rdfs:comment 'User identifier for the analyst in the Laboratory Information Management System (LabWare or similar). Links the certification record to the analysts login and activity in the LIMS for audit trail and data integrity purposes.' ;
    rdfs:domain ind:CertifiedAnalyst ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:proficiencyTestingStatus rdf:type rdf:Property ;
    rdfs:label 'Proficiency Testing Status' ;
    rdfs:comment 'Status of the analysts participation in proficiency testing programs. Proficiency testing is required for NELAC accreditation and demonstrates the analysts ability to produce accurate results. Current status indicates successful completion of required PT samples.' ;
    rdfs:domain ind:CertifiedAnalyst ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qualityControlRole rdf:type rdf:Property ;
    rdfs:label 'Quality Control Role' ;
    rdfs:comment 'Role of the analyst in the laboratorys quality assurance and quality control program. Roles include bench analyst, data reviewer, QA officer, or technical director with oversight responsibilities.' ;
    rdfs:domain ind:CertifiedAnalyst ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recordSource rdf:type rdf:Property ;
    rdfs:label 'Record Source' ;
    rdfs:comment 'Identifier of the source system from which this certified analyst record originated. Examples include LIMS (LabWare), SAP HR, or manual certification tracking system.' ;
    rdfs:domain ind:Laboratory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:safetyTrainingDate rdf:type rdf:Property ;
    rdfs:label 'Safety Training Date' ;
    rdfs:comment 'Date of the most recent laboratory safety training completion. Required annually for OSHA compliance and includes topics such as chemical hygiene, hazardous waste handling, and emergency response.' ;
    rdfs:domain ind:CertifiedAnalyst ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:shiftAssignment rdf:type rdf:Property ;
    rdfs:label 'Shift Assignment' ;
    rdfs:comment 'Work shift to which the analyst is assigned. Relevant for 24/7 laboratory operations and emergency response coverage.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:signatoryAuthority rdf:type rdf:Property ;
    rdfs:label 'Signatory Authority' ;
    rdfs:comment 'Boolean flag indicating whether the analyst has signatory authority to approve and sign laboratory reports for regulatory submission. Signatory authority is typically restricted to senior analysts or laboratory directors who meet specific qualification criteria.' ;
    rdfs:domain ind:Laboratory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:specialtyAreas rdf:type rdf:Property ;
    rdfs:label 'Specialty Areas' ;
    rdfs:comment 'Comma-separated list of analytical specialty areas or matrices the analyst is qualified to work with. Examples include drinking water microbiology, wastewater metals, organic compounds, radiochemistry, or specific contaminant groups such as PFAS (Per- and Polyfluoroalkyl Substances) or DBPs (Disinfection Byproducts).' ;
    rdfs:domain ind:CertifiedAnalyst ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accreditationCertificateNumber rdf:type rdf:Property ;
    rdfs:label 'Accreditation Certificate Number' ;
    rdfs:comment 'The unique certificate number issued by the accrediting body for this accreditation.' ;
    rdfs:domain ind:Laboratory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accreditationCostUsd rdf:type rdf:Property ;
    rdfs:label 'Accreditation Cost Usd' ;
    rdfs:comment 'The total cost in US dollars for obtaining and maintaining this accreditation, including application fees, assessment fees, and proficiency testing costs.' ;
    rdfs:domain ind:Laboratory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:accreditationDocumentUrl rdf:type rdf:Property ;
    rdfs:label 'Accreditation Document Url' ;
    rdfs:comment 'URL or file path to the digital copy of the accreditation certificate and scope document.' ;
    rdfs:domain ind:Laboratory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accreditationScopeDescription rdf:type rdf:Property ;
    rdfs:label 'Accreditation Scope Description' ;
    rdfs:comment 'Detailed description of the accreditation scope, including the list of accredited analytes, matrices, and test methods covered under this accreditation.' ;
    rdfs:domain ind:Laboratory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accreditationType rdf:type rdf:Property ;
    rdfs:label 'Accreditation Type' ;
    rdfs:comment 'The type or program of accreditation granted (e.g., state primacy, NELAC/TNI, A2LA, DoD ELAP, ISO 17025).' ;
    rdfs:domain ind:Laboratory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conditionsOrDeficienciesNoted rdf:type rdf:Property ;
    rdfs:label 'Conditions Or Deficiencies Noted' ;
    rdfs:comment 'Any conditions, limitations, or deficiencies noted by the accrediting body during the last assessment. May include corrective action requirements.' ;
    rdfs:domain ind:Laboratory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:initialAccreditationDate rdf:type rdf:Property ;
    rdfs:label 'Initial Accreditation Date' ;
    rdfs:comment 'The date when the laboratory first received this accreditation from the accrediting body.' ;
    rdfs:domain ind:Laboratory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:proficiencyTestId rdf:type rdf:Property ;
    rdfs:label 'Proficiency Test Id' ;
    rdfs:comment 'Unique identifier for the proficiency testing study participation event.' ;
    rdfs:domain ind:Laboratory ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProficiencyTest .

ind:primaryProficiencyLabSampleId rdf:type rdf:Property ;
    rdfs:label 'Primary Proficiency Lab Sample Id' ;
    rdfs:comment 'Unique sample identifier assigned by the proficiency test provider.' ;
    rdfs:domain ind:ProficiencyTest ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:LabSample .

ind:proficiencyEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Proficiency Employee Id' ;
    rdfs:comment 'Reference to the quality assurance officer or supervisor who reviewed the proficiency test results.' ;
    rdfs:domain ind:ProficiencyTest ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:proficiencyReviewedByEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Proficiency Reviewed By Employee Id' ;
    rdfs:comment 'Reference to the quality assurance officer or supervisor who reviewed the proficiency test results.' ;
    rdfs:domain ind:ProficiencyTest ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:ptProviderId rdf:type rdf:Property ;
    rdfs:label 'Pt Provider Id' ;
    rdfs:comment 'Reference to the proficiency testing provider organization (ERA, NERL, LGC, etc.).' ;
    rdfs:domain ind:Laboratory ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PtProvider .

ind:accreditationField rdf:type rdf:Property ;
    rdfs:label 'Accreditation Field' ;
    rdfs:comment 'Field of accreditation or testing category this proficiency test supports (e.g., Drinking Water Chemistry, Microbiology).' ;
    rdfs:domain ind:Laboratory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accreditationImpact rdf:type rdf:Property ;
    rdfs:label 'Accreditation Impact' ;
    rdfs:comment 'Assessment of the impact of this proficiency test result on laboratory accreditation status.' ;
    rdfs:domain ind:Laboratory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignedValue rdf:type rdf:Property ;
    rdfs:label 'Assigned Value' ;
    rdfs:comment 'True or reference concentration value assigned by the proficiency test provider.' ;
    rdfs:domain ind:ProficiencyTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:participantCount rdf:type rdf:Property ;
    rdfs:label 'Participant Count' ;
    rdfs:comment 'Number of laboratories that participated in this proficiency test round.' ;
    rdfs:domain ind:ProficiencyTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:peerGroupMean rdf:type rdf:Property ;
    rdfs:label 'Peer Group Mean' ;
    rdfs:comment 'Mean value reported by all participating laboratories in the peer group.' ;
    rdfs:domain ind:ProficiencyTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:peerGroupStandardDeviation rdf:type rdf:Property ;
    rdfs:label 'Peer Group Standard Deviation' ;
    rdfs:comment 'Standard deviation of values reported by all participating laboratories in the peer group.' ;
    rdfs:domain ind:ProficiencyTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:percentileRank rdf:type rdf:Property ;
    rdfs:label 'Percentile Rank' ;
    rdfs:comment 'Percentile ranking of the laboratorys performance relative to all participants (0-100).' ;
    rdfs:domain ind:ProficiencyTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ptRound rdf:type rdf:Property ;
    rdfs:label 'Pt Round' ;
    rdfs:comment 'Round or cycle identifier for the proficiency test (e.g., 2024-Q1, Round 45).' ;
    rdfs:domain ind:ProficiencyTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ptStudyName rdf:type rdf:Property ;
    rdfs:label 'Pt Study Name' ;
    rdfs:comment 'Name of the proficiency testing study or program (e.g., WP-123, DMR-QA).' ;
    rdfs:domain ind:ProficiencyTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportReceiptDate rdf:type rdf:Property ;
    rdfs:label 'Report Receipt Date' ;
    rdfs:comment 'Date the laboratory received the final proficiency test report from the provider.' ;
    rdfs:domain ind:ProficiencyTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reportedValue rdf:type rdf:Property ;
    rdfs:label 'Reported Value' ;
    rdfs:comment 'Concentration value reported by the laboratory for the proficiency test sample.' ;
    rdfs:domain ind:ProficiencyTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sampleReceiptDate rdf:type rdf:Property ;
    rdfs:label 'Sample Receipt Date' ;
    rdfs:comment 'Date the proficiency test sample was received by the laboratory.' ;
    rdfs:domain ind:Laboratory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:submissionDeadline rdf:type rdf:Property ;
    rdfs:label 'Submission Deadline' ;
    rdfs:comment 'Deadline date by which the laboratory must submit results to the proficiency test provider.' ;
    rdfs:domain ind:ProficiencyTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:zScore rdf:type rdf:Property ;
    rdfs:label 'Z Score' ;
    rdfs:comment 'Statistical z-score calculated from the reported value, assigned value, and standard deviation, indicating performance relative to peer laboratories.' ;
    rdfs:domain ind:ProficiencyTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:resultValidationId rdf:type rdf:Property ;
    rdfs:label 'Result Validation Id' ;
    rdfs:comment 'Unique identifier for the result validation record. Primary key.' ;
    rdfs:domain ind:ResultValidation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:primaryResultEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Result Employee Id' ;
    rdfs:comment 'Reference to the certified analyst or data validator who performed the validation review. Must be a qualified individual per laboratory QA/QC protocols.' ;
    rdfs:domain ind:ResultValidation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:resultEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Result Employee Id' ;
    rdfs:comment 'Reference to the certified analyst or data validator who performed the validation review. Must be a qualified individual per laboratory QA/QC protocols.' ;
    rdfs:domain ind:ResultValidation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:reviewerId rdf:type rdf:Property ;
    rdfs:label 'Reviewer Id' ;
    rdfs:comment 'Reference to a secondary reviewer or quality assurance officer who performed independent review of the validation. Used in laboratories with multi-tier validation protocols.' ;
    rdfs:domain ind:ResultValidation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:validationBatchId rdf:type rdf:Property ;
    rdfs:label 'Validation Batch Id' ;
    rdfs:comment 'Reference to the validation batch if multiple results were validated together. Enables grouping of validation activities performed in a single review session.' ;
    rdfs:domain ind:Laboratory ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ValidationBatch .

ind:calibrationVerificationFlag rdf:type rdf:Property ;
    rdfs:label 'Calibration Verification Flag' ;
    rdfs:comment 'Indicates whether instrument calibration was current and verified at the time of analysis. True if calibration was valid, False if calibration issues were identified.' ;
    rdfs:domain ind:ResultValidation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:chainOfCustodyVerifiedFlag rdf:type rdf:Property ;
    rdfs:label 'Chain Of Custody Verified Flag' ;
    rdfs:comment 'Indicates whether the chain of custody documentation was complete and verified during validation. True if COC is intact and verified, False if discrepancies were found.' ;
    rdfs:domain ind:ResultValidation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dataReleaseTimestamp rdf:type rdf:Property ;
    rdfs:label 'Data Release Timestamp' ;
    rdfs:comment 'Date and time when the validated result was released for regulatory reporting, customer delivery, or internal use. Marks the completion of the validation and approval workflow.' ;
    rdfs:domain ind:Laboratory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:flagsRaisedCount rdf:type rdf:Property ;
    rdfs:label 'Flags Raised Count' ;
    rdfs:comment 'Number of quality flags or warnings raised during validation. Flags may indicate potential issues that do not necessarily result in rejection but require documentation.' ;
    rdfs:domain ind:ResultValidation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:methodComplianceFlag rdf:type rdf:Property ;
    rdfs:label 'Method Compliance Flag' ;
    rdfs:comment 'Indicates whether the analytical method was performed in full compliance with the approved EPA or Standard Method protocol. True if compliant, False if deviations occurred.' ;
    rdfs:domain ind:ResultValidation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:qcAcceptanceCriteriaMetFlag rdf:type rdf:Property ;
    rdfs:label 'Qc Acceptance Criteria Met Flag' ;
    rdfs:comment 'Indicates whether all quality control acceptance criteria (blanks, duplicates, spikes, surrogates, calibration verification) were met for this result. True if all QC passed, False if any QC failure occurred.' ;
    rdfs:domain ind:ResultValidation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:qualifiersApplied rdf:type rdf:Property ;
    rdfs:label 'Qualifiers Applied' ;
    rdfs:comment 'Data qualifiers or flags assigned to the result during validation. Common qualifiers include J (estimated value), U (non-detect), R (rejected), Q (quality control issue). Multiple qualifiers may be comma-separated.' ;
    rdfs:domain ind:ResultValidation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryDefensibilityFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Defensibility Flag' ;
    rdfs:comment 'Indicates whether the validated result meets the full defensibility standard required for regulatory reporting and potential legal proceedings. True if defensible, False if data quality issues compromise defensibility.' ;
    rdfs:domain ind:Laboratory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:resultsRejectedCount rdf:type rdf:Property ;
    rdfs:label 'Results Rejected Count' ;
    rdfs:comment 'Number of individual test results rejected during this validation review. Used for quality metrics and laboratory performance tracking.' ;
    rdfs:domain ind:ResultValidation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:validationCriteriaApplied rdf:type rdf:Property ;
    rdfs:label 'Validation Criteria Applied' ;
    rdfs:comment 'Description of the specific validation criteria, checklists, or protocols applied during the review. May reference EPA method requirements, laboratory SOP numbers, or regulatory program-specific validation rules.' ;
    rdfs:domain ind:ResultValidation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:validationDisposition rdf:type rdf:Property ;
    rdfs:label 'Validation Disposition' ;
    rdfs:comment 'Final outcome of the validation review. Accepted: result meets all quality criteria and is released without qualification. Qualified: result is usable but carries data qualifiers or flags. Rejected: result fails validation and cannot be used for regulatory reporting.' ;
    rdfs:domain ind:ResultValidation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:validationDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Validation Duration Minutes' ;
    rdfs:comment 'Total time in minutes spent performing the validation review. Used for laboratory productivity metrics and resource planning.' ;
    rdfs:domain ind:ResultValidation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:validationFindings rdf:type rdf:Property ;
    rdfs:label 'Validation Findings' ;
    rdfs:comment 'Detailed narrative of validation findings, issues identified, corrective actions taken, and rationale for the final disposition. Critical for regulatory audit trail and data defensibility.' ;
    rdfs:domain ind:ResultValidation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:validationLevel rdf:type rdf:Property ;
    rdfs:label 'Validation Level' ;
    rdfs:comment 'The EPA validation protocol level applied to this result. Level I: basic data verification; Level II: analytical QC review; Level III: method and holding time compliance; Level IV: full data package audit for regulatory defensibility.' ;
    rdfs:domain ind:ResultValidation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:validationNotes rdf:type rdf:Property ;
    rdfs:label 'Validation Notes' ;
    rdfs:comment 'Additional notes, comments, or observations recorded by the validator during the review process. May include references to supporting documentation, communications with analysts, or special circumstances.' ;
    rdfs:domain ind:ResultValidation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:validatorCertificationNumber rdf:type rdf:Property ;
    rdfs:label 'Validator Certification Number' ;
    rdfs:comment 'Professional certification or license number of the validator. Required for regulatory defensibility under SDWA and CWA compliance programs.' ;
    rdfs:domain ind:ResultValidation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:validatorName rdf:type rdf:Property ;
    rdfs:label 'Validator Name' ;
    rdfs:comment 'Full name of the validator who performed the review. Provides human-readable identification for audit trail and regulatory reporting.' ;
    rdfs:domain ind:ResultValidation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preparedByEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Prepared By Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: QC/QA protocols require documented employee accountability for reagent preparation. Accreditation standards (TNI, NELAC) mandate traceable preparation records linking to qualified employees for method' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:associatedTestMethods rdf:type rdf:Property ;
    rdfs:label 'Associated Test Methods' ;
    rdfs:comment 'Comma-separated list of analytical test method codes or names for which this reagent or standard is used. Supports traceability of reagents to specific analytical procedures and regulatory compliance demonstrations.' ;
    rdfs:domain ind:ReagentStandard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:catalogNumber rdf:type rdf:Property ;
    rdfs:label 'Catalog Number' ;
    rdfs:comment 'Manufacturer or supplier catalog number for the reagent or standard. Used for reordering and traceability to supplier specifications.' ;
    rdfs:domain ind:ReagentStandard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:certifiedReferenceMaterialFlag rdf:type rdf:Property ;
    rdfs:label 'Certified Reference Material Flag' ;
    rdfs:comment 'Indicates whether this standard is a certified reference material with traceability to national or international measurement standards. True if CRM, false otherwise. CRMs are required for certain regulatory compliance testing.' ;
    rdfs:domain ind:ReagentStandard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:concentrationValue rdf:type rdf:Property ;
    rdfs:label 'Concentration Value' ;
    rdfs:comment 'Numeric concentration or purity of the reagent or standard as certified by the manufacturer or as prepared in the laboratory. Used in calibration calculations and quality control verification.' ;
    rdfs:domain ind:ReagentStandard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:currentStockQuantity rdf:type rdf:Property ;
    rdfs:label 'Current Stock Quantity' ;
    rdfs:comment 'Current quantity of the reagent or standard available in laboratory inventory. Updated as material is consumed or replenished.' ;
    rdfs:domain ind:ReagentStandard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:expiryDate rdf:type rdf:Property ;
    rdfs:label 'Expiry Date' ;
    rdfs:comment 'Date after which the reagent or standard should no longer be used for analytical testing due to potential degradation or loss of certified properties. Determined by manufacturer specifications or laboratory stability studies.' ;
    rdfs:domain ind:ReagentStandard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:preparationDate rdf:type rdf:Property ;
    rdfs:label 'Preparation Date' ;
    rdfs:comment 'Date on which the reagent or standard was prepared or diluted in the laboratory. For commercially prepared standards, this is the manufacture date. Critical for determining shelf life and expiry.' ;
    rdfs:domain ind:ReagentStandard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reagentName rdf:type rdf:Property ;
    rdfs:label 'Reagent Name' ;
    rdfs:comment 'Full chemical or commercial name of the reagent, standard, or reference material as provided by the manufacturer or as catalogued in the Laboratory Information Management System (LIMS).' ;
    rdfs:domain ind:ReagentStandard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reagentStandardStatus rdf:type rdf:Property ;
    rdfs:label 'Reagent Standard Status' ;
    rdfs:comment 'Current lifecycle status of the reagent or standard: active (in use), expired (past expiry date), depleted (stock exhausted), quarantined (under investigation or hold), or disposed (removed from inventory).' ;
    rdfs:domain ind:ReagentStandard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reagentType rdf:type rdf:Property ;
    rdfs:label 'Reagent Type' ;
    rdfs:comment 'Classification of the chemical material by its intended laboratory use: reagent for general analytical work, standard for calibration, reference material for quality control, buffer for pH adjustment, indicator for endpoint detection, or solvent for dilution and extraction.' ;
    rdfs:domain ind:ReagentStandard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reorderThreshold rdf:type rdf:Property ;
    rdfs:label 'Reorder Threshold' ;
    rdfs:comment 'Minimum stock quantity that triggers a reorder alert or procurement action. Ensures continuous availability of critical reagents and standards for analytical operations.' ;
    rdfs:domain ind:ReagentStandard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:safetyDataSheetReference rdf:type rdf:Property ;
    rdfs:label 'Safety Data Sheet Reference' ;
    rdfs:comment 'Reference identifier or file location for the Safety Data Sheet (SDS) associated with this reagent. SDS provides hazard information, handling instructions, and emergency procedures.' ;
    rdfs:domain ind:ReagentStandard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stockUnit rdf:type rdf:Property ;
    rdfs:label 'Stock Unit' ;
    rdfs:comment 'Unit of measure for the stock quantity: milliliters (mL), liters (L), grams (g), kilograms (kg), units, or vials.' ;
    rdfs:domain ind:ReagentStandard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:storageConditions rdf:type rdf:Property ;
    rdfs:label 'Storage Conditions' ;
    rdfs:comment 'Required environmental conditions for storing the reagent or standard to maintain stability and integrity: ambient temperature, refrigerated (2-8°C), frozen (<0°C), protected from light (dark), or under inert atmosphere.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verifiedBy rdf:type rdf:Property ;
    rdfs:label 'Verified By' ;
    rdfs:comment 'Name or identifier of the laboratory supervisor or quality assurance officer who verified the preparation or receipt of the reagent or standard. Ensures independent quality control.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:analyteStatus rdf:type rdf:Property ;
    rdfs:label 'Analyte Status' ;
    rdfs:comment 'Current status of the analyte in the laboratory catalog (active, inactive, retired, pending approval, under review).' ;
    rdfs:domain ind:Analyte ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:astmMethodCode rdf:type rdf:Property ;
    rdfs:label 'Astm Method Code' ;
    rdfs:comment 'The ASTM International standard method code(s) for measuring this analyte, if applicable. Multiple methods may be comma-separated.' ;
    rdfs:domain ind:Analyte ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:analyteCategory rdf:type rdf:Property ;
    rdfs:label 'Analyte Category' ;
    rdfs:comment 'Detailed sub-classification within the analyte group (e.g., heavy metals, volatile organic compounds, disinfection byproducts, indicator organisms).' ;
    rdfs:domain ind:Analyte ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:certifiedAnalystRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Certified Analyst Required Flag' ;
    rdfs:comment 'Indicates whether analysis of this analyte must be performed by a state-certified or specially trained analyst.' ;
    rdfs:domain ind:Analyte ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:analyteCode rdf:type rdf:Property ;
    rdfs:label 'Analyte Code' ;
    rdfs:comment 'Short alphanumeric code used to identify the analyte in laboratory systems and reports. Often corresponds to LIMS internal codes or regulatory parameter codes.' ;
    rdfs:domain ind:Analyte ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:defaultReportingUnit rdf:type rdf:Property ;
    rdfs:label 'Default Reporting Unit' ;
    rdfs:comment 'Standard unit of measure for reporting results for this analyte (e.g., mg/L, µg/L, CFU/100mL, NTU, pH units, pCi/L).' ;
    rdfs:domain ind:Analyte ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:epaMethodCode rdf:type rdf:Property ;
    rdfs:label 'Epa Method Code' ;
    rdfs:comment 'The EPA-approved analytical method code(s) for measuring this analyte (e.g., EPA 200.8, EPA 300.0, EPA 1103.1). Multiple methods may be comma-separated.' ;
    rdfs:domain ind:Analyte ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:healthEffect rdf:type rdf:Property ;
    rdfs:label 'Health Effect' ;
    rdfs:comment 'Summary of known or potential health effects associated with exposure to this analyte at elevated concentrations (e.g., gastrointestinal illness, neurological effects, increased cancer risk).' ;
    rdfs:domain ind:Analyte ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:limsIntegrationCode rdf:type rdf:Property ;
    rdfs:label 'Lims Integration Code' ;
    rdfs:comment 'The analyte identifier or code used in the LIMS (LabWare or similar) for system integration and data exchange.' ;
    rdfs:domain ind:Analyte ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minimumSampleVolumeMl rdf:type rdf:Property ;
    rdfs:label 'Minimum Sample Volume Ml' ;
    rdfs:comment 'Minimum volume of sample required for analysis of this analyte, expressed in milliliters.' ;
    rdfs:domain ind:Laboratory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:analyteName rdf:type rdf:Property ;
    rdfs:label 'Analyte Name' ;
    rdfs:comment 'Full descriptive name of the chemical, biological, or physical parameter being measured (e.g., Total Coliform, Lead, pH, Turbidity).' ;
    rdfs:domain ind:Analyte ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:proficiencyTestingRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Proficiency Testing Required Flag' ;
    rdfs:comment 'Indicates whether the laboratory must participate in proficiency testing programs for this analyte to maintain accreditation and regulatory compliance.' ;
    rdfs:domain ind:Analyte ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:qaqcRequirement rdf:type rdf:Property ;
    rdfs:label 'Qaqc Requirement' ;
    rdfs:comment 'Specific QA/QC protocols required for this analyte (e.g., matrix spike/matrix spike duplicate, laboratory control sample, method blank, field duplicate, proficiency testing frequency).' ;
    rdfs:domain ind:Analyte ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryClassification rdf:type rdf:Property ;
    rdfs:label 'Regulatory Classification' ;
    rdfs:comment 'Classification of the analyte based on regulatory requirements: primary MCL (Maximum Contaminant Level), secondary MCL, NPDES (National Pollutant Discharge Elimination System) parameter, PFAS (Per- and Polyfluoroalkyl Substances), DBP (Disinfection Byproduct), DBP precursor, unregulated, or action level. [ENUM-REF-CANDIDATE: primary_mcl|secondary_mcl|npdes_parameter|pfas|dbp|dbp_precursor|unregulated|action_level — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Analyte ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sampleMatrixApplicability rdf:type rdf:Property ;
    rdfs:label 'Sample Matrix Applicability' ;
    rdfs:comment 'The types of sample matrices for which this analyte is applicable (e.g., drinking water, wastewater, surface water, groundwater, biosolids, sludge). Multiple matrices may be comma-separated.' ;
    rdfs:domain ind:Analyte ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:seasonalMonitoringFlag rdf:type rdf:Property ;
    rdfs:label 'Seasonal Monitoring Flag' ;
    rdfs:comment 'Indicates whether monitoring for this analyte is required only during specific seasons or months (e.g., DBP monitoring during warmer months).' ;
    rdfs:domain ind:Analyte ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sourceOfContamination rdf:type rdf:Property ;
    rdfs:label 'Source Of Contamination' ;
    rdfs:comment 'Common sources or pathways by which this analyte enters water systems (e.g., naturally occurring, industrial discharge, agricultural runoff, corrosion of household plumbing, disinfection byproduct).' ;
    rdfs:domain ind:Analyte ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:standardMethodCode rdf:type rdf:Property ;
    rdfs:label 'Standard Method Code' ;
    rdfs:comment 'The Standard Methods for the Examination of Water and Wastewater method code(s) for measuring this analyte (e.g., SM 2320 B, SM 4500-Cl G). Multiple methods may be comma-separated.' ;
    rdfs:domain ind:Analyte ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:laboratoryCorrectiveActionId rdf:type rdf:Property ;
