ind:ageFactor rdf:type rdf:Property ;
    rdfs:label 'Age Factor' ;
    rdfs:comment 'Multiplicative factor based on member age.' ;
    rdfs:domain ind:RateDevelopment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:approvedTimestamp rdf:type rdf:Property ;
