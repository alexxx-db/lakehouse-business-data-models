  lead_time_days varchar [note: 'Lead time in days.']
  line_number varchar [note: 'Line number on the PO.']
  line_status varchar [note: 'Status of the line.']
  line_type varchar [note: 'Type of line item.']
  net_amount decimal(18,2) [note: 'Net line amount.']
  notes varchar [note: 'Additional notes.']
  ordered_quantity decimal(12,4) [note: 'Quantity ordered.']
  receipt_timestamp timestamp [note: 'When goods were received.']
  received_quantity decimal(12,4) [note: 'Quantity received.']
  tax_amount decimal(18,2) [note: 'Tax amount for the line.']
  tax_code decimal(18,2) [note: 'Tax code.']
  tax_rate decimal(5,2) [note: 'Tax rate for the line.']
  unit_price decimal(18,2) [note: 'Unit price.']
  uom varchar [note: 'Unit of measure.']
  updated_timestamp timestamp [note: 'Record last update timestamp.']
  waste_percentage decimal(5,2) [note: 'Expected waste percentage.']

  Note: 'Individual line items on a purchase order specifying items, quantities, prices, and delivery details.'
}

Table procurement.supplier_invoice {
  supplier_invoice_id varchar [pk, note: 'Primary key for the supplier invoice.']
  approved_by_employee_id varchar [note: 'Employee who approved the invoice.']
  contract_id varchar [note: 'Associated contract.']
  procurement_purchase_order_id varchar [note: 'Associated purchase order.']
  procurement_supplier_id varchar [note: 'Supplier who issued the invoice.']
