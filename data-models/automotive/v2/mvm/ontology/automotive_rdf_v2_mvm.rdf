    rdfs:range xsd:integer .

ind:confidenceScore rdf:type rdf:Property ;
    rdfs:label 'Confidence Score' ;
    rdfs:comment 'Confidence level (0.0000-1.0000) that the stored preference accurately reflects the customer\'s intent.' ;
    rdfs:domain ind:Preference ;
    rdf:type owl:DatatypeProperty ;
