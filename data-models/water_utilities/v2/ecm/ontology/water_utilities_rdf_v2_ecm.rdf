    rdfs:range xsd:date .

ind:secondaryContactPhone rdf:type rdf:Property ;
    rdfs:label 'Secondary Contact Phone' ;
    rdfs:comment 'Secondary or alternate telephone number for reaching the third party if primary contact fails.' ;
