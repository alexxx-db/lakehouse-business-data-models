  pacs_system_name varchar [note: 'PACS system name']
  patient_care_setting varchar [note: 'Patient care setting']
  patient_location_at_notification varchar [note: 'Patient location when notified']
  patient_safety_event_flag boolean [note: 'Whether this is a patient safety event']
  radiologist_npi varchar [note: 'NPI of radiologist']
