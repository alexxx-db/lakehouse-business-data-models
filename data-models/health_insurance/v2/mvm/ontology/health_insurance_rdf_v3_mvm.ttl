    rdfs:range xsd:string .

ind:authorizationEndDate rdf:type rdf:Property ;
    rdfs:label 'Authorization End Date' ;
    rdfs:comment 'Effective end date of the approved authorization period.' ;
    rdfs:domain ind:PaDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:authorizationPeriodType rdf:type rdf:Property ;
