ind:configurationTrimLevelModelId rdf:type rdf:Property ;
    rdfs:label 'Configuration Trim Level Model Id' ;
    rdfs:comment 'Foreign key linking to vehicle.vehicle_trim_level. Business justification: configuration currently stores trim_level as a STRING — a denormalized reference to the vehicle_trim_level catalog. vehicle_trim_level is the authoritative hierarchy of trim grades within a model-MY c' ;
