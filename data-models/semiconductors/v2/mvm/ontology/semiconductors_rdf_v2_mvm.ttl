    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rootCauseMethod rdf:type rdf:Property ;
    rdfs:label 'Root Cause Method' ;
    rdfs:comment 'Methodology used to determine the root cause (e.g., 5-Why, Ishikawa, FTA, Pareto).' ;
