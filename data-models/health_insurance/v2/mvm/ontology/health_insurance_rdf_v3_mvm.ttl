    rdfs:comment 'How the group pays for coverage: fully insured, ASO, or self-funded.' ;
    rdfs:domain ind:Employer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gfcCode rdf:type rdf:Property ;
    rdfs:label 'Gfc Code' ;
    rdfs:comment 'Link to the financial control entity responsible for the group\'s accounting.' ;
    rdfs:domain ind:Group ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:groupStatus rdf:type rdf:Property ;
    rdfs:label 'Group Status' ;
    rdfs:comment 'Current lifecycle state of the employer group relationship.' ;
    rdfs:domain ind:Group ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:headcountCurrent rdf:type rdf:Property ;
    rdfs:label 'Headcount Current' ;
    rdfs:comment 'Current total number of employees covered under the group plan.' ;
    rdfs:domain ind:Group ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:headcountLastMonth rdf:type rdf:Property ;
    rdfs:label 'Headcount Last Month' ;
    rdfs:comment 'Employee headcount as of the end of the previous month.' ;
    rdfs:domain ind:Group ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:headcountLastYear rdf:type rdf:Property ;
    rdfs:label 'Headcount Last Year' ;
    rdfs:comment 'Employee headcount as of the same month in the prior calendar year.' ;
    rdfs:domain ind:Group ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:legalName rdf:type rdf:Property ;
    rdfs:label 'Legal Name' ;
    rdfs:comment 'Full legal name of the employer organization as registered.' ;
    rdfs:domain ind:Group ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:naicsCode rdf:type rdf:Property ;
    rdfs:label 'Naics Code' ;
    rdfs:comment 'Six-digit code representing the employer\'s industry sector.' ;
    rdfs:domain ind:Group ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:participationRequirement rdf:type rdf:Property ;
    rdfs:label 'Participation Requirement' ;
    rdfs:comment 'Minimum employee participation level required for the group plan.' ;
    rdfs:domain ind:Group ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sicCode rdf:type rdf:Property ;
    rdfs:label 'Sic Code' ;
    rdfs:comment 'Four-digit code classifying the employer\'s primary industry.' ;
    rdfs:domain ind:Employer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sizeTier rdf:type rdf:Property ;
    rdfs:label 'Size Tier' ;
    rdfs:comment 'Categorization of the employer based on employee headcount.' ;
    rdfs:domain ind:Group ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxIdEin rdf:type rdf:Property ;
    rdfs:label 'Tax Id Ein' ;
    rdfs:comment 'Federal tax identification number for the employer, used for reporting and compliance.' ;
    rdfs:domain ind:Group ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:onSiteFacilityId rdf:type rdf:Property ;
    rdfs:label 'On Site Facility Id' ;
    rdfs:comment 'Foreign key linking to provider.facility. Business justification: Links employer on-site clinic locations to provider facilities, enabling employee access reporting and utilization analytics.' ;
    rdfs:domain ind:GroupLocation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Facility .

ind:geocodeAccuracy rdf:type rdf:Property ;
    rdfs:label 'Geocode Accuracy' ;
    rdfs:comment 'Indicates the precision of the latitude/longitude coordinates.' ;
    rdfs:domain ind:GroupLocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:groupLocationStatus rdf:type rdf:Property ;
    rdfs:label 'Group Location Status' ;
    rdfs:comment 'Current lifecycle status of the location record.' ;
    rdfs:domain ind:GroupLocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:locationCode rdf:type rdf:Property ;
    rdfs:label 'Location Code' ;
    rdfs:comment 'Business identifier code for the location used in billing and regulatory filings.' ;
    rdfs:domain ind:GroupLocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ratingArea rdf:type rdf:Property ;
    rdfs:label 'Rating Area' ;
    rdfs:comment 'Geographic rating area used for premium calculations.' ;
    rdfs:domain ind:HealthInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:zipPlus4 rdf:type rdf:Property ;
    rdfs:label 'Zip Plus4' ;
    rdfs:comment 'Extended ZIP+4 postal code.' ;
    rdfs:domain ind:GroupLocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:groupContactId rdf:type rdf:Property ;
    rdfs:label 'Group Contact Id' ;
    rdfs:comment 'System-generated unique identifier for the group contact record.' ;
    rdfs:domain ind:GroupContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:authorizationLevel rdf:type rdf:Property ;
    rdfs:label 'Authorization Level' ;
    rdfs:comment 'Level of authority the contact has for enrollment and billing actions.' ;
    rdfs:domain ind:GroupContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:canBill rdf:type rdf:Property ;
    rdfs:label 'Can Bill' ;
    rdfs:comment 'Indicates whether the contact is authorized to initiate billing or premium payment actions.' ;
    rdfs:domain ind:GroupContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:canEnroll rdf:type rdf:Property ;
    rdfs:label 'Can Enroll' ;
    rdfs:comment 'Indicates whether the contact is authorized to submit enrollment transactions.' ;
    rdfs:domain ind:GroupContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:department rdf:type rdf:Property ;
    rdfs:label 'Department' ;
    rdfs:comment 'Department or business unit where the contact works.' ;
    rdfs:domain ind:GroupContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:groupContactStatus rdf:type rdf:Property ;
    rdfs:label 'Group Contact Status' ;
    rdfs:comment 'Current lifecycle status of the contact record.' ;
    rdfs:domain ind:GroupContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preferredCommunicationChannel rdf:type rdf:Property ;
    rdfs:label 'Preferred Communication Channel' ;
    rdfs:comment 'Contact\'s preferred method for receiving communications.' ;
    rdfs:domain ind:GroupContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemContactReference rdf:type rdf:Property ;
    rdfs:label 'Source System Contact Reference' ;
    rdfs:comment 'Identifier for the contact as defined in the source system.' ;
    rdfs:domain ind:GroupContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:title rdf:type rdf:Property ;
    rdfs:label 'Title' ;
    rdfs:comment 'Professional title or position of the contact within the employer organization.' ;
    rdfs:domain ind:HealthInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contributionStrategyId rdf:type rdf:Property ;
    rdfs:label 'Contribution Strategy Id' ;
    rdfs:comment 'Foreign key linking to employer.contribution_strategy. Business justification: A group plan offering is governed by a specific contribution strategy that defines employer/employee cost-sharing. contribution_strategy is the SSOT for contribution rules and already has group_id and' ;
    rdfs:domain ind:Employer ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ContributionStrategy .

ind:contributionEffectiveEndDate rdf:type rdf:Property ;
    rdfs:label 'Contribution Effective End Date' ;
    rdfs:comment 'Date when the defined contribution strategy expires; null if ongoing.' ;
    rdfs:domain ind:GroupPlanOffering ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:contributionEffectiveStartDate rdf:type rdf:Property ;
    rdfs:label 'Contribution Effective Start Date' ;
    rdfs:comment 'Date when the defined contribution strategy becomes effective.' ;
    rdfs:domain ind:GroupPlanOffering ;
