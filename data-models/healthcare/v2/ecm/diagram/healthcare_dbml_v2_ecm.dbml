  coding_status varchar [note: 'Status of the coding (pending, complete, queried).']
  created_timestamp timestamp [note: 'Record creation timestamp.']
  diagnosis_rank varchar [note: 'Rank/sequence of the diagnosis.']
  diagnosis_seq_num varchar [note: 'Sequence number of the diagnosis.']
  diagnosis_source varchar [note: 'Source of the diagnosis (physician, coder, etc.).']
  diagnosis_type varchar [note: 'Type of diagnosis (admitting, principal, secondary).']
  drg_code varchar [note: 'DRG code associated with this diagnosis.']
  drg_relevance_flag boolean [note: 'Flag indicating relevance to DRG assignment.']
  drg_type varchar [note: 'DRG type.']
  encounter_diagnosis_comment varchar [note: 'Free-text comment about the diagnosis.']
  encounter_diagnosis_source_code varchar [note: 'Source system code for the diagnosis.']
  external_cause_code varchar [note: 'External cause ICD-10 code (E-code).']
  hai_flag boolean [note: 'Flag indicating healthcare-associated infection.']
  hcc_category_code varchar [note: 'HCC category code for risk adjustment.']
  hcc_flag boolean [note: 'Flag indicating HCC-relevant diagnosis.']
  icd10_code varchar [note: 'ICD-10 diagnosis code.']
  icd10_description varchar [note: 'ICD-10 diagnosis description.']
  icd10_version varchar [note: 'ICD-10 version year.']
  mental_health_flag boolean [note: 'Flag indicating mental health diagnosis.']
  onset_date date [note: 'Date of diagnosis onset.']
  poa_indicator varchar [note: 'Present on admission indicator (Y, N, U, W, 1).']
  primary_diagnosis_flag boolean [note: 'Flag indicating this is the primary diagnosis.']
  quality_measure_flag boolean [note: 'Flag indicating relevance to quality measures.']
  reportable_condition_flag boolean [note: 'Flag indicating reportable condition.']
  resolved_date date [note: 'Date when diagnosis was resolved.']
  sdoh_flag boolean [note: 'Flag indicating SDOH-related diagnosis (Z-code).']
  snomed_code varchar [note: 'SNOMED CT code.']
  substance_use_flag boolean [note: 'Flag indicating substance use disorder diagnosis.']
  updated_timestamp timestamp [note: 'Record last updated timestamp.']
  vibe_mutation_marker varchar
  vibe_structure_marker varchar
  visit_diagnosis_status varchar

  Note: 'Diagnosis codes associated with a visit, including POA indicators, DRG relevance, and coding status.'
}

Table encounter.visit_procedure {
  visit_procedure_id varchar [pk, note: 'Surrogate primary key for the visit procedure.']
