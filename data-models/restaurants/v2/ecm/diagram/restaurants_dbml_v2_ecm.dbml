  record_updated_timestamp timestamp [note: 'Record last update timestamp']
  total_invoices_evaluated varchar [note: 'Number of invoices in evaluation period']
  total_orders_evaluated varchar [note: 'Number of orders in evaluation period']

  Note: 'Periodic performance measurements for suppliers covering delivery, quality, and compliance metrics.'
}

Table supply.distribution_center {
  distribution_center_id varchar [pk, note: 'Primary key']
