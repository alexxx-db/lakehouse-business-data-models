Table foodsafety.haccp_plan {
  haccp_plan_id varchar [pk, note: 'Primary key for the HACCP plan']
  cost_center_id varchar [note: 'FK to finance cost center']
  employee_id varchar [note: 'FK to responsible employee']
  allergen_control_flag boolean [note: 'Whether allergen controls are included in this plan']
  approval_date date [note: 'Date the plan was approved']
  approval_status varchar [note: 'Current approval status of the plan']
  approved_by varchar [note: 'Name of person who approved the plan']
  audit_last_date date [note: 'Date of last audit of this plan']
  audit_next_due date [note: 'Date next audit is due']
  audit_status varchar [note: 'Current audit status']
  compliance_status varchar [note: 'Overall compliance status of the plan']
  corrective_action_procedure varchar [note: 'Description of corrective action procedures']
  critical_control_points varchar [note: 'Summary of critical control points in the plan']
  document_status varchar [note: 'Status of the plan document']
  document_url varchar [note: 'URL to the plan document']
  effective_from date [note: 'Start date of plan effectiveness']
  effective_until date [note: 'End date of plan effectiveness']
  hazard_analysis_summary varchar [note: 'Summary of hazard analysis']
  last_review_date date [note: 'Date of last review']
  lifecycle_status varchar [note: 'Current lifecycle status of the plan']
  monitoring_frequency varchar [note: 'How often monitoring occurs']
  next_review_date date [note: 'Date of next scheduled review']
  non_conformance_count varchar [note: 'Number of non-conformances found']
  plan_code varchar [note: 'Unique code for the plan']
  plan_name varchar [note: 'Name of the HACCP plan']
  plan_type varchar [note: 'Type/category of the plan']
  plan_version varchar [note: 'Version identifier of the plan']
  record_audit_created timestamp [note: 'Timestamp when record was created']
  record_audit_updated timestamp [note: 'Timestamp when record was last updated']
  regulatory_framework varchar [note: 'Applicable regulatory framework']
  revision_number varchar [note: 'Current revision number']
  risk_level varchar [note: 'Overall risk level assessment']
  sanitation_schedule_reference varchar [note: 'Reference to associated sanitation schedule']
  scope_description varchar [note: 'Description of plan scope']
  temperature_log_reference varchar [note: 'Reference to temperature log']
  temperature_monitoring_required_flag boolean [note: 'Whether temperature monitoring is required']
  training_completion_date date [note: 'Date training was completed']
  training_required_flag boolean [note: 'Whether training is required for this plan']

  Note: 'HACCP (Hazard Analysis Critical Control Points) plan documents for food safety management'
}

Table foodsafety.critical_control_point {
  critical_control_point_id varchar [pk, note: 'Primary key']
  haccp_plan_id varchar [note: 'FK to parent HACCP plan']
  responsible_employee_id varchar [note: 'FK to responsible employee']
  average_deviation_value decimal(18,2) [note: 'Average deviation from critical limits']
  corrective_action_procedure varchar [note: 'Procedure for corrective actions']
