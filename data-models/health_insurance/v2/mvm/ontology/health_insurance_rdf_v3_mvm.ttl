    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:authorizationStartDate rdf:type rdf:Property ;
    rdfs:label 'Authorization Start Date' ;
    rdfs:comment 'Effective start date of the approved authorization period.' ;
    rdfs:domain ind:PaDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:authorizationUnits rdf:type rdf:Property ;
    rdfs:label 'Authorization Units' ;
    rdfs:comment 'Unit of measure for the authorized quantity.' ;
