    rdfs:domain ind:CapacityAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reassessmentRecommended rdf:type rdf:Property ;
    rdfs:label 'Reassessment Recommended' ;
    rdfs:comment 'Reassessment recommended' ;
    rdfs:domain ind:CapacityAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:surrogateRequired rdf:type rdf:Property ;
    rdfs:label 'Surrogate Required' ;
    rdfs:comment 'Surrogate decision maker needed' ;
    rdfs:domain ind:CapacityAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:understandingScore rdf:type rdf:Property ;
    rdfs:label 'Understanding Score' ;
    rdfs:comment 'Understanding component score' ;
    rdfs:domain ind:CapacityAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:parentCompliancePolicyId rdf:type rdf:Property ;
    rdfs:label 'Parent Compliance Policy Id' ;
    rdfs:comment 'Foreign key linking to compliance.policy. Business justification: Consent-specific policies are often subordinate to or reference broader organizational compliance policies. Establishes policy hierarchy for governance, ensures consent policies align with enterprise ' ;
    rdfs:domain ind:ConsentPolicy ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CompliancePolicy .

ind:primaryConsentEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Consent Employee Id' ;
    rdfs:comment 'Identifier of the user or role responsible for maintaining and updating this consent policy.' ;
    rdfs:domain ind:ConsentPolicy ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:primarySupersededByConsentPolicyId rdf:type rdf:Property ;
    rdfs:label 'Primary Superseded By Consent Policy Id' ;
    rdfs:comment 'Reference to the consent policy that supersedes this policy. Populated when policy status is \'superseded\'. Null for active policies.' ;
    rdfs:domain ind:ConsentPolicy ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ConsentPolicy .

ind:tertiaryConsentLastUpdatedByUserEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Tertiary Consent Last Updated By User Employee Id' ;
    rdfs:comment 'Identifier of the user who last modified this consent policy record.' ;
    rdfs:domain ind:ConsentPolicy ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:capacityAssessmentRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Capacity Assessment Required Flag' ;
    rdfs:comment 'Indicates whether a formal capacity assessment is required before obtaining consent under this policy. True if capacity assessment is mandatory, False otherwise.' ;
    rdfs:domain ind:ConsentPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:capacityAssessmentTriggers rdf:type rdf:Property ;
    rdfs:label 'Capacity Assessment Triggers' ;
    rdfs:comment 'Specific conditions or circumstances that trigger the requirement for a capacity assessment (e.g., cognitive impairment, altered mental status, high-risk procedure). Multiple triggers separated by semicolons.' ;
    rdfs:domain ind:ConsentPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentationRequirements rdf:type rdf:Property ;
    rdfs:label 'Documentation Requirements' ;
    rdfs:comment 'Detailed description of documentation requirements for consent obtained under this policy, including required forms, signatures, attestations, and supporting materials.' ;
    rdfs:domain ind:ConsentPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyCode rdf:type rdf:Property ;
    rdfs:label 'Policy Code' ;
    rdfs:comment 'Unique business identifier code for the consent policy, used for external reference and system integration.' ;
    rdfs:domain ind:ConsentPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reconsentIntervalMonths rdf:type rdf:Property ;
    rdfs:label 'Reconsent Interval Months' ;
    rdfs:comment 'Number of months after which consent must be renewed if time-based re-consent is required. Null if time-based re-consent does not apply.' ;
    rdfs:domain ind:ConsentPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reconsentTriggerNewRisk rdf:type rdf:Property ;
    rdfs:label 'Reconsent Trigger New Risk' ;
    rdfs:comment 'Indicates whether the discovery of significant new risks triggers the requirement for re-consent under this policy. True if new risk requires re-consent, False otherwise.' ;
    rdfs:domain ind:ConsentPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reconsentTriggerProtocolAmendment rdf:type rdf:Property ;
    rdfs:label 'Reconsent Trigger Protocol Amendment' ;
    rdfs:comment 'Indicates whether a protocol amendment triggers the requirement for re-consent under this policy (primarily applicable to research consent). True if protocol amendment requires re-consent, False otherwise.' ;
    rdfs:domain ind:ConsentPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reconsentTriggerTimeBased rdf:type rdf:Property ;
    rdfs:label 'Reconsent Trigger Time Based' ;
    rdfs:comment 'Indicates whether consent expires after a defined time period and requires renewal under this policy. True if time-based re-consent is required, False otherwise.' ;
    rdfs:domain ind:ConsentPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryCitations rdf:type rdf:Property ;
    rdfs:label 'Regulatory Citations' ;
    rdfs:comment 'Specific regulatory citations, statutes, or code sections that apply to this consent policy (e.g., 45 CFR 164.508, 21 CFR 50.25). Multiple citations separated by semicolons.' ;
    rdfs:domain ind:ConsentPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requiredConsentElements rdf:type rdf:Property ;
    rdfs:label 'Required Consent Elements' ;
    rdfs:comment 'Comma-separated list of mandatory elements that must be included in consent documentation governed by this policy (e.g., purpose, risks, benefits, alternatives, right to refuse, right to revoke).' ;
    rdfs:domain ind:ConsentPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

