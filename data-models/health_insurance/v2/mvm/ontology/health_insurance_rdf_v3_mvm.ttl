ind:obligationType rdf:type rdf:Property ;
    rdfs:label 'Obligation Type' ;
    rdfs:comment 'Category of the regulatory requirement.' ;
    rdfs:domain ind:RegulatoryObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:penaltyAmount rdf:type rdf:Property ;
    rdfs:label 'Penalty Amount' ;
    rdfs:comment 'Monetary penalty for non-compliance.' ;
    rdfs:domain ind:RegulatoryObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:penaltyCurrency rdf:type rdf:Property ;
    rdfs:label 'Penalty Currency' ;
    rdfs:comment 'Currency of the penalty amount.' ;
    rdfs:domain ind:RegulatoryObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referenceUrl rdf:type rdf:Property ;
    rdfs:label 'Reference Url' ;
    rdfs:comment 'Link to the official regulation or guidance document.' ;
    rdfs:domain ind:RegulatoryObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryFramework rdf:type rdf:Property ;
    rdfs:label 'Regulatory Framework' ;
    rdfs:comment 'Framework or statute under which the obligation falls (e.g., HIPAA, ACA, Medicare, State Law).' ;
    rdfs:domain ind:RegulatoryObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportingFrequencyMonths rdf:type rdf:Property ;
    rdfs:label 'Reporting Frequency Months' ;
    rdfs:comment 'Number of months between required reports.' ;
    rdfs:domain ind:RegulatoryObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:riskImpact rdf:type rdf:Property ;
    rdfs:label 'Risk Impact' ;
    rdfs:comment 'Potential business impact if the obligation is not met.' ;
    rdfs:domain ind:RegulatoryObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskLikelihood rdf:type rdf:Property ;
    rdfs:label 'Risk Likelihood' ;
    rdfs:comment 'Likelihood of non-compliance occurring.' ;
    rdfs:domain ind:RegulatoryObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submissionDeadline rdf:type rdf:Property ;
    rdfs:label 'Submission Deadline' ;
    rdfs:comment 'Final date for filing required reports or documents.' ;
    rdfs:domain ind:RegulatoryObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:memberHccAssignmentId rdf:type rdf:Property ;
    rdfs:label 'Member Hcc Assignment Id' ;
    rdfs:comment 'System-generated unique identifier for the member HCC assignment record.' ;
    rdfs:domain ind:MemberHccAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:coefficientApplied rdf:type rdf:Property ;
    rdfs:label 'Coefficient Applied' ;
    rdfs:comment 'The actual coefficient value from the hcc_mapping that was applied in this assignment. Stored redundantly to support historical analysis when model coefficients change year-over-year.' ;
    rdfs:domain ind:MemberHccAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:diagnosisSource rdf:type rdf:Property ;
    rdfs:label 'Diagnosis Source' ;
    rdfs:comment 'Source system or data collection method from which the diagnosis (and thus the HCC) was captured. Critical for RADV audit defense and data completeness tracking.' ;
    rdfs:domain ind:MemberHccAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hccCodes rdf:type rdf:Property ;
    rdfs:label 'Hcc Codes' ;
    rdfs:comment 'Pipe-separated list of HCC codes contributing to the score. [Moved from member_risk_score: This pipe-separated STRING field on member_risk_score is a denormalized representation of the M:N relationship. By normalizing into member_hcc_assignment, each HCC code becomes a separate record with its own contribution_amount, status, and source. This enables proper HCC-level analytics and eliminates the need to parse delimited strings.]' ;
    rdfs:domain ind:MemberHccAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hccContributionAmount rdf:type rdf:Property ;
    rdfs:label 'Hcc Contribution Amount' ;
    rdfs:comment 'The numeric RAF score contribution from this specific HCC to the member\'s total risk score. This is the product of the HCC coefficient and any applicable adjustment factors.' ;
    rdfs:domain ind:MemberHccAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hccStatus rdf:type rdf:Property ;
    rdfs:label 'Hcc Status' ;
    rdfs:comment 'Current processing status of this HCC assignment. Tracks whether the HCC is actively contributing to the RAF score, suppressed by hierarchy rules, excluded by CMS, or pending validation.' ;
    rdfs:domain ind:MemberHccAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .
