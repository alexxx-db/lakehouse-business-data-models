ind:insurancePolicyNumber rdf:type rdf:Property ;
    rdfs:label 'Insurance Policy Number' ;
    rdfs:comment 'Policy number of the carrier\'s liability insurance.' ;
    rdfs:domain ind:Automotive ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:insuranceProvider rdf:type rdf:Property ;
    rdfs:label 'Insurance Provider' ;
    rdfs:comment 'Name of the insurance company covering the carrier\'s operations.' ;
    rdfs:domain ind:Carrier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastAuditDate rdf:type rdf:Property ;
    rdfs:label 'Last Audit Date' ;
    rdfs:comment 'Date of the most recent compliance or safety audit performed on the carrier.' ;
    rdfs:domain ind:Automotive ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:operatingRegions rdf:type rdf:Property ;
    rdfs:label 'Operating Regions' ;
    rdfs:comment 'Geographic regions (e.g., continents, countries) where the carrier provides service.' ;
    rdfs:domain ind:Carrier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:performanceRating rdf:type rdf:Property ;
    rdfs:label 'Performance Rating' ;
    rdfs:comment 'Overall performance score (0-5) derived from on-time delivery, safety, and cost metrics.' ;
    rdfs:domain ind:Carrier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scacCode rdf:type rdf:Property ;
    rdfs:label 'Scac Code' ;
    rdfs:comment 'Four-letter code uniquely identifying the carrier in North American logistics.' ;
    rdfs:domain ind:Carrier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:state rdf:type rdf:Property ;
    rdfs:label 'State' ;
    rdfs:comment 'State or province of the carrier\'s primary business address.' ;
    rdfs:domain ind:Automotive ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxIdentifier rdf:type rdf:Property ;
    rdfs:label 'Tax Identifier' ;
    rdfs:comment 'Government-issued tax identifier for the carrier.' ;
    rdfs:domain ind:Automotive ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tier rdf:type rdf:Property ;
    rdfs:label 'Tier' ;
    rdfs:comment 'Strategic tier assigned to the carrier based on volume, reliability, and strategic importance.' ;
    rdfs:domain ind:Carrier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transportModes rdf:type rdf:Property ;
    rdfs:label 'Transport Modes' ;
    rdfs:comment 'Transport modes the carrier is authorized to operate.' ;
    rdfs:domain ind:Carrier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:website rdf:type rdf:Property ;
    rdfs:label 'Website' ;
    rdfs:comment 'Public website URL of the carrier.' ;
    rdfs:domain ind:Carrier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capacityUnits rdf:type rdf:Property ;
    rdfs:label 'Capacity Units' ;
    rdfs:comment 'Maximum number of vehicles the compound can store.' ;
    rdfs:domain ind:VehicleCompound ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:complianceCertifications rdf:type rdf:Property ;
    rdfs:label 'Compliance Certifications' ;
    rdfs:comment 'Comma-separated list of certifications (e.g., ISO-9001, IATF-16949) held by the compound.' ;
    rdfs:domain ind:VehicleCompound ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:compoundCode rdf:type rdf:Property ;
    rdfs:label 'Compound Code' ;
    rdfs:comment 'Unique business code used to reference the compound in operational systems.' ;
    rdfs:domain ind:VehicleCompound ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:compoundType rdf:type rdf:Property ;
    rdfs:label 'Compound Type' ;
    rdfs:comment 'Classification of the compound (e.g., plant yard, port yard, regional distribution center, dealer preparation site).' ;
    rdfs:domain ind:VehicleCompound ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:currentOccupancy rdf:type rdf:Property ;
    rdfs:label 'Current Occupancy' ;
    rdfs:comment 'Current number of vehicles stored in the compound.' ;
    rdfs:domain ind:VehicleCompound ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isPdiCapable rdf:type rdf:Property ;
    rdfs:label 'Is Pdi Capable' ;
    rdfs:comment 'Indicates whether the compound can perform Pre-Delivery Inspection (PDI) on vehicles.' ;
    rdfs:domain ind:VehicleCompound ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:managerEmail rdf:type rdf:Property ;
    rdfs:label 'Manager Email' ;
    rdfs:comment 'Contact email address for the compound operator/manager.' ;
    rdfs:domain ind:Automotive ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:managerPhone rdf:type rdf:Property ;
    rdfs:label 'Manager Phone' ;
    rdfs:comment 'Contact phone number for the compound operator/manager.' ;
    rdfs:domain ind:Automotive ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:operatorName rdf:type rdf:Property ;
    rdfs:label 'Operator Name' ;
    rdfs:comment 'Name of the person or organization responsible for day-to-day operations of the compound.' ;
    rdfs:domain ind:VehicleCompound ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:otdTargetPercentage rdf:type rdf:Property ;
    rdfs:label 'Otd Target Percentage' ;
    rdfs:comment 'Target percentage for on-time delivery performance for shipments originating from this compound.' ;
    rdfs:domain ind:VehicleCompound ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regionCode rdf:type rdf:Property ;
    rdfs:label 'Region Code' ;
    rdfs:comment 'Internal code representing the broader geographic region (e.g., NA, EU, APAC).' ;
    rdfs:domain ind:Automotive ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:securityLevel rdf:type rdf:Property ;
    rdfs:label 'Security Level' ;
    rdfs:comment 'Security classification of the compound (low, medium, high).' ;
    rdfs:domain ind:Automotive ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:storageAreaSqft rdf:type rdf:Property ;
    rdfs:label 'Storage Area Sqft' ;
    rdfs:comment 'Total floor area of the compound in square feet.' ;
    rdfs:domain ind:VehicleCompound ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:temperatureControlled rdf:type rdf:Property ;
    rdfs:label 'Temperature Controlled' ;
    rdfs:comment 'Indicates whether the compound maintains temperature-controlled storage.' ;
    rdfs:domain ind:Automotive ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:vehicleCompoundStatus rdf:type rdf:Property ;
    rdfs:label 'Vehicle Compound Status' ;
    rdfs:comment 'Current operational status of the compound.' ;
    rdfs:domain ind:VehicleCompound ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wasteHandlingCapability rdf:type rdf:Property ;
    rdfs:label 'Waste Handling Capability' ;
    rdfs:comment 'Indicates whether the compound is equipped to handle hazardous waste.' ;
    rdfs:domain ind:VehicleCompound ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:compoundMovementId rdf:type rdf:Property ;
    rdfs:label 'Compound Movement Id' ;
    rdfs:comment 'Surrogate primary key for the compound movement record.' ;
    rdfs:domain ind:CompoundMovement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:compoundMovementStatus rdf:type rdf:Property ;
    rdfs:label 'Compound Movement Status' ;
    rdfs:comment 'Current lifecycle status of the movement.' ;
    rdfs:domain ind:CompoundMovement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:delayMinutes rdf:type rdf:Property ;
    rdfs:label 'Delay Minutes' ;
    rdfs:comment 'Minutes of delay between ETA and actual arrival.' ;
    rdfs:domain ind:CompoundMovement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isOtaCapable rdf:type rdf:Property ;
    rdfs:label 'Is Ota Capable' ;
    rdfs:comment 'Indicates if the vehicle supports over-the-air updates.' ;
    rdfs:domain ind:CompoundMovement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:loadQuantity rdf:type rdf:Property ;
    rdfs:label 'Load Quantity' ;
    rdfs:comment 'Number of units moved in this transaction (typically 1).' ;
    rdfs:domain ind:CompoundMovement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:movementReference rdf:type rdf:Property ;
    rdfs:label 'Movement Reference' ;
    rdfs:comment 'External reference number used by logistics to identify the movement transaction.' ;
    rdfs:domain ind:CompoundMovement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:movementTimestamp rdf:type rdf:Property ;
    rdfs:label 'Movement Timestamp' ;
    rdfs:comment 'Date and time when the movement event occurred.' ;
    rdfs:domain ind:CompoundMovement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:originZone rdf:type rdf:Property ;
    rdfs:label 'Origin Zone' ;
    rdfs:comment 'Yard or bay where the vehicle originated.' ;
    rdfs:domain ind:CompoundMovement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorityLevel rdf:type rdf:Property ;
    rdfs:label 'Priority Level' ;
    rdfs:comment 'Priority assigned to the movement for scheduling purposes.' ;
    rdfs:domain ind:Automotive ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:temperatureC rdf:type rdf:Property ;
    rdfs:label 'Temperature C' ;
    rdfs:comment 'Temperature in the yard at the time of movement.' ;
    rdfs:domain ind:CompoundMovement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:vehicleType rdf:type rdf:Property ;
    rdfs:label 'Vehicle Type' ;
    rdfs:comment 'Classification of the vehicle model.' ;
    rdfs:domain ind:Automotive ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inTransitInventoryId rdf:type rdf:Property ;
    rdfs:label 'In Transit Inventory Id' ;
    rdfs:comment 'Surrogate primary key for the in-transit inventory record.' ;
    rdfs:domain ind:InTransitInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:aftersalesServiceAppointmentId rdf:type rdf:Property ;
    rdfs:label 'Aftersales Service Appointment Id' ;
    rdfs:comment 'Foreign key linking to aftersales.aftersales_service_appointment. Business justification: Parts-to-appointment scheduling: parts ordered for a specific service appointment are tracked in transit against that appointment. Service advisors use this to confirm parts availability before the cu' ;
    rdfs:domain ind:Automotive ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AftersalesServiceAppointment .

ind:primaryInDealerDealershipId rdf:type rdf:Property ;
    rdfs:label 'Primary In Dealer Dealership Id' ;
    rdfs:comment 'Identifier of the dealer receiving the vehicle.' ;
    rdfs:domain ind:InTransitInventory ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Dealership .

ind:actualArrivalDate rdf:type rdf:Property ;
    rdfs:label 'Actual Arrival Date' ;
    rdfs:comment 'Date the vehicle actually arrived at the destination (if arrived).' ;
    rdfs:domain ind:InTransitInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:currentLocation rdf:type rdf:Property ;
    rdfs:label 'Current Location' ;
    rdfs:comment 'Last known location of the vehicle while in transit.' ;
    rdfs:domain ind:InTransitInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:daysInTransit rdf:type rdf:Property ;
    rdfs:label 'Days In Transit' ;
    rdfs:comment 'Number of calendar days the vehicle has been in transit.' ;
    rdfs:domain ind:InTransitInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:destinationFacilityCode rdf:type rdf:Property ;
    rdfs:label 'Destination Facility Code' ;
    rdfs:comment 'Code of the dealer or final destination facility.' ;
    rdfs:domain ind:InTransitInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedArrivalDate rdf:type rdf:Property ;
    rdfs:label 'Estimated Arrival Date' ;
    rdfs:comment 'Planned date the vehicle is expected to arrive at the destination.' ;
    rdfs:domain ind:Automotive ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastUpdateTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Update Timestamp' ;
    rdfs:comment 'Timestamp of the most recent update to the record.' ;
    rdfs:domain ind:InTransitInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:odometerEndKm rdf:type rdf:Property ;
    rdfs:label 'Odometer End Km' ;
    rdfs:comment 'Vehicle odometer reading at the end of the shipment.' ;
    rdfs:domain ind:InTransitInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:odometerStartKm rdf:type rdf:Property ;
    rdfs:label 'Odometer Start Km' ;
    rdfs:comment 'Vehicle odometer reading at the start of the shipment.' ;
    rdfs:domain ind:InTransitInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:originFacilityCode rdf:type rdf:Property ;
    rdfs:label 'Origin Facility Code' ;
    rdfs:comment 'Code of the plant or facility where the vehicle originated.' ;
    rdfs:domain ind:InTransitInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shipmentLegCount rdf:type rdf:Property ;
    rdfs:label 'Shipment Leg Count' ;
    rdfs:comment 'Count of individual transport legs in the shipment itinerary.' ;
    rdfs:domain ind:InTransitInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:transitStatus rdf:type rdf:Property ;
    rdfs:label 'Transit Status' ;
    rdfs:comment 'Current operational status of the shipment.' ;
    rdfs:domain ind:InTransitInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transportCostAmount rdf:type rdf:Property ;
    rdfs:label 'Transport Cost Amount' ;
    rdfs:comment 'Monetary cost incurred for transporting the vehicle.' ;
    rdfs:domain ind:InTransitInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:transportCostCurrency rdf:type rdf:Property ;
    rdfs:label 'Transport Cost Currency' ;
    rdfs:comment 'Three-letter ISO currency code for the transport cost.' ;
    rdfs:domain ind:InTransitInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:freightInvoiceId rdf:type rdf:Property ;
    rdfs:label 'Freight Invoice Id' ;
    rdfs:comment 'System-generated unique identifier for the freight invoice record.' ;
    rdfs:domain ind:FreightInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:billingPartyId rdf:type rdf:Property ;
    rdfs:label 'Billing Party Id' ;
    rdfs:comment 'Foreign key linking to customer.party. Business justification: Freight invoices are billed to the end-customer; associating each invoice with the customer party supports financial reconciliation and compliance reporting.' ;
    rdfs:domain ind:FreightInvoice ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:agreedRate rdf:type rdf:Property ;
    rdfs:label 'Agreed Rate' ;
    rdfs:comment 'Contracted rate per unit (e.g., per kilometer or per container) agreed with the carrier.' ;
    rdfs:domain ind:FreightInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:exchangeRateDate rdf:type rdf:Property ;
    rdfs:label 'Exchange Rate Date' ;
    rdfs:comment 'Date for which the exchange rate was valid.' ;
    rdfs:domain ind:FreightInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:freightInvoiceStatus rdf:type rdf:Property ;
    rdfs:label 'Freight Invoice Status' ;
    rdfs:comment 'Current lifecycle state of the freight invoice.' ;
    rdfs:domain ind:FreightInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:invoicedAmount rdf:type rdf:Property ;
    rdfs:label 'Invoiced Amount' ;
    rdfs:comment 'Total amount billed by the carrier before discounts, taxes, or adjustments.' ;
    rdfs:domain ind:FreightInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentDueDate rdf:type rdf:Property ;
    rdfs:label 'Payment Due Date' ;
    rdfs:comment 'Date by which the invoice must be paid according to contract terms.' ;
    rdfs:domain ind:FreightInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:varianceAmount rdf:type rdf:Property ;
    rdfs:label 'Variance Amount' ;
    rdfs:comment 'Difference between the invoiced amount and the agreed rate-based amount.' ;
    rdfs:domain ind:FreightInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:destinationDealershipId rdf:type rdf:Property ;
    rdfs:label 'Destination Dealership Id' ;
    rdfs:comment 'Foreign key linking to dealer.dealership. Business justification: Lane planning process: logistics lanes define origin-to-destination transport corridors. Dealer delivery lanes require a destination dealership FK to support carrier assignment, freight rate negotiati' ;
    rdfs:domain ind:Lane ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Dealership .

ind:originVehicleCompoundId rdf:type rdf:Property ;
    rdfs:label 'Origin Vehicle Compound Id' ;
    rdfs:comment 'Foreign key linking to logistics.vehicle_compound. Business justification: A logistics lane is defined as an origin-destination pair. The origin of a lane is typically a vehicle compound, plant yard, or staging area. Linking lane to vehicle_compound for the origin node norma' ;
    rdfs:domain ind:Lane ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:VehicleCompound .

ind:originStorageLocationId rdf:type rdf:Property ;
    rdfs:label 'Origin Storage Location Id' ;
    rdfs:comment 'Foreign key linking to inventory.storage_location. Business justification: Vehicle handover occurs from a specific storage location (PDI bay, delivery bay) within a compound or dealership. Linking vehicle_handover to storage_location enables finished vehicle stock location c' ;
    rdfs:domain ind:VehicleHandover ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:StorageLocation .

ind:receivingPartyId rdf:type rdf:Property ;
    rdfs:label 'Receiving Party Id' ;
    rdfs:comment 'Unique identifier of the receiving party (dealer or customer).' ;
    rdfs:domain ind:VehicleHandover ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:tradeInId rdf:type rdf:Property ;
    rdfs:label 'Trade In Id' ;
    rdfs:comment 'Foreign key linking to sales.trade_in. Business justification: At vehicle handover, the trade-in is physically collected and routed for reconditioning or auction. Linking handover to trade_in enables title transfer tracking, logistics disposition routing, and rec' ;
    rdfs:domain ind:Automotive ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TradeIn .

ind:vehicleOwnershipId rdf:type rdf:Property ;
    rdfs:label 'Vehicle Ownership Id' ;
    rdfs:comment 'Foreign key linking to customer.vehicle_ownership. Business justification: Vehicle handover is the triggering event that creates or activates the vehicle_ownership record (title transfer, warranty start, odometer capture). Linking handover to ownership supports delivery clos' ;
    rdfs:domain ind:Automotive ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:VehicleOwnership .

ind:acceptanceSignatureStatus rdf:type rdf:Property ;
    rdfs:label 'Acceptance Signature Status' ;
    rdfs:comment 'Status of the acceptance signature: signed, unsigned, or pending.' ;
    rdfs:domain ind:VehicleHandover ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:carrierName rdf:type rdf:Property ;
    rdfs:label 'Carrier Name' ;
    rdfs:comment 'Name of the logistics carrier responsible for the transport.' ;
    rdfs:domain ind:VehicleHandover ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:handoverCondition rdf:type rdf:Property ;
    rdfs:label 'Handover Condition' ;
    rdfs:comment 'Condition of the vehicle at handover: new, used, reconditioned, or damaged.' ;
    rdfs:domain ind:VehicleHandover ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:handoverFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Handover Fee Amount' ;
    rdfs:comment 'Gross fee charged for the handover service.' ;
    rdfs:domain ind:VehicleHandover ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:handoverFeeCurrency rdf:type rdf:Property ;
    rdfs:label 'Handover Fee Currency' ;
    rdfs:comment 'Three-letter ISO 4217 currency code for the handover fee.' ;
    rdfs:domain ind:VehicleHandover ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:handoverFeeNetAmount rdf:type rdf:Property ;
    rdfs:label 'Handover Fee Net Amount' ;
    rdfs:comment 'Net amount after tax for the handover fee.' ;
    rdfs:domain ind:VehicleHandover ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:handoverFeeTaxAmount rdf:type rdf:Property ;
    rdfs:label 'Handover Fee Tax Amount' ;
    rdfs:comment 'Tax component of the handover fee.' ;
    rdfs:domain ind:VehicleHandover ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:handoverLocation rdf:type rdf:Property ;
    rdfs:label 'Handover Location' ;
    rdfs:comment 'Physical location (plant, compound, yard, or dealer site) where the handover took place.' ;
    rdfs:domain ind:VehicleHandover ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:handoverNumber rdf:type rdf:Property ;
    rdfs:label 'Handover Number' ;
    rdfs:comment 'Business-assigned handover reference number used for tracking and communication.' ;
    rdfs:domain ind:VehicleHandover ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:handoverStatus rdf:type rdf:Property ;
    rdfs:label 'Handover Status' ;
    rdfs:comment 'Current processing status of the handover record.' ;
    rdfs:domain ind:VehicleHandover ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:handoverTimestamp rdf:type rdf:Property ;
    rdfs:label 'Handover Timestamp' ;
    rdfs:comment 'Exact date and time when the handover event occurred.' ;
    rdfs:domain ind:VehicleHandover ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:handoverType rdf:type rdf:Property ;
    rdfs:label 'Handover Type' ;
    rdfs:comment 'Classification of the handover scenario: dealer stock, retail customer, export, or import.' ;
    rdfs:domain ind:VehicleHandover ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pdiReference rdf:type rdf:Property ;
    rdfs:label 'Pdi Reference' ;
    rdfs:comment 'Reference identifier linking to the Pre-Delivery Inspection record.' ;
    rdfs:domain ind:VehicleHandover ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:receivingPartyType rdf:type rdf:Property ;
    rdfs:label 'Receiving Party Type' ;
    rdfs:comment 'Indicates whether the receiving party is a dealer or an end-customer.' ;
    rdfs:domain ind:VehicleHandover ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ean13 rdf:type rdf:Property ;
    rdfs:label 'Ean13' ;
    rdfs:comment '13-digit European Article Number for the SKU.' ;
    rdfs:domain ind:SkuMaster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expirationDate rdf:type rdf:Property ;
    rdfs:label 'Expiration Date' ;
    rdfs:comment 'Date after which the SKU is considered expired.' ;
    rdfs:domain ind:Automotive ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:hazardousFlag rdf:type rdf:Property ;
    rdfs:label 'Hazardous Flag' ;
    rdfs:comment 'Indicates whether the SKU is classified as hazardous under regulatory standards.' ;
    rdfs:domain ind:SkuMaster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:heightCm rdf:type rdf:Property ;
    rdfs:label 'Height Cm' ;
    rdfs:comment 'Height dimension of the SKU in centimeters.' ;
    rdfs:domain ind:SkuMaster ;
    rdf:type owl:DatatypeProperty ;
