ind:pharmacyGroupNumber rdf:type rdf:Property ;
    rdfs:label 'Pharmacy Group Number' ;
    rdfs:comment 'Group number used for pharmacy benefit routing.' ;
    rdfs:domain ind:IdCard ;
    rdf:type owl:DatatypeProperty ;
