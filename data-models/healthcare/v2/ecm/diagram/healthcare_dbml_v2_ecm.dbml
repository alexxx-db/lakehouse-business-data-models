  pay_range_midpoint decimal(12,2) [note: 'Midpoint salary/hourly rate for compensation benchmarking']
  pay_range_min decimal(12,2) [note: 'Minimum salary/hourly rate for this position']
  position_code varchar [note: 'Unique business code identifying the position']
  position_number varchar
  position_status varchar [note: 'Current status (open, filled, frozen, closed)']
  position_title varchar
  position_type varchar [note: 'Type of position (regular, temporary, contract, traveler)']
  required_certification varchar [note: 'Professional certification required (BLS, ACLS, etc.)']
  required_education_level varchar [note: 'Minimum education level required (BSN, MD, etc.)']
  required_license_type varchar [note: 'Professional license type required (RN, MD, PA, etc.)']
  shift_type varchar [note: 'Primary shift assignment (day, evening, night, rotating)']
  source_system_code varchar [note: 'Identifier of the source HR system']
  source_system_position_code varchar [note: 'Position identifier in the source system']
  standard_hours_per_week decimal(5,2) [note: 'Standard weekly hours for this position']
  telehealth_eligible boolean [note: 'Whether this position can perform telehealth services']
  title varchar [note: 'Official title of the position']
  union_code varchar [note: 'Union bargaining unit code if applicable']
  updated_timestamp timestamp [note: 'Timestamp of last update to the position record']
  vacancy_reason varchar [note: 'Reason for current vacancy (resignation, retirement, new position)']
  vibe_mutation_marker varchar [note: 'Added by VIBE mutator to ensure a change']
  vibe_structure_marker varchar [note: 'Structure enforcement marker for 22-domain/541-product superset.']
  weekend_rotation_required boolean [note: 'Whether weekend rotation is required for this position']

  Note: 'Position master defining authorized roles, budgeted FTE, reporting structure, and job requirements.'
}

Table workforce.job_profile {
