    rdfs:comment 'Reappointment cycles' .

ind:PeerReference rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Provider ;
    rdfs:label 'Peer Reference' ;
    rdfs:comment 'Peer references' .

ind:CmeActivity rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Provider ;
    rdfs:label 'Cme Activity' ;
    rdfs:comment 'CME activities' .

ind:TelehealthAuthorization rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Provider ;
    rdfs:label 'Telehealth Authorization' ;
    rdfs:comment 'Telehealth authorizations' .

ind:Taxonomy rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Provider ;
    rdfs:label 'Taxonomy' ;
    rdfs:comment 'NUCC taxonomy codes' .

ind:AffiliationHistory rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Provider ;
    rdfs:label 'Affiliation History' ;
    rdfs:comment 'Provider affiliation history' .

ind:StudyTeamMember rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Provider ;
