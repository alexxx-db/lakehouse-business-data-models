  location_type varchar [note: 'Type of work location (on-site, remote, hybrid)']
  max_pay_rate decimal(18,2)
  min_pay_rate decimal(18,2)
  minimum_experience_years varchar [note: 'Minimum years of experience required']
  mutator_applied_flag boolean [note: 'Flag set by mutator to indicate modification']
  on_call_required boolean [note: 'Whether on-call coverage is required']
  osha_job_hazard_category varchar [note: 'OSHA job hazard classification for workplace safety']
  patient_facing boolean [note: 'Whether this position involves direct patient interaction']
  pay_grade varchar [note: 'Compensation pay grade level']
