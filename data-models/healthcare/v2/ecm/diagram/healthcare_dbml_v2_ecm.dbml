  proctoring_required_flag boolean
  updated_timestamp timestamp
  vibe_structure_marker varchar [note: 'Structure enforcement marker for 22-domain/541-product superset.']

  Note: 'This association product represents the credentialing relationship between healthcare workforce members and specific CPT procedures they are authorized to perform. It captures the medical staff services office\'s privilege granting, competency assessment, and ongoing professional practice evaluation. Each record links one employee (clinician) to one CPT code with privilege-specific attributes including grant/expiration dates, competency level, volume requirements, and supervision needs. This is the operational foundation of medical staff credentialing and delineation of privileges.. Existence Justification: Clinical privileges represent the operational credentialing relationship where healthcare providers (physicians, nurses, allied health) are granted authority to perform specific procedures (CPT codes). In real-world medical staff services operations, a single surgeon holds privileges for 20-200 different CPT codes (e.g., appendectomy, cholecystectomy, hernia repair), and each CPT code has 50+ credentialed clinicians across the health system. The medical staff services office actively manages these privileges with grant/expiration dates, competency assessments, volume requirements, and supervision rules.'
}

Table workforce.channel_support_assignment {
  channel_support_assignment_id varchar [pk]
  care_site_id varchar
  employee_id varchar
  assignment_status varchar
  channel_type varchar
  created_timestamp timestamp
  effective_date date
  languages_supported varchar
  max_concurrent_sessions varchar
  schedule_preference varchar
  skill_level varchar
  termination_date date
  updated_timestamp timestamp
  vibe_structure_marker varchar [note: 'Structure enforcement marker for 22-domain/541-product superset.']

  Note: 'This association product represents the operational support assignment between healthcare IT workforce members and interface channels. It captures the tiered support structure (primary, backup, escalation), on-call rotation schedules, and assignment lifecycle for incident management and workforce scheduling. Each record links one employee to one interface channel with role-specific attributes that exist only in the context of this support relationship.. Existence Justification: Healthcare IT operations require multi-tiered support coverage for interface channels (HL7 feeds, FHIR endpoints, Direct messaging). A single interface channel has multiple support staff assigned in different roles (primary, backup, escalation), and a single IT workforce member supports multiple interface channels across different systems. Organizations actively manage these assignments for on-call rotations, incident escalation paths, and workforce scheduling.'
}

Table workforce.position_procedure_authorization {
  position_procedure_authorization_id varchar [pk, note: 'Unique identifier for the procedure authorization record']
  cpt_code_id varchar [note: 'FK to the CPT procedure code authorized']
  job_profile_id varchar
  position_id varchar [note: 'FK to the position authorized to perform the procedure']
  age_restriction varchar [note: 'Patient age restrictions for this authorization (e.g., adult only, pediatric)']
  authorization_level varchar [note: 'Level of authorization (independent, supervised, assist)']
  authorization_status varchar [note: 'Current status (active, suspended, revoked, pending)']
  cases_performed_count varchar [note: 'Number of cases performed under this authorization']
  competency_required boolean
  competency_validation_frequency varchar [note: 'How often competency must be revalidated (annual, biennial)']
  created_date timestamp [note: 'Timestamp when the authorization was created']
  created_timestamp timestamp
  credentialing_committee_approval_date date [note: 'Date the credentialing committee approved the authorization']
  effective_date date [note: 'Date the authorization becomes effective']
  expiration_date date [note: 'Date the authorization expires']
  last_competency_validation_date date [note: 'Date of most recent competency validation']
  minimum_cases_required varchar [note: 'Minimum number of cases required for competency']
  mutator_applied_flag boolean [note: 'Flag set by mutator to indicate modification']
  notes varchar [note: 'Additional notes about the authorization']
  procedure_code varchar
  procedure_name varchar
  regulatory_basis varchar
  requires_supervision boolean
  risk_category varchar [note: 'Risk category of the procedure (low, medium, high)']
  scope_of_practice varchar
  setting_restriction varchar [note: 'Care setting restrictions (inpatient only, OR only)']
  source_system_code varchar [note: 'Identifier of the source credentialing system']
  supervision_requirement varchar [note: 'Type of supervision required (direct, general, none)']
  training_description varchar [note: 'Description of required training for this procedure']
  training_required boolean [note: 'Whether additional training is required']
  updated_date timestamp [note: 'Timestamp of last update to the authorization']
  updated_timestamp timestamp
  vibe_mutation_marker varchar [note: 'Added by VIBE mutator to ensure a change']
  vibe_structure_marker varchar [note: 'Structure enforcement marker for 22-domain/541-product superset.']
  volume_expectation varchar [note: 'Expected annual procedure volume']
  created_by varchar [note: 'User who created the authorization record']

  Note: 'This association product represents the authorization relationship between workforce positions and CPT procedure codes. It captures which procedures each position type is credentialed and authorized to perform, including supervision requirements, volume expectations, and training prerequisites. Each record links one position to one CPT code with authorization-specific attributes that exist only in the context of this relationship. Supports competency management, credentialing workflows, and clinical privilege tracking.. Existence Justification: In healthcare workforce management, positions are authorized to perform multiple CPT procedures based on credentials, training, and clinical privileges, and each CPT procedure can be performed by multiple position types with varying authorization levels. The business actively manages position-procedure authorizations as part of credentialing workflows, competency frameworks, and clinical privilege management. This is an operational relationship tracked in medical staff services and HR systems, not an analytical correlation.'
}

