ind:controllingArea rdf:type rdf:Property ;
    rdfs:label 'Controlling Area' ;
    rdfs:comment 'Controlling area' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costCenterStatus rdf:type rdf:Property ;
    rdfs:label 'Cost Center Status' ;
    rdfs:comment 'Cost center status' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:costCenterType rdf:type rdf:Property ;
    rdfs:label 'Cost Center Type' ;
    rdfs:comment 'Cost center type' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:costElementGroup rdf:type rdf:Property ;
    rdfs:label 'Cost Element Group' ;
    rdfs:comment 'Cost element group' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costPool rdf:type rdf:Property ;
    rdfs:label 'Cost Pool' ;
    rdfs:comment 'Cost pool for allocation' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costCenterDescription rdf:type rdf:Property ;
    rdfs:label 'Cost Center Description' ;
    rdfs:comment 'Cost center description' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isDirectCostCenter rdf:type rdf:Property ;
    rdfs:label 'Is Direct Cost Center' ;
    rdfs:comment 'Direct vs indirect cost center' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isRateBaseEligible rdf:type rdf:Property ;
    rdfs:label 'Is Rate Base Eligible' ;
    rdfs:comment 'Eligible for rate base inclusion' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:costCenterName rdf:type rdf:Property ;
    rdfs:label 'Cost Center Name' ;
    rdfs:comment 'Cost center name' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:overheadRatePercentage rdf:type rdf:Property ;
    rdfs:label 'Overhead Rate Percentage' ;
    rdfs:comment 'Overhead rate percentage' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:validFromDate rdf:type rdf:Property ;
    rdfs:label 'Valid From Date' ;
    rdfs:comment 'Valid from date' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:validToDate rdf:type rdf:Property ;
    rdfs:label 'Valid To Date' ;
    rdfs:comment 'Valid to date' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:journalApprovedByEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Journal Approved By Employee Id' ;
    rdfs:comment 'Approved by employee' ;
    rdfs:domain ind:JournalEntry ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:journalCreatedByEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Journal Created By Employee Id' ;
    rdfs:comment 'Created by employee' ;
    rdfs:domain ind:JournalEntry ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:journalPostedByEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Journal Posted By Employee Id' ;
    rdfs:comment 'Posted by employee' ;
    rdfs:domain ind:JournalEntry ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:recurringEntryTemplateId rdf:type rdf:Property ;
    rdfs:label 'Recurring Entry Template Id' ;
    rdfs:comment 'The identifier of the recurring journal entry template used to generate this entry, if applicable. Recurring templates are used for repetitive monthly postings such as depreciation, amortization, or allocated overhead costs.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RecurringEntryTemplate .

ind:reversedByJournalEntryId rdf:type rdf:Property ;
    rdfs:label 'Reversed By Journal Entry Id' ;
    rdfs:comment 'Reversing journal entry' ;
    rdfs:domain ind:JournalEntry ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:JournalEntry .

ind:approvedByUser rdf:type rdf:Property ;
    rdfs:label 'Approved By User' ;
    rdfs:comment 'The user ID or username of the person who approved this journal entry for posting. Populated only after the entry has been approved. Used for segregation of duties and audit trail.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exchangeRate rdf:type rdf:Property ;
    rdfs:label 'Exchange Rate' ;
    rdfs:comment 'The foreign exchange rate applied to convert transaction currency amounts to local currency, if applicable. Populated only for journal entries involving foreign currency transactions.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:intercompanyIndicator rdf:type rdf:Property ;
    rdfs:label 'Intercompany Indicator' ;
    rdfs:comment 'Boolean flag indicating whether this journal entry involves intercompany or inter-fund transactions between different legal entities or funds within the water utility organization. True if intercompany, false otherwise.' ;
    rdfs:domain ind:JournalEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:journalEntryDate rdf:type rdf:Property ;
    rdfs:label 'Journal Entry Date' ;
    rdfs:comment 'Journal entry date' ;
    rdfs:domain ind:JournalEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:journalEntryDescription rdf:type rdf:Property ;
    rdfs:label 'Journal Entry Description' ;
    rdfs:comment 'Narrative description or memo text explaining the business purpose and nature of this journal entry. Provides context for auditors, accountants, and financial analysts reviewing the posting.' ;
    rdfs:domain ind:JournalEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:journalEntryNumber rdf:type rdf:Property ;
    rdfs:label 'Journal Entry Number' ;
    rdfs:comment 'Journal entry number' ;
    rdfs:domain ind:JournalEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:journalSource rdf:type rdf:Property ;
    rdfs:label 'Journal Source' ;
    rdfs:comment 'Manual, AP, AR, Payroll, Depreciation, Accrual' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:journalStatus rdf:type rdf:Property ;
    rdfs:label 'Journal Status' ;
    rdfs:comment 'Draft, Posted, Reversed' ;
    rdfs:domain ind:JournalEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:journalType rdf:type rdf:Property ;
    rdfs:label 'Journal Type' ;
    rdfs:comment 'Classification of the journal entry by its accounting purpose: standard (regular operational postings), adjusting (period-end accruals and deferrals), closing (fiscal year-end closing entries), reversing (automatic reversal of prior accruals), recurring (template-based repetitive entries), or statistical (non-financial postings for cost allocation).' ;
    rdfs:domain ind:JournalEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lineItemCount rdf:type rdf:Property ;
    rdfs:label 'Line Item Count' ;
    rdfs:comment 'The number of individual line items (debits and credits) contained in this journal entry header. Used for validation and summary reporting.' ;
    rdfs:domain ind:JournalEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:originatingModule rdf:type rdf:Property ;
    rdfs:label 'Originating Module' ;
    rdfs:comment 'The source system module or sub-ledger that generated this journal entry. GL (General Ledger) for manual entries, AP (Accounts Payable) for vendor invoice postings, AR (Accounts Receivable) for customer billing, FA (Fixed Assets) for depreciation, PM (Plant Maintenance) for work order capitalization, MM (Materials Management) for inventory transactions, HR/payroll for labor cost allocation, billing for revenue recognition, asset_accounting for capital asset transactions, or manual for ad-hoc adjustments. [ENUM-REF-CANDIDATE: GL|AP|AR|FA|PM|MM|HR|payroll|billing|asset_accounting|manual — 11 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:JournalEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postedByUser rdf:type rdf:Property ;
    rdfs:label 'Posted By User' ;
    rdfs:comment 'The user ID or username of the person who posted this journal entry to the general ledger. Populated only after the entry has been posted. Used for audit trail and accountability.' ;
    rdfs:domain ind:JournalEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Posted Timestamp' ;
    rdfs:comment 'The date and time when this journal entry was posted to the general ledger. Populated only after posting. Used for audit trail and to track posting timing.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:postingStatus rdf:type rdf:Property ;
    rdfs:label 'Posting Status' ;
    rdfs:comment 'Current lifecycle status of the journal entry in the approval and posting workflow. Draft entries are being prepared, pending approval entries await authorization, approved entries are ready for posting, posted entries have been committed to the general ledger, reversed entries have been backed out, and rejected entries were denied approval.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalCreditAmount rdf:type rdf:Property ;
    rdfs:label 'Total Credit Amount' ;
    rdfs:comment 'The sum of all credit line item amounts in this journal entry. Must equal total_debit_amount to maintain double-entry accounting balance.' ;
    rdfs:domain ind:JournalEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalDebitAmount rdf:type rdf:Property ;
    rdfs:label 'Total Debit Amount' ;
    rdfs:comment 'The sum of all debit line item amounts in this journal entry. Must equal total_credit_amount to maintain double-entry accounting balance.' ;
    rdfs:domain ind:JournalEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:journalEntryLineId rdf:type rdf:Property ;
    rdfs:label 'Journal Entry Line Id' ;
    rdfs:comment 'Unique identifier for the journal entry line item. Primary key for the journal entry line product.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:JournalEntryLine .

ind:journalBusinessPartnerVendorId rdf:type rdf:Property ;
    rdfs:label 'Journal Business Partner Vendor Id' ;
    rdfs:comment 'Foreign key reference to the business partner (vendor, customer, employee) associated with this line item. Used for accounts payable, accounts receivable, and payroll transactions.' ;
    rdfs:domain ind:JournalEntryLine ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Vendor .

ind:journalEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Journal Employee Id' ;
    rdfs:comment 'User ID of the person or system account that created this journal entry line. Used for audit trail and accountability.' ;
    rdfs:domain ind:JournalEntryLine ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:journalModifiedByUserEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Journal Modified By User Employee Id' ;
    rdfs:comment 'User ID of the person or system account that last modified this journal entry line. Null if never modified after creation.' ;
    rdfs:domain ind:JournalEntryLine ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:journalVendorId rdf:type rdf:Property ;
    rdfs:label 'Journal Vendor Id' ;
    rdfs:comment 'Foreign key reference to the business partner (vendor, customer, employee) associated with this line item. Used for accounts payable, accounts receivable, and payroll transactions.' ;
    rdfs:domain ind:JournalEntryLine ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Vendor .

ind:primaryJournalEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Journal Employee Id' ;
    rdfs:comment 'User ID of the person or system account that created this journal entry line. Used for audit trail and accountability.' ;
    rdfs:domain ind:JournalEntryLine ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:referenceDocumentId rdf:type rdf:Property ;
    rdfs:label 'Reference Document Id' ;
    rdfs:comment 'Reference document ID' ;
    rdfs:domain ind:JournalEntryLine ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Document .

ind:reversedLineJournalEntryLineId rdf:type rdf:Property ;
    rdfs:label 'Reversed Line Journal Entry Line Id' ;
    rdfs:comment 'Foreign key reference to the original journal entry line that this entry reverses. Null for non-reversal entries.' ;
    rdfs:domain ind:JournalEntryLine ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:JournalEntryLine .

ind:allocationIndicator rdf:type rdf:Property ;
    rdfs:label 'Allocation Indicator' ;
    rdfs:comment 'Indicates whether this line item was created through an automated allocation or distribution process. True for allocated entries, false for direct postings.' ;
    rdfs:domain ind:JournalEntryLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:clearingDate rdf:type rdf:Property ;
    rdfs:label 'Clearing Date' ;
    rdfs:comment 'Date when this open item was cleared or settled. Null for uncleared items.' ;
    rdfs:domain ind:JournalEntryLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:clearingDocumentNumber rdf:type rdf:Property ;
    rdfs:label 'Clearing Document Number' ;
    rdfs:comment 'Document number of the clearing entry that settled this open item. Used for accounts payable and receivable reconciliation. Null for uncleared items.' ;
    rdfs:domain ind:JournalEntryLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:debitCreditIndicator rdf:type rdf:Property ;
    rdfs:label 'Debit Credit Indicator' ;
    rdfs:comment 'Indicates whether this line item is a debit (D) or credit (C) entry. Required for double-entry bookkeeping and ensuring balanced journal entries.' ;
    rdfs:domain ind:JournalEntryLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:functionalAmount rdf:type rdf:Property ;
    rdfs:label 'Functional Amount' ;
    rdfs:comment 'Monetary amount converted to the utility\'s functional (reporting) currency. Used for consolidated financial statements and GASB reporting when transaction currency differs from functional currency.' ;
    rdfs:domain ind:JournalEntryLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:functionalAreaCode rdf:type rdf:Property ;
    rdfs:label 'Functional Area Code' ;
    rdfs:comment 'Functional area classification for cross-organizational reporting. Examples include water treatment, wastewater treatment, distribution, collection, customer service, and administration.' ;
    rdfs:domain ind:JournalEntryLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:functionalCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Functional Currency Code' ;
    rdfs:comment 'Three-letter ISO 4217 currency code for the functional amount. Typically USD for U.S. water utilities.' ;
    rdfs:domain ind:JournalEntryLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:glAccountDescription rdf:type rdf:Property ;
    rdfs:label 'Gl Account Description' ;
    rdfs:comment 'Descriptive name of the general ledger account for human readability and reporting purposes.' ;
    rdfs:domain ind:JournalEntryLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:internalOrderNumber rdf:type rdf:Property ;
    rdfs:label 'Internal Order Number' ;
    rdfs:comment 'Internal order number for tracking specific operational or maintenance activities. Used for short-term cost collection and allocation.' ;
    rdfs:domain ind:JournalEntryLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lineDescription rdf:type rdf:Property ;
    rdfs:label 'Line Description' ;
    rdfs:comment 'Line description' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lineItemText rdf:type rdf:Property ;
    rdfs:label 'Line Item Text' ;
    rdfs:comment 'Free-form descriptive text providing additional context for the journal entry line. Used for audit trails, explanations, and supporting documentation references.' ;
    rdfs:domain ind:JournalEntryLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:manualEntryIndicator rdf:type rdf:Property ;
    rdfs:label 'Manual Entry Indicator' ;
    rdfs:comment 'Indicates whether this line item was manually entered by a user or automatically generated by the system. True for manual entries, false for system-generated entries.' ;
    rdfs:domain ind:JournalEntryLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:referenceDocumentType rdf:type rdf:Property ;
    rdfs:label 'Reference Document Type' ;
    rdfs:comment 'Type of source document that originated this journal entry line. Categorizes the business transaction for reporting and analysis. [ENUM-REF-CANDIDATE: invoice|purchase_order|payment|work_order|payroll|adjustment|accrual|reversal|allocation|other — 10 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:JournalEntryLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:statisticalAmount rdf:type rdf:Property ;
    rdfs:label 'Statistical Amount' ;
    rdfs:comment 'Statistical quantity (e.g., gallons, connections)' ;
    rdfs:domain ind:JournalEntryLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:statisticalUnit rdf:type rdf:Property ;
    rdfs:label 'Statistical Unit' ;
    rdfs:comment 'Statistical unit of measure' ;
    rdfs:domain ind:JournalEntryLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tradingPartnerCode rdf:type rdf:Property ;
    rdfs:label 'Trading Partner Code' ;
    rdfs:comment 'Trading partner code for intercompany or inter-fund transactions. Used for consolidation and elimination entries in multi-entity utilities.' ;
    rdfs:domain ind:JournalEntryLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transactionCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Transaction Currency Code' ;
    rdfs:comment 'Three-letter ISO 4217 currency code for the transaction amount. Supports multi-currency accounting for utilities with international operations or foreign debt.' ;
    rdfs:domain ind:JournalEntryLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:valueDate rdf:type rdf:Property ;
    rdfs:label 'Value Date' ;
    rdfs:comment 'Value date for cash management and treasury operations. Represents the effective date for interest calculation and cash flow analysis.' ;
    rdfs:domain ind:JournalEntryLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:apInvoiceId rdf:type rdf:Property ;
    rdfs:label 'Ap Invoice Id' ;
    rdfs:comment 'Unique identifier for the accounts payable invoice record. Primary key.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ApInvoice .

ind:apInvoiceDescription rdf:type rdf:Property ;
    rdfs:label 'Ap Invoice Description' ;
    rdfs:comment 'Free-text description of the goods or services covered by this invoice. Provides business context for the invoice.' ;
    rdfs:domain ind:ApInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:discountDueDate rdf:type rdf:Property ;
    rdfs:label 'Discount Due Date' ;
    rdfs:comment 'The date by which payment must be made to qualify for the early payment discount.' ;
    rdfs:domain ind:ApInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:form1099Box rdf:type rdf:Property ;
    rdfs:label 'Form 1099 Box' ;
    rdfs:comment '1099 box number' ;
    rdfs:domain ind:ApInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:glPostedFlag rdf:type rdf:Property ;
    rdfs:label 'Gl Posted Flag' ;
    rdfs:comment 'GL posted flag' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:glPostingDate rdf:type rdf:Property ;
    rdfs:label 'Gl Posting Date' ;
    rdfs:comment 'GL posting date' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:goodsReceiptNumber rdf:type rdf:Property ;
    rdfs:label 'Goods Receipt Number' ;
    rdfs:comment 'The goods receipt document number confirming that materials or services were received. Used for three-way match validation.' ;
    rdfs:domain ind:ApInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:invoiceAmount rdf:type rdf:Property ;
    rdfs:label 'Invoice Amount' ;
    rdfs:comment 'Invoice total amount' ;
    rdfs:domain ind:ApInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:invoiceReceivedDate rdf:type rdf:Property ;
    rdfs:label 'Invoice Received Date' ;
    rdfs:comment 'The date the water utility received the invoice from the vendor.' ;
    rdfs:domain ind:ApInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:is1099Reportable rdf:type rdf:Property ;
    rdfs:label 'Is 1099 Reportable' ;
    rdfs:comment '1099 reportable flag' ;
    rdfs:domain ind:ApInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isCapex rdf:type rdf:Property ;
    rdfs:label 'Is Capex' ;
    rdfs:comment 'Boolean flag indicating whether this invoice is for capital expenditure (CAPEX) or operating expenditure (OPEX). True if CAPEX, False if OPEX.' ;
    rdfs:domain ind:ApInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:paymentReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Payment Reference Number' ;
    rdfs:comment 'The payment transaction reference number or check number used to pay this invoice.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:apPaymentId rdf:type rdf:Property ;
    rdfs:label 'Ap Payment Id' ;
    rdfs:comment 'Unique identifier for the accounts payable payment transaction.' ;
    rdfs:domain ind:ApPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:apCreatedByEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Ap Created By Employee Id' ;
    rdfs:comment 'Created by employee' ;
    rdfs:domain ind:ApPayment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:paymentRunId rdf:type rdf:Property ;
    rdfs:label 'Payment Run Id' ;
    rdfs:comment 'Identifier of the batch payment run or payment proposal that generated this payment (SAP payment run or Tyler Munis batch ID).' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PaymentRun .

ind:primaryApprovedByEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Approved By Employee Id' ;
    rdfs:comment 'Approved by employee' ;
    rdfs:domain ind:ApPayment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:achTraceNumber rdf:type rdf:Property ;
    rdfs:label 'Ach Trace Number' ;
    rdfs:comment 'ACH trace number' ;
    rdfs:domain ind:ApPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:apPaymentDescription rdf:type rdf:Property ;
    rdfs:label 'Ap Payment Description' ;
    rdfs:comment 'Payment description' ;
    rdfs:domain ind:ApPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:netPaymentAmount rdf:type rdf:Property ;
    rdfs:label 'Net Payment Amount' ;
    rdfs:comment 'Net amount paid to the vendor after applying discounts and adjustments (payment_amount minus discount_amount).' ;
    rdfs:domain ind:ApPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentAmount rdf:type rdf:Property ;
    rdfs:label 'Payment Amount' ;
    rdfs:comment 'Gross amount of the payment disbursed to the vendor before any adjustments or discounts.' ;
    rdfs:domain ind:ApPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentDescription rdf:type rdf:Property ;
    rdfs:label 'Payment Description' ;
    rdfs:comment 'Textual description of the payment purpose or goods/services procured (e.g., \'Chlorine chemical supply for WTP\', \'Contractor services for pipe repair\').' ;
    rdfs:domain ind:ApPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentReference rdf:type rdf:Property ;
    rdfs:label 'Payment Reference' ;
    rdfs:comment 'Additional reference information for the payment such as vendor invoice number, contract reference, or external tracking number.' ;
    rdfs:domain ind:ApPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remittanceAdviceNumber rdf:type rdf:Property ;
    rdfs:label 'Remittance Advice Number' ;
    rdfs:comment 'Reference number for the remittance advice document sent to the vendor detailing invoices paid and amounts applied.' ;
    rdfs:domain ind:ApPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:voidDate rdf:type rdf:Property ;
    rdfs:label 'Void Date' ;
    rdfs:comment 'Date the payment was voided or cancelled.' ;
    rdfs:domain ind:ApPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:voidReason rdf:type rdf:Property ;
    rdfs:label 'Void Reason' ;
    rdfs:comment 'Reason the payment was voided or cancelled if applicable (e.g., duplicate payment, vendor dispute, incorrect amount).' ;
    rdfs:domain ind:ApPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wireConfirmationNumber rdf:type rdf:Property ;
    rdfs:label 'Wire Confirmation Number' ;
    rdfs:comment 'Wire confirmation number' ;
    rdfs:domain ind:ApPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:arCustomerAccountId rdf:type rdf:Property ;
    rdfs:label 'Ar Customer Account Id' ;
    rdfs:comment 'FK to customer.customer_account' ;
    rdfs:domain ind:ArTransaction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CustomerAccount .

ind:arCustomerCustomerAccountId rdf:type rdf:Property ;
    rdfs:label 'Ar Customer Customer Account Id' ;
    rdfs:comment 'Reference to the customer or entity responsible for payment. Links to customer master for non-utility billing customers.' ;
    rdfs:domain ind:ArTransaction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CustomerAccount .

ind:agingBucket rdf:type rdf:Property ;
    rdfs:label 'Aging Bucket' ;
    rdfs:comment 'Classification of the AR transaction by days past due. Used for aging reports and collection prioritization.' ;
    rdfs:domain ind:ArTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:arGlAccountCode rdf:type rdf:Property ;
    rdfs:label 'Ar Gl Account Code' ;
    rdfs:comment 'General ledger account code for the accounts receivable balance. Used for balance sheet reporting and reconciliation.' ;
    rdfs:domain ind:ArTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:arTransactionDescription rdf:type rdf:Property ;
    rdfs:label 'Ar Transaction Description' ;
    rdfs:comment 'Detailed narrative description of the AR transaction including service provided, fee basis, and any special terms or conditions.' ;
    rdfs:domain ind:ArTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collectionPriority rdf:type rdf:Property ;
    rdfs:label 'Collection Priority' ;
    rdfs:comment 'Priority level assigned for collection efforts based on amount, aging, customer history, and business rules.' ;
    rdfs:domain ind:ArTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:customerName rdf:type rdf:Property ;
    rdfs:label 'Customer Name' ;
    rdfs:comment 'Full legal name of the customer or entity responsible for the AR transaction. Denormalized for reporting convenience.' ;
    rdfs:domain ind:ArTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:iupPermitId rdf:type rdf:Property ;
    rdfs:label 'Iup Permit Id' ;
    rdfs:comment 'Reference to the Industrial User Permit if this AR transaction represents an IUP fee. Nullable for non-IUP transactions.' ;
    rdfs:domain ind:ArTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lastCollectionActionDate rdf:type rdf:Property ;
    rdfs:label 'Last Collection Action Date' ;
    rdfs:comment 'Date of the most recent collection activity (call, letter, email, or legal action) for this AR transaction.' ;
    rdfs:domain ind:ArTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:originalAmount rdf:type rdf:Property ;
    rdfs:label 'Original Amount' ;
    rdfs:comment 'Original billed amount of the AR transaction before any payments, adjustments, or write-offs. Base amount for revenue recognition.' ;
    rdfs:domain ind:ArTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:outstandingAmount rdf:type rdf:Property ;
    rdfs:label 'Outstanding Amount' ;
    rdfs:comment 'Current unpaid balance of the AR transaction after applying payments, credits, and adjustments. Used for aging and collection reporting.' ;
    rdfs:domain ind:ArTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paidAmount rdf:type rdf:Property ;
    rdfs:label 'Paid Amount' ;
    rdfs:comment 'Total amount paid against this AR transaction to date. Sum of all payment applications.' ;
    rdfs:domain ind:ArTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentPlanFlag rdf:type rdf:Property ;
    rdfs:label 'Payment Plan Flag' ;
    rdfs:comment 'Indicates whether this AR transaction is enrolled in a payment plan arrangement. True if on payment plan, false otherwise.' ;
    rdfs:domain ind:ArTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:transactionDate rdf:type rdf:Property ;
    rdfs:label 'Transaction Date' ;
    rdfs:comment 'Date when the AR transaction was originated or the service/product was delivered. Used for revenue recognition timing per GASB 33.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:transactionNumber rdf:type rdf:Property ;
    rdfs:label 'Transaction Number' ;
    rdfs:comment 'Externally-visible business identifier for the AR transaction. Used in customer communications and financial reporting.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transactionStatus rdf:type rdf:Property ;
    rdfs:label 'Transaction Status' ;
    rdfs:comment 'Current lifecycle status of the AR transaction in the collection workflow. [ENUM-REF-CANDIDATE: draft|open|partially_paid|paid|written_off|disputed|cancelled — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:ArTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transactionType rdf:type rdf:Property ;
    rdfs:label 'Transaction Type' ;
    rdfs:comment 'Classification of the AR transaction by revenue stream category. Determines accounting treatment and revenue recognition rules.' ;
    rdfs:domain ind:ArTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:writeOffAmount rdf:type rdf:Property ;
    rdfs:label 'Write Off Amount' ;
    rdfs:comment 'Amount written off as uncollectible per the utility\'s bad debt policy. Reduces outstanding balance and impacts allowance for doubtful accounts.' ;
    rdfs:domain ind:ArTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:allotmentAmount rdf:type rdf:Property ;
    rdfs:label 'Allotment Amount' ;
    rdfs:comment 'Portion of the appropriation amount allocated for a specific period (e.g., quarterly or monthly allotment), used for cash flow management and spending control.' ;
    rdfs:domain ind:FinanceBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:amendmentNumber rdf:type rdf:Property ;
    rdfs:label 'Amendment Number' ;
    rdfs:comment 'Sequential number indicating the count of amendments made to the original budget, used for version control and audit trail.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appropriationAmount rdf:type rdf:Property ;
    rdfs:label 'Appropriation Amount' ;
    rdfs:comment 'Total budgeted amount appropriated for this budget line, representing the authorized spending limit for the fiscal year.' ;
    rdfs:domain ind:FinanceBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:authoritySource rdf:type rdf:Property ;
    rdfs:label 'Authority Source' ;
    rdfs:comment 'Legal or administrative source of budget authority, such as board resolution number, city ordinance, or state appropriation act, providing traceability to the authorizing document.' ;
    rdfs:domain ind:FinanceBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:boardResolutionNumber rdf:type rdf:Property ;
    rdfs:label 'Board Resolution Number' ;
    rdfs:comment 'Board resolution number' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:budgetCategory rdf:type rdf:Property ;
    rdfs:label 'Budget Category' ;
    rdfs:comment 'High-level classification of the budget expenditure type: personnel (salaries and benefits), materials (supplies and inventory), services (contracted services), utilities (energy and water), debt service (principal and interest), or transfers (inter-fund transfers).' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:budgetDescription rdf:type rdf:Property ;
    rdfs:label 'Budget Description' ;
    rdfs:comment 'Detailed narrative description of the budget line, explaining the purpose, scope, and intended use of the appropriated funds.' ;
    rdfs:domain ind:FinanceBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:budgetName rdf:type rdf:Property ;
    rdfs:label 'Budget Name' ;
    rdfs:comment 'Budget name' ;
    rdfs:domain ind:FinanceBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:budgetNumber rdf:type rdf:Property ;
    rdfs:label 'Budget Number' ;
    rdfs:comment 'Externally-known unique identifier for the budget, typically formatted as BUD-YYYY-NNNNNN.' ;
    rdfs:domain ind:FinanceBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:budgetPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Budget Period End Date' ;
    rdfs:comment 'Budget period end date' ;
    rdfs:domain ind:FinanceBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:budgetPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Budget Period Start Date' ;
    rdfs:comment 'Budget period start date' ;
    rdfs:domain ind:FinanceBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:budgetStatus rdf:type rdf:Property ;
    rdfs:label 'Budget Status' ;
    rdfs:comment 'Current lifecycle status of the budget: draft (in preparation), submitted (awaiting approval), approved (board-approved), active (in effect), or closed (fiscal year ended).' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:budgetType rdf:type rdf:Property ;
    rdfs:label 'Budget Type' ;
    rdfs:comment 'Classification of the budget: operating (OPEX - day-to-day operations and maintenance), capital (CAPEX - infrastructure and asset investments), or grant (externally funded projects).' ;
    rdfs:domain ind:FinanceBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:debtServiceFlag rdf:type rdf:Property ;
    rdfs:label 'Debt Service Flag' ;
    rdfs:comment 'Boolean indicator (True/False) denoting whether this budget line is designated for debt service payments (principal and interest on bonds or loans).' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:encumbranceAmount rdf:type rdf:Property ;
    rdfs:label 'Encumbrance Amount' ;
    rdfs:comment 'Amount of the budget that has been encumbered (committed via purchase orders or contracts) but not yet expended, used for budget availability tracking.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:grantNumber rdf:type rdf:Property ;
    rdfs:label 'Grant Number' ;
    rdfs:comment 'Grant or external funding source identifier if this budget is funded by a grant, used for grant compliance and reporting.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:officerEmail rdf:type rdf:Property ;
    rdfs:label 'Officer Email' ;
    rdfs:comment 'Email address of the budget officer responsible for this budget line, used for communication and escalation.' ;
    rdfs:domain ind:FinanceBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:officerName rdf:type rdf:Property ;
    rdfs:label 'Officer Name' ;
    rdfs:comment 'Name of the budget officer or financial manager responsible for this budget line, used for accountability and contact purposes.' ;
    rdfs:domain ind:FinanceBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateCaseFlag rdf:type rdf:Property ;
    rdfs:label 'Rate Case Flag' ;
    rdfs:comment 'Boolean indicator (True/False) denoting whether this budget line is included in rate case preparation and regulatory filings for rate adjustments.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:budgetLineId rdf:type rdf:Property ;
    rdfs:label 'Budget Line Id' ;
    rdfs:comment 'Unique identifier for the budget line item record. Primary key for the budget line entity.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BudgetLine .

ind:budgetEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Budget Employee Id' ;
    rdfs:comment 'Reference to the employee or manager responsible for managing and monitoring this budget line item. Links to the employee or workforce entity.' ;
    rdfs:domain ind:BudgetLine ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:primaryBudgetManagerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Budget Manager Employee Id' ;
    rdfs:comment 'Reference to the employee or manager responsible for managing and monitoring this budget line item. Links to the employee or workforce entity.' ;
    rdfs:domain ind:BudgetLine ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:actualAmount rdf:type rdf:Property ;
    rdfs:label 'Actual Amount' ;
    rdfs:comment 'Actual amount' ;
    rdfs:domain ind:BudgetLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:actualExpenditureAmount rdf:type rdf:Property ;
    rdfs:label 'Actual Expenditure Amount' ;
    rdfs:comment 'The cumulative actual expenditures posted to this budget line item to date within the fiscal year. Represents funds that have been spent and recorded in the general ledger.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:amendedBudgetAmount rdf:type rdf:Property ;
    rdfs:label 'Amended Budget Amount' ;
    rdfs:comment 'The current amended budget amount for this line item, reflecting all approved budget amendments, transfers, and adjustments since the original budget. This is the current authorized spending limit.' ;
    rdfs:domain ind:BudgetLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:availableBalanceAmount rdf:type rdf:Property ;
    rdfs:label 'Available Balance Amount' ;
    rdfs:comment 'The remaining available budget balance for this line item, calculated as amended budget amount minus encumbrances minus actual expenditures. Represents funds still available for commitment or expenditure.' ;
    rdfs:domain ind:BudgetLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:encumberedAmount rdf:type rdf:Property ;
    rdfs:label 'Encumbered Amount' ;
    rdfs:comment 'Encumbered amount' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:grantCode rdf:type rdf:Property ;
    rdfs:label 'Grant Code' ;
    rdfs:comment 'The grant or external funding source code associated with this budget line item, if applicable. Used to track grant-funded expenditures and ensure compliance with grant terms and conditions.' ;
    rdfs:domain ind:BudgetLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:originalBudgetAmount rdf:type rdf:Property ;
    rdfs:label 'Original Budget Amount' ;
    rdfs:comment 'The original approved budget amount for this line item at the start of the fiscal year. Represents the initial allocation before any amendments or adjustments.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:period01Amount rdf:type rdf:Property ;
    rdfs:label 'Period 01 Amount' ;
    rdfs:comment 'Period 1 budget' ;
    rdfs:domain ind:BudgetLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:period02Amount rdf:type rdf:Property ;
    rdfs:label 'Period 02 Amount' ;
    rdfs:comment 'Period 2 budget' ;
    rdfs:domain ind:BudgetLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:period03Amount rdf:type rdf:Property ;
    rdfs:label 'Period 03 Amount' ;
    rdfs:comment 'Period 3 budget' ;
    rdfs:domain ind:BudgetLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:period04Amount rdf:type rdf:Property ;
    rdfs:label 'Period 04 Amount' ;
    rdfs:comment 'Period 4 budget' ;
    rdfs:domain ind:BudgetLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:period05Amount rdf:type rdf:Property ;
    rdfs:label 'Period 05 Amount' ;
    rdfs:comment 'Period 5 budget' ;
    rdfs:domain ind:BudgetLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:period06Amount rdf:type rdf:Property ;
    rdfs:label 'Period 06 Amount' ;
    rdfs:comment 'Period 6 budget' ;
    rdfs:domain ind:BudgetLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:period07Amount rdf:type rdf:Property ;
    rdfs:label 'Period 07 Amount' ;
    rdfs:comment 'Period 7 budget' ;
    rdfs:domain ind:BudgetLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:period08Amount rdf:type rdf:Property ;
    rdfs:label 'Period 08 Amount' ;
    rdfs:comment 'Period 8 budget' ;
    rdfs:domain ind:BudgetLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:period09Amount rdf:type rdf:Property ;
    rdfs:label 'Period 09 Amount' ;
    rdfs:comment 'Period 9 budget' ;
    rdfs:domain ind:BudgetLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:period10Amount rdf:type rdf:Property ;
    rdfs:label 'Period 10 Amount' ;
    rdfs:comment 'Period 10 budget' ;
    rdfs:domain ind:BudgetLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:period11Amount rdf:type rdf:Property ;
    rdfs:label 'Period 11 Amount' ;
    rdfs:comment 'Period 11 budget' ;
    rdfs:domain ind:BudgetLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:period12Amount rdf:type rdf:Property ;
    rdfs:label 'Period 12 Amount' ;
    rdfs:comment 'Period 12 budget' ;
    rdfs:domain ind:BudgetLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:variancePct rdf:type rdf:Property ;
    rdfs:label 'Variance Pct' ;
    rdfs:comment 'Variance percentage' ;
    rdfs:domain ind:BudgetLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:assetCapacity rdf:type rdf:Property ;
    rdfs:label 'Asset Capacity' ;
    rdfs:comment 'Rated capacity or throughput of the asset in appropriate units (e.g., MGD for treatment plants, GPM for pumps, PSI for pressure vessels). The unit of measure is specified in capacity_unit_of_measure.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:assetStatus rdf:type rdf:Property ;
    rdfs:label 'Asset Status' ;
    rdfs:comment 'Current lifecycle status of the fixed asset indicating its operational state and availability.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assetTagNumber rdf:type rdf:Property ;
    rdfs:label 'Asset Tag Number' ;
    rdfs:comment 'Externally visible unique identifier assigned to the physical asset for tracking and inventory purposes. Typically affixed to the asset as a barcode or RFID tag.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gasbCapitalAssetCategory rdf:type rdf:Property ;
    rdfs:label 'Gasb Capital Asset Category' ;
    rdfs:comment 'GASB-compliant capital asset classification for financial reporting and compliance with governmental accounting standards. [ENUM-REF-CANDIDATE: land|land_improvements|buildings|building_improvements|infrastructure|machinery_and_equipment|vehicles|construction_in_progress — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:insuranceValue rdf:type rdf:Property ;
    rdfs:label 'Insurance Value' ;
    rdfs:comment 'Insured value or replacement cost of the asset for insurance purposes. Recorded in USD.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isContributedAsset rdf:type rdf:Property ;
    rdfs:label 'Is Contributed Asset' ;
    rdfs:comment 'Contributed asset flag' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastConditionAssessmentDate rdf:type rdf:Property ;
    rdfs:label 'Last Condition Assessment Date' ;
    rdfs:comment 'Date of the most recent condition assessment or inspection performed on this asset.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sapAssetNumber rdf:type rdf:Property ;
    rdfs:label 'Sap Asset Number' ;
    rdfs:comment 'Asset master record number in SAP FI-AA (Fixed Assets) module, used for financial accounting and depreciation posting.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:administratorEmail rdf:type rdf:Property ;
    rdfs:label 'Administrator Email' ;
    rdfs:comment 'Email address of the grant administrator for internal coordination and external grantor communication.' ;
    rdfs:domain ind:Grant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:administratorName rdf:type rdf:Property ;
    rdfs:label 'Administrator Name' ;
    rdfs:comment 'Name of the utility employee responsible for administering this grant, including compliance, reporting, and drawdown coordination.' ;
    rdfs:domain ind:Grant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:administratorPhone rdf:type rdf:Property ;
    rdfs:label 'Administrator Phone' ;
    rdfs:comment 'Phone number of the grant administrator.' ;
    rdfs:domain ind:Grant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allowableCostCategories rdf:type rdf:Property ;
    rdfs:label 'Allowable Cost Categories' ;
    rdfs:comment 'Description of the types of costs that may be charged to the grant (e.g., \'Capital construction, engineering design, equipment acquisition, project management\' or \'Operations and maintenance, personnel, supplies\'). Defined in the grant agreement.' ;
    rdfs:domain ind:Grant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:awardAmount rdf:type rdf:Property ;
    rdfs:label 'Award Amount' ;
    rdfs:comment 'Total dollar amount of the grant or loan award as specified in the grant agreement. For loans, this is the principal amount.' ;
    rdfs:domain ind:Grant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:awardDate rdf:type rdf:Property ;
    rdfs:label 'Award Date' ;
    rdfs:comment 'Date on which the grant or loan was officially awarded to the utility by the grantor agency. This is the effective date of the grant agreement.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cfdaNumber rdf:type rdf:Property ;
    rdfs:label 'Cfda Number' ;
    rdfs:comment 'Five-digit CFDA number identifying the federal program (e.g., 66.458 for Capitalization Grants for Clean Water State Revolving Funds). Required for federal grants and single audit reporting.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:closeoutDate rdf:type rdf:Property ;
    rdfs:label 'Closeout Date' ;
    rdfs:comment 'Date on which the grant was formally closed out with the grantor agency, including submission of final financial and performance reports.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:complianceConditions rdf:type rdf:Property ;
    rdfs:label 'Compliance Conditions' ;
    rdfs:comment 'Summary of key compliance requirements and special conditions attached to the grant (e.g., \'Davis-Bacon prevailing wage requirements, Buy America provisions, environmental review compliance, quarterly progress reporting\').' ;
    rdfs:domain ind:Grant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grantDescription rdf:type rdf:Property ;
    rdfs:label 'Grant Description' ;
    rdfs:comment 'Grant description' ;
    rdfs:domain ind:Grant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:drawdownScheduleDescription rdf:type rdf:Property ;
    rdfs:label 'Drawdown Schedule Description' ;
    rdfs:comment 'Description of the schedule or milestones for drawing down grant funds (e.g., \'Quarterly reimbursement based on actual expenditures\', \'Milestone-based: 30% at design completion, 60% at construction midpoint, 10% at final acceptance\').' ;
    rdfs:domain ind:Grant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:federalAwardIdentificationNumber rdf:type rdf:Property ;
    rdfs:label 'Federal Award Identification Number' ;
    rdfs:comment 'Unique Federal Award Identification Number (FAIN) assigned by the federal agency for tracking and reporting purposes. Required for federal transparency reporting (FFATA).' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:firstPaymentDueDate rdf:type rdf:Property ;
    rdfs:label 'First Payment Due Date' ;
    rdfs:comment 'Date on which the first loan repayment is due. Applicable only to loan-type grants.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:forgivenessConditions rdf:type rdf:Property ;
    rdfs:label 'Forgiveness Conditions' ;
    rdfs:comment 'Description of conditions under which a forgivable loan may be forgiven (e.g., \'Principal forgiveness of 50% upon project completion and 5 years of compliant operation\'). Null if not applicable.' ;
    rdfs:domain ind:Grant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grantStatus rdf:type rdf:Property ;
    rdfs:label 'Grant Status' ;
    rdfs:comment 'Current lifecycle status of the grant: pending (application submitted), awarded (approved but not yet active), active (funds being drawn and spent), suspended (temporarily halted), closed (completed successfully), terminated (ended prematurely).' ;
    rdfs:domain ind:Grant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grantorAgencyCode rdf:type rdf:Property ;
    rdfs:label 'Grantor Agency Code' ;
    rdfs:comment 'Standardized code for the grantor agency (e.g., EPA, USDA, HUD) used for classification and reporting.' ;
    rdfs:domain ind:Grant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grantorAgencyName rdf:type rdf:Property ;
    rdfs:label 'Grantor Agency Name' ;
    rdfs:comment 'Name of the federal, state, or local agency providing the grant or loan (e.g., \'U.S. Environmental Protection Agency\', \'State Water Resources Control Board\', \'USDA Rural Development\').' ;
    rdfs:domain ind:Grant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:indirectCostRate rdf:type rdf:Property ;
    rdfs:label 'Indirect Cost Rate' ;
    rdfs:comment 'Approved indirect cost rate (as a percentage) that may be applied to direct costs for this grant. Based on federally negotiated indirect cost rate agreement or de minimis rate.' ;
    rdfs:domain ind:Grant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isReimbursementGrant rdf:type rdf:Property ;
    rdfs:label 'Is Reimbursement Grant' ;
    rdfs:comment 'Reimbursement grant flag' ;
    rdfs:domain ind:Grant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:matchPct rdf:type rdf:Property ;
    rdfs:label 'Match Pct' ;
    rdfs:comment 'Match percentage' ;
    rdfs:domain ind:Grant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:matchRequiredAmount rdf:type rdf:Property ;
    rdfs:label 'Match Required Amount' ;
    rdfs:comment 'Required match amount' ;
    rdfs:domain ind:Grant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:matchingAmountRequired rdf:type rdf:Property ;
    rdfs:label 'Matching Amount Required' ;
    rdfs:comment 'Dollar amount of local matching funds required by the grant agreement. Calculated based on matching_requirement_percentage and total project cost.' ;
    rdfs:domain ind:Grant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:matchingRequirementPercentage rdf:type rdf:Property ;
    rdfs:label 'Matching Requirement Percentage' ;
    rdfs:comment 'Percentage of project costs that the utility must contribute as a match (e.g., 20.00 for a 20% local match requirement). Zero if no match is required.' ;
    rdfs:domain ind:Grant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:grantName rdf:type rdf:Property ;
    rdfs:label 'Grant Name' ;
    rdfs:comment 'Descriptive name or title of the grant project (e.g., \'Water Infrastructure Improvements Financing Act Loan for Treatment Plant Expansion\', \'State Revolving Fund - Distribution System Rehabilitation\').' ;
    rdfs:domain ind:Grant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:passThroughEntityIdentifyingNumber rdf:type rdf:Property ;
    rdfs:label 'Pass Through Entity Identifying Number' ;
    rdfs:comment 'Identifying number assigned by the pass-through entity to this subaward. Required for Single Audit reporting when applicable.' ;
    rdfs:domain ind:Grant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:passThroughEntityName rdf:type rdf:Property ;
    rdfs:label 'Pass Through Entity Name' ;
    rdfs:comment 'Name of the pass-through entity if the grant is received from a state or local agency that is itself a federal grant recipient (e.g., \'State Water Resources Control Board\'). Null if received directly from federal agency.' ;
    rdfs:domain ind:Grant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:periodOfPerformanceEndDate rdf:type rdf:Property ;
    rdfs:label 'Period Of Performance End Date' ;
    rdfs:comment 'End date of the grant period. All allowable costs must be incurred by this date. Extensions require formal amendment.' ;
    rdfs:domain ind:Grant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:periodOfPerformanceStartDate rdf:type rdf:Property ;
    rdfs:label 'Period Of Performance Start Date' ;
    rdfs:comment 'Start date of the grant period during which costs may be incurred and charged to the grant. May differ from award_date.' ;
    rdfs:domain ind:Grant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:program rdf:type rdf:Property ;
    rdfs:label 'Program' ;
    rdfs:comment 'WIFIA, SRF, ARPA, FEMA, EPA' ;
    rdfs:domain ind:Grant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:projectDescription rdf:type rdf:Property ;
    rdfs:label 'Project Description' ;
    rdfs:comment 'Detailed description of the capital or operational project funded by this grant (e.g., \'Replacement of 5 miles of aging water distribution mains in the downtown district\', \'Upgrade of wastewater treatment plant secondary clarifiers and UV disinfection system\').' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:projectLocation rdf:type rdf:Property ;
    rdfs:label 'Project Location' ;
    rdfs:comment 'Geographic location or service area where the grant-funded project is being implemented (e.g., \'Downtown Water Treatment Plant, 123 Main St\', \'District 4 Distribution Network\').' ;
    rdfs:domain ind:Grant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:repaymentTermMonths rdf:type rdf:Property ;
    rdfs:label 'Repayment Term Months' ;
    rdfs:comment 'Total repayment period in months for loan-type grants. Null for non-repayable grants.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:singleAuditRequired rdf:type rdf:Property ;
    rdfs:label 'Single Audit Required' ;
    rdfs:comment 'Single audit required flag' ;
    rdfs:domain ind:Grant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:singleAuditRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Single Audit Required Flag' ;
    rdfs:comment 'Indicates whether this grant is subject to Single Audit Act requirements (OMB Uniform Guidance). True if the utility expends $750,000 or more in federal awards in a fiscal year.' ;
    rdfs:domain ind:Grant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:totalAmountDrawn rdf:type rdf:Property ;
    rdfs:label 'Total Amount Drawn' ;
    rdfs:comment 'Cumulative dollar amount of grant funds that have been drawn down or reimbursed to date. Updated as drawdown requests are processed.' ;
    rdfs:domain ind:Grant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:grantExpenditureId rdf:type rdf:Property ;
    rdfs:label 'Grant Expenditure Id' ;
    rdfs:comment 'Unique identifier for the grant expenditure transaction record.' ;
    rdfs:domain ind:GrantExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:drawdownRequestId rdf:type rdf:Property ;
    rdfs:label 'Drawdown Request Id' ;
    rdfs:comment 'Reference to the grant drawdown or reimbursement request in which this expenditure was included.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DrawdownRequest .

ind:auditFindingFlag rdf:type rdf:Property ;
    rdfs:label 'Audit Finding Flag' ;
    rdfs:comment 'Indicates whether this expenditure has been flagged in a grant audit or single audit finding.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:auditFindingReference rdf:type rdf:Property ;
    rdfs:label 'Audit Finding Reference' ;
    rdfs:comment 'Reference number or description of the audit finding associated with this expenditure, if applicable.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grantExpenditureDescription rdf:type rdf:Property ;
    rdfs:label 'Grant Expenditure Description' ;
    rdfs:comment 'A detailed narrative description of the goods, services, or activities for which the expenditure was incurred.' ;
    rdfs:domain ind:GrantExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eligibilityClassification rdf:type rdf:Property ;
    rdfs:label 'Eligibility Classification' ;
    rdfs:comment 'Classification indicating whether the expenditure is eligible, ineligible, partially eligible, or pending review for grant reimbursement.' ;
    rdfs:domain ind:GrantExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eligibleAmount rdf:type rdf:Property ;
    rdfs:label 'Eligible Amount' ;
    rdfs:comment 'The portion of the expenditure amount that is eligible for reimbursement under the grant terms.' ;
    rdfs:domain ind:GrantExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:expenditureAmount rdf:type rdf:Property ;
    rdfs:label 'Expenditure Amount' ;
    rdfs:comment 'The total dollar amount of the expenditure charged to the grant.' ;
    rdfs:domain ind:GrantExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:expenditureCategory rdf:type rdf:Property ;
    rdfs:label 'Expenditure Category' ;
    rdfs:comment 'Personnel, Equipment, Supplies, Contractual, Other' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expenditureDate rdf:type rdf:Property ;
    rdfs:label 'Expenditure Date' ;
    rdfs:comment 'The date on which the expenditure was incurred or the transaction occurred.' ;
    rdfs:domain ind:GrantExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:indirectCostAmount rdf:type rdf:Property ;
    rdfs:label 'Indirect Cost Amount' ;
    rdfs:comment 'Indirect cost amount' ;
    rdfs:domain ind:GrantExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ineligibleAmount rdf:type rdf:Property ;
    rdfs:label 'Ineligible Amount' ;
    rdfs:comment 'The portion of the expenditure amount that is not eligible for reimbursement under the grant terms.' ;
    rdfs:domain ind:GrantExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isDirectCost rdf:type rdf:Property ;
    rdfs:label 'Is Direct Cost' ;
    rdfs:comment 'Direct cost flag' ;
    rdfs:domain ind:GrantExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:matchAmount rdf:type rdf:Property ;
    rdfs:label 'Match Amount' ;
    rdfs:comment 'The dollar amount of this expenditure that counts toward the grantee match or cost-sharing requirement.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:matchRequirementFlag rdf:type rdf:Property ;
    rdfs:label 'Match Requirement Flag' ;
    rdfs:comment 'Indicates whether this expenditure is used to satisfy a grant match or cost-sharing requirement.' ;
    rdfs:domain ind:GrantExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reimbursementReceivedFlag rdf:type rdf:Property ;
    rdfs:label 'Reimbursement Received Flag' ;
    rdfs:comment 'Reimbursement received flag' ;
    rdfs:domain ind:GrantExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reimbursementRequestedFlag rdf:type rdf:Property ;
    rdfs:label 'Reimbursement Requested Flag' ;
    rdfs:comment 'Reimbursement requested flag' ;
    rdfs:domain ind:GrantExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:debtInstrumentId rdf:type rdf:Property ;
    rdfs:label 'Debt Instrument Id' ;
    rdfs:comment 'Unique identifier for the debt instrument record in the water utility\'s long-term debt portfolio.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DebtInstrument .

ind:amortizationType rdf:type rdf:Property ;
    rdfs:label 'Amortization Type' ;
    rdfs:comment 'The structure of principal repayment over the life of the debt. Level principal has equal principal payments; level debt service has equal combined principal and interest payments; bullet has single principal payment at maturity; serial has staggered maturities; term has single maturity date.' ;
    rdfs:domain ind:DebtInstrument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bondCounselName rdf:type rdf:Property ;
    rdfs:label 'Bond Counsel Name' ;
    rdfs:comment 'The name of the law firm that provided the legal opinion on the validity and tax-exempt status of the debt issuance.' ;
    rdfs:domain ind:DebtInstrument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bondRating rdf:type rdf:Property ;
    rdfs:label 'Bond Rating' ;
    rdfs:comment 'The credit quality rating assigned to the debt instrument by rating agencies (e.g., Moody\'s, S&P, Fitch). Common ratings include AAA, AA, A, BBB, etc. Higher ratings indicate lower credit risk and typically result in lower interest costs.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cafrReportingCategory rdf:type rdf:Property ;
    rdfs:label 'Cafr Reporting Category' ;
    rdfs:comment 'The category under which this debt instrument is reported in the utility\'s CAFR. Water utilities typically report under business-type activities as enterprise funds.' ;
    rdfs:domain ind:DebtInstrument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:callDate rdf:type rdf:Property ;
    rdfs:label 'Call Date' ;
    rdfs:comment 'The earliest date on which the issuer may exercise the call option to redeem the debt instrument before maturity. Null if the instrument is non-callable.' ;
    rdfs:domain ind:DebtInstrument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:callPremiumPercentage rdf:type rdf:Property ;
    rdfs:label 'Call Premium Percentage' ;
    rdfs:comment 'The premium above par value that the issuer must pay to bondholders if the debt is called before maturity, expressed as a percentage (e.g., 2.0000 represents 2.00% premium). Null if non-callable.' ;
    rdfs:domain ind:DebtInstrument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:callableFlag rdf:type rdf:Property ;
    rdfs:label 'Callable Flag' ;
    rdfs:comment 'Boolean flag indicating whether the issuer has the right to redeem (call) the debt instrument before its stated maturity date. True indicates callable; False indicates non-callable.' ;
    rdfs:domain ind:DebtInstrument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:couponFrequency rdf:type rdf:Property ;
    rdfs:label 'Coupon Frequency' ;
    rdfs:comment 'The frequency at which interest payments (coupons) are made to bondholders or lenders. Semi-annual is most common for municipal bonds.' ;
    rdfs:domain ind:DebtInstrument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:covenantDescription rdf:type rdf:Property ;
    rdfs:label 'Covenant Description' ;
    rdfs:comment 'Description of financial covenants and restrictions imposed by the debt agreement, such as debt service coverage ratio requirements, rate covenant obligations, reserve fund requirements, or restrictions on additional debt issuance.' ;
    rdfs:domain ind:DebtInstrument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cusipNumber rdf:type rdf:Property ;
    rdfs:label 'Cusip Number' ;
    rdfs:comment 'The 9-character alphanumeric identifier assigned to the debt instrument for trading and settlement purposes in the securities market. Format: 3 digits (issuer), 6 alphanumeric (issue), 1 check digit.' ;
    rdfs:domain ind:DebtInstrument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:debtDescription rdf:type rdf:Property ;
    rdfs:label 'Debt Description' ;
    rdfs:comment 'Debt description' ;
    rdfs:domain ind:DebtInstrument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:debtNumber rdf:type rdf:Property ;
    rdfs:label 'Debt Number' ;
    rdfs:comment 'Debt instrument number' ;
    rdfs:domain ind:DebtInstrument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:debtServiceReserveRequirement rdf:type rdf:Property ;
    rdfs:label 'Debt Service Reserve Requirement' ;
    rdfs:comment 'The required balance to be maintained in the debt service reserve fund as specified in the bond indenture, typically equal to maximum annual debt service or a percentage of outstanding principal.' ;
    rdfs:domain ind:DebtInstrument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:debtType rdf:type rdf:Property ;
    rdfs:label 'Debt Type' ;
    rdfs:comment 'Revenue Bond, GO Bond, SRF Loan, WIFIA Loan, Note Payable' ;
    rdfs:domain ind:DebtInstrument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:instrumentNumber rdf:type rdf:Property ;
    rdfs:label 'Instrument Number' ;
    rdfs:comment 'The externally-known unique identifier or serial number assigned to the debt instrument by the issuer, trustee, or financial institution (e.g., bond CUSIP, loan agreement number).' ;
    rdfs:domain ind:DebtInstrument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:instrumentStatus rdf:type rdf:Property ;
    rdfs:label 'Instrument Status' ;
    rdfs:comment 'Current lifecycle status of the debt instrument. Active indicates the debt is outstanding and serviced; matured indicates principal fully repaid at term end; defeased indicates legally satisfied through irrevocable trust; refunded indicates replaced by new debt issuance; defaulted indicates payment obligations not met; cancelled indicates instrument voided before issuance.' ;
    rdfs:domain ind:DebtInstrument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:insuranceProvider rdf:type rdf:Property ;
    rdfs:label 'Insurance Provider' ;
    rdfs:comment 'The name of the bond insurance company providing credit enhancement for the debt instrument, if applicable. Bond insurance guarantees timely payment of principal and interest in case of issuer default.' ;
    rdfs:domain ind:DebtInstrument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interestCalculationMethod rdf:type rdf:Property ;
    rdfs:label 'Interest Calculation Method' ;
    rdfs:comment 'The day-count convention used to calculate accrued interest. 30/360 assumes 30-day months and 360-day years; Actual/360 uses actual days and 360-day years; Actual/365 uses actual days and 365-day years; Actual/Actual uses actual days and actual year length.' ;
    rdfs:domain ind:DebtInstrument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interestRateType rdf:type rdf:Property ;
    rdfs:label 'Interest Rate Type' ;
    rdfs:comment 'Classification of the interest rate structure. Fixed rates remain constant over the life of the instrument; variable rates adjust periodically based on market indices; zero coupon instruments accrue interest but pay at maturity.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isCallable rdf:type rdf:Property ;
    rdfs:label 'Is Callable' ;
    rdfs:comment 'Callable flag' ;
    rdfs:domain ind:DebtInstrument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isinNumber rdf:type rdf:Property ;
    rdfs:label 'Isin Number' ;
    rdfs:comment 'The 12-character alphanumeric code that uniquely identifies the debt instrument in international securities markets. Format: 2-letter country code + 9-character national identifier + 1 check digit.' ;
    rdfs:domain ind:DebtInstrument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:liquidityProviderName rdf:type rdf:Property ;
    rdfs:label 'Liquidity Provider Name' ;
    rdfs:comment 'For variable rate demand obligations, the name of the financial institution providing the standby bond purchase agreement or letter of credit to ensure liquidity if bonds cannot be remarketed.' ;
    rdfs:domain ind:DebtInstrument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maturityDate rdf:type rdf:Property ;
    rdfs:label 'Maturity Date' ;
    rdfs:comment 'The date on which the final principal payment is due and the debt instrument obligation is fully satisfied.' ;
    rdfs:domain ind:DebtInstrument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:originalPrincipalAmount rdf:type rdf:Property ;
    rdfs:label 'Original Principal Amount' ;
    rdfs:comment 'The total face value or principal amount of the debt instrument at issuance, before any payments or amortization.' ;
    rdfs:domain ind:DebtInstrument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:outstandingPrincipalAmount rdf:type rdf:Property ;
    rdfs:label 'Outstanding Principal Amount' ;
    rdfs:comment 'Outstanding principal amount' ;
    rdfs:domain ind:DebtInstrument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:outstandingPrincipalBalance rdf:type rdf:Property ;
    rdfs:label 'Outstanding Principal Balance' ;
    rdfs:comment 'The current unpaid principal balance remaining on the debt instrument after all principal payments to date.' ;
    rdfs:domain ind:DebtInstrument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:payingAgentName rdf:type rdf:Property ;
    rdfs:label 'Paying Agent Name' ;
    rdfs:comment 'The name of the financial institution designated to distribute principal and interest payments to bondholders on behalf of the issuer.' ;
    rdfs:domain ind:DebtInstrument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentFrequency rdf:type rdf:Property ;
    rdfs:label 'Payment Frequency' ;
    rdfs:comment 'Monthly, Quarterly, Semi-Annual, Annual' ;
    rdfs:domain ind:DebtInstrument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:purpose rdf:type rdf:Property ;
    rdfs:label 'Purpose' ;
    rdfs:comment 'The intended use of proceeds from the debt issuance, such as capital improvement projects (CIP), infrastructure replacement, system expansion, refunding existing debt, or working capital needs.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateResetFrequency rdf:type rdf:Property ;
    rdfs:label 'Rate Reset Frequency' ;
    rdfs:comment 'For variable rate debt, the frequency at which the interest rate is recalculated and adjusted based on the underlying index.' ;
    rdfs:domain ind:DebtInstrument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ratingAgency rdf:type rdf:Property ;
    rdfs:label 'Rating Agency' ;
    rdfs:comment 'The name of the credit rating agency that assigned the bond rating (e.g., Moody\'s Investors Service, Standard & Poor\'s, Fitch Ratings).' ;
    rdfs:domain ind:DebtInstrument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remarketingAgentName rdf:type rdf:Property ;
    rdfs:label 'Remarketing Agent Name' ;
    rdfs:comment 'For variable rate demand obligations, the name of the financial institution responsible for resetting the interest rate and remarketing bonds tendered by investors.' ;
    rdfs:domain ind:DebtInstrument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:securityType rdf:type rdf:Property ;
    rdfs:label 'Security Type' ;
    rdfs:comment 'The type of security or collateral backing the debt instrument. Revenue pledge is secured by utility operating revenues; general obligation by taxing power; special assessment by property assessments; moral obligation by non-binding commitment; unsecured has no specific collateral.' ;
    rdfs:domain ind:DebtInstrument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trusteeName rdf:type rdf:Property ;
    rdfs:label 'Trustee Name' ;
    rdfs:comment 'The name of the financial institution serving as trustee, responsible for safeguarding bondholders\' interests, holding collateral, and ensuring compliance with bond covenants.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:underwriterName rdf:type rdf:Property ;
    rdfs:label 'Underwriter Name' ;
    rdfs:comment 'The name of the investment banking firm or financial institution that underwrote the debt issuance and facilitated its sale to investors.' ;
    rdfs:domain ind:DebtInstrument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:variableRateIndex rdf:type rdf:Property ;
    rdfs:label 'Variable Rate Index' ;
    rdfs:comment 'For variable rate debt, the market index to which the interest rate is tied, such as SOFR (Secured Overnight Financing Rate), LIBOR (being phased out), SIFMA (Securities Industry and Financial Markets Association Municipal Swap Index), or Prime Rate.' ;
    rdfs:domain ind:DebtInstrument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:debtServicePaymentId rdf:type rdf:Property ;
    rdfs:label 'Debt Service Payment Id' ;
    rdfs:comment 'Unique identifier for the debt service payment transaction.' ;
    rdfs:domain ind:DebtServicePayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:actualPaymentDate rdf:type rdf:Property ;
    rdfs:label 'Actual Payment Date' ;
    rdfs:comment 'Actual payment date' ;
    rdfs:domain ind:DebtServicePayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:covenantComplianceIndicator rdf:type rdf:Property ;
    rdfs:label 'Covenant Compliance Indicator' ;
    rdfs:comment 'Boolean flag indicating whether this debt service payment was made in compliance with all bond covenants and debt service coverage requirements.' ;
    rdfs:domain ind:DebtServicePayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:debtServiceCoverageRatio rdf:type rdf:Property ;
    rdfs:label 'Debt Service Coverage Ratio' ;
    rdfs:comment 'The debt service coverage ratio calculated at the time of this payment, representing the ratio of net revenues available for debt service to the debt service payment amount, used for bond covenant monitoring.' ;
    rdfs:domain ind:DebtServicePayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:feesAmount rdf:type rdf:Property ;
    rdfs:label 'Fees Amount' ;
    rdfs:comment 'Additional fees associated with the debt service payment, including trustee fees, paying agent fees, or administrative charges.' ;
    rdfs:domain ind:DebtServicePayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:glDocumentNumber rdf:type rdf:Property ;
    rdfs:label 'Gl Document Number' ;
    rdfs:comment 'The general ledger document or journal entry number associated with the debt service payment transaction in SAP FI or Tyler Munis.' ;
    rdfs:domain ind:DebtServicePayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:latePaymentIndicator rdf:type rdf:Property ;
    rdfs:label 'Late Payment Indicator' ;
    rdfs:comment 'Boolean flag indicating whether the debt service payment was made after the contractual due date.' ;
    rdfs:domain ind:DebtServicePayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:latePaymentPenaltyAmount rdf:type rdf:Property ;
    rdfs:label 'Late Payment Penalty Amount' ;
    rdfs:comment 'Penalty amount assessed for late payment of debt service, if applicable per the bond indenture or loan agreement.' ;
    rdfs:domain ind:DebtServicePayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:premiumDiscountAmortization rdf:type rdf:Property ;
    rdfs:label 'Premium Discount Amortization' ;
    rdfs:comment 'The amortization amount for bond premium or discount allocated to this payment period, following the effective interest method or straight-line method as applicable.' ;
    rdfs:domain ind:DebtServicePayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reserveFundDrawAmount rdf:type rdf:Property ;
    rdfs:label 'Reserve Fund Draw Amount' ;
    rdfs:comment 'The amount drawn from the debt service reserve fund to supplement this payment, if applicable.' ;
    rdfs:domain ind:DebtServicePayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reserveFundDrawIndicator rdf:type rdf:Property ;
    rdfs:label 'Reserve Fund Draw Indicator' ;
    rdfs:comment 'Boolean flag indicating whether this debt service payment required a draw from the debt service reserve fund to meet the obligation.' ;
    rdfs:domain ind:DebtServicePayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:totalPaymentAmount rdf:type rdf:Property ;
    rdfs:label 'Total Payment Amount' ;
    rdfs:comment 'The total amount of the debt service payment, including principal, interest, amortization, and fees.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:transactionReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Transaction Reference Number' ;
    rdfs:comment 'Bank or financial system transaction reference number for the debt service payment, used for reconciliation and audit trail.' ;
    rdfs:domain ind:DebtServicePayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trusteeConfirmationNumber rdf:type rdf:Property ;
    rdfs:label 'Trustee Confirmation Number' ;
    rdfs:comment 'Confirmation or reference number provided by the bond trustee or paying agent acknowledging receipt and processing of the debt service payment.' ;
    rdfs:domain ind:DebtServicePayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tylerMunisTransactionReference rdf:type rdf:Property ;
    rdfs:label 'Tyler Munis Transaction Reference' ;
    rdfs:comment 'Tyler Technologies Munis system transaction identifier for the debt service payment, used for municipal utilities.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:canonicalServiceRateCaseId rdf:type rdf:Property ;
    rdfs:label 'Canonical Service Rate Case Id' ;
    rdfs:domain ind:FinanceRateCase ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ServiceRateCase .

ind:serviceRateCaseId rdf:type rdf:Property ;
    rdfs:label 'Service Rate Case Id' ;
    rdfs:comment 'FK to canonical SSOT entity service.service_rate_case' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ServiceRateCase .

ind:allowedRateOfReturn rdf:type rdf:Property ;
    rdfs:label 'Allowed Rate Of Return' ;
    rdfs:comment 'The overall rate of return on rate base authorized by the regulatory commission, expressed as a decimal (e.g., 0.0725 for 7.25%). Represents the weighted average cost of capital (WACC) including debt and equity components.' ;
    rdfs:domain ind:FinanceRateCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:allowedReturnOnEquity rdf:type rdf:Property ;
    rdfs:label 'Allowed Return On Equity' ;
    rdfs:comment 'The authorized return on equity component of the rate of return, expressed as a decimal (e.g., 0.0950 for 9.50%). Represents the profit margin allowed on shareholder equity investment in the utility.' ;
    rdfs:domain ind:FinanceRateCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:approvedRevenueRequirement rdf:type rdf:Property ;
    rdfs:label 'Approved Revenue Requirement' ;
    rdfs:comment 'Total annual revenue requirement approved by the regulatory commission or utility board. This is the final authorized revenue level after regulatory review, hearings, and adjustments. May differ from the requested amount due to disallowed costs, rate base adjustments, or modified return on equity. Expressed in USD.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:capitalImprovementProgramAmount rdf:type rdf:Property ;
    rdfs:label 'Capital Improvement Program Amount' ;
    rdfs:comment 'Total value of the Capital Improvement Program (CIP) or Capital Expenditure (CAPEX) plan supporting the rate case, covering planned infrastructure investments during the test year and rate period. Expressed in USD.' ;
    rdfs:domain ind:FinanceRateCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:commercialRateImpactPercentage rdf:type rdf:Property ;
    rdfs:label 'Commercial Rate Impact Percentage' ;
    rdfs:comment 'Percentage change in typical commercial customer bills resulting from the approved rate case.' ;
    rdfs:domain ind:FinanceRateCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:consultant rdf:type rdf:Property ;
    rdfs:label 'Consultant' ;
    rdfs:comment 'Name of the external consulting firm or advisor retained to prepare the rate case filing, cost of service study, and regulatory testimony. Common firms include Black & Veatch, Raftelis, NewGen Strategies, and specialized rate consultants.' ;
    rdfs:domain ind:FinanceRateCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:customerClassAllocationMethod rdf:type rdf:Property ;
    rdfs:label 'Customer Class Allocation Method' ;
    rdfs:comment 'The cost allocation methodology used to distribute revenue requirements across customer classes (residential, commercial, industrial, public authority). Base-extra-capacity allocates fixed costs by capacity and variable by usage; commodity-demand splits by consumption and peak demand; customer count uses simple per-account allocation; meter equivalent weights by meter size; peak demand allocates by maximum usage contribution.' ;
    rdfs:domain ind:FinanceRateCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:debtServiceAmount rdf:type rdf:Property ;
    rdfs:label 'Debt Service Amount' ;
    rdfs:comment 'Annual debt service costs (principal and interest payments) on utility bonds and loans included in the revenue requirement. Expressed in USD.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:decisionDocumentUrl rdf:type rdf:Property ;
    rdfs:label 'Decision Document Url' ;
    rdfs:comment 'Web link to the official commission decision document, order, or ruling. Typically hosted on the Public Utilities Commission website or document management system.' ;
    rdfs:domain ind:FinanceRateCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:depreciationExpenseAmount rdf:type rdf:Property ;
    rdfs:label 'Depreciation Expense Amount' ;
    rdfs:comment 'Annual depreciation expense included in the revenue requirement, calculated based on approved depreciation rates and asset lives for utility plant and equipment. Expressed in USD.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:docketNumber rdf:type rdf:Property ;
    rdfs:label 'Docket Number' ;
    rdfs:comment 'Official docket or case number assigned by the Public Utilities Commission (PUC) or regulatory body for tracking the rate proceeding. This is the externally-known identifier used in all regulatory filings and correspondence.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gasbComplianceNotes rdf:type rdf:Property ;
    rdfs:label 'Gasb Compliance Notes' ;
    rdfs:comment 'Free-text notes documenting compliance with Governmental Accounting Standards Board (GASB) requirements for municipal utilities, including fund accounting, regulatory asset/liability treatment, and financial statement presentation.' ;
    rdfs:domain ind:FinanceRateCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:industrialRateImpactPercentage rdf:type rdf:Property ;
    rdfs:label 'Industrial Rate Impact Percentage' ;
    rdfs:comment 'Percentage change in typical industrial customer bills resulting from the approved rate case.' ;
    rdfs:domain ind:FinanceRateCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:intervenorCount rdf:type rdf:Property ;
    rdfs:label 'Intervenor Count' ;
    rdfs:comment 'Number of parties granted intervenor status in the rate case proceeding. Intervenors may include consumer advocates, industrial customer groups, environmental organizations, or other stakeholders with standing to participate.' ;
    rdfs:domain ind:FinanceRateCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:leadAttorney rdf:type rdf:Property ;
    rdfs:label 'Lead Attorney' ;
    rdfs:comment 'Name of the lead legal counsel representing the utility in the rate case proceeding. May be in-house counsel or external regulatory law firm.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextRateCaseAnticipatedDate rdf:type rdf:Property ;
    rdfs:label 'Next Rate Case Anticipated Date' ;
    rdfs:comment 'Anticipated filing date for the next general rate case. Used for financial planning and analysis (FP&A) and long-term capital planning. May be driven by regulatory requirements, financial need, or strategic timing.' ;
    rdfs:domain ind:FinanceRateCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:operatingExpenseAmount rdf:type rdf:Property ;
    rdfs:label 'Operating Expense Amount' ;
    rdfs:comment 'Total annual operating expenses included in the approved revenue requirement. Includes operations and maintenance (O&M) costs, administrative expenses, purchased water, power, chemicals, labor, and other recurring costs. Expressed in USD.' ;
    rdfs:domain ind:FinanceRateCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rateBase rdf:type rdf:Property ;
    rdfs:label 'Rate Base' ;
    rdfs:comment 'Rate base' ;
    rdfs:domain ind:FinanceRateCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rateBaseAmount rdf:type rdf:Property ;
    rdfs:label 'Rate Base Amount' ;
    rdfs:comment 'The net value of utility plant and equipment upon which the utility is allowed to earn a return. Calculated as gross plant in service plus working capital minus accumulated depreciation and contributions in aid of construction. Expressed in USD.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rateCaseName rdf:type rdf:Property ;
    rdfs:label 'Rate Case Name' ;
    rdfs:comment 'Rate case name' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateCaseStatus rdf:type rdf:Property ;
    rdfs:label 'Rate Case Status' ;
    rdfs:comment 'Filed, Pending, Approved, Denied' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateCaseType rdf:type rdf:Property ;
    rdfs:label 'Rate Case Type' ;
    rdfs:comment 'General Rate Case, Interim Rate Adjustment, WICA' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateDesignMethodology rdf:type rdf:Property ;
    rdfs:label 'Rate Design Methodology' ;
    rdfs:comment 'The pricing methodology used to allocate the approved revenue requirement across customer classes and rate components. Cost of service allocates based on cost causation; value of service considers customer willingness to pay; marginal cost reflects incremental supply costs; tiered conservation encourages efficiency; uniform rate applies flat pricing; lifeline protects low-income customers.' ;
    rdfs:domain ind:FinanceRateCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Rate Effective Date' ;
    rdfs:comment 'Date on which the approved rates become effective and are applied to customer bills. May be subject to refund provisions during appeal periods or interim rate periods.' ;
    rdfs:domain ind:FinanceRateCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:rateOfReturn rdf:type rdf:Property ;
    rdfs:label 'Rate Of Return' ;
    rdfs:comment 'Rate of return' ;
    rdfs:domain ind:FinanceRateCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatoryCommission rdf:type rdf:Property ;
    rdfs:label 'Regulatory Commission' ;
    rdfs:comment 'Regulatory commission name' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryLagDays rdf:type rdf:Property ;
    rdfs:label 'Regulatory Lag Days' ;
    rdfs:comment 'Number of days between rate case filing and rate effective date. Regulatory lag represents the period during which the utility operates under outdated rates while awaiting approval, potentially impacting financial performance.' ;
    rdfs:domain ind:FinanceRateCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:requestedRevenueRequirement rdf:type rdf:Property ;
    rdfs:label 'Requested Revenue Requirement' ;
    rdfs:comment 'Total annual revenue requirement requested by the utility in the rate case filing. Represents the utility\'s calculation of the revenue needed to cover operating expenses (OPEX), capital costs (CAPEX), debt service, and allowed return on investment (ROI). Expressed in USD.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:residentialRateImpactPercentage rdf:type rdf:Property ;
    rdfs:label 'Residential Rate Impact Percentage' ;
    rdfs:comment 'Percentage change in typical residential customer bills resulting from the approved rate case. Used for public communication and affordability analysis.' ;
    rdfs:domain ind:FinanceRateCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:revenueIncreaseAmount rdf:type rdf:Property ;
    rdfs:label 'Revenue Increase Amount' ;
    rdfs:comment 'Dollar amount of the approved revenue increase (or decrease if negative) compared to current authorized revenue levels. Calculated as approved revenue requirement minus current revenue requirement. Expressed in USD.' ;
    rdfs:domain ind:FinanceRateCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:revenueIncreasePercentage rdf:type rdf:Property ;
    rdfs:label 'Revenue Increase Percentage' ;
    rdfs:comment 'Percentage increase (or decrease if negative) in authorized revenue compared to current levels. Calculated as (revenue increase amount / current revenue requirement) * 100. Used for public communication and rate impact analysis.' ;
    rdfs:domain ind:FinanceRateCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:settlementAgreementFlag rdf:type rdf:Property ;
    rdfs:label 'Settlement Agreement Flag' ;
    rdfs:comment 'Indicates whether the rate case was resolved through a negotiated settlement agreement among parties rather than a fully litigated commission decision. Settlements often result in faster resolution and reduced regulatory costs.' ;
    rdfs:domain ind:FinanceRateCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:testYear rdf:type rdf:Property ;
    rdfs:label 'Test Year' ;
    rdfs:comment 'Test year' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:testYearEndDate rdf:type rdf:Property ;
    rdfs:label 'Test Year End Date' ;
    rdfs:comment 'Ending date of the test year period used to establish the utility\'s revenue requirements and cost structure.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:testYearStartDate rdf:type rdf:Property ;
    rdfs:label 'Test Year Start Date' ;
    rdfs:comment 'Beginning date of the test year period used to establish the utility\'s revenue requirements and cost structure. The test year is the 12-month period (historical or forecasted) upon which rate calculations are based.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:testYearType rdf:type rdf:Property ;
    rdfs:label 'Test Year Type' ;
    rdfs:comment 'Indicates whether the test year is based on historical actual data, forecasted future data, or a hybrid approach combining historical base with known adjustments. Regulatory bodies may have preferences or requirements for test year methodology.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorizedRateOfReturnPercentage rdf:type rdf:Property ;
    rdfs:label 'Authorized Rate Of Return Percentage' ;
    rdfs:comment 'The rate of return on rate base authorized by the Public Utilities Commission (PUC), typically based on the utility\'s weighted average cost of capital (WACC).' ;
    rdfs:domain ind:RevenueRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:calculationStatus rdf:type rdf:Property ;
    rdfs:label 'Calculation Status' ;
    rdfs:comment 'Current lifecycle status of the revenue requirement calculation in the regulatory approval process.' ;
    rdfs:domain ind:RevenueRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capitalExpenditureAmount rdf:type rdf:Property ;
    rdfs:label 'Capital Expenditure Amount' ;
    rdfs:comment 'Planned capital expenditures allocated to this customer class for the test year, supporting infrastructure investment and asset renewal programs.' ;
    rdfs:domain ind:RevenueRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:currentRevenueAmount rdf:type rdf:Property ;
    rdfs:label 'Current Revenue Amount' ;
    rdfs:comment 'Current annual revenue collected from this customer class under existing rates, used to calculate the revenue sufficiency gap.' ;
    rdfs:domain ind:RevenueRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:grantFundingAmount rdf:type rdf:Property ;
    rdfs:label 'Grant Funding Amount' ;
    rdfs:comment 'Grant funding or subsidies allocated to this customer class that offset the revenue requirement, such as EPA grants or state infrastructure funding.' ;
    rdfs:domain ind:RevenueRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:omExpenseAmount rdf:type rdf:Property ;
    rdfs:label 'Om Expense Amount' ;
    rdfs:comment 'Total operations and maintenance expenses allocated to this customer class for the test year, including labor, chemicals, utilities, and routine maintenance costs.' ;
    rdfs:domain ind:RevenueRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:operatingExpenditureAmount rdf:type rdf:Property ;
    rdfs:label 'Operating Expenditure Amount' ;
    rdfs:comment 'Total operating expenditures allocated to this customer class for the test year, including O&M expenses and administrative costs.' ;
    rdfs:domain ind:RevenueRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rateAdjustmentPercentage rdf:type rdf:Property ;
    rdfs:label 'Rate Adjustment Percentage' ;
    rdfs:comment 'The percentage rate increase or decrease required for this customer class to meet the revenue requirement, calculated as (revenue sufficiency gap / current revenue) * 100.' ;
    rdfs:domain ind:RevenueRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:returnOnRateBaseAmount rdf:type rdf:Property ;
    rdfs:label 'Return On Rate Base Amount' ;
    rdfs:comment 'The allowed return on the utility\'s rate base (net plant investment) allocated to this customer class, calculated as rate base multiplied by the authorized rate of return.' ;
    rdfs:domain ind:RevenueRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:revenueSufficiencyGapAmount rdf:type rdf:Property ;
    rdfs:label 'Revenue Sufficiency Gap Amount' ;
    rdfs:comment 'The difference between the total revenue requirement and current revenue, representing the additional revenue needed from this customer class. Positive values indicate a revenue shortfall; negative values indicate a surplus.' ;
    rdfs:domain ind:RevenueRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:taxExpenseAmount rdf:type rdf:Property ;
    rdfs:label 'Tax Expense Amount' ;
    rdfs:comment 'Income taxes, property taxes, and other tax obligations allocated to this customer class for the test year.' ;
    rdfs:domain ind:RevenueRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalRevenueRequirementAmount rdf:type rdf:Property ;
    rdfs:label 'Total Revenue Requirement Amount' ;
    rdfs:comment 'Total revenue requirement for this customer class, calculated as the sum of O&M expenses, depreciation, debt service, return on rate base, and taxes.' ;
    rdfs:domain ind:RevenueRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:approverName rdf:type rdf:Property ;
    rdfs:label 'Approver Name' ;
    rdfs:comment 'Name of the manager or authorized official who approved the encumbrance, ensuring budgetary control and authorization.' ;
    rdfs:domain ind:Encumbrance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:budgetLineItem rdf:type rdf:Property ;
    rdfs:label 'Budget Line Item' ;
    rdfs:comment 'Specific budget line item or appropriation code against which the encumbrance is charged, enabling detailed budget vs. actual tracking.' ;
    rdfs:domain ind:Encumbrance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:encumbranceDescription rdf:type rdf:Property ;
    rdfs:label 'Encumbrance Description' ;
    rdfs:comment 'Detailed narrative description of the purpose and nature of the encumbrance, including goods or services to be acquired.' ;
    rdfs:domain ind:Encumbrance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:encumbranceDate rdf:type rdf:Property ;
    rdfs:label 'Encumbrance Date' ;
    rdfs:comment 'Date the encumbrance was recorded in the financial system, reserving budget funds for the obligation.' ;
    rdfs:domain ind:Encumbrance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:encumbranceNumber rdf:type rdf:Property ;
    rdfs:label 'Encumbrance Number' ;
    rdfs:comment 'Business-facing document number for the encumbrance, typically generated by the financial system (SAP or Tyler Munis) for tracking and reference purposes.' ;
    rdfs:domain ind:Encumbrance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:encumbranceStatus rdf:type rdf:Property ;
    rdfs:label 'Encumbrance Status' ;
    rdfs:comment 'Current lifecycle status of the encumbrance: open (active and uncommitted balance remains), partially_liquidated (some invoices applied), fully_liquidated (all funds expended), closed (fiscal year-end closure), cancelled (voided before liquidation), or reversed (accounting correction).' ;
    rdfs:domain ind:Encumbrance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:encumbranceType rdf:type rdf:Property ;
    rdfs:label 'Encumbrance Type' ;
    rdfs:comment 'Classification of the encumbrance stage: pre-encumbrance (requisition stage), encumbrance (purchase order or contract issued), reservation (blanket order), or commitment (other obligating document).' ;
    rdfs:domain ind:Encumbrance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:liquidatedAmount rdf:type rdf:Property ;
    rdfs:label 'Liquidated Amount' ;
    rdfs:comment 'Cumulative amount of the encumbrance that has been liquidated (expended) through invoice payments or other expenditure transactions.' ;
    rdfs:domain ind:Encumbrance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:originatingDocumentDate rdf:type rdf:Property ;
    rdfs:label 'Originating Document Date' ;
    rdfs:comment 'Date the originating document (purchase order, contract, etc.) was issued or executed, establishing the commitment.' ;
    rdfs:domain ind:Encumbrance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:originatingDocumentNumber rdf:type rdf:Property ;
    rdfs:label 'Originating Document Number' ;
    rdfs:comment 'Document number of the source transaction that created this encumbrance (e.g., PO number, contract number, requisition number).' ;
    rdfs:domain ind:Encumbrance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:originatingDocumentType rdf:type rdf:Property ;
    rdfs:label 'Originating Document Type' ;
    rdfs:comment 'Type of source document that created the encumbrance: purchase order, contract, blanket order, requisition, work order, or service agreement.' ;
    rdfs:domain ind:Encumbrance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remainingAmount rdf:type rdf:Property ;
    rdfs:label 'Remaining Amount' ;
    rdfs:comment 'Remaining amount' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:yearEndCarryforwardFlag rdf:type rdf:Property ;
    rdfs:label 'Year End Carryforward Flag' ;
    rdfs:comment 'Indicates whether the encumbrance is eligible to be carried forward to the next fiscal year if not fully liquidated by year-end. True if carryforward is allowed, False otherwise.' ;
    rdfs:domain ind:Encumbrance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sweepTargetAccountId rdf:type rdf:Property ;
    rdfs:label 'Sweep Target Account Id' ;
    rdfs:comment 'The identifier of the bank account to which funds are swept when the sweep arrangement is triggered. Null if no sweep arrangement exists.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BankAccount .

ind:accountPurpose rdf:type rdf:Property ;
    rdfs:label 'Account Purpose' ;
    rdfs:comment 'Operating, Debt Service, Construction, Payroll' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accountPurposeDescription rdf:type rdf:Property ;
    rdfs:label 'Account Purpose Description' ;
    rdfs:comment 'A detailed description of the specific business purpose and intended use of this bank account within the water utility\'s operations.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorizedSignatoryCount rdf:type rdf:Property ;
    rdfs:label 'Authorized Signatory Count' ;
    rdfs:comment 'The number of individuals authorized to sign checks or approve electronic transactions on this account.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:bankBranchName rdf:type rdf:Property ;
    rdfs:label 'Bank Branch Name' ;
    rdfs:comment 'The name or identifier of the specific bank branch where the account is maintained.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bankName rdf:type rdf:Property ;
    rdfs:label 'Bank Name' ;
    rdfs:comment 'The legal name of the bank or financial institution where the account is held.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bankRoutingNumber rdf:type rdf:Property ;
    rdfs:label 'Bank Routing Number' ;
    rdfs:comment 'The nine-digit American Bankers Association (ABA) routing transit number that identifies the financial institution for electronic funds transfers and check processing.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collateralValueAmount rdf:type rdf:Property ;
    rdfs:label 'Collateral Value Amount' ;
    rdfs:comment 'The current market value of securities or other assets pledged by the financial institution as collateral for uninsured deposits in this account.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:collateralizationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Collateralization Required Flag' ;
    rdfs:comment 'Indicates whether the financial institution is required to provide collateral for deposits exceeding FDIC insurance limits, as mandated by state law or utility policy.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dailyBalanceLimitAmount rdf:type rdf:Property ;
    rdfs:label 'Daily Balance Limit Amount' ;
    rdfs:comment 'The maximum balance amount permitted in this account on any given day, as defined by treasury policy or regulatory requirements. Used for cash management and investment policy compliance.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dualSignatureRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Dual Signature Required Flag' ;
    rdfs:comment 'Indicates whether transactions above a certain threshold require two authorized signatures for approval, as a control measure.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dualSignatureThresholdAmount rdf:type rdf:Property ;
    rdfs:label 'Dual Signature Threshold Amount' ;
    rdfs:comment 'The transaction amount above which dual signature authorization is required.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fdicInsuredFlag rdf:type rdf:Property ;
    rdfs:label 'Fdic Insured Flag' ;
    rdfs:comment 'Indicates whether the account is insured by the Federal Deposit Insurance Corporation up to applicable limits.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:interestBearingFlag rdf:type rdf:Property ;
    rdfs:label 'Interest Bearing Flag' ;
    rdfs:comment 'Indicates whether this account earns interest on deposited funds.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:interestRatePercentage rdf:type rdf:Property ;
    rdfs:label 'Interest Rate Percentage' ;
    rdfs:comment 'The current annual interest rate percentage applied to the account balance, if the account is interest-bearing.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:investmentPolicyComplianceFlag rdf:type rdf:Property ;
    rdfs:label 'Investment Policy Compliance Flag' ;
    rdfs:comment 'Indicates whether this account and its associated investment activities comply with the water utility\'s board-approved investment policy and applicable state and federal regulations.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastReconciliationDate rdf:type rdf:Property ;
    rdfs:label 'Last Reconciliation Date' ;
    rdfs:comment 'The date when the most recent bank reconciliation was completed for this account, ensuring that the utility\'s records match the bank\'s records.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:openingDate rdf:type rdf:Property ;
    rdfs:label 'Opening Date' ;
    rdfs:comment 'The date when the bank account was originally opened with the financial institution.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:routingNumber rdf:type rdf:Property ;
    rdfs:label 'Routing Number' ;
    rdfs:comment 'Bank routing number' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sapHouseBankCode rdf:type rdf:Property ;
    rdfs:label 'Sap House Bank Code' ;
    rdfs:comment 'The SAP house bank identifier that links this bank account to the SAP treasury management module for payment processing and cash management.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sweepArrangementFlag rdf:type rdf:Property ;
    rdfs:label 'Sweep Arrangement Flag' ;
    rdfs:comment 'Indicates whether this account participates in an automated cash sweep arrangement where excess funds are automatically transferred to an investment account or vice versa.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sweepThresholdAmount rdf:type rdf:Property ;
    rdfs:label 'Sweep Threshold Amount' ;
    rdfs:comment 'The balance threshold that triggers the automated sweep of funds to or from the target account.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:trusteeAgreementNumber rdf:type rdf:Property ;
    rdfs:label 'Trustee Agreement Number' ;
    rdfs:comment 'The reference number of the trust agreement governing this account, if managed by a trustee.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tylerMunisBankCode rdf:type rdf:Property ;
    rdfs:label 'Tyler Munis Bank Code' ;
    rdfs:comment 'The bank code identifier used in Tyler Technologies Munis system for municipal financial management and fund accounting integration.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bankReconciliationId rdf:type rdf:Property ;
    rdfs:label 'Bank Reconciliation Id' ;
    rdfs:comment 'Unique identifier for the bank reconciliation record. Primary key for the bank reconciliation entity.' ;
    rdfs:domain ind:BankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:bankApprovedByEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Bank Approved By Employee Id' ;
    rdfs:comment 'Approved by employee' ;
    rdfs:domain ind:BankReconciliation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:bankApprovedByUserEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Bank Approved By User Employee Id' ;
    rdfs:comment 'User ID of the authorized approver who provided final approval of the bank reconciliation, completing the control cycle.' ;
    rdfs:domain ind:BankReconciliation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:bankEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Bank Employee Id' ;
    rdfs:comment 'User ID of the staff member who prepared the bank reconciliation, supporting segregation of duties and accountability.' ;
    rdfs:domain ind:BankReconciliation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:bankReconciledByEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Bank Reconciled By Employee Id' ;
    rdfs:comment 'Reconciled by employee' ;
    rdfs:domain ind:BankReconciliation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:bankReviewedByUserEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Bank Reviewed By User Employee Id' ;
    rdfs:comment 'User ID of the supervisor or manager who reviewed the bank reconciliation, supporting internal control requirements.' ;
    rdfs:domain ind:BankReconciliation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:primaryBankEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Bank Employee Id' ;
    rdfs:comment 'User ID of the staff member who prepared the bank reconciliation, supporting segregation of duties and accountability.' ;
    rdfs:domain ind:BankReconciliation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:tertiaryBankApprovedByUserEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Tertiary Bank Approved By User Employee Id' ;
    rdfs:comment 'User ID of the authorized approver who provided final approval of the bank reconciliation, completing the control cycle.' ;
    rdfs:domain ind:BankReconciliation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:adjustedBankBalanceAmount rdf:type rdf:Property ;
    rdfs:label 'Adjusted Bank Balance Amount' ;
    rdfs:comment 'The bank statement balance after applying outstanding checks, deposits in transit, and other bank-side adjustments.' ;
    rdfs:domain ind:BankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:adjustedGlBalanceAmount rdf:type rdf:Property ;
    rdfs:label 'Adjusted Gl Balance Amount' ;
    rdfs:comment 'The GL balance after applying unrecorded bank charges, credits, NSF checks, and other GL-side adjustments.' ;
    rdfs:domain ind:BankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bankAdjustmentsAmount rdf:type rdf:Property ;
    rdfs:label 'Bank Adjustments Amount' ;
    rdfs:comment 'Bank adjustments amount' ;
    rdfs:domain ind:BankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bankChargesAmount rdf:type rdf:Property ;
    rdfs:label 'Bank Charges Amount' ;
    rdfs:comment 'Total amount of bank service charges, fees, and other deductions appearing on the bank statement but not yet recorded in the GL.' ;
    rdfs:domain ind:BankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bankCreditsAmount rdf:type rdf:Property ;
    rdfs:label 'Bank Credits Amount' ;
    rdfs:comment 'Total amount of interest income, wire transfers, or other credits appearing on the bank statement but not yet recorded in the GL.' ;
    rdfs:domain ind:BankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bankStatementBalanceAmount rdf:type rdf:Property ;
    rdfs:label 'Bank Statement Balance Amount' ;
    rdfs:comment 'The ending balance per the bank statement for the reconciliation period, as reported by the financial institution.' ;
    rdfs:domain ind:BankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bankStatementDate rdf:type rdf:Property ;
    rdfs:label 'Bank Statement Date' ;
    rdfs:comment 'The statement date from the bank statement being reconciled, which may differ from the period end date.' ;
    rdfs:domain ind:BankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:bankStatementReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Bank Statement Reference Number' ;
    rdfs:comment 'The reference or document number from the bank statement being reconciled, used for audit trail and verification.' ;
    rdfs:domain ind:BankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bookAdjustmentsAmount rdf:type rdf:Property ;
    rdfs:label 'Book Adjustments Amount' ;
    rdfs:comment 'Book adjustments amount' ;
    rdfs:domain ind:BankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:depositsInTransitAmount rdf:type rdf:Property ;
    rdfs:label 'Deposits In Transit Amount' ;
    rdfs:comment 'Total amount of deposits recorded in the GL but not yet reflected on the bank statement as of the period end date.' ;
    rdfs:domain ind:BankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:glBalanceAmount rdf:type rdf:Property ;
    rdfs:label 'Gl Balance Amount' ;
    rdfs:comment 'The cash balance per the general ledger for this account as of the period end date, before reconciling adjustments.' ;
    rdfs:domain ind:BankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:glEndingBalance rdf:type rdf:Property ;
    rdfs:label 'Gl Ending Balance' ;
    rdfs:comment 'GL ending balance' ;
    rdfs:domain ind:BankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:glPostingDocumentNumber rdf:type rdf:Property ;
    rdfs:label 'Gl Posting Document Number' ;
    rdfs:comment 'The journal entry document number for any GL adjustments posted as a result of this reconciliation.' ;
    rdfs:domain ind:BankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nsfChecksAmount rdf:type rdf:Property ;
    rdfs:label 'Nsf Checks Amount' ;
    rdfs:comment 'Total amount of customer checks returned by the bank due to insufficient funds, requiring GL adjustment.' ;
    rdfs:domain ind:BankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:otherReconcilingItemsAmount rdf:type rdf:Property ;
    rdfs:label 'Other Reconciling Items Amount' ;
    rdfs:comment 'Net amount of all other reconciling items not classified in the standard categories, including errors, adjustments, and timing differences.' ;
    rdfs:domain ind:BankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:outstandingChecksAmount rdf:type rdf:Property ;
    rdfs:label 'Outstanding Checks Amount' ;
    rdfs:comment 'Total amount of checks issued and recorded in the GL but not yet cleared by the bank as of the period end date.' ;
    rdfs:domain ind:BankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:outstandingItemsCount rdf:type rdf:Property ;
    rdfs:label 'Outstanding Items Count' ;
    rdfs:comment 'Total number of outstanding reconciling items (checks, deposits, adjustments) identified during the reconciliation process.' ;
    rdfs:domain ind:BankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:preparedDate rdf:type rdf:Property ;
    rdfs:label 'Prepared Date' ;
    rdfs:comment 'The date on which the reconciliation was prepared, distinct from the reconciliation date and period end date.' ;
    rdfs:domain ind:BankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reconciledBalance rdf:type rdf:Property ;
    rdfs:label 'Reconciled Balance' ;
    rdfs:comment 'Reconciled balance' ;
    rdfs:domain ind:BankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reconciledBalanceAmount rdf:type rdf:Property ;
    rdfs:label 'Reconciled Balance Amount' ;
    rdfs:comment 'The final reconciled cash balance that should match between adjusted GL and adjusted bank balances, representing the true cash position.' ;
    rdfs:domain ind:BankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reconciliationMethod rdf:type rdf:Property ;
    rdfs:label 'Reconciliation Method' ;
    rdfs:comment 'The method used to perform the reconciliation, indicating level of automation and system support.' ;
    rdfs:domain ind:BankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reconciliationNotes rdf:type rdf:Property ;
    rdfs:label 'Reconciliation Notes' ;
    rdfs:comment 'Free-text notes documenting unusual items, explanations for variances, follow-up actions, or other relevant information for audit and review purposes.' ;
    rdfs:domain ind:BankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reconciliationNumber rdf:type rdf:Property ;
    rdfs:label 'Reconciliation Number' ;
    rdfs:comment 'Business identifier for the reconciliation record, typically formatted as RECON-YYYY-MM-ACCT or similar pattern used for external reference and audit trail.' ;
    rdfs:domain ind:BankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewedByName rdf:type rdf:Property ;
    rdfs:label 'Reviewed By Name' ;
    rdfs:comment 'Full name of the supervisor or manager who reviewed the reconciliation for audit trail and reporting purposes.' ;
    rdfs:domain ind:BankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:statementDate rdf:type rdf:Property ;
    rdfs:label 'Statement Date' ;
    rdfs:comment 'Bank statement date' ;
    rdfs:domain ind:BankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:statementEndingBalance rdf:type rdf:Property ;
    rdfs:label 'Statement Ending Balance' ;
    rdfs:comment 'Statement ending balance' ;
    rdfs:domain ind:BankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:interfundTransferId rdf:type rdf:Property ;
    rdfs:label 'Interfund Transfer Id' ;
    rdfs:comment 'Unique identifier for the interfund_transfer data product (auto-inserted pre-linking).' ;
    rdfs:domain ind:InterfundTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:destinationCostCenterId rdf:type rdf:Property ;
    rdfs:label 'Destination Cost Center Id' ;
    rdfs:comment 'Destination cost center' ;
    rdfs:domain ind:InterfundTransfer ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CostCenter .

ind:destinationFundId rdf:type rdf:Property ;
    rdfs:label 'Destination Fund Id' ;
    rdfs:domain ind:InterfundTransfer ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Fund .

ind:fromFundId rdf:type rdf:Property ;
    rdfs:label 'From Fund Id' ;
    rdfs:comment 'Source fund' ;
    rdfs:domain ind:InterfundTransfer ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Fund .

ind:interfundApprovedByEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Interfund Approved By Employee Id' ;
    rdfs:comment 'Employee who approved transfer' ;
    rdfs:domain ind:InterfundTransfer ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:interfundAuthorizedByEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Interfund Authorized By Employee Id' ;
    rdfs:comment 'Employee who authorized the transfer.' ;
    rdfs:domain ind:InterfundTransfer ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:interfundCreatedByEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Interfund Created By Employee Id' ;
    rdfs:domain ind:InterfundTransfer ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:interfundPostedByEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Interfund Posted By Employee Id' ;
    rdfs:comment 'FK to workforce.employee (poster)' ;
    rdfs:domain ind:InterfundTransfer ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:interfundPreparedByEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Interfund Prepared By Employee Id' ;
    rdfs:comment 'Employee who prepared transfer' ;
    rdfs:domain ind:InterfundTransfer ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:interfundResponsibleEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Interfund Responsible Employee Id' ;
    rdfs:domain ind:InterfundTransfer ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:reversalInterfundTransferId rdf:type rdf:Property ;
    rdfs:label 'Reversal Interfund Transfer Id' ;
    rdfs:comment 'Self-referencing FK on interfund_transfer (reversal_interfund_transfer_id)' ;
    rdfs:domain ind:InterfundTransfer ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:InterfundTransfer .

ind:sourceCostCenterId rdf:type rdf:Property ;
    rdfs:label 'Source Cost Center Id' ;
    rdfs:comment 'Source cost center' ;
    rdfs:domain ind:InterfundTransfer ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CostCenter .

ind:sourceFundId rdf:type rdf:Property ;
    rdfs:label 'Source Fund Id' ;
    rdfs:comment 'Foreign key linking to finance.fund. Business justification: Interfund transfers move money from a source fund. The interfund_transfer table has no visible attributes other than PK, so this FK is needed to link to the source fund. The FK uses the descriptive pr' ;
    rdfs:domain ind:InterfundTransfer ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Fund .

ind:toFundId rdf:type rdf:Property ;
    rdfs:label 'To Fund Id' ;
    rdfs:comment 'Destination fund' ;
    rdfs:domain ind:InterfundTransfer ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Fund .

ind:authorizationReference rdf:type rdf:Property ;
    rdfs:label 'Authorization Reference' ;
    rdfs:comment 'Board resolution or authorization reference' ;
    rdfs:domain ind:InterfundTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interfundTransferCategory rdf:type rdf:Property ;
    rdfs:label 'Interfund Transfer Category' ;
    rdfs:domain ind:InterfundTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interfundTransferCode rdf:type rdf:Property ;
    rdfs:label 'Interfund Transfer Code' ;
    rdfs:domain ind:InterfundTransfer ;
    rdf:type owl:DatatypeProperty ;
