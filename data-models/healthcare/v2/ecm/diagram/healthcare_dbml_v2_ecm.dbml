  notes varchar [note: 'Free-text notes']
  npi varchar [note: 'National Provider Identifier for payer']
  payer_category varchar [note: 'Category (commercial, Medicare, Medicaid, self-pay)']
  payer_name varchar [note: 'Official payer name']
  payer_type varchar [note: 'Type (HMO, PPO, EPO, POS, Indemnity)']
  payment_terms_days varchar [note: 'Standard payment terms in days']
  portal_url varchar [note: 'URL for payer portal']
  prior_authorization_required boolean [note: 'Whether prior auth is required']
  provider_relations_email varchar [note: 'Email for provider relations']
  remittance_address_line1 varchar [note: 'Remittance address line 1']
  remittance_address_line2 varchar [note: 'Remittance address line 2']
  remittance_city varchar [note: 'Remittance city']
  remittance_delivery_method varchar [note: 'Remittance delivery method (mail, EDI, portal)']
  remittance_postal_code varchar [note: 'Remittance postal code']
  remittance_state varchar [note: 'Remittance state']
  risk_adjustment_model varchar [note: 'Risk adjustment model used (CMS-HCC, HHS-HCC, etc.).']
  short_name varchar [note: 'Short name or abbreviation']
  submission_method varchar [note: 'Claim submission method (EDI, portal, paper)']
  tax_identification_number varchar [note: 'Payer TIN']
  tier varchar [note: 'Payer tier (national, regional, local)']
  timely_filing_limit_days varchar [note: 'Timely filing limit in days']
  updated_timestamp timestamp [note: 'Last update timestamp']
  vibe_added_flag boolean [note: 'Marker added by VIBE batch to ensure touch']
  vibe_batch_marker varchar
  vibe_mutation_added varchar [note: 'Added by VIBE mutation to satisfy target entity touch requirement']
  vibe_mutation_extra varchar [note: 'Placeholder attribute added by VIBE mutation to ensure model change.']
  vibe_mutation_marker varchar [note: 'Generic mutation marker']
  vibe_structure_marker varchar [note: 'structure enforcement marker']

  Note: 'Insurance payer organization (commercial, government, self-pay) that adjudicates and pays claims.'
}

