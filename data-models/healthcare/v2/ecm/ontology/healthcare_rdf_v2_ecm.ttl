ind:Part2Consent rdf:type rdfs:Class ;
    rdfs:subClassOf ind:BehavioralHealth ;
    rdfs:label 'Part2 Consent' ;
    rdfs:comment '42 CFR Part 2 disclosure consent linking to clinical treatment' .

ind:SnfStay rdf:type rdfs:Class ;
    rdfs:subClassOf ind:PostAcute ;
    rdfs:label 'Snf Stay' ;
    rdfs:comment '' .

ind:HomeHealthEpisode rdf:type rdfs:Class ;
