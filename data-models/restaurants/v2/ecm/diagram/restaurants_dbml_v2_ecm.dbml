  early_payment_due_date date [note: 'Due date for early payment discount.']
  exchange_rate decimal(12,6) [note: 'Exchange rate applied.']
  external_comments varchar [note: 'Comments from supplier.']
  gross_amount decimal(18,2) [note: 'Gross invoice amount.']
