    rdfs:comment 'CPT-coded radiology procedure(s) that trigger this distribution rule; comma-delimited CPT codes or code range applicable.' ;
    rdfs:domain ind:DistributionRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:quietHoursEnd rdf:type rdf:Property ;
    rdfs:label 'Quiet Hours End' ;
    rdfs:comment 'End of the daily quiet-hours window during which non-critical distributions are suppressed or deferred (HH:mm, 24-hour).' ;
    rdfs:domain ind:DistributionRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:quietHoursStart rdf:type rdf:Property ;
    rdfs:label 'Quiet Hours Start' ;
    rdfs:comment 'Start of the daily quiet-hours window during which non-critical distributions are suppressed or deferred (HH:mm, 24-hour).' ;
    rdfs:domain ind:DistributionRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recipientEndpoint rdf:type rdf:Property ;
    rdfs:label 'Recipient Endpoint' ;
    rdfs:comment 'Configured target endpoint address for delivery (e.g., HL7 receiving application/facility, direct message address, or interface node) used to route the report.' ;
    rdfs:domain ind:DistributionRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recipientRole rdf:type rdf:Property ;
    rdfs:label 'Recipient Role' ;
    rdfs:comment 'Intended recipient role or audience for reports matched by this distribution rule.' ;
    rdfs:domain ind:DistributionRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportStatusTrigger rdf:type rdf:Property ;
    rdfs:label 'Report Status Trigger' ;
    rdfs:comment 'Radiology report status that triggers evaluation and firing of this distribution rule.' ;
    rdfs:domain ind:DistributionRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:retryLimit rdf:type rdf:Property ;
    rdfs:label 'Retry Limit' ;
    rdfs:comment 'Maximum number of automatic delivery retry attempts for failed distributions before the rule flags a delivery failure.' ;
    rdfs:domain ind:DistributionRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:abstract rdf:type rdf:Property ;
    rdfs:label 'Abstract' ;
    rdfs:comment 'Narrative summary describing the scientific aims and scope of the funded project.' ;
    rdfs:domain ind:Grant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:animalSubjectsFlag rdf:type rdf:Property ;
    rdfs:label 'Animal Subjects Flag' ;
    rdfs:comment 'Indicates whether the funded research involves animal subjects requiring IACUC oversight.' ;
    rdfs:domain ind:Grant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:clinicalTrialFlag rdf:type rdf:Property ;
    rdfs:label 'Clinical Trial Flag' ;
    rdfs:comment 'Indicates whether the grant funds a clinical trial subject to FDA / ClinicalTrials.gov requirements.' ;
    rdfs:domain ind:Grant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:costShareRequiredAmount rdf:type rdf:Property ;
    rdfs:label 'Cost Share Required Amount' ;
    rdfs:comment 'Committed institutional cost-sharing or matching amount required by the sponsor.' ;
    rdfs:domain ind:Grant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:currentYearBudgetAmount rdf:type rdf:Property ;
    rdfs:label 'Current Year Budget Amount' ;
    rdfs:comment 'Funded budget amount for the current active budget period.' ;
    rdfs:domain ind:Grant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dunsUeiNumber rdf:type rdf:Property ;
    rdfs:label 'Duns Uei Number' ;
    rdfs:comment 'SAM.gov Unique Entity Identifier of the recipient institution for federal awards.' ;
    rdfs:domain ind:Grant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:financialConflictOfInterestFlag rdf:type rdf:Property ;
    rdfs:label 'Financial Conflict Of Interest Flag' ;
    rdfs:comment 'Indicates whether a financial conflict of interest has been disclosed and requires management on this grant.' ;
    rdfs:domain ind:Grant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fundingSourceType rdf:type rdf:Property ;
    rdfs:label 'Funding Source Type' ;
    rdfs:comment 'Category of the organization providing the grant funds.' ;
    rdfs:domain ind:Grant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:humanSubjectsFlag rdf:type rdf:Property ;
    rdfs:label 'Human Subjects Flag' ;
    rdfs:comment 'Indicates whether the funded research involves human subjects requiring IRB oversight.' ;
    rdfs:domain ind:Grant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nextReportDueDate rdf:type rdf:Property ;
    rdfs:label 'Next Report Due Date' ;
    rdfs:comment 'Due date of the next required progress or financial report to the sponsor.' ;
    rdfs:domain ind:Grant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:noCostExtensionEndDate rdf:type rdf:Property ;
    rdfs:label 'No Cost Extension End Date' ;
    rdfs:comment 'Revised end date if a no-cost extension has been approved on the award.' ;
    rdfs:domain ind:Grant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:primeSponsorName rdf:type rdf:Property ;
    rdfs:label 'Prime Sponsor Name' ;
    rdfs:comment 'Name of the originating prime sponsor when the award is a subaward passed through another institution.' ;
    rdfs:domain ind:Grant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:researchType rdf:type rdf:Property ;
    rdfs:label 'Research Type' ;
    rdfs:comment 'Category of research the grant supports.' ;
    rdfs:domain ind:Grant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:restrictedFundsFlag rdf:type rdf:Property ;
    rdfs:label 'Restricted Funds Flag' ;
    rdfs:comment 'Indicates whether the grant funds are restricted to specific purposes by the sponsor.' ;
    rdfs:domain ind:Grant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sponsorProgramOfficerName rdf:type rdf:Property ;
    rdfs:label 'Sponsor Program Officer Name' ;
    rdfs:comment 'Name of the sponsor\'s assigned program or grants management officer.' ;
    rdfs:domain ind:Grant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalAwardedAmount rdf:type rdf:Property ;
    rdfs:label 'Total Awarded Amount' ;
    rdfs:comment 'Total dollar value awarded across the full project period, including direct and indirect costs.' ;
    rdfs:domain ind:Grant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:parentPromQuestionId rdf:type rdf:Property ;
    rdfs:label 'Parent Prom Question Id' ;
    rdfs:comment 'Self-referencing FK on prom_question (parent_prom_question_id)' ;
    rdfs:domain ind:PromQuestion ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PromQuestion .

ind:parentPortalSessionId rdf:type rdf:Property ;
    rdfs:label 'Parent Portal Session Id' ;
    rdfs:comment 'Self-referencing FK on portal_session (parent_portal_session_id)' ;
    rdfs:domain ind:PortalSession ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PortalSession .

ind:parentGrantId rdf:type rdf:Property ;
    rdfs:label 'Parent Grant Id' ;
    rdfs:comment 'Self-referencing FK on grant (parent_grant_id)' ;
    rdfs:domain ind:Grant ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Grant .

ind:parentSetId rdf:type rdf:Property ;
    rdfs:label 'Parent Set Id' ;
    rdfs:comment 'Self-referencing FK on set (parent_set_id)' ;
    rdfs:domain ind:Set ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Set .

ind:parentDistributionRuleId rdf:type rdf:Property ;
    rdfs:label 'Parent Distribution Rule Id' ;
    rdfs:comment 'Self-referencing FK on distribution_rule (parent_distribution_rule_id)' ;
    rdfs:domain ind:DistributionRule ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DistributionRule .
