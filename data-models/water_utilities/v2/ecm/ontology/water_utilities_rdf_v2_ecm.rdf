    rdfs:domain ind:Deposit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:interestBearing rdf:type rdf:Property ;
    rdfs:label 'Interest Bearing' ;
    rdfs:comment 'Whether deposit earns interest' ;
    rdfs:domain ind:Deposit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:interestRate rdf:type rdf:Property ;
    rdfs:label 'Interest Rate' ;
    rdfs:comment 'Annual interest rate for loan-type grants (e.g., SRF loans, WIFIA loans), expressed as a decimal (e.g., 0.0250 for 2.5%). Zero for non-repayable grants.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:interestRatePct rdf:type rdf:Property ;
    rdfs:label 'Interest Rate Pct' ;
    rdfs:comment 'Annual interest rate on deposit' ;
    rdfs:domain ind:Deposit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isInterestBearing rdf:type rdf:Property ;
    rdfs:label 'Is Interest Bearing' ;
    rdfs:comment 'Whether deposit accrues interest per tariff' ;
    rdfs:domain ind:Deposit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isWaived rdf:type rdf:Property ;
    rdfs:label 'Is Waived' ;
    rdfs:comment 'Flag indicating the deposit requirement was waived' ;
    rdfs:domain ind:Deposit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:method rdf:type rdf:Property ;
    rdfs:label 'Method' ;
    rdfs:comment 'CASH, CHECK, CREDIT_CARD, ACH' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:depositName rdf:type rdf:Property ;
    rdfs:label 'Deposit Name' ;
    rdfs:domain ind:Deposit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reason rdf:type rdf:Property ;
    rdfs:label 'Reason' ;
    rdfs:comment 'Detailed explanation provided by the customer describing why they are disputing the charges.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:receiptNumber rdf:type rdf:Property ;
    rdfs:label 'Receipt Number' ;
    rdfs:comment 'Receipt number' ;
    rdfs:domain ind:Deposit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:receivedDate rdf:type rdf:Property ;
