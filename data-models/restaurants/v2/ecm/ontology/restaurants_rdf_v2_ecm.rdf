ind:brand rdf:type rdf:Property ;
    rdfs:label 'Brand' ;
    rdfs:comment 'Restaurant brand or concept associated with this area (e.g., \'Quick-Service Brand A\', \'Casual Dining Brand B\').' ;
    rdfs:domain ind:Restaurants ;
