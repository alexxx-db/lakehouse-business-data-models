  award_date timestamp [note: 'Date the award was made.']
  award_decision varchar [note: 'Decision outcome of the sourcing event.']
  category_scope varchar [note: 'Categories covered by this sourcing event.']
  compliance_requirements varchar [note: 'Compliance requirements for participants.']
  created_timestamp timestamp [note: 'Record creation timestamp.']
  currency_code varchar [note: 'Currency for the sourcing event.']
  evaluation_criteria varchar [note: 'Criteria used to evaluate responses.']
  event_code varchar [note: 'Unique code for the sourcing event.']
  event_end_timestamp timestamp [note: 'When the sourcing event closes.']
  event_name varchar [note: 'Name of the sourcing event.']
  event_notes varchar [note: 'Additional notes about the event.']
  event_start_timestamp timestamp [note: 'When the sourcing event opens.']
  event_type varchar [note: 'Type of sourcing event (RFP, RFQ, auction).']
  is_confidential boolean [note: 'Whether the event is confidential.']
  lifecycle_status varchar [note: 'Current lifecycle status of the event.']
  sourcing_event_description varchar [note: 'Detailed description of the sourcing event.']
  submission_deadline timestamp [note: 'Deadline for response submissions.']
  total_budget decimal(18,2) [note: 'Total budget allocated for this sourcing.']
  updated_by varchar [note: 'User who last updated the record.']
  updated_timestamp timestamp [note: 'Record last update timestamp.']
  weighting_scheme decimal(10,4) [note: 'Scoring weight scheme used for evaluation.']
  created_by varchar [note: 'User who created the record.']

  Note: 'Sourcing events such as RFPs, RFQs, and reverse auctions used to competitively select suppliers.'
}

Table procurement.sourcing_response {
  sourcing_response_id varchar [pk, note: 'Primary key for the sourcing response.']
  procurement_supplier_id varchar [note: 'Supplier who submitted the response.']
  sourcing_event_id varchar [note: 'Sourcing event this response is for.']
  award_status varchar [note: 'Whether this response was awarded.']
  bid_type varchar [note: 'Type of bid submitted.']
  compliance_attestations varchar [note: 'Compliance attestations provided.']
  compliance_score decimal(5,2) [note: 'Score for compliance criteria.']
  contract_term_months varchar [note: 'Proposed contract term in months.']
  created_timestamp timestamp [note: 'Record creation timestamp.']
  currency_code varchar [note: 'Currency of the bid.']
  delivery_terms varchar [note: 'Proposed delivery terms.']
  discount_amount decimal(18,2) [note: 'Discount offered.']
  disqualification_reason varchar [note: 'Reason if response was disqualified.']
  is_eligible boolean [note: 'Whether the response meets eligibility criteria.']
  is_preferred_supplier boolean [note: 'Whether the respondent is a preferred supplier.']
  lead_time_days varchar [note: 'Proposed lead time in days.']
  minimum_order_quantity varchar [note: 'Minimum order quantity proposed.']
  net_price decimal(18,2) [note: 'Net price after discounts.']
  payment_terms decimal(18,2) [note: 'Proposed payment terms.']
  price_per_unit decimal(18,2) [note: 'Unit price proposed.']
  quality_certifications varchar [note: 'Quality certifications held by supplier.']
  response_comments varchar [note: 'Additional comments from supplier.']
  response_number varchar [note: 'Unique response reference number.']
  risk_level varchar [note: 'Assessed risk level of the response.']
  scoring_rank varchar [note: 'Rank among all responses.']
  scoring_total decimal(18,2) [note: 'Total evaluation score.']
  sourcing_response_status varchar [note: 'Current status of the response.']
  submission_timestamp timestamp [note: 'When the response was submitted.']
  supplier_rating decimal(4,2) [note: 'Historical supplier rating.']
  tax_amount decimal(18,2) [note: 'Tax amount in the bid.']
  total_price decimal(18,2) [note: 'Total bid price.']
  unit_of_measure varchar [note: 'Unit of measure for pricing.']
  updated_timestamp timestamp [note: 'Record last update timestamp.']
  valid_until date [note: 'Date until which the bid is valid.']
  warranty_period_months varchar [note: 'Warranty period offered in months.']

  Note: 'Supplier responses/bids submitted to sourcing events including pricing, terms, and evaluation scores.'
}

Table procurement.contract {
  contract_id varchar [pk, note: 'Primary key for the procurement contract.']
  contract_employee_id varchar [note: 'Employee managing the contract.']
  franchisee_id varchar [note: 'Franchisee associated with the contract.']
  owner_employee_id varchar [note: 'Contract owner employee.']
  procurement_supplier_id varchar [note: 'Supplier party to the contract.']
  unit_id varchar [note: 'Restaurant unit associated with the contract.']
  amendment_count varchar [note: 'Number of amendments to the contract.']
  auto_renewal_flag boolean [note: 'Whether the contract auto-renews.']
  compliance_requirements varchar [note: 'Compliance requirements in the contract.']
  confidentiality_level varchar [note: 'Confidentiality classification.']
  contract_name varchar [note: 'Name of the contract.']
  contract_number varchar [note: 'Unique contract reference number.']
  contract_status varchar [note: 'Current status of the contract.']
  contract_type varchar [note: 'Type of contract (blanket, spot, framework).']
  created_timestamp timestamp [note: 'Record creation timestamp.']
  currency_code varchar [note: 'Contract currency.']
  discount_rate decimal(5,2) [note: 'Negotiated discount rate.']
  document_url varchar [note: 'URL to the contract document.']
  effective_end_date date [note: 'Contract end date.']
  effective_start_date date [note: 'Contract start date.']
  exclusivity_flag boolean [note: 'Whether the contract is exclusive.']
  governing_body varchar [note: 'Legal governing body/jurisdiction.']
  last_review_date date [note: 'Date of last contract review.']
  manager_contact varchar [note: 'Contact information for the contract manager.']
  next_renewal_date date [note: 'Next renewal date.']
  payment_terms decimal(18,2) [note: 'Payment terms in net days.']
  penalty_clause varchar [note: 'Penalty clause details.']
  pricing_model varchar [note: 'Pricing model (fixed, variable, tiered).']
  rebate_terms decimal(18,2) [note: 'Rebate terms value.']
  regulatory_approval_status varchar [note: 'Status of regulatory approval.']
  renewal_term_months varchar [note: 'Renewal term length in months.']
  scope_of_supply varchar [note: 'Scope of goods/services covered.']
  sla_commitment varchar [note: 'Service level agreement commitments.']
  termination_date date [note: 'Date the contract was terminated.']
  termination_reason varchar [note: 'Reason for contract termination.']
  total_value decimal(18,2) [note: 'Total contract value.']
  updated_timestamp timestamp [note: 'Record last update timestamp.']
  version_number varchar [note: 'Contract version number.']

  Note: 'Procurement contracts governing supplier relationships, pricing, terms, and compliance requirements.'
}

Table procurement.contract_line {
  contract_line_id varchar [pk, note: 'Primary key for the contract line.']
  approved_by_employee_id varchar [note: 'Employee who approved the line.']
  contract_id varchar [note: 'Parent contract.']
  cost_center_id varchar [note: 'Cost center for the line.']
  procurement_supplier_id varchar [note: 'Supplier for this line.']
  stock_item_id varchar [note: 'Inventory stock item referenced.']
  approved_timestamp timestamp [note: 'When the line was approved.']
  compliance_requirements varchar [note: 'Line-level compliance requirements.']
  contract_line_status varchar [note: 'Status of the contract line.']
  contract_line_type varchar [note: 'Type of contract line.']
  created_timestamp timestamp [note: 'Record creation timestamp.']
  currency_code varchar [note: 'Currency for the line.']
  delivery_location_code varchar [note: 'Code for delivery location.']
  effective_end_date date [note: 'Line effective end date.']
  effective_start_date date [note: 'Line effective start date.']
  is_price_locked boolean [note: 'Whether the price is locked.']
  is_renewable boolean [note: 'Whether the line is renewable.']
  item_description varchar [note: 'Description of the item.']
  lead_time_days varchar [note: 'Lead time in days.']
  line_sequence varchar [note: 'Sequence number of the line.']
  maximum_order_quantity varchar [note: 'Maximum order quantity.']
  minimum_order_quantity varchar [note: 'Minimum order quantity.']
  notes varchar [note: 'Additional notes.']
  price_escalation_clause decimal(18,2) [note: 'Price escalation clause value.']
  price_escalation_frequency decimal(18,2) [note: 'Frequency of price escalation.']
  price_escalation_percent decimal(5,2) [note: 'Percentage of price escalation.']
  price_tier_end_quantity decimal(18,2) [note: 'End quantity for price tier.']
  price_tier_start_quantity decimal(18,2) [note: 'Start quantity for price tier.']
  regulatory_approval_status varchar [note: 'Regulatory approval status.']
  renewal_option varchar [note: 'Renewal option details.']
  sku varchar [note: 'Stock keeping unit code.']
  tax_rate_percent decimal(5,2) [note: 'Applicable tax rate.']
  tier_price decimal(18,2) [note: 'Price for the tier.']
  unit_price decimal(18,2) [note: 'Unit price for the item.']
  uom varchar [note: 'Unit of measure.']
  updated_timestamp timestamp [note: 'Record last update timestamp.']
  waste_percentage_allowed decimal(5,2) [note: 'Allowable waste percentage.']
  yield_percentage decimal(5,2) [note: 'Expected yield percentage.']

  Note: 'Individual line items within a procurement contract specifying items, pricing, and terms.'
}

Table procurement.requisition {
  requisition_id varchar [pk, note: 'Primary key for the requisition.']
  approved_by_employee_id varchar [note: 'Employee who approved the requisition.']
  contract_id varchar [note: 'Associated contract.']
