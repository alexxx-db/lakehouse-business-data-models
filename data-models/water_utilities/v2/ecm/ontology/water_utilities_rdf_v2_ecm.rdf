ind:calculatedMrl rdf:type rdf:Property ;
    rdfs:label 'Calculated Mrl' ;
    rdfs:comment 'Calculated Minimum Reporting Level (also known as Practical Quantitation Limit or PQL), typically set at 3-10 times the MDL to ensure reliable quantitation.' ;
    rdfs:domain ind:MethodDetectionLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:limsMdlCode rdf:type rdf:Property ;
    rdfs:label 'Lims Mdl Code' ;
    rdfs:comment 'Unique identifier for the corresponding MDL record in the Laboratory Information Management System (LabWare).' ;
    rdfs:domain ind:MethodDetectionLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:meanRecovery rdf:type rdf:Property ;
    rdfs:label 'Mean Recovery' ;
    rdfs:comment 'Mean recovery percentage of the spiked analyte across all replicates, used to assess method accuracy.' ;
    rdfs:domain ind:MethodDetectionLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nextStudyDueDate rdf:type rdf:Property ;
    rdfs:label 'Next Study Due Date' ;
    rdfs:comment 'Date by which the next MDL study must be conducted to maintain regulatory compliance.' ;
    rdfs:domain ind:MethodDetectionLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:previousMdlValue rdf:type rdf:Property ;
    rdfs:label 'Previous Mdl Value' ;
    rdfs:comment 'Previously established MDL value for comparison and trend analysis.' ;
    rdfs:domain ind:MethodDetectionLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:previousMrlValue rdf:type rdf:Property ;
    rdfs:label 'Previous Mrl Value' ;
    rdfs:comment 'Previously established MRL value for comparison and trend analysis.' ;
    rdfs:domain ind:MethodDetectionLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatoryAcceptanceStatus rdf:type rdf:Property ;
    rdfs:label 'Regulatory Acceptance Status' ;
    rdfs:comment 'Regulatory acceptance status of the MDL study, indicating whether it meets EPA or state primacy agency requirements.' ;
    rdfs:domain ind:MethodDetectionLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relativeStandardDeviationPercent rdf:type rdf:Property ;
    rdfs:label 'Relative Standard Deviation Percent' ;
    rdfs:comment 'Relative standard deviation (coefficient of variation) expressed as a percentage, used to assess method precision.' ;
    rdfs:domain ind:MethodDetectionLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:replicateCount rdf:type rdf:Property ;
    rdfs:label 'Replicate Count' ;
    rdfs:comment 'Number of replicate samples analyzed in the MDL study. EPA requires a minimum of 7 replicates.' ;
    rdfs:domain ind:MethodDetectionLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reviewerName rdf:type rdf:Property ;
    rdfs:label 'Reviewer Name' ;
    rdfs:comment 'Full name of the quality assurance reviewer who validated the MDL study.' ;
    rdfs:domain ind:MethodDetectionLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:spikeConcentrationUnit rdf:type rdf:Property ;
    rdfs:label 'Spike Concentration Unit' ;
    rdfs:comment 'Unit of measure for the spike concentration (e.g., mg/L, ug/L, ng/L).' ;
    rdfs:domain ind:MethodDetectionLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:standardDeviation rdf:type rdf:Property ;
    rdfs:label 'Standard Deviation' ;
    rdfs:comment 'Standard deviation of the replicate measurements used in the MDL calculation.' ;
    rdfs:domain ind:Laboratory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:studyDate rdf:type rdf:Property ;
    rdfs:label 'Study Date' ;
    rdfs:comment 'Date on which the method detection limit study was conducted.' ;
    rdfs:domain ind:MethodDetectionLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:studyNotes rdf:type rdf:Property ;
    rdfs:label 'Study Notes' ;
    rdfs:comment 'Free-text notes documenting any special conditions, deviations, or observations during the MDL study.' ;
    rdfs:domain ind:MethodDetectionLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:studyReason rdf:type rdf:Property ;
    rdfs:label 'Study Reason' ;
    rdfs:comment 'Reason for conducting the MDL study (e.g., annual renewal, method change, instrument change, matrix change).' ;
    rdfs:domain ind:MethodDetectionLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tValue rdf:type rdf:Property ;
    rdfs:label 'T Value' ;
    rdfs:comment 'Student\'s t-value at 99% confidence level for the number of replicates used in the MDL calculation.' ;
    rdfs:domain ind:MethodDetectionLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:actualCompletionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Actual Completion Timestamp' ;
    rdfs:comment 'Date and time when all analyses were completed, validated, and results released. Used to measure TAT performance and identify bottlenecks.' ;
    rdfs:domain ind:LabWorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:analysisCount rdf:type rdf:Property ;
    rdfs:label 'Analysis Count' ;
    rdfs:comment 'Total number of individual analytical tests requested across all samples in the work order. A single sample may require multiple analyses.' ;
    rdfs:domain ind:LabWorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:assignedAnalystName rdf:type rdf:Property ;
    rdfs:label 'Assigned Analyst Name' ;
    rdfs:comment 'Name of the primary analyst assigned to the work order. Used for accountability and quality assurance tracking.' ;
    rdfs:domain ind:LabWorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billableFlag rdf:type rdf:Property ;
    rdfs:label 'Billable Flag' ;
    rdfs:comment 'Indicates whether this work order is billable to an external client or internal cost recovery. True for external client work and some internal service agreements.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:certificationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Certification Required Flag' ;
    rdfs:comment 'Indicates whether the work order requires analysis by a state-certified analyst. True for regulatory compliance samples that must be legally defensible.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:holdingTimeCompliantFlag rdf:type rdf:Property ;
    rdfs:label 'Holding Time Compliant Flag' ;
    rdfs:comment 'Indicates whether all analyses in the work order were completed within the required holding time. False triggers data qualification and potential regulatory reporting.' ;
    rdfs:domain ind:LabWorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requestedAnalyteList rdf:type rdf:Property ;
    rdfs:label 'Requested Analyte List' ;
    rdfs:comment 'Comma-separated list of analytes or parameters to be tested, such as pH, turbidity, total coliform, lead, copper, BOD, TSS, PFAS, or specific contaminants.' ;
    rdfs:domain ind:LabWorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestedTestMethodList rdf:type rdf:Property ;
    rdfs:label 'Requested Test Method List' ;
    rdfs:comment 'Comma-separated list of analytical test methods to be used, such as EPA 200.8, SM 2540C, EPA 1664A. Methods must be approved for regulatory defensibility.' ;
    rdfs:domain ind:LabWorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestingEntity rdf:type rdf:Property ;
    rdfs:label 'Requesting Entity' ;
    rdfs:comment 'Name of the department, facility, or external client that submitted the work order. May include treatment operations, compliance team, WTP, WWTP, or external industrial clients.' ;
    rdfs:domain ind:LabWorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestingEntityType rdf:type rdf:Property ;
    rdfs:label 'Requesting Entity Type' ;
    rdfs:comment 'Classification of the requesting entity to support workflow routing, billing, and reporting requirements.' ;
    rdfs:domain ind:LabWorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestorContactEmail rdf:type rdf:Property ;
    rdfs:label 'Requestor Contact Email' ;
    rdfs:comment 'Email address of the requestor for result delivery, status updates, and work order correspondence.' ;
    rdfs:domain ind:LabWorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestorContactPhone rdf:type rdf:Property ;
    rdfs:label 'Requestor Contact Phone' ;
    rdfs:comment 'Phone number of the requestor for urgent communication regarding sample issues, result clarification, or turnaround time adjustments.' ;
    rdfs:domain ind:LabWorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestorName rdf:type rdf:Property ;
    rdfs:label 'Requestor Name' ;
    rdfs:comment 'Name of the individual who submitted the work order. Used for clarification and communication during analysis.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requiredTurnaroundTimeHours rdf:type rdf:Property ;
    rdfs:label 'Required Turnaround Time Hours' ;
    rdfs:comment 'Number of hours within which analytical results must be delivered. Driven by regulatory requirements, operational needs, or client service level agreements.' ;
    rdfs:domain ind:LabWorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:scheduledCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Scheduled Completion Date' ;
    rdfs:comment 'Target date by which all analyses in the work order should be completed and results validated. Calculated from submission timestamp and required TAT.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

