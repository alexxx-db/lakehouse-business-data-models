  invoice_date date [note: 'Date of the invoice.']
  invoice_number varchar [note: 'Supplier invoice number.']
  invoice_type varchar [note: 'Type of invoice.']
  is_disputed boolean [note: 'Whether the invoice is disputed.']
  line_item_count varchar [note: 'Number of line items.']
  net_amount decimal(18,2) [note: 'Net invoice amount.']
  payment_date date [note: 'Date payment was made.']
  payment_method decimal(18,2) [note: 'Payment method used.']
  payment_status decimal(18,2) [note: 'Payment status.']
  payment_terms decimal(18,2) [note: 'Payment terms.']
  receipt_date date [note: 'Date invoice was received.']
  receipt_number varchar [note: 'Goods receipt number.']
  supplier_invoice_status varchar [note: 'Current invoice status.']
  tax_amount decimal(18,2) [note: 'Tax amount.']
  tax_exempt_flag boolean [note: 'Whether the invoice is tax exempt.']
  tax_rate decimal(5,2) [note: 'Tax rate applied.']
  updated_timestamp timestamp [note: 'Record last update timestamp.']
