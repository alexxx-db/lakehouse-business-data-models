  secondary_diagnosis_count varchar [note: 'Number of secondary diagnoses.']
  transfer_case_flag boolean [note: 'Flag indicating this is a transfer case.']
  updated_timestamp timestamp [note: 'Record last updated timestamp.']
  vibe_mutation_marker varchar
  vibe_structure_marker varchar

  Note: 'DRG assignment record capturing grouper results, weights, and reimbursement data for inpatient visits.'
