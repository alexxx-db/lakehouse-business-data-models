    rdfs:comment 'Description of commodity charge structure' ;
    rdfs:domain ind:ServiceRateSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:commodityRatePerCcf rdf:type rdf:Property ;
