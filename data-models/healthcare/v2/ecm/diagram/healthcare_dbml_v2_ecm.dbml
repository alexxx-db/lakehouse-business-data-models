  primary_test_clinician_id varchar
  primary_test_employee_id varchar
  quality_measure_id varchar
  reagent_lot_id varchar
  reference_range_id varchar
  research_study_id varchar
  result_snomed_concept_id varchar
  specimen_id varchar
  tertiary_test_amending_user_employee_id varchar
  tertiary_test_ordering_provider_clinician_id varchar
  test_catalog_id varchar
  test_resulting_clinician_id varchar
  visit_id varchar
  abnormal_flag boolean
  amendment_datetime timestamp
  amendment_reason varchar
  clia_number varchar
  created_datetime timestamp
  created_timestamp timestamp
  critical_flag boolean
  critical_value_acknowledgment_datetime timestamp
  critical_value_alert_generated_datetime timestamp
  critical_value_escalation_action varchar
  critical_value_notification_datetime timestamp
  critical_value_notification_method varchar
  critical_value_resolution_note varchar
  delta_check_flag boolean
  interpretation varchar
  is_amended boolean
  is_critical_value boolean
  last_updated_datetime timestamp
  original_result_value_numeric decimal(18,6)
  original_result_value_text varchar
  performing_lab_facility varchar
  performing_lab_section varchar
  record_number varchar
  result_comment varchar
  result_datetime timestamp
  result_interpretation varchar
  result_numeric decimal(18,4)
  result_released_datetime timestamp
  result_status varchar
  result_timestamp timestamp
  result_unit varchar
  result_units varchar
  result_value decimal(18,2)
  result_value_coded varchar
  result_value_numeric decimal(18,6)
  result_value_text varchar
  specimen_received_datetime timestamp
  test_code varchar
  test_name varchar
  test_result_status varchar
  updated_timestamp timestamp
  verified_by varchar
  verified_timestamp timestamp
  vibe_mutation_applied varchar
  vibe_mutation_marker varchar
  vibe_structure_marker varchar [note: 'structure enforcement marker']

  Note: 'Transactional record of every individual laboratory test result produced for a specimen, including result amendments and critical value notifications. Stores LOINC-coded test identifier, result value (numeric, text, coded), result unit of measure, reference range applied, result status lifecycle (preliminary, final, corrected, cancelled), abnormal flag (normal, low, high, critical low, critical high), result date/time, performing lab section, instrument identifier, verifying technologist. Owns the full amendment/correction history: original value, amended value, amendment reason, amending user, amendment timestamp. When a result exceeds critical thresholds, owns the critical value alert lifecycle: alert generation timestamp, notified provider, notification method (phone, secure message, EHR alert), acknowledgment timestamp, acknowledging clinician, escalation actions, and resolution notes. Consolidates the former critical_value_alert and result_amendment concepts. Supports CLIA critical value compliance, Joint Commission NPSG requirements, HIM audit requirements, and downstream clinical decision-making.'
}

Table laboratory.reference_range {
  reference_range_id varchar [pk]
  loinc_code_id varchar
  age_group varchar
  age_high varchar
  age_low varchar
  alert_priority varchar
  alert_trigger_flag boolean
  clinical_significance varchar
  created_timestamp timestamp
  critical_high decimal(18,4)
  critical_high_threshold decimal(18,6)
  critical_low decimal(18,4)
  critical_low_threshold decimal(18,6)
  effective_date date
  effective_end_date date
  effective_start_date date
  expiration_date date
  high_value decimal(18,4)
  instrument_platform varchar
  interpretation_code varchar
  last_review_date date
  last_updated_timestamp timestamp
  lis_system_code varchar
  low_value decimal(18,4)
  lower_normal_limit decimal(18,6)
  medical_director_override_flag boolean
  methodology varchar
  next_review_date date
  notes varchar
  override_justification varchar
  population_basis varchar
  pregnancy_status varchar
  race_ethnicity varchar
  range_name varchar
  range_status varchar
  reference_range_status varchar
  review_status varchar
  sample_size varchar
  sex varchar
  source_citation varchar
  source_type varchar
  statistical_method varchar
  unit_of_measure varchar
  units varchar
  updated_timestamp timestamp
  upper_normal_limit decimal(18,6)
  vibe_mutation_applied varchar
  vibe_mutation_marker varchar
  vibe_structure_marker varchar [note: 'structure enforcement marker']

  Note: 'Reference data defining normal, abnormal, and critical value thresholds for each laboratory test, stratified by patient demographics (age group, sex, pregnancy status, race/ethnicity where clinically validated) and specimen type. Includes lower and upper normal limits, critical low and critical high thresholds, panic value definitions, unit of measure, effective date range, and the authoritative source (CAP, CLIA, manufacturer insert, institutional medical director override). Used by result interpretation logic to assign abnormal flags and trigger critical value alerts in test_result. Supports CLIA-required documentation of reference range sources and periodic review.'
}

Table laboratory.pathology_report {
  pathology_report_id varchar [pk]
  cda_document_id varchar
