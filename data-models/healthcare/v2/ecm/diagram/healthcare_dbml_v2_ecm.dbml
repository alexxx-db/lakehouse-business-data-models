  last_audit_result varchar [note: 'Outcome of the most recent audit']
  last_review_date date [note: 'Date of the most recent program review']
  mandatory_flag boolean [note: 'Indicates if the program is mandatory']
  modified_by varchar [note: 'User who last modified the record']
  modified_timestamp timestamp [note: 'When the record was last modified']
  next_audit_date date [note: 'Date of the next scheduled audit']
  next_review_date date [note: 'Date of the next scheduled review']
  notes varchar [note: 'Additional notes about the program']
  objectives varchar [note: 'Program objectives and goals']
  penalty_exposure_amount decimal(15,2) [note: 'Potential financial penalty exposure']
  policy_count varchar [note: 'Number of policies under this program']
  program_code varchar [note: 'Unique code for the program']
  program_name varchar [note: 'Name of the compliance program']
  program_scope varchar [note: 'Scope and coverage of the program']
  program_status varchar [note: 'Current status of the program']
  program_type varchar [note: 'Type or category of compliance program']
  regulatory_framework varchar [note: 'Regulatory framework governing the program']
  reporting_frequency varchar [note: 'How often reporting is required']
  reporting_required_flag boolean [note: 'Indicates if reporting is required']
  review_frequency_months varchar [note: 'Number of months between reviews']
  risk_level varchar [note: 'Risk level associated with the program']
  ssot_reference varchar
  training_frequency_months varchar [note: 'Number of months between required training']
  training_required_flag boolean [note: 'Indicates if training is required']
  updated_timestamp timestamp
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutation to ensure change']
  vibe_mutation_marker varchar [note: 'Marker added by VIBE mutator to indicate change']
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']
  website_url varchar [note: 'URL for program information']
