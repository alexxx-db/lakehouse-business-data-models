  carrier_scac_code varchar [note: 'Standard carrier alpha code']
  created_timestamp timestamp [note: 'Record creation timestamp']
  currency_code varchar [note: 'Currency ISO code']
  delay_minutes varchar [note: 'Delay in minutes if late']
  destination_location_code varchar [note: 'Destination location code']
  exception_reason varchar [note: 'Reason for any exception']
  freight_cost decimal(18,2) [note: 'Freight cost']
  freight_terms varchar [note: 'Freight terms (FOB, CIF)']
  hazard_material_flag boolean [note: 'Whether contains hazardous materials']
  is_expedited boolean [note: 'Whether shipment is expedited']
  number_of_items varchar [note: 'Number of items in shipment']
  origin_location_code varchar [note: 'Origin location code']
  scheduled_arrival_timestamp timestamp [note: 'Scheduled arrival time']
  scheduled_departure_timestamp timestamp [note: 'Scheduled departure time']
  seal_number varchar [note: 'Container seal number']
  shipment_number varchar [note: 'Unique shipment tracking number']
  shipment_status varchar [note: 'Status (in_transit, delivered, delayed)']
  temperature_control_flag boolean [note: 'Whether temperature controlled']
  temperature_max_c decimal(5,2) [note: 'Maximum temperature requirement']
  temperature_min_c decimal(5,2) [note: 'Minimum temperature requirement']
  transport_mode varchar [note: 'Mode of transport (truck, rail, air)']
  updated_timestamp timestamp [note: 'Record last update timestamp']
  volume_cubic_m decimal(10,3) [note: 'Total volume in cubic meters']
  weight_kg decimal(10,3) [note: 'Total weight in kg']

  Note: 'Tracking of inbound shipments from suppliers to distribution centers or restaurant units.'
}

Table supply.ingredient_lot {
  ingredient_lot_id varchar [pk, note: 'Primary key']
  haccp_plan_id varchar [note: 'FK to HACCP plan']
  ingredient_id varchar [note: 'FK to ingredient master']
  unit_id varchar [note: 'FK to restaurant unit holding the lot']
  batch_number varchar [note: 'Supplier batch number']
  best_by_date date [note: 'Best-by/use-by date']
  cost_per_unit decimal(18,2) [note: 'Cost per unit for this lot']
  country_of_origin varchar [note: 'Country of origin']
  created_timestamp timestamp [note: 'Record creation timestamp']
  currency_code varchar [note: 'Currency ISO code']
  expiration_date decimal(10,4) [note: 'Expiration date']
  external_traceability_code varchar [note: 'External traceability reference']
  inspection_status varchar [note: 'Quality inspection status']
  lot_number varchar [note: 'Unique lot number']
  lot_status varchar [note: 'Status (available, quarantined, recalled, consumed)']
  lot_type varchar [note: 'Type of lot (raw, processed)']
  organic_certified boolean [note: 'Whether organic certified']
  production_date date [note: 'Date of production']
  quality_score decimal(5,2) [note: 'Quality score']
  quantity decimal(12,3) [note: 'Current quantity on hand']
  recall_flag boolean [note: 'Whether lot is under recall']
  recall_reason varchar [note: 'Reason for recall if applicable']
  received_date date [note: 'Date received at location']
  storage_location varchar [note: 'Physical storage location']
  storage_temperature_c decimal(5,2) [note: 'Required storage temperature']
  supplier_code varchar [note: 'Supplier code reference']
  supplier_lot_reference varchar [note: 'Supplier lot reference number']
  temperature_controlled boolean [note: 'Whether temperature controlled']
  total_cost decimal(18,2) [note: 'Total lot cost']
  traceability_enabled boolean [note: 'Whether full traceability is enabled']
  unit_of_measure varchar [note: 'Unit of measure']
  updated_timestamp timestamp [note: 'Record last update timestamp']
  waste_percentage decimal(5,2) [note: 'Waste percentage for this lot']
  yield_percentage decimal(5,2) [note: 'Yield percentage for this lot']

  Note: 'Lot-level tracking of ingredients for traceability, quality, and recall management.'
}

Table supply.quality_inspection {
  quality_inspection_id varchar [pk, note: 'Primary key']
  haccp_plan_id varchar [note: 'FK to HACCP plan']
  inspector_employee_id varchar [note: 'FK to inspector employee']
  procurement_supplier_id varchar [note: 'FK to supplier']
  site_id varchar [note: 'FK to inspection site']
  compliance_flag boolean [note: 'Whether item is compliant']
  corrective_action_due_date date [note: 'Due date for corrective action']
  corrective_action_required boolean [note: 'Whether corrective action needed']
  created_timestamp timestamp [note: 'Record creation timestamp']
  defect_category varchar [note: 'Category of defect if found']
  disposition_action varchar [note: 'Disposition (accept, reject, return, destroy)']
  humidity_percent decimal(5,2) [note: 'Humidity reading during inspection']
  inspection_method varchar [note: 'Method used (visual, lab, instrument)']
  inspection_notes varchar [note: 'Inspector notes']
  inspection_result varchar [note: 'Result (pass, fail, conditional)']
  inspection_timestamp timestamp [note: 'When inspection was performed']
  inspection_type varchar [note: 'Type of inspection (receiving, periodic, random)']
  lot_number varchar [note: 'Lot number inspected']
  quality_inspection_status varchar [note: 'Status (pending, complete, cancelled)']
  regulatory_reference varchar [note: 'Regulatory standard reference']
  rejection_quantity decimal(12,2) [note: 'Quantity rejected']
  sku varchar [note: 'SKU inspected']
  temperature_c decimal(5,2) [note: 'Temperature reading during inspection']
  unit_of_measure varchar [note: 'UOM for rejection quantity']
  updated_timestamp timestamp [note: 'Record last update timestamp']

  Note: 'Quality inspections performed on received ingredients and supplies.'
}

Table supply.recall_event {
  recall_event_id varchar [pk, note: 'Primary key']
  procurement_supplier_id varchar [note: 'FK to supplier involved in recall']
  affected_dc_locations varchar [note: 'Affected distribution centers']
  affected_ingredient_sku varchar [note: 'SKU of affected ingredient']
  affected_lot_numbers varchar [note: 'Affected lot numbers (comma-separated)']
  affected_restaurant_locations varchar [note: 'Affected restaurant locations']
  compliance_fda boolean [note: 'Whether FDA notified']
  compliance_haccp boolean [note: 'Whether HACCP protocols followed']
  created_timestamp timestamp [note: 'Record creation timestamp']
  currency_code varchar [note: 'Currency ISO code']
  disposal_method varchar [note: 'Method of disposal']
  notes varchar [note: 'Additional notes']
  product_category varchar [note: 'Category of recalled product']
  quantity_recalled decimal(18,2) [note: 'Total quantity recalled']
  recall_class varchar [note: 'FDA recall class (I, II, III)']
  recall_closure_timestamp timestamp [note: 'When recall was closed']
  recall_initiation_timestamp timestamp [note: 'When recall was initiated']
  recall_number varchar [note: 'Unique recall reference number']
  recall_reason varchar [note: 'Reason for the recall']
  recall_severity varchar [note: 'Severity level']
  recall_status varchar [note: 'Status (initiated, in_progress, closed)']
  recall_type varchar [note: 'Type (voluntary, mandatory, market_withdrawal)']
  regulatory_notification_status varchar [note: 'Status of regulatory notifications']
  risk_score decimal(10,2) [note: 'Risk assessment score']
  temperature_deviation_flag boolean [note: 'Whether temperature deviation was involved']
  total_cost decimal(18,2) [note: 'Total financial impact']
  unit_of_measure varchar [note: 'UOM for recalled quantity']
  updated_timestamp timestamp [note: 'Record last update timestamp']

  Note: 'Product and ingredient recall events tracking affected items, severity, and resolution.'
}

Table supply.commodity_category {
  commodity_category_id varchar [pk, note: 'Primary key']
  parent_commodity_category_id varchar [note: 'FK to parent category for hierarchy']
  average_cost_per_unit decimal(18,2) [note: 'Average cost per unit in category']
  average_lead_time_days varchar [note: 'Average lead time for category']
  commodity_category_code varchar [note: 'Unique category code']
  commodity_category_description varchar [note: 'Description of the category']
  commodity_category_name varchar [note: 'Category name']
  commodity_category_status varchar [note: 'Status (active, inactive)']
  commodity_type varchar [note: 'Type (food, packaging, chemicals, equipment)']
  compliance_requirements varchar [note: 'Compliance requirements description']
  created_timestamp timestamp [note: 'Record creation timestamp']
  effective_from date [note: 'Effective start date']
  effective_until date [note: 'Effective end date']
  hierarchy_level varchar [note: 'Level in the hierarchy (1=top)']
  is_leaf_category boolean [note: 'Whether this is a leaf node']
  is_perishable boolean [note: 'Whether items in category are perishable']
  notes varchar [note: 'Additional notes']
  primary_buyer_owner varchar [note: 'Primary buyer/category manager']
  risk_level varchar [note: 'Supply risk level (low, medium, high)']
  risk_score decimal(10,2) [note: 'Numeric risk score']
  spend_percentage decimal(5,2) [note: 'Percentage of total spend']
  strategic_sourcing_tier decimal(10,4) [note: 'Strategic sourcing tier classification']
  typical_cogs_percent decimal(5,2) [note: 'Typical COGS percentage']
  unit_of_measure varchar [note: 'Default UOM for category']
  updated_timestamp timestamp [note: 'Record last update timestamp']

  Note: 'Hierarchical classification of commodities for spend analysis, sourcing strategy, and supplier categorization.'
}

Table supply.supply_contract {
  supply_contract_id varchar [pk, note: 'Primary key']
