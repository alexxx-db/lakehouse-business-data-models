    rdfs:comment 'Additional address line if needed.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:memberAddressStatus rdf:type rdf:Property ;
    rdfs:label 'Member Address Status' ;
    rdfs:comment 'Current lifecycle status of the address.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorityRank rdf:type rdf:Property ;
