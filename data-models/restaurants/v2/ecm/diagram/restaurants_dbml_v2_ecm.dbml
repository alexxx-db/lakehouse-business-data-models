  Note: 'Physical distribution centers and warehouses that store and ship ingredients to restaurant units.'
}

Table supply.inbound_shipment {
  inbound_shipment_id varchar [pk, note: 'Primary key']
  contract_id varchar [note: 'FK to governing contract']
  destination_site_id varchar [note: 'FK to destination site']
  procurement_purchase_order_id varchar [note: 'FK to procurement PO']
