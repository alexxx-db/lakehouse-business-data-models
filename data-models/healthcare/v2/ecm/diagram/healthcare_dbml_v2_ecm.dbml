  hcpcs_code varchar [note: 'HCPCS procedure code.']
  icd10_pcs_code varchar [note: 'ICD-10-PCS procedure code.']
  implant_flag boolean [note: 'Flag indicating an implant was used.']
  is_cancelled boolean [note: 'Flag indicating procedure was cancelled.']
  is_elective boolean [note: 'Flag indicating elective procedure.']
  is_principal_procedure boolean [note: 'Flag indicating this is the principal procedure.']
  laterality varchar [note: 'Laterality of the procedure (left, right, bilateral).']
  performing_provider_npi varchar [note: 'NPI of the performing provider.']
  procedure_date date [note: 'Date the procedure was performed.']
  procedure_description varchar [note: 'Description of the procedure.']
  procedure_end_timestamp timestamp [note: 'Timestamp when procedure ended.']
  procedure_number varchar [note: 'Procedure number from source system.']
  procedure_start_timestamp timestamp [note: 'Timestamp when procedure started.']
  procedure_status varchar [note: 'Status of the procedure.']
  procedure_type varchar [note: 'Type of procedure (surgical, diagnostic, therapeutic).']
  quantity varchar [note: 'Quantity of procedure performed.']
  rvu_total decimal(10,4) [note: 'Total RVU value.']
  rvu_work decimal(10,4) [note: 'Work RVU value.']
  sequence_number varchar [note: 'Sequence number of the procedure.']
  snomed_code varchar [note: 'SNOMED CT code.']
  source_system_procedure_code varchar [note: 'Source system procedure code.']
  surgical_approach varchar [note: 'Surgical approach (open, laparoscopic, robotic).']
  timeout_performed_flag boolean [note: 'Flag indicating surgical timeout was performed.']
  udi varchar [note: 'Unique Device Identifier for implanted device.']
  updated_timestamp timestamp [note: 'Record last updated timestamp.']
  vibe_mutation_marker varchar
  vibe_structure_marker varchar
  visit_procedure_status varchar
  wound_class varchar [note: 'Wound classification (clean, clean-contaminated, contaminated, dirty).']

