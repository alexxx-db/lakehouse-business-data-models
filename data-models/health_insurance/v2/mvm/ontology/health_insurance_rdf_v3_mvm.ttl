ind:networkServiceAreaId rdf:type rdf:Property ;
    rdfs:label 'Network Service Area Id' ;
    rdfs:comment 'Foreign key linking to network.service_area. Business justification: An eligibility span is fundamentally tied to a service area — regulatory filings, network adequacy reporting, and enrollment processing all require knowing which service area covers the member\'s eligi' ;
    rdfs:domain ind:HealthInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:NetworkServiceArea .

ind:transactionId rdf:type rdf:Property ;
    rdfs:label 'Transaction Id' ;
    rdfs:comment 'Foreign key linking to enrollment.transaction. Business justification: Enrollment transaction processing: enrollment transactions (add, change, terminate) directly create or modify eligibility spans. This link supports retroactive adjustment processing, enrollment audit ' ;
    rdfs:domain ind:HealthInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Transaction .

