ind:binDefinitionId rdf:type rdf:Property ;
    rdfs:label 'Bin Definition Id' ;
    rdfs:comment 'Foreign key linking to test.bin_definition. Business justification: Wafer maps classify die using bin codes (pass_bin_code, fail_bin_code are denormalized text columns). Linking wafer_map to bin_definition normalizes bin classification, enabling quality engineers to q' ;
    rdfs:domain ind:Semiconductors ;
