    rdfs:range xsd:date .

ind:terminationWarningIssued rdf:type rdf:Property ;
    rdfs:label 'Termination Warning Issued' ;
    rdfs:comment 'Indicates whether a termination warning has been sent to the member.' ;
    rdfs:domain ind:GracePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:annualAptcCap rdf:type rdf:Property ;
    rdfs:label 'Annual Aptc Cap' ;
    rdfs:comment 'Maximum total APTC amount the member may receive in a calendar year.' ;
    rdfs:domain ind:AptcSubsidy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:aptcMonthlyAmount rdf:type rdf:Property ;
    rdfs:label 'Aptc Monthly Amount' ;
    rdfs:comment 'Monthly amount of APTC applied to the member\'s premium.' ;
