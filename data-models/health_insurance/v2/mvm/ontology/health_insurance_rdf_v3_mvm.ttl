    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isMspCompliant rdf:type rdf:Property ;
    rdfs:label 'Is Msp Compliant' ;
    rdfs:comment 'Indicates compliance with Medicare Secondary Payer rules.' ;
    rdfs:domain ind:CobRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isSubrogationFlag rdf:type rdf:Property ;
    rdfs:label 'Is Subrogation Flag' ;
    rdfs:comment 'True if the claim may be subject to subrogation based on this COB arrangement.' ;
    rdfs:domain ind:CobRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:policyType rdf:type rdf:Property ;
    rdfs:label 'Policy Type' ;
    rdfs:comment 'Classification of the other carrier policy.' ;
    rdfs:domain ind:HealthInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verificationMethod rdf:type rdf:Property ;
    rdfs:label 'Verification Method' ;
    rdfs:comment 'Method used to verify the COB information.' ;
    rdfs:domain ind:HealthInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:idCardId rdf:type rdf:Property ;
    rdfs:label 'Id Card Id' ;
    rdfs:comment 'Surrogate primary key for the ID card record.' ;
    rdfs:domain ind:IdCard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:eligibilitySpanId rdf:type rdf:Property ;
    rdfs:label 'Eligibility Span Id' ;
    rdfs:comment 'Foreign key linking to member.eligibility_span. Business justification: An ID card is issued to represent a member\'s active coverage for a specific eligibility period. Linking id_card to eligibility_span establishes the authoritative coverage period the card represents, e' ;
    rdfs:domain ind:HealthInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EligibilitySpan .

ind:formularyId rdf:type rdf:Property ;
    rdfs:label 'Formulary Id' ;
    rdfs:comment 'Foreign key linking to pharmacy.formulary. Business justification: Member ID cards display formulary-specific pharmacy benefit information (tier copays, BIN/PCN). Linking id_card to formulary enables member portal drug coverage lookups, formulary change notifications' ;
    rdfs:domain ind:HealthInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Formulary .

ind:memberIdentityId rdf:type rdf:Property ;
    rdfs:label 'Member Identity Id' ;
    rdfs:comment 'Unique identifier of the member to whom the card is issued.' ;
    rdfs:domain ind:HealthInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Identity .

ind:barcode rdf:type rdf:Property ;
    rdfs:label 'Barcode' ;
    rdfs:comment 'Machine-readable barcode value encoded on the card.' ;
    rdfs:domain ind:IdCard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cardFormat rdf:type rdf:Property ;
    rdfs:label 'Card Format' ;
    rdfs:comment 'Delivery format of the card: physical plastic, digital image, or mobile app representation.' ;
