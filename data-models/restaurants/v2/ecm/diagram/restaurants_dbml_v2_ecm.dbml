Table procurement.procurement_supplier {
  procurement_supplier_id varchar [pk, note: 'Primary key for the procurement supplier record.']
  parent_supplier_procurement_supplier_id varchar [note: 'Self-referencing FK to parent supplier for hierarchical supplier structures.']
  address_line varchar [note: 'Primary street address of the supplier.']
  average_lead_time_days varchar [note: 'Average number of days from order to delivery.']
  bank_account_number varchar [note: 'Supplier bank account number for payments.']
  bank_routing_number varchar [note: 'Bank routing number for electronic payments.']
  city varchar [note: 'City of the supplier address.']
  classification varchar [note: 'Supplier classification such as strategic, preferred, transactional.']
  compliance_status varchar [note: 'Current compliance status of the supplier.']
  contract_end_date date [note: 'End date of the primary contract with this supplier.']
  contract_number varchar [note: 'Reference number of the governing contract.']
  contract_start_date date [note: 'Start date of the primary contract with this supplier.']
  country varchar [note: 'Country of the supplier address.']
  created_timestamp timestamp [note: 'Timestamp when the supplier record was created.']
  currency_code varchar [note: 'Default transaction currency for this supplier.']
  default_tax_rate decimal(5,2) [note: 'Default tax rate applied to supplier invoices.']
  discount_rate decimal(5,2) [note: 'Standard discount rate negotiated with the supplier.']
  email_address varchar [note: 'Primary email address for the supplier.']
  global_supplier_number varchar [note: 'Global unique identifier for the supplier across systems.']
  insurance_expiry_date date [note: 'Expiration date of the supplier liability insurance.']
  last_audit_date date [note: 'Date of the most recent supplier audit.']
  legal_name varchar [note: 'Registered legal name of the supplier entity.']
  liability_limit decimal(12,2) [note: 'Maximum liability limit per the supplier contract.']
  max_order_quantity varchar [note: 'Maximum order quantity per purchase order.']
  min_order_quantity varchar [note: 'Minimum order quantity per purchase order.']
  onboarding_status varchar [note: 'Current status in the supplier onboarding process.']
  payment_terms decimal(18,2) [note: 'Payment terms in net days for the supplier.']
  phone_number varchar [note: 'Primary phone number for the supplier.']
  postal_code varchar [note: 'Postal/ZIP code of the supplier address.']
  preferred_supplier_flag boolean [note: 'Indicates if this is a preferred supplier.']
  primary_contact_email varchar [note: 'Email of the primary contact person at the supplier.']
  primary_contact_name varchar [note: 'Name of the primary contact person at the supplier.']
  primary_contact_phone varchar [note: 'Phone number of the primary contact person.']
  procurement_supplier_name varchar [note: 'Common/trade name of the supplier.']
  procurement_supplier_status varchar [note: 'Active/inactive/suspended status of the supplier.']
  remittance_address varchar [note: 'Address where payments should be sent.']
  risk_tier varchar [note: 'Risk classification tier for the supplier.']
  spend_ytd decimal(18,2) [note: 'Year-to-date spend with this supplier.']
  state varchar [note: 'State/province of the supplier address.']
  supplier_type varchar [note: 'Type of supplier such as manufacturer, distributor, broker.']
  tax_identifier decimal(18,2) [note: 'Tax identification number of the supplier.']
  updated_timestamp timestamp [note: 'Timestamp when the supplier record was last updated.']

  Note: 'Master record for suppliers used in procurement, containing contact, financial, compliance, and contract details.'
}

Table procurement.approved_vendor_list {
  approved_vendor_list_id varchar [pk, note: 'Primary key for the approved vendor list entry.']
  approving_authority_employee_id varchar [note: 'Employee who approved the vendor.']
  procurement_supplier_id varchar [note: 'FK to the procurement supplier.']
