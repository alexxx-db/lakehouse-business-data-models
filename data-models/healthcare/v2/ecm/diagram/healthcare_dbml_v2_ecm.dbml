Table radiology.distribution_rule {
  distribution_rule_id varchar [pk, note: 'Primary key for distribution_rule']
  parent_distribution_rule_id varchar [note: 'Self-referencing FK on distribution_rule (parent_distribution_rule_id)']
  acknowledgment_required boolean [note: 'Indicates whether recipient read-receipt or closed-loop acknowledgment is mandatory for reports distributed under this rule.']
  approval_status varchar [note: 'Governance approval state of the distribution rule configuration.']
  consent_verification_required boolean [note: 'Indicates whether patient consent must be verified prior to distributing the report under this rule.']
  created_timestamp timestamp [note: 'Timestamp when this distribution rule record was first captured.']
  criticality_level varchar [note: 'Clinical criticality level of findings that this rule applies to, driving expedited notification of critical results.']
  delivery_channel varchar [note: 'Interface/channel through which the report is distributed to the recipient (HL7 interface, fax, email, patient portal, print, or API).']
  effective_from_date date [note: 'Date on which this distribution rule becomes active and eligible for enforcement.']
  effective_until_date date [note: 'Date on which this distribution rule expires; null indicates open-ended enforcement.']
  escalation_recipient_role varchar [note: 'Role to which distribution escalates when acknowledgment is not received within the escalation timeout.']
  escalation_timeout_minutes varchar [note: 'Number of minutes without acknowledgment after which the report distribution escalates to the next recipient or channel.']
  external_share_allowed boolean [note: 'Indicates whether reports matched by this rule may be distributed to organizations outside the health system.']
  include_images boolean [note: 'Indicates whether associated DICOM image links or renderings are included alongside the distributed report.']
  message_template_code varchar [note: 'Reference code for the notification/message template applied when formatting the distributed report.']
  modality_scope varchar [note: 'Imaging modalities to which this rule applies (e.g., CT, MRI, XR, US, PET). [ENUM-REF-CANDIDATE: CT|MRI|XR|US|PET|MG|NM|FL — promote to reference product]']
  owner_department varchar [note: 'Radiology sub-department or business unit that owns and maintains this distribution rule.']
  phi_masking_required boolean [note: 'Indicates whether Protected Health Information (PHI) must be masked or de-identified before distribution, e.g., for external sharing under HIPAA.']
  priority_order varchar [note: 'Numeric evaluation precedence indicating the order in which competing distribution rules are applied; lower numbers evaluate first.']
  procedure_scope varchar [note: 'CPT-coded radiology procedure(s) that trigger this distribution rule; comma-delimited CPT codes or code range applicable.']
  quiet_hours_end varchar [note: 'End of the daily quiet-hours window during which non-critical distributions are suppressed or deferred (HH:mm, 24-hour).']
  quiet_hours_start varchar [note: 'Start of the daily quiet-hours window during which non-critical distributions are suppressed or deferred (HH:mm, 24-hour).']
  recipient_endpoint varchar [note: 'Configured target endpoint address for delivery (e.g., HL7 receiving application/facility, direct message address, or interface node) used to route the report.']
  recipient_role varchar [note: 'Intended recipient role or audience for reports matched by this distribution rule.']
  regulatory_reporting_flag boolean [note: 'Indicates whether this distribution rule supports a mandated regulatory or public-health reporting obligation (e.g., cancer registry, dose reporting).']
  report_status_trigger varchar [note: 'Radiology report status that triggers evaluation and firing of this distribution rule.']
  retry_limit varchar [note: 'Maximum number of automatic delivery retry attempts for failed distributions before the rule flags a delivery failure.']
  rule_code varchar [note: 'Externally-known unique short code used by the RIS/PACS to reference this distribution rule.']
  rule_description varchar [note: 'Detailed narrative describing the intent and business conditions under which this distribution rule applies.']
  rule_name varchar [note: 'Human-readable label for the report distribution rule, e.g., \'STAT CT to ED Physician\'.']
  rule_status varchar [note: 'Current lifecycle state of the distribution rule governing whether it is enforced in production.']
  rule_type varchar [note: 'Categorical classification of the distribution rule behavior (automatic routing, manual review, escalation, carbon-copy, external share, or hold).']
  source_system varchar [note: 'Originating RIS/PACS system that owns and enforces this distribution rule (e.g., Epic Radiant, Cerner RadNet).']
  updated_timestamp timestamp [note: 'Timestamp when this distribution rule record was last modified.']

  Note: 'Master reference table for distribution_rule. Referenced by distribution_rule_id.'
}

