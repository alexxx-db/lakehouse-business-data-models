ind:patientAgeMax rdf:type rdf:Property ;
    rdfs:label 'Patient Age Max' ;
    rdfs:comment 'Maximum patient age in years for which this routing rule applies. Null indicates no upper age limit.' ;
    rdfs:domain ind:RoutingRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:patientAgeMin rdf:type rdf:Property ;
    rdfs:label 'Patient Age Min' ;
    rdfs:comment 'Minimum patient age in years for which this routing rule applies. Used for age-based routing to pediatric or geriatric services.' ;
    rdfs:domain ind:RoutingRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:patientGender rdf:type rdf:Property ;
    rdfs:label 'Patient Gender' ;
    rdfs:comment 'Patient gender for which this routing rule applies. Used for gender-specific service routing such as obstetrics or urology.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:patientLocationType rdf:type rdf:Property ;
    rdfs:label 'Patient Location Type' ;
    rdfs:comment 'Type of patient care setting or location for which this routing rule applies.' ;
    rdfs:domain ind:RoutingRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:procedureCode rdf:type rdf:Property ;
    rdfs:label 'Procedure Code' ;
    rdfs:comment 'Specific procedure or service code (CPT, HCPCS, or LOINC) to which this routing rule applies.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:routingSequence rdf:type rdf:Property ;
    rdfs:label 'Routing Sequence' ;
    rdfs:comment 'Order of evaluation for this routing rule when multiple rules may apply. Lower numbers are evaluated first.' ;
    rdfs:domain ind:RoutingRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ruleOwner rdf:type rdf:Property ;
    rdfs:label 'Rule Owner' ;
    rdfs:comment 'Name or identifier of the department, role, or individual responsible for maintaining and approving changes to this routing rule.' ;
    rdfs:domain ind:RoutingRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ruleType rdf:type rdf:Property ;
    rdfs:label 'Rule Type' ;
    rdfs:comment 'Category of clinical order this routing rule applies to, aligned with Epic Orders modules.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:timeOfDayEnd rdf:type rdf:Property ;
    rdfs:label 'Time Of Day End' ;
    rdfs:comment 'End time of day (HH:MM format) during which this routing rule is active. Null indicates rule applies until end of day.' ;
    rdfs:domain ind:RoutingRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:timeOfDayStart rdf:type rdf:Property ;
    rdfs:label 'Time Of Day Start' ;
    rdfs:comment 'Start time of day (HH:MM format) during which this routing rule is active, used for shift-based or time-dependent routing.' ;
    rdfs:domain ind:RoutingRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvedVendorId rdf:type rdf:Property ;
    rdfs:label 'Approved Vendor Id' ;
    rdfs:domain ind:OrderAuthorization ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Vendor .

ind:appealDecisionDate rdf:type rdf:Property ;
    rdfs:label 'Appeal Decision Date' ;
    rdfs:comment 'The date on which the payer made a determination on the appeal of the prior authorization denial.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:appealFiledDate rdf:type rdf:Property ;
    rdfs:label 'Appeal Filed Date' ;
    rdfs:comment 'Date appeal was filed if applicable.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:approvedQuantity rdf:type rdf:Property ;
    rdfs:label 'Approved Quantity' ;
    rdfs:comment 'The quantity of medication units approved by the payer, which may differ from the originally requested quantity.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:approvedQuantityUnit rdf:type rdf:Property ;
    rdfs:label 'Approved Quantity Unit' ;
    rdfs:domain ind:OrderAuthorization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:decisionDatetime rdf:type rdf:Property ;
    rdfs:label 'Decision Datetime' ;
    rdfs:domain ind:OrderAuthorization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:peerToPeerConducted rdf:type rdf:Property ;
    rdfs:label 'Peer To Peer Conducted' ;
    rdfs:domain ind:OrderAuthorization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:peerToPeerDate rdf:type rdf:Property ;
