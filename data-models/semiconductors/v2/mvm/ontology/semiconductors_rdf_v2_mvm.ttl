    rdfs:range xsd:date .

ind:milestoneAmount rdf:type rdf:Property ;
    rdfs:label 'Milestone Amount' ;
    rdfs:comment 'Fee associated with the milestone, invoiced upon completion.' ;
    rdfs:domain ind:NreAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:milestoneName rdf:type rdf:Property ;
    rdfs:label 'Milestone Name' ;
    rdfs:comment 'Name of a specific NRE milestone (e.g., RTL Freeze, Tapeout).' ;
    rdfs:domain ind:NreAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:milestonePlannedDate rdf:type rdf:Property ;
    rdfs:label 'Milestone Planned Date' ;
