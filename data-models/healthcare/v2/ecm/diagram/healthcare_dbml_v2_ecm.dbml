Table reference.geographic_region {
  geographic_region_id varchar [pk, note: 'Surrogate primary key for geographic region record.']
  parent_region_geographic_region_id varchar [note: 'FK to parent geographic region (self-referential hierarchy).']
  aco_service_area_flag boolean [note: 'True if the region is part of an ACO service area.']
  cbsa_code varchar [note: 'Core-Based Statistical Area (CBSA) code.']
  cbsa_name varchar [note: 'CBSA name (e.g., \'New York-Newark-Jersey City, NY-NJ-PA\').']
  census_division varchar [note: 'US Census division (e.g., \'Middle Atlantic\', \'Pacific\').']
  census_region varchar [note: 'US Census region (e.g., \'Northeast\', \'West\').']
  cms_region_number varchar [note: 'CMS region number (1-10).']
  country_code varchar [note: 'ISO 3166-1 alpha-2 country code (e.g., \'US\', \'CA\').']
  effective_end_date date [note: 'Date the region became inactive.']
  effective_start_date date [note: 'Date the region became active.']
  fips_code varchar [note: 'Federal Information Processing Standards (FIPS) code.']
  hrr_code varchar [note: 'Hospital Referral Region (HRR) code (Dartmouth Atlas).']
  hsa_code varchar [note: 'Hospital Service Area (HSA) code (Dartmouth Atlas).']
  is_active boolean [note: 'True if the region is active.']
  last_updated_timestamp timestamp [note: 'Record last update timestamp.']
  latitude decimal(10,7) [note: 'Latitude (decimal degrees).']
  longitude decimal(10,7) [note: 'Longitude (decimal degrees).']
  median_household_income decimal(12,2) [note: 'Median household income (USD).']
  population_estimate varchar [note: 'Population estimate.']
  poverty_rate_percent decimal [note: 'Poverty rate (percent).']
  region_code varchar [note: 'Region code (e.g., ZIP code, county FIPS).']
  region_name varchar [note: 'Region name (e.g., \'New York County\', \'10001\').']
  region_type varchar [note: 'ZIP, County, CBSA, HRR, HSA, State, Country.']
  ruca_code varchar [note: 'Rural-Urban Commuting Area (RUCA) code.']
  state_abbreviation varchar [note: 'State abbreviation (e.g., \'NY\', \'CA\').']
  time_zone varchar [note: 'Time zone (e.g., \'America/New_York\').']
  uninsured_rate_percent decimal [note: 'Uninsured rate (percent).']
  urban_rural_classification varchar [note: 'Urban, Suburban, Rural.']
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutation to ensure change']
  vibe_mutation_marker varchar
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']

  Note: 'Geographic region master with ZIP codes, counties, CBSAs, HRRs, HSAs, and SDOH indicators for population health analytics.'
}

Table reference.condition_code {
  condition_code_id varchar [pk, note: 'Surrogate primary key for condition code record.']
  code_set_version_id varchar [note: 'FK to code_set_version for condition code release.']
  ama_indicator boolean [note: 'True if the code is AMA-approved.']
  bilateral_indicator boolean [note: 'True if the code applies to bilateral procedures.']
  claim_form_type varchar [note: 'UB-04, CMS-1500, ADA Dental Claim Form.']
  code_type varchar [note: 'Condition Code, Occurrence Code, Value Code.']
  commercial_payer_flag boolean [note: 'True if the code is accepted by commercial payers.']
  condition_code_category varchar [note: 'Category (e.g., \'Patient Status\', \'Billing\').']
  condition_code_code varchar [note: 'Two-digit condition code (e.g., \'01\', \'07\', \'A1\').']
  condition_code_description varchar [note: 'Full description of the condition code.']
  effective_date date [note: 'Date the code became valid.']
  expired_indicator boolean [note: 'True if the code is expired.']
  facility_indicator boolean [note: 'True if the code applies to facility claims.']
  governing_body varchar [note: 'Governing body (e.g., \'NUBC\', \'CMS\').']
  hospice_indicator boolean [note: 'True if the code applies to hospice claims.']
  last_updated_date date [note: 'Date the record was last updated.']
  medicaid_approved_flag boolean [note: 'True if the code is Medicaid-approved.']
  medicare_approved_flag boolean [note: 'True if the code is Medicare-approved.']
  pricing_impact_flag boolean [note: 'True if the code impacts pricing.']
  professional_indicator boolean [note: 'True if the code applies to professional claims.']
  replacement_code varchar [note: 'Replacement code if retired.']
  requires_value_flag boolean [note: 'True if the code requires a value (e.g., occurrence date).']
  short_description varchar [note: 'Abbreviated description.']
  telehealth_eligible_flag boolean [note: 'True if the code is telehealth-eligible.']
  termination_date date [note: 'Date the code was retired.']
  ub04_form_locator varchar [note: 'UB-04 form locator (e.g., \'FL 18-28\').']
  usage_notes varchar [note: 'Usage notes and instructions.']
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutation to ensure change']
  vibe_mutation_marker varchar
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']

  Note: 'Condition code master for UB-04 and CMS-1500 claim forms with usage notes and payer applicability.'
}

Table reference.code_set_version {
  code_set_version_id varchar [pk, note: 'Surrogate primary key for code set version record.']
  superseded_by_version_code_set_version_id varchar [note: 'FK to code_set_version that supersedes this version.']
  checksum_algorithm varchar [note: 'Checksum algorithm (e.g., \'SHA-256\', \'MD5\').']
  code_set_name varchar [note: 'Code set name (e.g., \'ICD-10-CM\', \'CPT\', \'SNOMED CT\').']
  code_set_type varchar [note: 'Diagnosis, Procedure, Drug, Laboratory, Geography, etc.']
  compliance_year varchar [note: 'Compliance year (e.g., 2024).']
  copyright_notice varchar [note: 'Copyright notice.']
  country_code varchar [note: 'ISO 3166-1 alpha-2 country code (e.g., \'US\', \'CA\').']
  created_timestamp timestamp [note: 'Record creation timestamp.']
  download_timestamp timestamp [note: 'Timestamp when the code set was downloaded.']
  effective_date date [note: 'Date the code set version became valid.']
  file_hash varchar [note: 'File hash (SHA-256, MD5).']
  file_name varchar [note: 'Source file name.']
  format_type varchar [note: 'CSV, XML, JSON, RF2 (SNOMED), etc.']
  is_hipaa_compliant boolean [note: 'True if the code set is HIPAA-compliant.']
  language_code varchar [note: 'ISO 639-1 language code (e.g., \'en\', \'es\').']
  last_updated_timestamp timestamp [note: 'Record last update timestamp.']
  license_type varchar [note: 'Public Domain, Commercial, UMLS License, etc.']
  load_status varchar [note: 'Pending, In Progress, Completed, Failed.']
  load_timestamp timestamp [note: 'Timestamp when the code set was loaded.']
  publication_date date [note: 'Date the code set was published by the source authority.']
  record_count varchar [note: 'Number of records in the code set.']
  release_notes varchar [note: 'Release notes.']
  source_authority varchar [note: 'Source authority (e.g., \'CMS\', \'AMA\', \'WHO\', \'Regenstrief\').']
  source_url varchar [note: 'Source URL.']
  termination_date date [note: 'Date the code set version was retired.']
  usage_scope varchar [note: 'Clinical, Billing, Research, Interoperability.']
  validation_status varchar [note: 'Validated, Failed, Pending.']
  validation_timestamp timestamp [note: 'Timestamp when the code set was validated.']
  version_identifier varchar [note: 'Version identifier (e.g., \'2024\', \'FY2024\', \'20240301\').']
  version_status varchar [note: 'Active, Superseded, Retired.']
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutation to ensure change']
  vibe_mutation_marker varchar
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']

  Note: 'Code set version master tracking releases, effective dates, and load status for all reference terminologies.'
}

Table reference.crosswalk {
  crosswalk_id varchar [pk, note: 'Surrogate primary key for crosswalk record.']
  code_set_version_id varchar [note: 'FK to code_set_version for the crosswalk release.']
  approximate_flag boolean [note: 'True if the mapping is approximate (not exact).']
  choice_list_indicator varchar [note: 'Choice list indicator (e.g., \'1 of N\', \'All of N\').']
  combination_flag boolean [note: 'True if the mapping requires a combination of target codes.']
  created_timestamp timestamp [note: 'Record creation timestamp.']
  directionality varchar [note: 'Forward, Backward, Bidirectional.']
  effective_date date [note: 'Date the mapping became valid.']
  effective_end_date date [note: 'Effective end date']
  effective_start_date date [note: 'Effective start date']
  last_validated_date date [note: 'Date the mapping was last validated.']
  map_group varchar [note: 'Map group identifier (for grouped mappings).']
  map_priority varchar [note: 'Map priority (1 = highest).']
  mapping_authority varchar [note: 'Mapping authority (e.g., \'CMS\', \'SNOMED International\', \'Regenstrief\').']
  mapping_purpose varchar [note: 'Billing, Clinical Documentation, Research, Interoperability.']
  mapping_quality varchar [note: 'Exact, Broad, Narrow, Partial, Unmappable.']
  mapping_rule varchar [note: 'Mapping rule text.']
  mapping_type varchar [note: '1:1, 1:N, N:1, N:M.']
  no_map_flag boolean [note: 'True if no mapping exists.']
  notes varchar [note: 'Mapping notes.']
  scenario_flag boolean [note: 'True if the mapping is scenario-dependent.']
  source_code varchar [note: 'Source code (e.g., ICD-10-CM code).']
  source_code_display varchar [note: 'Source code display text.']
  source_code_system varchar [note: 'Source code system (e.g., \'ICD-10-CM\', \'CPT\').']
  target_code varchar [note: 'Target code (e.g., SNOMED CT code).']
  target_code_display varchar [note: 'Target code display text.']
  target_code_system varchar [note: 'Target code system (e.g., \'SNOMED CT\', \'LOINC\').']
  termination_date date [note: 'Date the mapping was retired.']
  updated_timestamp timestamp [note: 'Record last update timestamp.']
  usage_count varchar [note: 'Number of times the mapping has been used.']
  validated_by varchar [note: 'User or system that validated the mapping.']
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutation to ensure change']
  vibe_mutation_marker varchar
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']

  Note: 'Code-to-code crosswalk master for terminology mappings (ICD-10 to SNOMED, CPT to HCPCS, etc.) with mapping quality and directionality.'
}

Table reference.major_diagnostic_category {
  major_diagnostic_category_id varchar [pk, note: 'Surrogate primary key for MDC record.']
