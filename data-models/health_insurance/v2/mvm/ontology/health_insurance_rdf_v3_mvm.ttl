    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:amendmentIndicator rdf:type rdf:Property ;
    rdfs:label 'Amendment Indicator' ;
    rdfs:comment 'Indicates if this record is the original decision or an amendment/reversal.' ;
