ind:limsResultCode rdf:type rdf:Property ;
    rdfs:label 'Lims Result Code' ;
    rdfs:comment 'The unique result identifier from the source Laboratory Information Management System (LIMS), such as LabWare. Enables traceability back to the originating system and supports data reconciliation.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mclValue rdf:type rdf:Property ;
    rdfs:label 'Mcl Value' ;
    rdfs:comment 'Applicable MCL or action level value' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mclgValue rdf:type rdf:Property ;
    rdfs:label 'Mclg Value' ;
    rdfs:comment 'The non-enforceable health goal for this analyte in drinking water, expressed in the default reporting unit. Null if no MCLG is established.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:analyticalResultName rdf:type rdf:Property ;
    rdfs:label 'Analytical Result Name' ;
    rdfs:domain ind:AnalyticalResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:percentRecovery rdf:type rdf:Property ;
    rdfs:label 'Percent Recovery' ;
    rdfs:comment 'Quality control metric indicating the percentage of known analyte concentration recovered in matrix spike or laboratory control sample. Used to assess method accuracy and matrix interference. Acceptable ranges are method-specific.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qualifierCode rdf:type rdf:Property ;
    rdfs:label 'Qualifier Code' ;
    rdfs:comment 'Data qualifier (e.g., U=non-detect, J=estimated, B=blank contamination).' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relativePercentDifference rdf:type rdf:Property ;
    rdfs:label 'Relative Percent Difference' ;
    rdfs:comment 'Quality control metric measuring precision between duplicate samples. Calculated as the absolute difference divided by the mean, expressed as a percentage. Used to assess analytical reproducibility.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reportingRequired rdf:type rdf:Property ;
    rdfs:label 'Reporting Required' ;
    rdfs:domain ind:AnalyticalResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:resultComment rdf:type rdf:Property ;
    rdfs:label 'Result Comment' ;
    rdfs:comment 'Free-text comment field for analyst notes, observations, or explanations regarding the result. May include information about matrix interference, unusual sample characteristics, deviations from standard procedure, or other contextual information.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resultStatus rdf:type rdf:Property ;
    rdfs:label 'Result Status' ;
    rdfs:comment 'Status of the monitoring result: pending, validated, reported, rejected.' ;
