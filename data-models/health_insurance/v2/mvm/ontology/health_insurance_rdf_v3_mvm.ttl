    rdfs:range xsd:dateTime .

ind:coordinatorId rdf:type rdf:Property ;
    rdfs:label 'Coordinator Id' ;
    rdfs:comment 'Foreign key linking to care.coordinator. Business justification: Care coordinators submit PA requests for members in care management programs. Essential workflow for tracking coordinator-initiated authorization requests and measuring program effectiveness.' ;
    rdfs:domain ind:HealthInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Coordinator .

ind:primaryPaProviderId rdf:type rdf:Property ;
    rdfs:label 'Primary Pa Provider Id' ;
    rdfs:comment 'Foreign key linking to provider.provider_provider. Business justification: Required for Prior Authorization request processing to link each request to the provider entity for reporting, compliance, and performance metrics.' ;
    rdfs:domain ind:PaRequest ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Provider .

ind:decisionMakerRole rdf:type rdf:Property ;
    rdfs:label 'Decision Maker Role' ;
    rdfs:comment 'Professional role of the decision maker.' ;
    rdfs:domain ind:PaRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedAdjustmentAmount rdf:type rdf:Property ;
    rdfs:label 'Estimated Adjustment Amount' ;
    rdfs:comment 'Estimated adjustments (e.g., discounts, co-pays) applied to the gross amount.' ;
    rdfs:domain ind:PaRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:estimatedGrossAmount rdf:type rdf:Property ;
    rdfs:label 'Estimated Gross Amount' ;
    rdfs:comment 'Initial estimated gross cost of the requested service before adjustments.' ;
    rdfs:domain ind:PaRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:estimatedNetAmount rdf:type rdf:Property ;
    rdfs:label 'Estimated Net Amount' ;
    rdfs:comment 'Final estimated net cost after adjustments.' ;
    rdfs:domain ind:PaRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isAppealable rdf:type rdf:Property ;
    rdfs:label 'Is Appealable' ;
    rdfs:comment 'Indicates whether the member may appeal a denial.' ;
    rdfs:domain ind:PaRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isDuplicateRequest rdf:type rdf:Property ;
    rdfs:label 'Is Duplicate Request' ;
    rdfs:comment 'Indicates whether this request is a duplicate of an existing request.' ;
    rdfs:domain ind:PaRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastAirDueDate rdf:type rdf:Property ;
    rdfs:label 'Last Air Due Date' ;
    rdfs:comment 'Due date for the most recent additional information request.' ;
    rdfs:domain ind:PaRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastAirReceivedDate rdf:type rdf:Property ;
    rdfs:label 'Last Air Received Date' ;
    rdfs:comment 'Date the last additional information request was received.' ;
    rdfs:domain ind:PaRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:paRequestStatus rdf:type rdf:Property ;
    rdfs:label 'Pa Request Status' ;
    rdfs:comment 'Current lifecycle status of the prior authorization request.' ;
    rdfs:domain ind:PaRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:patientAgeAtRequest rdf:type rdf:Property ;
    rdfs:label 'Patient Age At Request' ;
    rdfs:comment 'Age of the member at the time of request submission.' ;
    rdfs:domain ind:PaRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:patientGender rdf:type rdf:Property ;
    rdfs:label 'Patient Gender' ;
    rdfs:comment 'Gender of the member at the time of request.' ;
