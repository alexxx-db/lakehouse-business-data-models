ind:pharmacyLocationId rdf:type rdf:Property ;
    rdfs:label 'Pharmacy Location Id' ;
    rdfs:comment 'SSOT cross-reference to canonical pharmacy.pharmacy_location' ;
    rdfs:domain ind:Healthcare ;
