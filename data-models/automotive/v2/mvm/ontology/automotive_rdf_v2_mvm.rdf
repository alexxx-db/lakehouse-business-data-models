    rdfs:range xsd:string .

ind:subscriptionEndDate rdf:type rdf:Property ;
    rdfs:label 'Subscription End Date' ;
    rdfs:comment 'Date when the current subscription plan expires (null if open-ended).' ;
    rdfs:domain ind:ConnectedVehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:subscriptionPlan rdf:type rdf:Property ;
    rdfs:label 'Subscription Plan' ;
    rdfs:comment 'Service plan governing feature entitlements for the connected vehicle.' ;
    rdfs:domain ind:ConnectedVehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subscriptionStartDate rdf:type rdf:Property ;
    rdfs:label 'Subscription Start Date' ;
    rdfs:comment 'Date when the current subscription plan became effective.' ;
    rdfs:domain ind:ConnectedVehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:tpmsCapability rdf:type rdf:Property ;
    rdfs:label 'Tpms Capability' ;
    rdfs:comment 'Indicates whether the vehicle is equipped with Tire Pressure Monitoring System telemetry.' ;
