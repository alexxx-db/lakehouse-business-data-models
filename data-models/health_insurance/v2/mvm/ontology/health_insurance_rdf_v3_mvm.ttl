ind:drugMasterId rdf:type rdf:Property ;
    rdfs:label 'Drug Master Id' ;
    rdfs:comment 'Foreign key linking to pharmacy.drug_master. Business justification: Member grievances filed for drug coverage denials, formulary tier placement disputes, or PA denials must reference the specific drug. CMS Part D and state regulators require grievance reporting by dru' ;
    rdfs:domain ind:HealthInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DrugMaster .

ind:facilityId rdf:type rdf:Property ;
    rdfs:label 'Facility Id' ;
    rdfs:comment 'Foreign key linking to provider.facility. Business justification: Grievances are frequently filed against facilities (hospitals, urgent care centers) rather than individual providers. CMS grievance reporting and state regulatory submissions require identifying the f' ;
    rdfs:domain ind:HealthInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Facility .

ind:formularyExceptionId rdf:type rdf:Property ;
    rdfs:label 'Formulary Exception Id' ;
    rdfs:comment 'Foreign key linking to pharmacy.formulary_exception. Business justification: Grievances are frequently filed after a formulary exception denial. CMS Part D requires tracking the full coverage determination appeals chain: exception request → denial → grievance. This FK creates ' ;
    rdfs:domain ind:HealthInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FormularyException .

ind:headerId rdf:type rdf:Property ;
    rdfs:label 'Header Id' ;
    rdfs:comment 'SSOT reference to appeal.grievance (single source of truth)' ;
    rdfs:domain ind:HealthInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Header .

ind:paRequestId rdf:type rdf:Property ;
    rdfs:label 'Pa Request Id' ;
    rdfs:comment 'Foreign key linking to utilization.pa_request. Business justification: Grievances are frequently filed when a PA request is denied. This link supports the denial-to-grievance workflow, CMS regulatory reporting of adverse determination appeals, and grievance resolution tr' ;
    rdfs:domain ind:HealthInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PaRequest .

ind:priorAuthorizationId rdf:type rdf:Property ;
    rdfs:label 'Prior Authorization Id' ;
    rdfs:comment 'Foreign key linking to pharmacy.prior_authorization. Business justification: Grievances are filed when prior authorizations are denied. CMS Part D coverage determination regulations require tracking the PA denial → grievance → appeal chain. Health plan compliance teams and reg' ;
    rdfs:domain ind:HealthInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PriorAuthorization .

ind:providerContractId rdf:type rdf:Property ;
    rdfs:label 'Provider Contract Id' ;
    rdfs:comment 'Foreign key linking to contract.provider_contract. Business justification: Member grievances arising from network adequacy, claim denials, or reimbursement disputes must be linked to the governing provider contract for contract performance monitoring, dispute resolution trac' ;
    rdfs:domain ind:HealthInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProviderContract .

ind:providerId rdf:type rdf:Property ;
    rdfs:label 'Provider Id' ;
    rdfs:comment 'Foreign key linking to provider.provider_provider. Business justification: REQUIRED: Grievances are often filed against a specific provider; linking enables tracking, reporting, and regulatory compliance.' ;
    rdfs:domain ind:HealthInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Provider .

ind:reimbursementPolicyId rdf:type rdf:Property ;
    rdfs:label 'Reimbursement Policy Id' ;
    rdfs:comment 'Foreign key linking to contract.reimbursement_policy. Business justification: Grievances frequently dispute specific reimbursement policy decisions — denials, bundling reductions, or modifier edits. Linking grievance to the triggering reimbursement_policy enables root-cause ana' ;
    rdfs:domain ind:HealthInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ReimbursementPolicy .

ind:umCaseId rdf:type rdf:Property ;
    rdfs:label 'Um Case Id' ;
    rdfs:comment 'Foreign key linking to utilization.um_case. Business justification: Grievances arise from adverse UM case determinations (e.g., concurrent review denials, LOS disputes). Linking grievance to um_case enables UM-driven grievance reporting, NCQA/URAC compliance audits, a' ;
    rdfs:domain ind:HealthInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:UmCase .

ind:cmsReportableIndicator rdf:type rdf:Property ;
    rdfs:label 'Cms Reportable Indicator' ;
    rdfs:comment 'True if the grievance is reportable under CMS grievance reporting requirements (e.g., Medicare Advantage).' ;
    rdfs:domain ind:Grievance ;
