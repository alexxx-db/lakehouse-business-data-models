    rdfs:comment 'FK to ordering provider' ;
    rdfs:domain ind:CriticalResult ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:acknowledgedFlag rdf:type rdf:Property ;
    rdfs:label 'Acknowledged Flag' ;
    rdfs:comment 'The acknowledged flag of the radiology critical result record.' ;
    rdfs:domain ind:CriticalResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:acknowledgedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Acknowledged Timestamp' ;
    rdfs:comment 'The acknowledged timestamp of the radiology critical result record.' ;
    rdfs:domain ind:CriticalResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:acknowledgmentDatetime rdf:type rdf:Property ;
