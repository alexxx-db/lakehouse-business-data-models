    rdfs:comment 'Indicates whether this period is eligible for Same-Store Sales (SSS) / Comparable Store Sales (Comp Sales) calculations. True if the period is at least 12 months after the restaurant opening date, enabling year-over-year comparisons.' ;
    rdfs:domain ind:Restaurants ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:weekNumber rdf:type rdf:Property ;
