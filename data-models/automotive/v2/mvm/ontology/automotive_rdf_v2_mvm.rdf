ind:supplyGoodsReceiptId rdf:type rdf:Property ;
    rdfs:label 'Supply Goods Receipt Id' ;
    rdfs:comment 'Unique identifier for the supply_goods_receipt data product (auto-inserted pre-linking).' ;
    rdfs:domain ind:SupplyGoodsReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:goodsMovementId rdf:type rdf:Property ;
    rdfs:label 'Goods Movement Id' ;
    rdfs:comment 'Foreign key linking to inventory.goods_movement. Business justification: A supplier goods receipt triggers a goods movement posting (e.g., movement type 101 in SAP). Linking GR to goods_movement enables reconciliation of received quantities against inventory postings, supp' ;
    rdfs:domain ind:Automotive ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GoodsMovement .

ind:stockBalanceId rdf:type rdf:Property ;
    rdfs:label 'Stock Balance Id' ;
    rdfs:comment 'Foreign key linking to inventory.stock_balance. Business justification: Goods receipt posting directly creates or updates a stock balance record. Inventory controllers and auditors trace GR documents to resulting stock balance changes for discrepancy resolution, month-end' ;
    rdfs:domain ind:Automotive ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:StockBalance .

ind:supplierScorecardId rdf:type rdf:Property ;
    rdfs:label 'Supplier Scorecard Id' ;
    rdfs:comment 'System-generated unique identifier for each supplier scorecard record.' ;
    rdfs:domain ind:SupplierScorecard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:approvedVendorListId rdf:type rdf:Property ;
    rdfs:label 'Approved Vendor List Id' ;
    rdfs:comment 'Foreign key linking to procurement.approved_vendor_list. Business justification: Scorecard results directly drive AVL status changes — preferred, backup, or removal decisions in automotive sourcing. Procurement teams run formal AVL review processes triggered by scorecard threshold' ;
    rdfs:domain ind:Automotive ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ApprovedVendorList .

ind:auditId rdf:type rdf:Property ;
    rdfs:label 'Audit Id' ;
    rdfs:comment 'Foreign key linking to quality.audit. Business justification: Supplier performance scorecards in automotive incorporate audit results as a scored dimension. Linking supplier_scorecard to the quality audit that informed the evaluation period score supports IATF 1' ;
    rdfs:domain ind:Automotive ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Audit .

ind:complianceScore rdf:type rdf:Property ;
