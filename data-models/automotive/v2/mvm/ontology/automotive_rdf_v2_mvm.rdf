    rdfs:comment 'Number of technicians employed at the service center.' ;
    rdfs:domain ind:ServiceCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:warrantyClaimsProcessed rdf:type rdf:Property ;
    rdfs:label 'Warranty Claims Processed' ;
    rdfs:comment 'Cumulative count of warranty claims handled by the center.' ;
    rdfs:domain ind:ServiceCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:certificationExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Certification Expiry Date' ;
    rdfs:comment 'Date on which the technician\'s current certification expires.' ;
    rdfs:domain ind:Technician ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:certificationLevel rdf:type rdf:Property ;
    rdfs:label 'Certification Level' ;
    rdfs:comment 'Level of certification achieved by the technician.' ;
    rdfs:domain ind:Technician ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:certificationType rdf:type rdf:Property ;
    rdfs:label 'Certification Type' ;
    rdfs:comment 'Type of certification held by the technician (e.g., ASE, OEM, EV, ADAS).' ;
    rdfs:domain ind:Technician ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:currentActiveRoCount rdf:type rdf:Property ;
    rdfs:label 'Current Active Ro Count' ;
    rdfs:comment 'Number of repair orders currently assigned to the technician.' ;
    rdfs:domain ind:Technician ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:flatRateEfficiencyRating rdf:type rdf:Property ;
    rdfs:label 'Flat Rate Efficiency Rating' ;
    rdfs:comment 'Efficiency rating expressed as a percentage of flat-rate labor productivity.' ;
    rdfs:domain ind:Technician ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fullName rdf:type rdf:Property ;
    rdfs:label 'Full Name' ;
    rdfs:comment 'Legal full name of the technician.' ;
    rdfs:domain ind:Technician ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hireDate rdf:type rdf:Property ;
    rdfs:label 'Hire Date' ;
    rdfs:comment 'Date the technician was hired by the organization.' ;
    rdfs:domain ind:Technician ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastTrainingDate rdf:type rdf:Property ;
    rdfs:label 'Last Training Date' ;
    rdfs:comment 'Date of the most recent training session attended by the technician.' ;
    rdfs:domain ind:Technician ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:maxConcurrentRo rdf:type rdf:Property ;
    rdfs:label 'Max Concurrent Ro' ;
    rdfs:comment 'Maximum number of repair orders the technician can handle simultaneously.' ;
    rdfs:domain ind:Technician ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:overtimeEligible rdf:type rdf:Property ;
    rdfs:label 'Overtime Eligible' ;
    rdfs:comment 'Indicates whether the technician is eligible for overtime pay.' ;
    rdfs:domain ind:Technician ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:overtimeRateMultiplier rdf:type rdf:Property ;
    rdfs:label 'Overtime Rate Multiplier' ;
    rdfs:comment 'Multiplier applied to the base labor rate for overtime work.' ;
    rdfs:domain ind:Technician ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:shiftType rdf:type rdf:Property ;
    rdfs:label 'Shift Type' ;
    rdfs:comment 'Work shift classification for the technician.' ;
    rdfs:domain ind:Technician ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:skillLevel rdf:type rdf:Property ;
    rdfs:label 'Skill Level' ;
    rdfs:comment 'Skill tier of the technician based on experience and performance.' ;
    rdfs:domain ind:Technician ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:specialization rdf:type rdf:Property ;
    rdfs:label 'Specialization' ;
    rdfs:comment 'Technical area of expertise for the technician.' ;
    rdfs:domain ind:Technician ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:technicianStatus rdf:type rdf:Property ;
    rdfs:label 'Technician Status' ;
    rdfs:comment 'Current employment status of the technician.' ;
    rdfs:domain ind:Technician ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trainingHoursCompleted rdf:type rdf:Property ;
    rdfs:label 'Training Hours Completed' ;
    rdfs:comment 'Cumulative hours of formal training completed by the technician.' ;
    rdfs:domain ind:Technician ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:yearsOfExperience rdf:type rdf:Property ;
    rdfs:label 'Years Of Experience' ;
    rdfs:comment 'Total number of years the technician has worked in automotive service.' ;
    rdfs:domain ind:Technician ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ownerPartyId rdf:type rdf:Property ;
    rdfs:label 'Owner Party Id' ;
    rdfs:comment 'Foreign key linking to customer.party. Business justification: Needed to identify the legal owner for billing, data-privacy compliance, and service entitlement of each connected vehicle.' ;
    rdfs:domain ind:ConnectedVehicle ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:vehicleVinRegistryId rdf:type rdf:Property ;
    rdfs:label 'Vehicle Vin Registry Id' ;
    rdfs:comment 'Foreign key linking to vehicle.vin_registry. Business justification: Required for warranty, recall and OTA management linking each connected vehicle to the official VIN registry record.' ;
    rdfs:domain ind:Automotive ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:VinRegistry .

ind:activationStatus rdf:type rdf:Property ;
    rdfs:label 'Activation Status' ;
    rdfs:comment 'Current lifecycle state of the device activation.' ;
    rdfs:domain ind:ConnectedVehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:activationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Activation Timestamp' ;
    rdfs:comment 'Date and time when the device was first activated.' ;
    rdfs:domain ind:ConnectedVehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:batteryHealthPercent rdf:type rdf:Property ;
    rdfs:label 'Battery Health Percent' ;
    rdfs:comment 'Estimated health of the battery relative to its original capacity.' ;
    rdfs:domain ind:ConnectedVehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:batteryStateOfChargePercent rdf:type rdf:Property ;
    rdfs:label 'Battery State Of Charge Percent' ;
    rdfs:comment 'Current state of charge of the vehicle\'s battery expressed as a percentage.' ;
    rdfs:domain ind:ConnectedVehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:connectivityTier rdf:type rdf:Property ;
    rdfs:label 'Connectivity Tier' ;
    rdfs:comment 'Service tier defining data allowance and priority for the vehicle.' ;
    rdfs:domain ind:ConnectedVehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataPlan rdf:type rdf:Property ;
    rdfs:label 'Data Plan' ;
    rdfs:comment 'Subscription plan governing cellular data usage.' ;
    rdfs:domain ind:ConnectedVehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataUsageGb rdf:type rdf:Property ;
    rdfs:label 'Data Usage Gb' ;
    rdfs:comment 'Cumulative cellular data consumed by the vehicle in the current billing cycle.' ;
    rdfs:domain ind:ConnectedVehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dataUsageLastReset rdf:type rdf:Property ;
    rdfs:label 'Data Usage Last Reset' ;
    rdfs:comment 'Date when the data usage counter was last reset.' ;
