  effective_until date [note: 'Price effective end date']
  is_current boolean [note: 'Whether this is the current active price']
  price_amount decimal(18,2) [note: 'Contracted price amount']
  price_change_reason varchar [note: 'Reason for price change']
  price_index_reference varchar [note: 'Reference index for indexed pricing']
  price_tier_max_qty decimal(18,2) [note: 'Maximum quantity for this price tier']
  price_tier_min_qty decimal(18,2) [note: 'Minimum quantity for this price tier']
  price_type varchar [note: 'Type (fixed, indexed, formula)']
  unit_of_measure varchar [note: 'UOM for the price']
  updated_timestamp timestamp [note: 'Record last update timestamp']

  Note: 'Price schedules within supplier contracts, supporting tiered and time-bound pricing.'
}

Table supply.supplier_performance {
  supplier_performance_id varchar [pk, note: 'Primary key']
  procurement_supplier_id varchar [note: 'FK to supplier']
  audit_findings_count varchar [note: 'Number of audit findings']
  average_lead_time_days decimal(5,2) [note: 'Average lead time in days']
