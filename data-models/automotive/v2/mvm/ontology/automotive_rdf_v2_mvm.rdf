    rdfs:comment 'Foreign key linking to aftersales.service_campaign. Business justification: Recall and service campaigns generate MRP requirements for specific parts at scale. Campaign-driven demand planning is a named automotive business process — planners must trace MRP requirements back t' ;
    rdfs:domain ind:Automotive ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ServiceCampaign .

ind:batchFlag rdf:type rdf:Property ;
    rdfs:label 'Batch Flag' ;
    rdfs:comment 'Indicates whether the material is managed in batches.' ;
    rdfs:domain ind:MrpRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:demandSource rdf:type rdf:Property ;
    rdfs:label 'Demand Source' ;
    rdfs:comment 'Origin of the demand that generated the requirement.' ;
    rdfs:domain ind:MrpRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exceptionMessage rdf:type rdf:Property ;
    rdfs:label 'Exception Message' ;
    rdfs:comment 'System-generated message describing any planning exception for the requirement.' ;
    rdfs:domain ind:MrpRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mrpRequirementStatus rdf:type rdf:Property ;
    rdfs:label 'Mrp Requirement Status' ;
    rdfs:comment 'Current processing state of the requirement.' ;
    rdfs:domain ind:MrpRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planningHorizonDays rdf:type rdf:Property ;
    rdfs:label 'Planning Horizon Days' ;
    rdfs:comment 'Number of days covered by the planning run that produced this requirement.' ;
    rdfs:domain ind:MrpRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:priorityCode rdf:type rdf:Property ;
    rdfs:label 'Priority Code' ;
    rdfs:comment 'Business priority assigned to the requirement for planning urgency.' ;
    rdfs:domain ind:Automotive ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:quantityRequired rdf:type rdf:Property ;
    rdfs:label 'Quantity Required' ;
    rdfs:comment 'Total quantity of the material required for the planning horizon.' ;
    rdfs:domain ind:MrpRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reorderPoint rdf:type rdf:Property ;
    rdfs:label 'Reorder Point' ;
    rdfs:comment 'Inventory level that triggers a new procurement proposal.' ;
    rdfs:domain ind:Automotive ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requirementDate rdf:type rdf:Property ;
    rdfs:label 'Requirement Date' ;
    rdfs:comment 'Date by which the material is needed to meet production schedules.' ;
    rdfs:domain ind:MrpRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:requirementNumber rdf:type rdf:Property ;
    rdfs:label 'Requirement Number' ;
    rdfs:comment 'Business identifier assigned to the requirement by the MRP run.' ;
    rdfs:domain ind:MrpRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requirementType rdf:type rdf:Property ;
    rdfs:label 'Requirement Type' ;
    rdfs:comment 'Indicates whether the requirement is independent (external demand) or dependent (internal component need).' ;
    rdfs:domain ind:MrpRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:safetyStock rdf:type rdf:Property ;
    rdfs:label 'Safety Stock' ;
    rdfs:comment 'Buffer stock maintained to protect against demand variability and supply delays.' ;
    rdfs:domain ind:Inventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryFinishedAllocationDealerDealershipId rdf:type rdf:Property ;
    rdfs:label 'Primary Finished Allocation Dealer Dealership Id' ;
    rdfs:comment 'Identifier of the dealer to which the vehicle is allocated.' ;
