}

Table research.grant {
  abstract varchar [note: 'Narrative summary describing the scientific aims and scope of the funded project.']
  account_code varchar [note: 'Institutional fund or general ledger account code where grant expenditures are recorded.']
  animal_subjects_flag boolean [note: 'Indicates whether the funded research involves animal subjects requiring IACUC oversight.']
  application_status varchar [note: 'Status of the grant application within the sponsor review process.']
  award_date date [note: 'Date the Notice of Award was issued by the sponsor.']
  budget_period_end_date date [note: 'End date of the current annual budget period.']
  budget_period_start_date date [note: 'Start date of the current annual budget period.']
  cfda_number varchar [note: 'Catalog of Federal Domestic Assistance / Assistance Listing number identifying the federal program funding the grant.']
  clinical_trial_flag boolean [note: 'Indicates whether the grant funds a clinical trial subject to FDA / ClinicalTrials.gov requirements.']
  closeout_date date [note: 'Date the grant was administratively and financially closed out.']
  compliance_status varchar [note: 'Overall regulatory compliance status of the grant (IRB, financial, reporting).']
  cost_share_required_amount decimal(18,2) [note: 'Committed institutional cost-sharing or matching amount required by the sponsor.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the award amounts.']
  current_year_budget_amount decimal(18,2) [note: 'Funded budget amount for the current active budget period.']
  department_name varchar [note: 'Name of the academic or clinical department administering the grant.']
  direct_cost_amount decimal(18,2) [note: 'Portion of the award attributable to direct project costs.']
  duns_uei_number varchar [note: 'SAM.gov Unique Entity Identifier of the recipient institution for federal awards.']
  financial_conflict_of_interest_flag boolean [note: 'Indicates whether a financial conflict of interest has been disclosed and requires management on this grant.']
  funding_source_type varchar [note: 'Category of the organization providing the grant funds.']
  grant_number varchar [note: 'Externally-known unique award number assigned by the funding agency (e.g., NIH award number). Serves as the business identifier of the grant.']
  grant_status varchar [note: 'Current state of the grant within its lifecycle.']
  grant_type varchar [note: 'Classification of the grant mechanism. [ENUM-REF-CANDIDATE: research_project|program_project|training|career_development|cooperative_agreement|contract|fellowship|subaward — promote to reference product]']
  human_subjects_flag boolean [note: 'Indicates whether the funded research involves human subjects requiring IRB oversight.']
  indirect_cost_amount decimal(18,2) [note: 'Portion of the award attributable to Facilities & Administrative (indirect) costs.']
  indirect_cost_rate_pct decimal(5,2) [note: 'Negotiated Facilities & Administrative (F&A) indirect cost rate applied to the award.']
  irb_protocol_number varchar [note: 'Institutional Review Board protocol number linked to the human-subjects research funded by this grant.']
  next_report_due_date date [note: 'Due date of the next required progress or financial report to the sponsor.']
  no_cost_extension_end_date date [note: 'Revised end date if a no-cost extension has been approved on the award.']
  prime_sponsor_name varchar [note: 'Name of the originating prime sponsor when the award is a subaward passed through another institution.']
  principal_investigator_name varchar [note: 'Full name of the principal investigator responsible for the scientific and technical direction of the grant.']
  project_end_date date [note: 'Date on which the overall project period ends (nullable for open-ended awards).']
  project_start_date date [note: 'Date on which the overall project period begins and the award becomes binding.']
  record_created_timestamp timestamp [note: 'Timestamp when the grant record was first captured in the system.']
  record_updated_timestamp timestamp [note: 'Timestamp when the grant record was last modified.']
  reporting_frequency varchar [note: 'Required frequency of technical and financial progress reports to the sponsor.']
  research_type varchar [note: 'Category of research the grant supports.']
  restricted_funds_flag boolean [note: 'Indicates whether the grant funds are restricted to specific purposes by the sponsor.']
  sponsor_name varchar [note: 'Name of the funding sponsor or agency that awarded the grant (e.g., National Institutes of Health).']
  sponsor_program_officer_name varchar [note: 'Name of the sponsor\'s assigned program or grants management officer.']
  submission_date date [note: 'Date the grant application was submitted to the sponsor.']
  title varchar [note: 'Official title of the funded research project or program.']
  total_awarded_amount decimal(18,2) [note: 'Total dollar value awarded across the full project period, including direct and indirect costs.']

  Note: 'Master reference table for grant. Referenced by grant_id.'
}

Table reference.icd_code {
  icd_code_id varchar [pk, note: 'Surrogate primary key for ICD code record.']
  code_set_version_id varchar [note: 'FK to code_set_version for ICD-10-CM, ICD-10-PCS, or ICD-9-CM release.']
  age_high varchar [note: 'Maximum age for which this code is valid (pediatric/geriatric restrictions).']
  age_low varchar [note: 'Minimum age for which this code is valid.']
  billable_flag boolean [note: 'True if the code is billable (leaf-level); false if header/category only.']
  cc_flag boolean [note: 'True if the diagnosis qualifies as a Complication or Comorbidity (CC) for DRG grouping.']
  chapter varchar [note: 'ICD chapter name (e.g., \'Diseases of the circulatory system\').']
  chapter_code varchar [note: 'ICD chapter code (e.g., \'IX\' for circulatory).']
  code_type varchar [note: 'ICD-10-CM, ICD-10-PCS, ICD-9-CM, ICD-9-PCS.']
  created_timestamp timestamp [note: 'Record creation timestamp.']
  effective_date date [note: 'Date the code became valid for use.']
  etiology_code_flag boolean [note: 'True if the code represents the underlying cause (etiology) in a manifestation pair.']
  expiration_date date [note: 'Date the code was retired or replaced.']
  gender_specific_flag boolean [note: 'True if the code is valid only for a specific sex (e.g., pregnancy codes).']
  hac_flag boolean [note: 'True if the diagnosis is a Hospital-Acquired Condition (HAC) subject to CMS non-payment.']
  icd_code_category varchar [note: 'Category or subcategory grouping (e.g., \'I20-I25 Ischemic heart diseases\').']
  icd_code_code varchar [note: 'The actual ICD code (e.g., \'I21.01\', \'0016070\').']
  long_description varchar [note: 'Full clinical description of the code.']
  manifestation_code_flag boolean [note: 'True if the code represents a manifestation (must be sequenced after etiology).']
  mcc_flag boolean [note: 'True if the diagnosis qualifies as a Major Complication or Comorbidity (MCC) for DRG grouping.']
  parent_code varchar [note: 'Parent ICD code in the hierarchy (e.g., \'I21\' is parent of \'I21.01\').']
  poa_exempt_flag boolean [note: 'True if the code is exempt from Present on Admission (POA) reporting.']
  replacement_code varchar [note: 'ICD code that supersedes this code if retired.']
  short_description varchar [note: 'Abbreviated description for display.']
  snomed_ct_mapping varchar [note: 'SNOMED CT concept ID(s) mapped to this ICD code.']
  subcategory varchar [note: 'Subcategory grouping within the category.']
  unacceptable_principal_dx_flag boolean [note: 'True if the code cannot be used as a principal diagnosis.']
  updated_timestamp timestamp [note: 'Record last update timestamp.']
  valid_for_coding_flag boolean [note: 'True if the code is currently valid for clinical coding.']
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutation to ensure change']
  vibe_mutation_marker varchar
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']

  Note: 'International Classification of Diseases (ICD-9-CM, ICD-10-CM, ICD-10-PCS) code master with billability, CC/MCC flags, and SNOMED CT mappings.'
}

Table reference.cpt_code {
  cpt_code_id varchar [pk, note: 'Surrogate primary key for CPT code record.']
  code_set_version_id varchar [note: 'FK to code_set_version for CPT annual release.']
  age_range_high varchar [note: 'Maximum age for which this code is appropriate.']
  age_range_low varchar [note: 'Minimum age for which this code is appropriate.']
  anesthesia_base_units decimal(6,2) [note: 'Base units for anesthesia codes (ASA Relative Value Guide).']
  clinical_family varchar [note: 'Clinical grouping (e.g., \'Cardiovascular\', \'Orthopedic\').']
  conversion_factor decimal(10,4) [note: 'Dollar conversion factor for RVU-to-payment calculation.']
  cpt_code varchar [note: 'Five-digit CPT code (e.g., \'99213\', \'27447\').']
  cpt_code_category varchar [note: 'Category I, II, III, or Unlisted.']
  cpt_code_status varchar [note: 'Active, Deleted, Revised.']
  created_timestamp timestamp [note: 'Record creation timestamp.']
  effective_date date [note: 'Date the code became valid.']
  facility_indicator varchar [note: 'Facility vs. non-facility pricing indicator.']
  full_descriptor varchar [note: 'Complete CPT descriptor text.']
  gender_specific varchar [note: 'Male, Female, or null if not gender-specific.']
  global_period varchar [note: '000, 010, 090, XXX, YYY, ZZZ (Medicare global surgery days).']
  malpractice_rvu decimal(10,4) [note: 'Malpractice relative value unit.']
  medically_unlikely_edit_value varchar [note: 'CMS MUE limit (max units per day).']
  modifier_indicator varchar [note: 'Modifier applicability (e.g., \'0\' = no modifier, \'1\' = modifier allowed).']
  multiple_procedure_indicator varchar [note: '0, 2, 3, 4, 5, 9 (multiple procedure payment reduction rules).']
  national_payment_amount decimal(18,2) [note: 'National average Medicare payment amount.']
  ncci_edit_indicator boolean [note: 'True if the code has National Correct Coding Initiative (NCCI) edits.']
  physician_supervision_required varchar [note: 'Direct, General, Personal, or None.']
  place_of_service_restriction varchar [note: 'Comma-separated POS codes where the code is valid.']
  practice_expense_rvu decimal(10,4) [note: 'Practice expense relative value unit.']
  section varchar [note: 'CPT section (e.g., \'Evaluation and Management\', \'Surgery\').']
  short_descriptor varchar [note: 'Abbreviated descriptor for display.']
  source_system_code varchar [note: 'Source system identifier.']
  subsection varchar [note: 'CPT subsection grouping.']
  telemedicine_eligible boolean [note: 'True if the code is eligible for telemedicine billing.']
  termination_date date [note: 'Date the code was retired.']
  total_rvu decimal(10,4) [note: 'Total relative value unit (work + PE + malpractice).']
  updated_timestamp timestamp [note: 'Record last update timestamp.']
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutation to ensure change']
  vibe_mutation_marker varchar
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']
  work_rvu decimal(10,4) [note: 'Work relative value unit.']

  Note: 'Current Procedural Terminology (CPT) code master with RVU values, global periods, NCCI edits, and Medicare payment data.'
}

Table reference.hcpcs_code {
  hcpcs_code_id varchar [pk, note: 'Surrogate primary key for HCPCS code record.']
  code_set_version_id varchar [note: 'FK to code_set_version for HCPCS annual release.']
  age_restriction varchar [note: 'Age range or restriction text (e.g., \'Pediatric only\').']
  anesthesia_base_units decimal(5,2) [note: 'Base units for anesthesia HCPCS codes.']
  asc_payment_indicator decimal(18,2) [note: 'Ambulatory Surgery Center payment indicator (A, B, C, etc.).']
  assistant_surgeon_indicator varchar [note: '0, 1, 2 (assistant surgeon payment rules).']
  bilateral_surgery_indicator varchar [note: '0, 1, 2, 3 (bilateral procedure payment rules).']
  co_surgeon_indicator varchar [note: '0, 1, 2 (co-surgeon payment rules).']
  code_type varchar [note: 'HCPCS Level II, Local Code, Temporary Code.']
  coverage_indicator varchar [note: 'Covered, Not Covered, Carrier Discretion.']
  diagnosis_requirement_indicator boolean [note: 'True if specific diagnosis codes are required for coverage.']
  dme_indicator boolean [note: 'True if the code represents durable medical equipment.']
  drug_indicator boolean [note: 'True if the code represents a drug or biologic.']
  effective_date date [note: 'Date the code became valid.']
  frequency_limit varchar [note: 'Frequency limitation text (e.g., \'Once per year\').']
  gender_restriction varchar [note: 'Male, Female, or null.']
  global_period varchar [note: '000, 010, 090, XXX, YYY, ZZZ.']
  hcpcs_code_category varchar [note: 'A-V category (e.g., \'A\' = Transportation, \'J\' = Drugs).']
  hcpcs_code_code varchar [note: 'Five-character HCPCS code (e.g., \'J1100\', \'E0601\').']
  intraoperative_percentage decimal [note: 'Percentage of global fee for intraoperative services.']
  last_updated_date date [note: 'Date the record was last updated.']
  long_description varchar [note: 'Full HCPCS descriptor.']
  modifier_required_indicator boolean [note: 'True if a modifier is required for billing.']
  multiple_procedure_indicator varchar [note: '0, 2, 3, 4, 5, 9.']
  ndc_crosswalk_indicator boolean [note: 'True if the code has an NDC crosswalk.']
  opps_payment_indicator decimal(18,2) [note: 'Outpatient Prospective Payment System indicator (A, B, C, etc.).']
  place_of_service_restriction varchar [note: 'Comma-separated POS codes.']
  postoperative_percentage decimal [note: 'Percentage of global fee for postoperative services.']
  preoperative_percentage decimal [note: 'Percentage of global fee for preoperative services.']
  pricing_indicator varchar [note: 'Pricing methodology (e.g., \'Fee Schedule\', \'Carrier Priced\').']
  prior_authorization_indicator boolean [note: 'True if prior authorization is required.']
  professional_component_indicator varchar [note: '0, 1, 2, 3 (professional component payment rules).']
  quantity_limit decimal(10,2) [note: 'Maximum quantity per service period.']
  short_description varchar [note: 'Abbreviated descriptor.']
  superseded_by_code varchar [note: 'HCPCS code that replaces this code.']
  team_surgery_indicator varchar [note: '0, 1, 2 (team surgery payment rules).']
  technical_component_indicator varchar [note: '0, 1, 2, 3 (technical component payment rules).']
  termination_date date [note: 'Date the code was retired.']
  unit_of_measure varchar [note: 'Unit of measure (e.g., \'mg\', \'ml\', \'each\').']
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutation to ensure change']
  vibe_mutation_marker varchar
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']

  Note: 'Healthcare Common Procedure Coding System (HCPCS Level II) code master for DME, drugs, supplies, and non-physician services.'
}

Table reference.drg {
  drg_id varchar [pk, note: 'Surrogate primary key for DRG record.']
  code_set_version_id varchar [note: 'FK to code_set_version for DRG fiscal year release.']
  major_diagnostic_category_id varchar [note: 'FK to major_diagnostic_category.']
  arithmetic_mean_los decimal(6,2) [note: 'Arithmetic mean length of stay in days.']
  bundled_payment_flag boolean [note: 'True if the DRG is part of a bundled payment program.']
  clinical_family varchar [note: 'Clinical grouping (e.g., \'Cardiovascular\', \'Orthopedic\').']
  complication_level varchar [note: 'With CC, With MCC, Without CC/MCC.']
  cost_outlier_threshold decimal(18,2) [note: 'Cost threshold for outlier payment eligibility.']
  created_timestamp timestamp [note: 'Record creation timestamp.']
  drg_code varchar [note: 'Three-digit DRG code (e.g., \'470\', \'871\').']
  drg_description varchar [note: 'Full DRG descriptor.']
  drg_type varchar [note: 'MS-DRG, APR-DRG, AP-DRG, IR-DRG.']
  effective_date date [note: 'Date the DRG became valid.']
  expiration_date date [note: 'Date the DRG was retired.']
  geometric_mean_los decimal(6,2) [note: 'Geometric mean length of stay in days (used for outlier calculation).']
  grouper_system varchar [note: 'Grouper software (e.g., \'3M\', \'Optum\', \'CMS\').']
  last_updated_timestamp timestamp [note: 'Record last update timestamp.']
  national_average_charges decimal(18,2) [note: 'National average total charges for the DRG.']
  national_average_payment decimal(18,2) [note: 'National average Medicare payment for the DRG.']
  national_case_volume varchar [note: 'National case volume for the DRG.']
  operating_room_procedure_flag boolean [note: 'True if the DRG requires an OR procedure.']
  post_acute_transfer_flag boolean [note: 'True if the DRG is subject to post-acute transfer payment reduction.']
  principal_diagnosis_range_end varchar [note: 'End of principal diagnosis code range for the DRG.']
  principal_diagnosis_range_start varchar [note: 'Start of principal diagnosis code range for the DRG.']
  procedure_requirement_flag boolean [note: 'True if the DRG requires a specific procedure.']
  quality_measure_flag boolean [note: 'True if the DRG is tied to a quality measure.']
  readmission_penalty_flag boolean [note: 'True if the DRG is subject to CMS readmission penalties.']
  relative_weight decimal(10,4) [note: 'DRG relative weight for payment calculation.']
  special_pay_flag boolean [note: 'True if the DRG has special payment rules.']
  title varchar [note: 'Short DRG title.']
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutation to ensure change']
  vibe_mutation_marker varchar
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']

  Note: 'Diagnosis-Related Group (MS-DRG, APR-DRG) master with relative weights, geometric mean LOS, and payment parameters.'
}

Table reference.snomed_concept {
  snomed_concept_id varchar [pk, note: 'Surrogate primary key for SNOMED CT concept record.']
  code_set_version_id varchar [note: 'FK to code_set_version for SNOMED CT release.']
  parent_concept_snomed_concept_id varchar [note: 'FK to parent SNOMED CT concept (self-referential hierarchy).']
  clinical_documentation_section varchar [note: 'Recommended clinical documentation section (e.g., \'Problem List\', \'Medications\').']
  concept_class varchar [note: 'Clinical finding, Procedure, Observable entity, etc.']
  concept_code varchar
  concept_definition varchar [note: 'Formal definition of the concept.']
  concept_status varchar [note: 'Active, Inactive, Retired.']
  cpt_map_target varchar [note: 'CPT code(s) mapped to this SNOMED CT concept.']
  created_timestamp timestamp [note: 'Record creation timestamp.']
  definition_status varchar [note: 'Primitive, Fully Defined.']
  effective_date date
  effective_time date [note: 'Date the concept became active.']
  fhir_value_set_membership varchar [note: 'Comma-separated FHIR value set URLs.']
  fully_specified_name varchar [note: 'Fully specified name (FSN) with semantic tag.']
  hierarchy varchar
  hierarchy_level varchar [note: 'Depth in the SNOMED CT hierarchy (0 = root).']
  icd10_map_correlation varchar [note: 'Exact, Broad, Narrow, Partial.']
  icd10_map_target varchar [note: 'ICD-10-CM code(s) mapped to this SNOMED CT concept.']
  is_active boolean
  is_ehr_preferred boolean [note: 'True if the concept is preferred for EHR documentation.']
  is_leaf_concept boolean [note: 'True if the concept has no children.']
  is_primitive boolean [note: 'True if the concept is primitive (not fully defined).']
  is_reportable boolean [note: 'True if the concept is reportable for quality measures.']
  last_modified_timestamp timestamp
  last_used_date date [note: 'Date the concept was last used in clinical documentation.']
  loinc_map_target varchar [note: 'LOINC code(s) mapped to this SNOMED CT concept.']
  module_code varchar [note: 'SNOMED CT module identifier (e.g., 900000000000207008 = International).']
  patient_friendly_term varchar [note: 'Patient-friendly synonym for patient portals.']
  preferred_term varchar [note: 'Preferred term (PT) for display.']
  quality_measure_inclusion varchar [note: 'Comma-separated quality measure identifiers.']
  relationship_count varchar [note: 'Number of relationships (IS-A, attribute, etc.).']
  rxnorm_map_target varchar [note: 'RxNorm code(s) mapped to this SNOMED CT concept.']
  semantic_tag varchar [note: 'Semantic tag (e.g., \'disorder\', \'procedure\', \'finding\').']
  specialty_relevance varchar [note: 'Comma-separated specialty codes.']
  synonym_count varchar [note: 'Number of synonyms.']
  top_level_hierarchy varchar [note: 'Top-level hierarchy (e.g., \'Clinical finding\', \'Procedure\').']
  updated_timestamp timestamp [note: 'Record last update timestamp.']
  usage_frequency_rank varchar [note: 'Usage frequency rank (1 = most used).']
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutation to ensure change']
  vibe_mutation_marker varchar
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']

  Note: 'SNOMED CT concept master with hierarchies, relationships, and mappings to ICD-10, CPT, LOINC, and RxNorm.'
}

Table reference.loinc_code {
  loinc_code_id varchar [pk, note: 'Surrogate primary key for LOINC code record.']
  code_set_version_id varchar [note: 'FK to code_set_version for LOINC release.']
  class varchar [note: 'LOINC class (e.g., \'CHEM\', \'HEM/BC\', \'MICRO\').']
  component varchar [note: 'Component (analyte) being measured (e.g., \'Glucose\', \'Hemoglobin\').']
  consumer_name varchar [note: 'Consumer-friendly name for patient portals.']
  created_timestamp timestamp [note: 'Record creation timestamp.']
  deprecated_date date [note: 'Date the code was deprecated.']
  display_name varchar [note: 'Display name for UI.']
  effective_date date [note: 'Date the code became valid.']
  example_ucum_units varchar [note: 'Example UCUM units (e.g., \'mg/dL\', \'mmol/L\').']
  example_units varchar [note: 'Example units (non-UCUM).']
  external_copyright_notice varchar [note: 'Copyright notice for external content.']
  hl7_field_subfield_code varchar [note: 'HL7 v2 field/subfield code.']
  hl7_v3_code_system_oid varchar [note: 'HL7 v3 code system OID.']
  is_active boolean [note: 'True if the code is active.']
  last_verified_date date [note: 'Date the code was last verified.']
  local_code varchar [note: 'Local laboratory code mapped to this LOINC code.']
  loinc_number varchar [note: 'LOINC code (e.g., \'2345-7\', \'8867-4\').']
  long_common_name varchar [note: 'Long common name.']
  method_type varchar [note: 'Method (e.g., \'Enzymatic\', \'Immunoassay\').']
  order_observation_flag boolean [note: 'True if the code can be used for both orders and observations.']
  panel_type varchar [note: 'Panel, Battery, or null.']
  property varchar [note: 'Property (e.g., \'MCnc\' = mass concentration, \'Qn\' = quantitative).']
  related_names varchar [note: 'Comma-separated related names.']
  scale_type varchar [note: 'Qn (quantitative), Ord (ordinal), Nom (nominal), Nar (narrative), Doc (document).']
  short_name varchar [note: 'Short name for display.']
  survey_question_source varchar [note: 'Survey question source (e.g., \'PHQ-9\', \'GAD-7\').']
  survey_question_text varchar [note: 'Survey question text.']
  system varchar [note: 'System (specimen type, e.g., \'Ser/Plas\' = serum or plasma).']
  time_aspect varchar [note: 'Time aspect (e.g., \'Pt\' = point in time, \'24H\' = 24 hour).']
  updated_timestamp timestamp [note: 'Record last update timestamp.']
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutation to ensure change']
  vibe_mutation_marker varchar
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']

  Note: 'Logical Observation Identifiers Names and Codes (LOINC) master for laboratory tests, clinical observations, and vital signs.'
}

Table reference.ndc_drug {
  ndc_drug_id varchar [pk, note: 'Surrogate primary key for NDC drug record.']
  code_set_version_id varchar [note: 'FK to code_set_version for NDC release.']
  active_ingredient varchar [note: 'Active ingredient(s).']
  application_number varchar [note: 'FDA application number (NDA, ANDA, BLA).']
  atc_code varchar [note: 'WHO Anatomical Therapeutic Chemical (ATC) code.']
  biosimilar_flag boolean [note: 'True if the drug is a biosimilar.']
  black_box_warning_flag boolean [note: 'True if the drug has a black box warning.']
  dea_schedule varchar [note: 'DEA schedule (I, II, III, IV, V).']
  dosage_form varchar [note: 'Dosage form (e.g., \'Tablet\', \'Injection\', \'Capsule\').']
  effective_date date [note: 'Date the NDC became valid.']
  expiration_date date [note: 'Date the NDC was retired.']
  fhir_medication_code varchar [note: 'FHIR Medication resource code.']
  formulary_status varchar [note: 'Formulary, Non-Formulary, Restricted.']
  gpi_code varchar [note: 'Generic Product Identifier (GPI) code.']
  high_alert_medication_flag boolean [note: 'True if the drug is a high-alert medication (ISMP list).']
  labeler_name varchar [note: 'Labeler (manufacturer) name.']
  marketing_category varchar [note: 'NDA, ANDA, BLA, OTC Monograph, Unapproved Drug.']
  marketing_end_date date [note: 'Date marketing ended.']
  marketing_start_date date [note: 'Date marketing started.']
  ndc_code varchar [note: '11-digit NDC code (5-4-2 or 5-3-2 format).']
  nonproprietary_name varchar [note: 'Generic (nonproprietary) name.']
  orange_book_code varchar [note: 'FDA Orange Book therapeutic equivalence code.']
  over_the_counter_flag boolean [note: 'True if the drug is available over-the-counter.']
  package_description varchar [note: 'Package description (e.g., \'100 tablets in 1 bottle\').']
  package_quantity decimal(18,4) [note: 'Package quantity.']
  package_unit varchar [note: 'Package unit (e.g., \'tablet\', \'ml\').']
  pregnancy_category varchar [note: 'FDA pregnancy category (A, B, C, D, X).']
  product_name varchar [note: 'Product name.']
  proprietary_name varchar [note: 'Brand (proprietary) name.']
  record_created_timestamp timestamp [note: 'Record creation timestamp.']
  record_updated_timestamp timestamp [note: 'Record last update timestamp.']
  refrigeration_required_flag boolean [note: 'True if the drug requires refrigeration.']
  route_of_administration varchar [note: 'Route of administration (e.g., \'Oral\', \'Intravenous\').']
  rxcui varchar [note: 'RxNorm Concept Unique Identifier (RxCUI).']
  rxnorm_name varchar [note: 'RxNorm name.']
  rxnorm_source_vocabulary varchar [note: 'RxNorm source vocabulary (e.g., \'RXNORM\', \'VANDF\').']
  rxnorm_suppress_flag boolean [note: 'True if the RxNorm concept is suppressed.']
  rxnorm_term_type varchar [note: 'RxNorm term type (e.g., \'SCD\', \'SBD\', \'GPCK\').']
  snomed_ct_code varchar [note: 'SNOMED CT code mapped to this NDC.']
  strength varchar [note: 'Strength (e.g., \'500\', \'10\').']
  strength_unit varchar [note: 'Strength unit (e.g., \'mg\', \'mcg\').']
  therapeutic_class varchar [note: 'Therapeutic class (e.g., \'Antihypertensive\', \'Antibiotic\').']
  unii_code varchar [note: 'FDA Unique Ingredient Identifier (UNII).']
  vaccine_flag boolean [note: 'True if the drug is a vaccine.']
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutation to ensure change']
  vibe_mutation_marker varchar
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']

  Note: 'National Drug Code (NDC) master with RxNorm mappings, DEA schedules, formulary status, and package information.'
}

Table reference.fhir_value_set {
  fhir_value_set_id varchar [pk, note: 'Surrogate primary key for FHIR value set record.']
  code_set_version_id varchar [note: 'FK to code_set_version for FHIR release.']
  approval_date date [note: 'Date the value set was approved.']
  binding_strength varchar [note: 'Required, Extensible, Preferred, Example.']
  canonical_url varchar [note: 'Canonical URL (e.g., \'http://hl7.org/fhir/ValueSet/observation-status\').']
  compose_exclude_count varchar [note: 'Number of exclude filters in the compose element.']
  compose_include_count varchar [note: 'Number of include filters in the compose element.']
  contact_json varchar [note: 'JSON array of contact information.']
  copyright varchar [note: 'Copyright notice.']
  created_timestamp timestamp [note: 'Record creation timestamp.']
  effective_end_date date [note: 'Date the value set became inactive.']
  effective_start_date date [note: 'Date the value set became active.']
  expansion_identifier varchar [note: 'Expansion identifier (UUID).']
  expansion_offset varchar [note: 'Expansion offset (for paging).']
  expansion_parameter_json varchar [note: 'JSON array of expansion parameters.']
  expansion_timestamp timestamp [note: 'Timestamp of the expansion.']
  expansion_total_concepts varchar [note: 'Total number of concepts in the expansion.']
  experimental_flag boolean [note: 'True if the value set is experimental.']
  fhir_element_path varchar [note: 'FHIR element path where the value set is used (e.g., \'Observation.status\').']
  fhir_resource_type varchar [note: 'FHIR resource type (e.g., \'Observation\', \'Condition\').']
  fhir_value_set_description varchar [note: 'Description of the value set.']
  immutable_flag boolean [note: 'True if the value set is immutable.']
  jurisdiction_codes varchar [note: 'Comma-separated jurisdiction codes (e.g., \'US\', \'CA\').']
  last_review_date date [note: 'Date the value set was last reviewed.']
  modified_timestamp timestamp [note: 'Record last update timestamp.']
  publisher varchar [note: 'Publisher (e.g., \'HL7 International\', \'CMS\').']
  purpose varchar [note: 'Purpose of the value set.']
  title varchar [note: 'Title of the value set.']
  use_context_json varchar [note: 'JSON array of use context.']
  value_set_name varchar [note: 'Name of the value set.']
  value_set_oid varchar [note: 'OID of the value set (e.g., \'2.16.840.1.113883.4.642.3.401\').']
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutation to ensure change']
  vibe_mutation_marker varchar
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']

  Note: 'FHIR ValueSet resource master with expansion parameters, binding strength, and canonical URLs for interoperability.'
}

Table reference.npi_registry {
  npi_registry_id varchar [pk, note: 'Surrogate primary key for NPI registry record.']
  practice_location_geographic_region_id varchar [note: 'FK to geographic_region for practice location.']
  authorized_official_first_name varchar [note: 'Authorized official first name (for organizations).']
  authorized_official_last_name varchar [note: 'Authorized official last name (for organizations).']
  authorized_official_middle_name varchar [note: 'Authorized official middle name.']
  authorized_official_telephone_number varchar [note: 'Authorized official telephone number.']
  authorized_official_title varchar [note: 'Authorized official title (e.g., \'CEO\', \'CFO\').']
