Table inventory.waste_log {
  waste_log_id varchar [pk, note: 'Primary key.']
  campaign_id varchar [note: 'FK to marketing campaign.']
  facility_id varchar [note: 'FK to facility.']
  franchisee_id varchar [note: 'FK to franchisee.']
  menu_item_id varchar [note: 'FK to menu item.']
  primary_waste_recorded_by_employee_id varchar [note: 'FK to employee who recorded waste.']
  recipe_id varchar [note: 'FK to recipe.']
  shift_id varchar [note: 'FK to shift.']
  stock_item_id varchar [note: 'FK to stock item.']
  stock_location_id varchar [note: 'FK to stock location.']
  waste_gl_account_id varchar [note: 'FK to GL account for waste.']
  waste_procurement_supplier_id varchar [note: 'FK to procurement supplier.']
  waste_restaurant_unit_id varchar [note: 'FK to restaurant unit.']
  waste_unit_id varchar [note: 'FK to restaurant unit.']
  waste_vendor_procurement_supplier_id varchar [note: 'FK to vendor supplier.']
  approval_timestamp timestamp [note: 'Timestamp of manager approval.']
  batch_number varchar [note: 'Batch number of wasted item.']
  corrective_action_taken varchar [note: 'Corrective action taken.']
  daypart varchar [note: 'Daypart when waste occurred.']
  disposal_method varchar [note: 'Method of disposal.']
  expiration_date decimal(9,4) [note: 'Expiration date of wasted item.']
  haccp_violation boolean [note: 'Whether waste was due to HACCP violation.']
  manager_approved boolean [note: 'Whether manager approved the waste.']
  notes varchar [note: 'Free-text notes.']
  on_hand_quantity_before_waste decimal(12,4) [note: 'Quantity on hand before waste event.']
  par_level_at_waste decimal(12,4) [note: 'Par level at time of waste.']
  record_created_timestamp timestamp [note: 'Record creation timestamp.']
  record_updated_timestamp timestamp [note: 'Record update timestamp.']
  responsible_station varchar [note: 'Kitchen station responsible.']
  temperature_at_waste decimal(5,2) [note: 'Temperature at time of waste.']
  unit_of_measure varchar [note: 'Unit of measure.']
  waste_category varchar [note: 'Category of waste.']
  waste_cost decimal(18,2) [note: 'Cost of wasted items.']
  waste_date date [note: 'Date of waste event.']
  waste_prevention_opportunity varchar [note: 'Identified prevention opportunity.']
  waste_quantity decimal(12,4) [note: 'Quantity wasted.']
