  last_audit_date date [note: 'Date of last supplier audit']
  measurement_period_end date [note: 'End of measurement period']
  measurement_period_start date [note: 'Start of measurement period']
  notes varchar [note: 'Performance notes']
  on_time_delivery_rate decimal(5,2) [note: 'Percentage of on-time deliveries']
  order_accuracy_rate decimal(5,2) [note: 'Percentage of accurate orders']
  quality_rejection_rate decimal(5,2) [note: 'Percentage of items rejected for quality']
