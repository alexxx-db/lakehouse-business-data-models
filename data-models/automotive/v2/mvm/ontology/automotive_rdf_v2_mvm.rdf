    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:batteryVoltageVolt rdf:type rdf:Property ;
    rdfs:label 'Battery Voltage Volt' ;
    rdfs:comment 'Instantaneous voltage of the vehicle\'s high-voltage battery, expressed in volts.' ;
    rdfs:domain ind:TelemetryEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:chargingStatus rdf:type rdf:Property ;
    rdfs:label 'Charging Status' ;
    rdfs:comment 'True if the vehicle is currently connected to a charger and charging, otherwise false.' ;
    rdfs:domain ind:TelemetryEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:connectivityStatus rdf:type rdf:Property ;
    rdfs:label 'Connectivity Status' ;
    rdfs:comment 'True if the telematics device had an active network connection at event time.' ;
    rdfs:domain ind:TelemetryEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:engineRpm rdf:type rdf:Property ;
    rdfs:label 'Engine Rpm' ;
    rdfs:comment 'Engine speed measured in revolutions per minute at the time of the event.' ;
    rdfs:domain ind:TelemetryEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:engineTemperatureC rdf:type rdf:Property ;
    rdfs:label 'Engine Temperature C' ;
    rdfs:comment 'Measured temperature of the engine coolant at event time, in degrees Celsius.' ;
    rdfs:domain ind:TelemetryEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:eventSequence rdf:type rdf:Property ;
    rdfs:label 'Event Sequence' ;
    rdfs:comment 'Monotonically increasing sequence number for events from the same vehicle, used for ordering.' ;
    rdfs:domain ind:TelemetryEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:eventSource rdf:type rdf:Property ;
    rdfs:label 'Event Source' ;
    rdfs:comment 'Identifier of the source system that produced the telemetry record (e.g., Geotab, Bosch).' ;
    rdfs:domain ind:TelemetryEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventTypeCode rdf:type rdf:Property ;
    rdfs:label 'Event Type Code' ;
    rdfs:comment 'Code that categorizes the type of telemetry event (e.g., speed, harsh_brake, idle).' ;
    rdfs:domain ind:TelemetryEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fuelLevelPercent rdf:type rdf:Property ;
    rdfs:label 'Fuel Level Percent' ;
    rdfs:comment 'Remaining fuel level expressed as a percentage of tank capacity.' ;
    rdfs:domain ind:TelemetryEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:gpsAccuracyM rdf:type rdf:Property ;
    rdfs:label 'Gps Accuracy M' ;
    rdfs:comment 'Estimated horizontal accuracy of the GPS position in meters.' ;
    rdfs:domain ind:TelemetryEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:headingDegrees rdf:type rdf:Property ;
    rdfs:label 'Heading Degrees' ;
    rdfs:comment 'Compass direction the vehicle is facing at event time, expressed in degrees from true north.' ;
    rdfs:domain ind:TelemetryEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ignitionState rdf:type rdf:Property ;
    rdfs:label 'Ignition State' ;
    rdfs:comment 'Indicates whether the vehicle ignition is on (true) or off (false) at the moment of the event.' ;
    rdfs:domain ind:TelemetryEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:latitudeAccuracy rdf:type rdf:Property ;
    rdfs:label 'Latitude Accuracy' ;
    rdfs:comment 'Estimated vertical accuracy of the latitude measurement.' ;
    rdfs:domain ind:TelemetryEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:locationCity rdf:type rdf:Property ;
    rdfs:label 'Location City' ;
    rdfs:comment 'City name derived from the GPS coordinates at event time.' ;
    rdfs:domain ind:TelemetryEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:locationCountry rdf:type rdf:Property ;
    rdfs:label 'Location Country' ;
    rdfs:comment 'Three-letter ISO country code derived from the GPS coordinates at event time.' ;
    rdfs:domain ind:TelemetryEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:locationState rdf:type rdf:Property ;
    rdfs:label 'Location State' ;
    rdfs:comment 'State or province name derived from the GPS coordinates at event time.' ;
    rdfs:domain ind:TelemetryEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:longitudeAccuracy rdf:type rdf:Property ;
    rdfs:label 'Longitude Accuracy' ;
    rdfs:comment 'Estimated vertical accuracy of the longitude measurement.' ;
    rdfs:domain ind:TelemetryEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:odometerKm rdf:type rdf:Property ;
    rdfs:label 'Odometer Km' ;
    rdfs:comment 'Cumulative distance traveled by the vehicle, recorded in kilometers.' ;
    rdfs:domain ind:TelemetryEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rawPayload rdf:type rdf:Property ;
    rdfs:label 'Raw Payload' ;
    rdfs:comment 'Original JSON payload received from the telematics device before any transformation.' ;
    rdfs:domain ind:TelemetryEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:signalQuality rdf:type rdf:Property ;
    rdfs:label 'Signal Quality' ;
    rdfs:comment 'Qualitative assessment of the telemetry signal (e.g., good, moderate, poor).' ;
    rdfs:domain ind:TelemetryEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:speedKph rdf:type rdf:Property ;
    rdfs:label 'Speed Kph' ;
    rdfs:comment 'Instantaneous vehicle speed at event time, measured in kilometers per hour.' ;
    rdfs:domain ind:TelemetryEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tirePressureFrontLeftPsi rdf:type rdf:Property ;
    rdfs:label 'Tire Pressure Front Left Psi' ;
    rdfs:comment 'Air pressure of the front-left tire measured in pounds per square inch.' ;
