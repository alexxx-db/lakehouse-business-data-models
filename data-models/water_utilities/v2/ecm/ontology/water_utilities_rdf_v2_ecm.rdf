    rdfs:comment 'Date deposit was refunded' ;
    rdfs:domain ind:Deposit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:refundEligibilityDate rdf:type rdf:Property ;
    rdfs:label 'Refund Eligibility Date' ;
    rdfs:comment 'Date deposit becomes eligible for refund' ;
    rdfs:domain ind:Deposit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:refundEligibleDate rdf:type rdf:Property ;
    rdfs:label 'Refund Eligible Date' ;
    rdfs:comment 'Date deposit becomes eligible for refund' ;
    rdfs:domain ind:Deposit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:refundMethod rdf:type rdf:Property ;
