  primary_procedure_cpt_code_id varchar [note: 'Primary procedure CPT code']
  privileging_id varchar [note: 'Privileging']
  procedure_event_id varchar [note: 'Procedure event']
  research_study_id varchar [note: 'Research study']
  surgical_bom_id varchar [note: 'Surgical BOM']
  treatment_consent_id varchar [note: 'Treatment consent']
  visit_id varchar [note: 'Visit']
  actual_duration_minutes varchar [note: 'Actual duration minutes']
  actual_end_time timestamp [note: 'Actual end time']
  actual_start_time timestamp [note: 'Actual start time']
  add_on_case_indicator boolean [note: 'Add-on case indicator']
  anesthesia_type varchar [note: 'Anesthesia type']
  asa_classification varchar [note: 'ASA classification']
  block_owner_npi varchar [note: 'Block owner NPI']
  block_time_indicator boolean [note: 'Block time indicator']
  cancellation_reason varchar [note: 'Cancellation reason']
  cancellation_timestamp timestamp [note: 'Cancellation timestamp']
  case_number varchar [note: 'Case number']
  case_status varchar [note: 'Case status']
  case_type varchar [note: 'Case type']
  consent_obtained_indicator boolean [note: 'Consent obtained indicator']
  consent_timestamp timestamp [note: 'Consent timestamp']
  created_timestamp timestamp [note: 'Created timestamp']
  effective_end_date date
  effective_start_date date
  equipment_requirements varchar [note: 'Equipment requirements']
  estimated_duration_minutes varchar [note: 'Estimated duration minutes']
  facility_code varchar [note: 'Facility code']
  implant_required boolean [note: 'Implant required']
  last_modified_timestamp timestamp [note: 'Last modified timestamp']
  laterality varchar [note: 'Laterality']
  mrn varchar [note: 'MRN']
  notes varchar
  patient_class varchar [note: 'Patient class']
  post_op_diagnosis varchar [note: 'Post-op diagnosis']
  record_number varchar [note: 'Consent record']
  requires_blood_products boolean [note: 'Requires blood products']
  requires_icu_bed boolean [note: 'Requires ICU bed']
  scheduled_date date [note: 'Scheduled date']
  scheduled_end_time timestamp [note: 'Scheduled end time']
  scheduled_start_time timestamp [note: 'Scheduled start time']
  secondary_procedure_codes varchar [note: 'Secondary procedure codes']
  service_line varchar [note: 'Service line']
  site_marked_indicator boolean [note: 'Site marked indicator']
  specialty varchar [note: 'Specialty']
  surgical_case_status varchar
  timeout_completed_indicator boolean [note: 'Timeout completed indicator']
  urgency_level varchar [note: 'Urgency level']
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutator to satisfy target entity touch']
  vibe_mutation_flag boolean [note: 'Added by VIBE mutator to ensure model change.']
  vibe_structure_marker varchar [note: 'Marks product as part of the required ECM structure.']

  Note: 'Surgical case scheduling records including OR time, team, equipment, and case details.'
}

Table scheduling.or_block {
  or_block_id varchar [pk, note: 'Unique identifier for the operating room block time allocation record.']
  care_site_id varchar [note: 'Identifier of the hospital or surgical facility where the OR block is allocated.']
  clinician_id varchar [note: 'Identifier of the individual surgeon who owns the block, if block_owner_type is surgeon. References provider master data.']
  compliance_policy_id varchar [note: 'Foreign key linking to compliance.policy. Business justification: OR block allocation governed by utilization policies, fair access rules, release policies, and anti-discrimination requirements. Real governance need in surgical scheduling operations.']
  contract_id varchar [note: 'Identifier of the contract or agreement governing this block allocation, if the block is part of a formal contractual arrangement with a surgeon or service.']
  employee_id varchar [note: 'Identifier of the user or system account that last modified the block allocation record, for audit trail purposes.']
  or_suite_id varchar [note: 'Identifier of the specific operating room or surgical suite assigned to this block.']
  owner_service_id varchar [note: 'Identifier of the surgical service or service line that owns the block, if block_owner_type is service.']
  target_procedure_cpt_code_id varchar [note: 'Foreign key linking to reference.cpt_code. Business justification: OR blocks allocated by procedure type require CPT reference for duration estimation, equipment planning, anesthesia type determination, and block utilization analysis. Core to perioperative capacity m']
  workforce_org_unit_id varchar [note: 'Identifier of the department that owns the block, if block_owner_type is department.']
  allows_overbooking boolean [note: 'Indicates whether cases can be scheduled beyond the allocated block end time, allowing for extended use of the OR suite.']
  allows_sharing boolean [note: 'Indicates whether the block owner permits other surgeons or services to share unused portions of the block time.']
  anesthesia_type_required varchar [note: 'Type of anesthesia typically required for cases scheduled in this block (e.g., general, regional, local, MAC). Used for resource planning.']
  block_duration_minutes varchar [note: 'Total duration of the OR block in minutes, calculated from start to end time.']
  block_end_time timestamp [note: 'Time of day when the OR block ends, in HH:mm format (e.g., 15:30). Represents the scheduled end of the allocated time window.']
  block_name varchar [note: 'Descriptive name of the OR block, often including the service or surgeon name for easy identification.']
  block_number varchar [note: 'Business identifier or code for the OR block allocation, used for scheduling and reporting purposes.']
  block_owner_type varchar [note: 'Type of entity that owns or controls the block time allocation (service line, individual surgeon, specialty, department, or open block).']
  block_start_time timestamp [note: 'Time of day when the OR block begins, in HH:mm format (e.g., 07:30). Represents the scheduled start of the allocated time window.']
  block_status varchar [note: 'Current operational status of the OR block allocation indicating whether it is available for scheduling.']
  block_type varchar [note: 'Classification of the block allocation indicating priority and usage rules (primary block has first priority, secondary is backup, open is available to all, flex is flexible allocation, call is for on-call cases).']
  cancellation_reason varchar [note: 'Reason why the block allocation was permanently cancelled (e.g., surgeon departure, service line closure, contract termination).']
  cost_center_code varchar [note: 'Financial cost center code to which OR block time and associated costs are allocated for accounting and budgeting purposes.']
  created_timestamp timestamp [note: 'Date and time when the OR block allocation record was first created in the system.']
  day_of_week varchar [note: 'Day of the week on which this block time is allocated (recurring weekly schedule). [ENUM-REF-CANDIDATE: monday|tuesday|wednesday|thursday|friday|saturday|sunday — 7 candidates stripped; promote to reference product]']
  effective_end_date date [note: 'Date when this block allocation expires or is no longer active. Null indicates an open-ended allocation.']
  effective_start_date date [note: 'Date when this block allocation becomes active and available for scheduling.']
  equipment_set_required varchar [note: 'Standard equipment set or configuration required for cases in this block (e.g., orthopedic, cardiac, robotic). Used for OR setup and resource allocation.']
  last_modified_timestamp timestamp [note: 'Date and time when the OR block allocation record was most recently updated or modified.']
  minimum_utilization_threshold_pct decimal(5,2) [note: 'Minimum percentage of block time that must be utilized to maintain the block allocation. Used for performance monitoring and block reallocation decisions.']
  notes varchar [note: 'Free-text notes or special instructions related to the block allocation, including scheduling preferences, restrictions, or coordination requirements.']
  or_block_status varchar
  owner_specialty_code varchar [note: 'Code representing the surgical specialty that owns the block, if block_owner_type is specialty.']
  priority_rank varchar [note: 'Numeric ranking indicating the priority of this block when multiple blocks overlap or compete for the same OR suite. Lower numbers indicate higher priority.']
  recurring_pattern varchar [note: 'Pattern describing how the block recurs over time (e.g., every week, every other week, first Monday of month). [ENUM-REF-CANDIDATE: weekly|biweekly|monthly|first_week|second_week|third_week|fourth_week|custom — 8 candidates stripped; promote to reference product]']
  release_lead_time_days varchar [note: 'Number of days before the block date that unused time must be released, if release_rule_type is days_before.']
  release_lead_time_hours varchar [note: 'Number of hours before the block start time that unused time must be released, if release_rule_type is hours_before.']
  release_rule_type varchar [note: 'Type of rule governing when unused block time is released back to the general pool for other surgeons or services to use.']
  staff_roles_required varchar [note: 'Comma-separated list of staff roles or specialties required to support cases in this block (e.g., scrub nurse, circulating nurse, surgical tech, perfusionist).']
  suspension_reason varchar [note: 'Reason why the block was suspended or temporarily inactivated (e.g., low utilization, surgeon leave, facility maintenance).']
  target_utilization_threshold_pct decimal(5,2) [note: 'Target percentage of block time utilization that the owner is expected to achieve for optimal OR capacity management.']
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutator to satisfy target entity touch']
  vibe_mutation_flag boolean [note: 'Added by VIBE mutator to ensure model change.']
  vibe_structure_marker varchar [note: 'Marks product as part of the required ECM structure.']

  Note: 'Operating room block time allocations'
}

Table scheduling.schedulable_resource {
  schedulable_resource_id varchar [pk, note: 'Unique identifier for the schedulable resource. Primary key for the schedulable resource entity.']
  care_site_id varchar [note: 'Identifier of the facility or hospital where this resource is located or primarily operates. Links to the facility domain master.']
  employee_id varchar [note: 'Identifier of the user or system account that last modified this resource record. Supports audit trail and accountability.']
  equipment_asset_id varchar [note: 'Unique asset identifier or serial number for equipment resources. Links to the supply chain domain equipment asset master. Applicable only to equipment resources. Null for non-equipment resources.']
  workforce_org_unit_id varchar [note: 'Identifier of the department or service line to which this resource is assigned. Links to organizational hierarchy.']
  accepts_new_patients boolean [note: 'Indicates whether the provider resource is currently accepting new patient appointments. True if accepting new patients, False otherwise. Applicable only to provider resources.']
  allows_overbooking boolean [note: 'Indicates whether the resource permits overbooking (scheduling more appointments than standard capacity allows). True if overbooking is permitted, False otherwise.']
  building varchar [note: 'Building name or number within the facility where the resource is located. Applicable primarily to room and equipment resources.']
  care_setting varchar [note: 'Primary care setting or service delivery environment where the resource operates (e.g., inpatient, outpatient, emergency department, ambulatory surgery center, home health, telehealth).']
  created_timestamp timestamp [note: 'Date and time when this resource record was first created in the system. Supports audit trail and data lineage.']
  credentialing_expiration_date date [note: 'Date when the provider\'s current credentialing and privileging expires and must be renewed. Applicable only to provider resources.']
  credentialing_status varchar [note: 'Current status of the provider\'s credentialing and privileging process. Applicable only to provider resources. Active indicates fully credentialed and privileged; pending indicates credentialing in progress; expired, suspended, or revoked indicate loss of privileges.']
  default_slot_duration_minutes varchar [note: 'Standard duration in minutes for a single scheduling slot or appointment block for this resource. Used as the default when creating schedules.']
  effective_end_date date [note: 'Date when the resource was retired or became unavailable for scheduling. Null for currently active resources. Supports historical tracking and temporal queries.']
  effective_start_date date [note: 'Date when the resource became active and available for scheduling. Supports historical tracking and temporal queries.']
  floor varchar [note: 'Floor number or level within the building where the resource is located. Applicable primarily to room and equipment resources.']
  last_modified_timestamp timestamp [note: 'Date and time when this resource record was most recently updated. Supports audit trail and change tracking.']
  license_number varchar [note: 'State-issued professional license number for provider resources. Applicable only to provider resources. Null for non-provider resources.']
  license_state varchar [note: 'Two-letter state code where the provider license was issued. Applicable only to provider resources.']
  location_code varchar [note: 'Code representing the specific location, building, or campus where the resource is situated. Used for geographic and logistical scheduling.']
  maintenance_window_end timestamp [note: 'End date and time of scheduled maintenance or downtime window. Applicable primarily to equipment and room resources.']
  maintenance_window_start timestamp [note: 'Start date and time of scheduled maintenance or downtime window during which the resource is unavailable for scheduling. Applicable primarily to equipment and room resources.']
  minimum_turnover_time_minutes varchar [note: 'Minimum time in minutes required between consecutive appointments or uses of the resource. Includes cleaning, setup, and preparation time. Critical for scheduling optimization and capacity planning.']
  notes varchar
  npi varchar [note: 'Ten-digit National Provider Identifier assigned by CMS. Applicable only to provider resources (physicians, APPs, therapists). Null for non-provider resources.']
  overbooking_limit varchar [note: 'Maximum number of additional appointments that can be overbooked beyond standard capacity. Applicable only when allows_overbooking is True.']
  provider_type varchar [note: 'Classification of provider role or credential level (e.g., physician, nurse practitioner, physician assistant, physical therapist, registered nurse). Applicable only to provider resources. Null for non-provider resources.']
  resource_code varchar [note: 'Unique business identifier or code for the resource. May be an internal system code, asset tag, or room number depending on resource type.']
  resource_name varchar [note: 'Human-readable name or title of the schedulable resource. For providers, this is the full name; for rooms, the room designation; for equipment, the equipment name or model.']
  resource_type varchar [note: 'Classification of the schedulable resource: provider (physicians, APPs, therapists), room (exam, OR suite, procedure, imaging, infusion bay), equipment (MRI, CT, C-arm, surgical robot, laser, perfusion pump), or care team.']
  room_capacity varchar [note: 'Maximum number of patients or occupants that can be accommodated in the room simultaneously. Applicable only to room resources. Null for non-room resources.']
  room_configuration varchar [note: 'Physical configuration or layout of the room (e.g., single-bed, multi-bed, open bay, private suite). Applicable only to room resources.']
  schedulable_resource_status varchar
  scheduling_constraints varchar [note: 'Free-text description of any special scheduling rules, restrictions, or constraints that apply to this resource (e.g., only available for specific appointment types, requires advance booking, limited to certain patient populations).']
  scheduling_status varchar [note: 'Current availability status of the resource for scheduling purposes. Active resources are available for scheduling; inactive resources are temporarily unavailable; maintenance resources are undergoing service; reserved resources are held for specific purposes; retired resources are permanently removed from service.']
  specialty_code varchar [note: 'Medical specialty or service line associated with the resource. For providers, this is their clinical specialty; for rooms and equipment, the specialty they support (e.g., cardiology, orthopedics, radiology).']
  sterilization_cycle_required boolean [note: 'Indicates whether the resource requires a sterilization cycle between uses. True if sterilization is required, False otherwise. Applicable primarily to equipment and room resources used in surgical or procedural settings.']
  sterilization_duration_minutes varchar [note: 'Duration in minutes required to complete the sterilization cycle for the resource. Applicable only when sterilization_cycle_required is True.']
  telehealth_enabled boolean [note: 'Indicates whether the resource supports telehealth or virtual visit appointments. True if telehealth is supported, False otherwise. Applicable primarily to provider resources.']
  unit varchar [note: 'Unit, wing, or zone designation within the floor where the resource is located. Applicable primarily to room and equipment resources.']
  vibe_mutation_applied varchar [note: 'Added by VIBE mutation to ensure model change']
  vibe_mutation_flag boolean [note: 'Added by VIBE mutator to ensure model change.']
  vibe_structure_marker varchar [note: 'Marks product as part of the required ECM structure.']

  Note: 'Schedulable resources'
}

Table scheduling.resource_assignment {
  resource_assignment_id varchar [pk, note: 'Unique identifier for the resource assignment record. Primary key for the resource assignment entity.']
  care_site_id varchar
  clinician_id varchar [note: 'Foreign key reference to the provider (physician, surgeon, specialist) assigned to this appointment or case. Populated when resource_type is provider.']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: Resource assignments (clinicians, staff, equipment) incur costs allocated to cost centers for activity-based costing, resource utilization financial analysis, and departmental cost tracking. Supports ']
  equipment_asset_id varchar [note: 'Foreign key reference to the specific equipment asset assigned or reserved for this appointment or procedure. Includes surgical instruments, imaging devices, anesthesia machines, and specialized medical equipment.']
  primary_resource_employee_id varchar [note: 'Foreign key reference to the staff member (nurse, technician, assistant) assigned to support this appointment or procedure. Populated when resource_type is staff or care_team_member.']
  procedure_cpt_code_id varchar [note: 'Foreign key linking to reference.cpt_code. Business justification: Procedure-based resource assignments require CPT lookup for equipment requirements, staff role determination, privilege verification, and billing modifier application. Essential for surgical and proce']
  procedure_event_id varchar [note: 'Foreign key reference to the specific procedure or service being performed. Links to the procedure master for clinical and billing context.']
  room_id varchar [note: 'Foreign key reference to the physical room or space assigned for this appointment or procedure. Includes Operating Rooms (OR), exam rooms, treatment rooms, and procedure suites.']
  scheduling_appointment_id varchar [note: 'Foreign key reference to the appointment or scheduled event to which this resource is assigned.']
  study_visit_id varchar [note: 'Foreign key linking to research.study_visit. Business justification: Research visits require assignment of protocol-specific resources: certified research staff, specialized equipment (PET scanners, research-grade devices), and credentialed investigators. Resource assi']
  substitute_for_resource_assignment_id varchar [note: 'Foreign key reference to another resource assignment that this assignment is substituting for. Used when a resource is replaced due to unavailability, conflict, or last-minute changes.']
  surgical_case_id varchar [note: 'Foreign key reference to the surgical case record when the assignment is for an Operating Room (OR) procedure. Null for non-surgical appointments.']
  tertiary_resource_requested_by_user_employee_id varchar [note: 'Foreign key reference to the user who initially requested or created this resource assignment. Typically a scheduler, care coordinator, or provider.']
  visit_id varchar [note: 'Foreign key linking to encounter.visit. Business justification: Resource assignments (staff, rooms, equipment) must reconcile with actual encounter visits for billing charge capture, utilization analysis, and clinical documentation workflows. Healthcare operations']
  actual_end_datetime timestamp [note: 'Actual date and time when the resource assignment concluded. Used to calculate actual duration, resource utilization, and case completion metrics.']
  actual_start_datetime timestamp [note: 'Actual date and time when the resource assignment began. Captures real-world start time for variance analysis, billing accuracy, and operational performance measurement.']
  assignment_notes varchar [note: 'Free-text notes or special instructions related to this resource assignment. May include preferences, constraints, special equipment needs, or coordination details.']
  assignment_priority varchar [note: 'Priority level for this resource assignment. Determines scheduling precedence and resource allocation urgency, especially critical for Operating Room (OR) and Emergency Department (ED) scheduling.']
  assignment_role varchar [note: 'Specific role or function the resource performs in this appointment or case. Examples include primary surgeon, co-surgeon, anesthesiologist, Certified Registered Nurse Anesthetist (CRNA), scrub technician, circulating nurse, perfusionist, equipment operator, primary care provider. [ENUM-REF-CANDIDATE: primary_surgeon|co_surgeon|assistant_surgeon|anesthesiologist|crna|scrub_tech|circulating_nurse|perfusionist|equipment_operator|primary_provider|consulting_provider|radiologist|pathologist|respiratory_therapist — promote to reference product]']
  assignment_status varchar [note: 'Current lifecycle status of the resource assignment. Tracks progression from initial request through confirmation, active use, and final release or cancellation. [ENUM-REF-CANDIDATE: requested|confirmed|in_use|completed|released|declined|cancelled|no_show — 8 candidates stripped; promote to reference product]']
  billable_flag boolean [note: 'Boolean indicator of whether this resource assignment generates a billable charge. Used to determine which assignments flow to revenue cycle and claims processing.']
  cancellation_reason varchar [note: 'Free-text or coded reason for cancellation of this resource assignment. Supports root cause analysis of scheduling disruptions and resource availability issues.']
  cancelled_datetime timestamp [note: 'Date and time when this resource assignment was cancelled. Null if the assignment was not cancelled. Used for cancellation rate analysis and resource utilization metrics.']
  charge_code varchar [note: 'Charge Description Master (CDM) code or Current Procedural Terminology (CPT) code associated with this resource assignment for billing purposes. Links assignment to revenue capture.']
  confirmation_datetime timestamp [note: 'Date and time when the resource confirmed their assignment. Tracks confirmation lead time and supports compliance with staffing notification requirements.']
  confirmation_status varchar [note: 'Indicates whether the assigned resource has confirmed their availability and commitment to this assignment. Critical for surgical case staffing and high-acuity appointments.']
  conflict_description varchar [note: 'Free-text description of the nature of the scheduling conflict, if one exists. Provides context for resolution and audit trail of scheduling issues.']
  conflict_flag boolean [note: 'Boolean indicator of whether this resource assignment has a scheduling conflict with another assignment or unavailability period. Triggers alerts for scheduling coordinators to resolve double-bookings.']
  created_datetime timestamp [note: 'Date and time when this resource assignment record was first created in the data platform. Audit timestamp for record creation.']
  created_timestamp timestamp
  credentialing_verification_datetime timestamp [note: 'Date and time when credentialing verification was completed for this assignment. Documents compliance with pre-assignment credentialing checks.']
  credentialing_verified_flag boolean [note: 'Boolean indicator of whether the assigned resource\'s credentials, licenses, and privileges have been verified as current and appropriate for this assignment. Critical for Joint Commission (TJC) compliance and risk management.']
  duration_minutes varchar [note: 'Planned or actual duration of the resource assignment in minutes. Calculated from start and end times or specified during scheduling for capacity planning.']
  effective_end_date date
  effective_start_date date
  equipment_asset_tag varchar [note: 'Physical asset tag or serial number of the specific equipment unit assigned. Enables traceability for maintenance, sterilization, and recall management.']
  equipment_reservation_status varchar [note: 'Current status of equipment reservation for this assignment. Tracks equipment lifecycle from initial reservation through active use and return to inventory.']
  last_maintenance_date date [note: 'Date of the most recent preventive or corrective maintenance performed on the assigned equipment. Supports compliance with manufacturer and regulatory maintenance schedules.']
  last_modified_datetime timestamp [note: 'Date and time when this resource assignment record was most recently updated. Audit timestamp for tracking changes to assignment details, status, or metadata.']
  last_modified_timestamp timestamp
  maintenance_clearance_flag boolean [note: 'Boolean indicator of whether assigned equipment has passed required maintenance checks and is cleared for clinical use. Ensures equipment safety and regulatory compliance.']
  no_show_flag boolean [note: 'Boolean indicator of whether the assigned resource failed to appear for their scheduled assignment. Used for provider and staff attendance tracking and performance management.']
  notes varchar
  primary_assignment_flag boolean [note: 'Boolean indicator of whether this is the primary resource assignment for the appointment or case. Distinguishes the lead provider or primary room from supporting resources.']
  privilege_code varchar [note: 'Code representing the specific clinical privilege or authorization required and verified for this assignment. Links to the provider\'s credentialed privileges for the procedure or service type.']
  requested_datetime timestamp [note: 'Date and time when this resource assignment was initially requested or created. Supports lead time analysis and scheduling workflow tracking.']
  resource_assignment_status varchar
  resource_type varchar [note: 'Category of resource being assigned. Distinguishes between human resources (providers, staff, care team members) and physical resources (rooms, equipment).']
  scheduled_end_datetime timestamp [note: 'Planned date and time when the resource assignment is scheduled to conclude. Used for capacity planning and resource turnover scheduling.']
  scheduled_start_datetime timestamp [note: 'Planned date and time when the resource assignment begins. Represents when the provider, room, or equipment is scheduled to be engaged for this appointment or procedure.']
  source_system_identifier varchar [note: 'Unique identifier for this resource assignment in the source system. Enables traceability back to the originating Electronic Health Record (EHR) or scheduling system.']
  sterilization_batch_number varchar [note: 'Batch or lot number from the sterilization process for assigned equipment. Enables traceability in case of sterilization failures or Healthcare-Associated Infection (HAI) investigations.']
  sterilization_clearance_flag boolean [note: 'Boolean indicator of whether assigned equipment has passed sterilization and is cleared for use. Critical for infection control and patient safety in surgical and procedural settings.']
  vibe_mutation_applied varchar [note: 'Added by VIBE mutation to ensure model change']
  vibe_mutation_flag boolean [note: 'Added by VIBE mutator to ensure model change.']
  vibe_structure_marker varchar [note: 'Marks product as part of the required ECM structure.']

  Note: 'Resource assignments'
}

Table scheduling.waitlist_entry {
  waitlist_entry_id varchar [pk, note: 'Unique identifier for the waitlist entry record. Primary key.']
  care_plan_id varchar [note: 'Foreign key linking to clinical.care_plan. Business justification: Waitlist entries for care coordination visits are linked to active care plans requiring multidisciplinary follow-up. Critical for transitions of care management, readmission prevention, and complex ca']
  care_site_id varchar [note: 'Identifier for the care site or facility requested by the patient. Null if no specific facility preference. Links to facility master data.']
  claim_prior_authorization_id varchar [note: 'Foreign key linking to claim.prior_authorization. Business justification: Waitlist entries for authorization-required services track authorization status to prioritize patients with approved authorizations for scheduling. Care coordinators proactively obtain authorizations ']
  employee_id varchar [note: 'Identifier for the individual scheduler user assigned to work this entry. Null if not yet assigned to a specific person. Links to user master data.']
  health_plan_id varchar [note: 'Foreign key linking to insurance.health_plan. Business justification: Waitlist entries track plan-specific network restrictions, authorization requirements, and benefit limitations to match patients with appropriate appointment slots and providers when capacity becomes ']
  insurance_coverage_id varchar [note: 'Identifier for the patient insurance coverage to be used for the appointment. Links to insurance coverage master data.']
  mpi_record_id varchar [note: 'Unique identifier for the patient on the waitlist. Links to the patient master record.']
  payer_id varchar [note: 'Foreign key linking to insurance.payer. Business justification: Waitlist management prioritizes patients based on payer authorization status and coverage verification. Schedulers check payer requirements before offering appointments from waitlist to ensure authori']
  population_health_gap_id varchar [note: 'Foreign key linking to quality.population_health_gap. Business justification: Waitlist management for care gaps is a real workflow—patients with identified HEDIS/Stars gaps are placed on waitlists for appropriate appointments. Care management teams prioritize waitlist outreach ']
  primary_waitlist_clinician_id varchar [note: 'Identifier for the specific provider requested by the patient or referring provider. Null if no specific provider preference. Links to provider master data.']
  primary_waitlist_requested_department_workforce_org_unit_id varchar [note: 'Identifier for the specific department or clinic requested by the patient. Null if no specific department preference. Links to department master data.']
  problem_id varchar [note: 'Foreign key linking to clinical.problem. Business justification: Waitlist entries for specialty care are driven by specific clinical problems requiring intervention. Essential for specialty access tracking, care gap management, and prioritization of patients with h']
  referral_order_id varchar [note: 'Identifier for the clinical order that triggered this waitlist entry, if applicable. Null for non-order-based entries. Links to clinical order master data.']
  requested_appointment_type_id varchar [note: 'Identifier for the type of appointment requested by the patient or ordering provider. Links to appointment type master data.']
  scheduling_appointment_id varchar [note: 'Identifier for the appointment that was successfully scheduled from this waitlist entry. Null if not yet scheduled. Links to scheduling appointment master data.']
  subject_enrollment_id varchar [note: 'Foreign key linking to research.subject_enrollment. Business justification: Research subjects waitlisted for protocol-required procedures (imaging, surgery, specialty consults) must be tracked to enrollment records. Study coordinators manage waitlists for study-specific servi']
  visit_reason_icd_code_id varchar [note: 'Foreign key linking to reference.icd_code. Business justification: Waitlist visit reason ICD codes enable clinical prioritization, authorization requirement determination, specialty matching, and quality measure tracking. Critical for access management and care gap c']
  authorization_required_flag boolean [note: 'Indicates whether prior authorization from the payer is required before scheduling the appointment. True if authorization must be obtained.']
  care_setting varchar [note: 'Type of care setting required for the appointment: outpatient clinic, inpatient admission, emergency department, ambulatory surgery center, telehealth virtual visit, home health visit.']
  created_datetime timestamp [note: 'Date and time when this waitlist entry record was first created in the system. Audit timestamp for record creation.']
  created_timestamp timestamp
  effective_end_date date
  effective_start_date date
  entry_number varchar [note: 'Business-facing unique identifier or tracking number for the waitlist entry, used for patient communication and scheduling team reference.']
  entry_status varchar [note: 'Current lifecycle status of the waitlist entry: active (awaiting action), offered (appointment offered to patient), accepted (patient accepted offer), expired (entry aged out or SLA missed), removed (manually removed from queue), pending (awaiting information or approval), in_progress (actively being worked by scheduling team), scheduled (appointment successfully scheduled), escalated (escalated due to aging or priority), closed (completed or resolved). [ENUM-REF-CANDIDATE: active|offered|accepted|expired|removed|pending|in_progress|scheduled|escalated|closed — 10 candidates stripped; promote to reference product]']
  entry_type varchar [note: 'Classification of the waitlist entry indicating the source or nature of the scheduling request: waitlist (patient-initiated or provider-requested appointment waitlist), referral_queue (unscheduled referral awaiting scheduling), order_based (pending order requiring appointment), recall (recall-driven request for follow-up), surgical_request (surgical scheduling request), work_queue (general scheduling department work item).']
  escalation_datetime timestamp [note: 'Date and time when the waitlist entry was escalated. Null if never escalated.']
  escalation_flag boolean [note: 'Indicates whether this waitlist entry has been escalated due to aging, priority, or SLA breach. True if escalated for management attention.']
  escalation_reason varchar [note: 'Free-text or coded reason for escalation (e.g., SLA breach, high clinical priority, patient complaint, aging threshold exceeded).']
  estimated_wait_time_days varchar [note: 'Estimated number of days the patient will wait from queue entry to scheduled appointment, based on current capacity and demand forecasting.']
  interpreter_required_flag boolean [note: 'Indicates whether a medical interpreter is required for the appointment. True if interpreter services must be arranged.']
  language_preference varchar [note: 'Patient preferred language for communication and care delivery. ISO 639-2 three-letter language code (e.g., eng for English, spa for Spanish).']
  last_modified_datetime timestamp [note: 'Date and time when this waitlist entry record was last updated. Audit timestamp for record modification.']
  last_modified_timestamp timestamp
  last_outreach_datetime timestamp [note: 'Date and time of the most recent outreach attempt to the patient. Null if no outreach has been attempted.']
  last_outreach_method varchar [note: 'Method used for the most recent outreach attempt: phone call, email, SMS text, patient portal message, postal mail.']
  notes varchar [note: 'Free-text notes and comments from scheduling staff regarding patient preferences, special requirements, barriers to scheduling, or other relevant information.']
  outreach_attempt_count varchar [note: 'Number of times the scheduling team has attempted to contact the patient to schedule the appointment. Used for tracking patient engagement and no-contact protocols.']
  preferred_contact_channel varchar [note: 'Patient preferred method of contact for scheduling outreach and appointment notifications: phone, email, SMS text message, patient portal message, postal mail.']
  preferred_days_of_week varchar [note: 'Patient preference for days of the week for scheduling (e.g., Monday, Wednesday, Friday). Stored as comma-separated list or coded representation.']
  preferred_time_of_day varchar [note: 'Patient preference for time of day for scheduling: morning (before noon), afternoon (noon to 5pm), evening (after 5pm), any (no preference).']
  priority_level varchar [note: 'Clinical or operational priority assigned to the waitlist entry, determining urgency of scheduling action. Values align with clinical acuity and access standards. [ENUM-REF-CANDIDATE: routine|urgent|emergent|stat|high|medium|low — 7 candidates stripped; promote to reference product]']
  queue_entry_datetime timestamp [note: 'Date and time when the patient was added to the waitlist or scheduling queue. Used for aging calculations and first-in-first-out queue management.']
  record_number varchar [note: 'Foreign key linking to consent.consent_record. Business justification: Waitlist entries track consent status for procedure readiness. Scheduling teams verify required consents obtained before converting waitlist to scheduled appointment. Prevents delays, ensures regulato']
  removal_datetime timestamp [note: 'Date and time when the waitlist entry was removed from the queue without scheduling (e.g., patient declined, no longer needed, duplicate entry). Null if not removed.']
  removal_reason varchar [note: 'Free-text or coded reason for removing the entry from the waitlist without scheduling (e.g., patient declined, no longer clinically indicated, duplicate entry, patient deceased, scheduled elsewhere).']
  scheduled_datetime timestamp [note: 'Date and time when the appointment was successfully scheduled and the waitlist entry was resolved. Null if not yet scheduled.']
  sla_target_datetime timestamp [note: 'Target date and time by which the scheduling action should be completed per organizational or regulatory service level agreement. Used for compliance monitoring and escalation triggers.']
  source_system_identifier varchar [note: 'Unique identifier for this waitlist entry in the source system. Used for data lineage and reconciliation.']
  specialty_required varchar [note: 'Clinical specialty required for the appointment (e.g., Cardiology, Orthopedics, Primary Care). Used for routing to appropriate scheduling queues.']
  telehealth_eligible_flag boolean [note: 'Indicates whether the patient is eligible and willing to receive care via telehealth modality for this appointment request. True if telehealth is an acceptable option.']
  transportation_assistance_needed_flag boolean [note: 'Indicates whether the patient requires transportation assistance to attend the appointment. True if transportation support is needed.']
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutator to satisfy target entity touch']
  vibe_mutation_flag boolean [note: 'Added by VIBE mutator to ensure model change.']
  vibe_structure_marker varchar [note: 'Marks product as part of the required ECM structure.']
  visit_reason varchar [note: 'Free-text description of the clinical reason or chief complaint for the requested appointment.']
  visit_reason_code varchar [note: 'Coded representation of the visit reason using standard clinical terminology (e.g., SNOMED CT, ICD-10).']
  waitlist_entry_status varchar

  Note: 'Waitlist entries'
}

Table scheduling.appointment_status_history {
  appointment_status_history_id varchar [pk, note: 'Unique identifier for each appointment status transition record in the audit log. Primary key for the appointment status history table.']
  care_site_id varchar
  employee_id varchar [note: 'Identifier of the user who triggered this status transition. May be a staff member, system user, or patient portal user. Used for accountability and audit trail.']
  primary_scheduling_appointment_id varchar [note: 'Foreign key reference to the appointment that underwent this status transition. Links this status history record to the parent appointment in the scheduling_appointment table.']
  tertiary_rescheduled_appointment_scheduling_appointment_id varchar [note: 'Foreign key reference to the new appointment created when this appointment was rescheduled. Null if not rescheduled. Used to track rescheduling patterns and patient retention.']
  advance_notice_hours varchar [note: 'Number of hours between the cancellation timestamp and the originally scheduled appointment time. Used to determine if cancellation met policy requirements and to analyze cancellation lead time patterns.']
  appointment_number varchar [note: 'Business identifier for the appointment. Human-readable appointment confirmation number used for patient communication and operational reference.']
  appointment_status_history_status varchar
  audit_required boolean [note: 'Flag indicating whether this status transition requires additional audit review or documentation per compliance policy. True if audit required, False otherwise. Used for compliance monitoring.']
  backfill_indicator boolean [note: 'Flag indicating whether this no-show or cancellation slot was successfully backfilled with another patient. True if the slot was reused, False if it remained empty. Critical for revenue protection and capacity utilization analysis.']
  comment varchar [note: 'Free-text comment or note entered by staff regarding this status transition. Provides additional context not captured in structured fields. Used for operational review and audit trail.']
  created_timestamp timestamp [note: 'Date and time when this status history record was first created in the data warehouse. Used for data lineage and audit trail. Distinct from transition_timestamp which is the business event time.']
  effective_end_date date
  effective_start_date date
  estimated_revenue_impact decimal(15,2) [note: 'Estimated financial impact of this status transition in USD. Positive for revenue-generating transitions, negative for lost revenue (no-shows, cancellations). Used for financial forecasting and no-show cost analysis.']
  financial_impact_flag boolean [note: 'Indicates whether this status transition has financial implications (e.g., no-show fee, late cancellation charge, lost revenue). True if financial impact exists, False otherwise. Used for revenue cycle reporting.']
  hedis_measure_applicable boolean [note: 'Indicates whether this appointment status transition impacts HEDIS access and availability measures. True if applicable to quality reporting, False otherwise. Used for NCQA quality measure compliance.']
  hedis_measure_code varchar [note: 'Specific HEDIS measure code that this status transition impacts (e.g., access measures, preventive care measures). Null if not applicable to HEDIS reporting.']
  initiated_by_role varchar [note: 'Role or job function of the user who triggered the transition (e.g., Scheduler, Nurse, Patient, System). Used for workflow analysis and training needs assessment.']
  initiated_by_user_name varchar [note: 'Name of the user who triggered this status transition. Human-readable identifier for operational review and audit purposes.']
  last_modified_timestamp timestamp
  new_status varchar [note: 'The appointment status after this transition. Captures the to-state in the status lifecycle. This is the current status as of this transition timestamp. [ENUM-REF-CANDIDATE: scheduled|confirmed|rescheduled|arrived|roomed|in_progress|completed|cancelled|no_show|pending|waitlisted — 11 candidates stripped; promote to reference product]']
  no_show_penalty_amount decimal(10,2) [note: 'Dollar amount of the no-show penalty or late cancellation fee charged to the patient. Null if no penalty was applied. Used for revenue tracking and policy effectiveness analysis.']
  no_show_penalty_applied boolean [note: 'Indicates whether a no-show penalty or fee was applied to the patient account as a result of this transition. True if penalty applied, False otherwise. Used for no-show policy enforcement tracking.']
  notes varchar
  notification_timestamp timestamp [note: 'Date and time when waitlist notifications were sent for this available slot. Null if no notifications were sent. Used to measure notification-to-booking conversion time.']
  patient_contact_method varchar [note: 'Method used to contact the patient regarding this status transition. Used for communication effectiveness analysis and patient preference tracking.']
  patient_contacted_flag boolean [note: 'Indicates whether the patient was contacted regarding this status transition (e.g., confirmation call, cancellation notification, no-show follow-up). True if contact attempted, False otherwise.']
  patient_response varchar [note: 'Free-text capture of patient response or feedback regarding this status transition. Used for patient satisfaction analysis and service improvement.']
  prior_status varchar [note: 'The appointment status immediately before this transition occurred. Captures the from-state in the status lifecycle for audit trail and pattern analysis. [ENUM-REF-CANDIDATE: scheduled|confirmed|rescheduled|arrived|roomed|in_progress|completed|cancelled|no_show|pending|waitlisted — 11 candidates stripped; promote to reference product]']
  quality_measure_impact varchar [note: 'Classification of how this status transition impacts quality measures. Positive for completed visits, negative for no-shows affecting access measures, neutral for administrative changes.']
  reason_category varchar [note: 'High-level classification of the transition reason. Groups granular reason codes into analytical categories for no-show and cancellation pattern tracking. [ENUM-REF-CANDIDATE: patient_request|provider_unavailable|facility_issue|insurance_issue|clinical_reason|administrative|weather|transportation|no_reason_given|other — 10 candidates stripped; promote to reference product]']
  regulatory_reportable boolean [note: 'Indicates whether this status transition must be included in regulatory reporting (CMS, state health departments, accreditation bodies). True if reportable, False otherwise.']
  source_system_identifier varchar [note: 'Unique identifier for this status transition record in the source system. Used for data reconciliation and troubleshooting integration issues.']
  system_generated boolean [note: 'Indicates whether this status transition was automatically generated by the system (e.g., auto no-show after appointment time) versus manually entered by staff. True if system-generated, False if manual.']
  transition_reason_code varchar [note: 'Coded reason for the status transition. Includes cancellation reason codes, no-show reason codes, and other transition justifications. Used for root cause analysis and no-show reduction programs.']
  transition_reason_description varchar [note: 'Free-text description or additional detail about why the status transition occurred. Supplements the reason code with context provided by staff or patient.']
  transition_source varchar [note: 'The system or channel through which the status transition was initiated. Distinguishes manual staff actions from automated system transitions and patient self-service actions. [ENUM-REF-CANDIDATE: manual|automated|patient_portal|ivr|mobile_app|kiosk|interface|batch_process — 8 candidates stripped; promote to reference product]']
  transition_timestamp timestamp [note: 'The exact date and time when this status transition occurred. Primary business event timestamp for this audit record. Used for no-show detection, cancellation pattern analysis, and operational throughput measurement.']
  vibe_mutation_applied varchar [note: 'Added by VIBE mutation to ensure model change']
  vibe_mutation_flag boolean [note: 'Added by VIBE mutator to ensure model change.']
  vibe_structure_marker varchar [note: 'Marks product as part of the required ECM structure.']
  waitlist_notification_sent boolean [note: 'Indicates whether waitlisted patients were notified of this newly available slot following a cancellation or no-show. True if notification sent, False otherwise. Used for waitlist management effectiveness tracking.']
  within_policy_window boolean [note: 'Indicates whether the cancellation or status change occurred within the required advance notice window per organizational policy. True if within policy, False if late. Used for policy compliance reporting.']

  Note: 'Appointment status history'
}

Table scheduling.appointment_reminder {
  appointment_reminder_id varchar [pk, note: 'Unique identifier for the appointment reminder record. Primary key.']
  care_site_id varchar
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: Reminder campaigns incur costs (platform fees, staff time) tracked by cost center. cost_per_reminder field signals financial tracking need. Supports patient engagement program cost management and no-s']
  diagnosis_id varchar [note: 'Foreign key linking to clinical.clinical_diagnosis. Business justification: Appointment reminders include diagnosis-specific preparation instructions (fasting for diabetes, bowel prep for colonoscopy). Improves visit preparedness, reduces cancellations, and enhances patient e']
  direct_message_id varchar [note: 'Foreign key linking to interoperability.direct_message. Business justification: Appointment reminders sent via Direct Secure Messaging for care coordination (e.g., notifying PCPs of specialist appointments). CMS interoperability rules and ACO care coordination workflows require t']
  mpi_record_id varchar [note: 'Foreign key reference to the patient who received this reminder. Links to the patient demographics product.']
  payer_id varchar [note: 'Foreign key linking to insurance.payer. Business justification: Appointment reminders include payer-specific instructions such as bringing insurance card, verifying eligibility, or completing pre-authorization. Reminder templates and content vary by payer requirem']
  reminder_template_id varchar [note: 'Identifier for the message template used to generate the reminder content. References the template library in the source system.']
  scheduling_appointment_id varchar [note: 'Foreign key reference to the appointment for which this reminder was sent. Links to the scheduling_appointment product.']
  actual_send_datetime timestamp [note: 'The actual date and time when the reminder was sent by the messaging system. May differ from scheduled send time due to system delays or batch processing.']
  appointment_date date [note: 'The date of the appointment for which this reminder was sent. Denormalized from the scheduling_appointment product for reporting convenience.']
  appointment_reminder_status varchar
  appointment_time timestamp [note: 'The scheduled start time of the appointment for which this reminder was sent. Denormalized from the scheduling_appointment product for reporting convenience.']
  attempt_number varchar [note: 'The sequential attempt number for this reminder (e.g., 1 for first attempt, 2 for second attempt). Supports tracking of retry logic and escalation workflows.']
  campaign_code varchar [note: 'Identifier for the reminder campaign or program under which this reminder was sent (e.g., no-show reduction initiative, seasonal flu shot reminders). Supports program-level analytics.']
  cost_per_reminder decimal(10,4) [note: 'The cost incurred for sending this reminder through the selected delivery channel (e.g., SMS carrier fees, IVR system costs). Supports cost analysis and Return on Investment (ROI) calculation for reminder programs.']
  created_timestamp timestamp [note: 'The date and time when this reminder record was first created in the source system. Supports audit trail and data lineage tracking.']
  delivery_channel varchar [note: 'The communication channel through which the reminder was sent (e.g., phone call, SMS text message, email, patient portal message, Interactive Voice Response (IVR), mobile app push notification).']
  delivery_failure_reason varchar [note: 'Detailed reason for delivery failure if the reminder was not successfully delivered (e.g., invalid phone number, email bounce, patient portal not activated, carrier rejection).']
  delivery_status varchar [note: 'The delivery status of the reminder message (e.g., sent, delivered, failed, bounced, undeliverable, pending, cancelled). Indicates whether the message successfully reached the patient. [ENUM-REF-CANDIDATE: sent|delivered|failed|bounced|undeliverable|pending|cancelled — 7 candidates stripped; promote to reference product]']
  department_name varchar [note: 'The name of the department where the appointment is scheduled. Denormalized for patient communication and reporting purposes.']
  effective_end_date date
  effective_start_date date
  facility_name varchar [note: 'The name of the facility where the appointment is scheduled. Denormalized for patient communication and reporting purposes.']
  language_code varchar [note: 'The two-letter ISO 639-1 language code for the language in which the reminder was sent (e.g., en for English, es for Spanish). Supports multilingual patient communication.']
  last_modified_timestamp timestamp [note: 'The date and time when this reminder record was last modified in the source system. Supports change tracking and audit trail requirements.']
  lead_time_days varchar [note: 'The number of days before the appointment that this reminder was scheduled to be sent. Supports analysis of optimal reminder timing for no-show reduction.']
  max_attempts_allowed varchar [note: 'The maximum number of reminder attempts configured for this appointment type or reminder workflow. Used to determine when to stop retry attempts.']
  message_content varchar [note: 'The full text content of the reminder message sent to the patient. May contain appointment details and instructions. Stored for audit and quality review purposes.']
  mrn varchar [note: 'The patient\'s medical record number. Protected Health Information (PHI) under HIPAA.']
  notes varchar
  opt_out_datetime timestamp [note: 'The date and time when the patient opted out of automated reminders, if applicable. Null if patient has not opted out.']
  opt_out_flag boolean [note: 'Indicates whether the patient has opted out of receiving automated reminders. True if patient has opted out, False otherwise. Supports patient communication preferences and regulatory compliance.']
  patient_response varchar [note: 'The patient\'s response to the reminder, if any (e.g., confirmed attendance, cancelled appointment, requested reschedule, no response received, opted out of reminders).']
  provider_name varchar [note: 'The name of the provider for the appointment. Denormalized for patient communication and reporting purposes.']
  recipient_email_address varchar [note: 'The email address to which the reminder was sent, if delivery channel was email. Protected Health Information (PHI) under HIPAA.']
  recipient_phone_number varchar [note: 'The phone number to which the reminder was sent, if delivery channel was phone or SMS. Protected Health Information (PHI) under HIPAA.']
  reminder_type varchar [note: 'The type or sequence of the reminder in the automated reminder workflow (e.g., initial, first reminder, second reminder, final reminder, confirmation request, pre-visit instructions).']
  response_channel varchar [note: 'The channel through which the patient responded to the reminder (e.g., phone call, SMS reply, email reply, patient portal, IVR system, mobile app).']
  response_datetime timestamp [note: 'The date and time when the patient responded to the reminder, if applicable. Null if no response was received.']
  scheduled_send_datetime timestamp [note: 'The date and time when the reminder was scheduled to be sent, based on the reminder lead time configuration and appointment date.']
  source_system_identifier varchar [note: 'The unique identifier for this reminder record in the source system. Supports data reconciliation and traceability back to the operational system.']
  vibe_mutation_applied varchar [note: 'Added by VIBE mutation to ensure model change']
  vibe_mutation_flag boolean [note: 'Added by VIBE mutator to ensure model change.']
  vibe_structure_marker varchar [note: 'Marks product as part of the required ECM structure.']

  Note: 'Appointment reminders'
}

Table scheduling.capacity_utilization {
  capacity_utilization_id varchar [pk, note: 'Primary key for capacity_utilization']
  budget_id varchar [note: 'Foreign key linking to finance.budget. Business justification: Capacity plans drive volume-based budget assumptions (target_visit_volume, target_case_volume). Linking enables budget-to-actual volume variance analysis, reforecasting, and operational budget managem']
  care_site_id varchar [note: 'Identifier of the healthcare facility where capacity is planned or measured.']
  or_block_id varchar [note: 'Reference to the OR block for which utilization is measured. Populated only when plan_type is or_block_utilization.']
  primary_capacity_employee_id varchar [note: 'Identifier of the user or system that created this capacity utilization record.']
  schedulable_resource_id varchar [note: 'Reference to the schedulable resource (provider, room, equipment) for which capacity is planned or measured.']
  workforce_org_unit_id varchar [note: 'Identifier of the department or service line for which capacity is planned or measured.']
  access_days varchar [note: 'Average number of days from appointment request to scheduled appointment date, measuring patient access timeliness.']
  actual_case_volume varchar [note: 'Actual number of surgical or procedural cases performed during the period.']
  actual_utilization_rate_pct decimal(5,2) [note: 'Actual utilization rate achieved as a percentage of available capacity.']
  actual_visit_volume varchar [note: 'Actual number of patient visits or appointments completed during the period.']
  add_on_case_count varchar [note: 'Number of add-on surgical cases scheduled outside of allocated block time during the period.']
  available_fte decimal(8,2) [note: 'Full-time equivalent staff or provider capacity available during the planning period.']
  available_hours decimal(10,2) [note: 'Total hours available for scheduling during the planning period (provider time, room time, or equipment time).']
  available_minutes varchar [note: 'Total minutes available for scheduling during the planning period, used primarily for OR block time tracking.']
  cancellation_count varchar [note: 'Number of cancelled appointments or cases during the period.']
  capacity_utilization_status varchar
  care_setting varchar [note: 'Care setting context for the capacity plan: outpatient clinic, inpatient unit, emergency department, surgical suite, procedural area, or telehealth.']
  created_timestamp timestamp [note: 'Timestamp when this capacity utilization record was first created in the system.']
  effective_end_date date
  effective_start_date date
  first_case_on_time_start_flag boolean [note: 'Indicates whether the first case of the day started on time. True if on time, False if delayed.']
  last_modified_timestamp timestamp [note: 'Timestamp when this capacity utilization record was last updated.']
  no_show_count varchar [note: 'Number of patient no-shows during the period, impacting actual utilization.']
  notes varchar [note: 'Free-text notes or comments about the capacity plan, utilization performance, or variance analysis.']
  overbooking_count varchar [note: 'Number of instances where capacity was overbooked beyond available slots or time.']
  plan_status varchar [note: 'Current status of the capacity plan: draft (in development), approved (ready for execution), active (currently in effect), completed (period ended), or cancelled.']
  plan_type varchar [note: 'Type of capacity record: capacity planning for future periods, OR block utilization for surgical blocks, resource utilization for general scheduling resources, or variance analysis comparing planned vs actual.']
  planning_period_end_date date [note: 'End date of the planning or measurement period for this capacity record.']
  planning_period_start_date date [note: 'Start date of the planning or measurement period for this capacity record.']
  provider_npi varchar [note: 'National Provider Identifier of the provider for whom capacity is planned or measured.']
  reallocation_recommendation varchar [note: 'Recommendation for capacity reallocation based on variance analysis (e.g., increase block time, reduce slots, shift resources).']
  released_minutes varchar [note: 'Minutes of OR block time released back to the pool for reallocation due to underutilization or cancellations.']
  scheduled_hours decimal(10,2) [note: 'Total hours scheduled with appointments or cases during the period.']
  scheduled_minutes varchar [note: 'Total minutes scheduled with cases or appointments during the period.']
  specialty_code varchar [note: 'Medical specialty code for which capacity is planned (e.g., cardiology, orthopedics, general surgery).']
  target_case_volume varchar [note: 'Planned number of surgical or procedural cases for the planning period.']
  target_utilization_rate_pct decimal(5,2) [note: 'Target utilization rate as a percentage of available capacity (e.g., 85.00 represents 85% target utilization).']
  target_visit_volume varchar [note: 'Planned number of patient visits or appointments for the planning period.']
  trend_indicator varchar [note: 'Directional trend of utilization over time: increasing demand, decreasing demand, stable, or volatile patterns.']
  turnover_time_minutes varchar [note: 'Average time in minutes between cases for room cleaning, setup, and preparation.']
  utilized_hours decimal(10,2) [note: 'Actual hours used for patient care activities during the period.']
  utilized_minutes varchar [note: 'Actual minutes used for patient care activities during the period.']
  variance_hours decimal(10,2) [note: 'Difference between actual and planned hours (actual minus planned).']
  variance_utilization_pct decimal(5,2) [note: 'Difference between actual and target utilization rate as a percentage.']
  variance_volume varchar [note: 'Difference between actual and planned visit or case volume (actual minus planned).']
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutator to satisfy target entity touch']
  vibe_mutation_flag boolean [note: 'Added by VIBE mutator to ensure model change.']
  vibe_structure_marker varchar [note: 'Marks product as part of the required ECM structure.']
  waitlist_volume varchar [note: 'Number of patients on the waitlist for this resource or service during the period.']

  Note: 'Capacity utilization metrics'
}

Table scheduling.block_utilization {
  block_utilization_id varchar [pk, note: 'Unique identifier for the operating room block utilization record.']
  care_site_id varchar [note: 'Reference to the healthcare facility where the OR block utilization occurred.']
  clinician_id varchar [note: 'Reference to the surgeon who owns the block, if block_owner_type is surgeon.']
  employee_id varchar [note: 'Reference to the user who released the unused block time.']
  or_block_id varchar [note: 'Reference to the allocated OR block schedule being measured for utilization.']
  or_suite_id varchar [note: 'Reference to the specific operating room suite where the block was utilized.']
  owner_service_id varchar [note: 'Reference to the service line that owns the block, if block_owner_type is service.']
  add_on_case_count varchar [note: 'Total number of add-on cases (not originally scheduled in the block) that were performed during the block time.']
  allocated_minutes varchar [note: 'Total number of minutes allocated for the OR block on this date.']
  average_turnover_minutes decimal(5,2) [note: 'Average turnover time between cases within this block, calculated as total turnover minutes divided by number of turnovers.']
  block_overrun_minutes varchar [note: 'Number of minutes the block ran beyond its allocated end time due to case overruns or delays.']
  block_owner_type varchar [note: 'The type of entity that owns or is allocated the OR block (surgeon, service line, department, specialty, shared pool, or unassigned).']
  block_reallocation_risk_flag boolean [note: 'Indicates whether this block is at risk for reallocation due to consistently low utilization (True) or not (False).']
  block_status varchar [note: 'Overall status of the block utilization for this date (utilized, partially utilized, unutilized, released to pool, or cancelled).']
  block_utilization_status varchar
  cancelled_case_count varchar [note: 'Total number of scheduled cases that were cancelled within the block time.']
  completed_case_count varchar [note: 'Total number of surgical cases that were completed during the block time.']
  cost_center_code varchar [note: 'The cost center code to which OR block time and associated costs are allocated for financial reporting.']
  created_timestamp timestamp [note: 'Date and time when the block utilization record was first created in the system.']
  effective_end_date date
  effective_start_date date
  first_case_delay_minutes varchar [note: 'Number of minutes the first case was delayed beyond the scheduled start time. Zero if started on time.']
  first_case_on_time_start_flag boolean [note: 'Indicates whether the first case of the day in this block started on time (True) or was delayed (False).']
  last_modified_timestamp timestamp [note: 'Date and time when the block utilization record was last updated or modified.']
  meets_utilization_threshold_flag boolean [note: 'Indicates whether the block utilization met or exceeded the minimum utilization threshold required to retain the block allocation (True) or fell below threshold (False).']
  notes varchar [note: 'Free-text notes or comments regarding the block utilization, including reasons for low utilization, special circumstances, or operational issues.']
  owner_specialty_code varchar [note: 'The medical specialty code of the block owner (e.g., orthopedics, cardiology, general surgery).']
  prime_time_flag boolean [note: 'Indicates whether this block occurred during prime OR time (typically weekday daytime hours, True) or non-prime time (False).']
  procedure_minutes varchar [note: 'Total number of minutes spent on actual surgical procedures (wheels in to wheels out), excluding turnover time.']
  release_timestamp timestamp [note: 'Date and time when unused block time was released back to the pool for reallocation.']
  released_minutes varchar [note: 'Number of minutes from the allocated block that were released back to the pool for use by other services or add-on cases.']
  scheduled_case_count varchar [note: 'Total number of surgical cases scheduled within the block time.']
  scheduled_minutes varchar [note: 'Total number of minutes scheduled for surgical cases within the block time.']
  target_utilization_percentage decimal(5,2) [note: 'The target utilization percentage threshold defined for this block owner or service line.']
  turnover_minutes varchar [note: 'Total number of minutes spent on room turnover between cases (wheels out to wheels in for next case).']
  unutilized_minutes varchar [note: 'Number of allocated minutes that were neither used nor released, representing idle OR time.']
  used_minutes varchar [note: 'Total number of minutes actually used for surgical procedures, including procedure time and turnover time.']
  utilization_date date [note: 'The calendar date on which the OR block utilization was measured.']
  utilization_percentage decimal(5,2) [note: 'Percentage of allocated block time that was actually used, calculated as (used_minutes / allocated_minutes) * 100.']
  utilization_variance_percentage decimal(5,2) [note: 'Variance between actual utilization percentage and target utilization percentage (actual minus target).']
  vibe_mutation_applied varchar [note: 'Added by VIBE mutation to ensure model change']
  vibe_mutation_flag boolean [note: 'Added by VIBE mutator to ensure model change.']
  vibe_structure_marker varchar [note: 'Marks product as part of the required ECM structure.']

  Note: 'Block utilization metrics'
}

Table scheduling.booking_rule {
  booking_rule_id varchar [pk, note: 'Primary key for booking_rule']
  care_site_id varchar [note: 'Reference to the specific facility or care site to which this rule applies. Null indicates the rule applies enterprise-wide across all facilities.']
  clinician_id varchar [note: 'Reference to the specific provider to whom this rule applies. Null indicates the rule applies to all providers or is provider-agnostic.']
  compliance_policy_id varchar [note: 'Foreign key linking to compliance.policy. Business justification: Booking rules implement compliance policies including authorization requirements, age restrictions, insurance eligibility, and referral mandates. Policy enforcement mechanism in scheduling systems.']
  primary_booking_appointment_type_id varchar [note: 'Reference to the specific appointment type to which this rule applies. Null indicates the rule applies to all appointment types.']
  primary_booking_employee_id varchar [note: 'Reference to the user who approved this scheduling rule for activation. Null for draft or unapproved rules. Supports governance and accountability.']
  superseded_rule_booking_rule_id varchar [note: 'Reference to the previous version of this rule that was replaced. Null for initial rule versions. Maintains lineage for rule versioning and audit trail.']
  workforce_org_unit_id varchar [note: 'Reference to the specific department to which this rule applies. Null indicates the rule applies across all departments.']
  applies_to_surgical_cases boolean [note: 'Indicates whether this rule applies to surgical case scheduling in Epic OpTime. True enforces the rule for Operating Room (OR) scheduling, false exempts surgical cases.']
  applies_to_telehealth boolean [note: 'Indicates whether this rule applies to telehealth virtual appointments. True enforces the rule for telehealth visits, false exempts telehealth from this rule.']
  approval_timestamp timestamp [note: 'Date and time when this scheduling rule was approved for activation. Null for draft or unapproved rules. Supports audit trail and compliance reporting.']
  booking_rule_status varchar
  business_justification varchar [note: 'Rationale for implementing this scheduling rule, including clinical, operational, financial, or regulatory drivers. Used for governance and audit purposes.']
  care_setting varchar [note: 'Type of care environment to which this rule applies. Null indicates the rule applies across all care settings.']
  conflict_rule_type varchar [note: 'Type of scheduling conflict this rule prevents. Same day block prevents multiple appointments on the same day, same week block prevents appointments in the same week, concurrent block prevents overlapping appointments, sequential required enforces appointment ordering.']
  created_timestamp timestamp [note: 'Date and time when this scheduling rule record was first created in the system. Supports audit trail and data lineage tracking.']
  double_booking_allowed boolean [note: 'Indicates whether multiple appointments can be scheduled in the same time slot for the same provider or resource. True permits double booking, false enforces single appointment per slot.']
  effective_end_date date [note: 'Date when the scheduling rule expires and ceases enforcement. Null indicates an open-ended rule with no planned expiration.']
  effective_start_date date [note: 'Date when the scheduling rule becomes active and begins enforcement in scheduling systems. Supports versioning and temporal validity of rule changes.']
  enforcement_mode varchar [note: 'Defines how strictly the rule is enforced in scheduling systems. Hard block prevents scheduling, soft warning allows override with acknowledgment, advisory provides guidance without enforcement.']
  gender_restriction varchar [note: 'Gender requirement for patients scheduling under this rule. Used for gender-specific procedures and services. Any indicates no gender restriction.']
  insurance_type_required varchar [note: 'Specific insurance plan type or payer category required for scheduling under this rule. Null indicates no insurance restriction. Used to enforce payer-specific access rules.']
  last_modified_timestamp timestamp [note: 'Date and time when this scheduling rule record was most recently updated. Supports change tracking and audit trail requirements.']
  maximum_lead_time_days varchar [note: 'Maximum number of days in advance that an appointment can be scheduled. Used to control booking horizon and prevent excessive future scheduling.']
  maximum_patient_age_years varchar [note: 'Maximum patient age in years permitted to schedule under this rule. Used to enforce age-appropriate care restrictions. Null indicates no maximum age limit.']
  minimum_lead_time_days varchar [note: 'Minimum number of days in advance that an appointment must be scheduled. Used to enforce advance booking requirements for procedures requiring preparation or authorization.']
  minimum_patient_age_years varchar [note: 'Minimum patient age in years required to schedule under this rule. Used to enforce age-appropriate care restrictions. Null indicates no minimum age requirement.']
  notes varchar
  overbooking_limit varchar [note: 'Maximum number of appointments that can be scheduled beyond standard capacity for a given time slot. Used to manage no-show risk and optimize throughput. Null indicates no overbooking permitted.']
  override_authority_level varchar [note: 'Minimum user role or authority level required to override this rule during scheduling. Defines escalation hierarchy for exception handling.']
  patient_class varchar [note: 'Classification of patient visit type to which this rule applies. Null indicates the rule applies to all patient classes.']
  regulatory_requirement_flag boolean [note: 'Indicates whether this rule is mandated by external regulatory or accreditation requirements. True identifies rules that cannot be waived without compliance risk.']
  required_pre_visit_orders varchar [note: 'Comma-separated list of order types or procedure codes that must be completed before the appointment. Used to enforce prerequisite testing or preparation requirements.']
  requires_prior_authorization boolean [note: 'Indicates whether insurance prior authorization must be obtained before scheduling. True enforces authorization validation, false permits scheduling without authorization.']
  requires_referral boolean [note: 'Indicates whether a valid referral order is required before scheduling. True enforces referral validation, false permits direct scheduling.']
  rule_category varchar [note: 'Broad classification of the rule by business domain. Temporal rules govern timing, clinical rules enforce medical protocols, administrative rules manage workflow, financial rules ensure payment compliance, operational rules optimize resource use, and regulatory rules enforce compliance requirements.']
  rule_code varchar [note: 'Business-assigned unique code for the scheduling rule, used for reference in Epic Cadence and OpTime scheduling systems.']
  rule_description varchar [note: 'Detailed business explanation of the scheduling rule, its purpose, and enforcement logic. Provides context for schedulers and system administrators.']
  rule_name varchar [note: 'Human-readable name of the scheduling rule for display and reporting purposes.']
  rule_priority varchar [note: 'Numeric priority ranking used to resolve conflicts when multiple rules apply to the same scheduling scenario. Lower numbers indicate higher priority. Rules with higher priority take precedence in enforcement.']
  rule_status varchar [note: 'Current lifecycle status of the scheduling rule. Active rules are enforced in scheduling systems, inactive rules are retired, suspended rules are temporarily disabled, draft rules are under development, and pending approval rules await governance review.']
  rule_type varchar [note: 'Classification of the scheduling rule governing its purpose and enforcement logic. Lead time rules control advance booking windows, eligibility rules determine patient qualification, constraint rules enforce scheduling restrictions, prerequisite rules require prior conditions, conflict rules prevent incompatible bookings, and capacity rules manage overbooking limits.']
  same_day_booking_allowed boolean [note: 'Indicates whether appointments can be scheduled on the same day as the request. True allows same-day scheduling, false requires advance booking per minimum lead time rules.']
  self_scheduling_allowed boolean [note: 'Indicates whether patients can book appointments directly through online portals without staff intervention. True permits patient self-service scheduling, false requires staff-assisted booking.']
  specialty_code varchar [note: 'Medical specialty to which this rule applies, using standard specialty taxonomy codes. Null indicates the rule is specialty-agnostic.']
  version_number varchar [note: 'Sequential version number for this rule, incremented with each modification. Supports audit trail and change tracking for rule evolution.']
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutator to satisfy target entity touch']
  vibe_mutation_flag boolean [note: 'Added by VIBE mutator to ensure model change.']
  vibe_structure_marker varchar [note: 'Marks product as part of the required ECM structure.']

  Note: 'Booking rules'
}

Table scheduling.patient_preference {
  patient_preference_id varchar [pk, note: 'Unique identifier for the patient scheduling preference record. Primary key.']
  care_site_id varchar [note: 'The healthcare facility or care site the patient prefers for appointments. Supports location-based scheduling optimization.']
  demographics_id varchar [note: 'Reference to the patient for whom these scheduling preferences are recorded. Links to the patient master data.']
  primary_patient_clinician_id varchar [note: 'The provider the patient prefers to see for appointments. Used to prioritize provider matching in scheduling workflows.']
  primary_patient_employee_id varchar [note: 'The system user who last verified or updated the preference record. Supports audit trail and data stewardship.']
  tertiary_patient_modified_by_user_employee_id varchar [note: 'The system user who last modified this preference record. Supports audit trail and data stewardship.']
  workforce_org_unit_id varchar [note: 'The specific department within a facility that the patient prefers. Enables granular location matching in scheduling.']
  accessibility_needs varchar [note: 'Free-text description of any accessibility accommodations the patient requires (e.g., wheelchair access, hearing assistance, visual aids). Used to ensure appropriate facility and resource assignment.']
  advance_notice_days varchar [note: 'The minimum number of days advance notice the patient requires for appointment scheduling. Supports patient access planning and reduces no-shows.']
  care_setting_preference varchar [note: 'The patient\'s preferred care setting for appointments. Supports care delivery model matching in scheduling.']
  created_timestamp timestamp [note: 'The date and time when this preference record was first created in the system. Supports audit trail and data lineage.']
  effective_end_date date [note: 'The date on which this preference record expires or is superseded. Null indicates an open-ended preference.']
  effective_start_date date [note: 'The date from which this preference record becomes active and is applied in scheduling workflows.']
  gender_preference_provider varchar [note: 'The patient\'s preference for provider gender. Supports patient-centered care and cultural sensitivity in scheduling.']
  group_visit_eligible_flag boolean [note: 'Indicates whether the patient is willing to participate in group medical appointments. Supports population health and chronic disease management programs.']
  interpreter_required_flag boolean [note: 'Indicates whether the patient requires interpreter services for appointments. Triggers resource allocation for language support.']
  language_preference varchar [note: 'The patient\'s preferred language for communication and care delivery. ISO 639-1 two-letter language code (e.g., en, es, zh). Used to match interpreter services and multilingual providers.']
  last_modified_timestamp timestamp [note: 'The date and time when this preference record was last updated. Supports change tracking and audit trail.']
  last_verified_date date [note: 'The date on which the patient last confirmed or updated their scheduling preferences. Supports preference data quality and staleness monitoring.']
  mrn varchar [note: 'The patient\'s medical record number as assigned by the healthcare organization. Used for patient identification and preference tracking across scheduling systems.']
  notes varchar
  opt_out_reminders_flag boolean [note: 'Indicates whether the patient has opted out of receiving appointment reminders. Honors patient communication preferences and regulatory requirements.']
  patient_preference_status varchar
  preference_notes varchar [note: 'Free-text notes providing additional context or special instructions related to the patient\'s scheduling preferences. Used by scheduling staff to accommodate unique patient needs.']
  preference_source varchar [note: 'The channel or system through which the preference was captured. Supports data lineage and preference quality assessment.']
  preference_status varchar [note: 'Current lifecycle status of the preference record. Determines whether the preference is actively applied in scheduling logic.']
  preference_type varchar [note: 'Category of scheduling preference being captured. Classifies the preference to enable targeted matching in scheduling workflows.']
  preferred_contact_channel varchar [note: 'The patient\'s preferred method for appointment reminders and scheduling communications. Drives outreach strategy in Epic MyChart and Salesforce Health Cloud.']
  preferred_days_of_week varchar [note: 'Comma-separated list of preferred days for appointments (e.g., Monday, Wednesday, Friday). Used to filter available slots in scheduling workflows.']
  preferred_time_of_day varchar [note: 'The time of day the patient prefers for appointments. Supports time-based slot matching and patient access optimization.']
  preferred_visit_modality varchar [note: 'The patient\'s preferred modality for care delivery. Supports patient-centered scheduling and access optimization.']
  reminder_lead_time_days varchar [note: 'The number of days before an appointment that the patient prefers to receive reminders. Customizes reminder campaigns to patient preferences.']
  same_day_appointment_preference varchar [note: 'The patient\'s preference for same-day appointment availability. Guides urgent care and walk-in scheduling strategies.']
  scheduling_priority_level varchar [note: 'The priority level assigned to this patient for scheduling purposes. May reflect clinical urgency, care program enrollment, or VIP status.']
  source_system_identifier varchar [note: 'The unique identifier for this preference record in the source system. Enables traceability and reconciliation with upstream systems.']
  specialty_preference varchar [note: 'The medical specialty the patient prefers for care (e.g., cardiology, orthopedics). Used for specialty-specific scheduling workflows.']
  telehealth_eligible_flag boolean [note: 'Indicates whether the patient is willing and able to participate in telehealth appointments. Used to offer virtual visit options in scheduling workflows.']
  telehealth_preference varchar [note: 'The patient\'s preference level for telehealth versus in-person visits. Guides visit modality selection in scheduling.']
  transportation_assistance_needed_flag boolean [note: 'Indicates whether the patient requires transportation assistance to attend appointments. Supports Social Determinants of Health (SDOH) interventions and access planning.']
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutator to satisfy target entity touch']
  vibe_mutation_flag boolean [note: 'Added by VIBE mutator to ensure model change.']
  vibe_structure_marker varchar [note: 'Marks product as part of the required ECM structure.']

  Note: 'Patient scheduling preferences'
}

Table scheduling.telehealth_session {
  telehealth_session_id varchar [pk, note: 'Primary key for telehealth_session']
  care_site_id varchar
  clinician_id varchar [note: 'Reference to the healthcare provider conducting the telehealth session.']
  mpi_record_id varchar [note: 'Reference to the patient participating in the telehealth session.']
  scheduling_appointment_id varchar [note: 'Reference to the parent appointment record in the scheduling system. Links this telehealth session to the broader appointment context.']
  telehealth_authorization_id varchar [note: 'Foreign key linking to provider.telehealth_authorization. Business justification: Cross-state telehealth sessions require state-specific authorizations per interstate compact rules and originating/distant site regulations. Links session to authorization covering the patient\'s state']
  telehealth_consent_id varchar [note: 'Foreign key linking to consent.telehealth_consent. Business justification: Telehealth sessions require platform-specific consent per state regulations and interstate licensure compacts. Providers verify telehealth consent before session start. Required for CMS telehealth bil']
  visit_id varchar [note: 'Reference to the clinical visit or encounter associated with this telehealth session.']
  actual_duration_minutes varchar [note: 'Actual duration of the telehealth session in minutes, calculated from start to end time.']
  actual_end_datetime timestamp [note: 'Actual date and time when the telehealth session ended, as recorded by the platform or provider.']
  actual_start_datetime timestamp [note: 'Actual date and time when the telehealth session began, as recorded by the platform or provider.']
  billing_eligible_flag boolean [note: 'Indicates whether the telehealth session meets all requirements for billing and reimbursement. Based on completion status, duration, documentation, and payer rules.']
  billing_modifier_code varchar [note: 'CPT or HCPCS modifier code applied to the telehealth session for billing purposes (e.g., GT, 95, GQ). Indicates the service was delivered via telehealth.']
  cancellation_datetime timestamp [note: 'Date and time when the telehealth session was cancelled, if applicable.']
  cancellation_reason varchar [note: 'Reason provided for cancellation of the telehealth session. Used for operational analysis and patient access improvement.']
  cancelled_by_role varchar [note: 'Role of the person or system that initiated the cancellation of the telehealth session.']
  connection_quality_score decimal(5,2) [note: 'Numeric score representing the overall quality of the telehealth connection, typically on a scale of 0-100. Based on bandwidth, latency, and stability metrics.']
  connection_status varchar [note: 'Technical status of the network connection during the telehealth session. Used to track quality and troubleshoot issues.']
  consent_datetime timestamp [note: 'Date and time when patient consent for telehealth services was obtained and documented.']
  consent_obtained_flag boolean [note: 'Indicates whether patient consent for telehealth services was obtained prior to or at the start of the session. Required for compliance and legal protection.']
  created_datetime timestamp [note: 'Date and time when this telehealth session record was first created in the system.']
  created_timestamp timestamp
  distant_site_code varchar [note: 'Code identifying the location where the provider is physically located during the telehealth session. Required for certain telehealth billing scenarios.']
  effective_end_date date
  effective_start_date date
  interpreter_language varchar [note: 'Language for which interpretation services were provided during the telehealth session, if applicable.']
  interpreter_present_flag boolean [note: 'Indicates whether an interpreter was actually present and participated in the telehealth session.']
  interpreter_required_flag boolean [note: 'Indicates whether a language interpreter was required for the telehealth session to facilitate communication between patient and provider.']
  last_modified_datetime timestamp [note: 'Date and time when this telehealth session record was most recently updated.']
  last_modified_timestamp timestamp
  no_show_flag boolean [note: 'Indicates whether the patient failed to attend the scheduled telehealth session without prior cancellation.']
  notes varchar
  originating_site_code varchar [note: 'Code identifying the location where the patient is physically located during the telehealth session. Required for certain telehealth billing scenarios.']
  patient_browser varchar [note: 'Web browser used by the patient to access the telehealth session, if applicable. Used for technical support and compatibility tracking.']
  patient_device_type varchar [note: 'Type of device used by the patient to access the telehealth session. Helps identify technical support needs and access patterns.']
  patient_operating_system varchar [note: 'Operating system of the device used by the patient (e.g., iOS, Android, Windows, macOS). Used for troubleshooting and compatibility analysis.']
  platform_name varchar [note: 'Name of the telehealth platform or application used to conduct the session (e.g., Epic MyChart Video, Zoom for Healthcare, Doxy.me).']
  platform_vendor varchar [note: 'Vendor or manufacturer of the telehealth platform used for the session.']
  provider_attestation_datetime timestamp [note: 'Date and time when the provider attested to the completion of the telehealth session.']
  provider_attestation_flag boolean [note: 'Indicates whether the provider has attested to the completion and clinical validity of the telehealth session. Required for billing and compliance.']
  provider_device_type varchar [note: 'Type of device used by the provider to conduct the telehealth session.']
  recording_enabled_flag boolean [note: 'Indicates whether the telehealth session was recorded for clinical, educational, or quality purposes. Requires explicit patient consent.']
  scheduled_duration_minutes varchar [note: 'Planned duration of the telehealth session in minutes, based on appointment type and clinical requirements.']
  scheduled_end_datetime timestamp [note: 'Planned date and time when the telehealth session was scheduled to end.']
  scheduled_start_datetime timestamp [note: 'Planned date and time when the telehealth session was scheduled to begin.']
  session_access_code varchar [note: 'PIN or access code required to join the telehealth session. Used for additional security and patient verification.']
  session_number varchar [note: 'Human-readable business identifier for the telehealth session, used for tracking and reference purposes.']
  session_status varchar [note: 'Current lifecycle status of the telehealth session. Tracks progression from scheduling through completion or cancellation.']
  session_type varchar [note: 'Type of telehealth modality used for the session. Determines workflow, platform requirements, and billing rules.']
  session_url varchar [note: 'Web link or URL provided to the patient and provider to access the telehealth session. Confidential to prevent unauthorized access.']
  technical_issue_description varchar [note: 'Free-text description of any technical issues encountered during the telehealth session, such as connectivity problems, audio/video quality issues, or platform errors.']
  technical_issue_reported_flag boolean [note: 'Indicates whether any technical issues were reported during or after the telehealth session that impacted quality or completion.']
  telehealth_session_status varchar
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutator to satisfy target entity touch']
  vibe_mutation_flag boolean [note: 'Added by VIBE mutator to ensure model change.']
  vibe_structure_marker varchar [note: 'Marks product as part of the required ECM structure.']

  Note: 'Telehealth sessions'
}

Table scheduling.recall_list {
  recall_list_id varchar [pk, note: 'Unique identifier for the recall list entry. Primary key for the recall list product.']
  care_plan_id varchar [note: 'Foreign key linking to clinical.care_plan. Business justification: Recall lists for care management visits are generated from care plans requiring periodic review and goal assessment. Essential for care plan monitoring, population health outreach, and chronic care ma']
  care_site_id varchar [note: 'Unique identifier for the facility or clinic where the recall appointment should be scheduled.']
  clinician_id varchar [note: 'Unique identifier for the provider responsible for the recall. Typically the Primary Care Physician (PCP) or specialist managing the care gap.']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: Recall/outreach programs incur costs (staff, communications, outreach campaigns) tracked by cost center for quality program financial management, HEDIS cost analysis, and care gap closure program ROI.']
  demographics_id varchar [note: 'Unique identifier for the patient who is due for recall. Links to the patient master record.']
  diagnosis_icd_code_id varchar [note: 'Foreign key linking to reference.icd_code. Business justification: Recall diagnosis ICD codes required for HEDIS/Stars measure tracking, care gap identification, clinical basis validation, and quality program reporting. Essential for population health and value-based']
  eligibility_id varchar [note: 'Foreign key linking to claim.eligibility. Business justification: Recall outreach for preventive services requires current eligibility verification to confirm active coverage before scheduling. Population health teams verify eligibility during recall campaigns to av']
  employee_id varchar [note: 'Unique identifier for the care manager or population health coordinator assigned to manage this recall outreach.']
  health_plan_id varchar [note: 'Foreign key linking to insurance.health_plan. Business justification: Recall lists target plan-specific quality gaps and measure sets. Care gap closure campaigns are designed around plan contracts, quality incentives, and plan-specific measure numerator/denominator crit']
  insurance_coverage_id varchar [note: 'Reference to the patients active insurance coverage at the time the recall was generated. Used to determine coverage for preventive services and quality measure attribution.']
  obligation_id varchar [note: 'Foreign key linking to compliance.obligation. Business justification: Recall programs fulfill regulatory obligations including preventive care mandates, quality measure requirements, and care gap closure. CMS, HEDIS, and Star ratings requirement.']
  payer_id varchar [note: 'Foreign key linking to insurance.payer. Business justification: Recall campaigns are segmented by payer for quality measure reporting (HEDIS, Stars). Outreach prioritizes patients by payer-specific measure gaps and authorization requirements for preventive service']
  population_health_gap_id varchar [note: 'Foreign key linking to quality.population_health_gap. Business justification: Recall lists ARE care gap registries in many systems. Recalls are generated from identified gaps (mammography due, A1C overdue). Linking recall entries to gaps enables gap closure tracking and quality']
  problem_id varchar [note: 'Foreign key linking to clinical.problem. Business justification: Recall lists are generated for chronic problems requiring periodic monitoring (diabetes, hypertension, CHF). Core to population health management, chronic care management billing, and quality measure ']
  procedure_cpt_code_id varchar [note: 'Foreign key linking to reference.cpt_code. Business justification: Recall procedure CPT codes enable service-based recall tracking, gap closure evidence validation, and quality measure numerator determination. Critical for preventive care scheduling and quality repor']
  procedure_event_id varchar [note: 'Foreign key linking to clinical.procedure_event. Business justification: Recall lists track patients due for repeat preventive procedures (colonoscopy, mammography) based on prior procedure dates and intervals. Critical for preventive screening compliance and HEDIS/Star qu']
  scheduling_appointment_id varchar [note: 'Reference to the scheduled appointment that fulfills this recall. Links to the scheduling appointment product when the recall is successfully scheduled.']
  aco_attributed boolean [note: 'Indicates whether the patient is attributed to an Accountable Care Organization (ACO) for quality measure reporting and shared savings programs.']
  appointment_scheduled_date date [note: 'Date when the recall appointment was successfully scheduled.']
  cancellation_date date [note: 'Date when the recall was cancelled.']
  cancellation_reason varchar [note: 'Reason why the recall was cancelled (e.g., patient deceased, patient transferred care, service completed elsewhere, no longer clinically indicated).']
  care_gap_registry_code varchar [note: 'Reference to the care gap registry entry that triggered this recall. Links to population health management and quality measure tracking systems.']
  clinical_basis varchar [note: 'Clinical justification for the recall, including relevant diagnosis codes, procedure history, or risk factors that necessitate follow-up care.']
  cms_quality_program varchar [note: 'CMS quality program associated with this recall (e.g., MIPS, MSSP, Value-Based Purchasing, Hospital Quality Reporting).']
  created_timestamp timestamp [note: 'Timestamp when the recall list entry was first created in the system.']
  effective_end_date date
  effective_start_date date
  gap_closure_evidence varchar [note: 'Documentation or reference to clinical evidence that the care gap was closed (e.g., lab result, procedure note, immunization record).']
  hedis_measure_code varchar [note: 'HEDIS quality measure code associated with this recall (e.g., BCS for Breast Cancer Screening, COL for Colorectal Cancer Screening, CDC for Comprehensive Diabetes Care).']
  interpreter_required boolean [note: 'Indicates whether the patient requires interpreter services for the recall appointment.']
  language_preference varchar [note: 'Patients preferred language for communication. Used to ensure culturally appropriate outreach materials and interpreter services.']
  last_modified_timestamp timestamp [note: 'Timestamp when the recall list entry was last updated or modified.']
  last_outreach_date date [note: 'Date of the most recent outreach attempt to the patient for this recall.']
  last_outreach_method varchar [note: 'Method used for the most recent outreach attempt (phone, mail, patient portal, text message, email, in-person).']
  last_service_date date [note: 'The date of the last completed service or appointment that established the baseline for calculating the recall date.']
  mrn varchar [note: 'The unique medical record number assigned to the patient by the healthcare organization. Protected Health Information (PHI) under HIPAA.']
  notes varchar
  outreach_attempt_count varchar [note: 'Number of outreach attempts made to contact the patient for recall scheduling (phone calls, letters, patient portal messages, text messages).']
  patient_response varchar [note: 'Patient response to the recall outreach (no response, agreed to schedule, declined, requested callback, wrong contact information, deceased).']
  patient_response_date date [note: 'Date when the patient responded to the recall outreach.']
  priority_level varchar [note: 'Priority level assigned to the recall based on clinical urgency, risk stratification, and quality measure deadlines (routine, high, urgent, critical).']
  quality_measure_numerator_eligible boolean [note: 'Indicates whether completing this recall would make the patient eligible for the numerator of the associated quality measure.']
  recall_category varchar [note: 'High-level category of the recall to support population health segmentation and reporting (preventive care, chronic disease management, post-procedure surveillance, care gap closure, immunization, screening, wellness). [ENUM-REF-CANDIDATE: preventive_care|chronic_disease_management|post_procedure_surveillance|care_gap_closure|immunization|screening|wellness — 7 candidates stripped; promote to reference product]']
  recall_completion_date date [note: 'Date when the recall was completed (patient attended the appointment and received the service).']
  recall_expiration_date date [note: 'Date after which the recall is considered expired and may be closed or escalated. Typically set based on quality measure reporting deadlines or clinical urgency.']
  recall_interval_months varchar [note: 'The standard recall interval in months for this type of service or condition (e.g., 12 months for annual wellness visit, 6 months for diabetes A1C, 24 months for colonoscopy follow-up).']
  recall_list_status varchar
  recall_reason varchar [note: 'Free-text description of the clinical reason for the recall (e.g., annual wellness visit, mammography screening, diabetes A1C follow-up, post-surgical follow-up).']
  recall_reason_code varchar [note: 'Standardized code representing the recall reason. May use SNOMED CT, LOINC, or internal coding system to classify the type of recall.']
  recall_status varchar [note: 'Current status of the recall entry in the workflow (pending, outreach in progress, scheduled, completed, cancelled, expired, patient declined). [ENUM-REF-CANDIDATE: pending|outreach_in_progress|scheduled|completed|cancelled|expired|patient_declined — 7 candidates stripped; promote to reference product]']
  source_system_identifier varchar [note: 'Unique identifier for this recall entry in the source system. Used for data reconciliation and lineage tracking.']
  star_measure_applicable boolean [note: 'Indicates whether this recall is applicable to Medicare STAR quality ratings for Medicare Advantage plans.']
  target_recall_date date [note: 'The target date by which the patient should be recalled for the follow-up appointment or service. Calculated based on clinical guidelines and recall interval.']
  transportation_assistance_needed boolean [note: 'Indicates whether the patient requires transportation assistance to attend the recall appointment. Supports Social Determinants of Health (SDOH) interventions.']
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutator to satisfy target entity touch']
  vibe_mutation_flag boolean [note: 'Added by VIBE mutator to ensure model change.']
  vibe_structure_marker varchar [note: 'Marks product as part of the required ECM structure.']

  Note: 'Recall lists'
}

Table scheduling.provider_availability {
  provider_availability_id varchar [pk, note: 'Unique identifier for the provider availability record. Primary key.']
  care_site_id varchar [note: 'Identifier of the facility where the provider availability applies.']
  clinician_id varchar [note: 'Identifier of the provider whose availability is being recorded. Links to the provider master data.']
  primary_provider_employee_id varchar [note: 'Identifier of the user who requested or created this availability record.']
  provider_employee_id varchar
  schedulable_resource_id varchar
  schedule_template_id varchar [note: 'Identifier of the schedule template that this availability record modifies or overrides, if applicable.']
  tertiary_provider_cancelled_by_user_employee_id varchar [note: 'Identifier of the user who cancelled this availability record.']
  workforce_org_unit_id varchar [note: 'Identifier of the department or service line where the provider is available.']
  accepts_new_patients boolean [note: 'Boolean indicator (True/False) whether the provider is accepting new patient appointments during this availability period.']
  accepts_new_patients_flag boolean
  approval_timestamp timestamp [note: 'The date and time when this availability record was approved. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.']
  availability_status varchar [note: 'Current status of the availability record in its lifecycle.']
  availability_type varchar [note: 'The type of availability record: scheduled (normal working hours), on_call (available for urgent calls), blocked (time blocked for non-clinical work), vacation (time off), cme (Continuing Medical Education), administrative (administrative duties).']
  booked_appointments varchar [note: 'The current count of appointments already booked during this availability period. Used for capacity management.']
  cancellation_reason varchar [note: 'Free-text description of why this availability record was cancelled.']
  cancellation_timestamp timestamp [note: 'The date and time when this availability record was cancelled. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.']
  care_setting varchar [note: 'The care setting or service location where the provider is available: inpatient, outpatient, emergency department, surgical suite, telehealth, or home health.']
  coverage_area varchar [note: 'Geographic or organizational coverage area for on-call availability. Examples: entire hospital, specific units, regional coverage.']
  created_timestamp timestamp [note: 'The date and time when this availability record was first created in the system. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.']
  credentialing_status varchar [note: 'The credentialing status of the provider at the facility during this availability period. Must be active for scheduling.']
  day_of_week varchar
  duration_minutes varchar [note: 'The total duration of the availability period in minutes, calculated from start to end datetime.']
  effective_end_date date [note: 'The date when this availability record expires and is no longer valid for scheduling. Null indicates no expiration. Format: yyyy-MM-dd.']
  effective_start_date date [note: 'The date when this availability record becomes effective for scheduling purposes. Format: yyyy-MM-dd.']
  end_datetime timestamp [note: 'The date and time when the provider availability period ends. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.']
  end_time timestamp
  insurance_type_accepted varchar [note: 'Comma-separated list of insurance types or payer categories accepted during this availability period. Examples: Medicare, Medicaid, Commercial, Self-Pay.']
  last_modified_timestamp timestamp [note: 'The date and time when this availability record was last updated or modified. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.']
  location_code varchar
  max_appointments varchar [note: 'The maximum number of appointments that can be scheduled during this availability period. Null indicates no specific limit.']
  notes varchar [note: 'Free-text notes or comments about this availability record. May include special instructions, constraints, or context.']
  npi varchar [note: 'The 10-digit National Provider Identifier assigned by CMS to uniquely identify the healthcare provider.']
  on_call_type varchar [note: 'The type of on-call availability when availability_type is on_call: primary (first responder), backup (secondary coverage), home (available from home), hospital (on-site coverage).']
  overbooking_allowed boolean [note: 'Boolean indicator (True/False) whether overbooking beyond max_appointments is permitted during this availability period.']
  overbooking_limit varchar [note: 'The maximum number of overbooked appointments allowed beyond the standard max_appointments capacity.']
  override_flag boolean [note: 'Boolean indicator (True/False) that identifies whether this availability record is an exception or override to the provider\'s standard schedule template.']
  patient_class varchar [note: 'The patient classification or visit type that this availability supports.']
  priority_level varchar [note: 'The priority level of appointments that can be scheduled during this availability period.']
  privilege_code varchar [note: 'The clinical privilege code or category that the provider holds at this facility, defining the scope of services they can provide.']
  provider_npi varchar
  recurrence_end_date date [note: 'The date when a recurring availability pattern ends. Null for one-time availability records. Format: yyyy-MM-dd.']
  recurrence_pattern varchar [note: 'Indicates whether this availability record is a one-time event or part of a recurring pattern.']
  remaining_capacity varchar [note: 'The number of additional appointments that can still be scheduled during this availability period, calculated as max_appointments minus booked_appointments.']
  session_type varchar
  slot_duration_minutes decimal
  source_system_identifier varchar [note: 'The unique identifier for this availability record in the source system.']
  specialty_code varchar [note: 'The medical specialty or service line code for which the provider is available during this period.']
  start_datetime timestamp [note: 'The date and time when the provider availability period begins. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.']
  start_time timestamp
  telehealth_enabled boolean [note: 'Boolean indicator (True/False) whether the provider is available for telehealth appointments during this period.']
  telehealth_enabled_flag boolean
  unavailability_reason varchar [note: 'Free-text description of the reason for unavailability when availability_type is blocked, vacation, cme, or administrative. Examples: conference attendance, personal leave, training, committee meeting.']
  unavailability_reason_code varchar [note: 'Standardized code representing the reason for unavailability. Used for reporting and analytics.']
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutator to satisfy target entity touch']
  vibe_mutation_flag boolean [note: 'Added by VIBE mutator to ensure model change.']
  vibe_structure_marker varchar [note: 'Marks product as part of the required ECM structure.']

  Note: 'Provider availability'
}

Table scheduling.surgical_case_team {
  surgical_case_team_id varchar [pk, note: 'Unique identifier for the surgical case team assignment record. Primary key for this entity.']
  clinician_id varchar
  credential_id varchar
  primary_surgical_employee_id varchar [note: 'System user identifier of the person who verified the team member\'s credentials and privileges for this case.']
  privileging_id varchar
  surgical_case_id varchar [note: 'Reference to the surgical case for which this team member is assigned. Links to the surgical_case product.']
  surgical_employee_id varchar
  tertiary_surgical_cancelled_by_user_employee_id varchar [note: 'System user identifier of the person who cancelled this team member assignment.']
  training_completion_id varchar [note: 'Foreign key linking to compliance.training_completion. Business justification: Surgical team members require procedure-specific training verification including scrub technique, equipment operation, and specialty certifications. Joint Commission and medical staff bylaws requireme']
  actual_end_datetime timestamp [note: 'The actual date and time when the team member completed their participation in the surgical case. Used for time tracking and billing.']
  actual_end_time timestamp
  actual_start_datetime timestamp [note: 'The actual date and time when the team member began their participation in the surgical case. Used for time tracking and billing.']
  actual_start_time timestamp
  anesthesiologist_npi varchar [note: 'National Provider Identifier of the anesthesiologist or CRNA (Certified Registered Nurse Anesthetist) assigned to the case. Used for anesthesia billing and quality tracking. [Moved from surgical_case: This attribute represents the anesthesiologist clinician-case relationship. In the M:N model, this becomes a record in surgical_case_team with team_role_code=\'ANESTHESIOLOGIST\' or \'CRNA\'. The current model cannot represent cases with multiple anesthesia providers or CRNA+anesthesiologist teams.]']
  assignment_datetime varchar
  assignment_notes varchar [note: 'Free-text notes regarding this team member assignment. May include special requirements, preferences, or coordination details.']
  assignment_priority varchar [note: 'Numeric priority ranking of this team member assignment relative to other assignments for the same case. Lower numbers indicate higher priority. Used for scheduling conflict resolution.']
  assignment_status varchar [note: 'Current status of the team member assignment. Tracks the lifecycle from scheduling through completion or cancellation.']
  assisting_surgeon_npi varchar [note: 'National Provider Identifier of the assisting surgeon, if applicable. Used for billing assistant surgeon charges and documenting surgical team composition. [Moved from surgical_case: This attribute represents another specific clinician-case relationship (the assisting surgeon role). In the M:N model, this becomes a record in surgical_case_team with team_role_code=\'ASSISTING_SURGEON\'. The current model artificially limits cases to one assisting surgeon.]']
  billable_flag boolean [note: 'Indicates whether this team member\'s participation is billable to the patient or payer. True if billable, False if non-billable (e.g., resident supervision, observation).']
  billing_modifier_code varchar [note: 'CPT or HCPCS modifier code applied to this team member\'s billing for the surgical case. Used to indicate special circumstances (e.g., assistant surgeon, co-surgeon, teaching physician).']
  board_certification_status varchar [note: 'Current status of the team member\'s board certification in their specialty. Used for quality reporting and credentialing.']
  call_status varchar [note: 'Indicates whether the team member is scheduled, on-call, backup, or responding to an emergency for this case. Used for staffing and scheduling analytics.']
  cancellation_datetime timestamp [note: 'The date and time when this team member assignment was cancelled. Null if assignment was not cancelled.']
  cancellation_reason varchar [note: 'Reason why this team member assignment was cancelled. May include provider unavailability, case cancellation, or scheduling changes.']
  confirmation_datetime timestamp [note: 'The date and time when the team member confirmed their participation in the surgical case.']
  confirmation_status varchar [note: 'Status indicating whether the team member has confirmed their availability and commitment to participate in this surgical case.']
  conflict_description varchar [note: 'Detailed description of any scheduling conflict identified for this team member assignment. Includes conflicting case number or appointment details.']
  conflict_flag boolean [note: 'Indicates whether this team member assignment has a scheduling conflict with another commitment. True if conflict exists, False otherwise.']
  created_timestamp timestamp [note: 'The date and time when this team member assignment record was first created in the system. Used for audit trail and data lineage.']
  credentialing_verification_datetime timestamp [note: 'The date and time when the team member\'s credentials and privileges were verified for this surgical case.']
  credentialing_verified_flag boolean [note: 'Indicates whether the team member\'s credentials and privileges have been verified for this specific surgical case. True if verified, False if not verified or pending.']
  last_modified_timestamp timestamp [note: 'The date and time when this team member assignment record was last modified. Used for audit trail and change tracking.']
  license_number varchar [note: 'The professional license number of the team member. Required for regulatory compliance and credentialing verification.']
  license_state varchar [note: 'Two-letter state code where the team member\'s professional license was issued. Must match the facility\'s state or have reciprocity agreement.']
  notes varchar
  participation_duration_minutes varchar [note: 'Total duration in minutes of the team member\'s actual participation in the surgical case. Calculated from actual start and end times.']
  primary_flag boolean
  primary_role_flag boolean [note: 'Indicates whether this team member holds the primary responsibility for their role category (e.g., primary surgeon vs. assisting surgeon). True if primary, False if secondary or assisting.']
  primary_surgeon_name varchar [note: 'Full name of the primary surgeon. Used for operational communication, patient information, and surgical schedule displays. [Moved from surgical_case: Denormalized display attribute derived from the primary surgeon relationship. Should be removed as it can be derived from the surgical_case_team association joined to clinician.]']
  primary_surgeon_npi varchar [note: 'National Provider Identifier of the primary surgeon responsible for the surgical case. Ten-digit unique identifier assigned by CMS. Used for credentialing, billing, and quality reporting. [Moved from surgical_case: This attribute represents one specific clinician-case relationship (the primary surgeon role). In the M:N model, this becomes a record in surgical_case_team with team_role_code=\'PRIMARY_SURGEON\'. Storing it as a single attribute on surgical_case violates normalization and prevents tracking multiple surgeons or role changes.]']
  privilege_code varchar [note: 'Code representing the specific clinical privilege that authorizes this team member to perform their role in this surgical case. Links to the provider\'s credentialing and privileging records.']
  privilege_verified_flag boolean
  provider_npi varchar
  quality_measure_applicable_flag boolean [note: 'Indicates whether this team member assignment is subject to quality measurement or reporting requirements. True if applicable, False otherwise.']
  relief_flag boolean
  replacement_team_member_npi varchar [note: 'The NPI of the replacement team member if this assignment was substituted. Used to track last-minute staffing changes.']
  requested_datetime timestamp [note: 'The date and time when this team member was requested for assignment to the surgical case.']
  role_code varchar
  role_status varchar
  scheduled_end_datetime timestamp [note: 'The date and time when the team member is scheduled to complete their participation in the surgical case.']
  scheduled_start_datetime timestamp [note: 'The date and time when the team member is scheduled to begin their participation in the surgical case.']
  scrub_time_minutes varchar [note: 'Time in minutes spent by the team member in surgical scrub preparation. Applicable to scrubbed team members (surgeons, scrub techs).']
  source_system_identifier varchar [note: 'Unique identifier for this team member assignment in the source system. Used for data lineage and reconciliation.']
  specialty_code varchar [note: 'Code representing the medical specialty or clinical discipline of the team member (e.g., orthopedic surgery, cardiothoracic surgery, anesthesiology).']
  supervising_provider_npi varchar [note: 'The NPI of the attending physician or supervising provider if this team member is a resident, fellow, or student. Required for teaching case billing compliance.']
  teaching_case_flag boolean [note: 'Indicates whether this is a teaching case with resident or student participation under supervision. True if teaching case, False otherwise. Impacts billing and documentation requirements.']
  team_member_name varchar [note: 'Full legal name of the care team member assigned to this surgical case. Used for case documentation and credentialing verification.']
  team_member_npi varchar [note: 'The 10-digit National Provider Identifier for the team member assigned to this surgical case. Required for billing and credentialing verification.']
  team_role varchar
  team_role_code varchar [note: 'Standardized code representing the role of the team member in the surgical case. Values: SURGEON (primary surgeon), CO_SURGEON (assisting surgeon), ANESTHESIOLOGIST (physician anesthesiologist), CRNA (Certified Registered Nurse Anesthetist), SCRUB_TECH (scrub technician), CIRCULATING_NURSE (circulating nurse). [ENUM-REF-CANDIDATE: SURGEON|CO_SURGEON|ANESTHESIOLOGIST|CRNA|SCRUB_TECH|CIRCULATING_NURSE|PERFUSIONIST|FIRST_ASSIST|SURGICAL_RESIDENT|ANESTHESIA_RESIDENT|STUDENT_NURSE — promote to reference product]']
  team_role_description varchar [note: 'Human-readable description of the team member\'s role and responsibilities during the surgical case.']
  time_in_room_minutes varchar [note: 'Total time in minutes that the team member spent in the operating room for this case. Used for efficiency and utilization analysis.']
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutator to satisfy target entity touch']
  vibe_mutation_flag boolean [note: 'Added by VIBE mutator to ensure model change.']
  vibe_structure_marker varchar [note: 'Marks product as part of the required ECM structure.']

  Note: 'Surgical case team'
}

Table scheduling.booking_queue {
  booking_queue_id varchar [pk, note: 'Primary key for booking_queue']
  booking_appointment_type_id varchar
  booking_clinician_id varchar
  booking_requested_appointment_type_id varchar [note: 'Reference to the type of appointment being requested. Links to appointment type reference data for scheduling parameters.']
  booking_workforce_org_unit_id varchar
  care_site_id varchar [note: 'Reference to the healthcare facility where the appointment is requested. Links to facility master data.']
  claim_prior_authorization_id varchar [note: 'Foreign key linking to claim.prior_authorization. Business justification: Scheduling queues track authorization requirements for pending appointments. Queue processors verify authorization status before booking, linking authorization records to ensure services are approved ']
  clinical_order_id varchar [note: 'Reference to the clinical order that generated this scheduling request. Links to order management system for order-based queue entries.']
  demographics_id varchar [note: 'Reference to the patient requiring scheduling. Links to the patient master record.']
  diagnosis_id varchar [note: 'Foreign key linking to clinical.clinical_diagnosis. Business justification: Booking queue entries include diagnosis information for centralized scheduling triage, specialty routing, and urgency determination. Essential for access management and appropriate specialty assignmen']
  health_plan_id varchar [note: 'Foreign key linking to insurance.health_plan. Business justification: Booking queues verify plan-specific network restrictions, benefit requirements, and authorization criteria before scheduling. Queue assignment logic routes patients to in-network providers based on pl']
  insurance_coverage_id varchar [note: 'Reference to the patients active insurance coverage for this appointment. Used for eligibility verification and authorization checks.']
  mpi_record_id varchar
  payer_id varchar [note: 'Foreign key linking to insurance.payer. Business justification: Booking queues prioritize patients by payer authorization status and track payer-specific scheduling requirements. Queue aging and escalation rules vary by payer timely filing limits and authorization']
  primary_booking_clinician_id varchar [note: 'Reference to the provider who initiated the scheduling request or referral. Links to provider master data.']
  primary_booking_employee_id varchar [note: 'Reference to the individual scheduler assigned to work this queue entry. May be null if not yet assigned to a specific person.']
  primary_booking_requested_department_workforce_org_unit_id varchar [note: 'Reference to the specific department or clinic within the facility where the appointment is requested.']
  scheduling_appointment_id varchar [note: 'Reference to the appointment that was created to fulfill this queue entry. Populated when queue status transitions to scheduled.']
  subject_enrollment_id varchar [note: 'Foreign key linking to research.subject_enrollment. Business justification: Research subjects queued for protocol-required appointments must link to enrollment records for visit window tracking and protocol compliance. Centralized scheduling teams process research appointment']
  visit_reason_icd_code_id varchar [note: 'Foreign key linking to reference.icd_code. Business justification: Booking queue visit reason ICD codes enable clinical triage, authorization requirement determination, specialty routing, and SLA prioritization. Essential for centralized scheduling operations and acc']
  waitlist_entry_id varchar
  aging_days varchar [note: 'Number of calendar days the queue entry has been open since queue entry datetime. Used for aging reports and escalation triggers.']
  assigned_to_user_name varchar
  authorization_required_flag boolean [note: 'Indicates whether insurance prior authorization is required before scheduling. Blocks scheduling until authorization is obtained.']
  care_setting varchar [note: 'The care delivery setting where the appointment will take place. Determines scheduling rules and resource requirements.']
  created_timestamp timestamp [note: 'System timestamp when the queue entry record was first created in the database. Used for audit trail and data lineage.']
  current_depth varchar
  enqueued_timestamp timestamp
  escalation_datetime timestamp [note: 'The date and time when the queue entry was escalated. Null if never escalated.']
  escalation_flag boolean [note: 'Indicates whether this queue entry has been escalated due to Service Level Agreement (SLA) breach, clinical urgency, or patient complaint.']
  escalation_reason varchar [note: 'Free-text explanation of why the queue entry was escalated. Documents clinical, operational, or patient satisfaction concerns.']
  interpreter_required_flag boolean [note: 'Indicates whether a medical interpreter is required for the appointment. Triggers interpreter scheduling and resource allocation.']
  language_preference varchar [note: 'The patients preferred language for communication and care delivery. ISO 639-1 two-letter language code or full language name.']
  last_modified_timestamp timestamp [note: 'System timestamp when the queue entry record was last updated. Used for audit trail and change tracking.']
  last_outreach_datetime timestamp [note: 'The date and time of the most recent outreach attempt to the patient. Used for follow-up scheduling and compliance tracking.']
  last_outreach_method varchar [note: 'The communication channel used for the most recent patient outreach attempt. Informs next-best-action for follow-up.']
  mrn varchar [note: 'The unique medical record number assigned to the patient by the healthcare organization. Protected Health Information (PHI) under HIPAA.']
  notes varchar [note: 'Free-text notes and comments added by scheduling staff during queue processing. Documents special instructions, patient requests, or workflow issues.']
  outreach_attempt_count varchar [note: 'Number of times scheduling staff have attempted to contact the patient to schedule the appointment. Used for tracking patient engagement.']
  preferred_contact_channel varchar [note: 'The patients preferred method of communication for scheduling coordination. Captured from patient preferences or registration data.']
  preferred_days_of_week varchar [note: 'Comma-separated list of days of the week the patient prefers for appointments (e.g., Monday, Wednesday, Friday). Used for slot matching.']
  preferred_time_of_day varchar [note: 'The time of day the patient prefers for appointments. Used to optimize patient satisfaction and reduce no-shows.']
  priority_level varchar [note: 'Clinical or operational priority assigned to the scheduling request. Determines urgency and Service Level Agreement (SLA) targets.']
  processed_timestamp timestamp
  queue_code varchar
  queue_entry_datetime timestamp [note: 'The date and time when the scheduling request was added to the queue. Used for aging calculations and Service Level Agreement (SLA) tracking.']
  queue_name varchar
  queue_number varchar [note: 'Human-readable business identifier for the queue entry. Used for tracking and reference by scheduling staff.']
  queue_position varchar
  queue_status varchar [note: 'Current lifecycle status of the queue entry. Tracks progression through the scheduling workflow from initial entry to resolution.']
  queue_type varchar [note: 'Classification of the scheduling queue entry by source or purpose. Determines workflow routing and handling procedures.']
  record_number varchar [note: 'Foreign key linking to consent.consent_record. Business justification: Booking queues track consent status as scheduling prerequisite. Scheduling staff verify consent obtained before finalizing appointment. Prevents booking procedures without required informed consent, s']
  removal_datetime timestamp [note: 'The date and time when the queue entry was removed from the active queue (scheduled, cancelled, or closed). Used for queue throughput metrics.']
  removal_reason varchar [note: 'Free-text explanation of why the queue entry was removed or closed. Documents resolution outcome or cancellation rationale.']
  routing_rule varchar
  scheduled_datetime timestamp [note: 'The date and time when the appointment was successfully scheduled and the queue entry was resolved. Used for cycle time reporting.']
  sla_target_datetime timestamp [note: 'The target date and time by which the scheduling request must be resolved to meet Service Level Agreement (SLA) commitments. Calculated based on priority and queue entry time.']
  sla_target_hours varchar
  source_system_identifier varchar
  specialty_code varchar
  specialty_required varchar [note: 'Medical specialty or subspecialty required for the appointment. Used for provider matching and resource allocation.']
  telehealth_eligible_flag boolean [note: 'Indicates whether the appointment type and patient circumstances allow for telehealth delivery. Used for virtual visit scheduling options.']
  transportation_assistance_needed_flag boolean [note: 'Indicates whether the patient requires transportation assistance to attend the appointment. May trigger coordination with transportation services.']
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutator to satisfy target entity touch']
  vibe_mutation_flag boolean [note: 'Added by VIBE mutator to ensure model change.']
  vibe_structure_marker varchar [note: 'Marks product as part of the required ECM structure.']
  visit_reason varchar [note: 'Free-text description of the reason for the appointment or clinical indication. Captured from referral or order documentation.']
  visit_reason_code varchar [note: 'Standardized code representing the reason for visit. May use ICD-10 (International Classification of Diseases 10th Revision), CPT (Current Procedural Terminology), or internal reason codes.']
  wait_time_minutes varchar

  Note: 'Booking queue'
}

Table scheduling.equipment_reservation {
  equipment_reservation_id varchar [pk, note: 'Unique identifier for the equipment reservation record. Primary key.']
  care_site_id varchar [note: 'Reference to the healthcare facility where the equipment is reserved and the procedure will take place. Links to facility master data.']
  clinician_id varchar [note: 'Reference to the physician or clinical provider who requested the equipment reservation. Links to provider master data.']
  equipment_asset_id varchar [note: 'Reference to the specific equipment asset being reserved. Links to the schedulable resource or equipment master record.']
  fixed_asset_id varchar [note: 'Foreign key linking to finance.fixed_asset. Business justification: Equipment reservations reference capital assets requiring depreciation tracking, utilization-based ROI analysis, and capital planning. Links reservation usage to asset financial records for equipment ']
  or_suite_id varchar [note: 'Reference to the specific operating room or procedure suite where the equipment will be used. Links to room master data.']
  primary_equipment_employee_id varchar [note: 'Reference to the system user who confirmed the equipment reservation. Links to user or staff master data for audit trail.']
  procedure_event_id varchar [note: 'Reference to the specific procedure event requiring this equipment. May link to non-surgical procedures such as interventional radiology or cardiac catheterization.']
  reserved_material_master_id varchar [note: 'Foreign key linking to supply.material_master. Business justification: Reservable equipment includes supply-chain-managed portable devices, instruments, and consumable kits tracked as material master items (not fixed assets). Enables unified asset tracking, maintenance s']
  resource_assignment_id varchar
  room_id varchar
  scheduling_appointment_id varchar [note: 'Reference to the outpatient appointment requiring this equipment. Used when specialized equipment is needed for clinic-based procedures.']
  surgical_case_id varchar [note: 'Reference to the surgical case for which this equipment is reserved. Links to the surgical case scheduling record in OpTime or equivalent surgical scheduling system.']
  tertiary_equipment_requested_by_user_employee_id varchar [note: 'Reference to the system user who created the equipment reservation request. Links to user or staff master data for audit trail.']
  workforce_org_unit_id varchar [note: 'Reference to the clinical department or service line requesting the equipment. Links to organizational unit master data.']
  actual_duration_minutes varchar [note: 'Actual duration the equipment was in use, measured in minutes. Calculated from actual start to actual end times for utilization analysis.']
  actual_end_datetime timestamp [note: 'Actual date and time when the equipment was released from use. Marks the true end of equipment utilization for the case or procedure.']
  actual_start_datetime timestamp [note: 'Actual date and time when the equipment was deployed and in-use began. Captures real-world utilization for performance tracking and billing.']
  billable_flag boolean [note: 'Indicates whether the equipment usage is billable to the patient or payer. Used for revenue cycle management and charge capture.']
  cancellation_datetime timestamp [note: 'Date and time when the equipment reservation was cancelled. Used for utilization analysis and no-show tracking.']
  cancellation_reason varchar [note: 'Detailed explanation of why the equipment reservation was cancelled. Supports root cause analysis and process improvement.']
  cancellation_reason_code varchar [note: 'Standardized code representing the category of cancellation reason. Enables structured analysis of cancellation patterns.']
  cancelled_datetime timestamp
  charge_code varchar [note: 'Revenue code or charge code associated with the equipment usage. Links to the Charge Description Master (CDM) for billing.']
  confirmation_datetime timestamp [note: 'Date and time when the equipment reservation was confirmed by the equipment management or scheduling team.']
  confirmation_status varchar [note: 'Status of the reservation confirmation process. Tracks whether the equipment availability has been verified and confirmed by the equipment management team.']
  conflict_description varchar [note: 'Detailed description of the scheduling conflict, including overlapping reservations or maintenance windows. Provides context for conflict resolution.']
  conflict_flag boolean [note: 'Indicates whether this reservation has a scheduling conflict with another reservation or maintenance window. Triggers manual review and resolution.']
  created_timestamp timestamp [note: 'System timestamp when this equipment reservation record was first created in the database. Used for audit trail and data lineage.']
  duration_minutes varchar [note: 'Planned duration of the equipment reservation in minutes. Calculated from scheduled start to scheduled end times.']
  equipment_asset_tag varchar [note: 'Physical asset tag identifier affixed to the equipment unit. Used for tracking and inventory management of the specific device instance.']
  equipment_type varchar [note: 'Category of specialized medical equipment being reserved. Defines the class of device required for the procedure. [ENUM-REF-CANDIDATE: c-arm|surgical_robot|laser|perfusion_pump|specialized_or_table|microscope|endoscopy_tower|lithotripsy|cryotherapy|ultrasound|fluoroscopy — 11 candidates stripped; promote to reference product]']
  last_maintenance_date date [note: 'Date of the most recent preventive maintenance or inspection performed on the equipment. Used to verify equipment readiness and compliance.']
  last_modified_timestamp timestamp [note: 'System timestamp when this equipment reservation record was last updated. Used for audit trail and change tracking.']
  maintenance_clearance_flag boolean [note: 'Indicates whether the equipment has passed all required maintenance checks and is cleared for clinical use. Ensures patient safety and device reliability.']
  notes varchar [note: 'Free-text notes or special instructions related to the equipment reservation. Captures additional context not covered by structured fields.']
  procedure_code varchar [note: 'Primary procedure code for the case or appointment requiring this equipment. Typically a CPT or ICD-10-PCS code identifying the clinical intervention.']
  procedure_description varchar [note: 'Human-readable description of the procedure or surgical case requiring the equipment. Provides clinical context for the reservation.']
  requested_datetime timestamp [note: 'Date and time when the equipment reservation was initially requested. Marks the beginning of the reservation lifecycle for lead time analysis.']
  requesting_provider_npi varchar [note: 'National Provider Identifier of the physician or clinical provider requesting the equipment. Ten-digit unique identifier assigned by CMS.']
  reservation_number varchar [note: 'Human-readable business identifier for the equipment reservation. Externally visible tracking number used by clinical and operational staff.']
  reservation_priority varchar [note: 'Clinical priority level of the equipment reservation. Determines scheduling precedence and conflict resolution rules.']
  reservation_status varchar [note: 'Current lifecycle status of the equipment reservation. Tracks the reservation from initial request through completion or cancellation. [ENUM-REF-CANDIDATE: requested|pending_approval|confirmed|in_use|released|cancelled|conflict|on_hold — 8 candidates stripped; promote to reference product]']
  reservation_type varchar
  reserved_end_datetime varchar
  reserved_start_datetime varchar
  scheduled_end_datetime timestamp [note: 'Planned date and time when the equipment reservation ends. Marks the conclusion of the reserved time block including any required turnover time.']
  scheduled_start_datetime timestamp [note: 'Planned date and time when the equipment reservation begins. Marks the start of the reserved time block for equipment availability.']
  source_system_identifier varchar
  specialty_code varchar [note: 'Medical specialty code associated with the procedure requiring this equipment. Used for equipment allocation and utilization analysis by service line.']
  sterilization_batch_number varchar [note: 'Batch or lot number from the sterilization cycle applied to this equipment. Used for infection control tracking and recall management.']
  sterilization_clearance_datetime timestamp [note: 'Date and time when the equipment was cleared as sterile and available for use. Critical for infection prevention and equipment readiness.']
  sterilization_clearance_flag boolean
  sterilization_required_flag boolean [note: 'Indicates whether the equipment requires sterilization before or after use. Critical for infection control and equipment availability planning.']
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutator to satisfy target entity touch']
  vibe_mutation_flag boolean [note: 'Added by VIBE mutator to ensure model change.']
  vibe_structure_marker varchar [note: 'Marks product as part of the required ECM structure.']

  Note: 'Equipment reservations'
}

Table scheduling.case_material_usage {
  case_material_usage_id varchar [pk, note: 'Unique surrogate identifier for each surgical case material usage transaction record. Primary key for the association.']
  cdm_entry_id varchar
  employee_id varchar [note: 'Identifier of the clinical or OR staff member who documented this material usage in the perioperative system. Used for accountability and audit compliance.']
  material_master_id varchar [note: 'Foreign key linking to the material master record identifying the specific supply item, implant, or consumable used in this case.']
  surgical_bom_id varchar
  surgical_case_id varchar [note: 'Foreign key linking to the surgical case during which this material was consumed. Establishes the clinical and temporal context for material usage.']
  udi_record_id varchar
  billable_flag boolean [note: 'Indicates whether this material usage is billable to the patient, payer, or included in the case bundled payment. Drives charge capture and revenue cycle workflows.']
  charge_amount decimal(18,2)
  charge_captured_flag boolean
  charge_code varchar [note: 'Revenue code, CPT code, or HCPCS code used for billing this material item to the payer. Links supply usage to charge master and claim generation workflows.']
  created_timestamp timestamp
  implant_flag boolean [note: 'Indicates whether this material item was implanted in the patient during the surgical case. Triggers mandatory UDI documentation, patient implant registry updates, and enhanced traceability requirements.']
  last_modified_timestamp timestamp
  lot_number varchar [note: 'Manufacturer\'s lot or batch number for the material item used in this case. Required for traceability, recall management, and quality control. Mandatory for implantable devices and sterile supplies.']
  material_code varchar
  material_description varchar
  quantity_used decimal(18,4) [note: 'Numeric quantity of the material item consumed during the surgical case, expressed in the material\'s stocking unit of measure. Used for inventory depletion, cost calculation, and utilization analytics.']
  quantity_wasted varchar
  serial_number varchar [note: 'Unique serial number for the specific material item instance used in this case. Required for FDA UDI compliance for implantable devices. Enables patient-level device tracking and recall notification.']
  source_system_identifier varchar
  total_cost decimal(18,2)
  udi_device_identifier varchar
  unit_cost decimal(18,4) [note: 'Actual cost per unit of the material item at the time of case consumption. Captured from contract pricing or catalog pricing at time of use. Used for case-level cost accounting and margin analysis.']
  unit_of_measure varchar
  usage_timestamp timestamp [note: 'Date and time when the material item was documented as used or implanted during the surgical case. Used for intraoperative timeline reconstruction and audit trails.']
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutator to satisfy target entity touch']
  vibe_mutation_flag boolean [note: 'Added by VIBE mutator to ensure model change.']
  vibe_structure_marker varchar [note: 'Marks product as part of the required ECM structure.']
  waste_flag boolean [note: 'Indicates whether this material was opened/prepared for the case but not used (wasted). Used for waste reduction analytics, cost variance analysis, and supply chain optimization.']

  Note: 'Case material usage'
}

Table scheduling.appointment_prior_auth_requirement {
  appointment_prior_auth_requirement_id varchar [pk, note: 'Unique identifier for this appointment type prior authorization requirement record. Primary key.']
  appointment_type_id varchar [note: 'Foreign key linking to the appointment type that is subject to prior authorization requirements']
  cpt_code_id varchar
  health_plan_id varchar
  payer_id varchar
  prior_auth_rule_id varchar [note: 'Foreign key linking to the payer-specific prior authorization rule that applies to this appointment type']
  scheduling_appointment_id varchar
  appointment_prior_auth_requirement_status varchar [note: 'Current lifecycle status of this appointment type prior authorization requirement: active (in effect), inactive (not enforced), pending (scheduled to activate), superseded (replaced by newer rule).']
  auth_required_flag boolean
  authorization_number varchar
  authorization_required_flag boolean
  authorization_status varchar
  clinical_criteria_reference varchar [note: 'Reference to the clinical guideline, medical policy, or evidence-based criteria document that applies to prior authorization for this appointment type under this payer rule. May be appointment-type-specific criteria. Sourced from detection phase relationship data.']
  created_date timestamp [note: 'Timestamp when this appointment type prior authorization requirement record was created in the system.']
  created_timestamp timestamp
  denial_reason varchar
  diagnosis_icd_code varchar
  effective_date date [note: 'Date on which this prior authorization requirement becomes active for this appointment type under this payer rule. Sourced from detection phase relationship data.']
  effective_end_date date
  effective_start_date date
  expiration_date date
  last_modified_timestamp timestamp
  last_updated_date timestamp [note: 'Timestamp when this appointment type prior authorization requirement record was last modified.']
  notes varchar
  procedure_code varchar
  procedure_cpt_code varchar
  requirement_status varchar
  requires_prior_authorization boolean [note: 'Indicates whether this appointment type requires prior authorization from the payer before scheduling. Supports revenue cycle compliance and denial prevention. [Moved from appointment_type: This boolean flag on appointment_type is too coarse-grained. Prior authorization requirements are payer-specific and time-bound, not universal to the appointment type. The flag should be replaced by a query against this association to determine if PA is required for a given appointment type, payer, and date combination.]']
  service_category varchar
  source_system_identifier varchar
  submission_datetime timestamp
  submission_method varchar [note: 'Allowed method(s) for submitting the prior authorization request for this appointment type under this payer rule: portal, fax, phone, EDI 278, or multiple. May be appointment-type-specific override of base rule submission method. Sourced from detection phase relationship data.']
  termination_date date [note: 'Date on which this prior authorization requirement is no longer active for this appointment type under this payer rule. Null indicates ongoing requirement. Sourced from detection phase relationship data.']
  turnaround_time_hours varchar [note: 'Standard turnaround time in hours for the payer to respond to a prior authorization request for this appointment type. May differ from the base rule turnaround time if appointment-specific SLAs exist. Sourced from detection phase relationship data.']
  units_authorized varchar
  vibe_mutation_applied varchar [note: 'Added by VIBE mutation to ensure model change']
  vibe_mutation_flag boolean [note: 'Added by VIBE mutator to ensure model change.']
  vibe_structure_marker varchar [note: 'Marks product as part of the required ECM structure.']

  Note: 'Appointment prior auth requirements'
}

Table scheduling.reminder_template {
  reminder_template_id varchar [pk, note: 'Primary key for reminder_template']
  appointment_type_id varchar [note: 'Reference to the specific appointment type or visit category that this reminder template is designed to support.']
  care_site_id varchar [note: 'Reference to the healthcare facility or location where this reminder template is used for appointment scheduling.']
  compliance_policy_id varchar
  message_template_id varchar
  parent_reminder_template_id varchar [note: 'Self-referencing FK on reminder_template (parent_reminder_template_id)']
  primary_superseded_by_reminder_template_id varchar
  reminder_org_unit_id varchar [note: 'Reference to the clinical or administrative department that owns and manages this reminder template.']
  reminder_workforce_org_unit_id varchar
  specialty_id varchar [note: 'Reference to the medical specialty or service line for which this reminder template is configured.']
  active_flag boolean
  approval_status varchar
  approved_by varchar [note: 'Username or identifier of the user who approved this reminder template for production use.']
  approved_timestamp timestamp [note: 'Date and time when this reminder template was approved for production use.']
  cancellation_instructions varchar [note: 'Text instructions provided to the patient on how to cancel or reschedule the appointment, including contact information and deadlines.']
  confirmation_deadline_hours varchar [note: 'Number of hours before the appointment by which the patient must confirm, used for capacity planning and waitlist management.']
  contact_email varchar [note: 'Email address provided in the reminder for patients to contact the scheduling department or care team regarding their appointment.']
  contact_phone varchar [note: 'Phone number provided in the reminder for patients to call with questions, confirmations, or cancellations related to their appointment.']
  created_timestamp timestamp [note: 'Date and time when this reminder template record was first created in the system.']
  delivery_channel varchar [note: 'Communication channel through which the reminder is delivered to the patient or responsible party.']
  effective_end_date date [note: 'Date when this reminder template is no longer active and should not be used for new appointments. Null indicates no end date.']
  effective_start_date date [note: 'Date when this reminder template becomes active and available for use in scheduling workflows.']
  include_copay_estimate boolean [note: 'Indicates whether the reminder should include an estimated copay or out-of-pocket cost for the appointment.']
  include_insurance_reminder boolean [note: 'Indicates whether the reminder should include instructions to bring insurance cards and verify coverage before the appointment.']
  include_provider_info boolean [note: 'Indicates whether the reminder message should include provider name, credentials, and contact information.']
  is_default boolean [note: 'Indicates whether this template is the default reminder template for its associated appointment type, specialty, or department.']
  language_code varchar [note: 'ISO 639-1 language code (with optional ISO 3166-1 country code) indicating the language of the reminder message content.']
  last_modified_timestamp timestamp
  lead_time_days varchar
  location_details varchar [note: 'Detailed information about the appointment location including building name, floor, department, parking instructions, and check-in procedures.']
  max_attempts_allowed varchar
  max_send_attempts varchar [note: 'Maximum number of times the system should attempt to deliver the reminder if initial delivery fails.']
  message_body varchar [note: 'Full text content of the reminder message, including placeholders for dynamic data such as patient name, appointment date, location, and provider.']
  message_subject varchar [note: 'Subject line or title of the reminder message, used primarily for email and portal notifications.']
  modified_by varchar [note: 'Username or identifier of the user who last modified this reminder template record.']
  modified_timestamp timestamp [note: 'Date and time when this reminder template record was last modified in the system.']
  notes varchar [note: 'Administrative notes or comments about the reminder template, including usage guidelines, change history, or special considerations.']
  opt_out_enabled_flag boolean
  preparation_instructions varchar [note: 'Clinical or administrative instructions for patient preparation before the appointment, such as fasting requirements, medication holds, or documentation to bring.']
  priority_level varchar [note: 'Priority classification of the reminder indicating urgency and importance for delivery and patient response.']
  reminder_template_status varchar [note: 'Current lifecycle status of the reminder template indicating whether it is available for use in scheduling workflows.']
  reminder_type varchar
  requires_confirmation boolean [note: 'Indicates whether the reminder requires the patient to confirm or respond to the appointment notification.']
  retry_interval_minutes varchar [note: 'Number of minutes to wait between retry attempts if reminder delivery fails.']
  send_time_preference varchar [note: 'Preferred time of day (HH:MM format) when the reminder should be sent, respecting patient communication preferences and operational hours.']
  source_system_identifier varchar
  template_code varchar [note: 'Unique business code or identifier for the reminder template, used for system integration and external reference.']
  template_name varchar [note: 'Human-readable name of the reminder template used for identification and selection in scheduling workflows.']
  template_status varchar
  template_type varchar [note: 'Classification of the reminder template based on the type of appointment or care event it supports.']
  trigger_timing_days varchar [note: 'Number of days before the scheduled appointment when the reminder should be sent. Negative values indicate days after the appointment.']
  trigger_timing_hours varchar [note: 'Number of hours before the scheduled appointment when the reminder should be sent, used for same-day or precise timing requirements.']
  version_number varchar [note: 'Version number of the reminder template, incremented when content or configuration is updated to maintain audit trail and change history.']
  vibe_mutation_applied varchar [note: 'Added by VIBE mutation to ensure model change']
  vibe_mutation_flag boolean [note: 'Added by VIBE mutator to ensure model change.']
  vibe_structure_marker varchar [note: 'Marks product as part of the required ECM structure.']
  created_by varchar [note: 'Username or identifier of the user who created this reminder template record.']

  Note: 'Reminder templates'
}

Table scheduling.scheduling_appointment {
  scheduling_appointment_id varchar [pk, note: 'Primary key for the scheduling appointment record.']
  appointment_type_id varchar [note: 'FK to appointment type.']
  care_site_id varchar [note: 'FK to the care site where the appointment occurs.']
  demographics_id varchar [note: 'FK to patient demographics.']
  encounter_authorization_id varchar [note: 'FK to prior authorization for this appointment.']
  mpi_record_id varchar
  open_slot_id varchar
  referral_order_id varchar
  room_id varchar
  schedulable_resource_id varchar
  scheduling_clinician_id varchar [note: 'FK to the assigned clinician.']
  scheduling_provider_clinician_id varchar
  visit_id varchar [note: 'FK to the resulting encounter visit.']
  absorbed_from_appointment_flag boolean
  appointment_number varchar [note: 'Human-readable appointment reference number.']
  appointment_scope varchar
  appointment_status varchar [note: 'Current status of the appointment (scheduled, cancelled, completed, no-show).']
  booking_channel varchar [note: 'Channel through which the appointment was booked.']
  booking_timestamp timestamp [note: 'Timestamp when the appointment was booked.']
  cancellation_reason varchar [note: 'Reason for appointment cancellation.']
  cancellation_timestamp timestamp [note: 'Timestamp when the appointment was cancelled.']
  care_setting varchar
  check_in_datetime varchar
  check_in_timestamp timestamp
  check_out_datetime varchar
  check_out_timestamp timestamp
  confirmation_status varchar
  created_timestamp timestamp [note: 'Record creation timestamp.']
  duration_minutes varchar [note: 'Duration of the appointment in minutes.']
  insurance_verification_status varchar [note: 'Status of insurance eligibility verification.']
  interpreter_required_flag boolean
  is_telehealth boolean
  last_modified_timestamp timestamp
  mrn varchar
  mvm_ecm_reconciled_flag boolean
  mvm_source_names varchar [note: 'scheduling.appointment aligned to scheduling.scheduling_appointment']
  no_show_flag boolean [note: 'Indicates patient did not attend the appointment.']
  notes varchar
  reason_for_visit varchar
  scheduled_date date [note: 'Date the appointment is scheduled.']
  scheduled_end_datetime varchar
  scheduled_end_time timestamp [note: 'Scheduled end timestamp.']
  scheduled_end_timestamp timestamp
  scheduled_start_datetime varchar
  scheduled_start_time timestamp [note: 'Scheduled start timestamp.']
  scheduled_start_timestamp timestamp
  self_scheduled_flag boolean
  source_system_identifier varchar
  ssot_canonical_reference varchar [note: 'SSOT canonical: radiology.radiology_appointment (duplicate reconciled to canonical)']
  telehealth_flag boolean
  telehealth_platform varchar [note: 'Platform used for telehealth visit.']
  telehealth_session_url varchar [note: 'URL for the telehealth session.']
  updated_timestamp timestamp [note: 'Record last updated timestamp.']
  vibe_mutation_applied varchar
  vibe_mutation_flag boolean
  vibe_structure_marker varchar [note: 'Marks product as part of the required ECM structure.']
  visit_modality varchar [note: 'Mode of visit: in-person, telehealth, phone.']
  visit_reason varchar [note: 'Patient-stated reason for the visit.']
  visit_reason_code varchar

  Note: 'Canonical scheduling appointment record (ECM superset of MVM scheduling.appointment). Tracks all appointment lifecycle events including telehealth, cancellation, and insurance verification.'
}

