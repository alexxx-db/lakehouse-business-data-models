ind:templateType rdf:type rdf:Property ;
    rdfs:label 'Template Type' ;
    rdfs:comment 'Classification of the recurring entry template by business purpose.' ;
    rdfs:domain ind:RecurringEntryTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cipEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Cip Employee Id' ;
    rdfs:comment 'Identifier of the employee assigned as project manager, responsible for planning, execution, and delivery. Links to workforce or employee master data.' ;
    rdfs:domain ind:CipProject ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:cipProjectManagerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Cip Project Manager Employee Id' ;
    rdfs:comment 'FK to workforce.employee' ;
    rdfs:domain ind:CipProject ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:authorizedBudgetAmount rdf:type rdf:Property ;
    rdfs:label 'Authorized Budget Amount' ;
    rdfs:comment 'Total budget amount authorized for the project by governing board or executive approval. Represents the funding ceiling for all project expenditures including design, construction, contingency, and administrative costs.' ;
    rdfs:domain ind:CipProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cipProgramYear rdf:type rdf:Property ;
    rdfs:label 'Cip Program Year' ;
    rdfs:comment 'Fiscal year in which the project was authorized and budgeted within the CIP plan (e.g., 2024). Used for multi-year CIP planning and tracking.' ;
    rdfs:domain ind:CipProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:cipProjectNumber rdf:type rdf:Property ;
    rdfs:label 'Cip Project Number' ;
    rdfs:comment 'Capital improvement project number.' ;
    rdfs:domain ind:CipProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costVarianceAmount rdf:type rdf:Property ;
    rdfs:label 'Cost Variance Amount' ;
    rdfs:comment 'Dollar amount the project is under (negative) or over (positive) budget. Calculated as estimated total cost minus authorized budget amount.' ;
    rdfs:domain ind:CipProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cipProjectDescription rdf:type rdf:Property ;
    rdfs:label 'Cip Project Description' ;
    rdfs:comment 'Free-text description' ;
    rdfs:domain ind:CipProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:environmentalReviewStatus rdf:type rdf:Property ;
    rdfs:label 'Environmental Review Status' ;
    rdfs:comment 'Status of environmental review process (NEPA, CEQA, or state equivalent): not_required (no review needed), pending (not yet started), in_progress (under review), completed (review finished), approved (clearance granted).' ;
    rdfs:domain ind:Project ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedCustomersImpacted rdf:type rdf:Property ;
    rdfs:label 'Estimated Customers Impacted' ;
    rdfs:comment 'Estimated number of customer accounts or service connections affected by the project during construction or upon completion. Used for outreach planning and benefit analysis.' ;
    rdfs:domain ind:CipProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:forecastCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Forecast Completion Date' ;
    rdfs:comment 'Current forecast for project completion based on progress, schedule changes, and known delays. Updated regularly throughout project lifecycle.' ;
    rdfs:domain ind:CipProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:infrastructureCategory rdf:type rdf:Property ;
    rdfs:label 'Infrastructure Category' ;
    rdfs:comment 'Primary infrastructure system served by the project: water (treatment and distribution), wastewater (collection and treatment), shared (benefits both systems), stormwater (drainage and management), or other.' ;
    rdfs:domain ind:CipProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isGrantFunded rdf:type rdf:Property ;
    rdfs:label 'Is Grant Funded' ;
    rdfs:comment 'Whether grant funded.' ;
    rdfs:domain ind:CipProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:operationalTurnoverDate rdf:type rdf:Property ;
    rdfs:label 'Operational Turnover Date' ;
    rdfs:comment 'Date the completed asset was formally transferred from the project team to operations and maintenance for ongoing management. Marks the end of the project lifecycle and start of asset operational life.' ;
    rdfs:domain ind:CipProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:percentComplete rdf:type rdf:Property ;
    rdfs:label 'Percent Complete' ;
    rdfs:comment 'Current percentage of project completion based on earned value, milestones achieved, or physical progress. Range 0.00 to 100.00.' ;
    rdfs:domain ind:Project ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:permitRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Permit Required Flag' ;
    rdfs:comment 'Indicates whether the project requires regulatory permits (e.g., construction permits, environmental permits, discharge permits). True if permits are required; false otherwise.' ;
    rdfs:domain ind:CipProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:plannedFinishDate rdf:type rdf:Property ;
    rdfs:label 'Planned Finish Date' ;
    rdfs:comment 'planned finish date for cip_project' ;
    rdfs:domain ind:Project ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:projectManagerName rdf:type rdf:Property ;
    rdfs:label 'Project Manager Name' ;
    rdfs:comment 'Full name of the project manager assigned to lead the CIP project. Denormalized for reporting convenience.' ;
    rdfs:domain ind:Project ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:projectNumber rdf:type rdf:Property ;
    rdfs:label 'Project Number' ;
    rdfs:comment 'Business identifier for the CIP project, typically formatted as program code followed by sequential number (e.g., WTP-2024-001). Used in external communications, contracts, and regulatory filings.' ;
    rdfs:domain ind:CipProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:projectStatus rdf:type rdf:Property ;
    rdfs:label 'Project Status' ;
    rdfs:comment 'Current operational status of the project: active (work progressing), on_hold (temporarily paused), delayed (behind schedule), cancelled (terminated before completion), completed (finished and closed).' ;
    rdfs:domain ind:CipProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:projectType rdf:type rdf:Property ;
    rdfs:label 'Project Type' ;
    rdfs:comment 'Classification of the CIP project by nature of work: expansion (capacity increase), rehabilitation (restore to original condition), renewal (extend useful life), replacement (like-for-like), upgrade (improve performance), new_construction (greenfield), or regulatory_compliance (mandated by regulation). [ENUM-REF-CANDIDATE: expansion|rehabilitation|renewal|replacement|upgrade|new_construction|regulatory_compliance — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:CipProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduleVarianceDays rdf:type rdf:Property ;
    rdfs:label 'Schedule Variance Days' ;
    rdfs:comment 'Number of days the project is ahead (negative) or behind (positive) the baseline schedule. Calculated as forecast completion date minus planned completion date.' ;
    rdfs:domain ind:Project ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sponsoringDepartment rdf:type rdf:Property ;
    rdfs:label 'Sponsoring Department' ;
    rdfs:comment 'Organizational department or division that owns and sponsors the project (e.g., Water Operations, Wastewater Treatment, Engineering, Asset Management). Responsible for project outcomes and operational handover.' ;
    rdfs:domain ind:CipProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:substantialCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Substantial Completion Date' ;
    rdfs:comment 'Date the project reached substantial completion per contract terms, meaning the asset is functional and can be used for its intended purpose, though minor punch-list items may remain.' ;
    rdfs:domain ind:Project ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalSpentAmount rdf:type rdf:Property ;
    rdfs:label 'Total Spent Amount' ;
    rdfs:comment 'Total spent to date.' ;
    rdfs:domain ind:CipProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:vibeProjectDomainFlag rdf:type rdf:Property ;
    rdfs:label 'Vibe Project Domain Flag' ;
    rdfs:comment 'Vibe project domain marker' ;
    rdfs:domain ind:Project ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:wbsElementId rdf:type rdf:Property ;
    rdfs:label 'Wbs Element Id' ;
    rdfs:comment 'Unique identifier for the WBS element. Primary key.' ;
    rdfs:domain ind:Project ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:WbsElement .

ind:parentWbsElementId rdf:type rdf:Property ;
    rdfs:label 'Parent Wbs Element Id' ;
    rdfs:comment 'Reference to the parent WBS element in the hierarchy. Null for top-level elements.' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:WbsElement .

ind:responsibleCostCenterId rdf:type rdf:Property ;
    rdfs:label 'Responsible Cost Center Id' ;
    rdfs:comment 'Reference to the cost center responsible for executing and managing this WBS element.' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CostCenter .

ind:actualCostAmount rdf:type rdf:Property ;
    rdfs:label 'Actual Cost Amount' ;
    rdfs:comment 'Actual cost.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:actualFinishDate rdf:type rdf:Property ;
    rdfs:label 'Actual Finish Date' ;
    rdfs:comment 'Actual date when this WBS element was completed. Null if not yet finished.' ;
    rdfs:domain ind:Project ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:baselineFinishDate rdf:type rdf:Property ;
    rdfs:label 'Baseline Finish Date' ;
    rdfs:comment 'Baseline (original approved) finish date for this WBS element, used for schedule variance analysis.' ;
    rdfs:domain ind:Project ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:baselineStartDate rdf:type rdf:Property ;
    rdfs:label 'Baseline Start Date' ;
    rdfs:comment 'Baseline (original approved) start date for this WBS element, used for schedule variance analysis.' ;
    rdfs:domain ind:Project ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:billingElementFlag rdf:type rdf:Property ;
    rdfs:label 'Billing Element Flag' ;
    rdfs:comment 'Indicates whether this WBS element is a billing element (True) or a planning element only (False). Billing elements can be invoiced to external parties or internal cost centers.' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:wbsElementCode rdf:type rdf:Property ;
    rdfs:label 'Wbs Element Code' ;
    rdfs:comment 'Externally visible unique code for the WBS element, typically hierarchical (e.g., P-12345.01.02). Used for reporting and integration with financial systems.' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commissioningRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Commissioning Required Flag' ;
    rdfs:comment 'Indicates whether formal commissioning and testing are required before this WBS element can be closed (True/False).' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:committedCost rdf:type rdf:Property ;
    rdfs:label 'Committed Cost' ;
    rdfs:comment 'Total committed costs (purchase orders, contracts) against this WBS element. Used for funds reservation tracking.' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:earnedValue rdf:type rdf:Property ;
    rdfs:label 'Earned Value' ;
    rdfs:comment 'Earned Value (EV) for Earned Value Management (EVM). Represents the budgeted cost of work actually completed to date.' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:geographicLocation rdf:type rdf:Property ;
    rdfs:label 'Geographic Location' ;
    rdfs:comment 'Geographic location or service area where this WBS element work is being performed (e.g., district, municipality, facility name).' ;
    rdfs:domain ind:Project ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wbsElementName rdf:type rdf:Property ;
    rdfs:label 'Wbs Element Name' ;
    rdfs:comment 'Short descriptive name of the WBS element (e.g., \'Design Phase\', \'Pipeline Installation\', \'Pump Station Construction\').' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:plannedValue rdf:type rdf:Property ;
    rdfs:label 'Planned Value' ;
    rdfs:comment 'Planned Value (PV) for Earned Value Management (EVM). Represents the budgeted cost of work scheduled to be completed by a given date.' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatoryPermitRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Permit Required Flag' ;
    rdfs:comment 'Indicates whether regulatory permits or approvals are required for this WBS element (True/False). Relevant for environmental compliance and construction permits.' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:settlementRule rdf:type rdf:Property ;
    rdfs:label 'Settlement Rule' ;
    rdfs:comment 'Rule defining how costs from this WBS element are settled to fixed assets, cost centers, or other receivers upon project completion.' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wbsCode rdf:type rdf:Property ;
    rdfs:label 'Wbs Code' ;
    rdfs:comment 'WBS code.' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wbsElementDescription rdf:type rdf:Property ;
    rdfs:label 'Wbs Element Description' ;
    rdfs:comment 'Detailed description of the scope, deliverables, and objectives of this WBS element.' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wbsElementStatus rdf:type rdf:Property ;
    rdfs:label 'Wbs Element Status' ;
    rdfs:comment 'Current lifecycle status of the WBS element (planned, released, in progress, completed, closed, cancelled).' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wbsElementType rdf:type rdf:Property ;
    rdfs:label 'Wbs Element Type' ;
    rdfs:comment 'Classification of the WBS element by its role in the project structure (phase, deliverable, work package, milestone, planning element).' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wbsLevel rdf:type rdf:Property ;
    rdfs:label 'Wbs Level' ;
    rdfs:comment 'Hierarchy level.' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:wbsName rdf:type rdf:Property ;
    rdfs:label 'Wbs Name' ;
    rdfs:comment 'WBS element name.' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:milestoneId rdf:type rdf:Property ;
    rdfs:label 'Milestone Id' ;
    rdfs:comment 'Unique identifier for the project milestone record. Primary key.' ;
    rdfs:domain ind:Milestone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:primaryPredecessorMilestoneId rdf:type rdf:Property ;
    rdfs:label 'Primary Predecessor Milestone Id' ;
    rdfs:comment 'Reference to the preceding milestone that must be completed before this milestone can begin. Used for schedule dependency tracking. Null if no predecessor.' ;
    rdfs:domain ind:Milestone ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Milestone .

ind:actualDate rdf:type rdf:Property ;
    rdfs:label 'Actual Date' ;
    rdfs:comment 'Actual date when the milestone was achieved or completed. Null if milestone is not yet completed. Used for schedule performance measurement.' ;
    rdfs:domain ind:Milestone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:budgetImpactAmount rdf:type rdf:Property ;
    rdfs:label 'Budget Impact Amount' ;
    rdfs:comment 'Financial impact or cost associated with achieving this milestone, expressed in US dollars. May include design fees, permit costs, contractor payments, or other milestone-specific expenditures.' ;
    rdfs:domain ind:Milestone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:deliverableDescription rdf:type rdf:Property ;
    rdfs:label 'Deliverable Description' ;
    rdfs:comment 'Description of the tangible deliverable or outcome associated with this milestone (e.g., signed design drawings, issued permit, executed contract, commissioned asset). Defines what constitutes milestone completion.' ;
    rdfs:domain ind:Milestone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:forecastDate rdf:type rdf:Property ;
    rdfs:label 'Forecast Date' ;
    rdfs:comment 'Current projected date for milestone completion based on latest schedule updates and progress assessments. May differ from baseline due to delays or accelerations.' ;
    rdfs:domain ind:Milestone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:isCompleted rdf:type rdf:Property ;
    rdfs:label 'Is Completed' ;
    rdfs:comment 'Whether completed.' ;
    rdfs:domain ind:Milestone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isRegulatoryMilestone rdf:type rdf:Property ;
    rdfs:label 'Is Regulatory Milestone' ;
    rdfs:comment 'Flag indicating whether this milestone is tied to a regulatory requirement or consent order deadline (e.g., EPA consent decree, state compliance order). True if regulatory; false otherwise.' ;
    rdfs:domain ind:Milestone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:milestoneNumber rdf:type rdf:Property ;
    rdfs:label 'Milestone Number' ;
    rdfs:comment 'Business identifier or sequence number for the milestone within the project (e.g., M-001, M-002). Used for external reporting and communication.' ;
    rdfs:domain ind:Milestone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:milestoneStatus rdf:type rdf:Property ;
    rdfs:label 'Milestone Status' ;
    rdfs:comment 'Current lifecycle status of the milestone. Indicates whether the milestone is planned, in progress, completed, delayed, cancelled, or on hold.' ;
    rdfs:domain ind:Milestone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:milestoneType rdf:type rdf:Property ;
    rdfs:label 'Milestone Type' ;
    rdfs:comment 'Category of milestone within the project lifecycle. Classifies the phase or functional area of the milestone event.' ;
    rdfs:domain ind:Milestone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:milestoneName rdf:type rdf:Property ;
    rdfs:label 'Milestone Name' ;
    rdfs:comment 'Descriptive name of the milestone event (e.g., Design Completion, Permit Issuance, Notice to Proceed, Substantial Completion, Final Completion, Asset Handover).' ;
    rdfs:domain ind:Milestone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:plannedDate rdf:type rdf:Property ;
    rdfs:label 'Planned Date' ;
    rdfs:comment 'Planned date.' ;
    rdfs:domain ind:Project ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:responsiblePartyType rdf:type rdf:Property ;
    rdfs:label 'Responsible Party Type' ;
    rdfs:comment 'Classification of the responsible party. Indicates whether the party is internal utility staff, external contractor, consultant, vendor, or regulatory agency.' ;
    rdfs:domain ind:Project ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:varianceCommentary rdf:type rdf:Property ;
    rdfs:label 'Variance Commentary' ;
    rdfs:comment 'Narrative explanation of any schedule variance, including root causes of delays or early completions, corrective actions taken, and impact on downstream milestones. Used for project status reporting.' ;
    rdfs:domain ind:Milestone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:varianceDays rdf:type rdf:Property ;
    rdfs:label 'Variance Days' ;
    rdfs:comment 'Number of days between baseline date and actual or forecast date. Positive values indicate delay; negative values indicate early completion. Used for schedule performance reporting.' ;
    rdfs:domain ind:Milestone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:projectBudgetId rdf:type rdf:Property ;
    rdfs:label 'Project Budget Id' ;
    rdfs:comment 'Unique identifier for the project budget record. Primary key for the project budget entity.' ;
    rdfs:domain ind:Project ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProjectBudget .

ind:appropriationOrdinanceNumber rdf:type rdf:Property ;
    rdfs:label 'Appropriation Ordinance Number' ;
    rdfs:comment 'Municipal ordinance or resolution number that legally authorized this budget appropriation. Required for public sector utilities subject to legislative budget approval.' ;
    rdfs:domain ind:ProjectBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvedAmendmentsAmount rdf:type rdf:Property ;
    rdfs:label 'Approved Amendments Amount' ;
    rdfs:comment 'Total cumulative amount of approved budget amendments, change orders, and supplemental appropriations that have been added to or subtracted from the original budget.' ;
    rdfs:domain ind:ProjectBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bondAmount rdf:type rdf:Property ;
    rdfs:label 'Bond Amount' ;
    rdfs:comment 'Portion of the budget funded by municipal bonds, revenue bonds, or general obligation bonds issued to finance capital improvements.' ;
    rdfs:domain ind:Project ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:budgetVersion rdf:type rdf:Property ;
    rdfs:label 'Budget Version' ;
    rdfs:comment 'Budget version.' ;
    rdfs:domain ind:ProjectBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capexAmount rdf:type rdf:Property ;
    rdfs:label 'Capex Amount' ;
    rdfs:comment 'Portion of the budget classified as capital expenditure (CAPEX) that will be capitalized as a fixed asset. Represents investment in long-term infrastructure assets.' ;
    rdfs:domain ind:ProjectBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contingencyAmount rdf:type rdf:Property ;
    rdfs:label 'Contingency Amount' ;
    rdfs:comment 'Budget amount set aside as contingency reserve for unforeseen costs, scope changes, or risk mitigation. Typically a percentage of the base construction budget.' ;
    rdfs:domain ind:ProjectBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contingencyPercentage rdf:type rdf:Property ;
    rdfs:label 'Contingency Percentage' ;
    rdfs:comment 'Contingency reserve expressed as a percentage of the base project budget. Common practice is 10-20% for water utility CIP projects depending on project complexity and risk.' ;
    rdfs:domain ind:ProjectBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:currentApprovedBudgetAmount rdf:type rdf:Property ;
    rdfs:label 'Current Approved Budget Amount' ;
    rdfs:comment 'Current total authorized budget amount including original budget plus all approved amendments. This is the active budget ceiling for expenditure control.' ;
    rdfs:domain ind:ProjectBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:projectBudgetDescription rdf:type rdf:Property ;
    rdfs:label 'Project Budget Description' ;
    rdfs:comment 'Free-text description' ;
    rdfs:domain ind:ProjectBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fundingSourcePrimary rdf:type rdf:Property ;
    rdfs:label 'Funding Source Primary' ;
    rdfs:comment 'Primary funding source for this budget allocation such as revenue bonds, general obligation bonds, grants, rate revenue, developer contributions, or state revolving fund loans.' ;
    rdfs:domain ind:ProjectBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fundingSourceSecondary rdf:type rdf:Property ;
    rdfs:label 'Funding Source Secondary' ;
    rdfs:comment 'Secondary or supplemental funding source if the project budget is financed from multiple sources. Supports blended financing structures common in large CIP projects.' ;
    rdfs:domain ind:ProjectBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grantAmount rdf:type rdf:Property ;
    rdfs:label 'Grant Amount' ;
    rdfs:comment 'Portion of the budget funded by federal, state, or local grants such as EPA Water Infrastructure Finance and Innovation Act (WIFIA) or state drinking water revolving fund grants.' ;
    rdfs:domain ind:ProjectBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isMultiYearBudget rdf:type rdf:Property ;
    rdfs:label 'Is Multi Year Budget' ;
    rdfs:comment 'Flag indicating whether this budget spans multiple fiscal years. True for large CIP projects with multi-year appropriations; false for single-year budgets.' ;
    rdfs:domain ind:ProjectBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastRevisionDate rdf:type rdf:Property ;
    rdfs:label 'Last Revision Date' ;
    rdfs:comment 'Date of the most recent budget revision, amendment, or change order that modified the approved budget amount or allocation.' ;
    rdfs:domain ind:ProjectBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:opexAmount rdf:type rdf:Property ;
    rdfs:label 'Opex Amount' ;
    rdfs:comment 'Portion of the budget classified as operating expenditure (OPEX) that will be expensed in the current period. Represents operational costs not capitalized.' ;
    rdfs:domain ind:ProjectBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:phase rdf:type rdf:Property ;
    rdfs:label 'Phase' ;
    rdfs:comment 'Project phase to which this budget allocation applies. CIP projects typically have budgets segmented by planning, design, construction, contingency, and inspection phases.' ;
    rdfs:domain ind:ProjectBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:projectCanonicalFinanceBudgetId rdf:type rdf:Property ;
    rdfs:label 'Project Canonical Finance Budget Id' ;
    rdfs:comment 'Reference FK to canonical SSOT finance.finance_budget' ;
    rdfs:domain ind:ProjectBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:projectFinanceBudgetId rdf:type rdf:Property ;
    rdfs:label 'Project Finance Budget Id' ;
    rdfs:comment 'Foreign key to the canonical single-source-of-truth entity finance.finance_budget to resolve cross-domain duplication.' ;
    rdfs:domain ind:ProjectBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:rateRevenueAmount rdf:type rdf:Property ;
    rdfs:label 'Rate Revenue Amount' ;
    rdfs:comment 'Portion of the budget funded directly from water and wastewater rate revenue collected from customers. Pay-as-you-go financing from operating cash flow.' ;
    rdfs:domain ind:ProjectBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:remainingBudgetAmount rdf:type rdf:Property ;
    rdfs:label 'Remaining Budget Amount' ;
    rdfs:comment 'Remaining unencumbered and unexpended budget available for future commitments. Calculated as current approved budget minus encumbrances minus actual expenditures.' ;
    rdfs:domain ind:ProjectBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:budgetAmendmentId rdf:type rdf:Property ;
    rdfs:label 'Budget Amendment Id' ;
    rdfs:comment 'Unique identifier for the budget amendment record. Primary key for the budget amendment entity.' ;
    rdfs:domain ind:BudgetAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:amendmentAmount rdf:type rdf:Property ;
    rdfs:label 'Amendment Amount' ;
    rdfs:comment 'The dollar value of the budget change. Positive values indicate budget increases; negative values indicate budget decreases or deobligations.' ;
    rdfs:domain ind:BudgetAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:amendmentStatus rdf:type rdf:Property ;
    rdfs:label 'Amendment Status' ;
    rdfs:comment 'Current state of the amendment in the approval workflow. Tracks progression from draft through final approval or rejection. [ENUM-REF-CANDIDATE: draft|pending_review|pending_approval|approved|rejected|withdrawn|superseded — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:BudgetAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:amendmentType rdf:type rdf:Property ;
    rdfs:label 'Amendment Type' ;
    rdfs:comment 'Classification of the amendment based on the nature of the budget change. Indicates whether the amendment is due to scope changes, contingency usage, emergency needs, cost overruns, schedule adjustments, or funding reallocations.' ;
    rdfs:domain ind:BudgetAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditTrailNotes rdf:type rdf:Property ;
    rdfs:label 'Audit Trail Notes' ;
    rdfs:comment 'Free-text field for capturing additional audit and compliance notes related to the amendment. Supports regulatory reporting and internal controls documentation.' ;
    rdfs:domain ind:BudgetAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contingencyAmountUsed rdf:type rdf:Property ;
    rdfs:label 'Contingency Amount Used' ;
    rdfs:comment 'The dollar amount of project contingency reserve consumed by this amendment. Tracks depletion of risk mitigation funds.' ;
    rdfs:domain ind:BudgetAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contingencyImpactFlag rdf:type rdf:Property ;
    rdfs:label 'Contingency Impact Flag' ;
    rdfs:comment 'Indicates whether this amendment draws from or affects the project contingency reserve. True if contingency funds are utilized; false otherwise.' ;
    rdfs:domain ind:BudgetAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:budgetAmendmentDescription rdf:type rdf:Property ;
    rdfs:label 'Budget Amendment Description' ;
    rdfs:comment 'Free-text description' ;
    rdfs:domain ind:BudgetAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:meetingDate rdf:type rdf:Property ;
    rdfs:label 'Meeting Date' ;
    rdfs:comment 'The date of the board or commission meeting at which the amendment was presented and approved. Provides governance audit trail.' ;
    rdfs:domain ind:BudgetAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:remainingContingency rdf:type rdf:Property ;
    rdfs:label 'Remaining Contingency' ;
    rdfs:comment 'The balance of contingency funds available after this amendment. Provides visibility into remaining risk buffer for the project.' ;
    rdfs:domain ind:BudgetAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:revisedBudgetAmount rdf:type rdf:Property ;
    rdfs:label 'Revised Budget Amount' ;
    rdfs:comment 'The resulting total project budget after applying this amendment. Calculated as original budget plus amendment amount.' ;
    rdfs:domain ind:BudgetAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scheduleImpactDays rdf:type rdf:Property ;
    rdfs:label 'Schedule Impact Days' ;
    rdfs:comment 'The number of calendar days by which the project schedule is extended or compressed as a result of this amendment. Positive values indicate delays; negative values indicate acceleration.' ;
    rdfs:domain ind:Project ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:scopeChangeDescription rdf:type rdf:Property ;
    rdfs:label 'Scope Change Description' ;
    rdfs:comment 'Detailed description of any project scope modifications associated with this budget amendment. Documents changes to deliverables, specifications, or project boundaries.' ;
    rdfs:domain ind:BudgetAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supportingDocumentReference rdf:type rdf:Property ;
    rdfs:label 'Supporting Document Reference' ;
    rdfs:comment 'Reference identifier or URI to supporting documentation for the amendment, such as cost estimates, change orders, engineering reports, or board memos.' ;
    rdfs:domain ind:BudgetAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:designContractAdministratorEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Design Contract Administrator Employee Id' ;
    rdfs:comment 'Reference to the utility employee responsible for contract administration, including invoice review, amendment processing, and compliance monitoring. Links to the workforce or employee master record.' ;
    rdfs:domain ind:DesignContract ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:designEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Design Employee Id' ;
    rdfs:comment 'Reference to the utility employee serving as project manager responsible for overseeing the design contract. Links to the workforce or employee master record.' ;
    rdfs:domain ind:DesignContract ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:designVendorId rdf:type rdf:Property ;
    rdfs:label 'Design Vendor Id' ;
    rdfs:comment 'Reference to the professional engineering firm or consultant providing design services under this contract. Links to the vendor or party master record.' ;
    rdfs:domain ind:DesignContract ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Vendor .

ind:primaryDesignEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Design Employee Id' ;
    rdfs:comment 'Reference to the utility employee serving as project manager responsible for overseeing the design contract. Links to the workforce or employee master record.' ;
    rdfs:domain ind:DesignContract ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:primaryDesignVendorId rdf:type rdf:Property ;
    rdfs:label 'Primary Design Vendor Id' ;
    rdfs:comment 'Reference to the professional engineering firm or consultant providing design services under this contract. Links to the vendor or party master record.' ;
    rdfs:domain ind:DesignContract ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Vendor .

ind:amendmentValue rdf:type rdf:Property ;
    rdfs:label 'Amendment Value' ;
    rdfs:comment 'Cumulative value in US dollars of all executed contract amendments and change orders. Positive values represent scope additions; negative values represent reductions. Sum of all amendment amounts applied to the original contract value.' ;
    rdfs:domain ind:DesignContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:constructionAdministrationIncluded rdf:type rdf:Property ;
    rdfs:label 'Construction Administration Included' ;
    rdfs:comment 'Boolean flag indicating whether the design contract includes construction administration (CA) services during the build phase. CA services typically include shop drawing review, site visits, request for information (RFI) responses, and substantial completion certification.' ;
    rdfs:domain ind:DesignContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:contractDurationDays rdf:type rdf:Property ;
    rdfs:label 'Contract Duration Days' ;
    rdfs:comment 'Total number of calendar days allocated for completion of design services, from notice to proceed to scheduled completion. Baseline duration established at contract execution.' ;
    rdfs:domain ind:Project ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:contractTitle rdf:type rdf:Property ;
    rdfs:label 'Contract Title' ;
    rdfs:comment 'Descriptive title of the design services contract, typically including the project name and scope summary (e.g., \'Preliminary Engineering Report and Design for Main Street Water Treatment Plant (WTP) Expansion\').' ;
    rdfs:domain ind:DesignContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:currentContractValue rdf:type rdf:Property ;
    rdfs:label 'Current Contract Value' ;
    rdfs:comment 'Current total contract value in US dollars, calculated as original contract value plus all executed amendments. Represents the current authorized budget for design services.' ;
    rdfs:domain ind:Project ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:deliverableSchedule rdf:type rdf:Property ;
    rdfs:label 'Deliverable Schedule' ;
    rdfs:comment 'Structured schedule of key design deliverables and their due dates. Typically includes milestones such as preliminary engineering report (PER) submission, 30% design review, 60% design review, 90% design review, final construction documents, and permit applications.' ;
    rdfs:domain ind:DesignContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:designContractDescription rdf:type rdf:Property ;
    rdfs:label 'Design Contract Description' ;
    rdfs:comment 'Free-text description' ;
    rdfs:domain ind:DesignContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:designPhase rdf:type rdf:Property ;
    rdfs:label 'Design Phase' ;
    rdfs:comment 'Current or primary phase of design services covered by this contract. Preliminary engineering includes feasibility studies and PER; conceptual and schematic design establish project approach; detailed design produces technical specifications; construction documents are bid-ready plans; bidding support assists procurement; construction administration provides oversight during build. [ENUM-REF-CANDIDATE: preliminary_engineering|conceptual_design|schematic_design|detailed_design|construction_documents|bidding_support|construction_administration — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Project ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:designStandardReference rdf:type rdf:Property ;
    rdfs:label 'Design Standard Reference' ;
    rdfs:comment 'Reference to the primary design standards and codes governing the engineering work. Typically includes AWWA standards, Ten States Standards (for water and wastewater), state-specific design manuals, and local utility design criteria.' ;
    rdfs:domain ind:DesignContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disadvantagedBusinessEnterpriseParticipation rdf:type rdf:Property ;
    rdfs:label 'Disadvantaged Business Enterprise Participation' ;
    rdfs:comment 'Percentage of contract value committed to disadvantaged business enterprise (DBE) or minority/women-owned business enterprise (M/WBE) participation. Required for federally-funded projects to meet EPA and USDA diversity goals.' ;
    rdfs:domain ind:DesignContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:engineeringFirmName rdf:type rdf:Property ;
    rdfs:label 'Engineering Firm Name' ;
    rdfs:comment 'Legal name of the engineering firm or consultant providing design services. Captured for reporting and audit purposes.' ;
    rdfs:domain ind:DesignContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:executionDate rdf:type rdf:Property ;
    rdfs:label 'Execution Date' ;
    rdfs:comment 'Date on which the design services contract was fully executed (signed by all parties). Establishes the legal effective date of the agreement.' ;
    rdfs:domain ind:Project ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:insuranceCertificateReceived rdf:type rdf:Property ;
    rdfs:label 'Insurance Certificate Received' ;
    rdfs:comment 'Boolean flag indicating whether the engineering firm has provided required professional liability insurance and general liability insurance certificates. Required before notice to proceed can be issued.' ;
    rdfs:domain ind:Project ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:invoicedToDate rdf:type rdf:Property ;
    rdfs:label 'Invoiced To Date' ;
    rdfs:comment 'Cumulative amount in US dollars invoiced by the engineering firm to date. Used to track contract spend and remaining budget.' ;
    rdfs:domain ind:DesignContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:noticeToProceedDate rdf:type rdf:Property ;
    rdfs:label 'Notice To Proceed Date' ;
    rdfs:comment 'Date on which the utility issued formal notice to proceed (NTP) authorizing the engineering firm to begin design work. Triggers contract performance period and milestone schedule.' ;
    rdfs:domain ind:Project ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:originalContractValue rdf:type rdf:Property ;
    rdfs:label 'Original Contract Value' ;
    rdfs:comment 'Initial total contract value in US dollars as executed at contract award, before any amendments or change orders. Represents the baseline budget for design services.' ;
    rdfs:domain ind:Project ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paidToDate rdf:type rdf:Property ;
    rdfs:label 'Paid To Date' ;
    rdfs:comment 'Cumulative amount in US dollars paid to the engineering firm to date. May differ from invoiced amount due to payment processing lag or retainage.' ;
    rdfs:domain ind:DesignContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:performanceBondRequired rdf:type rdf:Property ;
    rdfs:label 'Performance Bond Required' ;
    rdfs:comment 'Boolean flag indicating whether a performance bond is required for this design services contract. Typically not required for professional services but may be mandated for high-value or high-risk projects.' ;
    rdfs:domain ind:Project ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:permitSupportIncluded rdf:type rdf:Property ;
    rdfs:label 'Permit Support Included' ;
    rdfs:comment 'Boolean flag indicating whether the design contract includes services for preparing and submitting regulatory permit applications. Common permits include NPDES discharge permits, Safe Drinking Water Act (SDWA) construction permits, wetland permits, and local building permits.' ;
    rdfs:domain ind:DesignContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:qualityAssuranceReviewRequired rdf:type rdf:Property ;
    rdfs:label 'Quality Assurance Review Required' ;
    rdfs:comment 'Boolean flag indicating whether an independent quality assurance (QA) or quality control (QC) review of design documents is required. Often mandated for large or complex projects, or when using federal funding.' ;
    rdfs:domain ind:DesignContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:retainageAmount rdf:type rdf:Property ;
    rdfs:label 'Retainage Amount' ;
    rdfs:comment 'Amount in US dollars withheld from payments as retainage to ensure contract performance and deliverable quality. Typically released upon final acceptance of design documents.' ;
    rdfs:domain ind:Project ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:retainagePercentage rdf:type rdf:Property ;
    rdfs:label 'Retainage Percentage' ;
    rdfs:comment 'Percentage of each invoice withheld as retainage. Common values are 5% or 10% for professional services contracts.' ;
    rdfs:domain ind:Project ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scopeOfServices rdf:type rdf:Property ;
    rdfs:label 'Scope Of Services' ;
    rdfs:comment 'Detailed description of the engineering and design services to be provided under this contract. Typically includes phases such as preliminary engineering report (PER), conceptual design, detailed design, construction documents, permitting support, bidding assistance, and construction administration.' ;
    rdfs:domain ind:DesignContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subconsultantList rdf:type rdf:Property ;
    rdfs:label 'Subconsultant List' ;
    rdfs:comment 'List of subconsultants and specialty firms engaged by the prime engineering firm to support design services. May include geotechnical engineers, environmental consultants, surveying firms, and other specialists.' ;
    rdfs:domain ind:DesignContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:constructionContractorVendorId rdf:type rdf:Property ;
    rdfs:label 'Construction Contractor Vendor Id' ;
    rdfs:comment 'Reference to the general contractor or prime contractor awarded this construction contract. Links to the vendor/contractor master record.' ;
    rdfs:domain ind:Project ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Vendor .

ind:constructionEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Construction Employee Id' ;
    rdfs:comment 'Reference to the utility employee serving as project manager responsible for contract administration, progress monitoring, and contractor coordination.' ;
    rdfs:domain ind:Project ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:constructionProjectManagerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Construction Project Manager Employee Id' ;
    rdfs:comment 'Reference to the utility employee serving as project manager responsible for contract administration, progress monitoring, and contractor coordination.' ;
    rdfs:domain ind:ConstructionContract ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:constructionVendorId rdf:type rdf:Property ;
    rdfs:label 'Construction Vendor Id' ;
    rdfs:comment 'Reference to the general contractor or prime contractor awarded this construction contract. Links to the vendor/contractor master record.' ;
    rdfs:domain ind:Project ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Vendor .

ind:awardedContractValue rdf:type rdf:Property ;
    rdfs:label 'Awarded Contract Value' ;
    rdfs:comment 'Contract value at the time of award, after any bid negotiations or adjustments. This is the baseline contract amount before any change orders.' ;
    rdfs:domain ind:ConstructionContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bidAdvertisementDate rdf:type rdf:Property ;
    rdfs:label 'Bid Advertisement Date' ;
    rdfs:comment 'Date the construction contract opportunity was publicly advertised for competitive bidding. Marks the start of the procurement process.' ;
    rdfs:domain ind:ConstructionContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:bidAmount rdf:type rdf:Property ;
    rdfs:label 'Bid Amount' ;
    rdfs:comment 'Original bid amount submitted by the contractor during the competitive bidding process, before any negotiations or adjustments. Represents the contractor\'s initial price proposal.' ;
    rdfs:domain ind:ConstructionContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bidOpeningDate rdf:type rdf:Property ;
    rdfs:label 'Bid Opening Date' ;
    rdfs:comment 'Date when sealed bids were publicly opened and read. Establishes the official bid prices for evaluation.' ;
    rdfs:domain ind:ConstructionContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:contractName rdf:type rdf:Property ;
    rdfs:label 'Contract Name' ;
    rdfs:comment 'Descriptive name of the construction contract, typically reflecting the scope of work (e.g., \'Main Street Water Main Replacement\', \'WWTP Clarifier Rehabilitation\').' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:currentCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Current Completion Date' ;
    rdfs:comment 'Current contractual deadline for substantial completion, adjusted for any approved time extensions due to change orders, weather delays, or other contract modifications.' ;
    rdfs:domain ind:ConstructionContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:constructionContractDescription rdf:type rdf:Property ;
    rdfs:label 'Construction Contract Description' ;
    rdfs:comment 'Free-text description' ;
    rdfs:domain ind:ConstructionContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:finalCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Final Completion Date' ;
    rdfs:comment 'Actual date all contract work including punch list items was completed and accepted by the utility. Triggers final payment and contract closeout.' ;
    rdfs:domain ind:Project ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:liquidatedDamagesAssessed rdf:type rdf:Property ;
    rdfs:label 'Liquidated Damages Assessed' ;
    rdfs:comment 'Total dollar amount of liquidated damages assessed against the contractor for late completion. Calculated as days late multiplied by daily rate.' ;
    rdfs:domain ind:ConstructionContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:liquidatedDamagesRate rdf:type rdf:Property ;
    rdfs:label 'Liquidated Damages Rate' ;
    rdfs:comment 'Daily dollar amount of liquidated damages assessed for each calendar day the contractor fails to achieve substantial completion by the contract deadline. Pre-agreed damages for delay, not a penalty.' ;
    rdfs:domain ind:ConstructionContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ntpDate rdf:type rdf:Property ;
    rdfs:label 'Ntp Date' ;
    rdfs:comment 'Date the utility issued the Notice to Proceed authorizing the contractor to begin construction work. Starts the contract time clock for completion deadlines.' ;
    rdfs:domain ind:ConstructionContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:originalCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Original Completion Date' ;
    rdfs:comment 'Original contractual deadline for substantial completion of the work, calculated from NTP date plus contract duration. Baseline for schedule performance tracking.' ;
    rdfs:domain ind:ConstructionContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:paymentBondAmount rdf:type rdf:Property ;
    rdfs:label 'Payment Bond Amount' ;
    rdfs:comment 'Dollar amount of the payment bond, typically 100% of the contract value. Ensures subcontractors and material suppliers are paid.' ;
    rdfs:domain ind:ConstructionContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentBondRequired rdf:type rdf:Property ;
    rdfs:label 'Payment Bond Required' ;
    rdfs:comment 'Indicates whether a payment bond (labor and material bond) is required to protect subcontractors and suppliers from non-payment by the general contractor.' ;
    rdfs:domain ind:ConstructionContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:performanceBondAmount rdf:type rdf:Property ;
    rdfs:label 'Performance Bond Amount' ;
    rdfs:comment 'Dollar amount of the performance bond, typically 100% of the contract value. Provides financial protection if contractor fails to complete the work.' ;
    rdfs:domain ind:ConstructionContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:timeExtensionsDays rdf:type rdf:Property ;
    rdfs:label 'Time Extensions Days' ;
    rdfs:comment 'Total number of calendar days of approved time extensions granted through change orders or contract modifications. Adjusts the completion deadline.' ;
    rdfs:domain ind:ConstructionContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:totalChangeOrderAmount rdf:type rdf:Property ;
    rdfs:label 'Total Change Order Amount' ;
    rdfs:comment 'Cumulative dollar value of all approved change orders (positive and negative). Represents the net change from awarded contract value to current contract value.' ;
    rdfs:domain ind:Project ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalPaidToDate rdf:type rdf:Property ;
    rdfs:label 'Total Paid To Date' ;
    rdfs:comment 'Cumulative amount paid to the contractor through all progress payments and partial payments, excluding retainage. Used to track payment status and remaining contract balance.' ;
    rdfs:domain ind:ConstructionContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:changeOrderId rdf:type rdf:Property ;
    rdfs:label 'Change Order Id' ;
    rdfs:comment 'Unique identifier for the change order record. Primary key.' ;
    rdfs:domain ind:Project ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ChangeOrder .

ind:changeContractorVendorId rdf:type rdf:Property ;
    rdfs:label 'Change Contractor Vendor Id' ;
    rdfs:comment 'Reference to the contractor or vendor responsible for executing the work described in the change order.' ;
    rdfs:domain ind:ChangeOrder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Vendor .

ind:changeDesignEngineerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Change Design Engineer Employee Id' ;
    rdfs:comment 'Reference to the engineering firm or design professional who reviewed or prepared technical specifications for the change order, if applicable.' ;
    rdfs:domain ind:ChangeOrder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:changeEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Change Employee Id' ;
    rdfs:comment 'Reference to the engineering firm or design professional who reviewed or prepared technical specifications for the change order, if applicable.' ;
    rdfs:domain ind:ChangeOrder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:changeVendorId rdf:type rdf:Property ;
    rdfs:label 'Change Vendor Id' ;
    rdfs:comment 'Reference to the contractor or vendor responsible for executing the work described in the change order.' ;
    rdfs:domain ind:ChangeOrder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Vendor .

ind:changeAmount rdf:type rdf:Property ;
    rdfs:label 'Change Amount' ;
    rdfs:comment 'Change amount.' ;
    rdfs:domain ind:ChangeOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:changeOrderDescription rdf:type rdf:Property ;
    rdfs:label 'Change Order Description' ;
    rdfs:comment 'Detailed narrative description of the scope change, including work to be added, deleted, or substituted, technical specifications, and justification for the modification.' ;
    rdfs:domain ind:ChangeOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:changeOrderNumber rdf:type rdf:Property ;
    rdfs:label 'Change Order Number' ;
    rdfs:comment 'Business-assigned unique identifier for the change order, typically sequential within a contract (e.g., CO-001, CO-002).' ;
    rdfs:domain ind:Project ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:changeOrderStatus rdf:type rdf:Property ;
    rdfs:label 'Change Order Status' ;
    rdfs:comment 'Current lifecycle status of the change order: draft (being prepared), submitted (sent for review), under review (being evaluated by stakeholders), approved (authorized for execution), rejected (denied), executed (work completed and invoiced), or closed (final reconciliation complete). [ENUM-REF-CANDIDATE: draft|submitted|under_review|approved|rejected|executed|closed — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:ChangeOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:changeOrderType rdf:type rdf:Property ;
    rdfs:label 'Change Order Type' ;
    rdfs:comment 'Classification of the change order by originating cause: owner-directed modifications, differing site conditions discovered during construction, design errors or omissions, unforeseen subsurface or environmental conditions, scope additions or deletions, time extensions without cost impact, value engineering proposals, or force majeure events. [ENUM-REF-CANDIDATE: owner_directed|differing_site_conditions|design_error|unforeseen_conditions|scope_change|time_extension|value_engineering|force_majeure — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:ChangeOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:changeReason rdf:type rdf:Property ;
    rdfs:label 'Change Reason' ;
    rdfs:comment 'Reason.' ;
    rdfs:domain ind:ChangeOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costImpactAmount rdf:type rdf:Property ;
    rdfs:label 'Cost Impact Amount' ;
    rdfs:comment 'Net financial impact of the change order on the contract value. Positive values represent cost additions; negative values represent cost deductions or credits to the owner.' ;
    rdfs:domain ind:Project ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:costImpactCurrency rdf:type rdf:Property ;
    rdfs:label 'Cost Impact Currency' ;
    rdfs:comment 'Three-letter ISO 4217 currency code for the cost impact amount. Typically USD for U.S. water utilities.' ;
    rdfs:domain ind:ChangeOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cumulativeChangeOrderValue rdf:type rdf:Property ;
    rdfs:label 'Cumulative Change Order Value' ;
    rdfs:comment 'Running total of all approved change order cost impacts for this contract through the current change order, used to track total contract growth or reduction.' ;
    rdfs:domain ind:ChangeOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:justification rdf:type rdf:Property ;
    rdfs:label 'Justification' ;
    rdfs:comment 'Business and technical rationale for the change order, including regulatory requirements, operational needs, safety considerations, or cost-benefit analysis supporting the modification.' ;
    rdfs:domain ind:ChangeOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revisedCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Revised Completion Date' ;
    rdfs:comment 'Updated contract substantial completion date after applying the schedule impact of this change order.' ;
    rdfs:domain ind:ChangeOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:scopeAdditionFlag rdf:type rdf:Property ;
    rdfs:label 'Scope Addition Flag' ;
    rdfs:comment 'Indicates whether the change order adds new work scope to the contract. True if scope is added; False if scope is deleted or substituted.' ;
    rdfs:domain ind:ChangeOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:scopeDeletionFlag rdf:type rdf:Property ;
    rdfs:label 'Scope Deletion Flag' ;
    rdfs:comment 'Indicates whether the change order removes or deletes work scope from the contract. True if scope is deleted; False otherwise.' ;
    rdfs:domain ind:ChangeOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:submittedDate rdf:type rdf:Property ;
    rdfs:label 'Submitted Date' ;
    rdfs:comment 'Date on which the change order was formally submitted to the owner or approval authority for review.' ;
    rdfs:domain ind:Project ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:payApplicationId rdf:type rdf:Property ;
    rdfs:label 'Pay Application Id' ;
    rdfs:comment 'Unique identifier for the contractor payment application record. Primary key.' ;
    rdfs:domain ind:PayApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:payContractorVendorId rdf:type rdf:Property ;
    rdfs:label 'Pay Contractor Vendor Id' ;
    rdfs:comment 'Reference to the contractor or vendor submitting the payment application.' ;
    rdfs:domain ind:PayApplication ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Vendor .

ind:payEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Pay Employee Id' ;
    rdfs:comment 'Reference to the engineer or architect who certified this payment application.' ;
    rdfs:domain ind:PayApplication ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:payEngineerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Pay Engineer Employee Id' ;
    rdfs:comment 'Reference to the engineer or architect who certified this payment application.' ;
    rdfs:domain ind:PayApplication ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:payVendorId rdf:type rdf:Property ;
    rdfs:label 'Pay Vendor Id' ;
    rdfs:comment 'Reference to the contractor or vendor submitting the payment application.' ;
    rdfs:domain ind:PayApplication ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Vendor .

ind:amountApproved rdf:type rdf:Property ;
    rdfs:label 'Amount Approved' ;
    rdfs:comment 'Amount approved.' ;
    rdfs:domain ind:PayApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:amountRequested rdf:type rdf:Property ;
    rdfs:label 'Amount Requested' ;
    rdfs:comment 'Amount requested.' ;
    rdfs:domain ind:PayApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:approvedChangeOrdersAmount rdf:type rdf:Property ;
    rdfs:label 'Approved Change Orders Amount' ;
    rdfs:comment 'Net total of all approved change orders that modify the contract sum.' ;
    rdfs:domain ind:PayApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:balanceToFinishAmount rdf:type rdf:Property ;
    rdfs:label 'Balance To Finish Amount' ;
    rdfs:comment 'Remaining contract value yet to be earned, calculated as current contract amount minus total earned to date.' ;
    rdfs:domain ind:PayApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:currentContractAmount rdf:type rdf:Property ;
    rdfs:label 'Current Contract Amount' ;
    rdfs:comment 'Current total contract sum including original contract amount plus approved change orders.' ;
    rdfs:domain ind:PayApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:currentPaymentDueAmount rdf:type rdf:Property ;
    rdfs:label 'Current Payment Due Amount' ;
    rdfs:comment 'Net amount due to the contractor for this payment application, calculated as total earned less retainage minus previous payments.' ;
    rdfs:domain ind:PayApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:payApplicationDescription rdf:type rdf:Property ;
    rdfs:label 'Pay Application Description' ;
    rdfs:comment 'Free-text description' ;
    rdfs:domain ind:PayApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:engineerCertificationDate rdf:type rdf:Property ;
    rdfs:label 'Engineer Certification Date' ;
    rdfs:comment 'Date the engineer or architect certified the payment application as accurate and compliant with contract requirements.' ;
    rdfs:domain ind:PayApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:engineerCertifiedAmount rdf:type rdf:Property ;
    rdfs:label 'Engineer Certified Amount' ;
    rdfs:comment 'Amount certified by the engineer or architect for payment, which may differ from the contractor-requested amount if adjustments are made.' ;
    rdfs:domain ind:PayApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:materialsStoredAmount rdf:type rdf:Property ;
    rdfs:label 'Materials Stored Amount' ;
    rdfs:comment 'Value of materials and equipment suitably stored on-site or off-site but not yet incorporated into the work.' ;
    rdfs:domain ind:PayApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:originalContractAmount rdf:type rdf:Property ;
    rdfs:label 'Original Contract Amount' ;
    rdfs:comment 'The original total contract sum before any approved change orders.' ;
    rdfs:domain ind:PayApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ownerApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Owner Approval Date' ;
    rdfs:comment 'Date the owner or authorized representative approved the payment application for disbursement.' ;
    rdfs:domain ind:PayApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ownerApprovedAmount rdf:type rdf:Property ;
    rdfs:label 'Owner Approved Amount' ;
    rdfs:comment 'Final amount approved by the owner for payment, which may differ from engineer-certified amount due to owner adjustments or disputes.' ;
    rdfs:domain ind:PayApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:periodEndingDate rdf:type rdf:Property ;
    rdfs:label 'Period Ending Date' ;
    rdfs:comment 'Billing period end.' ;
    rdfs:domain ind:PayApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:previousPaymentsAmount rdf:type rdf:Property ;
    rdfs:label 'Previous Payments Amount' ;
    rdfs:comment 'Sum of all payments previously made to the contractor on this contract through prior payment applications.' ;
    rdfs:domain ind:PayApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalEarnedLessRetainageAmount rdf:type rdf:Property ;
    rdfs:label 'Total Earned Less Retainage Amount' ;
    rdfs:comment 'Total earned to date minus retainage withheld, representing the gross amount eligible for payment.' ;
    rdfs:domain ind:PayApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalEarnedToDateAmount rdf:type rdf:Property ;
    rdfs:label 'Total Earned To Date Amount' ;
    rdfs:comment 'Sum of work completed to date and materials stored, representing total amount earned by the contractor through this billing period.' ;
    rdfs:domain ind:PayApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:workCompletedToDateAmount rdf:type rdf:Property ;
    rdfs:label 'Work Completed To Date Amount' ;
    rdfs:comment 'Total value of work completed and in place as of the end of this billing period, based on the schedule of values (AIA G703).' ;
    rdfs:domain ind:PayApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:costTransactionId rdf:type rdf:Property ;
    rdfs:label 'Cost Transaction Id' ;
    rdfs:comment 'Unique identifier for the project cost transaction record. Primary key.' ;
    rdfs:domain ind:CostTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:originalTransactionCostTransactionId rdf:type rdf:Property ;
    rdfs:label 'Original Transaction Cost Transaction Id' ;
    rdfs:comment 'Reference to the original project cost transaction ID that this reversal transaction is correcting. Null for original postings; populated only for reversal entries.' ;
    rdfs:domain ind:CostTransaction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CostTransaction .

ind:capitalizationFlag rdf:type rdf:Property ;
    rdfs:label 'Capitalization Flag' ;
    rdfs:comment 'Boolean indicator of whether this cost transaction is eligible for capitalization as a fixed asset upon project completion. True indicates the cost will be capitalized; False indicates it will be expensed.' ;
    rdfs:domain ind:CostTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:commitmentItem rdf:type rdf:Property ;
    rdfs:label 'Commitment Item' ;
    rdfs:comment 'Reference to the budget commitment or encumbrance item that this actual cost is drawn against. Enables commitment vs. actual cost tracking for budget control.' ;
    rdfs:domain ind:CostTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costElement rdf:type rdf:Property ;
    rdfs:label 'Cost Element' ;
    rdfs:comment 'The SAP CO cost element code that categorizes the nature of the expense (e.g., direct labor, materials, external services). Maps to the chart of accounts for financial reporting.' ;
    rdfs:domain ind:CostTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costTransactionDescription rdf:type rdf:Property ;
    rdfs:label 'Cost Transaction Description' ;
    rdfs:comment 'Free-text description of the cost transaction providing additional context about the work performed, materials purchased, or services rendered. Supports audit and cost review processes.' ;
    rdfs:domain ind:CostTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costType rdf:type rdf:Property ;
    rdfs:label 'Cost Type' ;
    rdfs:comment 'Classification of the cost transaction by type: labor charges, material purchases, equipment rentals, subcontractor invoices, overhead allocations, or other miscellaneous costs.' ;
    rdfs:domain ind:CostTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceDocumentReference rdf:type rdf:Property ;
    rdfs:label 'Source Document Reference' ;
    rdfs:comment 'The unique document identifier in the source system (e.g., SAP document number, Maximo work order ID). Enables traceability back to the originating transaction.' ;
    rdfs:domain ind:CostTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:canonicalTreatmentPermitId rdf:type rdf:Property ;
    rdfs:label 'Canonical Treatment Permit Id' ;
    rdfs:comment 'Canonical reference to treatment.treatment_permit' ;
    rdfs:domain ind:ProjectPermit ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TreatmentPermit .

ind:projectCanonicalCompliancePermitId rdf:type rdf:Property ;
    rdfs:label 'Project Canonical Compliance Permit Id' ;
    rdfs:comment 'Reference FK to canonical SSOT compliance.compliance_permit' ;
    rdfs:domain ind:ProjectPermit ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CompliancePermit .

ind:projectCompliancePermitId rdf:type rdf:Property ;
    rdfs:label 'Project Compliance Permit Id' ;
    rdfs:comment 'Foreign key linking to compliance.compliance_permit. Business justification: Project-specific construction/discharge permits reference master operational permits held by the utility. Links temporary project permits to permanent facility permits for comprehensive compliance tra' ;
    rdfs:domain ind:ProjectPermit ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CompliancePermit .

ind:appealStatus rdf:type rdf:Property ;
    rdfs:label 'Appeal Status' ;
    rdfs:comment 'Current status of any administrative appeal or legal challenge. Null if no appeal was filed.' ;
    rdfs:domain ind:ProjectPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicationFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Application Fee Amount' ;
    rdfs:comment 'Fee charged by the issuing agency for processing the permit application. Recorded in US dollars.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:applicationSubmittedBy rdf:type rdf:Property ;
    rdfs:label 'Application Submitted By' ;
    rdfs:comment 'Name of the individual or organization that submitted the permit application on behalf of the utility. May be internal staff, consultant, or contractor.' ;
    rdfs:domain ind:ProjectPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bondRequired rdf:type rdf:Property ;
    rdfs:label 'Bond Required' ;
    rdfs:comment 'Indicates whether a performance or surety bond is required as a condition of the permit. Common for construction and right-of-way permits.' ;
    rdfs:domain ind:ProjectPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:conditions rdf:type rdf:Property ;
    rdfs:label 'Conditions' ;
    rdfs:comment 'Detailed text of conditions, restrictions, and requirements imposed by the issuing agency as part of the permit. May include construction methods, environmental protections, monitoring requirements, reporting obligations, and mitigation measures.' ;
    rdfs:domain ind:ProjectPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverageAreaDescription rdf:type rdf:Property ;
    rdfs:label 'Coverage Area Description' ;
    rdfs:comment 'Textual description of the geographic area or project site covered by the permit. May include street addresses, parcel numbers, legal descriptions, or geographic coordinates.' ;
    rdfs:domain ind:ProjectPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:projectPermitDescription rdf:type rdf:Property ;
    rdfs:label 'Project Permit Description' ;
    rdfs:comment 'Free-text description' ;
    rdfs:domain ind:ProjectPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:environmentalImpactCategory rdf:type rdf:Property ;
    rdfs:label 'Environmental Impact Category' ;
    rdfs:comment 'Classification of the environmental impact level associated with the permitted activity. Determines level of environmental review and mitigation requirements.' ;
    rdfs:domain ind:ProjectPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:insuranceRequired rdf:type rdf:Property ;
    rdfs:label 'Insurance Required' ;
    rdfs:comment 'Indicates whether proof of insurance coverage is required as a condition of the permit. Common for construction permits requiring general liability and workers compensation coverage.' ;
    rdfs:domain ind:ProjectPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:issuingAgencyJurisdiction rdf:type rdf:Property ;
    rdfs:label 'Issuing Agency Jurisdiction' ;
    rdfs:comment 'Level of government jurisdiction for the issuing agency. Determines regulatory authority and appeal processes.' ;
    rdfs:domain ind:ProjectPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mitigationMeasures rdf:type rdf:Property ;
    rdfs:label 'Mitigation Measures' ;
    rdfs:comment 'Description of required environmental mitigation measures to offset impacts of the permitted activity. May include wetland restoration, stormwater controls, erosion prevention, habitat protection, or compensatory mitigation.' ;
    rdfs:domain ind:ProjectPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:monitoringRequirements rdf:type rdf:Property ;
    rdfs:label 'Monitoring Requirements' ;
    rdfs:comment 'Description of required monitoring activities, including parameters to be monitored, frequency, methods, and reporting schedules. Common for environmental permits requiring water quality, air quality, or stormwater monitoring.' ;
    rdfs:domain ind:ProjectPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:publicCommentPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Public Comment Period End Date' ;
    rdfs:comment 'Date the public comment period closed for the permit application. Null if no public comment period was required.' ;
    rdfs:domain ind:ProjectPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:renewalRequired rdf:type rdf:Property ;
    rdfs:label 'Renewal Required' ;
    rdfs:comment 'Indicates whether the permit requires periodic renewal. Common for environmental permits with fixed terms such as NPDES permits which typically require renewal every 5 years.' ;
    rdfs:domain ind:ProjectPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:responsiblePartyName rdf:type rdf:Property ;
    rdfs:label 'Responsible Party Name' ;
    rdfs:comment 'Name of the individual or organization legally responsible for permit compliance. Typically the permit holder or designated responsible official.' ;
    rdfs:domain ind:Project ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subtype rdf:type rdf:Property ;
    rdfs:label 'Subtype' ;
    rdfs:comment 'Detailed classification within the permit type. Examples: NPDES Construction Stormwater, Section 404 Wetlands Fill, Building Permit Commercial, Grading Permit, Encroachment Permit Street Opening, Right-of-Way Temporary Occupancy.' ;
    rdfs:domain ind:ProjectPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalFeesPaid rdf:type rdf:Property ;
    rdfs:label 'Total Fees Paid' ;
    rdfs:comment 'Cumulative total of all fees paid for this permit, including application, annual, renewal, and amendment fees. Recorded in US dollars.' ;
    rdfs:domain ind:ProjectPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:designSubmittalId rdf:type rdf:Property ;
    rdfs:label 'Design Submittal Id' ;
    rdfs:comment 'Unique identifier for the design submittal record. Primary key for tracking engineering document submissions during the design phase of capital improvement program (CIP) projects.' ;
    rdfs:domain ind:DesignSubmittal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:previousSubmittalDesignSubmittalId rdf:type rdf:Property ;
    rdfs:label 'Previous Submittal Design Submittal Id' ;
    rdfs:comment 'Reference to the prior version of this design submittal if this is a resubmission. Creates a lineage chain for tracking design evolution through multiple review cycles.' ;
    rdfs:domain ind:DesignSubmittal ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DesignSubmittal .

ind:commentCount rdf:type rdf:Property ;
    rdfs:label 'Comment Count' ;
    rdfs:comment 'Total number of review comments generated during the design review. Provides a quantitative measure of the extent of feedback provided.' ;
    rdfs:domain ind:DesignSubmittal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:commentResolutionStatus rdf:type rdf:Property ;
    rdfs:label 'Comment Resolution Status' ;
    rdfs:comment 'Current status of addressing and resolving review comments. Tracks progress from initial comment receipt through final verification and closure.' ;
    rdfs:domain ind:DesignSubmittal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:designSubmittalDescription rdf:type rdf:Property ;
    rdfs:label 'Design Submittal Description' ;
    rdfs:comment 'Free-text description' ;
    rdfs:domain ind:DesignSubmittal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:designDiscipline rdf:type rdf:Property ;
    rdfs:label 'Design Discipline' ;
    rdfs:comment 'Engineering discipline or specialty area covered by the design submittal. Categorizes the technical domain of the deliverable. [ENUM-REF-CANDIDATE: civil|structural|mechanical|electrical|instrumentation_and_control|process|environmental|geotechnical|hydraulic|architectural — 10 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:DesignSubmittal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:designLifeYears rdf:type rdf:Property ;
    rdfs:label 'Design Life Years' ;
    rdfs:comment 'Planned operational lifespan of the designed infrastructure in years. Used for asset management planning and long-term capital improvement program (CIP) forecasting.' ;
    rdfs:domain ind:DesignSubmittal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:drawingCount rdf:type rdf:Property ;
    rdfs:label 'Drawing Count' ;
    rdfs:comment 'Number of individual engineering drawings or sheets included in the design submittal package. Applicable for design drawing submittals.' ;
    rdfs:domain ind:DesignSubmittal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:environmentalReviewRequired rdf:type rdf:Property ;
    rdfs:label 'Environmental Review Required' ;
    rdfs:comment 'Indicates whether the design requires environmental impact assessment or review under National Environmental Policy Act (NEPA), state environmental quality acts, or other environmental regulations.' ;
    rdfs:domain ind:DesignSubmittal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:estimatedConstructionCost rdf:type rdf:Property ;
    rdfs:label 'Estimated Construction Cost' ;
    rdfs:comment 'Projected cost to construct the designed infrastructure based on the current design phase. Used for Capital Expenditure (CAPEX) planning and budget control. Expressed in US dollars.' ;
    rdfs:domain ind:DesignSubmittal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pageCount rdf:type rdf:Property ;
    rdfs:label 'Page Count' ;
    rdfs:comment 'Total number of pages or sheets in the submitted design document. Provides a measure of document size and complexity.' ;
    rdfs:domain ind:DesignSubmittal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:regulatoryPermitRequired rdf:type rdf:Property ;
    rdfs:label 'Regulatory Permit Required' ;
    rdfs:comment 'Indicates whether the design requires regulatory permits or approvals from agencies such as the U.S. Environmental Protection Agency (EPA), state primacy agencies, or local authorities before construction can proceed.' ;
    rdfs:domain ind:DesignSubmittal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reviewCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Review Completion Date' ;
    rdfs:comment 'Actual date when the design review was completed and disposition was determined. Null if review is still in progress.' ;
    rdfs:domain ind:Project ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reviewNotes rdf:type rdf:Property ;
    rdfs:label 'Review Notes' ;
    rdfs:comment 'Summary notes or general comments from the reviewer regarding the design submittal. Captures high-level feedback and overall assessment beyond individual line-item comments.' ;
    rdfs:domain ind:DesignSubmittal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewerRole rdf:type rdf:Property ;
    rdfs:label 'Reviewer Role' ;
    rdfs:comment 'Functional role or title of the reviewer (e.g., Chief Engineer, Project Manager, Technical Director, Regulatory Compliance Officer). Indicates the authority level for approval.' ;
    rdfs:domain ind:DesignSubmittal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:specificationSection rdf:type rdf:Property ;
    rdfs:label 'Specification Section' ;
    rdfs:comment 'Reference to the technical specification section or division covered by this submittal (e.g., Division 40 - Process Integration, Section 11300 - Water Treatment Equipment). Follows Construction Specifications Institute (CSI) MasterFormat or similar standards.' ;
    rdfs:domain ind:Project ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submittalNumber rdf:type rdf:Property ;
    rdfs:label 'Submittal Number' ;
    rdfs:comment 'Business identifier for the design submittal, typically following project-specific numbering conventions (e.g., DS-001, DS-002). Used for external communication and document tracking.' ;
    rdfs:domain ind:Project ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submittalStatus rdf:type rdf:Property ;
    rdfs:label 'Submittal Status' ;
    rdfs:comment 'Status.' ;
    rdfs:domain ind:Project ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submittalType rdf:type rdf:Property ;
    rdfs:label 'Submittal Type' ;
    rdfs:comment 'Classification of the design deliverable being submitted. Indicates the phase and nature of the engineering document (e.g., Preliminary Engineering Report (PER), 30%/60%/90%/100% design drawings, specifications, hydraulic models, geotechnical reports, environmental assessments). [ENUM-REF-CANDIDATE: preliminary_engineering_report|30_percent_design|60_percent_design|90_percent_design|100_percent_design|specifications|hydraulic_model|geotechnical_report|environmental_assessment|other — 10 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Project ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submitterName rdf:type rdf:Property ;
    rdfs:label 'Submitter Name' ;
    rdfs:comment 'Name of the individual or organization submitting the design document. Typically the design consultant, engineering firm, or internal engineering staff member.' ;
    rdfs:domain ind:DesignSubmittal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submitterOrganization rdf:type rdf:Property ;
    rdfs:label 'Submitter Organization' ;
    rdfs:comment 'Name of the consulting firm, engineering company, or internal department responsible for preparing and submitting the design deliverable.' ;
    rdfs:domain ind:DesignSubmittal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:constructionSubmittalId rdf:type rdf:Property ;
    rdfs:label 'Construction Submittal Id' ;
    rdfs:comment 'Unique identifier for the construction submittal record. Primary key for the construction submittal entity.' ;
    rdfs:domain ind:ConstructionSubmittal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:primaryConstructionChangeOrderId rdf:type rdf:Property ;
    rdfs:label 'Primary Construction Change Order Id' ;
    rdfs:comment 'Reference to a change order if this submittal is associated with a contract change, scope modification, or value engineering proposal. Null if part of original contract scope.' ;
    rdfs:domain ind:ConstructionSubmittal ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ChangeOrder .

ind:assetHandoverFlag rdf:type rdf:Property ;
    rdfs:label 'Asset Handover Flag' ;
    rdfs:comment 'Indicates whether this submittal includes documentation required for asset handover and commissioning (e.g., O&M manuals, as-built drawings, warranty information). True if handover documentation is included.' ;
    rdfs:domain ind:ConstructionSubmittal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:complianceCertification rdf:type rdf:Property ;
    rdfs:label 'Compliance Certification' ;
    rdfs:comment 'Industry certifications, standards compliance, or regulatory approvals applicable to the submitted product (e.g., NSF/ANSI 61 for drinking water system components, AWWA standards, UL listing).' ;
    rdfs:domain ind:ConstructionSubmittal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:criticalPathFlag rdf:type rdf:Property ;
    rdfs:label 'Critical Path Flag' ;
    rdfs:comment 'Indicates whether this submittal is on the project critical path and delays in review or approval would impact the overall project schedule. True if on critical path.' ;
    rdfs:domain ind:Project ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:constructionSubmittalDescription rdf:type rdf:Property ;
    rdfs:label 'Construction Submittal Description' ;
    rdfs:comment 'Free-text description' ;
    rdfs:domain ind:ConstructionSubmittal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dispositionCode rdf:type rdf:Property ;
    rdfs:label 'Disposition Code' ;
    rdfs:comment 'Engineer review decision code indicating the approval status: approved (no exceptions, proceed with work), approved_as_noted (minor corrections noted, proceed with work), revise_resubmit (corrections required, resubmit for approval), rejected (does not meet specifications, major revisions required), for_information_only (no approval required), withdrawn (contractor withdrew submittal).' ;
    rdfs:domain ind:ConstructionSubmittal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:finalApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Final Approval Date' ;
    rdfs:comment 'Date on which the submittal received final approval disposition (approved or approved_as_noted), allowing the contractor to proceed with fabrication or installation. Null if not yet approved.' ;
    rdfs:domain ind:ConstructionSubmittal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:requiredBeforeInstallationFlag rdf:type rdf:Property ;
    rdfs:label 'Required Before Installation Flag' ;
    rdfs:comment 'Indicates whether this submittal must receive final approval before the contractor may proceed with fabrication or installation of the associated material or equipment. True if approval is mandatory before work proceeds.' ;
    rdfs:domain ind:ConstructionSubmittal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:resubmittalCount rdf:type rdf:Property ;
    rdfs:label 'Resubmittal Count' ;
    rdfs:comment 'Number of times this submittal has been resubmitted after initial rejection or revise-and-resubmit disposition. Zero indicates first submission.' ;
    rdfs:domain ind:ConstructionSubmittal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reviewComments rdf:type rdf:Property ;
    rdfs:label 'Review Comments' ;
    rdfs:comment 'Detailed comments, corrections, or notes provided by the reviewing engineer regarding the submittal, including any required changes or clarifications.' ;
    rdfs:domain ind:ConstructionSubmittal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submittalDescription rdf:type rdf:Property ;
    rdfs:label 'Submittal Description' ;
    rdfs:comment 'Detailed description of the submittal contents, scope, and purpose, including any special notes or instructions from the contractor.' ;
    rdfs:domain ind:ConstructionSubmittal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submittalPriority rdf:type rdf:Property ;
    rdfs:label 'Submittal Priority' ;
    rdfs:comment 'Priority level assigned to the submittal review based on project schedule impact and construction sequencing needs: urgent (immediate review required), high (expedited review needed), normal (standard review timeline), low (non-critical, review as time permits).' ;
    rdfs:domain ind:ConstructionSubmittal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submittalTitle rdf:type rdf:Property ;
    rdfs:label 'Submittal Title' ;
    rdfs:comment 'Descriptive title of the submittal identifying the specific material, equipment, or system being submitted for review (e.g., Clarifier Drive Unit, 24-inch Ductile Iron Pipe, Chemical Feed Pump).' ;
    rdfs:domain ind:ConstructionSubmittal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestForInformationId rdf:type rdf:Property ;
    rdfs:label 'Request For Information Id' ;
    rdfs:comment 'Primary key for request_for_information' ;
    rdfs:domain ind:RequestForInformation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:requestAssignedReviewerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Request Assigned Reviewer Employee Id' ;
    rdfs:domain ind:RequestForInformation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:requestAssignedToEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Request Assigned To Employee Id' ;
    rdfs:comment 'Employee assigned to respond to the RFI' ;
    rdfs:domain ind:RequestForInformation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:requestContractorVendorId rdf:type rdf:Property ;
    rdfs:label 'Request Contractor Vendor Id' ;
    rdfs:domain ind:RequestForInformation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Vendor .

ind:requestCreatedByEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Request Created By Employee Id' ;
    rdfs:domain ind:RequestForInformation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:requestRespondedByEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Request Responded By Employee Id' ;
    rdfs:domain ind:RequestForInformation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:requestResponsibleEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Request Responsible Employee Id' ;
    rdfs:domain ind:RequestForInformation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:requestSubmittedByEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Request Submitted By Employee Id' ;
    rdfs:comment 'FK to workforce.employee (submitter)' ;
    rdfs:domain ind:RequestForInformation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:requestSubmittedByVendorId rdf:type rdf:Property ;
    rdfs:label 'Request Submitted By Vendor Id' ;
    rdfs:comment 'Vendor who submitted RFI' ;
    rdfs:domain ind:RequestForInformation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Vendor .

ind:actualResponseDate rdf:type rdf:Property ;
    rdfs:label 'Actual Response Date' ;
    rdfs:comment 'Actual response date' ;
    rdfs:domain ind:RequestForInformation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:requestForInformationCategory rdf:type rdf:Property ;
    rdfs:label 'Request For Information Category' ;
    rdfs:domain ind:RequestForInformation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:changeOrderRequired rdf:type rdf:Property ;
    rdfs:label 'Change Order Required' ;
    rdfs:comment 'Whether change order is required' ;
    rdfs:domain ind:RequestForInformation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:changeOrderRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Change Order Required Flag' ;
    rdfs:domain ind:RequestForInformation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:closedFlag rdf:type rdf:Property ;
    rdfs:label 'Closed Flag' ;
    rdfs:domain ind:RequestForInformation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requestForInformationCode rdf:type rdf:Property ;
    rdfs:label 'Request For Information Code' ;
    rdfs:domain ind:RequestForInformation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contractorReference rdf:type rdf:Property ;
    rdfs:label 'Contractor Reference' ;
    rdfs:comment 'Contractor reference number for this RFI' ;
    rdfs:domain ind:RequestForInformation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costImpact rdf:type rdf:Property ;
    rdfs:label 'Cost Impact' ;
    rdfs:domain ind:RequestForInformation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:costImpactEstimated rdf:type rdf:Property ;
    rdfs:label 'Cost Impact Estimated' ;
    rdfs:comment 'Estimated cost impact of the RFI' ;
    rdfs:domain ind:RequestForInformation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:costImpactFlag rdf:type rdf:Property ;
    rdfs:label 'Cost Impact Flag' ;
    rdfs:comment 'Whether RFI has cost impact' ;
    rdfs:domain ind:RequestForInformation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:costImpactUsd rdf:type rdf:Property ;
    rdfs:label 'Cost Impact Usd' ;
    rdfs:domain ind:RequestForInformation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:requestForInformationDescription rdf:type rdf:Property ;
    rdfs:label 'Request For Information Description' ;
    rdfs:domain ind:RequestForInformation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:discipline rdf:type rdf:Property ;
    rdfs:label 'Discipline' ;
    rdfs:comment 'Engineering discipline (civil, mechanical, electrical, structural)' ;
    rdfs:domain ind:RequestForInformation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:drawingReference rdf:type rdf:Property ;
    rdfs:label 'Drawing Reference' ;
    rdfs:comment 'Drawing or specification reference' ;
    rdfs:domain ind:RequestForInformation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedCostImpactUsd rdf:type rdf:Property ;
    rdfs:label 'Estimated Cost Impact Usd' ;
    rdfs:comment 'Estimated cost impact if applicable.' ;
    rdfs:domain ind:RequestForInformation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hasCostImpact rdf:type rdf:Property ;
    rdfs:label 'Has Cost Impact' ;
    rdfs:comment 'Whether RFI has cost impact' ;
    rdfs:domain ind:RequestForInformation ;
