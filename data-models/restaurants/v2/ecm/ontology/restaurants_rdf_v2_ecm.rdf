    rdfs:range xsd:string .

ind:reportingCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Reporting Currency Code' ;
    rdfs:comment 'The three-letter ISO 4217 currency code used for financial reporting in this period (e.g., USD, EUR, GBP). All monetary metrics for this period are expressed in this currency.' ;
    rdfs:domain ind:Restaurants ;
