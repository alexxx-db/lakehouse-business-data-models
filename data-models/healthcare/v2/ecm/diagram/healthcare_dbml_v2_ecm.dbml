  icd_10_cm_range_start varchar [note: 'Start of ICD-10-CM code range for the MDC.']
  icd_10_pcs_range_end varchar [note: 'End of ICD-10-PCS code range for the MDC.']
  icd_10_pcs_range_start varchar [note: 'Start of ICD-10-PCS code range for the MDC.']
