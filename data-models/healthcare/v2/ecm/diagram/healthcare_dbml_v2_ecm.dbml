  provider_gender_code varchar [note: 'M, F, or null.']
  provider_last_name varchar [note: 'Provider last name (for entity type 1).']
  provider_middle_name varchar [note: 'Provider middle name.']
  provider_name_prefix varchar [note: 'Provider name prefix (e.g., \'Dr.\', \'Mr.\').']
  provider_name_suffix varchar [note: 'Provider name suffix (e.g., \'Jr.\', \'III\').']
