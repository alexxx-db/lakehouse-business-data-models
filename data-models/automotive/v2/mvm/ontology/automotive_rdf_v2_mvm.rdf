    rdfs:range xsd:string .

ind:source rdf:type rdf:Property ;
    rdfs:label 'Source' ;
    rdfs:comment 'Origin of the preference record: self-declared by the customer, inferred by analytics, or imported from an external system.' ;
    rdfs:domain ind:Preference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:valueDataType rdf:type rdf:Property ;
    rdfs:label 'Value Data Type' ;
    rdfs:comment 'Indicates the native data type of preference_value (e.g., string, boolean, integer, list).' ;
    rdfs:domain ind:Preference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vehicleWarrantyId rdf:type rdf:Property ;
    rdfs:label 'Vehicle Warranty Id' ;
    rdfs:comment 'Foreign key linking to aftersales.vehicle_warranty. Business justification: Warranty dispute and goodwill cases must reference the vehicle warranty being contested. Aftersales customer relations teams require this link to adjudicate coverage disputes and produce warranty-rela' ;
    rdfs:domain ind:Automotive ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:VehicleWarranty .

ind:caseNumber rdf:type rdf:Property ;
    rdfs:label 'Case Number' ;
    rdfs:comment 'Business-visible case number assigned at creation.' ;
    rdfs:domain ind:Case ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:caseStatus rdf:type rdf:Property ;
    rdfs:label 'Case Status' ;
    rdfs:comment 'Current lifecycle state of the case.' ;
    rdfs:domain ind:Case ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:caseType rdf:type rdf:Property ;
    rdfs:label 'Case Type' ;
    rdfs:comment 'High-level classification of the case purpose.' ;
    rdfs:domain ind:Case ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:closedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Closed Timestamp' ;
    rdfs:comment 'Date and time when the case was finally closed.' ;
    rdfs:domain ind:Case ;
