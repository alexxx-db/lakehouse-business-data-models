    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ipOwnershipClause rdf:type rdf:Property ;
    rdfs:label 'Ip Ownership Clause' ;
    rdfs:comment 'Specifies IP ownership rights granted by the agreement.' ;
    rdfs:domain ind:NreAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastMilestoneCompletedDate rdf:type rdf:Property ;
    rdfs:label 'Last Milestone Completed Date' ;
