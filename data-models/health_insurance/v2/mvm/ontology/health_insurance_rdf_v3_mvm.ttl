ind:groupLocationId rdf:type rdf:Property ;
    rdfs:label 'Group Location Id' ;
    rdfs:comment 'Foreign key linking to employer.group_location. Business justification: Multi-site employers assign subscribers to specific group locations for rating area determination, on-site clinic access, and location-based benefit administration. This link enables location-level en' ;
    rdfs:domain ind:HealthInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GroupLocation .

