ind:hedisMeasureId rdf:type rdf:Property ;
    rdfs:label 'Hedis Measure Id' ;
    rdfs:comment 'Foreign key linking to care.hedis_measure. Business justification: CMS remittances for quality bonus payments, star ratings incentives, and HEDIS performance-based payments must reference the specific HEDIS measures that triggered the payment. Required for quality pa' ;
    rdfs:domain ind:HealthInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:HedisMeasure .

ind:rapsSubmissionId rdf:type rdf:Property ;
    rdfs:label 'Raps Submission Id' ;
    rdfs:comment 'Foreign key linking to risk.raps_submission. Business justification: CMS risk adjustment remittances must reference the specific RAPS submission batch that triggered the payment. Critical for reconciling CMS payments to submitted diagnosis data and resolving payment di' ;
    rdfs:domain ind:HealthInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RapsSubmission .

ind:edi820Reference rdf:type rdf:Property ;
