Table claim.claim {
  claim_id varchar [pk, note: 'Unique identifier for the claim record.']
  ar_account_id varchar [note: 'Link to the AR account for revenue tracking.']
  billing_provider_org_provider_id varchar [note: 'Organization submitting the claim.']
  care_site_id varchar [note: 'Facility where service was rendered.']
  clinical_order_id varchar [note: 'Link to the originating clinical order.']
  demographics_id varchar [note: 'Link to patient demographic record.']
  drg_id varchar [note: 'Diagnosis Related Group assignment.']
