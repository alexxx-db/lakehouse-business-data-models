ind:tirePressureRearLeftPsi rdf:type rdf:Property ;
    rdfs:label 'Tire Pressure Rear Left Psi' ;
    rdfs:comment 'Air pressure of the rear-left tire measured in pounds per square inch.' ;
    rdfs:domain ind:TelemetryEvent ;
    rdf:type owl:DatatypeProperty ;
