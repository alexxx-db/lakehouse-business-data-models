ind:planServiceAreaId rdf:type rdf:Property ;
    rdfs:label 'Plan Service Area Id' ;
    rdfs:comment 'Foreign key linking to plan.plan_service_area. Business justification: Member addresses must be validated against plan service areas to confirm enrollment eligibility and regulatory compliance. State insurance regulators require insurers to verify members reside within t' ;
    rdfs:domain ind:HealthInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PlanServiceArea .

ind:externalCode rdf:type rdf:Property ;
    rdfs:label 'External Code' ;
