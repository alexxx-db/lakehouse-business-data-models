  last_updated_date date [note: 'Date the record was last updated.']
  major_diagnostic_category_description varchar [note: 'Full MDC description.']
  major_diagnostic_category_name varchar [note: 'MDC name (e.g., \'Diseases and Disorders of the Nervous System\').']
  major_diagnostic_category_status varchar [note: 'Active, Retired.']
  mdc_code varchar [note: 'MDC code (e.g., \'MDC 01\', \'MDC 05\').']
  mdc_number varchar [note: 'MDC number (1-25).']
  pre_mdc_indicator boolean [note: 'True if the MDC is a pre-MDC (e.g., transplants, tracheostomy).']
  reimbursement_impact_level varchar [note: 'High, Medium, Low.']
  relative_weight_average decimal(10,4) [note: 'Average relative weight for the MDC.']
  short_name varchar [note: 'Short MDC name.']
  surgical_medical_partition varchar [note: 'Surgical, Medical, Both.']
  termination_date date [note: 'Date the MDC was retired.']
  ungroupable_indicator boolean [note: 'True if the MDC is for ungroupable cases.']
  version varchar [note: 'Version identifier.']
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutation to ensure change']
  vibe_mutation_marker varchar
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']

  Note: 'Major Diagnostic Category (MDC) master for DRG grouping with body system, ICD-10 ranges, and surgical/medical partition.'
}

