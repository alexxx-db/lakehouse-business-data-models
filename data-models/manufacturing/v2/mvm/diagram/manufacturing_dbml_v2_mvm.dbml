Ref: procurement.supplier_invoice.contract_release_order_id > procurement.contract_release_order.contract_release_order_id
Ref: procurement.supplier_invoice.freight_order_id > logistics.freight_order.freight_order_id
Ref: procurement.supplier_invoice.inbound_delivery_id > logistics.inbound_delivery.inbound_delivery_id
Ref: procurement.supplier_invoice.po_line_item_id > procurement.po_line_item.po_line_item_id
Ref: procurement.supplier_invoice.procurement_contract_id > procurement.procurement_contract.procurement_contract_id
Ref: procurement.supplier_invoice.procurement_goods_receipt_id > procurement.procurement_goods_receipt.procurement_goods_receipt_id
Ref: procurement.supplier_invoice.purchase_order_id > procurement.purchase_order.purchase_order_id
Ref: procurement.purchase_info_record.material_master_id > inventory.material_master.material_master_id
Ref: procurement.purchase_info_record.procurement_contract_id > procurement.procurement_contract.procurement_contract_id
Ref: procurement.source_list.material_master_id > inventory.material_master.material_master_id
Ref: procurement.source_list.procurement_contract_id > procurement.procurement_contract.procurement_contract_id
Ref: procurement.source_list.purchase_info_record_id > procurement.purchase_info_record.purchase_info_record_id
Ref: procurement.source_list.sku_master_id > product.sku_master.sku_master_id

