  currency_code varchar [note: 'Currency for monetary values.']
  cycle_count_frequency varchar [note: 'Frequency of cycle counts.']
  days_until_expiration decimal(9,4) [note: 'Days remaining until expiration.']
  expiration_date decimal(9,4) [note: 'Expiration date value.']
  extended_value decimal(18,2) [note: 'Total value of on-hand quantity.']
  inventory_status varchar [note: 'Current inventory status.']
  is_perishable boolean [note: 'Whether item is perishable.']
  last_adjustment_date date [note: 'Date of last adjustment.']
  last_movement_timestamp timestamp [note: 'Timestamp of last inventory movement.']
  last_physical_count_date date [note: 'Date of last physical count.']
  last_received_date date [note: 'Date item was last received.']
  lot_number varchar [note: 'Lot number of on-hand stock.']
  par_level decimal(18,4) [note: 'Target par level quantity.']
  quantity_available decimal(18,4) [note: 'Quantity available for use.']
  quantity_on_hand decimal(18,4) [note: 'Total quantity on hand.']
  quantity_reserved decimal(18,4) [note: 'Quantity reserved for orders.']
  record_created_timestamp timestamp [note: 'Timestamp when record was created.']
  record_updated_timestamp timestamp [note: 'Timestamp when record was last updated.']
  reorder_point decimal(18,4) [note: 'Quantity triggering reorder.']
  safety_stock decimal(18,4) [note: 'Safety stock quantity.']
  sku_code varchar [note: 'SKU code.']
  sku_description varchar [note: 'Description of the SKU.']
  snapshot_timestamp timestamp [note: 'Timestamp of the balance snapshot.']
  temperature_zone varchar [note: 'Temperature zone.']
  unit_cost decimal(18,2) [note: 'Cost per unit.']
  unit_of_measure varchar [note: 'Unit of measure.']
  valuation_method varchar [note: 'Inventory valuation method (FIFO, LIFO, avg).']
  variance_from_par decimal(18,4) [note: 'Variance from par level.']

  Note: 'Current on-hand inventory balance for each stock item at each location, including valuation and par-level tracking.'
}

Table inventory.receiving_order {
  receiving_order_id varchar [pk, note: 'Primary key.']
  facility_id varchar [note: 'FK to facility.']
  procurement_purchase_order_id varchar [note: 'FK to procurement purchase order.']
  procurement_supplier_id varchar [note: 'FK to procurement supplier.']
  receiving_employee_id varchar [note: 'FK to employee.']
  receiving_manager_employee_id varchar [note: 'FK to receiving manager.']
  receiving_restaurant_unit_id varchar [note: 'FK to restaurant unit.']
  receiving_unit_id varchar [note: 'FK to restaurant unit.']
  created_timestamp timestamp [note: 'Record creation timestamp.']
  currency_code varchar [note: 'Currency code.']
  days_variance varchar [note: 'Days variance from expected delivery.']
  delivery_date date [note: 'Actual delivery date.']
  delivery_note_number varchar [note: 'Delivery note reference number.']
  delivery_time timestamp [note: 'Actual delivery time.']
  delivery_timeliness varchar [note: 'Timeliness classification (early, on-time, late).']
  driver_name varchar [note: 'Name of delivery driver.']
  expected_delivery_date date [note: 'Expected delivery date.']
  goods_receipt_number varchar [note: 'Goods receipt reference number.']
