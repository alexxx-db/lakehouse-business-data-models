Table supply.supply_supplier {
  supply_supplier_id varchar [pk, note: 'Primary key']
  procurement_supplier_id varchar [note: 'FK to procurement supplier master for SSOT linkage']
  address_line1 varchar [note: 'Street address line 1']
  average_lead_time_days varchar [note: 'Average delivery lead time in days']
  city varchar [note: 'City of supplier headquarters']
  contact_email varchar [note: 'Primary contact email address']
  contact_name varchar [note: 'Primary contact person name']
  contact_phone varchar [note: 'Primary contact phone number']
  country_code varchar [note: 'ISO country code']
  created_timestamp timestamp [note: 'Record creation timestamp']
  currency_code varchar [note: 'Default transaction currency ISO code']
  food_safety_certified_flag boolean [note: 'Whether supplier holds food safety certification']
  is_approved boolean [note: 'Whether supplier has passed approval process']
  legal_name varchar [note: 'Registered legal entity name']
  on_time_delivery_rate decimal(5,2) [note: 'Historical on-time delivery percentage']
  onboarded_date date [note: 'Date supplier was onboarded']
  payment_terms varchar [note: 'Default payment terms (Net30, Net60)']
  postal_code varchar [note: 'Postal/ZIP code']
  preferred_flag boolean [note: 'Whether this is a preferred supplier']
  quality_rating decimal(5,2) [note: 'Composite quality score']
  region varchar [note: 'Geographic region for sourcing']
  state_province varchar [note: 'State or province']
  supplier_code varchar [note: 'Unique business code for the supplier']
  supplier_name varchar [note: 'Legal or trading name of the supplier']
  supplier_status varchar [note: 'Current status (active, suspended, terminated)']
  supplier_type varchar [note: 'Classification (distributor, manufacturer, broker)']
  tax_identifier varchar [note: 'Tax ID / EIN of the supplier']
  updated_timestamp timestamp [note: 'Record last update timestamp']

  Note: 'Master record for suppliers providing ingredients and goods to the restaurant supply chain.'
}

Table supply.ingredient {
  ingredient_id varchar [pk, note: 'Primary key']
  haccp_plan_id varchar [note: 'FK to HACCP plan governing this ingredient']
  item_specification_id varchar [note: 'FK to procurement item specification']
  allergen_flags varchar [note: 'Comma-separated allergen indicators']
  carbohydrate_content_percent decimal(5,2) [note: 'Carbohydrate content as percentage']
  cost_per_unit decimal(18,2) [note: 'Standard cost per unit']
  country_of_origin varchar [note: 'Primary sourcing country']
  created_timestamp timestamp [note: 'Record creation timestamp']
  currency_code varchar [note: 'Currency for cost']
  effective_from date [note: 'Date ingredient became active']
  effective_until date [note: 'Date ingredient was discontinued']
  fat_content_percent decimal(5,2) [note: 'Fat content as percentage']
  haccp_classification varchar [note: 'HACCP risk classification level']
  halal_flag boolean [note: 'Whether ingredient is halal certified']
  ingredient_category varchar [note: 'High-level category (protein, dairy, produce)']
  ingredient_code varchar [note: 'Unique business code']
  ingredient_name varchar [note: 'Display name of the ingredient']
  ingredient_status varchar [note: 'Lifecycle status (active, discontinued)']
  inspection_status varchar [note: 'Last inspection result status']
  kosher_flag boolean [note: 'Whether ingredient is kosher certified']
  last_inspection_date date [note: 'Date of last quality inspection']
  lead_time_days varchar [note: 'Standard procurement lead time']
  non_gmo_flag boolean [note: 'Whether ingredient is non-GMO verified']
  nutritional_calories_per_unit decimal(8,2) [note: 'Calories per standard unit']
  organic_flag boolean [note: 'Whether ingredient is certified organic']
  packaging_type varchar [note: 'Type of packaging (case, bag, pail)']
  par_level varchar [note: 'Minimum stock level before reorder']
  protein_content_percent decimal(5,2) [note: 'Protein content as percentage']
  shelf_life_days varchar [note: 'Expected shelf life in days']
  sodium_mg_per_unit decimal(8,2) [note: 'Sodium in mg per unit']
  standard_weight_per_unit decimal(12,4) [note: 'Standard weight per unit in grams']
  storage_temperature_c decimal(5,2) [note: 'Required storage temperature in Celsius']
  sub_category varchar [note: 'Sub-category within the main category']
  traceability_batch_number varchar [note: 'Current traceability batch reference']
  unit_of_measure varchar [note: 'Standard UOM for ordering/usage']
  updated_timestamp timestamp [note: 'Record last update timestamp']
  usda_grade varchar [note: 'USDA quality grade if applicable']
  waste_percentage decimal(5,2) [note: 'Expected waste/trim percentage']

  Note: 'Master catalog of ingredients used in restaurant recipes and menu items.'
}

Table supply.supply_purchase_order {
  supply_purchase_order_id varchar [pk, note: 'Primary key']
  distribution_center_id varchar [note: 'FK to distribution center if DC-level order']
  franchisee_id varchar [note: 'FK to franchisee placing order']
  procurement_purchase_order_id varchar [note: 'FK to procurement PO for SSOT linkage']
  site_id varchar [note: 'FK to delivery site']
  supply_supplier_id varchar [note: 'FK to supplier']
  unit_id varchar [note: 'FK to ordering restaurant unit']
  approval_status varchar [note: 'Approval workflow status']
  approved_by varchar [note: 'Name/ID of approver']
  created_timestamp timestamp [note: 'Record creation timestamp']
  currency_code varchar [note: 'Currency ISO code']
  expected_delivery_date date [note: 'Supplier-confirmed expected delivery date']
  is_approved boolean [note: 'Whether PO has been approved']
  line_item_count varchar [note: 'Number of line items on the PO']
  notes varchar [note: 'Free-text notes']
  order_date date [note: 'Date the PO was placed']
  payment_terms varchar [note: 'Payment terms on this PO']
  purchase_order_number varchar [note: 'Human-readable PO number']
  purchase_order_status varchar [note: 'Current PO status (draft, submitted, approved, received, closed)']
  requested_delivery_date date [note: 'Requested delivery date']
  ship_to_location varchar [note: 'Delivery address or location code']
  shipping_method varchar [note: 'Shipping/delivery method']
  total_amount decimal(18,2) [note: 'Total monetary value of the PO']
  updated_timestamp timestamp [note: 'Record last update timestamp']

  Note: 'Purchase orders placed with suppliers for ingredients and supplies.'
}

Table supply.purchase_order_line {
  purchase_order_line_id varchar [pk, note: 'Primary key']
  ingredient_id varchar [note: 'FK to ingredient being ordered']
  supply_purchase_order_id varchar [note: 'FK to parent purchase order']
  unit_id varchar [note: 'FK to receiving restaurant unit']
  created_timestamp timestamp [note: 'Record creation timestamp']
  currency_code varchar [note: 'Currency ISO code']
  discount_amount decimal(12,2) [note: 'Discount applied to the line']
  expected_delivery_date date [note: 'Expected delivery date for this line']
  extended_amount decimal(18,2) [note: 'Total line amount (qty x price)']
  item_description varchar [note: 'Description of the line item']
  line_sequence varchar [note: 'Line number sequence on the PO']
  line_status varchar [note: 'Status of this line (open, partial, received, cancelled)']
  ordered_quantity decimal(12,3) [note: 'Quantity ordered']
  received_quantity decimal(12,3) [note: 'Quantity actually received']
  sku varchar [note: 'Supplier SKU code']
  tax_amount decimal(12,2) [note: 'Tax amount on the line']
  unit_of_measure varchar [note: 'Unit of measure for the line']
  unit_price decimal(12,4) [note: 'Price per unit']
  updated_timestamp timestamp [note: 'Record last update timestamp']

  Note: 'Individual line items on a supply purchase order specifying ingredient, quantity, and price.'
}

Table supply.goods_receipt {
  goods_receipt_id varchar [pk, note: 'Primary key']
  contract_id varchar [note: 'FK to governing contract']
  cost_center_id varchar [note: 'FK to cost center for accounting']
