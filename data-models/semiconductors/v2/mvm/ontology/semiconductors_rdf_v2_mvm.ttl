ind:primaryPmToolChamberId rdf:type rdf:Property ;
    rdfs:label 'Primary Pm Tool Chamber Id' ;
    rdfs:comment 'Foreign key linking to equipment.tool_chamber. Business justification: Preventive maintenance schedules in semiconductor fabs are defined at the chamber level for multi-chamber tools — e.g., a weekly chamber clean cycle for chamber A of a CVD tool, or a quarterly RF gene' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ToolChamber .

ind:requiredMaterialMasterId rdf:type rdf:Property ;
    rdfs:label 'Required Material Master Id' ;
    rdfs:comment 'Foreign key linking to supply.material_master. Business justification: PM schedules reference specific consumable materials (process gases, cleaning agents, replacement consumables) beyond spare parts. Linking to material_master enables MRP-driven consumable planning and' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:ObjectProperty ;
