  sample_size varchar [note: 'Sample size used in the audit']
  scheduled_end_date date [note: 'Scheduled end date of the audit']
  scheduled_start_date date [note: 'Scheduled start date of the audit']
  scope varchar [note: 'Scope and coverage of the audit']
  team_size varchar [note: 'Size of the audit team']
  trigger varchar [note: 'Trigger or reason for the audit']
  updated_timestamp timestamp
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutation to ensure change']
  vibe_mutation_marker varchar [note: 'Marker added by VIBE mutator to indicate change']
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']

  Note: 'Compliance audits conducted by internal or external auditors to assess adherence to regulations and policies'
}

Table compliance.audit_finding {
  audit_finding_id varchar [pk, note: 'Unique identifier for the audit finding record. Primary key.']
  care_site_id varchar [note: 'Reference to the specific facility, hospital, clinic, or care site where the finding was identified. Links to the facility product.']
  compliance_audit_id varchar [note: 'Reference to the parent compliance audit during which this finding was identified. Links to the compliance_audit product.']
  compliance_policy_id varchar [note: 'Reference to the organizational policy that was violated or requires update as a result of this finding. Links to the policy product. Null if no specific policy is implicated.']
  compliance_program_id varchar
  cpt_code_id varchar [note: 'Foreign key linking to reference.cpt_code. Business justification: Audit findings reference specific CPT codes when identifying billing compliance issues, upcoding, unbundling violations, or modifier misuse. Critical for revenue cycle compliance and OIG audit respons']
  drg_id varchar [note: 'Foreign key linking to reference.drg. Business justification: DRG validation audits identify specific DRG assignments that were incorrect or unsupported by documentation. Essential for inpatient reimbursement compliance and RAC audit defense.']
  icd_code_id varchar [note: 'Foreign key linking to reference.icd_code. Business justification: Audit findings cite specific ICD codes when documenting clinical documentation deficiencies, DRG validation errors, or medical necessity issues. Essential for coding compliance audits and CAP tracking']
  interface_channel_id varchar [note: 'Foreign key linking to interoperability.interface_channel. Business justification: Audit findings frequently cite specific interface configuration issues, message validation failures, or data exchange vulnerabilities. Linking findings to the affected interface channel enables target']
  parent_audit_finding_id varchar [note: 'Self-referencing FK on audit_finding (related_audit_finding_id)']
  primary_previous_finding_audit_finding_id varchar [note: 'Reference to the prior audit finding record if this is a recurrence. Links to another audit_finding record. Null if this is not a repeat finding.']
  accreditation_impact_flag boolean [note: 'Indicates whether the finding could affect the organization\'s accreditation status with Joint Commission, DNV, HFAP, or other accrediting bodies. True if accreditation is at risk; false otherwise.']
  actual_resolution_date date [note: 'The date on which the finding was actually resolved, corrective actions were completed, and the finding was closed. Null if still open or in remediation.']
  affected_department varchar [note: 'The department, unit, or service line where the finding was identified (e.g., Emergency Department, Pharmacy, Health Information Management, Infection Control). May reference multiple departments if the finding spans areas.']
  audit_finding_status varchar
  auditor_name varchar [note: 'The name of the auditor, surveyor, or inspector who identified and documented the finding. May be internal compliance staff or external regulatory surveyor.']
  auditor_organization varchar [note: 'The organization or agency the auditor represents (e.g., Joint Commission, CMS Regional Office, State Department of Health, Internal Audit Department).']
  corrective_action_required_flag boolean [note: 'Indicates whether a formal corrective action plan is required to address the finding. True for deficiencies and condition-level findings; false for observations and informational findings.']
  created_timestamp timestamp [note: 'The timestamp when this audit finding record was first created in the system. Used for audit trail and data lineage.']
  days_to_resolution varchar [note: 'The number of calendar days between the identified date and the actual resolution date. Used for performance measurement and trend analysis of remediation effectiveness.']
  dispute_reason varchar [note: 'If the finding status is disputed, this field captures the organization\'s rationale for contesting the finding, including supporting evidence and regulatory interpretation arguments. Null if not disputed.']
  dispute_submitted_date date [note: 'The date on which a formal dispute or appeal of the finding was submitted to the regulatory authority. Null if not disputed.']
  effective_date date
  evidence_location varchar [note: 'The file path, document management system location, or reference to where supporting evidence and documentation for the finding is stored (e.g., audit work papers, photographs, medical records reviewed).']
  expiration_date date
  financial_penalty_risk_flag boolean [note: 'Indicates whether the finding carries risk of financial penalties, fines, or reimbursement recoupment from CMS, state agencies, or other payers. True if monetary sanctions are possible; false otherwise.']
  finding_description varchar [note: 'Detailed narrative description of the deficiency, observation, or non-compliance issue identified. Includes what was observed, why it constitutes a finding, and the specific circumstances or evidence supporting the citation.']
  finding_number varchar [note: 'The externally-known unique identifier or tracking number assigned to this finding within the audit (e.g., F-2024-001, CMS-CoP-123). Used for audit documentation and regulatory correspondence.']
  finding_status varchar [note: 'Current lifecycle status of the finding. Open indicates newly identified; in remediation indicates corrective action plan is being executed; pending verification indicates awaiting auditor review; closed indicates resolved and accepted; disputed indicates organization contests the finding; deferred indicates resolution postponed.']
  finding_type varchar [note: 'Classification of the finding severity and nature. Deficiency indicates non-compliance requiring corrective action; observation is a noted concern without formal citation; opportunity for improvement is a recommendation; immediate jeopardy indicates serious threat to patient safety; condition-level deficiency is a systemic CMS compliance failure; best practice gap is advisory.']
  follow_up_audit_required_flag boolean [note: 'Indicates whether a follow-up audit or validation survey is required to verify that corrective actions have been effectively implemented. True if follow-up is mandated; false otherwise.']
  follow_up_audit_scheduled_date date [note: 'The scheduled date for the follow-up audit or validation survey to verify corrective action effectiveness. Null if no follow-up is required or not yet scheduled.']
  identified_date date [note: 'The date on which the finding was first identified during the audit or inspection. This is the principal business event timestamp for the finding.']
  mandatory_reporting_required_flag boolean [note: 'Indicates whether the finding triggers mandatory external reporting obligations to CMS, state health departments, Joint Commission, or other regulatory bodies. True if external reporting is required; false otherwise.']
  modified_by_user varchar [note: 'The username or identifier of the user who last modified this audit finding record. Used for accountability and audit trail.']
  modified_timestamp timestamp [note: 'The timestamp when this audit finding record was last modified. Used for audit trail and change tracking.']
  notes varchar
  patient_safety_impact_flag boolean [note: 'Indicates whether the finding has direct or potential impact on patient safety. True if patient harm occurred or could occur; false if the finding is administrative or process-related without direct patient safety implications.']
  recurrence_flag boolean [note: 'Indicates whether this finding is a repeat or recurrence of a previously identified and supposedly corrected issue. True if this is a repeat finding; false if this is the first occurrence.']
  regulatory_framework varchar [note: 'The overarching regulatory framework or governing body under which the cited standard falls (e.g., HIPAA for privacy violations, CMS CoP for hospital conditions, Joint Commission for accreditation standards, OSHA for workplace safety). [ENUM-REF-CANDIDATE: hipaa|cms_cop|joint_commission|osha|state_health_department|fda|dea|emtala|stark_law|anti_kickback|other — 11 candidates stripped; promote to reference product]']
  regulatory_standard_cited varchar [note: 'The specific regulatory standard, rule, or requirement that was violated or not met (e.g., 42 CFR 482.13, Joint Commission LD.04.03.11, OSHA 29 CFR 1910.1030). May include multiple citations separated by semicolons.']
  reported_to_authority_date date [note: 'The date on which the finding was reported to the applicable regulatory authority, if mandatory reporting was required. Null if not reported or not required.']
  responsible_party_email varchar [note: 'The email address of the responsible party for follow-up communication and status updates regarding the finding remediation.']
  responsible_party_name varchar [note: 'The name of the individual, role, or department assigned ownership and accountability for remediating the finding and implementing corrective actions.']
  root_cause_category varchar [note: 'The primary root cause category identified through analysis of why the finding occurred. Used to drive systemic corrective actions and prevent recurrence. [ENUM-REF-CANDIDATE: policy_gap|training_deficiency|process_failure|resource_constraint|communication_breakdown|technology_issue|human_error|documentation_failure|other — 9 candidates stripped; promote to reference product]']
  scope_of_impact varchar [note: 'The breadth of the finding across the organization. Isolated indicates a single incident; pattern indicates multiple occurrences in one area; widespread indicates multiple areas affected; systemic indicates organization-wide process failure.']
  severity_level varchar [note: 'The assessed severity or risk level of the finding. Critical indicates immediate threat to patient safety or major regulatory violation; high indicates significant compliance risk; medium indicates moderate risk; low indicates minor issue; informational indicates advisory note without compliance impact.']
  tags_keywords varchar [note: 'Comma-separated list of tags or keywords for categorization, search, and reporting (e.g., infection_control, medication_safety, documentation, privacy, emergency_preparedness). Supports analytics and trend identification.']
  target_resolution_date date [note: 'The date by which the finding must be resolved and corrective actions completed. May be mandated by regulatory authority or set internally based on risk assessment.']
  updated_timestamp timestamp
  verification_method varchar [note: 'The method used by the auditor to verify and validate the finding (e.g., document review, on-site inspection, staff interviews, medical record audit). May include multiple methods. [ENUM-REF-CANDIDATE: document_review|on_site_inspection|staff_interview|medical_record_audit|policy_review|observation|testing|other — 8 candidates stripped; promote to reference product]']
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutation to ensure change']
  vibe_mutation_marker varchar
  vibe_mutation_timestamp timestamp [note: 'Auto‑added by VIBE mutator to register a change']
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']

  Note: 'Individual findings identified during compliance audits'
}

Table compliance.corrective_action_plan {
  corrective_action_plan_id varchar [pk, note: 'Unique identifier for the corrective action plan record. Primary key.']
  audit_finding_id varchar [note: 'Reference to the primary audit finding or compliance violation that triggered this corrective action plan.']
  budget_id varchar [note: 'Foreign key linking to finance.budget. Business justification: CAPs often require capital expenditures or operational budget allocations for remediation (system upgrades, additional staffing, consultant fees). Links denormalized financial_impact_estimate to forma']
  capital_project_id varchar [note: 'Foreign key linking to finance.capital_project. Business justification: CAPs frequently require capital investments for remediation (HVAC upgrades for infection control, IT system implementations for HIPAA compliance, facility modifications for life safety). Links CAP to ']
  compliance_policy_id varchar [note: 'Reference to the organizational policy that was updated, created, or reinforced as part of this corrective action plan.']
  cpt_code_id varchar [note: 'Foreign key linking to reference.cpt_code. Business justification: CAPs remediate specific procedure code compliance issues, tracking which CPT codes require documentation improvement, modifier education, or billing practice changes to prevent recurrence.']
  icd_code_id varchar [note: 'Foreign key linking to reference.icd_code. Business justification: CAPs address specific diagnosis code misuse patterns identified in audits, requiring remediation tied to particular ICD codes (e.g., sepsis coding education, specificity improvement for diabetes codes']
  payer_id varchar [note: 'Foreign key linking to insurance.payer. Business justification: CAPs often result from payer audits (claims audits, medical record reviews, contract compliance audits) or address payer-identified deficiencies. Tracking which payer triggered or is monitoring the CA']
  privacy_incident_hipaa_privacy_incident_id varchar [note: 'Foreign key linking to compliance.hipaa_privacy_incident. Business justification: Corrective action plans can be created in response to HIPAA privacy incidents, not just audit findings. CAP should support multiple trigger types. This FK allows tracking CAPs created to remediate pri']
  scheduling_appointment_id varchar [note: 'Foreign key linking to scheduling.scheduling_appointment. Business justification: CAPs may require appointment-level remediation including rebilling, documentation correction, or patient notification. Real remediation scope for billing and documentation findings.']
  security_risk_hipaa_security_risk_id varchar [note: 'Foreign key linking to compliance.hipaa_security_risk. Business justification: Corrective action plans can be created to mitigate HIPAA security risks identified during risk assessments. This FK allows tracking CAPs created to address security risks. N:1 relationship (many CAPs ']
  superseded_corrective_action_plan_id varchar [note: 'Self-referencing FK on corrective_action_plan (superseded_corrective_action_plan_id)']
  actual_completion_date date [note: 'Actual date when all corrective actions were fully implemented and ready for verification.']
  cap_number varchar [note: 'Business identifier for the corrective action plan, externally visible and used in regulatory submissions and audit correspondence.']
  cap_status varchar [note: 'Current lifecycle status of the corrective action plan in the regulatory response and implementation workflow. [ENUM-REF-CANDIDATE: draft|submitted|approved|in_progress|completed|verified|closed — 7 candidates stripped; promote to reference product]']
  cap_type varchar [note: 'Classification of the corrective action plan based on regulatory requirement and scope of response.']
  closed_timestamp timestamp [note: 'Timestamp when the corrective action plan was formally closed after successful verification and regulatory acceptance.']
  closure_notes varchar [note: 'Final notes documenting the closure of the corrective action plan, including lessons learned and recommendations for future compliance improvement.']
  corrective_actions_defined varchar [note: 'Detailed description of the specific corrective actions, process changes, policy updates, training programs, or system enhancements that will be implemented to address the deficiency.']
  created_by_user varchar [note: 'Username or identifier of the compliance officer or staff member who created the corrective action plan record.']
  created_timestamp timestamp [note: 'Timestamp when the corrective action plan record was first created in the compliance management system.']
  escalation_required_flag boolean [note: 'Indicates whether the corrective action plan requires escalation to executive leadership, board of directors, or external regulatory authority due to severity or complexity.']
  external_consultant_engaged_flag boolean [note: 'Indicates whether external consultants, subject matter experts, or legal counsel were engaged to support corrective action plan development or implementation.']
  implementation_milestones varchar [note: 'Key milestones, checkpoints, and deliverables defined in the corrective action plan implementation timeline.']
  modified_by_user varchar [note: 'Username or identifier of the user who last modified the corrective action plan record.']
  modified_timestamp timestamp [note: 'Timestamp when the corrective action plan record was last modified or updated.']
  monitoring_frequency varchar [note: 'Frequency at which ongoing monitoring and auditing will be conducted to ensure sustained compliance after corrective action plan implementation.']
  patient_safety_impact_flag boolean [note: 'Indicates whether the compliance violation and corrective action plan directly impact patient safety or quality of care.']
  priority_level varchar [note: 'Priority classification of the corrective action plan based on severity of the violation, patient safety impact, and regulatory urgency.']
  recurrence_prevention_measures varchar [note: 'Specific measures, controls, monitoring mechanisms, or system changes implemented to prevent recurrence of the compliance violation.']
  regulator_approval_date date [note: 'Date when the regulatory body or accreditation agency formally approved the corrective action plan.']
  regulator_feedback varchar [note: 'Feedback, comments, or additional requirements provided by the regulatory body or accreditation agency in response to the submitted corrective action plan.']
  regulatory_requirement_reference varchar [note: 'Citation of the specific regulatory requirement, standard, or condition of participation that was violated and is being addressed by this CAP.']
  responsible_owner_department varchar [note: 'Department or organizational unit responsible for executing the corrective action plan.']
  responsible_owner_email varchar [note: 'Email contact for the individual responsible for the corrective action plan implementation.']
  responsible_owner_name varchar [note: 'Name of the individual or role accountable for implementing and completing the corrective action plan.']
  root_cause_analysis_summary varchar [note: 'Summary of the root cause analysis conducted to identify the underlying factors that led to the compliance violation or audit finding.']
  staff_affected_count varchar [note: 'Number of staff members, departments, or organizational units affected by or involved in the corrective action plan implementation.']
  submitted_to_regulator_date date [note: 'Date when the corrective action plan was formally submitted to the regulatory body or accreditation agency.']
  target_completion_date date [note: 'Planned date by which all corrective actions must be fully implemented and verified, as committed to the regulatory body or accreditation agency.']
  training_completion_target_date date [note: 'Target date by which all required staff training must be completed as part of the corrective action plan.']
  training_required_flag boolean [note: 'Indicates whether staff training or education is required as part of the corrective action plan implementation.']
  verification_date date [note: 'Date when the corrective action plan was verified as complete and effective by internal compliance or external regulatory authority.']
  verification_method varchar [note: 'Method by which the effectiveness and completion of the corrective action plan will be verified by internal compliance or external regulatory surveyors. [ENUM-REF-CANDIDATE: document_review|on_site_inspection|staff_interview|medical_record_audit|policy_review|training_records_review|system_validation — 7 candidates stripped; promote to reference product]']
  verification_notes varchar [note: 'Detailed notes from the verification process documenting findings, evidence reviewed, and any remaining concerns or recommendations.']
  verification_outcome varchar [note: 'Result of the verification process indicating whether the corrective actions were found to be effective and sustainable.']
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutation to ensure change']
  vibe_mutation_marker varchar
  vibe_mutation_timestamp timestamp [note: 'Auto‑added by VIBE mutator to register a change']
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']

  Note: 'Corrective action plans developed to address audit findings and compliance gaps'
}

Table compliance.hipaa_privacy_incident {
  hipaa_privacy_incident_id varchar [pk, note: 'Unique identifier for the HIPAA privacy incident record. Primary key.']
  message_log_id varchar [note: 'Foreign key linking to interoperability.message_log. Business justification: Privacy incidents often originate from or are discovered through message exchange logs (unauthorized access, improper disclosure via interface). Linking incidents to specific message logs provides evi']
  note_id varchar [note: 'Foreign key linking to clinical.clinical_note. Business justification: Privacy breach investigations frequently identify specific clinical notes that were inappropriately accessed or disclosed. HIPAA incident response requires documenting which exact note records were in']
  parent_hipaa_privacy_incident_id varchar [note: 'Self-referencing FK on hipaa_privacy_incident (related_hipaa_privacy_incident_id)']
  payer_id varchar [note: 'Foreign key linking to insurance.payer. Business justification: Privacy incidents involving payer data (eligibility file breaches, claims data exposure, remittance misdirection) must track which payer\'s data was involved for breach notification, business associate']
  phi_access_log_id varchar [note: 'Foreign key linking to compliance.phi_access_log. Business justification: Privacy incidents are often discovered through access log reviews; linking the specific log entries that triggered the incident investigation is standard practice for breach determination and OCR repo']
  affected_individuals_count varchar [note: 'The number of unique individuals whose PHI was potentially or actually compromised in the incident.']
  breach_determination_date date [note: 'The date when the formal breach determination was completed.']
  breach_determination_outcome varchar [note: 'The formal determination of whether the incident constitutes a breach under HIPAA Breach Notification Rule based on the four-factor risk assessment.']
  closed_date date [note: 'The date when the incident investigation and all required actions were completed and the case was formally closed.']
  created_timestamp timestamp [note: 'The timestamp when this incident record was first created in the system.']
  disciplinary_action_taken_flag boolean [note: 'Indicates whether disciplinary action was taken against any workforce member as a result of the incident.']
  discovery_date date [note: 'The date when the organization first became aware of the potential privacy incident or breach.']
  incident_category varchar [note: 'High-level categorization of the root cause or mechanism of the incident.']
  incident_date date [note: 'The date when the unauthorized access, use, or disclosure of Protected Health Information (PHI) occurred or is estimated to have occurred.']
  incident_description varchar [note: 'Detailed narrative description of the privacy incident including circumstances, individuals involved, and sequence of events.']
  incident_number varchar [note: 'Business-facing unique identifier or case number assigned to the privacy incident for tracking and reference purposes.']
  incident_status varchar [note: 'Current lifecycle status of the privacy incident investigation and resolution process. [ENUM-REF-CANDIDATE: reported|under investigation|breach determination pending|breach confirmed|not a breach|closed|remediation in progress — 7 candidates stripped; promote to reference product]']
  incident_type varchar [note: 'Classification of the nature of the privacy incident describing how the unauthorized use or disclosure occurred. [ENUM-REF-CANDIDATE: unauthorized access|improper disclosure|lost device|stolen device|misdirected communication|insider threat|hacking|ransomware|phishing — 9 candidates stripped; promote to reference product]']
  individual_notification_date date [note: 'The date when notification letters were sent to affected individuals (must be within 60 days of discovery).']
  individual_notification_required_flag boolean [note: 'Indicates whether notification to affected individuals is required under HIPAA Breach Notification Rule.']
  investigation_summary varchar [note: 'Detailed summary of the investigation findings including root cause analysis and contributing factors.']
  law_enforcement_case_number varchar [note: 'Case or reference number assigned by law enforcement if the incident was reported to police or other authorities.']
  law_enforcement_notified_flag boolean [note: 'Indicates whether law enforcement agencies were notified of the incident.']
  lessons_learned varchar [note: 'Key lessons learned from the incident and recommendations for organizational improvement.']
  location_of_incident varchar [note: 'Physical or system location where the privacy incident occurred (e.g., facility name, department, system name).']
  media_notification_date date [note: 'The date when media notification was issued for breaches affecting 500 or more individuals.']
  media_notification_required_flag boolean [note: 'Indicates whether media notification is required (for breaches affecting 500 or more individuals in a jurisdiction).']
  mitigation_measures varchar [note: 'Description of immediate mitigation measures taken to limit harm and prevent further unauthorized access or disclosure.']
  modified_timestamp timestamp [note: 'The timestamp when this incident record was last modified or updated.']
  notification_required_flag boolean [note: 'Indicates whether breach notification to affected individuals, HHS Office for Civil Rights (OCR), and/or media is required.']
  ocr_case_number varchar [note: 'The case or reference number assigned by HHS Office for Civil Rights upon receipt of the breach report.']
  ocr_reporting_required_flag boolean [note: 'Indicates whether reporting to HHS Office for Civil Rights is required.']
  ocr_reporting_status varchar [note: 'Current status of the breach report submission to HHS Office for Civil Rights.']
  ocr_submission_date date [note: 'The date when the breach report was submitted to HHS Office for Civil Rights (within 60 days for 500+ individuals, or annually for fewer than 500).']
  phi_involved_flag boolean [note: 'Indicates whether Protected Health Information was involved in the incident.']
  phi_type varchar [note: 'Description of the type or category of PHI that was accessed, used, or disclosed (e.g., medical records, billing information, lab results, demographic data).']
  phi_volume_records varchar [note: 'The number of patient records or PHI records involved in the incident.']
  policy_violation_flag boolean [note: 'Indicates whether the incident involved a violation of organizational privacy policies or procedures.']
  privacy_officer_assigned varchar [note: 'Name of the privacy officer or compliance officer assigned to investigate and manage the incident.']
  remediation_actions_taken varchar [note: 'Description of corrective and remediation actions taken to address the incident and prevent recurrence.']
  remediation_completion_date date [note: 'The date when all remediation actions were completed.']
  reported_by_department varchar [note: 'Department or organizational unit of the individual who reported the incident.']
  reported_by_name varchar [note: 'Name of the individual who initially reported or discovered the privacy incident.']
  reported_by_role varchar [note: 'Job title or role of the individual who reported the incident.']
  risk_assessment_completed_flag boolean [note: 'Indicates whether the required four-factor risk assessment has been completed to determine breach status.']
  risk_assessment_summary varchar [note: 'Summary of the four-factor risk assessment findings including nature and extent of PHI, unauthorized person, actual acquisition or viewing, and extent of mitigation.']
  root_cause varchar [note: 'Identified root cause of the privacy incident based on investigation findings.']
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutation to ensure change']
  vibe_mutation_marker varchar
  vibe_mutation_timestamp timestamp [note: 'Auto‑added by VIBE mutator to register a change']
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']

  Note: 'HIPAA privacy incidents and breaches requiring investigation and reporting'
}

Table compliance.hipaa_security_risk {
  hipaa_security_risk_id varchar [pk, note: 'Unique identifier for the HIPAA Security Rule risk analysis record. Primary key for the risk register.']
  audit_finding_id varchar [note: 'Reference to an internal or external audit finding that identified this risk, if applicable.']
  equipment_asset_id varchar [note: 'Reference to the specific IT asset, facility, or resource in the asset inventory that is exposed to this risk.']
  interface_channel_id varchar [note: 'Foreign key linking to interoperability.interface_channel. Business justification: HIPAA security risk assessments must evaluate interface channels as potential threat vectors for ePHI exposure. Linking risks to specific channels enables risk-based interface security controls, vulne']
  primary_hipaa_risk_owner_employee_id varchar [note: 'Reference to the employee or role accountable for managing and monitoring this risk. Typically a department head, system owner, or security officer.']
  prior_hipaa_security_risk_id varchar [note: 'Self-referencing FK on hipaa_security_risk (prior_hipaa_security_risk_id)']
  related_incident_hipaa_privacy_incident_id varchar [note: 'Reference to a security incident or breach event that triggered the identification of this risk, if applicable.']
  tertiary_hipaa_identified_by_employee_id varchar [note: 'Reference to the employee, auditor, or security analyst who identified and documented this risk.']
  affected_ephi_system varchar [note: 'Name or identifier of the information system, application, or asset that contains or processes ePHI and is subject to this risk. Examples include EHR system, billing system, patient portal, or backup storage.']
  closed_timestamp timestamp [note: 'System timestamp when this risk was formally closed or resolved, indicating it is no longer an active concern.']
  control_effectiveness varchar [note: 'Assessment of how well existing controls are functioning to mitigate the risk. Rated as effective, partially effective, ineffective, or not implemented.']
  created_timestamp timestamp [note: 'System timestamp when this risk record was first created in the risk management system.']
  existing_controls varchar [note: 'Description of current safeguards, policies, procedures, or technical controls already in place that reduce the likelihood or impact of this risk.']
  identification_method varchar [note: 'Method or source through which the risk was identified, such as vulnerability scan, penetration test, internal audit, external audit, incident investigation, or self-assessment.']
  identified_date date [note: 'Date when this risk was first identified and documented in the risk register.']
  impact_rating varchar [note: 'Qualitative assessment of the potential harm or damage if the risk is realized. Considers confidentiality, integrity, and availability impact on ePHI, as well as financial, reputational, and regulatory consequences.']
  impact_score varchar [note: 'Numeric score representing the magnitude of impact if the risk occurs, typically on a scale of 1-5 or 1-10, used for quantitative risk calculation.']
  inherent_risk_level varchar [note: 'Overall risk level before considering existing controls, calculated from likelihood and impact. Categorized as critical, high, medium, or low. Represents the raw exposure.']
  inherent_risk_score varchar [note: 'Numeric inherent risk score, typically calculated as likelihood_score multiplied by impact_score, representing the risk exposure before mitigation.']
  last_review_date date [note: 'Date when this risk was last reviewed and reassessed by the risk owner or security team.']
  likelihood_rating varchar [note: 'Qualitative assessment of the probability that the threat will exploit the vulnerability. Rated as very low, low, medium, high, or very high based on threat frequency, vulnerability severity, and existing controls.']
  likelihood_score varchar [note: 'Numeric score representing the likelihood of occurrence, typically on a scale of 1-5 or 1-10, used for quantitative risk calculation.']
  mitigation_actual_completion_date date [note: 'Actual date when mitigation controls were fully implemented and verified as operational.']
  mitigation_controls_implemented varchar [note: 'List or description of new safeguards, policies, procedures, or technical controls that have been implemented to mitigate this risk.']
  mitigation_plan varchar [note: 'Detailed description of the action plan to reduce the risk, including specific controls to be implemented, responsible parties, and timelines.']
  mitigation_start_date date [note: 'Date when mitigation activities began or are scheduled to begin.']
  mitigation_target_completion_date date [note: 'Planned or target date by which mitigation controls should be fully implemented and operational.']
  modified_timestamp timestamp [note: 'System timestamp when this risk record was last updated or modified.']
  next_review_date date [note: 'Scheduled date for the next periodic review of this risk to reassess likelihood, impact, control effectiveness, and treatment decisions. HIPAA requires annual risk analysis.']
  notes varchar [note: 'Additional comments, context, or documentation related to this risk, including historical decisions, stakeholder discussions, or special considerations.']
  regulatory_citation varchar [note: 'Specific HIPAA Security Rule section or other regulatory requirement that this risk relates to, such as §164.308(a)(3) for workforce security or §164.312(a)(1) for access control.']
  residual_risk_level varchar [note: 'Overall risk level after considering existing and planned mitigation controls. Categorized as critical, high, medium, or low. Represents the remaining exposure after treatment.']
  residual_risk_score varchar [note: 'Numeric residual risk score after mitigation, calculated from adjusted likelihood and impact scores, representing the remaining risk exposure.']
  risk_acceptance_date date [note: 'Date when the risk acceptance decision was formally approved by management.']
  risk_acceptance_justification varchar [note: 'Business rationale and approval documentation for accepting a risk without further mitigation, including cost-benefit analysis and management sign-off.']
  risk_assessment_cycle_code varchar [note: 'Reference to the annual or periodic risk assessment cycle during which this risk was identified. Links to the broader compliance assessment program.']
  risk_category varchar [note: 'High-level classification of the risk aligned with HIPAA Security Rule safeguard categories: administrative, physical, technical, or organizational.']
  risk_number varchar [note: 'Business-facing unique identifier for the risk, typically formatted as a human-readable code (e.g., RISK-2024-001) for tracking and reporting purposes.']
  risk_owner_department varchar [note: 'Department or business unit responsible for managing this risk, such as IT, Compliance, Clinical Operations, or Health Information Management (HIM).']
  risk_status varchar [note: 'Current lifecycle status of the risk: open (newly identified), in progress (mitigation underway), mitigated (controls implemented), accepted (risk tolerance decision made), or closed (risk no longer applicable).']
  risk_subcategory varchar [note: 'Detailed classification of the risk within the category, such as access control, encryption, workforce security, or facility access.']
  risk_title varchar [note: 'Short descriptive title of the identified risk, summarizing the threat or vulnerability in business terms.']
  risk_treatment_decision varchar [note: 'Strategic decision on how to address the risk: accept (tolerate the risk), mitigate (implement controls to reduce risk), transfer (shift risk via insurance or contract), or avoid (eliminate the activity causing the risk).']
  threat_description varchar [note: 'Detailed description of the threat agent or event that could exploit the vulnerability and cause harm to ePHI (Electronic Protected Health Information). Examples include malware, unauthorized access, natural disaster, or insider threat.']
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutation to ensure change']
  vibe_mutation_marker varchar
  vibe_mutation_timestamp timestamp [note: 'Auto‑added by VIBE mutator to register a change']
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']
  vulnerability_description varchar [note: 'Detailed description of the weakness or gap in controls that could be exploited by the threat. Examples include unpatched systems, weak passwords, lack of encryption, or inadequate physical security.']

  Note: 'HIPAA security risks identified through risk assessments and security evaluations'
}

Table compliance.training {
  training_id varchar [pk, note: 'Unique identifier for the compliance training program. Primary key.']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: Training programs are delivered by specific departments and funded through their cost centers. Training costs (development, delivery, vendor fees) must be allocated for financial tracking, budget mana']
  cpt_code_id varchar [note: 'Foreign key linking to reference.cpt_code. Business justification: Procedure coding training targets specific CPT codes with high error rates, compliance risk, or frequent NCCI edits, necessitating direct linkage for curriculum design and effectiveness tracking.']
  icd_code_id varchar [note: 'Foreign key linking to reference.icd_code. Business justification: Compliance training modules focus on specific high-risk or frequently misused diagnosis codes (sepsis, MI, diabetes with complications), requiring direct code references for targeted coder education.']
  prerequisite_training_id varchar [note: 'Self-referencing FK on training (prerequisite_training_id)']
  accreditation_body varchar [note: 'Organization that has accredited or certified this training program. Examples: ANCC, AMA, AAFP. Null if not accredited.']
  accreditation_number varchar [note: 'Unique accreditation or certification number assigned by the accrediting body. Used for external reporting and audit.']
  approval_authority varchar [note: 'Role or individual who approved this training program for deployment. Examples: Chief Compliance Officer, Chief Medical Officer, VP Human Resources.']
  approval_date date [note: 'Date when the training program was formally approved for use by the approval authority.']
  assessment_required_flag boolean [note: 'Indicates whether the training includes a graded assessment that must be passed for completion. True if assessment is required, False if completion is based on participation only.']
  attestation_required_flag boolean [note: 'Indicates whether the learner must sign an attestation statement acknowledging understanding and commitment to comply. Common for Code of Conduct and policy-based training.']
  certificate_issued_flag boolean [note: 'Indicates whether a completion certificate is issued upon successful completion of the training. True if certificate is generated, False otherwise.']
  content_author varchar [note: 'Name of the individual or team who developed the training content.']
  content_location_url varchar [note: 'URL or file path where the training content is hosted. Used by learning management systems to launch the training.']
  content_owner varchar [note: 'Department or role responsible for maintaining the training content and ensuring accuracy and regulatory alignment. Examples: Compliance Department, Infection Prevention, Human Resources.']
  created_timestamp timestamp [note: 'Timestamp when this training program record was first created in the system. Used for audit trail and data lineage.']
  duration_minutes decimal(5,2) [note: 'Expected time in minutes required to complete the training program. Used for workforce planning and scheduling.']
  effective_date date [note: 'Date when this training program version became active and available for assignment. Used to track training content versioning.']
  escalation_threshold_days varchar [note: 'Number of days past the due date after which non-completion triggers an escalation to management. Used for compliance enforcement.']
  expiration_date date [note: 'Date when this training program version is no longer valid or available for new assignments. Null if the training has no planned end date.']
  format varchar [note: 'Delivery method for the training program. Determines how learners access and complete the training. [ENUM-REF-CANDIDATE: Online|In-Person|Blended|Simulation|On-the-Job|Self-Study|Webinar|Video — 8 candidates stripped; promote to reference product]']
  frequency varchar [note: 'How often the training must be completed to maintain compliance. Drives recurrence scheduling and assignment logic. [ENUM-REF-CANDIDATE: Annual|Biennial|One-Time|Upon Hire|Upon Role Change|Quarterly|As Needed — 7 candidates stripped; promote to reference product]']
  frequency_months varchar [note: 'Numeric representation of training recurrence interval in months. Used for automated scheduling. Examples: 12 for annual, 24 for biennial, null for one-time.']
  keywords varchar [note: 'Comma-separated list of keywords and tags used for training catalog search and discovery.']
  last_review_date date [note: 'Date when the training content was last reviewed and validated for accuracy and regulatory compliance.']
  learning_objectives varchar [note: 'Summary of the key learning outcomes and competencies the training is designed to achieve. Used for curriculum mapping and competency tracking.']
  modified_timestamp timestamp [note: 'Timestamp when this training program record was last modified. Used for audit trail and change tracking.']
  next_review_date date [note: 'Scheduled date for the next content review. Used to trigger review workflows and ensure training remains current.']
  non_compliance_consequence varchar [note: 'Description of the organizational consequence for failing to complete required training. Examples: Loss of system access, disciplinary action, termination.']
  passing_score_threshold decimal(5,2) [note: 'Minimum score required to successfully complete the training, expressed as a percentage (0.00 to 100.00). Null if no assessment is required.']
  policy_reference varchar [note: 'Reference to the organizational policy or policies that this training supports. Links training to the governance framework.']
  priority_level varchar [note: 'Business priority assigned to this training program. Critical and High priority training may trigger escalation workflows for non-completion.']
  regulatory_authority varchar [note: 'The governing body or agency that mandates this training requirement. Examples: HHS Office for Civil Rights, OSHA, CMS, The Joint Commission, State Department of Health.']
  regulatory_mandate varchar [note: 'The specific regulation, statute, or accreditation standard that requires this training. Examples: HIPAA Privacy Rule 45 CFR 164.530(b), OSHA 29 CFR 1910.1030, Joint Commission HR.01.06.01.']
  retired_reason varchar [note: 'Explanation for why the training program was retired. Examples: Superseded by new version, Regulatory requirement removed, Content no longer relevant.']
  retired_timestamp timestamp [note: 'Timestamp when this training program was retired and removed from active use. Null if the training is still active or suspended.']
  review_cycle_months varchar [note: 'Frequency in months at which the training content must be reviewed for accuracy and regulatory alignment. Examples: 12, 24, 36.']
  supersedes_training_number varchar [note: 'Training program number that this version replaces. Used to track training evolution and ensure learners complete the most current version.']
  target_audience varchar [note: 'Description of the workforce population required to complete this training. May specify roles, departments, or all staff. Examples: All Staff, Clinical Staff, Physicians, Nurses, Environmental Services, IT Staff, Revenue Cycle Staff.']
  target_department varchar [note: 'Specific department or service line required to complete this training. Used for automated assignment rules.']
  target_role varchar [note: 'Specific job role or role category required to complete this training. Used for automated assignment rules.']
  training_description varchar [note: 'Detailed description of the training program content, scope, and purpose. Displayed to learners and used for catalog search.']
  training_name varchar [note: 'Full name of the compliance training program as displayed to learners and in catalogs.']
  training_number varchar [note: 'Business identifier for the training program, used for external reference and reporting. Typically follows format TRN-XXXXXX.']
  training_status varchar [note: 'Current lifecycle status of the training program. Active programs are available for assignment and completion.']
  training_type varchar [note: 'Category of compliance training program. Defines the subject matter and regulatory domain covered by the training. [ENUM-REF-CANDIDATE: HIPAA Privacy|HIPAA Security|Corporate Compliance|OSHA Bloodborne Pathogens|Fire Safety|Abuse and Neglect|Cultural Competency|Code of Conduct|Emergency Preparedness|Infection Control|Patient Rights|Workplace Violence Prevention|Hazardous Materials|Radiation Safety|Respiratory Protection|Other — 16 candidates stripped; promote to reference product]']
  vendor_course_code varchar [note: 'Unique identifier assigned by the external vendor for this training course. Used for integration and reporting with vendor learning management systems.']
  vendor_name varchar [note: 'Name of the external vendor or content provider if the training is sourced from a third party. Null for internally developed training.']
  version_number varchar [note: 'Version identifier for the training content. Incremented when training materials are updated. Format: major.minor (e.g., 2.1).']
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutation to ensure change']
  vibe_mutation_marker varchar
  vibe_mutation_timestamp timestamp [note: 'Auto‑added by VIBE mutator to register a change']
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']

  Note: 'Compliance training programs and courses required for staff'
}

Table compliance.training_completion {
  training_completion_id varchar [pk, note: 'Unique identifier for the training completion record. Primary key.']
  employee_id varchar [note: 'Reference to the staff member who completed or was assigned the training. Links to the workforce domain employee master.']
  reattempted_training_completion_id varchar [note: 'Self-referencing FK on training_completion (reattempted_training_completion_id)']
  training_id varchar [note: 'Foreign key linking to compliance.training. Business justification: CRITICAL FIX: training_completion.training_program_id currently points to compliance.program.program_id, but it should point to compliance.training.training_id. Training completion records should refe']
  accreditation_body varchar [note: 'Name of the organization that accredited or approved this training program. Examples include ACCME, ANCC, state boards, or internal compliance committees.']
  assigned_date date [note: 'Date when the training program was assigned to the employee. Marks the start of the compliance obligation period.']
  attempt_number varchar [note: 'Sequential attempt number for this training completion. Increments when an employee retakes a failed training.']
  certificate_issued_date date [note: 'Date when the training certificate was officially issued. May differ from completion date for trainings requiring manual review or approval.']
  certificate_number varchar [note: 'Unique certificate or credential number issued upon successful completion. Used for external verification and audit documentation.']
  completion_date date [note: 'Date when the employee successfully completed the training program. Null if training is not yet completed.']
  completion_number varchar [note: 'Business identifier for this training completion event. May be used for certificate tracking and audit trails.']
  completion_status varchar [note: 'Current lifecycle status of the training completion record. Tracks progression from assignment through completion or expiration. [ENUM-REF-CANDIDATE: assigned|in_progress|completed|overdue|waived|expired|not_started — 7 candidates stripped; promote to reference product]']
  completion_timestamp timestamp [note: 'Precise timestamp when the training was marked complete in the Learning Management System (LMS). Used for audit trail and time-sensitive compliance verification.']
  continuing_education_credits decimal(5,2) [note: 'Number of Continuing Education (CE) or Continuing Medical Education (CME) credits awarded for this training completion. Used for professional licensure maintenance.']
  created_timestamp timestamp [note: 'Timestamp when this training completion record was first created in the data platform. Part of the audit trail.']
  credit_type varchar [note: 'Type of continuing education credit awarded. CME (Continuing Medical Education) for physicians, CEU (Continuing Education Unit) for general staff, CNE (Continuing Nursing Education) for nurses, or contact hours.']
  due_date date [note: 'Date by which the training must be completed to maintain compliance. Used for overdue tracking and escalation.']
  employee_department varchar [note: 'Department or organizational unit of the employee at the time of training completion. Captured for compliance reporting by department.']
  employee_facility varchar [note: 'Healthcare facility or location where the employee is assigned. Used for facility-level compliance reporting and Joint Commission readiness.']
  employee_role varchar [note: 'Job role or title of the employee at the time of training completion. Used for role-based compliance reporting and gap analysis.']
  escalation_date date [note: 'Date when the overdue training was escalated to management. Part of the compliance enforcement audit trail.']
  escalation_flag boolean [note: 'Indicates whether this overdue training has been escalated to management or compliance leadership. True if escalated, False otherwise.']
  expiration_date date [note: 'Date when this training completion expires and requires renewal. Null for one-time trainings that do not expire.']
  instructor_name varchar [note: 'Name of the instructor or facilitator who delivered the training. Applicable for in-person and instructor-led sessions.']
  last_reminder_sent_date date [note: 'Date when the most recent reminder notification was sent to the employee. Used for escalation timing and communication tracking.']
  modified_timestamp timestamp [note: 'Timestamp when this training completion record was last modified in the data platform. Used for change tracking and audit purposes.']
  notes varchar [note: 'Free-text notes or comments related to this training completion. May include special circumstances, technical issues, or compliance officer annotations.']
  pass_fail_status varchar [note: 'Indicates whether the employee passed or failed the training assessment. Not applicable for trainings without assessments.']
  passing_score_threshold decimal(5,2) [note: 'Minimum score required to pass the training. Captured at completion time to preserve historical pass/fail criteria.']
  regulatory_requirement_satisfied varchar [note: 'Citation or reference to the specific regulatory requirement satisfied by this training completion. Examples include HIPAA Privacy Rule, OSHA Bloodborne Pathogens Standard, Joint Commission standards.']
  reminder_sent_count varchar [note: 'Number of reminder notifications sent to the employee for this training assignment. Used for tracking engagement and escalation.']
  score_achieved decimal(5,2) [note: 'Numeric score or percentage achieved by the employee on the training assessment. Null if training does not include a scored assessment.']
  source_system_record_code varchar [note: 'Unique identifier of this training completion record in the source system. Used for data lineage and reconciliation.']
  training_duration_minutes decimal(5,2) [note: 'Total time in minutes the employee spent completing the training. Captured from Learning Management System (LMS) tracking data.']
  training_location varchar [note: 'Physical or virtual location where the training was conducted. May be a facility name, room number, or online platform identifier.']
  training_method varchar [note: 'Method by which the training was delivered to the employee. Used for effectiveness analysis and compliance documentation.']
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutation to ensure change']
  vibe_mutation_marker varchar
  vibe_mutation_timestamp timestamp [note: 'Auto‑added by VIBE mutator to register a change']
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']
  waiver_approval_date date [note: 'Date when the training waiver was officially approved. Part of the compliance audit trail.']
  waiver_approved_by varchar [note: 'Name or identifier of the authority who approved the training waiver. Required for audit trail when waiver is granted.']
  waiver_flag boolean [note: 'Indicates whether the training requirement was waived for this employee. True if waived, False otherwise.']
  waiver_reason varchar [note: 'Business justification for waiving the training requirement. Required when waiver_flag is True. Subject to compliance review.']

  Note: 'Individual employee completion records for compliance training'
}

Table compliance.compliance_regulatory_submission {
  compliance_regulatory_submission_id varchar [pk, note: 'Unique identifier for the regulatory submission record. Primary key.']
  chart_of_accounts_id varchar [note: 'Foreign key linking to finance.chart_of_accounts. Business justification: Regulatory submissions with penalties or fees must post to specific GL accounts. Currently has penalty_currency_code but no GL account FK. Enables proper financial recording of regulatory penalties, s']
  code_set_version_id varchar [note: 'Foreign key linking to reference.code_set_version. Business justification: Regulatory submissions (CMS quality reporting, state claims data, HEDIS) must document which ICD/CPT/HCPCS code set versions were used for the reporting period, required for data validation and audit ']
  compliance_employee_id varchar
  compliance_program_id varchar [note: 'Identifier of the enterprise compliance program under which this submission is managed.']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: Regulatory submissions are prepared by specific departments. The cost of preparation, external consultants, and submission fees should be tracked against the responsible cost center for budget managem']
  financial_entity_id varchar [note: 'Identifier of the healthcare facility, hospital, clinic, or organizational unit that is filing the regulatory submission.']
  obligation_id varchar [note: 'Identifier linking this submission to the specific regulatory requirement or obligation it satisfies.']
  payer_id varchar [note: 'Foreign key linking to insurance.payer. Business justification: Many regulatory submissions are payer-specific: CMS cost reports, Medicare Advantage quality reporting (HEDIS/Stars), network adequacy filings, MLR reporting. Tracking which payer each submission rela']
  primary_compliance_prepared_by_employee_id varchar [note: 'Identifier of the employee or staff member who prepared the regulatory submission.']
  primary_original_submission_compliance_regulatory_submission_id varchar [note: 'Identifier of the original submission record if this is a resubmission or correction. Links to the prior submission that was rejected or withdrawn.']
  public_health_report_id varchar [note: 'Foreign key linking to interoperability.public_health_report. Business justification: Many regulatory submissions to CMS, CDC, and state agencies are transmitted via public health reporting interfaces. Linking submissions to their transmission records enables tracking of submission sta']
  regulatory_change_id varchar [note: 'Foreign key linking to compliance.regulatory_change. Business justification: Regulatory submissions may be triggered by new regulatory changes (e.g., new CMS reporting requirement). Each submission should optionally link to the regulatory change that triggered it. This allows ']
  research_study_id varchar
  acceptance_date date [note: 'Date on which the receiving agency formally accepted the submission as complete and compliant.']
  acknowledgment_date date [note: 'Date on which the receiving agency acknowledged receipt of the submission.']
  acknowledgment_number varchar [note: 'Confirmation or tracking number provided by the receiving agency upon acknowledgment of the submission.']
  acknowledgment_received_flag boolean [note: 'Indicates whether the receiving agency has acknowledged receipt of the submission. True = acknowledgment received, False = no acknowledgment received.']
  agency_name varchar
  approval_date date [note: 'Date on which the submission was internally approved for filing with the regulatory agency.']
  attestation_date date [note: 'Date on which the authorized officer attested to the accuracy and completeness of the submission.']
  attestation_officer_name varchar [note: 'Name of the authorized officer (e.g., Chief Executive Officer, Chief Compliance Officer, Chief Medical Officer) who attested to the submission.']
  attestation_required_flag boolean [note: 'Indicates whether the submission requires a formal attestation or certification by an authorized officer. True = attestation required, False = no attestation required.']
  audit_date date [note: 'Date on which the external audit or validation of the submission was conducted.']
  audit_result varchar [note: 'Outcome of the external audit or validation. PASSED = submission validated as accurate, FAILED = submission found to be inaccurate or non-compliant, CONDITIONAL = passed with conditions or corrective actions required, PENDING = audit in progress, NOT_AUDITED = no audit conducted.']
  corrective_action_due_date date [note: 'Deadline by which corrective actions must be completed and documented in response to audit findings or agency feedback.']
  corrective_action_required_flag boolean [note: 'Indicates whether corrective actions are required as a result of audit findings or agency feedback. True = corrective action required, False = no corrective action required.']
  created_timestamp timestamp [note: 'Date and time when this regulatory submission record was first created in the system.']
  document_location_url varchar [note: 'File path, URL, or document management system reference where the submitted regulatory report or supporting documentation is stored.']
  due_date date [note: 'Regulatory deadline by which the submission must be filed to remain compliant.']
  external_audit_flag boolean [note: 'Indicates whether this submission is subject to external audit or validation by the regulatory agency or third-party auditor. True = subject to external audit, False = not subject to external audit.']
  last_modified_timestamp timestamp
  modified_timestamp timestamp [note: 'Date and time when this regulatory submission record was last updated or modified.']
  notes varchar [note: 'Free-text field for additional comments, context, or internal notes related to the regulatory submission, including special circumstances, challenges, or follow-up actions.']
  penalty_amount decimal(15,2) [note: 'Monetary penalty assessed by the regulatory agency for late, incomplete, or non-compliant submission, in US dollars.']
  penalty_currency_code varchar [note: 'Three-letter ISO 4217 currency code for the penalty amount (e.g., USD for US dollars).']
  receiving_agency varchar [note: 'Name of the government agency, accrediting body, or regulatory authority receiving the submission (e.g., CMS, State Department of Health, OSHA, OCR, Joint Commission, CDC).']
  receiving_agency_code varchar [note: 'Standardized code or abbreviation for the receiving regulatory agency (e.g., CMS, OCR, OSHA, TJC, CDC).']
  reference_number varchar
  rejection_date date [note: 'Date on which the receiving agency rejected the submission due to errors, incompleteness, or non-compliance.']
  rejection_reason varchar [note: 'Explanation or code provided by the receiving agency describing why the submission was rejected.']
  reporting_period_end_date date [note: 'End date of the time period covered by the regulatory submission.']
  reporting_period_start_date date [note: 'Start date of the time period covered by the regulatory submission (e.g., calendar quarter, fiscal year, annual period).']
  research_regulatory_submission_id varchar
  response_date date
  resubmission_required_flag boolean [note: 'Indicates whether the submission must be corrected and resubmitted. True = resubmission required, False = no resubmission required.']
  risk_level varchar [note: 'Assessment of the compliance risk associated with this submission, including potential penalties for non-compliance or late filing.']
  submission_date date [note: 'Date on which the regulatory submission was filed or transmitted to the receiving agency.']
  submission_domain varchar [note: 'Domain discriminator: COMPLIANCE or RESEARCH']
  submission_format varchar [note: 'Data format or file type of the regulatory submission. XML = Extensible Markup Language, JSON = JavaScript Object Notation, CSV = comma-separated values, PDF = Portable Document Format, HL7_V2 = Health Level Seven Version 2 message, FHIR = Fast Healthcare Interoperability Resources. [ENUM-REF-CANDIDATE: XML|JSON|CSV|PDF|HL7_V2|FHIR|PAPER|OTHER — 8 candidates stripped; promote to reference product]']
  submission_method varchar [note: 'Method or channel used to transmit the regulatory submission. ELECTRONIC_PORTAL = web-based agency portal, EMAIL = email transmission, FAX = facsimile, MAIL = postal mail, API = application programming interface, HL7_INTERFACE = Health Level Seven (HL7) electronic interface, SFTP = secure file transfer protocol. [ENUM-REF-CANDIDATE: ELECTRONIC_PORTAL|EMAIL|FAX|MAIL|API|HL7_INTERFACE|SFTP|OTHER — 8 candidates stripped; promote to reference product]']
  submission_number varchar [note: 'Business identifier or tracking number assigned to the regulatory submission, often used for external reference and correspondence with regulatory agencies.']
  submission_priority varchar [note: 'Priority level assigned to the regulatory submission based on urgency, risk, or regulatory importance. CRITICAL = immediate action required, HIGH = high importance, MEDIUM = standard priority, LOW = routine submission.']
  submission_scope varchar
  submission_status varchar [note: 'Current lifecycle status of the regulatory submission. DRAFT = being prepared, PENDING_REVIEW = awaiting internal approval, SUBMITTED = sent to regulatory agency, ACKNOWLEDGED = receipt confirmed by agency, ACCEPTED = approved by agency, REJECTED = not accepted by agency, RESUBMITTED = corrected and resubmitted after rejection, WITHDRAWN = submission cancelled. [ENUM-REF-CANDIDATE: DRAFT|PENDING_REVIEW|SUBMITTED|ACKNOWLEDGED|ACCEPTED|REJECTED|RESUBMITTED|WITHDRAWN — 8 candidates stripped; promote to reference product]']
  submission_timestamp timestamp [note: 'Precise date and time when the regulatory submission was transmitted to the receiving agency, including time zone.']
  submission_type varchar [note: 'Category of regulatory submission. CMS_IQR = Centers for Medicare and Medicaid Services (CMS) Inpatient Quality Reporting, CMS_OQR = CMS Outpatient Quality Reporting, CMS_IPFQR = CMS Inpatient Psychiatric Facility Quality Reporting, STATE_LICENSURE = State health department facility licensure reports, OSHA_300 = Occupational Safety and Health Administration (OSHA) Log of Work-Related Injuries and Illnesses, OSHA_300A = OSHA Annual Summary, OCR_BREACH = Office for Civil Rights (OCR) breach notification under HIPAA, OIG_SELF_DISCLOSURE = Office of Inspector General (OIG) self-disclosure of potential fraud or abuse, JOINT_COMMISSION_PPR = Joint Commission Periodic Performance Review, CDC_NHSN_HAI = Centers for Disease Control and Prevention (CDC) National Healthcare Safety Network (NHSN) Healthcare-Associated Infection (HAI) reporting. [ENUM-REF-CANDIDATE: CMS_IQR|CMS_OQR|CMS_IPFQR|STATE_LICENSURE|OSHA_300|OSHA_300A|OCR_BREACH|OIG_SELF_DISCLOSURE|JOINT_COMMISSION_PPR|CDC_NHSN_HAI|OTHER — 11 candidates stripped; promote to reference product]']
  submitting_entity_npi varchar [note: 'Ten-digit National Provider Identifier (NPI) of the submitting healthcare organization, as assigned by CMS.']
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutation to ensure change']
  vibe_mutation_marker varchar
  vibe_mutation_timestamp timestamp [note: 'Auto‑added by VIBE mutator to register a change']
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']

  Note: 'SSOT resolved: defer to research.research_regulatory_submission as the single source of truth for this concept. This table is a domain-specific extension/reference.'
}

Table compliance.exclusion_screening {
  exclusion_screening_id varchar [pk, note: 'Unique identifier for the exclusion screening record.']
  compliance_program_id varchar [note: 'Reference to the compliance program under which this screening was performed.']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: Screening programs are operated by compliance departments with associated costs (vendor fees, staff time). These costs must be allocated to the responsible cost center for budget tracking, vendor spen']
  primary_exclusion_employee_id varchar [note: 'Reference to the individual being screened (employee, contractor, or medical staff member).']
  prior_exclusion_screening_id varchar [note: 'Self-referencing FK on exclusion_screening (prior_exclusion_screening_id)']
  reference_npi_registry_id varchar [note: 'Foreign key linking to reference.npi_registry. Business justification: Exclusion screening validates NPIs against the national registry to ensure screened providers are correctly identified (name, address, taxonomy) before checking OIG/SAM exclusion databases for complia']
  screened_payer_id varchar [note: 'Foreign key linking to insurance.payer. Business justification: Healthcare organizations must screen payers and health plans for OIG/SAM exclusions to ensure they are not contracting with excluded entities. This is a regulatory requirement for federal program part']
  audit_trail varchar [note: 'Comprehensive audit trail documenting all actions, reviews, and decisions related to this screening record.']
  created_timestamp timestamp [note: 'Timestamp when the exclusion screening record was first created in the system.']
  exclusion_authority varchar [note: 'Government agency or authority that imposed the exclusion (e.g., OIG, GSA, State Medicaid).']
  exclusion_date date [note: 'Date when the exclusion was imposed by the regulatory authority.']
  exclusion_type varchar [note: 'Type or category of exclusion found (e.g., mandatory, permissive, conviction-related, license revocation).']
  exclusion_waiver_state varchar [note: 'Two-letter state code where a waiver from the exclusion may apply, if applicable.']
  match_confidence_level varchar [note: 'Confidence level of the match found during screening (high, medium, or low) based on data quality and matching criteria.']
  match_details varchar [note: 'Detailed information about the exclusion match found, including name matched, identifier matched, and exclusion reason.']
  match_found_flag boolean [note: 'Boolean indicator of whether a match was found on any exclusion list during screening.']
  modified_timestamp timestamp [note: 'Timestamp when the exclusion screening record was last modified or updated.']
  next_screening_date date [note: 'Scheduled date for the next exclusion screening check for this individual or entity.']
  notification_sent_date date [note: 'Date when notification about the screening result was sent to relevant stakeholders.']
  notification_sent_flag boolean [note: 'Boolean indicator of whether notification was sent to relevant stakeholders about the screening result.']
  reinstatement_date date [note: 'Date when the excluded individual or entity is eligible for reinstatement to federal healthcare programs.']
  resolution_action varchar [note: 'Action taken in response to the screening result (e.g., employment terminated, contract cancelled, credentialing denied, further investigation required).']
  resolution_date date [note: 'Date when the screening result was resolved and final action was taken.']
  resolution_notes varchar [note: 'Free-text notes documenting the resolution process, investigation findings, and rationale for action taken.']
  resolution_status varchar [note: 'Current status of the resolution process for the screening result (pending review, cleared, confirmed exclusion, action taken, or escalated).']
  risk_level varchar [note: 'Risk level assigned to this screening result based on entity type, role, and match findings.']
  screened_business_name varchar [note: 'Legal business name of the vendor or organization being screened.']
  screened_date_of_birth date [note: 'Date of birth of the individual being screened, used for identity verification and matching.']
  screened_entity_type varchar [note: 'Type of entity being screened for exclusion status (employee, contractor, vendor, medical staff, volunteer, or board member).']
  screened_first_name varchar [note: 'First name of the individual being screened for exclusion status.']
  screened_last_name varchar [note: 'Last name of the individual being screened for exclusion status.']
  screened_middle_name varchar [note: 'Middle name or initial of the individual being screened.']
  screened_ssn varchar [note: 'Social Security Number of the individual being screened, used for matching against exclusion lists.']
  screened_state varchar [note: 'Two-letter state code where the screened individual or business is located or licensed.']
  screening_date date [note: 'Date when the exclusion screening check was performed.']
  screening_frequency_months varchar [note: 'Number of months between required exclusion screening checks for this entity type.']
  screening_method varchar [note: 'Method used to perform the exclusion screening (automated system, manual search, or third-party vendor service).']
  screening_result varchar [note: 'Outcome of the exclusion screening check indicating whether the entity is clear, a match was found, result is inconclusive, or an error occurred.']
  screening_source varchar [note: 'Source database used for the exclusion screening check (OIG LEIE, SAM.gov, state Medicaid exclusion list, or combined search).']
  screening_transaction_number varchar [note: 'Unique transaction identifier from the screening vendor or system for audit trail purposes.']
  screening_vendor_name varchar [note: 'Name of the third-party vendor or service used to perform the exclusion screening, if applicable.']
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutation to ensure change']
  vibe_mutation_marker varchar
  vibe_mutation_timestamp timestamp [note: 'Auto‑added by VIBE mutator to register a change']
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']

  Note: 'Screening of employees and providers against federal and state exclusion lists'
}

Table compliance.conflict_of_interest {
  conflict_of_interest_id varchar [pk, note: 'Unique identifier for the conflict of interest disclosure record.']
  care_site_id varchar [note: 'Identifier of the healthcare facility or location where the disclosing individual is primarily assigned.']
  primary_conflict_employee_id varchar [note: 'Identifier of the employee, medical staff member, board member, or contractor submitting the disclosure.']
  prior_conflict_of_interest_id varchar [note: 'Self-referencing FK on conflict_of_interest (prior_conflict_of_interest_id)']
  reviewer_employee_id varchar [note: 'Identifier of the compliance officer or committee member who reviewed the disclosure.']
  approval_authority varchar [note: 'The role or body that has authority to approve or reject the disclosure: compliance officer, ethics committee, chief compliance officer, board of directors, or department head.']
  approval_date date [note: 'Date when the disclosure was formally approved by the designated authority.']
  attestation_date date [note: 'Date when the disclosing individual signed the attestation affirming the disclosure.']
  attestation_statement varchar [note: 'Text of the attestation statement signed by the disclosing individual affirming the accuracy and completeness of the disclosure.']
  audit_trail_notes varchar [note: 'Free-text notes capturing key events, decisions, and communications throughout the disclosure lifecycle for audit and compliance tracking purposes.']
  confidentiality_level varchar [note: 'Data classification level for the disclosure record: restricted (highest sensitivity), confidential (business-sensitive), or internal (standard operational data).']
  created_timestamp timestamp [note: 'Timestamp when the conflict of interest disclosure record was first created in the system.']
  department_name varchar [note: 'Name of the department or division where the disclosing individual works or is affiliated.']
  disclosed_entity_name varchar [note: 'Name of the external organization, vendor, research sponsor, or individual with whom the conflict of interest relationship exists.']
  disclosed_entity_type varchar [note: 'Classification of the disclosed entity: vendor, supplier, competitor, research sponsor, pharmaceutical company, device manufacturer, consulting firm, healthcare provider, or other. [ENUM-REF-CANDIDATE: vendor|supplier|competitor|research_sponsor|pharmaceutical_company|device_manufacturer|consulting_firm|healthcare_provider|other — 9 candidates stripped; promote to reference product]']
  disclosing_individual_role varchar [note: 'Role or affiliation of the individual submitting the disclosure: employee, medical staff, board member, contractor, volunteer, or vendor representative.']
  disclosure_date date [note: 'Date when the conflict of interest disclosure was submitted by the individual.']
  disclosure_number varchar [note: 'Externally-known unique business identifier for the conflict of interest disclosure.']
  disclosure_status varchar [note: 'Current lifecycle status of the conflict of interest disclosure: submitted, under review by compliance, approved without conditions, approved with mitigation plan, rejected, or withdrawn by disclosing individual.']
  disclosure_type varchar [note: 'Type of disclosure submission: initial disclosure, annual recertification, material change update, or ad-hoc disclosure.']
  estimated_value_amount decimal(15,2) [note: 'Estimated monetary value of the financial interest or relationship in US dollars.']
  expiration_date date [note: 'Date when the disclosed relationship or financial interest is expected to end or when the disclosure record expires and requires renewal.']
  last_recertification_date date [note: 'Date of the most recent annual recertification submission for this conflict of interest.']
  mitigation_effective_date date [note: 'Date when the mitigation plan became effective and enforceable.']
  mitigation_plan varchar [note: 'Detailed description of the mitigation actions, controls, or restrictions put in place to manage the conflict of interest, such as recusal from decisions, disclosure to stakeholders, or divestiture.']
  mitigation_required_flag boolean [note: 'Indicates whether a mitigation plan is required to manage the conflict of interest (True) or not (False).']
  modified_timestamp timestamp [note: 'Timestamp when the conflict of interest disclosure record was last modified or updated.']
  recertification_due_date date [note: 'Date by which the individual must submit an annual recertification or update of the conflict of interest disclosure.']
  regulatory_requirement_reference varchar [note: 'Citation of the specific regulatory requirement or compliance program element that mandates this disclosure, such as Stark Law, Anti-Kickback Statute, or OIG guidance.']
  rejection_reason varchar [note: 'Explanation provided by the compliance authority for rejecting the disclosure or determining that the conflict cannot be adequately mitigated.']
  relationship_description varchar [note: 'Detailed narrative description of the nature of the conflict of interest relationship, including roles, responsibilities, and interactions.']
  relationship_type varchar [note: 'Category of the conflict of interest relationship being disclosed: financial interest, outside employment, family relationship with vendor or employee, vendor relationship, research sponsorship, or consulting arrangement.']
  review_completion_date date [note: 'Date when the compliance review of the disclosure was completed and a determination was made.']
  review_start_date date [note: 'Date when the compliance review of the disclosure began.']
  supporting_documentation_url varchar [note: 'URL or file path to supporting documentation provided with the disclosure, such as contracts, financial statements, or correspondence.']
  value_range varchar [note: 'Categorical range of the estimated value: under $5,000, $5,000 to $25,000, $25,000 to $100,000, over $100,000, or not applicable for non-financial relationships.']
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutation to ensure change']
  vibe_mutation_marker varchar
  vibe_mutation_timestamp timestamp [note: 'Auto‑added by VIBE mutator to register a change']
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']

  Note: 'Conflict of interest disclosures and management'
}

Table compliance.hotline_report {
  hotline_report_id varchar [pk, note: 'Unique identifier for the compliance hotline report. Primary key.']
  care_site_id varchar [note: 'Identifier of the healthcare facility where the alleged incident occurred or is relevant.']
  original_hotline_report_id varchar [note: 'Self-referencing FK on hotline_report (original_hotline_report_id)']
  primary_hotline_reporter_employee_id varchar [note: 'Employee identifier of the reporter if they are an internal employee. Null if external reporter or anonymous.']
  tertiary_hotline_employee_id varchar [note: 'Employee identifier of the compliance officer or investigator assigned to review and investigate this report.']
  allegation_category varchar [note: 'Primary category of the compliance concern or ethics violation alleged: billing fraud, privacy violation, workplace safety, abuse/neglect, conflict of interest, retaliation, or code of conduct violation. [ENUM-REF-CANDIDATE: billing_fraud|privacy_violation|workplace_safety|abuse_neglect|conflict_of_interest|retaliation|code_of_conduct|discrimination|harassment|data_breach|regulatory_violation|quality_of_care|environmental_safety — promote to reference product]']
  allegation_description varchar [note: 'Detailed narrative description of the compliance concern, potential violation, or ethics issue as reported by the submitter.']
  allegation_subcategory varchar [note: 'More specific classification of the allegation within the primary category, providing additional detail on the nature of the concern.']
  assigned_investigator_name varchar [note: 'Name of the compliance officer or investigator assigned to this case.']
  case_notes varchar [note: 'Internal notes and documentation maintained by the compliance team throughout the investigation lifecycle.']
  confidentiality_level varchar [note: 'Classification of the sensitivity and confidentiality requirements for this hotline report and investigation materials.']
  corrective_action_completion_date date [note: 'Actual date when all required corrective actions were completed and verified.']
  corrective_action_description varchar [note: 'Description of the corrective actions taken or planned in response to substantiated compliance concerns.']
  corrective_action_due_date date [note: 'Target date by which corrective actions must be completed.']
  corrective_action_required_flag boolean [note: 'Indicates whether corrective action is required as a result of the investigation findings. True if action required, False otherwise.']
  created_timestamp timestamp [note: 'System timestamp when this hotline report record was first created in the compliance management system.']
  department_implicated varchar [note: 'Name or code of the department or unit where the alleged compliance concern occurred.']
  disposition varchar [note: 'Final determination of the investigation: substantiated (violation confirmed), unsubstantiated (no violation found), inconclusive (insufficient evidence), or pending (investigation ongoing).']
  disposition_notes varchar [note: 'Detailed explanation of the investigation findings, rationale for the disposition, and any supporting evidence or context.']
  follow_up_date date [note: 'Scheduled date for follow-up communication with the reporter or additional investigation activities.']
  follow_up_required_flag boolean [note: 'Indicates whether additional follow-up with the reporter or further investigation is required. True if follow-up needed, False otherwise.']
  incident_date date [note: 'Date when the alleged incident or compliance violation occurred, as reported or estimated.']
  incident_date_range_end date [note: 'End date of the period during which the alleged incident occurred, if the incident spanned multiple dates.']
  incident_date_range_start date [note: 'Start date of the period during which the alleged incident occurred, if the incident spanned multiple dates.']
  individual_implicated_name varchar [note: 'Name of the individual(s) allegedly involved in the compliance concern, if identified in the report.']
  investigation_completion_date date [note: 'Date when the investigation was completed and findings were documented.']
  investigation_start_date date [note: 'Date when the formal investigation into the reported concern was initiated.']
  investigation_status varchar [note: 'Current status of the investigation into the reported compliance concern: new, assigned, in progress, pending additional information, completed, or closed.']
  modified_timestamp timestamp [note: 'System timestamp when this hotline report record was last updated or modified.']
  priority_level varchar [note: 'Priority assigned to the investigation and resolution of this report: urgent, high, normal, or low.']
  regulatory_authority_notified varchar [note: 'Name of the external regulatory authority or governing body that was notified of the substantiated violation (e.g., CMS, OIG, OCR, state health department).']
  regulatory_notification_date date [note: 'Date when the external regulatory authority was formally notified of the substantiated violation.']
  regulatory_reporting_required_flag boolean [note: 'Indicates whether the substantiated violation requires mandatory reporting to external regulatory authorities (CMS, OIG, state health department, etc.). True if external reporting required, False otherwise.']
  report_channel varchar [note: 'Method through which the compliance concern was reported: hotline, online portal, direct report to compliance officer, email, mail, or in-person.']
  report_date date [note: 'Date when the compliance concern or ethics report was submitted through the hotline or reporting system.']
  report_number varchar [note: 'Business identifier for the hotline report, formatted as HR- followed by 8 digits. Used for external reference and tracking.']
  report_timestamp timestamp [note: 'Precise date and time when the report was received by the compliance system.']
  reporter_anonymity_flag boolean [note: 'Indicates whether the reporter chose to remain anonymous. True if anonymous, False if reporter provided identity.']
  reporter_contact_email varchar [note: 'Email address of the reporter for follow-up communication, if provided. Null if anonymous or not provided.']
  reporter_contact_phone varchar [note: 'Phone number of the reporter for follow-up, if provided. Null if anonymous or not provided.']
  reporter_name varchar [note: 'Name of the individual who submitted the report, if not anonymous. Null if reporter chose anonymity.']
  resolution_date date [note: 'Date when the hotline report was formally closed and all required actions were completed.']
  retaliation_concern_flag boolean [note: 'Indicates whether the reporter expressed concern about potential retaliation for making the report. True if retaliation concern noted, False otherwise.']
  severity_level varchar [note: 'Initial assessment of the severity or potential impact of the alleged compliance concern: critical, high, medium, or low.']
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutation to ensure change']
  vibe_mutation_marker varchar
  vibe_mutation_timestamp timestamp [note: 'Auto‑added by VIBE mutator to register a change']
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']

  Note: 'Reports submitted through compliance hotline or reporting mechanisms'
}

Table compliance.investigation {
  investigation_id varchar [pk, note: 'Unique identifier for the compliance investigation record. Primary key.']
  audit_finding_id varchar [note: 'Foreign key linking to compliance.audit_finding. Business justification: Investigation can be triggered by audit_finding. When trigger_source=\'audit_finding\', the investigation should have a structured FK to audit_finding. This is in addition to the hotline_report_id FK - ']
  care_site_id varchar [note: 'Identifier of the healthcare facility or location where the alleged violation occurred, if applicable.']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: Investigations consume departmental resources. Investigation costs (staff time, legal fees, consultant fees) must be tracked against the responsible department\'s cost center for budget management, cos']
  hotline_report_id varchar [note: 'Foreign key linking to compliance.hotline_report. Business justification: Investigation can be triggered by hotline_report. The trigger_reference_number (STRING) should be replaced with a structured FK hotline_report_id when trigger_source=\'hotline\'. This creates a clear au']
  investigation_employee_id varchar [note: 'System user identifier of the person who last modified this investigation record. Used for audit trail and accountability.']
  investigation_investigator_employee_id varchar [note: 'Identifier of the primary compliance officer or investigator assigned to lead this investigation.']
  parent_investigation_id varchar [note: 'Self-referencing FK on investigation (related_investigation_id)']
  phi_access_log_id varchar [note: 'Foreign key linking to compliance.phi_access_log. Business justification: Investigations into unauthorized PHI access require direct linkage to the access log entries being investigated for evidence chain, timeline reconstruction, and disciplinary action documentation.']
  privacy_incident_hipaa_privacy_incident_id varchar [note: 'Foreign key linking to compliance.hipaa_privacy_incident. Business justification: Investigation can be triggered by HIPAA privacy incident. When trigger_source=\'privacy_incident\', the investigation should have a structured FK to hipaa_privacy_incident. This completes the set of tri']
  breach_notification_required_flag boolean [note: 'Indicator of whether the investigation findings triggered mandatory breach notification to patients, HHS OCR, or media under HIPAA Breach Notification Rule. True indicates notification obligation exists.']
  close_date date [note: 'Date on which the investigation was formally concluded and final determination documented. Null for open investigations.']
  conclusion varchar [note: 'Final determination of the investigation outcome. Violation confirmed indicates substantiated compliance breach. No violation indicates allegation not supported by evidence. Inconclusive indicates insufficient evidence to make determination. Pending review indicates investigation complete but awaiting final approval or legal review.']
  confidentiality_level varchar [note: 'Data classification level governing access to and disclosure of investigation records. Restricted indicates highest sensitivity requiring need-to-know access. Confidential indicates limited distribution. Internal indicates organization-wide access. Public indicates no restriction.']
  corrective_action_required_flag boolean [note: 'Indicator of whether the investigation findings require formal corrective action plan. True indicates CAP must be developed, approved, and tracked to completion.']
  created_timestamp timestamp [note: 'System timestamp recording when this investigation record was first created in the compliance management system. Used for audit trail and data lineage.']
  department_involved varchar [note: 'Primary department or business unit where the alleged violation occurred or that is the subject of the investigation.']
  disciplinary_action_taken_flag boolean [note: 'Indicator of whether employee disciplinary action was taken as a result of investigation findings, including counseling, suspension, termination, or other personnel action.']
  external_referral_agency varchar [note: 'Name of external regulatory, law enforcement, or oversight agency to which the investigation was referred, such as HHS OIG, DOJ, FBI, OCR, state attorney general, or state health department.']
  external_referral_date date [note: 'Date on which the investigation was formally referred to external authority. Null if no external referral made.']
  financial_impact_amount decimal(15,2) [note: 'Estimated or calculated financial impact of the violation in US dollars, including overpayments, penalties, refunds, or potential liability exposure. Used for self-disclosure calculations and reserve estimation.']
  findings_summary varchar [note: 'Comprehensive narrative summary of the investigation findings, including evidence reviewed, interviews conducted, timeline of events, root cause analysis, and factual determinations. This field supports legal privilege and compliance program documentation.']
  investigation_number varchar [note: 'Business-facing unique investigation case number assigned at initiation, formatted as INV-YYYYNNNN for tracking and reference in compliance documentation and legal proceedings.']
  investigation_status varchar [note: 'Current lifecycle status of the investigation. Initiated indicates case opened but not yet assigned. Active indicates investigation in progress. Suspended indicates temporarily paused pending additional information. Closed indicates investigation concluded. Escalated indicates elevated to senior leadership or legal counsel. Referred external indicates case transferred to external authority such as OIG, OCR, or law enforcement.']
  investigation_type varchar [note: 'Classification of the investigation based on the nature of the alleged compliance violation. Privacy breach covers HIPAA violations and unauthorized PHI disclosure. Billing fraud includes upcoding, unbundling, and false claims. Workplace safety covers OSHA violations. Abuse/neglect includes patient harm and mistreatment. Anti-kickback covers illegal remuneration. Stark violation covers physician self-referral violations.']
  investigator_name varchar [note: 'Full name of the primary investigator assigned to this case for business reporting and audit trail purposes.']
  legal_privilege_asserted_flag boolean [note: 'Indicator of whether attorney-client privilege or attorney work product privilege has been asserted over investigation materials. True indicates privileged status requiring special handling and access controls.']
  modified_timestamp timestamp [note: 'System timestamp recording the most recent update to this investigation record. Used for audit trail and change tracking.']
  notes varchar [note: 'Free-form text field for investigator notes, observations, and supplementary information not captured in structured fields. May include interview summaries, document references, and investigative leads.']
  patient_count varchar [note: 'Number of distinct patients affected by or involved in the alleged violation. Used to assess breach notification requirements under HIPAA and scope of potential harm.']
  patient_involved_flag boolean [note: 'Indicator of whether the investigation involves a specific patient or patient PHI. True indicates patient-specific investigation requiring additional privacy protections and breach notification assessment.']
  priority_level varchar [note: 'Urgency classification of the investigation based on severity of alleged violation, potential financial impact, patient safety risk, and regulatory exposure. Critical indicates immediate patient safety or significant regulatory risk. High indicates substantial compliance risk. Medium indicates moderate risk. Low indicates minor or technical violation.']
  recommended_actions varchar [note: 'Detailed recommendations for corrective and preventive actions resulting from investigation findings, including policy revisions, training requirements, system controls, disciplinary actions, and process improvements.']
  regulatory_citation varchar [note: 'Specific regulatory statute, rule, or standard that was violated, including citation reference such as HIPAA 45 CFR 164.502, False Claims Act 31 USC 3729, Stark Law 42 USC 1395nn, Anti-Kickback Statute 42 USC 1320a-7b, or OSHA standard number.']
  risk_rating varchar [note: 'Assessment of the potential organizational risk exposure associated with the alleged violation, considering financial, reputational, regulatory, and patient safety dimensions.']
  scope_description varchar [note: 'Detailed narrative describing the boundaries and focus of the investigation, including specific allegations, time period under review, departments or individuals involved, and types of evidence to be examined.']
  self_disclosure_date date [note: 'Date on which voluntary self-disclosure was submitted to the applicable regulatory authority. Null if no disclosure required or not yet submitted.']
  self_disclosure_required_flag boolean [note: 'Indicator of whether the investigation findings require voluntary self-disclosure to regulatory authority such as OIG, CMS, or OCR under self-disclosure protocols. True indicates disclosure obligation exists.']
  start_date date [note: 'Date on which the formal investigation was officially opened and investigative activities commenced. Used to track timeliness of investigation response and compliance with regulatory reporting deadlines.']
  target_due_date date [note: 'Target completion date for the investigation based on regulatory timelines, internal SLA, or urgency classification. Used to monitor investigation timeliness and escalate overdue cases.']
  trigger_source varchar [note: 'Origin or channel through which the investigation was initiated. Hotline report indicates anonymous or named report through compliance hotline. Audit finding indicates discovery during internal or external audit. Self-disclosure indicates proactive identification by organization. External referral indicates notification from regulatory body, payer, or law enforcement. Patient complaint indicates grievance filed by patient or family. Employee report indicates direct report from staff member. Regulatory inquiry indicates investigation prompted by CMS, OCR, or state agency request. [ENUM-REF-CANDIDATE: hotline_report|audit_finding|self_disclosure|external_referral|patient_complaint|employee_report|regulatory_inquiry — 7 candidates stripped; promote to reference product]']
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutation to ensure change']
  vibe_mutation_marker varchar
  vibe_mutation_timestamp timestamp [note: 'Auto‑added by VIBE mutator to register a change']
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']
  violation_confirmed_flag boolean [note: 'Boolean indicator of whether the investigation substantiated a compliance violation. True indicates confirmed violation requiring corrective action and potential self-disclosure.']

  Note: 'Compliance investigations of reported incidents and allegations'
}

Table compliance.stark_arrangement {
  stark_arrangement_id varchar [pk, note: 'Unique identifier for the Stark Law financial arrangement record. Primary key for the stark_arrangement product.']
  clinician_id varchar [note: 'Identifier for the physician party to the financial arrangement. Links to the provider master record.']
  financial_entity_id varchar [note: 'Identifier for the healthcare entity party to the financial arrangement. Links to the facility or organizational unit master record.']
  reference_npi_registry_id varchar [note: 'Foreign key linking to reference.npi_registry. Business justification: Stark law compliance requires validating physician NPI details, taxonomy codes, and practice locations against the national registry for arrangement documentation, disclosure, and annual attestation p']
  renewed_stark_arrangement_id varchar [note: 'Self-referencing FK on stark_arrangement (renewed_stark_arrangement_id)']
  arrangement_number varchar [note: 'Business-assigned unique identifier or reference number for the Stark arrangement, used for tracking and reporting purposes.']
  arrangement_status varchar [note: 'Current lifecycle status of the Stark arrangement indicating whether it is in force, under compliance review, or has ended.']
  arrangement_type varchar [note: 'Classification of the financial arrangement between the physician and entity. Determines which Stark exception may apply. [ENUM-REF-CANDIDATE: employment|personal_services|fair_market_value_lease|equipment_lease|recruitment|indirect_compensation|space_rental|medical_director|call_coverage|academic_medical_center|other — 11 candidates stripped; promote to reference product]']
  commercial_reasonableness_determination varchar [note: 'Assessment of whether the arrangement is commercially reasonable and would make sense even in the absence of referrals between the parties.']
  commercial_reasonableness_rationale varchar [note: 'Business justification and rationale supporting the commercial reasonableness determination.']
  compensation_amount decimal(18,2) [note: 'Total annual or per-period compensation amount paid to the physician under the arrangement, in US dollars.']
  compensation_frequency varchar [note: 'Frequency at which compensation is paid to the physician under the arrangement.']
  compensation_structure varchar [note: 'Method by which the physician is compensated under the arrangement. Critical for determining compliance with volume or value of referrals standards. [ENUM-REF-CANDIDATE: fixed_salary|hourly_rate|per_service|percentage_of_revenue|productivity_based|hybrid|other — 7 candidates stripped; promote to reference product]']
  contract_document_location varchar [note: 'File path, URL, or document management system reference to the executed contract or agreement governing the arrangement.']
  created_timestamp timestamp [note: 'Date and time when the Stark arrangement record was first created in the compliance management system.']
  designated_health_services_involved varchar [note: 'List of designated health services (clinical lab, radiology, DME, etc.) to which the physician may refer under this arrangement, triggering Stark Law applicability.']
  disclosure_date date [note: 'Date on which the arrangement was disclosed to CMS under the Self-Referral Disclosure Protocol, if applicable.']
  disclosure_reference_number varchar [note: 'CMS-assigned reference number for the self-referral disclosure submission, if applicable.']
  disclosure_required_flag boolean [note: 'Indicates whether the arrangement must be disclosed to CMS under the Self-Referral Disclosure Protocol due to potential non-compliance.']
  effective_date date [note: 'Date on which the Stark arrangement becomes legally binding and active.']
  exception_criteria_met varchar [note: 'Detailed documentation of how the arrangement satisfies all required elements of the claimed Stark exception.']
  expiration_date date [note: 'Date on which the Stark arrangement terminates or expires. Nullable for open-ended arrangements.']
  fmv_compliant_flag boolean [note: 'Indicates whether the compensation has been determined to be consistent with fair market value based on the valuation performed.']
  fmv_determination_method varchar [note: 'Methodology used to establish that the compensation is consistent with fair market value and not determined in a manner that takes into account the volume or value of referrals.']
  fmv_opinion_date date [note: 'Date on which the FMV opinion or valuation was issued.']
  fmv_opinion_source varchar [note: 'Name of the independent valuation firm, consultant, or survey source that provided the FMV opinion or benchmark data.']
  legal_approval_status varchar [note: 'Outcome of the legal compliance review indicating whether the arrangement has been approved as Stark-compliant.']
  legal_review_date date [note: 'Date on which the arrangement was last reviewed by legal counsel or compliance department for Stark Law compliance.']
  legal_reviewer_name varchar [note: 'Name of the attorney or compliance officer who conducted the Stark Law compliance review.']
  modified_by varchar [note: 'User ID or name of the compliance staff member who last modified the Stark arrangement record.']
  modified_timestamp timestamp [note: 'Date and time when the Stark arrangement record was last updated or modified.']
  next_review_date date [note: 'Scheduled date for the next periodic compliance review of the Stark arrangement.']
  notes varchar [note: 'Additional free-text notes, comments, or special considerations related to the Stark arrangement and its compliance status.']
  referral_volume_tracking_required boolean [note: 'Indicates whether ongoing monitoring of referral volume and value is required to ensure continued compliance with the exception.']
  review_frequency_months varchar [note: 'Number of months between required compliance reviews of the arrangement.']
  risk_rating varchar [note: 'Compliance risk assessment level for the arrangement based on structure, compensation method, and exception applicability.']
  stark_exception_applied varchar [note: 'Specific Stark Law exception (by CFR citation or common name) that the arrangement relies upon for compliance, such as employment exception, personal services exception, or fair market value compensation exception.']
  termination_date date [note: 'Actual date on which the arrangement was terminated prior to the scheduled expiration date, if applicable.']
  termination_reason varchar [note: 'Business or compliance reason for early termination of the Stark arrangement.']
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutation to ensure change']
  vibe_mutation_marker varchar
  vibe_mutation_timestamp timestamp [note: 'Auto‑added by VIBE mutator to register a change']
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']
  created_by varchar [note: 'User ID or name of the compliance staff member who created the Stark arrangement record.']

  Note: 'Physician financial arrangements subject to Stark Law review'
}

Table compliance.osha_safety_program {
  osha_safety_program_id varchar [pk, note: 'Unique identifier for the OSHA safety program record. Primary key.']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: Safety programs are owned by specific departments (typically EHS or Risk Management) and require budget allocation for implementation, training, and equipment. Cost center link enables budget tracking']
  parent_osha_safety_program_id varchar [note: 'Self-referencing FK on osha_safety_program (parent_osha_safety_program_id)']
  program_owner_employee_id varchar [note: 'Identifier of the employee designated as the program owner or coordinator responsible for program implementation and compliance.']
  training_id varchar [note: 'Identifier of the training course associated with this safety program, linking to the learning management system.']
  approval_authority varchar [note: 'The role or title of the individual or committee authorized to approve the safety program (e.g., Chief Medical Officer, Safety Committee, Board of Directors).']
  approval_date date [note: 'The date when the safety program was formally approved by the designated authority.']
  attestation_frequency_months varchar [note: 'The frequency in months at which attestation must be completed for this safety program. Null if attestation is one-time or not required.']
  attestation_required_flag boolean [note: 'Indicates whether employees or managers must formally attest to compliance with this safety program (True) or not (False).']
  corrective_action_required_flag boolean [note: 'Indicates whether corrective actions are required to address deficiencies identified in the most recent audit (True) or not (False).']
  created_timestamp timestamp [note: 'The timestamp when this safety program record was first created in the system.']
  document_location_url varchar [note: 'The URL or file path where the official safety program document is stored and accessible to authorized personnel.']
  effective_date date [note: 'The date when the safety program became or will become operational and enforceable within the organization.']
  enforcement_mechanism varchar [note: 'Description of how compliance with this safety program is monitored and enforced (e.g., audits, inspections, incident investigations, self-assessments).']
  expiration_date date [note: 'The date when the safety program is scheduled to expire or be retired, if applicable. Null for ongoing programs.']
  external_audit_scope_flag boolean [note: 'Indicates whether this safety program is within the scope of external regulatory audits or inspections (True) or only subject to internal review (False).']
  finding_count varchar [note: 'The number of audit findings or deficiencies identified during the most recent audit of this safety program.']
  keywords varchar [note: 'Comma-separated list of keywords or tags for search and categorization of the safety program (e.g., PPE, exposure, hazmat, ergonomics).']
  last_audit_date date [note: 'The most recent date when an internal or external audit was conducted to assess compliance with this safety program.']
  last_audit_result varchar [note: 'The outcome of the most recent audit of this safety program, indicating the level of compliance found.']
  last_review_date date [note: 'The most recent date when the safety program was formally reviewed for compliance, effectiveness, and currency.']
  modified_timestamp timestamp [note: 'The timestamp when this safety program record was last modified in the system.']
  next_review_date date [note: 'The scheduled date for the next formal review of the safety program to ensure ongoing compliance and relevance.']
  non_compliance_consequence varchar [note: 'Description of the consequences for non-compliance with this safety program, including disciplinary actions, corrective measures, or regulatory penalties.']
  notes varchar [note: 'Free-text field for additional notes, comments, or context related to the safety program that do not fit in other structured fields.']
  osha_standard_citation varchar [note: 'The specific OSHA regulatory citation (e.g., 29 CFR 1910.1030 for Bloodborne Pathogens) that mandates or guides this safety program.']
  program_name varchar [note: 'Official name of the OSHA safety program (e.g., Bloodborne Pathogens Exposure Control Plan, Hazard Communication Program, Respiratory Protection Program).']
  program_number varchar [note: 'Business identifier for the safety program, used for external reference and reporting to regulatory authorities.']
  program_owner_department varchar [note: 'The department responsible for maintaining and overseeing the safety program (e.g., Environmental Health and Safety, Infection Control, Facilities Management).']
  program_purpose varchar [note: 'Detailed statement of the business and regulatory purpose of the safety program, including the hazards or risks it addresses.']
  program_scope varchar [note: 'Description of the organizational scope and applicability of the safety program, including which facilities, departments, or employee groups are covered.']
  program_status varchar [note: 'Current lifecycle status of the safety program indicating whether it is operational, under revision, or retired.']
  program_summary varchar [note: 'A brief summary of the safety program\'s purpose, key requirements, and objectives.']
  program_type varchar [note: 'Classification of the safety program based on OSHA-mandated or voluntary program categories.']
  related_policy_references varchar [note: 'Comma-separated list of related organizational policy numbers or identifiers that support or are supported by this safety program.']
  related_procedure_references varchar [note: 'Comma-separated list of related procedure identifiers or standard operating procedures (SOPs) that implement this safety program.']
  retired_reason varchar [note: 'Explanation of why the safety program was retired (e.g., regulatory change, program consolidation, no longer applicable).']
  retired_timestamp timestamp [note: 'The timestamp when this safety program was retired or deactivated. Null if the program is still active.']
  review_cycle_months varchar [note: 'The frequency in months at which the safety program must be reviewed (e.g., 12 for annual review, 24 for biennial review).']
  risk_rating varchar [note: 'The assessed risk level associated with non-compliance or failure of this safety program, used for prioritization and resource allocation.']
  supersedes_program_number varchar [note: 'The program number of the previous version of this safety program that this version replaces, if applicable.']
  training_frequency_months varchar [note: 'The frequency in months at which employees must complete training for this safety program (e.g., 12 for annual training). Null if training is one-time or not required.']
  training_required_flag boolean [note: 'Indicates whether employee training is required as part of this safety program (True) or not (False).']
  version_number varchar [note: 'The version identifier of the safety program document, used to track revisions and updates over time.']
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutation to ensure change']
  vibe_mutation_marker varchar
  vibe_mutation_timestamp timestamp [note: 'Auto‑added by VIBE mutator to register a change']
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']

  Note: 'OSHA workplace safety programs and compliance initiatives'
}

Table compliance.osha_exposure_incident {
  osha_exposure_incident_id varchar [pk, note: 'Unique identifier for the occupational exposure incident record. Primary key for the OSHA exposure incident entity.']
  care_site_id varchar [note: 'Reference to the healthcare facility where the exposure incident occurred. Required for multi-facility OSHA reporting and facility-level safety benchmarking.']
  mpi_record_id varchar [note: 'Reference to the patient who was the source of the exposure, if applicable. Required for source patient testing and post-exposure prophylaxis decision-making.']
  ndc_drug_id varchar [note: 'Foreign key linking to reference.ndc_drug. Business justification: Exposure incidents involving post-exposure prophylaxis (PEP) or vaccines must document the specific NDC codes administered for workers\' compensation claims, OSHA recordkeeping, and pharmacy billing re']
  osha_safety_program_id varchar [note: 'Foreign key linking to compliance.osha_safety_program. Business justification: OSHA exposure incidents are tracked under specific OSHA safety programs (e.g., Bloodborne Pathogen Exposure Control Plan). Each incident should link to the safety program it falls under for aggregatio']
  parent_osha_exposure_incident_id varchar [note: 'Self-referencing FK on osha_exposure_incident (related_osha_exposure_incident_id)']
  primary_osha_exposed_employee_id varchar [note: 'Reference to the healthcare worker who experienced the occupational exposure incident.']
  procedure_event_id varchar [note: 'Foreign key linking to clinical.procedure_event. Business justification: Sharps injuries and exposure incidents often occur during specific surgical or invasive procedures. Root cause analysis and OSHA reporting require linking exposure incidents to the procedural context ']
  scheduling_appointment_id varchar [note: 'Foreign key linking to scheduling.scheduling_appointment. Business justification: Exposure incidents often occur during scheduled patient encounters providing context for root cause analysis, procedure identification, and prevention planning. Real incident investigation requirement']
  tertiary_osha_employee_id varchar [note: 'Reference to the employee health or safety officer responsible for investigating the exposure incident and completing required documentation.']
  treatment_ap_invoice_id varchar [note: 'Foreign key linking to finance.ap_invoice. Business justification: Exposure incidents generate invoices for post-exposure prophylaxis, laboratory testing, medical treatment, and workers\' compensation costs. This link enables incident cost tracking, workers\' comp clai']
  baseline_testing_completed_flag boolean [note: 'Indicates whether baseline bloodborne pathogen testing was completed for the exposed employee immediately following the exposure. Required to establish pre-exposure status.']
  corrective_actions_implemented varchar [note: 'Description of corrective actions implemented to prevent recurrence of similar exposure incidents. May include process changes, equipment changes, or additional training.']
  created_timestamp timestamp [note: 'Date and time when the exposure incident record was first created in the system. Audit trail for data governance and compliance verification.']
  days_away_from_work varchar [note: 'Number of calendar days the exposed employee was unable to work as a result of the exposure incident. Required for OSHA 300 log column entries.']
  days_of_job_transfer_restriction varchar [note: 'Number of calendar days the exposed employee was on restricted work activity or job transfer as a result of the exposure. Required for OSHA 300 log column entries.']
  exposed_employee_department varchar [note: 'Department or unit where the exposed employee was working at the time of the incident. Critical for departmental safety metrics and targeted training.']
  exposed_employee_job_title varchar [note: 'Job title or role of the exposed employee at the time of the incident. Used for risk analysis and prevention planning by occupational category.']
  exposure_route varchar [note: 'Route by which the exposure occurred. Percutaneous (needlestick, sharps injury) and mucous membrane exposures have different post-exposure prophylaxis protocols.']
  exposure_type varchar [note: 'Primary category of occupational exposure. Bloodborne pathogen exposures are the most common in healthcare and trigger specific OSHA Bloodborne Pathogens Standard requirements.']
  follow_up_completed_flag boolean [note: 'Indicates whether all required follow-up testing and medical evaluations have been completed for the exposed employee. Used to track compliance with post-exposure protocols.']
  follow_up_testing_schedule varchar [note: 'Scheduled follow-up testing timeline for the exposed employee (e.g., 6 weeks, 3 months, 6 months post-exposure). Protocol varies by exposure type and source patient status.']
  incident_date date [note: 'Date when the occupational exposure incident occurred. Used to determine OSHA recordability and reporting deadlines.']
  incident_location varchar [note: 'Specific location within the healthcare facility where the exposure occurred (e.g., Emergency Department Room 3, Operating Room 5, Patient Room 412). Used for environmental risk assessment.']
  incident_number varchar [note: 'Business identifier assigned to the exposure incident for tracking and reporting purposes. Used in OSHA 300 log and internal incident management systems.']
  incident_resolution_date date [note: 'Date when the exposure incident case was closed and all follow-up activities completed. Used for case closure tracking and outcome analysis.']
  incident_status varchar [note: 'Current status of the exposure incident case management. Tracks the incident through investigation, follow-up care, and final resolution.']
  incident_time timestamp [note: 'Precise date and time when the exposure incident occurred. Used for shift analysis, staffing pattern review, and post-exposure prophylaxis timing calculations.']
  investigation_notes varchar [note: 'Detailed narrative of the incident investigation findings, including circumstances leading to the exposure, witness statements, and contributing factors. Used for root cause analysis and prevention planning.']
  modified_timestamp timestamp [note: 'Date and time when the exposure incident record was last modified. Audit trail for tracking updates to incident details, status changes, and follow-up documentation.']
  osha_recordable_determination_date date [note: 'Date when the OSHA recordability determination was made. Must be within 7 calendar days of receiving information that a recordable injury or illness has occurred.']
  osha_recordable_flag boolean [note: 'Indicates whether the exposure incident meets OSHA criteria for recordability on the OSHA 300 log. Recordability determination based on whether the incident resulted in medical treatment beyond first aid, days away from work, or job transfer/restriction.']
  pep_initiated_flag boolean [note: 'Indicates whether post-exposure prophylaxis treatment was initiated for the exposed employee. Required for OSHA compliance and employee health tracking.']
  pep_start_timestamp timestamp [note: 'Date and time when post-exposure prophylaxis was initiated. Timing is critical for PEP effectiveness, particularly for HIV exposure (ideally within 2 hours, no later than 72 hours).']
  pep_type varchar [note: 'Type of post-exposure prophylaxis administered (e.g., HIV PEP antiretroviral therapy, Hepatitis B immune globulin, Hepatitis B vaccination). Free text to accommodate multiple concurrent treatments.']
  procedure_being_performed varchar [note: 'Clinical procedure or task being performed when the exposure occurred. Used for procedural risk analysis and targeted training interventions.']
  reported_timestamp timestamp [note: 'Date and time when the exposure incident was first reported to management or employee health. Used to track reporting timeliness and compliance with immediate reporting requirements.']
  root_cause_analysis_completed_flag boolean [note: 'Indicates whether a formal root cause analysis was conducted for the exposure incident. Required for serious incidents and used to drive systemic safety improvements.']
  safety_engineered_device_flag boolean [note: 'Indicates whether the device involved had safety-engineered sharps injury protection features. Critical for evaluating effectiveness of safety device adoption.']
  sharps_device_brand varchar [note: 'Manufacturer and brand name of the sharp device involved. Used for product safety evaluation and vendor performance tracking.']
  sharps_device_type varchar [note: 'Type of sharp device involved in the exposure (e.g., hollow-bore needle, suture needle, scalpel, lancet). Required for OSHA Sharps Injury Log and device evaluation.']
  source_patient_hbv_status varchar [note: 'Hepatitis B test result for the source patient. Protected health information. Determines need for Hepatitis B immune globulin and vaccination for exposed employee.']
  source_patient_hcv_status varchar [note: 'Hepatitis C test result for the source patient. Protected health information. Determines baseline and follow-up testing protocol for exposed employee.']
  source_patient_hiv_status varchar [note: 'HIV test result for the source patient. Protected health information. Critical for determining post-exposure prophylaxis regimen for the exposed employee.']
  source_patient_known_flag boolean [note: 'Indicates whether the source patient could be identified. Unknown source exposures require different post-exposure prophylaxis risk assessment.']
  source_patient_tested_flag boolean [note: 'Indicates whether the source patient was tested for bloodborne pathogens (HIV, Hepatitis B, Hepatitis C) following the exposure incident.']
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutation to ensure change']
  vibe_mutation_marker varchar
  vibe_mutation_timestamp timestamp [note: 'Auto‑added by VIBE mutator to register a change']
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']
  workers_comp_claim_filed_flag boolean [note: 'Indicates whether a workers compensation claim was filed for the exposure incident. Links occupational health incident to workers compensation case management.']
  workers_comp_claim_number varchar [note: 'Workers compensation claim number associated with the exposure incident, if a claim was filed. Used for cross-referencing with workers compensation system.']

  Note: 'OSHA-reportable exposure incidents and workplace injuries'
}

Table compliance.cms_condition_status {
  cms_condition_status_id varchar [pk, note: 'Unique identifier for the CMS Condition of Participation or Condition for Coverage compliance status tracking record.']
  audit_id varchar [note: 'Foreign key linking to compliance.audit. Business justification: CMS Condition of Participation status records are assessed during CMS surveys/audits. Each cms_condition_status record should link to the audit/survey that assessed it (last_survey_date, last_survey_t']
  care_site_id varchar [note: 'Identifier of the healthcare facility or provider location to which this CMS condition compliance status applies.']
  compliance_program_id varchar
  payer_id varchar [note: 'Foreign key linking to insurance.payer. Business justification: CMS Conditions of Participation status directly affects Medicare/Medicaid payer relationships. Deemed status through accreditation impacts which payers will contract. Tracking payer context for CoP co']
  prior_cms_condition_status_id varchar [note: 'Self-referencing FK on cms_condition_status (prior_cms_condition_status_id)']
  responsible_cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: CMS condition compliance is typically owned by specific departments (Quality, Infection Control, etc.). Remediation costs must be tracked against the responsible cost center for budget management, cos']
  certification_effective_date date [note: 'The date on which the current CMS certification status for this provider type became effective.']
  certification_expiration_date date [note: 'The date on which the current CMS certification for this provider type expires if not renewed through recertification survey.']
  certification_status varchar [note: 'The overall CMS certification status of the facility for this provider type: certified (full compliance), provisional certification (initial certification period), conditional certification (deficiencies present but correctable), decertified, or termination pending.']
  civil_monetary_penalty_amount decimal(15,2) [note: 'The total dollar amount of civil monetary penalties imposed by CMS for deficiencies cited under this Condition of Participation.']
  cms_condition_status_status varchar
  compliance_status varchar [note: 'The current compliance status of the facility for this specific CMS Condition of Participation: compliant (no deficiencies), deficient (standard-level deficiency), condition-level deficiency (threatens health and safety), immediate jeopardy (serious harm or death likely), plan of correction pending, or plan of correction accepted.']
  condition_category varchar [note: 'The functional category or domain of the CMS Condition of Participation (e.g., patient rights, quality assurance, infection control, nursing services, medical staff, pharmaceutical services). [ENUM-REF-CANDIDATE: patient_rights|quality_assurance|infection_control|nursing_services|medical_staff|pharmaceutical_services|dietary_services|emergency_services|surgical_services|anesthesia_services|radiologic_services|laboratory_services|medical_record_services|physical_environment|life_safety|governance|administration — 17 candidates stripped; promote to reference product]']
  condition_name varchar [note: 'The full descriptive name of the CMS Condition of Participation or Condition for Coverage (e.g., Patient Rights, Infection Prevention and Control, Nursing Services).']
  cop_citation varchar [note: 'The official CMS regulatory citation for the Condition of Participation or Condition for Coverage (e.g., 42 CFR 482.13, 42 CFR 483.10) that this status record tracks.']
  correction_completion_date date [note: 'The date by which the facility must complete all corrective actions for deficiencies cited under this condition, as specified in the accepted Plan of Correction.']
  correction_verified_date date [note: 'The date on which CMS or the state survey agency verified that all corrective actions for this condition have been successfully implemented and deficiencies resolved.']
  created_timestamp timestamp [note: 'The date and time when this CMS condition status tracking record was first created in the system.']
  deficiency_tag_numbers varchar [note: 'Comma-separated list of CMS deficiency tag numbers (e.g., K0001, K0021, A0115) cited under this Condition of Participation during the last survey.']
  effective_date date
  enforcement_action_flag boolean [note: 'Indicates whether CMS or the state survey agency has imposed enforcement actions (remedies) on the facility related to deficiencies under this condition (True if enforcement actions are active, False otherwise).']
  enforcement_action_type varchar [note: 'The type of CMS enforcement remedy imposed for deficiencies under this condition (e.g., civil monetary penalty, denial of payment for new admissions, temporary management, termination of provider agreement). Multiple actions may be listed if applicable.']
  expiration_date date
  internal_audit_frequency_months varchar [note: 'The frequency in months at which the organization conducts internal compliance audits or self-assessments for this CMS Condition of Participation.']
  last_internal_audit_date date [note: 'The date of the most recent internal compliance audit or self-assessment conducted for this CMS Condition of Participation.']
  last_internal_audit_result varchar [note: 'The outcome of the most recent internal compliance audit for this condition: compliant, minor gaps identified, significant gaps identified, or non-compliant.']
  last_survey_date date [note: 'The date of the most recent CMS certification survey or validation survey during which this Condition of Participation was evaluated.']
  last_survey_outcome varchar [note: 'The overall outcome of the last CMS survey for this condition: no deficiencies found, deficiencies cited (standard level), condition-level deficiencies cited, immediate jeopardy cited, or termination recommended.']
  last_survey_type varchar [note: 'The type of CMS survey during which this condition was last evaluated (e.g., initial certification, recertification, complaint investigation, validation, life safety code, revisit).']
  modified_timestamp timestamp [note: 'The date and time when this CMS condition status tracking record was last updated or modified.']
  next_internal_audit_date date [note: 'The scheduled date for the next internal compliance audit or self-assessment for this CMS Condition of Participation.']
  next_survey_window_end date [note: 'The latest date within the window when the next CMS certification or recertification survey for this condition must occur to maintain compliance with survey frequency requirements.']
  next_survey_window_start date [note: 'The earliest date within the window when the next CMS certification or recertification survey for this condition is expected to occur, based on regulatory survey cycles.']
  notes varchar [note: 'Additional free-text notes, comments, or context regarding the compliance status, survey findings, corrective actions, or other relevant information for this CMS Condition of Participation.']
  open_deficiency_count varchar [note: 'The current number of open (uncorrected) deficiencies cited under this Condition of Participation that require corrective action.']
  plan_of_correction_acceptance_date date [note: 'The date on which CMS or the state survey agency formally accepted the facilitys Plan of Correction.']
  plan_of_correction_due_date date [note: 'The deadline by which the facility must submit its Plan of Correction to CMS or the state survey agency for deficiencies cited under this condition.']
  plan_of_correction_status varchar [note: 'The current status of the Plan of Correction for deficiencies cited under this condition: not required, required, submitted, under review by CMS/state agency, accepted, rejected, implemented, or verified as corrected. [ENUM-REF-CANDIDATE: not_required|required|submitted|under_review|accepted|rejected|implemented|verified — 8 candidates stripped; promote to reference product]']
  plan_of_correction_submission_date date [note: 'The date on which the facility submitted its Plan of Correction to CMS or the state survey agency.']
  provider_type varchar [note: 'The certified provider type classification under CMS regulations (e.g., hospital, SNF, home health, hospice, ASC, critical access hospital) that determines which Conditions of Participation apply.']
  responsible_department varchar [note: 'The internal department or service line responsible for maintaining compliance with this CMS Condition of Participation (e.g., Nursing, Infection Prevention, Quality, Medical Staff Services).']
  responsible_officer_name varchar [note: 'The name of the executive or director responsible for oversight of compliance with this CMS Condition of Participation.']
  responsible_officer_title varchar [note: 'The job title of the executive or director responsible for oversight of compliance with this CMS Condition of Participation (e.g., Chief Nursing Officer, Director of Quality, Chief Medical Officer).']
  risk_level varchar [note: 'The organizations internal risk assessment level for non-compliance with this CMS Condition of Participation, based on likelihood and impact of deficiencies (low, moderate, high, critical).']
  scope_and_severity_level varchar [note: 'The CMS scope and severity matrix level assigned to the most serious deficiency under this condition (A through L, where A is isolated/no harm and L is widespread/immediate jeopardy). [ENUM-REF-CANDIDATE: A|B|C|D|E|F|G|H|I|J|K|L — 12 candidates stripped; promote to reference product]']
  state_survey_agency varchar [note: 'The name of the state health department or survey agency responsible for conducting CMS certification surveys for this facility.']
  surveyor_name varchar [note: 'The name of the lead CMS or state survey agency surveyor who conducted the last survey evaluation of this condition.']
  updated_timestamp timestamp
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutation to ensure change']
  vibe_mutation_marker varchar
  vibe_mutation_timestamp timestamp [note: 'Auto‑added by VIBE mutator to register a change']
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']

  Note: 'CMS Conditions of Participation compliance status tracking'
}

Table compliance.accreditation_status {
  accreditation_status_id varchar [pk, note: 'Unique identifier for the accreditation status record. Primary key.']
  audit_id varchar [note: 'Foreign key linking to compliance.audit. Business justification: Accreditation status is determined by accreditation audits/surveys. Each accreditation_status record should link to the audit that determined the status (last_survey_date, survey_type exist). This cre']
  care_site_id varchar [note: 'Reference to the healthcare facility or organizational unit that holds this accreditation. Links to the facility master record.']
  compliance_program_id varchar
  payer_id varchar [note: 'Foreign key linking to insurance.payer. Business justification: Accreditation (Joint Commission, NCQA, URAC) is often contractually required by specific payers. Payers reference accreditation status for contracting decisions, deemed status recognition, and quality']
  prior_accreditation_status_id varchar [note: 'Self-referencing FK on accreditation_status (prior_accreditation_status_id)']
  accreditation_award_date date [note: 'Date on which the accreditation status was officially awarded or conferred by the accrediting body following survey completion and decision.']
  accreditation_certificate_number varchar [note: 'Unique certificate or accreditation number issued by the accrediting body to identify this specific accreditation award.']
  accreditation_cost_amount decimal(15,2) [note: 'Total cost in US dollars (USD) associated with obtaining and maintaining this accreditation, including survey fees, application fees, annual fees, and consulting costs.']
  accreditation_cycle_years varchar [note: 'Number of years in the accreditation cycle before re-survey is required. Typically 3 years for hospital accreditation, may vary by program type.']
  accreditation_decision_date date [note: 'Date on which the accrediting body made the formal accreditation decision following survey review and any appeals process.']
  accreditation_level varchar [note: 'Level or tier of accreditation awarded, if the accrediting body uses tiered accreditation (e.g., gold, silver, bronze for some programs; level I, II, III for trauma centers).']
  accreditation_scope varchar [note: 'Description of the scope of services, departments, or programs covered by this accreditation (e.g., acute care hospital services, emergency department, surgical services, laboratory services, radiology services).']
  accreditation_status varchar [note: 'Current accreditation status awarded by the accrediting body. Accredited indicates full compliance; accredited with follow-up indicates minor findings requiring follow-up; conditional indicates significant findings with conditions; preliminary denial indicates intent to deny; not accredited indicates denial or loss of accreditation; withdrawn indicates voluntary withdrawal.']
  accreditation_status_status varchar
  accrediting_body_code varchar [note: 'Standardized code identifying the accrediting organization (e.g., TJC for The Joint Commission, DNV for DNV GL, HFAP for Healthcare Facilities Accreditation Program, CARF for Commission on Accreditation of Rehabilitation Facilities, CAP for College of American Pathologists, ACR for American College of Radiology, AAAHC for Accreditation Association for Ambulatory Health Care).']
  accrediting_body_name varchar [note: 'Full legal name of the accrediting organization (e.g., The Joint Commission, DNV GL Healthcare, Healthcare Facilities Accreditation Program).']
  annual_maintenance_fee_amount decimal(15,2) [note: 'Annual fee in US dollars (USD) charged by the accrediting body to maintain active accreditation status between surveys.']
  appeal_filed_flag boolean [note: 'Indicates whether the organization filed an appeal of the accreditation decision or survey findings. True if appeal was filed; false otherwise.']
  appeal_outcome varchar [note: 'Outcome of the appeal process if an appeal was filed. Upheld indicates original decision stands; overturned indicates decision reversed; modified indicates decision changed; pending indicates appeal in progress; not applicable if no appeal filed.']
  cms_certification_number varchar [note: 'CMS-issued certification number (CCN) associated with this accreditation when deemed status applies. Used for Medicare and Medicaid billing and provider enrollment.']
  contact_person_email varchar [note: 'Email address of the primary organizational contact person for this accreditation.']
  contact_person_name varchar [note: 'Name of the primary organizational contact person responsible for managing this accreditation relationship and survey coordination.']
  contact_person_phone varchar [note: 'Phone number of the primary organizational contact person for this accreditation.']
  contact_person_title varchar [note: 'Job title or role of the primary organizational contact person for this accreditation (e.g., Director of Regulatory Compliance, Chief Quality Officer, Accreditation Coordinator).']
  created_timestamp timestamp [note: 'Timestamp when this accreditation status record was first created in the system.']
  critical_findings_count varchar [note: 'Number of critical or immediate threat to health and safety findings identified during the last survey. Critical findings may result in conditional accreditation or denial.']
  deemed_status_flag boolean [note: 'Indicates whether this accreditation confers deemed status for Centers for Medicare and Medicaid Services (CMS) Conditions of Participation (CoP), allowing the facility to participate in Medicare and Medicaid programs without separate CMS certification. True if deemed status is granted; false otherwise.']
  effective_date date [note: 'Date from which the accreditation status becomes effective and the organization is considered accredited.']
  exclusions varchar [note: 'Description of any services, departments, or programs explicitly excluded from the scope of this accreditation.']
  expiration_date date [note: 'Date on which the current accreditation status expires and requires renewal or re-survey. Typically 3 years for hospital accreditation.']
  follow_up_completion_date date [note: 'Date on which the required follow-up activity (evidence submission, corrective action plan, or follow-up survey) was completed and accepted by the accrediting body.']
  follow_up_due_date date [note: 'Date by which the organization must submit evidence of standards compliance, corrective action plan, or complete a follow-up survey to maintain accreditation status.']
  follow_up_required_flag boolean [note: 'Indicates whether the accrediting body requires a follow-up survey, evidence of standards compliance (ESC), or corrective action plan submission to address findings. True if follow-up is required; false otherwise.']
  last_survey_date date [note: 'Date of the most recent accreditation survey conducted by the accrediting body that resulted in the current accreditation status.']
  modified_timestamp timestamp [note: 'Timestamp when this accreditation status record was last modified or updated in the system.']
  next_survey_window_end_date date [note: 'Latest date within the window by which the next accreditation survey must be completed to maintain continuous accreditation.']
  next_survey_window_start_date date [note: 'Earliest date within the window when the next accreditation survey may be scheduled or conducted.']
  notes varchar [note: 'Free-text notes capturing additional context, special conditions, or important information about this accreditation status not captured in structured fields.']
  program_type varchar [note: 'Type of accreditation program applicable to the facility (e.g., hospital accreditation, ambulatory care accreditation, laboratory accreditation, radiology accreditation, behavioral health, rehabilitation, home health). [ENUM-REF-CANDIDATE: hospital|ambulatory|laboratory|radiology|behavioral_health|rehabilitation|home_health|other — 8 candidates stripped; promote to reference product]']
  public_disclosure_flag boolean [note: 'Indicates whether this accreditation status is publicly disclosed on the accrediting body\'s website or public database. True if publicly disclosed; false if confidential.']
  quality_report_url varchar [note: 'Web address (URL) where the public quality report or accreditation details can be accessed on the accrediting body\'s website (e.g., The Joint Commission Quality Check).']
  state_licensure_alignment_flag boolean [note: 'Indicates whether this accreditation is recognized by the state health department for facility licensure purposes or whether it satisfies state licensure requirements. True if aligned; false otherwise.']
  survey_findings_count varchar [note: 'Total number of findings, deficiencies, or requirements for improvement identified during the last accreditation survey.']
  survey_type varchar [note: 'Type of survey that resulted in this accreditation status. Initial for first-time accreditation; triennial for standard 3-year re-accreditation; mid-cycle for periodic review; unannounced for random unannounced surveys; for-cause for complaint-driven surveys; follow-up for post-finding validation.']
  updated_timestamp timestamp
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutation to ensure change']
  vibe_mutation_marker varchar
  vibe_mutation_timestamp timestamp [note: 'Auto‑added by VIBE mutator to register a change']
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']

  Note: 'Accreditation status for various programs and services'
}

Table compliance.business_associate_agreement {
  business_associate_agreement_id varchar [pk, note: 'Unique identifier for the Business Associate Agreement record. Primary key.']
  compliance_program_id varchar [note: 'Identifier linking this BAA to the overarching compliance program under which it is managed.']
  payer_id varchar [note: 'Foreign key linking to insurance.payer. Business justification: Payers receiving PHI (eligibility files, claims data, remittance) are business associates under HIPAA requiring executed BAAs. Healthcare organizations must track which payer each BAA covers for regul']
  renewed_business_associate_agreement_id varchar [note: 'Self-referencing FK on business_associate_agreement (renewed_business_associate_agreement_id)']
  agreement_number varchar [note: 'Externally-known unique identifier or reference number assigned to this BAA for tracking and reference purposes.']
  audit_rights_granted_flag boolean [note: 'Indicates whether the covered entity has the right to audit the business associate\'s compliance with the BAA and HIPAA requirements.']
  breach_notification_required_flag boolean [note: 'Indicates whether the business associate is required to notify the covered entity of any breach of unsecured PHI.']
  breach_notification_timeframe_days varchar [note: 'Number of days within which the business associate must notify the covered entity of a breach of unsecured PHI.']
  business_associate_address varchar [note: 'Full mailing address of the business associate organization, including street, city, state, and postal code.']
  business_associate_agreement_status varchar [note: 'Current lifecycle status of the BAA indicating whether it is in force, expired, terminated, or pending action.']
  business_associate_contact_email varchar [note: 'Email address of the primary contact person at the business associate organization for BAA-related matters.']
  business_associate_contact_name varchar [note: 'Name of the primary contact person at the business associate organization for BAA-related matters.']
  business_associate_contact_phone varchar [note: 'Phone number of the primary contact person at the business associate organization for BAA-related matters.']
  business_associate_signatory_name varchar [note: 'Name of the individual who signed the BAA on behalf of the business associate.']
  business_associate_signatory_title varchar [note: 'Job title or role of the individual who signed the BAA on behalf of the business associate.']
  business_associate_tax_number varchar [note: 'Federal tax identification number (EIN) of the business associate for legal and financial tracking.']
  covered_entity_signatory_name varchar [note: 'Name of the individual who signed the BAA on behalf of the covered entity.']
  covered_entity_signatory_title varchar [note: 'Job title or role of the individual who signed the BAA on behalf of the covered entity.']
  created_timestamp timestamp [note: 'Timestamp indicating when this BAA record was first created in the system.']
  document_location_url varchar [note: 'URL or file path to the stored copy of the executed BAA document for reference and audit purposes.']
  effective_date date [note: 'Date on which the BAA becomes legally binding and enforceable.']
  execution_date date [note: 'Date on which the BAA was signed and executed by both the covered entity and the business associate.']
  expiration_date date [note: 'Date on which the BAA expires or terminates, if applicable. Null for agreements without a defined end date.']
  indemnification_clause_included_flag boolean [note: 'Indicates whether the BAA includes an indemnification clause protecting the covered entity from liability arising from the business associate\'s actions.']
  insurance_coverage_amount decimal(15,2) [note: 'Minimum dollar amount of liability or cyber insurance coverage the business associate must maintain.']
  insurance_required_flag boolean [note: 'Indicates whether the business associate is required to maintain liability or cyber insurance as a condition of the BAA.']
  last_review_date date [note: 'Date on which the BAA was last reviewed for compliance, accuracy, and currency.']
  modified_by_user varchar [note: 'Username or identifier of the user who last modified this BAA record.']
  modified_timestamp timestamp [note: 'Timestamp indicating when this BAA record was last modified in the system.']
  next_review_date date [note: 'Scheduled date for the next review of the BAA to ensure ongoing compliance and relevance.']
  notes varchar [note: 'Additional notes, comments, or context regarding the BAA, including special terms, amendments, or historical information.']
  permitted_disclosures varchar [note: 'Specific disclosures of PHI that the business associate is permitted to make under the terms of this BAA.']
  permitted_uses varchar [note: 'Specific uses of PHI that the business associate is permitted to perform under the terms of this BAA.']
  phi_retention_period_years varchar [note: 'Number of years the business associate is permitted or required to retain PHI after termination of services, if return or destruction is not feasible.']
  phi_types_shared varchar [note: 'Categories and types of PHI that will be disclosed to or accessed by the business associate under this agreement (e.g., demographic, clinical, billing).']
  renewal_date date [note: 'Date on which the BAA was renewed or is scheduled for renewal.']
  return_or_destroy_phi_flag boolean [note: 'Indicates whether the business associate is required to return or destroy all PHI upon termination of the agreement.']
  review_frequency_months varchar [note: 'Number of months between scheduled reviews of the BAA.']
  safeguards_required varchar [note: 'Description of the administrative, physical, and technical safeguards the business associate must implement to protect PHI.']
  services_provided varchar [note: 'Detailed description of the services the business associate will provide that involve access to, use of, or disclosure of PHI.']
  subcontractor_baa_chain varchar [note: 'List or description of subcontractors with whom the business associate has executed downstream BAAs, maintaining the chain of HIPAA compliance.']
  subcontractor_baa_required_flag boolean [note: 'Indicates whether the business associate is required to obtain BAAs from any subcontractors who will have access to PHI.']
  termination_date date [note: 'Actual date on which the BAA was terminated, if applicable. Null if the agreement has not been terminated.']
  termination_reason varchar [note: 'Explanation or reason for the termination of the BAA, including breach, mutual agreement, or expiration.']
  updated_timestamp timestamp
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutation to ensure change']
  vibe_mutation_marker varchar
  vibe_mutation_timestamp timestamp [note: 'Auto‑added by VIBE mutator to register a change']
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']

  Note: 'HIPAA Business Associate Agreements with third-party vendors'
}

Table compliance.notice_of_privacy_practices {
  notice_of_privacy_practices_id varchar [pk, note: 'Unique identifier for the Notice of Privacy Practices record. Primary key for the NPP entity tracking both document versions and patient acknowledgments.']
  care_site_id varchar [note: 'Identifier for the healthcare facility where the NPP was provided to the patient. Important for multi-facility organizations.']
  compliance_policy_id varchar [note: 'Foreign key linking to compliance.policy. Business justification: Notice of Privacy Practices (NPP) is a specific HIPAA-required policy document. Each NPP version/distribution should link to the underlying privacy policy it implements. This allows tracking NPP distr']
  mpi_record_id varchar [note: 'Unique identifier for the patient who received and acknowledged (or refused) the NPP. Links to the patient master record.']
  provided_by_employee_id varchar [note: 'Identifier for the employee or staff member who provided the NPP to the patient and obtained (or attempted to obtain) acknowledgment.']
  superseded_notice_of_privacy_practices_id varchar [note: 'Self-referencing FK on notice_of_privacy_practices (superseded_notice_of_privacy_practices_id)']
  visit_id varchar [note: 'Identifier for the clinical encounter or visit during which the NPP was provided to the patient. Null if provided outside of an encounter context.']
  acknowledgment_date date [note: 'Date when the patient acknowledged receipt of the NPP. Null if acknowledgment was refused or not obtained.']
  acknowledgment_method varchar [note: 'Specific method used to capture the patient\'s acknowledgment (e.g., wet signature on paper, electronic signature pad, portal checkbox).']
  acknowledgment_status varchar [note: 'Current status of the patient\'s acknowledgment of receipt of the NPP. Tracks compliance with HIPAA requirement to make good faith effort to obtain acknowledgment.']
  acknowledgment_timestamp timestamp [note: 'Precise date and time when the patient acknowledged receipt of the NPP, particularly important for electronic acknowledgments.']
  acknowledgment_type varchar [note: 'Type of acknowledgment received from the patient. HIPAA requires good faith effort to obtain written acknowledgment but allows documentation of refusal or inability to obtain.']
  audit_trail_notes varchar [note: 'Additional notes or comments documenting special circumstances, follow-up actions, or compliance considerations related to this NPP record.']
  available_on_website_flag boolean [note: 'Indicates whether this NPP version is available on the organization\'s website. HIPAA requires covered entities with websites to post NPP prominently.']
  department_name varchar [note: 'Name of the department or service area where the NPP was provided (e.g., Emergency Department, Registration, Outpatient Clinic).']
  device_type varchar [note: 'Type of device used for electronic NPP acknowledgment (e.g., desktop, mobile, tablet, kiosk). Supports audit trail for electronic acknowledgments.']
  distribution_date date [note: 'Date when the NPP was provided or made available to the patient. Required for compliance documentation.']
  distribution_method varchar [note: 'Method by which the NPP was provided to the patient. HIPAA requires covered entities to provide NPP at first service delivery and make good faith effort to obtain acknowledgment. [ENUM-REF-CANDIDATE: paper|electronic|portal|email|mail|in_person|kiosk — 7 candidates stripped; promote to reference product]']
  distribution_timestamp timestamp [note: 'Precise date and time when the NPP was distributed to the patient, particularly important for electronic and portal distributions.']
  emergency_exception_flag boolean [note: 'Indicates whether the NPP acknowledgment was not obtained due to emergency treatment circumstances. HIPAA allows exception for emergency situations.']
  emergency_exception_reason varchar [note: 'Description of the emergency circumstances that prevented obtaining NPP acknowledgment at the time of service.']
  follow_up_completion_date date [note: 'Date when follow-up was completed and NPP acknowledgment was obtained or final refusal documented.']
  follow_up_due_date date [note: 'Target date by which follow-up should be completed to obtain NPP acknowledgment if not obtained at initial service delivery.']
  follow_up_required_flag boolean [note: 'Indicates whether follow-up is required to obtain NPP acknowledgment (e.g., after emergency treatment, if patient was unable to acknowledge at initial visit).']
  ip_address varchar [note: 'IP address from which electronic or portal-based NPP acknowledgment was submitted. Used for audit trail and verification purposes.']
  material_change_flag boolean [note: 'Indicates whether this NPP version contains material changes to privacy practices. HIPAA requires prompt revision and redistribution if material changes occur.']
  mrn varchar [note: 'The patient\'s Medical Record Number used to identify the individual across the healthcare organization. Required for tracking NPP acknowledgment compliance.']
  npp_document_title varchar [note: 'Official title of the NPP document (e.g., \'Notice of Privacy Practices for Protected Health Information\').']
  npp_document_url varchar [note: 'Storage location or URL where the NPP document is maintained (e.g., document management system path, web portal URL).']
  npp_effective_date date [note: 'Date when this version of the NPP became effective and legally binding. Required to be printed on the notice per HIPAA regulations.']
  npp_expiration_date date [note: 'Date when this NPP version was superseded or retired. Null for the current active version.']
  npp_language_code varchar [note: 'ISO 639-2 three-letter language code for the NPP document (e.g., ENG for English, SPA for Spanish). Organizations must provide NPP in languages spoken by patient populations.']
  npp_version_number varchar [note: 'Version identifier for the NPP document (e.g., 1.0, 2.1, 3.0). Tracks revisions to the notice over time as regulations or organizational practices change.']
  posted_in_facility_flag boolean [note: 'Indicates whether this NPP version is posted prominently in the facility where patients can view it. HIPAA requires posting in clear and prominent location.']
  record_created_timestamp timestamp [note: 'Date and time when this NPP record was first created in the system. Part of the audit trail required for HIPAA compliance documentation.']
  record_modified_by varchar [note: 'Identifier or name of the user who last modified this NPP record. Required for audit trail and accountability.']
  record_modified_timestamp timestamp [note: 'Date and time when this NPP record was last modified. Supports audit trail and compliance verification.']
  refusal_documented_by varchar [note: 'Name or identifier of the staff member who documented the patient\'s refusal to acknowledge the NPP.']
  refusal_reason varchar [note: 'Documented reason why the patient refused to acknowledge receipt of the NPP. HIPAA requires documentation of good faith effort and reason for non-acknowledgment.']
  revision_reason varchar [note: 'Reason for creating a new version of the NPP (e.g., regulatory change, organizational policy update, new service offerings). Required when material changes are made.']
  signature_image_url varchar [note: 'Storage location or URL for the scanned or electronic signature image capturing the patient\'s acknowledgment.']
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutation to ensure change']
  vibe_mutation_marker varchar
  vibe_mutation_timestamp timestamp [note: 'Auto‑added by VIBE mutator to register a change']
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']
  website_url varchar [note: 'URL where the NPP is published on the organization\'s website for public access.']
  witness_name varchar [note: 'Name of witness present during NPP distribution and acknowledgment, if applicable (e.g., for verbal acknowledgments or special circumstances).']

  Note: 'Notice of Privacy Practices versions and patient acknowledgments'
}

Table compliance.phi_access_log {
  phi_access_log_id varchar [pk, note: 'Unique identifier for each PHI access audit log entry. Primary key for compliance tracking of electronic Protected Health Information access events.']
  care_site_id varchar [note: 'Identifier of the healthcare facility where the access occurred. Supports facility-level compliance reporting and multi-site access pattern analysis.']
  employee_id varchar [note: 'Identifier of the workforce member or system user who accessed the PHI. Links to employee or system user master data for accountability tracking.']
  fhir_resource_log_id varchar [note: 'Foreign key linking to interoperability.fhir_resource_log. Business justification: PHI access auditing must correlate with FHIR API access logs to create complete audit trails for patient data access via APIs. Required for HIPAA audit controls, patient access requests, and Cures Act']
  mpi_record_id varchar [note: 'Unique identifier of the patient whose PHI was accessed. Links to patient master data for privacy investigations and minimum necessary access reviews.']
  note_id varchar [note: 'Foreign key linking to clinical.clinical_note. Business justification: Access audit trails must track which specific clinical notes were viewed for inappropriate access monitoring and breach investigation. Healthcare organizations audit access logs against clinical note ']
  parent_phi_access_log_id varchar [note: 'Self-referencing FK on phi_access_log (related_phi_access_log_id)']
  visit_id varchar [note: 'Identifier of the clinical encounter or visit associated with the access event, if applicable. Links access to specific episodes of care for context validation.']
  access_reason varchar [note: 'Business reason or justification for accessing the PHI, either system-captured or user-provided. Used to validate legitimate treatment, payment, or healthcare operations purposes.']
  access_reason_code varchar [note: 'Standardized code representing the category of access reason. Enables systematic analysis of access patterns and compliance with minimum necessary standards. [ENUM-REF-CANDIDATE: treatment|payment|operations|research|legal|emergency|patient_request|quality_review|audit|other — 10 candidates stripped; promote to reference product]']
  access_timestamp timestamp [note: 'Date and time when the PHI access event occurred. Critical for audit trail reconstruction and compliance investigations per HIPAA Security Rule audit control requirements.']
  access_type varchar [note: 'Type of action performed on the PHI (view, print, export, modify, create, delete). Critical for assessing the nature and risk level of the access event.']
  audit_log_source varchar [note: 'Source system or mechanism that generated this audit log entry (e.g., EHR native audit, SIEM correlation, access governance tool). Identifies the technical origin of the compliance record.']
  breach_determination varchar [note: 'Determination of whether the access event constitutes a breach of unsecured PHI requiring notification under the HIPAA Breach Notification Rule. Critical for regulatory reporting obligations.']
  breach_reported_date date [note: 'Date when the breach was reported to affected individuals, HHS, or media, if applicable. Tracks compliance with breach notification timelines.']
  break_glass_flag boolean
  corrective_action_required boolean [note: 'Indicates whether corrective action or workforce sanctions are required as a result of this access event. True if the review determined policy violations requiring remediation.']
  corrective_action_taken varchar [note: 'Description of corrective actions or sanctions applied (e.g., counseling, retraining, access suspension, termination). Confidential workforce management information documenting compliance enforcement.']
  created_timestamp timestamp [note: 'Timestamp when this audit log record was created in the compliance data warehouse. Distinct from access_timestamp; represents when the compliance record was captured for reporting.']
  data_classification varchar [note: 'Classification level of the PHI accessed, indicating heightened sensitivity requiring additional protections under federal or state law (e.g., 42 CFR Part 2 substance abuse records, state mental health laws). [ENUM-REF-CANDIDATE: phi|sensitive_phi|substance_abuse|mental_health|hiv_aids|genetic|reproductive_health — 7 candidates stripped; promote to reference product]']
  disclosure_tracking_required boolean [note: 'Indicates whether this access event must be tracked as a disclosure for patient accounting of disclosures purposes under HIPAA. True for disclosures outside of treatment, payment, and operations.']
  emergency_access_flag boolean [note: 'Indicates whether this was an emergency or break-the-glass access event where normal access controls were overridden for patient safety reasons. True for emergency access requiring post-hoc review.']
  flag_reason varchar [note: 'Reason why the access was flagged for review (e.g., no patient relationship, VIP patient access, excessive access volume, after-hours access, break-the-glass override). Guides privacy officer investigation priorities.']
  flagged_for_review boolean [note: 'Indicates whether this access event was flagged by automated monitoring rules for privacy officer review. True if the access triggered compliance alerts based on access patterns, break-the-glass scenarios, or policy violations.']
  ip_address varchar [note: 'IP address of the device from which the PHI was accessed. Used for technical audit trail and security incident investigation.']
  modified_timestamp timestamp [note: 'Timestamp when this audit log record was last modified, typically during privacy officer review or investigation updates. Supports audit trail integrity and compliance record lifecycle tracking.']
  mrn varchar [note: 'The patient\'s Medical Record Number accessed during this event. Provides human-readable patient identifier for audit review and investigation workflows.']
  patient_consent_on_file boolean [note: 'Indicates whether valid patient consent or authorization was on file at the time of access, if required. Used to validate compliance with consent requirements for specific uses and disclosures.']
  patient_relationship varchar [note: 'Nature of the user\'s relationship to the patient at the time of access. Used to assess appropriateness of access based on legitimate need-to-know and minimum necessary principles. [ENUM-REF-CANDIDATE: direct_care_provider|care_team_member|consulting_provider|administrative_staff|billing_staff|no_relationship|emergency_access — 7 candidates stripped; promote to reference product]']
  record_type varchar [note: 'Type of PHI record accessed. Categorizes the nature of protected health information viewed for compliance analysis and minimum necessary reviews. [ENUM-REF-CANDIDATE: clinical_note|lab_result|radiology_report|medication_order|diagnosis|procedure|demographic|insurance|billing|appointment|immunization|allergy|vital_sign|problem_list|care_plan|discharge_summary|operative_note|pathology_report|consent_form — promote to reference product]']
  resource_accessed varchar
  retention_period_years varchar [note: 'Number of years this audit log entry must be retained per HIPAA Security Rule requirements and organizational policy. Typically 6 years from creation or last active date per §164.316(b)(2)(i).']
  review_date date [note: 'Date when the compliance review of this access event was completed. Used to track review timeliness and compliance program effectiveness.']
  review_notes varchar [note: 'Confidential notes documented by the privacy officer during the review of this access event. Contains investigation findings, user explanations, and compliance determinations.']
  review_status varchar [note: 'Current status of the compliance review for this access event. Tracks the lifecycle of privacy officer investigation from initial flag through resolution.']
  reviewed_by varchar [note: 'Name or identifier of the privacy officer or compliance staff member who reviewed this access event. Establishes accountability for compliance review activities.']
  session_code varchar [note: 'Unique identifier for the user session during which the access occurred. Enables correlation of multiple access events within a single login session.']
  suspicious_flag boolean
  system_accessed varchar [note: 'Name or identifier of the electronic health information system accessed (e.g., Epic EHR, Cerner Millennium, PACS, LIS). Identifies the source system containing the ePHI.']
  system_module varchar [note: 'Specific module or application within the system accessed (e.g., ClinDoc, Orders, Beaker, PowerChart). Provides granular detail on the type of PHI accessed.']
  user_department varchar [note: 'Department or organizational unit to which the accessing user belongs. Supports departmental compliance reporting and access pattern analysis.']
  user_name varchar [note: 'Full name of the user who accessed the PHI. Captured for human-readable audit reporting and privacy officer investigations.']
  user_role varchar [note: 'Job role or function of the user at the time of access (e.g., Physician, Nurse, Billing Specialist, Registration Clerk). Used to assess appropriateness of access based on role-based access control policies.']
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutation to ensure change']
  vibe_mutation_marker varchar
  vibe_mutation_timestamp timestamp [note: 'Auto‑added by VIBE mutator to register a change']
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']
  violation_type varchar [note: 'Type of HIPAA violation identified during review, if applicable (e.g., unauthorized access, snooping, minimum necessary violation, breach of confidentiality). Used for workforce sanctions and corrective action tracking.']
  workstation_code varchar [note: 'Identifier of the physical or virtual workstation from which the access occurred. Supports technical security investigations and physical safeguard compliance.']

  Note: 'Audit logs of PHI access for compliance monitoring'
}

Table compliance.attestation {
  attestation_id varchar [pk, note: 'Unique identifier for the compliance attestation record. Primary key.']
  care_site_id varchar [note: 'Identifier of the healthcare facility or location where the attesting individual is assigned. Used for facility-level compliance reporting and tracking.']
  compliance_policy_id varchar [note: 'Identifier of the specific policy or regulatory requirement being attested to. Links the attestation to the governing policy document.']
  compliance_program_id varchar [note: 'Identifier of the compliance program under which this attestation is required. Links the attestation to the governing compliance framework.']
  obligation_id varchar [note: 'Foreign key linking to compliance.obligation. Business justification: Attestations fulfill specific regulatory obligations. Each attestation should link to the obligation it satisfies (regulatory_requirement_reference exists as STRING but should be structured FK). This ']
  primary_attestation_employee_id varchar [note: 'Identifier of the workforce member submitting the attestation. Links to the employee or medical staff member making the formal certification.']
  reattested_attestation_id varchar [note: 'Self-referencing FK on attestation (reattested_attestation_id)']
  reviewer_employee_id varchar [note: 'Identifier of the compliance officer or manager who reviewed and approved the attestation. Links to the employee responsible for verification.']
  training_completion_id varchar [note: 'Foreign key linking to compliance.training_completion. Business justification: Attestation has training_completion_flag and training_completion_date, indicating it references a specific training completion event. When training is required for attestation, should link to the spec']
  acknowledgment_flag boolean [note: 'Indicates whether the attesting individual has acknowledged receipt and understanding of the policy or requirement. True if acknowledged, False otherwise.']
  approval_authority varchar [note: 'Name or title of the individual or role with authority to approve this attestation. Defines the governance hierarchy for compliance certifications.']
  attestation_date date [note: 'Date on which the attesting individual formally submitted or signed the attestation. Represents the principal business event timestamp for this transaction.']
  attestation_number varchar [note: 'Business-facing unique identifier or tracking number for the attestation, used for reference in compliance documentation and audit trails.']
  attestation_status varchar [note: 'Current lifecycle state of the attestation. Tracks whether the certification is awaiting submission, has been completed, is past due, or has been rejected.']
  attestation_type varchar [note: 'Category of attestation being submitted. Defines the specific compliance requirement or policy being certified.']
  attesting_individual_department varchar [note: 'Department or organizational unit to which the attesting individual belongs. Used for compliance reporting and departmental attestation tracking.']
  attesting_individual_email varchar [note: 'Email address of the person submitting the attestation. Used for communication, reminders, and audit trail documentation.']
  attesting_individual_name varchar [note: 'Full name of the person submitting the attestation. Captured for audit trail and compliance documentation purposes.']
  attesting_individual_title varchar [note: 'Job title or role of the person submitting the attestation at the time of certification. Provides context for the authority and scope of the attestation.']
  audit_trail_notes varchar [note: 'Free-text notes documenting changes, communications, or significant events related to this attestation. Provides detailed audit trail for compliance investigations.']
  created_timestamp timestamp [note: 'Date and time when this attestation record was first created in the system. Provides audit trail for record creation.']
  device_identifier varchar [note: 'Identifier of the device or workstation from which the attestation was submitted. Used for security tracking and access control verification.']
  due_date date [note: 'Deadline by which the attestation must be submitted to remain compliant. Used to track overdue attestations and trigger escalations.']
  effective_date date
  electronic_signature_reference varchar [note: 'Reference identifier or token for the electronic signature applied to the attestation. Links to the digital signature system for non-repudiation and legal validity.']
  expiration_date date [note: 'Date on which this attestation expires and is no longer considered valid for compliance purposes. Triggers need for renewal or recertification.']
  ip_address varchar [note: 'IP address from which the attestation was submitted. Captured for security audit and fraud prevention purposes.']
  mandatory_flag boolean [note: 'Indicates whether this attestation is mandatory for the individual based on their role and responsibilities. True if required, False if voluntary.']
  modified_by_user varchar [note: 'Username or identifier of the system user who last modified this attestation record. Provides accountability for record changes.']
  modified_timestamp timestamp [note: 'Date and time when this attestation record was last modified. Tracks the most recent update to the record for audit purposes.']
  next_recertification_due_date date [note: 'Date by which the next recertification attestation must be submitted. Used to schedule and track recurring compliance certifications.']
  notes varchar
  notification_sent_date date [note: 'Date on which the most recent notification or reminder was sent to the attesting individual. Used to track communication history.']
  notification_sent_flag boolean [note: 'Indicates whether a notification or reminder has been sent to the attesting individual regarding this attestation. True if notification sent, False otherwise.']
  period_end_date date [note: 'Ending date of the time period covered by this attestation. Defines when the compliance certification period concludes.']
  period_start_date date [note: 'Beginning date of the time period covered by this attestation. Defines the effective start of the compliance certification period.']
  recertification_frequency_months varchar [note: 'Number of months between required recertifications for this attestation type. Null if recertification is not required.']
  recertification_required_flag boolean [note: 'Indicates whether this attestation requires periodic recertification. True if recertification is required, False if it is a one-time attestation.']
  regulatory_requirement_reference varchar [note: 'Citation or reference to the specific regulatory requirement, standard, or obligation that this attestation satisfies. Examples include HIPAA sections, CMS conditions, Joint Commission standards.']
  rejection_reason varchar [note: 'Explanation for why the attestation was rejected, if applicable. Captures the rationale for non-acceptance and required corrective actions.']
  review_date date [note: 'Date on which the attestation was reviewed and approved by the compliance officer or designated authority.']
  scope varchar [note: 'Description of the scope or coverage of the attestation. Defines what activities, locations, or responsibilities are covered by this certification.']
  signature_timestamp timestamp [note: 'Precise date and time when the electronic signature was applied to the attestation. Provides legal timestamp for compliance and audit purposes.']
  statement varchar [note: 'Full text of the attestation statement or certification language that the individual is affirming. Captures the exact wording of the compliance commitment.']
  supporting_documentation_url varchar [note: 'File path or URL to supporting documentation or evidence attached to the attestation. Links to certificates, training records, or other proof of compliance.']
  training_completion_flag boolean [note: 'Indicates whether required training associated with this attestation has been completed. True if training is complete, False otherwise.']
  updated_timestamp timestamp
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutation to ensure change']
  vibe_mutation_marker varchar
  vibe_mutation_timestamp timestamp [note: 'Auto‑added by VIBE mutator to register a change']
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']

  Note: 'Employee and provider attestations for compliance requirements'
}

Table compliance.regulatory_change {
  regulatory_change_id varchar [pk, note: 'Unique identifier for the regulatory change record. Primary key.']
  compliance_program_id varchar [note: 'Reference to the primary compliance program affected by this regulatory change.']
  primary_regulatory_employee_id varchar [note: 'Reference to the compliance officer responsible for managing the organizational response to this regulatory change.']
  superseded_regulatory_change_id varchar [note: 'Self-referencing FK on regulatory_change (superseded_regulatory_change_id)']
  actual_cost_amount decimal(15,2) [note: 'Actual financial cost incurred by the organization for implementing this regulatory change.']
  affected_compliance_programs varchar [note: 'Comma-separated list or description of all compliance programs impacted by this regulatory change.']
  affected_facilities varchar [note: 'List or description of healthcare facilities affected by this regulatory change.']
  affected_systems varchar [note: 'Information systems and applications that require modification to comply with this regulatory change (e.g., EHR, billing system, reporting tools).']
  assigned_department varchar [note: 'The primary department responsible for implementing the regulatory change.']
  change_description varchar [note: 'Detailed description of the regulatory change, including what is being modified, added, or removed.']
  change_number varchar [note: 'Business identifier for the regulatory change, typically assigned by the compliance office or derived from the regulatory body\'s reference number.']
  change_title varchar [note: 'The official title or name of the regulatory change as published by the regulatory body.']
  change_type varchar [note: 'The nature of the regulatory change being tracked.']
  comment_period_end_date date [note: 'The deadline by which public comments must be submitted to the regulatory body.']
  comment_period_start_date date [note: 'The date when the public comment period opens for proposed regulatory changes.']
  comment_submission_date date [note: 'The date when organizational comments were submitted to the regulatory body.']
  comment_submitted_flag boolean [note: 'Indicates whether the organization submitted comments during the public comment period.']
  comment_summary varchar [note: 'Summary of the comments submitted by the organization during the comment period.']
  created_timestamp timestamp [note: 'The timestamp when this regulatory change record was first created in the system.']
  document_url varchar [note: 'URL or file path to the official regulatory change document or Federal Register notice.']
  effective_date date [note: 'The date when the regulatory change becomes effective and enforceable.']
  estimated_cost_amount decimal(15,2) [note: 'Estimated financial cost to the organization for implementing this regulatory change, including system modifications, training, and process changes.']
  external_consultation_required_flag boolean [note: 'Indicates whether external legal or compliance consultation was or will be required for this regulatory change.']
  impact_assessment_completion_date date [note: 'The date when the impact assessment was completed.']
  impact_assessment_status varchar [note: 'Current status of the organizational impact assessment for this regulatory change.']
  impact_summary varchar [note: 'Summary of the organizational impact including affected departments, systems, processes, and estimated effort.']
  implementation_completion_date date [note: 'The date when all implementation activities were completed and verified.']
  implementation_deadline date [note: 'The date by which the organization must have fully implemented the regulatory change to achieve compliance.']
  implementation_start_date date [note: 'The date when implementation activities began.']
  implementation_status varchar [note: 'Current status of the organization\'s implementation of the regulatory change. [ENUM-REF-CANDIDATE: identified|under review|planning|in progress|implemented|verified|closed — 7 candidates stripped; promote to reference product]']
  internal_documentation_url varchar [note: 'URL or file path to internal organizational documentation related to this regulatory change (impact assessments, implementation plans, meeting notes).']
  modified_timestamp timestamp [note: 'The timestamp when this regulatory change record was last modified.']
  monitoring_required_flag boolean [note: 'Indicates whether ongoing monitoring is required after implementation to ensure sustained compliance.']
  next_review_date date [note: 'The date when this regulatory change record should be reviewed for updates or changes in regulatory guidance.']
  notes varchar [note: 'Additional notes, observations, or context related to this regulatory change.']
  penalty_exposure_amount decimal(15,2) [note: 'Estimated financial penalty exposure if the organization fails to comply with this regulatory change.']
  policy_updates_required_flag boolean [note: 'Indicates whether organizational policies must be updated to comply with this regulatory change.']
  publication_date date [note: 'The date the regulatory change was officially published or announced by the regulatory body.']
  regulatory_body varchar [note: 'The governing body or agency issuing the regulatory change (e.g., CMS, OCR, Joint Commission, OSHA, State Department of Health, FDA).']
  regulatory_citation varchar [note: 'The official citation or reference number for the regulatory change (e.g., Federal Register citation, CFR section, Joint Commission standard number).']
  regulatory_framework varchar [note: 'The overarching regulatory framework or program under which this change falls (e.g., HIPAA, CMS Conditions of Participation, Joint Commission Standards, OSHA Healthcare Worker Safety).']
  response_actions_required varchar [note: 'Description of the specific actions the organization must take to comply with the regulatory change (e.g., policy updates, system changes, training, reporting modifications).']
  risk_level varchar [note: 'The risk level associated with non-compliance or delayed implementation of this regulatory change.']
  superseded_regulation varchar [note: 'Reference to the previous regulation or standard that this change supersedes or replaces.']
  training_required_flag boolean [note: 'Indicates whether staff training is required to implement this regulatory change.']
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutation to ensure change']
  vibe_mutation_marker varchar
  vibe_mutation_timestamp timestamp [note: 'Auto‑added by VIBE mutator to register a change']
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']

  Note: 'Tracking of regulatory changes and their impact on compliance programs'
}

Table compliance.monitoring_activity {
  monitoring_activity_id varchar [pk, note: 'Unique identifier for the compliance monitoring activity record. Primary key for the monitoring activity entity.']
  care_site_id varchar [note: 'Reference to the healthcare facility where the monitoring activity is being conducted or that is the subject of the review.']
  compliance_policy_id varchar [note: 'Foreign key linking to compliance.policy. Business justification: Monitoring activities verify policy compliance. The policy_reference (STRING) field should be replaced with a structured FK policy_id. This allows tracking which policies are being monitored and aggre']
  compliance_program_id varchar [note: 'Reference to the overarching compliance program under which this monitoring activity is conducted.']
  cpt_code_id varchar [note: 'Foreign key linking to reference.cpt_code. Business justification: Procedure code monitoring targets specific CPT codes for compliance review based on utilization outliers, NCCI edit violations, or high-risk procedure categories identified in compliance risk assessme']
  follow_up_monitoring_activity_id varchar [note: 'Self-referencing FK on monitoring_activity (follow_up_monitoring_activity_id)']
  icd_code_id varchar [note: 'Foreign key linking to reference.icd_code. Business justification: Compliance monitoring activities (DRG validation, coding audits, medical necessity reviews) sample specific diagnosis codes for review based on risk profiles, payer focus areas, or OIG work plans.']
  interface_channel_id varchar [note: 'Foreign key linking to interoperability.interface_channel. Business justification: Compliance monitoring activities routinely audit interface channels for message integrity, timeliness, error rates, and adherence to data exchange policies. Linking monitoring to specific channels ena']
  lead_monitor_employee_id varchar [note: 'Reference to the employee who is leading or responsible for conducting the monitoring activity.']
  monitoring_cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: Monitoring activities consume departmental resources. Monitoring costs (staff time, audit tools, sampling) should be tracked against the responsible cost center\'s budget for cost allocation, program e']
  obligation_id varchar [note: 'Foreign key linking to compliance.obligation. Business justification: Monitoring activities verify compliance with specific regulatory obligations. Each monitoring activity should link to the obligation being monitored. This allows tracking obligation compliance through']
  activity_name varchar [note: 'Descriptive name or title of the monitoring activity that clearly identifies the focus and scope of the review.']
  activity_number varchar [note: 'Business-facing unique identifier or tracking number assigned to the monitoring activity for reference and reporting purposes.']
  activity_status varchar [note: 'Current lifecycle status of the monitoring activity indicating its progress through the monitoring workflow.']
  activity_type varchar [note: 'Classification of the monitoring activity by its primary focus area. Supports categorization and trend analysis of compliance monitoring efforts. [ENUM-REF-CANDIDATE: medical_record_review|hipaa_access_audit|billing_compliance_spot_check|coding_accuracy_review|policy_adherence_observation|department_self_assessment|claims_audit|documentation_review|privacy_monitoring|security_monitoring|quality_review|operational_audit — promote to reference product]']
  actual_completion_date date [note: 'The actual date when the monitoring activity was completed. Used to track schedule adherence and cycle time metrics.']
  actual_start_date date [note: 'The actual date when the monitoring activity execution began. Used to track schedule adherence and performance metrics.']
  compliance_rate_percentage decimal(5,2) [note: 'Calculated percentage representing the proportion of reviewed items that were found to be compliant with the applicable standard or requirement. Key performance indicator for compliance effectiveness.']
  confidentiality_level varchar [note: 'Classification of the sensitivity and access restrictions for the monitoring activity and its findings.']
  corrective_action_plan_required_flag boolean [note: 'Indicates whether a formal corrective action plan is required to address the issues identified during the monitoring activity.']
  created_timestamp timestamp [note: 'The date and time when this monitoring activity record was first created in the system. Supports audit trail and data lineage tracking.']
  critical_issues_count varchar [note: 'The number of issues identified that are classified as critical or high-severity, requiring immediate attention and remediation.']
  department_monitored varchar [note: 'The name of the department, unit, or functional area that is the subject of the monitoring activity.']
  external_auditor_involvement_flag boolean [note: 'Indicates whether external auditors or consultants participated in or reviewed the monitoring activity.']
  external_auditor_organization varchar [note: 'Name of the external auditing firm or consulting organization involved in the monitoring activity, if applicable.']
  findings_summary varchar [note: 'High-level summary of the key findings, observations, and results from the monitoring activity. Provides executive-level overview of compliance status.']
  follow_up_action_description varchar [note: 'Detailed description of the follow-up actions, corrective measures, or remediation steps required or recommended based on the monitoring findings.']
  follow_up_due_date date [note: 'The target date by which follow-up actions or corrective measures should be completed.']
  follow_up_required_flag boolean [note: 'Indicates whether follow-up monitoring or verification activities are required based on the findings of this monitoring activity.']
  issues_identified_count varchar [note: 'The total number of compliance issues, deficiencies, or non-conformances identified during the monitoring activity.']
  lead_monitor_name varchar [note: 'Full name of the employee leading the monitoring activity. Provides quick reference without requiring a join to the employee table.']
  modified_timestamp timestamp [note: 'The date and time when this monitoring activity record was last updated or modified. Supports audit trail and change tracking.']
  monitoring_methodology varchar [note: 'Description of the approach, techniques, and procedures used to conduct the monitoring activity (e.g., random sampling, targeted review, automated scanning, observation).']
  monitoring_period_end_date date [note: 'The ending date of the time period being reviewed or monitored for compliance. Defines the temporal scope of the monitoring activity.']
  monitoring_period_start_date date [note: 'The beginning date of the time period being reviewed or monitored for compliance. Defines the temporal scope of the monitoring activity.']
  monitoring_team_size varchar [note: 'The number of individuals involved in conducting the monitoring activity. Used for resource planning and workload analysis.']
  notes varchar [note: 'Additional free-text notes, comments, or contextual information about the monitoring activity that do not fit into structured fields.']
  population_size varchar [note: 'The total number of records, transactions, or cases in the population from which the sample was drawn.']
  process_monitored varchar [note: 'Description of the specific business process, workflow, or operational activity being monitored for compliance (e.g., patient registration, order entry, billing submission).']
  regulatory_citation varchar [note: 'Specific citation or reference to the regulatory requirement, standard section, or rule being monitored (e.g., 45 CFR 164.308, Joint Commission Standard LD.04.03.11).']
  regulatory_framework varchar [note: 'The primary regulatory framework or standard being monitored for compliance (e.g., HIPAA, CMS Conditions of Participation, Joint Commission standards, OSHA requirements).']
  report_document_path varchar [note: 'File system path or URL to the detailed monitoring activity report document for reference and audit trail purposes.']
  report_issued_date date [note: 'The date when the formal monitoring activity report was issued or published to stakeholders.']
  risk_level varchar [note: 'Assessment of the overall risk level associated with the findings from the monitoring activity, considering potential impact on patient safety, regulatory compliance, and financial exposure.']
  sample_size varchar [note: 'The number of records, transactions, or cases reviewed as part of the monitoring activity. Used to assess statistical validity and coverage.']
  scheduled_completion_date date [note: 'The planned date by which the monitoring activity is expected to be completed.']
  scheduled_start_date date [note: 'The planned date when the monitoring activity is scheduled to begin execution.']
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutation to ensure change']
  vibe_mutation_marker varchar
  vibe_mutation_timestamp timestamp [note: 'Auto‑added by VIBE mutator to register a change']
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']

  Note: 'Ongoing compliance monitoring activities and reviews'
}

Table compliance.program_policy_assignment {
  program_policy_assignment_id varchar [pk, note: 'Unique identifier for this program-policy assignment record. Primary key.']
  compliance_policy_id varchar [note: 'Foreign key linking to the organizational policy assigned to this compliance program']
  primary_compliance_program_id varchar [note: 'Foreign key to compliance_program. Identifies which compliance program this policy is assigned to.']
  assigned_by varchar [note: 'Name or role of the individual or committee that assigned this policy to this compliance program (e.g., Chief Compliance Officer, Compliance Committee).']
  assignment_date date [note: 'Date when this policy was formally assigned to this compliance program. Tracks the governance decision date.']
  assignment_status varchar [note: 'Current status of this program-policy assignment. Active assignments are in effect; suspended assignments are temporarily inactive; retired assignments are no longer in effect; under_review assignments are being evaluated for continued relevance.']
  audit_frequency varchar [note: 'Frequency at which compliance with this policy must be audited specifically under this compliance program. May differ from the program\'s general audit_frequency or the policy\'s review cycle, as different programs may impose different audit requirements on the same policy.']
  effective_date date [note: 'Date when this policy became governed under this specific compliance program. May differ from the policy\'s own effective_date if the policy was added to an existing program later.']
  expiration_date date [note: 'Date when this program-policy assignment expires or requires renewal. Nullable for permanent assignments.']
  last_audit_date date [note: 'Date when compliance with this policy was last audited specifically in the context of this compliance program. Tracks program-specific audit history, as the same policy may be audited at different times under different programs.']
  last_review_date date [note: 'Date when this program-policy assignment was last reviewed for continued relevance and accuracy.']
  mandatory_flag boolean [note: 'Indicates whether this policy is mandatory (true) or optional (false) specifically within the context of this compliance program. A policy may be mandatory under one program but optional under another.']
  next_audit_date date [note: 'Scheduled date for the next audit of this policy under this specific compliance program. Calculated based on the program-specific audit_frequency.']
  next_review_date date [note: 'Scheduled date for the next review of this program-policy assignment.']
  program_scope_applicability varchar [note: 'Description of how this policy applies within the scope of this specific compliance program. Captures program-specific applicability rules, exceptions, or scope limitations that may not apply when the same policy is governed under a different program.']
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutation to ensure change']
  vibe_mutation_marker varchar
  vibe_mutation_timestamp timestamp [note: 'Auto‑added by VIBE mutator to register a change']
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']

  Note: 'Assignment of policies to compliance programs'
}

Table compliance.policy_regulatory_impact {
  policy_regulatory_impact_id varchar [pk, note: 'Unique identifier for this policy regulatory impact record. Primary key.']
  compliance_policy_id varchar [note: 'Foreign key linking to the organizational policy that was created, updated, or retired in response to the regulatory change.']
  employee_id varchar [note: 'Reference to the compliance officer responsible for managing this specific policy response to this regulatory change. May differ from the overall regulatory change owner if different officers manage different policy impacts.']
  regulatory_change_id varchar [note: 'Foreign key linking to the regulatory change that triggered the policy action.']
  change_summary varchar [note: 'Summary of the specific changes made to this policy in response to this regulatory change. Describes what was added, modified, or removed from the policy to achieve compliance.']
  created_timestamp timestamp [note: 'Timestamp when this policy regulatory impact record was created in the system.']
  effective_date date [note: 'The date when the policy change or new policy becomes effective in response to the regulatory change. This is the date when the policy update driven by this regulatory change takes effect.']
  impact_assessment_date date [note: 'The date when the impact assessment for this regulatory change on this specific policy was completed.']
  impact_assessment_status varchar [note: 'Current status of the impact assessment for this specific regulatory change on this specific policy. Tracks the workflow state of evaluating how the regulatory change affects this policy.']
  implementation_date date [note: 'The date when the policy changes required by this regulatory change were fully implemented and operationalized across the organization.']
  policy_version_created varchar [note: 'The version number of the policy that was created or updated as a result of this regulatory change. Links the regulatory change to the specific policy version it triggered.']
  response_type varchar [note: 'The type of policy action taken in response to this regulatory change. Indicates whether a new policy was created, an existing policy was updated, a policy was retired, or no policy action was required.']
  updated_timestamp timestamp [note: 'Timestamp when this policy regulatory impact record was last updated.']
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutation to ensure change']
  vibe_mutation_marker varchar
  vibe_mutation_timestamp timestamp [note: 'Auto‑added by VIBE mutator to register a change']
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']

  Note: 'Mapping of policies to regulatory requirements they satisfy'
}

Table compliance.policy_payer_applicability {
  policy_payer_applicability_id varchar [pk, note: 'Unique identifier for this policy-payer applicability record. Primary key.']
  compliance_policy_id varchar [note: 'Foreign key linking to the organizational policy that applies to this payer relationship.']
  payer_id varchar [note: 'Foreign key linking to the insurance payer to whom this policy applies.']
  attestation_required boolean [note: 'Indicates whether the payer is required to formally attest to compliance with this policy as part of the contractual relationship. True for policies with regulatory or contractual attestation requirements.']
  compliance_status varchar [note: 'Current compliance status of the payer with respect to this policy. Compliant indicates the payer meets all policy requirements; non_compliant indicates violations or gaps; pending_review indicates assessment in progress; waived indicates formal exception granted; not_applicable indicates policy does not apply to this payer relationship.']
  distribution_date date [note: 'Date on which this policy was distributed or communicated to the payer. Tracks when the payer was notified of policy requirements.']
  effective_date date [note: 'Date on which this policy became applicable to this payer relationship. May differ from the policy\'s overall effective date if the payer contract was established after policy adoption.']
  last_compliance_review_date date [note: 'Date on which compliance with this policy was most recently assessed for this payer relationship. Used for audit tracking and review cycle management.']
  next_compliance_review_date date [note: 'Scheduled date for the next compliance review of this payer against this policy. Calculated based on policy review cycle and payer contract terms.']
  notes varchar [note: 'Free-text notes documenting payer-specific considerations, exceptions, or implementation details for this policy applicability. Used for operational context and audit trail.']
  payer_acknowledgment_date date [note: 'Date on which the payer formally acknowledged receipt and acceptance of this policy as part of the contractual relationship. Required for contract compliance and audit trail.']
  payer_specific_version varchar [note: 'Version identifier for the payer-specific adaptation or addendum to the base policy. Some payers require customized policy language or additional requirements beyond the base organizational policy.']
  termination_date date [note: 'Date on which this policy ceased to apply to this payer relationship. Nullable for ongoing applicability. Used when payer contracts end or policies are superseded.']
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutation to ensure change']
  vibe_mutation_marker varchar
  vibe_mutation_timestamp timestamp [note: 'Auto‑added by VIBE mutator to register a change']
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']
  waiver_approval_authority varchar [note: 'Individual, role, or committee that approved the waiver for this payer-policy combination. Nullable if no waiver granted.']
  waiver_granted_flag boolean [note: 'Indicates whether a formal waiver or exception has been granted exempting this payer from this policy requirement. True indicates waiver in effect.']
  waiver_justification varchar [note: 'Business or regulatory justification for granting a waiver exempting this payer from this policy. Nullable if no waiver granted. Required for audit and governance documentation.']

  Note: 'Payer-specific policy applicability and requirements'
}

Table compliance.regulatory_requirement {
  regulatory_requirement_id varchar [pk, note: 'Primary key for regulatory_requirement']
  parent_regulatory_requirement_id varchar [note: 'Self-referencing FK on regulatory_requirement (parent_regulatory_requirement_id)']
  regulatory_superseded_by_requirement_id varchar [note: 'Identifier of the regulatory requirement that supersedes this requirement, if applicable. Null if not superseded.']
  applicability_scope varchar [note: 'Description of which organizational units, facilities, or business processes this requirement applies to (e.g., all hospitals, outpatient clinics only, laboratories, covered entities).']
  audit_frequency varchar [note: 'Frequency at which audits or assessments must be conducted for this requirement, if audits are required.']
  audit_required boolean [note: 'Indicates whether periodic audits or assessments are required to verify compliance with this requirement (True) or not (False).']
  compliance_frequency varchar [note: 'Frequency at which compliance with this requirement must be demonstrated or assessed (e.g., continuous, annual, quarterly, monthly, event-driven, one-time).']
  control_framework varchar [note: 'Name of the internal control framework or compliance program that governs this requirement (e.g., HIPAA Compliance Program, Patient Safety Program, Infection Control Program).']
  created_timestamp timestamp [note: 'Timestamp when this regulatory requirement record was first created in the system.']
  documentation_retention_years varchar [note: 'Number of years that documentation demonstrating compliance with this requirement must be retained.']
  effective_date date [note: 'Date when the regulatory requirement became or will become enforceable.']
  expiration_date date [note: 'Date when the regulatory requirement is no longer enforceable or was superseded. Null for requirements that remain active indefinitely.']
  implementation_guidance varchar [note: 'Guidance notes or instructions for implementing this requirement within the organization.']
  jurisdiction varchar [note: 'Geographic or governmental scope of the requirement: federal, state, local, or international.']
  jurisdiction_detail varchar [note: 'Specific jurisdiction detail (e.g., state name, country code) when the requirement applies to a specific geographic area.']
  last_reviewed_date date [note: 'Date when this regulatory requirement record was last reviewed for accuracy and currency.']
  next_review_date date [note: 'Scheduled date for the next review of this regulatory requirement record.']
  penalty_amount_max decimal(15,2) [note: 'Maximum monetary penalty amount for noncompliance, if applicable. Null if no monetary penalty or penalty is not quantified.']
  penalty_amount_min decimal(15,2) [note: 'Minimum monetary penalty amount for noncompliance, if applicable. Null if no monetary penalty or penalty is not quantified.']
  penalty_currency_code varchar [note: 'Three-letter ISO 4217 currency code for penalty amounts (e.g., USD, EUR, GBP).']
  penalty_for_noncompliance varchar [note: 'Description of penalties, fines, sanctions, or enforcement actions that may result from noncompliance with this requirement.']
  policy_reference varchar [note: 'Reference to the internal policy or procedure document that implements this regulatory requirement.']
  regulation_citation varchar [note: 'Full legal citation or reference to the regulation section (e.g., 45 CFR 164.308(a)(1)(i), 42 CFR 482.13, 29 CFR 1910.1030).']
  regulation_name varchar [note: 'Name of the parent regulation, standard, or framework to which this requirement belongs (e.g., HIPAA Privacy Rule, CMS Conditions of Participation, Joint Commission National Patient Safety Goals).']
  regulatory_body varchar [note: 'Name of the governing body or agency that issued the requirement (e.g., HHS Office for Civil Rights, CMS, Joint Commission, OSHA, State Health Department).']
  regulatory_requirement_status varchar [note: 'Current lifecycle status of the regulatory requirement.']
  related_requirements varchar [note: 'Comma-separated list of related requirement codes or identifiers that are connected to or dependent on this requirement.']
  reporting_frequency varchar [note: 'Frequency at which reports must be submitted to the regulatory body, if reporting is required.']
  reporting_required boolean [note: 'Indicates whether this requirement mandates formal reporting to a regulatory body (True) or not (False).']
  requirement_category varchar [note: 'High-level classification of the regulatory requirement by domain (e.g., privacy, security, safety, quality, operational, financial, reporting).']
  requirement_code varchar [note: 'Externally-known unique code or identifier for the regulatory requirement (e.g., HIPAA-164.308, CMS-CoP-482.13, OSHA-1910.1030).']
  requirement_description varchar [note: 'Detailed description of the regulatory requirement, including scope, obligations, and compliance expectations.']
  requirement_title varchar [note: 'Human-readable title or name of the regulatory requirement.']
  requirement_type varchar [note: 'Classification of the requirement by enforcement level: mandatory (must comply), conditional (applies under certain conditions), recommended (best practice), or voluntary (optional).']
  responsible_role varchar [note: 'Job title or role responsible for ensuring compliance with this requirement (e.g., Chief Compliance Officer, Privacy Officer, Infection Control Director).']
  risk_level varchar [note: 'Organizational risk level associated with noncompliance with this requirement (critical, high, medium, low).']
  source_document_url varchar [note: 'URL or hyperlink to the official source document or regulatory text for this requirement.']
  training_frequency varchar [note: 'Frequency at which staff training must be completed for this requirement, if training is required.']
  training_required boolean [note: 'Indicates whether staff training is required to comply with this requirement (True) or not (False).']
  updated_by varchar [note: 'Username or identifier of the user who last modified this regulatory requirement record.']
  updated_timestamp timestamp [note: 'Timestamp when this regulatory requirement record was last modified.']
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutation to ensure change']
  vibe_mutation_marker varchar
  vibe_mutation_timestamp timestamp [note: 'Auto‑added by VIBE mutator to register a change']
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']
  created_by varchar [note: 'Username or identifier of the user who created this regulatory requirement record.']

  Note: 'Master list of regulatory requirements applicable to the organization'
}

Table finance.general_ledger {
  general_ledger_id varchar [pk, note: 'Unique identifier for the general ledger']
  chart_of_accounts_id varchar [note: 'Reference to the chart of accounts used by this ledger']
  financial_entity_id varchar [note: 'Legal entity or reporting entity for this ledger']
  parent_general_ledger_id varchar [note: 'Self-reference to parent ledger for hierarchical ledgers']
  primary_superseded_by_general_ledger_id varchar
  accounting_basis varchar [note: 'Accounting basis (Cash, Accrual, Modified Accrual)']
  audit_trail_level varchar [note: 'Level of audit trail detail (Full, Summary, None)']
  budget_control_enabled_flag boolean [note: 'Whether budget control is enabled for this ledger']
  consolidation_group_code varchar [note: 'Consolidation group code for financial reporting']
  cost_center_enabled_flag boolean [note: 'Whether cost center tracking is enabled']
  created_timestamp timestamp [note: 'Timestamp when the ledger was created']
  effective_end_date date [note: 'End date of ledger validity']
  effective_start_date date [note: 'Start date of ledger validity']
  fiscal_year_start_month varchar [note: 'Month number (1-12) when fiscal year starts']
  fiscal_year_variant varchar [note: 'Fiscal year calendar variant code']
  functional_currency_code varchar [note: 'ISO currency code for functional currency']
  general_ledger_description varchar [note: 'Description of the general ledger']
  intercompany_enabled_flag boolean [note: 'Whether intercompany transactions are enabled']
  last_closed_period varchar [note: 'Last fiscal period that was closed']
  last_posting_date date [note: 'Date of last posting to this ledger']
  leading_ledger_flag boolean [note: 'Whether this is the leading ledger for the entity']
  ledger_code varchar [note: 'Short code for the ledger']
  ledger_name varchar [note: 'Name of the ledger']
  ledger_status varchar [note: 'Status of the ledger (Active, Inactive, Closed)']
  ledger_type varchar [note: 'Type of ledger (Primary, Secondary, Reporting, Adjustment)']
  modified_timestamp timestamp [note: 'Timestamp of last modification']
  parallel_accounting_enabled_flag boolean [note: 'Whether parallel accounting is enabled']
  profit_center_enabled_flag boolean [note: 'Whether profit center tracking is enabled']
  project_accounting_enabled_flag boolean [note: 'Whether project accounting is enabled']
  reporting_entity_code varchar [note: 'Code for the reporting entity']
  retention_period_years varchar [note: 'Number of years to retain ledger data']
  segment_reporting_enabled_flag boolean [note: 'Whether segment reporting is enabled']
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutation to ensure change']
  vibe_mutation_marker varchar [note: 'Marker attribute added by VIBE mutator to ensure a change.']
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']

  Note: 'General ledger configuration and metadata for each accounting ledger instance'
}

Table finance.chart_of_accounts {
  chart_of_accounts_id varchar [pk, note: 'Unique identifier for the chart of accounts entry']
  parent_chart_of_accounts_id varchar [note: 'Self-reference to parent account for hierarchical chart of accounts']
  account_category varchar [note: 'High-level category (Asset, Liability, Equity, Revenue, Expense)']
  account_code varchar [note: 'GL account code']
  account_description varchar [note: 'Full description of the account']
  account_name varchar [note: 'Name of the account']
  account_owner varchar [note: 'Owner or responsible party for the account']
  account_status varchar [note: 'Status (Active, Inactive, Closed)']
  account_subcategory varchar [note: 'Subcategory within the main category']
  account_subtype varchar [note: 'Subtype classification']
  account_type varchar [note: 'Type of account (Balance Sheet, Income Statement, Statistical)']
  alternate_account_code varchar [note: 'Alternate or legacy account code']
  approval_required_flag boolean [note: 'Whether postings to this account require approval']
  budget_control_flag boolean [note: 'Whether budget control is enforced for this account']
  consolidation_account_code varchar [note: 'Account code used for consolidation reporting']
  cost_center_applicable_flag boolean [note: 'Whether cost center is required for this account']
  created_timestamp timestamp [note: 'Timestamp when the account was created']
  currency_code varchar [note: 'ISO currency code if account is currency-specific']
  department_applicable_flag boolean [note: 'Whether department is required for this account']
  drg_cost_allocation_flag boolean [note: 'Whether this account is used in DRG cost allocation']
  effective_end_date date [note: 'End date of account validity']
  effective_start_date date [note: 'Start date of account validity']
  external_reporting_code varchar [note: 'Code used for external financial reporting']
  financial_statement_classification varchar [note: 'Classification for financial statement presentation']
  financial_statement_line_item varchar [note: 'Line item on financial statements']
  fund_applicable_flag boolean [note: 'Whether fund is required for this account']
  gaap_classification varchar [note: 'GAAP classification code']
  gasb_classification varchar [note: 'GASB classification code for governmental entities']
  intercompany_flag boolean [note: 'Whether this is an intercompany account']
  modified_timestamp timestamp [note: 'Timestamp of last modification']
  natural_balance decimal [note: 'Natural balance type (Debit=1, Credit=-1) - VREQ-041 corrected from STRING to DECIMAL']
  posting_restriction varchar [note: 'Posting restriction (Manual, Automatic, No Posting)']
  project_applicable_flag boolean [note: 'Whether project is required for this account']
  reconciliation_required_flag boolean [note: 'Whether account requires periodic reconciliation']
  rollup_account_code varchar [note: 'Parent account code for rollup reporting']
  rvu_allocation_flag boolean [note: 'Whether this account is used in RVU-based allocation']
  statistical_account_flag boolean [note: 'Whether this is a statistical (non-monetary) account']
  tax_reporting_category varchar [note: 'Category for tax reporting purposes']
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutation to ensure change']
  vibe_mutation_marker varchar [note: 'Marker added by VIBE mutator']
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']

  Note: 'Chart of accounts master defining all GL account codes and their attributes'
}

Table finance.cost_center {
  cost_center_id varchar [pk, note: 'Unique identifier for the cost center']
  care_site_id varchar [note: 'Physical care site associated with this cost center']
  fund_id varchar [note: 'Fund associated with this cost center']
  general_ledger_chart_of_accounts_id varchar [note: 'Default GL account for this cost center']
  parent_cost_center_id varchar [note: 'Parent cost center for hierarchical rollup']
  budget_amount decimal(18,2) [note: 'Current budget amount for the cost center']
  budget_fiscal_year varchar [note: 'Fiscal year of the budget']
  cms_provider_number varchar [note: 'CMS provider number for cost reporting']
  cost_allocation_method varchar [note: 'Method used for cost allocation (Direct, Step-down, Reciprocal)']
  cost_center_category varchar [note: 'Category (Clinical, Administrative, Support, Revenue)']
  cost_center_code varchar [note: 'Short code for the cost center']
  cost_center_name varchar [note: 'Name of the cost center']
  cost_center_status varchar [note: 'Status (Active, Inactive, Closed)']
  cost_center_type varchar [note: 'Type (Direct Patient Care, Ancillary, Support, Administrative)']
  cost_per_unit decimal(12,2) [note: 'Average cost per unit of service']
  created_timestamp timestamp [note: 'Timestamp when the cost center was created']
  department_code varchar [note: 'Department code']
  department_name varchar [note: 'Department name']
  drg_weight decimal(6,4) [note: 'Average DRG weight for this cost center']
  effective_end_date date [note: 'End date of cost center validity']
  effective_start_date date [note: 'Start date of cost center validity']
  fte_allocation decimal(8,2) [note: 'Full-time equivalent staff allocation']
  is_capital_intensive boolean [note: 'Whether this is a capital-intensive cost center']
  is_direct_patient_care boolean [note: 'Whether this cost center provides direct patient care']
  is_revenue_generating boolean [note: 'Whether this cost center generates revenue']
  last_modified_by varchar [note: 'User who last modified the record']
  last_modified_timestamp timestamp [note: 'Timestamp of last modification']
  notes varchar [note: 'Additional notes']
  regulatory_reporting_required boolean [note: 'Whether regulatory reporting is required']
  rvu_target decimal(12,2) [note: 'Target RVU for the cost center']
  service_line varchar [note: 'Service line (Cardiology, Oncology, etc.)']
  unit_of_measure varchar [note: 'Unit of measure for cost allocation (Visits, Procedures, Days, etc.)']
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutation to ensure change']
  vibe_mutation_marker varchar [note: 'Marker added by VIBE mutator']
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']

  Note: 'Cost center master defining organizational units for cost tracking and allocation'
}

Table finance.journal_entry {
  journal_entry_id varchar [pk, note: 'Unique identifier for the journal entry']
  approver_employee_id varchar [note: 'Employee who approved the journal entry']
  cost_center_id varchar [note: 'Default cost center for the journal entry']
  financial_entity_id varchar [note: 'Financial entity for the journal entry']
  fiscal_period_id varchar [note: 'Fiscal period for the journal entry']
  primary_journal_employee_id varchar [note: 'Employee who created the journal entry']
  primary_reversal_journal_entry_id varchar [note: 'Journal entry that reversed this entry']
  recurring_schedule_id varchar [note: 'Recurring schedule if this is a recurring entry']
  adjustment_type varchar [note: 'Type of adjustment (Accrual, Reclassification, Correction)']
  approval_date date [note: 'Date the journal entry was approved']
  audit_trail_reference varchar [note: 'Reference to audit trail']
  batch_code varchar [note: 'Batch code for grouped entries']
  consolidation_indicator boolean [note: 'Whether this is a consolidation entry']
  created_timestamp timestamp [note: 'Timestamp when the entry was created']
  currency_code varchar [note: 'ISO currency code']
  effective_date date [note: 'Effective date of the journal entry']
  exchange_rate decimal(12,6) [note: 'Exchange rate if foreign currency']
  fiscal_year varchar [note: 'Fiscal year']
  functional_currency_code varchar [note: 'Functional currency code']
  gl_interface_status varchar [note: 'Status of GL interface (Pending, Posted, Error)']
  intercompany_indicator boolean [note: 'Whether this is an intercompany entry']
  journal_category varchar [note: 'Category (Manual, Automatic, Recurring, Adjustment)']
  journal_entry_description varchar [note: 'Description of the journal entry']
  journal_entry_number varchar [note: 'Journal entry number']
  journal_source varchar [note: 'Source system or module']
  modified_timestamp timestamp [note: 'Timestamp of last modification']
  notes varchar [note: 'Additional notes']
  posted_timestamp timestamp [note: 'Timestamp when the entry was posted']
  posting_date date [note: 'Date the entry was posted to GL']
  posting_status varchar [note: 'Status (Draft, Pending, Posted, Reversed)']
  recurring_entry_indicator boolean [note: 'Whether this is a recurring entry']
  regulatory_reporting_indicator boolean [note: 'Whether this entry is for regulatory reporting']
  reversal_date date [note: 'Date the entry was reversed']
  reversal_indicator boolean [note: 'Whether this entry has been reversed']
  reversal_reason_code varchar [note: 'Reason code for reversal']
  source_system_code varchar [note: 'Source system code']
  source_transaction_reference varchar [note: 'Reference to source transaction']
  supporting_document_reference varchar [note: 'Reference to supporting documents']
  total_credit_amount decimal(18,2) [note: 'Total credit amount']
  total_debit_amount decimal(18,2) [note: 'Total debit amount']
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutation to ensure change']
  vibe_mutation_marker varchar [note: 'Marker added by VIBE mutator']
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']

  Note: 'Journal entry header for manual and automated GL postings'
}

Table finance.journal_entry_line {
  journal_entry_line_id varchar [pk, note: 'Unique identifier for the journal entry line']
  chart_of_accounts_id varchar [note: 'GL account for this line']
  cost_center_id varchar [note: 'Cost center for this line']
  drg_id varchar [note: 'DRG code for cost allocation']
  fiscal_period_id varchar [note: 'Fiscal period']
  fund_id varchar [note: 'Fund for this line']
  journal_entry_id varchar [note: 'Parent journal entry']
  primary_journal_employee_id varchar [note: 'Employee who created the line']
  primary_reversed_line_journal_entry_line_id varchar [note: 'Line that was reversed by this line']
  tertiary_journal_approved_by_user_employee_id varchar [note: 'Employee who approved the line']
  approved_timestamp timestamp [note: 'Timestamp when the line was approved']
  created_timestamp timestamp [note: 'Timestamp when the line was created']
  credit_amount decimal(18,2) [note: 'Credit amount']
  debit_amount decimal(18,2) [note: 'Debit amount']
  department_code varchar [note: 'Department code']
  exchange_rate decimal(12,6) [note: 'Exchange rate if foreign currency']
  fiscal_year varchar [note: 'Fiscal year']
  functional_currency_code varchar [note: 'Functional currency code']
  intercompany_entity_code varchar [note: 'Intercompany entity code']
  intercompany_indicator boolean [note: 'Whether this is an intercompany line']
  line_description varchar [note: 'Description of the line']
  line_number varchar [note: 'Line number within the journal entry']
  location_code varchar [note: 'Location code']
  modified_timestamp timestamp [note: 'Timestamp of last modification']
  natural_account_code varchar [note: 'Natural account code']
  payer_code varchar [note: 'Payer code for revenue allocation']
  posting_date date [note: 'Date the line was posted']
  posting_status varchar [note: 'Status (Draft, Pending, Posted, Reversed)']
  program_code varchar [note: 'Program code']
  project_code varchar [note: 'Project code']
  reconciliation_date date [note: 'Date the line was reconciled']
  reconciliation_status varchar [note: 'Reconciliation status']
  reversal_indicator boolean [note: 'Whether this line has been reversed']
  source_document_number varchar [note: 'Source document number']
  source_system_code varchar [note: 'Source system code']
  statistical_amount decimal(18,4) [note: 'Statistical amount for non-monetary accounts']
  statistical_uom varchar [note: 'Unit of measure for statistical amount']
  transaction_amount decimal(18,2) [note: 'Transaction amount in transaction currency']
  transaction_currency_code varchar [note: 'Transaction currency code']
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutation to ensure change']
  vibe_mutation_marker varchar [note: 'Marker added by VIBE mutator']
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']

  Note: 'Journal entry line detail with account, amount, and dimension attributes'
}

Table finance.fiscal_period {
  fiscal_period_id varchar [pk, note: 'Unique identifier for the fiscal period']
  general_ledger_id varchar [note: 'General ledger this period belongs to']
  parent_fiscal_period_id varchar [note: 'Parent fiscal period for hierarchical rollup (VREQ-040 renamed from parent_period_fiscal_period_id for clarity)']
  parent_period_fiscal_period_id varchar [note: 'Parent period for hierarchical periods (e.g., quarter contains months)']
  primary_prior_period_fiscal_period_id varchar [note: 'Prior period for period-over-period comparisons']
  adjustment_period_flag boolean [note: 'Whether this is an adjustment period (e.g., period 13)']
  budget_period_flag boolean [note: 'Whether this period is used for budgeting']
  business_days_in_period varchar [note: 'Number of business days in the period']
  calendar_month varchar [note: 'Calendar month (1-12)']
  calendar_quarter varchar [note: 'Calendar quarter (1-4)']
  calendar_year varchar [note: 'Calendar year']
  close_approved_by varchar [note: 'User who approved the period close']
  close_date date [note: 'Date the period was closed']
  close_initiated_by varchar [note: 'User who initiated the period close']
  cms_reporting_period_flag boolean [note: 'Whether this is a CMS reporting period']
  created_timestamp timestamp [note: 'Timestamp when the period was created']
  days_in_period varchar [note: 'Total number of days in the period']
  end_date date [note: 'End date of the period']
  fiscal_period_description varchar [note: 'Description of the fiscal period']
  fiscal_year varchar [note: 'Fiscal year']
  period_end_close_checklist_complete_flag boolean [note: 'Whether the period-end close checklist is complete']
  period_name varchar [note: 'Name of the period']
  period_number varchar [note: 'Period number within the fiscal year']
  period_status varchar [note: 'Status (Open, Closed, Permanently Closed)']
  period_type varchar [note: 'Type (Month, Quarter, Year, Adjustment)']
  permanent_close_date date [note: 'Date the period was permanently closed']
  quarter_number varchar [note: 'Quarter number (1-4)']
  reopen_date date [note: 'Date the period was reopened']
  reporting_period_flag boolean [note: 'Whether this is a reporting period']
  start_date date [note: 'Start date of the period']
  updated_timestamp timestamp [note: 'Timestamp of last update']
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutation to ensure change']
  vibe_mutation_marker varchar [note: 'Marker added by VIBE mutator']
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']

  Note: 'Fiscal period master defining accounting periods and their status'
}

Table finance.budget {
  budget_id varchar [pk, note: 'Unique identifier for the budget']
  approver_employee_id varchar [note: 'Employee who approved the budget']
  care_site_id varchar [note: 'Care site for the budget']
  cost_center_id varchar [note: 'Cost center for the budget']
  financial_entity_id varchar [note: 'Financial entity for the budget']
  fte_budget_id varchar [note: 'Associated FTE budget']
  org_unit_id varchar [note: 'Organizational unit for the budget']
  parent_budget_id varchar [note: 'Parent budget for hierarchical budgets']
  position_id varchar [note: 'Position for position-level budgets']
  primary_budget_employee_id varchar [note: 'Employee who owns the budget']
  primary_prior_budget_id varchar [note: 'Prior year budget for comparison']
  approval_date date [note: 'Date the budget was approved']
  assumptions varchar [note: 'Budget assumptions and methodology']
  budget_category varchar [note: 'Category (Operating, Capital, Research)']
  budget_name varchar [note: 'Name of the budget']
  budget_number varchar [note: 'Budget number']
  budget_status varchar [note: 'Status (Draft, Submitted, Approved, Active, Closed)']
  budget_type varchar [note: 'Type (Annual, Quarterly, Project, Grant)']
  budgeted_cmi decimal(5,4) [note: 'Budgeted case mix index']
  budgeted_fte_count decimal(10,2) [note: 'Budgeted full-time equivalent count']
  budgeted_net_income decimal(18,2) [note: 'Budgeted net income']
  budgeted_patient_volume varchar [note: 'Budgeted patient volume']
  created_timestamp timestamp [note: 'Timestamp when the budget was created']
  currency_code varchar [note: 'ISO currency code']
  effective_end_date date [note: 'End date of budget validity']
  effective_start_date date [note: 'Start date of budget validity']
  fiscal_year varchar [note: 'Fiscal year']
  funding_source varchar [note: 'Funding source (Operating, Grant, Donation, Bond)']
  grant_number varchar [note: 'Grant number if grant-funded']
  is_baseline_budget boolean [note: 'Whether this is the baseline budget']
  last_modified_timestamp timestamp [note: 'Timestamp of last modification']
  methodology varchar [note: 'Budgeting methodology (Zero-based, Incremental, Activity-based)']
  narrative varchar [note: 'Budget narrative and justification']
  notes varchar [note: 'Additional notes']
  submission_date date [note: 'Date the budget was submitted']
  total_budgeted_capital decimal(18,2) [note: 'Total budgeted capital expenditures']
  total_budgeted_expense decimal(18,2) [note: 'Total budgeted expenses']
  total_budgeted_revenue decimal(18,2) [note: 'Total budgeted revenue']
  variance_threshold_percent decimal(5,2) [note: 'Variance threshold percentage for alerts']
  version varchar [note: 'Budget version (Original, Revised, Final)']
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutation to ensure change']
  vibe_mutation_marker varchar [note: 'Marker added by VIBE mutator']
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']

  Note: 'Budget header defining budget versions, scenarios, and metadata'
}

Table finance.budget_line {
  budget_line_id varchar [pk, note: 'Unique identifier for the budget line']
  budget_id varchar [note: 'Parent budget']
  chart_of_accounts_id varchar [note: 'GL account for this budget line']
  cost_center_id varchar [note: 'Cost center for this budget line']
  fund_id varchar [note: 'Fund for this budget line']
  parent_budget_line_id varchar [note: 'Parent budget line for hierarchical budgets']
  allocation_method varchar [note: 'Method for allocating budget (Equal, Weighted, Historical)']
  allocation_percentage decimal(5,2) [note: 'Allocation percentage']
  approval_status varchar [note: 'Approval status (Pending, Approved, Rejected)']
  approved_by varchar [note: 'User who approved the line']
  approved_date date [note: 'Date the line was approved']
  budgeted_amount decimal(18,2) [note: 'Budgeted amount']
  created_timestamp timestamp [note: 'Timestamp when the line was created']
  currency_code varchar [note: 'ISO currency code']
  effective_end_date date [note: 'End date of line validity']
  effective_start_date date [note: 'Start date of line validity']
  fiscal_period varchar [note: 'Fiscal period']
  fiscal_year varchar [note: 'Fiscal year']
  fte_count decimal(8,2) [note: 'FTE count for this line']
  is_capital boolean [note: 'Whether this is a capital budget line']
  is_restricted boolean [note: 'Whether this is a restricted fund line']
  line_notes varchar [note: 'Notes for this line']
  line_number varchar [note: 'Line number within the budget']
  modified_by varchar [note: 'User who last modified the line']
  modified_timestamp timestamp [note: 'Timestamp of last modification']
  prior_year_actual decimal(18,2) [note: 'Prior year actual amount']
  service_line_code varchar [note: 'Service line code']
  statistical_basis varchar [note: 'Statistical basis for budget (Visits, Days, Procedures)']
  variance_threshold_percent decimal(5,2) [note: 'Variance threshold percentage']
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutation to ensure change']
  vibe_mutation_marker varchar [note: 'Marker added by VIBE mutator']
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']
  volume_assumption decimal(12,2) [note: 'Volume assumption']
  volume_unit varchar [note: 'Unit of measure for volume']
  created_by varchar [note: 'User who created the line']

  Note: 'Budget line detail with account, amount, and allocation attributes'
}

Table finance.budget_transfer {
  budget_transfer_id varchar [pk, note: 'Unique identifier for the budget transfer transaction. Primary key for the budget transfer record.']
  approver_employee_id varchar [note: 'Identifier of the employee who approved the budget transfer. Links to the employee master data for authorization tracking and compliance.']
  budget_employee_id varchar [note: 'System user identifier of the person who created this budget transfer record in the system. Part of standard audit trail.']
  budget_modified_by_user_employee_id varchar [note: 'System user identifier of the person who last modified this budget transfer record. Part of standard audit trail for accountability.']
  destination_budget_line_id varchar [note: 'Identifier of the specific budget line item to which funds are being transferred. Links to the budget line master data.']
  destination_cost_center_id varchar [note: 'Identifier of the cost center, department, or organizational unit to which budget funds are being transferred. Links to the cost center master data.']
  destination_gl_account_chart_of_accounts_id varchar [note: 'Identifier of the general ledger account to which budget funds are being transferred. Links to the chart of accounts.']
  journal_entry_id varchar [note: 'Identifier of the general ledger journal entry that recorded this budget transfer in the financial system. Links to the journal entry master data for financial reconciliation.']
  primary_budget_chart_of_accounts_id varchar [note: 'Identifier of the general ledger account from which budget funds are being transferred. Links to the chart of accounts.']
  primary_budget_requestor_employee_id varchar [note: 'Identifier of the employee who initiated or requested the budget transfer. Links to the employee master data for accountability tracking.']
  primary_original_transfer_budget_transfer_id varchar [note: 'If this transfer is a reversal or correction of a previous transfer, this field contains the budget_transfer_id of the original transfer being reversed. Null for original transfers.']
  source_budget_line_id varchar [note: 'Identifier of the specific budget line item from which funds are being transferred. Links to the budget line master data.']
  source_cost_center_id varchar [note: 'Identifier of the cost center, department, or organizational unit from which budget funds are being transferred. Links to the cost center master data.']
  approval_date date [note: 'The date when the budget transfer was formally approved by the authorized approver. Null if transfer is not yet approved.']
  approval_level varchar [note: 'The organizational level at which the budget transfer was approved, indicating the authority level required based on transfer amount and type: department_manager, director, vice_president, chief_financial_officer (CFO), or board_of_directors.']
  approver_name varchar [note: 'Full name of the employee who approved the budget transfer, captured for audit trail and accountability.']
  audit_trail_reference varchar [note: 'Reference identifier to the complete audit trail or change log for this budget transfer, linking to detailed history of all modifications and approvals.']
  batch_code varchar [note: 'Identifier for a batch or group of related budget transfers processed together, typically used for mass budget adjustments or year-end reallocations.']
  comments varchar [note: 'Additional free-text comments, notes, or context about the budget transfer that do not fit in other structured fields. Used for collaboration and documentation.']
  compliance_flag boolean [note: 'Boolean indicator of whether this budget transfer complies with all applicable financial policies, regulatory requirements, and budget constraints. True if compliant, False if exceptions exist.']
  compliance_notes varchar [note: 'Free-text notes documenting compliance review findings, exceptions, or special considerations related to regulatory or policy requirements.']
  created_timestamp timestamp [note: 'System timestamp when this budget transfer record was first created in the database. Part of standard audit trail for data lineage.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the transfer amount (e.g., USD, EUR, GBP). Required for multi-currency healthcare systems.']
  effective_date date [note: 'The date when the budget transfer becomes binding and the budget changes take effect in the financial system. May differ from transfer_date for future-dated transfers.']
  fiscal_period varchar [note: 'The fiscal period (month or quarter) within the fiscal year to which this transfer applies, typically 1-12 for monthly periods or 1-4 for quarterly periods.']
  fiscal_year varchar [note: 'The fiscal year to which this budget transfer applies, typically a four-digit year (e.g., 2024). Critical for period-based budget management and year-end reconciliation.']
  modified_timestamp timestamp [note: 'System timestamp when this budget transfer record was last modified in the database. Part of standard audit trail for change tracking.']
  requestor_department varchar [note: 'Name of the department or organizational unit of the employee who requested the transfer, for organizational analysis and reporting.']
  requestor_name varchar [note: 'Full name of the employee who requested the budget transfer, captured for audit trail and reporting purposes.']
  reversal_date date [note: 'The date when this budget transfer was reversed or undone. Null if the transfer has not been reversed.']
  reversal_flag boolean [note: 'Boolean indicator of whether this budget transfer has been reversed or undone. True if reversed, False if still in effect.']
  reversal_reason varchar [note: 'Narrative explanation of why the budget transfer was reversed, including business justification and corrective action taken.']
  supporting_document_reference varchar [note: 'Reference identifier or URI to supporting documentation for the budget transfer (e.g., memo, business case, board resolution, email approval). Critical for audit trail and compliance.']
  transfer_amount decimal(18,2) [note: 'The monetary value being transferred from the source budget line to the destination budget line. Always positive; direction is indicated by source/destination fields.']
  transfer_date date [note: 'The business date when the budget transfer was initiated or became effective. This is the principal business event timestamp for the transaction, distinct from audit timestamps.']
  transfer_number varchar [note: 'Externally-visible unique business identifier for the budget transfer, typically formatted as BT-YYYYNNNN for tracking and audit purposes.']
  transfer_reason_code varchar [note: 'Standardized code indicating the primary business reason for the budget transfer: operational_need (operational requirements changed), cost_overrun (original budget insufficient), revenue_shortfall (revenue below projections), strategic_priority (strategic initiative funding), regulatory_requirement (compliance mandate), or emergency_response (urgent unplanned need).']
  transfer_reason_description varchar [note: 'Detailed narrative explanation of the business justification for the budget transfer, including context, impact, and supporting rationale. Critical for audit trail and management review.']
  transfer_status varchar [note: 'Current lifecycle state of the budget transfer: draft (being prepared), pending_approval (submitted for review), approved (authorized to proceed), rejected (denied), in_progress (being executed), completed (fully processed), cancelled (withdrawn before completion), or reversed (undone after completion). [ENUM-REF-CANDIDATE: draft|pending_approval|approved|rejected|in_progress|completed|cancelled|reversed — 8 candidates stripped; promote to reference product]']
  transfer_type varchar [note: 'Classification of the budget modification: budget amendment (formal change to approved budget), budget transfer (movement between cost centers), budget revision (adjustment to budget assumptions), budget reallocation (redistribution within same department), supplemental appropriation (additional funding), or technical adjustment (correction without policy change).']
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutation to ensure change']
  vibe_mutation_marker varchar [note: 'Marker added by VIBE mutator']
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']

  Note: 'Transactional record of approved budget transfers and amendments between cost centers, accounts, or periods within an approved budget. Captures transfer date, transfer type (budget amendment, budget transfer, budget revision), source budget line, destination budget line, transfer amount, transfer reason, requestor, approver, approval date, and supporting documentation reference. Maintains a complete audit trail of all budget modifications post-approval.'
}

Table finance.ap_invoice {
  ap_invoice_id varchar [pk, note: 'Unique identifier for the accounts payable invoice record. Primary key.']
  care_site_id varchar [note: 'Identifier of the healthcare facility or location to which this invoice is allocated.']
  cost_center_id varchar [note: 'FK to finance.cost_center']
  credited_ap_invoice_id varchar [note: 'Self-referencing FK on ap_invoice (credited_ap_invoice_id)']
  fiscal_period_id varchar [note: 'Foreign key linking to finance.fiscal_period. Business justification: Invoices must be assigned to fiscal periods for accrual accounting, expense recognition timing, period-end close, and financial statement accuracy. Complements gl_date with structured period assignmen']
  org_unit_id varchar [note: 'Identifier of the department that is responsible for this invoice expense.']
  primary_ap_employee_id varchar [note: 'Identifier of the employee who approved this invoice for payment.']
  requester_employee_id varchar [note: 'Identifier of the employee who requested the goods or services that resulted in this invoice.']
  vendor_id varchar [note: 'Identifier of the vendor who issued this invoice. Links to the vendor master record.']
  vendor_site_id varchar [note: 'Identifier of the specific vendor site or remit-to location associated with this invoice.']
  ap_invoice_description varchar [note: 'A free-text description of the goods or services covered by this invoice.']
  approval_date date [note: 'The date the invoice was approved for payment.']
  approval_status varchar [note: 'The current status of the invoice in the approval workflow: pending (awaiting approval), approved (authorized for payment), rejected (returned to requester), or escalated (sent to higher authority).']
  created_timestamp timestamp [note: 'The date and time when this invoice record was first created in the accounts payable system.']
  discount_amount decimal(18,2) [note: 'The total discount amount applied to the invoice (early payment discounts, volume discounts, or negotiated price reductions).']
  due_date date [note: 'The date by which payment is due to the vendor per the payment terms.']
  exchange_rate decimal(12,6) [note: 'The currency exchange rate used to convert the invoice amount from the invoice currency to the organization\'s functional currency, if applicable.']
  freight_amount decimal(18,2) [note: 'The shipping and freight charges included in the invoice.']
  functional_currency_amount decimal(18,2) [note: 'The total invoice amount converted to the organization\'s functional currency using the exchange rate, for consolidated financial reporting.']
  gl_account_code varchar [note: 'The general ledger account code to which this invoice is posted in the chart of accounts.']
  gl_date date [note: 'The accounting period date when this invoice is posted to the general ledger.']
  hold_date date [note: 'The date the invoice was placed on hold.']
  hold_reason_code varchar [note: 'The code indicating why the invoice is on hold (e.g., pricing variance, missing receipt, duplicate invoice, vendor on hold, budget exceeded).']
  hold_released_date date [note: 'The date the hold was released and the invoice was returned to normal processing.']
  invoice_amount decimal(18,2) [note: 'The gross total amount of the invoice before taxes and freight, representing the base charge for goods or services.']
  invoice_currency_code varchar [note: 'The three-letter ISO 4217 currency code in which the invoice is denominated (e.g., USD, EUR, GBP).']
  invoice_date date [note: 'The date the vendor issued the invoice. This is the principal business event timestamp for the invoice transaction.']
  invoice_number varchar [note: 'The externally-known vendor-assigned invoice number that uniquely identifies this invoice in the vendor\'s system and on the physical/electronic invoice document.']
  invoice_source varchar [note: 'The channel through which the invoice was received: manual_entry (keyed by AP clerk), edi (Electronic Data Interchange), email (scanned attachment), ocr (Optical Character Recognition from paper), supplier_portal (vendor self-service portal), or api (system-to-system integration).']
  invoice_status varchar [note: 'The current lifecycle status of the invoice in the accounts payable workflow: received (entered into system), validated (passed data quality checks), matched (matched to PO and receipt), approved (approved for payment), on_hold (payment hold applied), scheduled_for_payment (queued for payment run), paid (payment issued), cancelled (invoice voided), or rejected (invoice returned to vendor). [ENUM-REF-CANDIDATE: received|validated|matched|approved|on_hold|scheduled_for_payment|paid|cancelled|rejected — 9 candidates stripped; promote to reference product]']
  invoice_type varchar [note: 'The classification of the invoice transaction: standard invoice for goods/services, credit memo for returns/adjustments, debit memo for additional charges, prepayment for advance payments, expense report for employee reimbursements, or recurring for subscription-based invoices.']
  payment_method varchar [note: 'The payment instrument used to pay this invoice: check (paper check), ach (Automated Clearing House), wire_transfer (bank wire), eft (Electronic Funds Transfer), credit_card (corporate card), or virtual_card (single-use virtual card).']
  payment_reference_number varchar [note: 'The check number, ACH trace number, wire confirmation number, or other payment transaction identifier.']
  payment_terms varchar [note: 'The payment terms agreed with the vendor (e.g., Net 30, Net 60, 2/10 Net 30) that define the due date and any early payment discounts.']
  po_match_indicator boolean [note: 'Boolean flag indicating whether this invoice has been matched to a purchase order (True) or is a non-PO invoice (False).']
  po_number varchar [note: 'The purchase order number that this invoice is matched against, if applicable. Used for three-way matching (PO, receipt, invoice).']
  received_date date [note: 'The date the healthcare organization received the invoice from the vendor.']
  tax_amount decimal(18,2) [note: 'The total tax amount charged on the invoice (sales tax, VAT, GST, or other applicable taxes).']
  tax_code varchar [note: 'The tax jurisdiction or tax rate code applied to this invoice for sales tax, VAT, or GST calculation.']
  three_way_match_status varchar [note: 'The status of the three-way match process (PO, receipt, invoice): not_applicable (non-PO invoice), pending (match in progress), matched (all three documents reconciled), variance (discrepancies identified within tolerance), or failed (discrepancies exceed tolerance).']
  total_amount decimal(18,2) [note: 'The net total amount payable to the vendor, calculated as invoice_amount + tax_amount + freight_amount - discount_amount.']
  updated_timestamp timestamp [note: 'The date and time when this invoice record was last modified in the accounts payable system.']
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutation to ensure change']
  vibe_mutation_marker varchar [note: 'Marker added by VIBE mutator to indicate change']
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']
  voucher_number varchar [note: 'The internal accounting voucher number assigned to this invoice for general ledger posting and audit trail purposes.']

  Note: 'Core accounts payable invoice record representing a vendor invoice received by the healthcare organization for goods or services. Captures invoice number, vendor ID, vendor name, invoice date, received date, due date, payment terms, invoice type (standard, credit memo, debit memo, prepayment), invoice currency, invoice amount, tax amount, freight amount, invoice status (received, matched, approved, on hold, paid, cancelled), PO match indicator, three-way match status, cost center, GL account, and approval workflow status. SSOT for all vendor payables.'
}

Table finance.ap_invoice_line {
  ap_invoice_line_id varchar [pk, note: 'Unique identifier for the accounts payable invoice line item. Primary key for this entity.']
  ap_invoice_id varchar [note: 'Reference to the parent accounts payable invoice header. Links this line item to its parent invoice document.']
  approver_employee_id varchar [note: 'Employee identifier of the manager or authorized approver who approved this line item for payment. Supports audit trail and segregation of duties.']
  chart_of_accounts_id varchar [note: 'Foreign key linking to finance.chart_of_accounts. Business justification: ap_invoice_line has gl_account_code (STRING) which should be normalized to FK to chart_of_accounts. Enables joining to get account metadata and ensures invoice lines reference valid GL accounts for ex']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: ap_invoice_line has cost_center_code (STRING) which should be normalized to FK to cost_center master. Enables joining to get cost center details for expense allocation and ensures referential integrit']
  credited_ap_invoice_line_id varchar [note: 'Self-referencing FK on ap_invoice_line (credited_ap_invoice_line_id)']
  fund_id varchar [note: 'Foreign key linking to finance.fund. Business justification: ap_invoice_line has fund_code (STRING) which should be normalized to FK to fund master. Enables joining to get fund details for restricted fund accounting and ensures invoice lines reference valid fun']
  goods_receipt_id varchar [note: 'Foreign key linking to supply.goods_receipt. Business justification: Invoice lines link to goods receipt for three-way match completion, quantity/quality verification, and received-not-invoiced accrual reconciliation. Required for accurate period-end accruals and AP au']
  purchase_order_line_id varchar [note: 'Foreign key linking to supply.purchase_order_line. Business justification: Invoice lines must link to PO lines for three-way match validation (PO-receipt-invoice), price variance analysis, and automated GL account inheritance from PO. Core AP matching process.']
  requester_employee_id varchar [note: 'Employee identifier of the person who requested or authorized this purchase. Supports accountability and spend analysis by requester.']
  asset_category varchar [note: 'Asset category or class for capital items. Determines depreciation method, useful life, and financial statement classification for capitalized purchases.']
  asset_flag boolean [note: 'Indicates whether this line item represents a capital asset purchase that should be capitalized rather than expensed. Triggers asset tracking and depreciation processes.']
  contract_number varchar [note: 'Vendor contract or agreement number governing the pricing and terms for this line item. Links the invoice to negotiated contract terms for compliance verification.']
  created_timestamp timestamp [note: 'Date and time when this invoice line record was first created in the system. Supports audit trail and data lineage tracking.']
  discount_amount decimal(18,2) [note: 'Discount amount applied to this line item. May represent volume discounts, promotional discounts, or negotiated contract pricing adjustments.']
  distribution_date date [note: 'Date when this line item was distributed and posted to the general ledger. Determines the accounting period in which the expense is recognized.']
  distribution_status varchar [note: 'Status of general ledger distribution for this line item. Indicates whether the expense has been posted to the general ledger and financial statements.']
  hold_flag boolean [note: 'Indicates whether this line item is on hold and blocked from payment. Used to prevent payment pending resolution of issues or additional approvals.']
  hold_reason varchar [note: 'Reason code or description explaining why this line item is on hold. Documents the issue preventing payment and guides resolution activities.']
  item_code varchar [note: 'Vendor or internal catalog item code identifying the specific product or service being purchased. Used for inventory tracking and spend analysis.']
  line_amount decimal(18,2) [note: 'Total amount for this line item before taxes and adjustments. Typically calculated as quantity multiplied by unit price.']
  line_description varchar [note: 'Detailed textual description of the goods or services being billed on this line. Provides context for the charge and supports audit and reconciliation activities.']
  line_number varchar [note: 'Sequential line number within the invoice. Determines the ordering and display sequence of line items on the invoice.']
  line_status varchar [note: 'Current processing status of this invoice line item. Tracks the line through the approval, matching, and payment workflow.']
  location_code varchar [note: 'Facility or location code where this expense will be utilized or allocated. Supports multi-site cost allocation and facility-level financial reporting.']
  match_exception_reason varchar [note: 'Reason code or description for match exceptions or variances. Documents why the invoice line does not match the PO or receipt (e.g., price variance, quantity variance).']
  match_status varchar [note: 'Status of three-way matching (PO-receipt-invoice) for this line item. Indicates whether the invoice line has been successfully matched to purchase order and goods receipt.']
  modified_timestamp timestamp [note: 'Date and time when this invoice line record was last modified. Tracks the most recent update to support change tracking and audit requirements.']
  notes varchar [note: 'Free-form notes or comments about this line item. Captures additional context, special instructions, or explanations for unusual transactions.']
  program_code varchar [note: 'Program or service line code for this expense. Used to allocate costs to specific clinical programs or service lines for profitability analysis.']
  project_code varchar [note: 'Project or capital initiative code if this line item is associated with a specific project. Enables project-based cost tracking and capital budgeting.']
  quantity decimal(18,4) [note: 'Quantity of items or units of service being billed on this line. Used in conjunction with unit price to calculate line amount.']
  service_period_end_date date [note: 'End date of the service period covered by this line item. Used with start date to determine expense allocation across accounting periods for prepaid services.']
  service_period_start_date date [note: 'Start date of the service period covered by this line item. Used for service-based invoices to determine the period of benefit and expense recognition timing.']
  tax_amount decimal(18,2) [note: 'Total tax amount applied to this line item. Includes sales tax, use tax, VAT, or other applicable taxes based on jurisdiction and item taxability.']
  tax_code varchar [note: 'Tax classification code determining the tax treatment and rate for this line item. Used to calculate applicable taxes based on jurisdiction and item type.']
  total_line_amount decimal(18,2) [note: 'Final total amount for this line item including taxes and discounts. Represents the net amount payable to the vendor for this line.']
  unit_of_measure varchar [note: 'Unit of measure for the quantity field. Defines how the quantity is counted or measured (e.g., each, box, hour, kilogram). [ENUM-REF-CANDIDATE: each|box|case|unit|hour|day|month|kg|lb|liter|gallon — 11 candidates stripped; promote to reference product]']
  unit_price decimal(18,4) [note: 'Price per unit of measure for this line item. Multiplied by quantity to derive the line amount before taxes and adjustments.']
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutation to ensure change']
  vibe_mutation_marker varchar [note: 'Marker added by VIBE mutator to indicate change']
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']

  Note: 'Individual line-item detail on an accounts payable invoice, representing a single billable item from a vendor. Captures AP invoice reference, line number, item description, quantity, unit of measure, unit price, line amount, GL account code, cost center, fund, project, tax code, PO line reference, goods receipt reference, match status, and distribution status. Enables granular cost allocation and three-way matching (PO-receipt-invoice) for healthcare supply and service procurement.'
}

Table finance.ap_payment {
  ap_payment_id varchar [pk, note: 'Unique identifier for the accounts payable payment transaction. Primary key.']
  chart_of_accounts_id varchar [note: 'Foreign key linking to finance.chart_of_accounts. Business justification: ap_payment has gl_account_code (STRING) which should be normalized to FK to chart_of_accounts. Enables joining to get account metadata for the cash/clearing account used in payment posting.']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: ap_payment has cost_center_code (STRING) which should be normalized to FK to cost_center master. Enables joining to get cost center details for payment allocation tracking.']
  fiscal_period_id varchar [note: 'Foreign key linking to finance.fiscal_period. Business justification: ap_payment has fiscal_period (INT) which should be normalized to FK to fiscal_period master. Enables joining to get period details and ensures payments reference valid fiscal periods. Note: fiscal_yea']
  payment_batch_id varchar [note: 'Identifier of the payment batch or payment run in which this payment was processed. Used for grouping payments processed together.']
  primary_ap_employee_id varchar [note: 'Identifier of the user who approved this payment for disbursement. Links to user or employee master. Null if not yet approved.']
  primary_ap_vendor_bank_account_id varchar [note: 'Identifier of the vendor bank account to which this payment was sent. Links to vendor banking information.']
  tertiary_ap_modified_by_user_employee_id varchar [note: 'Identifier of the user who last modified this payment record. Links to user or employee master. Audit trail field.']
  vendor_id varchar [note: 'Identifier of the vendor or supplier receiving this payment. Links to the vendor master record.']
  voided_ap_payment_id varchar [note: 'Self-referencing FK on ap_payment (voided_ap_payment_id)']
  ach_trace_number varchar [note: 'ACH trace number assigned by the bank for ACH/EFT payments. Used for tracking and reconciliation. Null for non-ACH payment methods.']
  approval_status varchar [note: 'Approval workflow status for the payment. Values: pending (awaiting approval), approved (authorized for disbursement), rejected (approval denied).']
  approved_timestamp timestamp [note: 'Date and time when the payment was approved for disbursement. Null if not yet approved.']
  check_number varchar [note: 'Physical check number if payment method is check. Null for electronic payment methods.']
  cleared_date date [note: 'Date on which the payment cleared the bank and funds were successfully transferred to the vendor. Null if payment has not yet cleared.']
  created_timestamp timestamp [note: 'Date and time when this payment record was first created in the system. Audit trail field.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the payment amount (e.g., USD, EUR, GBP).']
  discount_taken_amount decimal(18,2) [note: 'Total early payment discount amount taken on this payment if vendor offered discount terms (e.g., 2% discount for payment within 10 days).']
  exchange_rate decimal(18,6) [note: 'Exchange rate applied if the payment was made in a foreign currency. Rate used to convert payment amount to the organization\'s functional currency.']
  fiscal_year varchar [note: 'Fiscal year in which the payment was issued, based on the organization\'s fiscal calendar.']
  functional_currency_amount decimal(18,2) [note: 'Payment amount converted to the organization\'s functional currency (typically USD for US-based healthcare organizations) using the exchange rate.']
  modified_timestamp timestamp [note: 'Date and time when this payment record was last modified. Audit trail field.']
  payment_amount decimal(18,2) [note: 'Total monetary amount disbursed in this payment transaction, in the payment currency.']
  payment_date date [note: 'Date on which the payment was issued or disbursed to the vendor. Principal business event timestamp for the payment transaction.']
  payment_description varchar [note: 'Free-text description or memo field providing additional context about the payment purpose or contents.']
  payment_method varchar [note: 'Method or instrument used to disburse the payment. Common values: check (paper check), ach (Automated Clearing House), eft (Electronic Funds Transfer), wire_transfer, virtual_card, cash.']
  payment_number varchar [note: 'Business-facing unique payment identifier or check number assigned by the financial system. Used for external reference and reconciliation.']
  payment_priority varchar [note: 'Priority level assigned to the payment for processing. Values: standard (normal processing), urgent (high priority), expedited (rush processing).']
  payment_reconciliation_status varchar [note: 'Bank reconciliation status of the payment. Values: unreconciled (not yet matched to bank statement), reconciled (matched and cleared), exception (discrepancy identified).']
  payment_source_system varchar [note: 'Name or identifier of the source financial system that originated this payment record (e.g., SAP S/4HANA FI, Epic Resolute PB).']
  payment_status varchar [note: 'Current lifecycle status of the payment. Values: issued (payment created and sent), cleared (payment successfully processed by bank), voided (payment cancelled before clearing), stopped (stop payment placed), cancelled (payment cancelled), pending (awaiting approval or processing).']
  payment_terms varchar [note: 'Payment terms applicable to this payment (e.g., Net 30, 2/10 Net 30). Reflects the terms under which the vendor invoices were paid.']
  payment_type varchar [note: 'Classification of the payment transaction type. Values: invoice_payment (standard vendor invoice payment), prepayment (advance payment), refund (return of funds), expense_reimbursement (employee expense reimbursement).']
  reconciled_date date [note: 'Date on which the payment was reconciled against the bank statement. Null if not yet reconciled.']
  remittance_advice_reference varchar [note: 'Reference number or identifier for the remittance advice document sent to the vendor detailing which invoices this payment settles.']
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutation to ensure change']
  vibe_mutation_marker varchar [note: 'Marker added by VIBE mutator']
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']
  void_date date [note: 'Date on which the payment was voided or cancelled. Null if payment has not been voided.']
  void_reason varchar [note: 'Business reason or explanation for why the payment was voided. Null if payment has not been voided.']
  wire_confirmation_number varchar [note: 'Bank confirmation or reference number for wire transfer payments. Null for non-wire payment methods.']

  Note: 'Transactional record of every payment disbursed to a vendor through the accounts payable process. Captures payment number, payment date, payment method (check, ACH/EFT, wire transfer, virtual card), vendor ID, vendor bank account, payment amount, currency, exchange rate, payment status (issued, cleared, voided, stopped), void date, void reason, bank account debited, check number (if applicable), remittance advice reference, and associated AP invoices settled. SSOT for all vendor disbursements.'
}

Table finance.ar_account {
  ar_account_id varchar [pk, note: 'Unique identifier for the accounts receivable account. Primary key for non-patient-billing receivables including grants, rental income, intercompany receivables, and physician practice management fees.']
  chart_of_accounts_id varchar [note: 'Foreign key linking to finance.chart_of_accounts. Business justification: ar_account has gl_account_code (STRING) which should be normalized to FK to chart_of_accounts. Enables joining to get account metadata for the receivable GL account.']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: ar_account has cost_center_code (STRING) which should be normalized to FK to cost_center master. Enables joining to get cost center details for receivable tracking by department/service line.']
  parent_ar_account_id varchar [note: 'Self-referencing FK on ar_account (parent_ar_account_id)']
  primary_ar_employee_id varchar [note: 'Identifier of the internal staff member or external collection agency assigned to manage collection activities for this account. Used for workload distribution, performance tracking, and accountability.']
  tertiary_ar_last_modified_by_user_employee_id varchar [note: 'The system user identifier of the person or process that most recently modified this AR account record. Used for accountability, audit trail, and change management.']
  account_number varchar [note: 'The externally-known unique account number assigned to this receivable account. Used for identification in financial systems and external communications with debtors.']
  account_status varchar [note: 'Current lifecycle status of the receivable account. Open indicates active receivable with expected payment; closed indicates fully paid or resolved; written_off indicates uncollectible and removed from active AR; in_collections indicates transferred to internal or external collections; disputed indicates debtor has contested the amount; on_hold indicates temporarily suspended collection activity; pending_resolution indicates awaiting internal review or decision. [ENUM-REF-CANDIDATE: open|closed|written_off|in_collections|disputed|on_hold|pending_resolution — 7 candidates stripped; promote to reference product]']
  account_type varchar [note: 'Classification of the receivable account indicating the nature of the financial relationship. Distinguishes between payer receivables, self-pay patient receivables, intercompany transactions, grant funding, physician practice management fees, rental income, and other non-RCM receivables. Note: This is for non-patient-billing AR; patient billing AR is managed in billing.patient_account. [ENUM-REF-CANDIDATE: payer|self_pay|intercompany|grant|physician_practice_management|rental_income|other — 7 candidates stripped; promote to reference product]']
  aging_bucket varchar [note: 'Categorization of the receivable based on the number of days outstanding since the original invoice or billing date. Used for aging analysis, collection prioritization, and allowance for doubtful accounts estimation. Current indicates not yet due; subsequent buckets indicate days past due.']
  collection_agency_name varchar [note: 'Name of the external third-party collection agency to which this account has been referred, if applicable. Null if account is managed internally or not yet in collections.']
  created_timestamp timestamp [note: 'The date and time when this AR account record was first created in the system. Used for audit trail, data lineage, and account lifecycle tracking.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code indicating the currency denomination of all monetary amounts on this account. Defaults to USD for domestic operations; supports multi-currency for international grants or intercompany receivables.']
  current_balance decimal(18,2) [note: 'The outstanding receivable balance as of the current date. Reflects original balance minus payments received, plus any adjustments, interest, or fees. This is the amount currently owed. Denominated in USD unless otherwise specified in currency_code.']
  days_outstanding varchar [note: 'The number of calendar days that have elapsed since the original invoice or billing date. Used to calculate aging bucket and assess collection risk. Key metric for Days Sales Outstanding (DSO) reporting.']
  debtor_name varchar [note: 'The legal or business name of the entity or individual that owes payment on this receivable account. May be a payer organization, self-pay patient, affiliated entity, grantor, or other debtor.']
  debtor_type varchar [note: 'Categorical classification of the debtor entity. Segments debtors into commercial insurance payers, government payers (Medicare, Medicaid), self-pay individuals, affiliated healthcare entities, grant-making organizations, corporate tenants, and other categories for reporting and collection strategy purposes. [ENUM-REF-CANDIDATE: commercial_payer|government_payer|self_pay_individual|affiliated_entity|grant_organization|corporate_tenant|other — 7 candidates stripped; promote to reference product]']
  dispute_date date [note: 'The date on which the debtor formally notified the organization of the dispute. Used to track dispute aging and ensure timely resolution per regulatory requirements.']
  dispute_flag boolean [note: 'Boolean indicator of whether the debtor has formally disputed the receivable amount or validity. True indicates an active dispute; false indicates no dispute. Disputed accounts typically require special handling and may be placed on hold pending resolution.']
  dispute_reason varchar [note: 'Description of the reason provided by the debtor for disputing the receivable, such as services not rendered, incorrect billing amount, duplicate invoice, or contractual disagreement. Used to guide dispute resolution process.']
  due_date date [note: 'The date by which payment is contractually due per the invoice terms or agreement. Used to determine whether the account is current or past due and to calculate late fees or interest if applicable.']
  interest_rate decimal(5,4) [note: 'The annual interest rate applied to overdue balances on this account, expressed as a decimal (e.g., 0.0500 for 5%). Null if no interest is charged. Used to calculate interest charges on past-due amounts per contractual terms or state regulations.']
  invoice_date date [note: 'The date on which the original invoice or billing statement was issued to the debtor. Serves as the starting point for aging calculations and payment term enforcement.']
  last_activity_date date [note: 'The most recent date on which any activity occurred on this account, including payments received, adjustments posted, collection calls made, correspondence sent, or status changes. Used to identify dormant accounts and prioritize follow-up.']
  last_modified_timestamp timestamp [note: 'The date and time when this AR account record was most recently updated. Used for audit trail, change tracking, and data synchronization.']
  last_payment_amount decimal(18,2) [note: 'The monetary amount of the most recent payment received on this account. Denominated in the account\'s currency_code. Used for payment trend analysis and debtor behavior assessment.']
  last_payment_date date [note: 'The date on which the most recent payment was received and posted to this account. Used to assess payment patterns and predict future payment likelihood.']
  legal_action_date date [note: 'The date on which legal action was initiated for collection of this receivable. Null if no legal action has been taken. Used for legal case tracking and statute of limitations monitoring.']
  legal_action_flag boolean [note: 'Boolean indicator of whether legal action (lawsuit, lien, garnishment) has been initiated to collect this receivable. True indicates active legal proceedings; false indicates no legal action. Used for legal department coordination and risk management.']
  notes varchar [note: 'Free-text field for recording important notes, comments, or special instructions related to this account. May include collection history, debtor communication summaries, special handling requirements, or internal coordination notes.']
  original_balance decimal(18,2) [note: 'The initial receivable amount established when the account was opened. Represents the total amount originally owed before any payments, adjustments, or write-offs. Denominated in USD unless otherwise specified in currency_code.']
  payment_terms varchar [note: 'The contractual payment terms agreed upon with the debtor, typically expressed as net days (e.g., Net 30, Net 60) or other terms such as due on receipt, installment plan, or custom terms. Defines the expected payment timeline.']
  settlement_accepted_flag boolean [note: 'Boolean indicator of whether the debtor has accepted a settlement offer. True indicates acceptance; false indicates no acceptance or no offer made. Used to track settlement negotiations and finalize account closure.']
  settlement_offer_amount decimal(18,2) [note: 'The reduced amount offered to the debtor as a settlement to close the account, if applicable. Typically less than current_balance. Null if no settlement has been offered. Denominated in the account\'s currency_code.']
  total_adjustments decimal(18,2) [note: 'The cumulative sum of all adjustments (positive or negative) applied to this account, including billing corrections, contractual allowances, courtesy adjustments, and dispute resolutions. Denominated in the account\'s currency_code.']
  total_fees_assessed decimal(18,2) [note: 'The cumulative amount of late fees, collection fees, administrative fees, or other charges assessed on this account. Included in the current_balance. Denominated in the account\'s currency_code.']
  total_interest_accrued decimal(18,2) [note: 'The cumulative amount of interest that has accrued on this account due to late payment. Included in the current_balance. Denominated in the account\'s currency_code.']
  total_payments_received decimal(18,2) [note: 'The cumulative sum of all payments received on this account since inception. Used to calculate current_balance and assess payment history. Denominated in the account\'s currency_code.']
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutation to ensure change']
  vibe_mutation_marker varchar [note: 'Marker added by VIBE mutator']
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']
  write_off_amount decimal(18,2) [note: 'The amount written off as uncollectible bad debt. Populated when account_status is written_off. Represents the portion of the receivable removed from active AR and recognized as a loss. Denominated in the account\'s currency_code.']
  write_off_date date [note: 'The date on which the receivable was written off as uncollectible. Null if the account has not been written off. Used for bad debt reporting and financial statement preparation.']
  write_off_reason varchar [note: 'Explanation or categorization of why the receivable was written off, such as debtor bankruptcy, inability to locate debtor, cost of collection exceeds balance, statute of limitations expired, or management decision. Used for root cause analysis and process improvement.']

  Note: 'Accounts receivable account master representing the financial receivable relationship between the healthcare organization and a payer or self-pay patient for non-patient-billing AR (e.g., grants, rental income, intercompany receivables, physician practice management fees). Captures account number, account type (payer, self-pay, intercompany, grant, other), debtor name, debtor type, original balance, current balance, aging bucket, account status (open, closed, written off, in collections), assigned collector, and last activity date. Complements billing.patient_account for non-RCM receivables.'
}

Table finance.ar_transaction {
  ar_transaction_id varchar [pk, note: 'Unique identifier for the accounts receivable transaction record. Primary key for the AR transaction subledger.']
  ar_account_id varchar [note: 'Reference to the AR account (non-RCM receivable account) associated with this transaction. Links to the AR account master for customer or entity billing relationships outside of revenue cycle management.']
  ar_applied_to_transaction_id varchar [note: 'Reference to the charge transaction that this payment, credit memo, or adjustment is applied against. Enables payment application tracking and open item reconciliation.']
  chart_of_accounts_id varchar [note: 'Foreign key linking to finance.chart_of_accounts. Business justification: ar_transaction has gl_account_code (STRING) which should be normalized to FK to chart_of_accounts. Enables joining to get account metadata for the GL account affected by the AR transaction.']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: ar_transaction has cost_center_code (STRING) which should be normalized to FK to cost_center master. Enables joining to get cost center details for AR transaction allocation.']
  fiscal_period_id varchar [note: 'Foreign key linking to finance.fiscal_period. Business justification: ar_transaction has posting_period (STRING) which should be normalized to FK to fiscal_period master. Enables joining to get period details and ensures AR transactions reference valid fiscal periods.']
  primary_ar_employee_id varchar [note: 'User identifier of the person who created or entered this AR transaction into the system. Used for audit trail and accountability.']
  primary_reversed_transaction_ar_transaction_id varchar [note: 'Reference to the original AR transaction that this entry reverses. Null for non-reversal transactions. Creates audit trail for transaction corrections.']
  transaction_batch_id varchar [note: 'Identifier for the batch or group of transactions processed together. Used for batch reconciliation and control totals validation.']
  adjustment_reason_code varchar [note: 'Standardized code indicating the business reason for adjustment transactions: billing error, pricing correction, contractual adjustment, goodwill credit. Null for non-adjustment transactions.']
  aging_bucket varchar [note: 'Calculated aging category based on days outstanding from transaction date to current date: current (0 days), 1-30 days, 31-60 days, 61-90 days, or over 90 days. Used for AR aging analysis and collection prioritization.']
  approval_date date [note: 'The date when this AR transaction was approved for posting. Null for transactions not requiring approval or still pending approval.']
  created_timestamp timestamp [note: 'System timestamp when this AR transaction record was first created in the database. Used for audit trail and data lineage tracking.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the transaction amount. Supports multi-currency AR management and foreign exchange reconciliation.']
  due_date date [note: 'The date by which payment is expected or required for charge transactions. Used to calculate days outstanding and aging. Null for payment and adjustment transactions.']
  exchange_rate decimal(12,6) [note: 'The foreign exchange rate applied to convert transaction currency to functional currency. Null for transactions in functional currency.']
  functional_amount decimal(18,2) [note: 'The transaction amount converted to the organization\'s functional reporting currency (typically USD) using the exchange rate at transaction date. Used for consolidated financial reporting.']
  modified_timestamp timestamp [note: 'System timestamp when this AR transaction record was last modified. Used for audit trail and change tracking.']
  notes varchar [note: 'Additional free-text notes or comments about the transaction providing supplementary context for accounting staff, auditors, or management review.']
  payment_method varchar [note: 'The payment instrument or method used for payment transactions: check, wire transfer, ACH, credit card, cash, or electronic funds transfer. Null for non-payment transaction types.']
  payment_reference_number varchar [note: 'External payment reference number such as check number, wire confirmation, or ACH trace number. Used for payment reconciliation and audit trail.']
  posting_date date [note: 'The date when the transaction was posted to the general ledger and became part of the official financial record.']
  posting_status varchar [note: 'Current posting status of the AR transaction: draft (not yet posted), posted (finalized in GL), reversed (cancelled with offsetting entry), voided (cancelled before posting), or pending_approval (awaiting authorization).']
  reconciliation_date date [note: 'The date when this transaction was reconciled and cleared. Null for unreconciled transactions.']
  reconciliation_status varchar [note: 'Status of the transaction in the AR reconciliation process: unreconciled (not yet matched), reconciled (matched and cleared), disputed (discrepancy identified), or under_review (being investigated).']
  reference_document_number varchar [note: 'External reference number linking this AR transaction to source documents such as invoices, payment receipts, credit memos, or adjustment authorizations.']
  reversal_flag boolean [note: 'Boolean indicator whether this transaction is a reversal entry that offsets a previously posted transaction. True for reversal entries, False otherwise.']
  source_system_code varchar [note: 'Code identifying the originating system or module that created this AR transaction: SAP FI, Workday Financials, manual entry, interface from external system.']
  source_system_transaction_reference varchar [note: 'The unique transaction identifier from the source system. Used for data lineage tracking and reconciliation back to operational systems.']
  tax_amount decimal(18,2) [note: 'The tax component of the transaction amount for charge transactions. Used for tax reporting and reconciliation. Null for non-taxable transactions.']
  tax_code varchar [note: 'Tax jurisdiction or tax type code applied to this transaction. Used for tax reporting and compliance with state and federal tax regulations.']
  transaction_amount decimal(18,2) [note: 'The monetary value of the AR transaction in the transaction currency. Positive for charges and debits, negative for payments and credits.']
  transaction_date date [note: 'The business date when the AR transaction event occurred. This is the principal event timestamp for aging analysis and financial period assignment.']
  transaction_description varchar [note: 'Free-text business description of the AR transaction providing context about the nature of the charge, payment, or adjustment.']
  transaction_number varchar [note: 'Business-facing unique transaction number or document reference assigned to this AR transaction for external communication and reconciliation purposes.']
  transaction_type varchar [note: 'Classification of the AR transaction event: charge (new receivable), payment (cash received), credit_memo (reduction), debit_memo (increase), adjustment (correction), write_off (uncollectible), or refund (payment reversal). [ENUM-REF-CANDIDATE: charge|payment|credit_memo|debit_memo|adjustment|write_off|refund — 7 candidates stripped; promote to reference product]']
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutation to ensure change']
  vibe_mutation_marker varchar [note: 'Marker added by VIBE mutator']
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']
  write_off_reason_code varchar [note: 'Standardized code indicating the business reason for write-off transactions: bad debt, small balance, bankruptcy, deceased, statute of limitations. Null for non-write-off transactions.']

  Note: 'Transactional record of every accounts receivable financial event including charges, payments received, adjustments, and write-offs for non-RCM AR accounts. Captures transaction date, transaction type (charge, payment, credit memo, adjustment, write-off), AR account reference, GL account, cost center, amount, currency, reference document number, transaction description, posting period, and posting status. Provides the complete AR subledger transaction history for reconciliation and aging analysis.'
}

Table finance.fixed_asset {
  fixed_asset_id varchar [pk, note: 'Unique identifier for the fixed asset record. Primary key for the fixed asset entity.']
  care_site_id varchar [note: 'Identifier of the healthcare facility where the fixed asset is physically located and assigned for operational use.']
  chart_of_accounts_id varchar [note: 'Foreign key linking to finance.chart_of_accounts. Business justification: fixed_asset has gl_account_code (STRING) which should be normalized to FK to chart_of_accounts. Enables joining to get the GL asset account for the fixed asset.']
  cost_center_id varchar [note: 'Identifier of the cost center or department responsible for the fixed asset and to which depreciation expense is allocated for financial reporting and budgeting.']
  parent_fixed_asset_id varchar [note: 'Self-referencing FK on fixed_asset (parent_fixed_asset_id)']
  accumulated_depreciation decimal(18,2) [note: 'Total depreciation expense recognized to date since the asset was placed in service. Contra-asset account that reduces the gross book value. Recorded in USD.']
  acquisition_cost decimal(18,2) [note: 'Total capitalized cost of acquiring the fixed asset including purchase price, installation costs, freight, and other costs necessary to prepare the asset for its intended use. Recorded in USD.']
  acquisition_date date [note: 'Date on which the healthcare organization legally acquired ownership or control of the fixed asset through purchase, donation, or construction completion.']
  asset_category varchar [note: 'Primary classification of the fixed asset type. Medical equipment includes diagnostic and treatment devices; buildings include owned structures; land includes real property; leasehold improvements include tenant modifications; IT equipment includes servers and network infrastructure; vehicles include ambulances and transport.']
  asset_description varchar [note: 'Detailed description of the fixed asset including specifications, model information, and distinguishing characteristics.']
  asset_name varchar [note: 'Human-readable name or title of the fixed asset for identification and reporting purposes.']
  asset_status varchar [note: 'Current lifecycle status of the fixed asset. Active indicates in-service use; disposed indicates sold or scrapped; transferred indicates moved to another entity; fully depreciated indicates zero net book value but still in use; under construction indicates not yet placed in service; retired indicates removed from service.']
  asset_subcategory varchar [note: 'Secondary classification providing additional granularity within the asset category (e.g., MRI scanner, CT scanner, ultrasound machine for medical equipment category).']
  asset_tag_number varchar [note: 'Unique physical identifier affixed to the asset for tracking and inventory purposes. Externally visible barcode or RFID tag number used in physical audits.']
  capitalization_threshold_met boolean [note: 'Flag indicating whether the asset acquisition cost met or exceeded the organization\'s capitalization threshold policy. True indicates the asset was properly capitalized; False would indicate an expense treatment.']
  created_timestamp timestamp [note: 'Date and time when the fixed asset record was first created in the system. Used for audit trail and data lineage tracking.']
  depreciation_method varchar [note: 'Accounting method used to systematically allocate the cost of the fixed asset over its useful life. Straight-line allocates evenly; declining balance accelerates early depreciation; MACRS (Modified Accelerated Cost Recovery System) follows IRS tax rules; units of production bases depreciation on usage; sum of years digits accelerates depreciation.']
  disposal_date date [note: 'Date on which the fixed asset was disposed of through sale, donation, scrapping, or other removal from service. Null for active assets.']
  disposal_method varchar [note: 'Method by which the fixed asset was disposed. Sold indicates sale to third party; donated indicates charitable contribution; scrapped indicates destruction; traded in indicates exchange for new asset; returned to lessor indicates lease termination; transferred indicates internal move to another entity.']
  disposal_proceeds decimal(18,2) [note: 'Cash or fair value of consideration received from disposal of the fixed asset. Used to calculate gain or loss on disposal. Recorded in USD.']
  fda_device_class varchar [note: 'FDA classification of the medical device based on risk level. Class I is low risk; Class II is moderate risk; Class III is high risk. Not applicable for non-medical equipment.']
  fda_regulated_indicator boolean [note: 'Flag indicating whether the fixed asset is a medical device or equipment subject to FDA regulatory oversight and compliance requirements. True for FDA-regulated medical equipment.']
  insurance_coverage_amount decimal(18,2) [note: 'Maximum insured value or coverage limit for the fixed asset under the insurance policy. Recorded in USD.']
  insurance_policy_number varchar [note: 'Policy number of the insurance coverage protecting the fixed asset against loss, damage, or theft. Used for risk management and claims processing.']
  last_maintenance_date date [note: 'Date of the most recent preventive or corrective maintenance service performed on the fixed asset. Used to track maintenance compliance and schedule next service.']
  last_physical_inventory_date date [note: 'Date of the most recent physical inventory audit or verification confirming the existence and condition of the fixed asset.']
  lease_end_date date [note: 'Date on which the lease agreement for the fixed asset expires. Null for owned assets. Used for lease renewal planning and return logistics.']
  lease_indicator boolean [note: 'Flag indicating whether the fixed asset is leased (True) or owned (False). Determines accounting treatment under ASC 842 lease accounting standards.']
  lease_type varchar [note: 'Classification of the lease agreement if the asset is leased. Operating lease transfers use rights; finance/capital lease transfers substantially all risks and rewards of ownership. Not applicable for owned assets.']
  maintenance_schedule varchar [note: 'Frequency of scheduled preventive maintenance required for the fixed asset to ensure safe operation and regulatory compliance. Critical for medical equipment and life safety systems. [ENUM-REF-CANDIDATE: daily|weekly|monthly|quarterly|semi_annual|annual|as_needed — 7 candidates stripped; promote to reference product]']
  manufacturer_name varchar [note: 'Name of the original equipment manufacturer (OEM) who produced the fixed asset. May differ from vendor if purchased through a distributor.']
  model_number varchar [note: 'Manufacturer-assigned model number or designation that identifies the specific product configuration and specifications of the fixed asset.']
  modified_timestamp timestamp [note: 'Date and time when the fixed asset record was last updated in the system. Used for audit trail and change tracking.']
  net_book_value decimal(18,2) [note: 'Current carrying value of the fixed asset calculated as acquisition cost minus accumulated depreciation. Represents the undepreciated balance on the balance sheet. Recorded in USD.']
  next_maintenance_due_date date [note: 'Scheduled date for the next preventive maintenance service based on the maintenance schedule and last service date. Used for maintenance planning and compliance tracking.']
  physical_location varchar [note: 'Current physical location of the fixed asset including facility name, building, floor, room number, or department where the asset is deployed and in use.']
  placed_in_service_date date [note: 'Date on which the fixed asset was ready and available for its intended use and depreciation began. May differ from acquisition date for assets requiring installation or construction.']
  purchase_order_number varchar [note: 'Purchase order number under which the fixed asset was procured. Links the asset to the original procurement transaction and vendor contract.']
  responsible_party_name varchar [note: 'Name of the individual or role responsible for the custody, maintenance, and proper use of the fixed asset. Typically a department manager or equipment coordinator.']
  salvage_value decimal(18,2) [note: 'Estimated residual value of the fixed asset at the end of its useful life. Amount expected to be recovered through sale or disposal. Recorded in USD.']
  serial_number varchar [note: 'Manufacturer-assigned unique serial number that identifies the individual unit of the fixed asset for warranty, service, and tracking purposes.']
  useful_life_years decimal(5,2) [note: 'Estimated number of years the fixed asset is expected to provide economic benefit to the healthcare organization. Used to calculate depreciation expense.']
  vendor_name varchar [note: 'Name of the vendor, supplier, or manufacturer from whom the fixed asset was purchased or leased.']
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutation to ensure change']
  vibe_mutation_marker varchar [note: 'Marker added by VIBE mutator']
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']
  warranty_expiration_date date [note: 'Date on which the manufacturer or vendor warranty coverage for the fixed asset expires. Used for maintenance planning and service contract decisions.']

  Note: 'Master record for every capitalized fixed asset owned or leased by the healthcare organization, including medical equipment, buildings, land, leasehold improvements, IT infrastructure, and vehicles. Captures asset tag number, asset name, asset description, asset category (medical equipment, building, land, furniture, IT equipment, vehicle), acquisition date, placed-in-service date, acquisition cost, salvage value, useful life (years), depreciation method (straight-line, MACRS, units of production), accumulated depreciation, net book value, asset status (active, disposed, transferred, fully depreciated), physical location, responsible cost center, and vendor/manufacturer.'
}

Table finance.depreciation_schedule {
  depreciation_schedule_id varchar [pk, note: 'Unique identifier for the depreciation schedule entry. Primary key for this transactional record of periodic depreciation calculation and posting.']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: depreciation_schedule has cost_center_code (STRING) which should be normalized to FK to cost_center master. Enables joining to get cost center details for depreciation expense allocation.']
  depreciation_run_id varchar [note: 'Reference to the batch depreciation calculation run that generated this entry. Links all depreciation entries processed together.']
  expense_chart_of_accounts_id varchar [note: 'Foreign key linking to finance.chart_of_accounts. Business justification: depreciation_schedule has depreciation_expense_gl_account (STRING) which should be normalized to FK to chart_of_accounts. Using \'expense_chart_of_accounts_id\' as the FK name to distinguish from the ac']
  fiscal_period_id varchar [note: 'Foreign key linking to finance.fiscal_period. Business justification: depreciation_schedule has fiscal_year (INT) and fiscal_period (INT) which should be normalized to FK to fiscal_period master. The fiscal_period INT likely represents period_number, which combined with']
  fixed_asset_id varchar [note: 'Reference to the fixed asset for which this depreciation entry is calculated. Links to the capital asset master record.']
  journal_entry_id varchar [note: 'Reference to the general ledger journal entry created for this depreciation posting. Links to the financial transaction record.']
  prior_depreciation_schedule_id varchar [note: 'Self-referencing FK on depreciation_schedule (prior_depreciation_schedule_id)']
  accumulated_depreciation_balance decimal(18,2) [note: 'The cumulative total of all depreciation expense recognized on this asset from acquisition through the current period. Contra-asset account balance.']
  accumulated_depreciation_gl_account varchar [note: 'The general ledger account code credited for accumulated depreciation. Contra-asset account that offsets the fixed asset account.']
  adjustment_flag boolean [note: 'Indicates whether this entry represents an adjustment to a previously posted depreciation calculation. True if adjustment, False if original entry.']
  adjustment_reason varchar [note: 'The business reason for the depreciation adjustment, such as asset revaluation, useful life change, or error correction. Null if not an adjustment.']
  asset_category varchar [note: 'The classification category of the fixed asset being depreciated (e.g., Medical Equipment, Building, IT Infrastructure, Furniture). Supports categorical reporting.']
  beginning_net_book_value decimal(18,2) [note: 'The net book value of the asset at the beginning of the depreciation period. Calculated as original cost minus accumulated depreciation from prior periods.']
  book_tax_difference decimal(18,2) [note: 'The difference between book depreciation expense and tax depreciation amount for this period. Used for deferred tax calculations.']
  created_timestamp timestamp [note: 'The date and time when this depreciation schedule record was first created in the system. Supports audit trail and data lineage.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts in this depreciation entry (e.g., USD, EUR, GBP).']
  department_code varchar [note: 'The department code responsible for the asset and associated depreciation expense. Supports organizational expense allocation.']
  depreciation_date date [note: 'The specific date on which this depreciation calculation was performed and recognized. Typically the last day of the fiscal period.']
  depreciation_expense_amount decimal(18,2) [note: 'The depreciation expense amount calculated and recognized for this period. This amount is debited to the depreciation expense account.']
  depreciation_method varchar [note: 'The depreciation calculation method applied for this period. Determines how the asset cost is allocated over its useful life.']
  ending_net_book_value decimal(18,2) [note: 'The net book value of the asset at the end of the depreciation period. Calculated as beginning net book value minus current period depreciation expense.']
  facility_code varchar [note: 'The facility or location code where the asset is deployed. Enables facility-level capital asset and depreciation reporting.']
  fiscal_period varchar [note: 'The fiscal period (month) within the fiscal year for this depreciation entry. Typically 1-12 representing January through December.']
  fiscal_year varchar [note: 'The fiscal year in which this depreciation expense is recognized. Four-digit year format (e.g., 2024).']
  impairment_adjustment_amount decimal(18,2) [note: 'Any impairment loss recognized in this period that reduces the carrying value of the asset below its recoverable amount. Zero if no impairment occurred.']
  modified_by varchar [note: 'The user ID or name of the person who last modified this depreciation schedule record. Supports audit trail and accountability.']
  modified_timestamp timestamp [note: 'The date and time when this depreciation schedule record was last modified. Tracks the most recent update for audit and change tracking.']
  notes varchar [note: 'Free-text notes or comments related to this depreciation entry. May include explanations for adjustments, impairments, or special circumstances.']
  posted_by varchar [note: 'The user ID or name of the person who posted this depreciation entry to the general ledger. Supports audit trail and accountability.']
  posted_date date [note: 'The date on which this depreciation entry was posted to the general ledger. May differ from the depreciation date for timing reasons.']
  posting_status varchar [note: 'The current posting status of this depreciation entry in the general ledger. Indicates whether the journal entry has been finalized.']
  reversal_date date [note: 'The date on which this depreciation entry was reversed, if applicable. Null if not reversed.']
  reversal_flag boolean [note: 'Indicates whether this depreciation entry has been reversed. True if reversed, False if active.']
  reversal_reason varchar [note: 'The business reason or justification for reversing this depreciation entry. Null if not reversed.']
  salvage_value decimal(18,2) [note: 'The estimated residual value of the asset at the end of its useful life. This amount is not depreciated.']
  tax_depreciation_amount decimal(18,2) [note: 'The depreciation amount calculated for tax reporting purposes, which may differ from book depreciation due to tax regulations such as MACRS.']
  useful_life_remaining_months varchar [note: 'The number of months of useful life remaining for the asset after this depreciation period. Used for forecasting future depreciation.']
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutation to ensure change']
  vibe_mutation_marker varchar [note: 'Marker added by VIBE mutator']
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']
  created_by varchar [note: 'The user ID or name of the person who created this depreciation schedule record. Supports accountability and audit requirements.']

  Note: 'Transactional record of periodic depreciation calculations and postings for each fixed asset. Captures asset reference, depreciation period (fiscal period/year), depreciation method applied, beginning net book value, depreciation expense amount, accumulated depreciation balance, ending net book value, GL account debited (depreciation expense), GL account credited (accumulated depreciation), cost center, posting status, and any impairment adjustments. Drives monthly depreciation journal entries and supports capital asset reporting.'
}

Table finance.capital_project {
  capital_project_id varchar [pk, note: 'Unique identifier for the capital project record. Primary key for the capital project entity.']
  capital_employee_id varchar [note: 'Identifier of the user who created this capital project record. Links to the employee or user record for audit purposes.']
  capital_modified_by_employee_id varchar [note: 'Identifier of the user who last modified this capital project record. Links to the employee or user record for audit purposes.']
  care_site_id varchar [note: 'Identifier of the healthcare facility where this capital project is located or will be deployed. Links to the facility master record.']
  cost_center_id varchar [note: 'Identifier of the cost center responsible for this capital project. Links to the organizational unit accountable for project execution and budget management.']
  financial_entity_id varchar [note: 'Foreign key linking to finance.financial_entity. Business justification: capital_project should link to financial_entity to identify which legal entity owns the capital project. This is essential for multi-entity healthcare organizations to track capital projects by subsid']
  fund_id varchar [note: 'Foreign key linking to finance.fund. Business justification: Capital projects funded by restricted grants or donor funds require fund linkage for grant accounting, compliance reporting, and restricted fund balance tracking. Essential for non-profit healthcare g']
  grant_id varchar [note: 'Foreign key linking to research.grant. Business justification: Capital projects can be funded by research grants requiring tracking for compliance, financial reporting, and audit trails. Essential for grant-funded capital equipment purchases, facility constructio']
  org_unit_id varchar [note: 'Identifier of the department that will utilize or benefit from this capital project. Links to the department master record.']
  parent_capital_project_id varchar [note: 'Self-referencing FK on capital_project (parent_capital_project_id)']
  primary_capital_employee_id varchar [note: 'Identifier of the employee serving as project manager, responsible for day-to-day execution, schedule, and deliverables.']
  vendor_id varchar [note: 'Identifier of the primary vendor, contractor, or supplier responsible for project execution. Links to the vendor master record.']
  actual_completion_date date [note: 'Date when the capital project was actually completed and closed. Null until project reaches completed status.']
  approval_date date [note: 'Date when the capital project budget was formally approved by the board, finance committee, or authorized approver.']
  approved_capital_budget decimal(18,2) [note: 'Total capital budget amount approved by the board or authorized approver for this project. Represents the spending authority ceiling.']
  asset_class varchar [note: 'Classification of the resulting capital asset for depreciation and financial reporting: building, building improvement, land improvement, equipment, software, or infrastructure.']
  bond_issue_number varchar [note: 'Bond issue identifier if this project is funded through bond financing. Links to the bond issuance record for debt service tracking.']
  business_justification varchar [note: 'Business case and rationale for the capital investment, including expected benefits, return on investment, and strategic alignment.']
  capitalization_status varchar [note: 'Accounting treatment status for project costs: not_capitalized (project not yet eligible), in_progress (costs accumulating in construction-in-progress), capitalized (asset placed in service and capitalized), or expensed (costs expensed rather than capitalized).']
  contract_number varchar [note: 'Primary contract number for the general contractor, vendor, or implementation partner executing this capital project.']
  created_timestamp timestamp [note: 'Date and time when this capital project record was first created in the system. Audit trail for record creation.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts in this project record (e.g., USD, EUR, GBP).']
  expected_annual_revenue decimal(18,2) [note: 'Projected annual revenue to be generated by this capital project once operational. Used for return on investment analysis.']
  expected_annual_savings decimal(18,2) [note: 'Projected annual cost savings or expense reduction resulting from this capital project (e.g., energy efficiency, labor reduction, supply chain optimization).']
  funding_source varchar [note: 'Primary source of capital funding for this project: bond (municipal or corporate bonds), operating cash (internal reserves), grant (government or foundation grant), lease (capital lease financing), donation (philanthropic contribution), or loan (bank financing).']
  is_regulatory_required boolean [note: 'Indicates whether this capital project is required to meet regulatory compliance, accreditation standards, or legal mandates (e.g., Joint Commission, CMS Conditions of Participation, OSHA, fire code).']
  is_revenue_generating boolean [note: 'Indicates whether this capital project is expected to generate incremental revenue (e.g., new service line, expanded capacity, revenue-producing equipment).']
  modified_timestamp timestamp [note: 'Date and time when this capital project record was last modified. Audit trail for record updates.']
  project_description varchar [note: 'Detailed narrative description of the capital project scope, objectives, and deliverables. Provides context for stakeholders and auditors.']
  project_name varchar [note: 'Descriptive name of the capital project for identification and reporting purposes.']
  project_notes varchar [note: 'Free-text field for additional notes, comments, or context about the capital project. Used for project history and knowledge transfer.']
  project_number varchar [note: 'Business identifier for the capital project, used for external reference and reporting. Unique across all capital projects.']
  project_phase varchar [note: 'Current phase of the project lifecycle: initiation (concept development), planning (detailed planning), design (architectural/engineering design), procurement (vendor selection), construction (build/implementation), testing (commissioning), or closeout (final documentation). [ENUM-REF-CANDIDATE: initiation|planning|design|procurement|construction|testing|closeout — 7 candidates stripped; promote to reference product]']
  project_priority varchar [note: 'Strategic priority level assigned to this capital project for resource allocation and scheduling: critical (immediate need), high (near-term priority), medium (planned investment), or low (deferred opportunity).']
  project_start_date date [note: 'Date when the capital project officially commenced or is scheduled to commence. Represents the beginning of the project timeline.']
  project_status varchar [note: 'Current lifecycle status of the capital project: planning (initial scoping), approved (budget authorized), in progress (active construction or implementation), on hold (temporarily suspended), completed (project closed), or cancelled (project terminated).']
  project_type varchar [note: 'Classification of the capital project by nature of investment: construction (new building), renovation (facility upgrade), equipment acquisition (medical or operational equipment), IT implementation (technology systems), leasehold improvement (tenant improvements), or infrastructure (utilities, parking, grounds).']
  projected_completion_date date [note: 'Planned or forecasted date for project completion. Updated as project progresses and schedule changes occur.']
  strategic_initiative varchar [note: 'Name or identifier of the strategic initiative or program that this capital project supports. Links project to organizational strategy.']
  total_actual_costs decimal(18,2) [note: 'Cumulative amount of actual expenditures incurred and recorded against this project. Represents cash outflows and accrued expenses.']
  total_committed_costs decimal(18,2) [note: 'Cumulative amount of costs committed through purchase orders, contracts, and other binding obligations for this project. Represents encumbered funds.']
  useful_life_years varchar [note: 'Expected useful life of the capital asset in years, used for depreciation calculation once the asset is placed in service.']
  variance_amount decimal(18,2) [note: 'Current budget variance calculated as approved budget minus total actual costs. Positive indicates under budget, negative indicates over budget.']
  variance_percent decimal(5,2) [note: 'Current budget variance expressed as a percentage of approved budget. Used for variance threshold monitoring and escalation.']
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutation to ensure change']
  vibe_mutation_marker varchar [note: 'Marker added by VIBE mutator']
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']

  Note: 'Master record for capital improvement and construction projects tracked within the finance domain for capital budgeting and expenditure control. Captures project number, project name, project type (construction, renovation, equipment acquisition, IT implementation, leasehold improvement), project status (planning, approved, in progress, on hold, completed, cancelled), approved capital budget, total committed costs, total actual costs, project start date, projected completion date, actual completion date, responsible cost center, project manager, funding source (bond, operating cash, grant, lease), and capitalization status. Distinct from facility.capital_project which tracks physical construction details.'
}

Table finance.capital_expenditure {
  capital_expenditure_id varchar [pk, note: 'Unique identifier for the capital expenditure transaction record.']
  capital_employee_id varchar [note: 'Reference to the user who created this capital expenditure record in the system.']
  capital_modified_by_employee_id varchar [note: 'Reference to the user who last modified this capital expenditure record.']
  capital_project_id varchar [note: 'Reference to the approved capital project against which this expenditure is charged.']
  care_site_id varchar [note: 'Reference to the healthcare facility or location where the capital asset will be deployed or used.']
  chart_of_accounts_id varchar [note: 'Foreign key linking to finance.chart_of_accounts. Business justification: capital_expenditure has gl_account_code (STRING) which should be normalized to FK to chart_of_accounts. Enables joining to get the GL account for capital expenditure posting.']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: capital_expenditure has cost_center_code (STRING) which should be normalized to FK to cost_center master. Enables joining to get cost center details for capital expenditure allocation.']
  fiscal_period_id varchar [note: 'Reference to the fiscal period in which this capital expenditure transaction is recorded.']
  fixed_asset_id varchar [note: 'Reference to the fixed asset record created once this capital expenditure has been capitalized and the asset is placed in service.']
  fund_id varchar [note: 'Foreign key linking to finance.fund. Business justification: capital_expenditure has fund_code (STRING) which should be normalized to FK to fund master. Enables joining to get fund details for capital project funding tracking.']
  modality_id varchar [note: 'Foreign key linking to radiology.modality. Business justification: Capital expenditures for imaging equipment purchases must link to the resulting operational modality asset to track project-to-asset lifecycle, verify capitalization upon installation, enable acquisit']
  org_unit_id varchar [note: 'Reference to the department that will utilize or benefit from the capital asset being acquired.']
  primary_capital_employee_id varchar [note: 'Reference to the employee whose labor was charged to this capital expenditure, applicable when internal_labor_flag is true.']
  reversed_capital_expenditure_id varchar [note: 'Self-referencing FK on capital_expenditure (reversed_capital_expenditure_id)']
  vendor_id varchar [note: 'Reference to the external vendor or supplier from whom goods or services were purchased for this capital expenditure.']
  approval_status varchar [note: 'Current approval status of the capital expenditure transaction within the financial control workflow.']
  approved_date date [note: 'The date on which this capital expenditure transaction was approved.']
  asset_category varchar [note: 'High-level classification of the type of capital asset being acquired through this expenditure.']
  asset_placed_in_service_flag boolean [note: 'Indicates whether the capital asset associated with this expenditure has been placed into active service and is ready for depreciation.']
  capitalization_eligible_flag boolean [note: 'Indicates whether this expenditure meets the criteria for capitalization as a fixed asset per GAAP standards.']
  cip_category varchar [note: 'Classification of the capital expenditure within the Construction In Progress accounting category, used for tracking costs before capitalization.']
  created_timestamp timestamp [note: 'System timestamp indicating when this capital expenditure record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code indicating the currency in which the expenditure amount is denominated.']
  depreciation_method varchar [note: 'Depreciation method to be applied to the capital asset once placed in service.']
  expenditure_amount decimal(18,2) [note: 'Monetary value of the capital expenditure transaction in the specified currency.']
  expenditure_date date [note: 'The date on which the capital expenditure transaction occurred or was recorded.']
  expenditure_description varchar [note: 'Detailed narrative description of the capital expenditure transaction, including purpose and justification.']
  expenditure_number varchar [note: 'Business identifier for the capital expenditure transaction, used for tracking and reference.']
  expenditure_status varchar [note: 'Current lifecycle status of the capital expenditure transaction in the financial system.']
  expenditure_type varchar [note: 'Classification of the capital expenditure transaction indicating the nature of the cost incurred.']
  fiscal_year varchar [note: 'Fiscal year in which this capital expenditure transaction is recorded for financial reporting purposes.']
  grant_number varchar [note: 'Grant or funding award number if this capital expenditure is funded by an external grant or restricted funding source.']
  internal_labor_flag boolean [note: 'Indicates whether this expenditure represents internal labor costs allocated to the capital project.']
  invoice_number varchar [note: 'Vendor invoice number associated with this capital expenditure transaction, if applicable.']
  labor_hours decimal(10,2) [note: 'Number of labor hours charged to this capital expenditure for internal labor costs.']
  labor_rate decimal(10,2) [note: 'Hourly rate applied to internal labor hours for calculating the labor cost component of this capital expenditure.']
  modified_timestamp timestamp [note: 'System timestamp indicating when this capital expenditure record was last modified.']
  notes varchar [note: 'Additional free-text notes or comments related to this capital expenditure transaction.']
  payment_date date [note: 'The date on which payment was made to the vendor or internal source for this capital expenditure.']
  payment_method varchar [note: 'Method used to remit payment for this capital expenditure transaction.']
  placed_in_service_date date [note: 'The date on which the capital asset was placed into active service, triggering the start of depreciation.']
  purchase_order_number varchar [note: 'Purchase order number authorizing the procurement that resulted in this capital expenditure.']
  reversal_date date [note: 'The date on which this capital expenditure transaction was reversed, if applicable.']
  reversal_flag boolean [note: 'Indicates whether this capital expenditure transaction has been reversed or voided.']
  reversal_reason varchar [note: 'Explanation for why this capital expenditure transaction was reversed or voided.']
  salvage_value decimal(18,2) [note: 'Estimated residual value of the capital asset at the end of its useful life, used in depreciation calculations.']
  useful_life_years varchar [note: 'Expected useful life of the capital asset in years, used for depreciation calculation once the asset is capitalized.']
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutation to ensure change']
  vibe_mutation_marker varchar [note: 'Marker added by VIBE mutator']
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']

  Note: 'Transactional record of individual capital expenditure events charged against an approved capital project. Captures capital project reference, expenditure date, expenditure type (invoice payment, progress billing, internal labor, capitalized interest), vendor or internal source, invoice or PO reference, expenditure amount, GL account, cost center, fund, capitalization eligibility flag, asset placed-in-service indicator, and associated fixed asset record (once capitalized). Enables CIP tracking and the transition from capital project costs to fixed asset records.'
}

Table finance.cost_allocation {
  cost_allocation_id varchar [pk, note: 'Unique identifier for the cost allocation transaction record.']
  allocation_method_id varchar [note: 'FK to finance.allocation_method']
  allocation_run_id varchar [note: 'Identifier for the batch allocation run that generated this allocation record. Groups all allocations processed in a single execution cycle.']
  care_site_id varchar [note: 'Reference to the healthcare facility or hospital where this cost allocation applies. Supports multi-facility cost accounting.']
  chart_of_accounts_id varchar [note: 'Foreign key linking to finance.chart_of_accounts. Business justification: cost_allocation has gl_account_code (STRING) which should be normalized to FK to chart_of_accounts. Enables joining to get the GL account for cost allocation posting.']
  fiscal_period_id varchar [note: 'Reference to the fiscal period in which this cost allocation was executed.']
  primary_cost_employee_id varchar [note: 'Reference to the finance manager or controller who approved this allocation for posting.']
  primary_original_allocation_cost_allocation_id varchar [note: 'Reference to the original cost allocation record that this entry reverses or corrects. Null if this is not a reversal.']
  source_cost_center_id varchar [note: 'The overhead or indirect cost center from which costs are being allocated. Typically represents support departments such as facilities, IT, administration, or housekeeping.']
  target_cost_center_id varchar [note: 'The direct patient care or revenue-generating cost center receiving the allocated costs. Represents departments such as surgery, emergency, radiology, or inpatient units.']
  tertiary_cost_modified_by_employee_id varchar [note: 'Reference to the user who last modified this allocation record.']
  adjustment_reason varchar [note: 'Explanation for any manual adjustment made to the allocated amount. Required for audit trail and variance analysis.']
  allocated_amount decimal(18,2) [note: 'The dollar amount of overhead or indirect cost allocated from the source cost center to the target cost center in this transaction. Calculated as source cost pool multiplied by allocation basis percentage.']
  allocation_adjustment_amount decimal(18,2) [note: 'Any manual adjustment applied to the calculated allocated amount. Used for corrections, policy adjustments, or rounding reconciliation.']
  allocation_amount decimal(18,2) [note: 'Allocation amount']
  allocation_basis varchar [note: 'The statistical or financial metric used to distribute costs from source to target cost centers. Square footage for facilities costs, FTE for HR costs, revenue for administrative overhead, RVU for clinical support, patient days for nursing, labor hours for supervision, transactions for IT, direct cost for proportional allocation, bed count for capacity-based allocation, and visits for outpatient services. [ENUM-REF-CANDIDATE: square_footage|fte|revenue|rvu|patient_days|labor_hours|transactions|direct_cost|bed_count|visits — 10 candidates stripped; promote to reference product]']
  allocation_basis_percentage decimal(7,4) [note: 'The percentage of the total allocation basis that the target cost center represents. Calculated as target quantity divided by sum of all target quantities. Used to distribute source costs proportionally.']
  allocation_basis_quantity decimal(18,4) [note: 'The numeric quantity of the allocation basis metric for the target cost center. For example, 5000 square feet, 25.5 FTEs, 1200 patient days, or 8500 RVUs.']
  allocation_category varchar [note: 'The functional category of overhead cost being allocated. Groups allocations by the type of support service provided. [ENUM-REF-CANDIDATE: facilities|information_technology|human_resources|administration|finance|legal|compliance|quality|marketing — 9 candidates stripped; promote to reference product]']
  allocation_date date [note: 'The business date on which this cost allocation was executed and recorded. Typically the last day of the fiscal period being allocated.']
  allocation_notes varchar [note: 'Free-text field for documenting special circumstances, adjustments, or explanations related to this specific allocation transaction.']
  allocation_percentage decimal(9,6)
  allocation_run_status varchar [note: 'The current lifecycle status of this allocation record. Draft indicates preliminary calculation, pending approval awaits finance review, approved is ready for posting, posted means committed to GL, reversed indicates correction, and cancelled means voided.']
  allocation_sequence varchar [note: 'The order in which this allocation was processed within the allocation run. Critical for step-down methodology where sequence determines which cost centers allocate first.']
  allocation_status varchar
  allocation_tier varchar [note: 'The hierarchical tier or level of this allocation in multi-tier allocation methodologies. Tier 1 represents first-level overhead, tier 2 represents second-level, and so on.']
  allocation_version varchar [note: 'Version identifier for the allocation run. Supports multiple allocation scenarios such as budget, forecast, actual, or what-if analysis.']
  approval_date date [note: 'The date on which this allocation was reviewed and approved by authorized finance personnel.']
  created_timestamp timestamp [note: 'The date and time when this cost allocation record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the allocated amount. Typically USD for U.S. healthcare organizations.']
  drg_cost_allocation_flag boolean [note: 'Indicates whether this allocation contributes to DRG-based cost calculations for inpatient prospective payment system analysis.']
  fiscal_year varchar
  is_medicare_reportable boolean [note: 'Indicates whether this allocation must be reported on the Medicare Cost Report (CMS-2552-10) for reimbursement calculation purposes.']
  is_reciprocal_allocation boolean [note: 'Indicates whether this allocation is part of a reciprocal allocation cycle where two or more cost centers provide mutual services to each other.']
  modified_timestamp timestamp [note: 'The date and time when this cost allocation record was last modified.']
  notes varchar
  posting_date date [note: 'The date on which this allocation was posted to the general ledger. May differ from allocation date due to period-end close timing.']
  posting_status varchar
  reversal_flag boolean [note: 'Indicates whether this allocation record represents a reversal of a previously posted allocation. Used for corrections and period adjustments.']
  service_line_code varchar [note: 'The clinical service line or product line to which the target cost center belongs. Examples include cardiology, orthopedics, oncology, women\'s health, or emergency services.']
  source_amount decimal(18,2)
  source_cost_pool_amount decimal(18,2) [note: 'The total amount of costs available in the source cost center for allocation before distribution. Represents the full overhead pool being allocated across all target cost centers.']
  statistic_quantity decimal(18,4)
  statistic_type varchar
  statistical_driver varchar
  total_pool_amount decimal(18,2)
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutation to ensure change']
  vibe_mutation_marker varchar [note: 'Marker added by VIBE mutator']
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']

  Note: 'Transactional record of overhead and indirect cost allocations distributed from overhead cost centers to direct patient care cost centers using defined allocation methodologies. Captures allocation run ID, fiscal period, allocation method (step-down, direct, reciprocal, activity-based), source cost center, target cost center, allocation basis (square footage, FTEs, revenue, RVUs, patient days), allocation basis quantity, allocated amount, GL account, and allocation run status. Supports Medicare cost report preparation and departmental cost accounting.'
}

Table finance.allocation_method {
  allocation_method_id varchar [pk, note: 'Unique identifier for the cost allocation method. Primary key for the allocation method reference master.']
  allocation_employee_id varchar [note: 'Identifier of the user who created this allocation method record. Links to workforce or user management system for accountability.']
  allocation_modified_by_employee_id varchar [note: 'Identifier of the user who last modified this allocation method record. Links to workforce or user management system for accountability.']
  chart_of_accounts_id varchar
  owner_employee_id varchar [note: 'Identifier of the cost accounting analyst or finance manager responsible for maintaining and updating this allocation method. Links to workforce or user management system.']
  parent_allocation_method_id varchar
  primary_allocation_employee_id varchar [note: 'Identifier of the finance executive or cost accounting manager who approved this allocation method. Links to workforce or user management system for accountability and audit trail.']
  primary_superseded_method_allocation_method_id varchar [note: 'Identifier of the previous allocation method that this method replaces. Creates a lineage chain for tracking method evolution and supporting historical cost report reconstruction.']
  activity_driver_description varchar [note: 'For activity-based costing (ABC) methods, describes the specific activity or cost driver that causes costs to be incurred. Examples include number of purchase orders processed, number of patient admissions, number of surgical procedures performed. Provides transparency into ABC methodology.']
  allocation_basis varchar [note: 'Allocation basis']
  allocation_basis_type varchar [note: 'The statistical or financial measure used as the basis for distributing costs. Square footage for facility costs; FTE (Full-Time Equivalent) count for HR costs; revenue for administrative overhead; RVU (Relative Value Unit) for physician services; patient days for nursing; procedures for surgical services; direct cost for proportional allocation; labor hours for labor-intensive departments; visits for outpatient services; discharges for inpatient services. [ENUM-REF-CANDIDATE: square_footage|fte_count|revenue|rvu|patient_days|procedures|direct_cost|labor_hours|visits|discharges — 10 candidates stripped; promote to reference product]']
  allocation_frequency varchar [note: 'How often this allocation method is executed. Monthly for routine cost accounting; quarterly for less frequent allocations; annually for year-end adjustments; as needed for special allocations; real-time for continuous allocation in advanced systems.']
  allocation_percentage_cap decimal(5,2) [note: 'Maximum percentage of source cost that can be allocated to any single target cost center. Used to prevent disproportionate allocation and ensure equitable distribution. Expressed as a percentage (e.g., 25.00 for 25%).']
  allocation_sequence varchar [note: 'The order in which this allocation method is applied in step-down or sequential allocation processes. Lower numbers are allocated first. Critical for step-down methodology where allocation order affects final cost distribution.']
  allocation_type varchar
  approval_date date [note: 'The date on which this allocation method was formally approved by finance leadership or the cost accounting committee. Required for audit trail and regulatory compliance documentation.']
  audit_trail_required_flag boolean [note: 'Indicates whether detailed audit trail logging is required for allocations using this method. True for regulatory or high-value allocations requiring full traceability; false for routine internal allocations.']
  basis_data_source varchar [note: 'The system, report, or data source from which the allocation basis statistics are obtained. Examples include facility management system for square footage, HR system for FTE counts, general ledger for revenue, clinical system for RVUs and patient days.']
  calculation_formula varchar [note: 'The mathematical formula or algorithm used to calculate allocation amounts. May reference basis statistics, weighting factors, and cost pools. Provides transparency and reproducibility for cost accounting calculations.']
  cms_cost_report_schedule varchar [note: 'The specific Medicare Cost Report worksheet or schedule to which this allocation method applies. Examples include Worksheet A (Reclassification and Adjustment of Trial Balance), Worksheet B (Cost Allocation), Worksheet C (Departmental Cost Allocation). Critical for regulatory compliance and reimbursement.']
  created_timestamp timestamp [note: 'The date and time when this allocation method record was first created in the system. Supports audit trail and data lineage tracking.']
  decimal_precision varchar [note: 'Number of decimal places to which allocation amounts are calculated and stored. Typically 2 for dollar amounts, but may be higher for statistical allocations or percentage calculations.']
  driver_metric varchar
  effective_end_date date [note: 'The date on which this allocation method ceases to be active. Null indicates the method is currently in use. Used for historical tracking and audit compliance.']
  effective_start_date date [note: 'The date from which this allocation method becomes active and applicable for cost accounting calculations. Aligns with fiscal period boundaries and Medicare Cost Report periods.']
  gaap_compliant_flag boolean [note: 'Indicates whether this allocation method complies with Generally Accepted Accounting Principles (GAAP) for financial statement preparation. True for methods acceptable under GAAP; false for methods used only for internal or regulatory purposes.']
  is_active boolean [note: 'Active flag']
  last_review_date date [note: 'The date on which this allocation method was last reviewed for accuracy, relevance, and compliance. Used to ensure methods are periodically validated and updated as business needs evolve.']
  method_code varchar [note: 'Short alphanumeric code uniquely identifying the allocation method for system processing and reporting. Used in cost accounting transactions and Medicare Cost Report preparation.']
  method_description varchar [note: 'Detailed narrative description of the allocation method, including business rationale, calculation approach, and any special considerations. Used for documentation, training, and audit support.']
  method_name varchar [note: 'Full descriptive name of the cost allocation method. Human-readable label used in financial reports and cost accounting documentation.']
  method_status varchar [note: 'Current lifecycle status of the allocation method. Active methods are in use; inactive methods are retired; pending approval methods await finance leadership sign-off; deprecated methods are being phased out; under review methods are being evaluated for changes.']
  method_type varchar [note: 'Classification of the cost allocation methodology. Step-down allocates overhead sequentially; direct allocates without intermediate steps; reciprocal accounts for mutual service exchanges; activity-based costing (ABC) allocates based on cost drivers; simultaneous solves all allocations concurrently; double distribution performs two-pass allocation.']
  modified_timestamp timestamp [note: 'The date and time when this allocation method record was last modified. Supports change tracking and audit compliance.']
  next_review_date date [note: 'The scheduled date for the next periodic review of this allocation method. Supports proactive governance and ensures methods remain current with regulatory and business requirements.']
  notes varchar
  prior_period_adjustment_flag boolean [note: 'Indicates whether this allocation method supports retroactive adjustments to prior accounting periods. True for methods that allow historical corrections; false for methods that only allocate current period costs.']
  reciprocal_allocation_flag boolean [note: 'Indicates whether this method supports reciprocal allocation where departments can allocate costs to each other. True for methods that handle mutual service exchanges; false for unidirectional allocation methods.']
  reciprocal_flag boolean
  regulatory_compliance_flag boolean [note: 'Indicates whether this allocation method is required for regulatory reporting compliance (CMS Medicare Cost Report, state Medicaid cost reports, or other regulatory filings). True for methods mandated by regulation; false for internal management accounting methods.']
  rounding_rule varchar [note: 'Specifies how calculated allocation amounts are rounded. Round half up rounds 0.5 and above up; round half down rounds 0.5 and below down; round up always rounds up; round down always rounds down; truncate drops decimals; no rounding preserves full precision. Critical for ensuring allocation totals reconcile to source costs.']
  source_cost_center_category varchar [note: 'Classification of the cost centers from which costs are allocated using this method. Overhead includes facilities and utilities; administrative includes finance and HR; support services includes IT and housekeeping; ancillary includes lab and radiology; clinical includes nursing and therapy; revenue-producing vs non-revenue-producing distinguishes direct patient care from support functions. [ENUM-REF-CANDIDATE: overhead|administrative|support_services|ancillary|clinical|revenue_producing|non_revenue_producing — 7 candidates stripped; promote to reference product]']
  statistic_source varchar
  statistic_type varchar
  statistical_source varchar
  step_down_sequence varchar
  target_cost_center_category varchar [note: 'Classification of the cost centers to which costs are allocated using this method. Defines the recipient departments for overhead distribution. Patient care only excludes further allocation to administrative departments.']
  usage_notes varchar [note: 'Free-text field for cost accounting analysts to document special instructions, exceptions, or considerations when applying this allocation method. Supports knowledge transfer and operational continuity.']
  version_number varchar [note: 'Version identifier for this allocation method configuration. Incremented when method parameters, formulas, or basis types are changed. Supports change tracking and historical analysis.']
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutation to ensure change']
  vibe_mutation_marker varchar [note: 'Marker added by VIBE mutator to indicate change']
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']
  weighting_factor decimal(10,4) [note: 'Numeric multiplier applied to the allocation basis to adjust for intensity, complexity, or other factors. Used to refine allocation precision when raw statistics do not fully reflect cost consumption patterns.']

  Note: 'Reference master defining the cost allocation methodologies and statistical basis configurations used in the healthcare cost accounting process. Captures method code, method name, method type (step-down, direct, reciprocal, activity-based costing), allocation basis type (square footage, FTE count, revenue, RVU, patient days, procedures), basis data source, weighting factor, effective date range, and applicable cost report schedule (Medicare Cost Report Schedule). Governs how overhead costs are distributed across clinical and administrative departments.'
}

Table finance.bank_account {
  bank_account_id varchar [pk, note: 'Unique identifier for the bank account record. Primary key.']
  bank_cash_chart_of_accounts_id varchar [note: 'Foreign key linking to finance.chart_of_accounts. Business justification: bank_account has gl_cash_account_code (STRING) which should be normalized to FK to chart_of_accounts. Enables joining to get the GL cash account details. Using \'cash_chart_of_accounts_id\' as the FK na']
  bank_chart_of_accounts_id varchar
  care_site_id varchar [note: 'Identifier of the healthcare facility or location associated with this bank account for operational and reporting purposes.']
  financial_entity_id varchar [note: 'Foreign key linking to finance.financial_entity. Business justification: bank_account has legal_entity_id (BIGINT) which should be normalized to FK to financial_entity. The attribute name uses \'legal_entity\' but should point to financial_entity.financial_entity_id. Enables']
  parent_bank_account_id varchar [note: 'Self-referencing FK on bank_account (parent_bank_account_id)']
  primary_bank_employee_id varchar [note: 'Identifier of the system user who created this bank account record.']
  account_closed_date date [note: 'The date on which the bank account was officially closed and is no longer available for transactions. Null if the account is still active.']
  account_name varchar [note: 'The descriptive name or title assigned to the bank account for internal identification and reporting purposes.']
  account_notes varchar [note: 'Free-text field for capturing additional information, special instructions, or operational notes related to the bank account.']
  account_number varchar [note: 'The masked or encrypted bank account number maintained by the financial institution. Stored in masked format for security compliance per PCI DSS and organizational treasury policy.']
  account_number_masked varchar
  account_opened_date date [note: 'The date on which the bank account was originally opened with the financial institution.']
  account_purpose varchar [note: 'The designated business purpose or functional use of the bank account within the healthcare organization\'s treasury operations.']
  account_status varchar [note: 'The current operational status of the bank account in its lifecycle, indicating whether it is available for transactions or restricted.']
  account_type varchar [note: 'The classification of the bank account based on its financial instrument characteristics and operational features.']
  ach_enabled_flag boolean [note: 'Indicates whether the account is enabled to send and receive ACH electronic funds transfers for payroll, vendor payments, and other automated transactions.']
  available_balance decimal(18,2) [note: 'The amount of funds available for immediate withdrawal or payment, accounting for pending transactions and holds.']
  bank_account_name varchar
  bank_branch_address varchar [note: 'The physical street address of the bank branch where the account is maintained.']
  bank_branch_name varchar [note: 'The name of the specific bank branch where the account is domiciled and serviced.']
  bank_contact_email varchar [note: 'The email address of the bank relationship manager or primary contact for electronic communication regarding the account.']
  bank_contact_name varchar [note: 'The name of the primary relationship manager or contact person at the financial institution for this account.']
  bank_contact_phone varchar [note: 'The telephone number of the bank relationship manager or primary contact for account inquiries and issue resolution.']
  bank_name varchar [note: 'The legal name of the financial institution where the account is maintained.']
  bank_routing_number varchar [note: 'The nine-digit American Bankers Association (ABA) routing transit number that identifies the financial institution for electronic funds transfers and check processing.']
  bank_swift_code varchar [note: 'The Society for Worldwide Interbank Financial Telecommunication (SWIFT) Business Identifier Code (BIC) used for international wire transfers and cross-border payments.']
  created_timestamp timestamp [note: 'The date and time when this bank account record was first created in the system.']
  currency_code varchar [note: 'The three-letter ISO 4217 currency code representing the denomination in which the account balance is maintained.']
  current_balance decimal(18,2) [note: 'The most recent available balance in the bank account as of the last reconciliation or bank statement date.']
  dual_signature_required_flag boolean [note: 'Indicates whether transactions above a certain threshold require two authorized signatures for approval and execution.']
  dual_signature_threshold_amount decimal(18,2) [note: 'The monetary threshold above which dual signature authorization is required for transactions on this account.']
  effective_end_date date
  effective_start_date date
  fdic_certificate_number varchar [note: 'The unique FDIC certificate number assigned to the financial institution, used to verify insurance coverage.']
  fdic_insured_flag boolean [note: 'Indicates whether the bank account is covered by FDIC insurance protection up to the statutory limit.']
  grant_number varchar [note: 'The unique identifier of the grant or funding award associated with this bank account, if the account is designated for grant-funded activities.']
  iban varchar
  interest_calculation_method varchar [note: 'The frequency and methodology used by the financial institution to calculate and credit interest to the account.']
  interest_rate decimal(5,4) [note: 'The annual percentage rate (APR) of interest earned on the account balance, expressed as a decimal (e.g., 0.0250 for 2.50%).']
  is_active boolean
  is_disbursement_account boolean
  is_operating_account boolean
  last_reconciled_date date
  last_reconciliation_date date [note: 'The date of the most recent bank reconciliation performed for this account, ensuring alignment between bank statement and general ledger balances.']
  minimum_balance_required decimal(18,2) [note: 'The minimum account balance that must be maintained to avoid fees or meet contractual requirements with the financial institution.']
  modified_timestamp timestamp [note: 'The date and time when this bank account record was last modified or updated in the system.']
  next_reconciliation_due_date date [note: 'The scheduled date by which the next bank reconciliation must be completed per organizational policy and internal controls.']
  notes varchar
  online_banking_enabled_flag boolean [note: 'Indicates whether online banking access and electronic transaction capabilities are enabled for this account.']
  opening_date date
  positive_pay_enabled_flag boolean [note: 'Indicates whether positive pay fraud prevention service is enabled, requiring pre-authorization of checks and ACH transactions before they are honored by the bank.']
  primary_signatory_name varchar [note: 'The name of the primary authorized signatory who has authority to execute transactions and sign checks on this bank account.']
  primary_signatory_title varchar [note: 'The job title or position of the primary authorized signatory within the healthcare organization.']
  restricted_fund_flag boolean [note: 'Indicates whether the account holds restricted funds that are subject to donor restrictions, grant requirements, or regulatory limitations on use.']
  restriction_description varchar [note: 'A detailed description of any restrictions placed on the use of funds in this account, including donor stipulations, grant conditions, or regulatory requirements.']
  routing_number varchar
  secondary_signatory_name varchar [note: 'The name of the secondary authorized signatory who has backup authority to execute transactions on this bank account.']
  swift_code varchar
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutation to ensure change']
  vibe_mutation_marker varchar [note: 'Marker added by VIBE mutator']
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']
  wire_transfer_enabled_flag boolean [note: 'Indicates whether the account is authorized to initiate and receive domestic and international wire transfers.']

  Note: 'Master record for all bank accounts maintained by the healthcare organization for operating, payroll, investment, and restricted fund purposes. Captures bank account number (masked), bank name, bank routing number, account type (checking, savings, money market, sweep, lockbox), account purpose (operating, payroll, petty cash, restricted, investment), currency, legal entity owner, GL cash account mapping, account status (active, closed, dormant), signatory list, and bank contact information. SSOT for treasury cash management.'
}

Table finance.bank_reconciliation {
  bank_reconciliation_id varchar [pk, note: 'Unique identifier for the bank reconciliation record. Primary key for the bank reconciliation transaction.']
  approver_employee_id varchar [note: 'Reference to the manager or supervisor who provided final approval of the bank reconciliation. Represents the final sign-off in the reconciliation workflow.']
  bank_account_id varchar [note: 'Reference to the specific bank account being reconciled. Links to the bank account master data.']
  chart_of_accounts_id varchar [note: 'Foreign key linking to finance.chart_of_accounts. Business justification: bank_reconciliation has gl_account_code (STRING) which should be normalized to FK to chart_of_accounts. Enables joining to get the GL account being reconciled.']
  fiscal_period_id varchar [note: 'Reference to the fiscal period for which this reconciliation is performed. Links to the fiscal calendar.']
  primary_bank_employee_id varchar [note: 'Reference to the employee who prepared and performed the bank reconciliation. Links to the workforce or employee master data for accountability and audit trail purposes.']
  primary_prior_period_reconciliation_bank_reconciliation_id varchar [note: 'Reference to the previous month\'s or period\'s bank reconciliation record. Enables tracking of reconciliation continuity and resolution of prior period outstanding items.']
  primary_recon_employee_id varchar
  reviewer_employee_id varchar [note: 'Reference to the employee who reviewed the bank reconciliation for accuracy and completeness. Must be different from the preparer to maintain segregation of duties per SOX requirements.']
  adjusted_bank_balance decimal(18,2)
  adjustment_amount decimal(18,2)
  approval_date date [note: 'The date on which the reconciliation received final approval from the designated approver. Marks the completion of the reconciliation workflow and acceptance of the reconciled balance.']
  approver_name varchar [note: 'Full name of the manager or supervisor who approved the bank reconciliation. Provides human-readable identification for reporting and audit purposes.']
  auto_reconciliation_flag boolean [note: 'Indicates whether this reconciliation was performed automatically by the system using matching algorithms or manually by an accountant. True indicates automated reconciliation, false indicates manual reconciliation.']
  bank_errors_total decimal(18,2) [note: 'Total amount of errors identified on the bank statement, such as incorrect charges, duplicate transactions, or processing mistakes by the bank. Positive values indicate bank overstatements, negative values indicate understatements.']
  bank_service_charges decimal(18,2) [note: 'Total bank fees and service charges deducted by the bank during the statement period, including monthly maintenance fees, transaction fees, and wire transfer charges.']
  bank_statement_balance decimal(18,2)
  book_balance decimal(18,2) [note: 'Book balance']
  book_errors_total decimal(18,2) [note: 'Total amount of errors identified in the organization\'s general ledger records, such as recording errors, duplicate entries, or omitted transactions. Requires correcting journal entries.']
  created_timestamp timestamp [note: 'System timestamp indicating when this bank reconciliation record was first created in the system. Part of the audit trail for data lineage and compliance.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the bank account being reconciled. Indicates the currency in which all monetary amounts are denominated.']
  deposits_in_transit decimal(18,2)
  deposits_in_transit_total decimal(18,2) [note: 'Total amount of deposits recorded in the GL but not yet reflected on the bank statement as of the statement date. Represents timing differences between internal recording and bank processing.']
  difference_amount decimal(18,2)
  ending_balance decimal(18,2)
  exception_flag boolean [note: 'Indicates whether this reconciliation contains exceptions or unusual items requiring management attention. True indicates exceptions exist, false indicates a clean reconciliation.']
  gl_book_balance decimal(18,2) [note: 'The cash account balance as recorded in the general ledger for the reconciliation period. This is the organization\'s internal record of the account balance.']
  interest_earned decimal(18,2) [note: 'Interest income earned on the bank account during the statement period as reported by the bank. Requires recording in the general ledger if not previously captured.']
  modified_by varchar [note: 'User identifier or name of the person who last modified this bank reconciliation record. Supports audit trail and accountability for changes to reconciliation data.']
  modified_timestamp timestamp [note: 'System timestamp indicating when this bank reconciliation record was last modified. Tracks the most recent update to the reconciliation data for audit and change tracking purposes.']
  notes varchar
  nsf_checks_total decimal(18,2) [note: 'Total amount of checks deposited by the organization that were returned by the bank due to insufficient funds in the payer\'s account. Requires reversal of the original deposit entry.']
  other_adjustments_total decimal(18,2) [note: 'Total amount of miscellaneous adjustments not categorized elsewhere, including electronic fund transfers, automatic payments, or other reconciling items identified during the reconciliation process.']
  outstanding_checks_amount decimal(18,2)
  outstanding_checks_total decimal(18,2) [note: 'Total amount of checks issued by the organization that have been recorded in the GL but have not yet cleared the bank as of the statement date.']
  outstanding_items_count varchar [note: 'Total number of outstanding reconciling items identified during the reconciliation process, including outstanding checks, deposits in transit, and other uncleared transactions.']
  preparation_date date [note: 'The date on which the reconciliation was initially prepared and completed by the preparer. Distinct from the reconciliation date which represents the business period being reconciled.']
  preparer_name varchar [note: 'Full name of the employee who prepared the bank reconciliation. Provides human-readable identification for reporting and audit purposes.']
  reconciled_balance decimal(18,2) [note: 'The final adjusted balance after applying all reconciling items to either the bank statement balance or the GL book balance. Both adjusted balances should equal this amount when reconciliation is complete.']
  reconciled_by varchar
  reconciliation_date date [note: 'The date on which the bank reconciliation was performed. Represents the business date of the reconciliation activity.']
  reconciliation_notes varchar [note: 'Free-text field for documenting significant findings, unusual items, explanations of variances, or other relevant information discovered during the reconciliation process. Supports audit trail and knowledge transfer.']
  reconciliation_number varchar [note: 'Business identifier for the reconciliation transaction, typically formatted as a sequential or date-based reference number used for tracking and audit purposes.']
  reconciliation_status varchar [note: 'Current workflow status of the bank reconciliation process. Tracks the reconciliation through preparation, review, and approval stages.']
  review_date date [note: 'The date on which the reconciliation was reviewed by the designated reviewer. Part of the internal control process to ensure accuracy and completeness.']
  reviewer_name varchar [note: 'Full name of the employee who reviewed the bank reconciliation. Provides human-readable identification for reporting and audit purposes.']
  statement_balance decimal(18,2) [note: 'Statement balance']
  statement_date date [note: 'The ending date of the bank statement being reconciled. Represents the cutoff date for transactions included in the bank statement.']
  statement_ending_balance decimal(18,2) [note: 'The ending balance as reported on the bank statement for the statement date. This is the bank\'s record of the account balance.']
  statement_ending_date date
  statement_starting_date date
  supporting_document_reference varchar [note: 'Reference identifier or file path to supporting documentation such as bank statements, reconciliation worksheets, or scanned images stored in the document management system.']
  unreconciled_variance decimal(18,2) [note: 'The remaining difference between the adjusted bank balance and adjusted book balance after all known reconciling items have been applied. A non-zero variance indicates unresolved discrepancies requiring investigation.']
  vibe_mutation_applied varchar [note: 'Marker added by VIBE mutation to ensure change']
  vibe_mutation_marker varchar [note: 'Marker added by VIBE mutator']
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']

  Note: 'Transactional record of monthly bank reconciliation activities performed for each bank account. Captures reconciliation period, bank account reference, statement date, bank statement ending balance, GL book balance, outstanding checks total, deposits in transit total, bank errors, book errors, reconciled balance, reconciliation status (in progress, reconciled, approved), preparer, reviewer, approval date, and unreconciled variance amount. Ensures integrity between bank statements and the general ledger cash accounts.'
}

Table finance.financial_period_close {
  financial_period_close_id varchar [pk, note: 'Unique identifier for the financial period close record. Primary key.']
  approver_employee_id varchar [note: 'Reference to the employee or user who approved the final close of this period.']
  financial_employee_id varchar [note: 'Reference to the user who created this financial period close record.']
  financial_entity_id varchar
  financial_modified_by_employee_id varchar [note: 'Reference to the user who last modified this financial period close record.']
  fiscal_period_id varchar [note: 'Reference to the fiscal period being closed (month, quarter, or year).']
  general_ledger_id varchar [note: 'Reference to the general ledger for which this close is being performed.']
  primary_close_employee_id varchar
  primary_financial_employee_id varchar [note: 'Reference to the employee or user responsible for managing and completing this period close.']
  prior_financial_period_close_id varchar [note: 'Self-referencing FK on financial_period_close (prior_financial_period_close_id)']
  accounts_payable_close_status varchar [note: 'Status of accounts payable close activities, including vendor invoice processing and accrual verification.']
  accrual_completion_status varchar [note: 'Status of accrual entries for the period, ensuring all revenue and expenses are recorded in the correct period per accrual accounting.']
  actual_close_date date [note: 'Actual date when the financial period close was completed and the period was locked.']
  approval_status varchar
  approval_timestamp timestamp [note: 'Date and time when the period close was formally approved.']
  approver_name varchar [note: 'Name of the individual who approved the final close of this period, for reporting convenience.']
  audit_findings_count varchar [note: 'Number of audit findings or exceptions identified during the close process that require resolution.']
  balance_sheet_reconciliation_status varchar [note: 'Status of balance sheet account reconciliations for this period, ensuring all asset, liability, and equity accounts are reconciled.']
  budget_variance_review_status varchar [note: 'Status of budget-to-actual variance analysis and review for this period.']
  close_checklist_completed_items varchar [note: 'Number of checklist items that have been completed for this period close.']
  close_checklist_completion_percentage decimal(5,2) [note: 'Percentage of close checklist items completed, calculated as (completed_items / total_items) * 100.']
  close_checklist_total_items varchar [note: 'Total number of checklist items that must be completed for this period close.']
  close_completed_timestamp timestamp [note: 'Date and time when the period close process was fully completed.']
  close_date date [note: 'Close date']
  close_delay_reason varchar [note: 'Explanation for any delay in completing the period close beyond the planned close date.']
  close_efficiency_rating varchar [note: 'Qualitative assessment of the efficiency and timeliness of this period close process.']
  close_initiated_timestamp timestamp [note: 'Date and time when the period close process was initiated.']
  close_notes varchar [note: 'Additional notes, comments, or observations related to this period close process.']
  close_number varchar [note: 'Business identifier for the period close event, typically formatted as YYYY-MM-CLOSE or similar.']
  close_status varchar [note: 'Current status of the period close process. Soft close allows limited adjustments; hard close is final and locked.']
  close_type varchar [note: 'Type of financial close being performed: monthly, quarterly, annual, or adjustment period close.']
  cms_cost_report_status varchar [note: 'Status of CMS cost report preparation and submission for this period, required for Medicare reimbursement.']
  completed_timestamp timestamp
  created_timestamp timestamp [note: 'Date and time when this financial period close record was first created in the system.']
  days_to_close varchar [note: 'Number of calendar days taken to complete the close from period end date to actual close date.']
  external_audit_status varchar [note: 'Status of external audit review for this period, typically applicable for year-end closes.']
  financial_statement_preparation_status varchar [note: 'Status of financial statement preparation for this period, including balance sheet, income statement, and cash flow statement.']
  fixed_assets_close_status varchar [note: 'Status of fixed asset close activities, including depreciation calculation and asset reconciliation.']
  hard_close_date date [note: 'Date when the period was permanently closed and locked from further adjustments.']
  intercompany_reconciliation_status varchar [note: 'Status of intercompany account reconciliation for this period, ensuring balances between entities are matched.']
  modified_timestamp timestamp [note: 'Date and time when this financial period close record was last modified.']
  notes varchar
  open_items_count varchar [note: 'Number of outstanding issues or tasks that must be resolved before the period can be closed.']
  payroll_close_status varchar [note: 'Status of payroll close activities for this period, ensuring all payroll expenses and liabilities are properly recorded.']
  planned_close_date date [note: 'Target date by which the financial period close should be completed per the close calendar.']
  prior_period_adjustment_flag boolean [note: 'Indicates whether this close includes adjustments to prior closed periods.']
  regulatory_reporting_status varchar [note: 'Status of regulatory reporting submissions required for this period, such as CMS cost reports or state financial filings.']
  reopen_date date [note: 'Date when a previously closed period was reopened for adjustments, if applicable.']
  responsible_party varchar
  revenue_cycle_close_status varchar [note: 'Status of revenue cycle close activities, including patient accounts receivable reconciliation and revenue recognition.']
  soft_close_date date [note: 'Date when the period was soft closed, allowing limited adjustments before final hard close.']
  started_timestamp timestamp
  target_close_date date
  tasks_completed_count varchar
  tasks_total_count varchar
  unposted_journals_count varchar [note: 'Number of journal entries that have been entered but not yet posted to the general ledger for this period.']
  updated_timestamp timestamp
  vibe_mutation_added varchar [note: 'Added by VIBE mutation to satisfy target entity touch requirement']
  vibe_mutation_applied varchar
  vibe_mutation_extra varchar [note: 'Placeholder attribute added by VIBE mutation to ensure model change.']
  vibe_mutation_marker varchar [note: 'Marker added by VIBE mutator']
  vibe_mutation_test varchar [note: 'Added by VIBE mutation to ensure product is touched']
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']

  Note: 'Transactional record tracking the month-end, quarter-end, and year-end financial close process for the healthcare organization. Captures close period, close type (monthly, quarterly, annual), close status (open, in progress, soft close, hard close), planned close date, actual close date, close checklist completion percentage, number of open items, number of unposted journals, intercompany reconciliation status, accrual completion status, financial statement preparation status, external audit status (for year-end), and close owner. Drives the period-end close workflow and accountability.'
}

Table finance.intercompany_transaction {
  intercompany_transaction_id varchar [pk, note: 'Unique identifier for the intercompany transaction record within the integrated delivery network (IDN).']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: intercompany_transaction has cost_center_code (STRING) which should be normalized to FK to cost_center master. Enables joining to get cost center details for intercompany transaction allocation.']
  fiscal_period_id varchar [note: 'Foreign key linking to finance.fiscal_period. Business justification: intercompany_transaction has fiscal_period (STRING) which should be normalized to FK to fiscal_period master. Enables joining to get period_name, start_date, end_date, period_status, and ensures inter']
  from_financial_entity_id varchar
  intercompany_agreement_id varchar [note: 'Reference to the master intercompany agreement or service level agreement that governs the terms of this transaction.']
  intercompany_elimination_journal_entry_id varchar [note: 'Reference to the consolidation elimination journal entry that offsets this intercompany transaction in the consolidated financial statements.']
  intercompany_journal_entry_id varchar [note: 'FK to journal entry']
  originating_chart_of_accounts_id varchar [note: 'Foreign key linking to finance.chart_of_accounts. Business justification: intercompany_transaction has originating_gl_account_code (STRING) which should be normalized to FK to chart_of_accounts. Using \'originating_chart_of_accounts_id\' as the FK name to distinguish from the']
  primary_intercompany_employee_id varchar [note: 'Identifier of the user or manager who approved the intercompany transaction for processing.']
  primary_intercompany_financial_entity_id varchar [note: 'Identifier of the legal entity within the IDN that initiated or is the source of the intercompany transaction.']
  primary_reversed_transaction_intercompany_transaction_id varchar [note: 'Reference to the original intercompany transaction that this record reverses, if applicable.']
  receiving_entity_financial_entity_id varchar [note: 'Identifier of the legal entity within the IDN that receives or is the destination of the intercompany transaction.']
  target_financial_entity_id varchar
  to_financial_entity_id varchar
  amount decimal(18,2)
  approval_date date [note: 'The date on which the intercompany transaction was approved by the authorized approver for processing and posting.']
  batch_code varchar [note: 'Identifier of the batch or group of intercompany transactions processed together for efficiency and control purposes.']
  created_timestamp timestamp [note: 'The date and time when the intercompany transaction record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code indicating the currency in which the intercompany transaction amount is denominated.']
  elimination_flag boolean
  elimination_indicator boolean [note: 'Flag indicating whether this intercompany transaction requires elimination during the consolidated financial statement preparation process.']
  elimination_period varchar [note: 'The fiscal period identifier in which the intercompany elimination entry will be or was recorded for consolidation purposes.']
  exchange_rate decimal(12,6) [note: 'The foreign exchange rate applied to convert the transaction amount from the transaction currency to the functional currency.']
  fiscal_year varchar [note: 'The fiscal year in which the intercompany transaction was recorded for financial reporting and consolidation purposes.']
  functional_currency_amount decimal(18,2) [note: 'The transaction amount converted to the functional currency of the consolidated entity for financial reporting purposes.']
  intercompany_transaction_description varchar [note: 'Detailed narrative description of the intercompany transaction explaining the business purpose and nature of the transfer.']
  modified_timestamp timestamp [note: 'The date and time when the intercompany transaction record was last modified or updated in the system.']
  notes varchar [note: 'Additional free-text notes or comments related to the intercompany transaction for audit trail and clarification purposes.']
  originating_entity_code varchar [note: 'Business code or abbreviation of the originating legal entity for reporting and identification purposes.']
  posted_timestamp timestamp [note: 'The date and time when the intercompany transaction was posted to the general ledger systems of both entities.']
  posting_date date [note: 'The date on which the intercompany transaction was posted to the general ledger of both originating and receiving entities.']
  posting_status varchar
  receiving_entity_code varchar [note: 'Business code or abbreviation of the receiving legal entity for reporting and identification purposes.']
  receiving_entity_id varchar
  receiving_gl_account_code varchar [note: 'The general ledger account code in the receiving entity\'s chart of accounts to which this transaction is posted.']
  reconciliation_date date [note: 'The date on which the intercompany transaction was successfully reconciled between the originating and receiving entities.']
  reconciliation_status varchar [note: 'Status indicating whether the intercompany transaction has been successfully reconciled between the originating and receiving entities.']
  reconciliation_variance_amount decimal(18,2) [note: 'The monetary difference identified during reconciliation between the originating and receiving entity records for this transaction.']
  reversal_indicator boolean [note: 'Flag indicating whether this intercompany transaction is a reversal of a previously posted transaction.']
  sending_entity_id varchar
  service_line_code varchar [note: 'The service line or business unit code associated with the intercompany transaction for segment reporting and profitability analysis.']
  settlement_date date
  settlement_status varchar
  source_financial_entity_id varchar
  source_system_code varchar [note: 'Code identifying the originating system or application from which the intercompany transaction data was sourced (e.g., SAP, Epic, Oracle).']
  source_transaction_reference varchar [note: 'The unique transaction identifier from the source system that originated this intercompany transaction record.']
  supporting_document_reference varchar [note: 'Reference number or identifier of supporting documentation (invoices, agreements, memos) that substantiate the intercompany transaction.']
  tax_amount decimal(18,2) [note: 'The tax amount associated with the intercompany transaction, if applicable, for jurisdictions requiring intercompany taxation.']
  tax_code varchar [note: 'The tax classification code applied to the intercompany transaction for tax reporting and compliance purposes.']
  transaction_amount decimal(18,2) [note: 'The monetary value of the intercompany transaction in the specified currency, representing the gross amount transferred between entities.']
  transaction_date date [note: 'The date on which the intercompany transaction was executed or recorded in the originating entity\'s books.']
  transaction_description varchar
  transaction_number varchar [note: 'Business-facing unique transaction number assigned to the intercompany transaction for tracking and reference purposes.']
  transaction_status varchar [note: 'Current lifecycle status of the intercompany transaction indicating its processing state and readiness for consolidation. [ENUM-REF-CANDIDATE: draft|pending_approval|approved|posted|reconciled|eliminated|rejected — 7 candidates stripped; promote to reference product]']
  transaction_type varchar [note: 'Classification of the intercompany transaction indicating the nature of the financial activity between legal entities.']
  updated_timestamp timestamp
  vibe_mutation_added varchar [note: 'Added by VIBE mutation to satisfy target entity touch requirement']
  vibe_mutation_applied varchar
  vibe_mutation_extra varchar [note: 'Placeholder attribute added by VIBE mutation to ensure model change.']
  vibe_mutation_marker varchar [note: 'Marker added by VIBE mutator']
  vibe_mutation_test varchar [note: 'Added by VIBE mutation to ensure product is touched']
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']

  Note: 'Transactional record of financial transactions between legal entities within the healthcare integrated delivery network (IDN), including management fees, shared service charges, intercompany loans, and cost transfers. Captures transaction date, transaction type (management fee, shared service charge, intercompany loan, cost transfer, intercompany sale), originating entity, receiving entity, transaction amount, currency, GL account (originating), GL account (receiving), cost center, elimination indicator, elimination period, and reconciliation status. Supports consolidated financial statement preparation and intercompany elimination.'
}

Table finance.financial_entity {
  financial_entity_id varchar [pk, note: 'Unique identifier for the financial entity record. Primary key.']
  care_site_id varchar
  parent_entity_financial_entity_id varchar [note: 'Reference to the parent financial entity in the corporate hierarchy. Null for top-level holding companies.']
  parent_financial_entity_id varchar [note: 'Self-referencing FK on financial_entity (parent_financial_entity_id)']
  accounting_basis varchar [note: 'Primary accounting framework used for financial reporting. GAAP = Generally Accepted Accounting Principles, GASB = Governmental Accounting Standards Board, IFRS = International Financial Reporting Standards.']
  cms_provider_number varchar [note: 'CMS Certification Number (CCN) assigned to Medicare-certified facilities for billing and reimbursement.']
  consolidation_method varchar [note: 'Accounting method used to consolidate this entity into parent financial statements.']
  created_timestamp timestamp [note: 'Timestamp when this financial entity record was first created in the system.']
  currency_code varchar
  duns_number varchar [note: 'Nine-digit Dun & Bradstreet identifier used for business credit and vendor management.']
  effective_end_date date [note: 'Date when this entity record ceased to be effective. Null for currently active entities.']
  effective_start_date date [note: 'Date when this entity record became effective for financial reporting and consolidation purposes.']
  entity_code varchar [note: 'Unique business identifier code for the legal entity used across financial systems and reporting.']
  entity_description varchar [note: 'Detailed narrative description of the entity\'s business purpose, services, and role within the corporate structure.']
  entity_name varchar [note: 'The full legal name of the entity as registered with regulatory authorities.']
  entity_status varchar [note: 'Current operational and legal status of the entity within the corporate structure.']
  entity_subtype varchar [note: 'Additional classification detail for the entity type (e.g., acute care hospital, specialty clinic, MSSP ACO).']
  entity_type varchar [note: 'Classification of the legal entity type within the healthcare organization structure. ACO = Accountable Care Organization.']
  external_auditor_name varchar [note: 'Name of the external audit firm responsible for auditing this entity\'s financial statements.']
  federal_tax_identification_number varchar
  fiscal_year_end_day varchar [note: 'Day of month (1-31) representing the end of the entity\'s fiscal year.']
  fiscal_year_end_month varchar [note: 'Month number (1-12) representing the end of the entity\'s fiscal year for financial reporting purposes.']
  functional_currency_code varchar [note: 'Three-letter ISO 4217 currency code representing the primary currency in which the entity conducts business and maintains its books.']
  incorporation_date date [note: 'Date the entity was legally incorporated or established.']
  intercompany_elimination_flag boolean [note: 'Indicates whether intercompany transactions involving this entity require elimination entries during consolidation.']
  joint_venture_flag boolean [note: 'Indicates whether this entity is a joint venture with external partners requiring special consolidation treatment.']
  last_audit_date date [note: 'Date of the most recent completed external financial audit for this entity.']
  legal_entity_address_line1 varchar [note: 'Primary street address line for the entity\'s legal registered address.']
  legal_entity_address_line2 varchar [note: 'Secondary address line (suite, floor, building) for the entity\'s legal registered address.']
  legal_entity_city varchar [note: 'City name for the entity\'s legal registered address.']
  legal_entity_country_code varchar [note: 'Three-letter ISO 3166-1 alpha-3 country code for the entity\'s legal registered address.']
  legal_entity_postal_code varchar [note: 'ZIP or postal code for the entity\'s legal registered address.']
  legal_entity_state varchar [note: 'Two-letter US state code for the entity\'s legal registered address.']
  legal_name varchar
  medicare_cost_report_required_flag boolean [note: 'Indicates whether this entity is required to file an annual Medicare cost report with CMS.']
  modified_timestamp timestamp [note: 'Timestamp when this financial entity record was last modified.']
  notes varchar
  npi varchar [note: 'National Provider Identifier assigned by CMS for healthcare entities that bill for services. Applicable to hospitals, physician groups, and other provider entities.']
  ownership_percentage decimal(5,2) [note: 'Percentage of ownership interest held by the parent entity, used for consolidation calculations.']
  primary_contact_email varchar [note: 'Primary email address for business contact with this entity.']
  primary_contact_name varchar [note: 'Name of the primary business contact or officer for this entity.']
  primary_contact_phone varchar [note: 'Primary phone number for business contact with this entity.']
  regulatory_reporting_tier varchar [note: 'Classification tier determining the level of regulatory reporting required for this entity based on size, revenue, or patient volume.']
  reporting_entity_flag boolean [note: 'Indicates whether this entity produces standalone financial statements for external reporting.']
  state_of_incorporation varchar [note: 'Two-letter US state code where the entity is legally incorporated or registered.']
  tax_exempt_status varchar [note: 'IRS tax-exempt classification for the entity. 501(c)(3) is common for nonprofit hospitals and foundations.']
  tax_identification_number varchar [note: 'Tax ID']
  tax_identifier varchar [note: 'Federal Employer Identification Number (EIN) assigned by the IRS for tax reporting purposes.']
  tax_status varchar
  updated_timestamp timestamp
  vibe_mutation_added varchar [note: 'Added by VIBE mutation to satisfy target entity touch requirement']
  vibe_mutation_applied varchar
  vibe_mutation_extra varchar [note: 'Placeholder attribute added by VIBE mutation to ensure model change.']
  vibe_mutation_marker varchar [note: 'Marker added by VIBE mutator']
  vibe_mutation_test varchar [note: 'Added by VIBE mutation to ensure product is touched']
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']

  Note: 'Master record for each legal entity, subsidiary, and reporting unit within the healthcare organization\'s corporate structure. Captures entity code, entity name, entity type (hospital, physician group, foundation, ACO, health plan, holding company, joint venture), tax ID (EIN), NPI (if applicable), state of incorporation, fiscal year end, functional currency, consolidation method (full consolidation, equity method, proportional), parent entity, GAAP vs GASB reporting basis, CMS provider number, and entity status. Drives intercompany elimination and consolidated financial reporting.'
}

Table finance.fund {
  fund_id varchar [pk, note: 'Unique identifier for the fund record. Primary key for the fund entity.']
  care_site_id varchar [note: 'Reference to the primary facility or hospital associated with this fund for facility-level financial reporting.']
  financial_entity_id varchar [note: 'Foreign key linking to finance.financial_entity. Business justification: fund has legal_entity_id (BIGINT) which should be normalized to FK to financial_entity. The attribute name uses \'legal_entity\' but should point to financial_entity.financial_entity_id. Enables joining']
  parent_fund_id varchar [note: 'Reference to a parent fund if this fund is a sub-fund or component of a larger fund structure.']
  primary_consolidation_fund_id varchar [note: 'Reference to the fund into which this fund rolls up for consolidated financial reporting.']
  approval_date date [note: 'Date when the fund was formally approved for use in financial transactions.']
  approval_status varchar [note: 'Current approval status of the fund setup, indicating whether it has been reviewed and authorized for use.']
  balance decimal(18,2) [note: 'Current balance of the fund representing the difference between fund assets and liabilities. For endowments, represents the corpus and accumulated earnings.']
  beginning_balance decimal(18,2) [note: 'Fund balance at the start of the current fiscal period, used for reconciliation and variance analysis.']
  closure_date date [note: 'Date when the fund was formally closed and all balances transferred or depleted.']
  closure_reason varchar [note: 'Explanation for why the fund was closed, such as purpose fulfilled, grant expired, or donor request.']
  cms_provider_number varchar [note: 'Six-digit CMS provider number associated with the fund for Medicare cost reporting and reimbursement tracking.']
  created_timestamp timestamp [note: 'System timestamp when the fund record was first created in the database.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code indicating the functional currency of the fund.']
  donor_id varchar [note: 'Reference to the donor entity in the donor management system for restricted and endowment funds.']
  donor_restriction_indicator boolean [note: 'Flag indicating whether the fund is subject to donor-imposed restrictions requiring separate tracking and reporting.']
  effective_end_date date [note: 'Date when the fund was closed or became inactive, if applicable. Null for active funds.']
  effective_start_date date [note: 'Date when the fund became active and available for financial transactions.']
  endowment_corpus_amount decimal(18,2) [note: 'Original principal amount of an endowment fund that must be maintained in perpetuity per donor restrictions.']
  establishment_date date [note: 'Date when the fund was originally established or created in the financial system.']
  fund_balance decimal(18,2)
  fund_category varchar [note: 'Broad category grouping for the fund used for financial statement presentation and consolidation. [ENUM-REF-CANDIDATE: operating|restricted|endowment|capital|agency|plant|debt_service — 7 candidates stripped; promote to reference product]']
  fund_code varchar [note: 'Unique alphanumeric code assigned to the fund for identification in financial transactions and reporting. This is the externally-known business identifier used across systems.']
  fund_name varchar [note: 'Full descriptive name of the fund as it appears in financial statements and reports.']
  fund_purpose varchar
  fund_status varchar [note: 'Current lifecycle status of the fund indicating whether it is available for transactions and reporting.']
  fund_type varchar [note: 'Classification of the fund based on restriction and purpose. Determines accounting treatment and reporting requirements for not-for-profit healthcare organizations.']
  funding_source varchar [note: 'Description of the source of funds, such as federal grant, state appropriation, private donation, or operating revenue.']
  grant_number varchar [note: 'External grant or award number assigned by the funding agency for grant-type funds, used for compliance and reporting.']
  investment_policy_code varchar [note: 'Code referencing the investment policy governing how fund assets may be invested, particularly for endowment and capital funds.']
  is_restricted boolean
  modified_timestamp timestamp [note: 'System timestamp when the fund record was last modified.']
  notes varchar [note: 'Free-text field for additional information, special instructions, or historical context about the fund.']
  purpose varchar [note: 'Business purpose and intended use of the fund, describing the programs, services, or capital projects it supports.']
  regulatory_reporting_required boolean [note: 'Flag indicating whether this fund is subject to external regulatory reporting requirements such as CMS cost reports or state financial filings.']
  reporting_requirements varchar [note: 'Detailed description of specific reporting obligations, frequencies, and regulatory bodies to which fund activity must be reported.']
  restriction_description varchar [note: 'Detailed narrative describing the specific restrictions, donor stipulations, or regulatory requirements governing the use of fund assets.']
  restriction_type varchar [note: 'Type of restriction placed on the fund indicating the source and nature of limitations on fund usage.']
  spending_policy varchar
  spending_policy_rate decimal(5,4) [note: 'Annual percentage rate at which endowment earnings may be spent, as defined by board policy or donor agreement.']
  updated_timestamp timestamp
  vibe_mutation_added varchar [note: 'Added by VIBE mutation to satisfy target entity touch requirement']
  vibe_mutation_applied varchar
  vibe_mutation_extra varchar [note: 'Placeholder attribute added by VIBE mutation to ensure model change.']
  vibe_mutation_marker varchar [note: 'Marker added by VIBE mutator']
  vibe_mutation_test varchar [note: 'Added by VIBE mutation to ensure product is touched']
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']

  Note: 'Master record for all funds used in healthcare fund accounting, including operating funds, restricted funds, endowment funds, capital funds, and grant funds. Captures fund code, fund name, fund type (unrestricted operating, temporarily restricted, permanently restricted, endowment, capital, grant, agency), restriction description, donor restriction indicator, fund purpose, fund balance, fund status (active, closed, depleted), associated legal entity, fund manager, and applicable regulatory or donor reporting requirements. Essential for not-for-profit healthcare fund accounting compliance.'
}

Table finance.financial_forecast {
  financial_forecast_id varchar [pk, note: 'Unique identifier for the financial forecast record. Primary key.']
  approver_employee_id varchar [note: 'Identifier of the executive or manager who approved this forecast. Links to the employee or workforce management system.']
  care_site_id varchar [note: 'Identifier of the healthcare facility or entity to which this forecast applies. Supports facility-level and consolidated financial planning.']
  cost_center_id varchar [note: 'Identifier of the cost center to which this forecast applies, if the forecast is prepared at the cost center level rather than enterprise-wide.']
  financial_employee_id varchar [note: 'System user identifier of the person who created this forecast record. Supports audit trail and accountability.']
  financial_entity_id varchar [note: 'Foreign key linking to finance.financial_entity. Business justification: financial_forecast should link to financial_entity to identify which legal entity the forecast belongs to. This is essential for multi-entity healthcare organizations to track forecasts by subsidiary.']
  financial_modified_by_user_employee_id varchar [note: 'System user identifier of the person who last modified this forecast record. Supports audit trail and accountability.']
  org_unit_id varchar [note: 'Identifier of the department to which this forecast applies, if the forecast is prepared at the department level.']
  parent_financial_forecast_id varchar [note: 'Identifier of the parent forecast if this forecast is a component of a larger consolidated forecast. Supports hierarchical financial planning structures.']
  primary_financial_preparer_employee_id varchar [note: 'Identifier of the finance team member who prepared this forecast. Links to the employee or workforce management system.']
  primary_superseded_by_financial_forecast_id varchar [note: 'Identifier of the newer forecast that supersedes this one. Null if this is the current active forecast. Supports version history and audit trail.']
  approval_date date [note: 'Date on which the forecast was formally approved by the designated authority. Marks the transition to official plan of record.']
  approval_status varchar
  assumptions_narrative varchar [note: 'Detailed narrative documenting the key assumptions, drivers, and rationale underlying the forecast. Includes market conditions, volume assumptions, rate assumptions, cost inflation factors, strategic initiatives, and risk factors.']
  baseline_flag boolean [note: 'Indicates whether this forecast version is the official baseline plan of record against which actual performance will be measured. True if baseline, False otherwise.']
  board_presentation_date date [note: 'Date on which this forecast was presented to the board of directors or trustees. Null if not presented.']
  board_presentation_flag boolean [note: 'Indicates whether this forecast was presented to the board of directors or trustees. True if presented, False otherwise. Used for governance and reporting tracking.']
  created_timestamp timestamp [note: 'Date and time when this forecast record was first created in the system. Supports audit trail and data lineage.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts in this forecast (e.g., USD for US Dollar). Ensures consistent financial reporting across multi-currency environments.']
  fiscal_year varchar [note: 'The fiscal year to which this forecast applies, represented as a four-digit year (e.g., 2024). Aligns with the organization\'s fiscal calendar.']
  forecast_horizon varchar
  forecast_method varchar
  forecast_methodology varchar [note: 'The forecasting technique or approach used to develop the projections. Trend analysis extrapolates historical patterns, driver-based links to operational metrics, zero-based builds from scratch, activity-based costs by activity, regression uses statistical models. [ENUM-REF-CANDIDATE: trend_analysis|driver_based|zero_based|activity_based|regression_model|scenario_planning|hybrid — 7 candidates stripped; promote to reference product]']
  forecast_name varchar [note: 'Descriptive name of the financial forecast, typically indicating the planning cycle or scenario (e.g., FY2024 Q2 Rolling Forecast, Long-Range Strategic Plan 2024-2028).']
  forecast_number varchar [note: 'Business-assigned unique identifier for the forecast, used for external reference and tracking across financial planning cycles.']
  forecast_period_end_date date [note: 'The last date of the period covered by this forecast. Defines the end of the planning horizon.']
  forecast_period_months varchar [note: 'Number of months covered by the forecast period. Typical values include 12 for annual plans, 18-24 for rolling forecasts, and 36-60 for long-range plans.']
  forecast_period_start_date date [note: 'The first date of the period covered by this forecast. Defines the beginning of the planning horizon.']
  forecast_scenario varchar
  forecast_status varchar [note: 'Current lifecycle state of the forecast. Draft indicates work in progress, submitted awaits review, approved is finalized, baseline is the official plan of record, superseded has been replaced by a newer version. [ENUM-REF-CANDIDATE: draft|submitted|under_review|approved|baseline|superseded|archived — 7 candidates stripped; promote to reference product]']
  forecast_type varchar [note: 'Classification of the forecast methodology and planning horizon. Rolling forecasts update continuously, annual operating plans cover a single fiscal year, long-range plans span multiple years, and scenario analyses model alternative futures.']
  forecast_version varchar [note: 'Version identifier for the forecast, enabling tracking of iterations and revisions (e.g., V1.0, V2.1, Q2 Update). Supports audit trail and version control.']
  forecasted_cmi decimal(5,4) [note: 'Projected average case mix index for the forecast period, reflecting the expected complexity and resource intensity of patient cases. Used for revenue and cost modeling under DRG-based payment systems.']
  forecasted_fte_count decimal(10,2) [note: 'Projected total full-time equivalent staffing levels for the forecast period. Critical for labor cost planning and productivity analysis.']
  forecasted_patient_volume varchar [note: 'Projected total patient encounters or admissions for the forecast period. Key volume driver for revenue and resource planning.']
  modified_timestamp timestamp [note: 'Date and time when this forecast record was last modified. Supports audit trail and change tracking.']
  notes varchar [note: 'Free-text field for additional comments, context, or special instructions related to this forecast. Used for collaboration and documentation.']
  scenario varchar
  scenario_description varchar [note: 'Description of the scenario being modeled (e.g., base case, best case, worst case, strategic initiative impact). Used for scenario analysis and sensitivity testing.']
  service_line_code varchar [note: 'Code identifying the clinical service line to which this forecast applies (e.g., cardiology, orthopedics, oncology). Supports service line financial planning and performance management.']
  submission_date date [note: 'Date on which the forecast was submitted for review and approval. Tracks the workflow progression.']
  total_forecast_expense decimal(18,2)
  total_forecast_revenue decimal(18,2)
  total_forecasted_capital_expenditure decimal(18,2) [note: 'Total projected capital spending for the forecast period, including facility construction, equipment purchases, technology investments, and major renovations.']
  total_forecasted_expense decimal(18,2) [note: 'Total projected operating expenses for the forecast period, including salaries and benefits, supplies, purchased services, depreciation, and other operating costs.']
  total_forecasted_net_income decimal(18,2) [note: 'Projected net income after all revenues, expenses, non-operating items, and taxes. Bottom line of the forecasted income statement.']
  total_forecasted_operating_income decimal(18,2) [note: 'Projected operating income (revenue minus expenses) for the forecast period. Key performance metric for financial sustainability and operational efficiency.']
  total_forecasted_revenue decimal(18,2) [note: 'Total projected operating revenue for the forecast period, including patient service revenue, capitation revenue, and other operating income. Represents the top line of the forecasted income statement.']
  updated_timestamp timestamp
  version varchar
  vibe_mutation_added varchar [note: 'Added by VIBE mutation to satisfy target entity touch requirement']
  vibe_mutation_applied varchar
  vibe_mutation_extra varchar [note: 'Placeholder attribute added by VIBE mutation to ensure model change.']
  vibe_mutation_marker varchar [note: 'Marker added by VIBE mutator']
  vibe_mutation_test varchar [note: 'Added by VIBE mutation to ensure product is touched']
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']

  Note: 'Master record for rolling financial forecasts and financial planning scenarios prepared by the healthcare finance team. Captures forecast name, forecast type (rolling forecast, annual operating plan, long-range plan, scenario analysis), fiscal year, forecast version, forecast status (draft, submitted, approved, baseline), forecast period coverage (months), total forecasted revenue, total forecasted expense, total forecasted operating income, forecast methodology, assumptions narrative, preparer, approver, and approval date. Supports financial planning and analysis (FP&A) and board-level financial reporting.'
}

Table finance.forecast_line {
  forecast_line_id varchar [pk, note: 'Unique identifier for the forecast line item. Primary key for the forecast line entity.']
  chart_of_accounts_id varchar [note: 'Foreign key linking to finance.chart_of_accounts. Business justification: forecast_line has gl_account_code (STRING) which should be normalized to FK to chart_of_accounts. Enables joining to get account metadata and ensures forecast lines reference valid GL accounts.']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: forecast_line has cost_center_code (STRING) which should be normalized to FK to cost_center master. Enables joining to get cost center details and ensures referential integrity.']
  financial_forecast_id varchar [note: 'Reference to the parent financial forecast header that this line belongs to. Links to the forecast master record.']
  fiscal_period_id varchar
  fund_id varchar [note: 'Foreign key linking to finance.fund. Business justification: forecast_line has fund_code (STRING) which should be normalized to FK to fund master. Enables joining to get fund details and ensures forecast lines reference valid funds.']
  prior_forecast_line_id varchar [note: 'Self-referencing FK on forecast_line (prior_forecast_line_id)']
  allocation_method varchar [note: 'Method used to allocate or distribute the forecasted amount across cost centers, departments, or service lines (e.g., direct assignment, proportional allocation, activity-based). Documents allocation transparency.']
  allocation_percentage decimal(5,2) [note: 'Percentage of the total forecasted amount allocated to this specific cost center or service line. Used when forecast amounts are distributed across multiple organizational units.']
  approval_status varchar [note: 'Current approval workflow status of this forecast line (draft, submitted, approved, rejected, revised). Tracks governance and authorization of forecast assumptions.']
  approved_by varchar [note: 'Name or identifier of the user or role who approved this forecast line. Provides audit trail for forecast authorization.']
  approved_date date [note: 'Date on which this forecast line was formally approved. Establishes the effective date of forecast commitment.']
  created_timestamp timestamp [note: 'Timestamp when this forecast line record was first created in the system. Provides audit trail for data lineage.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the forecasted amount (e.g., USD, EUR, GBP). Supports multi-currency financial planning.']
  current_budget_amount decimal(18,2) [note: 'The approved budget amount for the same GL account, cost center, and fiscal period. Enables forecast-to-budget variance analysis.']
  driver_assumption varchar
  effective_end_date date [note: 'Date on which this forecast line ceases to be effective. Nullable for currently active forecast lines. Supports historical forecast analysis.']
  effective_start_date date [note: 'Date from which this forecast line becomes effective. Supports time-based forecast versioning and historical tracking.']
  fiscal_period varchar [note: 'The fiscal period (month, quarter, or other sub-annual period) within the fiscal year for which this forecast line projects financial activity.']
  fiscal_year varchar [note: 'The fiscal year to which this forecast line applies. Represents the annual financial planning period.']
  forecast_amount decimal(18,2) [note: 'Forecast amount']
  forecast_category varchar [note: 'High-level classification of the forecast line into major financial statement categories: revenue, salary expense, non-salary expense, capital expenditure, or other.']
  forecast_confidence_level varchar [note: 'Qualitative assessment of the reliability and certainty of this forecast line (high, medium, low). Reflects data quality, volatility, and external risk factors.']
  forecast_scenario varchar [note: 'Scenario or case identifier for this forecast line (e.g., base case, best case, worst case, strategic initiative). Supports scenario planning and sensitivity analysis.']
  forecast_version varchar [note: 'Version identifier for the forecast (e.g., Q1 Forecast, Mid-Year Reforecast, Year-End Projection). Tracks forecast iterations and updates throughout the fiscal year.']
  forecasted_amount decimal(18,2) [note: 'The projected financial amount for this GL account, cost center, and fiscal period combination. Represents the best estimate of future financial performance.']
  fte_count decimal(10,2) [note: 'Forecasted number of Full-Time Equivalent staff positions associated with this line, particularly relevant for salary expense forecasts. Supports workforce planning integration.']
  grant_number varchar [note: 'Grant or award identifier if this forecast line is funded by a specific grant. Links forecast to grant management and compliance tracking.']
  is_capital boolean [note: 'Boolean flag indicating whether this forecast line represents a capital expenditure (True) or an operating expense/revenue (False). Supports capital budgeting and cash flow planning.']
  is_restricted boolean [note: 'Boolean flag indicating whether this forecast line is associated with restricted funds or grants (True) or unrestricted general operating funds (False). Critical for fund accounting compliance.']
  line_description varchar
  line_notes varchar [note: 'Free-text notes or comments providing additional context, assumptions, or explanations for this forecast line. Supports collaborative planning and documentation.']
  line_number varchar [note: 'Sequential line number within the parent forecast, used for ordering and referencing specific forecast line items.']
  modified_by varchar [note: 'User identifier or name of the person who last modified this forecast line record. Supports change tracking and accountability.']
  modified_timestamp timestamp [note: 'Timestamp when this forecast line record was last modified. Tracks the most recent update to the forecast data.']
  prior_period_actual decimal(18,2)
  prior_year_actual_amount decimal(18,2) [note: 'The actual financial result for the same GL account, cost center, and fiscal period in the prior year. Provides historical baseline for variance analysis.']
  project_code varchar [note: 'Project or initiative identifier for capital projects or strategic initiatives. Enables project-based financial tracking and reporting.']
  service_line_code varchar [note: 'Clinical or operational service line classification (e.g., cardiology, orthopedics, emergency services) for revenue and expense attribution.']
  statistical_basis varchar [note: 'Description of the statistical or analytical method used to derive the forecast (e.g., trend analysis, regression, historical average, zero-based). Documents forecast rigor and reliability.']
  variance_amount decimal(18,2)
  variance_percent decimal(5,2)
  variance_to_budget decimal(18,2) [note: 'Calculated variance between the forecasted amount and the current budget amount (forecast minus budget). Highlights deviations from the approved financial plan.']
  variance_to_prior_year decimal(18,2) [note: 'Calculated variance between the forecasted amount and the prior year actual amount (forecast minus prior year). Measures year-over-year growth or decline.']
  vibe_mutation_added varchar [note: 'Added by VIBE mutation to satisfy target entity touch requirement']
  vibe_mutation_applied varchar
  vibe_mutation_extra varchar [note: 'Placeholder attribute added by VIBE mutation to ensure model change.']
  vibe_mutation_marker varchar [note: 'Marker added by VIBE mutator']
  vibe_mutation_test varchar [note: 'Added by VIBE mutation to ensure product is touched']
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']
  volume_assumption decimal(18,2)
  volume_driver_assumption varchar [note: 'Description of the key volume or activity driver underlying this forecast (e.g., patient days, surgical cases, outpatient visits, Full-Time Equivalents). Provides transparency into forecast methodology.']
  volume_quantity decimal(18,2) [note: 'Numeric quantity of the volume driver assumed in this forecast line. Enables calculation of per-unit rates and variance analysis.']
  volume_unit varchar [note: 'Unit of measure for the volume driver (e.g., patient days, cases, visits, FTE, admissions). Standardizes volume metrics across forecast lines.']
  created_by varchar [note: 'User identifier or name of the person who created this forecast line record. Supports accountability and audit trail.']

  Note: 'Individual line-item detail within a financial forecast, representing the projected financial amount for a specific GL account, cost center, and fiscal period combination. Captures forecast reference, GL account code, cost center, fund, service line, fiscal period, forecasted amount, forecast category (revenue, salary expense, non-salary expense, capital), volume driver assumption, statistical basis, prior year actual amount, current budget amount, and variance to budget. Enables granular FP&A drill-down and variance analysis between forecast, budget, and actuals.'
}

Table finance.invoice_payment_application {
  invoice_payment_application_id varchar [pk, note: 'Unique identifier for this payment application record. Primary key.']
  ap_invoice_id varchar [note: 'Foreign key linking to the accounts payable invoice being paid or settled by this payment application.']
  ap_invoice_line_id varchar
  ap_payment_id varchar [note: 'Foreign key linking to the accounts payable payment being applied to settle the invoice.']
  created_by_employee_id varchar [note: 'Identifier of the employee or system user who created this payment application record.']
  amount_applied decimal(18,2) [note: 'The monetary amount of this payment that was applied to settle this specific invoice. For partial payments, this will be less than the total payment amount. For split payments across multiple invoices, the sum of amount_applied across all applications equals the total payment amount.']
  amount_paid decimal(18,2) [note: 'The total amount that has been paid against this invoice to date. May be less than total_amount for partial payments. [Moved from ap_invoice: This attribute represents the total amount paid against an invoice, which is actually the SUM of amount_applied across all payment applications for this invoice. It is a derived/calculated value that belongs in the association layer, not as a standalone attribute on the invoice.]']
  amount_remaining decimal(18,2) [note: 'The outstanding balance remaining to be paid on this invoice, calculated as total_amount - amount_paid. [Moved from ap_invoice: This attribute represents the outstanding balance on an invoice, which is calculated as total_amount minus the sum of amount_applied from all payment applications. It is a derived value that should be calculated from the association data, not stored redundantly on the invoice.]']
  application_date date [note: 'The date on which this payment was applied to this invoice in the accounts payable system. This is the business event date for the payment allocation and may differ from the payment_date if payments are applied retroactively or in batch processes.']
  application_sequence varchar [note: 'The sequence number of this application when a single payment is applied to multiple invoices. Used to track the order in which payment funds were allocated across invoices, which is important for cash application rules and aging calculations.']
  application_status varchar [note: 'The current status of this payment application. Values: applied (payment successfully applied to invoice), reversed (application was reversed due to payment void or correction), pending (application awaiting approval or clearing), cleared (application confirmed and reconciled).']
  applied_amount decimal(18,2) [note: 'Applied amount']
  created_timestamp timestamp [note: 'System timestamp when this payment application record was created.']
  currency_code varchar
  discount_taken decimal(18,2) [note: 'The early payment discount amount taken on this specific invoice as part of this payment application. If a payment covers multiple invoices, each invoice may have a different discount amount based on its payment terms and timing.']
  discount_taken_amount decimal(18,2)
  modified_timestamp timestamp
  notes varchar
  payment_date date [note: 'The date the payment was issued to the vendor. [Moved from ap_invoice: An invoice can be paid by multiple payments on different dates. The payment_date belongs to the payment entity (ap_payment), and the relationship between invoice and payment is captured through the application_date in the association. This attribute on the invoice is ambiguous when multiple payments exist.]']
  remaining_balance decimal(18,2)
  reversal_date date [note: 'The date on which this payment application was reversed or voided. Null if the application has not been reversed.']
  reversal_flag boolean
  reversal_reason varchar [note: 'Business reason or explanation for why this payment application was reversed. Null if not reversed.']
  updated_timestamp timestamp
  vibe_mutation_added varchar [note: 'Added by VIBE mutation to satisfy target entity touch requirement']
  vibe_mutation_applied varchar
  vibe_mutation_extra varchar [note: 'Placeholder attribute added by VIBE mutation to ensure model change.']
  vibe_mutation_marker varchar [note: 'Marker added by VIBE mutator']
  vibe_mutation_test varchar [note: 'Added by VIBE mutation to ensure product is touched']
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']
  writeoff_amount decimal(18,2)

  Note: 'This association product represents the application of a payment to an invoice in the accounts payable process. It captures the specific allocation of payment funds to settle invoice balances, including partial payments, overpayments, and payment reversals. Each record links one ap_invoice to one ap_payment with attributes that exist only in the context of this payment application event.. Existence Justification: In healthcare accounts payable operations, a single vendor invoice can be paid through multiple payments (partial payments, installment payments, or corrections), and a single payment disbursement can be applied to settle multiple invoices from the same vendor (batch payment allocation). Finance teams actively manage payment applications as a distinct business process, tracking which portion of each payment settles which invoice, including discount calculations, application sequencing, and reversal handling.'
}

Table finance.fund_allocation {
  fund_allocation_id varchar [pk, note: 'Unique surrogate identifier for the fund allocation record. Primary key for the association.']
  approved_by_employee_id varchar [note: 'Reference to the employee who approved this fund allocation. Used for accountability and audit trail.']
  chart_of_accounts_id varchar
  cost_center_id varchar [note: 'FK to cost center']
  fiscal_period_id varchar
  fund_id varchar [note: 'Foreign key linking to the fund being allocated to the organizational provider']
  org_provider_id varchar [note: 'Foreign key linking to the organizational provider receiving fund allocation']
  allocated_amount decimal(18,2)
  allocation_amount decimal(18,2) [note: 'Fixed dollar amount allocated to this organizational provider from the fund, if allocation is amount-based rather than percentage-based. Mutually exclusive with allocation_percentage in business logic.']
  allocation_date date [note: 'Allocation date']
  allocation_percentage decimal(5,4) [note: 'Percentage of the fund allocated to this organizational provider. Used for proportional expense allocation and fund balance distribution. Must sum to 1.0000 across all allocations for a given fund.']
  allocation_purpose varchar [note: 'Specific purpose or program for which this fund is allocated to the organizational provider. May be more granular than the fund-level purpose, capturing provider-specific use cases (e.g., \'Cardiology equipment upgrade\' within a broader capital fund).']
  allocation_status varchar
  approval_date date [note: 'Date when this fund allocation was formally approved by the board, finance committee, or authorized approver. Required for audit trail and governance compliance.']
  created_timestamp timestamp [note: 'Created']
  currency_code varchar
  effective_date date [note: 'Date when this fund allocation became active and available for transaction posting. Used for period-specific fund accounting and historical allocation tracking.']
  end_date date [note: 'Date when this fund allocation ended or was terminated. Null for currently active allocations. Used for historical tracking and fund reallocation management.']
  fiscal_year varchar
  fund_allocation_status varchar [note: 'Current lifecycle status of the fund allocation. Drives whether transactions can be posted against this allocation.']
  modified_timestamp timestamp
  notes varchar [note: 'Free-text notes capturing allocation-specific details, restrictions, or special handling instructions not captured in structured fields.']
  reporting_requirements varchar [note: 'Specific reporting obligations associated with this fund allocation, including frequency, format, and recipient (e.g., quarterly donor report, annual CMS cost report Schedule A). May differ from fund-level reporting requirements based on allocation-specific stipulations.']
  restriction_compliance_flag boolean
  restriction_compliance_status varchar [note: 'Current compliance status of this allocation with respect to donor restrictions, grant stipulations, or regulatory requirements. Drives audit flags and reporting requirements.']
  updated_timestamp timestamp
  vibe_mutation_added varchar [note: 'Added by VIBE mutation to satisfy target entity touch requirement']
  vibe_mutation_applied varchar
  vibe_mutation_extra varchar [note: 'Placeholder attribute added by VIBE mutation to ensure model change.']
  vibe_mutation_marker varchar [note: 'Marker added by VIBE mutator']
  vibe_mutation_test varchar [note: 'Added by VIBE mutation to ensure product is touched']
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']

  Note: 'This association product represents the allocation relationship between organizational providers and funds in healthcare fund accounting. It captures how restricted and unrestricted funds are allocated across organizational entities (hospitals, clinics, facilities) for compliance tracking, donor restriction management, and regulatory reporting. Each record links one organizational provider to one fund with allocation percentages, effective dates, and compliance status that exist only in the context of this relationship.. Existence Justification: In healthcare fund accounting, organizational providers (hospitals, clinics, facilities) participate in multiple funds simultaneously (operating funds, restricted grants, endowments, capital funds), and each fund is typically allocated across multiple organizational entities within an integrated delivery network or health system. The allocation relationship is actively managed by finance teams with specific percentages, effective dates, compliance tracking, and reporting requirements that belong to neither the provider nor the fund alone.'
}

Table finance.payment_batch {
  payment_batch_id varchar [pk, note: 'Primary key for payment_batch']
  bank_account_id varchar [note: 'Reference to the bank account used for processing this payment batch.']
  fiscal_period_id varchar [note: 'Reference to the fiscal period in which this payment batch is recorded for financial reporting.']
  payment_created_by_user_employee_id varchar [note: 'Reference to the user who created this payment batch record.']
  payment_employee_id varchar [note: 'Reference to the user who approved this payment batch for processing.']
  payment_financial_entity_id varchar [note: 'Reference to the organization making the payments in this batch, such as an insurance company or employer.']
  payment_original_batch_id varchar [note: 'Reference to the original payment batch that this batch is reversing or correcting, if applicable.']
  payment_payee_organization_financial_entity_id varchar [note: 'Reference to the organization receiving the payments in this batch, typically the healthcare provider or facility.']
  primary_batch_employee_id varchar
  primary_reversed_payment_batch_id varchar [note: 'Self-referencing FK on payment_batch (reversed_payment_batch_id)']
  actual_processing_timestamp timestamp [note: 'The precise date and time when the payment batch processing was completed.']
  adjustment_amount decimal(18,2) [note: 'The total value of adjustments, fees, or corrections applied to the batch amount.']
  approval_required_flag boolean [note: 'Indicates whether this payment batch requires managerial or supervisory approval before processing.']
  approval_status varchar
  approval_timestamp timestamp [note: 'The date and time when the payment batch was approved for processing.']
  batch_date date [note: 'The business date on which the payment batch was created or scheduled for processing.']
  batch_number varchar [note: 'Externally-known unique business identifier for the payment batch, used for tracking and reconciliation across systems.']
  batch_status varchar [note: 'Batch status']
  batch_type varchar [note: 'Classification of the payment batch by its purpose and source. Determines processing rules and reconciliation requirements.']
  cost_center_code varchar [note: 'The cost center or department code responsible for this payment batch for budgeting and cost allocation purposes.']
  created_timestamp timestamp [note: 'The date and time when this payment batch record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code indicating the currency of all monetary amounts in this batch.']
  electronic_funds_transfer_trace_number varchar [note: 'The trace number assigned by the Automated Clearing House (ACH) network for tracking electronic fund transfers.']
  error_message varchar [note: 'Detailed error message or failure reason if the payment batch processing encountered issues.']
  external_batch_reference varchar [note: 'External reference number or identifier provided by the payer or payment processor for cross-system reconciliation.']
  failed_payment_count varchar [note: 'The number of payment transactions that failed processing within this batch.']
  general_ledger_account_code varchar [note: 'The general ledger account code to which this payment batch is posted for financial reporting.']
  is_reversal boolean [note: 'Indicates whether this payment batch represents a reversal or correction of a previously processed batch.']
  lockbox_number varchar [note: 'The lockbox identifier used for processing mailed payments, typically assigned by the bank providing lockbox services.']
  modified_timestamp timestamp [note: 'The date and time when this payment batch record was last modified.']
  net_batch_amount decimal(18,2) [note: 'The final net monetary value of the payment batch after all adjustments have been applied.']
  notes varchar
  payment_batch_status varchar [note: 'Current lifecycle status of the payment batch in the processing workflow.']
  payment_channel varchar [note: 'The interface or channel through which the payment batch was initiated or received.']
  payment_count varchar
  payment_date date
  payment_method varchar [note: 'The financial instrument or mechanism used to execute payments in this batch.']
  processing_notes varchar [note: 'Free-text notes documenting special instructions, issues, or observations related to the processing of this payment batch.']
  reconciliation_date date [note: 'The date on which the payment batch was successfully reconciled with bank records.']
  reconciliation_status varchar [note: 'Current status of the reconciliation process for this payment batch against bank statements and accounting records.']
  remittance_advice_number varchar [note: 'The unique identifier for the remittance advice document associated with this payment batch, used for payment application.']
  scheduled_processing_date date [note: 'The target date when the payment batch is scheduled to be processed and funds transferred.']
  source_system_code varchar [note: 'Identifier of the source system or module that originated this payment batch.']
  successful_payment_count varchar [note: 'The number of payment transactions that were successfully processed within this batch.']
  total_amount decimal(18,2) [note: 'Total amount']
  total_batch_amount decimal(18,2) [note: 'The total monetary value of all payments included in this batch before any adjustments.']
  total_payment_count varchar [note: 'The total number of individual payment transactions included in this batch.']
  updated_timestamp timestamp
  vibe_mutation_added varchar [note: 'Added by VIBE mutation to satisfy target entity touch requirement']
  vibe_mutation_applied varchar
  vibe_mutation_extra varchar [note: 'Placeholder attribute added by VIBE mutation to ensure model change.']
  vibe_mutation_marker varchar [note: 'Marker added by VIBE mutator']
  vibe_mutation_test varchar [note: 'Added by VIBE mutation to ensure product is touched']
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']

  Note: 'Master reference table for payment_batch. Referenced by payment_batch_id.'
}

Table finance.transaction_batch {
  transaction_batch_id varchar [pk, note: 'Primary key for transaction_batch']
  cost_center_id varchar [note: 'Reference to the primary cost center associated with this transaction batch for cost allocation purposes.']
  financial_entity_id varchar [note: 'Reference to the legal entity or business unit to which this transaction batch belongs.']
  fiscal_period_id varchar [note: 'Reference to the accounting period (fiscal month/quarter/year) to which this batch belongs.']
  org_unit_id varchar [note: 'Reference to the department that originated or owns this transaction batch.']
  primary_batch_employee_id varchar
  primary_reversed_transaction_batch_id varchar [note: 'Self-referencing FK on transaction_batch (reversed_transaction_batch_id)']
  recurring_schedule_id varchar [note: 'Reference to the recurring schedule template if this batch is part of a recurring series.']
  transaction_approved_by_user_employee_id varchar [note: 'Reference to the user who approved this transaction batch for posting.']
  transaction_employee_id varchar [note: 'Reference to the user who created this transaction batch.']
  transaction_financial_entity_id varchar
  transaction_fiscal_period_id varchar
  transaction_modified_by_user_employee_id varchar [note: 'Reference to the user who last modified this transaction batch.']
  transaction_original_batch_id varchar [note: 'Reference to the original batch if this batch is a reversal or correction of another batch.']
  transaction_posted_by_user_employee_id varchar [note: 'Reference to the user who posted this transaction batch to the general ledger.']
  transaction_reversal_batch_id varchar [note: 'Reference to the reversal batch if this batch has been reversed, creating an audit trail of corrections.']
  approved_timestamp timestamp [note: 'The date and time when this transaction batch was approved.']
  batch_date date [note: 'The business date on which the transaction batch was created or is effective for accounting purposes.']
  batch_description varchar [note: 'Detailed textual description of the purpose and contents of the transaction batch.']
  batch_number varchar [note: 'Externally-known unique business identifier for the transaction batch, used for tracking and reconciliation across systems.']
  batch_status varchar [note: 'Current lifecycle status of the transaction batch in the approval and posting workflow.']
  batch_total_amount decimal(18,2)
  batch_type varchar [note: 'Classification of the transaction batch indicating the nature of transactions contained within (e.g., journal entries, payments, adjustments).']
  control_total decimal(18,2) [note: 'Expected control total for validation purposes, used to verify batch integrity before posting.']
  control_total_amount decimal(18,2)
  created_timestamp timestamp [note: 'The date and time when this transaction batch record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the transaction batch amounts.']
  external_reference_number varchar [note: 'External reference identifier from source systems or third-party systems for cross-system reconciliation.']
  fiscal_period varchar [note: 'The fiscal period number (1-12 or 1-13) within the fiscal year for this transaction batch.']
  fiscal_year varchar [note: 'The fiscal year to which this transaction batch is assigned for financial reporting purposes.']
  is_auto_generated boolean [note: 'Indicates whether the batch was automatically generated by a system process (true) or manually created by a user (false).']
  is_balanced boolean [note: 'Indicates whether the batch debits and credits are in balance (true) or out of balance (false).']
  is_recurring boolean [note: 'Indicates whether this batch is part of a recurring batch series (true) or a one-time batch (false).']
  modified_timestamp timestamp [note: 'The date and time when this transaction batch record was last modified.']
  net_amount decimal(18,2) [note: 'The net amount of the batch (total debits minus total credits), should be zero for balanced batches.']
  notes varchar [note: 'Additional free-form notes or comments about the transaction batch for documentation purposes.']
  posted_timestamp timestamp [note: 'The date and time when this transaction batch was posted to the general ledger.']
  posting_date date [note: 'The date on which the transaction batch was posted to the general ledger.']
  posting_status varchar
  rejection_reason varchar [note: 'Textual explanation of why the batch was rejected during the approval process, if applicable.']
  source_system_code varchar
  total_amount decimal(18,2) [note: 'Total amount']
  total_batch_amount decimal(18,2)
  total_credit_amount decimal(18,2) [note: 'The sum of all credit amounts in the transaction batch, used for batch balancing and reconciliation.']
  total_debit_amount decimal(18,2) [note: 'The sum of all debit amounts in the transaction batch, used for batch balancing and reconciliation.']
  transaction_count varchar [note: 'The total number of individual transactions contained within this batch.']
  updated_timestamp timestamp
  vibe_mutation_added varchar [note: 'Added by VIBE mutation to satisfy target entity touch requirement']
  vibe_mutation_applied varchar
  vibe_mutation_extra varchar [note: 'Placeholder attribute added by VIBE mutation to ensure model change.']
  vibe_mutation_marker varchar [note: 'Marker added by VIBE mutator']
  vibe_mutation_test varchar [note: 'Added by VIBE mutation to ensure product is touched']
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']

  Note: 'Master reference table for transaction_batch. Referenced by batch_id.'
}

Table finance.allocation_run {
  allocation_run_id varchar [pk, note: 'Primary key for allocation_run']
  allocation_approved_by_user_employee_id varchar [note: 'Reference to the user who approved this allocation run for posting to the general ledger.']
  allocation_employee_id varchar [note: 'Reference to the user or system account that initiated or triggered this allocation run.']
  allocation_method_id varchar [note: 'Reference to the allocation methodology applied in this run (e.g., direct, step-down, reciprocal, activity-based costing).']
  cost_center_id varchar [note: 'Reference to the primary cost center or cost pool from which costs are being allocated in this run.']
  fiscal_period_id varchar [note: 'Reference to the fiscal period for which this allocation run was executed, linking to the financial calendar.']
  journal_entry_id varchar
  primary_run_employee_id varchar
  reversed_allocation_run_id varchar [note: 'Reference to the original allocation run that this run is reversing, if applicable.']
  transaction_batch_id varchar [note: 'Identifier for the batch processing job or financial close cycle that includes this allocation run.']
  actual_end_timestamp timestamp [note: 'Actual date and time when the allocation run execution completed or terminated.']
  actual_start_timestamp timestamp [note: 'Actual date and time when the allocation run execution commenced, representing the principal business event timestamp for this transaction.']
  allocation_basis varchar [note: 'Description of the statistical or financial basis used for cost allocation (e.g., square footage, FTE count, patient days, relative value units).']
  allocation_percentage_total decimal(5,2) [note: 'Sum of all allocation percentages applied across target cost centers, should equal 100.00 for validation purposes.']
  approval_timestamp timestamp [note: 'Date and time when the allocation run was formally approved for financial posting.']
  audit_trail_reference varchar [note: 'Reference identifier linking to detailed audit logs or supporting documentation for this allocation run.']
  completed_timestamp timestamp
  created_timestamp timestamp [note: 'Date and time when this allocation run record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts in this allocation run.']
  error_count varchar [note: 'Number of errors encountered during the allocation run execution.']
  execution_duration_seconds varchar [note: 'Total elapsed time in seconds for the allocation run execution, used for performance monitoring and optimization.']
  gl_batch_number varchar [note: 'General ledger batch identifier associated with the journal entries created from this allocation run.']
  gl_posting_timestamp timestamp [note: 'Date and time when the allocation run results were posted to the general ledger system.']
  last_modified_timestamp timestamp [note: 'Date and time when this allocation run record was last updated or modified.']
  modified_timestamp timestamp
  notes varchar [note: 'Free-text notes or comments regarding the allocation run, including special circumstances, adjustments, or explanations.']
  posted_to_gl_flag boolean [note: 'Indicator whether the allocation results have been posted to the general ledger.']
  records_processed_count varchar [note: 'Total number of allocation detail records or transactions processed in this run.']
  regulatory_reporting_flag boolean [note: 'Indicator whether this allocation run is used for regulatory cost reporting purposes (e.g., Medicare Cost Report).']
  reversal_flag boolean [note: 'Indicator whether this allocation run is a reversal of a previous allocation.']
  run_date date [note: 'Run date']
  run_name varchar [note: 'Descriptive name assigned to the allocation run for identification and reporting purposes, often includes period and allocation type context.']
  run_number varchar [note: 'Business-facing unique identifier for the allocation run, typically formatted with prefix and sequence number for external reference and audit trails.']
  run_status varchar [note: 'Current lifecycle status of the allocation run indicating its stage in the execution and approval workflow.']
  run_type varchar [note: 'Classification of the allocation run indicating its purpose and finality within the financial close process.']
  scheduled_start_timestamp timestamp [note: 'Planned date and time when the allocation run was scheduled to begin execution.']
  simulation_flag boolean [note: 'Indicator whether this allocation run is a simulation or what-if scenario rather than an actual financial posting.']
  started_timestamp timestamp
  target_cost_centers_count varchar [note: 'Number of distinct cost centers that received allocated costs in this run.']
  total_allocated_amount decimal(18,2)
  total_amount_allocated decimal(18,2) [note: 'Total monetary value of costs allocated across all target cost centers in this run, representing the gross base amount for this allocation transaction.']
  variance_amount decimal(18,2) [note: 'Difference between expected and actual allocated amounts, used for reconciliation and quality control.']
  vibe_mutation_added varchar [note: 'Added by VIBE mutation to satisfy target entity touch requirement']
  vibe_mutation_applied varchar
  vibe_mutation_extra varchar [note: 'Placeholder attribute added by VIBE mutation to ensure model change.']
  vibe_mutation_marker varchar [note: 'Generic mutation marker']
  vibe_mutation_test varchar [note: 'Added by VIBE mutation to ensure product is touched']
  vibe_structure_marker varchar [note: 'Marker attribute stamped by required-structure enforcement pass.']
  warning_count varchar [note: 'Number of warnings generated during the allocation run execution.']

  Note: 'Master reference table for allocation_run. Referenced by allocation_run_id.'
}

Table finance.depreciation_run {
  depreciation_run_id varchar [pk, note: 'Primary key for depreciation_run']
  asset_book_id varchar [note: 'Reference to the asset book (corporate, tax, IFRS, etc.) for which this depreciation run is executed.']
  care_site_id varchar [note: 'Reference to the facility or location for which this depreciation run is scoped, if applicable.']
  cost_center_id varchar [note: 'Reference to the cost center for which this depreciation run is scoped, if applicable.']
  depreciation_approved_by_user_employee_id varchar [note: 'Reference to the user who approved the depreciation run for posting to the general ledger.']
  depreciation_employee_id varchar [note: 'Reference to the user who initiated or scheduled this depreciation run.']
  depreciation_reversed_run_id varchar [note: 'Reference to the original depreciation run that this run reverses, if applicable.']
  financial_entity_id varchar
  fiscal_period_id varchar [note: 'Reference to the fiscal period for which this depreciation run is executed.']
  general_ledger_id varchar [note: 'Reference to the general ledger to which this depreciation run posts entries.']
  journal_entry_id varchar
  org_unit_id varchar [note: 'Reference to the department for which this depreciation run is scoped, if applicable.']
  primary_reversed_depreciation_run_id varchar [note: 'Self-referencing FK on depreciation_run (reversed_depreciation_run_id)']
  primary_run_employee_id varchar
  approval_timestamp timestamp [note: 'The date and time when the depreciation run was approved for posting.']
  asset_count varchar [note: 'The total number of assets included in this depreciation run.']
  auto_post_flag boolean [note: 'Indicates whether the depreciation entries from this run are automatically posted to the general ledger upon completion.']
  calculation_method varchar [note: 'The accounting method used to calculate depreciation in this run, such as straight-line, declining balance, or units of production.']
  completed_timestamp timestamp
  created_timestamp timestamp [note: 'The date and time when this depreciation run record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the depreciation amounts in this run.']
  effective_date date [note: 'The accounting effective date for which the depreciation expense is recognized in the financial statements.']
  end_timestamp timestamp [note: 'The precise date and time when the depreciation run processing completed.']
  error_message varchar [note: 'Detailed error message if the depreciation run failed, providing diagnostic information for troubleshooting.']
  failed_asset_count varchar [note: 'The number of assets that failed processing during this depreciation run.']
  journal_batch_reference varchar [note: 'Reference to the journal batch containing the depreciation entries generated by this run.']
  modified_timestamp timestamp [note: 'The date and time when this depreciation run record was last modified.']
  notes varchar
  posting_date date [note: 'The date on which the depreciation entries from this run were posted to the general ledger.']
  posting_status varchar
  processed_asset_count varchar [note: 'The number of assets successfully processed in this depreciation run.']
  reversal_flag boolean [note: 'Indicates whether this depreciation run is a reversal of a previous run.']
  run_date date [note: 'The business date on which the depreciation run was executed or scheduled to execute.']
  run_description varchar [note: 'Free-text description providing additional context or notes about the purpose and scope of this depreciation run.']
  run_number varchar [note: 'Business-facing unique identifier for the depreciation run, used in financial reports and audit trails.']
  run_status varchar [note: 'Current lifecycle status of the depreciation run indicating its processing state.']
  run_type varchar [note: 'Classification of the depreciation run indicating whether it is a scheduled periodic run, ad-hoc calculation, adjustment, reversal, year-end closing, or interim calculation.']
  simulation_flag boolean [note: 'Indicates whether this depreciation run is a simulation or test run that does not post to the general ledger.']
  start_timestamp timestamp [note: 'The precise date and time when the depreciation run processing began.']
  started_timestamp timestamp
  total_depreciation_amount decimal(18,2) [note: 'The total depreciation expense calculated across all assets in this run.']
  updated_timestamp timestamp
  vibe_mutation_added varchar [note: 'Added by VIBE mutation to satisfy target entity touch requirement']
  vibe_mutation_applied varchar
  vibe_mutation_extra varchar [note: 'Placeholder attribute added by VIBE mutation to ensure model change.']
  vibe_mutation_marker varchar [note: 'Marker added by VIBE mutator']
  vibe_mutation_test varchar [note: 'Added by VIBE mutation to ensure product is touched']
  vibe_structure_marker varchar [note: 'structure enforcement marker']

  Note: 'Master reference table for depreciation_run. Referenced by depreciation_run_id.'
}

Table finance.donor {
  donor_id varchar [pk, note: 'Primary key for donor']
  fund_id varchar
  merged_donor_id varchar [note: 'Self-referencing FK on donor (merged_donor_id)']
  mpi_record_id varchar
  acknowledgment_preference varchar [note: 'Donor\'s preference for public recognition of their contributions in donor lists, annual reports, and naming opportunities.']
  affinity_score decimal(5,2) [note: 'Quantitative score representing the donor\'s affinity and connection to the healthcare organization based on engagement history, volunteer activity, and relationship depth.']
  board_member_flag boolean [note: 'Boolean indicator of whether the donor currently serves or has served on the healthcare organization\'s board of directors or advisory board.']
  city varchar [note: 'City name of the donor\'s mailing address.']
  country_code varchar [note: 'Three-letter ISO country code representing the donor\'s country of residence or incorporation.']
  created_timestamp timestamp [note: 'Timestamp when the donor record was first created in the system, following the format yyyy-MM-ddTHH:mm:ss.SSSXXX.']
  data_classification varchar [note: 'Classification level of the donor record indicating the sensitivity and access controls required for this data per organizational data governance policies.']
  donor_category varchar
  donor_name varchar [note: 'Full legal name of the donor individual or organization providing financial contributions.']
  donor_status varchar [note: 'Current lifecycle status of the donor relationship indicating whether the donor is actively contributing, inactive, temporarily suspended, deceased, or merged with another donor record.']
  donor_type varchar [note: 'Classification of the donor entity type indicating whether the donor is an individual person, corporate entity, charitable foundation, government agency, or anonymous contributor.']
  email varchar
  email_address varchar [note: 'Primary email address for donor communication and correspondence regarding contributions and acknowledgments.']
  employer_name varchar [note: 'Name of the donor\'s employer organization, relevant for corporate matching gift programs and workplace giving campaigns.']
  first_gift_date date [note: 'Date when the donor made their first recorded contribution to the healthcare organization.']
  is_anonymous boolean
  last_gift_date date [note: 'Date of the most recent contribution received from the donor.']
  lifetime_giving_amount decimal(18,2) [note: 'Total cumulative amount of all contributions made by the donor since the inception of the donor relationship, expressed in the organization\'s functional currency.']
  mailing_address varchar
  mailing_address_line1 varchar [note: 'First line of the donor\'s mailing address including street number and street name for correspondence and tax receipts.']
  mailing_address_line2 varchar [note: 'Second line of the donor\'s mailing address including apartment, suite, or unit number.']
  matching_gift_eligible_flag boolean [note: 'Boolean indicator of whether the donor is eligible for corporate matching gift programs through their employer.']
  memorial_honoree_name varchar [note: 'Name of the individual being honored or memorialized through the donor\'s contributions, if applicable.']
  modified_timestamp timestamp [note: 'Timestamp when the donor record was last modified or updated, following the format yyyy-MM-ddTHH:mm:ss.SSSXXX.']
  notes varchar [note: 'Free-text notes and comments about the donor relationship, preferences, special considerations, and stewardship history for development staff reference.']
  patient_flag boolean [note: 'Boolean indicator of whether the donor is or has been a patient of the healthcare organization, relevant for grateful patient programs.']
  phone varchar
  phone_number varchar [note: 'Primary contact phone number for the donor used for outreach, stewardship, and contribution acknowledgment.']
  planned_giving_flag boolean [note: 'Boolean indicator of whether the donor has established a planned gift commitment such as a bequest, charitable trust, or life insurance designation.']
  postal_code varchar [note: 'Postal or ZIP code of the donor\'s mailing address for correspondence delivery.']
  preferred_communication_method varchar [note: 'Donor\'s preferred method of communication for stewardship, solicitation, and acknowledgment correspondence.']
  recognition_level varchar
  segment varchar [note: 'Fundraising segment classification of the donor based on giving capacity and engagement level for targeted stewardship and solicitation strategies.']
  solicitation_opt_out_flag boolean [note: 'Boolean indicator of whether the donor has requested to opt out of future fundraising solicitations and appeals.']
  source varchar [note: 'Original source or channel through which the donor was acquired or first engaged with the healthcare organization\'s fundraising programs.']
  state_province varchar [note: 'State or province code of the donor\'s mailing address using standard postal abbreviations.']
  tax_id_number varchar [note: 'Tax identification number for the donor used for IRS reporting and tax-deductible contribution acknowledgment. May be SSN for individuals or EIN for organizations.']
  tax_identification_number varchar
  tax_receipt_required_flag boolean
  total_contributed_amount decimal(18,2)
  updated_timestamp timestamp
  vibe_mutation_added varchar [note: 'Added by VIBE mutation to satisfy target entity touch requirement']
  vibe_mutation_applied varchar
  vibe_mutation_extra varchar [note: 'Placeholder attribute added by VIBE mutation to ensure model change.']
  vibe_mutation_marker varchar [note: 'Marker added by VIBE mutator']
  vibe_mutation_test varchar [note: 'Added by VIBE mutation to ensure product is touched']
  vibe_structure_marker varchar [note: 'structure enforcement marker']
  volunteer_flag boolean [note: 'Boolean indicator of whether the donor actively volunteers or has volunteered for the healthcare organization.']
  wealth_capacity_rating varchar [note: 'Estimated wealth capacity rating or score for the donor based on wealth screening and prospect research, used for major gift identification and cultivation strategies.']

  Note: 'Master reference table for donor. Referenced by donor_id.'
}

Table finance.intercompany_agreement {
  intercompany_agreement_id varchar [pk, note: 'Primary key for intercompany_agreement']
  cost_center_id varchar [note: 'Identifier of the cost center responsible for managing or tracking costs related to this agreement.']
  employee_id varchar [note: 'Identifier of the user or approver who authorized this intercompany agreement.']
  financial_entity_id varchar [note: 'Identifier of the legal entity providing services, goods, or resources under this intercompany agreement.']
  from_financial_entity_id varchar
  parent_intercompany_agreement_id varchar [note: 'Identifier of the parent or master agreement if this is a subsidiary or amendment agreement. Nullable for standalone agreements.']
  primary_superseded_intercompany_agreement_id varchar [note: 'Self-referencing FK on intercompany_agreement (superseded_intercompany_agreement_id)']
  target_financial_entity_id varchar
  to_financial_entity_id varchar
  agreement_name varchar [note: 'Human-readable name or title of the intercompany agreement describing its purpose or scope.']
  agreement_number varchar [note: 'Externally-known unique business identifier for the intercompany agreement, typically used in contracts and financial reporting.']
  agreement_status varchar [note: 'Agreement status']
  agreement_type varchar [note: 'Classification of the intercompany agreement based on its business purpose (e.g., service agreement, cost allocation, revenue sharing, transfer pricing, licensing, or intercompany loan).']
  annual_contract_value decimal(18,2) [note: 'Total estimated or committed annual value of the intercompany agreement in the specified currency.']
  approval_date date [note: 'Date when the intercompany agreement was formally approved by authorized parties.']
  audit_required_flag boolean [note: 'Indicates whether this agreement requires periodic audit review for compliance or financial accuracy.']
  billing_frequency varchar [note: 'Frequency at which intercompany charges are billed under this agreement.']
  cost_allocation_basis varchar [note: 'Description of the basis or formula used for allocating costs between entities (e.g., headcount, revenue, square footage, usage metrics).']
  created_timestamp timestamp [note: 'Timestamp when the intercompany agreement record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all financial transactions under this agreement.']
  dispute_resolution_method varchar [note: 'Method specified in the agreement for resolving disputes between the provider and receiver entities.']
  document_reference_url varchar [note: 'URL or file path to the signed agreement document or contract repository location.']
  effective_end_date date [note: 'Date when the intercompany agreement expires or terminates. Nullable for open-ended agreements.']
  effective_start_date date [note: 'Date when the intercompany agreement becomes legally binding and operational.']
  gl_account_code varchar [note: 'General ledger account code used for posting intercompany transactions under this agreement.']
  governing_law_jurisdiction varchar [note: 'Legal jurisdiction whose laws govern the interpretation and enforcement of this intercompany agreement.']
  intercompany_agreement_status varchar [note: 'Current lifecycle status of the intercompany agreement indicating its operational state.']
  intercompany_receiver_entity_id varchar [note: 'Identifier of the legal entity receiving services, goods, or resources under this intercompany agreement.']
  last_audit_date date [note: 'Date of the most recent audit or compliance review performed on this intercompany agreement.']
  last_modified_timestamp timestamp [note: 'Timestamp when the intercompany agreement record was last updated or modified.']
  markup_percentage decimal(9,6)
  modified_timestamp timestamp
  next_review_date date [note: 'Scheduled date for the next periodic review or renewal evaluation of this agreement.']
  notes varchar [note: 'Additional notes, comments, or special instructions related to the intercompany agreement.']
  payment_terms_days varchar [note: 'Number of days allowed for payment after invoice date, as specified in the agreement terms.']
  pricing_method varchar [note: 'Method used to determine pricing for services or goods exchanged under this intercompany agreement.']
  receiving_entity_id varchar
  renewal_flag boolean [note: 'Indicates whether the agreement is eligible for automatic renewal upon expiration.']
  renewal_notice_days varchar [note: 'Number of days prior to expiration that renewal notice must be provided, as specified in the agreement.']
  sending_entity_id varchar
  service_description varchar [note: 'Detailed description of the services, goods, or resources covered by this intercompany agreement.']
  settlement_frequency varchar
  source_financial_entity_id varchar
  tax_jurisdiction_code varchar [note: 'Code representing the primary tax jurisdiction governing this intercompany agreement.']
  termination_clause varchar [note: 'Summary of the conditions and procedures under which the agreement may be terminated by either party.']
  transfer_pricing_basis varchar
  transfer_pricing_compliant_flag boolean [note: 'Indicates whether the agreement has been reviewed and approved as compliant with transfer pricing regulations.']
  updated_timestamp timestamp
  version_number varchar [note: 'Version number of the agreement, incremented with each amendment or revision.']
