Table radiology.imaging_order {
  imaging_order_id varchar [pk, note: 'Unique identifier for the imaging order.']
  audit_finding_id varchar [note: 'Link to compliance audit finding if applicable.']
  care_site_id varchar [note: 'Facility where the imaging order was placed.']
  clinical_order_id varchar [note: 'Parent clinical order.']
  contrast_drug_master_id varchar [note: 'Contrast agent drug master record.']
  contrast_material_master_id varchar [note: 'Contrast material supply record.']
  cost_center_id varchar [note: 'Cost center for financial tracking.']
  demographics_id varchar [note: 'Patient demographic record.']
  employee_id varchar [note: 'Employee who placed or processed the order.']
  icd10_primary_diagnosis_icd_code_id varchar [note: 'Primary ICD-10 diagnosis code.']
  payer_id varchar [note: 'Insurance payer.']
  primary_imaging_clinician_id varchar [note: 'Clinician who ordered the imaging study.']
  procedure_code_cpt_code_id varchar [note: 'CPT code for the imaging procedure.']
  research_study_id varchar [note: 'Research study if applicable.']
  visit_id varchar [note: 'Encounter visit.']
  accession_number varchar [note: 'Unique accession number for the imaging order.']
  body_part varchar [note: 'Anatomical body part to be imaged.']
  cancellation_reason varchar [note: 'Reason for order cancellation.']
  cancelled_timestamp timestamp [note: 'Date and time the order was cancelled.']
  clinical_indication varchar [note: 'Clinical reason for the imaging order.']
  contrast_required boolean [note: 'Flag indicating if contrast is required.']
  created_timestamp timestamp [note: 'Date and time the order record was created.']
  critical_finding_flag boolean [note: 'Flag indicating if a critical finding was identified.']
  exam_end_timestamp timestamp [note: 'Date and time the exam ended.']
  exam_start_timestamp timestamp [note: 'Date and time the exam started.']
  is_portable boolean [note: 'Flag indicating if the imaging is portable (bedside).']
  is_stat_override boolean [note: 'Flag indicating if the order was marked as STAT.']
  laterality varchar [note: 'Left, right, or bilateral.']
  modality_type varchar [note: 'Imaging modality (e.g., CT, MRI, X-Ray).']
  mrn varchar [note: 'Patient medical record number.']
  order_priority varchar [note: 'Priority level (e.g., routine, urgent, STAT).']
  order_source varchar [note: 'Source system or method of order entry.']
  order_status varchar [note: 'Current status of the order.']
  ordered_timestamp timestamp [note: 'Date and time the order was placed.']
  ordering_provider_npi varchar [note: 'National Provider Identifier of the ordering provider.']
  prior_auth_number varchar [note: 'Prior authorization number from payer.']
  prior_auth_status varchar [note: 'Status of prior authorization.']
  procedure_description varchar [note: 'Description of the imaging procedure.']
  protocol_name varchar [note: 'Imaging protocol name.']
  radiation_dose_ctdi decimal(10,4) [note: 'CT Dose Index (CTDI) in mGy.']
  radiation_dose_dlp decimal(10,4) [note: 'Dose Length Product (DLP) in mGy·cm.']
  referring_department varchar [note: 'Department that referred the patient.']
  report_finalized_timestamp timestamp [note: 'Date and time the report was finalized.']
  report_status varchar [note: 'Status of the radiology report.']
  requisition_number varchar [note: 'Requisition number for the order.']
  scheduled_timestamp timestamp [note: 'Date and time the exam is scheduled.']
  source_system_order_code varchar [note: 'Order code in the source system.']
  updated_timestamp timestamp [note: 'Date and time the order record was last updated.']
  vibe_mutation_applied varchar
  vibe_mutation_flag boolean
  vibe_structure_marker varchar [note: 'Marks product as part of the required ECM structure.']

  Note: 'Radiology imaging order placed by a provider for diagnostic or therapeutic imaging procedures.'
}

Table radiology.dicom_series {
  dicom_series_id varchar [pk, note: 'Unique identifier for the DICOM series.']
  imaging_protocol_id varchar [note: 'Imaging protocol used for the series.']
  modality_id varchar [note: 'Foreign key linking to radiology.modality. Business justification: A DICOM series is acquired on a specific physical imaging equipment unit (modality). dicom_series currently only carries a free-text modality string plus denormalized equipment descriptors (manufactur']
  performing_technologist_employee_id varchar [note: 'Technologist who performed the series.']
  radiology_study_id varchar [note: 'Parent radiology study.']
  accession_number varchar [note: 'Accession number for the series.']
