    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:state rdf:type rdf:Property ;
    rdfs:label 'State' ;
    rdfs:comment 'State or province code for the water source location.' ;
    rdfs:domain ind:WaterUtilities ;
