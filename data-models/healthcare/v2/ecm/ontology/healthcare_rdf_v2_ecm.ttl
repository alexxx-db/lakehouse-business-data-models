    rdfs:domain ind:Set ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:setType rdf:type rdf:Property ;
    rdfs:label 'Set Type' ;
    rdfs:comment 'Categorical classification of the order set structure (individual order set, SmartSet, protocol, panel, or power plan).' ;
    rdfs:domain ind:Set ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystem rdf:type rdf:Property ;
    rdfs:label 'Source System' ;
    rdfs:comment 'Operational system of record that maintains this order set content (e.g., Epic Orders, Beaker, Radiant, Willow).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
