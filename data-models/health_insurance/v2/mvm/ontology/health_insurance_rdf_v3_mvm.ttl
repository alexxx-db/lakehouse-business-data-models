    rdfs:comment 'Indicates if this PCP is the member\'s primary provider when multiple assignments exist.' ;
    rdfs:domain ind:HealthInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:panelStatus rdf:type rdf:Property ;
    rdfs:label 'Panel Status' ;
    rdfs:comment 'Indicates whether the PCP is currently in the member\'s provider panel.' ;
    rdfs:domain ind:HealthInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cobRecordId rdf:type rdf:Property ;
    rdfs:label 'Cob Record Id' ;
    rdfs:comment 'Primary key for cob_record' ;
    rdfs:domain ind:HealthInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CobRecord .

ind:groupId rdf:type rdf:Property ;
    rdfs:label 'Group Id' ;
    rdfs:comment 'Foreign key linking to employer.group. Business justification: Coordination of benefits processing must record the employee handling the COB record for compliance and audit.' ;
    rdfs:domain ind:HealthInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Group .

ind:regulatoryObligationId rdf:type rdf:Property ;
    rdfs:label 'Regulatory Obligation Id' ;
    rdfs:comment 'Foreign key linking to compliance.regulatory_obligation. Business justification: Medicare Secondary Payer (MSP) rules and state COB regulations are specific regulatory obligations governing COB records. The existing \'is_msp_compliant\' column signals MSP regulatory dependency. Comp' ;
    rdfs:domain ind:HealthInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RegulatoryObligation .

ind:birthdayRuleApplicable rdf:type rdf:Property ;
