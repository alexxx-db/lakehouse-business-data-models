Table encounter.visit {
  visit_id varchar [pk, note: 'Surrogate primary key for the visit/encounter record.']
  care_site_id varchar [note: 'FK to the care site where the visit occurred.']
  cost_center_id varchar [note: 'FK to the financial cost center.']
  drg_id varchar [note: 'FK to the DRG reference record.']
  insurance_coverage_id varchar [note: 'FK to the patient insurance coverage record.']
  primary_nurse_employee_id varchar [note: 'FK to the primary nurse employee.']
  primary_visit_admitting_provider_clinician_id varchar [note: 'FK to the admitting provider clinician.']
  primary_visit_mpi_record_id varchar [note: 'FK to the patient MPI record.']
  research_study_id varchar [note: 'FK to associated research study.']
  tertiary_visit_discharging_provider_clinician_id varchar [note: 'FK to the discharging provider clinician.']
  training_completion_id varchar [note: 'FK to training completion record.']
  admission_source varchar [note: 'Source of admission (e.g., ED, physician referral).']
  admission_timestamp timestamp [note: 'Date and time of patient admission.']
  admission_type varchar [note: 'Type of admission (e.g., elective, emergency, urgent).']
  admitting_diagnosis_code varchar [note: 'ICD-10 code for the admitting diagnosis.']
  care_setting varchar [note: 'Care setting (inpatient, outpatient, observation, ED).']
  care_transition_plan_completed boolean [note: 'Flag indicating care transition plan was completed.']
  consent_obtained boolean [note: 'Flag indicating patient consent was obtained.']
  converted_to_inpatient boolean [note: 'Flag indicating observation status converted to inpatient.']
  created_timestamp timestamp [note: 'Record creation timestamp.']
  discharge_disposition varchar [note: 'Discharge disposition description.']
  discharge_instructions_issued boolean [note: 'Flag indicating discharge instructions were issued.']
  discharge_timestamp timestamp [note: 'Date and time of patient discharge.']
  drg_type varchar [note: 'DRG type (MS-DRG, APR-DRG).']
  drg_weight decimal(8,4) [note: 'DRG relative weight for reimbursement calculation.']
  emtala_compliant boolean [note: 'Flag indicating EMTALA compliance.']
  encounter_number varchar [note: 'Unique encounter/visit number from source system.']
  expected_los_days decimal(6,2) [note: 'Expected length of stay in days.']
  financial_class varchar [note: 'Financial class of the visit (Medicare, Medicaid, Commercial).']
  follow_up_scheduled boolean [note: 'Flag indicating follow-up appointment was scheduled.']
  inpatient_conversion_timestamp timestamp [note: 'Timestamp when observation was converted to inpatient.']
  length_of_stay_days varchar [note: 'Actual length of stay in days.']
  moon_delivered_timestamp timestamp [note: 'Timestamp when Medicare Outpatient Observation Notice was delivered.']
  mrn varchar [note: 'Medical record number.']
  observation_hours decimal(6,2) [note: 'Total hours patient was in observation status.']
  observation_status boolean [note: 'Flag indicating patient is in observation status.']
  point_of_service_code varchar [note: 'CMS point of service code.']
  principal_icd10_diagnosis_code varchar [note: 'Principal ICD-10 diagnosis code.']
  readmission_flag boolean [note: 'Flag indicating this visit is a readmission.']
  readmission_risk_score decimal(5,2) [note: 'Readmission risk score at time of admission.']
  source_encounter_code varchar [note: 'Source system encounter code.']
  structural_fk_reconciled_flag boolean
  telehealth_connection_quality varchar [note: 'Quality rating of telehealth connection.']
  telehealth_platform varchar [note: 'Telehealth platform used for the visit.']
  two_midnight_compliant boolean [note: 'Flag indicating compliance with CMS two-midnight rule.']
  updated_timestamp timestamp [note: 'Record last updated timestamp.']
  vibe_mutation_marker varchar
  vibe_structure_marker varchar
  visit_status varchar [note: 'Current status of the visit.']
  visit_type varchar [note: 'Type of visit (inpatient, outpatient, ED, telehealth).']

  Note: 'Core encounter/visit record representing a patient interaction with the health system.'
}

Table encounter.adt_event {
  adt_event_id varchar [pk, note: 'Surrogate primary key for the ADT event.']
  clinician_id varchar [note: 'FK to the clinician associated with the ADT event.']
  demographics_id varchar [note: 'FK to patient demographics.']
  drg_id varchar [note: 'FK to DRG reference.']
  message_log_id varchar [note: 'FK to the HL7 message log.']
  mpi_record_id varchar
  prior_event_adt_event_id varchar [note: 'Self-referential FK to the prior ADT event.']
  transporting_employee_id varchar [note: 'FK to the employee responsible for patient transport.']
  visit_id varchar [note: 'FK to the parent visit.']
  accepting_provider_npi varchar [note: 'NPI of the accepting provider.']
  admission_source_code varchar [note: 'Admission source code.']
  adt_event_status varchar
  ama_flag boolean [note: 'Flag indicating against medical advice discharge.']
  bed_assigned_timestamp timestamp [note: 'Timestamp when bed was assigned.']
  bed_request_timestamp timestamp [note: 'Timestamp when bed was requested.']
  cancel_reason varchar [note: 'Reason for event cancellation.']
  clinical_reason_for_transfer varchar [note: 'Clinical reason for patient transfer.']
  created_timestamp timestamp [note: 'Record creation timestamp.']
  discharge_disposition_code varchar [note: 'Discharge disposition code.']
  drg_type varchar [note: 'DRG type associated with the event.']
  emtala_compliant boolean [note: 'EMTALA compliance flag.']
  emtala_transfer_form_completed boolean [note: 'Flag indicating EMTALA transfer form was completed.']
  event_recorded_timestamp timestamp [note: 'Timestamp when event was recorded in system.']
  event_status varchar [note: 'Current status of the ADT event.']
  event_timestamp timestamp [note: 'Timestamp when the ADT event occurred.']
  event_type_code varchar [note: 'HL7 ADT event type code (A01, A02, A03, etc.).']
  event_type_description varchar [note: 'Description of the ADT event type.']
  from_bed_code varchar [note: 'Bed code patient is transferring from.']
  from_unit_code varchar [note: 'Unit code patient is transferring from.']
  isolation_flag boolean [note: 'Flag indicating patient requires isolation.']
  isolation_type varchar [note: 'Type of isolation required.']
  leave_of_absence_reason varchar [note: 'Reason for leave of absence.']
  level_of_care_code varchar [note: 'Level of care code.']
  patient_class_code varchar [note: 'Patient class code (inpatient, outpatient, etc.).']
  patient_stability_score varchar [note: 'Patient stability score at time of event.']
  readmission_risk_flag boolean [note: 'Flag indicating elevated readmission risk.']
  sending_application varchar [note: 'HL7 sending application identifier.']
  sending_facility varchar [note: 'HL7 sending facility identifier.']
  sequence_number varchar [note: 'Sequence number of the event within the visit.']
  source_system_event_code varchar [note: 'Source system event code.']
  source_system_name varchar [note: 'Source system name.']
  to_bed_code varchar [note: 'Bed code patient is transferring to.']
  to_room_code varchar [note: 'Room code patient is transferring to.']
  to_unit_code varchar [note: 'Unit code patient is transferring to.']
  transition_type varchar [note: 'Type of care transition.']
  transport_mode varchar [note: 'Mode of patient transport.']
  updated_timestamp timestamp [note: 'Record last updated timestamp.']
  vibe_mutation_marker varchar
  vibe_structure_marker varchar
  visit_type_code varchar [note: 'Visit type code.']

  Note: 'Admit-Discharge-Transfer event record capturing patient movement events within and between facilities.'
}

Table encounter.visit_provider {
  visit_provider_id varchar [pk, note: 'Surrogate primary key for the visit-provider association.']
  cost_center_id varchar [note: 'FK to the cost center.']
