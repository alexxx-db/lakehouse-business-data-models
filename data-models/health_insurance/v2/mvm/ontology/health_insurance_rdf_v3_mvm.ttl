    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentDueDay rdf:type rdf:Property ;
    rdfs:label 'Payment Due Day' ;
    rdfs:comment 'Day of month by which payment must be received.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:paymentTerms rdf:type rdf:Property ;
    rdfs:label 'Payment Terms' ;
    rdfs:comment 'Contractual terms defining when payment is due after invoice issuance.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pmpmRate rdf:type rdf:Property ;
    rdfs:label 'Pmpm Rate' ;
    rdfs:comment 'Rate used to calculate monthly charges on a per-member basis.' ;
    rdfs:domain ind:HealthInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:taxExemptFlag rdf:type rdf:Property ;
    rdfs:label 'Tax Exempt Flag' ;
    rdfs:comment 'Indicates whether the account is exempt from sales or other applicable taxes.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:resolvingPremiumPaymentId rdf:type rdf:Property ;
    rdfs:label 'Resolving Premium Payment Id' ;
    rdfs:comment 'Foreign key linking to billing.premium_payment. Business justification: A grace period is resolved (or terminated) when a premium payment is received. grace_period has payment_received_date (a date field) but no FK to the actual premium_payment record that resolved it. Ad' ;
    rdfs:domain ind:GracePeriod ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PremiumPayment .

ind:dayCount rdf:type rdf:Property ;
    rdfs:label 'Day Count' ;
    rdfs:comment 'Number of days elapsed since the start of the grace period.' ;
    rdfs:domain ind:GracePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:extensionEndDate rdf:type rdf:Property ;
    rdfs:label 'Extension End Date' ;
    rdfs:comment 'New end date if the grace period was extended.' ;
    rdfs:domain ind:GracePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:extensionFlag rdf:type rdf:Property ;
    rdfs:label 'Extension Flag' ;
    rdfs:comment 'Indicates whether the original grace period was extended.' ;
    rdfs:domain ind:GracePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:gracePeriodStatus rdf:type rdf:Property ;
    rdfs:label 'Grace Period Status' ;
    rdfs:comment 'Current lifecycle status of the grace period.' ;
    rdfs:domain ind:GracePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gracePeriodType rdf:type rdf:Property ;
    rdfs:label 'Grace Period Type' ;
    rdfs:comment 'Classification of the grace period based on product or regulatory rules.' ;
    rdfs:domain ind:GracePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isEligibleForAptc rdf:type rdf:Property ;
    rdfs:label 'Is Eligible For Aptc' ;
    rdfs:comment 'Indicates if the member is eligible for Advanced Premium Tax Credit during this grace period.' ;
    rdfs:domain ind:GracePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:jurisdiction rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction' ;
    rdfs:comment 'Regulatory jurisdiction applicable to the grace period.' ;
    rdfs:domain ind:HealthInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outcome rdf:type rdf:Property ;
    rdfs:label 'Outcome' ;
    rdfs:comment 'Result of the grace period after it ends.' ;
