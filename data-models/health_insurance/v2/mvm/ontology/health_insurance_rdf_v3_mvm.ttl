    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:subsidyNumber rdf:type rdf:Property ;
    rdfs:label 'Subsidy Number' ;
    rdfs:comment 'External business identifier assigned to the subsidy agreement.' ;
