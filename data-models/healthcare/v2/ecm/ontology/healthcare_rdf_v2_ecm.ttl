    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:locationTypeDomain rdf:type rdf:Property ;
    rdfs:label 'Location Type Domain' ;
    rdfs:comment 'Discriminator for location domain: PHARMACY, PROVIDER' ;
