ind:enrollmentCountEo rdf:type rdf:Property ;
    rdfs:label 'Enrollment Count Eo' ;
    rdfs:comment 'Number of employees enrolled in employee-only coverage.' ;
    rdfs:domain ind:Group ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:enrollmentCountEs rdf:type rdf:Property ;
    rdfs:label 'Enrollment Count Es' ;
    rdfs:comment 'Number of employees plus spouses enrolled.' ;
    rdfs:domain ind:Group ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:erisaStatus rdf:type rdf:Property ;
    rdfs:label 'Erisa Status' ;
    rdfs:comment 'Indicates whether the group is subject to ERISA regulations.' ;
    rdfs:domain ind:Employer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fundingArrangement rdf:type rdf:Property ;
