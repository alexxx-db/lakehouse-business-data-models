  compliance_usda_required decimal(18,2) [note: 'USDA compliance requirement.']
  cost_per_unit decimal(18,2) [note: 'Cost per unit of the item.']
  country_of_origin varchar [note: 'Country where the item is produced.']
  created_timestamp timestamp [note: 'Record creation timestamp.']
  currency_code varchar [note: 'Currency for pricing.']
  dietary_restriction varchar [note: 'Dietary restrictions applicable.']
  effective_from date [note: 'Specification effective from date.']
  effective_until date [note: 'Specification effective until date.']
  expiration_date decimal(9,4) [note: 'Expiration date code.']
  hazardous_material_flag boolean [note: 'Whether the item is hazardous.']
  is_perishable boolean [note: 'Whether the item is perishable.']
  item_specification_code varchar [note: 'Unique specification code.']
  item_specification_name varchar [note: 'Name of the specification.']
  item_specification_status varchar [note: 'Status of the specification.']
  last_inspection_date date [note: 'Date of last quality inspection.']
  lead_time_days varchar [note: 'Lead time in days.']
  material varchar [note: 'Material composition.']
  maximum_order_quantity varchar [note: 'Maximum order quantity.']
  minimum_order_quantity varchar [note: 'Minimum order quantity.']
  notes varchar [note: 'Additional notes.']
  packaging_type varchar [note: 'Type of packaging.']
  quality_grade varchar [note: 'Quality grade requirement.']
  quantity_per_unit decimal(10,2) [note: 'Quantity per unit of packaging.']
  shelf_life_days varchar [note: 'Shelf life in days.']
  storage_temperature_c decimal(5,2) [note: 'Required storage temperature in Celsius.']
  supplier_requirements varchar [note: 'Requirements for suppliers.']
  temperature_control_required boolean [note: 'Whether temperature control is needed.']
  temperature_range_c varchar [note: 'Acceptable temperature range.']
  traceability_required boolean [note: 'Whether traceability is required.']
  unit_of_measure varchar [note: 'Unit of measure.']
  updated_timestamp timestamp [note: 'Record last update timestamp.']
  volume_liters decimal(10,3) [note: 'Volume in liters.']
  waste_percentage decimal(5,2) [note: 'Expected waste percentage.']
  weight_kg decimal(10,3) [note: 'Weight in kilograms.']

  Note: 'Detailed specifications for procured items including quality, packaging, storage, and compliance requirements.'
}

Table procurement.vendor_rebate {
  vendor_rebate_id varchar [pk, note: 'Primary key for the vendor rebate.']
  procurement_supplier_id varchar [note: 'Alternative supplier reference.']
  superseded_vendor_rebate_id varchar [note: 'Previous rebate this one supersedes.']
  vendor_procurement_supplier_id varchar [note: 'Supplier offering the rebate.']
  accrual_amount decimal(18,2) [note: 'Accrual amount.']
  accrued_amount decimal(18,2) [note: 'Amount accrued to date.']
  calculation_method varchar [note: 'Method used to calculate the rebate.']
  created_at timestamp [note: 'Alternative creation timestamp.']
  created_timestamp timestamp [note: 'Record creation timestamp.']
  currency varchar [note: 'Currency for the rebate.']
  currency_code varchar [note: 'Currency code.']
  payment_status varchar [note: 'Payment status of the rebate.']
  period_end varchar [note: 'End of rebate period.']
  period_end_date date [note: 'End date of the rebate period.']
  period_start varchar [note: 'Start of rebate period.']
  period_start_date date [note: 'Start date of the rebate period.']
  rebate_amount decimal(18,2) [note: 'Fixed rebate amount.']
  rebate_name varchar [note: 'Name of the rebate.']
  rebate_percent decimal(9,4) [note: 'Rebate percentage.']
  rebate_program_name varchar [note: 'Name of the rebate program.']
  rebate_rate decimal(9,4) [note: 'Rebate rate.']
  rebate_rate_pct decimal(9,4) [note: 'Rebate rate as percentage.']
  rebate_rate_percent decimal(18,4) [note: 'Rebate rate as a percent value.']
  rebate_status varchar [note: 'Detailed rebate status.']
  rebate_type varchar [note: 'Type of rebate (volume, spend, growth).']
  threshold_amount decimal(18,2) [note: 'Spend threshold to qualify.']
  vendor_rebate_status varchar [note: 'Current rebate status.']
  volume_threshold decimal(18,4) [note: 'Volume threshold to qualify.']

  Note: 'Vendor rebate programs tracking volume-based or spend-based rebates from suppliers.'
}

Table procurement.supplier_category_contract {
  supplier_category_contract_id varchar [pk, note: 'Primary key.']
  category_id varchar [note: 'Procurement category.']
  contract_id varchar [note: 'Associated contract.']
  procurement_supplier_id varchar [note: 'Supplier.']
  auto_renew_flag boolean [note: 'Whether auto-renews.']
  committed_spend decimal(18,2) [note: 'Committed spend amount.']
  committed_spend_amount decimal(18,2) [note: 'Alternative committed spend.']
  committed_volume varchar [note: 'Committed volume.']
  contract_end_date date [note: 'End date.']
  contract_start_date date [note: 'Start date.']
  contract_status varchar [note: 'Contract status.']
  created_timestamp timestamp [note: 'Record creation timestamp.']
  currency_code varchar [note: 'Currency.']
  discount_rate decimal(9,4) [note: 'Discount rate for the category.']
  effective_date date [note: 'Effective date.']
  end_date date [note: 'Alternative end date.']
  expiry_date date [note: 'Expiry date.']
  payment_terms decimal(18,2) [note: 'Payment terms.']
  preferred_vendor_flag boolean [note: 'Whether preferred vendor for category.']
  pricing_terms varchar [note: 'Pricing terms description.']
  rebate_rate decimal(9,4) [note: 'Rebate rate for the category.']
  start_date date [note: 'Alternative start date.']
  supplier_category_contract_status varchar [note: 'Current status.']
  updated_timestamp timestamp [note: 'Record last update timestamp.']
  vendor_rating varchar [note: 'Vendor rating for this category.']

  Note: 'Contracts linking suppliers to specific procurement categories with pricing and volume commitments.'
}

Table procurement.supply_agreement {
  supply_agreement_id varchar [pk, note: 'Primary key for the supply agreement.']
  ingredient_id varchar [note: 'Ingredient covered by the agreement.']
  procurement_supplier_id varchar [note: 'Supplier party to the agreement.']
  agreement_number varchar [note: 'Unique agreement reference number.']
  agreement_status varchar [note: 'Detailed agreement status.']
  auto_renew_flag boolean [note: 'Whether the agreement auto-renews.']
  created_timestamp timestamp [note: 'Record creation timestamp.']
  currency varchar [note: 'Alternative currency field.']
  currency_code varchar [note: 'Currency for the agreement.']
  effective_date date [note: 'Alternative effective date.']
  effective_end_date date [note: 'Effective end date.']
  effective_start_date date [note: 'Effective start date.']
  end_date date [note: 'Agreement end date.']
  expiry_date date [note: 'Expiry date.']
  governing_terms varchar [note: 'Governing terms and conditions.']
  lead_time_days varchar [note: 'Lead time in days.']
  payment_terms varchar [note: 'Payment terms.']
  price_amount decimal(18,2) [note: 'Agreed price amount.']
  price_tier_max_qty decimal(18,2) [note: 'Maximum quantity for price tier.']
  price_tier_min_qty decimal(18,2) [note: 'Minimum quantity for price tier.']
  renewal_terms varchar [note: 'Renewal terms.']
  start_date date [note: 'Agreement start date.']
  supply_agreement_status varchar [note: 'Agreement status.']
  total_commitment_value decimal(18,2) [note: 'Alternative total commitment value.']
  total_committed_value decimal(18,2) [note: 'Total committed value.']
  unit_of_measure varchar [note: 'Unit of measure for quantities.']
  updated_timestamp timestamp [note: 'Record last update timestamp.']

  Note: 'Supply agreements with suppliers for specific ingredients or products with pricing tiers and commitment values.'
}

Table procurement.product {
  product_id varchar [pk, note: 'Primary key.']
  category_id varchar [note: 'FK to procurement category.']
  parent_product_id varchar [note: 'Self-FK to parent product.']
  procurement_supplier_id varchar [note: 'FK to procurement supplier.']
  allergen_info varchar [note: 'Allergen information.']
  brand varchar [note: 'Product brand.']
  cost_price decimal(18,2) [note: 'Cost price.']
  created_timestamp timestamp [note: 'Record creation timestamp.']
  currency_code varchar [note: 'Currency code.']
  discontinued_date date [note: 'Date product was discontinued.']
  effective_from date [note: 'Effective from date.']
  effective_until date [note: 'Effective until date.']
  expiration_date decimal(9,4) [note: 'Expiration date.']
  has_allergen boolean
  hazardous_material boolean [note: 'Whether product is hazardous.']
  hazardous_material_flag boolean
  height_cm decimal(10,3) [note: 'Height in centimeters.']
  is_perishable boolean [note: 'Whether product is perishable.']
  lead_time_days varchar [note: 'Lead time in days.']
  length_cm decimal(10,3) [note: 'Length in centimeters.']
  lifecycle_stage varchar [note: 'Product lifecycle stage.']
  line varchar [note: 'Product line.']
  nutritional_info varchar [note: 'Nutritional information.']
  packaging_type varchar [note: 'Type of packaging.']
  price decimal(18,2) [note: 'Selling price.']
  product_category varchar [note: 'Product category.']
  product_description varchar [note: 'Product description.']
  product_name varchar [note: 'Product name.']
  product_status varchar [note: 'Product status.']
  reorder_point_quantity varchar [note: 'Reorder point quantity.']
  safety_stock_quantity varchar [note: 'Safety stock quantity.']
  sku varchar [note: 'Stock keeping unit.']
  subcategory varchar [note: 'Product subcategory.']
  tax_code decimal(18,2) [note: 'Tax code.']
  unit_of_measure varchar [note: 'Unit of measure.']
  upc varchar [note: 'Universal Product Code.']
  updated_timestamp timestamp [note: 'Last updated timestamp.']
  volume_liters decimal(10,3) [note: 'Volume in liters.']
  weight_kg decimal(10,3) [note: 'Weight in kilograms.']
  width_cm decimal(10,3) [note: 'Width in centimeters.']

  Note: 'Catalog of procurable products with specifications, dimensions, pricing, and lifecycle management.'
}

