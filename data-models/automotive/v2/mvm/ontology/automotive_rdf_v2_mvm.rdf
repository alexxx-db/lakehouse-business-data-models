    rdfs:range xsd:decimal .

ind:batterySocPercent rdf:type rdf:Property ;
    rdfs:label 'Battery Soc Percent' ;
    rdfs:comment 'Current electric battery charge level for EV/HEV vehicles, expressed as a percentage.' ;
