ind:unitCount rdf:type rdf:Property ;
    rdfs:label 'Unit Count' ;
    rdfs:comment 'Total number of restaurant units (company-owned and franchised) within this area.' ;
    rdfs:domain ind:AreaManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:renovationProjectId rdf:type rdf:Property ;
    rdfs:label 'Renovation Project Id' ;
    rdfs:comment 'Unique identifier for the renovation project. Primary key.' ;
    rdfs:domain ind:RenovationProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:renovationApprovedByUserEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Renovation Approved By User Employee Id' ;
    rdfs:comment 'Identifier of the user who approved the renovation project for execution.' ;
    rdfs:domain ind:RenovationProject ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:renovationEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Renovation Employee Id' ;
    rdfs:comment 'Identifier of the user who approved the renovation project for execution.' ;
    rdfs:domain ind:RenovationProject ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:renovationRestaurantUnitId rdf:type rdf:Property ;
    rdfs:label 'Renovation Restaurant Unit Id' ;
    rdfs:comment 'Identifier of the restaurant unit undergoing renovation. Links to the restaurant location being renovated.' ;
    rdfs:domain ind:RenovationProject ;
    rdf:type owl:ObjectProperty ;
