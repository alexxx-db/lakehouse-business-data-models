  provider_payer_enrollment_id varchar [note: 'FK to provider payer enrollment.']
  referral_order_id varchar [note: 'FK to the referral order.']
  stark_arrangement_id varchar [note: 'FK to Stark Law arrangement.']
  supervising_nurse_employee_id varchar [note: 'FK to the supervising nurse employee.']
  tertiary_visit_supervising_provider_clinician_id varchar [note: 'FK to the tertiary supervising provider.']
  visit_id varchar [note: 'FK to the parent visit.']
  admission_source_role varchar [note: 'Role of the provider at admission.']
  assignment_end_timestamp timestamp [note: 'Timestamp when provider assignment ended.']
  assignment_start_timestamp timestamp [note: 'Timestamp when provider assignment started.']
  assignment_status varchar [note: 'Current status of the provider assignment.']
  assignment_type varchar [note: 'Type of provider assignment.']
  billing_provider_npi varchar [note: 'NPI of the billing provider.']
  care_setting varchar [note: 'Care setting for this provider assignment.']
  care_team_sequence varchar [note: 'Sequence number within the care team.']
  comments varchar [note: 'Free-text comments about the assignment.']
  cosignature_required boolean [note: 'Flag indicating co-signature is required.']
  created_timestamp timestamp [note: 'Record creation timestamp.']
  credentialing_verified_flag boolean [note: 'Flag indicating credentialing was verified.']
  drg_attribution_flag boolean [note: 'Flag indicating provider is attributed for DRG.']
  effective_date date [note: 'Effective date of the provider assignment.']
  handoff_reference varchar [note: 'Reference to handoff documentation.']
  is_attending_of_record boolean [note: 'Flag indicating provider is the attending of record.']
  is_primary_provider boolean [note: 'Flag indicating this is the primary provider.']
  locum_tenens_flag boolean [note: 'Flag indicating locum tenens provider.']
  mips_eligible_flag boolean [note: 'Flag indicating provider is MIPS eligible.']
  note_count varchar [note: 'Number of notes authored by this provider for this visit.']
  npi varchar [note: 'National Provider Identifier.']
  on_call_flag boolean [note: 'Flag indicating provider was on call.']
  order_count varchar [note: 'Number of orders placed by this provider for this visit.']
  participation_duration_minutes varchar [note: 'Duration of provider participation in minutes.']
  place_of_service_code varchar [note: 'CMS place of service code.']
  privilege_type varchar [note: 'Type of clinical privilege exercised.']
  provider_role varchar [note: 'Role of the provider (attending, resident, consultant).']
  provider_type varchar [note: 'Type of provider (physician, NP, PA).']
  rendering_provider_npi varchar [note: 'NPI of the rendering provider.']
  rvu_credit_flag boolean [note: 'Flag indicating RVU credit is assigned.']
  rvu_work_units decimal(10,4) [note: 'Work RVU units credited to this provider.']
  source_system_record_code varchar [note: 'Source system record code.']
  specialty_at_assignment varchar [note: 'Provider specialty at time of assignment.']
  telehealth_flag boolean [note: 'Flag indicating telehealth visit.']
  updated_timestamp timestamp [note: 'Record last updated timestamp.']
  vibe_mutation_marker varchar
  vibe_structure_marker varchar
  visit_provider_status varchar

  Note: 'Association between a visit and the providers involved in care delivery.'
}

Table encounter.drg_assignment {
  drg_assignment_id varchar [pk, note: 'Surrogate primary key for the DRG assignment.']
  care_site_id varchar [note: 'FK to the care site.']
  clinician_id varchar [note: 'FK to the responsible clinician.']
