    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastSampleCollectedDate rdf:type rdf:Property ;
    rdfs:label 'Last Sample Collected Date' ;
    rdfs:comment 'Date of the most recent sample collection event at this customer location under this sampling plan. Used to calculate next scheduled sampling date and track compliance.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nextScheduledSampleDate rdf:type rdf:Property ;
    rdfs:label 'Next Scheduled Sample Date' ;
    rdfs:comment 'Date of the next scheduled sample collection event at this customer location under this sampling plan. Calculated based on sampling frequency and last collection date.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:participationNotes rdf:type rdf:Property ;
    rdfs:label 'Participation Notes' ;
