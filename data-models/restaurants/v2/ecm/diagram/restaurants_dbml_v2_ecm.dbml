  total_cost decimal(18,2) [note: 'Total line cost']
  unit_of_measure varchar [note: 'Unit of measure']
  unit_price decimal(18,2) [note: 'Unit price']
  updated_timestamp timestamp [note: 'Record last update timestamp']
  variance_amount decimal(18,2) [note: 'Monetary variance']
  variance_quantity decimal(12,3) [note: 'Variance between ordered and received']
  weight_kg decimal(10,3) [note: 'Weight in kilograms']

  Note: 'Line-level detail for goods received, including quantity, quality, and cost information.'
}

Table supply.invoice {
  invoice_id varchar [pk, note: 'Primary key']
