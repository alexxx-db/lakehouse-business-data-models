    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:criteriaMetFlag rdf:type rdf:Property ;
    rdfs:label 'Criteria Met Flag' ;
    rdfs:comment 'Indicates whether the request met all required clinical criteria (true) or not (false).' ;
    rdfs:domain ind:PaDecision ;
