  accreditation_expiration_date date [note: 'Date when accreditation expires']
  accreditation_status varchar [note: 'Current accreditation status']
  audit_frequency varchar [note: 'How often audits are conducted']
  charter_document varchar [note: 'Reference to the program charter document']
  compliance_program_status varchar
  contact_email varchar [note: 'Email address for program contact']
  contact_phone varchar [note: 'Phone number for program contact']
  created_timestamp timestamp [note: 'When the record was created']
  effective_date date [note: 'Date when the program becomes effective']
  expiration_date date [note: 'Date when the program expires']
  external_auditor_name varchar [note: 'Name of external auditing organization']
