ind:replacementPartNumber rdf:type rdf:Property ;
    rdfs:label 'Replacement Part Number' ;
    rdfs:comment 'Part number for the filter media or components used in replacements.' ;
    rdfs:domain ind:FilterUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serialNumber rdf:type rdf:Property ;
    rdfs:label 'Serial Number' ;
    rdfs:comment 'Unique serial number stamped on the filter unit.' ;
    rdfs:domain ind:FilterUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unitCode rdf:type rdf:Property ;
    rdfs:label 'Unit Code' ;
    rdfs:comment 'Business identifier or code assigned to the filter unit.' ;
    rdfs:domain ind:FilterUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:warrantyExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Warranty Expiration Date' ;
    rdfs:comment 'Date the manufacturer\'s warranty ends.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:customerAccountId rdf:type rdf:Property ;
    rdfs:label 'Customer Account Id' ;
    rdfs:comment 'Unique identifier for the customer_account data product (auto-inserted pre-linking).' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CustomerAccount .

ind:holderPersonId rdf:type rdf:Property ;
    rdfs:label 'Holder Person Id' ;
    rdfs:comment 'Foreign key linking to customer.person. Business justification: A customer account is held by a person (the account holder). This critical FK links the master account record to the individual person record. customer_account is the child in this relationship — one ' ;
    rdfs:domain ind:CustomerAccount ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Person .

ind:organizationId rdf:type rdf:Property ;
    rdfs:label 'Organization Id' ;
    rdfs:comment 'Foreign key linking to customer.organization. Business justification: Commercial and industrial customer accounts should reference the organization master record. This allows proper tracking of corporate account structures. The account table currently only has person_id' ;
    rdfs:domain ind:Customer ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Organization .

ind:personId rdf:type rdf:Property ;
    rdfs:label 'Person Id' ;
    rdfs:comment 'Unique identifier for the person record. Primary key for the person entity. Serves as the single source of truth for individual identity within the customer domain.' ;
    rdfs:domain ind:Person ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:serviceAddressId rdf:type rdf:Property ;
    rdfs:label 'Service Address Id' ;
    rdfs:comment 'add column service_address_id (BIGINT) with FK to customer.service_address.service_address_id - persons should be linkable to their primary residence address for correspondence and lead service line notifications' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ServiceAddress .

ind:autopayEnrollmentDate rdf:type rdf:Property ;
    rdfs:label 'Autopay Enrollment Date' ;
    rdfs:comment 'The date when the person enrolled in or opted out of autopay in yyyy-MM-dd format. Used for payment preference tracking and billing operations.' ;
    rdfs:domain ind:Person ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:autopayEnrollmentFlag rdf:type rdf:Property ;
    rdfs:label 'Autopay Enrollment Flag' ;
    rdfs:comment 'Boolean flag indicating whether the person has enrolled in automatic payment (autopay) for their utility bills. True if enrolled in autopay, False otherwise. Used for payment processing and customer convenience tracking.' ;
    rdfs:domain ind:Person ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:creditCheckConsentDate rdf:type rdf:Property ;
    rdfs:label 'Credit Check Consent Date' ;
    rdfs:comment 'The date when the person provided consent for credit check in yyyy-MM-dd format. Used for compliance documentation and audit trails.' ;
    rdfs:domain ind:Person ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:creditCheckConsentFlag rdf:type rdf:Property ;
    rdfs:label 'Credit Check Consent Flag' ;
    rdfs:comment 'Boolean flag indicating whether the person has provided consent for the utility to perform a credit check. True if consent given, False otherwise. Required for deposit determination and account establishment.' ;
    rdfs:domain ind:Person ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:customerSegment rdf:type rdf:Property ;
    rdfs:label 'Customer Segment' ;
    rdfs:comment 'The business segment classification of the person based on their primary account relationship. Used for rate classification, service level determination, and customer analytics. Aligns with rate schedule eligibility.' ;
    rdfs:domain ind:Customer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataSharingConsentDate rdf:type rdf:Property ;
    rdfs:label 'Data Sharing Consent Date' ;
    rdfs:comment 'The date when the person provided or withdrew data sharing consent in yyyy-MM-dd format. Used for compliance documentation and privacy management.' ;
    rdfs:domain ind:Person ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:dataSharingConsentFlag rdf:type rdf:Property ;
    rdfs:label 'Data Sharing Consent Flag' ;
    rdfs:comment 'Boolean flag indicating whether the person has consented to sharing their data with third parties (e.g., energy efficiency program partners, government agencies, research organizations). True if consent given, False otherwise.' ;
    rdfs:domain ind:Person ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dateOfBirth rdf:type rdf:Property ;
    rdfs:label 'Date Of Birth' ;
    rdfs:comment 'The person\'s date of birth in yyyy-MM-dd format. Used for identity verification, age-based service eligibility (e.g., senior citizen rates), and compliance with age-restricted service programs.' ;
    rdfs:domain ind:Person ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:disabilityAccommodationFlag rdf:type rdf:Property ;
    rdfs:label 'Disability Accommodation Flag' ;
    rdfs:comment 'Boolean flag indicating whether the person requires disability accommodations for service delivery, communications, or billing. True if accommodations required, False otherwise. Used to ensure accessible service delivery.' ;
    rdfs:domain ind:Person ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:disabilityAccommodationNotes rdf:type rdf:Property ;
    rdfs:label 'Disability Accommodation Notes' ;
    rdfs:comment 'Free-text notes describing specific disability accommodations required by the person (e.g., large print bills, TTY/TDD phone service, accessible meter location). Used to ensure appropriate service delivery and ADA compliance.' ;
    rdfs:domain ind:Person ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:emailAddress rdf:type rdf:Property ;
    rdfs:label 'Email Address' ;
    rdfs:comment 'The primary email address for the person. Used for electronic billing, service notifications, CCR (Consumer Confidence Report) delivery, and digital customer communications.' ;
    rdfs:domain ind:Person ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:governmentIdExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Government Id Expiration Date' ;
    rdfs:comment 'The expiration date of the government-issued identification document in yyyy-MM-dd format. Used to ensure identity verification documents remain current and valid.' ;
    rdfs:domain ind:Person ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:governmentIdIssuingState rdf:type rdf:Property ;
    rdfs:label 'Government Id Issuing State' ;
    rdfs:comment 'The U.S. state or territory that issued the government identification document. Used for identity verification and fraud prevention. Two-letter state abbreviation (e.g., CA, NY, TX).' ;
    rdfs:domain ind:Person ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:governmentIdNumberMasked rdf:type rdf:Property ;
    rdfs:label 'Government Id Number Masked' ;
    rdfs:comment 'The masked or partially redacted government-issued identification number (e.g., last 4 digits of SSN, masked driver\'s license number). Full number stored in secure vault; this field contains display-safe version for operational use.' ;
    rdfs:domain ind:Person ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:governmentIdType rdf:type rdf:Property ;
    rdfs:label 'Government Id Type' ;
    rdfs:comment 'The type of government-issued identification document provided by the person for identity verification during account application or service connection. Used to comply with customer identification requirements.' ;
    rdfs:domain ind:Person ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:identityVerificationDate rdf:type rdf:Property ;
    rdfs:label 'Identity Verification Date' ;
    rdfs:comment 'The date when the person\'s identity was successfully verified in yyyy-MM-dd format. Used for audit trails and compliance reporting on customer identification procedures.' ;
    rdfs:domain ind:Person ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:identityVerificationMethod rdf:type rdf:Property ;
    rdfs:label 'Identity Verification Method' ;
    rdfs:comment 'The method used to verify the person\'s identity (in-person document review, online verification service, mail-in documentation, third-party identity verification service). Used for audit and compliance tracking.' ;
    rdfs:domain ind:Customer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:identityVerificationStatus rdf:type rdf:Property ;
    rdfs:label 'Identity Verification Status' ;
    rdfs:comment 'The current status of the person\'s identity verification process. Indicates whether government-issued identification has been validated and approved for service connection and account establishment.' ;
    rdfs:domain ind:Customer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:languagePreference rdf:type rdf:Property ;
    rdfs:label 'Language Preference' ;
    rdfs:comment 'The person\'s preferred language for communications and service delivery. Three-letter ISO 639-2 language code. Used to ensure accessible customer service and compliance with language access requirements. [ENUM-REF-CANDIDATE: ENG|SPA|CHI|VIE|KOR|RUS|FRE|ARA|POR|OTH — 10 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Person ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastModifiedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Modified Timestamp' ;
    rdfs:comment 'The timestamp when this person record was last updated in yyyy-MM-ddTHH:mm:ss.SSSXXX format. Used for audit trails, change tracking, and data synchronization across systems.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:legalFirstName rdf:type rdf:Property ;
    rdfs:label 'Legal First Name' ;
    rdfs:comment 'The legal first name of the person as it appears on government-issued identification documents. Used for identity verification and legal correspondence.' ;
    rdfs:domain ind:Person ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalLastName rdf:type rdf:Property ;
    rdfs:label 'Legal Last Name' ;
    rdfs:comment 'The legal last name (surname) of the person as it appears on government-issued identification documents. Used for identity verification and legal correspondence.' ;
    rdfs:domain ind:Person ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalMiddleName rdf:type rdf:Property ;
    rdfs:label 'Legal Middle Name' ;
    rdfs:comment 'The legal middle name or initial of the person as it appears on government-issued identification documents. May be null if not provided.' ;
    rdfs:domain ind:Person ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lifeSupportEquipmentFlag rdf:type rdf:Property ;
    rdfs:label 'Life Support Equipment Flag' ;
    rdfs:comment 'Boolean flag indicating whether the person or household member relies on life-support medical equipment that requires uninterrupted water service. True if life-support equipment present, False otherwise. Used for service disconnection protection and emergency prioritization.' ;
    rdfs:domain ind:Person ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lifeSupportVerificationDate rdf:type rdf:Property ;
    rdfs:label 'Life Support Verification Date' ;
    rdfs:comment 'The date when the life-support equipment status was verified by medical certification in yyyy-MM-dd format. Used for program compliance and annual recertification tracking.' ;
    rdfs:domain ind:Person ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lowIncomeAssistanceEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Low Income Assistance Eligible Flag' ;
    rdfs:comment 'Boolean flag indicating whether the person is eligible for low-income assistance programs, rate discounts, or payment assistance based on income verification. True if eligible, False otherwise. Used for social equity program administration.' ;
    rdfs:domain ind:Customer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lowIncomeVerificationDate rdf:type rdf:Property ;
    rdfs:label 'Low Income Verification Date' ;
    rdfs:comment 'The date when the person\'s low-income status was verified for assistance program eligibility in yyyy-MM-dd format. Used for program compliance and recertification tracking.' ;
    rdfs:domain ind:Person ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:marketingConsentDate rdf:type rdf:Property ;
    rdfs:label 'Marketing Consent Date' ;
    rdfs:comment 'The date when the person provided or withdrew marketing consent in yyyy-MM-dd format. Used for compliance documentation and preference management.' ;
    rdfs:domain ind:Person ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:marketingConsentFlag rdf:type rdf:Property ;
    rdfs:label 'Marketing Consent Flag' ;
    rdfs:comment 'Boolean flag indicating whether the person has consented to receive marketing communications and promotional materials from the utility. True if consent given, False otherwise. Used to comply with marketing communication regulations.' ;
    rdfs:domain ind:Person ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:paperlessBillingEnrollmentDate rdf:type rdf:Property ;
    rdfs:label 'Paperless Billing Enrollment Date' ;
    rdfs:comment 'The date when the person enrolled in or opted out of paperless billing in yyyy-MM-dd format. Used for billing preference tracking and environmental impact reporting.' ;
    rdfs:domain ind:Person ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:paperlessBillingFlag rdf:type rdf:Property ;
    rdfs:label 'Paperless Billing Flag' ;
    rdfs:comment 'Boolean flag indicating whether the person has enrolled in paperless billing and prefers to receive bills electronically. True if enrolled in paperless billing, False if paper bills preferred.' ;
    rdfs:domain ind:Customer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:personStatus rdf:type rdf:Property ;
    rdfs:label 'Person Status' ;
    rdfs:comment 'The current lifecycle status of the person record. Active indicates the person is currently associated with one or more accounts. Inactive indicates no current account relationships. Deceased, merged, and duplicate statuses support data quality and master data management.' ;
    rdfs:domain ind:Person ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:personType rdf:type rdf:Property ;
    rdfs:label 'Person Type' ;
    rdfs:comment 'The role or relationship type of the person within the customer domain. Distinguishes between account holders, co-applicants, authorized contacts, guarantors, and other person roles. One person may have multiple types across different accounts.' ;
    rdfs:domain ind:Person ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preferredContactMethod rdf:type rdf:Property ;
    rdfs:label 'Preferred Contact Method' ;
    rdfs:comment 'The person\'s preferred method for receiving utility communications and notifications. Used to honor customer communication preferences and improve engagement rates.' ;
    rdfs:domain ind:Person ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preferredName rdf:type rdf:Property ;
    rdfs:label 'Preferred Name' ;
    rdfs:comment 'The name the person prefers to be called in day-to-day interactions, which may differ from their legal name. Used for customer service communications and personalization.' ;
    rdfs:domain ind:Person ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryPhone rdf:type rdf:Property ;
    rdfs:label 'Primary Phone' ;
    rdfs:comment 'The primary contact phone number for the person. Used for service notifications, billing inquiries, outage alerts, and emergency communications. Format may include country code, area code, and extension.' ;
    rdfs:domain ind:Person ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryPhoneType rdf:type rdf:Property ;
    rdfs:label 'Primary Phone Type' ;
    rdfs:comment 'The type of primary phone number (mobile, home, work, other). Used to determine appropriate communication channels and times for customer outreach.' ;
    rdfs:domain ind:Person ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:seniorCitizenFlag rdf:type rdf:Property ;
    rdfs:label 'Senior Citizen Flag' ;
    rdfs:comment 'Boolean flag indicating whether the person qualifies as a senior citizen for age-based rate discounts or service programs. True if senior citizen, False otherwise. Age threshold defined by utility policy and regulatory requirements.' ;
    rdfs:domain ind:Person ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:suffix rdf:type rdf:Property ;
    rdfs:label 'Suffix' ;
    rdfs:comment 'Generational or professional suffix appended to the person\'s legal name (e.g., Jr, Sr, II, III). Used to distinguish individuals with identical names.' ;
    rdfs:domain ind:Person ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:parentOrganizationId rdf:type rdf:Property ;
    rdfs:label 'Parent Organization Id' ;
    rdfs:comment 'Reference to the parent organization in corporate hierarchies. Enables consolidated billing, enterprise account management, and multi-location reporting for corporate customers.' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Organization .

ind:primaryContactPersonId rdf:type rdf:Property ;
    rdfs:label 'Primary Contact Person Id' ;
    rdfs:comment 'Foreign key linking to customer.person. Business justification: Organization currently stores primary contact details as denormalized strings (primary_contact_name, primary_contact_email, primary_contact_phone, primary_contact_title). Normalizing this to a FK to t' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Person .

ind:accountClosedDate rdf:type rdf:Property ;
    rdfs:label 'Account Closed Date' ;
    rdfs:comment 'Date when the organization\'s account was closed or terminated. Null for active accounts.' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:accountOpenedDate rdf:type rdf:Property ;
    rdfs:label 'Account Opened Date' ;
    rdfs:comment 'Date when the organization\'s first service account was established with the utility. Used for customer tenure analysis and loyalty program eligibility.' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:accountStatus rdf:type rdf:Property ;
    rdfs:label 'Account Status' ;
    rdfs:comment 'Current lifecycle status of the organization account. Active accounts receive service; Suspended accounts have service restrictions; Closed accounts are terminated.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:annualRevenueRange rdf:type rdf:Property ;
    rdfs:label 'Annual Revenue Range' ;
    rdfs:comment 'Estimated annual revenue range of the organization. Used for credit assessment, account prioritization, and business development targeting.' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:autoPayEnrolledFlag rdf:type rdf:Property ;
    rdfs:label 'Auto Pay Enrolled Flag' ;
    rdfs:comment 'Indicates whether the organization is enrolled in automatic payment processing. True if enrolled, False otherwise.' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:billingAddressLine1 rdf:type rdf:Property ;
    rdfs:label 'Billing Address Line1' ;
    rdfs:comment 'First line of the organization\'s billing address, typically street number and name. Used for invoice delivery and legal correspondence.' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingAddressLine2 rdf:type rdf:Property ;
    rdfs:label 'Billing Address Line2' ;
    rdfs:comment 'Second line of billing address for suite, floor, or department information.' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingCity rdf:type rdf:Property ;
    rdfs:label 'Billing City' ;
    rdfs:comment 'City name for the organization\'s billing address.' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingCountry rdf:type rdf:Property ;
    rdfs:label 'Billing Country' ;
    rdfs:comment 'Three-letter ISO country code for the organization\'s billing address.' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingPostalCode rdf:type rdf:Property ;
    rdfs:label 'Billing Postal Code' ;
    rdfs:comment 'ZIP or ZIP+4 postal code for the organization\'s billing address.' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingState rdf:type rdf:Property ;
    rdfs:label 'Billing State' ;
    rdfs:comment 'Two-letter state code for the organization\'s billing address.' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:creditLimitAmount rdf:type rdf:Property ;
    rdfs:label 'Credit Limit Amount' ;
    rdfs:comment 'Maximum outstanding balance allowed for the organization before service restrictions are applied. Expressed in USD.' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:creditTier rdf:type rdf:Property ;
    rdfs:label 'Credit Tier' ;
    rdfs:comment 'Internal credit rating tier assigned to the organization based on payment history, financial strength, and risk assessment. Determines deposit requirements and payment terms.' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dbaName rdf:type rdf:Property ;
    rdfs:label 'Dba Name' ;
    rdfs:comment 'Trade name or fictitious business name under which the organization operates, if different from legal name. Used for customer-facing communications and service delivery.' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:depositAmount rdf:type rdf:Property ;
    rdfs:label 'Deposit Amount' ;
    rdfs:comment 'Dollar amount of security deposit held for the organization. Expressed in USD. Null if no deposit is required.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:depositRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Deposit Required Flag' ;
    rdfs:comment 'Indicates whether a security deposit is required for this organization based on credit assessment. True if deposit is required, False otherwise.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:employeeCountRange rdf:type rdf:Property ;
    rdfs:label 'Employee Count Range' ;
    rdfs:comment 'Estimated number of employees at the organization. Used for water demand forecasting and commercial rate structure assignment. [ENUM-REF-CANDIDATE: 1_to_10|11_to_50|51_to_200|201_to_500|501_to_1000|over_1000|unknown — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:federalTaxNumber rdf:type rdf:Property ;
    rdfs:label 'Federal Tax Number' ;
    rdfs:comment 'IRS-issued Employer Identification Number (EIN) for tax reporting and identification purposes. Nine-digit number in format XX-XXXXXXX.' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incorporationDate rdf:type rdf:Property ;
    rdfs:label 'Incorporation Date' ;
    rdfs:comment 'Date the organization was legally incorporated, registered, or chartered. Used for account tenure analysis and credit assessment.' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:incorporationState rdf:type rdf:Property ;
    rdfs:label 'Incorporation State' ;
    rdfs:comment 'Two-letter state code where the organization is legally incorporated or registered. Used for jurisdictional compliance and legal correspondence.' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:industrialUserClassification rdf:type rdf:Property ;
    rdfs:label 'Industrial User Classification' ;
    rdfs:comment 'EPA classification level for industrial users subject to pretreatment requirements. Categorical Industrial User (CIU) discharges regulated pollutants; Significant Industrial User (SIU) meets discharge thresholds; Non-Significant does not meet thresholds.' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:industrialUserFlag rdf:type rdf:Property ;
    rdfs:label 'Industrial User Flag' ;
    rdfs:comment 'Indicates whether the organization is classified as an industrial user subject to pretreatment program requirements under the Clean Water Act. True if industrial user, False otherwise.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:iupExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Iup Expiration Date' ;
    rdfs:comment 'Date when the current IUP permit expires and renewal is required. Used for compliance tracking and permit renewal notifications.' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:iupPermitNumber rdf:type rdf:Property ;
    rdfs:label 'Iup Permit Number' ;
    rdfs:comment 'Permit number issued for industrial users authorized to discharge wastewater into the municipal collection system. Required for tracking pretreatment compliance and discharge monitoring.' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalName rdf:type rdf:Property ;
    rdfs:label 'Legal Name' ;
    rdfs:comment 'The official registered legal name of the organization as filed with state incorporation documents or municipal charter. Used for contracts, billing, and regulatory reporting.' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:naicsCode rdf:type rdf:Property ;
    rdfs:label 'Naics Code' ;
    rdfs:comment 'Six-digit NAICS code identifying the organization\'s primary industry sector. Used for industrial user classification, rate structure assignment, and regulatory reporting.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:organizationType rdf:type rdf:Property ;
    rdfs:label 'Organization Type' ;
    rdfs:comment 'Legal structure classification of the organization. Determines billing rules, credit policies, and regulatory treatment.' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentTermsDays rdf:type rdf:Property ;
    rdfs:label 'Payment Terms Days' ;
    rdfs:comment 'Number of days allowed for payment after invoice date. Standard terms are typically 30 days; extended terms may be granted based on credit tier.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sicCode rdf:type rdf:Property ;
    rdfs:label 'Sic Code' ;
    rdfs:comment 'Four-digit SIC code for legacy industry classification. Maintained for historical reporting and systems that have not migrated to NAICS.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:specialBillingInstructions rdf:type rdf:Property ;
    rdfs:label 'Special Billing Instructions' ;
    rdfs:comment 'Free-text field for custom billing requirements, invoice formatting preferences, or special handling instructions for the organization account.' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxExemptCertificateNumber rdf:type rdf:Property ;
    rdfs:label 'Tax Exempt Certificate Number' ;
    rdfs:comment 'State-issued tax exemption certificate number for organizations claiming tax-exempt status. Required for audit compliance.' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxExemptFlag rdf:type rdf:Property ;
    rdfs:label 'Tax Exempt Flag' ;
    rdfs:comment 'Indicates whether the organization is exempt from sales tax or utility taxes. True if tax-exempt (typically government entities), False otherwise.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:websiteUrl rdf:type rdf:Property ;
    rdfs:label 'Website Url' ;
    rdfs:comment 'Public website URL for the organization. Used for customer research and business development.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dmaId rdf:type rdf:Property ;
    rdfs:label 'Dma Id' ;
    rdfs:comment 'Foreign key linking to distribution.dma. Business justification: Service addresses fall within District Metered Areas for non-revenue water tracking, leak detection program management, and consumption pattern analysis. Essential for AWWA water audit compliance, tar' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Dma .

ind:parcelId rdf:type rdf:Property ;
    rdfs:label 'Parcel Id' ;
    rdfs:comment 'Foreign key linking to customer.parcel. Business justification: Service address is physically located on a land parcel; linking provides geographic context and eliminates isolated parcel table.' ;
    rdfs:domain ind:Customer ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Parcel .

ind:addressEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Address Effective Date' ;
    rdfs:comment 'Date when this service address became effective and available for service delivery. Start of the address lifecycle.' ;
    rdfs:domain ind:ServiceAddress ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:addressEndDate rdf:type rdf:Property ;
    rdfs:label 'Address End Date' ;
    rdfs:comment 'Date when this service address was retired or became unavailable for service. Null if address is still active.' ;
    rdfs:domain ind:ServiceAddress ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:addressLine1 rdf:type rdf:Property ;
    rdfs:label 'Address Line 1' ;
    rdfs:comment 'Primary street address line including house number, street name, and street type. First line of the physical service delivery location.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:addressLine2 rdf:type rdf:Property ;
    rdfs:label 'Address Line 2' ;
    rdfs:comment 'Secondary address line for apartment number, suite, unit, building, floor, or other location qualifier within the premise.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:addressNotes rdf:type rdf:Property ;
    rdfs:label 'Address Notes' ;
    rdfs:comment 'Free-text notes or comments about the service address including special access instructions, delivery restrictions, or historical context.' ;
    rdfs:domain ind:ServiceAddress ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:addressSourceSystem rdf:type rdf:Property ;
    rdfs:label 'Address Source System' ;
    rdfs:comment 'Name of the source system or application that created or last updated this service address record (e.g., CC&B, GIS, CRM).' ;
    rdfs:domain ind:ServiceAddress ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:addressStatus rdf:type rdf:Property ;
    rdfs:label 'Address Status' ;
    rdfs:comment 'Lifecycle status of the service address record. Values: active (currently serviceable), inactive (temporarily not in use), pending (awaiting activation), retired (permanently closed).' ;
    rdfs:domain ind:ServiceAddress ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:addressValidationStatus rdf:type rdf:Property ;
    rdfs:label 'Address Validation Status' ;
    rdfs:comment 'Status indicating whether the address has been validated against USPS or other authoritative address databases. Values: validated, unvalidated, corrected, invalid.' ;
    rdfs:domain ind:ServiceAddress ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:apn rdf:type rdf:Property ;
    rdfs:label 'Apn' ;
    rdfs:comment 'County assessor parcel number uniquely identifying the land parcel for property tax and ownership purposes. Links service address to GIS parcel data.' ;
    rdfs:domain ind:ServiceAddress ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:buildingType rdf:type rdf:Property ;
    rdfs:label 'Building Type' ;
    rdfs:comment 'Type or classification of building structure at the service address (e.g., single-family, multi-family, office, retail, warehouse, school).' ;
    rdfs:domain ind:Customer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:city rdf:type rdf:Property ;
    rdfs:label 'City' ;
    rdfs:comment 'City or municipality name where the service address is located.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:countryCode rdf:type rdf:Property ;
    rdfs:label 'Country Code' ;
    rdfs:comment 'Three-letter ISO country code for the service address (e.g., USA, CAN, MEX).' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:county rdf:type rdf:Property ;
    rdfs:label 'County' ;
    rdfs:comment 'County or parish name where the service address is located. Used for regulatory reporting and jurisdictional compliance.' ;
    rdfs:domain ind:Customer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:customerClass rdf:type rdf:Property ;
    rdfs:label 'Customer Class' ;
    rdfs:comment 'Customer classification for rate and billing purposes. Values: residential, commercial, industrial, municipal, agricultural, institutional.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:floodZoneDesignation rdf:type rdf:Property ;
    rdfs:label 'Flood Zone Designation' ;
    rdfs:comment 'FEMA flood zone classification (e.g., A, AE, X, VE) indicating flood risk level. Used for infrastructure planning and emergency response.' ;
    rdfs:domain ind:ServiceAddress ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gisFeatureCode rdf:type rdf:Property ;
    rdfs:label 'Gis Feature Code' ;
    rdfs:comment 'Unique identifier linking this service address to the corresponding feature in the Esri ArcGIS spatial database for network modeling and asset management.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:meterLocationDescription rdf:type rdf:Property ;
    rdfs:label 'Meter Location Description' ;
    rdfs:comment 'Free-text description of where the water meter is physically located at the premise (e.g., front yard, basement, alley, inside garage).' ;
    rdfs:domain ind:ServiceAddress ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:occupancyStatus rdf:type rdf:Property ;
    rdfs:label 'Occupancy Status' ;
    rdfs:comment 'Current occupancy status of the premise. Values: occupied, vacant, seasonal, under_construction.' ;
    rdfs:domain ind:ServiceAddress ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postalCode rdf:type rdf:Property ;
    rdfs:label 'Postal Code' ;
    rdfs:comment 'Five-digit ZIP code or ZIP+4 format postal code for the service address. Used for mail delivery and geographic segmentation.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceTerritoryCode rdf:type rdf:Property ;
    rdfs:label 'Service Territory Code' ;
    rdfs:comment 'Code identifying the utility service territory or franchise area where the address is located. Determines regulatory jurisdiction and service provider.' ;
    rdfs:domain ind:ServiceAddress ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceType rdf:type rdf:Property ;
    rdfs:label 'Service Type' ;
    rdfs:comment 'Type of utility service(s) available at this address. Values: water_only, wastewater_only, water_and_wastewater, stormwater, reclaimed_water.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sewerBasin rdf:type rdf:Property ;
    rdfs:label 'Sewer Basin' ;
    rdfs:comment 'Wastewater collection basin or drainage area identifier indicating which sewer system and treatment plant serve this address.' ;
    rdfs:domain ind:ServiceAddress ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:standardizedAddress rdf:type rdf:Property ;
    rdfs:label 'Standardized Address' ;
    rdfs:comment 'Fully standardized and concatenated address string following USPS formatting rules. Used for address matching and deduplication.' ;
    rdfs:domain ind:ServiceAddress ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateCode rdf:type rdf:Property ;
    rdfs:label 'State Code' ;
    rdfs:comment 'Two-letter state or province abbreviation following USPS standards (e.g., CA, TX, NY).' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:withinServiceBoundaryFlag rdf:type rdf:Property ;
    rdfs:label 'Within Service Boundary Flag' ;
    rdfs:comment 'Boolean flag indicating whether the address is within the utility\'s authorized service boundary. True if within boundary, False if outside.' ;
    rdfs:domain ind:ServiceAddress ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:premiseId rdf:type rdf:Property ;
    rdfs:label 'Premise Id' ;
    rdfs:comment 'Unique identifier for the premise record. Primary key representing the utility\'s asset record for a serviceable location.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Premise .

ind:connectedPipeMainId rdf:type rdf:Property ;
    rdfs:label 'Connected Pipe Main Id' ;
    rdfs:comment 'Foreign key linking to distribution.pipe_main. Business justification: Premises physically connect to specific distribution mains for water service delivery. Essential for hydraulic modeling, service line inventory (LCRR compliance), outage impact analysis, and main brea' ;
    rdfs:domain ind:Premise ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PipeMain .

ind:serviceClassId rdf:type rdf:Property ;
    rdfs:label 'Service Class Id' ;
    rdfs:comment 'Foreign key linking to service.service_class. Business justification: A premise is classified by service class (residential, commercial, industrial, irrigation) which determines applicable rates, meter size standards, fire flow requirements, and regulatory reporting cat' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ServiceClass .

ind:servingFacilityId rdf:type rdf:Property ;
    rdfs:label 'Serving Facility Id' ;
    rdfs:comment 'Foreign key linking to treatment.facility. Business justification: Each premise is served by a specific WTP. This link is essential for boil-water advisory notifications (identifying affected customers per facility), water quality complaint routing to the responsible' ;
    rdfs:domain ind:Premise ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Facility .

ind:backflowPreventionRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Backflow Prevention Required Flag' ;
    rdfs:comment 'Indicates whether the premise requires backflow prevention devices due to cross-connection hazards. Mandatory for commercial, industrial, and irrigation services per Safe Drinking Water Act (SDWA).' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:buildingSquareFootage rdf:type rdf:Property ;
    rdfs:label 'Building Square Footage' ;
    rdfs:comment 'Total conditioned floor area of structures on the premise in square feet. Used for commercial water demand forecasting and capacity fee assessments.' ;
    rdfs:domain ind:Premise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:connectionFeePaidAmount rdf:type rdf:Property ;
    rdfs:label 'Connection Fee Paid Amount' ;
    rdfs:comment 'Total one-time connection or capacity fees paid for this premise to establish utility service. Includes system development charges and impact fees.' ;
    rdfs:domain ind:Premise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:connectionFeePaidDate rdf:type rdf:Property ;
    rdfs:label 'Connection Fee Paid Date' ;
    rdfs:comment 'Date when connection or capacity fees were paid for this premise. Used for revenue recognition and capital improvement program (CIP) funding tracking.' ;
    rdfs:domain ind:Premise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:constructionYear rdf:type rdf:Property ;
    rdfs:label 'Construction Year' ;
    rdfs:comment 'Year the primary structure on the premise was originally constructed. Used for infrastructure age analysis and lead service line risk assessment per Lead and Copper Rule Revisions (LCRR).' ;
    rdfs:domain ind:Premise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:effectiveEndDate rdf:type rdf:Property ;
    rdfs:label 'Effective End Date' ;
    rdfs:comment 'Date when this premise record was retired or became inactive. Null for currently active premises. Supports temporal data management and historical analysis.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:effectiveStartDate rdf:type rdf:Property ;
    rdfs:label 'Effective Start Date' ;
    rdfs:comment 'Date when this premise record became active and available for service connections. Supports temporal data management and historical analysis.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:elevationFeet rdf:type rdf:Property ;
    rdfs:label 'Elevation Feet' ;
    rdfs:comment 'Ground elevation of the premise in feet above mean sea level. Critical for hydraulic pressure calculations and gravity sewer flow analysis.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:estimatedDailyDemandGallons rdf:type rdf:Property ;
    rdfs:label 'Estimated Daily Demand Gallons' ;
    rdfs:comment 'Projected average daily water consumption in gallons for this premise based on premise type, units, and historical usage patterns. Used for capacity planning and meter sizing.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fatsOilsGreaseProgramFlag rdf:type rdf:Property ;
    rdfs:label 'Fats Oils Grease Program Flag' ;
    rdfs:comment 'Indicates whether the premise is subject to Fats, Oils, and Grease (FOG) control program requirements. Applicable to food service establishments to prevent Sanitary Sewer Overflows (SSO).' ;
    rdfs:domain ind:Premise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fireProtectionRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Fire Protection Required Flag' ;
    rdfs:comment 'Indicates whether the premise requires dedicated fire protection service (fire hydrant or sprinkler connection). Determines fire service charge applicability.' ;
    rdfs:domain ind:Premise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:industrialUserPermitRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Industrial User Permit Required Flag' ;
    rdfs:comment 'Indicates whether the premise requires an Industrial User Permit (IUP) for wastewater discharge due to industrial processes. Triggers pretreatment program compliance monitoring.' ;
    rdfs:domain ind:Premise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lotSizeSquareFeet rdf:type rdf:Property ;
    rdfs:label 'Lot Size Square Feet' ;
    rdfs:comment 'Total land area of the premise parcel in square feet. Used for irrigation demand estimation and stormwater fee calculations.' ;
    rdfs:domain ind:Premise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:meterSizeInches rdf:type rdf:Property ;
    rdfs:label 'Meter Size Inches' ;
    rdfs:comment 'Standard meter size in inches required or installed at this premise based on demand characteristics. Common sizes: 0.625, 0.75, 1.0, 1.5, 2.0, 3.0, 4.0, 6.0, 8.0 inches.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:numberOfUnits rdf:type rdf:Property ;
    rdfs:label 'Number Of Units' ;
    rdfs:comment 'Count of individual dwelling or tenant units within the premise. Applicable for multi-family residential and commercial properties. Used for equivalent dwelling unit (EDU) calculations.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:parcelNumber rdf:type rdf:Property ;
    rdfs:label 'Parcel Number' ;
    rdfs:comment 'County assessor\'s parcel number (APN) or tax lot identifier for the property. Used for cross-reference with property tax records and GIS systems.' ;
    rdfs:domain ind:Customer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:peakDemandGpm rdf:type rdf:Property ;
    rdfs:label 'Peak Demand Gpm' ;
    rdfs:comment 'Estimated peak instantaneous water demand in Gallons Per Minute (GPM) for this premise. Used for hydraulic modeling and service line sizing.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:premiseNumber rdf:type rdf:Property ;
    rdfs:label 'Premise Number' ;
    rdfs:comment 'Externally-known business identifier for the premise, used in customer communications and field operations. Unique across the utility service territory.' ;
    rdfs:domain ind:Premise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:premiseStatus rdf:type rdf:Property ;
    rdfs:label 'Premise Status' ;
    rdfs:comment 'Current lifecycle status of the premise in the utility\'s service inventory. Determines whether the premise is available for service connection.' ;
    rdfs:domain ind:Premise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:premiseType rdf:type rdf:Property ;
    rdfs:label 'Premise Type' ;
    rdfs:comment 'Classification of the premise based on its primary use and service characteristics. Determines applicable rate schedules and service requirements.' ;
    rdfs:domain ind:Premise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reclaimedWaterServiceAvailableFlag rdf:type rdf:Property ;
    rdfs:label 'Reclaimed Water Service Available Flag' ;
    rdfs:comment 'Indicates whether recycled or reclaimed water distribution infrastructure is available for non-potable uses such as irrigation. Part of water conservation programs.' ;
    rdfs:domain ind:Premise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:serviceLineDiameterInches rdf:type rdf:Property ;
    rdfs:label 'Service Line Diameter Inches' ;
    rdfs:comment 'Internal diameter of the water service line in inches. Determines flow capacity and pressure loss from main to premise.' ;
    rdfs:domain ind:Premise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:serviceLineMaterial rdf:type rdf:Property ;
    rdfs:label 'Service Line Material' ;
    rdfs:comment 'Material composition of the water service line connecting the distribution main to the premise. Critical for Lead and Copper Rule Revisions (LCRR) compliance and lead service line inventory. [ENUM-REF-CANDIDATE: copper|galvanized_steel|lead|pvc|pex|hdpe|unknown — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sewerLateralDiameterInches rdf:type rdf:Property ;
    rdfs:label 'Sewer Lateral Diameter Inches' ;
    rdfs:comment 'Internal diameter of the sanitary sewer lateral in inches. Determines wastewater conveyance capacity from premise to collection system.' ;
    rdfs:domain ind:Premise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sewerLateralMaterial rdf:type rdf:Property ;
    rdfs:label 'Sewer Lateral Material' ;
    rdfs:comment 'Material composition of the sanitary sewer lateral connecting the premise to the collection main. Used for Inflow and Infiltration (I&I) risk assessment.' ;
    rdfs:domain ind:Premise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:specialNotes rdf:type rdf:Property ;
    rdfs:label 'Special Notes' ;
    rdfs:comment 'Free-text field for operational notes, access instructions, or unique characteristics of the premise relevant to field service personnel and customer service representatives.' ;
    rdfs:domain ind:Premise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stormwaterServiceAvailableFlag rdf:type rdf:Property ;
    rdfs:label 'Stormwater Service Available Flag' ;
    rdfs:comment 'Indicates whether stormwater drainage infrastructure serves this premise. Determines applicability of stormwater utility fees.' ;
    rdfs:domain ind:Premise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:wastewaterServiceAvailableFlag rdf:type rdf:Property ;
    rdfs:label 'Wastewater Service Available Flag' ;
    rdfs:comment 'Indicates whether sanitary sewer collection infrastructure is available to serve this premise. True if sewer mains are accessible within standard connection distance.' ;
    rdfs:domain ind:Premise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:waterServiceAvailableFlag rdf:type rdf:Property ;
    rdfs:label 'Water Service Available Flag' ;
    rdfs:comment 'Indicates whether potable water distribution infrastructure is available to serve this premise. True if water mains are accessible within standard connection distance.' ;
    rdfs:domain ind:Premise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:zoningClassification rdf:type rdf:Property ;
    rdfs:label 'Zoning Classification' ;
    rdfs:comment 'Municipal zoning code designation for the premise parcel. Determines permitted land uses and development density. Format varies by jurisdiction.' ;
    rdfs:domain ind:Premise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceAgreementId rdf:type rdf:Property ;
    rdfs:label 'Service Agreement Id' ;
    rdfs:comment 'Unique identifier for the customer_service_agreement data product (auto-inserted pre-linking).' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ServiceAgreement .

ind:offeringId rdf:type rdf:Property ;
    rdfs:label 'Offering Id' ;
    rdfs:comment 'Foreign key linking to service.offering. Business justification: A service agreement is established for a specific service offering (potable water, recycled water, fire protection). The offering defines base rates, meter size requirements, and SLA terms. New servic' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Offering .

ind:tariffId rdf:type rdf:Property ;
    rdfs:label 'Tariff Id' ;
    rdfs:comment 'Foreign key linking to service.tariff. Business justification: Each service agreement is subject to a specific tariff approved by the regulatory authority. Rate dispute resolution, regulatory reporting, and billing accuracy all require knowing which tariff govern' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Tariff .

ind:serviceApplicationId rdf:type rdf:Property ;
    rdfs:label 'Service Application Id' ;
    rdfs:comment 'Unique identifier for the service application record. Primary key.' ;
    rdfs:domain ind:ServiceApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:applicantPersonId rdf:type rdf:Property ;
    rdfs:label 'Applicant Person Id' ;
    rdfs:comment 'Foreign key linking to customer.person. Business justification: Service applications capture applicant details that should reference the person master record. This eliminates data duplication and ensures applicant identity is properly managed. The person table con' ;
    rdfs:domain ind:ServiceApplication ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Person .

ind:primaryServiceCustomerAccountId rdf:type rdf:Property ;
    rdfs:label 'Primary Service Customer Account Id' ;
    rdfs:comment 'Reference to the customer (applicant) who submitted this service application. Links to the customer master record.' ;
    rdfs:domain ind:ServiceApplication ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CustomerAccount .

ind:resultingServiceAgreementId rdf:type rdf:Property ;
    rdfs:label 'Resulting Service Agreement Id' ;
    rdfs:comment 'Foreign key linking to customer.service_agreement. Business justification: A service application, when approved, results in the creation of a service agreement. This FK captures the lifecycle link from application to the resulting agreement, enabling traceability of how each' ;
    rdfs:domain ind:ServiceApplication ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ServiceAgreement .

ind:applicationNumber rdf:type rdf:Property ;
    rdfs:label 'Application Number' ;
    rdfs:comment 'Externally-visible unique application number assigned when the customer submits a service application. Used for customer communication and tracking.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicationStatus rdf:type rdf:Property ;
    rdfs:label 'Application Status' ;
    rdfs:comment 'Current lifecycle status of the service application: submitted (initial state), under review (being processed by utility staff), approved (ready for service establishment), rejected (application denied), withdrawn (applicant cancelled), or pending payment (awaiting deposit or connection fee).' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicationType rdf:type rdf:Property ;
    rdfs:label 'Application Type' ;
    rdfs:comment 'Type of service application: new service establishment, transfer of service to new occupant, service upgrade (larger meter or additional service), service downgrade, service termination, or reconnection after disconnection.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvalDate rdf:type rdf:Property ;
    rdfs:label 'Approval Date' ;
    rdfs:comment 'Date when the service application was approved by the utility, authorizing service establishment.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:approvalTimestamp rdf:type rdf:Property ;
    rdfs:label 'Approval Timestamp' ;
    rdfs:comment 'Precise date and time when the service application was approved.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:connectionFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Connection Fee Amount' ;
    rdfs:comment 'One-time connection or service establishment fee charged to the applicant for initiating water or wastewater service at the premise.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:creditCheckResult rdf:type rdf:Property ;
    rdfs:label 'Credit Check Result' ;
    rdfs:comment 'Outcome of the credit check: pass (credit meets utility standards), fail (credit does not meet standards, deposit required), insufficient history (no credit history available), or not applicable (credit check not performed).' ;
    rdfs:domain ind:ServiceApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:creditCheckStatus rdf:type rdf:Property ;
    rdfs:label 'Credit Check Status' ;
    rdfs:comment 'Status of credit check for the applicant: not required (based on service class or policy), pending (credit check requested), completed (credit check results received), or waived (credit check requirement waived by management).' ;
    rdfs:domain ind:ServiceApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:creditScore rdf:type rdf:Property ;
    rdfs:label 'Credit Score' ;
    rdfs:comment 'Numeric credit score obtained from credit bureau for the applicant, used to determine deposit requirements and service approval.' ;
    rdfs:domain ind:ServiceApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:meterSizeRequested rdf:type rdf:Property ;
    rdfs:label 'Meter Size Requested' ;
    rdfs:comment 'Size of water meter requested by the applicant or recommended by utility staff based on anticipated usage (e.g., 5/8 inch, 3/4 inch, 1 inch, 1.5 inch, 2 inch, etc.).' ;
    rdfs:domain ind:ServiceApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorityLevel rdf:type rdf:Property ;
    rdfs:label 'Priority Level' ;
    rdfs:comment 'Priority level assigned to the application for processing: low (standard processing), normal (default priority), high (expedited processing requested), or urgent (emergency service needed).' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:processingNotes rdf:type rdf:Property ;
    rdfs:label 'Processing Notes' ;
    rdfs:comment 'Free-text notes entered by utility staff during application review and processing, documenting special circumstances, follow-up actions, or additional context.' ;
    rdfs:domain ind:ServiceApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rejectionDate rdf:type rdf:Property ;
    rdfs:label 'Rejection Date' ;
    rdfs:comment 'Date when the service application was rejected by the utility. Null if application was not rejected.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:rejectionReason rdf:type rdf:Property ;
    rdfs:label 'Rejection Reason' ;
    rdfs:comment 'Detailed explanation of why the service application was rejected (e.g., failed credit check, incomplete documentation, service not available at address, outstanding balance from previous account).' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rejectionReasonCode rdf:type rdf:Property ;
    rdfs:label 'Rejection Reason Code' ;
    rdfs:comment 'Standardized code categorizing the reason for application rejection: credit failure, incomplete documentation, service unavailable at location, outstanding balance from prior account, duplicate application, or invalid service address.' ;
    rdfs:domain ind:ServiceApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestedServiceStartDate rdf:type rdf:Property ;
    rdfs:label 'Requested Service Start Date' ;
    rdfs:comment 'Date when the applicant requests water or wastewater service to begin at the service address.' ;
    rdfs:domain ind:ServiceApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reviewCompletedDate rdf:type rdf:Property ;
    rdfs:label 'Review Completed Date' ;
    rdfs:comment 'Date when the application review process was completed and a decision (approved or rejected) was made.' ;
    rdfs:domain ind:ServiceApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reviewStartDate rdf:type rdf:Property ;
    rdfs:label 'Review Start Date' ;
    rdfs:comment 'Date when utility staff began reviewing and processing the service application.' ;
    rdfs:domain ind:ServiceApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:serviceTypeRequested rdf:type rdf:Property ;
    rdfs:label 'Service Type Requested' ;
    rdfs:comment 'Type of utility service requested by the applicant: water only, wastewater (sewer) only, or combined water and wastewater service.' ;
    rdfs:domain ind:ServiceApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:slaDueDate rdf:type rdf:Property ;
    rdfs:label 'Sla Due Date' ;
    rdfs:comment 'Target date by which the application should be reviewed and processed according to utility service level agreement standards.' ;
    rdfs:domain ind:ServiceApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:submissionChannel rdf:type rdf:Property ;
    rdfs:label 'Submission Channel' ;
    rdfs:comment 'Channel through which the customer submitted the service application: online customer portal, phone call to customer service, walk-in at utility office, postal mail, mobile app, or email.' ;
    rdfs:domain ind:ServiceApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submissionDate rdf:type rdf:Property ;
    rdfs:label 'Submission Date' ;
    rdfs:comment 'Date when the customer submitted the service application.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:submissionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Submission Timestamp' ;
    rdfs:comment 'Precise date and time when the service application was submitted by the customer or entered into the system.' ;
    rdfs:domain ind:ServiceApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:withdrawnDate rdf:type rdf:Property ;
    rdfs:label 'Withdrawn Date' ;
    rdfs:comment 'Date when the applicant withdrew or cancelled the service application. Null if application was not withdrawn.' ;
    rdfs:domain ind:ServiceApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:withdrawnReason rdf:type rdf:Property ;
    rdfs:label 'Withdrawn Reason' ;
    rdfs:comment 'Reason provided by the applicant for withdrawing the service application (e.g., changed mind, moved to different location, service no longer needed).' ;
    rdfs:domain ind:ServiceApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interactionId rdf:type rdf:Property ;
    rdfs:label 'Interaction Id' ;
    rdfs:comment 'Unique identifier for each customer interaction record. Primary key.' ;
    rdfs:domain ind:Interaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:agreementId rdf:type rdf:Property ;
    rdfs:label 'Agreement Id' ;
    rdfs:comment 'Foreign key linking to service.agreement. Business justification: Customer service interactions (calls, portal sessions) are frequently about a specific service agreement — billing questions, service changes, contract renewals. CRM workflows and first-contact-resolu' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Agreement .

ind:collectionSystemBlockageId rdf:type rdf:Property ;
    rdfs:label 'Collection System Blockage Id' ;
    rdfs:comment 'Foreign key linking to wastewater.collection_system_blockage. Business justification: Customer service interactions about sewer backups must reference the associated blockage event. Agents need the blockage record to provide status, estimated clearance time, and document customer impac' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CollectionSystemBlockage .

ind:contactPersonId rdf:type rdf:Property ;
    rdfs:label 'Contact Person Id' ;
    rdfs:comment 'Foreign key linking to customer.person. Business justification: Customer interactions capture contact details that should reference the person master when the contact is a known person. This eliminates duplication of person contact information. Nullable as some in' ;
    rdfs:domain ind:Interaction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Person .

ind:hydrantId rdf:type rdf:Property ;
    rdfs:label 'Hydrant Id' ;
    rdfs:comment 'Foreign key linking to distribution.hydrant. Business justification: Customer reports about hydrant problems (leaking, damaged, blocked access, vandalism) reference specific hydrant assets. Enables tracking of public-reported hydrant defects, prioritizing inspection/re' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Hydrant .

ind:mainBreakId rdf:type rdf:Property ;
    rdfs:label 'Main Break Id' ;
    rdfs:comment 'Foreign key linking to distribution.main_break. Business justification: Customer service interactions (outage calls, pressure complaints, road damage reports) are frequently triggered by main break events. Linking interactions to the specific main_break enables outage com' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MainBreak .

ind:networkValveId rdf:type rdf:Property ;
    rdfs:label 'Network Valve Id' ;
    rdfs:comment 'Foreign key linking to distribution.network_valve. Business justification: Customer reports about valve issues (leaking valve box, exposed valve, damaged cover) reference specific valve assets. Enables public-sourced defect identification, prioritizes valve maintenance, and' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:NetworkValve .

ind:orderId rdf:type rdf:Property ;
    rdfs:label 'Order Id' ;
    rdfs:comment 'Reference to a service request created as a result of this interaction. Null if no service request was generated.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Order .

ind:ssoEventId rdf:type rdf:Property ;
    rdfs:label 'Sso Event Id' ;
    rdfs:comment 'Foreign key linking to wastewater.sso_event. Business justification: Customer service agents handling calls about sewage overflows need to reference the active SSO event record. This link enables agents to provide accurate status updates, log interaction context agains' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SsoEvent .

ind:violationId rdf:type rdf:Property ;
    rdfs:label 'Violation Id' ;
    rdfs:comment 'Foreign key linking to compliance.compliance_violation. Business justification: Customer interactions may report violations or document utility response to violation-related inquiries—customer service and regulatory documentation requirement for tracking public complaints and res' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Violation .

ind:accessibilityAccommodation rdf:type rdf:Property ;
    rdfs:label 'Accessibility Accommodation' ;
    rdfs:comment 'Description of any accessibility accommodations provided during the interaction (e.g., TTY, large print, sign language). Null if no accommodation was required.' ;
    rdfs:domain ind:Interaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agentName rdf:type rdf:Property ;
    rdfs:label 'Agent Name' ;
    rdfs:comment 'Full name of the customer service agent who handled the interaction. Null for self-service interactions.' ;
    rdfs:domain ind:Interaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:callbackCompletedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Callback Completed Timestamp' ;
    rdfs:comment 'Date and time when the requested callback was completed. Null if callback was not requested or not yet completed.' ;
    rdfs:domain ind:Interaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:callbackRequestedFlag rdf:type rdf:Property ;
    rdfs:label 'Callback Requested Flag' ;
    rdfs:comment 'Indicates whether the customer requested a callback from the utility.' ;
    rdfs:domain ind:Interaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:caseNumber rdf:type rdf:Property ;
    rdfs:label 'Case Number' ;
    rdfs:comment 'Reference to a formal case or complaint record created in the CRM system as a result of this interaction. Null if no case was created.' ;
    rdfs:domain ind:Interaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:category rdf:type rdf:Property ;
    rdfs:label 'Category' ;
    rdfs:comment 'High-level category grouping for the interaction type, used for reporting and analytics (e.g., billing, service delivery, water quality, account management).' ;
    rdfs:domain ind:Customer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:channel rdf:type rdf:Property ;
    rdfs:label 'Channel' ;
    rdfs:comment 'Channel through which the interaction occurred: inbound call, outbound call, web portal, mobile app, email, chat, walk-in visit, IVR self-service, or SMS. [ENUM-REF-CANDIDATE: inbound_call|outbound_call|web_portal|mobile_app|email|chat|walk_in|ivr|sms — 9 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:closedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Closed Timestamp' ;
    rdfs:comment 'Date and time when the interaction was formally closed. Null if interaction is not yet closed.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:customerSatisfactionScore rdf:type rdf:Property ;
    rdfs:label 'Customer Satisfaction Score' ;
    rdfs:comment 'Customer satisfaction rating provided by the customer after the interaction, typically on a scale of 1 to 5. Null if not captured.' ;
    rdfs:domain ind:Interaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:description rdf:type rdf:Property ;
    rdfs:label 'Description' ;
    rdfs:comment 'Detailed narrative description of the interaction, including customer inquiry, issue reported, and any relevant context provided by the customer or agent.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:durationSeconds rdf:type rdf:Property ;
    rdfs:label 'Duration Seconds' ;
    rdfs:comment 'Total duration of the interaction in seconds, applicable primarily to call and chat channels. Null for asynchronous channels like email.' ;
    rdfs:domain ind:Interaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:escalationFlag rdf:type rdf:Property ;
    rdfs:label 'Escalation Flag' ;
    rdfs:comment 'Indicates whether the interaction was escalated to a supervisor, specialist, or higher tier of support.' ;
    rdfs:domain ind:Interaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:escalationReason rdf:type rdf:Property ;
    rdfs:label 'Escalation Reason' ;
    rdfs:comment 'Reason for escalating the interaction, such as complex technical issue, customer dissatisfaction, or policy exception required. Null if not escalated.' ;
    rdfs:domain ind:Interaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:firstContactResolutionFlag rdf:type rdf:Property ;
    rdfs:label 'First Contact Resolution Flag' ;
    rdfs:comment 'Indicates whether the interaction was resolved during the first contact without requiring follow-up. Key customer service performance indicator.' ;
    rdfs:domain ind:Interaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:interactionNumber rdf:type rdf:Property ;
    rdfs:label 'Interaction Number' ;
    rdfs:comment 'Business-facing unique identifier for the interaction, used for tracking and reference in customer communications.' ;
    rdfs:domain ind:Interaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interactionStatus rdf:type rdf:Property ;
    rdfs:label 'Interaction Status' ;
    rdfs:comment 'Current lifecycle status of the interaction: open, in progress, pending customer response, pending internal action, resolved, closed, or cancelled. [ENUM-REF-CANDIDATE: open|in_progress|pending_customer|pending_internal|resolved|closed|cancelled — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Interaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interactionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Interaction Timestamp' ;
    rdfs:comment 'Date and time when the interaction was initiated or received by the utility. Primary business event timestamp for the interaction.' ;
    rdfs:domain ind:Interaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:interactionType rdf:type rdf:Property ;
    rdfs:label 'Interaction Type' ;
    rdfs:comment 'Classification of the interaction purpose: billing inquiry, service request, complaint, outage report, payment arrangement, or general inquiry.' ;
    rdfs:domain ind:Interaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interpreterRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Interpreter Required Flag' ;
    rdfs:comment 'Indicates whether a language interpreter was required or used during the interaction.' ;
    rdfs:domain ind:Interaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:languageCode rdf:type rdf:Property ;
    rdfs:label 'Language Code' ;
    rdfs:comment 'Three-letter ISO 639-2 language code indicating the language used during the interaction. [ENUM-REF-CANDIDATE: ENG|SPA|FRE|CHI|VIE|KOR|RUS|ARA|POR|GER — 10 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Interaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:netPromoterScore rdf:type rdf:Property ;
    rdfs:label 'Net Promoter Score' ;
    rdfs:comment 'Net Promoter Score provided by the customer, typically on a scale of 0 to 10, measuring likelihood to recommend the utility. Null if not captured.' ;
    rdfs:domain ind:Interaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:priority rdf:type rdf:Property ;
    rdfs:label 'Priority' ;
    rdfs:comment 'Priority level assigned to the interaction based on urgency and impact: low, medium, high, urgent, or critical.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resolutionNotes rdf:type rdf:Property ;
    rdfs:label 'Resolution Notes' ;
    rdfs:comment 'Detailed notes documenting the resolution provided, actions taken, and any follow-up required. Populated when interaction is resolved or closed.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resolutionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Resolution Timestamp' ;
    rdfs:comment 'Date and time when the interaction was marked as resolved. Null if interaction is still open or in progress.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:sourceSystemCode rdf:type rdf:Property ;
    rdfs:label 'Source System Code' ;
    rdfs:comment 'Unique identifier of the interaction record in the source system, used for traceability and reconciliation.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subcategory rdf:type rdf:Property ;
    rdfs:label 'Subcategory' ;
    rdfs:comment 'Detailed subcategory within the interaction category, providing granular classification for analytics (e.g., high bill inquiry, leak report, water pressure issue).' ;
    rdfs:domain ind:Customer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subject rdf:type rdf:Property ;
    rdfs:label 'Subject' ;
    rdfs:comment 'Brief subject or title summarizing the purpose or topic of the interaction.' ;
    rdfs:domain ind:Interaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surveyCompletedFlag rdf:type rdf:Property ;
    rdfs:label 'Survey Completed Flag' ;
    rdfs:comment 'Indicates whether the customer completed a post-interaction satisfaction survey.' ;
    rdfs:domain ind:Interaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:complaintId rdf:type rdf:Property ;
    rdfs:label 'Complaint Id' ;
    rdfs:comment 'Unique identifier for the customer complaint record. Primary key.' ;
    rdfs:domain ind:Complaint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:billingInvoiceId rdf:type rdf:Property ;
    rdfs:label 'Billing Invoice Id' ;
    rdfs:comment 'Foreign key linking to billing.invoice. Business justification: Billing complaints (disputed charges, incorrect amounts) must link directly to the specific invoice in question. Utility regulators require tracking billing complaints to specific invoices for dispute' ;
    rdfs:domain ind:Complaint ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Invoice .

ind:originatingInteractionId rdf:type rdf:Property ;
    rdfs:label 'Originating Interaction Id' ;
    rdfs:comment 'Foreign key linking to customer.interaction. Business justification: A customer complaint is frequently filed during or as a result of a customer interaction (e.g., a call to the contact center). Linking customer_complaint to the originating interaction enables full tr' ;
    rdfs:domain ind:Complaint ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Interaction .

ind:pipeMainId rdf:type rdf:Property ;
    rdfs:label 'Pipe Main Id' ;
    rdfs:comment 'Foreign key linking to distribution.pipe_main. Business justification: Water quality complaints (taste, odor, discoloration, pressure) routinely reference the specific distribution main where the issue originates. Operations teams use this for targeted flushing, leak det' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PipeMain .

ind:primaryCustomerAccountId rdf:type rdf:Property ;
    rdfs:label 'Primary Customer Account Id' ;
    rdfs:comment 'Reference to the customer account associated with this complaint.' ;
    rdfs:domain ind:Complaint ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CustomerAccount .

ind:primaryCustomerOrderId rdf:type rdf:Property ;
    rdfs:label 'Primary Customer Order Id' ;
    rdfs:comment 'Reference to the service order created to address customer-facing service actions related to the complaint, such as meter test, service reconnection, or billing adjustment.' ;
    rdfs:domain ind:Complaint ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Order .

ind:primaryCustomerWorkOrderId rdf:type rdf:Property ;
    rdfs:label 'Primary Customer Work Order Id' ;
    rdfs:comment 'Reference to the work order created to address the physical or operational issue underlying the complaint, such as a repair, inspection, or maintenance activity in IBM Maximo Asset Management (CMMS).' ;
    rdfs:domain ind:Complaint ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:WorkOrder .

ind:reportedByPersonId rdf:type rdf:Property ;
    rdfs:label 'Reported By Person Id' ;
    rdfs:comment 'Foreign key linking to customer.person. Business justification: Complaints capture reporter details that should reference the person master when the reporter is a known person. This eliminates duplication and enables proper reporter tracking. Nullable as some comp' ;
    rdfs:domain ind:Complaint ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Person .

ind:serviceLineId rdf:type rdf:Property ;
    rdfs:label 'Service Line Id' ;
    rdfs:comment 'Foreign key linking to distribution.service_line. Business justification: LCRR (Lead and Copper Rule Revisions) compliance requires tracking complaints tied to specific service lines for lead material inventory and remediation reporting. Water quality and pressure complaint' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ServiceLine .

ind:triggeredWaterSampleId rdf:type rdf:Property ;
    rdfs:label 'Triggered Water Sample Id' ;
    rdfs:comment 'Foreign key linking to quality.water_sample. Business justification: Water quality complaints trigger sample collection for investigation. Linking complaint to the resulting water_sample enables complaint-resolution traceability and regulatory audit trails. water_quali' ;
    rdfs:domain ind:Complaint ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:WaterSample .

ind:wtpFacilityId rdf:type rdf:Property ;
    rdfs:label 'Wtp Facility Id' ;
    rdfs:comment 'Foreign key linking to treatment.facility. Business justification: Water quality complaints require facility-specific investigation and operator response. Linking complaints to serving facility enables proper routing to facility operators, coordinated sampling, and f' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Facility .

ind:actualResolutionDate rdf:type rdf:Property ;
    rdfs:label 'Actual Resolution Date' ;
    rdfs:comment 'Actual date when the complaint was resolved and closed.' ;
    rdfs:domain ind:Complaint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:assignedDate rdf:type rdf:Property ;
    rdfs:label 'Assigned Date' ;
    rdfs:comment 'Date when the complaint was assigned to a resolution owner.' ;
    rdfs:domain ind:Complaint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:assignedToDepartment rdf:type rdf:Property ;
    rdfs:label 'Assigned To Department' ;
    rdfs:comment 'Department or functional area responsible for resolving the complaint, such as Customer Service, Water Quality, Distribution Operations and Maintenance (O&M), Billing, or Laboratory.' ;
    rdfs:domain ind:Complaint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingAdjustmentAmount rdf:type rdf:Property ;
    rdfs:label 'Billing Adjustment Amount' ;
    rdfs:comment 'Dollar amount of billing adjustment or credit issued to the customer as a result of the complaint resolution, if applicable.' ;
    rdfs:domain ind:Complaint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:compensationProvidedFlag rdf:type rdf:Property ;
    rdfs:label 'Compensation Provided Flag' ;
    rdfs:comment 'Indicates whether any form of compensation, credit, or goodwill gesture was provided to the customer as part of the complaint resolution.' ;
    rdfs:domain ind:Complaint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:complaintNumber rdf:type rdf:Property ;
    rdfs:label 'Complaint Number' ;
    rdfs:comment 'Externally visible unique complaint tracking number assigned by the Customer Information System (CIS) or Customer Care and Billing (CC&B) system.' ;
    rdfs:domain ind:Complaint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complaintStatus rdf:type rdf:Property ;
    rdfs:label 'Complaint Status' ;
    rdfs:comment 'Current lifecycle status of the complaint in the resolution workflow. [ENUM-REF-CANDIDATE: open|in_progress|pending_customer|pending_investigation|resolved|closed|escalated|withdrawn — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Complaint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactMethod rdf:type rdf:Property ;
    rdfs:label 'Contact Method' ;
    rdfs:comment 'Channel through which the complaint was received by the utility. [ENUM-REF-CANDIDATE: phone|email|web_portal|mobile_app|in_person|mail|social_media — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Complaint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:correctiveAction rdf:type rdf:Property ;
    rdfs:label 'Corrective Action' ;
    rdfs:comment 'Specific corrective action taken to address the root cause and prevent recurrence, such as infrastructure repair, meter replacement, billing adjustment, or process improvement.' ;
    rdfs:domain ind:Complaint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:customerSatisfactionComments rdf:type rdf:Property ;
    rdfs:label 'Customer Satisfaction Comments' ;
    rdfs:comment 'Free-text feedback provided by the customer regarding their satisfaction with the complaint resolution process and outcome.' ;
    rdfs:domain ind:Complaint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:customerSatisfactionRating rdf:type rdf:Property ;
    rdfs:label 'Customer Satisfaction Rating' ;
    rdfs:comment 'Customer satisfaction score provided by the customer after complaint resolution, typically on a scale of 1 to 5 or 1 to 10.' ;
    rdfs:domain ind:Complaint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:followUpDate rdf:type rdf:Property ;
    rdfs:label 'Follow Up Date' ;
    rdfs:comment 'Scheduled date for follow-up action or customer contact to verify sustained resolution.' ;
    rdfs:domain ind:Complaint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:followUpRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Follow Up Required Flag' ;
    rdfs:comment 'Indicates whether additional follow-up action or monitoring is required after initial complaint resolution.' ;
    rdfs:domain ind:Complaint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:internalNotes rdf:type rdf:Property ;
    rdfs:label 'Internal Notes' ;
    rdfs:comment 'Internal notes and comments for staff use, not visible to the customer, documenting investigation steps, coordination with other departments, and operational context.' ;
    rdfs:domain ind:Complaint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryCaseNumber rdf:type rdf:Property ;
    rdfs:label 'Regulatory Case Number' ;
    rdfs:comment 'Case or reference number assigned by the regulatory agency for tracking the escalated complaint.' ;
    rdfs:domain ind:Complaint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryEscalationFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Escalation Flag' ;
    rdfs:comment 'Indicates whether the complaint was escalated to or originated from a regulatory agency such as state primacy agency, Public Utilities Commission (PUC), or U.S. Environmental Protection Agency (EPA).' ;
    rdfs:domain ind:Complaint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryResponseDueDate rdf:type rdf:Property ;
    rdfs:label 'Regulatory Response Due Date' ;
    rdfs:comment 'Date by which the utility must provide a formal response to the regulatory agency regarding the escalated complaint.' ;
    rdfs:domain ind:Complaint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reportedDate rdf:type rdf:Property ;
    rdfs:label 'Reported Date' ;
    rdfs:comment 'Date when the complaint was first reported to the utility by the customer.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reportedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Reported Timestamp' ;
    rdfs:comment 'Precise date and time when the complaint was logged into the system, including time zone offset.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:resolutionDescription rdf:type rdf:Property ;
    rdfs:label 'Resolution Description' ;
    rdfs:comment 'Detailed narrative of the actions taken to resolve the complaint, including investigation findings, corrective actions, and customer communication.' ;
    rdfs:domain ind:Complaint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rootCause rdf:type rdf:Property ;
    rdfs:label 'Root Cause' ;
    rdfs:comment 'Identified root cause of the complaint issue, such as main break, meter malfunction, billing system error, water treatment process deviation, or customer misunderstanding.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetResolutionDate rdf:type rdf:Property ;
    rdfs:label 'Target Resolution Date' ;
    rdfs:comment 'Target date by which the complaint should be resolved, based on Service Level Agreement (SLA) commitments and regulatory requirements.' ;
    rdfs:domain ind:Complaint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:waterQualityTestRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Water Quality Test Required Flag' ;
    rdfs:comment 'Indicates whether a water quality test was required or performed as part of the complaint investigation, particularly for complaints involving taste, odor, discoloration, or suspected contamination.' ;
    rdfs:domain ind:Complaint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:parentParcelId rdf:type rdf:Property ;
    rdfs:label 'Parent Parcel Id' ;
    rdfs:comment 'Self-referencing FK on parcel (parent_parcel_id)' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Parcel .

ind:serviceTerritoryId rdf:type rdf:Property ;
    rdfs:label 'Service Territory Id' ;
    rdfs:comment 'add column service_territory_id (BIGINT) with FK to service.territory.territory_id - parcels exist within service territories and this link is needed for service availability determination' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Territory .

ind:addressLine1 rdf:type rdf:Property ;
    rdfs:label 'Address Line1' ;
    rdfs:comment 'Primary street address of the parcel.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:addressLine2 rdf:type rdf:Property ;
    rdfs:label 'Address Line2' ;
    rdfs:comment 'Secondary address information (e.g., suite, unit).' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:areaSqft rdf:type rdf:Property ;
    rdfs:label 'Area Sqft' ;
    rdfs:comment 'Total land area of the parcel in square feet.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cadastralReference rdf:type rdf:Property ;
    rdfs:label 'Cadastral Reference' ;
    rdfs:comment 'Official cadastral registry identifier for the parcel.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:creationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Creation Timestamp' ;
    rdfs:comment 'Timestamp when the parcel record was first created in the system.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:dispositionDate rdf:type rdf:Property ;
    rdfs:label 'Disposition Date' ;
    rdfs:comment 'Date the parcel was transferred or disposed.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:geometryWkt rdf:type rdf:Property ;
    rdfs:label 'Geometry Wkt' ;
    rdfs:comment 'Well-Known Text representation of the parcel\'s spatial geometry.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isHistorical rdf:type rdf:Property ;
    rdfs:label 'Is Historical' ;
    rdfs:comment 'Indicates whether the record represents a historical (true) or current (false) parcel.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:landUseDescription rdf:type rdf:Property ;
    rdfs:label 'Land Use Description' ;
    rdfs:comment 'Narrative description of the parcel\'s land use.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastUpdatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Updated Timestamp' ;
    rdfs:comment 'Timestamp of the most recent update to the parcel record.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:ownerContactPhone rdf:type rdf:Property ;
    rdfs:label 'Owner Contact Phone' ;
    rdfs:comment 'Primary phone number for the parcel owner.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ownerEmail rdf:type rdf:Property ;
    rdfs:label 'Owner Email' ;
    rdfs:comment 'Primary email address for the parcel owner.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ownerName rdf:type rdf:Property ;
    rdfs:label 'Owner Name' ;
    rdfs:comment 'Name of the individual or entity that owns the parcel.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ownershipType rdf:type rdf:Property ;
    rdfs:label 'Ownership Type' ;
    rdfs:comment 'Legal ownership classification of the parcel.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:parcelStatus rdf:type rdf:Property ;
    rdfs:label 'Parcel Status' ;
    rdfs:comment 'Current lifecycle status of the parcel.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:parcelType rdf:type rdf:Property ;
    rdfs:label 'Parcel Type' ;
    rdfs:comment 'Category of the parcel based on land use and zoning.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxAssessedValue rdf:type rdf:Property ;
    rdfs:label 'Tax Assessed Value' ;
    rdfs:comment 'Assessed value of the parcel for property tax purposes.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:taxAssessmentYear rdf:type rdf:Property ;
    rdfs:label 'Tax Assessment Year' ;
    rdfs:comment 'Fiscal year of the tax assessment.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:valuationUsd rdf:type rdf:Property ;
    rdfs:label 'Valuation Usd' ;
    rdfs:comment 'Assessed monetary value of the parcel in US dollars.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:zipCode rdf:type rdf:Property ;
    rdfs:label 'Zip Code' ;
    rdfs:comment 'Postal code for the parcel location.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:zoningCode rdf:type rdf:Property ;
    rdfs:label 'Zoning Code' ;
    rdfs:comment 'Regulatory zoning classification code for the parcel.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assetClassId rdf:type rdf:Property ;
    rdfs:label 'Asset Class Id' ;
    rdfs:comment 'Foreign key linking to asset.asset_class. Business justification: Water mains are capital assets requiring depreciation tracking, GASB reporting, and rate base valuation. Essential for annual financial statements, regulatory asset reporting, and rate case filings.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AssetClass .

ind:assetOwner rdf:type rdf:Property ;
    rdfs:label 'Asset Owner' ;
    rdfs:comment 'Legal owner of the pipe main asset. Typically the water utility, but may be a municipality, private developer, or other entity. Important for maintenance responsibility and capital planning.' ;
    rdfs:domain ind:PipeMain ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:averageDailyFlowGpm rdf:type rdf:Property ;
    rdfs:label 'Average Daily Flow Gpm' ;
    rdfs:comment 'Average daily flow through the pipe main in gallons per minute (GPM), typically derived from SCADA flow meters or hydraulic model calibration. Used for demand analysis and capacity utilization assessment.' ;
    rdfs:domain ind:PipeMain ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:beddingType rdf:type rdf:Property ;
    rdfs:label 'Bedding Type' ;
    rdfs:comment 'Type of bedding material and installation method used to support the pipe main in the trench. Common types include sand, gravel, crushed stone, and controlled low-strength material (CLSM). Affects pipe structural integrity and longevity.' ;
    rdfs:domain ind:PipeMain ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:breakHistoryCount rdf:type rdf:Property ;
    rdfs:label 'Break History Count' ;
    rdfs:comment 'Total number of main breaks or failures recorded for this pipe main since installation. High break counts indicate poor condition and prioritize replacement. Used for reliability analysis and risk assessment.' ;
    rdfs:domain ind:PipeMain ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:cathodicProtectionFlag rdf:type rdf:Property ;
    rdfs:label 'Cathodic Protection Flag' ;
    rdfs:comment 'Indicates whether the pipe main is protected by a cathodic protection system to prevent corrosion. True if cathodic protection is installed and active; false otherwise. Primarily applicable to metallic pipes (ductile iron, steel).' ;
    rdfs:domain ind:PipeMain ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:coatingType rdf:type rdf:Property ;
    rdfs:label 'Coating Type' ;
    rdfs:comment 'Exterior coating material applied to the pipe main to protect against soil corrosion and environmental degradation. Common coatings include polyethylene wrap, epoxy, and zinc.' ;
    rdfs:domain ind:PipeMain ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:depthFeet rdf:type rdf:Property ;
    rdfs:label 'Depth Feet' ;
    rdfs:comment 'Depth of the pipe main below ground surface in feet, measured to the pipe crown. Affects frost protection, traffic load resistance, and excavation cost for repairs.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:downstreamNodeCode rdf:type rdf:Property ;
    rdfs:label 'Downstream Node Code' ;
    rdfs:comment 'Identifier of the downstream hydraulic node (junction, tank, reservoir, or pump) in the distribution network topology. Used for hydraulic modeling in Innovyze InfoWater and network connectivity analysis.' ;
    rdfs:domain ind:PipeMain ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fireFlowCapableFlag rdf:type rdf:Property ;
    rdfs:label 'Fire Flow Capable Flag' ;
    rdfs:comment 'Indicates whether the pipe main is sized and pressurized to provide adequate fire flow per AWWA and Insurance Services Office (ISO) standards. True if the main meets fire flow requirements; false otherwise.' ;
    rdfs:domain ind:PipeMain ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:gisGeometryWkt rdf:type rdf:Property ;
    rdfs:label 'Gis Geometry Wkt' ;
    rdfs:comment 'Well-Known Text (WKT) representation of the pipe main centerline geometry (LINESTRING). Captures the spatial path of the pipe for GIS integration, routing, and proximity analysis.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hazenWilliamsCFactor rdf:type rdf:Property ;
    rdfs:label 'Hazen Williams C Factor' ;
    rdfs:comment 'Hazen-Williams roughness coefficient (C-factor) used in hydraulic modeling to represent pipe friction and head loss. New pipes typically have C=130-140; older or corroded pipes may have C=80-100. Used in Innovyze InfoWater hydraulic models.' ;
    rdfs:domain ind:PipeMain ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:installationYear rdf:type rdf:Property ;
    rdfs:label 'Installation Year' ;
    rdfs:comment 'Year the pipe main was installed. Commonly used for age-based analysis and replacement prioritization when exact installation date is unknown.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:jointType rdf:type rdf:Property ;
    rdfs:label 'Joint Type' ;
    rdfs:comment 'Type of joint used to connect pipe segments. Common types include push-on, mechanical joint, flanged, welded, and restrained joint. Joint type affects installation cost, seismic resilience, and leak risk.' ;
    rdfs:domain ind:PipeMain ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastBreakDate rdf:type rdf:Property ;
    rdfs:label 'Last Break Date' ;
    rdfs:comment 'Date of the most recent main break or failure event on this pipe main. Used for failure trend analysis and to assess time since last incident.' ;
    rdfs:domain ind:PipeMain ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lengthFeet rdf:type rdf:Property ;
    rdfs:label 'Length Feet' ;
    rdfs:comment 'Physical length of the pipe main segment in feet, measured from upstream to downstream node. Used for network inventory, hydraulic modeling, and asset valuation.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lifecycleStatus rdf:type rdf:Property ;
    rdfs:label 'Lifecycle Status' ;
    rdfs:comment 'Current operational status of the pipe main in its asset lifecycle. Active pipes are in service; planned pipes are in design or budgeted; abandoned pipes are no longer used but not removed.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:liningType rdf:type rdf:Property ;
    rdfs:label 'Lining Type' ;
    rdfs:comment 'Interior lining material applied to the pipe main to prevent corrosion and maintain water quality. Common linings include cement mortar, epoxy, polyurethane, and polyethylene. Critical for compliance with Safe Drinking Water Act (SDWA) and Lead and Copper Rule Revisions (LCRR).' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maintenanceResponsibility rdf:type rdf:Property ;
    rdfs:label 'Maintenance Responsibility' ;
    rdfs:comment 'Entity responsible for operations and maintenance (O&M) of the pipe main. May differ from asset owner in cases of shared infrastructure or developer-owned systems pending transfer.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:material rdf:type rdf:Property ;
    rdfs:label 'Material' ;
    rdfs:comment 'Material composition of the pipe main. Common materials include ductile iron (DI), polyvinyl chloride (PVC), high-density polyethylene (HDPE), cast iron (CI), and steel. Material affects durability, corrosion resistance, and hydraulic performance. [ENUM-REF-CANDIDATE: ductile_iron|pvc|hdpe|cast_iron|concrete|steel|copper|galvanized_steel|asbestos_cement — 9 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maxFlowCapacityGpm rdf:type rdf:Property ;
    rdfs:label 'Max Flow Capacity Gpm' ;
    rdfs:comment 'Maximum hydraulic flow capacity of the pipe main in gallons per minute (GPM) under design conditions. Calculated based on diameter, pressure, and Hazen-Williams C-factor. Used for capacity planning and fire flow analysis.' ;
    rdfs:domain ind:PipeMain ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nominalDiameterInches rdf:type rdf:Property ;
    rdfs:label 'Nominal Diameter Inches' ;
    rdfs:comment 'Nominal inside diameter of the pipe main in inches. Standard sizes range from 2 inches for service lines to 72+ inches for transmission mains. Critical for hydraulic capacity and flow (GPM/MGD) calculations.' ;
    rdfs:domain ind:PipeMain ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:operatingPressurePsi rdf:type rdf:Property ;
    rdfs:label 'Operating Pressure Psi' ;
    rdfs:comment 'Typical operating pressure in pounds per square inch (PSI) at which the pipe main operates under normal conditions. Used for hydraulic analysis and to ensure adequate service pressure (typically 40-80 PSI at customer meters).' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pipeNumber rdf:type rdf:Property ;
    rdfs:label 'Pipe Number' ;
    rdfs:comment 'Business identifier for the pipe main, typically assigned by the utility for asset tracking and field reference. May follow utility-specific numbering conventions.' ;
    rdfs:domain ind:PipeMain ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pipeType rdf:type rdf:Property ;
    rdfs:label 'Pipe Type' ;
    rdfs:comment 'Classification of the pipe main by its function in the water distribution system. Transmission mains convey large volumes between facilities; distribution mains serve neighborhoods; service laterals connect to premises.' ;
    rdfs:domain ind:PipeMain ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pressureClassPsi rdf:type rdf:Property ;
    rdfs:label 'Pressure Class Psi' ;
    rdfs:comment 'Rated working pressure class of the pipe main in pounds per square inch (PSI). Common classes include 150, 200, 250, 300 PSI. Must meet or exceed the operating pressure of the assigned pressure zone.' ;
    rdfs:domain ind:PipeMain ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:streetName rdf:type rdf:Property ;
    rdfs:label 'Street Name' ;
    rdfs:comment 'Name of the street or roadway where the pipe main is located. Used for field crew dispatch, work order management, and public communication during maintenance or repairs.' ;
    rdfs:domain ind:PipeMain ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conditionAssessmentId rdf:type rdf:Property ;
    rdfs:label 'Condition Assessment Id' ;
    rdfs:comment 'Foreign key linking to asset.condition_assessment. Business justification: LCRR (Lead and Copper Rule Revisions) mandates condition assessments of service lines for lead pipe identification and replacement prioritization. Direct FK to condition_assessment enables regulatory ' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ConditionAssessment .

ind:criticalityRatingId rdf:type rdf:Property ;
    rdfs:label 'Criticality Rating Id' ;
    rdfs:comment 'Foreign key linking to asset.criticality_rating. Business justification: LCRR replacement prioritization requires formal criticality ratings for service lines, incorporating public health impact (lead exposure risk), customer vulnerability, and failure likelihood. Direct F' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CriticalityRating .

ind:connectionStatus rdf:type rdf:Property ;
    rdfs:label 'Connection Status' ;
    rdfs:comment 'Current operational status of the service line connection indicating whether it is actively serving a customer or has been deactivated.' ;
    rdfs:domain ind:ServiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:curbStopInstalled rdf:type rdf:Property ;
    rdfs:label 'Curb Stop Installed' ;
    rdfs:comment 'Indicates whether a curb stop shutoff valve is installed on the service line for isolation purposes.' ;
    rdfs:domain ind:ServiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:curbStopLocation rdf:type rdf:Property ;
    rdfs:label 'Curb Stop Location' ;
    rdfs:comment 'Descriptive location of the curb stop valve for field crew reference during service shutoff operations.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:diameterInches rdf:type rdf:Property ;
    rdfs:label 'Diameter Inches' ;
    rdfs:comment 'Internal diameter of the service line pipe measured in inches. Typical residential service lines range from 0.75 to 2.0 inches.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lastLeakRepairDate rdf:type rdf:Property ;
    rdfs:label 'Last Leak Repair Date' ;
    rdfs:comment 'Date of the most recent leak repair performed on this service line.' ;
    rdfs:domain ind:ServiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lcrrClassification rdf:type rdf:Property ;
    rdfs:label 'Lcrr Classification' ;
    rdfs:comment 'EPA LCRR regulatory classification of service line material status for lead service line inventory and replacement planning. Mandatory for LCRR compliance reporting.' ;
    rdfs:domain ind:ServiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lcrrInventoryVerified rdf:type rdf:Property ;
    rdfs:label 'Lcrr Inventory Verified' ;
    rdfs:comment 'Indicates whether the service line material classification has been physically verified for LCRR compliance inventory accuracy.' ;
    rdfs:domain ind:ServiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lcrrVerificationDate rdf:type rdf:Property ;
    rdfs:label 'Lcrr Verification Date' ;
    rdfs:comment 'Date when the service line material was physically verified for LCRR inventory compliance.' ;
    rdfs:domain ind:ServiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lcrrVerificationMethod rdf:type rdf:Property ;
    rdfs:label 'Lcrr Verification Method' ;
    rdfs:comment 'Method used to verify the service line material classification for LCRR compliance.' ;
    rdfs:domain ind:ServiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:leakHistoryCount rdf:type rdf:Property ;
    rdfs:label 'Leak History Count' ;
    rdfs:comment 'Total number of documented leak incidents on this service line since installation. Used for reliability assessment and replacement prioritization.' ;
    rdfs:domain ind:ServiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:materialType rdf:type rdf:Property ;
    rdfs:label 'Material Type' ;
    rdfs:comment 'Material composition of the service line pipe. Critical for Lead and Copper Rule Revisions (LCRR) compliance and corrosion risk assessment. [ENUM-REF-CANDIDATE: lead|galvanized_steel|copper|polyethylene|pvc|hdpe|unknown — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:ServiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:replacementMethod rdf:type rdf:Property ;
    rdfs:label 'Replacement Method' ;
    rdfs:comment 'Planned or executed method for service line replacement. Trenchless methods minimize surface disruption.' ;
    rdfs:domain ind:ServiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:replacementPriorityScore rdf:type rdf:Property ;
    rdfs:label 'Replacement Priority Score' ;
    rdfs:comment 'Calculated priority score for service line replacement based on age, material, leak history, and LCRR compliance requirements. Higher scores indicate higher replacement urgency.' ;
    rdfs:domain ind:ServiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:serviceLineNumber rdf:type rdf:Property ;
    rdfs:label 'Service Line Number' ;
    rdfs:comment 'Business identifier or tag number assigned to the service connection for field operations and customer reference.' ;
    rdfs:domain ind:ServiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tapSizeInches rdf:type rdf:Property ;
    rdfs:label 'Tap Size Inches' ;
    rdfs:comment 'Diameter of the tap connection point on the distribution main where the service line originates, measured in inches.' ;
    rdfs:domain ind:ServiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:primaryStorageFacilityId rdf:type rdf:Property ;
    rdfs:label 'Primary Storage Facility Id' ;
    rdfs:comment 'Identifier of the primary storage tank or reservoir that serves this pressure zone, providing hydraulic head and emergency storage.' ;
    rdfs:domain ind:PressureZone ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Facility .

ind:arcgisFeatureCode rdf:type rdf:Property ;
    rdfs:label 'Arcgis Feature Code' ;
    rdfs:comment 'Corresponding feature identifier in the Esri ArcGIS Geographic Information System (GIS) for spatial representation and network topology management.' ;
    rdfs:domain ind:PressureZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:averageDailyDemandMgd rdf:type rdf:Property ;
    rdfs:label 'Average Daily Demand Mgd' ;
    rdfs:comment 'Average daily water demand in Million Gallons per Day (MGD) for the pressure zone, used for capacity planning and hydraulic modeling.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:averageElevationFt rdf:type rdf:Property ;
    rdfs:label 'Average Elevation Ft' ;
    rdfs:comment 'Average ground elevation in feet above sea level across the pressure zone, used for hydraulic modeling and demand allocation.' ;
    rdfs:domain ind:PressureZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:boundaryDescription rdf:type rdf:Property ;
    rdfs:label 'Boundary Description' ;
    rdfs:comment 'Textual description of the geographic or infrastructure boundaries defining the pressure zone, including major streets, landmarks, or infrastructure features.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:customerCount rdf:type rdf:Property ;
    rdfs:label 'Customer Count' ;
    rdfs:comment 'Total number of active customer service connections within the pressure zone, used for demand forecasting and revenue allocation.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:designPressurePsi rdf:type rdf:Property ;
    rdfs:label 'Design Pressure Psi' ;
    rdfs:comment 'Design or nominal operating pressure in Pounds per Square Inch (PSI) for which the zone infrastructure was engineered and constructed.' ;
    rdfs:domain ind:PressureZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:elevationMaxFt rdf:type rdf:Property ;
    rdfs:label 'Elevation Max Ft' ;
    rdfs:comment 'Maximum ground elevation in feet above sea level within the pressure zone boundary, critical for pressure management and PRV settings.' ;
    rdfs:domain ind:PressureZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:elevationMinFt rdf:type rdf:Property ;
    rdfs:label 'Elevation Min Ft' ;
    rdfs:comment 'Minimum ground elevation in feet above sea level within the pressure zone boundary, used for hydraulic gradient calculations.' ;
    rdfs:domain ind:PressureZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fireFlowCapacityGpm rdf:type rdf:Property ;
    rdfs:label 'Fire Flow Capacity Gpm' ;
    rdfs:comment 'Minimum fire flow capacity in Gallons per Minute (GPM) that the pressure zone must maintain at specified residual pressure for fire protection, per Insurance Services Office (ISO) and NFPA standards.' ;
    rdfs:domain ind:PressureZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:hydraulicModelLastCalibratedDate rdf:type rdf:Property ;
    rdfs:label 'Hydraulic Model Last Calibrated Date' ;
    rdfs:comment 'Date when the hydraulic model for this pressure zone was last calibrated against field measurements, ensuring model accuracy for planning and operational decisions.' ;
    rdfs:domain ind:PressureZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:infowaterModelZoneCode rdf:type rdf:Property ;
    rdfs:label 'Infowater Model Zone Code' ;
    rdfs:comment 'Corresponding pressure zone identifier in the Innovyze InfoWater hydraulic model, used for synchronization between operational systems and modeling platforms.' ;
    rdfs:domain ind:PressureZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastBoundaryReviewDate rdf:type rdf:Property ;
    rdfs:label 'Last Boundary Review Date' ;
    rdfs:comment 'Date when the pressure zone boundaries were last reviewed and validated for accuracy, typically as part of GIS updates or hydraulic model recalibration.' ;
    rdfs:domain ind:PressureZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nrwPercentage rdf:type rdf:Property ;
    rdfs:label 'Nrw Percentage' ;
    rdfs:comment 'Percentage of Non-Revenue Water (NRW) within the pressure zone, calculated as the difference between water supplied and billed consumption, used for loss control and efficiency analysis.' ;
    rdfs:domain ind:PressureZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:peakHourDemandMgd rdf:type rdf:Property ;
    rdfs:label 'Peak Hour Demand Mgd' ;
    rdfs:comment 'Peak hourly water demand in Million Gallons per Day (MGD) for the pressure zone, critical for sizing infrastructure and ensuring adequate pressure during high-demand periods.' ;
    rdfs:domain ind:PressureZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:residualPressureFirePsi rdf:type rdf:Property ;
    rdfs:label 'Residual Pressure Fire Psi' ;
    rdfs:comment 'Minimum residual pressure in Pounds per Square Inch (PSI) that must be maintained during fire flow conditions to ensure adequate service to other customers and fire suppression effectiveness.' ;
    rdfs:domain ind:PressureZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scadaZoneTag rdf:type rdf:Property ;
    rdfs:label 'Scada Zone Tag' ;
    rdfs:comment 'SCADA system tag or point identifier for real-time monitoring of pressure, flow, and operational status within this zone via OSIsoft PI Historian or similar SCADA platforms.' ;
    rdfs:domain ind:PressureZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceAreaSqMi rdf:type rdf:Property ;
    rdfs:label 'Service Area Sq Mi' ;
    rdfs:comment 'Geographic area in square miles covered by the pressure zone, used for demand density calculations and infrastructure planning.' ;
    rdfs:domain ind:PressureZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:storageCapacityMg rdf:type rdf:Property ;
    rdfs:label 'Storage Capacity Mg' ;
    rdfs:comment 'Total storage capacity in Million Gallons (MG) of all tanks and reservoirs serving the pressure zone, used for emergency supply and pressure stabilization.' ;
    rdfs:domain ind:PressureZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:targetPressureMaxPsi rdf:type rdf:Property ;
    rdfs:label 'Target Pressure Max Psi' ;
    rdfs:comment 'Maximum target operating pressure in Pounds per Square Inch (PSI) to prevent infrastructure damage, excessive leakage, and customer service issues.' ;
    rdfs:domain ind:PressureZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:targetPressureMinPsi rdf:type rdf:Property ;
    rdfs:label 'Target Pressure Min Psi' ;
    rdfs:comment 'Minimum target operating pressure in Pounds per Square Inch (PSI) that must be maintained throughout the zone to ensure adequate service delivery and regulatory compliance.' ;
    rdfs:domain ind:PressureZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ufwPercentage rdf:type rdf:Property ;
    rdfs:label 'Ufw Percentage' ;
    rdfs:comment 'Percentage of Unaccounted-for Water (UFW) within the pressure zone, representing water losses that cannot be attributed to known uses, critical for leak detection and infrastructure assessment.' ;
    rdfs:domain ind:PressureZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:zoneCode rdf:type rdf:Property ;
    rdfs:label 'Zone Code' ;
    rdfs:comment 'Unique alphanumeric code or identifier for the pressure zone used in GIS, SCADA, and hydraulic modeling systems.' ;
    rdfs:domain ind:PressureZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:zoneName rdf:type rdf:Property ;
    rdfs:label 'Zone Name' ;
    rdfs:comment 'Business name or designation of the pressure zone used for operational reference and communication.' ;
    rdfs:domain ind:PressureZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:zoneType rdf:type rdf:Property ;
    rdfs:label 'Zone Type' ;
    rdfs:comment 'Classification of the pressure zone based on the primary method of pressure maintenance: gravity-fed from elevated storage, pumped from pump stations, combination of both, elevated tank-fed, or booster zone.' ;
    rdfs:domain ind:PressureZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:averagePressurePsi rdf:type rdf:Property ;
    rdfs:label 'Average Pressure Psi' ;
    rdfs:comment 'Average operating pressure within the DMA measured in Pounds per Square Inch. Pressure management is critical for leakage control; excessive pressure increases leak rates and pipe stress.' ;
    rdfs:domain ind:Dma ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:code rdf:type rdf:Property ;
    rdfs:label 'Code' ;
    rdfs:comment 'Business identifier code for the DMA used in operational systems, GIS, and reporting. Typically alphanumeric and unique across the distribution network.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:criticalityRating rdf:type rdf:Property ;
    rdfs:label 'Criticality Rating' ;
    rdfs:comment 'Business criticality rating of the DMA based on factors such as population served, infrastructure condition, leakage history, and service area importance. Critical DMAs receive priority for monitoring and maintenance.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:decommissionedDate rdf:type rdf:Property ;
    rdfs:label 'Decommissioned Date' ;
    rdfs:comment 'Date when the DMA was decommissioned or reconfigured. Null for active DMAs. Used for historical tracking and audit purposes.' ;
    rdfs:domain ind:Dma ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:designFlowMgd rdf:type rdf:Property ;
    rdfs:label 'Design Flow Mgd' ;
    rdfs:comment 'Design flow capacity for the DMA in Million Gallons per Day. Represents the maximum daily demand the DMA is engineered to supply under normal operating conditions.' ;
    rdfs:domain ind:Dma ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dmaStatus rdf:type rdf:Property ;
    rdfs:label 'Dma Status' ;
    rdfs:comment 'Current operational status of the DMA. Active DMAs are fully operational and monitored; inactive or decommissioned DMAs are no longer in use; planned DMAs are in design phase; under review indicates reconfiguration or audit in progress.' ;
    rdfs:domain ind:Dma ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:establishedDate rdf:type rdf:Property ;
    rdfs:label 'Established Date' ;
    rdfs:comment 'Date when the DMA was first established and commissioned for operational monitoring. Represents the start of the DMAs lifecycle.' ;
    rdfs:domain ind:Dma ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:gisPolygonBoundary rdf:type rdf:Property ;
    rdfs:label 'Gis Polygon Boundary' ;
    rdfs:comment 'GIS polygon geometry defining the spatial boundary of the DMA. Typically stored as WKT (Well-Known Text) or reference to GIS layer feature ID for integration with Esri ArcGIS.' ;
    rdfs:domain ind:Dma ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inletMeterCount rdf:type rdf:Property ;
    rdfs:label 'Inlet Meter Count' ;
    rdfs:comment 'Number of inlet flow meters installed at entry points to the DMA. Inlet meters measure total water entering the zone and are critical for NRW calculation.' ;
    rdfs:domain ind:Dma ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isolationValveCount rdf:type rdf:Property ;
    rdfs:label 'Isolation Valve Count' ;
    rdfs:comment 'Number of isolation valves installed at the DMA boundary. Isolation valves enable hydraulic isolation of the DMA for accurate flow measurement and leakage detection.' ;
    rdfs:domain ind:Dma ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lastLeakageSurveyDate rdf:type rdf:Property ;
    rdfs:label 'Last Leakage Survey Date' ;
    rdfs:comment 'Date of the most recent active leakage detection survey conducted within the DMA. Used to track compliance with leakage management programs.' ;
    rdfs:domain ind:Dma ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:leakageDetectionFrequencyDays rdf:type rdf:Property ;
    rdfs:label 'Leakage Detection Frequency Days' ;
    rdfs:comment 'Frequency in days at which active leakage detection surveys are conducted within the DMA. High-risk or high-leakage DMAs may be surveyed more frequently.' ;
    rdfs:domain ind:Dma ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:mainLengthMiles rdf:type rdf:Property ;
    rdfs:label 'Main Length Miles' ;
    rdfs:comment 'Total length of water mains (distribution pipes) within the DMA measured in miles. Used for calculating leakage per mile of main and infrastructure density metrics.' ;
    rdfs:domain ind:Dma ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumNightFlowThresholdGpm rdf:type rdf:Property ;
    rdfs:label 'Minimum Night Flow Threshold Gpm' ;
    rdfs:comment 'Minimum Night Flow threshold in Gallons per Minute. MNF is the lowest flow rate measured during nighttime hours (typically 2 AM to 4 AM) when legitimate consumption is minimal. Elevated MNF indicates leakage within the DMA.' ;
    rdfs:domain ind:Dma ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nextScheduledSurveyDate rdf:type rdf:Property ;
    rdfs:label 'Next Scheduled Survey Date' ;
    rdfs:comment 'Scheduled date for the next active leakage detection survey within the DMA. Used for planning and resource allocation.' ;
    rdfs:domain ind:Dma ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:outletMeterCount rdf:type rdf:Property ;
    rdfs:label 'Outlet Meter Count' ;
    rdfs:comment 'Number of outlet flow meters installed at exit points from the DMA. Outlet meters are used in complex DMA configurations where water may flow to adjacent zones.' ;
    rdfs:domain ind:Dma ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:populationServed rdf:type rdf:Property ;
    rdfs:label 'Population Served' ;
    rdfs:comment 'Estimated population served by the DMA. Used for per-capita consumption analysis and demand forecasting.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:prvCount rdf:type rdf:Property ;
    rdfs:label 'Prv Count' ;
    rdfs:comment 'Number of Pressure Reducing Valves installed within or at the boundary of the DMA. PRVs control pressure to reduce leakage and pipe stress.' ;
    rdfs:domain ind:Dma ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:scadaMonitoredFlag rdf:type rdf:Property ;
    rdfs:label 'Scada Monitored Flag' ;
    rdfs:comment 'Indicates whether the DMA is actively monitored by the SCADA system. SCADA-monitored DMAs provide real-time flow, pressure, and alarm data for proactive leakage management.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:serviceConnectionCount rdf:type rdf:Property ;
    rdfs:label 'Service Connection Count' ;
    rdfs:comment 'Total number of active service connections (customer meters) within the DMA. Used for calculating per-connection leakage rates and NRW metrics.' ;
    rdfs:domain ind:Dma ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:targetNrwPercentage rdf:type rdf:Property ;
    rdfs:label 'Target Nrw Percentage' ;
    rdfs:comment 'Target threshold for Non-Revenue Water as a percentage of total water supplied to the DMA. NRW includes physical losses (leakage) and commercial losses (metering inaccuracies, theft). Typical industry targets range from 10% to 20%.' ;
    rdfs:domain ind:Dma ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:targetUfwPercentage rdf:type rdf:Property ;
    rdfs:label 'Target Ufw Percentage' ;
    rdfs:comment 'Target threshold for Unaccounted-for Water as a percentage of total water supplied. UFW is a broader measure than NRW and includes all water that cannot be accounted for through billing or authorized use.' ;
    rdfs:domain ind:Dma ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pmScheduleId rdf:type rdf:Property ;
    rdfs:label 'Pm Schedule Id' ;
    rdfs:comment 'Foreign key linking to asset.pm_schedule. Business justification: Valve exercising programs are formal PM schedules required by AWWA standards and many state regulations. Direct FK to pm_schedule enables automated work order generation for valve exercising, frequenc' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PmSchedule .

ind:primaryNetworkAssetRegistryId rdf:type rdf:Property ;
    rdfs:label 'Primary Network Asset Registry Id' ;
    rdfs:comment 'Reference to the asset registry record in the Computerized Maintenance Management System (CMMS). Links this valve to IBM Maximo Asset Management for maintenance tracking, work orders, and lifecycle management.' ;
    rdfs:domain ind:NetworkValve ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Registry .

ind:burialDepthFeet rdf:type rdf:Property ;
    rdfs:label 'Burial Depth Feet' ;
    rdfs:comment 'Depth in feet from ground surface to the valve operating nut. Used for excavation planning, valve box sizing, and accessibility assessment. Typical range is 3-8 feet depending on frost line and main depth.' ;
    rdfs:domain ind:NetworkValve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:currentPosition rdf:type rdf:Property ;
    rdfs:label 'Current Position' ;
    rdfs:comment 'Actual current position of the valve as of the last field verification or SCADA reading. May differ from normal_position during maintenance, emergencies, or operational adjustments.' ;
    rdfs:domain ind:NetworkValve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exercisingFrequencyMonths rdf:type rdf:Property ;
    rdfs:label 'Exercising Frequency Months' ;
    rdfs:comment 'Planned frequency in months for valve exercising activities. Typically 12 months for standard valves, 6 months for critical isolation valves, and 24 months for low-priority valves. Drives preventive maintenance scheduling in CMMS.' ;
    rdfs:domain ind:NetworkValve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isBuried rdf:type rdf:Property ;
    rdfs:label 'Is Buried' ;
    rdfs:comment 'Indicates whether the valve is buried underground (True) or above ground in a vault or building (False). Buried valves require valve box access and are more difficult to exercise; above-ground valves are more accessible but require weather protection.' ;
    rdfs:domain ind:NetworkValve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isMotorized rdf:type rdf:Property ;
    rdfs:label 'Is Motorized' ;
    rdfs:comment 'Indicates whether the valve is equipped with a motor or actuator for remote operation. True for SCADA-controlled valves; False for manual valves requiring field crew operation.' ;
    rdfs:domain ind:NetworkValve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastExercisedBy rdf:type rdf:Property ;
    rdfs:label 'Last Exercised By' ;
    rdfs:comment 'Name or identifier of the crew member or contractor who last exercised the valve. Supports accountability and quality assurance in valve maintenance programs.' ;
    rdfs:domain ind:NetworkValve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastExercisedDate rdf:type rdf:Property ;
    rdfs:label 'Last Exercised Date' ;
    rdfs:comment 'Date the valve was last exercised (opened and closed through its full range of motion). Regular valve exercising prevents seizing and ensures operability during emergencies. AWWA recommends annual exercising for critical valves.' ;
    rdfs:domain ind:NetworkValve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:modifiedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Modified Timestamp' ;
    rdfs:comment 'Timestamp when this valve record was last modified. Supports change tracking, audit requirements, and data quality monitoring.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:normalPosition rdf:type rdf:Property ;
    rdfs:label 'Normal Position' ;
    rdfs:comment 'Standard operating position of the valve under normal conditions. Critical for hydraulic modeling, isolation planning, and Supervisory Control and Data Acquisition (SCADA) monitoring. Most distribution valves are normally open; some isolation and control valves are normally closed or throttled.' ;
    rdfs:domain ind:NetworkValve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pressureRatingPsi rdf:type rdf:Property ;
    rdfs:label 'Pressure Rating Psi' ;
    rdfs:comment 'Maximum rated working pressure of the valve in Pounds per Square Inch (PSI) as specified by the manufacturer. Must exceed operating_pressure_psi with adequate safety margin. Common ratings are 150, 200, 250, and 300 PSI.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scadaTag rdf:type rdf:Property ;
    rdfs:label 'Scada Tag' ;
    rdfs:comment 'SCADA system tag identifier for automated valves with remote monitoring and control capability. Links to OSIsoft PI Historian for real-time position monitoring, alarm management, and operational analytics. Only populated for motorized or actuated valves integrated with SCADA.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateProvince rdf:type rdf:Property ;
    rdfs:label 'State Province' ;
    rdfs:comment 'State or province in which the valve is located. Used for regulatory reporting to State Drinking Water Programs and Primacy Agencies.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:streetAddress rdf:type rdf:Property ;
    rdfs:label 'Street Address' ;
    rdfs:comment 'Nearest street address or intersection to the valve location. Provides human-readable location reference for field crews, emergency responders, and customer service representatives.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:turnsToClose rdf:type rdf:Property ;
    rdfs:label 'Turns To Close' ;
    rdfs:comment 'Number of complete turns required to fully close the valve from the fully open position. Used by field crews during valve exercising programs and emergency isolation procedures. Typical range is 5-50 turns depending on valve size and type.' ;
    rdfs:domain ind:NetworkValve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:usefulLifeYears rdf:type rdf:Property ;
    rdfs:label 'Useful Life Years' ;
    rdfs:comment 'Expected useful life of the valve in years from installation date. Used for depreciation calculations per Generally Accepted Accounting Principles (GAAP) and Governmental Accounting Standards Board (GASB) standards, and for long-term replacement planning. Typical range is 50-75 years for distribution valves.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:valveBoxType rdf:type rdf:Property ;
    rdfs:label 'Valve Box Type' ;
    rdfs:comment 'Type of valve box or access structure protecting the buried valve. Standard boxes for sidewalk/lawn areas; traffic-rated boxes for roadways; extension boxes for deep valves; vaults for large valves; none for above-ground installations.' ;
    rdfs:domain ind:NetworkValve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:valveFunction rdf:type rdf:Property ;
    rdfs:label 'Valve Function' ;
    rdfs:comment 'Primary operational function of the valve in the distribution network. Isolation valves segment the network for maintenance; control valves regulate flow; pressure reducing valves (PRV) manage pressure zones; check valves prevent backflow; air release valves expel trapped air; blowoff valves drain sections.' ;
    rdfs:domain ind:NetworkValve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:valveNumber rdf:type rdf:Property ;
    rdfs:label 'Valve Number' ;
    rdfs:comment 'Externally-known business identifier for the valve, typically painted or tagged on the valve in the field. Used by operations and maintenance crews for identification.' ;
    rdfs:domain ind:NetworkValve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:valveType rdf:type rdf:Property ;
    rdfs:label 'Valve Type' ;
    rdfs:comment 'Classification of the valve mechanism. Gate valves provide full flow with minimal pressure drop; butterfly valves are compact and quick-operating; ball valves offer tight shutoff; check valves prevent backflow; plug, cone, and needle valves provide throttling control. [ENUM-REF-CANDIDATE: gate|butterfly|ball|check|plug|cone|needle — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:NetworkValve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:buryDepthFeet rdf:type rdf:Property ;
    rdfs:label 'Bury Depth Feet' ;
    rdfs:comment 'Depth in feet from ground surface to the hydrant valve or base, critical for freeze protection and installation specifications.' ;
    rdfs:domain ind:Hydrant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:conditionStatus rdf:type rdf:Property ;
    rdfs:label 'Condition Status' ;
    rdfs:comment 'Current physical condition assessment of the hydrant based on inspection findings: excellent (like new), good (minor wear), fair (functional with moderate wear), poor (requires repair), critical (non-functional or unsafe).' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fireDistrict rdf:type rdf:Property ;
    rdfs:label 'Fire District' ;
    rdfs:comment 'Name or code of the fire protection district or fire department jurisdiction responsible for this hydrant, used for emergency response coordination.' ;
    rdfs:domain ind:Hydrant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:flowCapacityGpm rdf:type rdf:Property ;
    rdfs:label 'Flow Capacity Gpm' ;
    rdfs:comment 'Rated fire flow capacity of the hydrant in gallons per minute (GPM) at 20 pounds per square inch (PSI) residual pressure, determined by flow testing per NFPA 291.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:flowClassColor rdf:type rdf:Property ;
    rdfs:label 'Flow Class Color' ;
    rdfs:comment 'Color coding per NFPA 291 indicating fire flow capacity class: Red (<500 GPM), Orange (500-999 GPM), Green (1000-1499 GPM), Blue (>=1500 GPM), Light Blue (>=2500 GPM). Used for visual identification by fire departments.' ;
    rdfs:domain ind:Hydrant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:flushingProgramFlag rdf:type rdf:Property ;
    rdfs:label 'Flushing Program Flag' ;
    rdfs:comment 'Boolean flag indicating whether this hydrant is included in the routine unidirectional flushing program for water quality maintenance and sediment removal.' ;
    rdfs:domain ind:Hydrant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hydrantNumber rdf:type rdf:Property ;
    rdfs:label 'Hydrant Number' ;
    rdfs:comment 'External business identifier or asset tag number assigned to the hydrant for field operations, maintenance tracking, and municipal records.' ;
    rdfs:domain ind:Hydrant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hydrantType rdf:type rdf:Property ;
    rdfs:label 'Hydrant Type' ;
    rdfs:comment 'Classification of hydrant design. Dry barrel hydrants drain after use (freeze-resistant for cold climates), wet barrel hydrants remain charged with water (warm climates), flush hydrants are below-grade, wall hydrants are building-mounted.' ;
    rdfs:domain ind:Hydrant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastFlowTestDate rdf:type rdf:Property ;
    rdfs:label 'Last Flow Test Date' ;
    rdfs:comment 'Date of the most recent fire flow test conducted on the hydrant per NFPA 291 standards, used to verify flow capacity and pressure performance.' ;
    rdfs:domain ind:Hydrant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastFlushingDate rdf:type rdf:Property ;
    rdfs:label 'Last Flushing Date' ;
    rdfs:comment 'Date when the hydrant was last used for system flushing or water quality maintenance activities.' ;
    rdfs:domain ind:Hydrant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:mainDiameterInches rdf:type rdf:Property ;
    rdfs:label 'Main Diameter Inches' ;
    rdfs:comment 'Diameter of the connected water main pipe in inches, critical for fire flow capacity calculations and hydraulic modeling.' ;
    rdfs:domain ind:Hydrant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nextInspectionDueDate rdf:type rdf:Property ;
    rdfs:label 'Next Inspection Due Date' ;
    rdfs:comment 'Scheduled date for the next routine inspection of the hydrant, based on preventive maintenance (PM) schedule and regulatory requirements.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:outletCount rdf:type rdf:Property ;
    rdfs:label 'Outlet Count' ;
    rdfs:comment 'Total number of discharge outlets (nozzles) on the hydrant, typically 2-5 outlets including pumper and hose connections.' ;
    rdfs:domain ind:Hydrant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:outletSizeInches rdf:type rdf:Property ;
    rdfs:label 'Outlet Size Inches' ;
    rdfs:comment 'Sizes of hydrant outlets in inches, typically formatted as a comma-separated list (e.g., \'2.5,2.5,4.5\' for two 2.5-inch hose outlets and one 4.5-inch pumper outlet).' ;
    rdfs:domain ind:Hydrant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:residualPressurePsi rdf:type rdf:Property ;
    rdfs:label 'Residual Pressure Psi' ;
    rdfs:comment 'Residual water pressure at the hydrant in pounds per square inch (PSI) during flow testing at rated capacity, used to assess available fire flow.' ;
    rdfs:domain ind:Hydrant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:staticPressurePsi rdf:type rdf:Property ;
    rdfs:label 'Static Pressure Psi' ;
    rdfs:comment 'Static water pressure at the hydrant location in pounds per square inch (PSI) when no water is flowing, measured during flow testing.' ;
    rdfs:domain ind:Hydrant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:valveTurnsToOpen rdf:type rdf:Property ;
    rdfs:label 'Valve Turns To Open' ;
    rdfs:comment 'Number of complete turns required to fully open the hydrant main valve, used for operational training and maintenance documentation.' ;
    rdfs:domain ind:Hydrant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pumpStationId rdf:type rdf:Property ;
    rdfs:label 'Pump Station Id' ;
    rdfs:comment 'Unique identifier for the booster pump station within the distribution network. Primary key.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PumpStation .

ind:backupGeneratorAvailable rdf:type rdf:Property ;
    rdfs:label 'Backup Generator Available' ;
    rdfs:comment 'Indicates whether the pump station has a backup generator for emergency power supply.' ;
    rdfs:domain ind:PumpStation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:backupGeneratorCapacityKw rdf:type rdf:Property ;
    rdfs:label 'Backup Generator Capacity Kw' ;
    rdfs:comment 'Capacity of the backup generator in kilowatts (kW) if available.' ;
    rdfs:domain ind:PumpStation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:designFlowCapacityGpm rdf:type rdf:Property ;
    rdfs:label 'Design Flow Capacity Gpm' ;
    rdfs:comment 'Maximum design flow capacity of the pump station measured in gallons per minute (GPM).' ;
    rdfs:domain ind:PumpStation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:designFlowCapacityMgd rdf:type rdf:Property ;
    rdfs:label 'Design Flow Capacity Mgd' ;
    rdfs:comment 'Maximum design flow capacity of the pump station measured in million gallons per day (MGD).' ;
    rdfs:domain ind:PumpStation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dischargePressurePsi rdf:type rdf:Property ;
    rdfs:label 'Discharge Pressure Psi' ;
    rdfs:comment 'Target discharge pressure in pounds per square inch (PSI) maintained by the pump station.' ;
    rdfs:domain ind:PumpStation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hydraulicModelNodeCode rdf:type rdf:Property ;
    rdfs:label 'Hydraulic Model Node Code' ;
    rdfs:comment 'Node identifier in the Innovyze InfoWater hydraulic model representing this pump station.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastMajorUpgradeDate rdf:type rdf:Property ;
    rdfs:label 'Last Major Upgrade Date' ;
    rdfs:comment 'Date of the most recent major upgrade or rehabilitation of the pump station.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:maximoAssetNumber rdf:type rdf:Property ;
    rdfs:label 'Maximo Asset Number' ;
    rdfs:comment 'Asset number assigned to the pump station in the IBM Maximo CMMS for maintenance management.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:numberOfDutyPumps rdf:type rdf:Property ;
    rdfs:label 'Number Of Duty Pumps' ;
    rdfs:comment 'Count of pumps designated for normal operational duty at the station.' ;
    rdfs:domain ind:PumpStation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:numberOfPumps rdf:type rdf:Property ;
    rdfs:label 'Number Of Pumps' ;
    rdfs:comment 'Total count of pump units installed at the station, including duty and standby pumps.' ;
    rdfs:domain ind:PumpStation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:numberOfStandbyPumps rdf:type rdf:Property ;
    rdfs:label 'Number Of Standby Pumps' ;
    rdfs:comment 'Count of pumps designated as standby or backup units for redundancy.' ;
    rdfs:domain ind:PumpStation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:powerSupplyPhase rdf:type rdf:Property ;
    rdfs:label 'Power Supply Phase' ;
    rdfs:comment 'Electrical power supply phase configuration for the pump station.' ;
    rdfs:domain ind:PumpStation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:powerSupplyVoltage rdf:type rdf:Property ;
    rdfs:label 'Power Supply Voltage' ;
    rdfs:comment 'Electrical power supply voltage specification for the pump station (e.g., 480V, 4160V).' ;
    rdfs:domain ind:PumpStation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scadaIntegrated rdf:type rdf:Property ;
    rdfs:label 'Scada Integrated' ;
    rdfs:comment 'Indicates whether the pump station is integrated with the SCADA system for remote monitoring and control.' ;
    rdfs:domain ind:PumpStation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:scadaTagPrefix rdf:type rdf:Property ;
    rdfs:label 'Scada Tag Prefix' ;
    rdfs:comment 'Prefix used for SCADA tags associated with this pump station in the OSIsoft PI Historian system.' ;
    rdfs:domain ind:PumpStation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stationCode rdf:type rdf:Property ;
    rdfs:label 'Station Code' ;
    rdfs:comment 'Unique alphanumeric code assigned to the pump station for asset tracking and SCADA integration.' ;
    rdfs:domain ind:PumpStation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stationName rdf:type rdf:Property ;
    rdfs:label 'Station Name' ;
    rdfs:comment 'Business name or designation of the pump station for operational reference and reporting.' ;
    rdfs:domain ind:PumpStation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stationType rdf:type rdf:Property ;
    rdfs:label 'Station Type' ;
    rdfs:comment 'Classification of the pump station based on its operational function within the distribution network.' ;
    rdfs:domain ind:PumpStation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:suctionPressurePsi rdf:type rdf:Property ;
    rdfs:label 'Suction Pressure Psi' ;
    rdfs:comment 'Inlet or suction pressure in pounds per square inch (PSI) at the pump station intake.' ;
    rdfs:domain ind:PumpStation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalDynamicHeadFt rdf:type rdf:Property ;
    rdfs:label 'Total Dynamic Head Ft' ;
    rdfs:comment 'Total dynamic head (TDH) in feet that the pump station must overcome, including elevation and friction losses.' ;
    rdfs:domain ind:PumpStation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:vfdConfiguration rdf:type rdf:Property ;
    rdfs:label 'Vfd Configuration' ;
    rdfs:comment 'Description of the VFD configuration including number of drives and control strategy.' ;
    rdfs:domain ind:PumpStation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vfdEquipped rdf:type rdf:Property ;
    rdfs:label 'Vfd Equipped' ;
    rdfs:comment 'Indicates whether the pump station is equipped with Variable Frequency Drive (VFD) technology for flow and pressure control.' ;
    rdfs:domain ind:PumpStation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:primaryStorageDistrictMeteredAreaDmaId rdf:type rdf:Property ;
    rdfs:label 'Primary Storage District Metered Area Dma Id' ;
    rdfs:comment 'Reference to the District Metered Area (DMA) that this storage tank serves. DMAs are discrete zones used for water balance analysis and Non-Revenue Water (NRW) management.' ;
    rdfs:domain ind:StorageTank ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Dma .

ind:baseElevationFeet rdf:type rdf:Property ;
    rdfs:label 'Base Elevation Feet' ;
    rdfs:comment 'Ground or foundation elevation (in feet above mean sea level or local datum) at the base of the storage tank structure. Used for hydraulic gradient calculations.' ;
    rdfs:domain ind:StorageTank ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:capacityGallons rdf:type rdf:Property ;
    rdfs:label 'Capacity Gallons' ;
    rdfs:comment 'Total storage capacity of the tank measured in gallons. Represents the maximum volume of potable water the tank can hold at overflow elevation.' ;
    rdfs:domain ind:StorageTank ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:capacityMillionGallons rdf:type rdf:Property ;
    rdfs:label 'Capacity Million Gallons' ;
    rdfs:comment 'Total storage capacity expressed in million gallons (MG), the standard unit for water utility storage reporting and system adequacy analysis.' ;
    rdfs:domain ind:StorageTank ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:coatingCondition rdf:type rdf:Property ;
    rdfs:label 'Coating Condition' ;
    rdfs:comment 'Assessment of the current condition of the tank\'s protective coating system based on the most recent inspection: excellent (no defects), good (minor wear), fair (localized deterioration), poor (widespread deterioration), or failed (coating breakdown requiring immediate attention).' ;
    rdfs:domain ind:StorageTank ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:emergencyStorageGallons rdf:type rdf:Property ;
    rdfs:label 'Emergency Storage Gallons' ;
    rdfs:comment 'Volume of water (in gallons) reserved for emergency supply during system outages, treatment plant failures, or other contingencies. Separate from fire flow reserve and operational storage.' ;
    rdfs:domain ind:StorageTank ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fireFlowReserveGallons rdf:type rdf:Property ;
    rdfs:label 'Fire Flow Reserve Gallons' ;
    rdfs:comment 'Volume of water (in gallons) reserved in the storage tank to meet fire protection requirements and emergency fire flow demands as defined by local fire codes and insurance standards.' ;
    rdfs:domain ind:StorageTank ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:inletPipeDiameterInches rdf:type rdf:Property ;
    rdfs:label 'Inlet Pipe Diameter Inches' ;
    rdfs:comment 'Diameter (in inches) of the primary inlet pipe supplying water to the storage tank. Used for hydraulic modeling and flow capacity analysis.' ;
    rdfs:domain ind:StorageTank ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lastCleaningDate rdf:type rdf:Property ;
    rdfs:label 'Last Cleaning Date' ;
    rdfs:comment 'Date when the storage tank interior was last drained, cleaned, and disinfected. Regular cleaning is required to maintain water quality and prevent sediment accumulation.' ;
    rdfs:domain ind:StorageTank ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastCoatingDate rdf:type rdf:Property ;
    rdfs:label 'Last Coating Date' ;
    rdfs:comment 'Date when the interior or exterior protective coating was last applied or rehabilitated. Coating maintenance is critical for corrosion prevention and structural longevity.' ;
    rdfs:domain ind:StorageTank ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:maximumOperatingLevelFeet rdf:type rdf:Property ;
    rdfs:label 'Maximum Operating Level Feet' ;
    rdfs:comment 'Highest water level (in feet) at which the tank should operate under normal conditions, typically set below overflow elevation to provide freeboard and prevent overflow events.' ;
    rdfs:domain ind:StorageTank ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumOperatingLevelFeet rdf:type rdf:Property ;
    rdfs:label 'Minimum Operating Level Feet' ;
    rdfs:comment 'Lowest water level (in feet) at which the tank should operate under normal conditions to maintain adequate system pressure and prevent pump cavitation or structural stress.' ;
    rdfs:domain ind:StorageTank ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mixingSystemInstalled rdf:type rdf:Property ;
    rdfs:label 'Mixing System Installed' ;
    rdfs:comment 'Indicates whether an active mixing system is installed in the storage tank to prevent water age stratification and maintain disinfectant residual throughout the tank volume.' ;
    rdfs:domain ind:StorageTank ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mixingSystemType rdf:type rdf:Property ;
    rdfs:label 'Mixing System Type' ;
    rdfs:comment 'Type of mixing system installed: mechanical (motor-driven mixer), hydraulic (jet mixing using inlet flow), or none (no active mixing).' ;
    rdfs:domain ind:StorageTank ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outletPipeDiameterInches rdf:type rdf:Property ;
    rdfs:label 'Outlet Pipe Diameter Inches' ;
    rdfs:comment 'Diameter (in inches) of the primary outlet pipe distributing water from the storage tank to the distribution network. Used for hydraulic modeling and flow capacity analysis.' ;
    rdfs:domain ind:StorageTank ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:overflowElevationFeet rdf:type rdf:Property ;
    rdfs:label 'Overflow Elevation Feet' ;
    rdfs:comment 'Elevation (in feet above mean sea level or local datum) at which the tank overflow pipe is located. Represents the absolute maximum water level before overflow discharge occurs.' ;
    rdfs:domain ind:StorageTank ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:overflowPipeDiameterInches rdf:type rdf:Property ;
    rdfs:label 'Overflow Pipe Diameter Inches' ;
    rdfs:comment 'Diameter (in inches) of the overflow pipe that prevents tank overfilling by discharging excess water when the maximum level is reached.' ;
    rdfs:domain ind:StorageTank ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scadaFlowMeterTag rdf:type rdf:Property ;
    rdfs:label 'Scada Flow Meter Tag' ;
    rdfs:comment 'OSIsoft PI Historian tag name for the flow meter measuring inflow or outflow (GPM or MGD) from this storage tank. Used for demand analysis and water balance calculations.' ;
    rdfs:domain ind:StorageTank ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scadaLevelSensorTag rdf:type rdf:Property ;
    rdfs:label 'Scada Level Sensor Tag' ;
    rdfs:comment 'OSIsoft PI Historian tag name for the real-time water level sensor monitoring this storage tank. Used to retrieve current level, historical trends, and alarm conditions from the SCADA system.' ;
    rdfs:domain ind:StorageTank ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scadaPressureSensorTag rdf:type rdf:Property ;
    rdfs:label 'Scada Pressure Sensor Tag' ;
    rdfs:comment 'OSIsoft PI Historian tag name for the pressure sensor monitoring outlet pressure (PSI) from this storage tank. Used for hydraulic performance monitoring and pressure zone management.' ;
    rdfs:domain ind:StorageTank ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:securitySystemInstalled rdf:type rdf:Property ;
    rdfs:label 'Security System Installed' ;
    rdfs:comment 'Indicates whether physical security systems (fencing, locks, intrusion detection, surveillance cameras) are installed to protect the storage tank from unauthorized access and potential contamination threats.' ;
    rdfs:domain ind:StorageTank ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:structuralCondition rdf:type rdf:Property ;
    rdfs:label 'Structural Condition' ;
    rdfs:comment 'Overall structural integrity assessment of the storage tank based on the most recent inspection: excellent (no defects), good (minor issues), fair (moderate deterioration), poor (significant deterioration requiring repair), or critical (unsafe condition requiring immediate action).' ;
    rdfs:domain ind:StorageTank ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tankMaterial rdf:type rdf:Property ;
    rdfs:label 'Tank Material' ;
    rdfs:comment 'Primary construction material of the storage tank structure: steel (welded or bolted), concrete (cast-in-place or precast), prestressed concrete, composite (steel and concrete), or fiberglass.' ;
    rdfs:domain ind:StorageTank ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tankName rdf:type rdf:Property ;
    rdfs:label 'Tank Name' ;
    rdfs:comment 'Common name or designation of the storage tank, often referencing geographic location or service area (e.g., \'Hillside Elevated Tank\', \'Downtown Reservoir\').' ;
    rdfs:domain ind:StorageTank ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tankNumber rdf:type rdf:Property ;
    rdfs:label 'Tank Number' ;
    rdfs:comment 'Business identifier or asset tag assigned to the storage tank for operational reference and field identification.' ;
    rdfs:domain ind:StorageTank ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tankType rdf:type rdf:Property ;
    rdfs:label 'Tank Type' ;
    rdfs:comment 'Classification of storage tank by structural configuration: elevated (water tower), ground-level (surface reservoir), standpipe (tall cylindrical), reservoir (large capacity ground storage), clearwell (treated water storage at WTP), or hydropneumatic (pressure tank).' ;
    rdfs:domain ind:StorageTank ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:usableCapacityGallons rdf:type rdf:Property ;
    rdfs:label 'Usable Capacity Gallons' ;
    rdfs:comment 'Effective storage capacity available for distribution operations, calculated as the volume between minimum operating level and overflow elevation. Excludes dead storage below minimum operating level.' ;
    rdfs:domain ind:StorageTank ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:flowReadingId rdf:type rdf:Property ;
    rdfs:label 'Flow Reading Id' ;
    rdfs:comment 'Unique identifier for the flow measurement record. Primary key for the flow reading transaction.' ;
    rdfs:domain ind:FlowReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:amiEndpointId rdf:type rdf:Property ;
    rdfs:label 'Ami Endpoint Id' ;
    rdfs:comment 'Foreign key linking to metering.ami_endpoint. Business justification: DMA inlet/bulk meters equipped with AMI endpoints transmit flow readings directly into distribution flow_reading records. Linking ami_endpoint_id identifies the AMI device as the data source, supporti' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AmiEndpoint .

ind:measurementPointId rdf:type rdf:Property ;
    rdfs:label 'Measurement Point Id' ;
    rdfs:comment 'Reference to the physical location or asset where the flow measurement was captured (DMA inlet/outlet meter, pump station discharge meter, PRV station meter, or bulk transfer point).' ;
    rdfs:domain ind:FlowReading ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Point .

ind:alarmFlag rdf:type rdf:Property ;
    rdfs:label 'Alarm Flag' ;
    rdfs:comment 'Indicates whether this flow reading triggered an alarm condition in the SCADA system (e.g., flow exceeds threshold, negative flow, meter communication failure).' ;
    rdfs:domain ind:FlowReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:alarmType rdf:type rdf:Property ;
    rdfs:label 'Alarm Type' ;
    rdfs:comment 'Classification of the alarm condition if alarm_flag is true. [ENUM-REF-CANDIDATE: high_flow|low_flow|no_flow|reverse_flow|communication_failure|meter_fault|pressure_deviation|temperature_anomaly|data_gap|validation_failure — promote to reference product]' ;
    rdfs:domain ind:FlowReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingFlag rdf:type rdf:Property ;
    rdfs:label 'Billing Flag' ;
    rdfs:comment 'Indicates whether this flow reading is used for bulk water billing or wholesale customer invoicing (e.g., inter-utility transfers, industrial bulk customers).' ;
    rdfs:domain ind:FlowReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:comments rdf:type rdf:Property ;
    rdfs:label 'Comments' ;
    rdfs:comment 'Free-text field for operator notes, validation comments, or explanations of anomalies in the flow reading. Used for audit trail and troubleshooting.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedFlag rdf:type rdf:Property ;
    rdfs:label 'Estimated Flag' ;
    rdfs:comment 'Indicates whether the flow value is an estimated or interpolated value rather than a direct meter reading. True when meter communication fails or reading is missing.' ;
    rdfs:domain ind:FlowReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:estimationMethod rdf:type rdf:Property ;
    rdfs:label 'Estimation Method' ;
    rdfs:comment 'Method used to estimate the flow value when direct measurement is unavailable. None indicates a direct measured value.' ;
    rdfs:domain ind:FlowReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:flowDirection rdf:type rdf:Property ;
    rdfs:label 'Flow Direction' ;
    rdfs:comment 'Direction of water flow at the measurement point. Inflow = water entering the zone/DMA, Outflow = water leaving the zone/DMA, Bidirectional = flow can reverse direction.' ;
    rdfs:domain ind:FlowReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:flowValue rdf:type rdf:Property ;
    rdfs:label 'Flow Value' ;
    rdfs:comment 'The raw flow measurement value as captured by the meter. Represents instantaneous flow rate or cumulative volume depending on measurement type. Used with engineering_unit to interpret the measurement.' ;
    rdfs:domain ind:FlowReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hydraulicModelFlag rdf:type rdf:Property ;
    rdfs:label 'Hydraulic Model Flag' ;
    rdfs:comment 'Indicates whether this flow reading is used for hydraulic model calibration in Innovyze InfoWater or similar distribution network modeling software.' ;
    rdfs:domain ind:FlowReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:intervalDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Interval Duration Minutes' ;
    rdfs:comment 'Time interval in minutes over which the flow measurement was aggregated or averaged. Common values: 15, 30, 60 minutes for SCADA polling intervals.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:measurementType rdf:type rdf:Property ;
    rdfs:label 'Measurement Type' ;
    rdfs:comment 'Classification of the flow measurement: instantaneous (real-time snapshot), cumulative (totalizer reading), average (calculated over interval), peak (maximum in interval), or minimum (lowest in interval).' ;
    rdfs:domain ind:FlowReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:meterAccuracyPercent rdf:type rdf:Property ;
    rdfs:label 'Meter Accuracy Percent' ;
    rdfs:comment 'The rated accuracy of the flow meter at the time of this reading, expressed as a percentage. Used to calculate measurement uncertainty for water balance calculations.' ;
    rdfs:domain ind:FlowReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nrwCalculationFlag rdf:type rdf:Property ;
    rdfs:label 'Nrw Calculation Flag' ;
    rdfs:comment 'Indicates whether this flow reading is included in Non-Revenue Water (NRW) or Unaccounted-for Water (UFW) balance calculations for the associated DMA.' ;
    rdfs:domain ind:FlowReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pressurePsi rdf:type rdf:Property ;
    rdfs:label 'Pressure Psi' ;
    rdfs:comment 'Water pressure measurement in PSI at the flow measurement point, captured concurrently with the flow reading. Used for hydraulic model calibration and pressure zone analysis.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scadaTagName rdf:type rdf:Property ;
    rdfs:label 'Scada Tag Name' ;
    rdfs:comment 'The SCADA system tag or point identifier that sourced this flow reading. Used for traceability back to the PI Historian or SCADA historian database.' ;
    rdfs:domain ind:FlowReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:temperatureF rdf:type rdf:Property ;
    rdfs:label 'Temperature F' ;
    rdfs:comment 'Water temperature in degrees Fahrenheit at the measurement point. Used for flow compensation calculations and water quality correlation analysis.' ;
    rdfs:domain ind:FlowReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalizerReading rdf:type rdf:Property ;
    rdfs:label 'Totalizer Reading' ;
    rdfs:comment 'Cumulative volume reading from the meter totalizer register. Used to calculate interval consumption by differencing consecutive readings. Typically in gallons or cubic meters.' ;
    rdfs:domain ind:FlowReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:validatedBy rdf:type rdf:Property ;
    rdfs:label 'Validated By' ;
    rdfs:comment 'User ID or system process name that performed the validation of this flow reading. Used for audit trail and accountability.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:validationStatus rdf:type rdf:Property ;
    rdfs:label 'Validation Status' ;
    rdfs:comment 'Current validation state of the flow reading. Pending = awaiting review, Validated = approved by operator or automated validation, Rejected = failed validation rules, Corrected = manually adjusted after validation.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:validationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Validation Timestamp' ;
    rdfs:comment 'Date and time when the flow reading was validated or reviewed by an operator or automated validation process.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:leakDetectionSurveyId rdf:type rdf:Property ;
    rdfs:label 'Leak Detection Survey Id' ;
    rdfs:comment 'Unique identifier for the leak detection survey record. Primary key.' ;
    rdfs:domain ind:LeakDetectionSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:conservationProgramId rdf:type rdf:Property ;
    rdfs:label 'Conservation Program Id' ;
    rdfs:comment 'Foreign key linking to service.conservation_program. Business justification: Leak detection surveys are frequently executed as part of NRW/conservation programs. Linking surveys to the sponsoring conservation program enables program performance reporting (actual_water_savings_' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ConservationProgram .

ind:correctiveActionId rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Id' ;
    rdfs:comment 'Foreign key linking to compliance.corrective_action. Business justification: Leak surveys identify infrastructure deficiencies requiring corrective action under consent decrees, enforcement orders, or water loss control programs. Survey findings must link to corrective action' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CorrectiveAction .

ind:regulatoryInspectionId rdf:type rdf:Property ;
    rdfs:label 'Regulatory Inspection Id' ;
    rdfs:comment 'Foreign key linking to compliance.regulatory_inspection. Business justification: Regulatory sanitary surveys frequently mandate leak detection surveys as a corrective finding. Linking leak_detection_survey to the regulatory_inspection that triggered it documents the regulatory bas' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RegulatoryInspection .

ind:ambientNoiseLevel rdf:type rdf:Property ;
    rdfs:label 'Ambient Noise Level' ;
    rdfs:comment 'Qualitative assessment of ambient noise levels during the survey, which can affect acoustic leak detection effectiveness.' ;
    rdfs:domain ind:LeakDetectionSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvedBy rdf:type rdf:Property ;
    rdfs:label 'Approved By' ;
    rdfs:comment 'Name or identifier of the supervisor or manager who reviewed and approved the survey results.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:completedDate rdf:type rdf:Property ;
    rdfs:label 'Completed Date' ;
    rdfs:comment 'The date on which the leak detection survey was marked as completed and results were finalized.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:equipmentUsed rdf:type rdf:Property ;
    rdfs:label 'Equipment Used' ;
    rdfs:comment 'Description or list of specific leak detection equipment and instruments used during the survey (e.g., model numbers, device names).' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedLeakRateGpm rdf:type rdf:Property ;
    rdfs:label 'Estimated Leak Rate Gpm' ;
    rdfs:comment 'Estimated total leak flow rate for all leaks detected during this survey, measured in Gallons Per Minute (GPM).' ;
    rdfs:domain ind:LeakDetectionSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:leakLocationsGis rdf:type rdf:Property ;
    rdfs:label 'Leak Locations Gis' ;
    rdfs:comment 'Geographic coordinates or GIS feature identifiers for each leak location detected during the survey, typically stored as comma-separated latitude/longitude pairs or GIS asset IDs.' ;
    rdfs:domain ind:LeakDetectionSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:leaksFoundCount rdf:type rdf:Property ;
    rdfs:label 'Leaks Found Count' ;
    rdfs:comment 'Total number of leaks identified during this survey.' ;
    rdfs:domain ind:LeakDetectionSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:repairWorkOrderGenerated rdf:type rdf:Property ;
    rdfs:label 'Repair Work Order Generated' ;
    rdfs:comment 'Indicates whether a repair work order was automatically or manually generated as a result of leaks found during this survey.' ;
    rdfs:domain ind:LeakDetectionSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:scheduledDate rdf:type rdf:Property ;
    rdfs:label 'Scheduled Date' ;
    rdfs:comment 'The originally planned or scheduled date for this leak detection survey, which may differ from the actual survey date.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:surveyCostCurrency rdf:type rdf:Property ;
    rdfs:label 'Survey Cost Currency' ;
    rdfs:comment 'Currency code for the survey cost amount. Defaults to USD for U.S. water utilities.' ;
    rdfs:domain ind:LeakDetectionSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surveyDate rdf:type rdf:Property ;
    rdfs:label 'Survey Date' ;
    rdfs:comment 'The calendar date on which the leak detection survey was conducted in the field.' ;
    rdfs:domain ind:LeakDetectionSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:surveyEndTime rdf:type rdf:Property ;
    rdfs:label 'Survey End Time' ;
    rdfs:comment 'Timestamp when the field crew completed the leak detection survey activity.' ;
    rdfs:domain ind:LeakDetectionSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:surveyLengthFeet rdf:type rdf:Property ;
    rdfs:label 'Survey Length Feet' ;
    rdfs:comment 'Total linear length of pipe surveyed during this leak detection activity, measured in feet.' ;
    rdfs:domain ind:LeakDetectionSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:surveyMethod rdf:type rdf:Property ;
    rdfs:label 'Survey Method' ;
    rdfs:comment 'The technology or technique used to conduct the leak detection survey (e.g., acoustic correlator, listening stick, ground-penetrating radar, leak noise logger).' ;
    rdfs:domain ind:LeakDetectionSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surveyNotes rdf:type rdf:Property ;
    rdfs:label 'Survey Notes' ;
    rdfs:comment 'Free-text field for technician observations, special conditions, challenges encountered, or additional context about the survey.' ;
    rdfs:domain ind:LeakDetectionSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surveyNumber rdf:type rdf:Property ;
    rdfs:label 'Survey Number' ;
    rdfs:comment 'Business-facing unique identifier or reference number assigned to this leak detection survey for tracking and reporting purposes.' ;
    rdfs:domain ind:LeakDetectionSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surveyOutcome rdf:type rdf:Property ;
    rdfs:label 'Survey Outcome' ;
    rdfs:comment 'Final outcome or result classification of the leak detection survey activity.' ;
    rdfs:domain ind:LeakDetectionSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surveyPriority rdf:type rdf:Property ;
    rdfs:label 'Survey Priority' ;
    rdfs:comment 'Priority level assigned to this leak detection survey based on factors such as DMA performance, customer complaints, or infrastructure criticality.' ;
    rdfs:domain ind:LeakDetectionSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surveyStartTime rdf:type rdf:Property ;
    rdfs:label 'Survey Start Time' ;
    rdfs:comment 'Timestamp when the field crew began the leak detection survey activity.' ;
    rdfs:domain ind:LeakDetectionSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:surveyStatus rdf:type rdf:Property ;
    rdfs:label 'Survey Status' ;
    rdfs:comment 'Current lifecycle status of the leak detection survey activity.' ;
    rdfs:domain ind:LeakDetectionSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:technicianName rdf:type rdf:Property ;
    rdfs:label 'Technician Name' ;
    rdfs:comment 'Name of the lead technician or operator who conducted the leak detection survey.' ;
    rdfs:domain ind:LeakDetectionSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:weatherConditions rdf:type rdf:Property ;
    rdfs:label 'Weather Conditions' ;
    rdfs:comment 'Description of weather conditions during the survey, which may impact detection accuracy (e.g., rain, wind, temperature).' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:failureRecordId rdf:type rdf:Property ;
    rdfs:label 'Failure Record Id' ;
    rdfs:comment 'Foreign key linking to asset.failure_record. Business justification: Main breaks are asset failure events requiring root cause analysis, MTBF/MTTR tracking, failure mode classification, and reliability analysis. Links distribution failures to enterprise failure trackin' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FailureRecord .

ind:boilWaterAdvisoryIssued rdf:type rdf:Property ;
    rdfs:label 'Boil Water Advisory Issued' ;
    rdfs:comment 'Indicates whether a boil water advisory was issued to affected customers due to potential water quality compromise. True if advisory was issued, False otherwise.' ;
    rdfs:domain ind:MainBreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:breakNumber rdf:type rdf:Property ;
    rdfs:label 'Break Number' ;
    rdfs:comment 'Business identifier for the main break event, typically formatted as MB-YYYYNNNNNN for external reference and reporting.' ;
    rdfs:domain ind:MainBreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:breakStatus rdf:type rdf:Property ;
    rdfs:label 'Break Status' ;
    rdfs:comment 'Current lifecycle status of the main break event: reported, dispatched, in progress, repaired, closed, or deferred.' ;
    rdfs:domain ind:MainBreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:breakTimestamp rdf:type rdf:Property ;
    rdfs:label 'Break Timestamp' ;
    rdfs:comment 'Date and time when the main break was first detected or reported. Principal business event timestamp for the break occurrence.' ;
    rdfs:domain ind:MainBreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:breakType rdf:type rdf:Property ;
    rdfs:label 'Break Type' ;
    rdfs:comment 'Classification of the main break failure mode: circumferential crack, longitudinal crack, blowout, joint failure, service line break, or corrosion pinhole.' ;
    rdfs:domain ind:MainBreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:customersAffectedCount rdf:type rdf:Property ;
    rdfs:label 'Customers Affected Count' ;
    rdfs:comment 'Number of customer accounts impacted by service disruption due to the main break.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dispatchTimestamp rdf:type rdf:Property ;
    rdfs:label 'Dispatch Timestamp' ;
    rdfs:comment 'Date and time when field crew was dispatched to the main break location.' ;
    rdfs:domain ind:MainBreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:locationAddress rdf:type rdf:Property ;
    rdfs:label 'Location Address' ;
    rdfs:comment 'Street address or nearest intersection where the main break occurred. Organizational location data classified as confidential.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:locationLatitude rdf:type rdf:Property ;
    rdfs:label 'Location Latitude' ;
    rdfs:comment 'Geographic latitude coordinate (decimal degrees) of the main break location for GIS mapping and spatial analysis.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:locationLongitude rdf:type rdf:Property ;
    rdfs:label 'Location Longitude' ;
    rdfs:comment 'Geographic longitude coordinate (decimal degrees) of the main break location for GIS mapping and spatial analysis.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pipeAgeYears rdf:type rdf:Property ;
    rdfs:label 'Pipe Age Years' ;
    rdfs:comment 'Estimated age of the pipe at the time of break, calculated from installation date to break date, measured in years.' ;
    rdfs:domain ind:MainBreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:pipeDiameterInches rdf:type rdf:Property ;
    rdfs:label 'Pipe Diameter Inches' ;
    rdfs:comment 'Nominal diameter of the failed pipe in inches.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pipeMaterial rdf:type rdf:Property ;
    rdfs:label 'Pipe Material' ;
    rdfs:comment 'Material composition of the failed pipe: cast iron, ductile iron, PVC (polyvinyl chloride), HDPE (high-density polyethylene), steel, concrete, asbestos cement, or copper. [ENUM-REF-CANDIDATE: cast_iron|ductile_iron|pvc|hdpe|steel|concrete|asbestos_cement|copper — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryReportRequired rdf:type rdf:Property ;
    rdfs:label 'Regulatory Report Required' ;
    rdfs:comment 'Indicates whether the main break requires regulatory reporting to EPA, state primacy agency, or Public Utilities Commission. True if reporting is required, False otherwise.' ;
    rdfs:domain ind:MainBreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:repairCompleteTimestamp rdf:type rdf:Property ;
    rdfs:label 'Repair Complete Timestamp' ;
    rdfs:comment 'Date and time when repair work was completed and the main was returned to service.' ;
    rdfs:domain ind:MainBreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:repairDurationHours rdf:type rdf:Property ;
    rdfs:label 'Repair Duration Hours' ;
    rdfs:comment 'Total duration of the repair activity from start to completion, measured in hours.' ;
    rdfs:domain ind:MainBreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:repairMethod rdf:type rdf:Property ;
    rdfs:label 'Repair Method' ;
    rdfs:comment 'Method used to repair the main break: clamp, sleeve, pipe replacement, joint repair, valve replacement, or temporary bypass.' ;
    rdfs:domain ind:MainBreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:repairStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Repair Start Timestamp' ;
    rdfs:comment 'Date and time when repair work commenced on the main break.' ;
    rdfs:domain ind:MainBreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:reportedBy rdf:type rdf:Property ;
    rdfs:label 'Reported By' ;
    rdfs:comment 'Source of the main break report: customer, field crew, SCADA alert, patrol, third party, or internal inspection.' ;
    rdfs:domain ind:MainBreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:soilCondition rdf:type rdf:Property ;
    rdfs:label 'Soil Condition' ;
    rdfs:comment 'Soil condition at the break location: clay, sand, gravel, rock, mixed, corrosive, saturated, or unknown. Influences corrosion rates and pipe stability. [ENUM-REF-CANDIDATE: clay|sand|gravel|rock|mixed|corrosive|saturated|unknown — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:MainBreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trafficImpact rdf:type rdf:Property ;
    rdfs:label 'Traffic Impact' ;
    rdfs:comment 'Impact of the main break on traffic and road access: none, lane closure, road closure, detour required, or emergency access restricted.' ;
    rdfs:domain ind:MainBreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waterLostGallons rdf:type rdf:Property ;
    rdfs:label 'Water Lost Gallons' ;
    rdfs:comment 'Estimated volume of water lost during the break event, measured in gallons. Critical for NRW (Non-Revenue Water) and UFW (Unaccounted-for Water) reporting.' ;
    rdfs:domain ind:MainBreak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:invoiceId rdf:type rdf:Property ;
    rdfs:label 'Invoice Id' ;
    rdfs:comment 'Unique system-generated identifier for the invoice record. Primary key for the invoice entity.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Invoice .

ind:cycleId rdf:type rdf:Property ;
    rdfs:label 'Cycle Id' ;
    rdfs:comment 'Foreign key linking to billing.billing_cycle. Business justification: Invoice belongs to a billing cycle; adding billing_cycle_id FK eliminates the redundant billing_cycle_code column and enables proper cycle lookup.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Cycle .

ind:pointId rdf:type rdf:Property ;
    rdfs:label 'Point Id' ;
    rdfs:comment 'Reference to the physical service point (meter location) associated with this invoice. May be null for account-level charges not tied to a specific service point.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Point .

ind:adjustmentAmount rdf:type rdf:Property ;
    rdfs:label 'Adjustment Amount' ;
    rdfs:comment 'Net adjustment amount applied to the invoice, including credits for billing errors, leak adjustments, service quality issues, or promotional discounts. Positive values increase invoice total; negative values decrease it.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:billingPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Billing Period End Date' ;
    rdfs:comment 'Last day of the consumption period covered by this invoice. Typically aligns with the current meter read date or service period end.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:billingPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Billing Period Start Date' ;
    rdfs:comment 'First day of the consumption period covered by this invoice. Typically aligns with the prior meter read date or service period start.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ccrIncluded rdf:type rdf:Property ;
    rdfs:label 'Ccr Included' ;
    rdfs:comment 'Boolean flag indicating whether the annual Consumer Confidence Report (water quality report) was included with this invoice mailing. Required annually under Safe Drinking Water Act (SDWA).' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:conservationMessage rdf:type rdf:Property ;
    rdfs:label 'Conservation Message' ;
    rdfs:comment 'Optional water conservation message or tip printed on the invoice to encourage efficient water use. May vary seasonally or based on drought conditions.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:createdByUser rdf:type rdf:Property ;
    rdfs:label 'Created By User' ;
    rdfs:comment 'User ID or system process name that created this invoice record. For automated cycle billing, typically a batch process identifier; for manual invoices, the billing staff user ID.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:currencyCode rdf:type rdf:Property ;
    rdfs:label 'Currency Code' ;
    rdfs:comment 'Three-letter ISO 4217 currency code for all monetary amounts on this invoice. Typically USD for U.S. water utilities.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deliveryMethod rdf:type rdf:Property ;
    rdfs:label 'Delivery Method' ;
    rdfs:comment 'Method by which the invoice was delivered to the customer. Options include postal mail (paper bill), email (electronic bill), customer web portal, or SMS notification with portal link.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disconnectionDate rdf:type rdf:Property ;
    rdfs:label 'Disconnection Date' ;
    rdfs:comment 'Date on which service may be disconnected if payment is not received. Typically set 10-15 days after due date, subject to regulatory notice requirements and customer protections.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:disputeFlag rdf:type rdf:Property ;
    rdfs:label 'Dispute Flag' ;
    rdfs:comment 'Boolean flag indicating whether the customer has formally disputed charges on this invoice. Triggers dispute resolution workflow and may suspend collection activities.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dueDate rdf:type rdf:Property ;
    rdfs:label 'Due Date' ;
    rdfs:comment 'Date by which payment must be received to avoid late fees or service disconnection. Calculated based on invoice date plus payment terms (typically 15-30 days).' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:generationMethod rdf:type rdf:Property ;
    rdfs:label 'Generation Method' ;
    rdfs:comment 'Method by which the invoice was generated. Automated cycle invoices are produced by scheduled batch billing runs; manual invoices are created by billing staff; off-cycle invoices are generated outside normal schedules; estimated invoices use projected consumption; corrected invoices replace prior errors.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:invoiceDate rdf:type rdf:Property ;
    rdfs:label 'Invoice Date' ;
    rdfs:comment 'Date the invoice was generated and issued to the customer. This is the official invoice date printed on the bill and used for aging calculations.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:invoiceNumber rdf:type rdf:Property ;
    rdfs:label 'Invoice Number' ;
    rdfs:comment 'Externally visible, human-readable invoice number printed on customer bills and used for customer service inquiries. Must be unique across all invoices.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:invoiceStatus rdf:type rdf:Property ;
    rdfs:label 'Invoice Status' ;
    rdfs:comment 'Current lifecycle state of the invoice. Draft invoices are pending finalization; issued invoices have been sent to customers; paid invoices are fully settled; partial_paid invoices have received some payment; overdue invoices are past due date; cancelled invoices are nullified before payment; void invoices are nullified after issuance. [ENUM-REF-CANDIDATE: draft|issued|paid|partial_paid|overdue|cancelled|void — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:invoiceType rdf:type rdf:Property ;
    rdfs:label 'Invoice Type' ;
    rdfs:comment 'Classification of the invoice based on billing circumstances. Regular cycle invoices are standard periodic bills; final invoices are issued upon service termination; estimated invoices use projected consumption when actual reads are unavailable; corrected invoices replace erroneous prior bills; off-cycle invoices are generated outside normal billing cycles; adjustment invoices correct prior billing errors.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isEstimated rdf:type rdf:Property ;
    rdfs:label 'Is Estimated' ;
    rdfs:comment 'Boolean flag indicating whether consumption values on this invoice are estimated rather than based on actual meter readings. True when meter is inaccessible or malfunctioning.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isFinal rdf:type rdf:Property ;
    rdfs:label 'Is Final' ;
    rdfs:comment 'Boolean flag indicating whether this is a final invoice issued upon service termination or account closure. Final invoices settle all outstanding charges and close the billing relationship.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lateFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Late Fee Amount' ;
    rdfs:comment 'Late payment penalty assessed if payment is not received by due date. Calculated as a percentage of outstanding balance or flat fee per utility policy and regulatory limits.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:modifiedByUser rdf:type rdf:Property ;
    rdfs:label 'Modified By User' ;
    rdfs:comment 'User ID or system process name that last modified this invoice record. Used for audit trail and accountability.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:previousBalanceAmount rdf:type rdf:Property ;
    rdfs:label 'Previous Balance Amount' ;
    rdfs:comment 'Outstanding balance carried forward from prior billing periods. Represents unpaid or partially paid amounts from previous invoices.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:printDate rdf:type rdf:Property ;
    rdfs:label 'Print Date' ;
    rdfs:comment 'Date the invoice was physically printed or electronically rendered for delivery to the customer. May differ from invoice date for batch processing.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:rateScheduleCode rdf:type rdf:Property ;
    rdfs:label 'Rate Schedule Code' ;
    rdfs:comment 'Code identifying the tariff rate schedule applied to calculate charges on this invoice. Rate schedules vary by customer class (residential, commercial, industrial) and service type.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stormwaterArea rdf:type rdf:Property ;
    rdfs:label 'Stormwater Area' ;
    rdfs:comment 'Total impervious surface area (in square feet or square meters) used to calculate stormwater management fees. Applicable for properties subject to stormwater utility charges.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:stormwaterChargeAmount rdf:type rdf:Property ;
    rdfs:label 'Stormwater Charge Amount' ;
    rdfs:comment 'Charges for stormwater management services, typically calculated based on impervious surface area. Supports stormwater infrastructure maintenance and regulatory compliance.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:taxAmount rdf:type rdf:Property ;
    rdfs:label 'Tax Amount' ;
    rdfs:comment 'Total tax charges applied to the invoice, including sales tax, utility tax, franchise fees, or other regulatory taxes as required by jurisdiction.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalAmountDue rdf:type rdf:Property ;
    rdfs:label 'Total Amount Due' ;
    rdfs:comment 'Total amount the customer must pay, calculated as sum of current period charges (water, wastewater, stormwater, other), taxes, adjustments, and previous balance. This is the headline amount printed on the invoice.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:wastewaterChargeAmount rdf:type rdf:Property ;
    rdfs:label 'Wastewater Charge Amount' ;
    rdfs:comment 'Total charges for wastewater collection and treatment services during the billing period. May include volumetric charges, fixed fees, and strength-of-waste surcharges for industrial users.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:wastewaterVolume rdf:type rdf:Property ;
    rdfs:label 'Wastewater Volume' ;
    rdfs:comment 'Volume of wastewater discharged during the billing period, typically calculated as a percentage of water consumption or measured separately for industrial customers. Measured in same unit as water consumption.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:waterChargeAmount rdf:type rdf:Property ;
    rdfs:label 'Water Charge Amount' ;
    rdfs:comment 'Total charges for potable water service during the billing period, including volumetric consumption charges and fixed service fees. Calculated based on applicable rate schedule and tier structure.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:waterConsumptionUom rdf:type rdf:Property ;
    rdfs:label 'Water Consumption Uom' ;
    rdfs:comment 'Unit of measure for water consumption volume. Common units include gallons, cubic meters (m³), hundred cubic feet (CCF), or thousand gallons (kgal).' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waterConsumptionVolume rdf:type rdf:Property ;
    rdfs:label 'Water Consumption Volume' ;
    rdfs:comment 'Total volume of potable water consumed during the billing period, measured in gallons or cubic meters depending on utility standard. Derived from meter readings or estimated when actual reads unavailable.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:invoiceLineId rdf:type rdf:Property ;
    rdfs:label 'Invoice Line Id' ;
    rdfs:comment 'Unique identifier for the invoice line item. Primary key for the invoice line product.' ;
    rdfs:domain ind:InvoiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:billingRateScheduleId rdf:type rdf:Property ;
    rdfs:label 'Billing Rate Schedule Id' ;
    rdfs:comment 'Reference to the rate schedule applied to calculate this charge. Determines pricing structure and rate components.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BillingRateSchedule .

ind:effluentParameterResultId rdf:type rdf:Property ;
    rdfs:label 'Effluent Parameter Result Id' ;
    rdfs:comment 'Foreign key linking to wastewater.effluent_parameter_result. Business justification: Industrial strength surcharge invoice lines are directly calculated from effluent parameter measurements (BOD, TSS, COD). Linking invoice_line to effluent_parameter_result provides the regulatory-requ' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EffluentParameterResult .

ind:industrialUserPermitId rdf:type rdf:Property ;
    rdfs:label 'Industrial User Permit Id' ;
    rdfs:comment 'Foreign key linking to wastewater.industrial_user_permit. Business justification: Individual invoice line items for industrial users (BOD surcharges, TSS strength charges, pretreatment fees) are calculated from permit-specific limits and monitoring data. Linking invoice_line to ind' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:IndustrialUserPermit .

ind:intervalConsumptionId rdf:type rdf:Property ;
    rdfs:label 'Interval Consumption Id' ;
    rdfs:comment 'Foreign key linking to metering.interval_consumption. Business justification: Invoice line items representing consumption charges should reference the authoritative rated_consumption record as their source data. This establishes traceability from billed charges back to the mete' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:IntervalConsumption .

ind:rateComponentId rdf:type rdf:Property ;
    rdfs:label 'Rate Component Id' ;
    rdfs:comment 'Foreign key linking to billing.rate_component. Business justification: Each invoice line is generated by a specific rate component (e.g., base charge, volumetric tier, surcharge). invoice_line already has billing_rate_schedule_id (the schedule level) and rate_tier_id (th' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RateComponent .

ind:rateTierId rdf:type rdf:Property ;
    rdfs:label 'Rate Tier Id' ;
    rdfs:comment 'Reference to the specific rate tier applied for tiered or block rate structures. Identifies which consumption block or tier this charge falls into.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RateTier .

ind:sewerServiceConnectionId rdf:type rdf:Property ;
    rdfs:label 'Sewer Service Connection Id' ;
    rdfs:comment 'Foreign key linking to wastewater.sewer_service_connection. Business justification: Wastewater invoice line items (availability charges, connection fees, lateral inspection fees) are assessed at the individual sewer service connection level. Direct FK enables connection-specific char' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SewerServiceConnection .

ind:adjustmentReasonCode rdf:type rdf:Property ;
    rdfs:label 'Adjustment Reason Code' ;
    rdfs:comment 'Code indicating the reason for billing adjustments, credits, or special charges. Used for adjustment and dispute tracking. [ENUM-REF-CANDIDATE: BILLING_ERROR|METER_MALFUNCTION|LEAK_ADJUSTMENT|CUSTOMER_DISPUTE|RATE_CHANGE|PRORATION|CREDIT_MEMO|WRITE_OFF|GOODWILL|OTHER — 10 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:adjustmentReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Adjustment Reference Number' ;
    rdfs:comment 'Reference number linking this line to an adjustment request, dispute case, or credit memo. Provides audit trail for non-standard charges.' ;
    rdfs:domain ind:InvoiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingDeterminant rdf:type rdf:Property ;
    rdfs:label 'Billing Determinant' ;
    rdfs:comment 'The basis or method used to calculate this charge. Identifies whether charge is based on metered usage, property characteristics, flat rate, or other factors. [ENUM-REF-CANDIDATE: METERED_CONSUMPTION|ESTIMATED_CONSUMPTION|FLAT_RATE|METER_SIZE|PROPERTY_SIZE|IMPERVIOUS_AREA|FIXTURE_COUNT|CONNECTION_SIZE|CUSTOMER_CLASS|OTHER — 10 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:InvoiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:chargeDescription rdf:type rdf:Property ;
    rdfs:label 'Charge Description' ;
    rdfs:comment 'Detailed textual description of the charge as it appears on the customer invoice. Provides human-readable explanation of the line item.' ;
    rdfs:domain ind:InvoiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:chargeTypeCode rdf:type rdf:Property ;
    rdfs:label 'Charge Type Code' ;
    rdfs:comment 'Classification of the charge line item by billing component type. Distinguishes between consumption charges, fixed fees, taxes, adjustments, and other billing elements. [ENUM-REF-CANDIDATE: WATER_CONSUMPTION|WASTEWATER_SERVICE|STORMWATER_FEE|BASE_SERVICE|METER_CHARGE|CONNECTION_FEE|LATE_FEE|ADJUSTMENT|TAX|SURCHARGE|PENALTY|CREDIT|REBATE|DEPOSIT|OTHER — 15 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:InvoiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isDisputed rdf:type rdf:Property ;
    rdfs:label 'Is Disputed' ;
    rdfs:comment 'Indicates whether this charge is currently under customer dispute. True if disputed, false otherwise. Used for dispute tracking and collections management.' ;
    rdfs:domain ind:InvoiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isProrated rdf:type rdf:Property ;
    rdfs:label 'Is Prorated' ;
    rdfs:comment 'Indicates whether this charge has been prorated due to partial billing period, service start/stop, or rate change. True if prorated, false otherwise.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isTaxable rdf:type rdf:Property ;
    rdfs:label 'Is Taxable' ;
    rdfs:comment 'Indicates whether this line item is subject to taxation. True if taxable, false if tax-exempt.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastModifiedByUser rdf:type rdf:Property ;
    rdfs:label 'Last Modified By User' ;
    rdfs:comment 'User identifier or system process that last modified this invoice line record. Supports audit and accountability requirements.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lineAmount rdf:type rdf:Property ;
    rdfs:label 'Line Amount' ;
    rdfs:comment 'Calculated charge amount for this line item before taxes and adjustments. Typically consumption_quantity multiplied by unit_rate for consumption charges, or fixed amount for service fees.' ;
    rdfs:domain ind:InvoiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lineSequenceNumber rdf:type rdf:Property ;
    rdfs:label 'Line Sequence Number' ;
    rdfs:comment 'Sequential ordering of line items within the parent invoice. Determines display order on customer bill.' ;
    rdfs:domain ind:InvoiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lineStatus rdf:type rdf:Property ;
    rdfs:label 'Line Status' ;
    rdfs:comment 'Current status of the invoice line item in the billing lifecycle. Tracks whether the charge is active, has been adjusted, disputed, or reversed.' ;
    rdfs:domain ind:InvoiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:printSequence rdf:type rdf:Property ;
    rdfs:label 'Print Sequence' ;
    rdfs:comment 'Display order for this line item on printed or electronic invoices. Controls the presentation sequence for customer-facing billing documents.' ;
    rdfs:domain ind:InvoiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:prorationFactor rdf:type rdf:Property ;
    rdfs:label 'Proration Factor' ;
    rdfs:comment 'Decimal factor applied for prorated charges. Represents the portion of the full billing period or rate being charged (e.g., 0.5000 for half period).' ;
    rdfs:domain ind:InvoiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:revenueClass rdf:type rdf:Property ;
    rdfs:label 'Revenue Class' ;
    rdfs:comment 'Classification of revenue type for financial reporting and regulatory compliance. Distinguishes between operating revenue, capital contributions, and other revenue categories.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceDays rdf:type rdf:Property ;
    rdfs:label 'Service Days' ;
    rdfs:comment 'Number of days in the billing period for this charge. Used for proration calculations and billing cycle analysis.' ;
    rdfs:domain ind:InvoiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:taxRatePercentage rdf:type rdf:Property ;
    rdfs:label 'Tax Rate Percentage' ;
    rdfs:comment 'Tax rate percentage applied to calculate the tax amount. Expressed as decimal (e.g., 0.0825 for 8.25% tax rate).' ;
    rdfs:domain ind:InvoiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalLineAmount rdf:type rdf:Property ;
    rdfs:label 'Total Line Amount' ;
    rdfs:comment 'Total amount for this line item including taxes and adjustments. Sum of line_amount and tax_amount. Contributes to invoice total.' ;
    rdfs:domain ind:InvoiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:unitRate rdf:type rdf:Property ;
    rdfs:label 'Unit Rate' ;
    rdfs:comment 'Price per unit of consumption or service. The rate applied to calculate the line charge amount. Expressed in currency per consumption_unit_of_measure.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentId rdf:type rdf:Property ;
    rdfs:label 'Payment Id' ;
    rdfs:comment 'Unique identifier for the payment transaction. Primary key for the payment record.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Payment .

ind:paymentPlanId rdf:type rdf:Property ;
    rdfs:label 'Payment Plan Id' ;
    rdfs:comment 'Reference to the payment plan or payment arrangement under which this payment was made. Null for non-plan payments.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PaymentPlan .

ind:reversedByPaymentId rdf:type rdf:Property ;
    rdfs:label 'Reversed By Payment Id' ;
    rdfs:comment 'Reference to the reversal payment transaction that cancelled or reversed this payment. Null for non-reversed payments.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Payment .

ind:amount rdf:type rdf:Property ;
    rdfs:label 'Amount' ;
    rdfs:comment 'Total monetary amount of the payment received from the customer, in the utility\'s base currency.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:appliedAmount rdf:type rdf:Property ;
    rdfs:label 'Applied Amount' ;
    rdfs:comment 'The portion of the payment amount that has been applied to outstanding account balances. May differ from payment_amount if payment is partially applied or held as credit.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:authorizationCode rdf:type rdf:Property ;
    rdfs:label 'Authorization Code' ;
    rdfs:comment 'Authorization or approval code returned by the payment processor for credit card or ACH transactions.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bankAccountLastFour rdf:type rdf:Property ;
    rdfs:label 'Bank Account Last Four' ;
    rdfs:comment 'Last four digits of the bank account number used for ACH or electronic payments. Used for customer verification without exposing full account number.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cardLastFour rdf:type rdf:Property ;
    rdfs:label 'Card Last Four' ;
    rdfs:comment 'Last four digits of the credit or debit card number used for card payments. Used for customer verification without exposing full card number.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cardType rdf:type rdf:Property ;
    rdfs:label 'Card Type' ;
    rdfs:comment 'The credit or debit card brand for card payments (e.g., Visa, MasterCard, American Express, Discover). Null for non-card payments.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:checkNumber rdf:type rdf:Property ;
    rdfs:label 'Check Number' ;
    rdfs:comment 'The check number for check payments. Null for non-check payment methods.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clearedDate rdf:type rdf:Property ;
    rdfs:label 'Cleared Date' ;
    rdfs:comment 'The date on which the payment cleared the bank or financial institution, confirming funds availability. Null for cash payments.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:isAutoPay rdf:type rdf:Property ;
    rdfs:label 'Is Auto Pay' ;
    rdfs:comment 'Boolean flag indicating whether this payment was processed automatically through an auto-pay enrollment (True) or was a manual customer-initiated payment (False).' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isRecurring rdf:type rdf:Property ;
    rdfs:label 'Is Recurring' ;
    rdfs:comment 'Boolean flag indicating whether this payment is part of a recurring payment plan or schedule (True) or a one-time payment (False).' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:locationCode rdf:type rdf:Property ;
    rdfs:label 'Location Code' ;
    rdfs:comment 'Code identifying the physical location or office where the payment was received (e.g., branch office, payment center). Null for remote payments.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lockboxNumber rdf:type rdf:Property ;
    rdfs:label 'Lockbox Number' ;
    rdfs:comment 'Bank lockbox number or identifier for payments received through lockbox processing services. Null for non-lockbox payments.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:method rdf:type rdf:Property ;
    rdfs:label 'Method' ;
    rdfs:comment 'The financial instrument or tender type used to make the payment (e.g., check, ACH bank draft, credit card, debit card, cash, money order).' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nsfFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Nsf Fee Amount' ;
    rdfs:comment 'The fee charged to the customer account for a returned NSF payment. Null if no NSF occurred or no fee was assessed.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nsfIndicator rdf:type rdf:Property ;
    rdfs:label 'Nsf Indicator' ;
    rdfs:comment 'Boolean flag indicating whether this payment was returned due to non-sufficient funds (True) or processed successfully (False).' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:paymentDate rdf:type rdf:Property ;
    rdfs:label 'Payment Date' ;
    rdfs:comment 'The date on which the payment was received or processed by the utility. This is the business event date for revenue recognition.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:paymentNumber rdf:type rdf:Property ;
    rdfs:label 'Payment Number' ;
    rdfs:comment 'Business-facing unique reference number for the payment transaction, used for customer inquiries and reconciliation.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentStatus rdf:type rdf:Property ;
    rdfs:label 'Payment Status' ;
    rdfs:comment 'Current lifecycle status of the payment transaction indicating whether it has been posted to the account, cleared by the bank, or reversed.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentTimestamp rdf:type rdf:Property ;
    rdfs:label 'Payment Timestamp' ;
    rdfs:comment 'Precise date and time when the payment transaction was received or recorded in the system.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:paymentType rdf:type rdf:Property ;
    rdfs:label 'Payment Type' ;
    rdfs:comment 'Classification of the payment purpose (e.g., regular bill payment, advance payment, deposit, refund, billing adjustment).' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postingDate rdf:type rdf:Property ;
    rdfs:label 'Posting Date' ;
    rdfs:comment 'The date on which the payment was posted to the customer account and applied against outstanding balances.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:processorName rdf:type rdf:Property ;
    rdfs:label 'Processor Name' ;
    rdfs:comment 'Name of the third-party payment processor or gateway that handled the electronic payment transaction (e.g., Stripe, PayPal, bank lockbox service).' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referenceNumber rdf:type rdf:Property ;
    rdfs:label 'Reference Number' ;
    rdfs:comment 'External reference number from the payment source (e.g., check number, ACH trace number, credit card authorization code, lockbox batch number).' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reversalReason rdf:type rdf:Property ;
    rdfs:label 'Reversal Reason' ;
    rdfs:comment 'Explanation or reason code for why the payment was reversed or cancelled. Null for non-reversed payments.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unappliedAmount rdf:type rdf:Property ;
    rdfs:label 'Unapplied Amount' ;
    rdfs:comment 'The portion of the payment amount that remains unapplied and is held as account credit or pending allocation.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentApplicationId rdf:type rdf:Property ;
    rdfs:label 'Payment Application Id' ;
    rdfs:comment 'Unique identifier for the payment application record. Primary key.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:adjustmentId rdf:type rdf:Property ;
    rdfs:label 'Adjustment Id' ;
    rdfs:comment 'Reference to the dispute case record if this payment application is part of a dispute resolution process.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Adjustment .

ind:billingAccountId rdf:type rdf:Property ;
    rdfs:label 'Billing Account Id' ;
    rdfs:comment 'Reference to the customer account for which this payment application is recorded.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BillingAccount .

ind:primaryPaymentInvoiceLineId rdf:type rdf:Property ;
    rdfs:label 'Primary Payment Invoice Line Id' ;
    rdfs:comment 'Reference to the specific invoice line item to which this payment is applied. Enables line-level payment allocation.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:InvoiceLine .

ind:adjustmentDate rdf:type rdf:Property ;
    rdfs:label 'Adjustment Date' ;
    rdfs:comment 'The date on which an adjustment was made to this payment application. Null if no adjustment occurred.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:adjustmentIndicator rdf:type rdf:Property ;
    rdfs:label 'Adjustment Indicator' ;
    rdfs:comment 'Flag indicating whether this payment application was adjusted after initial processing due to billing correction or dispute resolution.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:allocationMethod rdf:type rdf:Property ;
    rdfs:label 'Allocation Method' ;
    rdfs:comment 'The method or rule used to allocate the payment across outstanding charges (e.g., FIFO, oldest invoice first, pro-rata across all balances). [ENUM-REF-CANDIDATE: fifo|lifo|oldest_first|highest_balance|pro_rata|manual|system_default — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicationDate rdf:type rdf:Property ;
    rdfs:label 'Application Date' ;
    rdfs:comment 'The business date on which the payment was applied to the invoice or account balance. This is the effective date for accounts receivable (AR) reconciliation.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:applicationSequence rdf:type rdf:Property ;
    rdfs:label 'Application Sequence' ;
    rdfs:comment 'Sequential order in which this application was processed for a given payment. Supports scenarios where a single payment is split across multiple invoices.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:applicationSource rdf:type rdf:Property ;
    rdfs:label 'Application Source' ;
    rdfs:comment 'Source or channel through which the payment application was initiated (e.g., automated system rule, manual CSR entry, batch process, customer self-service portal). [ENUM-REF-CANDIDATE: automated|manual|batch|api|customer_portal|ivr|mobile_app — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Application Timestamp' ;
    rdfs:comment 'The precise date and time when the payment application transaction was processed in the billing system.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:arReconciliationStatus rdf:type rdf:Property ;
    rdfs:label 'Ar Reconciliation Status' ;
    rdfs:comment 'Status indicating whether this payment application has been successfully reconciled in the accounts receivable ledger.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:balanceBucketCode rdf:type rdf:Property ;
    rdfs:label 'Balance Bucket Code' ;
    rdfs:comment 'Code identifying the account balance bucket or aging category to which the payment was applied (e.g., current, 30-day, 60-day, 90-day past due).' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:chargeType rdf:type rdf:Property ;
    rdfs:label 'Charge Type' ;
    rdfs:comment 'Category of charge to which the payment was applied, distinguishing between water, wastewater, stormwater, penalties, and other utility charges. [ENUM-REF-CANDIDATE: water|wastewater|stormwater|penalty|interest|reconnection|late_fee|service_charge|other — 9 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disputeIndicator rdf:type rdf:Property ;
    rdfs:label 'Dispute Indicator' ;
    rdfs:comment 'Flag indicating whether this payment application is associated with a billing dispute or customer challenge.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:glAccountCode rdf:type rdf:Property ;
    rdfs:label 'Gl Account Code' ;
    rdfs:comment 'General ledger account code to which this payment application is posted for financial accounting and revenue recognition.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isOverpayment rdf:type rdf:Property ;
    rdfs:label 'Is Overpayment' ;
    rdfs:comment 'Flag indicating whether this payment application resulted in an overpayment or credit balance on the account.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPrepayment rdf:type rdf:Property ;
    rdfs:label 'Is Prepayment' ;
    rdfs:comment 'Flag indicating whether this payment application represents a prepayment applied to future charges rather than outstanding invoices.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:overpaymentHandling rdf:type rdf:Property ;
    rdfs:label 'Overpayment Handling' ;
    rdfs:comment 'Indicates how overpayment or excess credit is handled: refunded to customer, held as credit, transferred to another account, or held pending customer instruction.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revenueRecognitionDate rdf:type rdf:Property ;
    rdfs:label 'Revenue Recognition Date' ;
    rdfs:comment 'The date on which the applied payment amount is recognized as revenue in the general ledger, per GASB revenue recognition standards.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reversalDate rdf:type rdf:Property ;
    rdfs:label 'Reversal Date' ;
    rdfs:comment 'The date on which this payment application was reversed. Null if not reversed.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reversalIndicator rdf:type rdf:Property ;
    rdfs:label 'Reversal Indicator' ;
    rdfs:comment 'Flag indicating whether this payment application has been reversed due to payment failure, dispute, or correction.' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reversalReasonCode rdf:type rdf:Property ;
    rdfs:label 'Reversal Reason Code' ;
    rdfs:comment 'Code indicating the reason for reversing the payment application (e.g., NSF, dispute, system error, customer request).' ;
    rdfs:domain ind:PaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accountNumber rdf:type rdf:Property ;
    rdfs:label 'Account Number' ;
    rdfs:comment 'Externally-visible unique account number used for customer communication, billing statements, and payment processing. This is the business identifier displayed on bills and correspondence.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accountType rdf:type rdf:Property ;
    rdfs:label 'Account Type' ;
    rdfs:comment 'Classification of the billing account based on customer segment and rate structure applicability. Determines which rate schedules and service classes apply.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:aging30Days rdf:type rdf:Property ;
    rdfs:label 'Aging 30 Days' ;
    rdfs:comment 'Portion of the account balance that is 1-30 days past due. Used for delinquency tracking and collections workflow triggers.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:aging60Days rdf:type rdf:Property ;
    rdfs:label 'Aging 60 Days' ;
    rdfs:comment 'Portion of the account balance that is 31-60 days past due. Indicates escalating delinquency requiring more aggressive collection actions.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:aging90Days rdf:type rdf:Property ;
    rdfs:label 'Aging 90 Days' ;
    rdfs:comment 'Portion of the account balance that is 61-90 days past due. Typically triggers final notice and service disconnection warnings.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:agingCurrent rdf:type rdf:Property ;
    rdfs:label 'Aging Current' ;
    rdfs:comment 'Portion of the account balance that is current and not yet past due. Part of the aging analysis for accounts receivable management.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:agingOver90Days rdf:type rdf:Property ;
    rdfs:label 'Aging Over 90 Days' ;
    rdfs:comment 'Portion of the account balance that is more than 90 days past due. Highest risk category for write-off and may result in service termination or legal action.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:autopayEnrolled rdf:type rdf:Property ;
    rdfs:label 'Autopay Enrolled' ;
    rdfs:comment 'Indicates whether the customer is enrolled in automatic payment processing where bills are automatically paid from a bank account or credit card on the due date.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:autopayMethod rdf:type rdf:Property ;
    rdfs:label 'Autopay Method' ;
    rdfs:comment 'Payment instrument used for automatic payment processing if autopay is enabled. Specifies whether payments are drawn from bank account or charged to card.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:balanceForward rdf:type rdf:Property ;
    rdfs:label 'Balance Forward' ;
    rdfs:comment 'Previous balance carried forward from the prior billing cycle before current period charges are applied. Used for aging analysis and delinquency tracking.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:billingFrequency rdf:type rdf:Property ;
    rdfs:label 'Billing Frequency' ;
    rdfs:comment 'Frequency at which bills are generated and issued for this account. Aligns with meter reading schedules and rate structure requirements.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:budgetBillingAmount rdf:type rdf:Property ;
    rdfs:label 'Budget Billing Amount' ;
    rdfs:comment 'Fixed monthly amount charged under budget billing program. Calculated based on historical consumption patterns and reconciled annually.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:budgetBillingEnrolled rdf:type rdf:Property ;
    rdfs:label 'Budget Billing Enrolled' ;
    rdfs:comment 'Indicates whether the customer is enrolled in budget billing program where monthly bills are averaged to provide consistent payment amounts throughout the year.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:closedDate rdf:type rdf:Property ;
    rdfs:label 'Closed Date' ;
    rdfs:comment 'Date when the billing account was closed and final bill was issued. Null for active accounts.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:collectionStatus rdf:type rdf:Property ;
    rdfs:label 'Collection Status' ;
    rdfs:comment 'Current stage in the collections workflow for delinquent accounts. Indicates escalation level and next collection action required.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:creditLimit rdf:type rdf:Property ;
    rdfs:label 'Credit Limit' ;
    rdfs:comment 'Maximum outstanding balance allowed before service restrictions or additional deposits are required. Based on credit rating and payment history.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:creditRating rdf:type rdf:Property ;
    rdfs:label 'Credit Rating' ;
    rdfs:comment 'Internal credit assessment of the customer based on payment history, delinquency patterns, and account behavior. Influences deposit requirements and collection strategies.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:currentBalance rdf:type rdf:Property ;
    rdfs:label 'Current Balance' ;
    rdfs:comment 'Total outstanding balance on the billing account including all charges, fees, adjustments, and payments. Positive values indicate amounts owed by the customer; negative values indicate credit balances.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:currentCharges rdf:type rdf:Property ;
    rdfs:label 'Current Charges' ;
    rdfs:comment 'Total charges for the current billing period including water consumption, wastewater service, stormwater fees, and other utility charges before adjustments.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:depositOnFile rdf:type rdf:Property ;
    rdfs:label 'Deposit On File' ;
    rdfs:comment 'Security deposit amount held by the utility to mitigate credit risk. May be applied to final bill or returned to customer upon account closure with good payment history.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:finalBillIssued rdf:type rdf:Property ;
    rdfs:label 'Final Bill Issued' ;
    rdfs:comment 'Indicates whether a final bill has been generated for this account upon closure. Used to ensure proper account settlement and deposit refund processing.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastBillDate rdf:type rdf:Property ;
    rdfs:label 'Last Bill Date' ;
    rdfs:comment 'Date when the most recent bill was generated for this account. Used to calculate next billing cycle and track billing cadence.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastPaymentAmount rdf:type rdf:Property ;
    rdfs:label 'Last Payment Amount' ;
    rdfs:comment 'Amount of the most recent payment received. Used for payment pattern analysis and customer service inquiries.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lastPaymentDate rdf:type rdf:Property ;
    rdfs:label 'Last Payment Date' ;
    rdfs:comment 'Date when the most recent payment was received and posted to this account. Used for payment history analysis and delinquency assessment.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lateFeeAssessed rdf:type rdf:Property ;
    rdfs:label 'Late Fee Assessed' ;
    rdfs:comment 'Total late payment fees assessed on this account for the current billing period. Applied when payment is not received by due date.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nextBillDate rdf:type rdf:Property ;
    rdfs:label 'Next Bill Date' ;
    rdfs:comment 'Scheduled date for the next bill generation based on billing cycle and frequency. Used for billing run planning and customer communication.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:openedDate rdf:type rdf:Property ;
    rdfs:label 'Opened Date' ;
    rdfs:comment 'Date when the billing account was first established. Used for customer tenure analysis and lifecycle reporting.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:paperlessBilling rdf:type rdf:Property ;
    rdfs:label 'Paperless Billing' ;
    rdfs:comment 'Indicates whether the customer has opted for electronic bill delivery instead of printed paper bills. Reduces mailing costs and supports environmental sustainability.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pastDueAmount rdf:type rdf:Property ;
    rdfs:label 'Past Due Amount' ;
    rdfs:comment 'Total amount that is overdue and unpaid beyond the payment due date. Used for collections prioritization and service restriction decisions.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentPlanActive rdf:type rdf:Property ;
    rdfs:label 'Payment Plan Active' ;
    rdfs:comment 'Indicates whether the customer is currently on a payment plan to pay down past due balances in installments. Used to prevent service disconnection during plan compliance.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:paymentPlanBalance rdf:type rdf:Property ;
    rdfs:label 'Payment Plan Balance' ;
    rdfs:comment 'Remaining balance to be paid under the active payment plan. Tracks progress toward full payment of delinquent amounts.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentTerms rdf:type rdf:Property ;
    rdfs:label 'Payment Terms' ;
    rdfs:comment 'Standard payment terms for this billing account specifying the number of days from invoice date until payment is due.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reconnectionFee rdf:type rdf:Property ;
    rdfs:label 'Reconnection Fee' ;
    rdfs:comment 'Fee charged to restore service after disconnection. Must be paid along with outstanding balance before service is restored.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:taxExempt rdf:type rdf:Property ;
    rdfs:label 'Tax Exempt' ;
    rdfs:comment 'Indicates whether this account is exempt from utility taxes and fees. Typically applies to government entities, non-profits, or other qualifying organizations.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:taxExemptCertificate rdf:type rdf:Property ;
    rdfs:label 'Tax Exempt Certificate' ;
    rdfs:comment 'Certificate or permit number documenting the tax exemption status. Required for audit compliance and revenue reporting.' ;
    rdfs:domain ind:BillingAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supersededByBillingRateScheduleId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Billing Rate Schedule Id' ;
    rdfs:comment 'Foreign key reference to the rate schedule that supersedes this one. Nullable if this rate schedule is current or retired without replacement.' ;
    rdfs:domain ind:BillingRateSchedule ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BillingRateSchedule .

ind:baseChargeAmount rdf:type rdf:Property ;
    rdfs:label 'Base Charge Amount' ;
    rdfs:comment 'Fixed monthly or periodic base charge (service charge) applied to customers under this rate schedule, regardless of consumption. Expressed in local currency.' ;
    rdfs:domain ind:BillingRateSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:billingRateScheduleStatus rdf:type rdf:Property ;
    rdfs:label 'Billing Rate Schedule Status' ;
    rdfs:comment 'Current lifecycle status of the rate schedule (draft, pending approval, active, superseded, retired). Lifecycle status of the tariff.' ;
    rdfs:domain ind:BillingRateSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conservationRateIndicator rdf:type rdf:Property ;
    rdfs:label 'Conservation Rate Indicator' ;
    rdfs:comment 'Indicates whether this rate schedule is designed to promote water conservation through inclining block or penalty pricing (true) or not (false).' ;
    rdfs:domain ind:BillingRateSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:consumptionUnitOfMeasure rdf:type rdf:Property ;
    rdfs:label 'Consumption Unit Of Measure' ;
    rdfs:comment 'Unit of measure for consumption used in this rate schedule (e.g., gallons, cubic feet, cubic meters, kiloliters, hundred cubic feet (CCF)).' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:droughtSurchargeApplicable rdf:type rdf:Property ;
    rdfs:label 'Drought Surcharge Applicable' ;
    rdfs:comment 'Indicates whether a drought surcharge or emergency rate adjustment can be applied under this rate schedule (true) or not (false).' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:maximumChargeAmount rdf:type rdf:Property ;
    rdfs:label 'Maximum Charge Amount' ;
    rdfs:comment 'Maximum total charge amount per billing period under this rate schedule (cap). Nullable if no maximum applies.' ;
    rdfs:domain ind:BillingRateSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:meterSizeApplicability rdf:type rdf:Property ;
    rdfs:label 'Meter Size Applicability' ;
    rdfs:comment 'Meter size(s) or range this rate schedule applies to (e.g., \'5/8 inch\', \'1 inch\', \'2 inch and above\'). Nullable if not meter-size-specific.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minimumChargeAmount rdf:type rdf:Property ;
    rdfs:label 'Minimum Charge Amount' ;
    rdfs:comment 'Minimum total charge amount per billing period under this rate schedule, regardless of consumption. Nullable if no minimum applies.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rateScheduleName rdf:type rdf:Property ;
    rdfs:label 'Rate Schedule Name' ;
    rdfs:comment 'Human-readable name of the rate schedule (e.g., \'Residential Tiered Water Rate\', \'Commercial Flat Wastewater Rate\'). Identity label for the tariff.' ;
    rdfs:domain ind:BillingRateSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateStructureType rdf:type rdf:Property ;
    rdfs:label 'Rate Structure Type' ;
    rdfs:comment 'Type of rate structure used for billing calculations (e.g., flat, tiered/inclining block, seasonal, time-of-use, budget-based, uniform, declining block). Defines the pricing methodology. [ENUM-REF-CANDIDATE: flat|tiered|seasonal|time_of_use|budget_based|uniform|declining_block — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Regulatory Approval Date' ;
    rdfs:comment 'Date when the regulatory body (e.g., Public Utilities Commission) approved this rate schedule.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:seasonalIndicator rdf:type rdf:Property ;
    rdfs:label 'Seasonal Indicator' ;
    rdfs:comment 'Indicates whether this rate schedule has seasonal rate variations (true) or is uniform year-round (false).' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvalAuthority rdf:type rdf:Property ;
    rdfs:label 'Approval Authority' ;
    rdfs:comment 'Name of the regulatory body or internal authority that approved this rate component. Examples: State Public Utilities Commission, City Council, Utility Board of Directors.' ;
    rdfs:domain ind:RateComponent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billPrintLabel rdf:type rdf:Property ;
    rdfs:label 'Bill Print Label' ;
    rdfs:comment 'Customer-facing label text displayed on the bill for this component. Should be clear and understandable to customers. Examples: Monthly Service Charge, Water Usage - First 5 CCF, Stormwater Fee.' ;
    rdfs:domain ind:RateComponent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:calculationFormula rdf:type rdf:Property ;
    rdfs:label 'Calculation Formula' ;
    rdfs:comment 'Custom calculation expression for formula-based components. Contains the algorithmic logic used to compute the charge amount, referencing other rate components, usage data, or account attributes. Null for standard calculation methods.' ;
    rdfs:domain ind:RateComponent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:calculationMethod rdf:type rdf:Property ;
    rdfs:label 'Calculation Method' ;
    rdfs:comment 'Algorithm used to calculate the charge amount. Flat amount applies a fixed charge regardless of usage, per-unit multiplies usage by unit rate, tiered block applies different rates to usage ranges, percentage applies a rate to another charge, and formula uses a custom calculation expression.' ;
    rdfs:domain ind:RateComponent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:componentCode rdf:type rdf:Property ;
    rdfs:label 'Component Code' ;
    rdfs:comment 'Business identifier code for the rate component used in billing systems and rate books. Examples: BASE_CHG, TIER1_VOL, DEMAND_CHG, STORMWATER_FEE.' ;
    rdfs:domain ind:RateComponent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:componentName rdf:type rdf:Property ;
    rdfs:label 'Component Name' ;
    rdfs:comment 'Human-readable name of the rate component. Examples: Base Service Charge, First Tier Volumetric Charge, Peak Demand Charge, Stormwater Management Fee.' ;
    rdfs:domain ind:RateComponent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:componentType rdf:type rdf:Property ;
    rdfs:label 'Component Type' ;
    rdfs:comment 'Classification of the rate component defining its billing purpose. Base charges are fixed monthly fees, volumetric charges are consumption-based, demand charges are based on peak usage, tier charges apply to usage blocks, surcharges are additional fees, taxes are regulatory levies, fees are service-specific charges, adjustments modify base amounts, and credits reduce charges. [ENUM-REF-CANDIDATE: base_charge|volumetric_charge|demand_charge|tier_charge|surcharge|tax|fee|adjustment|credit — 9 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:RateComponent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conservationTierFlag rdf:type rdf:Property ;
    rdfs:label 'Conservation Tier Flag' ;
    rdfs:comment 'Indicates whether this component is part of a conservation-oriented inclining block rate structure designed to discourage excessive water use. True for higher-tier volumetric charges that increase with consumption.' ;
    rdfs:domain ind:RateComponent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:costCenter rdf:type rdf:Property ;
    rdfs:label 'Cost Center' ;
    rdfs:comment 'Cost center code for internal cost allocation and profitability analysis. Links revenue to the organizational unit or service line responsible for the charge.' ;
    rdfs:domain ind:RateComponent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:flatAmount rdf:type rdf:Property ;
    rdfs:label 'Flat Amount' ;
    rdfs:comment 'Fixed charge amount for flat-rate components such as base service charges, connection fees, or fixed surcharges. Null for volumetric or percentage-based components.' ;
    rdfs:domain ind:RateComponent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isVolumetric rdf:type rdf:Property ;
    rdfs:label 'Is Volumetric' ;
    rdfs:comment 'Indicates whether the component is consumption-based (volumetric) or fixed. True for components that vary with usage (per-unit, tiered block). False for fixed charges (base charges, flat fees). Used to distinguish variable from fixed revenue components.' ;
    rdfs:domain ind:RateComponent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:percentageRate rdf:type rdf:Property ;
    rdfs:label 'Percentage Rate' ;
    rdfs:comment 'Percentage rate applied for percentage-based components such as taxes, surcharges, or adjustments. Expressed as a decimal (e.g., 0.0825 for 8.25% sales tax). Null for non-percentage components.' ;
    rdfs:domain ind:RateComponent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:printOnBillFlag rdf:type rdf:Property ;
    rdfs:label 'Print On Bill Flag' ;
    rdfs:comment 'Indicates whether this component should be displayed as a separate line item on customer bills. True for components that require transparency and customer visibility. False for internal calculation components.' ;
    rdfs:domain ind:RateComponent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rateComponentStatus rdf:type rdf:Property ;
    rdfs:label 'Rate Component Status' ;
    rdfs:comment 'Current lifecycle status of the rate component. Active components are in use for billing. Inactive components are temporarily disabled. Pending approval components await regulatory approval. Superseded components have been replaced by newer versions. Retired components are no longer used and retained for historical reference only.' ;
    rdfs:domain ind:RateComponent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryReportingCategory rdf:type rdf:Property ;
    rdfs:label 'Regulatory Reporting Category' ;
    rdfs:comment 'Classification code for regulatory financial reporting and rate case filings. Maps the component to standardized reporting categories required by state public utilities commissions.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sequenceNumber rdf:type rdf:Property ;
    rdfs:label 'Sequence Number' ;
    rdfs:comment 'Ordering sequence for component calculation and display within the rate schedule. Lower numbers are calculated and displayed first. Critical for components with dependencies (e.g., base charge calculated before percentage surcharge).' ;
    rdfs:domain ind:RateComponent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:tierHighThreshold rdf:type rdf:Property ;
    rdfs:label 'Tier High Threshold' ;
    rdfs:comment 'Upper bound of the usage quantity range for tiered block rate components. Defines the maximum consumption level (inclusive) to which this tier rate applies. Measured in the component\'s unit of measure. Null indicates no upper limit (open-ended tier). Null for non-tiered components.' ;
    rdfs:domain ind:RateComponent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tierLowThreshold rdf:type rdf:Property ;
    rdfs:label 'Tier Low Threshold' ;
    rdfs:comment 'Lower bound of the usage quantity range for tiered block rate components. Defines the minimum consumption level (inclusive) to which this tier rate applies. Measured in the component\'s unit of measure. Null for non-tiered components.' ;
    rdfs:domain ind:RateComponent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:accuracyTestId rdf:type rdf:Property ;
    rdfs:label 'Accuracy Test Id' ;
    rdfs:comment 'Foreign key linking to metering.accuracy_test. Business justification: Meter accuracy test failures directly trigger billing adjustments to correct over/under-billing — a named regulatory and customer service process in water utilities. Auditors and billing analysts requ' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AccuracyTest .

ind:analyticalResultId rdf:type rdf:Property ;
    rdfs:label 'Analytical Result Id' ;
    rdfs:comment 'Foreign key linking to quality.analytical_result. Business justification: Billing adjustments issued for quality-driven credits (MCL exceedance, boil-water advisory, contamination event) must reference the specific analytical result that triggered the credit. Supports regul' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AnalyticalResult .

ind:enforcementActionId rdf:type rdf:Property ;
    rdfs:label 'Enforcement Action Id' ;
    rdfs:comment 'Foreign key linking to compliance.enforcement_action. Business justification: Enforcement actions with civil penalties mandate billing adjustments (penalty fee waivers, billing corrections). AR staff must trace which enforcement action triggered an adjustment for regulatory rep' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EnforcementAction .

ind:originalAdjustmentId rdf:type rdf:Property ;
    rdfs:label 'Original Adjustment Id' ;
    rdfs:comment 'Reference to the original adjustment record being reversed, if this is a reversal entry. Null if this is not a reversal.' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Adjustment .

ind:adjustmentNumber rdf:type rdf:Property ;
    rdfs:label 'Adjustment Number' ;
    rdfs:comment 'Externally visible unique adjustment reference number used for customer communication and audit trails.' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:adjustmentStatus rdf:type rdf:Property ;
    rdfs:label 'Adjustment Status' ;
    rdfs:comment 'Current lifecycle status of the adjustment: pending (awaiting approval), approved (authorized but not yet applied), rejected (denied), applied (posted to account), reversed (undone), cancelled (voided before application).' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:adjustmentType rdf:type rdf:Property ;
    rdfs:label 'Adjustment Type' ;
    rdfs:comment 'Classification of the adjustment indicating the nature of the correction: credit (reduces balance), debit (increases balance), write-off (uncollectible), leak_adjustment (leak allowance), rate_correction (tariff error), estimated_to_actual (true-up from estimated to actual meter reading), courtesy_credit (goodwill), penalty_reversal (late fee removal). [ENUM-REF-CANDIDATE: credit|debit|write-off|leak_adjustment|rate_correction|estimated_to_actual|courtesy_credit|penalty_reversal — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appliedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Applied Timestamp' ;
    rdfs:comment 'Date and time when the adjustment was actually posted to the customer account and reflected in the account balance. Null if not yet applied.' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:approvalRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Approval Required Flag' ;
    rdfs:comment 'Indicates whether supervisory approval is required for this adjustment based on amount thresholds or adjustment type. True if approval is required, False if auto-approved.' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:approvalThresholdAmount rdf:type rdf:Property ;
    rdfs:label 'Approval Threshold Amount' ;
    rdfs:comment 'The monetary threshold above which supervisory approval is required for this adjustment type. Null if no threshold applies.' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:chargeCategory rdf:type rdf:Property ;
    rdfs:label 'Charge Category' ;
    rdfs:comment 'The billing charge category being adjusted: consumption (usage-based charges), base_charge (fixed monthly fee), connection_fee (new service fees), late_fee (delinquency charges), penalty (violation fines), surcharge (special assessments), tax (sales or utility tax), other (miscellaneous). [ENUM-REF-CANDIDATE: consumption|base_charge|connection_fee|late_fee|penalty|surcharge|tax|other — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consumptionVolumeAdjusted rdf:type rdf:Property ;
    rdfs:label 'Consumption Volume Adjusted' ;
    rdfs:comment 'The volume of water or wastewater consumption being adjusted, measured in the utility\'s standard unit (typically gallons or cubic meters). Null if adjustment is not consumption-related.' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:costCenterCode rdf:type rdf:Property ;
    rdfs:label 'Cost Center Code' ;
    rdfs:comment 'Cost center or department code responsible for this adjustment, used for internal cost allocation and management reporting.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:customerNotificationSentFlag rdf:type rdf:Property ;
    rdfs:label 'Customer Notification Sent Flag' ;
    rdfs:comment 'Indicates whether the customer has been notified of this adjustment via bill message, email, or letter. True if notification sent, False otherwise.' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:disputeReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Dispute Reference Number' ;
    rdfs:comment 'Reference number of the customer billing dispute or complaint that triggered this adjustment. Null if not dispute-related.' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:externalReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'External Reference Number' ;
    rdfs:comment 'External reference number from third-party systems (e.g., payment processor, collection agency, regulatory agency) related to this adjustment. Null if no external reference.' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:leakAllowanceFlag rdf:type rdf:Property ;
    rdfs:label 'Leak Allowance Flag' ;
    rdfs:comment 'Indicates whether this adjustment is a leak allowance credit granted to the customer for documented plumbing leaks. True if leak allowance, False otherwise.' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:leakVerificationDate rdf:type rdf:Property ;
    rdfs:label 'Leak Verification Date' ;
    rdfs:comment 'Date when the plumbing leak was verified by utility staff or licensed plumber, supporting the leak allowance adjustment. Null if not a leak adjustment.' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:notificationSentTimestamp rdf:type rdf:Property ;
    rdfs:label 'Notification Sent Timestamp' ;
    rdfs:comment 'Date and time when customer notification of the adjustment was sent. Null if notification not yet sent.' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:rateCaseReference rdf:type rdf:Property ;
    rdfs:label 'Rate Case Reference' ;
    rdfs:comment 'Reference number of the regulatory rate case or tariff filing that mandated this adjustment. Null if not rate-case-related.' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reasonCode rdf:type rdf:Property ;
    rdfs:label 'Reason Code' ;
    rdfs:comment 'Standardized code indicating the specific business reason for the adjustment (e.g., BILLING_ERROR, METER_MALFUNCTION, LEAK_ALLOWANCE, CUSTOMER_DISPUTE, RATE_CHANGE, GOODWILL, REGULATORY_COMPLIANCE). Maps to internal reason code table.' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reasonDescription rdf:type rdf:Property ;
    rdfs:label 'Reason Description' ;
    rdfs:comment 'Detailed free-text explanation of the reason for the adjustment, providing context for audit and customer service purposes.' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryComplianceFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Compliance Flag' ;
    rdfs:comment 'Indicates whether this adjustment was made to comply with regulatory requirements or rate case orders. True if regulatory-driven, False otherwise.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reversalFlag rdf:type rdf:Property ;
    rdfs:label 'Reversal Flag' ;
    rdfs:comment 'Indicates whether this adjustment is a reversal of a previous adjustment. True if this is a reversal entry, False otherwise.' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:brokenDate rdf:type rdf:Property ;
    rdfs:label 'Broken Date' ;
    rdfs:comment 'Date when the payment plan was marked as broken due to missed payment or violation of terms. Nullable if plan has never been broken.' ;
    rdfs:domain ind:PaymentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:brokenReason rdf:type rdf:Property ;
    rdfs:label 'Broken Reason' ;
    rdfs:comment 'Reason the payment plan was marked as broken: missed installment (customer failed to pay on time), late payment (payment received after grace period), new charges unpaid (customer failed to pay current charges while on plan), customer request (customer asked to cancel), or administrative (utility-initiated termination).' ;
    rdfs:domain ind:PaymentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cancellationReason rdf:type rdf:Property ;
    rdfs:label 'Cancellation Reason' ;
    rdfs:comment 'Free-text explanation of why the payment plan was cancelled, capturing business context for audit and reporting purposes.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cancelledDate rdf:type rdf:Property ;
    rdfs:label 'Cancelled Date' ;
    rdfs:comment 'Date when the payment plan was cancelled by the utility or customer before completion. Nullable if plan was not cancelled.' ;
    rdfs:domain ind:PaymentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:completedInstallments rdf:type rdf:Property ;
    rdfs:label 'Completed Installments' ;
    rdfs:comment 'Number of installment payments successfully made by the customer to date.' ;
    rdfs:domain ind:PaymentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:currentBalanceAmount rdf:type rdf:Property ;
    rdfs:label 'Current Balance Amount' ;
    rdfs:comment 'Remaining balance amount still owed under the payment plan after applying all installment payments to date.' ;
    rdfs:domain ind:PaymentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:downPaymentAmount rdf:type rdf:Property ;
    rdfs:label 'Down Payment Amount' ;
    rdfs:comment 'Initial down payment amount required to establish the payment plan, paid at enrollment. Nullable if no down payment was required.' ;
    rdfs:domain ind:PaymentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:downPaymentReceivedDate rdf:type rdf:Property ;
    rdfs:label 'Down Payment Received Date' ;
    rdfs:comment 'Date when the down payment was received and the payment plan was activated. Nullable if no down payment was required.' ;
    rdfs:domain ind:PaymentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:enrolledBalanceAmount rdf:type rdf:Property ;
    rdfs:label 'Enrolled Balance Amount' ;
    rdfs:comment 'Total delinquent balance amount enrolled in the payment plan at the time of plan establishment. Represents the arrears being repaid through installments.' ;
    rdfs:domain ind:PaymentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:gracePeriodDays rdf:type rdf:Property ;
    rdfs:label 'Grace Period Days' ;
    rdfs:comment 'Number of days after the installment due date during which a late payment is accepted without breaking the plan.' ;
    rdfs:domain ind:PaymentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:installmentAmount rdf:type rdf:Property ;
    rdfs:label 'Installment Amount' ;
    rdfs:comment 'Fixed amount the customer is required to pay per installment period to satisfy the payment plan terms.' ;
    rdfs:domain ind:PaymentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:installmentFrequency rdf:type rdf:Property ;
    rdfs:label 'Installment Frequency' ;
    rdfs:comment 'Frequency at which installment payments are due: weekly, biweekly, monthly, or quarterly.' ;
    rdfs:domain ind:PaymentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:liheapEligible rdf:type rdf:Property ;
    rdfs:label 'Liheap Eligible' ;
    rdfs:comment 'Indicates whether the customer on this payment plan is eligible for LIHEAP or similar low-income energy assistance coordination. True if eligible; false otherwise.' ;
    rdfs:domain ind:PaymentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nextInstallmentDueDate rdf:type rdf:Property ;
    rdfs:label 'Next Installment Due Date' ;
    rdfs:comment 'Date when the next installment payment is due from the customer.' ;
    rdfs:domain ind:PaymentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:planEndDate rdf:type rdf:Property ;
    rdfs:label 'Plan End Date' ;
    rdfs:comment 'Scheduled date when the payment plan is expected to be completed if all installments are paid on time. Nullable for open-ended plans.' ;
    rdfs:domain ind:PaymentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:planNumber rdf:type rdf:Property ;
    rdfs:label 'Plan Number' ;
    rdfs:comment 'Externally visible unique business identifier for the payment plan, formatted as PP-XXXXXXXX.' ;
    rdfs:domain ind:PaymentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planStartDate rdf:type rdf:Property ;
    rdfs:label 'Plan Start Date' ;
    rdfs:comment 'Date when the payment plan becomes effective and the first installment is due.' ;
    rdfs:domain ind:PaymentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:planStatus rdf:type rdf:Property ;
    rdfs:label 'Plan Status' ;
    rdfs:comment 'Current lifecycle status of the payment plan: active (customer is making payments on schedule), broken (customer missed payment and violated terms), completed (all installments paid), cancelled (plan terminated by utility or customer), suspended (temporarily paused), or pending approval (awaiting credit review).' ;
    rdfs:domain ind:PaymentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planType rdf:type rdf:Property ;
    rdfs:label 'Plan Type' ;
    rdfs:comment 'Classification of the payment plan arrangement: budget billing (level monthly payments), deferred payment agreement (short-term installment), low-income assistance (subsidized plan), arrearage management (long-term debt forgiveness plan), seasonal payment (adjusted for seasonal usage), or extended payment (custom extended terms).' ;
    rdfs:domain ind:PaymentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requiresCurrentChargesPaid rdf:type rdf:Property ;
    rdfs:label 'Requires Current Charges Paid' ;
    rdfs:comment 'Indicates whether the customer must pay all new current charges in addition to installment payments to remain in good standing on the plan. True if current charges must be paid; false if only installments are required.' ;
    rdfs:domain ind:PaymentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:totalInstallments rdf:type rdf:Property ;
    rdfs:label 'Total Installments' ;
    rdfs:comment 'Total number of scheduled installment payments required to complete the payment plan.' ;
    rdfs:domain ind:PaymentPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:collectionNoticeId rdf:type rdf:Property ;
    rdfs:label 'Collection Notice Id' ;
    rdfs:comment 'Primary key for collection_notice' ;
    rdfs:domain ind:CollectionNotice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:disconnectionServiceOrderId rdf:type rdf:Property ;
    rdfs:label 'Disconnection Service Order Id' ;
    rdfs:comment 'Foreign key linking to service.service_order. Business justification: Collection notices for non-payment trigger disconnection service orders when payment is not received by due date. Collections workflow requires linking the delinquency notice to the scheduled disconne' ;
    rdfs:domain ind:CollectionNotice ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Order .

ind:precedingRateTierId rdf:type rdf:Property ;
    rdfs:label 'Preceding Rate Tier Id' ;
    rdfs:comment 'Self-referencing FK on rate_tier (preceding_rate_tier_id)' ;
    rdfs:domain ind:RateTier ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RateTier .

ind:consumptionMax rdf:type rdf:Property ;
    rdfs:label 'Consumption Max' ;
    rdfs:comment 'Upper bound of consumption for which this tier applies; null for no upper limit.' ;
    rdfs:domain ind:RateTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:consumptionMin rdf:type rdf:Property ;
    rdfs:label 'Consumption Min' ;
    rdfs:comment 'Lower bound of consumption (in unit_of_measure) for which this tier applies.' ;
    rdfs:domain ind:RateTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:effectiveFrom rdf:type rdf:Property ;
    rdfs:label 'Effective From' ;
    rdfs:comment 'Date when the tier becomes effective for billing.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:effectiveUntil rdf:type rdf:Property ;
    rdfs:label 'Effective Until' ;
    rdfs:comment 'Date when the tier expires; null if open-ended.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:fixedCharge rdf:type rdf:Property ;
    rdfs:label 'Fixed Charge' ;
    rdfs:comment 'Flat fee applied for this tier regardless of consumption.' ;
    rdfs:domain ind:RateTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ratePerUnit rdf:type rdf:Property ;
    rdfs:label 'Rate Per Unit' ;
    rdfs:comment 'Price charged per unit of consumption within this tier (currency per unit).' ;
    rdfs:domain ind:RateTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rateTierStatus rdf:type rdf:Property ;
    rdfs:label 'Rate Tier Status' ;
    rdfs:comment 'Current lifecycle status of the tier.' ;
    rdfs:domain ind:RateTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surchargeAmount rdf:type rdf:Property ;
    rdfs:label 'Surcharge Amount' ;
    rdfs:comment 'Amount of surcharge applied when surcharge_applicable is true.' ;
    rdfs:domain ind:RateTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:surchargeApplicable rdf:type rdf:Property ;
    rdfs:label 'Surcharge Applicable' ;
    rdfs:comment 'Indicates whether a surcharge is applied to this tier.' ;
    rdfs:domain ind:RateTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:taxRate rdf:type rdf:Property ;
    rdfs:label 'Tax Rate' ;
    rdfs:comment 'Applicable tax rate percentage for the tier when not tax-exempt.' ;
    rdfs:domain ind:RateTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tierCode rdf:type rdf:Property ;
    rdfs:label 'Tier Code' ;
    rdfs:comment 'Short alphanumeric code used to identify the tier in billing systems.' ;
    rdfs:domain ind:RateTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tierName rdf:type rdf:Property ;
    rdfs:label 'Tier Name' ;
    rdfs:comment 'Human-readable name of the rate tier (e.g., "Residential Tier 1").' ;
    rdfs:domain ind:RateTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tierType rdf:type rdf:Property ;
    rdfs:label 'Tier Type' ;
    rdfs:comment 'Category of customers or service that the tier applies to.' ;
    rdfs:domain ind:RateTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:variableCharge rdf:type rdf:Property ;
    rdfs:label 'Variable Charge' ;
    rdfs:comment 'Additional variable component (e.g., service fee) applied per billing period.' ;
    rdfs:domain ind:RateTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:previousBillingCycleId rdf:type rdf:Property ;
    rdfs:label 'Previous Billing Cycle Id' ;
    rdfs:comment 'Self-referencing FK on billing_cycle (previous_billing_cycle_id)' ;
    rdfs:domain ind:Cycle ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Cycle .

ind:billingCycleDescription rdf:type rdf:Property ;
    rdfs:label 'Billing Cycle Description' ;
    rdfs:comment 'Free-form text describing the purpose or special conditions of the billing cycle.' ;
    rdfs:domain ind:Cycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingCycleStatus rdf:type rdf:Property ;
    rdfs:label 'Billing Cycle Status' ;
    rdfs:comment 'Current lifecycle status of the billing cycle.' ;
    rdfs:domain ind:Cycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingPeriodEnd rdf:type rdf:Property ;
    rdfs:label 'Billing Period End' ;
    rdfs:comment 'Last calendar day covered by the billing cycle.' ;
    rdfs:domain ind:Cycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:billingPeriodStart rdf:type rdf:Property ;
    rdfs:label 'Billing Period Start' ;
    rdfs:comment 'First calendar day covered by the billing cycle.' ;
    rdfs:domain ind:Cycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cycleType rdf:type rdf:Property ;
    rdfs:label 'Cycle Type' ;
    rdfs:comment 'Classification of the billing cycle based on its recurrence pattern.' ;
    rdfs:domain ind:Cycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:discountAmount rdf:type rdf:Property ;
    rdfs:label 'Discount Amount' ;
    rdfs:comment 'Total discount granted for the billing cycle.' ;
    rdfs:domain ind:Cycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lastProcessedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Processed Timestamp' ;
    rdfs:comment 'Timestamp when the billing cycle was last processed for invoicing or payment.' ;
    rdfs:domain ind:Cycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:lateFeeApplied rdf:type rdf:Property ;
    rdfs:label 'Late Fee Applied' ;
    rdfs:comment 'Indicates whether a late fee has been assessed for this cycle.' ;
    rdfs:domain ind:Cycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:netAmount rdf:type rdf:Property ;
    rdfs:label 'Net Amount' ;
    rdfs:comment 'Final amount payable after taxes and discounts.' ;
    rdfs:domain ind:Cycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalAmount rdf:type rdf:Property ;
    rdfs:label 'Total Amount' ;
    rdfs:comment 'Gross amount billed before taxes, discounts, or adjustments.' ;
    rdfs:domain ind:Cycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sewerNetworkId rdf:type rdf:Property ;
    rdfs:label 'Sewer Network Id' ;
    rdfs:comment 'Unique identifier for the sewer network segment. Primary key for the sewer network master topology.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SewerNetwork .

ind:wwtpId rdf:type rdf:Property ;
    rdfs:label 'Wwtp Id' ;
    rdfs:comment 'Identifier of the Wastewater Treatment Plant (WWTP) that receives flow from this sewer segment. Supports load allocation and treatment capacity planning.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Wwtp .

ind:assetTag rdf:type rdf:Property ;
    rdfs:label 'Asset Tag' ;
    rdfs:comment 'Physical asset tag or barcode identifier affixed to the segment or associated manhole for field identification and work order tracking in IBM Maximo.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:averageDailyFlowMgd rdf:type rdf:Property ;
    rdfs:label 'Average Daily Flow Mgd' ;
    rdfs:comment 'Average daily wastewater flow through the segment in Million Gallons per Day (MGD). Used for load balancing and treatment plant influent forecasting.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:conditionGrade rdf:type rdf:Property ;
    rdfs:label 'Condition Grade' ;
    rdfs:comment 'Current physical condition assessment of the sewer segment based on CCTV inspection, PACP (Pipeline Assessment and Certification Program) scoring, or field evaluation. Drives maintenance and replacement decisions.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coordinateSystem rdf:type rdf:Property ;
    rdfs:label 'Coordinate System' ;
    rdfs:comment 'Spatial reference system identifier (e.g., EPSG code) for the GIS geometry. Ensures spatial data interoperability and accurate georeferencing.' ;
    rdfs:domain ind:SewerNetwork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:criticalityScore rdf:type rdf:Property ;
    rdfs:label 'Criticality Score' ;
    rdfs:comment 'Risk-based criticality rating (typically 1-100 scale) reflecting consequence of failure, service impact, and environmental risk. Drives capital investment prioritization.' ;
    rdfs:domain ind:SewerNetwork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:downstreamInvertElevationFeet rdf:type rdf:Property ;
    rdfs:label 'Downstream Invert Elevation Feet' ;
    rdfs:comment 'Elevation of the inside bottom of the pipe at the downstream end in feet above mean sea level. Used with upstream invert to calculate slope and hydraulic capacity.' ;
    rdfs:domain ind:SewerNetwork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:easementRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Easement Required Flag' ;
    rdfs:comment 'Indicates whether a legal easement is required for utility access to the sewer segment. Critical for maintenance planning and right-of-way management.' ;
    rdfs:domain ind:SewerNetwork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fogRiskFlag rdf:type rdf:Property ;
    rdfs:label 'Fog Risk Flag' ;
    rdfs:comment 'Indicates whether the segment is at elevated risk for FOG (Fats, Oils, and Grease) blockages based on upstream land use (restaurants, food processing). Drives preventive maintenance frequency.' ;
    rdfs:domain ind:Wastewater ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hydrogenSulfideRiskFlag rdf:type rdf:Property ;
    rdfs:label 'Hydrogen Sulfide Risk Flag' ;
    rdfs:comment 'Indicates elevated risk of hydrogen sulfide gas generation and corrosion. Common in force mains and long gravity sewers with low flow velocity.' ;
    rdfs:domain ind:SewerNetwork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:liningInstallationDate rdf:type rdf:Property ;
    rdfs:label 'Lining Installation Date' ;
    rdfs:comment 'Date when pipe lining or rehabilitation was completed. Resets the effective age for condition assessment and extends asset useful life.' ;
    rdfs:domain ind:SewerNetwork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:peakFlowGpm rdf:type rdf:Property ;
    rdfs:label 'Peak Flow Gpm' ;
    rdfs:comment 'Maximum observed or modeled flow rate in Gallons per Minute (GPM) during peak wet weather or high demand periods. Critical for SSO risk assessment.' ;
    rdfs:domain ind:SewerNetwork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:replacementCostUsd rdf:type rdf:Property ;
    rdfs:label 'Replacement Cost Usd' ;
    rdfs:comment 'Estimated current replacement cost of the sewer segment in US Dollars. Used for asset valuation, insurance, and capital improvement program (CIP) budgeting.' ;
    rdfs:domain ind:Wastewater ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rootIntrusionFlag rdf:type rdf:Property ;
    rdfs:label 'Root Intrusion Flag' ;
    rdfs:comment 'Indicates whether tree root intrusion has been observed or is a known risk for this segment. Common in older vitrified clay and concrete pipes.' ;
    rdfs:domain ind:Wastewater ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:segmentIdentifier rdf:type rdf:Property ;
    rdfs:label 'Segment Identifier' ;
    rdfs:comment 'Externally-known unique identifier for the sewer segment used in GIS systems, field operations, and regulatory reporting. Aligns with Esri ArcGIS feature identifiers.' ;
    rdfs:domain ind:SewerNetwork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:segmentType rdf:type rdf:Property ;
    rdfs:label 'Segment Type' ;
    rdfs:comment 'Classification of the sewer segment by conveyance method and network hierarchy. Gravity sewers use slope for flow; force mains use pumps; interceptors and trunk lines are major collectors.' ;
    rdfs:domain ind:SewerNetwork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:slopePercent rdf:type rdf:Property ;
    rdfs:label 'Slope Percent' ;
    rdfs:comment 'Gradient of the sewer pipe expressed as a percentage. Critical for gravity sewer hydraulic performance and self-cleansing velocity calculations.' ;
    rdfs:domain ind:SewerNetwork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ssoHistoryCount rdf:type rdf:Property ;
    rdfs:label 'Sso History Count' ;
    rdfs:comment 'Number of Sanitary Sewer Overflow (SSO) events recorded for this segment. High counts trigger regulatory scrutiny and prioritize capacity upgrades.' ;
    rdfs:domain ind:SewerNetwork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:trafficImpactLevel rdf:type rdf:Property ;
    rdfs:label 'Traffic Impact Level' ;
    rdfs:comment 'Assessment of traffic disruption risk if the segment requires excavation or repair. High-traffic segments require special permitting and coordination.' ;
    rdfs:domain ind:SewerNetwork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:upstreamInvertElevationFeet rdf:type rdf:Property ;
    rdfs:label 'Upstream Invert Elevation Feet' ;
    rdfs:comment 'Elevation of the inside bottom of the pipe at the upstream end in feet above mean sea level. Essential for hydraulic grade line analysis and I&I (Inflow and Infiltration) assessment.' ;
    rdfs:domain ind:SewerNetwork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:manholeId rdf:type rdf:Property ;
    rdfs:label 'Manhole Id' ;
    rdfs:comment 'Unique identifier for the manhole structure in the wastewater collection system. Primary key.' ;
    rdfs:domain ind:Wastewater ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Manhole .

ind:basinCode rdf:type rdf:Property ;
    rdfs:label 'Basin Code' ;
    rdfs:comment 'Code identifying the drainage basin or sewershed that this manhole serves. Used for hydraulic modeling and capacity planning.' ;
    rdfs:domain ind:Wastewater ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:confinedSpaceFlag rdf:type rdf:Property ;
    rdfs:label 'Confined Space Flag' ;
    rdfs:comment 'Indicates whether the manhole is classified as a permit-required confined space under OSHA regulations. True if the manhole requires a confined space entry permit; false otherwise. Critical for worker safety and entry procedures.' ;
    rdfs:domain ind:Manhole ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:coverType rdf:type rdf:Property ;
    rdfs:label 'Cover Type' ;
    rdfs:comment 'Type of cover installed on the manhole. Watertight covers prevent Inflow and Infiltration (I&I); bolted covers provide security; vented covers allow gas release; traffic-rated covers support vehicular loads.' ;
    rdfs:domain ind:Manhole ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dmaCode rdf:type rdf:Property ;
    rdfs:label 'Dma Code' ;
    rdfs:comment 'Code identifying the District Metered Area (DMA) or pressure zone to which this manhole belongs. Used for network segmentation and performance monitoring.' ;
    rdfs:domain ind:Manhole ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gisFeatureReference rdf:type rdf:Property ;
    rdfs:label 'Gis Feature Reference' ;
    rdfs:comment 'Unique identifier for the manhole feature in the utility\'s GIS system. Used to link asset management data with spatial data layers in ArcGIS or other GIS platforms.' ;
    rdfs:domain ind:Wastewater ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inflowInfiltrationFlag rdf:type rdf:Property ;
    rdfs:label 'Inflow Infiltration Flag' ;
    rdfs:comment 'Indicates whether the manhole has been identified as a source of Inflow and Infiltration (I&I) into the wastewater collection system. True if I&I has been observed or suspected; false otherwise. Used for prioritizing I&I reduction programs.' ;
    rdfs:domain ind:Manhole ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:invertElevationFeet rdf:type rdf:Property ;
    rdfs:label 'Invert Elevation Feet' ;
    rdfs:comment 'Elevation of the lowest point inside the manhole where wastewater flows, measured in feet above a reference datum. Critical for calculating pipe slopes and flow gradients.' ;
    rdfs:domain ind:Manhole ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:macpScore rdf:type rdf:Property ;
    rdfs:label 'Macp Score' ;
    rdfs:comment 'Numerical condition score assigned using the NASSCO Manhole Assessment and Certification Program (MACP) methodology. Higher scores indicate worse condition. Used for prioritizing rehabilitation and capital planning.' ;
    rdfs:domain ind:Wastewater ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:manholeNumber rdf:type rdf:Property ;
    rdfs:label 'Manhole Number' ;
    rdfs:comment 'Business identifier or asset tag assigned to the manhole for field operations and maintenance tracking. Typically displayed on manhole covers or in field maps.' ;
    rdfs:domain ind:Manhole ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:manholeStatus rdf:type rdf:Property ;
    rdfs:label 'Manhole Status' ;
    rdfs:comment 'Current operational status of the manhole in the wastewater collection system lifecycle. Active manholes are in service; inactive are temporarily out of service; abandoned are no longer used but not removed; planned are in design phase; under construction are being installed; decommissioned are permanently removed from service.' ;
    rdfs:domain ind:Manhole ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:manholeType rdf:type rdf:Property ;
    rdfs:label 'Manhole Type' ;
    rdfs:comment 'Classification of the manhole based on its function in the wastewater collection network. Standard manholes provide access; drop manholes accommodate elevation changes; junction manholes connect multiple pipes; terminal manholes mark the end of a line; diversion manholes route flow; metering manholes house flow measurement equipment. [ENUM-REF-CANDIDATE: standard|drop|junction|terminal|diversion|metering|special — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Manhole ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ownership rdf:type rdf:Property ;
    rdfs:label 'Ownership' ;
    rdfs:comment 'Entity that owns the manhole asset. Utility-owned assets are maintained by the water utility; municipal assets may be owned by the city; private assets are on private property; joint ownership involves shared responsibility.' ;
    rdfs:domain ind:Manhole ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rimElevationFeet rdf:type rdf:Property ;
    rdfs:label 'Rim Elevation Feet' ;
    rdfs:comment 'Elevation of the manhole rim (top of cover) above a reference datum, typically mean sea level, measured in feet. Used for hydraulic modeling and flood risk assessment.' ;
    rdfs:domain ind:Manhole ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ssoHistoryFlag rdf:type rdf:Property ;
    rdfs:label 'Sso History Flag' ;
    rdfs:comment 'Indicates whether the manhole has a history of Sanitary Sewer Overflows (SSO). True if SSO events have occurred at this location; false otherwise. Used for identifying high-risk locations and prioritizing capacity improvements.' ;
    rdfs:domain ind:Wastewater ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:trafficLoadRating rdf:type rdf:Property ;
    rdfs:label 'Traffic Load Rating' ;
    rdfs:comment 'Load rating classification of the manhole cover based on expected vehicular traffic. Light duty for pedestrian areas; medium duty for residential streets; heavy duty for arterial roads; extra heavy duty for highways and industrial areas.' ;
    rdfs:domain ind:Manhole ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:receivingWaterSourceId rdf:type rdf:Property ;
    rdfs:label 'Receiving Water Source Id' ;
    rdfs:comment 'Foreign key linking to treatment.water_source. Business justification: SDWA source water assessment regulations require utilities to identify when a WWTP discharges into a water body that is also a drinking water source. This link enables cross-domain source water protec' ;
    rdfs:domain ind:Wastewater ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:WaterSource .

ind:biosolidsClass rdf:type rdf:Property ;
    rdfs:label 'Biosolids Class' ;
    rdfs:comment 'EPA classification of biosolids quality based on pathogen reduction and vector attraction reduction requirements.' ;
    rdfs:domain ind:Wwtp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:biosolidsManagementMethod rdf:type rdf:Property ;
    rdfs:label 'Biosolids Management Method' ;
    rdfs:comment 'Primary method used for disposal or beneficial reuse of biosolids (treated sewage sludge) generated by the treatment process.' ;
    rdfs:domain ind:Wwtp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceStatus rdf:type rdf:Property ;
    rdfs:label 'Compliance Status' ;
    rdfs:comment 'Current regulatory compliance status of the facility with respect to NPDES permit limits and reporting requirements.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:effluentDischargePoint rdf:type rdf:Property ;
    rdfs:label 'Effluent Discharge Point' ;
    rdfs:comment 'Geographic or infrastructure identifier for the outfall location where treated effluent is discharged from the facility.' ;
    rdfs:domain ind:Wwtp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:energyConsumptionKwhPerMg rdf:type rdf:Property ;
    rdfs:label 'Energy Consumption Kwh Per Mg' ;
    rdfs:comment 'Average energy intensity of the treatment process measured in kilowatt-hours per million gallons treated. Key performance indicator for operational efficiency.' ;
    rdfs:domain ind:Wwtp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:facilityEmail rdf:type rdf:Property ;
    rdfs:label 'Facility Email' ;
    rdfs:comment 'Primary email address for facility operations and regulatory correspondence.' ;
    rdfs:domain ind:Wwtp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facilityPhone rdf:type rdf:Property ;
    rdfs:label 'Facility Phone' ;
    rdfs:comment 'Primary contact phone number for the wastewater treatment plant operations center.' ;
    rdfs:domain ind:Wwtp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:operatorCertificationLevel rdf:type rdf:Property ;
    rdfs:label 'Operator Certification Level' ;
    rdfs:comment 'Minimum operator certification level or class required to operate this facility (e.g., Class I, Class II, Class III, Class IV).' ;
    rdfs:domain ind:Wwtp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:operatorCertificationRequired rdf:type rdf:Property ;
    rdfs:label 'Operator Certification Required' ;
    rdfs:comment 'Indicates whether state-certified operators are required to manage this facility per regulatory requirements.' ;
    rdfs:domain ind:Wwtp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:peakFlowMgd rdf:type rdf:Property ;
    rdfs:label 'Peak Flow Mgd' ;
    rdfs:comment 'Maximum instantaneous or daily flow capacity the facility can handle during wet weather or peak demand events.' ;
    rdfs:domain ind:Wwtp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:receivingWaterClassification rdf:type rdf:Property ;
    rdfs:label 'Receiving Water Classification' ;
    rdfs:comment 'Regulatory classification of the receiving water body (e.g., Class A, Class B, impaired, sensitive) that determines discharge limits.' ;
    rdfs:domain ind:Wwtp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scadaSystemReference rdf:type rdf:Property ;
    rdfs:label 'Scada System Reference' ;
    rdfs:comment 'Identifier linking this facility to the SCADA system for real-time process monitoring and control data integration.' ;
    rdfs:domain ind:Wwtp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:treatmentLevel rdf:type rdf:Property ;
    rdfs:label 'Treatment Level' ;
    rdfs:comment 'Highest level of treatment provided by the facility process train, indicating the degree of pollutant removal achieved.' ;
    rdfs:domain ind:Wwtp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:treatmentProcessDescription rdf:type rdf:Property ;
    rdfs:label 'Treatment Process Description' ;
    rdfs:comment 'Detailed description of the treatment process train including primary, secondary, and tertiary treatment technologies employed (e.g., activated sludge, trickling filter, membrane bioreactor, UV disinfection).' ;
    rdfs:domain ind:Wwtp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:effluentDischargeEventId rdf:type rdf:Property ;
    rdfs:label 'Effluent Discharge Event Id' ;
    rdfs:comment 'Unique identifier for the effluent discharge event record. Primary key for tracking individual discharge occurrences from WWTP outfalls.' ;
    rdfs:domain ind:Wastewater ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EffluentDischargeEvent .

ind:dischargeAssetRegistryId rdf:type rdf:Property ;
    rdfs:label 'Discharge Asset Registry Id' ;
    rdfs:comment 'Foreign key linking to asset.registry. Business justification: Discharge events are associated with specific outfall structures and discharge point assets registered in the asset registry. Role-prefix \'discharge_\' used because effluent_discharge_event may referen' ;
    rdfs:domain ind:Wastewater ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Registry .

ind:dischargeWaterSampleId rdf:type rdf:Property ;
    rdfs:label 'Discharge Water Sample Id' ;
    rdfs:comment 'Foreign key linking to quality.water_sample. Business justification: NPDES regulations require water sampling at the discharge point during effluent discharge events (especially bypasses) to assess receiving water body impact. Compliance officers and regulators expect ' ;
    rdfs:domain ind:EffluentDischargeEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:WaterSample .

ind:effluentMeteringMeterId rdf:type rdf:Property ;
    rdfs:label 'Effluent Metering Meter Id' ;
    rdfs:comment 'Foreign key linking to metering.metering_meter. Business justification: NPDES/DMR regulatory compliance requires identifying the specific flow meter used to measure effluent discharge volume. The measured discharge_volume_mgd and discharge_flow_rate_gpm must be traceable ' ;
    rdfs:domain ind:EffluentDischargeEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Meter .

ind:bypassNotificationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Bypass Notification Timestamp' ;
    rdfs:comment 'Date and time when regulatory authorities were notified of an emergency bypass or unauthorized discharge event, as required by NPDES permit conditions.' ;
    rdfs:domain ind:EffluentDischargeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:bypassReasonCode rdf:type rdf:Property ;
    rdfs:label 'Bypass Reason Code' ;
    rdfs:comment 'Standardized code indicating the reason for a treatment bypass or emergency discharge (e.g., equipment failure, extreme weather, power outage).' ;
    rdfs:domain ind:EffluentDischargeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dischargeAuthorizationNumber rdf:type rdf:Property ;
    rdfs:label 'Discharge Authorization Number' ;
    rdfs:comment 'External authorization or permit number assigned by the regulatory agency for this discharge event or outfall.' ;
    rdfs:domain ind:EffluentDischargeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dischargeDurationHours rdf:type rdf:Property ;
    rdfs:label 'Discharge Duration Hours' ;
    rdfs:comment 'Total duration of the discharge event measured in hours. Calculated from start and end timestamps.' ;
    rdfs:domain ind:EffluentDischargeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dischargeEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Discharge End Timestamp' ;
    rdfs:comment 'Date and time when the effluent discharge event ended. Used to calculate total discharge duration and volume.' ;
    rdfs:domain ind:EffluentDischargeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:dischargeFlowRateGpm rdf:type rdf:Property ;
    rdfs:label 'Discharge Flow Rate Gpm' ;
    rdfs:comment 'Average flow rate of effluent discharge measured in gallons per minute during the event.' ;
    rdfs:domain ind:EffluentDischargeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dischargePointLatitude rdf:type rdf:Property ;
    rdfs:label 'Discharge Point Latitude' ;
    rdfs:comment 'Geographic latitude coordinate of the outfall discharge point in decimal degrees.' ;
    rdfs:domain ind:EffluentDischargeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dischargePointLongitude rdf:type rdf:Property ;
    rdfs:label 'Discharge Point Longitude' ;
    rdfs:comment 'Geographic longitude coordinate of the outfall discharge point in decimal degrees.' ;
    rdfs:domain ind:EffluentDischargeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dischargeStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Discharge Start Timestamp' ;
    rdfs:comment 'Date and time when the effluent discharge event began. Critical for calculating discharge duration and compliance with permit limits.' ;
    rdfs:domain ind:EffluentDischargeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:dischargeStatus rdf:type rdf:Property ;
    rdfs:label 'Discharge Status' ;
    rdfs:comment 'Current operational status of the discharge event indicating whether it was authorized under permit conditions, an emergency bypass, or an unauthorized release.' ;
    rdfs:domain ind:EffluentDischargeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dischargeType rdf:type rdf:Property ;
    rdfs:label 'Discharge Type' ;
    rdfs:comment 'Classification of the discharge event based on operational pattern: continuous flow, intermittent release, batch discharge, or bypass event.' ;
    rdfs:domain ind:EffluentDischargeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dischargeVolumeMgd rdf:type rdf:Property ;
    rdfs:label 'Discharge Volume Mgd' ;
    rdfs:comment 'Total volume of treated effluent discharged during this event, measured in million gallons per day. Core metric for NPDES permit compliance and DMR reporting.' ;
    rdfs:domain ind:EffluentDischargeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dmrReportingPeriod rdf:type rdf:Property ;
    rdfs:label 'Dmr Reporting Period' ;
    rdfs:comment 'The monthly or quarterly DMR reporting period to which this discharge event will be aggregated for regulatory submission.' ;
    rdfs:domain ind:Wastewater ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dmrSubmissionDate rdf:type rdf:Property ;
    rdfs:label 'Dmr Submission Date' ;
    rdfs:comment 'Date when the DMR containing this discharge event data was submitted to the regulatory authority.' ;
    rdfs:domain ind:Wastewater ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:dmrSubmittedFlag rdf:type rdf:Property ;
    rdfs:label 'Dmr Submitted Flag' ;
    rdfs:comment 'Indicates whether this discharge event has been included in a submitted DMR to the regulatory authority.' ;
    rdfs:domain ind:EffluentDischargeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:operatorCertificationNumber rdf:type rdf:Property ;
    rdfs:label 'Operator Certification Number' ;
    rdfs:comment 'State-issued certification number of the operator responsible for monitoring the discharge event.' ;
    rdfs:domain ind:EffluentDischargeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:operatorName rdf:type rdf:Property ;
    rdfs:label 'Operator Name' ;
    rdfs:comment 'Name of the certified wastewater treatment plant operator on duty during the discharge event.' ;
    rdfs:domain ind:EffluentDischargeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:permitLimitApplicableFlag rdf:type rdf:Property ;
    rdfs:label 'Permit Limit Applicable Flag' ;
    rdfs:comment 'Indicates whether NPDES permit discharge limits apply to this specific discharge event. False for emergency bypasses or non-permitted discharges.' ;
    rdfs:domain ind:EffluentDischargeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rainfallAmountInches rdf:type rdf:Property ;
    rdfs:label 'Rainfall Amount Inches' ;
    rdfs:comment 'Total rainfall measured in inches during or immediately preceding the discharge event. Relevant for wet weather discharge analysis and CSO/SSO correlation.' ;
    rdfs:domain ind:Wastewater ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:receivingWaterBodyClassification rdf:type rdf:Property ;
    rdfs:label 'Receiving Water Body Classification' ;
    rdfs:comment 'Regulatory classification of the receiving water body (e.g., Class A, Class B, impaired waters, sensitive ecosystem) that determines applicable discharge standards.' ;
    rdfs:domain ind:EffluentDischargeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scadaEventReference rdf:type rdf:Property ;
    rdfs:label 'Scada Event Reference' ;
    rdfs:comment 'Identifier linking this discharge event to the corresponding SCADA system event record for process data correlation.' ;
    rdfs:domain ind:EffluentDischargeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:treatmentLevelAchieved rdf:type rdf:Property ;
    rdfs:label 'Treatment Level Achieved' ;
    rdfs:comment 'Level of wastewater treatment achieved prior to discharge (primary, secondary, tertiary, advanced, or partial treatment during bypass).' ;
    rdfs:domain ind:EffluentDischargeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:violationDescription rdf:type rdf:Property ;
    rdfs:label 'Violation Description' ;
    rdfs:comment 'Detailed description of any permit violations or exceedances that occurred during this discharge event, including parameters exceeded and magnitude.' ;
    rdfs:domain ind:EffluentDischargeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:violationFlag rdf:type rdf:Property ;
    rdfs:label 'Violation Flag' ;
    rdfs:comment 'Indicates whether this discharge event resulted in one or more NPDES permit violations or exceedances of discharge limits.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:contaminantId rdf:type rdf:Property ;
    rdfs:label 'Contaminant Id' ;
    rdfs:comment 'Foreign key linking to quality.contaminant. Business justification: Each effluent parameter result measures a specific regulated contaminant. parameter_name and parameter_code are denormalized representations of the contaminant entity. Linking to quality.contaminant n' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Contaminant .

ind:contaminantLimitId rdf:type rdf:Property ;
    rdfs:label 'Contaminant Limit Id' ;
    rdfs:comment 'Foreign key linking to quality.contaminant_limit. Business justification: Each effluent parameter result is evaluated against a specific permit limit for compliance determination. permit_limit_value and permit_limit_type are denormalized from contaminant_limit. Linking to q' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ContaminantLimit .

ind:permitConditionId rdf:type rdf:Property ;
    rdfs:label 'Permit Condition Id' ;
    rdfs:comment 'Foreign key linking to compliance.permit_condition. Business justification: Effluent parameter results are measured against specific permit condition limits (numeric_limit, parameter_code in permit_condition). Linking results to the specific permit condition enables automated' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PermitCondition .

ind:analysisDate rdf:type rdf:Property ;
    rdfs:label 'Analysis Date' ;
    rdfs:comment 'Date when the laboratory analysis was performed on the sample.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:analysisMethod rdf:type rdf:Property ;
    rdfs:label 'Analysis Method' ;
    rdfs:comment 'EPA-approved analytical method used to measure the parameter (e.g., EPA 405.1 for BOD, EPA 160.2 for TSS, SM 4500-H+ for pH).' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataValidationStatus rdf:type rdf:Property ;
    rdfs:label 'Data Validation Status' ;
    rdfs:comment 'Internal validation status of the result data before regulatory submission (draft, validated by supervisor, approved for submission, or rejected).' ;
    rdfs:domain ind:EffluentParameterResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:detectionLimit rdf:type rdf:Property ;
    rdfs:label 'Detection Limit' ;
    rdfs:comment 'Minimum concentration that the analytical method can reliably detect for this parameter.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dmrSubmissionStatus rdf:type rdf:Property ;
    rdfs:label 'Dmr Submission Status' ;
    rdfs:comment 'Status of the DMR submission that includes this result (pending, submitted to EPA, accepted by EPA, or rejected).' ;
    rdfs:domain ind:EffluentParameterResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exceedancePercentage rdf:type rdf:Property ;
    rdfs:label 'Exceedance Percentage' ;
    rdfs:comment 'Percentage by which the measured value exceeds the permit limit, calculated as ((measured_value - permit_limit_value) / permit_limit_value) * 100. Null if result is in compliance.' ;
    rdfs:domain ind:EffluentParameterResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:flowRateMgd rdf:type rdf:Property ;
    rdfs:label 'Flow Rate Mgd' ;
    rdfs:comment 'Effluent discharge flow rate in million gallons per day at the time of sample collection, used for mass loading calculations.' ;
    rdfs:domain ind:EffluentParameterResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:laboratoryBatchNumber rdf:type rdf:Property ;
    rdfs:label 'Laboratory Batch Number' ;
    rdfs:comment 'Laboratory-assigned batch or run number for quality control and traceability purposes.' ;
    rdfs:domain ind:EffluentParameterResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:massLoadingLbsPerDay rdf:type rdf:Property ;
    rdfs:label 'Mass Loading Lbs Per Day' ;
    rdfs:comment 'Calculated mass loading of the parameter in pounds per day, derived from concentration and flow rate (concentration * flow * 8.34).' ;
    rdfs:domain ind:EffluentParameterResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:qualityControlFlag rdf:type rdf:Property ;
    rdfs:label 'Quality Control Flag' ;
    rdfs:comment 'Indicates the outcome of quality control checks (e.g., duplicate analysis, spike recovery, blank contamination) for this result.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:quantitationLimit rdf:type rdf:Property ;
    rdfs:label 'Quantitation Limit' ;
    rdfs:comment 'Minimum concentration that the analytical method can reliably quantify with acceptable precision and accuracy.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatoryAgency rdf:type rdf:Property ;
    rdfs:label 'Regulatory Agency' ;
    rdfs:comment 'Regulatory authority to which this result is reported (EPA or state primacy agency).' ;
    rdfs:domain ind:EffluentParameterResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resultQualifier rdf:type rdf:Property ;
    rdfs:label 'Result Qualifier' ;
    rdfs:comment 'Laboratory qualifier code indicating special conditions of the result (e.g., < for below detection limit, > for above quantitation limit, J for estimated value).' ;
    rdfs:domain ind:EffluentParameterResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sampleCollectionDate rdf:type rdf:Property ;
    rdfs:label 'Sample Collection Date' ;
    rdfs:comment 'Date when the effluent sample was collected from the discharge point.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sampleCollectionTime rdf:type rdf:Property ;
    rdfs:label 'Sample Collection Time' ;
    rdfs:comment 'Precise timestamp when the effluent sample was collected, including time zone.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:sampleType rdf:type rdf:Property ;
    rdfs:label 'Sample Type' ;
    rdfs:comment 'Method by which the effluent sample was collected (e.g., grab sample, 24-hour composite, flow-weighted composite, continuous monitoring).' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:validationDate rdf:type rdf:Property ;
    rdfs:label 'Validation Date' ;
    rdfs:comment 'Date when the result was validated and approved for regulatory reporting.' ;
    rdfs:domain ind:EffluentParameterResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:primarySsoAssetRegistryId rdf:type rdf:Property ;
    rdfs:label 'Primary Sso Asset Registry Id' ;
    rdfs:comment 'Foreign key reference to the infrastructure asset (pipe, pump station, lift station) associated with the overflow event.' ;
    rdfs:domain ind:SsoEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Registry .

ind:causeCategory rdf:type rdf:Property ;
    rdfs:label 'Cause Category' ;
    rdfs:comment 'Primary category of the root cause of the overflow event. [ENUM-REF-CANDIDATE: blockage|capacity_exceedance|equipment_failure|power_failure|operator_error|vandalism|inflow_infiltration|structural_failure|maintenance_activity|unknown — promote to reference product]' ;
    rdfs:domain ind:SsoEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:causeCode rdf:type rdf:Property ;
    rdfs:label 'Cause Code' ;
    rdfs:comment 'Detailed cause code identifying the specific reason for the overflow (e.g., grease blockage, root intrusion, pump failure, wet weather overload).' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:causeDescription rdf:type rdf:Property ;
    rdfs:label 'Cause Description' ;
    rdfs:comment 'Detailed narrative description of the cause and circumstances of the overflow event.' ;
    rdfs:domain ind:SsoEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:correctiveActionTaken rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Taken' ;
    rdfs:comment 'Description of immediate corrective actions taken to stop the overflow and mitigate environmental impact (e.g., cleared blockage, repaired pump, deployed vacuum truck).' ;
    rdfs:domain ind:SsoEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:discoveredBy rdf:type rdf:Property ;
    rdfs:label 'Discovered By' ;
    rdfs:comment 'Source or party that discovered and reported the overflow event.' ;
    rdfs:domain ind:SsoEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:discoveryTimestamp rdf:type rdf:Property ;
    rdfs:label 'Discovery Timestamp' ;
    rdfs:comment 'Date and time when the overflow event was first discovered or reported.' ;
    rdfs:domain ind:SsoEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:dmrReported rdf:type rdf:Property ;
    rdfs:label 'Dmr Reported' ;
    rdfs:comment 'Boolean flag indicating whether the overflow event was included in the monthly Discharge Monitoring Report (DMR) submitted under the NPDES permit.' ;
    rdfs:domain ind:SsoEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:durationMinutes rdf:type rdf:Property ;
    rdfs:label 'Duration Minutes' ;
    rdfs:comment 'Total duration of the overflow event in minutes, calculated from start to end timestamp.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:enforcementActionTaken rdf:type rdf:Property ;
    rdfs:label 'Enforcement Action Taken' ;
    rdfs:comment 'Type of enforcement action taken by regulatory agencies in response to the overflow event.' ;
    rdfs:domain ind:SsoEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedVolumeGallons rdf:type rdf:Property ;
    rdfs:label 'Estimated Volume Gallons' ;
    rdfs:comment 'Estimated volume of untreated or partially treated wastewater discharged during the SSO event, measured in gallons. Critical metric for regulatory reporting and environmental impact assessment.' ;
    rdfs:domain ind:SsoEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:eventEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Event End Timestamp' ;
    rdfs:comment 'Date and time when the sanitary sewer overflow event was stopped or contained.' ;
    rdfs:domain ind:SsoEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:eventNumber rdf:type rdf:Property ;
    rdfs:label 'Event Number' ;
    rdfs:comment 'Externally-known business identifier for the SSO event, typically formatted as SSO-YYYY-NNNNNN for regulatory reporting and tracking.' ;
    rdfs:domain ind:SsoEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Event Start Timestamp' ;
    rdfs:comment 'Date and time when the sanitary sewer overflow event began, representing the principal business event time for regulatory reporting.' ;
    rdfs:domain ind:SsoEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:eventStatus rdf:type rdf:Property ;
    rdfs:label 'Event Status' ;
    rdfs:comment 'Current lifecycle status of the SSO event in the incident management workflow.' ;
    rdfs:domain ind:SsoEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:overflowLocationType rdf:type rdf:Property ;
    rdfs:label 'Overflow Location Type' ;
    rdfs:comment 'Type of infrastructure asset where the overflow occurred.' ;
    rdfs:domain ind:SsoEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:penaltyAmount rdf:type rdf:Property ;
    rdfs:label 'Penalty Amount' ;
    rdfs:comment 'Monetary penalty assessed by regulatory agencies for the overflow event, in US dollars.' ;
    rdfs:domain ind:SsoEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:preventiveActionPlanned rdf:type rdf:Property ;
    rdfs:label 'Preventive Action Planned' ;
    rdfs:comment 'Description of long-term preventive measures planned to prevent recurrence (e.g., pipe replacement, capacity upgrade, enhanced maintenance).' ;
    rdfs:domain ind:SsoEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:publicNotificationRequired rdf:type rdf:Property ;
    rdfs:label 'Public Notification Required' ;
    rdfs:comment 'Boolean flag indicating whether public notification (posting, media alert, direct contact) is required based on overflow volume, location, or receiving environment.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:publicNotificationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Public Notification Timestamp' ;
    rdfs:comment 'Date and time when public notification was issued regarding the overflow event.' ;
    rdfs:domain ind:SsoEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:reachedSurfaceWater rdf:type rdf:Property ;
    rdfs:label 'Reached Surface Water' ;
    rdfs:comment 'Boolean flag indicating whether the overflow reached a surface water body, triggering enhanced regulatory reporting requirements.' ;
    rdfs:domain ind:SsoEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:receivingEnvironment rdf:type rdf:Property ;
    rdfs:label 'Receiving Environment' ;
    rdfs:comment 'Type of environment that received the discharged wastewater: surface water body, storm drainage system, land surface, building interior, or other.' ;
    rdfs:domain ind:SsoEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryNotificationRequired rdf:type rdf:Property ;
    rdfs:label 'Regulatory Notification Required' ;
    rdfs:comment 'Boolean flag indicating whether the overflow event meets thresholds requiring notification to state or federal regulatory agencies.' ;
    rdfs:domain ind:SsoEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryNotificationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Regulatory Notification Timestamp' ;
    rdfs:comment 'Date and time when the overflow event was reported to the regulatory agency (EPA, state primacy agency), typically required within 24 hours.' ;
    rdfs:domain ind:Wastewater ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:responseTimestamp rdf:type rdf:Property ;
    rdfs:label 'Response Timestamp' ;
    rdfs:comment 'Date and time when utility personnel arrived on-site to respond to the overflow event.' ;
    rdfs:domain ind:Wastewater ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:responsibleParty rdf:type rdf:Property ;
    rdfs:label 'Responsible Party' ;
    rdfs:comment 'Name or identifier of the utility staff member or contractor responsible for managing the response to the overflow event.' ;
    rdfs:domain ind:SsoEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:volumeEstimationMethod rdf:type rdf:Property ;
    rdfs:label 'Volume Estimation Method' ;
    rdfs:comment 'Method used to determine the spill volume: measured (flow meter), calculated (hydraulic model), or estimated (visual observation).' ;
    rdfs:domain ind:SsoEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:volumeRecoveredGallons rdf:type rdf:Property ;
    rdfs:label 'Volume Recovered Gallons' ;
    rdfs:comment 'Volume of spilled wastewater that was recovered and returned to the collection system or treatment plant, measured in gallons.' ;
    rdfs:domain ind:SsoEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:weatherRelated rdf:type rdf:Property ;
    rdfs:label 'Weather Related' ;
    rdfs:comment 'Boolean flag indicating whether the overflow was caused or exacerbated by wet weather conditions, inflow, or infiltration (I&I).' ;
    rdfs:domain ind:SsoEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dischargeMeteringMeteringMeterId rdf:type rdf:Property ;
    rdfs:label 'Discharge Metering Metering Meter Id' ;
    rdfs:comment 'Foreign key linking to metering.metering_meter. Business justification: Industrial pretreatment permits require discharge volume monitoring for compliance and flow-based surcharge calculations. Utilities install dedicated wastewater discharge meters at industrial faciliti' ;
    rdfs:domain ind:IndustrialUserPermit ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Meter .

ind:facilityLocationId rdf:type rdf:Property ;
    rdfs:label 'Facility Location Id' ;
    rdfs:comment 'Foreign key linking to asset.asset_location. Business justification: Industrial user permits are tied to specific facility locations for inspection scheduling, compliance tracking, and enforcement actions. Asset location integration enables spatial analysis of pretreat' ;
    rdfs:domain ind:IndustrialUserPermit ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Location .

ind:bodLimitMgPerL rdf:type rdf:Property ;
    rdfs:label 'Bod Limit Mg Per L' ;
    rdfs:comment 'Maximum permitted concentration of BOD in milligrams per liter that the industrial user may discharge to the wastewater collection system.' ;
    rdfs:domain ind:IndustrialUserPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cadmiumLimitMgPerL rdf:type rdf:Property ;
    rdfs:label 'Cadmium Limit Mg Per L' ;
    rdfs:comment 'Maximum permitted concentration of cadmium in milligrams per liter. Heavy metal limit for metal finishing and plating industries.' ;
    rdfs:domain ind:IndustrialUserPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:categoricalStandardApplicable rdf:type rdf:Property ;
    rdfs:label 'Categorical Standard Applicable' ;
    rdfs:comment 'Indicates whether federal categorical pretreatment standards apply to this industrial user based on SIC code and discharge characteristics.' ;
    rdfs:domain ind:IndustrialUserPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:categoricalStandardCitation rdf:type rdf:Property ;
    rdfs:label 'Categorical Standard Citation' ;
    rdfs:comment 'Specific CFR citation for the applicable categorical pretreatment standard (e.g., 40 CFR Part 433 for Metal Finishing). Null if non-categorical.' ;
    rdfs:domain ind:IndustrialUserPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:chromiumLimitMgPerL rdf:type rdf:Property ;
    rdfs:label 'Chromium Limit Mg Per L' ;
    rdfs:comment 'Maximum permitted concentration of total chromium in milligrams per liter. Heavy metal limit for metal finishing and plating industries.' ;
    rdfs:domain ind:IndustrialUserPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:codLimitMgPerL rdf:type rdf:Property ;
    rdfs:label 'Cod Limit Mg Per L' ;
    rdfs:comment 'Maximum permitted concentration of COD in milligrams per liter that the industrial user may discharge to the wastewater collection system.' ;
    rdfs:domain ind:IndustrialUserPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:complianceScheduleFinalDate rdf:type rdf:Property ;
    rdfs:label 'Compliance Schedule Final Date' ;
    rdfs:comment 'Final date by which the industrial user must achieve full compliance with all permit discharge limits. Null if no compliance schedule is required.' ;
    rdfs:domain ind:IndustrialUserPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:complianceScheduleRequired rdf:type rdf:Property ;
    rdfs:label 'Compliance Schedule Required' ;
    rdfs:comment 'Indicates whether the permit includes a compliance schedule with milestones for achieving full compliance with discharge limits.' ;
    rdfs:domain ind:IndustrialUserPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:copperLimitMgPerL rdf:type rdf:Property ;
    rdfs:label 'Copper Limit Mg Per L' ;
    rdfs:comment 'Maximum permitted concentration of copper in milligrams per liter. Heavy metal limit for metal finishing and plating industries.' ;
    rdfs:domain ind:IndustrialUserPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:flowLimitGpd rdf:type rdf:Property ;
    rdfs:label 'Flow Limit Gpd' ;
    rdfs:comment 'Maximum permitted daily discharge flow rate in gallons per day (GPD) that the industrial user may discharge to the wastewater collection system.' ;
    rdfs:domain ind:IndustrialUserPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fogLimitMgPerL rdf:type rdf:Property ;
    rdfs:label 'Fog Limit Mg Per L' ;
    rdfs:comment 'Maximum permitted concentration of FOG in milligrams per liter that the industrial user may discharge. Critical for food service and processing facilities.' ;
    rdfs:domain ind:IndustrialUserPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:inspectionFrequency rdf:type rdf:Property ;
    rdfs:label 'Inspection Frequency' ;
    rdfs:comment 'Required frequency at which the pretreatment authority will conduct on-site inspections of the industrial facility and pretreatment system.' ;
    rdfs:domain ind:IndustrialUserPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:issuanceDate rdf:type rdf:Property ;
    rdfs:label 'Issuance Date' ;
    rdfs:comment 'Date on which the permit was officially issued by the pretreatment authority.' ;
    rdfs:domain ind:IndustrialUserPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:leadLimitMgPerL rdf:type rdf:Property ;
    rdfs:label 'Lead Limit Mg Per L' ;
    rdfs:comment 'Maximum permitted concentration of lead in milligrams per liter. Heavy metal limit for metal finishing and plating industries.' ;
    rdfs:domain ind:IndustrialUserPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mercuryLimitMgPerL rdf:type rdf:Property ;
    rdfs:label 'Mercury Limit Mg Per L' ;
    rdfs:comment 'Maximum permitted concentration of mercury in milligrams per liter. Heavy metal limit for dental and medical facilities.' ;
    rdfs:domain ind:IndustrialUserPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nickelLimitMgPerL rdf:type rdf:Property ;
    rdfs:label 'Nickel Limit Mg Per L' ;
    rdfs:comment 'Maximum permitted concentration of nickel in milligrams per liter. Heavy metal limit for metal finishing and plating industries.' ;
    rdfs:domain ind:IndustrialUserPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:phMaximum rdf:type rdf:Property ;
    rdfs:label 'Ph Maximum' ;
    rdfs:comment 'Maximum permitted pH level for industrial discharge. Typically 9.0 to 12.5 per local limits.' ;
    rdfs:domain ind:IndustrialUserPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:phMinimum rdf:type rdf:Property ;
    rdfs:label 'Ph Minimum' ;
    rdfs:comment 'Minimum permitted pH level for industrial discharge. Typically 5.0 to 6.0 per local limits.' ;
    rdfs:domain ind:IndustrialUserPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pretreatmentRequired rdf:type rdf:Property ;
    rdfs:label 'Pretreatment Required' ;
    rdfs:comment 'Indicates whether the industrial user is required to install and operate an on-site pretreatment system to meet discharge limits.' ;
    rdfs:domain ind:IndustrialUserPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pretreatmentSystemDescription rdf:type rdf:Property ;
    rdfs:label 'Pretreatment System Description' ;
    rdfs:comment 'Description of the on-site pretreatment system installed by the industrial user (e.g., oil-water separator, pH neutralization, metals precipitation). Null if no pretreatment is required.' ;
    rdfs:domain ind:IndustrialUserPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:silverLimitMgPerL rdf:type rdf:Property ;
    rdfs:label 'Silver Limit Mg Per L' ;
    rdfs:comment 'Maximum permitted concentration of silver in milligrams per liter. Heavy metal limit for photographic and metal finishing industries.' ;
    rdfs:domain ind:IndustrialUserPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalNitrogenLimitMgPerL rdf:type rdf:Property ;
    rdfs:label 'Total Nitrogen Limit Mg Per L' ;
    rdfs:comment 'Maximum permitted concentration of total nitrogen in milligrams per liter that the industrial user may discharge.' ;
    rdfs:domain ind:IndustrialUserPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalPhosphorusLimitMgPerL rdf:type rdf:Property ;
    rdfs:label 'Total Phosphorus Limit Mg Per L' ;
    rdfs:comment 'Maximum permitted concentration of total phosphorus in milligrams per liter that the industrial user may discharge.' ;
    rdfs:domain ind:IndustrialUserPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tssLimitMgPerL rdf:type rdf:Property ;
    rdfs:label 'Tss Limit Mg Per L' ;
    rdfs:comment 'Maximum permitted concentration of TSS in milligrams per liter that the industrial user may discharge to the wastewater collection system.' ;
    rdfs:domain ind:IndustrialUserPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:zincLimitMgPerL rdf:type rdf:Property ;
    rdfs:label 'Zinc Limit Mg Per L' ;
    rdfs:comment 'Maximum permitted concentration of zinc in milligrams per liter. Heavy metal limit for metal finishing and plating industries.' ;
    rdfs:domain ind:IndustrialUserPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sewerInspectionId rdf:type rdf:Property ;
    rdfs:label 'Sewer Inspection Id' ;
    rdfs:comment 'Unique identifier for each sewer inspection event. Primary key for the sewer inspection data product.' ;
    rdfs:domain ind:SewerInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:inspectionEventId rdf:type rdf:Property ;
    rdfs:label 'Inspection Event Id' ;
    rdfs:comment 'Foreign key linking to asset.inspection_event. Business justification: Sewer CCTV and PACP inspections should be linked to the unified asset inspection event record for cross-asset inspection program scheduling, regulatory compliance reporting, and inspection history con' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:InspectionEvent .

ind:assetIdentifier rdf:type rdf:Property ;
    rdfs:label 'Asset Identifier' ;
    rdfs:comment 'Business-facing identifier or tag of the specific asset inspected (pipe segment number, manhole number, etc.), used for field reference and reporting.' ;
    rdfs:domain ind:SewerInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assetType rdf:type rdf:Property ;
    rdfs:label 'Asset Type' ;
    rdfs:comment 'The type of sewer infrastructure asset being inspected, distinguishing between pipes, manholes, and other components.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contractorName rdf:type rdf:Property ;
    rdfs:label 'Contractor Name' ;
    rdfs:comment 'Name of the third-party contractor or vendor who performed the inspection, if the work was outsourced.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:criticalDefectFlag rdf:type rdf:Property ;
    rdfs:label 'Critical Defect Flag' ;
    rdfs:comment 'Boolean indicator of whether any critical or high-severity defects were identified that require immediate attention or emergency repair.' ;
    rdfs:domain ind:SewerInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:defectCodes rdf:type rdf:Property ;
    rdfs:label 'Defect Codes' ;
    rdfs:comment 'Comma-separated list of NASSCO defect codes identified during the inspection (e.g., CL for crack longitudinal, RB for roots, DP for deformed pipe), used for detailed condition analysis.' ;
    rdfs:domain ind:SewerInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:defectCount rdf:type rdf:Property ;
    rdfs:label 'Defect Count' ;
    rdfs:comment 'Total number of discrete defects identified during the inspection, used as a quick indicator of asset condition complexity.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:downstreamManholeNumber rdf:type rdf:Property ;
    rdfs:label 'Downstream Manhole Number' ;
    rdfs:comment 'Identifier of the downstream manhole for pipe segment inspections, establishing the ending point of the inspection run.' ;
    rdfs:domain ind:SewerInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedRepairCostUsd rdf:type rdf:Property ;
    rdfs:label 'Estimated Repair Cost Usd' ;
    rdfs:comment 'Preliminary cost estimate in US dollars for the recommended repair or rehabilitation action, used for capital planning and budget forecasting.' ;
    rdfs:domain ind:SewerInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:flowCondition rdf:type rdf:Property ;
    rdfs:label 'Flow Condition' ;
    rdfs:comment 'Flow level observed in the pipe during inspection, impacting visibility and the ability to assess certain defects.' ;
    rdfs:domain ind:SewerInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fogAccumulationFlag rdf:type rdf:Property ;
    rdfs:label 'Fog Accumulation Flag' ;
    rdfs:comment 'Boolean indicator of whether FOG buildup was observed, requiring cleaning and potentially indicating FOG program enforcement needs.' ;
    rdfs:domain ind:SewerInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:infiltrationObservedFlag rdf:type rdf:Property ;
    rdfs:label 'Infiltration Observed Flag' ;
    rdfs:comment 'Boolean indicator of whether infiltration or inflow was observed during the inspection, contributing to non-revenue water and treatment plant overload.' ;
    rdfs:domain ind:SewerInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:inspectionDate rdf:type rdf:Property ;
    rdfs:label 'Inspection Date' ;
    rdfs:comment 'The date on which the sewer inspection was performed. Principal business event timestamp for this transaction.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:inspectionDirection rdf:type rdf:Property ;
    rdfs:label 'Inspection Direction' ;
    rdfs:comment 'Direction of travel during the inspection relative to flow direction, relevant for CCTV and sonar inspections of pipe segments.' ;
    rdfs:domain ind:SewerInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectionLengthFeet rdf:type rdf:Property ;
    rdfs:label 'Inspection Length Feet' ;
    rdfs:comment 'Total length of pipe segment inspected, measured in feet, used to calculate condition per linear foot and prioritize rehabilitation.' ;
    rdfs:domain ind:SewerInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:inspectionMethod rdf:type rdf:Property ;
    rdfs:label 'Inspection Method' ;
    rdfs:comment 'The technology or technique used to perform the inspection. CCTV is the most common method for pipe condition assessment.' ;
    rdfs:domain ind:SewerInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectionNumber rdf:type rdf:Property ;
    rdfs:label 'Inspection Number' ;
    rdfs:comment 'Business-facing unique identifier or work order number assigned to this inspection event for tracking and reference purposes.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectionTime rdf:type rdf:Property ;
    rdfs:label 'Inspection Time' ;
    rdfs:comment 'Precise timestamp when the inspection commenced, including time of day for scheduling and operational tracking.' ;
    rdfs:domain ind:SewerInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:inspectionType rdf:type rdf:Property ;
    rdfs:label 'Inspection Type' ;
    rdfs:comment 'Classification of the inspection purpose or trigger, distinguishing between scheduled maintenance, reactive response, and compliance-driven inspections.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectorCertificationNumber rdf:type rdf:Property ;
    rdfs:label 'Inspector Certification Number' ;
    rdfs:comment 'Professional certification number of the inspector, typically NASSCO PACP or MACP certification, ensuring qualified personnel perform assessments.' ;
    rdfs:domain ind:SewerInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectorName rdf:type rdf:Property ;
    rdfs:label 'Inspector Name' ;
    rdfs:comment 'Name of the individual technician or engineer who performed the inspection, for accountability and quality assurance.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:operationalDefectFlag rdf:type rdf:Property ;
    rdfs:label 'Operational Defect Flag' ;
    rdfs:comment 'Boolean indicator of whether operational defects (roots, grease, debris, infiltration, exfiltration) were observed, impacting flow capacity.' ;
    rdfs:domain ind:SewerInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pacpScore rdf:type rdf:Property ;
    rdfs:label 'Pacp Score' ;
    rdfs:comment 'Numeric PACP score calculated from defect observations, representing the overall structural and operational condition of the pipe segment.' ;
    rdfs:domain ind:SewerInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:recommendedAction rdf:type rdf:Property ;
    rdfs:label 'Recommended Action' ;
    rdfs:comment 'Recommended maintenance or capital action based on inspection findings, guiding asset management and CIP prioritization decisions.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rehabilitationMethod rdf:type rdf:Property ;
    rdfs:label 'Rehabilitation Method' ;
    rdfs:comment 'Specific rehabilitation technique recommended if repair or renewal is needed (e.g., CIPP lining, pipe bursting, open-cut replacement, spot repair, manhole lining).' ;
    rdfs:domain ind:SewerInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportFilePath rdf:type rdf:Property ;
    rdfs:label 'Report File Path' ;
    rdfs:comment 'File system path or URL to the formal inspection report document, typically in PDF format, for regulatory and asset management records.' ;
    rdfs:domain ind:SewerInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewDate rdf:type rdf:Property ;
    rdfs:label 'Review Date' ;
    rdfs:comment 'Date on which the inspection report was reviewed and approved by qualified personnel, completing the quality assurance process.' ;
    rdfs:domain ind:SewerInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reviewedBy rdf:type rdf:Property ;
    rdfs:label 'Reviewed By' ;
    rdfs:comment 'Name of the engineer or supervisor who reviewed and validated the inspection findings, ensuring quality control and technical accuracy.' ;
    rdfs:domain ind:SewerInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:structuralDefectFlag rdf:type rdf:Property ;
    rdfs:label 'Structural Defect Flag' ;
    rdfs:comment 'Boolean indicator of whether structural defects (cracks, fractures, collapse, deformation) were observed, impacting asset integrity.' ;
    rdfs:domain ind:SewerInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:upstreamManholeNumber rdf:type rdf:Property ;
    rdfs:label 'Upstream Manhole Number' ;
    rdfs:comment 'Identifier of the upstream manhole for pipe segment inspections, establishing the starting point of the inspection run.' ;
    rdfs:domain ind:SewerInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:urgencyClassification rdf:type rdf:Property ;
    rdfs:label 'Urgency Classification' ;
    rdfs:comment 'Priority level assigned to the recommended action, used to sequence capital projects and maintenance work in the CIP and O&M budgets.' ;
    rdfs:domain ind:SewerInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:videoFilePath rdf:type rdf:Property ;
    rdfs:label 'Video File Path' ;
    rdfs:comment 'File system path or URL to the recorded CCTV or sonar video file, enabling review and validation of inspection findings.' ;
    rdfs:domain ind:SewerInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:blockageCause rdf:type rdf:Property ;
    rdfs:label 'Blockage Cause' ;
    rdfs:comment 'Primary cause of the blockage event. FOG = Fats, Oils, and Grease; I&I = Inflow and Infiltration. [ENUM-REF-CANDIDATE: FOG|roots|debris|structural_collapse|grease_buildup|foreign_object|sediment|pipe_defect|I&I|unknown — 10 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:CollectionSystemBlockage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:blockageNumber rdf:type rdf:Property ;
    rdfs:label 'Blockage Number' ;
    rdfs:comment 'Externally-known unique identifier or ticket number assigned to this blockage event for tracking and reporting purposes.' ;
    rdfs:domain ind:CollectionSystemBlockage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:blockageSeverity rdf:type rdf:Property ;
    rdfs:label 'Blockage Severity' ;
    rdfs:comment 'Severity classification of the blockage based on impact to service and risk of overflow.' ;
    rdfs:domain ind:CollectionSystemBlockage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:blockageType rdf:type rdf:Property ;
    rdfs:label 'Blockage Type' ;
    rdfs:comment 'Indicates whether the blockage was partial (reduced flow) or complete (no flow).' ;
    rdfs:domain ind:CollectionSystemBlockage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clearanceMethod rdf:type rdf:Property ;
    rdfs:label 'Clearance Method' ;
    rdfs:comment 'Method or technique used by the crew to clear the blockage and restore flow.' ;
    rdfs:domain ind:CollectionSystemBlockage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clearanceTimeMinutes rdf:type rdf:Property ;
    rdfs:label 'Clearance Time Minutes' ;
    rdfs:comment 'Elapsed time in minutes from crew arrival to successful clearance of the blockage.' ;
    rdfs:domain ind:CollectionSystemBlockage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:clearanceTimestamp rdf:type rdf:Property ;
    rdfs:label 'Clearance Timestamp' ;
    rdfs:comment 'Date and time when the blockage was successfully cleared and flow was restored.' ;
    rdfs:domain ind:CollectionSystemBlockage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:customerComplaintCount rdf:type rdf:Property ;
    rdfs:label 'Customer Complaint Count' ;
    rdfs:comment 'Number of customer complaints received related to this blockage event.' ;
    rdfs:domain ind:CollectionSystemBlockage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:customerImpactFlag rdf:type rdf:Property ;
    rdfs:label 'Customer Impact Flag' ;
    rdfs:comment 'Indicates whether the blockage event impacted customer service (e.g., backup into property, service disruption).' ;
    rdfs:domain ind:CollectionSystemBlockage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:environmentalImpactFlag rdf:type rdf:Property ;
    rdfs:label 'Environmental Impact Flag' ;
    rdfs:comment 'Indicates whether the blockage event resulted in environmental impact requiring regulatory notification.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:estimatedCostUsd rdf:type rdf:Property ;
    rdfs:label 'Estimated Cost Usd' ;
    rdfs:comment 'Estimated total cost in US dollars to respond to and clear the blockage including labor, equipment, and materials.' ;
    rdfs:domain ind:CollectionSystemBlockage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:eventTimestamp rdf:type rdf:Property ;
    rdfs:label 'Event Timestamp' ;
    rdfs:comment 'Date and time when the blockage or stoppage event was first detected or reported.' ;
    rdfs:domain ind:CollectionSystemBlockage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:preventiveMaintenanceRecommendation rdf:type rdf:Property ;
    rdfs:label 'Preventive Maintenance Recommendation' ;
    rdfs:comment 'Recommended preventive maintenance actions to reduce future blockage risk at this location (e.g., scheduled cleaning, root treatment, pipe rehabilitation).' ;
    rdfs:domain ind:CollectionSystemBlockage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:previousBlockageCount rdf:type rdf:Property ;
    rdfs:label 'Previous Blockage Count' ;
    rdfs:comment 'Number of previous blockage events recorded at this location within the past 12 months.' ;
    rdfs:domain ind:CollectionSystemBlockage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:regulatoryNotificationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Notification Required Flag' ;
    rdfs:comment 'Indicates whether regulatory notification to EPA or state agency was required for this blockage event.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:repeatBlockageFlag rdf:type rdf:Property ;
    rdfs:label 'Repeat Blockage Flag' ;
    rdfs:comment 'Indicates whether this location has experienced previous blockage events within a defined time period.' ;
    rdfs:domain ind:CollectionSystemBlockage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:responseTimeMinutes rdf:type rdf:Property ;
    rdfs:label 'Response Time Minutes' ;
    rdfs:comment 'Elapsed time in minutes from when the blockage was reported to when the crew arrived on site.' ;
    rdfs:domain ind:CollectionSystemBlockage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rootCauseAnalysisCompletedFlag rdf:type rdf:Property ;
    rdfs:label 'Root Cause Analysis Completed Flag' ;
    rdfs:comment 'Indicates whether a formal root cause analysis was completed for this blockage event.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ssoLocationDescription rdf:type rdf:Property ;
    rdfs:label 'Sso Location Description' ;
    rdfs:comment 'Description of the location where the SSO occurred (e.g., street, property, receiving water body).' ;
    rdfs:domain ind:CollectionSystemBlockage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ssoOccurredFlag rdf:type rdf:Property ;
    rdfs:label 'Sso Occurred Flag' ;
    rdfs:comment 'Indicates whether a Sanitary Sewer Overflow occurred as a result of this blockage event.' ;
    rdfs:domain ind:CollectionSystemBlockage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ssoVolumeGallons rdf:type rdf:Property ;
    rdfs:label 'Sso Volume Gallons' ;
    rdfs:comment 'Estimated volume of wastewater overflow in gallons if an SSO occurred due to the blockage.' ;
    rdfs:domain ind:CollectionSystemBlockage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Total Duration Minutes' ;
    rdfs:comment 'Total elapsed time in minutes from blockage detection to clearance completion.' ;
    rdfs:domain ind:CollectionSystemBlockage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:meterInstallationId rdf:type rdf:Property ;
    rdfs:label 'Meter Installation Id' ;
    rdfs:comment 'Foreign key linking to metering.installation. Business justification: Sewer charges are calculated from water consumption measured at the specific meter installation paired to the service connection. Billing reconciliation, sewer rate adjustments, and field crew coordin' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Installation .

ind:abandonmentDate rdf:type rdf:Property ;
    rdfs:label 'Abandonment Date' ;
    rdfs:comment 'Date when the service connection was permanently abandoned and removed from active service. Abandoned connections are typically capped or filled.' ;
    rdfs:domain ind:SewerServiceConnection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:activationDate rdf:type rdf:Property ;
    rdfs:label 'Activation Date' ;
    rdfs:comment 'Date when the service connection was activated and began receiving wastewater service. May differ from installation date if there was a delay between construction and service commencement.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:backwaterValveInstalledFlag rdf:type rdf:Property ;
    rdfs:label 'Backwater Valve Installed Flag' ;
    rdfs:comment 'Indicates whether a backwater valve (backflow preventer) is installed on the service lateral to prevent sewage backup into the premise during system surcharge events.' ;
    rdfs:domain ind:SewerServiceConnection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cleanoutAvailableFlag rdf:type rdf:Property ;
    rdfs:label 'Cleanout Available Flag' ;
    rdfs:comment 'Indicates whether a cleanout access point is available on the service lateral for maintenance and inspection purposes. Cleanouts facilitate camera inspection and clearing blockages.' ;
    rdfs:domain ind:SewerServiceConnection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:conditionRating rdf:type rdf:Property ;
    rdfs:label 'Condition Rating' ;
    rdfs:comment 'Current physical condition assessment of the service lateral based on inspection findings, age, material, and maintenance history. Ratings guide rehabilitation and replacement prioritization.' ;
    rdfs:domain ind:SewerServiceConnection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:connectionType rdf:type rdf:Property ;
    rdfs:label 'Connection Type' ;
    rdfs:comment 'Type of sewer service connection based on conveyance method. Gravity connections rely on slope; grinder pump and ejector pump connections serve properties below the sewer main elevation; low-pressure and vacuum systems are specialized collection methods.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deactivationDate rdf:type rdf:Property ;
    rdfs:label 'Deactivation Date' ;
    rdfs:comment 'Date when the service connection was deactivated or taken out of service, either temporarily or permanently.' ;
    rdfs:domain ind:SewerServiceConnection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:grinderPumpInstallationDate rdf:type rdf:Property ;
    rdfs:label 'Grinder Pump Installation Date' ;
    rdfs:comment 'Date when the grinder pump was installed at this service connection. Used for warranty tracking and lifecycle management.' ;
    rdfs:domain ind:SewerServiceConnection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:grinderPumpManufacturer rdf:type rdf:Property ;
    rdfs:label 'Grinder Pump Manufacturer' ;
    rdfs:comment 'Manufacturer name of the grinder pump installed at this service connection, if applicable.' ;
    rdfs:domain ind:SewerServiceConnection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grinderPumpModel rdf:type rdf:Property ;
    rdfs:label 'Grinder Pump Model' ;
    rdfs:comment 'Model number or designation of the grinder pump installed at this service connection, if applicable.' ;
    rdfs:domain ind:SewerServiceConnection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grinderPumpSerialNumber rdf:type rdf:Property ;
    rdfs:label 'Grinder Pump Serial Number' ;
    rdfs:comment 'Manufacturer serial number of the grinder pump installed at this service connection, if applicable. Used for warranty tracking, maintenance scheduling, and parts ordering.' ;
    rdfs:domain ind:SewerServiceConnection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lateralDiameterInches rdf:type rdf:Property ;
    rdfs:label 'Lateral Diameter Inches' ;
    rdfs:comment 'Internal diameter of the service lateral pipe measured in inches. Typical residential laterals range from 4 to 6 inches; commercial and industrial connections may be larger.' ;
    rdfs:domain ind:SewerServiceConnection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lateralLengthFeet rdf:type rdf:Property ;
    rdfs:label 'Lateral Length Feet' ;
    rdfs:comment 'Total length of the service lateral pipe from the premise connection point to the public sewer main, measured in feet. Used for capacity analysis, maintenance planning, and replacement cost estimation.' ;
    rdfs:domain ind:SewerServiceConnection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lateralPipeMaterial rdf:type rdf:Property ;
    rdfs:label 'Lateral Pipe Material' ;
    rdfs:comment 'Material composition of the service lateral pipe. Common materials include PVC (polyvinyl chloride), vitrified clay, cast iron, ductile iron, concrete, Orangeburg (bituminized fiber), ABS (acrylonitrile butadiene styrene), and HDPE (high-density polyethylene). Material affects durability, corrosion resistance, and maintenance needs. [ENUM-REF-CANDIDATE: pvc|vitrified_clay|cast_iron|ductile_iron|concrete|orangeburg|abs|hdpe — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:SewerServiceConnection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:parcelIdentifier rdf:type rdf:Property ;
    rdfs:label 'Parcel Identifier' ;
    rdfs:comment 'Tax parcel number or assessor parcel number (APN) for the property served by this connection. Used for cross-referencing with municipal tax and GIS records.' ;
    rdfs:domain ind:SewerServiceConnection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceAddressLine1 rdf:type rdf:Property ;
    rdfs:label 'Service Address Line1' ;
    rdfs:comment 'Primary street address line of the premise served by this sewer connection. Organizational contact data classified as confidential.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceAddressLine2 rdf:type rdf:Property ;
    rdfs:label 'Service Address Line2' ;
    rdfs:comment 'Secondary address line (apartment, suite, unit number) for the premise served by this sewer connection. Organizational contact data classified as confidential.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceCity rdf:type rdf:Property ;
    rdfs:label 'Service City' ;
    rdfs:comment 'City or municipality where the served premise is located. Organizational contact data classified as confidential.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceConnectionNumber rdf:type rdf:Property ;
    rdfs:label 'Service Connection Number' ;
    rdfs:comment 'Business identifier for the sewer service connection, typically used in field operations, customer service, and billing. May follow utility-specific numbering conventions.' ;
    rdfs:domain ind:SewerServiceConnection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:servicePostalCode rdf:type rdf:Property ;
    rdfs:label 'Service Postal Code' ;
    rdfs:comment 'Postal or ZIP code for the service address. Organizational contact data classified as confidential.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceStateProvince rdf:type rdf:Property ;
    rdfs:label 'Service State Province' ;
    rdfs:comment 'State or province code for the service address location.' ;
    rdfs:domain ind:SewerServiceConnection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceStatus rdf:type rdf:Property ;
    rdfs:label 'Service Status' ;
    rdfs:comment 'Current operational status of the sewer service connection. Active connections are in use; inactive connections are temporarily out of service; abandoned connections are permanently closed; capped connections are physically sealed; pending activation connections are installed but not yet in service.' ;
    rdfs:domain ind:SewerServiceConnection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:meterSizeTypeId rdf:type rdf:Property ;
    rdfs:label 'Meter Size Type Id' ;
    rdfs:comment 'Foreign key linking to metering.meter_size_type. Business justification: Meter size and type combinations are standardized configurations defined in the meter_size_type reference table. The metering_meter table currently stores meter_size_inches and meter_type as denormali' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MeterSizeType .

ind:installationId rdf:type rdf:Property ;
    rdfs:label 'Installation Id' ;
    rdfs:comment 'Primary key for installation' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Installation .

ind:connectionApplicationId rdf:type rdf:Property ;
    rdfs:label 'Connection Application Id' ;
    rdfs:comment 'Foreign key linking to service.connection_application. Business justification: A meter installation is the direct physical fulfillment of an approved connection application. New service fulfillment tracking and regulatory audit trails require a direct link from the resulting ins' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ConnectionApplication .

ind:readRouteId rdf:type rdf:Property ;
    rdfs:label 'Read Route Id' ;
    rdfs:comment 'Foreign key linking to metering.read_route. Business justification: A read_route organizes meter installations for scheduled AMR drive-by, walk-by, or manual reading operations. While individual read records already capture read_route_id (the route used for a specific' ;
    rdfs:domain ind:Metering ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ReadRoute .

ind:batteryExpectedLifeYears rdf:type rdf:Property ;
    rdfs:label 'Battery Expected Life Years' ;
    rdfs:comment 'Manufacturer-specified expected battery life in years under normal operating conditions. Typically 15-20 years for AMI endpoints.' ;
    rdfs:domain ind:AmiEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:batteryInstallDate rdf:type rdf:Property ;
    rdfs:label 'Battery Install Date' ;
    rdfs:comment 'Date when the battery was installed or last replaced in the endpoint device. Used to calculate expected battery life remaining.' ;
    rdfs:domain ind:AmiEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:batteryLevelPercent rdf:type rdf:Property ;
    rdfs:label 'Battery Level Percent' ;
    rdfs:comment 'Current battery charge level as a percentage. Critical for battery-powered endpoints to schedule replacement before failure.' ;
    rdfs:domain ind:AmiEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:communicationFrequencyMinutes rdf:type rdf:Property ;
    rdfs:label 'Communication Frequency Minutes' ;
    rdfs:comment 'Configured interval in minutes between endpoint transmissions. Typical values: 15, 30, 60 minutes for hourly reads; 1440 for daily reads.' ;
    rdfs:domain ind:AmiEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:communicationProtocol rdf:type rdf:Property ;
    rdfs:label 'Communication Protocol' ;
    rdfs:comment 'Network communication protocol used by the endpoint. RF (Radio Frequency) for FlexNet, Cellular for 4G/5G, LoRaWAN for low-power wide-area, NB-IoT for narrowband cellular.' ;
    rdfs:domain ind:AmiEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataRetentionDays rdf:type rdf:Property ;
    rdfs:label 'Data Retention Days' ;
    rdfs:comment 'Number of days of interval consumption data stored locally on the endpoint device before being overwritten. Typically 35-45 days.' ;
    rdfs:domain ind:AmiEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:decommissionReason rdf:type rdf:Property ;
    rdfs:label 'Decommission Reason' ;
    rdfs:comment 'Reason for endpoint decommissioning (e.g., meter replacement, device failure, service disconnection, upgrade to new technology).' ;
    rdfs:domain ind:AmiEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:encryptionAlgorithm rdf:type rdf:Property ;
    rdfs:label 'Encryption Algorithm' ;
    rdfs:comment 'Cryptographic algorithm used to secure communications between endpoint and collector. AES-128 or AES-256 for encrypted devices.' ;
    rdfs:domain ind:AmiEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:encryptionKeyVersion rdf:type rdf:Property ;
    rdfs:label 'Encryption Key Version' ;
    rdfs:comment 'Version identifier for the encryption key currently provisioned on the endpoint. Used for secure communication and key rotation management.' ;
    rdfs:domain ind:AmiEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:endpointSerialNumber rdf:type rdf:Property ;
    rdfs:label 'Endpoint Serial Number' ;
    rdfs:comment 'Manufacturer-assigned unique serial number for the AMI/AMR endpoint device. Used for warranty tracking and device identification.' ;
    rdfs:domain ind:AmiEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:endpointType rdf:type rdf:Property ;
    rdfs:label 'Endpoint Type' ;
    rdfs:comment 'Type of AMI/AMR communication device. ERT (Encoder Receiver Transmitter) for drive-by reading, MXU (Meter Transmit Unit) for fixed network, iPerl for integrated smart meter, Orion for cellular endpoint, Ally for water meter module.' ;
    rdfs:domain ind:AmiEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:firmwareVersion rdf:type rdf:Property ;
    rdfs:label 'Firmware Version' ;
    rdfs:comment 'Current firmware version installed on the endpoint device. Critical for security patches and feature updates.' ;
    rdfs:domain ind:AmiEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geographicLatitude rdf:type rdf:Property ;
    rdfs:label 'Geographic Latitude' ;
    rdfs:comment 'Latitude coordinate of the endpoint installation location in decimal degrees. Used for GIS mapping and network planning.' ;
    rdfs:domain ind:AmiEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:geographicLongitude rdf:type rdf:Property ;
    rdfs:label 'Geographic Longitude' ;
    rdfs:comment 'Longitude coordinate of the endpoint installation location in decimal degrees. Used for GIS mapping and network planning.' ;
    rdfs:domain ind:AmiEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:installationTechnician rdf:type rdf:Property ;
    rdfs:label 'Installation Technician' ;
    rdfs:comment 'Name or identifier of the technician who installed the endpoint device. Used for quality tracking and accountability.' ;
    rdfs:domain ind:AmiEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ipAddress rdf:type rdf:Property ;
    rdfs:label 'Ip Address' ;
    rdfs:comment 'IP address assigned to the endpoint device for cellular or IP-based communication protocols. Null for RF-only devices.' ;
    rdfs:domain ind:AmiEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastCommunicationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Communication Timestamp' ;
    rdfs:comment 'Timestamp of the most recent successful communication received from this endpoint. Used to identify non-communicating devices.' ;
    rdfs:domain ind:AmiEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:lastFirmwareUpdateDate rdf:type rdf:Property ;
    rdfs:label 'Last Firmware Update Date' ;
    rdfs:comment 'Date when the endpoint firmware was last updated. Critical for security patch tracking and compliance.' ;
    rdfs:domain ind:AmiEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:leakAlertThresholdGpm rdf:type rdf:Property ;
    rdfs:label 'Leak Alert Threshold Gpm' ;
    rdfs:comment 'Continuous flow threshold in gallons per minute that triggers a leak alert. Typically 0.01 to 0.5 GPM for residential meters.' ;
    rdfs:domain ind:AmiEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:leakDetectionEnabledFlag rdf:type rdf:Property ;
    rdfs:label 'Leak Detection Enabled Flag' ;
    rdfs:comment 'Indicates whether continuous leak detection monitoring is enabled on this endpoint. True if enabled, False if disabled.' ;
    rdfs:domain ind:AmiEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:macAddress rdf:type rdf:Property ;
    rdfs:label 'Mac Address' ;
    rdfs:comment 'Unique hardware address assigned to the endpoint network interface. Used for device authentication and network routing.' ;
    rdfs:domain ind:AmiEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:networkNodeCode rdf:type rdf:Property ;
    rdfs:label 'Network Node Code' ;
    rdfs:comment 'Identifier for the network node or collector that this endpoint communicates with in the AMI network topology.' ;
    rdfs:domain ind:AmiEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:readIntervalSeconds rdf:type rdf:Property ;
    rdfs:label 'Read Interval Seconds' ;
    rdfs:comment 'Interval in seconds at which the endpoint records consumption data internally. Typical values: 900 (15 min), 3600 (hourly), 86400 (daily).' ;
    rdfs:domain ind:AmiEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reverseFlowDetectedFlag rdf:type rdf:Property ;
    rdfs:label 'Reverse Flow Detected Flag' ;
    rdfs:comment 'Indicates whether reverse flow has been detected by the endpoint. True if reverse flow detected, False otherwise. May indicate backflow or meter installation error.' ;
    rdfs:domain ind:AmiEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:signalQualityIndicator rdf:type rdf:Property ;
    rdfs:label 'Signal Quality Indicator' ;
    rdfs:comment 'Qualitative assessment of communication signal quality. Derived from signal strength and packet success rate.' ;
    rdfs:domain ind:AmiEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:signalStrengthDbm rdf:type rdf:Property ;
    rdfs:label 'Signal Strength Dbm' ;
    rdfs:comment 'Most recent radio signal strength measurement in dBm. Indicates communication quality between endpoint and collector. Typical range -110 to -50 dBm.' ;
    rdfs:domain ind:Metering ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tamperDetectedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Tamper Detected Timestamp' ;
    rdfs:comment 'Timestamp when the most recent tamper event was detected by the endpoint. Null if no tamper has been detected.' ;
    rdfs:domain ind:AmiEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:tamperStatus rdf:type rdf:Property ;
    rdfs:label 'Tamper Status' ;
    rdfs:comment 'Current tamper detection status reported by the endpoint. Alerts to potential theft, fraud, or unauthorized access.' ;
    rdfs:domain ind:AmiEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:readId rdf:type rdf:Property ;
    rdfs:label 'Read Id' ;
    rdfs:comment 'Primary key for read' ;
    rdfs:domain ind:Read ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:alarmCode rdf:type rdf:Property ;
    rdfs:label 'Alarm Code' ;
    rdfs:comment 'Code indicating any alarm condition detected during this interval. Examples include leak alarm, burst alarm, backflow alarm, low battery alarm, or communication failure alarm. Empty if no alarm condition exists.' ;
    rdfs:domain ind:IntervalConsumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:batteryVoltage rdf:type rdf:Property ;
    rdfs:label 'Battery Voltage' ;
    rdfs:comment 'The battery voltage of the AMI endpoint device at the time of this reading, measured in volts. Used to monitor endpoint health and predict battery replacement needs.' ;
    rdfs:domain ind:IntervalConsumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:consumptionVolumeGallons rdf:type rdf:Property ;
    rdfs:label 'Consumption Volume Gallons' ;
    rdfs:comment 'The total volume of water consumed during this interval, measured in gallons. This is the primary consumption metric used for billing, leak detection, and demand analysis.' ;
    rdfs:domain ind:IntervalConsumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dataQualityIndicator rdf:type rdf:Property ;
    rdfs:label 'Data Quality Indicator' ;
    rdfs:comment 'Indicates the quality and reliability of this interval reading. Valid readings are directly measured; estimated readings are interpolated due to communication gaps; suspect readings show anomalies; missing indicates no data received; tampered indicates potential meter tampering; overflow indicates meter register overflow.' ;
    rdfs:domain ind:IntervalConsumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedMethod rdf:type rdf:Property ;
    rdfs:label 'Estimated Method' ;
    rdfs:comment 'The method used to estimate this interval reading if data was missing or invalid. None indicates actual measured data. Other values indicate the estimation algorithm applied.' ;
    rdfs:domain ind:IntervalConsumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gapFlag rdf:type rdf:Property ;
    rdfs:label 'Gap Flag' ;
    rdfs:comment 'Boolean flag indicating whether this interval represents a data gap that was filled by estimation or interpolation. True indicates the reading is estimated due to missing data transmission.' ;
    rdfs:domain ind:IntervalConsumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:highUsageFlag rdf:type rdf:Property ;
    rdfs:label 'High Usage Flag' ;
    rdfs:comment 'Boolean flag indicating whether this interval exceeded the high-usage threshold for this meter installation. True indicates consumption significantly above normal patterns, potentially indicating irrigation, filling pools, or abnormal usage.' ;
    rdfs:domain ind:IntervalConsumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:intervalEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Interval End Timestamp' ;
    rdfs:comment 'The precise date and time when the consumption interval ended. Represents the end of the measurement period for this interval reading.' ;
    rdfs:domain ind:IntervalConsumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:intervalStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Interval Start Timestamp' ;
    rdfs:comment 'The precise date and time when the consumption interval began. Represents the beginning of the measurement period for this interval reading.' ;
    rdfs:domain ind:IntervalConsumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:leakDetectionFlag rdf:type rdf:Property ;
    rdfs:label 'Leak Detection Flag' ;
    rdfs:comment 'Boolean flag indicating whether this interval triggered a potential leak alert based on continuous low-flow patterns. True indicates sustained consumption suggesting a possible leak.' ;
    rdfs:domain ind:IntervalConsumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:processedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Processed Timestamp' ;
    rdfs:comment 'The date and time when this interval reading was processed and loaded into the data warehouse. Used for data pipeline monitoring and audit trails.' ;
    rdfs:domain ind:IntervalConsumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:pulseIncrementGallons rdf:type rdf:Property ;
    rdfs:label 'Pulse Increment Gallons' ;
    rdfs:comment 'The volume of water represented by each pulse from the meter encoder, measured in gallons. Varies by meter size and type. Used to convert pulse counts to consumption volumes.' ;
    rdfs:domain ind:IntervalConsumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rawPulseCount rdf:type rdf:Property ;
    rdfs:label 'Raw Pulse Count' ;
    rdfs:comment 'The raw cumulative pulse count from the meter encoder at the end of this interval. Each pulse represents a fixed volume increment. Used for data validation and troubleshooting.' ;
    rdfs:domain ind:IntervalConsumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:receivedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Received Timestamp' ;
    rdfs:comment 'The date and time when this interval reading was received by the AMI head-end system. Used to calculate transmission latency and identify delayed readings.' ;
    rdfs:domain ind:IntervalConsumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:reverseFlowFlag rdf:type rdf:Property ;
    rdfs:label 'Reverse Flow Flag' ;
    rdfs:comment 'Boolean flag indicating whether reverse flow was detected during this interval. True indicates water flowing backward through the meter, which may indicate backflow, meter installation issues, or tampering.' ;
    rdfs:domain ind:IntervalConsumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:tamperEventCode rdf:type rdf:Property ;
    rdfs:label 'Tamper Event Code' ;
    rdfs:comment 'Code indicating the type of tamper event detected during this interval, if any. Examples include magnetic interference, tilt detection, removal detection, or reverse flow. Empty if no tamper event detected.' ;
    rdfs:domain ind:IntervalConsumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:temperatureFahrenheit rdf:type rdf:Property ;
    rdfs:label 'Temperature Fahrenheit' ;
    rdfs:comment 'The ambient temperature at the meter location during this interval, measured in degrees Fahrenheit. Some AMI endpoints include temperature sensors for freeze detection and consumption correlation analysis.' ;
    rdfs:domain ind:IntervalConsumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:transmissionRetryCount rdf:type rdf:Property ;
    rdfs:label 'Transmission Retry Count' ;
    rdfs:comment 'The number of transmission attempts required to successfully deliver this interval reading to the AMI collector. Higher retry counts indicate communication challenges.' ;
    rdfs:domain ind:IntervalConsumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:zeroConsumptionFlag rdf:type rdf:Property ;
    rdfs:label 'Zero Consumption Flag' ;
    rdfs:comment 'Boolean flag indicating whether zero consumption was recorded during this interval. True indicates no water usage, which may be normal for vacant properties or may indicate meter malfunction.' ;
    rdfs:domain ind:IntervalConsumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:highUsageAlertId rdf:type rdf:Property ;
    rdfs:label 'High Usage Alert Id' ;
    rdfs:comment 'Unique identifier for the high usage alert record. Primary key.' ;
    rdfs:domain ind:HighUsageAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fieldInvestigationWorkOrderId rdf:type rdf:Property ;
    rdfs:label 'Field Investigation Work Order Id' ;
    rdfs:comment 'Foreign key linking to asset.work_order. Business justification: High usage alerts trigger field investigation work orders for meter inspection or leak detection. The existing order_id FK points to service.order (customer-facing); this role-prefixed FK captures the' ;
    rdfs:domain ind:HighUsageAlert ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:WorkOrder .

ind:primaryHighAmiDeviceAmiEndpointId rdf:type rdf:Property ;
    rdfs:label 'Primary High Ami Device Ami Endpoint Id' ;
    rdfs:comment 'Unique identifier of the AMI endpoint device (Sensus FlexNet or similar) that generated the consumption data triggering this alert. Used for device diagnostics and data quality validation.' ;
    rdfs:domain ind:HighUsageAlert ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AmiEndpoint .

ind:actualConsumptionUnit rdf:type rdf:Property ;
    rdfs:label 'Actual Consumption Unit' ;
    rdfs:comment 'Unit of measure for the actual consumption value. Gallons, cubic feet, and cubic meters represent volume; GPM (Gallons per Minute) and MGD (Million Gallons per Day) represent flow rate.' ;
    rdfs:domain ind:HighUsageAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actualConsumptionValue rdf:type rdf:Property ;
    rdfs:label 'Actual Consumption Value' ;
    rdfs:comment 'The measured consumption value during the detection period that triggered the alert. Represents the actual usage that exceeded the threshold.' ;
    rdfs:domain ind:HighUsageAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:alertGeneratedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Alert Generated Timestamp' ;
    rdfs:comment 'Date and time when the alert was generated by the Advanced Metering Infrastructure (AMI) or analytics system. Represents the moment the threshold breach was detected.' ;
    rdfs:domain ind:HighUsageAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:alertNumber rdf:type rdf:Property ;
    rdfs:label 'Alert Number' ;
    rdfs:comment 'Business-facing unique alert number used for tracking and customer communication. Format: HUA-XXXXXXXXXX.' ;
    rdfs:domain ind:HighUsageAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alertSeverity rdf:type rdf:Property ;
    rdfs:label 'Alert Severity' ;
    rdfs:comment 'Severity classification of the alert based on variance magnitude and potential impact. Low indicates minor variance; medium indicates moderate concern; high indicates significant issue requiring prompt attention; critical indicates emergency condition requiring immediate response.' ;
    rdfs:domain ind:HighUsageAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alertStatus rdf:type rdf:Property ;
    rdfs:label 'Alert Status' ;
    rdfs:comment 'Current lifecycle status of the alert. Open indicates newly generated; notified means customer has been contacted; acknowledged means customer confirmed receipt; investigating indicates active review; resolved means issue addressed; dismissed means no action required; false positive indicates erroneous alert. [ENUM-REF-CANDIDATE: open|notified|acknowledged|investigating|resolved|dismissed|false_positive — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:HighUsageAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alertType rdf:type rdf:Property ;
    rdfs:label 'Alert Type' ;
    rdfs:comment 'Classification of the high usage alert based on consumption pattern analysis. High consumption indicates volume exceeds baseline; continuous flow suggests uninterrupted usage; backflow suspected indicates reverse flow detection; leak detected flags potential infrastructure failure; abnormal pattern identifies irregular usage; threshold exceeded indicates absolute limit breach.' ;
    rdfs:domain ind:HighUsageAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:baselineConsumptionValue rdf:type rdf:Property ;
    rdfs:label 'Baseline Consumption Value' ;
    rdfs:comment 'Historical average or expected consumption value used as the comparison baseline for this alert. May be calculated from seasonal norms, customer history, or similar account profiles.' ;
    rdfs:domain ind:HighUsageAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:baselinePeriodDays rdf:type rdf:Property ;
    rdfs:label 'Baseline Period Days' ;
    rdfs:comment 'Number of days used to calculate the baseline consumption value. Typical values include 30, 60, 90, or 365 days depending on seasonality and data availability.' ;
    rdfs:domain ind:HighUsageAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:customerAcknowledgedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Customer Acknowledged Timestamp' ;
    rdfs:comment 'Date and time when the customer acknowledged receipt and awareness of this alert. Null if customer has not acknowledged.' ;
    rdfs:domain ind:HighUsageAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:customerNotifiedFlag rdf:type rdf:Property ;
    rdfs:label 'Customer Notified Flag' ;
    rdfs:comment 'Indicates whether the customer has been notified about this high usage alert. True means notification sent; False means no notification sent yet.' ;
    rdfs:domain ind:HighUsageAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:detectionPeriodEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Detection Period End Timestamp' ;
    rdfs:comment 'End of the time window during which the high usage condition was detected. Used to define the consumption analysis interval.' ;
    rdfs:domain ind:HighUsageAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:detectionPeriodStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Detection Period Start Timestamp' ;
    rdfs:comment 'Beginning of the time window during which the high usage condition was detected. Used to define the consumption analysis interval.' ;
    rdfs:domain ind:HighUsageAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:estimatedRevenueImpactAmount rdf:type rdf:Property ;
    rdfs:label 'Estimated Revenue Impact Amount' ;
    rdfs:comment 'Estimated financial impact of the high usage condition, representing potential lost revenue or customer billing adjustment. Positive values indicate revenue at risk; negative values indicate customer credits issued. Null if not calculated.' ;
    rdfs:domain ind:HighUsageAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:estimatedWaterLossGallons rdf:type rdf:Property ;
    rdfs:label 'Estimated Water Loss Gallons' ;
    rdfs:comment 'Estimated volume of water lost or wasted due to the condition that triggered this alert, measured in gallons. Used for Non-Revenue Water (NRW) and Unaccounted-for Water (UFW) analysis. Null if not applicable or not calculated.' ;
    rdfs:domain ind:HighUsageAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:firstNotificationTimestamp rdf:type rdf:Property ;
    rdfs:label 'First Notification Timestamp' ;
    rdfs:comment 'Date and time when the first customer notification was sent for this alert. Null if customer has not been notified.' ;
    rdfs:domain ind:HighUsageAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:investigationStartedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Investigation Started Timestamp' ;
    rdfs:comment 'Date and time when investigation of this alert began. Null if investigation has not started.' ;
    rdfs:domain ind:HighUsageAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:notificationCount rdf:type rdf:Property ;
    rdfs:label 'Notification Count' ;
    rdfs:comment 'Total number of notification attempts made to the customer regarding this alert. Includes all channels and retries.' ;
    rdfs:domain ind:HighUsageAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:notificationMethod rdf:type rdf:Property ;
    rdfs:label 'Notification Method' ;
    rdfs:comment 'Primary communication channel used to notify the customer about this alert. Email, SMS, and mobile app represent digital channels; phone call represents voice contact; postal mail represents physical correspondence; customer portal represents self-service access; none indicates no notification sent. [ENUM-REF-CANDIDATE: email|sms|phone_call|postal_mail|mobile_app|customer_portal|none — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:HighUsageAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resolutionCategory rdf:type rdf:Property ;
    rdfs:label 'Resolution Category' ;
    rdfs:comment 'Classification of the root cause or resolution outcome for this alert. Customer leak repaired indicates customer-side plumbing issue fixed; utility leak repaired indicates utility infrastructure issue fixed; meter malfunction indicates faulty meter; seasonal usage indicates expected variance; customer behavior change indicates legitimate usage increase; irrigation system and pool filling indicate specific high-volume activities; construction activity indicates temporary usage spike; false alarm indicates erroneous alert; other indicates miscellaneous resolution. [ENUM-REF-CANDIDATE: customer_leak_repaired|utility_leak_repaired|meter_malfunction|seasonal_usage|customer_behavior_change|irrigation_system|pool_filling|construction_activity|false_alarm|other — 10 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:HighUsageAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceOrderCreatedFlag rdf:type rdf:Property ;
    rdfs:label 'Service Order Created Flag' ;
    rdfs:comment 'Indicates whether a field service order was created in response to this alert. True means service order generated; False means no service order created.' ;
    rdfs:domain ind:HighUsageAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:suppressionFlag rdf:type rdf:Property ;
    rdfs:label 'Suppression Flag' ;
    rdfs:comment 'Indicates whether this alert was suppressed from customer notification due to business rules (e.g., customer opted out, account in dispute, recent similar alert). True means suppressed; False means not suppressed.' ;
    rdfs:domain ind:HighUsageAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:suppressionReason rdf:type rdf:Property ;
    rdfs:label 'Suppression Reason' ;
    rdfs:comment 'Explanation of why this alert was suppressed from customer notification. Null if alert was not suppressed.' ;
    rdfs:domain ind:HighUsageAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:thresholdUnit rdf:type rdf:Property ;
    rdfs:label 'Threshold Unit' ;
    rdfs:comment 'Unit of measure for the threshold value. Gallons and cubic feet/meters represent volume; GPM (Gallons per Minute) and MGD (Million Gallons per Day) represent flow rate; percent represents variance from baseline.' ;
    rdfs:domain ind:HighUsageAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:thresholdValue rdf:type rdf:Property ;
    rdfs:label 'Threshold Value' ;
    rdfs:comment 'The defined limit or baseline value that was exceeded to trigger this alert. May represent absolute volume, flow rate, or percentage variance depending on alert configuration.' ;
    rdfs:domain ind:HighUsageAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:variancePercentage rdf:type rdf:Property ;
    rdfs:label 'Variance Percentage' ;
    rdfs:comment 'Percentage by which actual consumption exceeded the threshold value. Calculated as ((actual - threshold) / threshold) * 100. Positive values indicate over-threshold conditions.' ;
    rdfs:domain ind:HighUsageAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:replacementOrderId rdf:type rdf:Property ;
    rdfs:label 'Replacement Order Id' ;
    rdfs:comment 'Primary key for replacement_order' ;
    rdfs:domain ind:ReplacementOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:oldMeteringMeterId rdf:type rdf:Property ;
    rdfs:label 'Old Metering Meter Id' ;
    rdfs:comment 'Foreign key linking to metering.metering_meter. Business justification: A replacement order replaces an existing (old) meter with a new meter. This FK tracks which physical meter device was removed/replaced. This is the first of two FKs to metering_meter (old and new), re' ;
    rdfs:domain ind:ReplacementOrder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Meter .

ind:createdAt rdf:type rdf:Property ;
    rdfs:label 'Created At' ;
    rdfs:domain ind:ReadRoute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:estimatedReadTimeMinutes rdf:type rdf:Property ;
    rdfs:label 'Estimated Read Time Minutes' ;
    rdfs:domain ind:ReadRoute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:geographicArea rdf:type rdf:Property ;
    rdfs:label 'Geographic Area' ;
    rdfs:domain ind:ReadRoute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isActive rdf:type rdf:Property ;
    rdfs:label 'Is Active' ;
    rdfs:comment 'Indicates whether this regulatory requirement is currently active and enforceable. False if the requirement has been superseded, repealed, or is no longer applicable.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:meterCount rdf:type rdf:Property ;
    rdfs:label 'Meter Count' ;
    rdfs:domain ind:ReadRoute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:routeCode rdf:type rdf:Property ;
    rdfs:label 'Route Code' ;
    rdfs:comment 'Identifier for the meter reading or field service route to which this service point is assigned. Used for scheduling meter reading, field inspections, and maintenance activities.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:routeDescription rdf:type rdf:Property ;
    rdfs:label 'Route Description' ;
    rdfs:domain ind:ReadRoute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:routeName rdf:type rdf:Property ;
    rdfs:label 'Route Name' ;
    rdfs:domain ind:ReadRoute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:routeSequence rdf:type rdf:Property ;
    rdfs:label 'Route Sequence' ;
    rdfs:domain ind:ReadRoute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:primaryReplacementMeterSizeTypeId rdf:type rdf:Property ;
    rdfs:label 'Primary Replacement Meter Size Type Id' ;
    rdfs:comment 'Reference to the successor meter size and type that replaces this obsolete configuration. Null if no replacement defined.' ;
    rdfs:domain ind:MeterSizeType ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MeterSizeType .

ind:accuracyClass rdf:type rdf:Property ;
    rdfs:label 'Accuracy Class' ;
    rdfs:comment 'AWWA or ISO accuracy classification for meters of this size (e.g., AWWA Class I, Class II; ISO R160, R250). Defines expected measurement precision and testing requirements.' ;
    rdfs:domain ind:MeterSizeType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accuracyPercentageLowFlow rdf:type rdf:Property ;
    rdfs:label 'Accuracy Percentage Low Flow' ;
    rdfs:comment 'Expected measurement accuracy as a percentage at the minimum detectable flow rate. Critical for NRW analysis.' ;
    rdfs:domain ind:MeterSizeType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:accuracyPercentageNormalFlow rdf:type rdf:Property ;
    rdfs:label 'Accuracy Percentage Normal Flow' ;
    rdfs:comment 'Expected measurement accuracy as a percentage at normal operating flow rate.' ;
    rdfs:domain ind:MeterSizeType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:activeFlag rdf:type rdf:Property ;
    rdfs:label 'Active Flag' ;
    rdfs:comment 'Indicates whether this meter size and type is currently approved for new installations in the utility service territory.' ;
    rdfs:domain ind:MeterSizeType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:amiCompatibleFlag rdf:type rdf:Property ;
    rdfs:label 'Ami Compatible Flag' ;
    rdfs:comment 'Indicates whether this meter size and type can be equipped with AMI endpoints for remote reading and interval data collection.' ;
    rdfs:domain ind:MeterSizeType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:amrCompatibleFlag rdf:type rdf:Property ;
    rdfs:label 'Amr Compatible Flag' ;
    rdfs:comment 'Indicates whether this meter size and type can be equipped with AMR endpoints for drive-by or walk-by reading.' ;
    rdfs:domain ind:MeterSizeType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:averageUnitCostUsd rdf:type rdf:Property ;
    rdfs:label 'Average Unit Cost Usd' ;
    rdfs:comment 'Average procurement cost in United States Dollars (USD) for a meter of this size including hardware but excluding installation labor. Used for budgeting and capital planning.' ;
    rdfs:domain ind:MeterSizeType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:awwaStandardCode rdf:type rdf:Property ;
    rdfs:label 'Awwa Standard Code' ;
    rdfs:comment 'Applicable AWWA standard governing this meter size and type (e.g., C700, C701, C702, C706, C708, C710, C713).' ;
    rdfs:domain ind:MeterSizeType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:displayName rdf:type rdf:Property ;
    rdfs:label 'Display Name' ;
    rdfs:comment 'Human-readable display name for the meter size (e.g., \'5/8 inch\', \'3/4 inch\', \'1 inch\', \'2 inch\'). Used in user interfaces, reports, and customer communications.' ;
    rdfs:domain ind:MeterSizeType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expectedServiceLifeYears rdf:type rdf:Property ;
    rdfs:label 'Expected Service Life Years' ;
    rdfs:comment 'Typical operational lifespan in years before meter replacement is recommended due to accuracy degradation.' ;
    rdfs:domain ind:MeterSizeType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:flangeStandard rdf:type rdf:Property ;
    rdfs:label 'Flange Standard' ;
    rdfs:comment 'Flange specification for flanged connections (e.g., ANSI Class 125, ANSI Class 250). Applicable to larger meter sizes requiring bolted connections.' ;
    rdfs:domain ind:MeterSizeType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:installationLaborHours rdf:type rdf:Property ;
    rdfs:label 'Installation Labor Hours' ;
    rdfs:comment 'Typical labor hours required to install or replace a meter of this size. Used for work order planning, crew scheduling, and cost estimation.' ;
    rdfs:domain ind:MeterSizeType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:installationOrientation rdf:type rdf:Property ;
    rdfs:label 'Installation Orientation' ;
    rdfs:comment 'Required or recommended installation orientation for accurate measurement (horizontal, vertical, or any orientation).' ;
    rdfs:domain ind:MeterSizeType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:leadFreeCertifiedFlag rdf:type rdf:Property ;
    rdfs:label 'Lead Free Certified Flag' ;
    rdfs:comment 'Indicates whether this meter size and type meets lead-free certification requirements under the Safe Drinking Water Act and LCRR.' ;
    rdfs:domain ind:MeterSizeType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lengthInches rdf:type rdf:Property ;
    rdfs:label 'Length Inches' ;
    rdfs:comment 'Overall length of the meter body in inches. Critical for vault and pit sizing during installation.' ;
    rdfs:domain ind:MeterSizeType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maxContinuousFlowGpm rdf:type rdf:Property ;
    rdfs:label 'Max Continuous Flow Gpm' ;
    rdfs:comment 'Maximum flow rate in gallons per minute that the meter can sustain continuously without damage or accuracy degradation.' ;
    rdfs:domain ind:MeterSizeType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maxRegisteredFlowGpm rdf:type rdf:Property ;
    rdfs:label 'Max Registered Flow Gpm' ;
    rdfs:comment 'Peak flow rate in gallons per minute that the meter can register accurately for short durations.' ;
    rdfs:domain ind:MeterSizeType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maximumFlowRateGpm rdf:type rdf:Property ;
    rdfs:label 'Maximum Flow Rate Gpm' ;
    rdfs:comment 'Maximum continuous flow rate in gallons per minute (GPM) for meters of this size. Defines the upper capacity limit for safe and accurate operation.' ;
    rdfs:domain ind:MeterSizeType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maximumIntermittentFlowRateGpm rdf:type rdf:Property ;
    rdfs:label 'Maximum Intermittent Flow Rate Gpm' ;
    rdfs:comment 'Maximum short-duration or peak flow rate in gallons per minute (GPM) that the meter can handle without damage. Used for surge and peak demand scenarios.' ;
    rdfs:domain ind:MeterSizeType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:measurementClass rdf:type rdf:Property ;
    rdfs:label 'Measurement Class' ;
    rdfs:comment 'AWWA accuracy classification (Class I through Class IV). Higher classes indicate greater accuracy at low flow rates.' ;
    rdfs:domain ind:MeterSizeType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:meterSizeTypeStatus rdf:type rdf:Property ;
    rdfs:label 'Meter Size Type Status' ;
    rdfs:comment 'Current lifecycle status of this meter size type in the reference catalog (active, inactive, obsolete, pending approval). Controls availability for new installations.' ;
    rdfs:domain ind:MeterSizeType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:meterType rdf:type rdf:Property ;
    rdfs:label 'Meter Type' ;
    rdfs:comment 'Technology classification of the water meter. Defines the measurement principle used to register flow.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minDetectableFlowGpm rdf:type rdf:Property ;
    rdfs:label 'Min Detectable Flow Gpm' ;
    rdfs:comment 'Lowest flow rate in gallons per minute that the meter can detect and register. Critical for leak detection and low-flow accuracy.' ;
    rdfs:domain ind:MeterSizeType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumFlowRateGpm rdf:type rdf:Property ;
    rdfs:label 'Minimum Flow Rate Gpm' ;
    rdfs:comment 'Minimum measurable flow rate in gallons per minute (GPM) for meters of this size. Defines the lower accuracy threshold for consumption measurement.' ;
    rdfs:domain ind:MeterSizeType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:normalOperatingFlowGpm rdf:type rdf:Property ;
    rdfs:label 'Normal Operating Flow Gpm' ;
    rdfs:comment 'Typical sustained flow rate in gallons per minute for which the meter is optimally designed. Used for meter sizing and selection.' ;
    rdfs:domain ind:MeterSizeType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:normalOperatingFlowRateGpm rdf:type rdf:Property ;
    rdfs:label 'Normal Operating Flow Rate Gpm' ;
    rdfs:comment 'Typical or recommended operating flow rate in gallons per minute (GPM) for optimal meter accuracy and longevity. Used for sizing and capacity planning.' ;
    rdfs:domain ind:MeterSizeType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nsf61CertifiedFlag rdf:type rdf:Property ;
    rdfs:label 'Nsf 61 Certified Flag' ;
    rdfs:comment 'Indicates whether this meter is certified to NSF/ANSI Standard 61 for drinking water system components.' ;
    rdfs:domain ind:MeterSizeType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:obsoleteDate rdf:type rdf:Property ;
    rdfs:label 'Obsolete Date' ;
    rdfs:comment 'Date when this meter size and type was discontinued or phased out for new installations. Null if still active.' ;
    rdfs:domain ind:MeterSizeType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:pressureLossAtMaxFlowPsi rdf:type rdf:Property ;
    rdfs:label 'Pressure Loss At Max Flow Psi' ;
    rdfs:comment 'Expected pressure loss in pounds per square inch (PSI) across the meter at maximum continuous flow rate. Critical for hydraulic modeling and system pressure management.' ;
    rdfs:domain ind:MeterSizeType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:registerCapacityGallons rdf:type rdf:Property ;
    rdfs:label 'Register Capacity Gallons' ;
    rdfs:comment 'Maximum cumulative volume in gallons that the meter register can display before rolling over. Important for billing cycle planning and register overflow detection.' ;
    rdfs:domain ind:MeterSizeType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:registerType rdf:type rdf:Property ;
    rdfs:label 'Register Type' ;
    rdfs:comment 'Type of register used to display consumption. Mechanical for analog dials, electronic for digital displays, encoder for AMI/AMR integration.' ;
    rdfs:domain ind:MeterSizeType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceConnectionType rdf:type rdf:Property ;
    rdfs:label 'Service Connection Type' ;
    rdfs:comment 'Standard connection method for installing this meter size (threaded, flanged, or compression fitting).' ;
    rdfs:domain ind:MeterSizeType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sizeCode rdf:type rdf:Property ;
    rdfs:label 'Size Code' ;
    rdfs:comment 'Short alphanumeric code representing the meter size (e.g., 5/8, 3/4, 1, 1.5, 2, 3, 4, 6, 8, 10, 12). Used as a lookup key in operational systems.' ;
    rdfs:domain ind:MeterSizeType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sizeInches rdf:type rdf:Property ;
    rdfs:label 'Size Inches' ;
    rdfs:comment 'Nominal diameter of the meter in inches (e.g., 0.625 for 5/8 inch, 0.75 for 3/4 inch, 1.0, 1.5, 2.0, etc.). Primary measurement for meter sizing and capacity planning.' ;
    rdfs:domain ind:MeterSizeType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sizeMillimeters rdf:type rdf:Property ;
    rdfs:label 'Size Millimeters' ;
    rdfs:comment 'Nominal diameter of the meter in millimeters (e.g., 15mm, 20mm, 25mm, 40mm, 50mm, etc.). Used for international standards compliance and metric system reporting.' ;
    rdfs:domain ind:MeterSizeType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sortOrder rdf:type rdf:Property ;
    rdfs:label 'Sort Order' ;
    rdfs:comment 'Numeric value controlling the display sequence of meter sizes in user interfaces and reports (typically ordered from smallest to largest).' ;
    rdfs:domain ind:MeterSizeType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:straightPipeDownstreamInches rdf:type rdf:Property ;
    rdfs:label 'Straight Pipe Downstream Inches' ;
    rdfs:comment 'Minimum length of straight pipe required downstream of the meter in inches to ensure accurate flow measurement.' ;
    rdfs:domain ind:MeterSizeType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:straightPipeUpstreamInches rdf:type rdf:Property ;
    rdfs:label 'Straight Pipe Upstream Inches' ;
    rdfs:comment 'Minimum length of straight pipe required upstream of the meter in inches to ensure accurate flow measurement.' ;
    rdfs:domain ind:MeterSizeType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:temperatureRatingFahrenheitMax rdf:type rdf:Property ;
    rdfs:label 'Temperature Rating Fahrenheit Max' ;
    rdfs:comment 'Maximum water temperature in Fahrenheit at which the meter maintains accuracy and structural integrity.' ;
    rdfs:domain ind:MeterSizeType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:temperatureRatingFahrenheitMin rdf:type rdf:Property ;
    rdfs:label 'Temperature Rating Fahrenheit Min' ;
    rdfs:comment 'Minimum water temperature in Fahrenheit at which the meter maintains accuracy and structural integrity.' ;
    rdfs:domain ind:MeterSizeType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:testingFrequencyYears rdf:type rdf:Property ;
    rdfs:label 'Testing Frequency Years' ;
    rdfs:comment 'Recommended interval in years between accuracy testing and calibration per regulatory and utility standards.' ;
    rdfs:domain ind:MeterSizeType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:threadStandard rdf:type rdf:Property ;
    rdfs:label 'Thread Standard' ;
    rdfs:comment 'Thread specification for threaded connections (e.g., NPT, BSPT, AWWA). Ensures compatibility with service line fittings and meter setters.' ;
    rdfs:domain ind:MeterSizeType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:typicalApplication rdf:type rdf:Property ;
    rdfs:label 'Typical Application' ;
    rdfs:comment 'Standard use case for this meter size and type (e.g., single-family residential, multi-family residential, commercial, industrial, fire service, irrigation).' ;
    rdfs:domain ind:MeterSizeType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:typicalCustomerClass rdf:type rdf:Property ;
    rdfs:label 'Typical Customer Class' ;
    rdfs:comment 'Primary customer class typically served by this meter size (residential, commercial, industrial, institutional, agricultural, municipal). Used for rate structure and billing configuration.' ;
    rdfs:domain ind:MeterSizeType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:typicalServiceLifeYears rdf:type rdf:Property ;
    rdfs:label 'Typical Service Life Years' ;
    rdfs:comment 'Expected operational service life in years for meters of this size under normal operating conditions. Used for asset replacement planning and depreciation schedules.' ;
    rdfs:domain ind:MeterSizeType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:weightPounds rdf:type rdf:Property ;
    rdfs:label 'Weight Pounds' ;
    rdfs:comment 'Approximate weight of the meter in pounds. Used for logistics, installation planning, and safety assessments.' ;
    rdfs:domain ind:MeterSizeType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:parentAssetRegistryId rdf:type rdf:Property ;
    rdfs:label 'Parent Asset Registry Id' ;
    rdfs:comment 'Self-referencing identifier pointing to the parent asset in the asset hierarchy (e.g., a pump impeller\'s parent is the pump assembly; the pump assembly\'s parent is the pump station). Enables parent-child asset hierarchy navigation for maintenance cost roll-up and condition assessment aggregation. Null for top-level assets.' ;
    rdfs:domain ind:Registry ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Registry .

ind:acquisitionCost rdf:type rdf:Property ;
    rdfs:label 'Acquisition Cost' ;
    rdfs:comment 'Original purchase or construction cost of the asset in US dollars at the time of acquisition. Represents the capitalized cost basis used for depreciation calculations and fixed asset register reporting. Sourced from SAP FI/CO asset accounting module. Required for GASB Statement No. 34 infrastructure asset reporting.' ;
    rdfs:domain ind:Registry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:assetCategory rdf:type rdf:Property ;
    rdfs:label 'Asset Category' ;
    rdfs:comment 'Operational domain category indicating which business process area the asset belongs to (e.g., water_treatment for WTP equipment, wastewater_treatment for WWTP equipment, distribution for pipes and valves in the distribution network, collection for sewer infrastructure, metering for AMI/AMR devices). [ENUM-REF-CANDIDATE: water_treatment|wastewater_treatment|distribution|collection|metering|electrical|mechanical|civil|vehicle|instrumentation_control — 10 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assetName rdf:type rdf:Property ;
    rdfs:label 'Asset Name' ;
    rdfs:comment 'Human-readable name or short description of the asset (e.g., \'Raw Water Pump No. 3\', \'Influent Gate Valve 12-inch\', \'Chlorine Contact Basin Filter 2\'). Used as the primary display label in CMMS, GIS, and reporting interfaces.' ;
    rdfs:domain ind:Registry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capacityUnit rdf:type rdf:Property ;
    rdfs:label 'Capacity Unit' ;
    rdfs:comment 'Unit of measure for the rated_capacity field. Common units include GPM (Gallons per Minute) for pumps, MGD (Million Gallons per Day) for treatment processes, gallons for storage tanks, kW for electrical equipment, and PSI (Pounds per Square Inch) for pressure vessels. [ENUM-REF-CANDIDATE: GPM|MGD|gallons|kW|kVA|HP|PSI|NTU|mg_L — 9 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conditionAssessmentDate rdf:type rdf:Property ;
    rdfs:label 'Condition Assessment Date' ;
    rdfs:comment 'Date of the most recent formal condition assessment performed on the asset. Used to determine assessment currency and schedule the next inspection cycle. Condition assessments may be visual inspections, CCTV surveys, vibration analysis, or other diagnostic methods.' ;
    rdfs:domain ind:Registry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:diameterMm rdf:type rdf:Property ;
    rdfs:label 'Diameter Mm' ;
    rdfs:comment 'Nominal diameter of the asset in millimeters. For pipes and valves, this is the internal bore diameter. For pumps, this is the discharge diameter. Used for hydraulic capacity calculations, spare parts specification, and network modeling in Innovyze InfoWater.' ;
    rdfs:domain ind:Registry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:elevationM rdf:type rdf:Property ;
    rdfs:label 'Elevation M' ;
    rdfs:comment 'Elevation of the asset above mean sea level in meters. Critical for hydraulic modeling, pressure zone assignment, and gravity-fed system design. Used in Innovyze InfoWater hydraulic models and Esri ArcGIS 3D network analysis.' ;
    rdfs:domain ind:Registry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:expectedUsefulLifeYears rdf:type rdf:Property ;
    rdfs:label 'Expected Useful Life Years' ;
    rdfs:comment 'The estimated total useful life of the asset in years as defined by engineering standards, manufacturer specifications, or utility policy. Used for depreciation calculations, Capital Improvement Program (CIP) planning, and asset renewal forecasting. Aligns with GASB Statement No. 34 infrastructure reporting requirements.' ;
    rdfs:domain ind:Registry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:functionalLocation rdf:type rdf:Property ;
    rdfs:label 'Functional Location' ;
    rdfs:comment 'Hierarchical functional location code representing the physical or functional position of the asset within the utility\'s infrastructure (e.g., WTP-PUMP-STATION-01-PUMP-03). Mirrors the SAP PM Functional Location (FLOC) structure and IBM Maximo Location field. Used for structured asset hierarchy navigation and maintenance cost allocation.' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isLeadServiceLine rdf:type rdf:Property ;
    rdfs:label 'Is Lead Service Line' ;
    rdfs:comment 'Indicates whether this asset is a lead service line or contains lead components. Critical for compliance with the EPA Lead and Copper Rule Revisions (LCRR) which requires utilities to inventory and replace lead service lines. True = confirmed lead service line; False = non-lead or unknown.' ;
    rdfs:domain ind:Registry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:maintenanceStrategy rdf:type rdf:Property ;
    rdfs:label 'Maintenance Strategy' ;
    rdfs:comment 'The primary maintenance approach applied to this asset as defined in the Computerized Maintenance Management System (CMMS). \'preventive\' indicates time-based scheduled maintenance; \'predictive\' indicates condition-monitoring-based maintenance; \'condition_based\' indicates maintenance triggered by condition thresholds; \'run_to_failure\' is applied to non-critical, easily replaceable assets.' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:manufactureDate rdf:type rdf:Property ;
    rdfs:label 'Manufacture Date' ;
    rdfs:comment 'Date the asset was manufactured by the OEM. May differ from installation date for assets stored in inventory before deployment. Used for age-based condition assessment and manufacturer warranty calculations.' ;
    rdfs:domain ind:Registry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:maximoAssetNum rdf:type rdf:Property ;
    rdfs:label 'Maximo Asset Num' ;
    rdfs:comment 'The asset number as assigned and maintained in IBM Maximo Asset Management (CMMS). This is the operational cross-reference key used by maintenance crews and work order management. Must be unique within the Maximo instance.' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modelNum rdf:type rdf:Property ;
    rdfs:label 'Model Num' ;
    rdfs:comment 'Manufacturer\'s model or product number for the asset (e.g., \'LF 3196 STX\', \'NK 65-200\'). Used for spare parts identification, technical documentation retrieval, and procurement of replacement units. Sourced from IBM Maximo model field.' ;
    rdfs:domain ind:Registry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:powerRatingKw rdf:type rdf:Property ;
    rdfs:label 'Power Rating Kw' ;
    rdfs:comment 'Nameplate power rating of the asset in kilowatts (kW). Applicable to pumps, blowers, motors, generators, and other electrical equipment. Used for energy consumption analysis, Variable Frequency Drive (VFD) sizing, electrical load planning, and OPEX budgeting.' ;
    rdfs:domain ind:Registry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pressureZone rdf:type rdf:Property ;
    rdfs:label 'Pressure Zone' ;
    rdfs:comment 'The hydraulic pressure zone or District Metered Area (DMA) in which the asset is located. Used for pressure management, Non-Revenue Water (NRW) analysis, and distribution network operations. Aligns with Innovyze InfoWater zone definitions and GIS pressure zone polygons.' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ratedCapacity rdf:type rdf:Property ;
    rdfs:label 'Rated Capacity' ;
    rdfs:comment 'The manufacturer-rated operational capacity of the asset expressed in the appropriate unit of measure (see capacity_unit field). For pumps: Gallons per Minute (GPM); for treatment units: Million Gallons per Day (MGD); for tanks: gallons. Used for capacity planning, hydraulic modeling, and performance benchmarking.' ;
    rdfs:domain ind:Registry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatoryAssetCode rdf:type rdf:Property ;
    rdfs:label 'Regulatory Asset Code' ;
    rdfs:comment 'Asset identifier assigned by a regulatory authority (e.g., state drinking water program, EPA) for compliance tracking and reporting purposes. Used in regulatory submissions such as the Consumer Confidence Report (CCR), Discharge Monitoring Report (DMR), and NPDES permit compliance documentation.' ;
    rdfs:domain ind:Registry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:replacementCost rdf:type rdf:Property ;
    rdfs:label 'Replacement Cost' ;
    rdfs:comment 'Current estimated cost to replace the asset with a new equivalent unit in US dollars. Updated periodically based on market pricing and engineering estimates. Used for Capital Improvement Program (CIP) budgeting, insurance valuation, and risk-based asset management decision-making.' ;
    rdfs:domain ind:Registry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sapEquipmentNum rdf:type rdf:Property ;
    rdfs:label 'Sap Equipment Num' ;
    rdfs:comment 'The equipment number assigned in SAP Plant Maintenance (PM) module. Used for integration with SAP FI/CO for depreciation, CAPEX/OPEX tracking, and maintenance cost postings. Enables bidirectional synchronization between SAP PM and the asset registry.' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serialNum rdf:type rdf:Property ;
    rdfs:label 'Serial Num' ;
    rdfs:comment 'Unique serial number assigned by the manufacturer to this specific asset unit. Used for warranty claims, recall tracking, and precise asset identification when multiple identical units exist. Sourced from IBM Maximo serial number field.' ;
    rdfs:domain ind:Registry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:warrantyExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Warranty Expiry Date' ;
    rdfs:comment 'Date on which the manufacturer\'s warranty for the asset expires. Used to trigger warranty claim processes before expiry and to transition maintenance responsibility from warranty to O&M budget. Sourced from IBM Maximo warranty end date.' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:amiApplicable rdf:type rdf:Property ;
    rdfs:label 'Ami Applicable' ;
    rdfs:comment 'Indicates whether assets of this class are part of the AMI/AMR metering infrastructure managed via the Sensus FlexNet AMI Platform. True for smart meters and communication endpoints; False for all other asset classes.' ;
    rdfs:domain ind:AssetClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:assetDomain rdf:type rdf:Property ;
    rdfs:label 'Asset Domain' ;
    rdfs:comment 'Operational domain to which this asset class primarily belongs within the utility (e.g., Water Treatment, Water Distribution, Wastewater Collection, Wastewater Treatment, Metering, Fleet, Facilities, Cross-Domain). Drives domain-specific maintenance strategies and regulatory reporting alignment. [ENUM-REF-CANDIDATE: Water Treatment|Water Distribution|Wastewater Collection|Wastewater Treatment|Metering|Fleet|Facilities|Cross-Domain — promote to reference product]' ;
    rdfs:domain ind:AssetClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capexThresholdUsd rdf:type rdf:Property ;
    rdfs:label 'Capex Threshold Usd' ;
    rdfs:comment 'Minimum acquisition or renewal cost in USD above which expenditures on assets of this class are capitalized as CAPEX rather than expensed as OPEX. Aligned with GAAP/GASB capitalization policies and SAP FI/CO asset accounting rules.' ;
    rdfs:domain ind:AssetClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cipProgramCategory rdf:type rdf:Property ;
    rdfs:label 'Cip Program Category' ;
    rdfs:comment 'CIP program category under which capital renewal projects for assets of this class are budgeted and tracked. Aligns with the utility\'s multi-year CIP planning structure in SAP PS and financial reporting to the Public Utilities Commission. [ENUM-REF-CANDIDATE: Water Supply|Water Treatment|Water Distribution|Wastewater Collection|Wastewater Treatment|Metering|Facilities|Fleet|Cross-Program — promote to reference product]' ;
    rdfs:domain ind:AssetClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:classCode rdf:type rdf:Property ;
    rdfs:label 'Class Code' ;
    rdfs:comment 'Short alphanumeric code uniquely identifying the asset class within the enterprise taxonomy (e.g., MECH-PUMP, ELEC-TRANS, CIVIL-PIPE). Used as the externally-known business identifier in IBM Maximo, SAP PM, and GIS integrations.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:classDescription rdf:type rdf:Property ;
    rdfs:label 'Class Description' ;
    rdfs:comment 'Detailed narrative description of the asset class, including its functional role within water or wastewater operations, typical installation context, and distinguishing characteristics from adjacent classes.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:className rdf:type rdf:Property ;
    rdfs:label 'Class Name' ;
    rdfs:comment 'Human-readable name of the asset class (e.g., \'Centrifugal Pump\', \'Distribution Main Pipe\', \'UV Disinfection Unit\'). Used in reports, work orders, and CAPEX planning documents.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:classStatus rdf:type rdf:Property ;
    rdfs:label 'Class Status' ;
    rdfs:comment 'Current lifecycle status of the asset class record within the reference taxonomy. \'Active\' classes are available for new asset registrations; \'Deprecated\' classes are retained for historical assets but cannot be assigned to new assets.' ;
    rdfs:domain ind:AssetClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conditionAssessmentMethod rdf:type rdf:Property ;
    rdfs:label 'Condition Assessment Method' ;
    rdfs:comment 'Default method used to assess the physical condition of assets in this class. CIPP and pipe assets typically use CCTV; rotating equipment uses vibration analysis; distribution mains may use acoustic leak detection. Drives field inspection work order types in Maximo. [ENUM-REF-CANDIDATE: Visual Inspection|CCTV|Acoustic Leak Detection|Vibration Analysis|Ultrasonic Testing|Hydraulic Testing|SCADA Monitoring|Not Applicable — promote to reference product]' ;
    rdfs:domain ind:AssetClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consequenceOfFailure rdf:type rdf:Property ;
    rdfs:label 'Consequence Of Failure' ;
    rdfs:comment 'Primary category of consequence if assets of this class fail. Drives risk-based maintenance prioritization and emergency response planning. [ENUM-REF-CANDIDATE: Service Interruption|Public Health Risk|Environmental Non-Compliance|Safety Hazard|Financial Loss|Reputational — promote to reference product]' ;
    rdfs:domain ind:AssetClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:criticalityTier rdf:type rdf:Property ;
    rdfs:label 'Criticality Tier' ;
    rdfs:comment 'Default criticality tier classification for assets of this class based on consequence of failure analysis. Critical assets (e.g., primary WTP pumps, transmission mains) receive highest maintenance priority and fastest response SLAs.' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:criticalityWeight rdf:type rdf:Property ;
    rdfs:label 'Criticality Weight' ;
    rdfs:comment 'Numeric weighting factor (typically 0.00–10.00) applied to assets of this class during criticality assessment scoring. Higher values indicate greater consequence of failure on service delivery, public health, or regulatory compliance. Used in risk-based asset prioritization per ISO 55001.' ;
    rdfs:domain ind:AssetClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:depreciationMethod rdf:type rdf:Property ;
    rdfs:label 'Depreciation Method' ;
    rdfs:comment 'Default accounting depreciation method applied to assets of this class for financial reporting purposes. Straight-Line is most common for utility infrastructure. Aligned with GAAP/GASB requirements for municipal utility financial statements. [ENUM-REF-CANDIDATE: Straight-Line|Declining Balance|Units of Production|Sum-of-Years-Digits|Modified Accelerated Cost Recovery — promote to reference product]' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:environmentalRiskFlag rdf:type rdf:Property ;
    rdfs:label 'Environmental Risk Flag' ;
    rdfs:comment 'Indicates whether failure of assets in this class poses a direct environmental risk requiring regulatory notification (e.g., SSO, CSO, chemical spill, NPDES permit exceedance). True triggers mandatory environmental incident reporting workflows.' ;
    rdfs:domain ind:AssetClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:gisFeatureClass rdf:type rdf:Property ;
    rdfs:label 'Gis Feature Class' ;
    rdfs:comment 'Corresponding feature class name in Esri ArcGIS geodatabase for assets of this class (e.g., \'wDistributionMain\', \'wValve\', \'wPump\'). Enables spatial analysis, network modeling in Innovyze InfoWater, and GIS-CMMS integration for field crew dispatch.' ;
    rdfs:domain ind:AssetClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hierarchyLevel rdf:type rdf:Property ;
    rdfs:label 'Hierarchy Level' ;
    rdfs:comment 'Numeric depth of this class within the classification hierarchy (1 = top-level category, 2 = sub-category, 3 = class, 4 = sub-class). Drives roll-up aggregation logic in CAPEX planning and maintenance reporting.' ;
    rdfs:domain ind:AssetClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:iso55001Aligned rdf:type rdf:Property ;
    rdfs:label 'Iso 55001 Aligned' ;
    rdfs:comment 'Indicates whether the maintenance strategy, criticality assessment, and lifecycle management approach for this asset class have been formally aligned with ISO 55001 Asset Management System requirements. Used for ISO certification audit evidence.' ;
    rdfs:domain ind:AssetClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lcrrApplicable rdf:type rdf:Property ;
    rdfs:label 'Lcrr Applicable' ;
    rdfs:comment 'Indicates whether assets of this class are subject to EPA Lead and Copper Rule Revisions (LCRR) compliance requirements, such as lead service line inventory and replacement tracking. Applicable to service lines, connectors, and plumbing components.' ;
    rdfs:domain ind:AssetClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:materialStandard rdf:type rdf:Property ;
    rdfs:label 'Material Standard' ;
    rdfs:comment 'Default material specification or construction standard applicable to assets of this class (e.g., \'AWWA C900 PVC\', \'AWWA C200 Steel\', \'ASTM A536 Ductile Iron\', \'HDPE ASTM D3035\'). Used in procurement specifications and asset registry for infrastructure renewal planning.' ;
    rdfs:domain ind:AssetClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maximoClassCode rdf:type rdf:Property ;
    rdfs:label 'Maximo Class Code' ;
    rdfs:comment 'Corresponding asset class identifier in IBM Maximo Asset Management CMMS. Used for bidirectional synchronization between the Silver Layer lakehouse and Maximo for work order generation, PM scheduling, and asset lifecycle management.' ;
    rdfs:domain ind:AssetClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:meanTimeBetweenFailuresDays rdf:type rdf:Property ;
    rdfs:label 'Mean Time Between Failures Days' ;
    rdfs:comment 'Industry benchmark mean time between failures in days for assets of this class, used as a baseline for reliability-centered maintenance planning and failure probability modeling. Sourced from AWWA reliability benchmarks and historical Maximo work order data.' ;
    rdfs:domain ind:AssetClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:meanTimeToRepairHours rdf:type rdf:Property ;
    rdfs:label 'Mean Time To Repair Hours' ;
    rdfs:comment 'Industry benchmark mean time to repair in hours for assets of this class, used for SLA setting, crew resource planning, and service restoration time estimation. Sourced from AWWA benchmarks and historical Maximo corrective work order durations.' ;
    rdfs:domain ind:AssetClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:numberSap rdf:type rdf:Property ;
    rdfs:label 'Number Sap' ;
    rdfs:comment 'Corresponding asset class number in SAP FI/CO Asset Accounting module (transaction AS02/AS03). Enables direct cross-reference between the enterprise data lakehouse and the SAP ERP system of record for financial reconciliation.' ;
    rdfs:domain ind:AssetClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pmFrequencyDays rdf:type rdf:Property ;
    rdfs:label 'Pm Frequency Days' ;
    rdfs:comment 'Default interval in calendar days between scheduled preventive maintenance activities for assets of this class. Used by IBM Maximo PM scheduling engine to auto-generate work orders. Overridable at the individual asset level.' ;
    rdfs:domain ind:AssetClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:primaryCategory rdf:type rdf:Property ;
    rdfs:label 'Primary Category' ;
    rdfs:comment 'Top-level classification grouping for the asset class aligned with standard utility asset taxonomy: Mechanical (pumps, blowers, mixers), Electrical (transformers, switchgear), Civil (pipes, structures, tanks), Instrumentation (sensors, meters, SCADA RTUs), Vehicle (fleet), Information Technology, or Other. [ENUM-REF-CANDIDATE: Mechanical|Electrical|Civil|Instrumentation|Vehicle|Information Technology|Other — promote to reference product]' ;
    rdfs:domain ind:AssetClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:renewalStrategy rdf:type rdf:Property ;
    rdfs:label 'Renewal Strategy' ;
    rdfs:comment 'Default end-of-life renewal strategy for assets of this class used in CIP planning. CIPP (Cured-in-Place Pipe) and trenchless methods are common for buried pipe rehabilitation; rotating equipment typically follows Replace-in-Kind or Upgrade strategies.' ;
    rdfs:domain ind:AssetClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:retirementDate rdf:type rdf:Property ;
    rdfs:label 'Retirement Date' ;
    rdfs:comment 'Date on which this asset class was retired or deprecated from the active taxonomy. Null for currently active classes. Retained for historical asset records that were registered under this class prior to retirement.' ;
    rdfs:domain ind:AssetClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:safetyClassification rdf:type rdf:Property ;
    rdfs:label 'Safety Classification' ;
    rdfs:comment 'Primary safety hazard classification for work activities on assets of this class. Drives OSHA-compliant safety permit requirements (e.g., confined space entry permits, lockout/tagout procedures) when generating work orders in Maximo.' ;
    rdfs:domain ind:AssetClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:salvageValuePct rdf:type rdf:Property ;
    rdfs:label 'Salvage Value Pct' ;
    rdfs:comment 'Default residual/salvage value expressed as a percentage of original acquisition cost at end of useful life for assets in this class. Used in depreciation calculations and asset disposal planning within SAP FI/CO.' ;
    rdfs:domain ind:AssetClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scadaMonitored rdf:type rdf:Property ;
    rdfs:label 'Scada Monitored' ;
    rdfs:comment 'Indicates whether assets of this class are typically monitored via SCADA (Supervisory Control and Data Acquisition) systems integrated with OSIsoft PI Historian. True for pumps, valves, flow meters, and treatment equipment; False for passive civil assets such as buried pipes.' ;
    rdfs:domain ind:AssetClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sizeUnitOfMeasure rdf:type rdf:Property ;
    rdfs:label 'Size Unit Of Measure' ;
    rdfs:comment 'Standard unit of measure used to express the principal sizing attribute for assets of this class (e.g., \'inches\' for pipe diameter, \'HP\' for pump motor horsepower, \'kVA\' for transformer capacity, \'GPM\' for flow capacity). Ensures consistent sizing data entry across the asset registry. [ENUM-REF-CANDIDATE: inches|mm|feet|meters|kVA|HP|kW|GPM|MGD|gallons|cubic feet — promote to reference product]' ;
    rdfs:domain ind:AssetClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sparePartsRequired rdf:type rdf:Property ;
    rdfs:label 'Spare Parts Required' ;
    rdfs:comment 'Indicates whether assets of this class typically require dedicated spare parts inventory to be maintained in the storeroom (SAP MM / Maximo Inventory). True for critical rotating equipment and instrumentation; False for passive civil assets.' ;
    rdfs:domain ind:AssetClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:workOrderTypeDefault rdf:type rdf:Property ;
    rdfs:label 'Work Order Type Default' ;
    rdfs:comment 'Default work order type generated in IBM Maximo for assets of this class when a maintenance event is triggered. Drives labor planning, cost coding, and CAPEX vs OPEX classification of maintenance expenditures.' ;
    rdfs:domain ind:AssetClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:parentLocationId rdf:type rdf:Property ;
    rdfs:label 'Parent Location Id' ;
    rdfs:comment 'Reference to the parent location in the hierarchical location structure (e.g., a room\'s parent is a floor, a floor\'s parent is a building).' ;
    rdfs:domain ind:Location ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Location .

ind:accessRestrictions rdf:type rdf:Property ;
    rdfs:label 'Access Restrictions' ;
    rdfs:comment 'Description of physical or security access restrictions for the location (e.g., \'Restricted - Badge Required\', \'Public Access\', \'Confined Space\').' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:areaSquareFeet rdf:type rdf:Property ;
    rdfs:label 'Area Square Feet' ;
    rdfs:comment 'Physical area of the location in square feet, used for space planning and asset density analysis.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:capacityRating rdf:type rdf:Property ;
    rdfs:label 'Capacity Rating' ;
    rdfs:comment 'Rated capacity of the location for asset storage or operational throughput (e.g., MGD for treatment facilities, gallons for storage tanks).' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dmaZone rdf:type rdf:Property ;
    rdfs:label 'Dma Zone' ;
    rdfs:comment 'District Metered Area zone identifier for water distribution network segmentation and Non-Revenue Water (NRW) analysis.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:environmentalConditions rdf:type rdf:Property ;
    rdfs:label 'Environmental Conditions' ;
    rdfs:comment 'Description of environmental conditions at the location (e.g., \'Indoor Climate Controlled\', \'Outdoor Exposed\', \'Wet Environment\', \'Corrosive Atmosphere\').' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:floorLevel rdf:type rdf:Property ;
    rdfs:label 'Floor Level' ;
    rdfs:comment 'Floor or level number within a building (e.g., 1 for ground floor, 2 for second floor, -1 for basement).' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:hazardClassification rdf:type rdf:Property ;
    rdfs:label 'Hazard Classification' ;
    rdfs:comment 'Safety hazard classification for the location (e.g., \'Confined Space\', \'High Voltage\', \'Chemical Storage\', \'None\').' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:locationStatus rdf:type rdf:Property ;
    rdfs:label 'Location Status' ;
    rdfs:comment 'Current operational status of the location in its lifecycle.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:locationType rdf:type rdf:Property ;
    rdfs:label 'Location Type' ;
    rdfs:comment 'Classification of the location type within the asset hierarchy.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maximoLocationCode rdf:type rdf:Property ;
    rdfs:label 'Maximo Location Code' ;
    rdfs:comment 'Location identifier in IBM Maximo CMMS for work order management and maintenance routing integration.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryJurisdiction rdf:type rdf:Property ;
    rdfs:label 'Regulatory Jurisdiction' ;
    rdfs:comment 'Regulatory jurisdiction or primacy agency responsible for oversight (e.g., state EPA, local health department).' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:roomNumber rdf:type rdf:Property ;
    rdfs:label 'Room Number' ;
    rdfs:comment 'Room or space identifier within a floor or building (e.g., \'Room 101\', \'Electrical Vault A\').' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sapFunctionalLocation rdf:type rdf:Property ;
    rdfs:label 'Sap Functional Location' ;
    rdfs:comment 'SAP PM functional location code for asset hierarchy and maintenance planning integration.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scadaIntegrationFlag rdf:type rdf:Property ;
    rdfs:label 'Scada Integration Flag' ;
    rdfs:comment 'Indicates whether the location is integrated with SCADA systems (OSIsoft PI Historian) for real-time monitoring and control.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:serviceTerritory rdf:type rdf:Property ;
    rdfs:label 'Service Territory' ;
    rdfs:comment 'Service territory or jurisdiction code defining the geographic area served by the utility.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:spatialReferenceCode rdf:type rdf:Property ;
    rdfs:label 'Spatial Reference Code' ;
    rdfs:comment 'Coordinate system reference identifier (EPSG code) used for GIS spatial data (e.g., \'EPSG:4326\' for WGS 84).' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:watershed rdf:type rdf:Property ;
    rdfs:label 'Watershed' ;
    rdfs:comment 'Watershed or drainage basin identifier for regulatory reporting and environmental compliance under the Clean Water Act (CWA).' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gisLocationId rdf:type rdf:Property ;
    rdfs:label 'Gis Location Id' ;
    rdfs:comment 'Reference to the asset location in the Geographic Information System (GIS), enabling spatial analysis and mapping of condition assessment results.' ;
    rdfs:domain ind:ConditionAssessment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Location .

ind:approvedDate rdf:type rdf:Property ;
    rdfs:label 'Approved Date' ;
    rdfs:comment 'Date when the assessment was formally approved by management.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:assessmentDate rdf:type rdf:Property ;
    rdfs:label 'Assessment Date' ;
    rdfs:comment 'The date on which the condition assessment was performed in the field.' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:assessmentIntervalMonths rdf:type rdf:Property ;
    rdfs:label 'Assessment Interval Months' ;
    rdfs:comment 'Standard inspection frequency interval in months for this asset type and condition grade.' ;
    rdfs:domain ind:ConditionAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:assessmentMethod rdf:type rdf:Property ;
    rdfs:label 'Assessment Method' ;
    rdfs:comment 'The inspection or testing method used to assess asset condition. Common methods include visual inspection, Closed-Circuit Television (CCTV) for pipes, acoustic leak detection, vibration analysis for rotating equipment, ultrasonic thickness measurement for corrosion, infrared thermography for electrical systems, and various hydraulic testing methods. [ENUM-REF-CANDIDATE: visual|cctv|acoustic|vibration_analysis|ultrasonic_thickness|infrared_thermography|dye_testing|smoke_testing|pressure_testing|flow_testing|electrical_testing|corrosion_survey — 12 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:ConditionAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assessmentNumber rdf:type rdf:Property ;
    rdfs:label 'Assessment Number' ;
    rdfs:comment 'Business identifier for the condition assessment, typically generated by the Computerized Maintenance Management System (CMMS) or inspection system.' ;
    rdfs:domain ind:ConditionAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assessmentStatus rdf:type rdf:Property ;
    rdfs:label 'Assessment Status' ;
    rdfs:comment 'Current workflow status of the condition assessment record: scheduled, in progress, completed (field work done), reviewed (technical review complete), approved (management sign-off), or cancelled.' ;
    rdfs:domain ind:ConditionAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assessmentTimestamp rdf:type rdf:Property ;
    rdfs:label 'Assessment Timestamp' ;
    rdfs:comment 'Precise date and time when the condition assessment was completed, including time zone information.' ;
    rdfs:domain ind:ConditionAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:assessmentType rdf:type rdf:Property ;
    rdfs:label 'Assessment Type' ;
    rdfs:comment 'Classification of the assessment purpose: routine scheduled inspection, preventive maintenance assessment, reactive inspection following an incident, condition-based monitoring, regulatory compliance inspection, pre-failure investigation, post-repair verification, or new asset commissioning. [ENUM-REF-CANDIDATE: routine|preventive|reactive|condition_based|regulatory|pre_failure|post_repair|commissioning — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:ConditionAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceStandard rdf:type rdf:Property ;
    rdfs:label 'Compliance Standard' ;
    rdfs:comment 'Specific regulatory standard, code, or requirement that this assessment addresses (e.g., SDWA Section 1433, AWWA C651, NFPA 25).' ;
    rdfs:domain ind:ConditionAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:criticalDefectCount rdf:type rdf:Property ;
    rdfs:label 'Critical Defect Count' ;
    rdfs:comment 'Number of critical or high-severity defects requiring immediate attention or corrective action.' ;
    rdfs:domain ind:ConditionAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:defectDescription rdf:type rdf:Property ;
    rdfs:label 'Defect Description' ;
    rdfs:comment 'Detailed narrative description of defects, damage, deterioration, or performance issues observed during the assessment.' ;
    rdfs:domain ind:ConditionAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedRepairCost rdf:type rdf:Property ;
    rdfs:label 'Estimated Repair Cost' ;
    rdfs:comment 'Preliminary cost estimate for recommended repair or rehabilitation work, used for Capital Expenditure (CAPEX) and Operating Expenditure (OPEX) planning.' ;
    rdfs:domain ind:ConditionAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:estimatedReplacementCost rdf:type rdf:Property ;
    rdfs:label 'Estimated Replacement Cost' ;
    rdfs:comment 'Estimated cost to fully replace the asset with equivalent new equipment or infrastructure.' ;
    rdfs:domain ind:ConditionAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:failureProbability rdf:type rdf:Property ;
    rdfs:label 'Failure Probability' ;
    rdfs:comment 'Statistical probability (0.0000 to 1.0000) of asset failure within the next planning period, calculated from condition data, age, and historical failure rates.' ;
    rdfs:domain ind:ConditionAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:inspectionEquipmentUsed rdf:type rdf:Property ;
    rdfs:label 'Inspection Equipment Used' ;
    rdfs:comment 'Description of specialized equipment, instruments, or tools used during the assessment (e.g., CCTV crawler, ultrasonic thickness gauge, vibration analyzer, acoustic leak detector).' ;
    rdfs:domain ind:ConditionAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectorCertification rdf:type rdf:Property ;
    rdfs:label 'Inspector Certification' ;
    rdfs:comment 'Professional certifications held by the inspector relevant to the assessment method (e.g., NASSCO PACP/MACP/LACP for pipeline inspection, ASNT Level II for ultrasonic testing, thermography certification).' ;
    rdfs:domain ind:ConditionAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextAssessmentDueDate rdf:type rdf:Property ;
    rdfs:label 'Next Assessment Due Date' ;
    rdfs:comment 'Scheduled date for the next condition assessment based on asset criticality, condition grade, and inspection frequency requirements.' ;
    rdfs:domain ind:ConditionAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:performanceScore rdf:type rdf:Property ;
    rdfs:label 'Performance Score' ;
    rdfs:comment 'Quantitative score (0-100 scale) representing the operational performance and efficiency of the asset relative to design specifications.' ;
    rdfs:domain ind:ConditionAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recommendedActionPriority rdf:type rdf:Property ;
    rdfs:label 'Recommended Action Priority' ;
    rdfs:comment 'Priority level for the recommended intervention: immediate (0-30 days), urgent (1-6 months), high (6-12 months), medium (1-3 years), low (3+ years).' ;
    rdfs:domain ind:ConditionAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remainingUsefulLifeYears rdf:type rdf:Property ;
    rdfs:label 'Remaining Useful Life Years' ;
    rdfs:comment 'Estimated number of years the asset can continue to operate before requiring major rehabilitation or replacement, based on current condition and deterioration rate.' ;
    rdfs:domain ind:ConditionAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reviewedDate rdf:type rdf:Property ;
    rdfs:label 'Reviewed Date' ;
    rdfs:comment 'Date when the assessment was reviewed and validated by a supervisor or subject matter expert.' ;
    rdfs:domain ind:ConditionAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:riskScore rdf:type rdf:Property ;
    rdfs:label 'Risk Score' ;
    rdfs:comment 'Composite risk score calculated as the product of failure probability and consequence of failure, used to prioritize asset renewal and Capital Improvement Program (CIP) planning.' ;
    rdfs:domain ind:ConditionAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:structuralIntegrityScore rdf:type rdf:Property ;
    rdfs:label 'Structural Integrity Score' ;
    rdfs:comment 'Quantitative score (0-100 scale) representing the structural soundness of the asset based on inspection findings. Higher scores indicate better structural condition.' ;
    rdfs:domain ind:ConditionAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:assessmentPerformedBy rdf:type rdf:Property ;
    rdfs:label 'Assessment Performed By' ;
    rdfs:comment 'Name or identifier of the person, team, or system that performed the criticality assessment. Supports audit trail and accountability for rating decisions.' ;
    rdfs:domain ind:CriticalityRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capitalRenewalPriorityRank rdf:type rdf:Property ;
    rdfs:label 'Capital Renewal Priority Rank' ;
    rdfs:comment 'Relative priority ranking for capital renewal or replacement within the asset portfolio. Lower numbers indicate higher priority. Derived from criticality tier and overall risk score.' ;
    rdfs:domain ind:CriticalityRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:cipEligibilityFlag rdf:type rdf:Property ;
    rdfs:label 'Cip Eligibility Flag' ;
    rdfs:comment 'Indicates whether this asset is eligible for inclusion in the Capital Improvement Program based on its criticality rating and condition. True if eligible for CIP funding consideration.' ;
    rdfs:domain ind:CriticalityRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:consequenceOfFailureScore rdf:type rdf:Property ;
    rdfs:label 'Consequence Of Failure Score' ;
    rdfs:comment 'Quantitative score representing the business, operational, safety, environmental, and regulatory impact if the asset fails. Typically scaled 1-100 or 1-10 depending on methodology.' ;
    rdfs:domain ind:CriticalityRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:customerImpactCount rdf:type rdf:Property ;
    rdfs:label 'Customer Impact Count' ;
    rdfs:comment 'Estimated number of customers or service connections that would be affected by failure of this asset. Used to quantify consequence of failure for distribution and collection system assets.' ;
    rdfs:domain ind:CriticalityRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:financialImpactAmount rdf:type rdf:Property ;
    rdfs:label 'Financial Impact Amount' ;
    rdfs:comment 'Estimated financial consequence of asset failure including emergency repair costs, lost revenue, regulatory fines, and liability claims. Expressed in USD.' ;
    rdfs:domain ind:CriticalityRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:likelihoodOfFailureScore rdf:type rdf:Property ;
    rdfs:label 'Likelihood Of Failure Score' ;
    rdfs:comment 'Quantitative score representing the probability of asset failure based on age, condition, maintenance history, and operating environment. Typically scaled 1-100 or 1-10 depending on methodology.' ;
    rdfs:domain ind:CriticalityRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:methodologyVersion rdf:type rdf:Property ;
    rdfs:label 'Methodology Version' ;
    rdfs:comment 'Version identifier of the criticality assessment methodology used to calculate this rating. Enables tracking of methodology changes over time and ensures consistent application across asset portfolio.' ;
    rdfs:domain ind:CriticalityRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextReviewDate rdf:type rdf:Property ;
    rdfs:label 'Next Review Date' ;
    rdfs:comment 'Scheduled date for the next criticality reassessment. Critical assets typically require more frequent review cycles than low-criticality assets.' ;
    rdfs:domain ind:CriticalityRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:overallRiskScore rdf:type rdf:Property ;
    rdfs:label 'Overall Risk Score' ;
    rdfs:comment 'Composite risk score calculated from Consequence of Failure and Likelihood of Failure scores. Typically computed as CoF × LoF. Used to rank assets for maintenance and capital investment prioritization.' ;
    rdfs:domain ind:CriticalityRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:preventiveMaintenanceFrequencyDays rdf:type rdf:Property ;
    rdfs:label 'Preventive Maintenance Frequency Days' ;
    rdfs:comment 'Recommended interval in days between preventive maintenance activities based on the criticality tier. Critical assets require more frequent PM than low-criticality assets.' ;
    rdfs:domain ind:CriticalityRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:publicHealthImpactFlag rdf:type rdf:Property ;
    rdfs:label 'Public Health Impact Flag' ;
    rdfs:comment 'Indicates whether failure of this asset would pose a direct threat to public health through loss of water supply, water quality degradation, or exposure to contaminants. True if public health risk exists.' ;
    rdfs:domain ind:CriticalityRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ratingEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Rating Effective Date' ;
    rdfs:comment 'The date from which this criticality rating becomes effective and is used for maintenance prioritization and capital planning decisions.' ;
    rdfs:domain ind:CriticalityRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ratingExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Rating Expiration Date' ;
    rdfs:comment 'The date when this criticality rating expires and must be reassessed. Nullable for ratings without a defined review cycle.' ;
    rdfs:domain ind:CriticalityRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ratingStatus rdf:type rdf:Property ;
    rdfs:label 'Rating Status' ;
    rdfs:comment 'Current lifecycle status of the criticality rating record. Active ratings are used for operational decisions; superseded ratings are retained for historical analysis.' ;
    rdfs:domain ind:CriticalityRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:redundancyAvailableFlag rdf:type rdf:Property ;
    rdfs:label 'Redundancy Available Flag' ;
    rdfs:comment 'Indicates whether backup or redundant assets are available to maintain service if this asset fails. True if redundancy exists, False if asset is a single point of failure.' ;
    rdfs:domain ind:CriticalityRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryConsequenceFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Consequence Flag' ;
    rdfs:comment 'Indicates whether failure of this asset would result in regulatory non-compliance, permit violations, or mandatory reporting under SDWA, CWA, or NPDES. True if regulatory consequences exist.' ;
    rdfs:domain ind:CriticalityRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reviewFrequencyMonths rdf:type rdf:Property ;
    rdfs:label 'Review Frequency Months' ;
    rdfs:comment 'Standard interval in months between criticality reassessments for this asset. Typically shorter for critical assets and longer for low-criticality assets.' ;
    rdfs:domain ind:CriticalityRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:safetyImpactFlag rdf:type rdf:Property ;
    rdfs:label 'Safety Impact Flag' ;
    rdfs:comment 'Indicates whether failure of this asset would create safety hazards for employees, contractors, or the public (e.g., chemical release, electrical hazard, structural collapse). True if safety risk exists.' ;
    rdfs:domain ind:CriticalityRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:serviceDisruptionDurationHours rdf:type rdf:Property ;
    rdfs:label 'Service Disruption Duration Hours' ;
    rdfs:comment 'Estimated duration in hours that service would be disrupted if this asset fails, accounting for repair time, parts availability, and system restoration procedures.' ;
    rdfs:domain ind:CriticalityRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:actualCost rdf:type rdf:Property ;
    rdfs:label 'Actual Cost' ;
    rdfs:comment 'Total actual cost incurred for the work order, including labor, materials, contractor services, and overhead allocations.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:actualFinishTimestamp rdf:type rdf:Property ;
    rdfs:label 'Actual Finish Timestamp' ;
    rdfs:comment 'Actual date and time when work execution was completed in the field.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:actualLaborHours rdf:type rdf:Property ;
    rdfs:label 'Actual Labor Hours' ;
    rdfs:comment 'Total labor hours actually expended on the work order, captured from time sheets and labor transactions.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:actualStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Actual Start Timestamp' ;
    rdfs:comment 'Actual date and time when work execution began in the field.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:assignedTo rdf:type rdf:Property ;
    rdfs:label 'Assigned To' ;
    rdfs:comment 'Name or identifier of the technician, crew, or contractor assigned to execute the work order.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:completionNotes rdf:type rdf:Property ;
    rdfs:label 'Completion Notes' ;
    rdfs:comment 'Detailed narrative entered by the technician upon work completion, documenting findings, actions taken, parts replaced, and any follow-up recommendations.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:downtimeDurationHours rdf:type rdf:Property ;
    rdfs:label 'Downtime Duration Hours' ;
    rdfs:comment 'Total hours the asset was out of service or unavailable due to this maintenance activity, critical for calculating Mean Time Between Failures (MTBF) and Mean Time To Repair (MTTR) Key Performance Indicators (KPIs).' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:estimatedCost rdf:type rdf:Property ;
    rdfs:label 'Estimated Cost' ;
    rdfs:comment 'Planned total cost for the work order including labor, materials, and services, used for budgeting and Capital Expenditure (CAPEX) / Operating Expenditure (OPEX) planning.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:estimatedLaborHours rdf:type rdf:Property ;
    rdfs:label 'Estimated Labor Hours' ;
    rdfs:comment 'Planned total labor hours required to complete the work order, used for resource planning and scheduling.' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:failureCode rdf:type rdf:Property ;
    rdfs:label 'Failure Code' ;
    rdfs:comment 'Standardized code identifying the type of failure or problem that triggered the work order (e.g., leak, blockage, electrical fault, mechanical wear).' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:permitRequired rdf:type rdf:Property ;
    rdfs:label 'Permit Required' ;
    rdfs:comment 'Indicates whether regulatory permits (confined space entry, hot work, excavation, discharge) are required before work can commence.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:remedyCode rdf:type rdf:Property ;
    rdfs:label 'Remedy Code' ;
    rdfs:comment 'Standardized code identifying the corrective action taken to resolve the failure (e.g., repair, replace, adjust, clean).' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:safetyPlanRequired rdf:type rdf:Property ;
    rdfs:label 'Safety Plan Required' ;
    rdfs:comment 'Indicates whether a formal safety plan, Job Safety Analysis (JSA), or Occupational Safety and Health Administration (OSHA) compliance documentation is required for this work order.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:scheduledFinishDate rdf:type rdf:Property ;
    rdfs:label 'Scheduled Finish Date' ;
    rdfs:comment 'Planned date when work is scheduled to be completed.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:scheduledStartDate rdf:type rdf:Property ;
    rdfs:label 'Scheduled Start Date' ;
    rdfs:comment 'Planned date when work is scheduled to begin.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:source rdf:type rdf:Property ;
    rdfs:label 'Source' ;
    rdfs:comment 'Origin or trigger that created the work order (preventive maintenance schedule, Supervisory Control and Data Acquisition (SCADA) alarm, customer complaint, inspection finding, operator observation, predictive analytics model, regulatory mandate). [ENUM-REF-CANDIDATE: pm_schedule|scada_alarm|customer_complaint|inspection|operator_round|predictive_analytics|regulatory_requirement — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supervisorApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Supervisor Approval Date' ;
    rdfs:comment 'Date when the work order was reviewed and approved by the maintenance supervisor or manager.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:warrantyClaim rdf:type rdf:Property ;
    rdfs:label 'Warranty Claim' ;
    rdfs:comment 'Indicates whether this work order is associated with a warranty claim against a vendor or contractor for defective equipment or workmanship.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:workOrderNumber rdf:type rdf:Property ;
    rdfs:label 'Work Order Number' ;
    rdfs:comment 'Externally visible business identifier for the work order, typically human-readable and used in field operations and reporting.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workOrderStatus rdf:type rdf:Property ;
    rdfs:label 'Work Order Status' ;
    rdfs:comment 'Current lifecycle status of the work order in the maintenance workflow, from creation through completion and closure. [ENUM-REF-CANDIDATE: draft|approved|scheduled|in_progress|on_hold|completed|closed|cancelled — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workOrderType rdf:type rdf:Property ;
    rdfs:label 'Work Order Type' ;
    rdfs:comment 'Classification of the work order by maintenance strategy: preventive maintenance (PM), corrective maintenance (CM), predictive maintenance (PdM), emergency, inspection, calibration, or capital project work. [ENUM-REF-CANDIDATE: preventive_maintenance|corrective_maintenance|predictive_maintenance|emergency|inspection|calibration|project — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assetCriticalityRating rdf:type rdf:Property ;
    rdfs:label 'Asset Criticality Rating' ;
    rdfs:comment 'Criticality classification of the asset to which this schedule applies, indicating the impact of asset failure on operations, safety, regulatory compliance, or customer service.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:autoGenerateWorkOrderFlag rdf:type rdf:Property ;
    rdfs:label 'Auto Generate Work Order Flag' ;
    rdfs:comment 'Indicates whether work orders should be automatically generated by the CMMS system when the schedule becomes due, or whether manual review and approval is required before work order creation.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:downtimeRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Downtime Required Flag' ;
    rdfs:comment 'Indicates whether the asset must be taken out of service (downtime) to perform the preventive maintenance task, requiring operational planning and backup capacity arrangements.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:estimatedDowntimeHours rdf:type rdf:Property ;
    rdfs:label 'Estimated Downtime Hours' ;
    rdfs:comment 'Estimated duration in hours that the asset will be out of service during preventive maintenance, used for operational planning and redundancy management.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:estimatedLaborCost rdf:type rdf:Property ;
    rdfs:label 'Estimated Labor Cost' ;
    rdfs:comment 'Estimated cost of labor required to complete the preventive maintenance task based on estimated hours and labor rates, used for budgeting and OPEX planning.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:estimatedMaterialCost rdf:type rdf:Property ;
    rdfs:label 'Estimated Material Cost' ;
    rdfs:comment 'Estimated cost of materials, parts, and consumables required to complete the preventive maintenance task, used for budgeting and OPEX planning.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:frequencyInterval rdf:type rdf:Property ;
    rdfs:label 'Frequency Interval' ;
    rdfs:comment 'Numeric value representing the interval between preventive maintenance occurrences, interpreted based on the frequency unit (e.g., 30 for days, 500 for hours, 1000 for gallons).' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:frequencyUnit rdf:type rdf:Property ;
    rdfs:label 'Frequency Unit' ;
    rdfs:comment 'Unit of measure for the frequency interval, defining whether the schedule is based on time periods (days, weeks, months, years), operating hours, operational cycles, or volume processed (gallons, cubic meters). [ENUM-REF-CANDIDATE: days|weeks|months|years|hours|cycles|gallons|cubic_meters — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastModifiedBy rdf:type rdf:Property ;
    rdfs:label 'Last Modified By' ;
    rdfs:comment 'Username or identifier of the user who last modified this preventive maintenance schedule record.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastPerformedDate rdf:type rdf:Property ;
    rdfs:label 'Last Performed Date' ;
    rdfs:comment 'Date when the preventive maintenance task was last completed, used to calculate the next due date for calendar-based schedules.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:leadTimeDays rdf:type rdf:Property ;
    rdfs:label 'Lead Time Days' ;
    rdfs:comment 'Number of days before the next due date that the work order should be generated to allow for planning, scheduling, and resource allocation.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:maintenanceTaskDescription rdf:type rdf:Property ;
    rdfs:label 'Maintenance Task Description' ;
    rdfs:comment 'Detailed description of the preventive maintenance task to be performed, including specific procedures, inspections, or servicing activities required.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:meterThreshold rdf:type rdf:Property ;
    rdfs:label 'Meter Threshold' ;
    rdfs:comment 'Threshold value for meter-based preventive maintenance triggers; when the asset meter reading reaches or exceeds this value, a work order is automatically generated.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nextDueDate rdf:type rdf:Property ;
    rdfs:label 'Next Due Date' ;
    rdfs:comment 'Calculated date when the next preventive maintenance work order should be generated based on the schedule frequency and last performed date.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:regulatoryReference rdf:type rdf:Property ;
    rdfs:label 'Regulatory Reference' ;
    rdfs:comment 'Citation or reference to the specific regulatory requirement, permit condition, or compliance standard that mandates this preventive maintenance activity (e.g., SDWA Section 1412, NPDES Permit Condition 3.2).' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requiredSkillCertifications rdf:type rdf:Property ;
    rdfs:label 'Required Skill Certifications' ;
    rdfs:comment 'Comma-separated list of required skill certifications or qualifications that technicians must possess to perform this preventive maintenance task safely and effectively (e.g., electrical license, confined space entry, SCADA operator certification).' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:safetyRequirements rdf:type rdf:Property ;
    rdfs:label 'Safety Requirements' ;
    rdfs:comment 'Description of safety precautions, personal protective equipment (PPE), lockout/tagout procedures, confined space entry protocols, or other safety measures required for this preventive maintenance task.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduleName rdf:type rdf:Property ;
    rdfs:label 'Schedule Name' ;
    rdfs:comment 'Descriptive name of the preventive maintenance schedule for easy identification by operations and maintenance staff.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduleNumber rdf:type rdf:Property ;
    rdfs:label 'Schedule Number' ;
    rdfs:comment 'Business identifier for the preventive maintenance schedule, typically assigned by the CMMS system for tracking and reporting purposes.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduleStatus rdf:type rdf:Property ;
    rdfs:label 'Schedule Status' ;
    rdfs:comment 'Current lifecycle status of the preventive maintenance schedule indicating whether it is actively generating work orders or has been suspended or deactivated.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:seasonalEndMonth rdf:type rdf:Property ;
    rdfs:label 'Seasonal End Month' ;
    rdfs:comment 'Month number (1-12) when seasonal preventive maintenance schedule becomes inactive, applicable only when seasonal_schedule_flag is true.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:seasonalScheduleFlag rdf:type rdf:Property ;
    rdfs:label 'Seasonal Schedule Flag' ;
    rdfs:comment 'Indicates whether this preventive maintenance schedule is seasonal in nature, applicable only during specific months or seasons (e.g., winterization of outdoor equipment, summer peak demand preparation).' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:seasonalStartMonth rdf:type rdf:Property ;
    rdfs:label 'Seasonal Start Month' ;
    rdfs:comment 'Month number (1-12) when seasonal preventive maintenance schedule becomes active, applicable only when seasonal_schedule_flag is true.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:triggerType rdf:type rdf:Property ;
    rdfs:label 'Trigger Type' ;
    rdfs:comment 'Type of trigger mechanism that determines when preventive maintenance is due: calendar-based (time intervals), meter-based (usage thresholds), condition-based (sensor readings), runtime-based (operating hours), or cycle-based (number of operations).' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workZone rdf:type rdf:Property ;
    rdfs:label 'Work Zone' ;
    rdfs:comment 'Specific work zone, area, or department within the facility where the preventive maintenance activity will take place, used for crew assignment and access control.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:createdBy rdf:type rdf:Property ;
    rdfs:label 'Created By' ;
    rdfs:comment 'Username or identifier of the user who created this preventive maintenance schedule record in the CMMS system.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actualRepairCost rdf:type rdf:Property ;
    rdfs:label 'Actual Repair Cost' ;
    rdfs:comment 'Actual total cost incurred to repair or replace the failed asset after work completion.' ;
    rdfs:domain ind:FailureRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:affectedSystem rdf:type rdf:Property ;
    rdfs:label 'Affected System' ;
    rdfs:comment 'The operational system or process affected by the failure (e.g., high service pump station, chlorination system, SCADA network, distribution main).' ;
    rdfs:domain ind:FailureRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:correctiveActionsRecommended rdf:type rdf:Property ;
    rdfs:label 'Corrective Actions Recommended' ;
    rdfs:comment 'List of recommended corrective and preventive actions to prevent recurrence of similar failures.' ;
    rdfs:domain ind:FailureRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:csoEventFlag rdf:type rdf:Property ;
    rdfs:label 'Cso Event Flag' ;
    rdfs:comment 'Boolean flag indicating whether the failure resulted in a Combined Sewer Overflow event requiring regulatory reporting.' ;
    rdfs:domain ind:FailureRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:detectionMethod rdf:type rdf:Property ;
    rdfs:label 'Detection Method' ;
    rdfs:comment 'Method by which the failure was discovered (SCADA alarm, operator inspection, customer complaint, etc.). [ENUM-REF-CANDIDATE: scada_alarm|operator_inspection|customer_complaint|scheduled_inspection|predictive_maintenance|routine_testing|emergency_response — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:FailureRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:emergencyResponseActions rdf:type rdf:Property ;
    rdfs:label 'Emergency Response Actions' ;
    rdfs:comment 'Detailed description of immediate emergency response actions taken to mitigate the failure (e.g., valve isolation, backup system activation, customer notification).' ;
    rdfs:domain ind:FailureRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:environmentalImpactDescription rdf:type rdf:Property ;
    rdfs:label 'Environmental Impact Description' ;
    rdfs:comment 'Description of any environmental impact resulting from the failure (e.g., water body contamination, soil contamination, habitat damage).' ;
    rdfs:domain ind:FailureRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:failureCause rdf:type rdf:Property ;
    rdfs:label 'Failure Cause' ;
    rdfs:comment 'Identified root cause of the failure (e.g., age-related deterioration, improper installation, inadequate maintenance, design deficiency, operational error, external damage).' ;
    rdfs:domain ind:FailureRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:failureCriticalityScore rdf:type rdf:Property ;
    rdfs:label 'Failure Criticality Score' ;
    rdfs:comment 'Calculated criticality score based on failure severity, service impact, and asset importance (typically 1-100 scale).' ;
    rdfs:domain ind:FailureRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:failureDate rdf:type rdf:Property ;
    rdfs:label 'Failure Date' ;
    rdfs:comment 'Calendar date when the asset failure occurred.' ;
    rdfs:domain ind:FailureRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:failureEffect rdf:type rdf:Property ;
    rdfs:label 'Failure Effect' ;
    rdfs:comment 'Description of the operational impact and consequences of the failure on system performance and service delivery.' ;
    rdfs:domain ind:FailureRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:failureMode rdf:type rdf:Property ;
    rdfs:label 'Failure Mode' ;
    rdfs:comment 'Classification of how the asset failed (e.g., mechanical fracture, electrical short, corrosion perforation, seal leakage, bearing seizure, control malfunction).' ;
    rdfs:domain ind:FailureRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:failureNumber rdf:type rdf:Property ;
    rdfs:label 'Failure Number' ;
    rdfs:comment 'Business-readable unique identifier for the failure event, typically auto-generated by CMMS.' ;
    rdfs:domain ind:FailureRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:failureSeverity rdf:type rdf:Property ;
    rdfs:label 'Failure Severity' ;
    rdfs:comment 'Severity classification of the failure based on service impact, safety risk, and regulatory implications.' ;
    rdfs:domain ind:FailureRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:failureStatus rdf:type rdf:Property ;
    rdfs:label 'Failure Status' ;
    rdfs:comment 'Current lifecycle status of the failure record in the investigation and resolution workflow.' ;
    rdfs:domain ind:FailureRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:failureTime rdf:type rdf:Property ;
    rdfs:label 'Failure Time' ;
    rdfs:comment 'Precise date and time when the asset failure was detected or occurred.' ;
    rdfs:domain ind:FailureRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:mtbfImpactFlag rdf:type rdf:Property ;
    rdfs:label 'Mtbf Impact Flag' ;
    rdfs:comment 'Boolean flag indicating whether this failure event should be included in MTBF reliability calculations for the asset class.' ;
    rdfs:domain ind:FailureRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mttrHours rdf:type rdf:Property ;
    rdfs:label 'Mttr Hours' ;
    rdfs:comment 'Measured time in hours from failure detection to restoration of asset to full operational status.' ;
    rdfs:domain ind:FailureRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:overflowVolumeGallons rdf:type rdf:Property ;
    rdfs:label 'Overflow Volume Gallons' ;
    rdfs:comment 'Estimated volume of wastewater overflow in gallons resulting from SSO or CSO event, if applicable.' ;
    rdfs:domain ind:FailureRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pressureDropPsi rdf:type rdf:Property ;
    rdfs:label 'Pressure Drop Psi' ;
    rdfs:comment 'Measured drop in system pressure (PSI) resulting from the failure event.' ;
    rdfs:domain ind:FailureRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:productionLossMgd rdf:type rdf:Property ;
    rdfs:label 'Production Loss Mgd' ;
    rdfs:comment 'Estimated water production capacity lost due to the failure, measured in Million Gallons per Day.' ;
    rdfs:domain ind:FailureRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatoryNotificationDate rdf:type rdf:Property ;
    rdfs:label 'Regulatory Notification Date' ;
    rdfs:comment 'Date when regulatory agencies were notified of the failure event, if applicable.' ;
    rdfs:domain ind:FailureRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:repairCostEstimate rdf:type rdf:Property ;
    rdfs:label 'Repair Cost Estimate' ;
    rdfs:comment 'Estimated total cost to repair or replace the failed asset, including labor, materials, and contractor costs.' ;
    rdfs:domain ind:FailureRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:resolutionDate rdf:type rdf:Property ;
    rdfs:label 'Resolution Date' ;
    rdfs:comment 'Date when the failure was fully resolved and the asset was restored to normal operation.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:rootCauseAnalysisFindings rdf:type rdf:Property ;
    rdfs:label 'Root Cause Analysis Findings' ;
    rdfs:comment 'Detailed findings and conclusions from the root cause analysis investigation, including contributing factors and systemic issues identified.' ;
    rdfs:domain ind:FailureRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceInterruptionFlag rdf:type rdf:Property ;
    rdfs:label 'Service Interruption Flag' ;
    rdfs:comment 'Boolean flag indicating whether the failure resulted in a complete service interruption to customers.' ;
    rdfs:domain ind:FailureRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ssoEventFlag rdf:type rdf:Property ;
    rdfs:label 'Sso Event Flag' ;
    rdfs:comment 'Boolean flag indicating whether the failure resulted in a Sanitary Sewer Overflow event requiring regulatory reporting.' ;
    rdfs:domain ind:FailureRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:warrantyClaimFlag rdf:type rdf:Property ;
    rdfs:label 'Warranty Claim Flag' ;
    rdfs:comment 'Boolean flag indicating whether the failure is covered under manufacturer or contractor warranty and a claim was filed.' ;
    rdfs:domain ind:FailureRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:acquisitionId rdf:type rdf:Property ;
    rdfs:label 'Acquisition Id' ;
    rdfs:comment 'Unique identifier for the asset acquisition record. Primary key for the asset acquisition data product.' ;
    rdfs:domain ind:Acquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:primaryAcquisitionAssetRegistryId rdf:type rdf:Property ;
    rdfs:label 'Primary Acquisition Asset Registry Id' ;
    rdfs:comment 'Reference to the asset being acquired in the asset registry. Links this acquisition to the corresponding asset_registry record.' ;
    rdfs:domain ind:Acquisition ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Registry .

ind:acquisitionStatus rdf:type rdf:Property ;
    rdfs:label 'Acquisition Status' ;
    rdfs:comment 'Current status of the acquisition record in the workflow. Tracks progression from initiation through completion and asset registry creation.' ;
    rdfs:domain ind:Acquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:acquisitionType rdf:type rdf:Property ;
    rdfs:label 'Acquisition Type' ;
    rdfs:comment 'Method by which the asset was acquired into the utility\'s asset base. Determines accounting treatment and capitalization rules.' ;
    rdfs:domain ind:Acquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capitalizationThresholdAmount rdf:type rdf:Property ;
    rdfs:label 'Capitalization Threshold Amount' ;
    rdfs:comment 'Minimum dollar amount threshold for capitalizing an asset as defined by the utility\'s accounting policy. Typically ranges from $1,000 to $5,000 for water utilities.' ;
    rdfs:domain ind:Acquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:capitalizationThresholdMetFlag rdf:type rdf:Property ;
    rdfs:label 'Capitalization Threshold Met Flag' ;
    rdfs:comment 'Indicates whether the acquisition cost meets the utility\'s capitalization threshold for fixed asset recording. Determines if asset is capitalized or expensed.' ;
    rdfs:domain ind:Acquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cost rdf:type rdf:Property ;
    rdfs:label 'Cost' ;
    rdfs:comment 'Total cost of acquiring the asset including purchase price, installation, freight, and other capitalizable costs. Basis for depreciation calculation.' ;
    rdfs:domain ind:Acquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fundingSource rdf:type rdf:Property ;
    rdfs:label 'Funding Source' ;
    rdfs:comment 'Source of funds used to finance the asset acquisition. Critical for Capital Expenditure (CAPEX) tracking and regulatory rate case filings.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grantAwardNum rdf:type rdf:Property ;
    rdfs:label 'Grant Award Num' ;
    rdfs:comment 'Unique identifier for the grant award that funded the acquisition, required for grant compliance reporting.' ;
    rdfs:domain ind:Acquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grantProgramName rdf:type rdf:Property ;
    rdfs:label 'Grant Program Name' ;
    rdfs:comment 'Name of the federal, state, or local grant program that funded the acquisition, if applicable. Examples include EPA Water Infrastructure Finance and Innovation Act (WIFIA) or State Revolving Fund (SRF).' ;
    rdfs:domain ind:Acquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:initialConditionGrade rdf:type rdf:Property ;
    rdfs:label 'Initial Condition Grade' ;
    rdfs:comment 'Condition assessment grade assigned at the time of acquisition. Baseline for future condition monitoring and asset health tracking.' ;
    rdfs:domain ind:Acquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:purchaseOrderNum rdf:type rdf:Property ;
    rdfs:label 'Purchase Order Num' ;
    rdfs:comment 'Purchase order number from SAP Materials Management (MM) or procurement system authorizing the asset acquisition. Links to procurement transaction.' ;
    rdfs:domain ind:Acquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:salvageValue rdf:type rdf:Property ;
    rdfs:label 'Salvage Value' ;
    rdfs:comment 'Estimated residual value of the asset at the end of its useful life. Used in depreciation calculation for certain methods.' ;
    rdfs:domain ind:Acquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:warrantyDurationMonths rdf:type rdf:Property ;
    rdfs:label 'Warranty Duration Months' ;
    rdfs:comment 'Duration of the warranty period in months. Calculated from warranty start and expiry dates for reporting purposes.' ;
    rdfs:domain ind:Acquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:warrantyStartDate rdf:type rdf:Property ;
    rdfs:label 'Warranty Start Date' ;
    rdfs:comment 'Date on which the manufacturer or contractor warranty period begins for the acquired asset.' ;
    rdfs:domain ind:Acquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:workOrderNum rdf:type rdf:Property ;
    rdfs:label 'Work Order Num' ;
    rdfs:comment 'Work order number from IBM Maximo or SAP PM for construction or installation activities related to the acquisition.' ;
    rdfs:domain ind:Acquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:checklistVersion rdf:type rdf:Property ;
    rdfs:label 'Checklist Version' ;
    rdfs:comment 'Version identifier of the inspection checklist used, ensuring traceability to specific regulatory or operational standards.' ;
    rdfs:domain ind:InspectionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:correctiveActionDueDate rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Due Date' ;
    rdfs:comment 'Target date by which identified deficiencies must be remediated, based on regulatory or operational requirements.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:correctiveActionRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Required Flag' ;
    rdfs:comment 'Indicates whether corrective action work orders or follow-up activities are required as a result of this inspection.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:criticalDeficiencyFlag rdf:type rdf:Property ;
    rdfs:label 'Critical Deficiency Flag' ;
    rdfs:comment 'Indicates whether any critical or high-severity deficiencies were identified that require immediate corrective action.' ;
    rdfs:domain ind:InspectionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:deficienciesIdentifiedCount rdf:type rdf:Property ;
    rdfs:label 'Deficiencies Identified Count' ;
    rdfs:comment 'Total number of deficiencies, non-conformances, or issues identified during the inspection.' ;
    rdfs:domain ind:InspectionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:deficiencySummary rdf:type rdf:Property ;
    rdfs:label 'Deficiency Summary' ;
    rdfs:comment 'Summary description of all deficiencies identified during the inspection, including severity and recommended actions.' ;
    rdfs:domain ind:InspectionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectionEndTime rdf:type rdf:Property ;
    rdfs:label 'Inspection End Time' ;
    rdfs:comment 'Timestamp when the inspection activity was completed.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:inspectionNotes rdf:type rdf:Property ;
    rdfs:label 'Inspection Notes' ;
    rdfs:comment 'Free-text field for inspector observations, comments, and detailed findings from the inspection.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectionStartTime rdf:type rdf:Property ;
    rdfs:label 'Inspection Start Time' ;
    rdfs:comment 'Timestamp when the inspection activity commenced.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:inspectorCertificationNum rdf:type rdf:Property ;
    rdfs:label 'Inspector Certification Num' ;
    rdfs:comment 'Professional certification or license number of the inspector, if required by regulatory authority.' ;
    rdfs:domain ind:InspectionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maximoInspectionNum rdf:type rdf:Property ;
    rdfs:label 'Maximo Inspection Num' ;
    rdfs:comment 'External inspection identifier from IBM Maximo CMMS system.' ;
    rdfs:domain ind:InspectionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:passFailOutcome rdf:type rdf:Property ;
    rdfs:label 'Pass Fail Outcome' ;
    rdfs:comment 'Overall pass/fail result of the inspection based on checklist criteria and regulatory requirements.' ;
    rdfs:domain ind:InspectionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryInspectionFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Inspection Flag' ;
    rdfs:comment 'Indicates whether this inspection was mandated by a regulatory authority (EPA, state primacy agency, OSHA) or was voluntary/internal.' ;
    rdfs:domain ind:InspectionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reportSubmissionDate rdf:type rdf:Property ;
    rdfs:label 'Report Submission Date' ;
    rdfs:comment 'Date on which the inspection report was submitted to the regulatory authority.' ;
    rdfs:domain ind:InspectionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reportSubmittedFlag rdf:type rdf:Property ;
    rdfs:label 'Report Submitted Flag' ;
    rdfs:comment 'Indicates whether the inspection report has been submitted to the regulatory authority, if required.' ;
    rdfs:domain ind:InspectionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:safetyIncidentFlag rdf:type rdf:Property ;
    rdfs:label 'Safety Incident Flag' ;
    rdfs:comment 'Indicates whether a safety incident or near-miss occurred during the inspection activity.' ;
    rdfs:domain ind:InspectionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:accessType rdf:type rdf:Property ;
    rdfs:label 'Access Type' ;
    rdfs:comment 'Classification of physical access requirements for sampling personnel. Public = open access; restricted = requires authorization; private property = requires owner permission; confined space = requires confined space entry procedures; remote = difficult to reach, may require special equipment.' ;
    rdfs:domain ind:SamplingPoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ccrReportingFlag rdf:type rdf:Property ;
    rdfs:label 'Ccr Reporting Flag' ;
    rdfs:comment 'Indicates whether water quality results from this sampling point must be included in the annual Consumer Confidence Report (CCR) to customers. True = included in CCR; False = not included.' ;
    rdfs:domain ind:SamplingPoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastSampleDate rdf:type rdf:Property ;
    rdfs:label 'Last Sample Date' ;
    rdfs:comment 'The most recent date on which a sample was collected from this sampling point. Used to track compliance with sampling schedules and identify overdue sampling locations.' ;
    rdfs:domain ind:SamplingPoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:modifiedBy rdf:type rdf:Property ;
    rdfs:label 'Modified By' ;
    rdfs:comment 'The username or identifier of the person who last modified this sampling point record.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextScheduledSampleDate rdf:type rdf:Property ;
    rdfs:label 'Next Scheduled Sample Date' ;
    rdfs:comment 'The next planned date for sample collection at this location based on the regulatory or operational sampling schedule.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:primaryContaminantGroup rdf:type rdf:Property ;
    rdfs:label 'Primary Contaminant Group' ;
    rdfs:comment 'The primary category of contaminants monitored at this sampling point (e.g., \'Microbiological\', \'Disinfection Byproducts\', \'Inorganic Chemicals\', \'Organic Chemicals\', \'Radionuclides\', \'Nutrients\', \'Metals\'). Used to organize sampling schedules and laboratory workflows.' ;
    rdfs:domain ind:SamplingPoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryZone rdf:type rdf:Property ;
    rdfs:label 'Regulatory Zone' ;
    rdfs:comment 'The regulatory monitoring zone or district to which this sampling point is assigned for compliance reporting purposes. Used to aggregate results for Consumer Confidence Report (CCR) and Discharge Monitoring Report (DMR).' ;
    rdfs:domain ind:SamplingPoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:residenceTimeHours rdf:type rdf:Property ;
    rdfs:label 'Residence Time Hours' ;
    rdfs:comment 'The estimated water residence time in hours from the treatment plant to this sampling point in the distribution system. Critical for disinfection Contact Time (CT) calculations and Disinfection Byproduct (DBP) formation analysis.' ;
    rdfs:domain ind:SamplingPoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:responsibleDepartment rdf:type rdf:Property ;
    rdfs:label 'Responsible Department' ;
    rdfs:comment 'The internal department or division responsible for sampling at this location (e.g., \'Water Quality Lab\', \'Distribution Operations\', \'Wastewater Operations\', \'Compliance\').' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:safetyNotes rdf:type rdf:Property ;
    rdfs:label 'Safety Notes' ;
    rdfs:comment 'Safety considerations and hazards specific to this sampling location (e.g., confined space, traffic hazards, chemical exposure, biological hazards, electrical equipment).' ;
    rdfs:domain ind:SamplingPoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sampleCollectionMethod rdf:type rdf:Property ;
    rdfs:label 'Sample Collection Method' ;
    rdfs:comment 'The method by which samples are collected at this point. Grab = single point-in-time sample; composite = time- or flow-weighted composite over a period; continuous monitor = automated real-time sensor; passive sampler = diffusion-based accumulation.' ;
    rdfs:domain ind:SamplingPoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:samplerName rdf:type rdf:Property ;
    rdfs:label 'Sampler Name' ;
    rdfs:comment 'The name of the primary field technician or automated sampler equipment responsible for routine sample collection at this location. Used for quality assurance and chain-of-custody tracking.' ;
    rdfs:domain ind:SamplingPoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:samplingFrequency rdf:type rdf:Property ;
    rdfs:label 'Sampling Frequency' ;
    rdfs:comment 'The regulatory or operational frequency at which samples must be collected from this location. Continuous = real-time monitoring (e.g., SCADA); event-based = triggered by specific conditions (e.g., storm events, process upsets). [ENUM-REF-CANDIDATE: continuous|hourly|daily|weekly|monthly|quarterly|annual|event_based — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:samplingInstructions rdf:type rdf:Property ;
    rdfs:label 'Sampling Instructions' ;
    rdfs:comment 'Detailed field instructions for sample collection at this location, including access directions, safety precautions, flushing procedures, bottle types, preservation requirements, and any site-specific protocols.' ;
    rdfs:domain ind:SamplingPoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:samplingPointStatus rdf:type rdf:Property ;
    rdfs:label 'Sampling Point Status' ;
    rdfs:comment 'Current operational status of the sampling point. Active = in regular use; inactive = not currently sampled but may be reactivated; temporarily suspended = short-term pause (e.g., construction); decommissioned = permanently retired.' ;
    rdfs:domain ind:SamplingPoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:treatmentStage rdf:type rdf:Property ;
    rdfs:label 'Treatment Stage' ;
    rdfs:comment 'For WTP or WWTP process sampling points, the specific treatment stage being monitored (e.g., \'Raw Intake\', \'Coagulation\', \'Sedimentation\', \'Filtration\', \'Disinfection\', \'Clearwell\', \'Primary Treatment\', \'Secondary Treatment\', \'Tertiary Treatment\', \'UV Disinfection\', \'Reverse Osmosis\'). Null for distribution or source sampling points.' ;
    rdfs:domain ind:SamplingPoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waterSourceType rdf:type rdf:Property ;
    rdfs:label 'Water Source Type' ;
    rdfs:comment 'The type of water source from which this sampling point draws or monitors. Surface water = rivers, lakes, reservoirs; groundwater = wells, aquifers; groundwater under influence = groundwater influenced by surface water; blended = mix of sources; purchased = water bought from another utility; recycled = reclaimed wastewater.' ;
    rdfs:domain ind:SamplingPoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:samplingScheduleId rdf:type rdf:Property ;
    rdfs:label 'Sampling Schedule Id' ;
    rdfs:comment 'Unique identifier for the sampling schedule record. Primary key.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SamplingSchedule .

ind:monitoringLocationId rdf:type rdf:Property ;
    rdfs:label 'Monitoring Location Id' ;
    rdfs:comment 'Reference to the physical location where samples are collected (e.g., treatment plant, distribution point, discharge point).' ;
    rdfs:domain ind:SamplingSchedule ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Location .

ind:annualBudgetAllocation rdf:type rdf:Property ;
    rdfs:label 'Annual Budget Allocation' ;
    rdfs:comment 'Total budget allocated in USD for this sampling schedule for the fiscal year.' ;
    rdfs:domain ind:SamplingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:complianceDeadlineDate rdf:type rdf:Property ;
    rdfs:label 'Compliance Deadline Date' ;
    rdfs:comment 'Regulatory deadline by which all samples for this schedule must be collected and analyzed to avoid violation.' ;
    rdfs:domain ind:SamplingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:costPerSample rdf:type rdf:Property ;
    rdfs:label 'Cost Per Sample' ;
    rdfs:comment 'Estimated or contracted cost in USD for each sample collection and analysis event under this schedule.' ;
    rdfs:domain ind:SamplingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:holdingTimeHours rdf:type rdf:Property ;
    rdfs:label 'Holding Time Hours' ;
    rdfs:comment 'Maximum allowable time in hours between sample collection and analysis, per regulatory or method requirements.' ;
    rdfs:domain ind:SamplingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lastSampleCollectedDate rdf:type rdf:Property ;
    rdfs:label 'Last Sample Collected Date' ;
    rdfs:comment 'Date when the most recent sample was collected under this schedule. Used to track compliance gaps.' ;
    rdfs:domain ind:SamplingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:monitoringPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Monitoring Period End Date' ;
    rdfs:comment 'End date of the monitoring period covered by this schedule. Null for ongoing/perpetual schedules.' ;
    rdfs:domain ind:SamplingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:monitoringPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Monitoring Period Start Date' ;
    rdfs:comment 'Start date of the monitoring period covered by this schedule.' ;
    rdfs:domain ind:SamplingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:notificationLeadTimeDays rdf:type rdf:Property ;
    rdfs:label 'Notification Lead Time Days' ;
    rdfs:comment 'Number of days in advance that field crews and labs should be notified before scheduled sampling events.' ;
    rdfs:domain ind:SamplingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:preservationMethod rdf:type rdf:Property ;
    rdfs:label 'Preservation Method' ;
    rdfs:comment 'Required preservation technique for samples (e.g., \'refrigerate to 4°C\', \'acidify to pH<2 with HNO3\', \'add sodium thiosulfate\', \'no preservation required\').' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryRule rdf:type rdf:Property ;
    rdfs:label 'Regulatory Rule' ;
    rdfs:comment 'The specific regulatory rule or permit condition driving this schedule (e.g., \'LCRR\', \'DBP Stage 2 Rule\', \'NPDES Permit CA0012345\', \'PFAS Monitoring Advisory\', \'SDWA Coliform Rule\').' ;
    rdfs:domain ind:SamplingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportingRequirement rdf:type rdf:Property ;
    rdfs:label 'Reporting Requirement' ;
    rdfs:comment 'Description of the reporting obligation associated with this schedule (e.g., \'Monthly Operating Report (MOR)\', \'Discharge Monitoring Report (DMR)\', \'Consumer Confidence Report (CCR)\', \'quarterly summary to state primacy agency\').' ;
    rdfs:domain ind:SamplingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sampleVolumeMl rdf:type rdf:Property ;
    rdfs:label 'Sample Volume Ml' ;
    rdfs:comment 'Required sample volume in milliliters for each collection event.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:samplesCollectedYtd rdf:type rdf:Property ;
    rdfs:label 'Samples Collected Ytd' ;
    rdfs:comment 'Count of samples collected under this schedule in the current calendar or fiscal year.' ;
    rdfs:domain ind:SamplingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:samplesPerPeriod rdf:type rdf:Property ;
    rdfs:label 'Samples Per Period' ;
    rdfs:comment 'Number of samples required per monitoring period (e.g., 4 samples per month for DBP monitoring in a large system).' ;
    rdfs:domain ind:SamplingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:samplesRequiredYtd rdf:type rdf:Property ;
    rdfs:label 'Samples Required Ytd' ;
    rdfs:comment 'Count of samples required to be collected under this schedule by this point in the calendar or fiscal year.' ;
    rdfs:domain ind:SamplingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:samplingMethod rdf:type rdf:Property ;
    rdfs:label 'Sampling Method' ;
    rdfs:comment 'Standard method or protocol for sample collection (e.g., \'EPA Method 1694\', \'Standard Methods 9060A\', \'grab sample\', \'composite 24-hour\').' ;
    rdfs:domain ind:SamplingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduleType rdf:type rdf:Property ;
    rdfs:label 'Schedule Type' ;
    rdfs:comment 'Classification of the sampling schedule purpose: regulatory (mandated by permit/rule), operational (internal monitoring), investigational (response to incident), special study (research/optimization), compliance verification, or routine.' ;
    rdfs:domain ind:SamplingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:seasonalAdjustmentFlag rdf:type rdf:Property ;
    rdfs:label 'Seasonal Adjustment Flag' ;
    rdfs:comment 'Indicates whether this schedule has seasonal variations in frequency or parameters (e.g., increased DBP monitoring in summer months).' ;
    rdfs:domain ind:SamplingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:complianceMonitoringPointId rdf:type rdf:Property ;
    rdfs:label 'Compliance Monitoring Point Id' ;
    rdfs:comment 'Reference to the regulatory compliance monitoring point associated with this sample, if applicable. Links sample to specific permit or regulatory obligation.' ;
    rdfs:domain ind:WaterSample ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Point .

ind:parentSampleWaterSampleId rdf:type rdf:Property ;
    rdfs:label 'Parent Sample Water Sample Id' ;
    rdfs:comment 'For duplicate or split samples, reference to the original parent sample from which this sample was derived. Null for primary samples.' ;
    rdfs:domain ind:WaterSample ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:WaterSample .

ind:analysisDueTimestamp rdf:type rdf:Property ;
    rdfs:label 'Analysis Due Timestamp' ;
    rdfs:comment 'Calculated deadline by which analysis must be completed to meet hold-time requirements. Derived from collection timestamp plus hold time hours.' ;
    rdfs:domain ind:WaterSample ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:collectionNotes rdf:type rdf:Property ;
    rdfs:label 'Collection Notes' ;
    rdfs:comment 'Free-text field for collector to record observations, anomalies, or special conditions at the time of collection (e.g., visible discoloration, odor, nearby construction activity, equipment malfunction).' ;
    rdfs:domain ind:WaterSample ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collectionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Collection Timestamp' ;
    rdfs:comment 'Date and time when the sample was physically collected, recorded in ISO 8601 format (yyyy-MM-ddTHH:mm:ss.SSSXXX). Critical for regulatory compliance and hold-time calculations.' ;
    rdfs:domain ind:WaterSample ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:compositeDurationHours rdf:type rdf:Property ;
    rdfs:label 'Composite Duration Hours' ;
    rdfs:comment 'For composite samples, the total time period over which the sample was collected (e.g., 24-hour composite). Null for grab samples.' ;
    rdfs:domain ind:WaterSample ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:compositeIntervalMinutes rdf:type rdf:Property ;
    rdfs:label 'Composite Interval Minutes' ;
    rdfs:comment 'For composite samples, the time interval between individual aliquot collections (e.g., every 15 minutes, every 60 minutes). Null for grab samples.' ;
    rdfs:domain ind:WaterSample ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:containerType rdf:type rdf:Property ;
    rdfs:label 'Container Type' ;
    rdfs:comment 'Type and material of the container used for sample collection (e.g., sterile plastic bottle, amber glass bottle, HDPE bottle). Must match EPA method requirements for the target analytes.' ;
    rdfs:domain ind:WaterSample ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:containerVolumeMl rdf:type rdf:Property ;
    rdfs:label 'Container Volume Ml' ;
    rdfs:comment 'Volume capacity of the sample container in milliliters (e.g., 125 mL, 500 mL, 1000 mL).' ;
    rdfs:domain ind:WaterSample ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fieldChlorineResidualMgL rdf:type rdf:Property ;
    rdfs:label 'Field Chlorine Residual Mg L' ;
    rdfs:comment 'Free or total chlorine residual measured at the time of sample collection in mg/L. Critical for disinfection monitoring and compliance with Safe Drinking Water Act (SDWA) requirements.' ;
    rdfs:domain ind:WaterSample ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fieldConductivityUsCm rdf:type rdf:Property ;
    rdfs:label 'Field Conductivity Us Cm' ;
    rdfs:comment 'Electrical conductivity measured at the time of sample collection in microsiemens per centimeter (µS/cm). Indicates total dissolved solids (TDS) and ionic content.' ;
    rdfs:domain ind:WaterSample ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fieldDissolvedOxygenMgL rdf:type rdf:Property ;
    rdfs:label 'Field Dissolved Oxygen Mg L' ;
    rdfs:comment 'Dissolved oxygen concentration measured at the time of sample collection in mg/L. Important for wastewater treatment process control and aquatic life support.' ;
    rdfs:domain ind:WaterSample ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fieldPh rdf:type rdf:Property ;
    rdfs:label 'Field Ph' ;
    rdfs:comment 'pH level measured at the time of sample collection using a calibrated field meter. Indicates acidity or alkalinity on a scale of 0-14.' ;
    rdfs:domain ind:WaterSample ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fieldTemperatureC rdf:type rdf:Property ;
    rdfs:label 'Field Temperature C' ;
    rdfs:comment 'Water temperature measured at the time of sample collection in degrees Celsius. Field measurement recorded on-site.' ;
    rdfs:domain ind:WaterSample ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fieldTurbidityNtu rdf:type rdf:Property ;
    rdfs:label 'Field Turbidity Ntu' ;
    rdfs:comment 'Turbidity measured at the time of sample collection in Nephelometric Turbidity Units (NTU) using a field turbidimeter. Indicates water clarity and particulate matter.' ;
    rdfs:domain ind:WaterSample ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:holdTimeHours rdf:type rdf:Property ;
    rdfs:label 'Hold Time Hours' ;
    rdfs:comment 'Maximum allowable time in hours between sample collection and analysis completion, as specified by EPA methods. Critical for ensuring analytical validity and regulatory compliance.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:limsSubmissionCode rdf:type rdf:Property ;
    rdfs:label 'Lims Submission Code' ;
    rdfs:comment 'Reference identifier assigned by the LIMS when the sample is logged into the laboratory system for analysis. Links field sample to laboratory test results.' ;
    rdfs:domain ind:WaterSample ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryProgram rdf:type rdf:Property ;
    rdfs:label 'Regulatory Program' ;
    rdfs:comment 'The regulatory program or permit under which the sample is collected (e.g., SDWA compliance, NPDES discharge monitoring, Lead and Copper Rule Revisions (LCRR), Disinfection Byproduct (DBP) monitoring, Per- and Polyfluoroalkyl Substances (PFAS) testing).' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestedAnalysisGroup rdf:type rdf:Property ;
    rdfs:label 'Requested Analysis Group' ;
    rdfs:comment 'The suite or panel of tests requested for this sample (e.g., bacteriological, inorganic chemicals, volatile organic compounds (VOCs), Disinfection Byproducts (DBPs), metals, nutrients). May reference a predefined test package.' ;
    rdfs:domain ind:WaterSample ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sampleLocationDescription rdf:type rdf:Property ;
    rdfs:label 'Sample Location Description' ;
    rdfs:comment 'Free-text description of the sample collection location, including address, facility name, or geographic reference. Supplements the sampling point reference with human-readable context.' ;
    rdfs:domain ind:WaterSample ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sampleMatrix rdf:type rdf:Property ;
    rdfs:label 'Sample Matrix' ;
    rdfs:comment 'The type of water or wastewater being sampled: drinking water (finished), raw water (source), treated water (post-treatment), distribution water (in-network), wastewater influent (incoming), or wastewater effluent (discharge).' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sampleNumber rdf:type rdf:Property ;
    rdfs:label 'Sample Number' ;
    rdfs:comment 'Business-facing unique sample identifier or barcode assigned at collection time, used for tracking and chain-of-custody documentation.' ;
    rdfs:domain ind:WaterSample ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:samplePurpose rdf:type rdf:Property ;
    rdfs:label 'Sample Purpose' ;
    rdfs:comment 'Business reason for collecting the sample (e.g., routine compliance monitoring, customer complaint investigation, process control, special study, Consumer Confidence Report (CCR) preparation, National Pollutant Discharge Elimination System (NPDES) permit monitoring).' ;
    rdfs:domain ind:WaterSample ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sampleStatus rdf:type rdf:Property ;
    rdfs:label 'Sample Status' ;
    rdfs:comment 'Current lifecycle status of the sample: collected (in field), in transit (being transported), received by lab (logged into LIMS), in analysis (testing underway), analysis complete (results available), results reported (delivered to stakeholders), or voided (invalidated). [ENUM-REF-CANDIDATE: collected|in_transit|received_by_lab|in_analysis|analysis_complete|results_reported|voided — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:WaterSample ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:samplerEquipmentCode rdf:type rdf:Property ;
    rdfs:label 'Sampler Equipment Code' ;
    rdfs:comment 'Reference to the automatic sampler or field equipment used to collect the sample, if applicable. Supports equipment calibration tracking and quality assurance.' ;
    rdfs:domain ind:WaterSample ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:analysisTimestamp rdf:type rdf:Property ;
    rdfs:label 'Analysis Timestamp' ;
    rdfs:comment 'Precise date and time when the laboratory analysis was completed. Provides full temporal resolution for hold-time verification and audit trails.' ;
    rdfs:domain ind:AnalyticalResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:analyticalMethod rdf:type rdf:Property ;
    rdfs:label 'Analytical Method' ;
    rdfs:comment 'EPA or standard method number used for the analysis (e.g., EPA 200.8, EPA 300.0, SM 2320B, ASTM D1067). Defines the laboratory procedure and instrumentation.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceExceeded rdf:type rdf:Property ;
    rdfs:label 'Compliance Exceeded' ;
    rdfs:comment 'Indicates whether the result value exceeds the applicable MCL or permit limit. Triggers regulatory notification and corrective action workflows.' ;
    rdfs:domain ind:AnalyticalResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dataValidationLevel rdf:type rdf:Property ;
    rdfs:label 'Data Validation Level' ;
    rdfs:comment 'Level of data validation review applied to this result. Higher levels indicate more rigorous QA/QC review, typically required for regulatory or litigation purposes.' ;
    rdfs:domain ind:AnalyticalResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dilutionFactor rdf:type rdf:Property ;
    rdfs:label 'Dilution Factor' ;
    rdfs:comment 'Factor by which the sample was diluted prior to analysis. Result value is typically reported after applying the dilution factor. A value of 1.0 indicates no dilution.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:holdTimeCompliant rdf:type rdf:Property ;
    rdfs:label 'Hold Time Compliant' ;
    rdfs:comment 'Indicates whether the sample was analyzed within the method-specified hold time from collection to analysis. Non-compliance may affect result validity.' ;
    rdfs:domain ind:AnalyticalResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:laboratoryAccreditationNumber rdf:type rdf:Property ;
    rdfs:label 'Laboratory Accreditation Number' ;
    rdfs:comment 'State or EPA certification number for the laboratory. Required for regulatory compliance reporting under SDWA and CWA.' ;
    rdfs:domain ind:AnalyticalResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:limsResultCode rdf:type rdf:Property ;
    rdfs:label 'Lims Result Code' ;
    rdfs:comment 'Original result identifier from the source LIMS system (LabWare or similar). Used for traceability and reconciliation with source system.' ;
    rdfs:domain ind:AnalyticalResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mclValue rdf:type rdf:Property ;
    rdfs:label 'Mcl Value' ;
    rdfs:comment 'Regulatory maximum contaminant level for this analyte as defined by EPA or state primacy agency. Used for automated compliance comparison.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mclgValue rdf:type rdf:Property ;
    rdfs:label 'Mclg Value' ;
    rdfs:comment 'Non-enforceable health goal for this analyte. Represents the level at which no known or anticipated adverse health effects occur, with an adequate margin of safety.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:percentRecovery rdf:type rdf:Property ;
    rdfs:label 'Percent Recovery' ;
    rdfs:comment 'Quality control metric indicating the percentage of analyte recovered in matrix spike or laboratory control sample. Acceptable ranges are method-specific.' ;
    rdfs:domain ind:AnalyticalResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:qualifierCode rdf:type rdf:Property ;
    rdfs:label 'Qualifier Code' ;
    rdfs:comment 'Data qualifier flag indicating special conditions (e.g., U=non-detect, J=estimated, H=hold-time exceeded, B=blank contamination, E=exceeds calibration range, Q=QC failure). Pipe-separated if multiple qualifiers apply.' ;
    rdfs:domain ind:AnalyticalResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relativePercentDifference rdf:type rdf:Property ;
    rdfs:label 'Relative Percent Difference' ;
    rdfs:comment 'Quality control metric comparing duplicate sample results. Measures precision and reproducibility of the analytical method.' ;
    rdfs:domain ind:AnalyticalResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reportingRequired rdf:type rdf:Property ;
    rdfs:label 'Reporting Required' ;
    rdfs:comment 'Indicates whether this result must be included in regulatory reports such as CCR, DMR, or MOR. Based on analyte type, sample location, and regulatory schedule.' ;
    rdfs:domain ind:AnalyticalResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:resultComment rdf:type rdf:Property ;
    rdfs:label 'Result Comment' ;
    rdfs:comment 'Free-text notes from the analyst or validator regarding special conditions, anomalies, or interpretation guidance for this result.' ;
    rdfs:domain ind:AnalyticalResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resultStatus rdf:type rdf:Property ;
    rdfs:label 'Result Status' ;
    rdfs:comment 'Current status of the analytical result in the laboratory workflow. Indicates whether the result has been validated and approved for regulatory reporting.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resultValue rdf:type rdf:Property ;
    rdfs:label 'Result Value' ;
    rdfs:comment 'Numerical value of the analytical result as measured by the laboratory. May be null if result is non-detect or qualitative.' ;
    rdfs:domain ind:AnalyticalResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:actionLevelUnit rdf:type rdf:Property ;
    rdfs:label 'Action Level Unit' ;
    rdfs:comment 'Unit of measure for the action level value. Common units: mg/L, ug/L.' ;
    rdfs:domain ind:Contaminant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actionLevelValue rdf:type rdf:Property ;
    rdfs:label 'Action Level Value' ;
    rdfs:comment 'The concentration of a contaminant which, if exceeded, triggers treatment or other requirements. Primarily used for lead and copper under the Lead and Copper Rule Revisions (LCRR).' ;
    rdfs:domain ind:Contaminant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:analyticalMethodCode rdf:type rdf:Property ;
    rdfs:label 'Analytical Method Code' ;
    rdfs:comment 'EPA-approved analytical method code(s) for laboratory testing of this contaminant. Examples: EPA 200.8 (metals), EPA 524.2 (volatile organics), SM 9223B (coliform).' ;
    rdfs:domain ind:Contaminant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:casNumber rdf:type rdf:Property ;
    rdfs:label 'Cas Number' ;
    rdfs:comment 'Unique numerical identifier assigned by the Chemical Abstracts Service to chemical substances. Used for precise identification of chemical contaminants.' ;
    rdfs:domain ind:Contaminant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ccrLanguageTemplate rdf:type rdf:Property ;
    rdfs:label 'Ccr Language Template' ;
    rdfs:comment 'Standard EPA-approved language template for describing this contaminant and its health effects in the Consumer Confidence Report. Ensures consistent public communication.' ;
    rdfs:domain ind:Contaminant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ccrReportingRequired rdf:type rdf:Property ;
    rdfs:label 'Ccr Reporting Required' ;
    rdfs:comment 'Indicates whether detection of this contaminant must be reported in the annual Consumer Confidence Report distributed to customers.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:contaminantStatus rdf:type rdf:Property ;
    rdfs:label 'Contaminant Status' ;
    rdfs:comment 'Current regulatory status of the contaminant in the enterprise taxonomy. Active contaminants are currently monitored; inactive are no longer required; proposed are under rulemaking; withdrawn were removed from regulations.' ;
    rdfs:domain ind:Contaminant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contaminantType rdf:type rdf:Property ;
    rdfs:label 'Contaminant Type' ;
    rdfs:comment 'Regulatory status indicating whether the contaminant has enforceable standards (regulated), is monitored without enforceable limits (unregulated), is under evaluation (emerging), or has non-enforceable guidelines (secondary).' ;
    rdfs:domain ind:Contaminant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:detectionLimitUnit rdf:type rdf:Property ;
    rdfs:label 'Detection Limit Unit' ;
    rdfs:comment 'Unit of measure for the method detection limit value.' ;
    rdfs:domain ind:Contaminant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:detectionLimitValue rdf:type rdf:Property ;
    rdfs:label 'Detection Limit Value' ;
    rdfs:comment 'The minimum concentration of a substance that can be measured and reported with 99% confidence that the analyte concentration is greater than zero. Laboratory capability threshold.' ;
    rdfs:domain ind:Contaminant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:healthEffectCategory rdf:type rdf:Property ;
    rdfs:label 'Health Effect Category' ;
    rdfs:comment 'Classification of the primary health impact associated with exposure to this contaminant. Acute effects occur shortly after exposure; chronic effects develop over long-term exposure; carcinogenic contaminants may cause cancer.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:healthEffectDescription rdf:type rdf:Property ;
    rdfs:label 'Health Effect Description' ;
    rdfs:comment 'Detailed description of known or potential health effects from exposure to this contaminant. Used in Consumer Confidence Reports (CCR) and public communication.' ;
    rdfs:domain ind:Contaminant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mclUnit rdf:type rdf:Property ;
    rdfs:label 'Mcl Unit' ;
    rdfs:comment 'Unit of measure for the MCL value. Common units: mg/L (milligrams per liter), ug/L (micrograms per liter), pCi/L (picocuries per liter), MFL (million fibers per liter), NTU (Nephelometric Turbidity Units).' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mclgUnit rdf:type rdf:Property ;
    rdfs:label 'Mclg Unit' ;
    rdfs:comment 'Unit of measure for the MCLG value. Typically matches MCL unit for consistency in comparison.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:monitoringFrequencyCode rdf:type rdf:Property ;
    rdfs:label 'Monitoring Frequency Code' ;
    rdfs:comment 'Standard frequency at which this contaminant must be monitored under regulatory requirements. Actual frequency may vary based on system size, source water type, and previous results. [ENUM-REF-CANDIDATE: daily|weekly|monthly|quarterly|annually|triennial|variable|not_required — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Contaminant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:monitoringLocationType rdf:type rdf:Property ;
    rdfs:label 'Monitoring Location Type' ;
    rdfs:comment 'Standard location(s) in the water system where monitoring for this contaminant is required. Determines sampling point selection for compliance.' ;
    rdfs:domain ind:Contaminant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:npdesEffluentLimitUnit rdf:type rdf:Property ;
    rdfs:label 'Npdes Effluent Limit Unit' ;
    rdfs:comment 'Unit of measure for the NPDES effluent limit value.' ;
    rdfs:domain ind:Contaminant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:npdesEffluentLimitValue rdf:type rdf:Property ;
    rdfs:label 'Npdes Effluent Limit Value' ;
    rdfs:comment 'Maximum allowable concentration in wastewater effluent discharge under NPDES permit requirements. Null if not applicable to wastewater.' ;
    rdfs:domain ind:Contaminant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:publicNotificationTier rdf:type rdf:Property ;
    rdfs:label 'Public Notification Tier' ;
    rdfs:comment 'EPA public notification tier classification determining the urgency and method of public notification required when violations occur. Tier 1 (most urgent, 24 hours), Tier 2 (30 days), Tier 3 (1 year).' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportingThresholdUnit rdf:type rdf:Property ;
    rdfs:label 'Reporting Threshold Unit' ;
    rdfs:comment 'Unit of measure for the reporting threshold value.' ;
    rdfs:domain ind:Contaminant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportingThresholdValue rdf:type rdf:Property ;
    rdfs:label 'Reporting Threshold Value' ;
    rdfs:comment 'The minimum concentration level at which detection and reporting to regulatory agencies is required. Also known as reporting limit or detection limit for regulatory purposes.' ;
    rdfs:domain ind:Contaminant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:revisionDate rdf:type rdf:Property ;
    rdfs:label 'Revision Date' ;
    rdfs:comment 'Date when the contaminant record was last revised to reflect regulatory updates, new scientific findings, or data corrections.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sourceCategory rdf:type rdf:Property ;
    rdfs:label 'Source Category' ;
    rdfs:comment 'Primary origin or source of the contaminant in water systems. Helps identify root causes and appropriate mitigation strategies. [ENUM-REF-CANDIDATE: naturally_occurring|industrial|agricultural|municipal|treatment_process|distribution_system|multiple — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Contaminant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceDescription rdf:type rdf:Property ;
    rdfs:label 'Source Description' ;
    rdfs:comment 'Detailed description of how the contaminant enters water systems. Examples: erosion of natural deposits, discharge from factories, runoff from agricultural operations, byproduct of disinfection, corrosion of household plumbing.' ;
    rdfs:domain ind:Contaminant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subgroup rdf:type rdf:Property ;
    rdfs:label 'Subgroup' ;
    rdfs:comment 'Secondary classification providing more granular categorization within the contaminant group. Examples: THM (within DBP), volatile organic compounds (within organic), coliforms (within microbiological).' ;
    rdfs:domain ind:Contaminant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:treatmentTechniqueDescription rdf:type rdf:Property ;
    rdfs:label 'Treatment Technique Description' ;
    rdfs:comment 'Description of the required treatment technique or process. Examples: filtration, disinfection, corrosion control, specific removal efficiency requirements.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:treatmentTechniqueRequired rdf:type rdf:Property ;
    rdfs:label 'Treatment Technique Required' ;
    rdfs:comment 'Indicates whether a treatment technique is required in lieu of or in addition to an MCL. True if EPA requires specific treatment processes rather than or alongside a numeric limit.' ;
    rdfs:domain ind:Contaminant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:violationTriggerLogic rdf:type rdf:Property ;
    rdfs:label 'Violation Trigger Logic' ;
    rdfs:comment 'Business rule describing when exceedances of limits constitute a regulatory violation. Examples: single sample exceeds MCL, running annual average exceeds MCL, 90th percentile exceeds action level.' ;
    rdfs:domain ind:Contaminant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wastewaterParameter rdf:type rdf:Property ;
    rdfs:label 'Wastewater Parameter' ;
    rdfs:comment 'Indicates whether this contaminant is also monitored as a wastewater effluent parameter under NPDES permits or state discharge requirements.' ;
    rdfs:domain ind:Contaminant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:analyticalMethodRequired rdf:type rdf:Property ;
    rdfs:label 'Analytical Method Required' ;
    rdfs:comment 'EPA-approved analytical method(s) required for measuring this contaminant. Examples: \'EPA Method 200.8\' (metals by ICP-MS), \'EPA Method 524.2\' (VOCs), \'EPA Method 537.1\' (PFAS), \'Standard Method 2320\' (alkalinity), \'EPA Method 1664A\' (oil and grease).' ;
    rdfs:domain ind:ContaminantLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicableRegulation rdf:type rdf:Property ;
    rdfs:label 'Applicable Regulation' ;
    rdfs:comment 'Citation of the regulation or rule establishing this limit. Examples: \'40 CFR 141.80\' (Stage 2 DBPR), \'40 CFR 141.51\' (MCLs for inorganic contaminants), \'LCRR 40 CFR 141.80-141.91\', state-specific regulation citation, or facility NPDES permit number.' ;
    rdfs:domain ind:ContaminantLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:averagingPeriod rdf:type rdf:Property ;
    rdfs:label 'Averaging Period' ;
    rdfs:comment 'Time period over which the limit is calculated or averaged. Instantaneous = single sample, daily_max = maximum value in a day, monthly_avg = average over calendar month, quarterly_avg = average over quarter, annual_avg = average over calendar year, running_annual_avg = rolling 12-month average, locational_running_annual_avg = running annual average at specific sampling location (e.g., for DBPs under Stage 2 DBPR). [ENUM-REF-CANDIDATE: instantaneous|daily_max|monthly_avg|quarterly_avg|annual_avg|running_annual_avg|locational_running_annual_avg — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:ContaminantLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:detectionLimitRequired rdf:type rdf:Property ;
    rdfs:label 'Detection Limit Required' ;
    rdfs:comment 'Minimum detection limit (MDL) or practical quantitation limit (PQL) required for the analytical method. Laboratory results must meet or exceed this sensitivity. Expressed in same unit_of_measure as limit_value.' ;
    rdfs:domain ind:ContaminantLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:exceedanceActionRequired rdf:type rdf:Property ;
    rdfs:label 'Exceedance Action Required' ;
    rdfs:comment 'Description of required actions when this limit is exceeded. Examples: \'Public notification within 24 hours\', \'Implement corrosion control treatment\', \'Increase monitoring frequency\', \'Submit corrective action plan within 30 days\', \'Immediate discharge cessation\'.' ;
    rdfs:domain ind:ContaminantLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jurisdictionAuthority rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction Authority' ;
    rdfs:comment 'Name of the regulatory authority or agency that issued this limit. Examples: \'U.S. EPA\', \'California State Water Resources Control Board\', \'Ohio EPA\', \'Local Municipal Authority\', or specific permit-issuing agency.' ;
    rdfs:domain ind:ContaminantLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:limitType rdf:type rdf:Property ;
    rdfs:label 'Limit Type' ;
    rdfs:comment 'Type of regulatory or operational limit. MCL = Maximum Contaminant Level (enforceable), MCLG = Maximum Contaminant Level Goal (non-enforceable health goal), action_level = threshold triggering corrective action (e.g., Lead and Copper Rule), treatment_technique = required treatment process standard, permit_limit = facility-specific NPDES or discharge permit limit.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:limitValue rdf:type rdf:Property ;
    rdfs:label 'Limit Value' ;
    rdfs:comment 'Numeric threshold value for the contaminant limit. For example, MCL for lead is 0.015 mg/L. Null if limit is qualitative (e.g., treatment technique with no numeric threshold).' ;
    rdfs:domain ind:ContaminantLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:monitoringFrequencyRequired rdf:type rdf:Property ;
    rdfs:label 'Monitoring Frequency Required' ;
    rdfs:comment 'Required sampling and analysis frequency for this contaminant at this context. Examples: \'Quarterly\', \'Monthly\', \'Weekly\', \'Daily\', \'Continuous\', \'Every 3 years\', \'Per compliance schedule\'. May reference a compliance_schedule record for complex schedules.' ;
    rdfs:domain ind:ContaminantLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sampleLocationType rdf:type rdf:Property ;
    rdfs:label 'Sample Location Type' ;
    rdfs:comment 'Type of location where samples are collected for comparison against this limit. Entry_point = water entering distribution system, distribution_system = within distribution network, consumer_tap = at customer premise, source_water = raw water intake, effluent_discharge = treated wastewater discharge point, process_intermediate = within treatment process.' ;
    rdfs:domain ind:ContaminantLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supersededDate rdf:type rdf:Property ;
    rdfs:label 'Superseded Date' ;
    rdfs:comment 'Date when this limit was replaced by a newer regulation or permit condition. Null if the limit is currently active. Used for historical compliance analysis and regulatory change tracking.' ;
    rdfs:domain ind:ContaminantLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:varianceExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Variance Expiration Date' ;
    rdfs:comment 'Date when the variance or waiver expires and standard limit enforcement resumes. Null if no variance is in effect or if variance is indefinite (subject to periodic review).' ;
    rdfs:domain ind:ContaminantLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:varianceWaiverFlag rdf:type rdf:Property ;
    rdfs:label 'Variance Waiver Flag' ;
    rdfs:comment 'Indicates whether a variance or waiver has been granted for this limit at this monitoring context. True = variance/waiver in effect (limit may be temporarily relaxed or monitoring reduced), False = standard limit applies without exception.' ;
    rdfs:domain ind:ContaminantLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exceedanceId rdf:type rdf:Property ;
    rdfs:label 'Exceedance Id' ;
    rdfs:comment 'Primary key for exceedance' ;
    rdfs:domain ind:Exceedance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:leadCopperResultId rdf:type rdf:Property ;
    rdfs:label 'Lead Copper Result Id' ;
    rdfs:comment 'Foreign key linking to quality.lead_copper_result. Business justification: Lead and Copper Rule (LCR/LCRR) exceedances are triggered by lead_copper_result records when the 90th percentile action level is exceeded. The current exceedance model only links to analytical_result,' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:LeadCopperResult .

ind:bacteriologicalResultId rdf:type rdf:Property ;
    rdfs:label 'Bacteriological Result Id' ;
    rdfs:comment 'Unique identifier for the bacteriological test result record.' ;
    rdfs:domain ind:BacteriologicalResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:analysisCompletionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Analysis Completion Timestamp' ;
    rdfs:comment 'Precise timestamp when the bacteriological analysis was completed and results were finalized.' ;
    rdfs:domain ind:BacteriologicalResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:chainOfCustodyNumber rdf:type rdf:Property ;
    rdfs:label 'Chain Of Custody Number' ;
    rdfs:comment 'Chain of custody tracking number for the sample from collection through analysis, ensuring sample integrity and traceability.' ;
    rdfs:domain ind:BacteriologicalResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eColiCfu rdf:type rdf:Property ;
    rdfs:label 'E Coli Cfu' ;
    rdfs:comment 'Quantitative result for E. coli bacteria expressed as Colony Forming Units per 100 mL when membrane filtration method is used.' ;
    rdfs:domain ind:BacteriologicalResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:eColiMpn rdf:type rdf:Property ;
    rdfs:label 'E Coli Mpn' ;
    rdfs:comment 'Quantitative result for E. coli bacteria expressed as Most Probable Number per 100 mL when enumeration method is used.' ;
    rdfs:domain ind:BacteriologicalResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:eColiResult rdf:type rdf:Property ;
    rdfs:label 'E Coli Result' ;
    rdfs:comment 'Presence or absence result for E. coli bacteria in the sample.' ;
    rdfs:domain ind:BacteriologicalResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:enterococciCfu rdf:type rdf:Property ;
    rdfs:label 'Enterococci Cfu' ;
    rdfs:comment 'Quantitative result for enterococci bacteria expressed as Colony Forming Units per 100 mL.' ;
    rdfs:domain ind:BacteriologicalResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:enterococciResult rdf:type rdf:Property ;
    rdfs:label 'Enterococci Result' ;
    rdfs:comment 'Presence or absence result for enterococci bacteria, typically used for wastewater and recreational water monitoring.' ;
    rdfs:domain ind:BacteriologicalResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fecalColiformCfu rdf:type rdf:Property ;
    rdfs:label 'Fecal Coliform Cfu' ;
    rdfs:comment 'Quantitative result for fecal coliform bacteria expressed as Colony Forming Units per 100 mL.' ;
    rdfs:domain ind:BacteriologicalResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fecalColiformResult rdf:type rdf:Property ;
    rdfs:label 'Fecal Coliform Result' ;
    rdfs:comment 'Presence or absence result for fecal coliform bacteria in the sample (legacy parameter, replaced by E. coli under RTCR).' ;
    rdfs:domain ind:BacteriologicalResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hpcResult rdf:type rdf:Property ;
    rdfs:label 'Hpc Result' ;
    rdfs:comment 'Quantitative result for Heterotrophic Plate Count expressed as Colony Forming Units per milliliter (CFU/mL), used to assess general bacterial population and treatment effectiveness.' ;
    rdfs:domain ind:BacteriologicalResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:incubationDurationHours rdf:type rdf:Property ;
    rdfs:label 'Incubation Duration Hours' ;
    rdfs:comment 'Duration in hours for which the sample was incubated during analysis (typically 24 or 48 hours depending on method).' ;
    rdfs:domain ind:BacteriologicalResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:incubationTemperatureC rdf:type rdf:Property ;
    rdfs:label 'Incubation Temperature C' ;
    rdfs:comment 'Temperature in degrees Celsius at which the sample was incubated during analysis (typically 35°C or 44.5°C depending on test type).' ;
    rdfs:domain ind:BacteriologicalResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:invalidationReason rdf:type rdf:Property ;
    rdfs:label 'Invalidation Reason' ;
    rdfs:comment 'Reason for invalidating the test result if result_status is invalidated (e.g., contamination, procedural error, equipment failure).' ;
    rdfs:domain ind:BacteriologicalResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mclExceededFlag rdf:type rdf:Property ;
    rdfs:label 'Mcl Exceeded Flag' ;
    rdfs:comment 'Boolean flag indicating whether the result exceeded the Maximum Contaminant Level for the tested parameter.' ;
    rdfs:domain ind:BacteriologicalResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:publicNotificationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Public Notification Required Flag' ;
    rdfs:comment 'Boolean flag indicating whether this result triggers a public notification requirement under SDWA.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryReportingFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Reporting Flag' ;
    rdfs:comment 'Boolean flag indicating whether this result must be included in regulatory compliance reporting to EPA or state primacy agency.' ;
    rdfs:domain ind:BacteriologicalResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:repeatSampleRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Repeat Sample Required Flag' ;
    rdfs:comment 'Boolean flag indicating whether RTCR requires repeat sampling due to a positive total coliform result.' ;
    rdfs:domain ind:BacteriologicalResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:resultComments rdf:type rdf:Property ;
    rdfs:label 'Result Comments' ;
    rdfs:comment 'Free-text comments from the analyst regarding the test result, including observations, anomalies, or special conditions.' ;
    rdfs:domain ind:BacteriologicalResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rtcrAssessmentLevel rdf:type rdf:Property ;
    rdfs:label 'Rtcr Assessment Level' ;
    rdfs:comment 'RTCR assessment level triggered by the result (none, Level 1 Assessment, Level 2 Assessment) based on coliform detection patterns.' ;
    rdfs:domain ind:BacteriologicalResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:testType rdf:type rdf:Property ;
    rdfs:label 'Test Type' ;
    rdfs:comment 'Type of bacteriological test performed (Total Coliform, E. coli, Fecal Coliform, Heterotrophic Plate Count, Enterococci, or Combined TCR/RTCR).' ;
    rdfs:domain ind:BacteriologicalResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalColiformCfu rdf:type rdf:Property ;
    rdfs:label 'Total Coliform Cfu' ;
    rdfs:comment 'Quantitative result for total coliform bacteria expressed as Colony Forming Units per 100 mL when membrane filtration method is used.' ;
    rdfs:domain ind:BacteriologicalResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalColiformMpn rdf:type rdf:Property ;
    rdfs:label 'Total Coliform Mpn' ;
    rdfs:comment 'Quantitative result for total coliform bacteria expressed as Most Probable Number per 100 mL when enumeration method is used.' ;
    rdfs:domain ind:BacteriologicalResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalColiformResult rdf:type rdf:Property ;
    rdfs:label 'Total Coliform Result' ;
    rdfs:comment 'Presence or absence result for total coliform bacteria in the sample.' ;
    rdfs:domain ind:BacteriologicalResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verificationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Verification Timestamp' ;
    rdfs:comment 'Timestamp when the result was verified and approved by quality assurance personnel.' ;
    rdfs:domain ind:BacteriologicalResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:copperActionLevelExceeded rdf:type rdf:Property ;
    rdfs:label 'Copper Action Level Exceeded' ;
    rdfs:comment 'Indicates whether the copper result exceeds the EPA action level of 1300 ppb (1.3 mg/L), triggering potential corrosion control treatment requirements.' ;
    rdfs:domain ind:LeadCopperResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:copperResultPpb rdf:type rdf:Property ;
    rdfs:label 'Copper Result Ppb' ;
    rdfs:comment 'Measured concentration of copper in the water sample expressed in parts per billion (ppb or µg/L). Used for 90th percentile calculation and action level comparison.' ;
    rdfs:domain ind:LeadCopperResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:corrosionControlTreatmentStatus rdf:type rdf:Property ;
    rdfs:label 'Corrosion Control Treatment Status' ;
    rdfs:comment 'Status of corrosion control treatment optimization at the time of sampling, indicating whether the water system has optimized corrosion control per LCRR requirements.' ;
    rdfs:domain ind:LeadCopperResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:customerNotificationDate rdf:type rdf:Property ;
    rdfs:label 'Customer Notification Date' ;
    rdfs:comment 'Date when the customer was notified of their individual lead and copper sample result.' ;
    rdfs:domain ind:LeadCopperResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:customerNotificationSent rdf:type rdf:Property ;
    rdfs:label 'Customer Notification Sent' ;
    rdfs:comment 'Indicates whether the customer was notified of their individual sample result as required by LCRR within 30 days of receiving results.' ;
    rdfs:domain ind:LeadCopperResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:detectionLimitCopperPpb rdf:type rdf:Property ;
    rdfs:label 'Detection Limit Copper Ppb' ;
    rdfs:comment 'Minimum concentration of copper that the analytical method can reliably detect and quantify for this sample.' ;
    rdfs:domain ind:LeadCopperResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:detectionLimitLeadPpb rdf:type rdf:Property ;
    rdfs:label 'Detection Limit Lead Ppb' ;
    rdfs:comment 'Minimum concentration of lead that the analytical method can reliably detect and quantify for this sample.' ;
    rdfs:domain ind:LeadCopperResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:holdingTimeCompliant rdf:type rdf:Property ;
    rdfs:label 'Holding Time Compliant' ;
    rdfs:comment 'Indicates whether the sample was analyzed within the EPA-required holding time (6 months for metals) from collection to analysis.' ;
    rdfs:domain ind:LeadCopperResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:includedIn90thPercentile rdf:type rdf:Property ;
    rdfs:label 'Included In 90th Percentile' ;
    rdfs:comment 'Indicates whether this result was included in the 90th percentile calculation for LCRR compliance determination. Invalid or QC-failed samples are excluded.' ;
    rdfs:domain ind:LeadCopperResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:leadActionLevelExceeded rdf:type rdf:Property ;
    rdfs:label 'Lead Action Level Exceeded' ;
    rdfs:comment 'Indicates whether the lead result exceeds the EPA action level of 15 ppb, triggering potential corrosion control treatment requirements.' ;
    rdfs:domain ind:LeadCopperResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:leadResultPpb rdf:type rdf:Property ;
    rdfs:label 'Lead Result Ppb' ;
    rdfs:comment 'Measured concentration of lead in the water sample expressed in parts per billion (ppb or µg/L). Used for 90th percentile calculation and action level comparison.' ;
    rdfs:domain ind:LeadCopperResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:qualityControlStatus rdf:type rdf:Property ;
    rdfs:label 'Quality Control Status' ;
    rdfs:comment 'Laboratory quality control status indicating whether the sample result passed all QC checks including blanks, duplicates, and spike recoveries.' ;
    rdfs:domain ind:LeadCopperResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryReportingStatus rdf:type rdf:Property ;
    rdfs:label 'Regulatory Reporting Status' ;
    rdfs:comment 'Status of this result in the regulatory reporting workflow to state primacy agency and EPA.' ;
    rdfs:domain ind:LeadCopperResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remarks rdf:type rdf:Property ;
    rdfs:label 'Remarks' ;
    rdfs:comment 'Free-text field for additional notes, observations, or special circumstances related to the sample collection or analysis.' ;
    rdfs:domain ind:LeadCopperResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:samplePh rdf:type rdf:Property ;
    rdfs:label 'Sample Ph' ;
    rdfs:comment 'pH measurement of the water sample at collection, relevant for corrosion control assessment.' ;
    rdfs:domain ind:LeadCopperResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:samplePreservationMethod rdf:type rdf:Property ;
    rdfs:label 'Sample Preservation Method' ;
    rdfs:comment 'Method used to preserve the sample for metals analysis, typically acidification with nitric acid to pH < 2.' ;
    rdfs:domain ind:LeadCopperResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sampleTemperatureC rdf:type rdf:Property ;
    rdfs:label 'Sample Temperature C' ;
    rdfs:comment 'Water temperature at the time of sample collection, recorded to document field conditions.' ;
    rdfs:domain ind:LeadCopperResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:siteTier rdf:type rdf:Property ;
    rdfs:label 'Site Tier' ;
    rdfs:comment 'LCRR-mandated tier classification of the sampling site based on service line material and building construction date (Tier 1: lead service lines, Tier 2: lead status unknown, Tier 3: non-lead).' ;
    rdfs:domain ind:LeadCopperResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stagnationTimeHours rdf:type rdf:Property ;
    rdfs:label 'Stagnation Time Hours' ;
    rdfs:comment 'Duration in hours that water remained stagnant in the service line prior to sample collection. LCRR requires minimum 6-hour stagnation for first-draw samples.' ;
    rdfs:domain ind:LeadCopperResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:complianceEvaluationMethod rdf:type rdf:Property ;
    rdfs:label 'Compliance Evaluation Method' ;
    rdfs:comment 'The method used to determine compliance with this condition: single value comparison (each result compared to limit), rolling average (moving average over specified period), statistical analysis (percentile or confidence interval), narrative assessment (qualitative evaluation), or best professional judgment (case-by-case determination).' ;
    rdfs:domain ind:PermitCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceScheduleMilestone rdf:type rdf:Property ;
    rdfs:label 'Compliance Schedule Milestone' ;
    rdfs:comment 'Description of the compliance schedule milestone associated with this condition (e.g., \'Submit engineering plans by 2024-06-30\', \'Complete construction by 2025-12-31\', \'Achieve interim limit of 30 mg/L BOD by 2024-12-31\'). Null if no compliance schedule applies.' ;
    rdfs:domain ind:PermitCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conditionNumber rdf:type rdf:Property ;
    rdfs:label 'Condition Number' ;
    rdfs:comment 'The official condition number or identifier as stated in the permit document (e.g., \'I.A.1\', \'II.B.3\', \'Condition 5\').' ;
    rdfs:domain ind:PermitCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conditionText rdf:type rdf:Property ;
    rdfs:label 'Condition Text' ;
    rdfs:comment 'The full verbatim text of the permit condition as written in the permit document. Includes all narrative requirements, qualifications, and regulatory language.' ;
    rdfs:domain ind:PermitCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conditionType rdf:type rdf:Property ;
    rdfs:label 'Condition Type' ;
    rdfs:comment 'Classification of the permit condition: effluent limit (numeric discharge limit), monitoring requirement (sampling frequency and method), reporting requirement (MOR/DMR submission), technology-based standard (treatment technology mandate), narrative condition (qualitative requirement), or best management practice (operational control).' ;
    rdfs:domain ind:PermitCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:detectionLimitRequirement rdf:type rdf:Property ;
    rdfs:label 'Detection Limit Requirement' ;
    rdfs:comment 'The minimum detection limit (MDL) or practical quantitation limit (PQL) required for the analytical method. Ensures that the laboratory can measure the parameter at levels sufficiently below the permit limit to demonstrate compliance. Null if no specific detection limit is mandated.' ;
    rdfs:domain ind:PermitCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:enforcementPriority rdf:type rdf:Property ;
    rdfs:label 'Enforcement Priority' ;
    rdfs:comment 'The priority level assigned by the regulatory agency for enforcement of this condition. Critical conditions (e.g., public health parameters like coliform, lead, PFAS) trigger immediate enforcement action upon violation. High priority conditions (e.g., BOD, TSS, pH) require prompt corrective action. Medium and low priority conditions may allow for compliance schedules.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mixingZoneAllowedFlag rdf:type rdf:Property ;
    rdfs:label 'Mixing Zone Allowed Flag' ;
    rdfs:comment 'Indicates whether a mixing zone (limited area where discharge is allowed to exceed water quality standards before achieving full dilution and compliance) is authorized for this condition. True if mixing zone is allowed, False if end-of-pipe compliance is required.' ;
    rdfs:domain ind:PermitCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mixingZoneDescription rdf:type rdf:Property ;
    rdfs:label 'Mixing Zone Description' ;
    rdfs:comment 'Description of the authorized mixing zone including dimensions, boundaries, and compliance monitoring points (e.g., \'100 meters downstream of Outfall 001\', \'Within 50-foot radius of discharge point\', \'Compliance measured at edge of mixing zone\'). Null if no mixing zone is allowed.' ;
    rdfs:domain ind:PermitCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modificationDate rdf:type rdf:Property ;
    rdfs:label 'Modification Date' ;
    rdfs:comment 'The date on which this permit condition was last modified through permit amendment, administrative order, or consent decree. Null if the condition has never been modified since the original permit issuance.' ;
    rdfs:domain ind:PermitCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:modificationReason rdf:type rdf:Property ;
    rdfs:label 'Modification Reason' ;
    rdfs:comment 'The reason for the most recent modification to this condition (e.g., \'Updated water quality standards\', \'New analytical method approved\', \'Compliance schedule adjustment\', \'Facility upgrade completed\', \'Enforcement action settlement\', \'Anti-backsliding provision waiver\'). Null if never modified.' ;
    rdfs:domain ind:PermitCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:monitoringLocation rdf:type rdf:Property ;
    rdfs:label 'Monitoring Location' ;
    rdfs:comment 'The specific location where monitoring or sampling must occur (e.g., \'Outfall 001\', \'Effluent Discharge Point A\', \'Influent to Primary Treatment\', \'Final Effluent\'). May reference a specific outfall, sampling point, or monitoring station.' ;
    rdfs:domain ind:PermitCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:numericLimit rdf:type rdf:Property ;
    rdfs:label 'Numeric Limit' ;
    rdfs:comment 'The numeric threshold value for the effluent limit or monitoring requirement. Null for narrative conditions or qualitative requirements.' ;
    rdfs:domain ind:PermitCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:parameterCode rdf:type rdf:Property ;
    rdfs:label 'Parameter Code' ;
    rdfs:comment 'Standardized code for the regulated parameter (e.g., \'00310\' for BOD, \'00530\' for TSS, \'00400\' for pH, \'00600\' for TDS). Uses EPA STORET or equivalent parameter coding system.' ;
    rdfs:domain ind:PermitCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qualityAssuranceRequirement rdf:type rdf:Property ;
    rdfs:label 'Quality Assurance Requirement' ;
    rdfs:comment 'Specific quality assurance and quality control (QA/QC) requirements for monitoring and sampling (e.g., \'EPA Method 1664A for FOG\', \'Standard Methods 5210B for BOD\', \'EPA Method 200.8 for metals\', \'Chain of custody required\', \'Laboratory must be state-certified\', \'Duplicate samples required quarterly\').' ;
    rdfs:domain ind:PermitCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recordRetentionPeriodDays rdf:type rdf:Property ;
    rdfs:label 'Record Retention Period Days' ;
    rdfs:comment 'The number of days that monitoring records, laboratory results, and compliance documentation for this condition must be retained by the permittee. Typically 3 years (1095 days) for NPDES permits, but may be longer for certain parameters or enforcement actions.' ;
    rdfs:domain ind:PermitCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:seasonalPeriod rdf:type rdf:Property ;
    rdfs:label 'Seasonal Period' ;
    rdfs:comment 'The time period during which seasonal variations apply (e.g., \'May 1 - September 30\', \'Winter: November 1 - March 31\', \'Low Flow Season: June - August\'). Null if no seasonal variation applies.' ;
    rdfs:domain ind:PermitCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:seasonalVariationFlag rdf:type rdf:Property ;
    rdfs:label 'Seasonal Variation Flag' ;
    rdfs:comment 'Indicates whether this condition has seasonal variations in limits or monitoring requirements (e.g., more stringent limits during low-flow summer months, reduced monitoring during winter). True if seasonal variations apply, False otherwise.' ;
    rdfs:domain ind:PermitCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:technologyRequirement rdf:type rdf:Property ;
    rdfs:label 'Technology Requirement' ;
    rdfs:comment 'Specific treatment technology or operational practice mandated by this condition (e.g., \'Secondary Treatment\', \'Ultraviolet (UV) Disinfection\', \'Granular Activated Carbon (GAC) Filtration\', \'Reverse Osmosis (RO)\', \'Microfiltration (MF)\', \'Ultrafiltration (UF)\', \'Fats Oils and Grease (FOG) Pretreatment\', \'Best Management Practice (BMP) for Stormwater\'). Null for non-technology-based conditions.' ;
    rdfs:domain ind:PermitCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:violationThreshold rdf:type rdf:Property ;
    rdfs:label 'Violation Threshold' ;
    rdfs:comment 'The numeric value at which a violation is triggered. May differ from the numeric limit if the permit allows for measurement uncertainty, rounding conventions, or compliance margins. Null for narrative conditions.' ;
    rdfs:domain ind:PermitCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:waterQualityStandardBasis rdf:type rdf:Property ;
    rdfs:label 'Water Quality Standard Basis' ;
    rdfs:comment 'The specific water quality standard or criterion that this condition is designed to protect (e.g., \'Aquatic Life Chronic Criterion\', \'Human Health - Fish Consumption\', \'Drinking Water Maximum Contaminant Level (MCL)\', \'Recreational Water Quality Standard\', \'Anti-Degradation Policy Tier II\'). Null for technology-based conditions.' ;
    rdfs:domain ind:PermitCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicableFacilityType rdf:type rdf:Property ;
    rdfs:label 'Applicable Facility Type' ;
    rdfs:comment 'Type of facility or system to which this requirement applies. WTP = Water Treatment Plant, WWTP = Wastewater Treatment Plant, STP = Sewage Treatment Plant.' ;
    rdfs:domain ind:RegulatoryRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicableSystemSize rdf:type rdf:Property ;
    rdfs:label 'Applicable System Size' ;
    rdfs:comment 'System size classification to which this requirement applies (e.g., large system >50,000 population, medium system 3,301-50,000, small system <=3,300). Null if applies to all sizes.' ;
    rdfs:domain ind:RegulatoryRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceDeadline rdf:type rdf:Property ;
    rdfs:label 'Compliance Deadline' ;
    rdfs:comment 'Date by which the utility must achieve full compliance with the requirement. Null if no specific deadline or if compliance is ongoing.' ;
    rdfs:domain ind:RegulatoryRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:internalPolicyReference rdf:type rdf:Property ;
    rdfs:label 'Internal Policy Reference' ;
    rdfs:comment 'Reference to the utility\'s internal policy, procedure, or standard operating procedure (SOP) that implements this regulatory requirement.' ;
    rdfs:domain ind:RegulatoryRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastComplianceAssessmentDate rdf:type rdf:Property ;
    rdfs:label 'Last Compliance Assessment Date' ;
    rdfs:comment 'Date of the most recent internal or external compliance assessment or audit for this requirement.' ;
    rdfs:domain ind:RegulatoryRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nextComplianceReviewDate rdf:type rdf:Property ;
    rdfs:label 'Next Compliance Review Date' ;
    rdfs:comment 'Scheduled date for the next compliance review or assessment of this requirement.' ;
    rdfs:domain ind:RegulatoryRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:penaltyDescription rdf:type rdf:Property ;
    rdfs:label 'Penalty Description' ;
    rdfs:comment 'Description of penalties or enforcement actions that may result from non-compliance (e.g., fines, consent orders, public notification requirements).' ;
    rdfs:domain ind:RegulatoryRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulationUrl rdf:type rdf:Property ;
    rdfs:label 'Regulation Url' ;
    rdfs:comment 'Web URL or hyperlink to the official regulatory text or guidance document.' ;
    rdfs:domain ind:RegulatoryRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryCitation rdf:type rdf:Property ;
    rdfs:label 'Regulatory Citation' ;
    rdfs:comment 'Full legal citation or reference to the regulation in the Code of Federal Regulations (CFR), state code, or local ordinance (e.g., 40 CFR 141.80).' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requirementCategory rdf:type rdf:Property ;
    rdfs:label 'Requirement Category' ;
    rdfs:comment 'Classification of the type of regulatory obligation. MCL = Maximum Contaminant Level, MCLG = Maximum Contaminant Level Goal. [ENUM-REF-CANDIDATE: monitoring|reporting|operational_standard|MCL|MCLG|treatment_technique|permit_condition|discharge_limit — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:RegulatoryRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requirementCode rdf:type rdf:Property ;
    rdfs:label 'Requirement Code' ;
    rdfs:comment 'Unique business identifier or citation code for the regulatory requirement (e.g., 40 CFR 141.80, LCRR-2021, NPDES-001).' ;
    rdfs:domain ind:RegulatoryRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requirementDescription rdf:type rdf:Property ;
    rdfs:label 'Requirement Description' ;
    rdfs:comment 'Detailed description of the regulatory requirement, including the specific obligation imposed on the utility (e.g., monitoring frequency, reporting format, operational standard).' ;
    rdfs:domain ind:RegulatoryRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requirementTitle rdf:type rdf:Property ;
    rdfs:label 'Requirement Title' ;
    rdfs:comment 'Official title or short name of the regulatory requirement (e.g., Lead and Copper Rule Revisions, Maximum Contaminant Level for Arsenic).' ;
    rdfs:domain ind:RegulatoryRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supersededRequirementCode rdf:type rdf:Property ;
    rdfs:label 'Superseded Requirement Code' ;
    rdfs:comment 'Citation or code of the previous regulatory requirement that this requirement supersedes or replaces. Null if not applicable.' ;
    rdfs:domain ind:RegulatoryRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dmrId rdf:type rdf:Property ;
    rdfs:label 'Dmr Id' ;
    rdfs:comment 'Unique identifier for the discharge monitoring report record.' ;
    rdfs:domain ind:Dmr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:amendedDmrId rdf:type rdf:Property ;
    rdfs:label 'Amended Dmr Id' ;
    rdfs:comment 'Reference to the original discharge monitoring report record if this is a resubmission or correction.' ;
    rdfs:domain ind:Dmr ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Dmr .

ind:acknowledgmentDate rdf:type rdf:Property ;
    rdfs:label 'Acknowledgment Date' ;
    rdfs:comment 'The date on which the regulatory authority acknowledged receipt of this discharge monitoring report.' ;
    rdfs:domain ind:Dmr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:certificationDate rdf:type rdf:Property ;
    rdfs:label 'Certification Date' ;
    rdfs:comment 'The date on which the certifying official signed and certified this discharge monitoring report, attesting to its accuracy under penalty of law.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:certificationStatement rdf:type rdf:Property ;
    rdfs:label 'Certification Statement' ;
    rdfs:comment 'The full text of the legal certification statement signed by the certifying official, typically stating that the report was prepared under their direction and supervision and that the information is true, accurate, and complete to the best of their knowledge.' ;
    rdfs:domain ind:Dmr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:certifyingOfficialName rdf:type rdf:Property ;
    rdfs:label 'Certifying Official Name' ;
    rdfs:comment 'The full name of the authorized signatory who certified the accuracy and completeness of this discharge monitoring report (typically a principal executive officer or ranking elected official).' ;
    rdfs:domain ind:Dmr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:certifyingOfficialTitle rdf:type rdf:Property ;
    rdfs:label 'Certifying Official Title' ;
    rdfs:comment 'The job title or position of the authorized signatory who certified this discharge monitoring report (e.g., General Manager, Mayor, Director of Public Works).' ;
    rdfs:domain ind:Dmr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dmrNumber rdf:type rdf:Property ;
    rdfs:label 'Dmr Number' ;
    rdfs:comment 'Externally-known unique identifier or tracking number for this discharge monitoring report, often assigned by the regulatory authority or internal tracking system.' ;
    rdfs:domain ind:Dmr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exceedanceCount rdf:type rdf:Property ;
    rdfs:label 'Exceedance Count' ;
    rdfs:comment 'The total number of individual parameter measurements within this discharge monitoring report that exceeded their respective permit limits.' ;
    rdfs:domain ind:Dmr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lateSubmissionFlag rdf:type rdf:Property ;
    rdfs:label 'Late Submission Flag' ;
    rdfs:comment 'Indicates whether this discharge monitoring report was submitted after the regulatory deadline (True if late, False if on time).' ;
    rdfs:domain ind:Dmr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:monitoringLocationCode rdf:type rdf:Property ;
    rdfs:label 'Monitoring Location Code' ;
    rdfs:comment 'The alphanumeric code identifying the specific monitoring location or sampling point as designated in the NPDES permit (e.g., 001, 002, EFF-1).' ;
    rdfs:domain ind:Dmr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:noDischargeFlag rdf:type rdf:Property ;
    rdfs:label 'No Discharge Flag' ;
    rdfs:comment 'Indicates whether there was no discharge from the outfall during the reporting period (True if no discharge occurred, False if discharge occurred).' ;
    rdfs:domain ind:Dmr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:noDischargeReason rdf:type rdf:Property ;
    rdfs:label 'No Discharge Reason' ;
    rdfs:comment 'Explanation for why no discharge occurred during the reporting period (e.g., facility shutdown, seasonal operations, maintenance outage).' ;
    rdfs:domain ind:Dmr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:noncomplianceFlag rdf:type rdf:Property ;
    rdfs:label 'Noncompliance Flag' ;
    rdfs:comment 'Indicates whether this discharge monitoring report contains any parameter measurements that exceeded permitted limits, triggering a noncompliance event (True if noncompliance detected, False if all parameters within limits).' ;
    rdfs:domain ind:Dmr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:preparerEmail rdf:type rdf:Property ;
    rdfs:label 'Preparer Email' ;
    rdfs:comment 'The email address of the individual who prepared this discharge monitoring report.' ;
    rdfs:domain ind:Dmr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preparerName rdf:type rdf:Property ;
    rdfs:label 'Preparer Name' ;
    rdfs:comment 'The full name of the individual who prepared and compiled this discharge monitoring report.' ;
    rdfs:domain ind:Dmr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preparerPhone rdf:type rdf:Property ;
    rdfs:label 'Preparer Phone' ;
    rdfs:comment 'The contact phone number for the individual who prepared this discharge monitoring report.' ;
    rdfs:domain ind:Dmr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preparerTitle rdf:type rdf:Property ;
    rdfs:label 'Preparer Title' ;
    rdfs:comment 'The job title or position of the individual who prepared this discharge monitoring report (e.g., Environmental Compliance Manager, Laboratory Supervisor).' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryAuthority rdf:type rdf:Property ;
    rdfs:label 'Regulatory Authority' ;
    rdfs:comment 'The regulatory body to which this discharge monitoring report was submitted (EPA for direct federal permits or state primacy agency for delegated state programs).' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportingPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Reporting Period End Date' ;
    rdfs:comment 'The last day of the monitoring period covered by this discharge monitoring report (typically the last day of the month or quarter).' ;
    rdfs:domain ind:Dmr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reportingPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Reporting Period Start Date' ;
    rdfs:comment 'The first day of the monitoring period covered by this discharge monitoring report (typically the first day of the month or quarter).' ;
    rdfs:domain ind:Dmr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:resubmissionFlag rdf:type rdf:Property ;
    rdfs:label 'Resubmission Flag' ;
    rdfs:comment 'Indicates whether this discharge monitoring report is a resubmission of a previously rejected or corrected report (True if resubmission, False if original submission).' ;
    rdfs:domain ind:Dmr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:stateAgencyName rdf:type rdf:Property ;
    rdfs:label 'State Agency Name' ;
    rdfs:comment 'The name of the state environmental or water quality agency that received this discharge monitoring report if submitted under a state-delegated NPDES program.' ;
    rdfs:domain ind:Dmr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submissionDueDate rdf:type rdf:Property ;
    rdfs:label 'Submission Due Date' ;
    rdfs:comment 'The regulatory deadline by which this discharge monitoring report must be submitted (typically the 28th day of the month following the reporting period).' ;
    rdfs:domain ind:Dmr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:submissionMethod rdf:type rdf:Property ;
    rdfs:label 'Submission Method' ;
    rdfs:comment 'The method by which this discharge monitoring report was submitted to the regulatory authority (NetDMR electronic system, paper mail, email, state-specific portal, or other).' ;
    rdfs:domain ind:Dmr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submissionStatus rdf:type rdf:Property ;
    rdfs:label 'Submission Status' ;
    rdfs:comment 'The current status of this discharge monitoring report in the submission and review workflow (draft, submitted, accepted by authority, rejected, under review, or resubmitted after corrections).' ;
    rdfs:domain ind:Dmr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:morId rdf:type rdf:Property ;
    rdfs:label 'Mor Id' ;
    rdfs:comment 'Unique identifier for the Monthly Operating Report record.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Mor .

ind:agencyResponseDate rdf:type rdf:Property ;
    rdfs:label 'Agency Response Date' ;
    rdfs:comment 'Date on which the state primacy agency responded to or acknowledged the submitted MOR.' ;
    rdfs:domain ind:Mor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:agencyResponseReceived rdf:type rdf:Property ;
    rdfs:label 'Agency Response Received' ;
    rdfs:comment 'Indicates whether a response or acknowledgment was received from the state primacy agency after submission.' ;
    rdfs:domain ind:Mor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:alkalinityAvgMgL rdf:type rdf:Property ;
    rdfs:label 'Alkalinity Avg Mg L' ;
    rdfs:comment 'Average alkalinity of finished water during the reporting month.' ;
    rdfs:domain ind:Mor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:certificationStatus rdf:type rdf:Property ;
    rdfs:label 'Certification Status' ;
    rdfs:comment 'Current status of the MOR in the certification and submission workflow.' ;
    rdfs:domain ind:Mor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:certifierLicenseNumber rdf:type rdf:Property ;
    rdfs:label 'Certifier License Number' ;
    rdfs:comment 'State-issued water treatment operator license number of the certifying operator.' ;
    rdfs:domain ind:Mor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:certifierName rdf:type rdf:Property ;
    rdfs:label 'Certifier Name' ;
    rdfs:comment 'Full name of the certified operator who reviewed and certified the accuracy of the MOR.' ;
    rdfs:domain ind:Mor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coagulantDosageAvgMgL rdf:type rdf:Property ;
    rdfs:label 'Coagulant Dosage Avg Mg L' ;
    rdfs:comment 'Average coagulant dosage applied during the reporting month.' ;
    rdfs:domain ind:Mor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ctComplianceStatus rdf:type rdf:Property ;
    rdfs:label 'Ct Compliance Status' ;
    rdfs:comment 'Indicates whether the achieved CT value met or exceeded the required CT value for the reporting month.' ;
    rdfs:domain ind:Mor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ctValueAchieved rdf:type rdf:Property ;
    rdfs:label 'Ct Value Achieved' ;
    rdfs:comment 'Calculated CT value (disinfectant concentration multiplied by contact time) achieved for pathogen inactivation during the reporting month.' ;
    rdfs:domain ind:Mor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ctValueRequired rdf:type rdf:Property ;
    rdfs:label 'Ct Value Required' ;
    rdfs:comment 'Regulatory CT value required for adequate pathogen inactivation based on water temperature and pH.' ;
    rdfs:domain ind:Mor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:disinfectantResidualAvgMgL rdf:type rdf:Property ;
    rdfs:label 'Disinfectant Residual Avg Mg L' ;
    rdfs:comment 'Average disinfectant residual concentration in the distribution system during the reporting month.' ;
    rdfs:domain ind:Mor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:disinfectantResidualMinMgL rdf:type rdf:Property ;
    rdfs:label 'Disinfectant Residual Min Mg L' ;
    rdfs:comment 'Minimum disinfectant residual concentration recorded in the distribution system during the reporting month.' ;
    rdfs:domain ind:Mor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:disinfectantType rdf:type rdf:Property ;
    rdfs:label 'Disinfectant Type' ;
    rdfs:comment 'Primary disinfection method used at the treatment plant during the reporting month.' ;
    rdfs:domain ind:Mor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:finishedWaterTurbidityAvgNtu rdf:type rdf:Property ;
    rdfs:label 'Finished Water Turbidity Avg Ntu' ;
    rdfs:comment 'Average turbidity of finished treated water leaving the plant during the reporting month.' ;
    rdfs:domain ind:Mor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:finishedWaterTurbidityMaxNtu rdf:type rdf:Property ;
    rdfs:label 'Finished Water Turbidity Max Ntu' ;
    rdfs:comment 'Maximum turbidity of finished treated water recorded during the reporting month.' ;
    rdfs:domain ind:Mor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:operationalEventsCount rdf:type rdf:Property ;
    rdfs:label 'Operational Events Count' ;
    rdfs:comment 'Number of significant operational events (equipment failures, process upsets, maintenance shutdowns) recorded during the reporting month.' ;
    rdfs:domain ind:Mor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:operationalEventsDescription rdf:type rdf:Property ;
    rdfs:label 'Operational Events Description' ;
    rdfs:comment 'Narrative description of significant operational events that occurred during the reporting month.' ;
    rdfs:domain ind:Mor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:peakDailyFlowMgd rdf:type rdf:Property ;
    rdfs:label 'Peak Daily Flow Mgd' ;
    rdfs:comment 'Maximum daily flow rate of treated water produced during the reporting month.' ;
    rdfs:domain ind:Mor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:preparerLicenseNumber rdf:type rdf:Property ;
    rdfs:label 'Preparer License Number' ;
    rdfs:comment 'State-issued water treatment operator license number of the preparer.' ;
    rdfs:domain ind:Mor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rawWaterTurbidityAvgNtu rdf:type rdf:Property ;
    rdfs:label 'Raw Water Turbidity Avg Ntu' ;
    rdfs:comment 'Average turbidity of raw source water entering the treatment plant during the reporting month.' ;
    rdfs:domain ind:Mor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rawWaterTurbidityMaxNtu rdf:type rdf:Property ;
    rdfs:label 'Raw Water Turbidity Max Ntu' ;
    rdfs:comment 'Maximum turbidity of raw source water recorded during the reporting month.' ;
    rdfs:domain ind:Mor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reportNumber rdf:type rdf:Property ;
    rdfs:label 'Report Number' ;
    rdfs:comment 'Externally-known unique report number assigned by the state primacy agency or internal tracking system.' ;
    rdfs:domain ind:Mor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportingMonth rdf:type rdf:Property ;
    rdfs:label 'Reporting Month' ;
    rdfs:comment 'The calendar month for which this MOR documents water treatment plant operations.' ;
    rdfs:domain ind:Mor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reportingYear rdf:type rdf:Property ;
    rdfs:label 'Reporting Year' ;
    rdfs:comment 'The calendar year for which this MOR is submitted.' ;
    rdfs:domain ind:Mor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sourceWaterType rdf:type rdf:Property ;
    rdfs:label 'Source Water Type' ;
    rdfs:comment 'Primary type of source water used by the treatment plant during the reporting month.' ;
    rdfs:domain ind:Mor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalWaterProducedMgd rdf:type rdf:Property ;
    rdfs:label 'Total Water Produced Mgd' ;
    rdfs:comment 'Total volume of treated water produced by the WTP during the reporting month, measured in million gallons per day.' ;
    rdfs:domain ind:Mor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:turbidityComplianceStatus rdf:type rdf:Property ;
    rdfs:label 'Turbidity Compliance Status' ;
    rdfs:comment 'Indicates whether turbidity levels met regulatory Maximum Contaminant Level (MCL) requirements during the reporting month.' ;
    rdfs:domain ind:Mor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:violationsCount rdf:type rdf:Property ;
    rdfs:label 'Violations Count' ;
    rdfs:comment 'Number of regulatory violations (MCL exceedances, monitoring failures, reporting failures) recorded during the reporting month.' ;
    rdfs:domain ind:Mor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:violationsDescription rdf:type rdf:Property ;
    rdfs:label 'Violations Description' ;
    rdfs:comment 'Narrative description of regulatory violations that occurred during the reporting month.' ;
    rdfs:domain ind:Mor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actionNumber rdf:type rdf:Property ;
    rdfs:label 'Action Number' ;
    rdfs:comment 'Official enforcement action number or case number assigned by the regulatory agency (EPA, state primacy agency, NPDES authority). This is the externally-known identifier used in all regulatory correspondence and legal documents.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actionStatus rdf:type rdf:Property ;
    rdfs:label 'Action Status' ;
    rdfs:comment 'Current lifecycle status of the enforcement action. Tracks progression from issuance through utility response, negotiation, and final resolution.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actionSummary rdf:type rdf:Property ;
    rdfs:label 'Action Summary' ;
    rdfs:comment 'Brief summary of the enforcement action, including the nature of the violation, regulatory basis, and key requirements. Provides context for reporting and management review.' ;
    rdfs:domain ind:EnforcementAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actionType rdf:type rdf:Property ;
    rdfs:label 'Action Type' ;
    rdfs:comment 'Type of formal enforcement action initiated by the regulatory agency. Includes Notice of Violation (NOV), Administrative Order (AO), Consent Order, Compliance Schedule, civil penalty assessment, or criminal referral.' ;
    rdfs:domain ind:EnforcementAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appealFiledFlag rdf:type rdf:Property ;
    rdfs:label 'Appeal Filed Flag' ;
    rdfs:comment 'Indicates whether the utility filed a formal appeal or contested the enforcement action through administrative or judicial proceedings.' ;
    rdfs:domain ind:EnforcementAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appealFilingDate rdf:type rdf:Property ;
    rdfs:label 'Appeal Filing Date' ;
    rdfs:comment 'Date the utility filed its appeal or petition for review. Null if no appeal was filed.' ;
    rdfs:domain ind:EnforcementAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:boardNotificationDate rdf:type rdf:Property ;
    rdfs:label 'Board Notification Date' ;
    rdfs:comment 'Date the utility\'s Board of Directors or governing body was notified of the enforcement action. Tracks governance and executive oversight requirements.' ;
    rdfs:domain ind:EnforcementAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:civilPenaltyAmount rdf:type rdf:Property ;
    rdfs:label 'Civil Penalty Amount' ;
    rdfs:comment 'Monetary penalty amount assessed by the regulatory agency in U.S. dollars. Null if no civil penalty was imposed.' ;
    rdfs:domain ind:EnforcementAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:complianceScheduleFinalDeadline rdf:type rdf:Property ;
    rdfs:label 'Compliance Schedule Final Deadline' ;
    rdfs:comment 'Final deadline by which all corrective actions and compliance milestones must be completed. Null if no compliance schedule is required.' ;
    rdfs:domain ind:EnforcementAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:complianceScheduleRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Compliance Schedule Required Flag' ;
    rdfs:comment 'Indicates whether the enforcement action includes a formal compliance schedule with milestones and deadlines for corrective actions.' ;
    rdfs:domain ind:EnforcementAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:correctiveActionRequired rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Required' ;
    rdfs:comment 'Description of the corrective actions required by the enforcement action. May include operational changes, infrastructure upgrades, process improvements, or enhanced monitoring.' ;
    rdfs:domain ind:EnforcementAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Document Reference Number' ;
    rdfs:comment 'Internal document management system reference number for the enforcement action file. Links to stored correspondence, legal documents, and supporting materials.' ;
    rdfs:domain ind:EnforcementAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalCounselAssigned rdf:type rdf:Property ;
    rdfs:label 'Legal Counsel Assigned' ;
    rdfs:comment 'Name of the internal or external legal counsel assigned to manage the utility\'s response to the enforcement action. Business-confidential information.' ;
    rdfs:domain ind:EnforcementAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalFirmName rdf:type rdf:Property ;
    rdfs:label 'Legal Firm Name' ;
    rdfs:comment 'Name of the external law firm representing the utility, if external counsel is engaged. Null if handled internally.' ;
    rdfs:domain ind:EnforcementAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:penaltyPaidAmount rdf:type rdf:Property ;
    rdfs:label 'Penalty Paid Amount' ;
    rdfs:comment 'Actual amount paid by the utility toward the civil penalty. May differ from assessed amount due to negotiated settlements or payment plans.' ;
    rdfs:domain ind:EnforcementAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:penaltyPaymentDate rdf:type rdf:Property ;
    rdfs:label 'Penalty Payment Date' ;
    rdfs:comment 'Date the civil penalty payment was made to the regulatory agency. Tracks compliance with payment deadlines.' ;
    rdfs:domain ind:EnforcementAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:publicNoticeDate rdf:type rdf:Property ;
    rdfs:label 'Public Notice Date' ;
    rdfs:comment 'Date public notice of the enforcement action was issued. Null if public notice is not required.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:publicNoticeRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Public Notice Required Flag' ;
    rdfs:comment 'Indicates whether the enforcement action requires public notification under regulatory or consent order terms. Drives public communication and transparency obligations.' ;
    rdfs:domain ind:EnforcementAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:receivedDate rdf:type rdf:Property ;
    rdfs:label 'Received Date' ;
    rdfs:comment 'Date the utility officially received the enforcement action notice. Used to calculate response deadlines and compliance timelines.' ;
    rdfs:domain ind:EnforcementAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:resolutionOutcome rdf:type rdf:Property ;
    rdfs:label 'Resolution Outcome' ;
    rdfs:comment 'Final outcome of the enforcement action. Indicates how the action was resolved (compliance achieved, consent order executed, penalty paid, dismissed, or under appeal).' ;
    rdfs:domain ind:EnforcementAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responseDueDate rdf:type rdf:Property ;
    rdfs:label 'Response Due Date' ;
    rdfs:comment 'Deadline by which the utility must submit a formal response to the enforcement action. Typically specified in the enforcement notice or calculated based on regulatory timelines.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:responseSubmittedDate rdf:type rdf:Property ;
    rdfs:label 'Response Submitted Date' ;
    rdfs:comment 'Date the utility submitted its formal response to the enforcement action. Tracks compliance with response deadlines.' ;
    rdfs:domain ind:EnforcementAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sepDescription rdf:type rdf:Property ;
    rdfs:label 'Sep Description' ;
    rdfs:comment 'Description of the Supplemental Environmental Project (SEP) agreed to as part of the enforcement settlement. Null if no SEP is included.' ;
    rdfs:domain ind:EnforcementAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sepEstimatedCost rdf:type rdf:Property ;
    rdfs:label 'Sep Estimated Cost' ;
    rdfs:comment 'Estimated cost of the Supplemental Environmental Project (SEP) in U.S. dollars. Used to calculate penalty offsets and track SEP investment.' ;
    rdfs:domain ind:EnforcementAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:supplementalEnvironmentalProjectFlag rdf:type rdf:Property ;
    rdfs:label 'Supplemental Environmental Project Flag' ;
    rdfs:comment 'Indicates whether the enforcement action includes a Supplemental Environmental Project (SEP) as part of the settlement. SEPs are environmentally beneficial projects that go beyond compliance requirements and may offset civil penalties.' ;
    rdfs:domain ind:EnforcementAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:correctiveActionSummary rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Summary' ;
    rdfs:comment 'Summary of the corrective actions required to address deficiencies and achieve compliance.' ;
    rdfs:domain ind:RegulatoryInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deficiencyCount rdf:type rdf:Property ;
    rdfs:label 'Deficiency Count' ;
    rdfs:comment 'Total number of deficiencies or non-compliance items identified during the inspection.' ;
    rdfs:domain ind:RegulatoryInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:enforcementActionFlag rdf:type rdf:Property ;
    rdfs:label 'Enforcement Action Flag' ;
    rdfs:comment 'Indicates whether formal enforcement action (administrative order, consent decree, penalty) was initiated as a result of this inspection.' ;
    rdfs:domain ind:RegulatoryInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:findingsSummary rdf:type rdf:Property ;
    rdfs:label 'Findings Summary' ;
    rdfs:comment 'High-level summary of the inspection findings, deficiencies identified, and overall compliance status.' ;
    rdfs:domain ind:RegulatoryInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:followUpInspectionRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Follow Up Inspection Required Flag' ;
    rdfs:comment 'Indicates whether a follow-up inspection by the regulatory agency is required to verify corrective action completion.' ;
    rdfs:domain ind:RegulatoryInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:followUpInspectionScheduledDate rdf:type rdf:Property ;
    rdfs:label 'Follow Up Inspection Scheduled Date' ;
    rdfs:comment 'Scheduled date for the follow-up inspection if required.' ;
    rdfs:domain ind:RegulatoryInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:inspectionReportReceivedDate rdf:type rdf:Property ;
    rdfs:label 'Inspection Report Received Date' ;
    rdfs:comment 'Date on which the utility received the official inspection report from the regulatory agency.' ;
    rdfs:domain ind:RegulatoryInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:inspectionReportStatus rdf:type rdf:Property ;
    rdfs:label 'Inspection Report Status' ;
    rdfs:comment 'Current status of the official inspection report (draft, final, under review, accepted, disputed).' ;
    rdfs:domain ind:RegulatoryInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectionScope rdf:type rdf:Property ;
    rdfs:label 'Inspection Scope' ;
    rdfs:comment 'Description of the areas, processes, or systems covered during the inspection (e.g., treatment processes, discharge monitoring, pretreatment program, laboratory practices).' ;
    rdfs:domain ind:RegulatoryInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectorContactEmail rdf:type rdf:Property ;
    rdfs:label 'Inspector Contact Email' ;
    rdfs:comment 'Email address of the lead inspector for official correspondence.' ;
    rdfs:domain ind:RegulatoryInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectorContactPhone rdf:type rdf:Property ;
    rdfs:label 'Inspector Contact Phone' ;
    rdfs:comment 'Phone number of the lead inspector for follow-up communication.' ;
    rdfs:domain ind:RegulatoryInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectorTitle rdf:type rdf:Property ;
    rdfs:label 'Inspector Title' ;
    rdfs:comment 'Job title or role of the lead inspector (e.g., Environmental Compliance Officer, Sanitary Survey Specialist).' ;
    rdfs:domain ind:RegulatoryInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:significantDeficiencyClassification rdf:type rdf:Property ;
    rdfs:label 'Significant Deficiency Classification' ;
    rdfs:comment 'Classification or category of the significant deficiency if identified (e.g., treatment process failure, monitoring inadequacy, operational deficiency).' ;
    rdfs:domain ind:RegulatoryInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:significantDeficiencyFlag rdf:type rdf:Property ;
    rdfs:label 'Significant Deficiency Flag' ;
    rdfs:comment 'Indicates whether any significant deficiencies (as defined by SDWA) were identified that could affect water quality or public health.' ;
    rdfs:domain ind:RegulatoryInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:utilityRepresentativeTitle rdf:type rdf:Property ;
    rdfs:label 'Utility Representative Title' ;
    rdfs:comment 'Job title of the utility representative who coordinated the inspection (e.g., Compliance Manager, Plant Superintendent).' ;
    rdfs:domain ind:RegulatoryInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:violationIdentifiedFlag rdf:type rdf:Property ;
    rdfs:label 'Violation Identified Flag' ;
    rdfs:comment 'Indicates whether any regulatory violations (SDWA, CWA, NPDES permit) were formally identified during the inspection.' ;
    rdfs:domain ind:RegulatoryInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:actionDescription rdf:type rdf:Property ;
    rdfs:label 'Action Description' ;
    rdfs:comment 'Detailed description of the corrective action to be taken, including specific tasks, procedures, and deliverables required to address the compliance gap.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actionTitle rdf:type rdf:Property ;
    rdfs:label 'Action Title' ;
    rdfs:comment 'Brief descriptive title summarizing the corrective action for quick identification and reporting.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actualCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Actual Completion Date' ;
    rdfs:comment 'Actual date when the corrective action was fully implemented and completed, used to track compliance with regulatory deadlines.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:actualStartDate rdf:type rdf:Property ;
    rdfs:label 'Actual Start Date' ;
    rdfs:comment 'Actual date when implementation of the corrective action commenced.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:agencyNotificationDate rdf:type rdf:Property ;
    rdfs:label 'Agency Notification Date' ;
    rdfs:comment 'Date when the regulatory agency was formally notified of the corrective action plan or completion, fulfilling reporting requirements.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:agencyNotificationMethod rdf:type rdf:Property ;
    rdfs:label 'Agency Notification Method' ;
    rdfs:comment 'Method used to notify the regulatory agency of the corrective action, such as formal letter, email, portal submission, phone, or in-person meeting.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agencyResponse rdf:type rdf:Property ;
    rdfs:label 'Agency Response' ;
    rdfs:comment 'Summary of the regulatory agencys response to the corrective action notification, including any feedback, approval, or additional requirements.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:closureNotes rdf:type rdf:Property ;
    rdfs:label 'Closure Notes' ;
    rdfs:comment 'Final notes documenting the closure of the corrective action, including lessons learned and recommendations for future compliance management.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:effectivenessReviewDate rdf:type rdf:Property ;
    rdfs:label 'Effectiveness Review Date' ;
    rdfs:comment 'Scheduled date for follow-up review to assess the long-term effectiveness of the corrective action and any preventive measures.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:effectivenessReviewOutcome rdf:type rdf:Property ;
    rdfs:label 'Effectiveness Review Outcome' ;
    rdfs:comment 'Summary of the effectiveness review findings, documenting whether the corrective action achieved sustained compliance improvement.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:plannedCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Planned Completion Date' ;
    rdfs:comment 'Target date by which the corrective action must be fully implemented and completed, often driven by regulatory deadlines or consent decree requirements.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:plannedStartDate rdf:type rdf:Property ;
    rdfs:label 'Planned Start Date' ;
    rdfs:comment 'Scheduled date when implementation of the corrective action is planned to begin.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:preventiveActionDescription rdf:type rdf:Property ;
    rdfs:label 'Preventive Action Description' ;
    rdfs:comment 'Description of preventive measures implemented to address systemic issues and prevent future occurrences of similar compliance gaps.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preventiveActionImplemented rdf:type rdf:Property ;
    rdfs:label 'Preventive Action Implemented' ;
    rdfs:comment 'Indicates whether preventive actions were implemented to prevent recurrence of the compliance gap or violation.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryAgencyNotified rdf:type rdf:Property ;
    rdfs:label 'Regulatory Agency Notified' ;
    rdfs:comment 'Indicates whether the relevant regulatory agency (EPA, state primacy agency, etc.) was notified of the corrective action as required by enforcement orders or consent decrees.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:responsibleIndividual rdf:type rdf:Property ;
    rdfs:label 'Responsible Individual' ;
    rdfs:comment 'Name of the individual assigned accountability for ensuring the corrective action is completed on time and meets all requirements.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rootCauseAnalysis rdf:type rdf:Property ;
    rdfs:label 'Root Cause Analysis' ;
    rdfs:comment 'Documented analysis identifying the underlying root cause(s) of the compliance gap or violation, supporting effective corrective action design.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supportingEvidenceLocation rdf:type rdf:Property ;
    rdfs:label 'Supporting Evidence Location' ;
    rdfs:comment 'File path, document management system reference, or physical location where supporting evidence and documentation for the corrective action is stored for audit trail purposes.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verificationDate rdf:type rdf:Property ;
    rdfs:label 'Verification Date' ;
    rdfs:comment 'Date when the corrective action was verified as complete and effective through the specified verification method.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:verificationMethod rdf:type rdf:Property ;
    rdfs:label 'Verification Method' ;
    rdfs:comment 'Method used to verify that the corrective action was implemented effectively and achieved the intended compliance outcome, such as internal audit, third-party audit, regulatory inspection, documentation review, testing, or monitoring.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verificationNotes rdf:type rdf:Property ;
    rdfs:label 'Verification Notes' ;
    rdfs:comment 'Detailed notes documenting the verification process, findings, and any additional observations regarding the effectiveness of the corrective action.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verificationStatus rdf:type rdf:Property ;
    rdfs:label 'Verification Status' ;
    rdfs:comment 'Status of the verification process indicating whether the corrective action has been confirmed as effective in addressing the compliance gap.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:parentRegulatoryAgencyRegulatoryAgencyId rdf:type rdf:Property ;
    rdfs:label 'Parent Regulatory Agency Regulatory Agency Id' ;
    rdfs:comment 'Reference to the parent or umbrella agency if this agency is a regional office, division, or sub-agency (e.g., EPA Region 5 parent is EPA). Null if this is a top-level agency.' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RegulatoryAgency .

ind:primaryParentRegulatoryAgencyId rdf:type rdf:Property ;
    rdfs:label 'Primary Parent Regulatory Agency Id' ;
    rdfs:comment 'Self-referencing FK on regulatory_agency (parent_regulatory_agency_id)' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RegulatoryAgency .

ind:agencyCode rdf:type rdf:Property ;
    rdfs:label 'Agency Code' ;
    rdfs:comment 'Short alphanumeric code uniquely identifying the regulatory agency within the utility\'s systems (e.g., EPA_R5, STATE_DNR, PUC_WI).' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agencyMainEmail rdf:type rdf:Property ;
    rdfs:label 'Agency Main Email' ;
    rdfs:comment 'General inquiry or main email address for the regulatory agency.' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agencyMainPhone rdf:type rdf:Property ;
    rdfs:label 'Agency Main Phone' ;
    rdfs:comment 'Main switchboard or general inquiry phone number for the regulatory agency.' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agencyName rdf:type rdf:Property ;
    rdfs:label 'Agency Name' ;
    rdfs:comment 'Full legal name of the regulatory agency or governing body (e.g., U.S. Environmental Protection Agency Region 5, Wisconsin Department of Natural Resources).' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agencyShortName rdf:type rdf:Property ;
    rdfs:label 'Agency Short Name' ;
    rdfs:comment 'Abbreviated or commonly used name for the agency (e.g., EPA Region 5, WI DNR, OSHA).' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agencyStatus rdf:type rdf:Property ;
    rdfs:label 'Agency Status' ;
    rdfs:comment 'Current operational status of the regulatory agency (active, inactive, merged, dissolved).' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agencyType rdf:type rdf:Property ;
    rdfs:label 'Agency Type' ;
    rdfs:comment 'Classification of the regulatory agency by its primary regulatory focus (environmental, health, safety, rate regulatory, labor, quality standards, other). [ENUM-REF-CANDIDATE: environmental|health|safety|rate_regulatory|labor|quality_standards|other — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agencyWebsiteUrl rdf:type rdf:Property ;
    rdfs:label 'Agency Website Url' ;
    rdfs:comment 'Official website URL for the regulatory agency.' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:businessHours rdf:type rdf:Property ;
    rdfs:label 'Business Hours' ;
    rdfs:comment 'Standard business hours of operation for the regulatory agency office (e.g., Monday-Friday 8:00 AM - 5:00 PM PST).' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:emergencyContactPhone rdf:type rdf:Property ;
    rdfs:label 'Emergency Contact Phone' ;
    rdfs:comment '24-hour emergency contact phone number for reporting spills, violations, or urgent compliance matters.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:enforcementAuthorityLevel rdf:type rdf:Property ;
    rdfs:label 'Enforcement Authority Level' ;
    rdfs:comment 'Level of enforcement authority this agency holds over the utility (primary, delegated, advisory, none). Primary indicates direct enforcement power; delegated indicates authority granted by a higher-level agency; advisory indicates no direct enforcement.' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:faxNumber rdf:type rdf:Property ;
    rdfs:label 'Fax Number' ;
    rdfs:comment 'Fax number for document submission to the regulatory agency, if applicable.' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectionFrequencyMonths rdf:type rdf:Property ;
    rdfs:label 'Inspection Frequency Months' ;
    rdfs:comment 'Typical frequency in months at which this regulatory agency conducts inspections of utility facilities under its jurisdiction.' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:inspectionFrequencyTypical rdf:type rdf:Property ;
    rdfs:label 'Inspection Frequency Typical' ;
    rdfs:comment 'Typical frequency at which this agency conducts inspections or audits of utility facilities (annual, biennial, triennial, as-needed, risk-based).' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jurisdictionGeographicArea rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction Geographic Area' ;
    rdfs:comment 'Geographic area or service territory over which the agency has regulatory authority (e.g., EPA Region 5 covers IL, IN, MI, MN, OH, WI; or specific county/municipality names).' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jurisdictionLevel rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction Level' ;
    rdfs:comment 'The governmental level at which the agency operates (federal, state, regional, local, international).' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notificationDeadlineHours rdf:type rdf:Property ;
    rdfs:label 'Notification Deadline Hours' ;
    rdfs:comment 'Standard number of hours within which the utility must notify this agency of reportable incidents or violations (e.g., 24 hours for SSO events).' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:npdesAuthorityFlag rdf:type rdf:Property ;
    rdfs:label 'Npdes Authority Flag' ;
    rdfs:comment 'Indicates whether this agency has authority to issue and enforce NPDES permits under the Clean Water Act. True if authorized, False otherwise.' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pretreatmentAuthorityFlag rdf:type rdf:Property ;
    rdfs:label 'Pretreatment Authority Flag' ;
    rdfs:comment 'Indicates whether this agency has authority to oversee industrial pretreatment programs. True if authorized, False otherwise.' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:primacyAgencyFlag rdf:type rdf:Property ;
    rdfs:label 'Primacy Agency Flag' ;
    rdfs:comment 'Indicates whether this agency has primacy authority for Safe Drinking Water Act (SDWA) enforcement in its jurisdiction. True if primacy agency, False otherwise.' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:primacyStatus rdf:type rdf:Property ;
    rdfs:label 'Primacy Status' ;
    rdfs:comment 'Indicates whether this agency is a primacy agency under the Safe Drinking Water Act (SDWA) or Clean Water Act (CWA), meaning it has been delegated primary enforcement authority by EPA (primacy_agency, non_primacy, not_applicable).' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryContactEmail rdf:type rdf:Property ;
    rdfs:label 'Primary Contact Email' ;
    rdfs:comment 'Primary email address for the agency contact.' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryContactName rdf:type rdf:Property ;
    rdfs:label 'Primary Contact Name' ;
    rdfs:comment 'Full name of the primary contact person at the agency for utility compliance matters.' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryContactPhone rdf:type rdf:Property ;
    rdfs:label 'Primary Contact Phone' ;
    rdfs:comment 'Primary telephone number for the agency contact.' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryContactTitle rdf:type rdf:Property ;
    rdfs:label 'Primary Contact Title' ;
    rdfs:comment 'Job title or role of the primary contact person at the agency.' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryRegulatoryProgram rdf:type rdf:Property ;
    rdfs:label 'Primary Regulatory Program' ;
    rdfs:comment 'The main regulatory program or statute administered by this agency relevant to water utilities (e.g., SDWA, CWA, NPDES, OSHA, Rate Regulation).' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regionCode rdf:type rdf:Property ;
    rdfs:label 'Region Code' ;
    rdfs:comment 'Regional designation or code if the agency operates within a specific region (e.g., EPA Region 9, Water Board Region 4).' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportingFrequencyDefault rdf:type rdf:Property ;
    rdfs:label 'Reporting Frequency Default' ;
    rdfs:comment 'Default or most common reporting frequency required by this agency for compliance reports (monthly, quarterly, semi-annual, annual, event-driven, as-required).' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportingSystemName rdf:type rdf:Property ;
    rdfs:label 'Reporting System Name' ;
    rdfs:comment 'Name of the electronic reporting system used by the agency (e.g., NetDMR, SDWIS, state-specific portal).' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submissionCredentialsReference rdf:type rdf:Property ;
    rdfs:label 'Submission Credentials Reference' ;
    rdfs:comment 'Reference identifier or location for stored login credentials or API keys used to access the agency\'s submission portal. Should reference a secure credential vault, not store actual credentials.' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submissionPortalName rdf:type rdf:Property ;
    rdfs:label 'Submission Portal Name' ;
    rdfs:comment 'Name of the online submission portal or system (e.g., NetDMR, State Environmental Portal, OSHA Injury Tracking Application).' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submissionPortalUrl rdf:type rdf:Property ;
    rdfs:label 'Submission Portal Url' ;
    rdfs:comment 'URL for the online portal or system used to submit compliance reports, permits, or other regulatory documents to this agency (e.g., NetDMR, state e-reporting system).' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:terminationDate rdf:type rdf:Property ;
    rdfs:label 'Termination Date' ;
    rdfs:comment 'Date when this agency\'s jurisdiction or regulatory authority over the utility ended or will end. Null if still active.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:amiEnabledFlag rdf:type rdf:Property ;
    rdfs:label 'Ami Enabled Flag' ;
    rdfs:comment 'Indicates whether this offering requires or supports Advanced Metering Infrastructure (AMI) for automated meter reading and real-time consumption monitoring. True = AMI required or available; False = manual or Automatic Meter Reading (AMR) only.' ;
    rdfs:domain ind:Offering ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:autoRenewalFlag rdf:type rdf:Property ;
    rdfs:label 'Auto Renewal Flag' ;
    rdfs:comment 'Indicates whether the service contract automatically renews at the end of the contract term. True = auto-renews unless customer cancels; False = requires explicit renewal. Null if not applicable.' ;
    rdfs:domain ind:Offering ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:baseRateAmount rdf:type rdf:Property ;
    rdfs:label 'Base Rate Amount' ;
    rdfs:comment 'Fixed monthly or periodic base charge for the service offering, independent of consumption. Covers fixed costs such as meter maintenance, billing, and infrastructure access. Expressed in local currency (USD for U.S. utilities).' ;
    rdfs:domain ind:Service ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:billingCycleCode rdf:type rdf:Property ;
    rdfs:label 'Billing Cycle Code' ;
    rdfs:comment 'Code identifying the billing cycle or schedule applicable to this offering. Examples: MNTH (monthly), QRTR (quarterly), BIMON (bi-monthly). Aligns with Oracle Utilities Customer Care and Billing (CC&B) billing cycle configuration.' ;
    rdfs:domain ind:Service ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capacityCharge rdf:type rdf:Property ;
    rdfs:label 'Capacity Charge' ;
    rdfs:comment 'Fee for reserving system capacity or infrastructure access, common in industrial and municipal bulk water agreements. May be based on meter size, peak demand, or contracted volume. Also known as a demand charge or readiness-to-serve charge.' ;
    rdfs:domain ind:Offering ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:connectionFee rdf:type rdf:Property ;
    rdfs:label 'Connection Fee' ;
    rdfs:comment 'One-time fee charged to establish a new service connection, including meter installation, service line connection, and administrative setup. May vary by customer class and service type.' ;
    rdfs:domain ind:Offering ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:conservationProgramEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Conservation Program Eligible Flag' ;
    rdfs:comment 'Indicates whether customers enrolled in this offering are eligible for water conservation programs, rebates, or incentives (e.g., low-flow fixture rebates, landscape conversion incentives). True = eligible; False = not eligible.' ;
    rdfs:domain ind:Offering ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:contractTermMonths rdf:type rdf:Property ;
    rdfs:label 'Contract Term Months' ;
    rdfs:comment 'Standard contract duration in months for this offering. Common for commercial, industrial, and municipal agreements. Null for month-to-month residential service.' ;
    rdfs:domain ind:Service ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:deliveryMode rdf:type rdf:Property ;
    rdfs:label 'Delivery Mode' ;
    rdfs:comment 'Method by which the service is delivered and billed. Metered = consumption-based billing via Advanced Metering Infrastructure (AMI) or Automatic Meter Reading (AMR); Unmetered = fixed-rate service without consumption measurement; Flat rate = fixed periodic charge regardless of usage; Seasonal = service active only during specific periods; Temporary = short-term service for construction or events; Emergency = contingency supply during outages or disasters.' ;
    rdfs:domain ind:Offering ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fireProtectionServiceFlag rdf:type rdf:Property ;
    rdfs:label 'Fire Protection Service Flag' ;
    rdfs:comment 'Indicates whether this offering includes dedicated fire protection service (e.g., fire hydrant access, private fire line). True = fire protection included; False = potable water or wastewater service only.' ;
    rdfs:domain ind:Service ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:latePaymentPenaltyPercent rdf:type rdf:Property ;
    rdfs:label 'Late Payment Penalty Percent' ;
    rdfs:comment 'Percentage penalty applied to overdue balances after the payment due date. Subject to Public Utilities Commission regulations. Null if no late fee applies.' ;
    rdfs:domain ind:Offering ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumMonthlyCharge rdf:type rdf:Property ;
    rdfs:label 'Minimum Monthly Charge' ;
    rdfs:comment 'Minimum amount a customer will be billed each billing period, regardless of consumption. Ensures cost recovery for fixed infrastructure and service availability. Null if no minimum applies.' ;
    rdfs:domain ind:Offering ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pressureRangePsiMax rdf:type rdf:Property ;
    rdfs:label 'Pressure Range Psi Max' ;
    rdfs:comment 'Maximum water pressure in PSI at the customer service connection under normal operating conditions. Excessive pressure may require Pressure Reducing Valve (PRV) installation. Null for wastewater or non-pressurized services.' ;
    rdfs:domain ind:Offering ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:pressureRangePsiMin rdf:type rdf:Property ;
    rdfs:label 'Pressure Range Psi Min' ;
    rdfs:comment 'Minimum water pressure in PSI guaranteed at the customer service connection under normal operating conditions. Part of service delivery specifications. Null for wastewater or non-pressurized services.' ;
    rdfs:domain ind:Offering ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:slaResponseTimeHours rdf:type rdf:Property ;
    rdfs:label 'Sla Response Time Hours' ;
    rdfs:comment 'Maximum time in hours within which the utility commits to respond to service requests, outages, or quality complaints for this offering. Part of the contractual Service Level Agreement (SLA). Null if no formal SLA applies.' ;
    rdfs:domain ind:Service ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:slaRestorationTimeHours rdf:type rdf:Property ;
    rdfs:label 'Sla Restoration Time Hours' ;
    rdfs:comment 'Maximum time in hours within which the utility commits to restore service following an outage or interruption for this offering. Part of the contractual Service Level Agreement (SLA). Null if no formal SLA applies.' ;
    rdfs:domain ind:Service ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:terminationNoticeDays rdf:type rdf:Property ;
    rdfs:label 'Termination Notice Days' ;
    rdfs:comment 'Number of days advance notice required for customer to terminate or discontinue service. Common for commercial and industrial contracts. Null for standard residential service.' ;
    rdfs:domain ind:Offering ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:volumetricRateAmount rdf:type rdf:Property ;
    rdfs:label 'Volumetric Rate Amount' ;
    rdfs:comment 'Per-unit charge for water or wastewater service based on consumption volume. Typically expressed in dollars per thousand gallons ($/kgal) or dollars per hundred cubic feet ($/CCF). Null for unmetered or flat-rate offerings.' ;
    rdfs:domain ind:Offering ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:volumetricRateUnit rdf:type rdf:Property ;
    rdfs:label 'Volumetric Rate Unit' ;
    rdfs:comment 'Unit of measure for volumetric billing. kgal = thousand gallons; CCF = hundred cubic feet; gallon = individual gallon; cubic meter = m³ (common in international contexts); acre-foot = volume unit for large agricultural or municipal contracts.' ;
    rdfs:domain ind:Offering ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waterQualityStandard rdf:type rdf:Property ;
    rdfs:label 'Water Quality Standard' ;
    rdfs:comment 'Applicable water quality standard or regulatory compliance framework for this offering. Examples: Safe Drinking Water Act (SDWA) Primary Standards, Recycled Water Quality Standards (Title 22 California), Industrial Discharge Permit Limits. Null for non-water offerings (e.g., wastewater collection).' ;
    rdfs:domain ind:Offering ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceRateScheduleId rdf:type rdf:Property ;
    rdfs:label 'Service Rate Schedule Id' ;
    rdfs:comment 'Unique identifier for the service_rate_schedule data product (auto-inserted pre-linking).' ;
    rdfs:domain ind:ServiceRateSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:treatmentFacilityId rdf:type rdf:Property ;
    rdfs:label 'Treatment Facility Id' ;
    rdfs:comment 'add column treatment_facility_id (BIGINT) with FK to treatment.facility.facility_id - service territories are served by specific treatment facilities' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Facility .

ind:areaSquareMiles rdf:type rdf:Property ;
    rdfs:label 'Area Square Miles' ;
    rdfs:comment 'Total geographic area of the service territory measured in square miles.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:commercialCustomerCount rdf:type rdf:Property ;
    rdfs:label 'Commercial Customer Count' ;
    rdfs:comment 'Number of commercial customer accounts within the territory.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:countyName rdf:type rdf:Property ;
    rdfs:label 'County Name' ;
    rdfs:comment 'Primary county in which the service territory is located, used for regulatory reporting and jurisdictional analysis.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:franchiseAgreementNumber rdf:type rdf:Property ;
    rdfs:label 'Franchise Agreement Number' ;
    rdfs:comment 'Identifier of the regulatory franchise agreement or certificate of public convenience and necessity (CPCN) authorizing service in this territory.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:franchiseExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Franchise Expiration Date' ;
    rdfs:comment 'Date when the current franchise agreement or certificate expires and requires renewal or renegotiation.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:gisBoundaryReference rdf:type rdf:Property ;
    rdfs:label 'Gis Boundary Reference' ;
    rdfs:comment 'Reference identifier or feature class name in Esri ArcGIS for the polygon geometry defining the territory boundary.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:industrialCustomerCount rdf:type rdf:Property ;
    rdfs:label 'Industrial Customer Count' ;
    rdfs:comment 'Number of industrial customer accounts within the territory.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:npdesPermitJurisdiction rdf:type rdf:Property ;
    rdfs:label 'Npdes Permit Jurisdiction' ;
    rdfs:comment 'Regulatory authority responsible for wastewater discharge permits under the Clean Water Act (CWA) in this territory.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:operatingDivisionCode rdf:type rdf:Property ;
    rdfs:label 'Operating Division Code' ;
    rdfs:comment 'Internal code identifying the utility\'s operating division or business unit responsible for service delivery in this territory.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:peakDailyDemandMgd rdf:type rdf:Property ;
    rdfs:label 'Peak Daily Demand Mgd' ;
    rdfs:comment 'Peak daily water demand for the territory measured in million gallons per day, used for infrastructure sizing and emergency planning.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:potableWaterServiceFlag rdf:type rdf:Property ;
    rdfs:label 'Potable Water Service Flag' ;
    rdfs:comment 'Indicates whether the utility provides potable (drinking) water service within this territory.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:predecessorUtilityName rdf:type rdf:Property ;
    rdfs:label 'Predecessor Utility Name' ;
    rdfs:comment 'Name of the previous utility that served this territory before acquisition or transfer, used for historical data lineage.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primacyAgencyJurisdiction rdf:type rdf:Property ;
    rdfs:label 'Primacy Agency Jurisdiction' ;
    rdfs:comment 'State or federal agency with primary regulatory authority over drinking water quality in this territory (e.g., \'California State Water Resources Control Board\').' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateZoneCode rdf:type rdf:Property ;
    rdfs:label 'Rate Zone Code' ;
    rdfs:comment 'Code identifying the rate zone or pricing district applicable to customers in this territory.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recycledWaterServiceFlag rdf:type rdf:Property ;
    rdfs:label 'Recycled Water Service Flag' ;
    rdfs:comment 'Indicates whether the utility provides recycled (reclaimed) water service for non-potable uses within this territory.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryAuthorityName rdf:type rdf:Property ;
    rdfs:label 'Regulatory Authority Name' ;
    rdfs:comment 'Name of the state or local regulatory body with jurisdiction over rates and service quality in this territory (e.g., \'California Public Utilities Commission\').' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:residentialCustomerCount rdf:type rdf:Property ;
    rdfs:label 'Residential Customer Count' ;
    rdfs:comment 'Number of residential customer accounts within the territory.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:serviceCenterLocation rdf:type rdf:Property ;
    rdfs:label 'Service Center Location' ;
    rdfs:comment 'Name or identifier of the primary service center or operations facility serving this territory.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceClassification rdf:type rdf:Property ;
    rdfs:label 'Service Classification' ;
    rdfs:comment 'Geographic and demographic classification of the territory, used for rate design and infrastructure planning.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stormwaterServiceFlag rdf:type rdf:Property ;
    rdfs:label 'Stormwater Service Flag' ;
    rdfs:comment 'Indicates whether the utility provides stormwater management service within this territory.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:tariffScheduleReference rdf:type rdf:Property ;
    rdfs:label 'Tariff Schedule Reference' ;
    rdfs:comment 'Reference to the applicable rate tariff schedule approved by the regulatory authority for this territory.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:territoryStatus rdf:type rdf:Property ;
    rdfs:label 'Territory Status' ;
    rdfs:comment 'Current operational status of the service territory in the utility\'s service portfolio.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:territoryType rdf:type rdf:Property ;
    rdfs:label 'Territory Type' ;
    rdfs:comment 'Classification of the service territory based on regulatory authorization and service delivery model.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:timeZone rdf:type rdf:Property ;
    rdfs:label 'Time Zone' ;
    rdfs:comment 'IANA time zone identifier for the territory (e.g., \'America/Los_Angeles\'), used for operational scheduling and SCADA data timestamping.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wastewaterServiceFlag rdf:type rdf:Property ;
    rdfs:label 'Wastewater Service Flag' ;
    rdfs:comment 'Indicates whether the utility provides wastewater collection and treatment service within this territory.' ;
    rdfs:domain ind:Territory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:averageMonthlyConsumptionGallons rdf:type rdf:Property ;
    rdfs:label 'Average Monthly Consumption Gallons' ;
    rdfs:comment 'Typical average monthly water consumption in gallons for accounts in this service class. Used for rate modeling and demand forecasting.' ;
    rdfs:domain ind:ServiceClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:awwaClassificationCode rdf:type rdf:Property ;
    rdfs:label 'Awwa Classification Code' ;
    rdfs:comment 'Standard classification code from AWWA M1 Manual used for industry benchmarking and best practice alignment.' ;
    rdfs:domain ind:ServiceClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:backflowPreventionRequired rdf:type rdf:Property ;
    rdfs:label 'Backflow Prevention Required' ;
    rdfs:comment 'Indicates whether backflow prevention devices are required for accounts in this service class to protect the public water supply from contamination.' ;
    rdfs:domain ind:Service ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:billingCycleType rdf:type rdf:Property ;
    rdfs:label 'Billing Cycle Type' ;
    rdfs:comment 'Standard billing frequency for accounts in this service class (e.g., monthly, bimonthly, quarterly). Determines meter reading and invoice generation schedules.' ;
    rdfs:domain ind:ServiceClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:classType rdf:type rdf:Property ;
    rdfs:label 'Class Type' ;
    rdfs:comment 'High-level category of the service class used for grouping and analysis. Aligns with regulatory reporting categories. [ENUM-REF-CANDIDATE: residential|commercial|industrial|irrigation|fire_protection|municipal|wholesale|other — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:ServiceClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conservationProgramEligible rdf:type rdf:Property ;
    rdfs:label 'Conservation Program Eligible' ;
    rdfs:comment 'Indicates whether accounts in this service class are eligible for water conservation programs, rebates, or incentives.' ;
    rdfs:domain ind:ServiceClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:consumptionTierStructure rdf:type rdf:Property ;
    rdfs:label 'Consumption Tier Structure' ;
    rdfs:comment 'Type of rate structure applied to consumption for this class (e.g., flat rate, tiered/block rates, seasonal rates, time-of-use rates).' ;
    rdfs:domain ind:ServiceClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:depositRequirementAmount rdf:type rdf:Property ;
    rdfs:label 'Deposit Requirement Amount' ;
    rdfs:comment 'Standard security deposit amount required for new accounts in this service class. May vary based on credit risk and consumption history.' ;
    rdfs:domain ind:ServiceClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:disconnectionPolicy rdf:type rdf:Property ;
    rdfs:label 'Disconnection Policy' ;
    rdfs:comment 'Policy governing service disconnection for non-payment for this class (e.g., standard, protected for vulnerable populations, restricted for essential services).' ;
    rdfs:domain ind:ServiceClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fireFlowRequirementGpm rdf:type rdf:Property ;
    rdfs:label 'Fire Flow Requirement Gpm' ;
    rdfs:comment 'Minimum fire flow capacity requirement in gallons per minute (GPM) for properties served under this class. Applicable primarily to commercial, industrial, and fire protection classes.' ;
    rdfs:domain ind:ServiceClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:latePaymentPenaltyRate rdf:type rdf:Property ;
    rdfs:label 'Late Payment Penalty Rate' ;
    rdfs:comment 'Percentage rate applied to overdue balances for accounts in this service class. Subject to regulatory limits.' ;
    rdfs:domain ind:ServiceClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:meterSizeRange rdf:type rdf:Property ;
    rdfs:label 'Meter Size Range' ;
    rdfs:comment 'Typical or allowable range of meter sizes (in inches) for accounts in this service class (e.g., 5/8-inch to 1-inch for residential, 2-inch to 6-inch for commercial).' ;
    rdfs:domain ind:ServiceClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minimumChargeApplicable rdf:type rdf:Property ;
    rdfs:label 'Minimum Charge Applicable' ;
    rdfs:comment 'Indicates whether a minimum monthly or periodic charge applies to accounts in this service class, regardless of consumption.' ;
    rdfs:domain ind:ServiceClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:peakDemandFactor rdf:type rdf:Property ;
    rdfs:label 'Peak Demand Factor' ;
    rdfs:comment 'Multiplier representing the ratio of peak demand to average demand for this service class. Used in capacity planning and infrastructure sizing.' ;
    rdfs:domain ind:ServiceClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pressureRequirementPsi rdf:type rdf:Property ;
    rdfs:label 'Pressure Requirement Psi' ;
    rdfs:comment 'Minimum service pressure requirement in pounds per square inch (PSI) for accounts in this service class. Ensures adequate pressure for intended use.' ;
    rdfs:domain ind:ServiceClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:pucApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Puc Approval Date' ;
    rdfs:comment 'Date when the Public Utilities Commission approved this service class and its associated rate structure. Required for regulated utilities.' ;
    rdfs:domain ind:ServiceClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:pucFilingReference rdf:type rdf:Property ;
    rdfs:label 'Puc Filing Reference' ;
    rdfs:comment 'Reference number or identifier of the PUC rate case filing or tariff document that established or modified this service class.' ;
    rdfs:domain ind:ServiceClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateScheduleGroup rdf:type rdf:Property ;
    rdfs:label 'Rate Schedule Group' ;
    rdfs:comment 'Identifier of the rate schedule group applicable to this service class. Links the class to specific rate structures and tariff schedules for billing purposes.' ;
    rdfs:domain ind:ServiceClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:renewalNotificationDays rdf:type rdf:Property ;
    rdfs:label 'Renewal Notification Days' ;
    rdfs:comment 'Number of days advance notice required before contract renewal or rate changes for this service class.' ;
    rdfs:domain ind:ServiceClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:seasonalRateApplicable rdf:type rdf:Property ;
    rdfs:label 'Seasonal Rate Applicable' ;
    rdfs:comment 'Indicates whether seasonal rate variations (e.g., higher summer rates for irrigation) apply to this service class.' ;
    rdfs:domain ind:ServiceClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:serviceClassStatus rdf:type rdf:Property ;
    rdfs:label 'Service Class Status' ;
    rdfs:comment 'Current lifecycle status of the service class. Active classes are available for new account assignments; deprecated classes are phased out but may have existing accounts.' ;
    rdfs:domain ind:ServiceClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceLevelAgreementTier rdf:type rdf:Property ;
    rdfs:label 'Service Level Agreement Tier' ;
    rdfs:comment 'Service level tier defining response times, service restoration priorities, and quality commitments for this class (e.g., standard, priority, premium, critical).' ;
    rdfs:domain ind:ServiceClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tariffClassification rdf:type rdf:Property ;
    rdfs:label 'Tariff Classification' ;
    rdfs:comment 'Official tariff classification as filed with and approved by the Public Utilities Commission. Used for rate case modeling and tariff compliance.' ;
    rdfs:domain ind:ServiceClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waterQualityMonitoringFrequency rdf:type rdf:Property ;
    rdfs:label 'Water Quality Monitoring Frequency' ;
    rdfs:comment 'Required frequency of water quality monitoring or testing for accounts in this service class. More stringent for industrial and high-risk classes.' ;
    rdfs:domain ind:ServiceClass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceOfferingId rdf:type rdf:Property ;
    rdfs:label 'Service Offering Id' ;
    rdfs:comment 'Reference to the specific service offering (water, wastewater, reclaimed water, stormwater) that this agreement covers. Links to the service catalog.' ;
    rdfs:domain ind:Agreement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Offering .

ind:agreementNumber rdf:type rdf:Property ;
    rdfs:label 'Agreement Number' ;
    rdfs:comment 'Externally visible unique business identifier for the service agreement. Used in customer communications, billing statements, and regulatory reporting.' ;
    rdfs:domain ind:Agreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agreementStatus rdf:type rdf:Property ;
    rdfs:label 'Agreement Status' ;
    rdfs:comment 'Current lifecycle status of the service agreement. Active agreements are billed and serviced; suspended agreements are temporarily halted; terminated agreements are closed.' ;
    rdfs:domain ind:Agreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:autoPayEnabled rdf:type rdf:Property ;
    rdfs:label 'Auto Pay Enabled' ;
    rdfs:comment 'Indicates whether automatic payment is enabled for this service agreement. When true, invoices are automatically paid from the customers designated payment method.' ;
    rdfs:domain ind:Agreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:autoRenewalEnabled rdf:type rdf:Property ;
    rdfs:label 'Auto Renewal Enabled' ;
    rdfs:comment 'Indicates whether the service agreement automatically renews at the end of the contract term. When false, agreement requires explicit renewal action.' ;
    rdfs:domain ind:Agreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:budgetBillingEnabled rdf:type rdf:Property ;
    rdfs:label 'Budget Billing Enabled' ;
    rdfs:comment 'Indicates whether the customer is enrolled in budget billing program, which averages annual usage into equal monthly payments to reduce seasonal bill variation.' ;
    rdfs:domain ind:Agreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:depositStatus rdf:type rdf:Property ;
    rdfs:label 'Deposit Status' ;
    rdfs:comment 'Current status of the security deposit for this agreement. Tracks whether deposit is required, currently held, waived based on credit, or refunded.' ;
    rdfs:domain ind:Agreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:endDate rdf:type rdf:Property ;
    rdfs:label 'End Date' ;
    rdfs:comment 'Date when the service agreement terminates or is scheduled to terminate. Null for open-ended agreements. Used for final billing and account closure.' ;
    rdfs:domain ind:Agreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:externalReferenceCode rdf:type rdf:Property ;
    rdfs:label 'External Reference Code' ;
    rdfs:comment 'External system identifier for this service agreement in legacy or third-party systems. Used for cross-system reconciliation and data migration tracking.' ;
    rdfs:domain ind:Agreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:industrialUserPermitRequired rdf:type rdf:Property ;
    rdfs:label 'Industrial User Permit Required' ;
    rdfs:comment 'Indicates whether this service agreement requires an Industrial User Permit for wastewater discharge per NPDES (National Pollutant Discharge Elimination System) pretreatment program requirements.' ;
    rdfs:domain ind:Agreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:irrigationServiceFlag rdf:type rdf:Property ;
    rdfs:label 'Irrigation Service Flag' ;
    rdfs:comment 'Indicates whether this agreement includes irrigation or outdoor water service, which may be billed separately or subject to seasonal rates and wastewater exemptions.' ;
    rdfs:domain ind:Agreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lowIncomeAssistanceEligible rdf:type rdf:Property ;
    rdfs:label 'Low Income Assistance Eligible' ;
    rdfs:comment 'Indicates whether this service agreement qualifies for low-income customer assistance programs, rate discounts, or payment plans per regulatory requirements.' ;
    rdfs:domain ind:Agreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:minimumUsageCommitmentGallons rdf:type rdf:Property ;
    rdfs:label 'Minimum Usage Commitment Gallons' ;
    rdfs:comment 'Minimum water usage volume (in gallons) that the customer commits to consume per billing period. Common for commercial and industrial agreements. Used for minimum charge calculations.' ;
    rdfs:domain ind:Agreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paperlessBillingEnabled rdf:type rdf:Property ;
    rdfs:label 'Paperless Billing Enabled' ;
    rdfs:comment 'Indicates whether the customer has opted for electronic billing instead of paper invoices. Supports environmental sustainability initiatives.' ;
    rdfs:domain ind:Agreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:renewalDate rdf:type rdf:Property ;
    rdfs:label 'Renewal Date' ;
    rdfs:comment 'Date when the service agreement is scheduled for renewal or renegotiation. Applicable for fixed-term contracts with renewal provisions.' ;
    rdfs:domain ind:Agreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:seniorCitizenDiscountEligible rdf:type rdf:Property ;
    rdfs:label 'Senior Citizen Discount Eligible' ;
    rdfs:comment 'Indicates whether this service agreement qualifies for senior citizen rate discounts or special programs as defined by utility tariff.' ;
    rdfs:domain ind:Agreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:startDate rdf:type rdf:Property ;
    rdfs:label 'Start Date' ;
    rdfs:comment 'Date when the service agreement becomes effective and service delivery begins. Used for billing proration and regulatory compliance reporting.' ;
    rdfs:domain ind:Agreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:terminationReasonCode rdf:type rdf:Property ;
    rdfs:label 'Termination Reason Code' ;
    rdfs:comment 'Standardized code indicating the reason for service agreement termination. Examples include customer move-out, non-payment, property demolition, or service transfer.' ;
    rdfs:domain ind:Agreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:amiEnabled rdf:type rdf:Property ;
    rdfs:label 'Ami Enabled' ;
    rdfs:comment 'Indicates whether this service point is equipped with Advanced Metering Infrastructure for automated remote meter reading and real-time consumption monitoring. True if AMI meter is installed; false for manual read meters.' ;
    rdfs:domain ind:Service ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:backflowDeviceType rdf:type rdf:Property ;
    rdfs:label 'Backflow Device Type' ;
    rdfs:comment 'Type of backflow prevention device installed at this service point. RPZ is Reduced Pressure Zone; DCVA is Double Check Valve Assembly; PVB is Pressure Vacuum Breaker; AG is Air Gap; none indicates no device required; unknown indicates status not verified.' ;
    rdfs:domain ind:Point ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:connectionMaterial rdf:type rdf:Property ;
    rdfs:label 'Connection Material' ;
    rdfs:comment 'Material composition of the service line connecting the distribution main to the customer premises. Critical for Lead and Copper Rule Revisions (LCRR) compliance and service line inventory reporting. [ENUM-REF-CANDIDATE: copper|pvc|hdpe|galvanized_steel|lead|ductile_iron|pex|unknown — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Point ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:connectionSizeInches rdf:type rdf:Property ;
    rdfs:label 'Connection Size Inches' ;
    rdfs:comment 'Diameter of the service connection pipe in inches, representing the physical capacity of the service line connecting the distribution main to the customer premises. Common sizes include 0.75, 1.0, 1.5, 2.0, 3.0, 4.0, 6.0, 8.0 inches.' ;
    rdfs:domain ind:Service ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fireServiceIndicator rdf:type rdf:Property ;
    rdfs:label 'Fire Service Indicator' ;
    rdfs:comment 'Indicates whether this service point includes fire protection service (fire sprinkler system or fire hydrant connection). True if fire service is provided; false for domestic-only service.' ;
    rdfs:domain ind:Point ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:serviceCountryCode rdf:type rdf:Property ;
    rdfs:label 'Service Country Code' ;
    rdfs:comment 'Three-letter ISO 3166-1 alpha-3 country code where the service point is located (e.g., USA, CAN, MEX).' ;
    rdfs:domain ind:Point ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:servicePointDescription rdf:type rdf:Property ;
    rdfs:label 'Service Point Description' ;
    rdfs:comment 'Free-text description providing additional context about the service point location, special characteristics, or access instructions for field personnel.' ;
    rdfs:domain ind:Point ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:servicePointNumber rdf:type rdf:Property ;
    rdfs:label 'Service Point Number' ;
    rdfs:comment 'Externally-known business identifier for the service point, typically displayed on customer bills and used in customer service interactions. Unique across the utility service territory.' ;
    rdfs:domain ind:Point ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:servicePointStatus rdf:type rdf:Property ;
    rdfs:label 'Service Point Status' ;
    rdfs:comment 'Current operational status of the service point in its lifecycle. Active indicates service is being delivered; inactive indicates no current service; suspended indicates temporary service hold; pending_activation indicates awaiting turn-on; disconnected indicates service terminated; abandoned indicates permanently retired.' ;
    rdfs:domain ind:Point ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceState rdf:type rdf:Property ;
    rdfs:label 'Service State' ;
    rdfs:comment 'Two-letter state or province code where the service point is located, following USPS state abbreviation standards.' ;
    rdfs:domain ind:Service ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicantEmail rdf:type rdf:Property ;
    rdfs:label 'Applicant Email' ;
    rdfs:comment 'Primary email address of the applicant for correspondence and notifications regarding the connection application.' ;
    rdfs:domain ind:ConnectionApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicantName rdf:type rdf:Property ;
    rdfs:label 'Applicant Name' ;
    rdfs:comment 'Full legal name of the individual or organization applying for the service connection.' ;
    rdfs:domain ind:ConnectionApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicantPhone rdf:type rdf:Property ;
    rdfs:label 'Applicant Phone' ;
    rdfs:comment 'Primary contact phone number of the applicant for communication regarding the connection application.' ;
    rdfs:domain ind:ConnectionApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicationFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Application Fee Amount' ;
    rdfs:comment 'Fee charged for processing the connection application, in USD.' ;
    rdfs:domain ind:ConnectionApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:capacityAvailable rdf:type rdf:Property ;
    rdfs:label 'Capacity Available' ;
    rdfs:comment 'Indicates whether sufficient system capacity (pressure, flow, treatment capacity) is available to serve the requested connection without infrastructure upgrades.' ;
    rdfs:domain ind:ConnectionApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:capacityChargeAmount rdf:type rdf:Property ;
    rdfs:label 'Capacity Charge Amount' ;
    rdfs:comment 'System development or capacity charge assessed to fund infrastructure expansion to serve the new connection, in USD.' ;
    rdfs:domain ind:ConnectionApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:completionDate rdf:type rdf:Property ;
    rdfs:label 'Completion Date' ;
    rdfs:comment 'Date when the physical service connection was completed and the service was activated.' ;
    rdfs:domain ind:Service ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:estimatedFlowDemandGpm rdf:type rdf:Property ;
    rdfs:label 'Estimated Flow Demand Gpm' ;
    rdfs:comment 'Estimated peak flow demand in gallons per minute (GPM) for the requested service connection. Used for hydraulic modeling and capacity verification.' ;
    rdfs:domain ind:ConnectionApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:infrastructureUpgradeRequired rdf:type rdf:Property ;
    rdfs:label 'Infrastructure Upgrade Required' ;
    rdfs:comment 'Indicates whether main extensions, pump station upgrades, or other infrastructure improvements are required to serve the connection.' ;
    rdfs:domain ind:ConnectionApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:meterTypeRequested rdf:type rdf:Property ;
    rdfs:label 'Meter Type Requested' ;
    rdfs:comment 'Type or model of water meter requested or recommended for the connection (e.g., positive displacement, turbine, compound, electromagnetic).' ;
    rdfs:domain ind:ConnectionApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:propertyType rdf:type rdf:Property ;
    rdfs:label 'Property Type' ;
    rdfs:comment 'Classification of the property requesting service: residential, commercial, industrial, institutional, agricultural, or mixed-use.' ;
    rdfs:domain ind:ConnectionApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestedServiceDate rdf:type rdf:Property ;
    rdfs:label 'Requested Service Date' ;
    rdfs:comment 'Date by which the applicant requests the service connection to be activated or completed.' ;
    rdfs:domain ind:ConnectionApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:serviceLatitude rdf:type rdf:Property ;
    rdfs:label 'Service Latitude' ;
    rdfs:comment 'Geographic latitude coordinate of the service connection location for GIS mapping and network planning.' ;
    rdfs:domain ind:ConnectionApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:serviceLongitude rdf:type rdf:Property ;
    rdfs:label 'Service Longitude' ;
    rdfs:comment 'Geographic longitude coordinate of the service connection location for GIS mapping and network planning.' ;
    rdfs:domain ind:ConnectionApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:technicalReviewDate rdf:type rdf:Property ;
    rdfs:label 'Technical Review Date' ;
    rdfs:comment 'Date when the technical feasibility and capacity review of the connection application was completed.' ;
    rdfs:domain ind:ConnectionApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:totalFeesAssessed rdf:type rdf:Property ;
    rdfs:label 'Total Fees Assessed' ;
    rdfs:comment 'Total of all fees assessed for the connection application (application fee, connection fee, capacity charge, and any other charges), in USD.' ;
    rdfs:domain ind:ConnectionApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:primaryOrderCustomerAccountId rdf:type rdf:Property ;
    rdfs:label 'Primary Order Customer Account Id' ;
    rdfs:comment 'Reference to the customer account associated with this service order.' ;
    rdfs:domain ind:Order ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CustomerAccount .

ind:primaryOrderMeteringMeterId rdf:type rdf:Property ;
    rdfs:label 'Primary Order Metering Meter Id' ;
    rdfs:comment 'Serial number or identifier of the meter removed during a meter exchange service order.' ;
    rdfs:domain ind:Order ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Meter .

ind:actualEndTime rdf:type rdf:Property ;
    rdfs:label 'Actual End Time' ;
    rdfs:comment 'Actual date and time when the field crew completed the service order activity.' ;
    rdfs:domain ind:Order ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:actualStartTime rdf:type rdf:Property ;
    rdfs:label 'Actual Start Time' ;
    rdfs:comment 'Actual date and time when the field crew began performing the service order activity.' ;
    rdfs:domain ind:Order ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:appointmentWindowEnd rdf:type rdf:Property ;
    rdfs:label 'Appointment Window End' ;
    rdfs:comment 'End of the time window communicated to the customer for the service order appointment.' ;
    rdfs:domain ind:Order ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:appointmentWindowStart rdf:type rdf:Property ;
    rdfs:label 'Appointment Window Start' ;
    rdfs:comment 'Beginning of the time window communicated to the customer for the service order appointment.' ;
    rdfs:domain ind:Order ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:billableFlag rdf:type rdf:Property ;
    rdfs:label 'Billable Flag' ;
    rdfs:comment 'Indicates whether the service order activity is billable to the customer account.' ;
    rdfs:domain ind:Order ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:customerContactName rdf:type rdf:Property ;
    rdfs:label 'Customer Contact Name' ;
    rdfs:comment 'Name of the customer contact person for this service order, used for appointment confirmation and access coordination.' ;
    rdfs:domain ind:Order ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:customerContactPhone rdf:type rdf:Property ;
    rdfs:label 'Customer Contact Phone' ;
    rdfs:comment 'Phone number of the customer contact person for appointment confirmation and field crew communication.' ;
    rdfs:domain ind:Order ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gpsLatitude rdf:type rdf:Property ;
    rdfs:label 'Gps Latitude' ;
    rdfs:comment 'Geographic latitude coordinate of the service location, used for crew dispatch and asset tracking.' ;
    rdfs:domain ind:Order ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:gpsLongitude rdf:type rdf:Property ;
    rdfs:label 'Gps Longitude' ;
    rdfs:comment 'Geographic longitude coordinate of the service location, used for crew dispatch and asset tracking.' ;
    rdfs:domain ind:Order ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:meterReadingUnit rdf:type rdf:Property ;
    rdfs:label 'Meter Reading Unit' ;
    rdfs:comment 'Unit of measure for the meter reading value captured during the service order.' ;
    rdfs:domain ind:Order ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:meterReadingValue rdf:type rdf:Property ;
    rdfs:label 'Meter Reading Value' ;
    rdfs:comment 'Final meter reading captured during the service order activity, measured in appropriate units (gallons, cubic meters, etc.).' ;
    rdfs:domain ind:Order ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:orderNumber rdf:type rdf:Property ;
    rdfs:label 'Order Number' ;
    rdfs:comment 'Externally visible business identifier for the service order, used for customer communication and field crew reference.' ;
    rdfs:domain ind:Order ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:orderStatus rdf:type rdf:Property ;
    rdfs:label 'Order Status' ;
    rdfs:comment 'Current lifecycle status of the service order in the field service workflow. [ENUM-REF-CANDIDATE: draft|scheduled|dispatched|in_progress|completed|cancelled|on_hold — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Order ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:orderType rdf:type rdf:Property ;
    rdfs:label 'Order Type' ;
    rdfs:comment 'Classification of the service order activity. Defines the nature of field work to be performed. [ENUM-REF-CANDIDATE: turn_on|turn_off|reconnection|meter_set|meter_exchange|service_upgrade|final_read|leak_investigation — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Order ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outcomeCode rdf:type rdf:Property ;
    rdfs:label 'Outcome Code' ;
    rdfs:comment 'Standardized code indicating the final outcome or result of the service order execution.' ;
    rdfs:domain ind:Order ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestedDate rdf:type rdf:Property ;
    rdfs:label 'Requested Date' ;
    rdfs:comment 'Date when the customer or system requested the service order to be performed.' ;
    rdfs:domain ind:Order ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:scheduledEndTime rdf:type rdf:Property ;
    rdfs:label 'Scheduled End Time' ;
    rdfs:comment 'Planned date and time when the field crew is expected to complete the service order activity.' ;
    rdfs:domain ind:Order ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:scheduledStartTime rdf:type rdf:Property ;
    rdfs:label 'Scheduled Start Time' ;
    rdfs:comment 'Precise date and time when the field crew is scheduled to begin the service order activity.' ;
    rdfs:domain ind:Order ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:serviceAddress rdf:type rdf:Property ;
    rdfs:label 'Service Address' ;
    rdfs:comment 'Full street address where the field service activity will be performed. Used for crew dispatch and navigation.' ;
    rdfs:domain ind:Order ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Service Fee Amount' ;
    rdfs:comment 'Monetary charge assessed to the customer for the service order activity, in US dollars.' ;
    rdfs:domain ind:Order ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:slaActualHours rdf:type rdf:Property ;
    rdfs:label 'Sla Actual Hours' ;
    rdfs:comment 'Actual number of hours elapsed from order creation to completion, used for SLA compliance tracking.' ;
    rdfs:domain ind:Order ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:slaMetFlag rdf:type rdf:Property ;
    rdfs:label 'Sla Met Flag' ;
    rdfs:comment 'Indicates whether the service order was completed within the target SLA timeframe.' ;
    rdfs:domain ind:Order ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:specialInstructions rdf:type rdf:Property ;
    rdfs:label 'Special Instructions' ;
    rdfs:comment 'Additional instructions or notes for the field crew regarding access, safety, or customer requirements.' ;
    rdfs:domain ind:Order ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workPerformedDescription rdf:type rdf:Property ;
    rdfs:label 'Work Performed Description' ;
    rdfs:comment 'Detailed narrative description of the work actually performed by the field crew, including any findings or issues encountered.' ;
    rdfs:domain ind:Order ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supersededTariffId rdf:type rdf:Property ;
    rdfs:label 'Superseded Tariff Id' ;
    rdfs:comment 'Reference to the prior tariff that this tariff replaces. Establishes the lineage of rate changes and enables historical rate analysis.' ;
    rdfs:domain ind:Tariff ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Tariff .

ind:adjustmentClauseFlag rdf:type rdf:Property ;
    rdfs:label 'Adjustment Clause Flag' ;
    rdfs:comment 'Indicates whether the tariff includes automatic adjustment clauses or riders that allow for rate changes without a full rate case. Common adjustment clauses include purchased water adjustment clauses (PWAC), infrastructure surcharges, and cost recovery mechanisms for specific capital programs.' ;
    rdfs:domain ind:Tariff ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:approvalOrderNumber rdf:type rdf:Property ;
    rdfs:label 'Approval Order Number' ;
    rdfs:comment 'The official order or docket number issued by the regulatory authority approving this tariff. This reference links the tariff to the formal regulatory decision and provides traceability to the rate case proceeding.' ;
    rdfs:domain ind:Tariff ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conservationRateFlag rdf:type rdf:Property ;
    rdfs:label 'Conservation Rate Flag' ;
    rdfs:comment 'Indicates whether the tariff incorporates conservation-oriented rate design features such as increasing block rates, seasonal pricing, or water budget-based rates intended to promote efficient water use.' ;
    rdfs:domain ind:Tariff ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:costOfServiceStudyReference rdf:type rdf:Property ;
    rdfs:label 'Cost Of Service Study Reference' ;
    rdfs:comment 'Reference to the cost-of-service study or rate design analysis that supports the tariff rates. This study allocates utility costs to customer classes and justifies the rate structure to the regulatory authority.' ;
    rdfs:domain ind:Tariff ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentUrl rdf:type rdf:Property ;
    rdfs:label 'Document Url' ;
    rdfs:comment 'The web address or document management system link to the official tariff filing document, including all schedules, exhibits, and supporting materials. Provides direct access to the complete regulatory record.' ;
    rdfs:domain ind:Tariff ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:filingDate rdf:type rdf:Property ;
    rdfs:label 'Filing Date' ;
    rdfs:comment 'The date on which the tariff was officially filed with the Public Utilities Commission or state regulatory authority. This date triggers statutory review periods and notice requirements.' ;
    rdfs:domain ind:Tariff ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:hearingDate rdf:type rdf:Property ;
    rdfs:label 'Hearing Date' ;
    rdfs:comment 'The date of the public hearing or evidentiary proceeding held by the regulatory authority to review the tariff filing. Null if no hearing was required or held.' ;
    rdfs:domain ind:Tariff ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lowIncomeAssistanceFlag rdf:type rdf:Property ;
    rdfs:label 'Low Income Assistance Flag' ;
    rdfs:comment 'Indicates whether the tariff includes provisions for low-income customer assistance programs, such as lifeline rates, bill discounts, or affordability programs mandated or approved by the regulatory authority.' ;
    rdfs:domain ind:Tariff ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rateBaseAmount rdf:type rdf:Property ;
    rdfs:label 'Rate Base Amount' ;
    rdfs:comment 'The net investment in utility plant and working capital upon which the utility is allowed to earn a return. Rate base is calculated as gross plant in service less accumulated depreciation plus working capital allowances.' ;
    rdfs:domain ind:Tariff ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rateOfReturnPercent rdf:type rdf:Property ;
    rdfs:label 'Rate Of Return Percent' ;
    rdfs:comment 'The allowed rate of return on rate base approved by the regulatory authority. Expressed as a decimal percentage (e.g., 0.0725 for 7.25%). This is the weighted average cost of capital (WACC) the utility is permitted to earn.' ;
    rdfs:domain ind:Tariff ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rateScheduleReference rdf:type rdf:Property ;
    rdfs:label 'Rate Schedule Reference' ;
    rdfs:comment 'Reference to the detailed rate schedule document or section number within the tariff filing that specifies the complete pricing structure, including block tiers, surcharges, and adjustments.' ;
    rdfs:domain ind:Tariff ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revenueRequirementAmount rdf:type rdf:Property ;
    rdfs:label 'Revenue Requirement Amount' ;
    rdfs:comment 'The total annual revenue requirement approved by the regulatory authority for the utility under this tariff. This is the aggregate revenue the utility is authorized to collect to cover operating expenses, capital costs, and allowed return on investment.' ;
    rdfs:domain ind:Tariff ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:serviceRulesReference rdf:type rdf:Property ;
    rdfs:label 'Service Rules Reference' ;
    rdfs:comment 'Reference to the service rules, terms, and conditions document or section number within the tariff filing that governs service delivery, customer obligations, disconnection policies, and dispute resolution procedures.' ;
    rdfs:domain ind:Tariff ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tariffNumber rdf:type rdf:Property ;
    rdfs:label 'Tariff Number' ;
    rdfs:comment 'The official regulatory tariff number assigned by the Public Utilities Commission or state regulatory authority. This is the externally-known identifier used in all regulatory filings and rate case proceedings.' ;
    rdfs:domain ind:Tariff ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tariffStatus rdf:type rdf:Property ;
    rdfs:label 'Tariff Status' ;
    rdfs:comment 'Current lifecycle status of the tariff filing. Draft indicates internal preparation, filed means submitted to the regulator, pending approval is under regulatory review, approved means accepted by the commission, active is currently in force, suspended is temporarily halted, superseded is replaced by a newer tariff, and withdrawn is retracted before approval. [ENUM-REF-CANDIDATE: draft|filed|pending_approval|approved|active|suspended|superseded|withdrawn — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Tariff ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tariffType rdf:type rdf:Property ;
    rdfs:label 'Tariff Type' ;
    rdfs:comment 'Classification of the tariff based on the customer segment and service arrangement it governs. General service tariffs apply to standard retail customers, special contracts cover negotiated agreements with large users, wholesale tariffs govern bulk water sales to other utilities, and industrial/municipal/residential/commercial designate specific customer classes. [ENUM-REF-CANDIDATE: general_service|special_contract|wholesale|industrial|municipal|residential|commercial — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Tariff ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actualParticipantCount rdf:type rdf:Property ;
    rdfs:label 'Actual Participant Count' ;
    rdfs:comment 'Current count of customers or accounts enrolled and participating in the conservation program.' ;
    rdfs:domain ind:ConservationProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:actualWaterSavingsGallons rdf:type rdf:Property ;
    rdfs:label 'Actual Water Savings Gallons' ;
    rdfs:comment 'Measured or estimated cumulative water savings achieved by the program to date, in gallons.' ;
    rdfs:domain ind:ConservationProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:budgetExpendedToDate rdf:type rdf:Property ;
    rdfs:label 'Budget Expended To Date' ;
    rdfs:comment 'Cumulative amount of program budget spent as of the last reporting period, in US dollars.' ;
    rdfs:domain ind:ConservationProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contactEmail rdf:type rdf:Property ;
    rdfs:label 'Contact Email' ;
    rdfs:comment 'Primary email address for customer inquiries and program communications.' ;
    rdfs:domain ind:ConservationProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactPhone rdf:type rdf:Property ;
    rdfs:label 'Contact Phone' ;
    rdfs:comment 'Primary phone number for customer inquiries and program support.' ;
    rdfs:domain ind:ConservationProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:customerClassApplicability rdf:type rdf:Property ;
    rdfs:label 'Customer Class Applicability' ;
    rdfs:comment 'Customer class segments eligible to participate in this conservation program.' ;
    rdfs:domain ind:ConservationProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eligibilityCriteria rdf:type rdf:Property ;
    rdfs:label 'Eligibility Criteria' ;
    rdfs:comment 'Detailed requirements and conditions that customers must meet to participate in the conservation program, including customer class, service type, meter size, and usage thresholds.' ;
    rdfs:domain ind:ConservationProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:enrollmentEndDate rdf:type rdf:Property ;
    rdfs:label 'Enrollment End Date' ;
    rdfs:comment 'Date when customer enrollment or application for the program closes. Null for open enrollment programs.' ;
    rdfs:domain ind:ConservationProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:enrollmentStartDate rdf:type rdf:Property ;
    rdfs:label 'Enrollment Start Date' ;
    rdfs:comment 'Date when customer enrollment or application for the program opens.' ;
    rdfs:domain ind:ConservationProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:incentiveAmount rdf:type rdf:Property ;
    rdfs:label 'Incentive Amount' ;
    rdfs:comment 'Fixed monetary value of the incentive provided per qualifying customer or installation, in US dollars.' ;
    rdfs:domain ind:ConservationProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:incentiveType rdf:type rdf:Property ;
    rdfs:label 'Incentive Type' ;
    rdfs:comment 'Type of financial or non-financial incentive offered to customers participating in the program.' ;
    rdfs:domain ind:ConservationProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incentiveUnit rdf:type rdf:Property ;
    rdfs:label 'Incentive Unit' ;
    rdfs:comment 'Unit of measure for calculating and distributing the incentive to program participants.' ;
    rdfs:domain ind:ConservationProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastReportedDate rdf:type rdf:Property ;
    rdfs:label 'Last Reported Date' ;
    rdfs:comment 'Date of the most recent performance report submitted for this conservation program.' ;
    rdfs:domain ind:ConservationProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:marketingCampaignCode rdf:type rdf:Property ;
    rdfs:label 'Marketing Campaign Code' ;
    rdfs:comment 'Code linking the conservation program to specific marketing and outreach campaigns for tracking effectiveness.' ;
    rdfs:domain ind:ConservationProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maximumIncentivePerCustomer rdf:type rdf:Property ;
    rdfs:label 'Maximum Incentive Per Customer' ;
    rdfs:comment 'Cap on the total incentive amount a single customer can receive under this program during the program period, in US dollars.' ;
    rdfs:domain ind:ConservationProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:performanceMetricDefinition rdf:type rdf:Property ;
    rdfs:label 'Performance Metric Definition' ;
    rdfs:comment 'Description of the key performance indicators (KPIs) used to measure program success, such as gallons saved per dollar spent or participation rate.' ;
    rdfs:domain ind:ConservationProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:programCategory rdf:type rdf:Property ;
    rdfs:label 'Program Category' ;
    rdfs:comment 'Target sector or application area for the conservation program.' ;
    rdfs:domain ind:ConservationProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:programCode rdf:type rdf:Property ;
    rdfs:label 'Program Code' ;
    rdfs:comment 'Unique business identifier code for the conservation program, used for external reference and reporting.' ;
    rdfs:domain ind:ConservationProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:programDescription rdf:type rdf:Property ;
    rdfs:label 'Program Description' ;
    rdfs:comment 'Detailed description of the conservation program objectives, activities, and benefits to customers and the utility.' ;
    rdfs:domain ind:ConservationProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:programEndDate rdf:type rdf:Property ;
    rdfs:label 'Program End Date' ;
    rdfs:comment 'Date when the conservation program concludes and no new participants are accepted. Null for ongoing programs.' ;
    rdfs:domain ind:ConservationProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:programName rdf:type rdf:Property ;
    rdfs:label 'Program Name' ;
    rdfs:comment 'Full descriptive name of the conservation program as presented to customers and in regulatory filings.' ;
    rdfs:domain ind:ConservationProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:programNotes rdf:type rdf:Property ;
    rdfs:label 'Program Notes' ;
    rdfs:comment 'Additional free-text notes, comments, or special instructions related to the conservation program administration and operations.' ;
    rdfs:domain ind:ConservationProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:programStartDate rdf:type rdf:Property ;
    rdfs:label 'Program Start Date' ;
    rdfs:comment 'Date when the conservation program becomes active and customers can begin participating.' ;
    rdfs:domain ind:ConservationProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:programStatus rdf:type rdf:Property ;
    rdfs:label 'Program Status' ;
    rdfs:comment 'Current lifecycle status of the conservation program.' ;
    rdfs:domain ind:ConservationProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:programType rdf:type rdf:Property ;
    rdfs:label 'Program Type' ;
    rdfs:comment 'Classification of the conservation program by delivery mechanism and approach. [ENUM-REF-CANDIDATE: rebate|tiered_pricing|water_audit|drought_surcharge|education|restriction|incentive — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:ConservationProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:programWebsiteUrl rdf:type rdf:Property ;
    rdfs:label 'Program Website Url' ;
    rdfs:comment 'Web address where customers can find detailed program information, eligibility requirements, and application forms.' ;
    rdfs:domain ind:ConservationProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryApprovalNumber rdf:type rdf:Property ;
    rdfs:label 'Regulatory Approval Number' ;
    rdfs:comment 'Approval or permit number issued by the state Public Utilities Commission or environmental agency authorizing the program.' ;
    rdfs:domain ind:ConservationProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryMandateFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Mandate Flag' ;
    rdfs:comment 'Indicates whether the conservation program is required by state or federal regulation (True) or is voluntary (False).' ;
    rdfs:domain ind:ConservationProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryMandateReference rdf:type rdf:Property ;
    rdfs:label 'Regulatory Mandate Reference' ;
    rdfs:comment 'Citation or reference to the specific regulation, statute, or executive order requiring or authorizing the conservation program.' ;
    rdfs:domain ind:ConservationProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetParticipantCount rdf:type rdf:Property ;
    rdfs:label 'Target Participant Count' ;
    rdfs:comment 'Goal for the number of customers or accounts participating in the conservation program.' ;
    rdfs:domain ind:ConservationProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:targetWaterSavingsGallons rdf:type rdf:Property ;
    rdfs:label 'Target Water Savings Gallons' ;
    rdfs:comment 'Projected total water savings goal for the program over its duration, measured in gallons.' ;
    rdfs:domain ind:ConservationProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:totalProgramBudget rdf:type rdf:Property ;
    rdfs:label 'Total Program Budget' ;
    rdfs:comment 'Total allocated budget for the conservation program over its entire duration, in US dollars.' ;
    rdfs:domain ind:ConservationProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:programEnrollmentId rdf:type rdf:Property ;
    rdfs:label 'Program Enrollment Id' ;
    rdfs:comment 'Primary key for the program_enrollment association' ;
    rdfs:domain ind:ProgramEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:enrollmentDate rdf:type rdf:Property ;
    rdfs:label 'Enrollment Date' ;
    rdfs:comment 'The date on which the service agreement was formally enrolled in the conservation program. Belongs to the enrollment event, not to the agreement or the program catalog.' ;
    rdfs:domain ind:ProgramEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:enrollmentStatus rdf:type rdf:Property ;
    rdfs:label 'Enrollment Status' ;
    rdfs:comment 'Current lifecycle status of this specific enrollment record. Tracks whether the customer\'s participation in this program is active, pending approval, suspended, completed, or cancelled. Belongs to the enrollment, not to the agreement or program.' ;
    rdfs:domain ind:ProgramEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incentiveAmountAwarded rdf:type rdf:Property ;
    rdfs:label 'Incentive Amount Awarded' ;
    rdfs:comment 'The actual monetary incentive amount awarded to this service agreement under this specific program enrollment. May differ from the program\'s standard incentive_amount due to partial qualification, caps, or pro-ration. Belongs to the enrollment record, not to the program catalog or the agreement.' ;
    rdfs:domain ind:ProgramEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:participationEndDate rdf:type rdf:Property ;
    rdfs:label 'Participation End Date' ;
    rdfs:comment 'The date on which the customer\'s active participation in the program ended or is scheduled to end. Null for ongoing open-ended enrollments. Belongs to the enrollment record, not to the program\'s overall end date.' ;
    rdfs:domain ind:ProgramEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:participationStartDate rdf:type rdf:Property ;
    rdfs:label 'Participation Start Date' ;
    rdfs:comment 'The date on which the customer\'s active participation in the program began (e.g., device installation date for a rebate program, or first billing cycle under a tiered incentive). May differ from enrollment_date if there is an approval or installation lag.' ;
    rdfs:domain ind:ProgramEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .
