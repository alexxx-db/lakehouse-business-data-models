ind:sourceWaterQualityStatus rdf:type rdf:Property ;
    rdfs:label 'Source Water Quality Status' ;
    rdfs:domain ind:SourceWaterQuality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sulfateMgPerL rdf:type rdf:Property ;
