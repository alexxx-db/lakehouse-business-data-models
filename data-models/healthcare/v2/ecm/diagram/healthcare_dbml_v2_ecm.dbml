  body_part_examined varchar [note: 'Body part examined']
  created_timestamp timestamp [note: 'Record creation timestamp']
  dicom_study_uid varchar [note: 'DICOM study UID']
  emtala_applicable boolean [note: 'Whether EMTALA applies']
  escalation_datetime timestamp [note: 'When escalation occurred']
