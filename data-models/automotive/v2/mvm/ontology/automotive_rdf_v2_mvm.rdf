    rdfs:comment 'Unique identifier for the inspection result record.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:InspectionResult .

ind:characteristicId rdf:type rdf:Property ;
    rdfs:label 'Characteristic Id' ;
    rdfs:comment 'Identifier of the inspected characteristic or measurement point.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Characteristic .

ind:cpValue rdf:type rdf:Property ;
    rdfs:label 'Cp Value' ;
    rdfs:comment 'Cp value calculated for the characteristic.' ;
    rdfs:domain ind:InspectionResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cpkValue rdf:type rdf:Property ;
    rdfs:label 'Cpk Value' ;
    rdfs:comment 'Cpk value calculated for the characteristic.' ;
    rdfs:domain ind:InspectionResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:deviationAmount rdf:type rdf:Property ;
    rdfs:label 'Deviation Amount' ;
    rdfs:comment 'Numeric difference between measured value and nearest specification limit.' ;
    rdfs:domain ind:InspectionResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lineSequence rdf:type rdf:Property ;
    rdfs:label 'Line Sequence' ;
    rdfs:comment 'Sequential order of the characteristic within the inspection lot.' ;
    rdfs:domain ind:Automotive ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:measurementAccuracy rdf:type rdf:Property ;
    rdfs:label 'Measurement Accuracy' ;
    rdfs:comment 'Accuracy specification of the measurement instrument.' ;
    rdfs:domain ind:InspectionResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:measurementCondition rdf:type rdf:Property ;
    rdfs:label 'Measurement Condition' ;
    rdfs:comment 'Environmental condition during measurement.' ;
    rdfs:domain ind:InspectionResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:measurementHumidityPercent rdf:type rdf:Property ;
    rdfs:label 'Measurement Humidity Percent' ;
    rdfs:comment 'Relative humidity percentage at time of measurement.' ;
    rdfs:domain ind:InspectionResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:measurementLocation rdf:type rdf:Property ;
    rdfs:label 'Measurement Location' ;
    rdfs:comment 'Physical location on the vehicle or part where measurement was taken.' ;
    rdfs:domain ind:InspectionResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:measurementResolution rdf:type rdf:Property ;
    rdfs:label 'Measurement Resolution' ;
