ind:destinationStorageLocationId rdf:type rdf:Property ;
    rdfs:label 'Destination Storage Location Id' ;
    rdfs:comment 'Foreign key linking to inventory.storage_location. Business justification: Inbound parts logistics requires knowing the exact storage location (aisle/rack/bin) where a shipment leg\'s cargo will be putaway. Automotive warehouse management depends on this link for dock-to-stoc' ;
    rdfs:domain ind:Logistics ;
    rdf:type owl:ObjectProperty ;
