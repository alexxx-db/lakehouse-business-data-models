  vibe_mutation_flag boolean
  vibe_mutation_marker varchar
  vibe_mutation_timestamp timestamp [note: 'Timestamp added by VIBE mutation']
  vibe_structure_marker varchar [note: 'domains 1-11 enforcement marker']

