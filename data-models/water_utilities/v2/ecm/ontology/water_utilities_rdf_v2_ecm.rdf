    rdfs:comment 'Calculated analytical result value after applying dilution factors, calibration curves, and method-specific calculations. This is the reportable concentration or measurement for the analyte.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:analyticalResultStatus rdf:type rdf:Property ;
    rdfs:label 'Analytical Result Status' ;
    rdfs:domain ind:AnalyticalResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:analyteId rdf:type rdf:Property ;
