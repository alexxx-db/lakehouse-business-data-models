    rdfs:domain ind:Automotive ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qualityPpapSubmissionId rdf:type rdf:Property ;
    rdfs:label 'Quality Ppap Submission Id' ;
    rdfs:comment 'Unique identifier for the quality_ppap_submission data product (auto-inserted pre-linking).' ;
    rdfs:domain ind:QualityPpapSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:correctiveActionId rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Id' ;
    rdfs:comment 'Unique identifier for the quality_corrective_action data product (auto-inserted pre-linking).' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:caseId rdf:type rdf:Property ;
    rdfs:label 'Case Id' ;
    rdfs:comment 'Foreign key linking to customer.case. Business justification: Automotive CAPA (Corrective and Preventive Action) processes are frequently initiated by customer complaint cases. Linking quality_corrective_action directly to the triggering customer case supports c' ;
    rdfs:domain ind:Automotive ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Case .

ind:rootCauseAnalysisId rdf:type rdf:Property ;
    rdfs:label 'Root Cause Analysis Id' ;
    rdfs:comment 'Foreign key linking to quality.root_cause_analysis. Business justification: In the 8D corrective action process (standard in automotive IATF 16949), D4 is root cause identification and D5-D6 are corrective/preventive actions. A corrective action is directly driven by a root c' ;
    rdfs:domain ind:Automotive ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RootCauseAnalysis .

ind:actionDescription rdf:type rdf:Property ;
    rdfs:label 'Action Description' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actionType rdf:type rdf:Property ;
    rdfs:label 'Action Type' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:closedDate rdf:type rdf:Property ;
    rdfs:label 'Closed Date' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:correctiveActionNumber rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Number' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:correctiveActionStatus rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Status' ;
    rdfs:comment 'Current progress status of corrective actions.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:effectivenessVerifiedFlag rdf:type rdf:Property ;
    rdfs:label 'Effectiveness Verified Flag' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rootCauseSummary rdf:type rdf:Property ;
    rdfs:label 'Root Cause Summary' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditPlantId rdf:type rdf:Property ;
    rdfs:label 'Audit Plant Id' ;
    rdfs:comment 'Surrogate key for the audited facility.' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Plant .

ind:franchiseAgreementId rdf:type rdf:Property ;
    rdfs:label 'Franchise Agreement Id' ;
    rdfs:comment 'Foreign key linking to dealer.franchise_agreement. Business justification: Dealer standards and facility audits are conducted against specific franchise agreement requirements. Linking audit to franchise_agreement supports franchise compliance scoring, renewal decisions, and' ;
    rdfs:domain ind:Automotive ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FranchiseAgreement .

ind:primaryAuditeeLocationPlantId rdf:type rdf:Property ;
    rdfs:label 'Primary Auditee Location Plant Id' ;
    rdfs:comment 'Surrogate key for the audited facility.' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Plant .

ind:warehouseId rdf:type rdf:Property ;
    rdfs:label 'Warehouse Id' ;
    rdfs:comment 'Foreign key linking to inventory.warehouse. Business justification: Warehouse quality audits (5S, inventory accuracy, hazardous material storage compliance, IATF 16949 logistics audits) are a standard automotive quality process. The audit table has audit_type and audi' ;
    rdfs:domain ind:Automotive ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Warehouse .

ind:auditDate rdf:type rdf:Property ;
    rdfs:label 'Audit Date' ;
    rdfs:comment 'Calendar date on which the audit was performed.' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:auditNumber rdf:type rdf:Property ;
    rdfs:label 'Audit Number' ;
    rdfs:comment 'Human-readable audit identifier used in reports and communications.' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditStatus rdf:type rdf:Property ;
    rdfs:label 'Audit Status' ;
    rdfs:comment 'Current lifecycle state of the audit.' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditType rdf:type rdf:Property ;
    rdfs:label 'Audit Type' ;
    rdfs:comment 'Classification of the audit (system, process, product, or layered process audit).' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditeeLocation rdf:type rdf:Property ;
    rdfs:label 'Auditee Location' ;
    rdfs:comment 'Code of the plant, facility, or site where the audit was conducted.' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditorName rdf:type rdf:Property ;
    rdfs:label 'Auditor Name' ;
    rdfs:comment 'Full name of the lead auditor responsible for the audit.' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:closureDate rdf:type rdf:Property ;
    rdfs:label 'Closure Date' ;
    rdfs:comment 'Date on which the audit was formally closed.' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:closureStatus rdf:type rdf:Property ;
    rdfs:label 'Closure Status' ;
    rdfs:comment 'Current status of audit closure activities.' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceReference rdf:type rdf:Property ;
    rdfs:label 'Compliance Reference' ;
    rdfs:comment 'Reference to the specific standard(s) (e.g., IATF 16949, ISO 9001) the audit addresses.' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentsCount rdf:type rdf:Property ;
    rdfs:label 'Documents Count' ;
    rdfs:comment 'Number of supporting documents attached to the audit record.' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:durationMinutes rdf:type rdf:Property ;
    rdfs:label 'Duration Minutes' ;
    rdfs:comment 'Total time spent conducting the audit, measured in minutes.' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:findingsMajor rdf:type rdf:Property ;
    rdfs:label 'Findings Major' ;
    rdfs:comment 'Count of findings classified as major.' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:findingsMinor rdf:type rdf:Property ;
    rdfs:label 'Findings Minor' ;
    rdfs:comment 'Count of findings classified as minor.' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:findingsSevere rdf:type rdf:Property ;
    rdfs:label 'Findings Severe' ;
    rdfs:comment 'Count of findings classified as severe (high impact).' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:findingsTotal rdf:type rdf:Property ;
    rdfs:label 'Findings Total' ;
    rdfs:comment 'Total number of findings identified during the audit.' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:method rdf:type rdf:Property ;
    rdfs:label 'Method' ;
    rdfs:comment 'Indicates whether the audit was performed internally, by an external party, or a third-party provider.' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nonConformanceCount rdf:type rdf:Property ;
    rdfs:label 'Non Conformance Count' ;
    rdfs:comment 'Number of non-conformances identified during the audit.' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:nonConformanceSeverity rdf:type rdf:Property ;
    rdfs:label 'Non Conformance Severity' ;
    rdfs:comment 'Highest severity level among identified non-conformances.' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryBody rdf:type rdf:Property ;
    rdfs:label 'Regulatory Body' ;
    rdfs:comment 'Governing body or standard applicable to the audit.' ;
    rdfs:domain ind:Automotive ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskLevel rdf:type rdf:Property ;
