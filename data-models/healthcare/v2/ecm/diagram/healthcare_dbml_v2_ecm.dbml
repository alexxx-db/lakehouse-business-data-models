  npi_number varchar
  organization_name varchar [note: 'Organization name (for entity type 2).']
  organization_other_name varchar [note: 'Organization other name (DBA).']
  practice_address_line1 varchar
  practice_city varchar
  practice_location_address_country_code varchar [note: 'Practice location country code.']
  practice_location_address_line_1 varchar [note: 'Practice location address line 1.']
  practice_location_address_line_2 varchar [note: 'Practice location address line 2.']
  practice_location_fax_number varchar [note: 'Practice location fax number.']
  practice_location_telephone_number varchar [note: 'Practice location telephone number.']
  practice_postal_code varchar
  practice_state varchar
