ind:bacteriologicalResultName rdf:type rdf:Property ;
    rdfs:label 'Bacteriological Result Name' ;
    rdfs:domain ind:BacteriologicalResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:repeatSampleRequiredFlag rdf:type rdf:Property ;
