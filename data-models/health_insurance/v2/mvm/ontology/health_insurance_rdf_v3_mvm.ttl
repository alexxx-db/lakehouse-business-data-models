ind:pcpAssignmentId rdf:type rdf:Property ;
    rdfs:label 'Pcp Assignment Id' ;
    rdfs:comment 'Primary key for pcp_assignment' ;
    rdfs:domain ind:PcpAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:capitationArrangementId rdf:type rdf:Property ;
    rdfs:label 'Capitation Arrangement Id' ;
    rdfs:comment 'Foreign key linking to contract.capitation_arrangement. Business justification: PCPs under capitation contracts have their panel members attributed through PCP assignments. Linking pcp_assignment to capitation_arrangement enables accurate PMPM payment calculation per PCP panel, s' ;
    rdfs:domain ind:HealthInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CapitationArrangement .

ind:contractProviderContractId rdf:type rdf:Property ;
    rdfs:label 'Contract Provider Contract Id' ;
    rdfs:comment 'Foreign key linking to contract.provider_contract. Business justification: Required for compliance check that a PCP assignment respects an active provider contract; ensures network participation rules are enforced during PCP selection.' ;
    rdfs:domain ind:HealthInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProviderContract .

ind:parAgreementId rdf:type rdf:Property ;
    rdfs:label 'Par Agreement Id' ;
    rdfs:comment 'Foreign key linking to network.par_agreement. Business justification: PCP assignment workflows must verify the specific PAR agreement under which the PCP participates in the network, supporting continuity of care, credentialing status checks, and contract compliance. Th' ;
    rdfs:domain ind:HealthInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ParAgreement .

ind:pcpProviderId rdf:type rdf:Property ;
    rdfs:label 'Pcp Provider Id' ;
    rdfs:comment 'Foreign key linking to provider.provider_provider. Business justification: REQUIRED: PCP assignment records must reference the provider entity to support network participation audits and accurate provider-member linkage.' ;
    rdfs:domain ind:HealthInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Provider .

ind:practiceLocationId rdf:type rdf:Property ;
    rdfs:label 'Practice Location Id' ;
    rdfs:comment 'Foreign key linking to provider.practice_location. Business justification: PCP assignments must specify WHICH office location the member is assigned to, since a provider can have multiple practice locations. Network adequacy reporting, member directory display, and care coor' ;
    rdfs:domain ind:HealthInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PracticeLocation .

ind:providerAssignmentId rdf:type rdf:Property ;
    rdfs:label 'Provider Assignment Id' ;
    rdfs:comment 'Foreign key linking to network.provider_assignment. Business justification: Panel management requires linking a member\'s PCP assignment to the provider\'s network.provider_assignment record to verify panel capacity, accepting_new_patients_flag, and panel_status before assignme' ;
    rdfs:domain ind:HealthInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProviderAssignment .

ind:providerNetworkId rdf:type rdf:Property ;
    rdfs:label 'Provider Network Id' ;
    rdfs:comment 'Identifier of the provider network to which the PCP belongs.' ;
    rdfs:domain ind:HealthInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProviderNetwork .

ind:specialtyId rdf:type rdf:Property ;
    rdfs:label 'Specialty Id' ;
    rdfs:comment 'Foreign key linking to provider.specialty. Business justification: pcp_assignment.pcp_specialty_code is a denormalized representation of provider.specialty. Linking to specialty normalizes this, enabling credentialing validation, HEDIS specialty reporting, and networ' ;
    rdfs:domain ind:HealthInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Specialty .

ind:tierId rdf:type rdf:Property ;
    rdfs:label 'Tier Id' ;
    rdfs:comment 'Foreign key linking to network.tier. Business justification: PCP assignments in tiered networks must record the PCP\'s tier to calculate member cost-sharing and steerage incentives. The existing network_tier plain-text column is a denormalization of network.tier' ;
    rdfs:domain ind:HealthInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Tier .

ind:assignmentReason rdf:type rdf:Property ;
    rdfs:label 'Assignment Reason' ;
    rdfs:comment 'Free-text explanation for why the PCP was assigned (e.g., member request, network requirement).' ;
    rdfs:domain ind:PcpAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignmentStatus rdf:type rdf:Property ;
    rdfs:label 'Assignment Status' ;
    rdfs:comment 'Current lifecycle status of the PCP assignment.' ;
    rdfs:domain ind:PcpAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignmentType rdf:type rdf:Property ;
    rdfs:label 'Assignment Type' ;
    rdfs:comment 'Method by which the PCP was assigned: member-selected, auto-assigned by system, or plan-assigned.' ;
    rdfs:domain ind:PcpAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:changeReason rdf:type rdf:Property ;
    rdfs:label 'Change Reason' ;
    rdfs:comment 'Reason for a change to the PCP assignment (e.g., member relocation, provider departure).' ;
    rdfs:domain ind:HealthInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:changeTimestamp rdf:type rdf:Property ;
    rdfs:label 'Change Timestamp' ;
    rdfs:comment 'Exact time when the most recent change to the assignment was recorded.' ;
    rdfs:domain ind:PcpAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:isCurrent rdf:type rdf:Property ;
