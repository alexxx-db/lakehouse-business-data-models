ind:addressId rdf:type rdf:Property ;
    rdfs:label 'Address Id' ;
    rdfs:comment 'Surrogate primary key for the address record.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
