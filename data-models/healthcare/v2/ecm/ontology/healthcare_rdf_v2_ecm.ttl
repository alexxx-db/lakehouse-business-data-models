ind:uspCategory rdf:type rdf:Property ;
    rdfs:label 'Usp Category' ;
    rdfs:domain ind:CompoundingRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:uspChapterCompliance rdf:type rdf:Property ;
