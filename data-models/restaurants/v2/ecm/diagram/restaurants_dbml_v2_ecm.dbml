  updated_timestamp timestamp [note: 'Record last update timestamp']

  Note: 'Supply-specific contracts linking suppliers to sites/categories with pricing and delivery terms.'
}

Table inventory.stock_item {
  stock_item_id varchar [pk, note: 'Primary key for the stock item.']
  category_id varchar [note: 'FK to procurement category.']
  cost_center_id varchar [note: 'FK to finance cost center.']
  gl_account_id varchar [note: 'FK to GL account for inventory valuation.']
  ingredient_id varchar [note: 'FK to supply ingredient master.']
  item_specification_id varchar [note: 'FK to procurement item specification.']
  primary_vendor_procurement_supplier_id varchar [note: 'FK to primary vendor supplier.']
  stock_procurement_supplier_id varchar [note: 'FK to procurement supplier.']
  allergen_eggs boolean [note: 'Whether item contains eggs allergen.']
  allergen_fish boolean [note: 'Whether item contains fish allergen.']
  allergen_milk boolean [note: 'Whether item contains milk allergen.']
  allergen_peanuts boolean [note: 'Whether item contains peanuts allergen.']
  allergen_shellfish boolean [note: 'Whether item contains shellfish allergen.']
  allergen_soybeans boolean [note: 'Whether item contains soybeans allergen.']
  allergen_tree_nuts boolean [note: 'Whether item contains tree nuts allergen.']
  allergen_wheat boolean [note: 'Whether item contains wheat allergen.']
  case_pack_quantity varchar [note: 'Number of units per case pack.']
  cost_currency_code decimal(18,2) [note: 'Currency code for cost values.']
  created_timestamp timestamp [note: 'Timestamp when record was created.']
  discontinuation_date date [note: 'Date item was discontinued.']
  gtin varchar [note: 'Global Trade Item Number.']
  haccp_max_temp_f decimal(5,2) [note: 'Maximum HACCP-compliant storage temperature in Fahrenheit.']
  haccp_min_temp_f decimal(5,2) [note: 'Minimum HACCP-compliant storage temperature in Fahrenheit.']
  is_active boolean [note: 'Whether the stock item is currently active.']
  is_gluten_free boolean [note: 'Whether item is gluten free.']
  is_gmo_free boolean [note: 'Whether item is GMO free.']
  is_halal boolean [note: 'Whether item is halal certified.']
  is_kosher boolean [note: 'Whether item is kosher certified.']
  is_organic boolean [note: 'Whether item is organic.']
  is_vegan boolean [note: 'Whether item is vegan.']
  is_vegetarian boolean [note: 'Whether item is vegetarian.']
  item_category varchar [note: 'Category classification of the stock item.']
  item_description varchar [note: 'Detailed description of the stock item.']
  item_name varchar [note: 'Name of the stock item.']
  item_subcategory varchar [note: 'Subcategory classification.']
  last_modified_timestamp timestamp [note: 'Timestamp of last modification.']
  par_level decimal(10,2) [note: 'Target on-hand quantity.']
  reorder_point decimal(10,2) [note: 'Quantity at which reorder is triggered.']
  reorder_quantity decimal(10,2) [note: 'Standard quantity to reorder.']
  shelf_life_days varchar [note: 'Number of days item remains usable.']
  sku_code varchar [note: 'Stock keeping unit code.']
  standard_cost decimal(18,2) [note: 'Standard cost per unit.']
  storage_class varchar [note: 'Storage classification (dry, refrigerated, frozen).']
  unit_of_measure varchar [note: 'Default unit of measure.']
  vendor_item_code varchar [note: 'Vendor-assigned item code.']
  yield_percentage decimal(5,2) [note: 'Expected yield percentage after prep.']

  Note: 'Master record for each stockable item tracked in restaurant inventory including allergen flags, storage requirements, and reorder parameters.'
}

Table inventory.stock_location {
  stock_location_id varchar [pk, note: 'Primary key for the stock location.']
  cost_center_id varchar [note: 'FK to finance cost center.']
  distribution_center_id varchar [note: 'FK to supply distribution center.']
  facility_id varchar [note: 'FK to real estate facility.']
  manager_employee_id varchar [note: 'FK to employee managing this location.']
  restaurant_unit_id varchar [note: 'FK to restaurant unit.']
  stock_equipment_asset_id varchar [note: 'FK to restaurant equipment asset.']
  stock_equipment_equipment_asset_id varchar [note: 'Alternate FK to equipment asset.']
  access_control_required boolean [note: 'Whether access control is required.']
  activation_date date [note: 'Date location was activated.']
  allows_receiving boolean [note: 'Whether location can receive goods.']
  allows_transfers boolean [note: 'Whether location allows stock transfers.']
  allows_waste_tracking boolean [note: 'Whether waste tracking is enabled.']
  bin_count varchar [note: 'Number of bins in this location.']
  building_section varchar [note: 'Section of building where location resides.']
  capacity_cubic_feet decimal(18,2) [note: 'Storage capacity in cubic feet.']
  created_timestamp timestamp [note: 'Timestamp when record was created.']
  cycle_count_frequency_days varchar [note: 'Days between cycle counts.']
  deactivation_date date [note: 'Date location was deactivated.']
  floor_level varchar [note: 'Floor level of the location.']
  last_cycle_count_date date [note: 'Date of last cycle count.']
  last_maintenance_date date [note: 'Date of last maintenance.']
  last_modified_timestamp timestamp [note: 'Timestamp of last modification.']
  location_code varchar [note: 'Unique code for the location.']
  location_name varchar [note: 'Name of the storage location.']
  location_type varchar [note: 'Type of location (walk-in, shelf, etc).']
  next_scheduled_cycle_count_date date [note: 'Next scheduled cycle count date.']
  next_scheduled_maintenance_date date [note: 'Next scheduled maintenance date.']
  notes varchar [note: 'Free-text notes about the location.']
  par_level_enabled boolean [note: 'Whether par level management is enabled.']
  primary_commodity_category varchar [note: 'Primary commodity stored here.']
  requires_haccp_monitoring boolean [note: 'Whether HACCP monitoring is required.']
  security_level varchar [note: 'Security level classification.']
  shelf_count varchar [note: 'Number of shelves.']
  stock_location_status varchar [note: 'Current status of the location.']
  storage_area_type varchar [note: 'Type of storage area.']
  target_temperature_max_f decimal(5,2) [note: 'Maximum target temperature in Fahrenheit.']
  target_temperature_min_f decimal(5,2) [note: 'Minimum target temperature in Fahrenheit.']
  temperature_monitoring_frequency_hours varchar [note: 'Hours between temperature checks.']
  temperature_zone varchar [note: 'Temperature zone classification.']

  Note: 'Physical storage locations within restaurants, distribution centers, or facilities where inventory is held.'
}

Table inventory.on_hand_balance {
  on_hand_balance_id varchar [pk, note: 'Primary key.']
  cost_center_id varchar [note: 'FK to cost center.']
  facility_id varchar [note: 'FK to facility.']
  on_restaurant_unit_id varchar [note: 'FK to restaurant unit.']
  on_sku_stock_item_id varchar [note: 'FK to stock item by SKU.']
  on_stock_item_id varchar [note: 'FK to stock item.']
  on_unit_id varchar [note: 'FK to restaurant unit.']
  stock_location_id varchar [note: 'FK to stock location.']
