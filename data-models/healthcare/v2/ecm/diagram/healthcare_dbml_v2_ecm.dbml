  employee_id varchar [note: 'FK to the coder/employee who performed the assignment.']
  mpi_record_id varchar [note: 'FK to the patient MPI record.']
  payer_id varchar [note: 'FK to the payer.']
  visit_id varchar [note: 'FK to the parent visit.']
  actual_los decimal(6,2) [note: 'Actual length of stay in days.']
  admit_source_code varchar [note: 'Admission source code.']
  appeal_status varchar [note: 'Status of any DRG appeal.']
  arithmetic_mean_los decimal(6,2) [note: 'Arithmetic mean length of stay for this DRG.']
  assignment_status varchar [note: 'Status of the DRG assignment.']
  assignment_type varchar [note: 'Type of DRG assignment (initial, final, appeal).']
  base_payment_rate decimal(12,2) [note: 'Base payment rate for this DRG.']
  cc_mcc_flag boolean [note: 'Flag indicating presence of CC or MCC.']
  cdi_query_count varchar [note: 'Number of CDI queries associated with this assignment.']
  cdi_query_response_flag boolean [note: 'Flag indicating CDI query was responded to.']
  created_timestamp timestamp [note: 'Record creation timestamp.']
  discharge_status_code varchar [note: 'Discharge status code.']
  drg_assignment_status varchar
  drg_changed_flag boolean [note: 'Flag indicating DRG was changed from initial assignment.']
  drg_description varchar [note: 'Description of the assigned DRG.']
  drg_version varchar [note: 'DRG version (e.g., MS-DRG v40).']
  drg_version_number varchar [note: 'DRG version number.']
  drg_weight decimal(10,4) [note: 'DRG relative weight.']
  expected_reimbursement decimal(12,2) [note: 'Expected reimbursement amount.']
  finalized_timestamp timestamp [note: 'Timestamp when DRG assignment was finalized.']
  geometric_mean_los decimal(6,2) [note: 'Geometric mean length of stay for this DRG.']
  grouper_software varchar [note: 'DRG grouper software used.']
  grouper_software_version varchar [note: 'Version of the DRG grouper software.']
  grouping_date date [note: 'Date when DRG grouping was performed.']
  initial_drg_code varchar [note: 'Initial DRG code before any changes.']
  initial_drg_weight decimal(10,4) [note: 'Initial DRG weight before any changes.']
  is_outlier boolean [note: 'Flag indicating this is a cost or day outlier case.']
  mdc_code varchar [note: 'Major Diagnostic Category code.']
  mdc_description varchar [note: 'Major Diagnostic Category description.']
  outlier_payment decimal(12,2) [note: 'Outlier payment amount.']
  patient_type varchar [note: 'Patient type (medical, surgical).']
  principal_diagnosis_code varchar [note: 'Principal diagnosis ICD-10 code.']
  principal_diagnosis_description varchar [note: 'Principal diagnosis description.']
  principal_procedure_code varchar [note: 'Principal procedure code.']
