ind:generationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Generation Timestamp' ;
    rdfs:comment 'Timestamp when the predictive maintenance alert was generated by the analytics engine.' ;
    rdfs:domain ind:PredictiveMaintenanceAlert ;
    rdf:type owl:DatatypeProperty ;
