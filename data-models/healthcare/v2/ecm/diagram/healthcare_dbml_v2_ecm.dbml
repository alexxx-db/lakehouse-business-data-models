  notification_attempt_count varchar [note: 'Number of notification attempts']
  notification_datetime timestamp [note: 'When notification was sent']
  notification_method varchar [note: 'Method of notification']
  notification_status varchar [note: 'Status of notification']
  notification_turnaround_minutes varchar [note: 'Minutes from finding to notification']
  notified_provider_npi varchar [note: 'NPI of notified provider']
