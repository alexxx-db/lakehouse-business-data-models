    rdfs:label 'Contrast Bolus Agent' ;
    rdfs:comment 'Contrast agent used.' ;
    rdfs:domain ind:DicomSeries ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contrastBolusRoute rdf:type rdf:Property ;
    rdfs:label 'Contrast Bolus Route' ;
    rdfs:comment 'Route of contrast administration.' ;
    rdfs:domain ind:DicomSeries ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contrastBolusVolumeMl rdf:type rdf:Property ;
    rdfs:label 'Contrast Bolus Volume Ml' ;
    rdfs:comment 'Volume of contrast administered in mL.' ;
    rdfs:domain ind:DicomSeries ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ctdiVolMgy rdf:type rdf:Property ;
    rdfs:label 'Ctdi Vol Mgy' ;
    rdfs:comment 'CT Dose Index Volume in mGy.' ;
    rdfs:domain ind:Radiology ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dlpMgyCm rdf:type rdf:Property ;
    rdfs:label 'Dlp Mgy Cm' ;
    rdfs:comment 'Dose Length Product in mGy·cm.' ;
    rdfs:domain ind:Radiology ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:exposureMa rdf:type rdf:Property ;
    rdfs:label 'Exposure Ma' ;
    rdfs:comment 'Exposure in milliamperes.' ;
    rdfs:domain ind:DicomSeries ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:exposureTimeMs rdf:type rdf:Property ;
    rdfs:label 'Exposure Time Ms' ;
    rdfs:comment 'Exposure time in milliseconds.' ;
    rdfs:domain ind:DicomSeries ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:imageOrientationPatient rdf:type rdf:Property ;
    rdfs:label 'Image Orientation Patient' ;
    rdfs:comment 'DICOM Image Orientation (Patient).' ;
    rdfs:domain ind:DicomSeries ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:kvp rdf:type rdf:Property ;
    rdfs:label 'Kvp' ;
    rdfs:comment 'Peak kilovoltage.' ;
    rdfs:domain ind:Radiology ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modality rdf:type rdf:Property ;
    rdfs:label 'Modality' ;
    rdfs:comment 'Imaging modality (e.g., CT, MRI, X-Ray).' ;
    rdfs:domain ind:Radiology ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:numberOfSeriesRelatedInstances rdf:type rdf:Property ;
    rdfs:label 'Number Of Series Related Instances' ;
    rdfs:comment 'Number of instances (images) in the series.' ;
    rdfs:domain ind:DicomSeries ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:pacsArchiveStatus rdf:type rdf:Property ;
    rdfs:label 'Pacs Archive Status' ;
    rdfs:comment 'Status in PACS archive.' ;
    rdfs:domain ind:DicomSeries ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pacsStoragePath rdf:type rdf:Property ;
    rdfs:label 'Pacs Storage Path' ;
    rdfs:comment 'PACS storage path or location.' ;
    rdfs:domain ind:DicomSeries ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:performingPhysicianName rdf:type rdf:Property ;
    rdfs:label 'Performing Physician Name' ;
    rdfs:comment 'Name of the performing physician.' ;
    rdfs:domain ind:DicomSeries ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pixelSpacingMm rdf:type rdf:Property ;
    rdfs:label 'Pixel Spacing Mm' ;
    rdfs:comment 'Pixel spacing in millimeters.' ;
    rdfs:domain ind:DicomSeries ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:procedureCodeModifier rdf:type rdf:Property ;
    rdfs:label 'Procedure Code Modifier' ;
    rdfs:comment 'CPT code modifier.' ;
    rdfs:domain ind:DicomSeries ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qualityControlComments rdf:type rdf:Property ;
    rdfs:label 'Quality Control Comments' ;
    rdfs:comment 'Quality control comments.' ;
    rdfs:domain ind:DicomSeries ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:radiationDoseMgy rdf:type rdf:Property ;
    rdfs:label 'Radiation Dose Mgy' ;
    rdfs:comment 'Radiation dose in mGy.' ;
    rdfs:domain ind:DicomSeries ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:referringPhysicianNpi rdf:type rdf:Property ;
    rdfs:label 'Referring Physician Npi' ;
    rdfs:comment 'National Provider Identifier of the referring physician.' ;
    rdfs:domain ind:DicomSeries ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestingPhysicianName rdf:type rdf:Property ;
    rdfs:label 'Requesting Physician Name' ;
    rdfs:comment 'Name of the requesting physician.' ;
    rdfs:domain ind:DicomSeries ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:seriesCompletenessFlag rdf:type rdf:Property ;
    rdfs:label 'Series Completeness Flag' ;
    rdfs:comment 'Flag indicating if the series is complete.' ;
    rdfs:domain ind:DicomSeries ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:seriesDate rdf:type rdf:Property ;
    rdfs:label 'Series Date' ;
    rdfs:comment 'Date of the series.' ;
    rdfs:domain ind:DicomSeries ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:seriesDescription rdf:type rdf:Property ;
    rdfs:label 'Series Description' ;
    rdfs:comment 'Description of the series.' ;
    rdfs:domain ind:DicomSeries ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:seriesInstanceUid rdf:type rdf:Property ;
    rdfs:label 'Series Instance Uid' ;
    rdfs:comment 'DICOM Series Instance UID.' ;
    rdfs:domain ind:DicomSeries ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:seriesNumber rdf:type rdf:Property ;
    rdfs:label 'Series Number' ;
    rdfs:comment 'Series number within the study.' ;
    rdfs:domain ind:DicomSeries ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:seriesStatus rdf:type rdf:Property ;
    rdfs:label 'Series Status' ;
    rdfs:comment 'Status of the series.' ;
    rdfs:domain ind:DicomSeries ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:seriesTime rdf:type rdf:Property ;
    rdfs:label 'Series Time' ;
    rdfs:comment 'Time of the series.' ;
    rdfs:domain ind:DicomSeries ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:sliceThicknessMm rdf:type rdf:Property ;
    rdfs:label 'Slice Thickness Mm' ;
    rdfs:comment 'Slice thickness in millimeters.' ;
    rdfs:domain ind:Radiology ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:directMessageId rdf:type rdf:Property ;
    rdfs:label 'Direct Message Id' ;
    rdfs:comment 'Foreign key linking to interoperability.direct_message. Business justification: Radiology reports are transmitted via Direct messaging for care coordination, specialist referrals, and patient-requested records. Links report to Direct message for delivery tracking, read receipts, ' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DirectMessage .

ind:icd10PrimaryIcdCodeId rdf:type rdf:Property ;
    rdfs:label 'Icd10 Primary Icd Code Id' ;
    rdfs:comment 'Foreign key linking to reference.icd_code. Business justification: Reports document ICD-10 codes for clinical documentation integrity, support diagnosis-based quality measures, and enable population health analytics linking imaging findings to disease prevalence.' ;
    rdfs:domain ind:Report ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:IcdCode .

ind:primaryReportAddendumAuthorClinicianId rdf:type rdf:Property ;
    rdfs:label 'Primary Report Addendum Author Clinician Id' ;
    rdfs:comment 'Reference to the provider who authored the addendum or amendment. May differ from the original signing radiologist. Null for the original report.' ;
    rdfs:domain ind:Report ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:tertiaryReportReadingRadiologistClinicianId rdf:type rdf:Property ;
    rdfs:label 'Tertiary Report Reading Radiologist Clinician Id' ;
    rdfs:comment 'Reference to the radiologist who performed the primary interpretation of the imaging study. May differ from the signing radiologist in teaching or supervisory contexts (e.g., resident reads, attending signs). Used for productivity tracking and RVU attribution.' ;
    rdfs:domain ind:Report ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:transcriptionistEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Transcriptionist Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: Radiology reports often dictated and transcribed by medical transcriptionists. Tracking needed for quality assurance, productivity monitoring, and error investigation when voice recognition not used.' ;
    rdfs:domain ind:Report ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:addendumSequence rdf:type rdf:Property ;
    rdfs:label 'Addendum Sequence' ;
    rdfs:comment 'Sequential number identifying the addendum within the report\'s amendment history. Null for the original report. Increments with each addendum or amendment added post-finalization. Used to order and display the full report amendment history.' ;
    rdfs:domain ind:Report ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:addendumText rdf:type rdf:Property ;
    rdfs:label 'Addendum Text' ;
    rdfs:comment 'Full text content of the addendum or amendment added to the report post-finalization. Contains Protected Health Information (PHI). Null for the original report. Preserves the complete amendment history as versioned child records.' ;
    rdfs:domain ind:Radiology ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:addendumTimestamp rdf:type rdf:Property ;
    rdfs:label 'Addendum Timestamp' ;
    rdfs:comment 'Date and time when the addendum or amendment was authored and signed. Null for the original report. Used to track the timeline of post-final modifications.' ;
    rdfs:domain ind:Radiology ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:addendumType rdf:type rdf:Property ;
    rdfs:label 'Addendum Type' ;
    rdfs:comment 'Classifies the type of post-final modification to the report. \'Addendum\' adds new information without changing the original; \'amendment\' modifies existing content; \'correction\' fixes a factual error; \'retraction\' withdraws the report. Null for the original report.' ;
    rdfs:domain ind:Radiology ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:attestationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Attestation Timestamp' ;
    rdfs:comment 'Date and time when the signing radiologist attested and finalized the report, transitioning it to \'final\' status. This is the principal business event timestamp for the report lifecycle. Required for billing, legal, and compliance purposes.' ;
    rdfs:domain ind:Report ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:contrastAdministeredFlag rdf:type rdf:Property ;
    rdfs:label 'Contrast Administered Flag' ;
    rdfs:comment 'Indicates whether contrast agent was administered during the imaging study. Relevant for CPT code selection, billing accuracy, radiation safety, and clinical documentation of contrast reactions.' ;
    rdfs:domain ind:Radiology ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:contrastAgentName rdf:type rdf:Property ;
    rdfs:label 'Contrast Agent Name' ;
    rdfs:comment 'Name of the contrast agent administered during the imaging study (e.g., Gadolinium, Iohexol, Gadobutrol). Null if no contrast was administered. Used for adverse event tracking, pharmacy reconciliation, and clinical documentation.' ;
    rdfs:domain ind:Radiology ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:criticalFindingCommunicatedFlag rdf:type rdf:Property ;
    rdfs:label 'Critical Finding Communicated Flag' ;
    rdfs:comment 'Indicates whether the critical finding has been communicated to the ordering or responsible provider. Required for Joint Commission compliance. Only applicable when critical_finding_flag is True.' ;
    rdfs:domain ind:Report ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:criticalFindingCommunicatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Critical Finding Communicated Timestamp' ;
    rdfs:comment 'Date and time when the critical finding was communicated to the ordering or responsible provider. Used to measure turnaround time compliance with Joint Commission and ACR critical results communication standards.' ;
    rdfs:domain ind:Report ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:dicomStudyInstanceUid rdf:type rdf:Property ;
    rdfs:label 'Dicom Study Instance Uid' ;
    rdfs:comment 'Globally unique DICOM Study Instance UID linking this report to the corresponding image set in the Picture Archiving and Communication System (PACS). Enables direct navigation from the report to the source images. Sourced from DICOM tag (0020,000D).' ;
    rdfs:domain ind:Radiology ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dictationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Dictation Timestamp' ;
    rdfs:comment 'Date and time when the radiologist began dictating the report. Used to measure report turnaround time (TAT) from study completion to dictation. Sourced from Epic Radiant or Cerner RadNet workflow timestamps.' ;
    rdfs:domain ind:Report ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:findingsText rdf:type rdf:Property ;
    rdfs:label 'Findings Text' ;
    rdfs:comment 'Full narrative text of the radiologist\'s findings section of the report, describing the imaging observations in detail. Contains Protected Health Information (PHI). This is the primary clinical content of the report and the source of truth for diagnostic observations. Sourced from Epic ClinDoc or Cerner PowerChart dictation/transcription.' ;
    rdfs:domain ind:Report ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:followUpRecommendation rdf:type rdf:Property ;
    rdfs:label 'Follow Up Recommendation' ;
    rdfs:comment 'Structured follow-up recommendation from the radiologist\'s impression, indicating the recommended next action (e.g., \'Follow-up CT in 3 months\', \'Biopsy recommended\', \'No follow-up needed\'). Used for care coordination, population health management, and closing the loop on incidental findings.' ;
    rdfs:domain ind:Report ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:impressionText rdf:type rdf:Property ;
    rdfs:label 'Impression Text' ;
    rdfs:comment 'Radiologist\'s summary impression or conclusion section of the report, providing the diagnostic interpretation and clinical recommendations. Contains Protected Health Information (PHI). This is the most clinically actionable section of the report and is used for clinical decision support, CDI, and quality measurement.' ;
    rdfs:domain ind:Report ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modalityCode rdf:type rdf:Property ;
    rdfs:label 'Modality Code' ;
    rdfs:comment 'DICOM-standard code identifying the imaging modality used for the study (e.g., CT = Computed Tomography, MR = Magnetic Resonance Imaging, XR/DX/CR = X-Ray, US = Ultrasound, PT = Positron Emission Tomography, NM = Nuclear Medicine, MG = Mammography, FL = Fluoroscopy). Sourced from DICOM tag (0008,0060). [ENUM-REF-CANDIDATE: CT|MR|XR|US|PT|NM|MG|FL|DX|CR — 10 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Radiology ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preliminaryTimestamp rdf:type rdf:Property ;
    rdfs:label 'Preliminary Timestamp' ;
    rdfs:comment 'Date and time when the report was first released in preliminary status, making it available to ordering providers before final attestation. Key lifecycle event for TAT measurement and clinical workflow.' ;
    rdfs:domain ind:Report ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:radsCategory rdf:type rdf:Property ;
    rdfs:label 'Rads Category' ;
    rdfs:comment 'Standardized ACR Reporting and Data System (RADS) assessment category assigned in the impression (e.g., BI-RADS 0-6 for mammography, LI-RADS 1-5 for liver, TI-RADS 1-5 for thyroid, Lung-RADS 1-4). Drives follow-up recommendations and quality measurement. [ENUM-REF-CANDIDATE: BI-RADS 0|BI-RADS 1|BI-RADS 2|BI-RADS 3|BI-RADS 4|BI-RADS 5|BI-RADS 6|LI-RADS 1|LI-RADS 2|LI-RADS 3|LI-RADS 4|LI-RADS 5|TI-RADS 1|TI-RADS 2|TI-RADS 3|TI-RADS 4|TI-RADS 5|Lung-RADS 1|Lung-RADS 2|Lung-RADS 3|Lung-RADS 4 — promote to reference product]' ;
    rdfs:domain ind:Radiology ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:risReportCode rdf:type rdf:Property ;
    rdfs:label 'Ris Report Code' ;
    rdfs:comment 'Native report identifier from the source Radiology Information System (RIS), such as Epic Radiant or Cerner RadNet. Used for cross-system reconciliation, ETL lineage tracking, and source system audit.' ;
    rdfs:domain ind:Report ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:signingRadiologistNpi rdf:type rdf:Property ;
    rdfs:label 'Signing Radiologist Npi' ;
    rdfs:comment '10-digit National Provider Identifier (NPI) of the radiologist who signed and attested the final report. Required for CMS billing, claims submission, and provider credentialing validation. Sourced from the NPPES registry.' ;
    rdfs:domain ind:Report ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:statPriorityFlag rdf:type rdf:Property ;
    rdfs:label 'Stat Priority Flag' ;
    rdfs:comment 'Indicates whether the imaging order and report were designated as STAT (immediate/urgent priority), requiring expedited turnaround time. Drives workflow prioritization in the RIS and radiologist worklist. Used for TAT compliance monitoring.' ;
    rdfs:domain ind:Report ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:studyDatetime rdf:type rdf:Property ;
    rdfs:label 'Study Datetime' ;
    rdfs:comment 'Date and time when the imaging study was performed (image acquisition). This is the principal real-world event time for the report. Sourced from DICOM tag (0008,0020)/(0008,0030) and RIS. Used as the primary temporal anchor for TAT calculations and clinical timelines.' ;
    rdfs:domain ind:Radiology ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:studyDescription rdf:type rdf:Property ;
    rdfs:label 'Study Description' ;
    rdfs:comment 'Human-readable description of the imaging study protocol or procedure performed (e.g., \'CT Chest with Contrast\', \'MRI Brain without Contrast\'). Sourced from the RIS order and DICOM tag (0008,1030). Used for report titling and clinical context.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transcriptionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Transcription Timestamp' ;
    rdfs:comment 'Date and time when the report transcription was completed (if applicable). Relevant for facilities using human transcription services rather than voice recognition. Used in TAT measurement.' ;
    rdfs:domain ind:Report ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:reportAddendumId rdf:type rdf:Property ;
    rdfs:label 'Report Addendum Id' ;
    rdfs:comment 'Unique surrogate identifier for each radiology report addendum record in the Silver Layer lakehouse. Primary key for this entity.' ;
    rdfs:domain ind:Radiology ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ReportAddendum .

ind:icd10IcdCodeId rdf:type rdf:Property ;
    rdfs:label 'Icd10 Icd Code Id' ;
    rdfs:comment 'Foreign key linking to reference.icd_code. Business justification: Addenda may update or clarify diagnosis codes for CDI queries, DRG impact analysis, and billing corrections. Links support amendment tracking and diagnosis code change auditing for compliance.' ;
    rdfs:domain ind:ReportAddendum ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:IcdCode .

ind:originalReportId rdf:type rdf:Property ;
    rdfs:label 'Original Report Id' ;
    rdfs:comment 'Reference to the finalized radiology report to which this addendum is appended. Links the addendum to its parent report for audit and CDI (Clinical Documentation Improvement) traceability.' ;
    rdfs:domain ind:ReportAddendum ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Report .

ind:primaryReportClinicianId rdf:type rdf:Property ;
    rdfs:label 'Primary Report Clinician Id' ;
    rdfs:comment 'Internal provider identifier for the radiologist or clinician who authored this addendum. Complements author_npi for internal system linkage to the provider master.' ;
    rdfs:domain ind:ReportAddendum ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:tertiaryReportOrderingProviderClinicianId rdf:type rdf:Property ;
    rdfs:label 'Tertiary Report Ordering Provider Clinician Id' ;
    rdfs:comment 'Internal provider identifier for the clinician who placed the original imaging order. Required to determine notification obligations when an addendum is issued, per ACR communication guidelines.' ;
    rdfs:domain ind:ReportAddendum ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:acknowledgmentDatetime rdf:type rdf:Property ;
    rdfs:label 'Acknowledgment Datetime' ;
    rdfs:comment 'Date and time when the ordering provider acknowledged receipt of the addendum notification. Nullable until acknowledged. Critical for closed-loop communication compliance per ACR and TJC standards.' ;
    rdfs:domain ind:Radiology ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:addendumDatetime rdf:type rdf:Property ;
    rdfs:label 'Addendum Datetime' ;
    rdfs:comment 'Date and time when the addendum was authored and entered into the RIS/EHR system. Represents the principal business event timestamp for this transaction. Stored in ISO 8601 format (yyyy-MM-ddTHH:mm:ss.SSSXXX).' ;
    rdfs:domain ind:ReportAddendum ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:addendumSequenceNumber rdf:type rdf:Property ;
    rdfs:label 'Addendum Sequence Number' ;
    rdfs:comment 'Sequential integer indicating the order of this addendum relative to other addenda on the same original report (e.g., 1 = first addendum, 2 = second addendum). Supports multi-addendum tracking and version ordering.' ;
    rdfs:domain ind:ReportAddendum ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:addendumStatus rdf:type rdf:Property ;
    rdfs:label 'Addendum Status' ;
    rdfs:comment 'Current workflow lifecycle state of the addendum. \'draft\' = authored but not yet signed; \'pending_review\' = awaiting co-signature or peer review; \'finalized\' = signed and locked; \'retracted\' = addendum itself has been withdrawn.' ;
    rdfs:domain ind:ReportAddendum ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:addendumWordCount rdf:type rdf:Property ;
    rdfs:label 'Addendum Word Count' ;
    rdfs:comment 'Number of words in the addendum text. Used for documentation completeness analytics, CDI program metrics, and radiologist productivity reporting. Derived at ingestion time from addendum_text.' ;
    rdfs:domain ind:ReportAddendum ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:amendmentReasonCode rdf:type rdf:Property ;
    rdfs:label 'Amendment Reason Code' ;
    rdfs:comment 'Standardized code categorizing the reason for amendment, enabling structured reporting and quality analytics. Complements the free-text amendment_reason field. [ENUM-REF-CANDIDATE: transcription_error|laterality_error|clinical_history_update|measurement_correction|impression_revision|additional_finding|provider_request|other — promote to reference product]' ;
    rdfs:domain ind:ReportAddendum ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorNpi rdf:type rdf:Property ;
    rdfs:label 'Author Npi' ;
    rdfs:comment '10-digit NPI (National Provider Identifier) of the radiologist or clinician who authored this addendum. Required for provider attribution, credentialing validation, and CMS (Centers for Medicare and Medicaid Services) billing compliance.' ;
    rdfs:domain ind:ReportAddendum ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:finalizedDatetime rdf:type rdf:Property ;
    rdfs:label 'Finalized Datetime' ;
    rdfs:comment 'Date and time when the addendum was electronically signed and finalized by the authoring radiologist. Distinct from addendum_datetime (authoring time) — captures the attestation event for HIM audit and legal record purposes.' ;
    rdfs:domain ind:ReportAddendum ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:himReviewDatetime rdf:type rdf:Property ;
    rdfs:label 'Him Review Datetime' ;
    rdfs:comment 'Date and time when the HIM department completed its review of this addendum. Nullable until HIM review is performed. Supports HIM audit trail and CDI workflow tracking.' ;
    rdfs:domain ind:ReportAddendum ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:himReviewFlag rdf:type rdf:Property ;
    rdfs:label 'Him Review Flag' ;
    rdfs:comment 'Indicates whether this addendum has been flagged for review by the HIM (Health Information Management) department for coding accuracy, documentation integrity, or compliance purposes.' ;
    rdfs:domain ind:ReportAddendum ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:impressionChangedFlag rdf:type rdf:Property ;
    rdfs:label 'Impression Changed Flag' ;
    rdfs:comment 'Indicates whether the addendum materially changes the clinical impression or diagnosis of the original report. True = impression revised; False = addendum is supplemental or administrative only. Key metric for CDI quality analytics and RAC (Recovery Audit Contractor) review.' ;
    rdfs:domain ind:ReportAddendum ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:notificationDatetime rdf:type rdf:Property ;
    rdfs:label 'Notification Datetime' ;
    rdfs:comment 'Date and time when the notification of this addendum was dispatched to the ordering provider. Nullable when notification_status is \'not_required\'. Supports ACR communication audit trail.' ;
    rdfs:domain ind:Radiology ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:notificationMethod rdf:type rdf:Property ;
    rdfs:label 'Notification Method' ;
    rdfs:comment 'Channel or method used to notify the ordering provider of the addendum (e.g., Epic In Basket message, secure message, phone call, fax). Supports communication audit and ACR compliance documentation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notificationStatus rdf:type rdf:Property ;
    rdfs:label 'Notification Status' ;
    rdfs:comment 'Status of notification sent to the ordering provider regarding this addendum. \'not_required\' = no notification needed per policy; \'pending\' = notification queued; \'sent\' = notification dispatched; \'acknowledged\' = provider confirmed receipt; \'failed\' = notification delivery failed. Supports ACR communication compliance.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:originalReportFinalizedDatetime rdf:type rdf:Property ;
    rdfs:label 'Original Report Finalized Datetime' ;
    rdfs:comment 'Date and time when the original radiology report was finalized prior to this addendum. Used to calculate turnaround time between original finalization and addendum, supporting quality metrics and ACR (American College of Radiology) benchmarking.' ;
    rdfs:domain ind:Radiology ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:peerReviewFlag rdf:type rdf:Property ;
    rdfs:label 'Peer Review Flag' ;
    rdfs:comment 'Indicates whether this addendum was generated as a result of a formal peer review process (e.g., ACR RADPEER, internal quality review). True = peer review initiated; False = standard clinical addendum. Supports quality program analytics.' ;
    rdfs:domain ind:ReportAddendum ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sourceSystemAddendumCode rdf:type rdf:Property ;
    rdfs:label 'Source System Addendum Code' ;
    rdfs:comment 'Native identifier of this addendum record in the originating operational system (e.g., Epic Radiant internal addendum ID, Cerner RadNet addendum key). Enables reconciliation between the lakehouse Silver Layer and the source RIS/EHR.' ;
    rdfs:domain ind:ReportAddendum ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:voiceRecognitionFlag rdf:type rdf:Property ;
    rdfs:label 'Voice Recognition Flag' ;
    rdfs:comment 'Indicates whether this addendum was authored using voice recognition / speech-to-text dictation software (e.g., Nuance PowerScribe, Nuance DAX). True = voice recognition used; False = manually typed. Supports transcription error root cause analysis.' ;
    rdfs:domain ind:ReportAddendum ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:primaryOperatorEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Operator Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: Radiology equipment has assigned primary operators/technologists for accountability, competency tracking, and maintenance coordination. Required for quality assurance programs and regulatory complianc' ;
    rdfs:domain ind:Modality ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:acrAccreditationExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Acr Accreditation Expiration Date' ;
    rdfs:comment 'Date on which the current American College of Radiology (ACR) accreditation for this modality unit expires. Null if not accredited or not applicable. Critical for maintaining Medicare billing eligibility for advanced imaging services.' ;
    rdfs:domain ind:Modality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:acrAccreditationStatus rdf:type rdf:Property ;
    rdfs:label 'Acr Accreditation Status' ;
    rdfs:comment 'Current American College of Radiology (ACR) accreditation status for this imaging modality unit. ACR accreditation is required for Medicare reimbursement for advanced imaging services (CT, MRI, PET, nuclear medicine) under CMS policy. Drives billing eligibility and quality reporting.' ;
    rdfs:domain ind:Modality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:aeTitle rdf:type rdf:Property ;
    rdfs:label 'Ae Title' ;
    rdfs:comment 'DICOM Application Entity (AE) title assigned to this modality unit, used for DICOM network communication, PACS routing, and worklist queries. Must be unique across the enterprise DICOM network. Configured in PACS and RIS for image routing and storage commitment.' ;
    rdfs:domain ind:Modality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:boreDiameterCm rdf:type rdf:Property ;
    rdfs:label 'Bore Diameter Cm' ;
    rdfs:comment 'Inner diameter of the CT or MRI gantry bore in centimeters (e.g., 70 cm wide-bore MRI, 80 cm CT). Null for non-gantry equipment. Used for patient eligibility screening (claustrophobia, body habitus) and order routing to appropriate equipment.' ;
    rdfs:domain ind:Modality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:buildingCode rdf:type rdf:Property ;
    rdfs:label 'Building Code' ;
    rdfs:comment 'Facility building or wing code where the modality unit is located (e.g., \'MAIN\', \'NORTH\', \'MOB-A\'). Supports physical asset management, maintenance routing, and emergency response planning.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contrastCapable rdf:type rdf:Property ;
    rdfs:label 'Contrast Capable' ;
    rdfs:comment 'Indicates whether this modality unit is equipped and approved for contrast-enhanced imaging procedures. Drives protocol assignment, contrast administration workflow routing, and safety checklist requirements in the RIS and EHR order management.' ;
    rdfs:domain ind:Modality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:detectorType rdf:type rdf:Property ;
    rdfs:label 'Detector Type' ;
    rdfs:comment 'Type of image detector technology used in the modality unit (e.g., \'Flat Panel\', \'Curved Array\', \'Photon Counting\', \'CCD\', \'Amorphous Silicon\', \'Scintillator\'). Relevant for image quality benchmarking, protocol optimization, and ACR phantom testing requirements.' ;
    rdfs:domain ind:Modality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dicomModalityCode rdf:type rdf:Property ;
    rdfs:label 'Dicom Modality Code' ;
    rdfs:comment 'Standardized DICOM modality code as defined in DICOM PS3.3 (e.g., CT, MR, US, DX, PT, NM, MG, RF, XA). Used for PACS routing, DICOM worklist matching, and interoperability with imaging systems. Critical for HL7 and FHIR image exchange.' ;
    rdfs:domain ind:Modality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:doseTrackingEnabled rdf:type rdf:Property ;
    rdfs:label 'Dose Tracking Enabled' ;
    rdfs:comment 'Indicates whether automated radiation dose tracking and reporting is enabled for this modality unit, feeding the ACR Dose Index Registry (DIR) and enterprise dose management systems. Required for CMS quality reporting and MIPS measures related to radiation safety.' ;
    rdfs:domain ind:Modality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:equipmentType rdf:type rdf:Property ;
    rdfs:label 'Equipment Type' ;
    rdfs:comment 'Classification of the imaging modality by technology type, aligned with DICOM modality codes and ACR accreditation categories. Drives order routing rules, protocol assignment, and utilization reporting. [ENUM-REF-CANDIDATE: CT|MRI|X-ray|Ultrasound|PET-CT|PET|Fluoroscopy|Mammography|Nuclear Medicine|DEXA|Angiography — promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fda510kNumber rdf:type rdf:Property ;
    rdfs:label 'Fda 510k Number' ;
    rdfs:comment 'FDA 510(k) premarket notification clearance number for this imaging device model, confirming substantial equivalence to a predicate device. Supports regulatory compliance documentation and procurement validation.' ;
    rdfs:domain ind:Modality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isMobile rdf:type rdf:Property ;
    rdfs:label 'Is Mobile' ;
    rdfs:comment 'Indicates whether this modality unit is a portable or mobile imaging device (True) that can be transported to patient care areas (e.g., portable X-ray, mobile ultrasound, mobile CT), versus a fixed-installation unit (False). Affects scheduling logic, location tracking, and utilization reporting.' ;
    rdfs:domain ind:Modality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:maxPatientWeightKg rdf:type rdf:Property ;
    rdfs:label 'Max Patient Weight Kg' ;
    rdfs:comment 'Maximum patient weight in kilograms that the modality unit\'s table or gantry is rated to support. Critical for bariatric patient scheduling, safety screening, and order routing to appropriate equipment. Drives clinical decision support alerts in the RIS and EHR.' ;
    rdfs:domain ind:Modality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nextCalibrationDueDate rdf:type rdf:Property ;
    rdfs:label 'Next Calibration Due Date' ;
    rdfs:comment 'Scheduled date by which the next calibration or quality control test must be completed to maintain regulatory compliance and accreditation status. Drives preventive maintenance scheduling and compliance alerts.' ;
    rdfs:domain ind:Modality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:pacsNodeName rdf:type rdf:Property ;
    rdfs:label 'Pacs Node Name' ;
    rdfs:comment 'Name of the PACS (Picture Archiving and Communication System) storage node or archive destination configured for this modality unit. Defines the image routing path from the modality to the enterprise PACS for storage, retrieval, and radiologist interpretation.' ;
    rdfs:domain ind:Modality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:radiationEmitting rdf:type rdf:Property ;
    rdfs:label 'Radiation Emitting' ;
    rdfs:comment 'Indicates whether this imaging modality unit emits ionizing radiation (True = ionizing radiation, e.g., CT, X-ray, PET, fluoroscopy; False = non-ionizing, e.g., MRI, ultrasound). Drives radiation dose tracking requirements, state radiation control reporting, and ALARA compliance workflows.' ;
    rdfs:domain ind:Modality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:risResourceCode rdf:type rdf:Property ;
    rdfs:label 'Ris Resource Code' ;
    rdfs:comment 'Identifier for this modality unit as configured in the source Radiology Information System (RIS) — Epic Radiant or Cerner RadNet. Used for system-of-record traceability, ETL reconciliation, and cross-system integration with scheduling and order management.' ;
    rdfs:domain ind:Modality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:roomIdentifier rdf:type rdf:Property ;
    rdfs:label 'Room Identifier' ;
    rdfs:comment 'Physical room or suite identifier within the facility where the modality unit is installed (e.g., \'Room 3\', \'Suite B-102\', \'MRI Suite 1\'). Used for scheduling, patient wayfinding, and facility management.' ;
    rdfs:domain ind:Modality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduledHoursPerDay rdf:type rdf:Property ;
    rdfs:label 'Scheduled Hours Per Day' ;
    rdfs:comment 'Standard number of hours per day this modality unit is scheduled for clinical operations. Used as the denominator for equipment utilization rate calculations, capacity planning, and staffing models in radiology operations analytics.' ;
    rdfs:domain ind:Modality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sharedServiceIndicator rdf:type rdf:Property ;
    rdfs:label 'Shared Service Indicator' ;
    rdfs:comment 'Indicates whether this modality unit is shared across multiple departments, facilities, or service lines (True) versus dedicated to a single department (False). Relevant for cost allocation, scheduling priority rules, and utilization analytics in multi-entity health systems.' ;
    rdfs:domain ind:Modality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sliceCount rdf:type rdf:Property ;
    rdfs:label 'Slice Count' ;
    rdfs:comment 'Number of detector rows or slices for CT modality units (e.g., 16, 64, 128, 256, 320). Null for non-CT equipment. Determines CT protocol capabilities, scan speed, and clinical application eligibility (e.g., cardiac CT requires ≥64 slices). Used in equipment utilization and capability reporting.' ;
    rdfs:domain ind:Modality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:softwareVersion rdf:type rdf:Property ;
    rdfs:label 'Software Version' ;
    rdfs:comment 'Current installed software or firmware version on the imaging modality unit. Critical for cybersecurity patch management, FDA software as a medical device (SaMD) compliance, and protocol compatibility with PACS and RIS systems.' ;
    rdfs:domain ind:Modality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:teslaFieldStrength rdf:type rdf:Property ;
    rdfs:label 'Tesla Field Strength' ;
    rdfs:comment 'Magnetic field strength in Tesla (T) for MRI modality units (e.g., 1.5, 3.0, 7.0). Null for non-MRI equipment. Determines MRI safety zone classifications, implant screening requirements, and protocol capabilities. Required for ACR MRI accreditation documentation.' ;
    rdfs:domain ind:Modality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:protocolId rdf:type rdf:Property ;
    rdfs:label 'Protocol Id' ;
    rdfs:comment 'Primary key for protocol' ;
    rdfs:domain ind:Protocol ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:approvingClinicianId rdf:type rdf:Property ;
    rdfs:label 'Approving Clinician Id' ;
    rdfs:comment 'FK to provider.clinician' ;
    rdfs:domain ind:Protocol ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:createdByEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Created By Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: Imaging protocols authored by radiologists or medical physicists require creator tracking for audit trail, version control, and regulatory compliance. Distinct from approving_clinician_id which captur' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:parentProtocolId rdf:type rdf:Property ;
    rdfs:label 'Parent Protocol Id' ;
    rdfs:comment 'Reference to the imaging_protocol_id of the parent protocol from which this protocol was derived or branched (e.g., a pediatric variant derived from an adult protocol). Supports protocol hierarchy and variant management within the Radiant protocol library.' ;
    rdfs:domain ind:Protocol ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Protocol .

ind:primarySupersededByProtocolId rdf:type rdf:Property ;
    rdfs:label 'Primary Superseded By Protocol Id' ;
    rdfs:comment 'Reference to the imaging_protocol_id of the newer protocol version that replaced this one upon retirement. Enables forward navigation through protocol version history and ensures continuity of care documentation.' ;
    rdfs:domain ind:Protocol ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Protocol .

ind:acrAppropriatenessRating rdf:type rdf:Property ;
    rdfs:label 'Acr Appropriateness Rating' ;
    rdfs:comment 'American College of Radiology (ACR) Appropriateness Criteria rating for this protocol-indication combination. Used for clinical decision support, prior authorization, and CMS Appropriate Use Criteria (AUC) compliance reporting under PAMA.' ;
    rdfs:domain ind:Protocol ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvingRadiologistNpi rdf:type rdf:Property ;
    rdfs:label 'Approving Radiologist Npi' ;
    rdfs:comment 'National Provider Identifier (NPI) of the radiologist who reviewed and approved this protocol version. Ensures accountability for clinical protocol governance and supports credentialing verification. Links to provider registry.' ;
    rdfs:domain ind:Protocol ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:protocolCategory rdf:type rdf:Property ;
    rdfs:label 'Protocol Category' ;
    rdfs:comment 'Clinical category classifying the purpose of this imaging protocol. \'diagnostic\' for standard clinical workup, \'screening\' for population health programs (e.g., lung cancer screening), \'interventional\' for image-guided procedures, \'research\' for IRB-approved studies, \'emergency\' for ED/trauma protocols, \'pediatric\' for age-specific protocols.' ;
    rdfs:domain ind:Protocol ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contrastDoseMl rdf:type rdf:Property ;
    rdfs:label 'Contrast Dose Ml' ;
    rdfs:comment 'Standard contrast agent dose in milliliters specified for this protocol. May be weight-based (documented separately in patient preparation instructions) or fixed volume. Used for pharmacy preparation and contrast utilization tracking.' ;
    rdfs:domain ind:Protocol ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contrastFlowRateMlPerSec rdf:type rdf:Property ;
    rdfs:label 'Contrast Flow Rate Ml Per Sec' ;
    rdfs:comment 'Injection flow rate for intravenous contrast in milliliters per second as specified in the protocol. Critical for CT angiography and dynamic phase imaging to achieve optimal vascular enhancement. Null for non-IV contrast protocols.' ;
    rdfs:domain ind:Protocol ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contrastRoute rdf:type rdf:Property ;
    rdfs:label 'Contrast Route' ;
    rdfs:comment 'Route of administration for the contrast agent specified in this protocol (e.g., intravenous for CT angiography, oral for GI studies, intrathecal for myelography). Drives nursing preparation and patient consent requirements.' ;
    rdfs:domain ind:Protocol ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:doseOptimizationProgram rdf:type rdf:Property ;
    rdfs:label 'Dose Optimization Program' ;
    rdfs:comment 'Radiation dose optimization program under which this protocol was designed or benchmarked. \'image_gently\' for pediatric dose reduction, \'image_wisely\' for adult dose reduction, \'acr_dir\' for ACR Dose Index Registry benchmarking. Supports regulatory reporting and quality improvement programs.' ;
    rdfs:domain ind:Protocol ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fastingDurationHours rdf:type rdf:Property ;
    rdfs:label 'Fasting Duration Hours' ;
    rdfs:comment 'Required fasting duration in hours prior to the examination when fasting_required is True (e.g., 4 hours for contrast CT, 6 hours for PET-CT). Null when fasting is not required.' ;
    rdfs:domain ind:Protocol ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fieldOfViewMm rdf:type rdf:Property ;
    rdfs:label 'Field Of View Mm' ;
    rdfs:comment 'Field of view in millimeters defining the anatomical coverage area for image reconstruction. Determines spatial resolution and the extent of anatomy captured in the image matrix. Applicable to CT and MRI protocols.' ;
    rdfs:domain ind:Protocol ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:implantScreeningRequired rdf:type rdf:Property ;
    rdfs:label 'Implant Screening Required' ;
    rdfs:comment 'Indicates whether MRI implant safety screening is required before performing this protocol. True = screening required (applicable to all MRI protocols); False = not required. Drives pre-procedure safety questionnaire workflows to identify contraindicated implants, pacemakers, or metallic foreign bodies.' ;
    rdfs:domain ind:Protocol ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:magneticFieldStrengthTesla rdf:type rdf:Property ;
    rdfs:label 'Magnetic Field Strength Tesla' ;
    rdfs:comment 'Magnetic field strength in Tesla for MRI protocols (e.g., 1.5T, 3.0T, 7.0T). Determines scanner compatibility, image quality characteristics, and specific absorption rate (SAR) limits. Null for non-MRI modalities.' ;
    rdfs:domain ind:Protocol ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mas rdf:type rdf:Property ;
    rdfs:label 'Mas' ;
    rdfs:comment 'Milliampere-seconds (mAs) setting specifying the X-ray tube current-time product for this protocol. Directly influences image noise and patient radiation dose. Used in CT and radiography protocols. Null for MRI and ultrasound.' ;
    rdfs:domain ind:Protocol ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pacsRoutingCode rdf:type rdf:Property ;
    rdfs:label 'Pacs Routing Code' ;
    rdfs:comment 'Code used to route completed images to the correct reading worklist, hanging protocol, and storage location within the Picture Archiving and Communication System (PACS). Ensures images are delivered to the appropriate radiologist subspecialty queue for interpretation.' ;
    rdfs:domain ind:Protocol ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:patientPrepInstructions rdf:type rdf:Property ;
    rdfs:label 'Patient Prep Instructions' ;
    rdfs:comment 'Standardized patient preparation instructions for this protocol, including fasting requirements (e.g., NPO 4 hours), hydration instructions, medication holds (e.g., hold Metformin for contrast studies), bowel preparation, and breath-hold coaching. Displayed to scheduling staff and communicated to patients prior to the exam.' ;
    rdfs:domain ind:Protocol ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pitchFactor rdf:type rdf:Property ;
    rdfs:label 'Pitch Factor' ;
    rdfs:comment 'Helical pitch factor for CT protocols, defined as table feed per rotation divided by total collimation. Values less than 1.0 indicate overlapping acquisitions (higher dose, better quality); values greater than 1.0 indicate faster coverage with lower dose. Null for non-helical CT and other modalities.' ;
    rdfs:domain ind:Protocol ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:protocolStatus rdf:type rdf:Property ;
    rdfs:label 'Protocol Status' ;
    rdfs:comment 'Current lifecycle status of the imaging protocol. \'active\' indicates the protocol is approved and available for use; \'draft\' indicates pending approval; \'retired\' indicates superseded by a newer version; \'under_review\' indicates undergoing clinical review.' ;
    rdfs:domain ind:Protocol ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pulseSequenceType rdf:type rdf:Property ;
    rdfs:label 'Pulse Sequence Type' ;
    rdfs:comment 'MRI pulse sequence type used in this protocol (e.g., \'T1 SE\', \'T2 FSE\', \'FLAIR\', \'DWI\', \'GRE\', \'SSFP\', \'EPI\'). Defines the fundamental MRI acquisition technique and determines tissue contrast characteristics. Null for non-MRI modalities.' ;
    rdfs:domain ind:Protocol ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:radiationDoseCtdiVolMgy rdf:type rdf:Property ;
    rdfs:label 'Radiation Dose Ctdi Vol Mgy' ;
    rdfs:comment 'Reference CT Dose Index Volume (CTDIvol) in milligray representing the average radiation dose within the scan volume for this CT protocol. Standardized metric for comparing dose across CT scanners and protocols. Reported to ACR Dose Index Registry and used for DRL benchmarking.' ;
    rdfs:domain ind:Protocol ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:radiationDoseDlpMgyCm rdf:type rdf:Property ;
    rdfs:label 'Radiation Dose Dlp Mgy Cm' ;
    rdfs:comment 'Reference Dose Length Product (DLP) in milligray-centimeters representing the expected radiation dose for this CT protocol under standard conditions. Used for radiation dose optimization programs, comparison against Diagnostic Reference Levels (DRLs), and regulatory reporting to CMS and ACR Dose Index Registry.' ;
    rdfs:domain ind:Protocol ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:radlexCode rdf:type rdf:Property ;
    rdfs:label 'Radlex Code' ;
    rdfs:comment 'RSNA RadLex ontology code for the imaging procedure or anatomy associated with this protocol (e.g., RID10321 for CT of abdomen). Supports standardized terminology in radiology reporting, PACS integration, and research data aggregation.' ;
    rdfs:domain ind:Radiology ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reconstructionAlgorithm rdf:type rdf:Property ;
    rdfs:label 'Reconstruction Algorithm' ;
    rdfs:comment 'Image reconstruction algorithm specified for this protocol (e.g., \'Filtered Back Projection\', \'Iterative Reconstruction\', \'Deep Learning Reconstruction\', \'ASIR-V 40%\'). Affects image quality, noise characteristics, and radiation dose efficiency. Vendor-specific algorithm names are stored as-is.' ;
    rdfs:domain ind:Protocol ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:renalFunctionCheckRequired rdf:type rdf:Property ;
    rdfs:label 'Renal Function Check Required' ;
    rdfs:comment 'Indicates whether pre-procedure renal function assessment (eGFR/creatinine) is required before administering contrast for this protocol. True = renal check required (standard for iodinated and gadolinium contrast protocols); False = not required. Drives lab order triggers in Epic Radiant.' ;
    rdfs:domain ind:Protocol ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:risProcedureCode rdf:type rdf:Property ;
    rdfs:label 'Ris Procedure Code' ;
    rdfs:comment 'Internal procedure code assigned to this protocol within the Radiology Information System (RIS), such as Epic Radiant or Cerner RadNet. Used for order entry mapping, scheduling, and charge capture integration with the CDM.' ;
    rdfs:domain ind:Protocol ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scanDurationEstimateSec rdf:type rdf:Property ;
    rdfs:label 'Scan Duration Estimate Sec' ;
    rdfs:comment 'Estimated acquisition time in seconds for this protocol under standard conditions. Used for scheduling slot allocation in the RIS, patient throughput planning, and breath-hold instruction timing for chest and abdominal studies.' ;
    rdfs:domain ind:Protocol ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sedationRequired rdf:type rdf:Property ;
    rdfs:label 'Sedation Required' ;
    rdfs:comment 'Indicates whether procedural sedation or anesthesia is required or commonly needed for this protocol (e.g., pediatric MRI, claustrophobic patients). True = sedation required; False = no sedation required. Triggers anesthesia scheduling and pre-sedation assessment workflows.' ;
    rdfs:domain ind:Protocol ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:totalExamDurationMin rdf:type rdf:Property ;
    rdfs:label 'Total Exam Duration Min' ;
    rdfs:comment 'Total estimated examination time in minutes including patient preparation, positioning, scanning, and post-processing. Used for scheduling block allocation in the RIS and patient appointment communication. Distinct from scan_duration_estimate_sec which covers acquisition only.' ;
    rdfs:domain ind:Protocol ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:contrastAdminId rdf:type rdf:Property ;
    rdfs:label 'Contrast Admin Id' ;
    rdfs:comment 'Primary key for contrast_admin' ;
    rdfs:domain ind:ContrastAdmin ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:administeringClinicianId rdf:type rdf:Property ;
    rdfs:label 'Administering Clinician Id' ;
    rdfs:comment 'Reference to the clinician (nurse, radiologic technologist, or radiologist) who administered the contrast agent. Used for accountability and adverse event tracking.' ;
    rdfs:domain ind:ContrastAdmin ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:administeredTimestamp rdf:type rdf:Property ;
    rdfs:label 'Administered Timestamp' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:administeringClinicianNpi rdf:type rdf:Property ;
    rdfs:label 'Administering Clinician Npi' ;
    rdfs:comment 'The 10-digit National Provider Identifier (NPI) of the clinician who administered the contrast agent. Required for regulatory reporting, billing, and provider accountability tracking.' ;
    rdfs:domain ind:ContrastAdmin ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:administrationDatetime rdf:type rdf:Property ;
    rdfs:label 'Administration Datetime' ;
    rdfs:comment 'The precise date and time at which the contrast agent was administered to the patient. This is the principal real-world event timestamp for this transaction, distinct from record audit timestamps.' ;
    rdfs:domain ind:ContrastAdmin ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:adverseReactionDatetime rdf:type rdf:Property ;
    rdfs:label 'Adverse Reaction Datetime' ;
    rdfs:comment 'The date and time at which the adverse reaction was first observed following contrast administration. Used to calculate time-to-reaction interval for safety analytics.' ;
    rdfs:domain ind:ContrastAdmin ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:adverseReactionDescription rdf:type rdf:Property ;
    rdfs:label 'Adverse Reaction Description' ;
    rdfs:comment 'Detailed clinical description of the adverse reaction signs and symptoms observed following contrast administration (e.g., \'urticaria on trunk and arms, resolved with diphenhydramine\'). Required for FDA MedWatch and internal safety reporting.' ;
    rdfs:domain ind:ContrastAdmin ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:adverseReactionOccurred rdf:type rdf:Property ;
    rdfs:label 'Adverse Reaction Occurred' ;
    rdfs:comment 'Indicates whether the patient experienced an adverse reaction following contrast administration (True = reaction occurred, False = no reaction). Triggers mandatory documentation and reporting workflows.' ;
    rdfs:domain ind:ContrastAdmin ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:adverseReactionSeverity rdf:type rdf:Property ;
    rdfs:label 'Adverse Reaction Severity' ;
    rdfs:comment 'Severity classification of the adverse reaction experienced by the patient following contrast administration, per ACR grading criteria. Drives escalation protocols and mandatory reporting thresholds.' ;
    rdfs:domain ind:ContrastAdmin ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:adverseReactionTreatment rdf:type rdf:Property ;
    rdfs:label 'Adverse Reaction Treatment' ;
    rdfs:comment 'Description of the clinical interventions performed to treat the adverse contrast reaction (e.g., \'epinephrine 0.3mg IM, oxygen 4L/min via nasal cannula, IV fluid bolus\'). Supports quality review and safety reporting.' ;
    rdfs:domain ind:ContrastAdmin ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agentClass rdf:type rdf:Property ;
    rdfs:label 'Agent Class' ;
    rdfs:comment 'Classification of the contrast agent by chemical class. Drives safety screening protocols (e.g., gadolinium retention monitoring, iodine allergy screening) and ACR guideline compliance.' ;
    rdfs:domain ind:ContrastAdmin ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agentOsmolalityType rdf:type rdf:Property ;
    rdfs:label 'Agent Osmolality Type' ;
    rdfs:comment 'Osmolality classification of the iodinated contrast agent (low, iso, or high osmolality). Relevant for patient safety risk stratification, particularly in patients with renal impairment.' ;
    rdfs:domain ind:ContrastAdmin ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bodyRegion rdf:type rdf:Property ;
    rdfs:label 'Body Region' ;
    rdfs:comment 'The anatomical body region being imaged (e.g., abdomen/pelvis, brain, chest, spine). Used for contrast protocol selection and population health analytics.' ;
    rdfs:domain ind:Radiology ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:catheterGauge rdf:type rdf:Property ;
    rdfs:label 'Catheter Gauge' ;
    rdfs:comment 'The gauge size of the intravenous catheter used for contrast injection (e.g., 18G, 20G, 22G). Relevant for power injector safety limits and extravasation risk assessment.' ;
    rdfs:domain ind:ContrastAdmin ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:concentrationMgPerMl rdf:type rdf:Property ;
    rdfs:label 'Concentration Mg Per Ml' ;
    rdfs:comment 'The concentration of the contrast agent in the administered preparation, expressed in milligrams per milliliter (mg/mL). Used to verify dose calculations and product selection.' ;
    rdfs:domain ind:ContrastAdmin ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contrastAllergyScreeningResult rdf:type rdf:Property ;
    rdfs:label 'Contrast Allergy Screening Result' ;
    rdfs:comment 'The result of the pre-administration contrast allergy screening assessment. Captures whether the patient has a documented prior contrast reaction, confirmed allergy, or no known allergy. Drives pre-medication decision.' ;
    rdfs:domain ind:ContrastAdmin ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contrastProtocolName rdf:type rdf:Property ;
    rdfs:label 'Contrast Protocol Name' ;
    rdfs:comment 'The name of the institutional contrast administration protocol followed (e.g., \'CT Abdomen Pelvis with IV Contrast — Standard Adult\'). Supports protocol compliance auditing and quality improvement.' ;
    rdfs:domain ind:ContrastAdmin ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:doseAmountMg rdf:type rdf:Property ;
    rdfs:label 'Dose Amount Mg' ;
    rdfs:comment 'The total mass of contrast agent administered, measured in milligrams (mg). Supports weight-based dosing verification and cumulative gadolinium/iodine exposure tracking.' ;
    rdfs:domain ind:ContrastAdmin ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:doseMl rdf:type rdf:Property ;
    rdfs:label 'Dose Ml' ;
    rdfs:domain ind:ContrastAdmin ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:doseVolumeMl rdf:type rdf:Property ;
    rdfs:label 'Dose Volume Ml' ;
    rdfs:comment 'The total volume of contrast agent administered, measured in milliliters (mL). Used for dose tracking, pharmacy reconciliation, and radiation/contrast safety monitoring.' ;
    rdfs:domain ind:ContrastAdmin ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:extravasationOccurred rdf:type rdf:Property ;
    rdfs:label 'Extravasation Occurred' ;
    rdfs:comment 'Indicates whether contrast agent extravasation (leakage into surrounding tissue) occurred during injection (True = extravasation, False = no extravasation). Triggers wound care and incident reporting protocols.' ;
    rdfs:domain ind:ContrastAdmin ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:extravasationVolumeMl rdf:type rdf:Property ;
    rdfs:label 'Extravasation Volume Ml' ;
    rdfs:comment 'Estimated volume of contrast agent that extravasated into surrounding tissue, in milliliters (mL). Used to guide clinical management and severity classification of the extravasation event.' ;
    rdfs:domain ind:ContrastAdmin ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:informedConsentObtained rdf:type rdf:Property ;
    rdfs:label 'Informed Consent Obtained' ;
    rdfs:comment 'Indicates whether informed consent was obtained from the patient prior to contrast administration (True = consent obtained, False = consent not obtained or waived). Required for regulatory compliance and risk management.' ;
    rdfs:domain ind:ContrastAdmin ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:injectionRateMlPerSec rdf:type rdf:Property ;
    rdfs:label 'Injection Rate Ml Per Sec' ;
    rdfs:comment 'The rate at which the contrast agent was injected, expressed in milliliters per second (mL/sec). Relevant for CT bolus timing, power injector programming, and adverse event analysis.' ;
    rdfs:domain ind:ContrastAdmin ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:injectionSite rdf:type rdf:Property ;
    rdfs:label 'Injection Site' ;
    rdfs:comment 'The anatomical site of contrast injection (e.g., right antecubital vein, left hand dorsal vein, lumbar intrathecal space). Supports extravasation tracking and adverse event documentation.' ;
    rdfs:domain ind:ContrastAdmin ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:metforminHeld rdf:type rdf:Property ;
    rdfs:label 'Metformin Held' ;
    rdfs:comment 'Indicates whether metformin was held prior to or following contrast administration per ACR guidelines for patients with renal impairment (True = metformin held, False = not held or not applicable).' ;
    rdfs:domain ind:ContrastAdmin ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:powerInjectorUsed rdf:type rdf:Property ;
    rdfs:label 'Power Injector Used' ;
    rdfs:comment 'Indicates whether a power injector device was used to administer the contrast agent (True) or manual hand injection was performed (False). Relevant for injection rate documentation and device safety tracking.' ;
    rdfs:domain ind:ContrastAdmin ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:premedicationDetails rdf:type rdf:Property ;
    rdfs:label 'Premedication Details' ;
    rdfs:comment 'Free-text or structured description of the pre-medication regimen administered (e.g., \'Prednisone 50mg PO x3 doses + Diphenhydramine 50mg IV\'). Supports clinical documentation and pharmacy reconciliation.' ;
    rdfs:domain ind:ContrastAdmin ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:premedicationGiven rdf:type rdf:Property ;
    rdfs:label 'Premedication Given' ;
    rdfs:comment 'Indicates whether pre-medication (e.g., corticosteroid prophylaxis) was administered prior to contrast injection to reduce the risk of allergic reaction (True = pre-medicated, False = not pre-medicated).' ;
    rdfs:domain ind:ContrastAdmin ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:priorContrastReactionType rdf:type rdf:Property ;
    rdfs:label 'Prior Contrast Reaction Type' ;
    rdfs:comment 'Description of the type of prior contrast reaction documented in the patient\'s allergy history (e.g., urticaria, bronchospasm, anaphylaxis). Informs pre-medication protocol selection.' ;
    rdfs:domain ind:ContrastAdmin ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:thyroidDiseaseFlag rdf:type rdf:Property ;
    rdfs:label 'Thyroid Disease Flag' ;
    rdfs:comment 'Indicates whether the patient has a documented thyroid condition (e.g., hyperthyroidism, thyroid cancer) that may be relevant to iodinated contrast administration safety screening.' ;
    rdfs:domain ind:ContrastAdmin ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:doseRecordId rdf:type rdf:Property ;
    rdfs:label 'Dose Record Id' ;
    rdfs:comment 'Primary key for dose_record' ;
    rdfs:domain ind:DoseRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:oshaSafetyProgramId rdf:type rdf:Property ;
    rdfs:label 'Osha Safety Program Id' ;
    rdfs:comment 'Foreign key linking to compliance.osha_safety_program. Business justification: Dose records support OSHA radiation safety programs by documenting employee and patient exposure levels. Safety programs monitor cumulative dose data to ensure compliance with occupational exposure li' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:OshaSafetyProgram .

ind:primaryDoseClinicianId rdf:type rdf:Property ;
    rdfs:label 'Primary Dose Clinician Id' ;
    rdfs:comment 'Reference to the clinician who ordered the imaging study. Used for utilization management, appropriateness criteria reporting, and CMS quality program compliance.' ;
    rdfs:domain ind:DoseRecord ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:publicHealthReportId rdf:type rdf:Property ;
    rdfs:label 'Public Health Report Id' ;
    rdfs:comment 'Foreign key linking to interoperability.public_health_report. Business justification: Radiation dose records are submitted to state dose registries and ACR Dose Index Registry for public health surveillance and dose optimization programs. Links dose record to its public health submissi' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PublicHealthReport .

ind:reviewingPhysicistEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Reviewing Physicist Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: Radiation dose records require medical physicist review for quality assurance and regulatory compliance (ACR, state regulations). Physicists may not have clinician_id if non-provider staff.' ;
    rdfs:domain ind:DoseRecord ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:contrastAdministered rdf:type rdf:Property ;
    rdfs:label 'Contrast Administered' ;
    rdfs:comment 'Indicates whether iodinated or gadolinium-based contrast agent was administered during the imaging study. True = contrast used; False = non-contrast study. Relevant for dose context, adverse event tracking, and clinical protocol classification.' ;
    rdfs:domain ind:Radiology ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:contrastAgentType rdf:type rdf:Property ;
    rdfs:label 'Contrast Agent Type' ;
    rdfs:comment 'Type of contrast agent administered during the imaging study. \'iodinated\'=CT/X-ray contrast; \'gadolinium\'=MRI contrast (tracked for nephrogenic systemic fibrosis risk); \'barium\'=GI fluoroscopy; \'none\'=no contrast. Used for clinical safety monitoring and protocol classification.' ;
    rdfs:domain ind:DoseRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ctdivolMgy rdf:type rdf:Property ;
    rdfs:label 'Ctdivol Mgy' ;
    rdfs:comment 'Volume CT Dose Index (CTDIvol) in milligray (mGy) for CT studies. Represents the average radiation dose delivered within the scan volume for a single series or the entire study. Primary CT dose metric for ACR DIR benchmarking and dose alert thresholds per NCRP and FDA guidance.' ;
    rdfs:domain ind:DoseRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cumulativeDoseMsv rdf:type rdf:Property ;
    rdfs:label 'Cumulative Dose Msv' ;
    rdfs:comment 'Running cumulative effective dose in millisieverts (mSv) for this patient across all prior ionizing radiation imaging studies recorded in the system, including the current study. Supports ALARA principle compliance, radiation safety counseling, and identification of high-dose patients for clinical review.' ;
    rdfs:domain ind:DoseRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dapGyCm2 rdf:type rdf:Property ;
    rdfs:label 'Dap Gy Cm2' ;
    rdfs:comment 'Dose Area Product (DAP) in Gy·cm² for fluoroscopy, X-ray angiography, and interventional radiology procedures. Measures total radiation energy delivered to the patient. Primary dose metric for fluoroscopic procedures per IEC 60601-2-43.' ;
    rdfs:domain ind:DoseRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:doseAlertFlag rdf:type rdf:Property ;
    rdfs:label 'Dose Alert Flag' ;
    rdfs:comment 'Indicates whether this study triggered a radiation dose alert based on institutional or regulatory thresholds (e.g., CTDIvol > alert level, fluoroscopy time > 30 min, RAK > 3 Gy). True = alert triggered; False = within normal limits. Supports Joint Commission radiation safety event reporting.' ;
    rdfs:domain ind:DoseRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:doseAlertThresholdType rdf:type rdf:Property ;
    rdfs:label 'Dose Alert Threshold Type' ;
    rdfs:comment 'The specific dose metric that triggered the dose alert, if applicable. Identifies which threshold was exceeded to support targeted clinical review and root cause analysis. \'not_triggered\' when dose_alert_flag is False. [ENUM-REF-CANDIDATE: ctdivol|dlp|dap|fluoroscopy_time|rak|effective_dose|not_triggered — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:DoseRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:doseAlertValue rdf:type rdf:Property ;
    rdfs:label 'Dose Alert Value' ;
    rdfs:comment 'The numeric threshold value that was exceeded to trigger the dose alert, expressed in the unit of the triggering metric (mGy, mGy·cm, Gy·cm², seconds, or mSv). Supports audit trail for dose safety events.' ;
    rdfs:domain ind:DoseRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:doseRecordStatus rdf:type rdf:Property ;
    rdfs:label 'Dose Record Status' ;
    rdfs:comment 'Current lifecycle status of the radiation dose record. \'preliminary\' = dose data received but not yet reviewed; \'final\' = reviewed and confirmed; \'amended\' = corrected after finalization; \'corrected\' = technical correction applied; \'cancelled\' = study voided.' ;
    rdfs:domain ind:DoseRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:doseRegistrySubmissionStatus rdf:type rdf:Property ;
    rdfs:label 'Dose Registry Submission Status' ;
    rdfs:comment 'Status of submission of this dose record to the ACR Dose Index Registry (DIR). \'pending\'=queued for submission; \'submitted\'=transmitted to ACR DIR; \'accepted\'=confirmed by ACR DIR; \'rejected\'=rejected by ACR DIR (requires correction); \'not_required\'=procedure not in DIR scope.' ;
    rdfs:domain ind:DoseRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:doseRegistrySubmissionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Dose Registry Submission Timestamp' ;
    rdfs:comment 'Date and time when this dose record was submitted to the ACR Dose Index Registry (DIR) or other regulatory dose registry. Supports audit trail for regulatory compliance and CMS quality program reporting.' ;
    rdfs:domain ind:DoseRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:drlComparisonResult rdf:type rdf:Property ;
    rdfs:label 'Drl Comparison Result' ;
    rdfs:comment 'Result of comparing the study dose against the applicable national or institutional Diagnostic Reference Level (DRL). \'below_drl\'=dose is below the reference level (optimal); \'at_drl\'=dose equals reference level; \'above_drl\'=dose exceeds reference level (requires review); \'not_applicable\'=no DRL defined for this procedure.' ;
    rdfs:domain ind:DoseRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:effectiveDoseMsv rdf:type rdf:Property ;
    rdfs:label 'Effective Dose Msv' ;
    rdfs:comment 'Estimated effective dose in millisieverts (mSv) representing the stochastic risk-weighted whole-body equivalent dose. Derived from DLP × conversion coefficient (k-factor) for CT, or from DAP for fluoroscopy. Used for patient communication, cumulative dose tracking, and ALARA compliance.' ;
    rdfs:domain ind:DoseRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:entranceSkinDoseMgy rdf:type rdf:Property ;
    rdfs:label 'Entrance Skin Dose Mgy' ;
    rdfs:comment 'Entrance skin dose (ESD) in milligray (mGy) for radiographic and fluoroscopic procedures. Represents the absorbed dose at the skin entry point. Critical for radiation injury risk assessment and Joint Commission threshold monitoring.' ;
    rdfs:domain ind:DoseRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:exceedsReferenceLevelFlag rdf:type rdf:Property ;
    rdfs:label 'Exceeds Reference Level Flag' ;
    rdfs:domain ind:DoseRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fluoroscopyTimeSec rdf:type rdf:Property ;
    rdfs:label 'Fluoroscopy Time Sec' ;
    rdfs:comment 'Total fluoroscopy beam-on time in seconds for fluoroscopic and interventional procedures. Regulatory threshold monitoring metric; Joint Commission requires tracking and alerting when fluoroscopy time exceeds defined thresholds (e.g., 30 minutes cumulative).' ;
    rdfs:domain ind:Radiology ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:numberOfExposures rdf:type rdf:Property ;
    rdfs:label 'Number Of Exposures' ;
    rdfs:comment 'Total count of individual X-ray exposures (radiographic frames or pulses) delivered during the study. Used for dose optimization analysis and comparison against diagnostic reference levels (DRLs).' ;
    rdfs:domain ind:DoseRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:patientAgeAtStudy rdf:type rdf:Property ;
    rdfs:label 'Patient Age At Study' ;
    rdfs:comment 'Patient age in whole years at the time of the imaging study. Used for pediatric dose benchmarking (pediatric patients require lower dose protocols), age-stratified DRL comparisons, and ACR DIR age-group reporting. Derived at time of study to avoid recalculation.' ;
    rdfs:domain ind:DoseRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:patientSizeCm rdf:type rdf:Property ;
    rdfs:label 'Patient Size Cm' ;
    rdfs:comment 'Patient effective diameter or water-equivalent diameter in centimeters, used for Size-Specific Dose Estimate (SSDE) calculation in CT. Derived from scout/localizer images or patient measurements. Required for AAPM TG-204 SSDE methodology.' ;
    rdfs:domain ind:DoseRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:physicistReviewFlag rdf:type rdf:Property ;
    rdfs:label 'Physicist Review Flag' ;
    rdfs:comment 'Indicates whether this dose record has been flagged for or completed a review by a qualified medical physicist. True = physicist review required or completed; False = no physicist review needed. Triggered by dose alerts, unusual protocol deviations, or regulatory requirements.' ;
    rdfs:domain ind:DoseRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:physicistReviewTimestamp rdf:type rdf:Property ;
    rdfs:label 'Physicist Review Timestamp' ;
    rdfs:comment 'Date and time when the medical physicist completed the review of this dose record. Null if physicist_review_flag is False or review is pending. Supports compliance audit trail for Joint Commission radiation safety requirements.' ;
    rdfs:domain ind:DoseRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:rdsrUid rdf:type rdf:Property ;
    rdfs:label 'Rdsr Uid' ;
    rdfs:comment 'DICOM Radiation Dose Structured Report (RDSR) SOP Instance UID per IEC 61910 standard. Globally unique identifier for the structured dose report generated by the imaging modality. Used for PACS integration and ACR Dose Index Registry (DIR) submission.' ;
    rdfs:domain ind:DoseRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referenceAirKermaMgy rdf:type rdf:Property ;
    rdfs:label 'Reference Air Kerma Mgy' ;
    rdfs:comment 'Reference Air Kerma (RAK) in mGy for interventional fluoroscopy procedures. Measured at the interventional reference point (IRP) per IEC 60601-2-43. Used for radiation injury risk assessment and regulatory threshold compliance.' ;
    rdfs:domain ind:DoseRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scannerManufacturer rdf:type rdf:Property ;
    rdfs:label 'Scanner Manufacturer' ;
    rdfs:comment 'Manufacturer of the imaging equipment used for the study (e.g., Siemens, GE Healthcare, Philips, Canon). Used for equipment-level dose benchmarking, physics QA, and ACR DIR equipment stratification.' ;
    rdfs:domain ind:DoseRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scannerModel rdf:type rdf:Property ;
    rdfs:label 'Scanner Model' ;
    rdfs:comment 'Model name of the imaging equipment used (e.g., \'SOMATOM Force\', \'Revolution CT\', \'Ingenuity Elite\'). Used for equipment-specific dose performance tracking and physics quality assurance.' ;
    rdfs:domain ind:DoseRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scannerStationName rdf:type rdf:Property ;
    rdfs:label 'Scanner Station Name' ;
    rdfs:comment 'DICOM station name or AE title of the imaging modality that generated the dose data. Used for equipment-level dose tracking, PACS routing, and physics QA within a multi-scanner facility.' ;
    rdfs:domain ind:DoseRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ssdeMgy rdf:type rdf:Property ;
    rdfs:label 'Ssde Mgy' ;
    rdfs:comment 'Size-Specific Dose Estimate (SSDE) in mGy for CT studies, calculated per AAPM TG-204 methodology by applying a size-based conversion factor to CTDIvol. Provides a more accurate patient-specific dose estimate than CTDIvol alone. Used for pediatric dose optimization and ACR DIR advanced reporting.' ;
    rdfs:domain ind:DoseRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:studyInstanceUid rdf:type rdf:Property ;
    rdfs:label 'Study Instance Uid' ;
    rdfs:comment 'DICOM Study Instance UID uniquely identifying the imaging study in the PACS (Picture Archiving and Communication System). Enables direct linkage between dose records and DICOM image metadata for audit and regulatory reporting.' ;
    rdfs:domain ind:Radiology ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:studyTimestamp rdf:type rdf:Property ;
    rdfs:label 'Study Timestamp' ;
    rdfs:comment 'Precise date and time the imaging study was performed, including timezone offset. Used for intraday workflow analysis, dose alert timing, and RDSR correlation.' ;
    rdfs:domain ind:DoseRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:tubeCurrentMas rdf:type rdf:Property ;
    rdfs:label 'Tube Current Mas' ;
    rdfs:comment 'X-ray tube current-time product in milliampere-seconds (mAs) for the study. Directly influences radiation dose output. Used for protocol optimization and dose benchmarking.' ;
    rdfs:domain ind:DoseRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:radiologyAppointmentId rdf:type rdf:Property ;
    rdfs:label 'Radiology Appointment Id' ;
    rdfs:comment 'Primary key for appointment' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RadiologyAppointment .

ind:administeredMaterialMasterId rdf:type rdf:Property ;
    rdfs:label 'Administered Material Master Id' ;
    rdfs:comment 'Link to material/supply administered during appointment' ;
    rdfs:domain ind:RadiologyAppointment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MaterialMaster .

ind:appointmentTypeId rdf:type rdf:Property ;
    rdfs:label 'Appointment Type Id' ;
    rdfs:comment 'Type of appointment (office visit, procedure, etc)' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AppointmentType .

ind:eligibilityId rdf:type rdf:Property ;
    rdfs:label 'Eligibility Id' ;
    rdfs:comment 'Insurance eligibility verification' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Eligibility .

ind:primaryRadiologyClinicianId rdf:type rdf:Property ;
    rdfs:label 'Primary Radiology Clinician Id' ;
    rdfs:comment 'Reference to the clinician who placed the imaging order that generated this appointment. Used for referral tracking, utilization management, and RVU attribution.' ;
    rdfs:domain ind:RadiologyAppointment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:radiologyClinicianId rdf:type rdf:Property ;
    rdfs:label 'Radiology Clinician Id' ;
    rdfs:comment 'Primary clinician for the appointment' ;
    rdfs:domain ind:Radiology ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:radiologyIcd10DiagnosisIcdCodeId rdf:type rdf:Property ;
    rdfs:label 'Radiology Icd10 Diagnosis Icd Code Id' ;
    rdfs:comment 'Foreign key linking to reference.icd_code. Business justification: Appointments carry diagnosis codes for prior authorization verification at scheduling time, support medical necessity screening, and enable diagnosis-based appointment prioritization for urgent condit' ;
    rdfs:domain ind:RadiologyAppointment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:IcdCode .

ind:radiologyModalityRoomId rdf:type rdf:Property ;
    rdfs:label 'Radiology Modality Room Id' ;
    rdfs:comment 'Reference to the specific imaging room or scanner unit assigned for this appointment. Enables room-level utilization tracking, maintenance scheduling, and capacity management.' ;
    rdfs:domain ind:RadiologyAppointment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Room .

ind:radiologyRoomId rdf:type rdf:Property ;
    rdfs:label 'Radiology Room Id' ;
    rdfs:comment 'Room assigned for appointment' ;
    rdfs:domain ind:RadiologyAppointment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Room .

ind:radiologyVisitReasonIcdCodeId rdf:type rdf:Property ;
    rdfs:label 'Radiology Visit Reason Icd Code Id' ;
    rdfs:comment 'ICD code for visit reason' ;
    rdfs:domain ind:RadiologyAppointment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:IcdCode .

ind:tertiaryRadiologyReferringProviderClinicianId rdf:type rdf:Property ;
    rdfs:label 'Tertiary Radiology Referring Provider Clinician Id' ;
    rdfs:comment 'Reference to the provider who referred the patient for this imaging study, which may differ from the ordering provider. Used for referral analytics, network management, and payer reporting.' ;
    rdfs:domain ind:RadiologyAppointment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:workforceOrgUnitId rdf:type rdf:Property ;
    rdfs:label 'Workforce Org Unit Id' ;
    rdfs:comment 'Organizational unit responsible for appointment' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:OrgUnit .

ind:actualEndDatetime rdf:type rdf:Property ;
    rdfs:label 'Actual End Datetime' ;
    rdfs:comment 'The actual date and time the imaging procedure concluded. Combined with actual_start_datetime to compute actual procedure duration for throughput and capacity analytics.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:actualStartDatetime rdf:type rdf:Property ;
    rdfs:label 'Actual Start Datetime' ;
    rdfs:comment 'The actual date and time the imaging procedure began (patient on table / scan initiated). Used to measure schedule adherence, wait times, and operational efficiency.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:appointmentComment rdf:type rdf:Property ;
    rdfs:label 'Appointment Comment' ;
    rdfs:comment 'Free-text clinical or operational notes associated with the imaging appointment (e.g., special patient needs, equipment requirements, interpreter needed, claustrophobia notes for MRI). Not intended for clinical documentation.' ;
    rdfs:domain ind:RadiologyAppointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appointmentDomain rdf:type rdf:Property ;
    rdfs:label 'Appointment Domain' ;
    rdfs:comment 'Domain discriminator: RADIOLOGY or SCHEDULING' ;
    rdfs:domain ind:RadiologyAppointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appointmentNumber rdf:type rdf:Property ;
    rdfs:label 'Appointment Number' ;
    rdfs:comment 'Human-readable appointment identifier' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appointmentScope rdf:type rdf:Property ;
    rdfs:label 'Appointment Scope' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appointmentStatus rdf:type rdf:Property ;
    rdfs:label 'Appointment Status' ;
    rdfs:comment 'Current workflow state of the radiology imaging appointment. Tracks the full lifecycle from initial scheduling through completion or cancellation. Aligns with IHE SWF appointment status codes.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appointmentType rdf:type rdf:Property ;
    rdfs:label 'Appointment Type' ;
    rdfs:comment 'Clinical classification of the imaging appointment indicating the urgency and purpose of the study. Drives scheduling priority, slot allocation, and workflow routing. [ENUM-REF-CANDIDATE: routine|urgent|stat|screening|follow_up|pre_op|research — promote to reference product if additional types are needed]' ;
    rdfs:domain ind:RadiologyAppointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:arrivalTimestamp rdf:type rdf:Property ;
    rdfs:label 'Arrival Timestamp' ;
    rdfs:comment 'Timestamp when patient arrived' ;
    rdfs:domain ind:RadiologyAppointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:authStatus rdf:type rdf:Property ;
    rdfs:label 'Auth Status' ;
    rdfs:comment 'Current status of the insurance pre-authorization for this imaging appointment. Drives scheduling holds, revenue cycle workflows, and denial management processes.' ;
    rdfs:domain ind:RadiologyAppointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingEligibilityFlag rdf:type rdf:Property ;
    rdfs:label 'Billing Eligibility Flag' ;
    rdfs:comment 'Whether appointment is billable' ;
    rdfs:domain ind:RadiologyAppointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bookingChannel rdf:type rdf:Property ;
    rdfs:label 'Booking Channel' ;
    rdfs:comment 'Channel used to book (phone, portal, walk-in)' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bookingTimestamp rdf:type rdf:Property ;
    rdfs:label 'Booking Timestamp' ;
    rdfs:comment 'When appointment was booked' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:cancellationReasonCode rdf:type rdf:Property ;
    rdfs:label 'Cancellation Reason Code' ;
    rdfs:comment 'Coded cancellation reason' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cancellationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Cancellation Timestamp' ;
    rdfs:comment 'When appointment was cancelled' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:cancelledBy rdf:type rdf:Property ;
    rdfs:label 'Cancelled By' ;
    rdfs:comment 'User who cancelled appointment' ;
    rdfs:domain ind:RadiologyAppointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:checkInTimestamp rdf:type rdf:Property ;
    rdfs:label 'Check In Timestamp' ;
    rdfs:comment 'When patient checked in' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:confirmationStatus rdf:type rdf:Property ;
    rdfs:label 'Confirmation Status' ;
    rdfs:comment 'Confirmation status' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:confirmationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Confirmation Timestamp' ;
    rdfs:comment 'When appointment was confirmed' ;
    rdfs:domain ind:RadiologyAppointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:contrastType rdf:type rdf:Property ;
    rdfs:label 'Contrast Type' ;
    rdfs:comment 'The route of contrast agent administration planned for this imaging study. Used for pre-procedure preparation, patient safety screening, and contrast administration documentation.' ;
    rdfs:domain ind:RadiologyAppointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:enterpriseAppointmentId rdf:type rdf:Property ;
    rdfs:label 'Enterprise Appointment Id' ;
    rdfs:comment 'Reference to the parent enterprise scheduling appointment record. Links this radiology-specific scheduling record to the general enterprise scheduling infrastructure.' ;
    rdfs:domain ind:RadiologyAppointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:insuranceVerificationStatus rdf:type rdf:Property ;
    rdfs:label 'Insurance Verification Status' ;
    rdfs:comment 'Insurance verification status' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:insuranceVerificationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Insurance Verification Timestamp' ;
    rdfs:comment 'When insurance was verified' ;
    rdfs:domain ind:RadiologyAppointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:isStat rdf:type rdf:Property ;
    rdfs:label 'Is Stat' ;
    rdfs:comment 'Indicates whether this imaging appointment was ordered as STAT (immediate/urgent priority), requiring expedited scheduling and turnaround. Drives workflow prioritization in the RIS and PACS.' ;
    rdfs:domain ind:RadiologyAppointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:noShowReason rdf:type rdf:Property ;
    rdfs:label 'No Show Reason' ;
    rdfs:comment 'The documented reason the patient did not appear for the scheduled imaging appointment when appointment_status is \'no_show\'. Used for patient outreach, access analytics, and population health management.' ;
    rdfs:domain ind:RadiologyAppointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pacsStudyUid rdf:type rdf:Property ;
    rdfs:label 'Pacs Study Uid' ;
    rdfs:comment 'The globally unique DICOM Study Instance UID assigned by the PACS for the imaging study associated with this appointment. Enables direct linkage between the scheduling record and the DICOM image archive.' ;
    rdfs:domain ind:Radiology ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:patientDeviceType rdf:type rdf:Property ;
    rdfs:label 'Patient Device Type' ;
    rdfs:comment 'Device type for telehealth' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:patientLocation rdf:type rdf:Property ;
    rdfs:label 'Patient Location' ;
    rdfs:comment 'The patient\'s physical location at the time of the imaging appointment (e.g., inpatient unit/bed, ED bay, outpatient clinic, external). Used for transport coordination and portable imaging dispatch.' ;
    rdfs:domain ind:RadiologyAppointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:prepInstructions rdf:type rdf:Property ;
    rdfs:label 'Prep Instructions' ;
    rdfs:comment 'Specific pre-appointment preparation instructions communicated to the patient (e.g., NPO after midnight, bowel prep, hydration requirements, medication holds). Critical for imaging quality and patient safety.' ;
    rdfs:domain ind:RadiologyAppointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerAttestationFlag rdf:type rdf:Property ;
    rdfs:label 'Provider Attestation Flag' ;
    rdfs:comment 'Provider attestation completed' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:radiationDoseFlag rdf:type rdf:Property ;
    rdfs:label 'Radiation Dose Flag' ;
    rdfs:comment 'Indicates whether radiation dose tracking is required for this imaging appointment (applicable to CT, fluoroscopy, nuclear medicine, and other ionizing radiation modalities). Drives dose monitoring workflows per ACR and Joint Commission requirements.' ;
    rdfs:domain ind:RadiologyAppointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rescheduleCount rdf:type rdf:Property ;
    rdfs:label 'Reschedule Count' ;
    rdfs:comment 'The number of times this imaging appointment has been rescheduled. Used to identify access barriers, patient compliance issues, and scheduling inefficiencies.' ;
    rdfs:domain ind:RadiologyAppointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:risAppointmentCode rdf:type rdf:Property ;
    rdfs:label 'Ris Appointment Code' ;
    rdfs:comment 'The native appointment identifier from the source Radiology Information System (RIS) such as Epic Radiant or Cerner RadNet. Used for cross-system reconciliation and ETL lineage tracking.' ;
    rdfs:domain ind:RadiologyAppointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:roomedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Roomed Timestamp' ;
    rdfs:comment 'When patient was roomed' ;
    rdfs:domain ind:RadiologyAppointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:scheduledDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Scheduled Duration Minutes' ;
    rdfs:comment 'The planned duration of the imaging appointment in minutes as defined at time of scheduling. Drives modality slot blocking, throughput analysis, and schedule optimization.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:scheduledEndDatetime rdf:type rdf:Property ;
    rdfs:label 'Scheduled End Datetime' ;
    rdfs:comment 'The planned date and time the imaging appointment is expected to conclude. Used with scheduled_start_datetime to determine the reserved slot duration on the modality schedule.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduledEndTime rdf:type rdf:Property ;
    rdfs:label 'Scheduled End Time' ;
    rdfs:comment 'Scheduled end time' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:scheduledStartTime rdf:type rdf:Property ;
    rdfs:label 'Scheduled Start Time' ;
    rdfs:comment 'Scheduled start time' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:schedulingSource rdf:type rdf:Property ;
    rdfs:label 'Scheduling Source' ;
    rdfs:comment 'The channel or source through which this imaging appointment was scheduled. Used for access analytics, referral management, and patient experience reporting.' ;
    rdfs:domain ind:RadiologyAppointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:telehealthAccessCode rdf:type rdf:Property ;
    rdfs:label 'Telehealth Access Code' ;
    rdfs:comment 'Access code for telehealth session' ;
    rdfs:domain ind:RadiologyAppointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:telehealthConnectionStatus rdf:type rdf:Property ;
    rdfs:label 'Telehealth Connection Status' ;
    rdfs:comment 'Telehealth connection status' ;
    rdfs:domain ind:RadiologyAppointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:telehealthSessionUrl rdf:type rdf:Property ;
    rdfs:label 'Telehealth Session Url' ;
    rdfs:comment 'URL for telehealth session' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:visitModality rdf:type rdf:Property ;
    rdfs:label 'Visit Modality' ;
    rdfs:comment 'Visit modality (in-person, telehealth, phone)' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:visitReason rdf:type rdf:Property ;
    rdfs:label 'Visit Reason' ;
    rdfs:comment 'Reason for visit' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:visitReasonCode rdf:type rdf:Property ;
    rdfs:label 'Visit Reason Code' ;
    rdfs:comment 'Coded visit reason' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:readerAssignmentId rdf:type rdf:Property ;
    rdfs:label 'Reader Assignment Id' ;
    rdfs:comment 'Primary key for reader_assignment' ;
    rdfs:domain ind:ReaderAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:primaryReaderClinicianId rdf:type rdf:Property ;
    rdfs:label 'Primary Reader Clinician Id' ;
    rdfs:comment 'Reference to the radiologist or reading provider assigned to interpret the imaging study. May reference an internal clinician or a teleradiology vendor reader.' ;
    rdfs:domain ind:ReaderAssignment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:priorAssignmentReaderAssignmentId rdf:type rdf:Property ;
    rdfs:label 'Prior Assignment Reader Assignment Id' ;
    rdfs:comment 'Reference to the previous reader_assignment record when this record represents a reassignment or second read. Enables chaining of assignment history for a single imaging study to support audit trails and TAT analysis.' ;
    rdfs:domain ind:ReaderAssignment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ReaderAssignment .

ind:addendumFlag rdf:type rdf:Property ;
    rdfs:label 'Addendum Flag' ;
    rdfs:comment 'Indicates whether an addendum was appended to the original radiology report after initial signing. True if an addendum exists; False otherwise. Supports HIM audit trails and clinical documentation integrity.' ;
    rdfs:domain ind:ReaderAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:assignedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Assigned Timestamp' ;
    rdfs:comment 'Date and time when the radiologist was formally assigned to the imaging study. Serves as the start of the turnaround time (TAT) clock for SLA measurement. Stored in ISO 8601 format with timezone offset.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:assignmentSource rdf:type rdf:Property ;
    rdfs:label 'Assignment Source' ;
    rdfs:comment 'Mechanism by which the radiologist was assigned to the study. Values: worklist_auto (RIS auto-assignment algorithm), manual (dispatcher or radiologist self-assignment), teleradiology_vendor (routed to external vendor), ai_routing (AI-assisted worklist routing), escalation (escalated from prior assignment). [ENUM-REF-CANDIDATE: worklist_auto|manual|teleradiology_vendor|ai_routing|escalation|stat_escalation|protocol_override — promote to reference product if values expand]' ;
    rdfs:domain ind:ReaderAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contrastUsed rdf:type rdf:Property ;
    rdfs:label 'Contrast Used' ;
    rdfs:comment 'Indicates whether contrast agent was administered during the imaging study. True if contrast was used; False for non-contrast studies. Relevant for CPT code selection, billing, and clinical interpretation context.' ;
    rdfs:domain ind:Radiology ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:criticalFindingNotifiedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Critical Finding Notified Timestamp' ;
    rdfs:comment 'Date and time when the radiologist or RIS system notified the ordering provider of a critical imaging finding. Required for TJC and ACR compliance documentation. Populated only when critical_finding_flag is True.' ;
    rdfs:domain ind:Radiology ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:imageCount rdf:type rdf:Property ;
    rdfs:label 'Image Count' ;
    rdfs:comment 'Total number of DICOM image instances in the imaging study at the time of assignment. Used as a proxy for study complexity in radiologist workload and productivity analysis.' ;
    rdfs:domain ind:Radiology ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isTeleradiology rdf:type rdf:Property ;
    rdfs:label 'Is Teleradiology' ;
    rdfs:comment 'Indicates whether this assignment was routed to an external teleradiology vendor rather than an internal radiologist. True for teleradiology assignments; False for internal reads. Drives vendor SLA tracking and billing differentiation.' ;
    rdfs:domain ind:ReaderAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:peerReviewCategory rdf:type rdf:Property ;
    rdfs:label 'Peer Review Category' ;
    rdfs:comment 'Categorical classification of the peer review outcome indicating the level of agreement or discrepancy between the primary read and the peer reviewer\'s interpretation. Supports quality improvement programs and radiologist performance monitoring.' ;
    rdfs:domain ind:ReaderAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:readCompleteTimestamp rdf:type rdf:Property ;
    rdfs:label 'Read Complete Timestamp' ;
    rdfs:comment 'Date and time when the radiologist completed the interpretation and the report was finalized or signed. Used as the end point for TAT SLA calculation.' ;
    rdfs:domain ind:ReaderAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:readStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Read Start Timestamp' ;
    rdfs:comment 'Date and time when the radiologist opened and began actively interpreting the imaging study in PACS or the RIS worklist. Used to measure time-to-read and radiologist productivity.' ;
    rdfs:domain ind:ReaderAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:readingSite rdf:type rdf:Property ;
    rdfs:label 'Reading Site' ;
    rdfs:comment 'Physical or virtual location from which the radiologist performed the interpretation (e.g., on-site reading room, remote home workstation, teleradiology hub). Distinct from the imaging facility; captures where the read occurred.' ;
    rdfs:domain ind:ReaderAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reassignmentReason rdf:type rdf:Property ;
    rdfs:label 'Reassignment Reason' ;
    rdfs:comment 'Free-text or coded reason why the study was reassigned from the originally assigned radiologist to another reader. Examples include radiologist unavailability, subspecialty escalation, conflict of interest, or workload rebalancing. Populated only when assignment_status is reassigned.' ;
    rdfs:domain ind:ReaderAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportSignedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Report Signed Timestamp' ;
    rdfs:comment 'Date and time when the radiologist electronically signed and authenticated the final radiology report. Distinct from read_complete_timestamp as signing may occur after dictation/transcription. Supports HIM and compliance audit requirements.' ;
    rdfs:domain ind:ReaderAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:rvuValue rdf:type rdf:Property ;
    rdfs:label 'Rvu Value' ;
    rdfs:comment 'The total Relative Value Unit (RVU) assigned to the CPT code for this interpretation, sourced from the CMS Physician Fee Schedule. Used for radiologist productivity measurement, compensation modeling, and departmental workload reporting.' ;
    rdfs:domain ind:ReaderAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:slaMet rdf:type rdf:Property ;
    rdfs:label 'Sla Met' ;
    rdfs:comment 'Indicates whether the reader assignment was completed within the applicable SLA target turnaround time. True if tat_minutes is less than or equal to sla_target_minutes; False otherwise. Supports SLA compliance dashboards and vendor performance management.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:subspecialtyMatch rdf:type rdf:Property ;
    rdfs:label 'Subspecialty Match' ;
    rdfs:comment 'Indicates whether the assigned radiologist\'s subspecialty certification matches the subspecialty required for the imaging study. True if matched; False if assigned outside subspecialty (e.g., general radiologist reading a neuroradiology study). Supports quality and credentialing compliance reporting.' ;
    rdfs:domain ind:ReaderAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:subspecialtyRequired rdf:type rdf:Property ;
    rdfs:label 'Subspecialty Required' ;
    rdfs:comment 'The radiologist subspecialty required to interpret this imaging study (e.g., neuroradiology, musculoskeletal, breast imaging, interventional, nuclear medicine). Drives subspecialty-based worklist routing and teleradiology vendor selection.' ;
    rdfs:domain ind:Radiology ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tatMinutes rdf:type rdf:Property ;
    rdfs:label 'Tat Minutes' ;
    rdfs:comment 'Calculated turnaround time in minutes from study assignment to report completion. Stored as a pre-computed operational field (not a KPI aggregate) to support SLA compliance monitoring and worklist management without requiring real-time computation.' ;
    rdfs:domain ind:ReaderAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:teleradiologyRoutingReason rdf:type rdf:Property ;
    rdfs:label 'Teleradiology Routing Reason' ;
    rdfs:comment 'Business reason why the study was routed to a teleradiology vendor rather than read internally. Values: after_hours (no internal radiologist available), subspecialty_gap (required subspecialty not available internally), volume_overflow (worklist capacity exceeded), coverage_gap (scheduled radiologist absent), stat_backup (emergency backup coverage).' ;
    rdfs:domain ind:ReaderAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:teleradiologyVendorName rdf:type rdf:Property ;
    rdfs:label 'Teleradiology Vendor Name' ;
    rdfs:comment 'Name of the external teleradiology vendor to whom the study was routed for interpretation. Populated only when is_teleradiology is True. Used for vendor performance management and contract SLA tracking.' ;
    rdfs:domain ind:ReaderAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vendorAccessionNumber rdf:type rdf:Property ;
    rdfs:label 'Vendor Accession Number' ;
    rdfs:comment 'The accession number assigned by the teleradiology vendor\'s RIS to the study. Used for cross-referencing the internal RIS accession number with the vendor\'s system for report reconciliation and image retrieval.' ;
    rdfs:domain ind:Radiology ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:worklistCode rdf:type rdf:Property ;
    rdfs:label 'Worklist Code' ;
    rdfs:comment 'Identifier of the RIS worklist queue from which this assignment was generated or pulled. Used to trace the assignment back to its originating worklist configuration for routing audit and performance analysis.' ;
    rdfs:domain ind:ReaderAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

