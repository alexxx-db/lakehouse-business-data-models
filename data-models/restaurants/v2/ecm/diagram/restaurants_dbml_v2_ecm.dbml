  effective_until date [note: 'Contract end date']
  lead_time_days varchar [note: 'Contracted lead time in days']
  minimum_order_quantity decimal(18,4) [note: 'Minimum order quantity']
  payment_terms varchar [note: 'Payment terms']
  price decimal(18,2) [note: 'Contracted unit price']
