    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:severity rdf:type rdf:Property ;
    rdfs:label 'Severity' ;
    rdfs:comment 'Severity level of the issue addressed by the CAPA.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verificationDate rdf:type rdf:Property ;
    rdfs:label 'Verification Date' ;
    rdfs:comment 'Date when the effectiveness of the CAPA was verified.' ;
    rdfs:domain ind:CapaRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:verificationResult rdf:type rdf:Property ;
    rdfs:label 'Verification Result' ;
    rdfs:comment 'Outcome of the effectiveness verification.' ;
    rdfs:domain ind:CapaRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceFabToolId rdf:type rdf:Property ;
    rdfs:label 'Source Fab Tool Id' ;
    rdfs:comment 'Foreign key linking to equipment.fab_tool. Business justification: IATF 16949 nonconformance management requires traceability to the equipment source of the nonconformance. NCRs triggered by tool out-of-control events must reference the offending tool to drive equipm' ;
    rdfs:domain ind:NonconformanceReport ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FabTool .

ind:attachedDocumentIds rdf:type rdf:Property ;
    rdfs:label 'Attached Document Ids' ;
    rdfs:comment 'Comma-separated list of document identifiers attached to the report.' ;
