ind:appliedDate rdf:type rdf:Property ;
    rdfs:label 'Applied Date' ;
    rdfs:comment 'Date deposit was applied' ;
    rdfs:domain ind:Deposit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:appliedToBalance rdf:type rdf:Property ;
    rdfs:label 'Applied To Balance' ;
    rdfs:comment 'Amount of deposit applied to outstanding balance' ;
    rdfs:domain ind:Deposit ;
