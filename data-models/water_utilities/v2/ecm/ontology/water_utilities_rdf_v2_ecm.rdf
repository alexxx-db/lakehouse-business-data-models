ind:appliedToBalanceDate rdf:type rdf:Property ;
    rdfs:label 'Applied To Balance Date' ;
    rdfs:comment 'Date deposit was applied to balance' ;
    rdfs:domain ind:Deposit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:balanceRemaining rdf:type rdf:Property ;
    rdfs:label 'Balance Remaining' ;
    rdfs:comment 'Current deposit balance held' ;
    rdfs:domain ind:Deposit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:depositCategory rdf:type rdf:Property ;
    rdfs:label 'Deposit Category' ;
    rdfs:domain ind:Deposit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:depositCode rdf:type rdf:Property ;
    rdfs:label 'Deposit Code' ;
    rdfs:domain ind:Deposit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collectedDate rdf:type rdf:Property ;
    rdfs:label 'Collected Date' ;
    rdfs:comment 'Date the deposit was collected.' ;
    rdfs:domain ind:Deposit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:collectionDate rdf:type rdf:Property ;
    rdfs:label 'Collection Date' ;
    rdfs:comment 'Date deposit was collected' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collectionReason rdf:type rdf:Property ;
    rdfs:label 'Collection Reason' ;
    rdfs:comment 'Reason deposit was required: new account, delinquency, etc.' ;
    rdfs:domain ind:Deposit ;
    rdf:type owl:DatatypeProperty ;
