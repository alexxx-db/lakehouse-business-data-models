  approved_status varchar [note: 'Current approval status.']
  audit_requirement varchar [note: 'Audit requirements for this vendor.']
  bank_account_number varchar [note: 'Vendor bank account number.']
  category_scope varchar [note: 'Categories the vendor is approved to supply.']
  compliance_documents varchar [note: 'List of compliance documents on file.']
  compliance_status varchar [note: 'Current compliance status of the vendor.']
  contract_end_date date [note: 'End date of the vendor contract.']
  contract_start_date date [note: 'Start date of the vendor contract.']
  contract_terms_summary varchar [note: 'Summary of key contract terms.']
  created_timestamp timestamp [note: 'Record creation timestamp.']
  disqualification_date date [note: 'Date the vendor was disqualified if applicable.']
  disqualification_reason varchar [note: 'Reason for vendor disqualification.']
  expiry_date date [note: 'Date the approval expires.']
  geographic_scope varchar [note: 'Geographic regions the vendor is approved for.']
  insurance_certificate_expiry date [note: 'Expiry date of the vendor insurance certificate.']
  is_currently_approved boolean [note: 'Whether the vendor is currently approved.']
  last_audit_date date [note: 'Date of the last vendor audit.']
  last_audit_result varchar [note: 'Result of the last vendor audit.']
  last_modified_by varchar [note: 'User who last modified the record.']
  notes varchar [note: 'Free-text notes about the vendor approval.']
  payment_terms decimal(18,2) [note: 'Payment terms in net days.']
  preferred_vendor_flag boolean [note: 'Indicates if this is a preferred vendor.']
  primary_contact_email varchar [note: 'Email of the primary contact.']
  primary_contact_name varchar [note: 'Name of the primary contact.']
  primary_contact_phone varchar [note: 'Phone of the primary contact.']
  risk_score decimal(5,2) [note: 'Calculated risk score for the vendor.']
  tax_id_number decimal(18,2) [note: 'Tax identification number of the vendor.']
  updated_timestamp timestamp [note: 'Record last update timestamp.']
  vendor_category_code varchar [note: 'Category code assigned to the vendor.']
  vendor_identifier varchar [note: 'Unique vendor identifier code.']
  vendor_rating decimal(3,2) [note: 'Overall vendor performance rating.']
  vendor_type varchar [note: 'Type classification of the vendor.']
  created_by varchar [note: 'User who created the record.']

  Note: 'Approved vendor list entries tracking which suppliers are authorized to provide goods/services.'
}

Table procurement.category {
  category_id varchar [pk, note: 'Primary key for the procurement category.']
  parent_category_id varchar [note: 'Self-referencing FK for category hierarchy.']
  active_flag boolean [note: 'Flag indicating active status.']
  annual_spend decimal(18,2) [note: 'Total annual spend in this category.']
  category_code varchar [note: 'Unique code for the category.']
  category_description varchar [note: 'Detailed description of the category.']
  category_level varchar [note: 'Hierarchy level of the category.']
  category_name varchar [note: 'Name of the procurement category.']
  category_type varchar [note: 'Type classification (direct, indirect, services).']
  commodity_group varchar [note: 'Commodity group this category belongs to.']
  created_at timestamp [note: 'Alternative creation timestamp.']
  created_timestamp timestamp [note: 'Record creation timestamp.']
  currency varchar [note: 'Currency for spend amounts.']
  effective_from date [note: 'Date the category becomes effective.']
  effective_until date [note: 'Date the category expires.']
  is_active boolean [note: 'Whether the category is currently active.']
  is_strategic decimal(10,4) [note: 'Whether this is a strategic category.']
  manager_name varchar [note: 'Name of the category manager responsible.']
  parent_category varchar [note: 'Name of the parent category.']
  sourcing_strategy decimal(10,4) [note: 'Sourcing strategy for this category.']
  spend_category varchar [note: 'Spend classification for reporting.']
  spend_classification varchar [note: 'Classification of spend type.']
  spend_owner varchar [note: 'Owner responsible for spend in this category.']
  spend_ytd decimal(18,2) [note: 'Year-to-date spend in this category.']
  unspsc_code varchar [note: 'United Nations Standard Products and Services Code.']
  updated_at timestamp [note: 'Alternative update timestamp.']
  updated_timestamp timestamp [note: 'Record last update timestamp.']

  Note: 'Procurement spend categories used to classify and manage sourcing activities and supplier relationships.'
}

Table procurement.sourcing_event {
  sourcing_event_id varchar [pk, note: 'Primary key for the sourcing event.']
  procurement_supplier_id varchar [note: 'Awarded supplier if applicable.']
  sourcing_employee_id varchar [note: 'Employee who created the sourcing event.']
