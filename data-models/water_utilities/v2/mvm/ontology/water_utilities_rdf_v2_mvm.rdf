    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:meterId rdf:type rdf:Property ;
    rdfs:label 'Meter Id' ;
    rdfs:comment 'Foreign key linking to metering.metering_meter. Business justification: Each filter unit has a dedicated flow meter measuring influent/effluent for CT compliance and backwash scheduling. Linking filter_unit to its metering_meter supports filter performance monitoring, reg' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Meter .

ind:pairedFilterUnitId rdf:type rdf:Property ;
    rdfs:label 'Paired Filter Unit Id' ;
    rdfs:comment 'Self-referencing FK on filter_unit (paired_filter_unit_id)' ;
    rdfs:domain ind:FilterUnit ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FilterUnit .

ind:calibrationDate rdf:type rdf:Property ;
    rdfs:label 'Calibration Date' ;
    rdfs:comment 'Date the filter unit\'s measurement instruments were last calibrated.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:calibrationStatus rdf:type rdf:Property ;
    rdfs:label 'Calibration Status' ;
    rdfs:comment 'Current calibration validity.' ;
    rdfs:domain ind:FilterUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capacityM3PerHour rdf:type rdf:Property ;
    rdfs:label 'Capacity M3 Per Hour' ;
    rdfs:comment 'Maximum water flow the filter unit can handle, expressed in cubic meters per hour.' ;
    rdfs:domain ind:FilterUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:commissioningDate rdf:type rdf:Property ;
    rdfs:label 'Commissioning Date' ;
    rdfs:comment 'Date the filter unit became operational.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:complianceCtValueMgPerL rdf:type rdf:Property ;
    rdfs:label 'Compliance Ct Value Mg Per L' ;
    rdfs:comment 'Measured chlorine residual (CT) value for compliance, expressed in mg/L.' ;
    rdfs:domain ind:FilterUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:costUsd rdf:type rdf:Property ;
    rdfs:label 'Cost Usd' ;
    rdfs:comment 'Acquisition cost of the filter unit in US dollars.' ;
    rdfs:domain ind:FilterUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:disposalDate rdf:type rdf:Property ;
    rdfs:label 'Disposal Date' ;
    rdfs:comment 'Date the filter media was disposed of.' ;
    rdfs:domain ind:FilterUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:disposalMethod rdf:type rdf:Property ;
    rdfs:label 'Disposal Method' ;
    rdfs:comment 'Method used to dispose of spent filter media.' ;
