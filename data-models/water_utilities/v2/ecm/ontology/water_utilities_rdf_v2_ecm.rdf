ind:isTaxIncluded rdf:type rdf:Property ;
    rdfs:label 'Is Tax Included' ;
    rdfs:comment 'True if tax is already included in the amount; false otherwise.' ;
    rdfs:domain ind:RecurringEntryTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastRunDate rdf:type rdf:Property ;
