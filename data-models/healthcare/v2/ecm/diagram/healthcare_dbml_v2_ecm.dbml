  effective_start_date date
  high_critical_value decimal(12,4)
  high_warning_value decimal(12,4)
  is_active boolean
  low_critical_value decimal(12,4)
  low_warning_value decimal(12,4)
  measure_type varchar
  unit_of_measure varchar
  updated_timestamp timestamp

  Note: 'Alert thresholds for RPM device readings.'
}

Table digital_health.prom_question {
  prom_question_id varchar [pk, note: 'Primary key for prom_question']
  parent_prom_question_id varchar [note: 'Self-referencing FK on prom_question (parent_prom_question_id)']
  prom_instrument_id varchar [note: 'Foreign key linking to digital_health.prom_instrument. Business justification: A prom_question is a master reference item belonging to exactly ONE PROM instrument (e.g. a PHQ-9 question belongs to the PHQ-9 instrument). prom_instrument (PROMIS, PHQ-9 definitions) is the parent; ']
  answer_option_set varchar [note: 'Reference name or identifier of the value set / answer option list used to constrain valid responses to this question.']
  clinical_domain varchar [note: 'Health domain or construct the question assesses (e.g., depression, physical function, pain, anxiety, quality of life). [ENUM-REF-CANDIDATE: depression|anxiety|physical_function|pain|fatigue|quality_of_life|social_function — promote to reference product]']
  conditional_display_logic varchar [note: 'Skip-logic / branching expression that determines whether this question is shown based on prior responses.']
  copyright_holder varchar [note: 'Organization or author holding copyright/licensing rights over the question and instrument content.']
  created_timestamp timestamp [note: 'Timestamp when this question reference record was first captured in the master table.']
  display_sequence varchar [note: 'Ordinal position of the question within the instrument presentation order.']
  effective_from_date date [note: 'Date from which this question version becomes valid for administration.']
  effective_to_date date [note: 'Date after which this question version is no longer valid for administration (nullable for open-ended).']
  help_text varchar [note: 'Optional supplementary guidance or clarification shown to the patient to aid comprehension of the question.']
  is_required boolean [note: 'Indicates whether a patient must answer this question for the survey to be considered complete.']
  is_reverse_scored boolean [note: 'Indicates whether the question response is reverse-scored when computing the domain or scale score.']
  language_code varchar [note: 'ISO 639 language code identifying the language of this question rendering for multilingual survey delivery.']
  last_updated_timestamp timestamp [note: 'Timestamp when this question reference record was last modified.']
  license_type varchar [note: 'Licensing classification governing permitted use of the question content.']
  loinc_code varchar [note: 'LOINC code that standardizes the question/observation for interoperability and reporting.']
  max_score varchar [note: 'Maximum numeric score achievable for this question, used for scoring and normalization.']
  min_score varchar [note: 'Minimum numeric score achievable for this question, used for scoring and normalization.']
  question_code varchar [note: 'Externally-known unique short code identifying the question within its instrument (e.g., PHQ9_Q1, PROMIS_PF_03). Used as the operational business key.']
  question_status varchar [note: 'Current lifecycle state of the question definition in the reference master.']
  question_text varchar [note: 'The full human-readable text of the question as presented to the patient.']
  question_type varchar [note: 'Structural type of the question determining how the patient response is captured and validated.']
  recall_period varchar [note: 'Time window the patient is asked to consider when answering (e.g., past 7 days), affecting response interpretation.']
  response_format varchar [note: 'Format of the expected patient response (e.g., Likert scale, Numeric Rating Scale, Visual Analog Scale).']
  scoring_weight decimal(6,4) [note: 'Relative weight applied to this question when aggregating into the instrument-level scale score.']
  short_label varchar [note: 'Abbreviated display label used in dashboards, charts, and compact survey UIs.']
  snomed_ct_code varchar [note: 'SNOMED CT concept code associated with the clinical concept the question measures, where applicable.']
  unit_of_measure varchar [note: 'Unit associated with numeric responses to the question, where applicable (e.g., days, count, points).']

  Note: 'Master reference table for prom_question. Referenced by question_id.'
}

Table digital_health.portal_session {
  portal_session_id varchar [pk, note: 'Primary key for portal_session']
  mpi_record_id varchar [note: 'Identifier of the patient whose portal account is associated with this session.']
  parent_portal_session_id varchar [note: 'Self-referencing FK on portal_session (parent_portal_session_id)']
  user_account_id varchar [note: 'Identifier of the portal user account that authenticated this session.']
  access_channel varchar [note: 'The interface/channel through which the portal session was initiated.']
  authentication_method varchar [note: 'The authentication mechanism used to establish this session.']
  browser_name varchar [note: 'Web browser or client application name reported during the session.']
  consent_acknowledged boolean [note: 'Indicates whether the user acknowledged required privacy/consent terms during the session.']
  country_code varchar [note: 'Three-letter ISO 3166-1 alpha-3 country code of the session origin.']
  created_timestamp timestamp [note: 'Timestamp when this session record was first captured in the system.']
  device_identifier varchar [note: 'Unique device fingerprint or registered device identifier associated with the session.']
  device_type varchar [note: 'Category of device used to access the portal session.']
  failed_login_attempts varchar [note: 'Count of failed authentication attempts recorded prior to or during establishment of this session.']
  geo_location varchar [note: 'Approximate geographic location (city/region) derived from the session\'s originating network.']
  idle_timeout_minutes varchar [note: 'Configured inactivity threshold in minutes after which the session auto-terminates.']
  last_activity_timestamp timestamp [note: 'Timestamp of the most recent user interaction within the session, used for idle timeout evaluation.']
  login_timestamp timestamp [note: 'The real-world timestamp when the portal session was authenticated and started.']
  logout_timestamp timestamp [note: 'The timestamp when the portal session ended, either by explicit logout or termination. Nullable for active sessions.']
  mfa_verified boolean [note: 'Indicates whether multi-factor authentication was successfully completed for this session.']
  operating_system varchar [note: 'Operating system name and version reported by the client device.']
  page_view_count varchar [note: 'Number of distinct portal pages or screens viewed during the session.']
  proxy_access_indicator boolean [note: 'Indicates whether the session was conducted by an authorized proxy (e.g., caregiver, guardian) on behalf of the patient.']
  session_duration_seconds varchar [note: 'Total elapsed active duration of the session measured in seconds.']
  session_status varchar [note: 'Current lifecycle state of the portal session.']
  session_token varchar [note: 'Opaque externally-referenced session token/identifier used to correlate the session across the portal application layer.']
  session_type varchar [note: 'Classifies the kind of portal session by the role of the authenticated user.']
  source_ip_address varchar [note: 'Originating IP address from which the portal session was established, captured for security auditing.']
  termination_reason varchar [note: 'The reason the session ended or was terminated.']
  user_agent varchar [note: 'Full user-agent header captured for the session for diagnostic and security purposes.']

  Note: 'Master reference table for portal_session. Referenced by session_id.'
}

