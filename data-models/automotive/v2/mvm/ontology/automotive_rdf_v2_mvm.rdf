ind:tirePressureRearRightPsi rdf:type rdf:Property ;
    rdfs:label 'Tire Pressure Rear Right Psi' ;
    rdfs:comment 'Air pressure of the rear-right tire measured in pounds per square inch.' ;
    rdfs:domain ind:TelemetryEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:predictiveMaintenanceAlertId rdf:type rdf:Property ;
    rdfs:label 'Predictive Maintenance Alert Id' ;
    rdfs:comment 'System-generated unique identifier for each predictive maintenance alert record.' ;
    rdfs:domain ind:PredictiveMaintenanceAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:alertCategory rdf:type rdf:Property ;
    rdfs:label 'Alert Category' ;
    rdfs:comment 'High-level classification of the alert (e.g., engine, brake, battery, software).' ;
    rdfs:domain ind:PredictiveMaintenanceAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alertCode rdf:type rdf:Property ;
    rdfs:label 'Alert Code' ;
    rdfs:comment 'Business identifier code assigned to the alert for tracking and reference.' ;
    rdfs:domain ind:PredictiveMaintenanceAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alertStatus rdf:type rdf:Property ;
    rdfs:label 'Alert Status' ;
    rdfs:comment 'Current lifecycle state of the alert.' ;
    rdfs:domain ind:PredictiveMaintenanceAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:confidencePercentage rdf:type rdf:Property ;
    rdfs:label 'Confidence Percentage' ;
    rdfs:comment 'Model confidence that the predicted failure will occur, expressed as a percentage (0-100).' ;
    rdfs:domain ind:PredictiveMaintenanceAlert ;
    rdf:type owl:DatatypeProperty ;
