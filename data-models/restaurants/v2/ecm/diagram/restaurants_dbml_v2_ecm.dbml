  goods_receipt_status varchar [note: 'Status (pending, complete, partial)']
  is_cold_chain_compliant boolean [note: 'Whether cold chain was maintained']
  lot_number varchar [note: 'Lot tracking number']
  purchase_order_number varchar [note: 'Reference PO number']
  receipt_number varchar [note: 'Unique receipt document number']
