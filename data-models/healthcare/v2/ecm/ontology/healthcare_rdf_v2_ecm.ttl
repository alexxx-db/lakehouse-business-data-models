    rdfs:comment 'Indicates whether the pharmacy location is equipped to dispense specialty medications (biologics, high-cost drugs, limited distribution drugs requiring REMS).' ;
    rdfs:domain ind:PharmacyLocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dispensingCapabilitySterile rdf:type rdf:Property ;
    rdfs:label 'Dispensing Capability Sterile' ;
    rdfs:comment 'Indicates whether the pharmacy location has USP 797 compliant sterile compounding capabilities (IV admixtures, chemotherapy, TPN).' ;
    rdfs:domain ind:PharmacyLocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:inventoryManagementSystem rdf:type rdf:Property ;
    rdfs:label 'Inventory Management System' ;
    rdfs:comment 'Name of the pharmacy inventory management system in use at this location (e.g., Epic Willow, Cerner PharmNet, Omnicell).' ;
    rdfs:domain ind:PharmacyLocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isAcceptingNewPatients rdf:type rdf:Property ;
    rdfs:label 'Is Accepting New Patients' ;
    rdfs:comment 'Indicates whether the provider at this location is currently accepting new patients. Critical field for provider directory accuracy, CMS network adequacy compliance, and patient access reporting. CMS requires this to be updated at least every 90 days.' ;
    rdfs:domain ind:PharmacyLocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isAdaAccessible rdf:type rdf:Property ;
    rdfs:label 'Is Ada Accessible' ;
    rdfs:comment 'Indicates whether the practice location is physically accessible and compliant with Americans with Disabilities Act (ADA) requirements, including wheelchair access, accessible parking, and accessible restrooms.' ;
    rdfs:domain ind:PharmacyLocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isCompoundingPharmacy rdf:type rdf:Property ;
    rdfs:label 'Is Compounding Pharmacy' ;
    rdfs:domain ind:PharmacyLocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isMailOrder rdf:type rdf:Property ;
    rdfs:label 'Is Mail Order' ;
    rdfs:domain ind:PharmacyLocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPrimaryLocation rdf:type rdf:Property ;
    rdfs:label 'Is Primary Location' ;
    rdfs:comment 'Indicates whether this is the provider\'s primary practice location. Used to determine the principal address for CMS enrollment, claims adjudication, and provider directory primary listing.' ;
    rdfs:domain ind:PharmacyLocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isSpecialtyPharmacy rdf:type rdf:Property ;
    rdfs:label 'Is Specialty Pharmacy' ;
    rdfs:domain ind:PharmacyLocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isTelehealthEnabled rdf:type rdf:Property ;
    rdfs:label 'Is Telehealth Enabled' ;
    rdfs:comment 'Indicates whether the provider at this location offers telehealth or virtual care services. Drives provider directory telehealth filtering and CMS Place of Service code 02 eligibility.' ;
    rdfs:domain ind:PharmacyLocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:languageCodes rdf:type rdf:Property ;
    rdfs:label 'Language Codes' ;
    rdfs:comment 'Pipe-delimited list of ISO 639-1 two-letter language codes representing languages spoken at this practice location (e.g., \'en|es|zh\'). Supports patient language matching, CMS language access requirements, and CLAS Standards compliance.' ;
    rdfs:domain ind:PharmacyLocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:locationCode rdf:type rdf:Property ;
    rdfs:label 'Location Code' ;
    rdfs:comment 'Internal business identifier or code for the pharmacy location used in operational systems (Epic Willow, Cerner PharmNet).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:locationEntityType rdf:type rdf:Property ;
    rdfs:label 'Location Entity Type' ;
    rdfs:comment 'Entity type discriminator: PHARMACY or PROVIDER' ;
