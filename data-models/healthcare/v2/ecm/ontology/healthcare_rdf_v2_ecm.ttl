    rdfs:comment 'Indicates whether patient consent must be verified prior to distributing the report under this rule.' ;
    rdfs:domain ind:DistributionRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:criticalityLevel rdf:type rdf:Property ;
    rdfs:label 'Criticality Level' ;
    rdfs:comment 'Clinical criticality level of findings that this rule applies to, driving expedited notification of critical results.' ;
    rdfs:domain ind:DistributionRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:effectiveUntilDate rdf:type rdf:Property ;
    rdfs:label 'Effective Until Date' ;
    rdfs:comment 'Date on which this distribution rule expires; null indicates open-ended enforcement.' ;
    rdfs:domain ind:DistributionRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:escalationRecipientRole rdf:type rdf:Property ;
