ind:compliancePermitId rdf:type rdf:Property ;
    rdfs:label 'Compliance Permit Id' ;
    rdfs:comment 'Foreign key linking to compliance.compliance_permit. Business justification: Discharge points (backwash discharge, filter-to-waste, plant drain) operate under specific NPDES/discharge compliance permits distinct from treatment permits. Regulators and operators must know which ' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CompliancePermit .

ind:installationId rdf:type rdf:Property ;
    rdfs:label 'Installation Id' ;
    rdfs:comment 'Foreign key linking to metering.installation. Business justification: Discharge points (backwash, plant effluent) require metered volume tracking for NPDES permit compliance and discharge monitoring reports (DMRs). Linking discharge_point to its meter installation enabl' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Installation .

ind:pipeMainId rdf:type rdf:Property ;
    rdfs:label 'Pipe Main Id' ;
    rdfs:comment 'Foreign key linking to distribution.pipe_main. Business justification: A treatment facility discharge point physically connects to a distribution pipe main as the entry point of finished water into the network. This link is fundamental for hydraulic modeling, water quali' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PipeMain .

ind:dischargeType rdf:type rdf:Property ;
    rdfs:label 'Discharge Type' ;
    rdfs:comment 'Discharge type (outfall, sewer, lagoon). Ref: OSIsoft PI Historian.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:receivingWaterBody rdf:type rdf:Property ;
