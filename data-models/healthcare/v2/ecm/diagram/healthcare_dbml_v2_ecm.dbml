  escalation_reason varchar [note: 'Reason for escalation']
  finding_category varchar [note: 'Category of critical finding']
  finding_datetime timestamp [note: 'When finding was identified']
  finding_description varchar [note: 'Description of critical finding']
  finding_severity varchar [note: 'Severity of finding']
  modality varchar [note: 'Imaging modality']
