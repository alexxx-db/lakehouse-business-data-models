  recount_required_flag boolean [note: 'Whether recount is required.']
  scheduled_start_timestamp timestamp [note: 'Scheduled start time.']
  submission_timestamp timestamp [note: 'Timestamp of count submission.']
  system_inventory_value decimal(18,2) [note: 'System-calculated inventory value.']
  total_sku_counted decimal(18,2) [note: 'Total SKUs counted.']
  total_sku_with_variance decimal(18,2) [note: 'Total SKUs with variance.']
  total_variance_amount decimal(18,2) [note: 'Total variance amount.']
  total_variance_percentage decimal(5,2) [note: 'Total variance as percentage.']
