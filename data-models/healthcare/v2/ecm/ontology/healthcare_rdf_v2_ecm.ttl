    rdfs:comment 'Indicates whether Protected Health Information (PHI) must be masked or de-identified before distribution, e.g., for external sharing under HIPAA.' ;
    rdfs:domain ind:DistributionRule ;
    rdf:type owl:DatatypeProperty ;
