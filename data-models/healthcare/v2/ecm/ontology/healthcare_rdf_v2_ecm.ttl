    rdfs:domain ind:PharmacyLocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:automatedDispensingCabinetCount rdf:type rdf:Property ;
    rdfs:label 'Automated Dispensing Cabinet Count' ;
    rdfs:comment 'Number of automated dispensing cabinets (e.g., Pyxis, Omnicell) deployed at this pharmacy location for decentralized medication storage and dispensing.' ;
    rdfs:domain ind:PharmacyLocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:cliaNumber rdf:type rdf:Property ;
    rdfs:label 'Clia Number' ;
    rdfs:comment 'clia number for pharmacy pharmacy location.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cmsEnrollmentNumber rdf:type rdf:Property ;
    rdfs:label 'Cms Enrollment Number' ;
    rdfs:comment 'CMS-assigned enrollment identifier (PTAN — Provider Transaction Access Number) for this practice location. Required for Medicare claims submission and CMS enrollment validation.' ;
    rdfs:domain ind:PharmacyLocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cmsPlaceOfServiceCode rdf:type rdf:Property ;
    rdfs:label 'Cms Place Of Service Code' ;
    rdfs:comment 'Two-digit CMS Place of Service code identifying the setting where healthcare services are rendered (e.g., 11=Office, 21=Inpatient Hospital, 02=Telehealth). Required on CMS-1500 professional claims and drives reimbursement rate determination.' ;
    rdfs:domain ind:PharmacyLocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:directoryLastVerifiedDate rdf:type rdf:Property ;
    rdfs:label 'Directory Last Verified Date' ;
    rdfs:comment 'Date on which the provider location information was last verified for accuracy in the provider directory. Supports CMS and NCQA provider directory accuracy requirements and audit trails.' ;
    rdfs:domain ind:PharmacyLocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:dispensingCapabilityControlledSubstances rdf:type rdf:Property ;
