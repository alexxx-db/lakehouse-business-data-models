ind:inspectionReportId rdf:type rdf:Property ;
    rdfs:label 'Inspection Report Id' ;
    rdfs:comment 'Unique identifier for the construction inspection report. Primary key.' ;
    rdfs:domain ind:Project ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:InspectionReport .

ind:inspectionContractorVendorId rdf:type rdf:Property ;
    rdfs:label 'Inspection Contractor Vendor Id' ;
    rdfs:comment 'Reference to the general contractor or prime contractor performing the work being inspected.' ;
    rdfs:domain ind:InspectionReport ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Vendor .

ind:changeOrderRecommendedFlag rdf:type rdf:Property ;
    rdfs:label 'Change Order Recommended Flag' ;
    rdfs:comment 'Indicates whether the inspector recommends a change order based on field conditions, design changes, or unforeseen circumstances observed during the inspection.' ;
    rdfs:domain ind:InspectionReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:contractorCrewSize rdf:type rdf:Property ;
    rdfs:label 'Contractor Crew Size' ;
    rdfs:comment 'Number of contractor personnel on-site during the inspection, used to assess resource deployment and progress correlation.' ;
    rdfs:domain ind:InspectionReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dailyProgressNarrative rdf:type rdf:Property ;
    rdfs:label 'Daily Progress Narrative' ;
    rdfs:comment 'Comprehensive narrative describing the overall progress of construction activities, contractor performance, site conditions, and any issues or delays encountered. Provides the contemporaneous field record for project documentation.' ;
    rdfs:domain ind:InspectionReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectionReportDescription rdf:type rdf:Property ;
    rdfs:label 'Inspection Report Description' ;
    rdfs:comment 'Free-text description' ;
    rdfs:domain ind:InspectionReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:drawingsReferenced rdf:type rdf:Property ;
    rdfs:label 'Drawings Referenced' ;
    rdfs:comment 'List of construction drawings, plans, or specifications referenced during the inspection, including drawing numbers and revision dates.' ;
    rdfs:domain ind:InspectionReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:equipmentOnSite rdf:type rdf:Property ;
    rdfs:label 'Equipment On Site' ;
    rdfs:comment 'List or description of major construction equipment present on-site during the inspection (e.g., excavators, cranes, concrete pumps, pipe layers).' ;
    rdfs:domain ind:InspectionReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectionReportNumber rdf:type rdf:Property ;
    rdfs:label 'Inspection Report Number' ;
    rdfs:comment 'Business identifier for the inspection report, typically a sequential or project-specific numbering scheme used for external reference and filing.' ;
    rdfs:domain ind:InspectionReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:materialsDelivered rdf:type rdf:Property ;
    rdfs:label 'Materials Delivered' ;
    rdfs:comment 'Description of construction materials delivered to the site during the inspection period, including quantities and supplier information where relevant.' ;
    rdfs:domain ind:InspectionReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:materialsTested rdf:type rdf:Property ;
    rdfs:label 'Materials Tested' ;
    rdfs:comment 'Description of materials tested or sampled during the inspection (e.g., concrete cylinders, soil compaction, pipe pressure tests), including test types and sample identifiers.' ;
    rdfs:domain ind:InspectionReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nonConformanceDescription rdf:type rdf:Property ;
    rdfs:label 'Non Conformance Description' ;
    rdfs:comment 'Detailed description of any non-conformance items identified, including location, nature of deficiency, and reference to violated specification sections.' ;
    rdfs:domain ind:InspectionReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nonConformanceIdentifiedFlag rdf:type rdf:Property ;
    rdfs:label 'Non Conformance Identified Flag' ;
    rdfs:comment 'Indicates whether any non-conformance items, deficiencies, or deviations from plans and specifications were identified during this inspection.' ;
    rdfs:domain ind:InspectionReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:payApplicationCertificationStatus rdf:type rdf:Property ;
    rdfs:label 'Pay Application Certification Status' ;
    rdfs:comment 'Status of the inspector\'s certification for contractor pay application based on the work progress documented in this report. Used to support or dispute contractor payment requests.' ;
    rdfs:domain ind:InspectionReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:photosAttachedCount rdf:type rdf:Property ;
    rdfs:label 'Photos Attached Count' ;
    rdfs:comment 'Number of photographs attached to this inspection report for visual documentation of site conditions, work progress, and non-conformance items.' ;
    rdfs:domain ind:InspectionReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:rfiGeneratedFlag rdf:type rdf:Property ;
    rdfs:label 'Rfi Generated Flag' ;
    rdfs:comment 'Indicates whether a Request for Information (RFI) was generated as a result of this inspection due to ambiguities, conflicts, or clarifications needed in the contract documents.' ;
    rdfs:domain ind:InspectionReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:safetyObservations rdf:type rdf:Property ;
    rdfs:label 'Safety Observations' ;
    rdfs:comment 'Documentation of safety conditions observed during the inspection, including compliance with Occupational Safety and Health Administration (OSHA) requirements, personal protective equipment (PPE) usage, and any safety concerns or violations.' ;
    rdfs:domain ind:InspectionReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subcontractorName rdf:type rdf:Property ;
    rdfs:label 'Subcontractor Name' ;
    rdfs:comment 'Name of the subcontractor performing the specific work activities observed during this inspection, if applicable.' ;
    rdfs:domain ind:InspectionReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:testResultsSummary rdf:type rdf:Property ;
    rdfs:label 'Test Results Summary' ;
    rdfs:comment 'Summary of field test results or observations from materials testing conducted during or immediately following the inspection.' ;
    rdfs:domain ind:InspectionReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:visitorsOnSite rdf:type rdf:Property ;
    rdfs:label 'Visitors On Site' ;
    rdfs:comment 'List of visitors present on-site during the inspection (e.g., project managers, engineers, regulatory inspectors, utility representatives), relevant for documentation and coordination.' ;
    rdfs:domain ind:InspectionReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workActivitiesObserved rdf:type rdf:Property ;
    rdfs:label 'Work Activities Observed' ;
    rdfs:comment 'Detailed narrative of construction activities observed during the inspection, including specific tasks, locations, and methods employed by the contractor.' ;
    rdfs:domain ind:InspectionReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workStoppageFlag rdf:type rdf:Property ;
    rdfs:label 'Work Stoppage Flag' ;
    rdfs:comment 'Indicates whether work was stopped or suspended during the inspection due to non-conformance, safety issues, or other reasons.' ;
    rdfs:domain ind:InspectionReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:workStoppageReason rdf:type rdf:Property ;
    rdfs:label 'Work Stoppage Reason' ;
    rdfs:comment 'Explanation of the reason for work stoppage if the work stoppage flag is true, including corrective actions required before work may resume.' ;
    rdfs:domain ind:InspectionReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nonconformanceReportId rdf:type rdf:Property ;
    rdfs:label 'Nonconformance Report Id' ;
    rdfs:comment 'Unique identifier for the non-conformance report. Primary key.' ;
    rdfs:domain ind:NonconformanceReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:nonconformanceContractorVendorId rdf:type rdf:Property ;
    rdfs:label 'Nonconformance Contractor Vendor Id' ;
    rdfs:comment 'Identifier of the contractor or subcontractor responsible for the work or materials that are the subject of the non-conformance report.' ;
    rdfs:domain ind:NonconformanceReport ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Vendor .

ind:nonconformanceVendorId rdf:type rdf:Property ;
    rdfs:label 'Nonconformance Vendor Id' ;
    rdfs:comment 'Identifier of the contractor or subcontractor responsible for the work or materials that are the subject of the non-conformance report.' ;
    rdfs:domain ind:NonconformanceReport ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Vendor .

ind:closeoutStatus rdf:type rdf:Property ;
    rdfs:label 'Closeout Status' ;
    rdfs:comment 'Status indicating whether the non-conformance report has been fully closed out with all corrective actions completed, verified, and documented, or remains open pending final steps.' ;
    rdfs:domain ind:Project ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contractorResponse rdf:type rdf:Property ;
    rdfs:label 'Contractor Response' ;
    rdfs:comment 'Narrative response from the contractor acknowledging the non-conformance, providing explanation, and proposing corrective action or requesting acceptance.' ;
    rdfs:domain ind:NonconformanceReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contractorResponseDate rdf:type rdf:Property ;
    rdfs:label 'Contractor Response Date' ;
    rdfs:comment 'Date when the contractor submitted their formal response to the non-conformance report.' ;
    rdfs:domain ind:NonconformanceReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:correctiveActionPlan rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Plan' ;
    rdfs:comment 'Detailed plan submitted by the contractor outlining the steps, methods, materials, and schedule for implementing the corrective action.' ;
    rdfs:domain ind:NonconformanceReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nonconformanceReportDescription rdf:type rdf:Property ;
    rdfs:label 'Nonconformance Report Description' ;
    rdfs:comment 'Free-text description' ;
    rdfs:domain ind:NonconformanceReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dispositionJustification rdf:type rdf:Property ;
    rdfs:label 'Disposition Justification' ;
    rdfs:comment 'Engineering justification or rationale for the disposition decision, particularly important when accepting non-conforming work as-is or granting concessions.' ;
    rdfs:domain ind:NonconformanceReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:engineerApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Engineer Approval Date' ;
    rdfs:comment 'Date when the engineer or authorized representative approved the disposition decision.' ;
    rdfs:domain ind:NonconformanceReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:engineerApprovalName rdf:type rdf:Property ;
    rdfs:label 'Engineer Approval Name' ;
    rdfs:comment 'Name of the professional engineer or authorized technical representative who approved the disposition decision, particularly for accept-as-is or use-as-is-with-concession dispositions.' ;
    rdfs:domain ind:NonconformanceReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:identifiedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Identified Timestamp' ;
    rdfs:comment 'Precise timestamp when the non-conformance was first identified, supporting detailed event sequencing and audit trails.' ;
    rdfs:domain ind:NonconformanceReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:inspectorOrganization rdf:type rdf:Property ;
    rdfs:label 'Inspector Organization' ;
    rdfs:comment 'Organization or company that the inspector represents, such as the utility owner, third-party inspection firm, or engineering consultant.' ;
    rdfs:domain ind:NonconformanceReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ncrNumber rdf:type rdf:Property ;
    rdfs:label 'Ncr Number' ;
    rdfs:comment 'Business identifier for the non-conformance report, typically a human-readable sequential or structured code used for tracking and reference in project documentation and communications.' ;
    rdfs:domain ind:NonconformanceReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ncrStatus rdf:type rdf:Property ;
    rdfs:label 'Ncr Status' ;
    rdfs:comment 'Current lifecycle status of the non-conformance report indicating its position in the quality management workflow from identification through resolution and closeout. [ENUM-REF-CANDIDATE: open|under_review|corrective_action_pending|corrective_action_in_progress|closed|rejected|accepted_as_is — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:NonconformanceReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nonconformanceCategory rdf:type rdf:Property ;
    rdfs:label 'Nonconformance Category' ;
    rdfs:comment 'Classification of the non-conformance by type, enabling trend analysis and root cause categorization across material defects, workmanship issues, design flaws, documentation errors, testing failures, safety violations, or environmental non-compliance. [ENUM-REF-CANDIDATE: material|workmanship|design|documentation|testing|safety|environmental|other — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:NonconformanceReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nonconformanceDescription rdf:type rdf:Property ;
    rdfs:label 'Nonconformance Description' ;
    rdfs:comment 'Detailed narrative description of the non-conformance, including what was observed, how it deviates from requirements, and the nature of the deficiency or defect.' ;
    rdfs:domain ind:NonconformanceReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preventiveAction rdf:type rdf:Property ;
    rdfs:label 'Preventive Action' ;
    rdfs:comment 'Description of preventive actions implemented to prevent recurrence of similar non-conformances in future work, such as process changes, additional training, or specification clarifications.' ;
    rdfs:domain ind:Project ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryReportableFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Reportable Flag' ;
    rdfs:comment 'Boolean indicator of whether the non-conformance must be reported to regulatory agencies such as EPA, state drinking water programs, or OSHA due to safety, environmental, or compliance implications.' ;
    rdfs:domain ind:NonconformanceReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:verifiedByName rdf:type rdf:Property ;
    rdfs:label 'Verified By Name' ;
    rdfs:comment 'Name of the inspector or engineer who verified the completion and acceptability of the corrective action.' ;
    rdfs:domain ind:Project ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commissioningActivityId rdf:type rdf:Property ;
    rdfs:label 'Commissioning Activity Id' ;
    rdfs:comment 'Unique identifier for the commissioning activity record. Primary key for this entity.' ;
    rdfs:domain ind:CommissioningActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:commissioningAssetRegistryId rdf:type rdf:Property ;
    rdfs:label 'Commissioning Asset Registry Id' ;
    rdfs:comment 'Reference to the newly constructed or rehabilitated asset (water treatment plant, wastewater treatment plant, pump station, pipeline, etc.) being commissioned.' ;
    rdfs:domain ind:CommissioningActivity ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Registry .

ind:commissioningRegistryId rdf:type rdf:Property ;
    rdfs:label 'Commissioning Registry Id' ;
    rdfs:comment 'Reference to the newly constructed or rehabilitated asset (water treatment plant, wastewater treatment plant, pump station, pipeline, etc.) being commissioned.' ;
    rdfs:domain ind:CommissioningActivity ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Registry .

ind:activityCategory rdf:type rdf:Property ;
    rdfs:label 'Activity Category' ;
    rdfs:comment 'Broader category grouping for the commissioning activity, aligning with engineering disciplines and operational domains. [ENUM-REF-CANDIDATE: mechanical|electrical|instrumentation_control|civil_structural|process|environmental|safety — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:CommissioningActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:activityCode rdf:type rdf:Property ;
    rdfs:label 'Activity Code' ;
    rdfs:comment 'Unique business identifier code for the commissioning activity, typically following organizational or project-specific numbering conventions.' ;
    rdfs:domain ind:CommissioningActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:activityDescription rdf:type rdf:Property ;
    rdfs:label 'Activity Description' ;
    rdfs:comment 'Detailed description of the commissioning activity scope, objectives, test procedures, acceptance criteria, and any special requirements or constraints.' ;
    rdfs:domain ind:CommissioningActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:activityName rdf:type rdf:Property ;
    rdfs:label 'Activity Name' ;
    rdfs:comment 'Descriptive name of the commissioning activity (e.g., \'WTP Clarifier Startup Test\', \'Distribution Main Disinfection and Flushing\', \'SCADA Integration Testing\').' ;
    rdfs:domain ind:CommissioningActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:activityStatus rdf:type rdf:Property ;
    rdfs:label 'Activity Status' ;
    rdfs:comment 'Current lifecycle status of the commissioning activity. Planned indicates not yet started. In progress indicates active testing. On hold indicates temporary suspension. Completed indicates successful finish. Cancelled indicates activity was terminated. Failed indicates activity did not meet acceptance criteria.' ;
    rdfs:domain ind:CommissioningActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commissioningStatus rdf:type rdf:Property ;
    rdfs:label 'Commissioning Status' ;
    rdfs:comment 'commissioning status for commissioning_activity' ;
    rdfs:domain ind:CommissioningActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contractorSignOffDate rdf:type rdf:Property ;
    rdfs:label 'Contractor Sign Off Date' ;
    rdfs:comment 'Date when the contractor signed off on the commissioning activity, certifying that the work meets contract requirements and specifications.' ;
    rdfs:domain ind:CommissioningActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:commissioningActivityDescription rdf:type rdf:Property ;
    rdfs:label 'Commissioning Activity Description' ;
    rdfs:comment 'Free-text description' ;
    rdfs:domain ind:CommissioningActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disinfectionContactTimeMinutes rdf:type rdf:Property ;
    rdfs:label 'Disinfection Contact Time Minutes' ;
    rdfs:comment 'Contact time in minutes for disinfection during commissioning, measured as the time the disinfectant remains in contact with the water or equipment surface. Critical for ensuring adequate microbial inactivation per EPA requirements.' ;
    rdfs:domain ind:CommissioningActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:engineerSignOffDate rdf:type rdf:Property ;
    rdfs:label 'Engineer Sign Off Date' ;
    rdfs:comment 'Date when the design engineer or commissioning engineer signed off on the activity, certifying that the installation and testing meet design intent and industry standards.' ;
    rdfs:domain ind:CommissioningActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:flowTestResultGpm rdf:type rdf:Property ;
    rdfs:label 'Flow Test Result Gpm' ;
    rdfs:comment 'Flow rate achieved during commissioning flow testing, measured in gallons per minute. Used to verify pump capacity, pipeline hydraulic performance, and treatment process flow rates.' ;
    rdfs:domain ind:CommissioningActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:operationsSignOffDate rdf:type rdf:Property ;
    rdfs:label 'Operations Sign Off Date' ;
    rdfs:comment 'Date when operations staff signed off on the commissioning activity, certifying readiness to accept the asset into operational service and assume maintenance responsibility.' ;
    rdfs:domain ind:CommissioningActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:pressureTestResultPsi rdf:type rdf:Property ;
    rdfs:label 'Pressure Test Result Psi' ;
    rdfs:comment 'Maximum pressure achieved during hydrostatic pressure testing of pipelines, tanks, or pressure vessels during commissioning. Used to verify structural integrity and leak-tightness.' ;
    rdfs:domain ind:CommissioningActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:responsibleContactEmail rdf:type rdf:Property ;
    rdfs:label 'Responsible Contact Email' ;
    rdfs:comment 'Email address of the primary contact person responsible for the commissioning activity.' ;
    rdfs:domain ind:CommissioningActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responsibleContactName rdf:type rdf:Property ;
    rdfs:label 'Responsible Contact Name' ;
    rdfs:comment 'Name of the primary contact person responsible for coordinating and executing the commissioning activity.' ;
    rdfs:domain ind:CommissioningActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responsibleContactPhone rdf:type rdf:Property ;
    rdfs:label 'Responsible Contact Phone' ;
    rdfs:comment 'Phone number of the primary contact person responsible for the commissioning activity.' ;
    rdfs:domain ind:CommissioningActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scadaIntegrationStatus rdf:type rdf:Property ;
    rdfs:label 'Scada Integration Status' ;
    rdfs:comment 'Status of SCADA system integration for the commissioned asset. Not applicable if asset does not require SCADA connectivity. Operational indicates successful integration and data flow to central control system.' ;
    rdfs:domain ind:CommissioningActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:signOffStatus rdf:type rdf:Property ;
    rdfs:label 'Sign Off Status' ;
    rdfs:comment 'Current approval status of the commissioning activity. Tracks progression through required sign-offs from contractor, engineer, and operations staff before final acceptance.' ;
    rdfs:domain ind:CommissioningActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:testProcedureReference rdf:type rdf:Property ;
    rdfs:label 'Test Procedure Reference' ;
    rdfs:comment 'Reference to the test procedure document, standard operating procedure (SOP), or industry standard that governs the commissioning activity execution (e.g., AWWA C651, manufacturer startup manual).' ;
    rdfs:domain ind:CommissioningActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waterQualitySampleCollectedFlag rdf:type rdf:Property ;
    rdfs:label 'Water Quality Sample Collected Flag' ;
    rdfs:comment 'Indicates whether water quality samples were collected during the commissioning activity for laboratory analysis (e.g., bacteriological testing after main disinfection, process performance verification).' ;
    rdfs:domain ind:CommissioningActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:assetHandoverId rdf:type rdf:Property ;
    rdfs:label 'Asset Handover Id' ;
    rdfs:comment 'Unique identifier for the asset handover record. Primary key for this entity representing the formal transfer event from project/construction to operations.' ;
    rdfs:domain ind:AssetHandover ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:acceptedByEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Accepted By Employee Id' ;
    rdfs:comment 'Accepting employee.' ;
    rdfs:domain ind:AssetHandover ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:assetContractorVendorId rdf:type rdf:Property ;
    rdfs:label 'Asset Contractor Vendor Id' ;
    rdfs:comment 'Identifier of the general contractor or construction firm that built or installed the asset.' ;
    rdfs:domain ind:AssetHandover ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Vendor .

ind:assetVendorId rdf:type rdf:Property ;
    rdfs:label 'Asset Vendor Id' ;
    rdfs:comment 'Identifier of the general contractor or construction firm that built or installed the asset.' ;
    rdfs:domain ind:AssetHandover ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Vendor .

ind:asBuiltDrawingReference rdf:type rdf:Property ;
    rdfs:label 'As Built Drawing Reference' ;
    rdfs:comment 'Document reference or hyperlink to the as-built engineering drawings reflecting the final constructed condition of the asset, stored in the document management system or GIS.' ;
    rdfs:domain ind:AssetHandover ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commissioningReportReference rdf:type rdf:Property ;
    rdfs:label 'Commissioning Report Reference' ;
    rdfs:comment 'Document reference to the commissioning report verifying that the asset has been tested, started up, and is operating according to design specifications.' ;
    rdfs:domain ind:AssetHandover ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:depreciationClass rdf:type rdf:Property ;
    rdfs:label 'Depreciation Class' ;
    rdfs:comment 'Depreciation category or class code used in SAP FI to determine useful life and depreciation method for financial reporting and rate-making purposes.' ;
    rdfs:domain ind:AssetHandover ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assetHandoverDescription rdf:type rdf:Property ;
    rdfs:label 'Asset Handover Description' ;
    rdfs:comment 'Free-text description' ;
    rdfs:domain ind:AssetHandover ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:finalAcceptanceDate rdf:type rdf:Property ;
    rdfs:label 'Final Acceptance Date' ;
    rdfs:comment 'Date when operations management formally accepted the asset after inspection and verification of all handover documentation and commissioning results.' ;
    rdfs:domain ind:Project ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:handoverDate rdf:type rdf:Property ;
    rdfs:label 'Handover Date' ;
    rdfs:comment 'The official date on which the asset was formally transferred from the project/construction team to the operations and maintenance team. This is the principal business event timestamp for this transaction.' ;
    rdfs:domain ind:AssetHandover ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:handoverNotes rdf:type rdf:Property ;
    rdfs:label 'Handover Notes' ;
    rdfs:comment 'Free-text notes documenting special conditions, outstanding issues, lessons learned, or other relevant information about the asset handover process.' ;
    rdfs:domain ind:AssetHandover ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:handoverNumber rdf:type rdf:Property ;
    rdfs:label 'Handover Number' ;
    rdfs:comment 'Business identifier or document number for this asset handover transaction, used for tracking and reference in project closeout documentation.' ;
    rdfs:domain ind:AssetHandover ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:handoverStatus rdf:type rdf:Property ;
    rdfs:label 'Handover Status' ;
    rdfs:comment 'Current lifecycle status of the asset handover process indicating workflow stage from draft through final completion and acceptance.' ;
    rdfs:domain ind:AssetHandover ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:installedCostAmount rdf:type rdf:Property ;
    rdfs:label 'Installed Cost Amount' ;
    rdfs:comment 'Total capitalized cost of the asset including construction, materials, labor, equipment, and overhead allocated for capitalization in SAP FI fixed assets module.' ;
    rdfs:domain ind:AssetHandover ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:omManualReference rdf:type rdf:Property ;
    rdfs:label 'Om Manual Reference' ;
    rdfs:comment 'Document reference or hyperlink to the Operations and Maintenance (O&M) manual provided by the contractor or equipment vendor for operational guidance.' ;
    rdfs:domain ind:AssetHandover ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:operationsAcceptanceSignature rdf:type rdf:Property ;
    rdfs:label 'Operations Acceptance Signature' ;
    rdfs:comment 'Digital signature or sign-off indicator confirming that the operations manager has formally accepted the asset and all associated documentation.' ;
    rdfs:domain ind:AssetHandover ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:operationsManagerName rdf:type rdf:Property ;
    rdfs:label 'Operations Manager Name' ;
    rdfs:comment 'Name of the operations manager or supervisor who accepted responsibility for the asset on behalf of the operations team.' ;
    rdfs:domain ind:AssetHandover ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryPermitNumber rdf:type rdf:Property ;
    rdfs:label 'Regulatory Permit Number' ;
    rdfs:comment 'Environmental or construction permit number issued by EPA, state primacy agency, or local authority authorizing the construction and operation of the asset.' ;
    rdfs:domain ind:AssetHandover ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responsibleOperationsGroup rdf:type rdf:Property ;
    rdfs:label 'Responsible Operations Group' ;
    rdfs:comment 'Name or code of the operations department, work center, or functional group that will assume ownership and maintenance responsibility for the asset (e.g., Water Treatment Operations, Distribution Maintenance).' ;
    rdfs:domain ind:AssetHandover ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:safetyCertificationFlag rdf:type rdf:Property ;
    rdfs:label 'Safety Certification Flag' ;
    rdfs:comment 'Indicator of whether the asset has received all required safety certifications and Occupational Safety and Health Administration (OSHA) compliance approvals.' ;
    rdfs:domain ind:AssetHandover ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sparePartsStockedFlag rdf:type rdf:Property ;
    rdfs:label 'Spare Parts Stocked Flag' ;
    rdfs:comment 'Indicator of whether critical spare parts for the asset have been procured and stocked in inventory for maintenance support.' ;
    rdfs:domain ind:AssetHandover ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:trainingCompletionFlag rdf:type rdf:Property ;
    rdfs:label 'Training Completion Flag' ;
    rdfs:comment 'Indicator of whether operations staff have completed all required training on the operation and maintenance of the new asset.' ;
    rdfs:domain ind:AssetHandover ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fundingSourceId rdf:type rdf:Property ;
    rdfs:label 'Funding Source Id' ;
    rdfs:comment 'Unique identifier for the funding source record. Primary key.' ;
    rdfs:domain ind:Project ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FundingSource .

ind:arraFlag rdf:type rdf:Property ;
    rdfs:label 'Arra Flag' ;
    rdfs:comment 'Indicates whether this funding source originated from ARRA (American Recovery and Reinvestment Act) stimulus funding. True if ARRA funding; False otherwise. ARRA funds had additional reporting and Buy American requirements.' ;
    rdfs:domain ind:FundingSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:availableBalance rdf:type rdf:Property ;
    rdfs:label 'Available Balance' ;
    rdfs:comment 'Remaining unallocated funding available for new project assignments. Calculated as total_authorized_amount minus allocated_amount.' ;
    rdfs:domain ind:FundingSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bondInsuranceProvider rdf:type rdf:Property ;
    rdfs:label 'Bond Insurance Provider' ;
    rdfs:comment 'Name of the insurance company providing credit enhancement for bond issues. Bond insurance guarantees payment and can improve credit rating. Null if no insurance or not applicable.' ;
    rdfs:domain ind:FundingSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:buyAmericanRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Buy American Required Flag' ;
    rdfs:comment 'Indicates whether projects funded by this source must comply with Buy American provisions requiring use of domestically produced iron, steel, and manufactured goods. True if Buy American applies; False otherwise. Common for federal funding.' ;
    rdfs:domain ind:FundingSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fundingSourceCode rdf:type rdf:Property ;
    rdfs:label 'Funding Source Code' ;
    rdfs:comment 'Unique business identifier code for the funding source used in financial systems and project documentation. Examples: DWSRF-2024-001, GOB-2023-SERIES-A, WIFIA-2025-LOAN.' ;
    rdfs:domain ind:FundingSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:davisBaconRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Davis Bacon Required Flag' ;
    rdfs:comment 'Indicates whether projects funded by this source must comply with Davis-Bacon prevailing wage requirements. True if Davis-Bacon applies; False otherwise. Typically required for federal grants and some SRF loans.' ;
    rdfs:domain ind:Project ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fundingSourceDescription rdf:type rdf:Property ;
    rdfs:label 'Funding Source Description' ;
    rdfs:comment 'Free-text description' ;
    rdfs:domain ind:FundingSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disadvantagedCommunityFlag rdf:type rdf:Property ;
    rdfs:label 'Disadvantaged Community Flag' ;
    rdfs:comment 'Indicates whether this funding source is specifically designated for disadvantaged communities (typically defined by median household income thresholds). True if designated for disadvantaged communities; False otherwise. Affects eligibility for principal forgiveness and subsidized rates.' ;
    rdfs:domain ind:FundingSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:drawdownRestrictions rdf:type rdf:Property ;
    rdfs:label 'Drawdown Restrictions' ;
    rdfs:comment 'Description of limitations or conditions on fund disbursement. Examples: \'Reimbursement only after costs incurred; Requires pre-approval for each draw; Maximum monthly draw limit; Construction milestone-based disbursement; Retainage held until project completion\'.' ;
    rdfs:domain ind:FundingSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eligibleProjectTypes rdf:type rdf:Property ;
    rdfs:label 'Eligible Project Types' ;
    rdfs:comment 'Comma-separated list or description of CIP project types eligible for funding from this source. Examples: \'Water Treatment Plant Expansion, Distribution System Rehabilitation, Lead Service Line Replacement\' or \'Wastewater Treatment Upgrades, CSO (Combined Sewer Overflow) Abatement, Green Infrastructure\'. DWSRF (Drinking Water SRF) and CWSRF (Clean Water SRF) have specific eligible use categories.' ;
    rdfs:domain ind:FundingSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:finalMaturityDate rdf:type rdf:Property ;
    rdfs:label 'Final Maturity Date' ;
    rdfs:comment 'Date when all principal and interest must be fully repaid for debt instruments. Null for grants and PAYGO funding.' ;
    rdfs:domain ind:FundingSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:fundingStatus rdf:type rdf:Property ;
    rdfs:label 'Funding Status' ;
    rdfs:comment 'Current lifecycle status of the funding source. Available: funds can be allocated to projects; Committed: allocated but not yet disbursed; Fully Allocated: no remaining capacity; Closed: program ended; Suspended: temporarily unavailable; Pending Approval: awaiting authorization.' ;
    rdfs:domain ind:FundingSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fundingType rdf:type rdf:Property ;
    rdfs:label 'Funding Type' ;
    rdfs:comment 'Funding type.' ;
    rdfs:domain ind:FundingSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:greenProjectReserveFlag rdf:type rdf:Property ;
    rdfs:label 'Green Project Reserve Flag' ;
    rdfs:comment 'Indicates whether this funding source is part of the Green Project Reserve, which prioritizes environmentally innovative projects (green infrastructure, water efficiency, energy efficiency). True if GPR funding; False otherwise. SRF programs must allocate at least 10% to GPR projects.' ;
    rdfs:domain ind:FundingSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:matchRequirementPercentage rdf:type rdf:Property ;
    rdfs:label 'Match Requirement Percentage' ;
    rdfs:comment 'Percentage of project cost that must be funded from other sources (local match). For example, a 20% match means the utility must provide 20% and the funding source covers 80%. Zero for funding sources with no match requirement. Common for federal grants.' ;
    rdfs:domain ind:FundingSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fundingSourceName rdf:type rdf:Property ;
    rdfs:label 'Funding Source Name' ;
    rdfs:comment 'Full descriptive name of the funding source including program name, series, and year. Example: \'Drinking Water State Revolving Fund 2024 Series A\' or \'General Obligation Bond 2023 Infrastructure Series\'.' ;
    rdfs:domain ind:FundingSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:prepaymentAllowedFlag rdf:type rdf:Property ;
    rdfs:label 'Prepayment Allowed Flag' ;
    rdfs:comment 'Indicates whether early repayment of principal is permitted without penalty for debt instruments. True if prepayment allowed; False if prepayment prohibited or penalized. Null for non-debt funding.' ;
    rdfs:domain ind:FundingSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:prepaymentPenaltyPercentage rdf:type rdf:Property ;
    rdfs:label 'Prepayment Penalty Percentage' ;
    rdfs:comment 'Percentage penalty charged for early repayment if prepayment is restricted. Zero if no penalty applies. Null for non-debt funding or if prepayment is not allowed.' ;
    rdfs:domain ind:FundingSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:principalForgivenessPercentage rdf:type rdf:Property ;
    rdfs:label 'Principal Forgiveness Percentage' ;
    rdfs:comment 'Percentage of loan principal that is forgiven (does not require repayment). Common in SRF programs for disadvantaged communities or specific project types (e.g., lead service line replacement). Zero if no forgiveness applies.' ;
    rdfs:domain ind:FundingSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reportingRequirements rdf:type rdf:Property ;
    rdfs:label 'Reporting Requirements' ;
    rdfs:comment 'Detailed description of reporting obligations including report types, submission deadlines, and required content. Examples: \'Quarterly progress reports due 30 days after quarter end; Annual financial audit; DBE (Disadvantaged Business Enterprise) utilization reports; Environmental compliance certifications\'.' ;
    rdfs:domain ind:FundingSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:termMonths rdf:type rdf:Property ;
    rdfs:label 'Term Months' ;
    rdfs:comment 'Total term or duration of the funding instrument in months. For bonds and loans, this is the repayment period. SRF loans typically have 20-30 year terms (240-360 months). Null for grants and PAYGO (pay-as-you-go) funding.' ;
    rdfs:domain ind:FundingSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:totalAuthorizedAmount rdf:type rdf:Property ;
    rdfs:label 'Total Authorized Amount' ;
    rdfs:comment 'Total funding amount authorized or available under this funding source. For bonds, this is the par value; for loans, the principal amount; for grants, the award amount; for PAYGO, the budgeted reserve allocation.' ;
    rdfs:domain ind:FundingSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalCommittedAmount rdf:type rdf:Property ;
    rdfs:label 'Total Committed Amount' ;
    rdfs:comment 'total committed amount for funding_source' ;
    rdfs:domain ind:FundingSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fundingAllocationId rdf:type rdf:Property ;
    rdfs:label 'Funding Allocation Id' ;
    rdfs:comment 'Unique identifier for the project funding allocation record. Primary key for this association entity linking a Capital Improvement Program (CIP) project to a specific funding source.' ;
    rdfs:domain ind:FundingAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:americanIronSteelRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'American Iron Steel Required Flag' ;
    rdfs:comment 'Indicates whether American Iron and Steel requirements apply to materials procured with this funding allocation. Mandated for State Revolving Fund (SRF) and many federal grant programs.' ;
    rdfs:domain ind:FundingAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:conditionsPrecedent rdf:type rdf:Property ;
    rdfs:label 'Conditions Precedent' ;
    rdfs:comment 'Description of conditions that must be satisfied before funds from this allocation may be drawn. May include regulatory approvals, environmental clearances, matching fund requirements, or other prerequisites imposed by the funding source.' ;
    rdfs:domain ind:FundingAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conditionsPrecedentMetDate rdf:type rdf:Property ;
    rdfs:label 'Conditions Precedent Met Date' ;
    rdfs:comment 'Date when all conditions precedent were satisfied and the allocation became available for drawdown. Establishes the start of the active funding period.' ;
    rdfs:domain ind:FundingAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:conditionsPrecedentMetFlag rdf:type rdf:Property ;
    rdfs:label 'Conditions Precedent Met Flag' ;
    rdfs:comment 'Indicates whether all conditions precedent have been satisfied and the allocation is available for drawdown. True when all prerequisites are met; false when conditions remain outstanding.' ;
    rdfs:domain ind:FundingAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fundingAllocationDescription rdf:type rdf:Property ;
    rdfs:label 'Funding Allocation Description' ;
    rdfs:comment 'Free-text description' ;
    rdfs:domain ind:FundingAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:forgivenessAmount rdf:type rdf:Property ;
    rdfs:label 'Forgiveness Amount' ;
    rdfs:comment 'Dollar amount of principal forgiveness granted as part of this funding allocation. Common in State Revolving Fund (SRF) programs for disadvantaged communities or green infrastructure projects.' ;
    rdfs:domain ind:FundingAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:forgivenessPercentage rdf:type rdf:Property ;
    rdfs:label 'Forgiveness Percentage' ;
    rdfs:comment 'Percentage of the allocation amount that is forgiven and does not require repayment. Represents the grant portion of a subsidized loan.' ;
    rdfs:domain ind:FundingAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fundingAgencyContactEmail rdf:type rdf:Property ;
    rdfs:label 'Funding Agency Contact Email' ;
    rdfs:comment 'Email address of the primary contact person at the funding agency. Used for submitting reports and coordinating drawdown requests.' ;
    rdfs:domain ind:FundingAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fundingAgencyContactName rdf:type rdf:Property ;
    rdfs:label 'Funding Agency Contact Name' ;
    rdfs:comment 'Name of the primary contact person at the funding agency responsible for administering this allocation. Used for coordination and compliance reporting.' ;
    rdfs:domain ind:FundingAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fundingAgencyContactPhone rdf:type rdf:Property ;
    rdfs:label 'Funding Agency Contact Phone' ;
    rdfs:comment 'Phone number of the primary contact person at the funding agency. Used for coordination and issue resolution.' ;
    rdfs:domain ind:FundingAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fundingPriorityRank rdf:type rdf:Property ;
    rdfs:label 'Funding Priority Rank' ;
    rdfs:comment 'Priority ranking of this funding allocation relative to other allocations for the same project. Lower numbers indicate higher priority for drawdown when multiple sources are available.' ;
    rdfs:domain ind:FundingAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:grantAgreementNumber rdf:type rdf:Property ;
    rdfs:label 'Grant Agreement Number' ;
    rdfs:comment 'Official agreement or contract number assigned by the funding agency for grant-based allocations. Used for tracking and reporting to federal and state agencies.' ;
    rdfs:domain ind:FundingAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ineligibleCostCategories rdf:type rdf:Property ;
    rdfs:label 'Ineligible Cost Categories' ;
    rdfs:comment 'Description of project cost categories that are explicitly ineligible for reimbursement from this funding allocation. Common exclusions include administrative overhead, legal fees, or operations and maintenance (O&M) costs.' ;
    rdfs:domain ind:FundingAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:loanAgreementNumber rdf:type rdf:Property ;
    rdfs:label 'Loan Agreement Number' ;
    rdfs:comment 'Official loan agreement or promissory note number assigned by the lending institution for loan-based allocations. Used for tracking State Revolving Fund (SRF) and other loan programs.' ;
    rdfs:domain ind:FundingAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:matchingAmount rdf:type rdf:Property ;
    rdfs:label 'Matching Amount' ;
    rdfs:comment 'Dollar amount of matching funds required from other sources to satisfy the matching requirement for this allocation.' ;
    rdfs:domain ind:FundingAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:matchingPercentage rdf:type rdf:Property ;
    rdfs:label 'Matching Percentage' ;
    rdfs:comment 'Required percentage of project cost that must be funded from other sources to satisfy matching requirements. Common for federal and state grant programs.' ;
    rdfs:domain ind:FundingAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:matchingRequirementFlag rdf:type rdf:Property ;
    rdfs:label 'Matching Requirement Flag' ;
    rdfs:comment 'Indicates whether this funding allocation requires matching funds from other sources. True for grants and loans with local match requirements; false for fully-funded allocations.' ;
    rdfs:domain ind:FundingAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reimbursementBasis rdf:type rdf:Property ;
    rdfs:label 'Reimbursement Basis' ;
    rdfs:comment 'Method by which drawdown requests are calculated and approved. Determines whether reimbursements are based on actual incurred costs, percentage of work complete, achievement of milestones, or advance payments.' ;
    rdfs:domain ind:FundingAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:landAcquisitionId rdf:type rdf:Property ;
    rdfs:label 'Land Acquisition Id' ;
    rdfs:comment 'Unique identifier for the land acquisition record. Primary key for the land acquisition entity.' ;
    rdfs:domain ind:LandAcquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:acquisitionAgentEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Acquisition Agent Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: Land acquisition agents are utility real estate staff. Tracking which employee manages property negotiations, appraisals, and eminent domain proceedings is essential for legal accountability, audit tr' ;
    rdfs:domain ind:LandAcquisition ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:acquisitionAmount rdf:type rdf:Property ;
    rdfs:label 'Acquisition Amount' ;
    rdfs:comment 'Acquisition cost.' ;
    rdfs:domain ind:LandAcquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:acquisitionNotes rdf:type rdf:Property ;
    rdfs:label 'Acquisition Notes' ;
    rdfs:comment 'Free-text notes documenting negotiation history, special conditions, owner concerns, unique circumstances, or other relevant information about the acquisition process.' ;
    rdfs:domain ind:LandAcquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:acquisitionNumber rdf:type rdf:Property ;
    rdfs:label 'Acquisition Number' ;
    rdfs:domain ind:LandAcquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:acquisitionPriority rdf:type rdf:Property ;
    rdfs:label 'Acquisition Priority' ;
    rdfs:comment 'Priority level for completing this acquisition based on project schedule criticality and construction sequencing requirements.' ;
    rdfs:domain ind:LandAcquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:acquisitionPurpose rdf:type rdf:Property ;
    rdfs:label 'Acquisition Purpose' ;
    rdfs:comment 'Detailed description of why this property acquisition is required for the CIP project. Examples: water main installation, treatment plant expansion, pump station construction, access road, permanent facility site.' ;
    rdfs:domain ind:LandAcquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appraisalDate rdf:type rdf:Property ;
    rdfs:label 'Appraisal Date' ;
    rdfs:comment 'Date when the certified appraisal was completed by a qualified real estate appraiser, establishing fair market value for just compensation purposes.' ;
    rdfs:domain ind:LandAcquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:appraisedValueAmount rdf:type rdf:Property ;
    rdfs:label 'Appraised Value Amount' ;
    rdfs:comment 'Fair market value of the property interest as determined by a certified real estate appraiser. Establishes baseline for just compensation under eminent domain law.' ;
    rdfs:domain ind:LandAcquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:appraiserName rdf:type rdf:Property ;
    rdfs:label 'Appraiser Name' ;
    rdfs:comment 'Name of the certified real estate appraiser who performed the property valuation. Used for documentation and potential testimony in condemnation proceedings.' ;
    rdfs:domain ind:LandAcquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:condemnationFilingDate rdf:type rdf:Property ;
    rdfs:label 'Condemnation Filing Date' ;
    rdfs:comment 'Date when the utility filed a condemnation petition or complaint with the court to acquire the property through eminent domain. Null if voluntary acquisition was successful.' ;
    rdfs:domain ind:LandAcquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:condemnationFlag rdf:type rdf:Property ;
    rdfs:label 'Condemnation Flag' ;
    rdfs:domain ind:LandAcquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:courtCaseNumber rdf:type rdf:Property ;
    rdfs:label 'Court Case Number' ;
    rdfs:comment 'Official court case number assigned to the eminent domain condemnation proceeding. Used for tracking legal proceedings and court-ordered compensation.' ;
    rdfs:domain ind:LandAcquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deedBookReference rdf:type rdf:Property ;
    rdfs:label 'Deed Book Reference' ;
    rdfs:comment 'Official recording reference including deed book number and page number where the instrument is recorded in county land records. Format varies by jurisdiction (e.g., Book 1234, Page 567 or Document Number 2023-12345).' ;
    rdfs:domain ind:LandAcquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deedRecordingDate rdf:type rdf:Property ;
    rdfs:label 'Deed Recording Date' ;
    rdfs:comment 'Date when the deed, easement, or other property instrument was officially recorded with the county recorder\'s office, completing the legal transfer of property rights.' ;
    rdfs:domain ind:LandAcquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:deedReference rdf:type rdf:Property ;
    rdfs:label 'Deed Reference' ;
    rdfs:domain ind:LandAcquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:landAcquisitionDescription rdf:type rdf:Property ;
    rdfs:label 'Land Acquisition Description' ;
    rdfs:comment 'Free-text description' ;
    rdfs:domain ind:LandAcquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:easementType rdf:type rdf:Property ;
    rdfs:label 'Easement Type' ;
    rdfs:domain ind:LandAcquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eminentDomainFlag rdf:type rdf:Property ;
    rdfs:label 'Eminent Domain Flag' ;
    rdfs:comment 'Indicates whether eminent domain (condemnation) proceedings were initiated or required because voluntary acquisition negotiations failed. True if condemnation was filed; false if acquired through voluntary negotiation.' ;
    rdfs:domain ind:LandAcquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:environmentalAssessmentStatus rdf:type rdf:Property ;
    rdfs:label 'Environmental Assessment Status' ;
    rdfs:comment 'Status of Phase I or Phase II environmental site assessment to identify potential contamination, hazardous materials, or environmental liabilities on the property.' ;
    rdfs:domain ind:LandAcquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:environmentalFindingsSummary rdf:type rdf:Property ;
    rdfs:label 'Environmental Findings Summary' ;
    rdfs:comment 'Summary of environmental assessment findings including any recognized environmental conditions, contamination, or remediation requirements that affect property value or acquisition feasibility.' ;
    rdfs:domain ind:LandAcquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:infrastructureAssetType rdf:type rdf:Property ;
    rdfs:label 'Infrastructure Asset Type' ;
    rdfs:comment 'Type of water or wastewater infrastructure asset that will be constructed on or require this acquired property. [ENUM-REF-CANDIDATE: water_main|transmission_main|distribution_main|pump_station|treatment_plant|storage_tank|well_site|access_road|utility_corridor — 9 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:LandAcquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:justCompensationAward rdf:type rdf:Property ;
    rdfs:label 'Just Compensation Award' ;
    rdfs:comment 'Final compensation amount awarded by the court in condemnation proceedings. Represents the court\'s determination of just compensation under the Fifth Amendment.' ;
    rdfs:domain ind:LandAcquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:negotiatedAcquisitionCost rdf:type rdf:Property ;
    rdfs:label 'Negotiated Acquisition Cost' ;
    rdfs:comment 'Final negotiated purchase price or compensation amount agreed upon between the utility and property owner. May differ from appraised value based on negotiation outcomes.' ;
    rdfs:domain ind:LandAcquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:negotiatedPriceAmount rdf:type rdf:Property ;
    rdfs:label 'Negotiated Price Amount' ;
    rdfs:domain ind:LandAcquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:offerDate rdf:type rdf:Property ;
    rdfs:label 'Offer Date' ;
    rdfs:comment 'Date when the utility made its initial written offer to purchase or acquire the property interest from the owner.' ;
    rdfs:domain ind:LandAcquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:parcelAreaAcres rdf:type rdf:Property ;
    rdfs:label 'Parcel Area Acres' ;
    rdfs:comment 'Total area of the parcel or portion being acquired, measured in acres. Used for valuation and compensation calculations.' ;
    rdfs:domain ind:LandAcquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:parcelAreaSquareFeet rdf:type rdf:Property ;
    rdfs:label 'Parcel Area Square Feet' ;
    rdfs:comment 'Total area of the parcel or portion being acquired, measured in square feet. Provides precise measurement for engineering and legal documentation.' ;
    rdfs:domain ind:LandAcquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:propertyOwnerContactAddress rdf:type rdf:Property ;
    rdfs:label 'Property Owner Contact Address' ;
    rdfs:comment 'Mailing address for the property owner used for official correspondence, notices, and negotiation communications.' ;
    rdfs:domain ind:LandAcquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:propertyOwnerEmail rdf:type rdf:Property ;
    rdfs:label 'Property Owner Email' ;
    rdfs:comment 'Email address for electronic communication with the property owner regarding acquisition matters.' ;
    rdfs:domain ind:LandAcquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:propertyOwnerPhone rdf:type rdf:Property ;
    rdfs:label 'Property Owner Phone' ;
    rdfs:comment 'Primary telephone number for contacting the property owner during acquisition negotiations.' ;
    rdfs:domain ind:LandAcquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:propertyUseType rdf:type rdf:Property ;
    rdfs:label 'Property Use Type' ;
    rdfs:comment 'Current use classification of the property being acquired. Affects valuation methodology, relocation assistance requirements, and environmental assessment scope. [ENUM-REF-CANDIDATE: residential|commercial|industrial|agricultural|vacant_land|government|institutional — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:LandAcquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relocationAssistanceAmount rdf:type rdf:Property ;
    rdfs:label 'Relocation Assistance Amount' ;
    rdfs:comment 'Estimated or actual cost of relocation assistance benefits owed to displaced persons or businesses under the Uniform Relocation Assistance Act. Includes moving expenses, replacement housing payments, and business re-establishment costs.' ;
    rdfs:domain ind:LandAcquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:relocationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Relocation Required Flag' ;
    rdfs:domain ind:LandAcquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:surveyCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Survey Completion Date' ;
    rdfs:comment 'Date when the professional land survey was completed, establishing precise legal boundaries, area measurements, and identifying any encroachments or easements.' ;
    rdfs:domain ind:LandAcquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:titleCompanyName rdf:type rdf:Property ;
    rdfs:label 'Title Company Name' ;
    rdfs:domain ind:LandAcquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:titleIssuesDescription rdf:type rdf:Property ;
    rdfs:label 'Title Issues Description' ;
    rdfs:comment 'Detailed description of any title defects, liens, mortgages, easements, or other encumbrances discovered during title examination that must be resolved before acquisition.' ;
    rdfs:domain ind:LandAcquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:titleSearchStatus rdf:type rdf:Property ;
    rdfs:label 'Title Search Status' ;
    rdfs:comment 'Status of the title search and examination process to verify clear ownership and identify any liens, encumbrances, or defects that could affect acquisition.' ;
    rdfs:domain ind:LandAcquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskId rdf:type rdf:Property ;
    rdfs:label 'Risk Id' ;
    rdfs:comment 'Primary key' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ownerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Owner Employee Id' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:primaryRiskOwnerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Risk Owner Employee Id' ;
    rdfs:comment 'FK to risk owner' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:contaminantOfConcern rdf:type rdf:Property ;
    rdfs:label 'Contaminant Of Concern' ;
    rdfs:comment 'Primary contaminant driving this risk (e.g. PFOA, lead, Cryptosporidium).' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contingencyPlan rdf:type rdf:Property ;
    rdfs:label 'Contingency Plan' ;
    rdfs:comment 'Contingency if risk realizes' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costImpactEstimate rdf:type rdf:Property ;
    rdfs:label 'Cost Impact Estimate' ;
