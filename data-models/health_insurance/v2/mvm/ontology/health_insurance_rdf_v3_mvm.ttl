    rdfs:comment 'Date when delivery of the card was confirmed.' ;
    rdfs:domain ind:IdCard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:deliveryMethod rdf:type rdf:Property ;
    rdfs:label 'Delivery Method' ;
    rdfs:comment 'Method used to deliver the card to the member.' ;
    rdfs:domain ind:HealthInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expirationDate rdf:type rdf:Property ;
    rdfs:label 'Expiration Date' ;
    rdfs:comment 'Date after which the card is no longer valid.' ;
    rdfs:domain ind:HealthInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:externalSystemCode rdf:type rdf:Property ;
    rdfs:label 'External System Code' ;
    rdfs:comment 'Identifier of the card record in the source operational system (e.g., Facets).' ;
    rdfs:domain ind:IdCard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:idCardStatus rdf:type rdf:Property ;
    rdfs:label 'Id Card Status' ;
    rdfs:comment 'Current lifecycle status of the card.' ;
    rdfs:domain ind:IdCard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:issueDate rdf:type rdf:Property ;
    rdfs:label 'Issue Date' ;
    rdfs:comment 'Date the card was originally issued to the member.' ;
    rdfs:domain ind:HealthInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastStatusChangeTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Status Change Timestamp' ;
    rdfs:comment 'Timestamp when the card status last changed.' ;
    rdfs:domain ind:HealthInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:magneticStripeData rdf:type rdf:Property ;
    rdfs:label 'Magnetic Stripe Data' ;
    rdfs:comment 'Data encoded on the magnetic stripe of the physical card.' ;
    rdfs:domain ind:IdCard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pharmacyBin rdf:type rdf:Property ;
    rdfs:label 'Pharmacy Bin' ;
    rdfs:comment 'Bank Identification Number for pharmacy benefits.' ;
    rdfs:domain ind:IdCard ;
    rdf:type owl:DatatypeProperty ;
