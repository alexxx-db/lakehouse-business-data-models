    rdfs:label 'Rpm Enrollment' ;
    rdfs:comment 'RPM program enrollment and alert thresholds' .

ind:RpmDevice rdf:type rdfs:Class ;
    rdfs:subClassOf ind:DigitalHealth ;
    rdfs:label 'Rpm Device' ;
    rdfs:comment 'RPM device registered to a patient for remote monitoring.' .

ind:AlertThreshold rdf:type rdfs:Class ;
    rdfs:subClassOf ind:DigitalHealth ;
    rdfs:label 'Alert Threshold' ;
    rdfs:comment 'RPM alert threshold defining escalation bounds for a monitored reading type.' .

ind:PromInstrument rdf:type rdfs:Class ;
    rdfs:subClassOf ind:DigitalHealth ;
    rdfs:label 'Prom Instrument' ;
    rdfs:comment 'Patient-reported outcome measure instrument definition (e.g. PROMIS, PHQ-9).' .

ind:DeviceAlertThreshold rdf:type rdfs:Class ;
    rdfs:subClassOf ind:DigitalHealth ;
    rdfs:label 'Device Alert Threshold' ;
    rdfs:comment 'Alert thresholds for RPM device readings.' .

ind:GeneticVariant rdf:type rdfs:Class ;
