ind:registrationStatus rdf:type rdf:Property ;
    rdfs:label 'Registration Status' ;
    rdfs:comment 'Current lifecycle state of the design registration.' ;
    rdfs:domain ind:DesignRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:signatoryContactId rdf:type rdf:Property ;
    rdfs:label 'Signatory Contact Id' ;
    rdfs:comment 'Foreign key linking to customer.contact. Business justification: NDA agreements are executed by specific named contacts (signatories). The nda_agreement table currently stores signatory_name, signatory_email, and signatory_phone as denormalized string columns — the' ;
    rdfs:domain ind:NdaAgreement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Contact .

ind:agreementNumber rdf:type rdf:Property ;
    rdfs:label 'Agreement Number' ;
    rdfs:comment 'External reference number or code assigned to the NDA by the legal or sales organization.' ;
    rdfs:domain ind:Semiconductors ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceRequirements rdf:type rdf:Property ;
    rdfs:label 'Compliance Requirements' ;
    rdfs:comment 'List of regulatory or contractual compliance obligations referenced in the NDA (e.g., ITAR, EAR, GDPR).' ;
    rdfs:domain ind:NdaAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:confidentialityLevel rdf:type rdf:Property ;
    rdfs:label 'Confidentiality Level' ;
    rdfs:comment 'Classification of the NDA\'s sensitivity as defined by corporate data governance.' ;
    rdfs:domain ind:Semiconductors ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentReferenceCode rdf:type rdf:Property ;
    rdfs:label 'Document Reference Code' ;
    rdfs:comment 'Identifier linking to the stored NDA document in the document management system.' ;
    rdfs:domain ind:NdaAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:executionDate rdf:type rdf:Property ;
    rdfs:label 'Execution Date' ;
    rdfs:comment 'Date the NDA was signed by the authorized signatory.' ;
    rdfs:domain ind:NdaAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:jurisdiction rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction' ;
    rdfs:comment 'ISO-3166-1 alpha-3 country code representing the legal jurisdiction governing the NDA.' ;
    rdfs:domain ind:NdaAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalEntityName rdf:type rdf:Property ;
    rdfs:label 'Legal Entity Name' ;
    rdfs:comment 'Official legal name of the customer organization bound by the NDA.' ;
    rdfs:domain ind:NdaAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ndaAgreementStatus rdf:type rdf:Property ;
    rdfs:label 'Nda Agreement Status' ;
    rdfs:comment 'Current lifecycle state of the NDA agreement.' ;
    rdfs:domain ind:NdaAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ndaType rdf:type rdf:Property ;
    rdfs:label 'Nda Type' ;
    rdfs:comment 'Indicates whether the NDA is mutual (both parties exchange confidential information) or one-way (only the semiconductor company shares information).' ;
    rdfs:domain ind:NdaAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:renewalNoticeDate rdf:type rdf:Property ;
    rdfs:label 'Renewal Notice Date' ;
    rdfs:comment 'Date on which a renewal notice must be sent to the customer before expiry.' ;
    rdfs:domain ind:NdaAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:scopeDescription rdf:type rdf:Property ;
    rdfs:label 'Scope Description' ;
    rdfs:comment 'Free-text description of the technology, roadmap, pricing, or other information covered by the NDA.' ;
    rdfs:domain ind:NdaAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:terminationReason rdf:type rdf:Property ;
    rdfs:label 'Termination Reason' ;
    rdfs:comment 'Reason provided for early termination of the NDA, if applicable.' ;
    rdfs:domain ind:Semiconductors ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:creditProfileId rdf:type rdf:Property ;
    rdfs:label 'Credit Profile Id' ;
    rdfs:comment 'Unique identifier for the credit profile record.' ;
    rdfs:domain ind:Semiconductors ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CreditProfile .

ind:primaryContactId rdf:type rdf:Property ;
    rdfs:label 'Primary Contact Id' ;
    rdfs:comment 'Foreign key linking to customer.contact. Business justification: Credit profiles have a designated primary contact (typically the customer\'s finance or procurement contact responsible for credit matters). The credit_profile table currently stores primary_contact_em' ;
    rdfs:domain ind:CreditProfile ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Contact .

ind:complianceFlag rdf:type rdf:Property ;
    rdfs:label 'Compliance Flag' ;
    rdfs:comment 'Indicates if the credit profile is subject to any regulatory hold or review.' ;
    rdfs:domain ind:Semiconductors ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:creditAnalystNotes rdf:type rdf:Property ;
    rdfs:label 'Credit Analyst Notes' ;
    rdfs:comment 'Free-form notes entered by the credit analyst.' ;
    rdfs:domain ind:CreditProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:creditHold rdf:type rdf:Property ;
    rdfs:label 'Credit Hold' ;
    rdfs:comment 'Indicates whether the customer\'s credit is currently on hold.' ;
    rdfs:domain ind:CreditProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:creditHoldReason rdf:type rdf:Property ;
    rdfs:label 'Credit Hold Reason' ;
    rdfs:comment 'Reason for placing the customer\'s credit on hold.' ;
    rdfs:domain ind:CreditProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:creditLimitAdjustmentAmount rdf:type rdf:Property ;
    rdfs:label 'Credit Limit Adjustment Amount' ;
    rdfs:comment 'Amount by which the credit limit was adjusted.' ;
    rdfs:domain ind:CreditProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:creditLimitAdjustmentDate rdf:type rdf:Property ;
    rdfs:label 'Credit Limit Adjustment Date' ;
    rdfs:comment 'Date when the credit limit adjustment took effect.' ;
    rdfs:domain ind:CreditProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:creditLimitAdjustmentReason rdf:type rdf:Property ;
    rdfs:label 'Credit Limit Adjustment Reason' ;
    rdfs:comment 'Reason for the most recent credit limit change.' ;
    rdfs:domain ind:CreditProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:creditLimitAmount rdf:type rdf:Property ;
    rdfs:label 'Credit Limit Amount' ;
    rdfs:comment 'Maximum credit amount approved for the customer.' ;
    rdfs:domain ind:CreditProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:creditLimitCurrency rdf:type rdf:Property ;
    rdfs:label 'Credit Limit Currency' ;
    rdfs:comment 'Currency of the credit limit (ISO 4217 three-letter code).' ;
    rdfs:domain ind:CreditProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:creditLimitEffectiveFrom rdf:type rdf:Property ;
    rdfs:label 'Credit Limit Effective From' ;
    rdfs:comment 'Date when the current credit limit became effective.' ;
    rdfs:domain ind:CreditProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:creditLimitEffectiveUntil rdf:type rdf:Property ;
    rdfs:label 'Credit Limit Effective Until' ;
    rdfs:comment 'Date when the current credit limit expires (null if open-ended).' ;
    rdfs:domain ind:CreditProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:creditProfileStatus rdf:type rdf:Property ;
    rdfs:label 'Credit Profile Status' ;
    rdfs:comment 'Current lifecycle status of the credit profile.' ;
    rdfs:domain ind:CreditProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:creditProfileType rdf:type rdf:Property ;
    rdfs:label 'Credit Profile Type' ;
    rdfs:comment 'Category of the credit profile based on internal risk segmentation.' ;
    rdfs:domain ind:CreditProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:creditRatingExternal rdf:type rdf:Property ;
    rdfs:label 'Credit Rating External' ;
    rdfs:comment 'External credit rating from a third-party agency.' ;
    rdfs:domain ind:CreditProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:creditRatingInternal rdf:type rdf:Property ;
    rdfs:label 'Credit Rating Internal' ;
    rdfs:comment 'Internal credit rating assigned by the company.' ;
    rdfs:domain ind:CreditProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:creditReviewDate rdf:type rdf:Property ;
    rdfs:label 'Credit Review Date' ;
    rdfs:comment 'Date of the most recent credit review.' ;
    rdfs:domain ind:CreditProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:creditReviewNotes rdf:type rdf:Property ;
    rdfs:label 'Credit Review Notes' ;
    rdfs:comment 'Analyst comments from the latest credit review.' ;
    rdfs:domain ind:CreditProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:creditReviewOutcome rdf:type rdf:Property ;
    rdfs:label 'Credit Review Outcome' ;
    rdfs:comment 'Result of the most recent credit review.' ;
    rdfs:domain ind:CreditProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:creditScore rdf:type rdf:Property ;
    rdfs:label 'Credit Score' ;
    rdfs:comment 'Numerical credit score from an external scoring model.' ;
    rdfs:domain ind:CreditProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:creditScoreDate rdf:type rdf:Property ;
    rdfs:label 'Credit Score Date' ;
    rdfs:comment 'Date when the credit score was obtained.' ;
    rdfs:domain ind:CreditProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:creditScoreSource rdf:type rdf:Property ;
    rdfs:label 'Credit Score Source' ;
    rdfs:comment 'Source of the credit score (e.g., Equifax, Experian).' ;
    rdfs:domain ind:CreditProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:creditUtilizationPct rdf:type rdf:Property ;
    rdfs:label 'Credit Utilization Pct' ;
    rdfs:comment 'Percentage of the credit limit currently utilized.' ;
    rdfs:domain ind:CreditProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:externalRatingAgency rdf:type rdf:Property ;
    rdfs:label 'External Rating Agency' ;
    rdfs:comment 'Name of the external agency providing the credit rating.' ;
    rdfs:domain ind:CreditProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isPreferredCustomer rdf:type rdf:Property ;
    rdfs:label 'Is Preferred Customer' ;
    rdfs:comment 'Indicates whether the customer is marked as a preferred partner.' ;
    rdfs:domain ind:CreditProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:outstandingBalance rdf:type rdf:Property ;
    rdfs:label 'Outstanding Balance' ;
    rdfs:comment 'Current unpaid balance owed by the customer.' ;
    rdfs:domain ind:CreditProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:overdueAmount rdf:type rdf:Property ;
    rdfs:label 'Overdue Amount' ;
    rdfs:comment 'Amount past due beyond the agreed payment terms.' ;
    rdfs:domain ind:CreditProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:preferredCustomerReason rdf:type rdf:Property ;
    rdfs:label 'Preferred Customer Reason' ;
    rdfs:comment 'Business justification for preferred customer status.' ;
    rdfs:domain ind:CreditProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:profileName rdf:type rdf:Property ;
    rdfs:label 'Profile Name' ;
    rdfs:comment 'Human-readable name for the credit profile (e.g., "Standard Credit Profile").' ;
    rdfs:domain ind:CreditProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ratingDate rdf:type rdf:Property ;
    rdfs:label 'Rating Date' ;
    rdfs:comment 'Date when the external credit rating was issued.' ;
    rdfs:domain ind:CreditProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:riskCategory rdf:type rdf:Property ;
    rdfs:label 'Risk Category' ;
    rdfs:comment 'Overall risk classification derived from credit metrics.' ;
    rdfs:domain ind:CreditProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:statusDate rdf:type rdf:Property ;
    rdfs:label 'Status Date' ;
    rdfs:comment 'Date when the credit profile status last changed.' ;
    rdfs:domain ind:CreditProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:priceAgreementId rdf:type rdf:Property ;
    rdfs:label 'Price Agreement Id' ;
    rdfs:comment 'System-generated unique identifier for the price agreement record.' ;
    rdfs:domain ind:Semiconductors ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PriceAgreement .

ind:priceAccountId rdf:type rdf:Property ;
    rdfs:label 'Price Account Id' ;
    rdfs:comment 'FK to customer.account.account_id — Customer-specific pricing is negotiated per account. FK to account is mandatory for pricing lookups during order entry.' ;
    rdfs:domain ind:PriceAgreement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Account .

ind:primaryPriceAccountId rdf:type rdf:Property ;
    rdfs:label 'Primary Price Account Id' ;
    rdfs:comment 'Unique identifier of the customer to which the price agreement applies.' ;
    rdfs:domain ind:PriceAgreement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Account .

ind:agreementType rdf:type rdf:Property ;
    rdfs:label 'Agreement Type' ;
    rdfs:comment 'Category of the price agreement indicating its purpose or pricing model.' ;
    rdfs:domain ind:Semiconductors ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contractReference rdf:type rdf:Property ;
    rdfs:label 'Contract Reference' ;
    rdfs:comment 'Reference number of the Special Price Authorization or contract linked to this agreement.' ;
    rdfs:domain ind:PriceAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:discountPercent rdf:type rdf:Property ;
    rdfs:label 'Discount Percent' ;
    rdfs:comment 'Percentage discount applied on top of the base unit price.' ;
    rdfs:domain ind:Semiconductors ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isPriceLocked rdf:type rdf:Property ;
    rdfs:label 'Is Price Locked' ;
    rdfs:comment 'Indicates whether the price agreement is locked from further changes.' ;
    rdfs:domain ind:Semiconductors ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:partRevision rdf:type rdf:Property ;
    rdfs:label 'Part Revision' ;
    rdfs:comment 'Specific revision or mask set of the part covered by the agreement.' ;
    rdfs:domain ind:PriceAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priceAgreementStatus rdf:type rdf:Property ;
    rdfs:label 'Price Agreement Status' ;
    rdfs:comment 'Current lifecycle state of the price agreement.' ;
    rdfs:domain ind:PriceAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priceChangeApprovalReference rdf:type rdf:Property ;
    rdfs:label 'Price Change Approval Reference' ;
    rdfs:comment 'Reference to the approval workflow instance for a price change.' ;
    rdfs:domain ind:PriceAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:priceChangeEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Price Change Effective Date' ;
    rdfs:comment 'Date on which a price amendment becomes effective.' ;
    rdfs:domain ind:PriceAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:priceChangeReason rdf:type rdf:Property ;
    rdfs:label 'Price Change Reason' ;
    rdfs:comment 'Narrative reason for a price amendment or re-negotiation.' ;
    rdfs:domain ind:PriceAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priceSource rdf:type rdf:Property ;
    rdfs:label 'Price Source' ;
    rdfs:comment 'Origin of the price data (e.g., SAP SD pricing condition, manual entry, external feed).' ;
    rdfs:domain ind:PriceAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priceUom rdf:type rdf:Property ;
    rdfs:label 'Price Uom' ;
    rdfs:comment 'Unit of measure for the price (e.g., per die, per wafer, per lot).' ;
    rdfs:domain ind:PriceAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pricingChannel rdf:type rdf:Property ;
    rdfs:label 'Pricing Channel' ;
    rdfs:comment 'Sales channel through which the price is offered.' ;
    rdfs:domain ind:PriceAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pricingRegion rdf:type rdf:Property ;
    rdfs:label 'Pricing Region' ;
    rdfs:comment 'Geographic region to which the pricing terms apply.' ;
    rdfs:domain ind:PriceAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxIncludedFlag rdf:type rdf:Property ;
    rdfs:label 'Tax Included Flag' ;
    rdfs:comment 'Indicates whether taxes are already included in the unit price.' ;
    rdfs:domain ind:PriceAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:tierEndQuantity rdf:type rdf:Property ;
    rdfs:label 'Tier End Quantity' ;
    rdfs:comment 'Inclusive upper bound of quantity for this volume tier; null if no upper limit.' ;
    rdfs:domain ind:PriceAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:tierPrice rdf:type rdf:Property ;
    rdfs:label 'Tier Price' ;
    rdfs:comment 'Agreed unit price applicable for the defined volume tier.' ;
    rdfs:domain ind:PriceAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tierStartQuantity rdf:type rdf:Property ;
    rdfs:label 'Tier Start Quantity' ;
    rdfs:comment 'Inclusive lower bound of quantity for this volume tier.' ;
    rdfs:domain ind:PriceAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:unitPrice rdf:type rdf:Property ;
    rdfs:label 'Unit Price' ;
    rdfs:comment 'Agreed price per unit of the part, expressed in the specified currency.' ;
    rdfs:domain ind:Semiconductors ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:volumeTier rdf:type rdf:Property ;
    rdfs:label 'Volume Tier' ;
    rdfs:comment 'Label for the volume-based pricing tier.' ;
    rdfs:domain ind:Semiconductors ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:opportunityId rdf:type rdf:Property ;
    rdfs:label 'Opportunity Id' ;
    rdfs:comment 'System-generated unique identifier for the sales opportunity.' ;
    rdfs:domain ind:Semiconductors ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Opportunity .

ind:competitiveLandscape rdf:type rdf:Property ;
    rdfs:label 'Competitive Landscape' ;
    rdfs:comment 'Free-text description of key competitors and market positioning for the opportunity.' ;
    rdfs:domain ind:Opportunity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contractEndDate rdf:type rdf:Property ;
    rdfs:label 'Contract End Date' ;
    rdfs:comment 'Planned end or expiration date of the contract; nullable for open-ended agreements.' ;
    rdfs:domain ind:Opportunity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:contractStartDate rdf:type rdf:Property ;
    rdfs:label 'Contract Start Date' ;
    rdfs:comment 'Effective start date of the contract if the opportunity is won.' ;
    rdfs:domain ind:Opportunity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:contractStatus rdf:type rdf:Property ;
    rdfs:label 'Contract Status' ;
    rdfs:comment 'Current lifecycle status of the contract.' ;
    rdfs:domain ind:Opportunity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contractType rdf:type rdf:Property ;
    rdfs:label 'Contract Type' ;
    rdfs:comment 'Nature of the contractual agreement associated with the opportunity.' ;
    rdfs:domain ind:Sales ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:endMarket rdf:type rdf:Property ;
    rdfs:label 'End Market' ;
    rdfs:comment 'Primary market segment the opportunity addresses.' ;
    rdfs:domain ind:Sales ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expectedCloseDate rdf:type rdf:Property ;
    rdfs:label 'Expected Close Date' ;
    rdfs:comment 'Projected date when the opportunity is expected to be closed (won or lost).' ;
    rdfs:domain ind:Opportunity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:expectedDiscountAmount rdf:type rdf:Property ;
    rdfs:label 'Expected Discount Amount' ;
    rdfs:comment 'Estimated discount or rebate amount applied to the gross revenue.' ;
    rdfs:domain ind:Opportunity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:expectedGrossAmount rdf:type rdf:Property ;
    rdfs:label 'Expected Gross Amount' ;
    rdfs:comment 'Projected gross revenue before discounts, taxes, or adjustments.' ;
    rdfs:domain ind:Opportunity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:expectedNetAmount rdf:type rdf:Property ;
    rdfs:label 'Expected Net Amount' ;
    rdfs:comment 'Projected net revenue after discounts and adjustments.' ;
    rdfs:domain ind:Opportunity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nreAmount rdf:type rdf:Property ;
    rdfs:label 'Nre Amount' ;
    rdfs:comment 'Potential NRE revenue associated with custom design or engineering services.' ;
    rdfs:domain ind:Semiconductors ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:opportunityNumber rdf:type rdf:Property ;
    rdfs:label 'Opportunity Number' ;
    rdfs:comment 'Human-readable business identifier assigned to the opportunity (e.g., OPP-2024-00123).' ;
    rdfs:domain ind:Opportunity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pricePerUnit rdf:type rdf:Property ;
    rdfs:label 'Price Per Unit' ;
    rdfs:comment 'Unit price used for revenue calculations, expressed in the selected currency.' ;
    rdfs:domain ind:Opportunity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pricingModel rdf:type rdf:Property ;
    rdfs:label 'Pricing Model' ;
    rdfs:comment 'Pricing structure applied to the opportunity.' ;
    rdfs:domain ind:Sales ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:probabilityPercent rdf:type rdf:Property ;
    rdfs:label 'Probability Percent' ;
    rdfs:comment 'Estimated probability (0-100) that the opportunity will be won, based on stage and historical data.' ;
    rdfs:domain ind:Opportunity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:salesChannel rdf:type rdf:Property ;
    rdfs:label 'Sales Channel' ;
    rdfs:comment 'Channel through which the sale is pursued.' ;
    rdfs:domain ind:Sales ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stageChangeTimestamp rdf:type rdf:Property ;
    rdfs:label 'Stage Change Timestamp' ;
    rdfs:comment 'Timestamp when the opportunity last moved to its current stage.' ;
    rdfs:domain ind:Opportunity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:winLossDate rdf:type rdf:Property ;
    rdfs:label 'Win Loss Date' ;
    rdfs:comment 'Date on which the opportunity outcome (win or loss) was recorded.' ;
    rdfs:domain ind:Opportunity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:winLossReason rdf:type rdf:Property ;
    rdfs:label 'Win Loss Reason' ;
    rdfs:comment 'Narrative reason why the opportunity was won or lost.' ;
