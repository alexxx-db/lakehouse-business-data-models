  cogs_percentage decimal(5,2) [note: 'Cost of goods sold percentage.']
  cost_center_code decimal(18,2) [note: 'Cost center code.']
  created_timestamp timestamp [note: 'Record creation timestamp.']
  currency_code varchar [note: 'Invoice currency.']
