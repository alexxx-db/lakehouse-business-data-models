    rdfs:range xsd:dateTime .

ind:leakDetectionFlag rdf:type rdf:Property ;
    rdfs:label 'Leak Detection Flag' ;
    rdfs:comment 'Leak detection flag. Ref: Sensus AMI.' ;
    rdfs:domain ind:IntervalConsumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:processedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Processed Timestamp' ;
    rdfs:comment 'Timestamp when processed. Ref: Sensus AMI.' ;
    rdfs:domain ind:IntervalConsumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:pulseIncrementGallons rdf:type rdf:Property ;
    rdfs:label 'Pulse Increment Gallons' ;
    rdfs:comment 'Pulse increment in gallons. Ref: Sensus AMI.' ;
    rdfs:domain ind:IntervalConsumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rawPulseCount rdf:type rdf:Property ;
    rdfs:label 'Raw Pulse Count' ;
    rdfs:comment 'Raw pulse count. Ref: Sensus AMI.' ;
    rdfs:domain ind:IntervalConsumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:receivedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Received Timestamp' ;
    rdfs:comment 'Timestamp when received. Ref: Sensus AMI.' ;
    rdfs:domain ind:IntervalConsumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:tamperEventCode rdf:type rdf:Property ;
    rdfs:label 'Tamper Event Code' ;
    rdfs:comment 'Tamper event code if any. Ref: Sensus AMI.' ;
    rdfs:domain ind:IntervalConsumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:temperatureFahrenheit rdf:type rdf:Property ;
    rdfs:label 'Temperature Fahrenheit' ;
    rdfs:comment 'Temperature in Fahrenheit. Ref: Sensus AMI.' ;
    rdfs:domain ind:IntervalConsumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:transmissionRetryCount rdf:type rdf:Property ;
    rdfs:label 'Transmission Retry Count' ;
    rdfs:comment 'Number of transmission retries. Ref: Sensus AMI.' ;
    rdfs:domain ind:IntervalConsumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:primaryHighAmiDeviceAmiEndpointId rdf:type rdf:Property ;
    rdfs:label 'Primary High Ami Device Ami Endpoint Id' ;
    rdfs:comment 'Unique identifier of the AMI endpoint device (Sensus FlexNet or similar) that generated the consumption data triggering this alert. Used for device diagnostics and data quality validation. Ref: Sensus AMI.' ;
    rdfs:domain ind:HighUsageAlert ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AmiEndpoint .

ind:actualConsumptionUnit rdf:type rdf:Property ;
    rdfs:label 'Actual Consumption Unit' ;
    rdfs:comment 'Unit of measure for the actual consumption value. Gallons, cubic feet, and cubic meters represent volume; GPM (Gallons per Minute) and MGD (Million Gallons per Day) represent flow rate. Ref: Sensus AMI.' ;
    rdfs:domain ind:HighUsageAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actualConsumptionValue rdf:type rdf:Property ;
    rdfs:label 'Actual Consumption Value' ;
    rdfs:comment 'The measured consumption value during the detection period that triggered the alert. Represents the actual usage that exceeded the threshold. Ref: Sensus AMI.' ;
    rdfs:domain ind:HighUsageAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:alertGeneratedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Alert Generated Timestamp' ;
    rdfs:comment 'Date and time when the alert was generated by the Advanced Metering Infrastructure (AMI) or analytics system. Represents the moment the threshold breach was detected. Ref: Sensus AMI.' ;
    rdfs:domain ind:HighUsageAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:alertNumber rdf:type rdf:Property ;
    rdfs:label 'Alert Number' ;
    rdfs:comment 'Business-facing unique alert number used for tracking and customer communication. Format: HUA-XXXXXXXXXX. Ref: Sensus AMI.' ;
    rdfs:domain ind:HighUsageAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alertSeverity rdf:type rdf:Property ;
    rdfs:label 'Alert Severity' ;
    rdfs:comment 'Severity classification of the alert based on variance magnitude and potential impact. Low indicates minor variance; medium indicates moderate concern; high indicates significant issue requiring prompt attention; critical indicates emergency condition requiring immediate response. Ref: Sensus AMI.' ;
    rdfs:domain ind:HighUsageAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alertStatus rdf:type rdf:Property ;
    rdfs:label 'Alert Status' ;
    rdfs:comment 'Current lifecycle status of the alert. Open indicates newly generated; notified means customer has been contacted; acknowledged means customer confirmed receipt; investigating indicates active review; resolved means issue addressed; dismissed means no action required; false positive indicates erroneous alert. [ENUM-REF-CANDIDATE: open|notified|acknowledged|investigating|resolved|dismissed|false_positive — 7 candidates stripped; promote to reference product]. Ref: Sensus AMI.' ;
    rdfs:domain ind:HighUsageAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alertType rdf:type rdf:Property ;
    rdfs:label 'Alert Type' ;
    rdfs:comment 'Classification of the high usage alert based on consumption pattern analysis. High consumption indicates volume exceeds baseline; continuous flow suggests uninterrupted usage; backflow suspected indicates reverse flow detection; leak detected flags potential infrastructure failure; abnormal pattern identifies irregular usage; threshold exceeded indicates absolute limit breach. Ref: Sensus AMI.' ;
    rdfs:domain ind:HighUsageAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:baselineConsumptionValue rdf:type rdf:Property ;
    rdfs:label 'Baseline Consumption Value' ;
    rdfs:comment 'Historical average or expected consumption value used as the comparison baseline for this alert. May be calculated from seasonal norms, customer history, or similar account profiles.' ;
    rdfs:domain ind:HighUsageAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:baselinePeriodDays rdf:type rdf:Property ;
    rdfs:label 'Baseline Period Days' ;
    rdfs:comment 'Number of days used to calculate the baseline consumption value. Typical values include 30, 60, 90, or 365 days depending on seasonality and data availability. Ref: Sensus AMI.' ;
    rdfs:domain ind:HighUsageAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:customerAcknowledgedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Customer Acknowledged Timestamp' ;
    rdfs:comment 'Date and time when the customer acknowledged receipt and awareness of this alert. Null if customer has not acknowledged. Ref: Sensus AMI.' ;
    rdfs:domain ind:HighUsageAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:customerNotifiedFlag rdf:type rdf:Property ;
    rdfs:label 'Customer Notified Flag' ;
    rdfs:comment 'Indicates whether the customer has been notified about this high usage alert. True means notification sent; False means no notification sent yet. Ref: Sensus AMI.' ;
    rdfs:domain ind:HighUsageAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:detectionPeriodEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Detection Period End Timestamp' ;
    rdfs:comment 'End of the time window during which the high usage condition was detected. Used to define the consumption analysis interval. Ref: Sensus AMI.' ;
    rdfs:domain ind:HighUsageAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:detectionPeriodStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Detection Period Start Timestamp' ;
    rdfs:comment 'Beginning of the time window during which the high usage condition was detected. Used to define the consumption analysis interval. Ref: Sensus AMI.' ;
    rdfs:domain ind:HighUsageAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:estimatedRevenueImpactAmount rdf:type rdf:Property ;
    rdfs:label 'Estimated Revenue Impact Amount' ;
    rdfs:comment 'Estimated financial impact of the high usage condition, representing potential lost revenue or customer billing adjustment. Positive values indicate revenue at risk; negative values indicate customer credits issued. Null if not calculated. Ref: Sensus AMI.' ;
    rdfs:domain ind:HighUsageAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:estimatedWaterLossGallons rdf:type rdf:Property ;
    rdfs:label 'Estimated Water Loss Gallons' ;
    rdfs:comment 'Estimated volume of water lost or wasted due to the condition that triggered this alert, measured in gallons. Used for Non-Revenue Water (NRW) and Unaccounted-for Water (UFW) analysis. Null if not applicable or not calculated. Ref: Sensus AMI.' ;
    rdfs:domain ind:HighUsageAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:firstNotificationTimestamp rdf:type rdf:Property ;
    rdfs:label 'First Notification Timestamp' ;
    rdfs:comment 'Date and time when the first customer notification was sent for this alert. Null if customer has not been notified. Ref: Sensus AMI.' ;
    rdfs:domain ind:HighUsageAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:investigationStartedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Investigation Started Timestamp' ;
    rdfs:comment 'Date and time when investigation of this alert began. Null if investigation has not started. Ref: Sensus AMI.' ;
    rdfs:domain ind:HighUsageAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:notificationCount rdf:type rdf:Property ;
    rdfs:label 'Notification Count' ;
    rdfs:comment 'Total number of notification attempts made to the customer regarding this alert. Includes all channels and retries. Ref: Sensus AMI.' ;
    rdfs:domain ind:HighUsageAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:notificationMethod rdf:type rdf:Property ;
    rdfs:label 'Notification Method' ;
    rdfs:comment 'Primary communication channel used to notify the customer about this alert. Email, SMS, and mobile app represent digital channels; phone call represents voice contact; postal mail represents physical correspondence; customer portal represents self-service access; none indicates no notification sent. [ENUM-REF-CANDIDATE: email|sms|phone_call|postal_mail|mobile_app|customer_portal|none — 7 candidates stripped; promote to reference product]. Ref: Sensus AMI.' ;
    rdfs:domain ind:HighUsageAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resolutionCategory rdf:type rdf:Property ;
    rdfs:label 'Resolution Category' ;
    rdfs:comment 'Classification of the root cause or resolution outcome for this alert. Customer leak repaired indicates customer-side plumbing issue fixed; utility leak repaired indicates utility infrastructure issue fixed; meter malfunction indicates faulty meter; seasonal usage indicates expected variance; customer behavior change indicates legitimate usage increase; irrigation system and pool filling indicate specific high-volume activities; construction activity indicates temporary usage spike; false alarm indicates erroneous alert; other indicates miscellaneous resolution. [ENUM-REF-CANDIDATE: customer_leak_repaired|utility_leak_repaired|meter_malfunction|seasonal_usage|customer_behavior_change|irrigation_system|pool_filling|construction_activity|false_alarm|other — 10 candidates stripped; promote to reference product]. Ref: Sensus AMI.' ;
    rdfs:domain ind:HighUsageAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceOrderCreatedFlag rdf:type rdf:Property ;
    rdfs:label 'Service Order Created Flag' ;
    rdfs:comment 'Indicates whether a field service order was created in response to this alert. True means service order generated; False means no service order created. Ref: Sensus AMI.' ;
    rdfs:domain ind:HighUsageAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:suppressionFlag rdf:type rdf:Property ;
    rdfs:label 'Suppression Flag' ;
    rdfs:comment 'Indicates whether this alert was suppressed from customer notification due to business rules (e.g., customer opted out, account in dispute, recent similar alert). True means suppressed; False means not suppressed. Ref: Sensus AMI.' ;
    rdfs:domain ind:HighUsageAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:suppressionReason rdf:type rdf:Property ;
    rdfs:label 'Suppression Reason' ;
    rdfs:comment 'Explanation of why this alert was suppressed from customer notification. Null if alert was not suppressed. Ref: Sensus AMI.' ;
    rdfs:domain ind:HighUsageAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:thresholdUnit rdf:type rdf:Property ;
    rdfs:label 'Threshold Unit' ;
    rdfs:comment 'Unit of measure for the threshold value. Gallons and cubic feet/meters represent volume; GPM (Gallons per Minute) and MGD (Million Gallons per Day) represent flow rate; percent represents variance from baseline. Ref: Sensus AMI.' ;
    rdfs:domain ind:HighUsageAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:thresholdValue rdf:type rdf:Property ;
    rdfs:label 'Threshold Value' ;
    rdfs:comment 'The defined limit or baseline value that was exceeded to trigger this alert. May represent absolute volume, flow rate, or percentage variance depending on alert configuration. Ref: Sensus AMI.' ;
    rdfs:domain ind:HighUsageAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:variancePercentage rdf:type rdf:Property ;
    rdfs:label 'Variance Percentage' ;
    rdfs:comment 'Percentage by which actual consumption exceeded the threshold value. Calculated as ((actual - threshold) / threshold) * 100. Positive values indicate over-threshold conditions. Ref: Sensus AMI.' ;
    rdfs:domain ind:HighUsageAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:accuracyPct rdf:type rdf:Property ;
    rdfs:label 'Accuracy Pct' ;
    rdfs:comment 'The accuracy pct value recorded for each accuracy test in the metering domain.' ;
    rdfs:domain ind:AccuracyTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:accuracyPercentage rdf:type rdf:Property ;
    rdfs:label 'Accuracy Percentage' ;
    rdfs:comment 'The accuracy percentage value recorded for each accuracy test in the metering domain.' ;
    rdfs:domain ind:AccuracyTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:accuracyTestNumber rdf:type rdf:Property ;
    rdfs:label 'Accuracy Test Number' ;
    rdfs:comment 'The accuracy test number value recorded for each accuracy test in the metering domain.' ;
    rdfs:domain ind:AccuracyTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accuracyTestStatus rdf:type rdf:Property ;
    rdfs:label 'Accuracy Test Status' ;
    rdfs:comment 'Lifecycle status of the record. Ref: Sensus AMI.' ;
    rdfs:domain ind:AccuracyTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accuracyTestType rdf:type rdf:Property ;
    rdfs:label 'Accuracy Test Type' ;
    rdfs:comment 'The accuracy test type value recorded for each accuracy test in the metering domain.' ;
    rdfs:domain ind:AccuracyTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accuracyThresholdPct rdf:type rdf:Property ;
    rdfs:label 'Accuracy Threshold Pct' ;
    rdfs:comment 'Accuracy threshold used for pass/fail determination. Ref: Sensus AMI.' ;
    rdfs:domain ind:AccuracyTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:accuracyTolerancePct rdf:type rdf:Property ;
    rdfs:label 'Accuracy Tolerance Pct' ;
    rdfs:comment 'Acceptable accuracy tolerance per AWWA standards' ;
    rdfs:domain ind:AccuracyTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:awwaStandardReference rdf:type rdf:Property ;
    rdfs:label 'Awwa Standard Reference' ;
    rdfs:comment 'AWWA standard used (M6, C700, C702, C710).' ;
    rdfs:domain ind:AccuracyTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:awwaThresholdPct rdf:type rdf:Property ;
    rdfs:label 'Awwa Threshold Pct' ;
    rdfs:comment 'AWWA accuracy threshold used (typically 98.5%)' ;
    rdfs:domain ind:AccuracyTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:complaintTriggered rdf:type rdf:Property ;
    rdfs:label 'Complaint Triggered' ;
    rdfs:comment 'Whether test was triggered by customer complaint. Ref: Sensus AMI.' ;
    rdfs:domain ind:AccuracyTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cumulativeVolumeAtTest rdf:type rdf:Property ;
    rdfs:label 'Cumulative Volume At Test' ;
    rdfs:comment 'Cumulative volume registered at test. Ref: Sensus AMI.' ;
    rdfs:domain ind:AccuracyTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:customerRequested rdf:type rdf:Property ;
    rdfs:label 'Customer Requested' ;
    rdfs:comment 'Flag indicating the test was requested by the customer. Ref: Sensus AMI.' ;
    rdfs:domain ind:AccuracyTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:disposition rdf:type rdf:Property ;
    rdfs:label 'Disposition' ;
    rdfs:comment 'Disposition after test (return_to_service, replace, repair, scrap). Ref: Sensus AMI.' ;
    rdfs:domain ind:AccuracyTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:highFlowAccuracyPct rdf:type rdf:Property ;
    rdfs:label 'High Flow Accuracy Pct' ;
    rdfs:comment 'Accuracy at high flow rate (%). Ref: Sensus AMI.' ;
    rdfs:domain ind:AccuracyTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:highFlowRateGpm rdf:type rdf:Property ;
    rdfs:label 'High Flow Rate Gpm' ;
    rdfs:comment 'High flow test rate in GPM. Ref: Sensus AMI.' ;
    rdfs:domain ind:AccuracyTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lowFlowAccuracyPct rdf:type rdf:Property ;
    rdfs:label 'Low Flow Accuracy Pct' ;
    rdfs:comment 'Accuracy at low flow rate (%). Ref: Sensus AMI.' ;
    rdfs:domain ind:AccuracyTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lowFlowRateGpm rdf:type rdf:Property ;
    rdfs:label 'Low Flow Rate Gpm' ;
    rdfs:comment 'Low flow test rate in GPM. Ref: Sensus AMI.' ;
    rdfs:domain ind:AccuracyTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mediumFlowAccuracyPct rdf:type rdf:Property ;
    rdfs:label 'Medium Flow Accuracy Pct' ;
    rdfs:comment 'Accuracy at medium flow rate (%). Ref: Sensus AMI.' ;
    rdfs:domain ind:AccuracyTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:meterAgeYears rdf:type rdf:Property ;
    rdfs:label 'Meter Age Years' ;
    rdfs:comment 'Age of meter at time of test. Ref: Sensus AMI.' ;
    rdfs:domain ind:AccuracyTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:meterVolume rdf:type rdf:Property ;
    rdfs:label 'Meter Volume' ;
    rdfs:comment 'The meter volume value recorded for each accuracy test in the metering domain.' ;
    rdfs:domain ind:AccuracyTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:midFlowAccuracyPct rdf:type rdf:Property ;
    rdfs:label 'Mid Flow Accuracy Pct' ;
    rdfs:comment 'The mid flow accuracy pct value recorded for each accuracy test in the metering domain.' ;
    rdfs:domain ind:AccuracyTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:midFlowRateGpm rdf:type rdf:Property ;
    rdfs:label 'Mid Flow Rate Gpm' ;
    rdfs:comment 'Mid flow test rate in GPM. Ref: Sensus AMI.' ;
    rdfs:domain ind:AccuracyTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:overallAccuracyPct rdf:type rdf:Property ;
    rdfs:label 'Overall Accuracy Pct' ;
    rdfs:comment 'Overall weighted accuracy percentage. Ref: Sensus AMI.' ;
    rdfs:domain ind:AccuracyTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:passFailFlag rdf:type rdf:Property ;
    rdfs:label 'Pass Fail Flag' ;
    rdfs:comment 'The pass fail flag value recorded for each accuracy test in the metering domain.' ;
    rdfs:domain ind:AccuracyTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:passFailStatus rdf:type rdf:Property ;
    rdfs:label 'Pass Fail Status' ;
    rdfs:comment 'Test result (pass, fail, marginal). Ref: Sensus AMI.' ;
    rdfs:domain ind:AccuracyTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:passFailThresholdPct rdf:type rdf:Property ;
    rdfs:label 'Pass Fail Threshold Pct' ;
    rdfs:comment 'Pass/fail threshold percentage for the test. Ref: Sensus AMI.' ;
    rdfs:domain ind:AccuracyTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:passFlag rdf:type rdf:Property ;
    rdfs:label 'Pass Flag' ;
    rdfs:comment 'The pass flag value recorded for each accuracy test in the metering domain.' ;
    rdfs:domain ind:AccuracyTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:postTestReadValue rdf:type rdf:Property ;
    rdfs:label 'Post Test Read Value' ;
    rdfs:comment 'Meter register reading after the test. Ref: Sensus AMI.' ;
    rdfs:domain ind:AccuracyTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:preTestReadValue rdf:type rdf:Property ;
    rdfs:label 'Pre Test Read Value' ;
    rdfs:comment 'Meter register reading before the test. Ref: Sensus AMI.' ;
    rdfs:domain ind:AccuracyTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:referenceVolume rdf:type rdf:Property ;
    rdfs:label 'Reference Volume' ;
    rdfs:comment 'The reference volume value recorded for each accuracy test in the metering domain.' ;
    rdfs:domain ind:AccuracyTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:replacementReason rdf:type rdf:Property ;
    rdfs:label 'Replacement Reason' ;
    rdfs:comment 'Reason replacement is recommended. Ref: Sensus AMI.' ;
    rdfs:domain ind:AccuracyTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:replacementRecommended rdf:type rdf:Property ;
    rdfs:label 'Replacement Recommended' ;
    rdfs:comment 'Whether replacement is recommended based on test result. Ref: Sensus AMI.' ;
    rdfs:domain ind:AccuracyTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:testBenchCalibrationDate rdf:type rdf:Property ;
    rdfs:label 'Test Bench Calibration Date' ;
    rdfs:comment 'Last calibration date of the test bench. Ref: Sensus AMI.' ;
