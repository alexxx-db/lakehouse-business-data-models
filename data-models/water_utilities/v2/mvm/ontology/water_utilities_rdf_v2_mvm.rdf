    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pfasFunctionalClass rdf:type rdf:Property ;
    rdfs:label 'Pfas Functional Class' ;
    rdfs:comment 'Functional chemical class of the PFAS compound (e.g. perfluorocarboxylic_acid, perfluorosulfonic_acid, fluorotelomer, ether_pfas). Ref: Sensus AMI.' ;
