  adjustment_amount decimal(18,2) [note: 'Total adjustment amount applied to claim.']
  admission_date date [note: 'Date of admission for inpatient claims.']
  appeal_filed_date date [note: 'Date appeal was filed if applicable.']
  appeal_filed_flag boolean [note: 'Indicates if an appeal has been filed.']
  authorization_number varchar [note: 'Prior authorization number.']
  bill_type varchar [note: 'UB-04 bill type code.']
  claim_number varchar [note: 'Internal claim number.']
  claim_status varchar [note: 'Current status of claim (submitted, paid, denied, etc.).']
  claim_type varchar [note: 'Type of claim (professional, institutional, dental, etc.).']
  coordination_of_benefits_flag boolean [note: 'Indicates if coordination of benefits applies.']
  created_timestamp timestamp [note: 'Timestamp when claim record was created.']
  currency_code varchar [note: 'ISO currency code for claim amounts.']
  denial_reason_code varchar [note: 'Code indicating reason for denial if applicable.']
  denial_reason_description varchar [note: 'Description of denial reason.']
  discharge_date date [note: 'Date of discharge for inpatient claims.']
  drg_grouper_version varchar [note: 'Version of DRG grouper software used.']
  paid_timestamp timestamp [note: 'Date and time claim was paid.']
  patient_responsibility_amount decimal(18,2) [note: 'Amount patient is responsible for.']
  payer_claim_number varchar [note: 'Payer-assigned claim control number.']
  place_of_service_code varchar [note: 'CMS place of service code.']
  primary_payer_flag boolean [note: 'Indicates if this is the primary payer.']
  principal_diagnosis_code varchar [note: 'ICD-10 code for principal diagnosis.']
  principal_procedure_code varchar [note: 'ICD-10-PCS code for principal procedure.']
  rac_audit_flag boolean [note: 'Indicates if claim is subject to RAC audit.']
  referring_provider_npi varchar [note: 'NPI of referring provider.']
  service_from_date date [note: 'Start date of service period.']
  service_to_date date [note: 'End date of service period.']
  source_system_claim_code varchar [note: 'Claim identifier in source system.']
  submission_method varchar [note: 'Method of claim submission (EDI, paper, portal).']
  submitted_timestamp timestamp [note: 'Date and time claim was submitted to payer.']
  total_allowed_amount decimal(18,2) [note: 'Total amount allowed by payer.']
  total_billed_amount decimal(18,2) [note: 'Total amount billed to payer.']
  total_paid_amount decimal(18,2) [note: 'Total amount paid by payer.']
  updated_timestamp timestamp [note: 'Timestamp of last update.']
