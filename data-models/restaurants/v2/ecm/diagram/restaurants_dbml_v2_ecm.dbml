  created_timestamp timestamp [note: 'Record creation timestamp.']
  currency_code varchar [note: 'Currency for the line.']
  delivery_status varchar [note: 'Delivery status.']
  discount_amount decimal(18,2) [note: 'Discount on this line.']
  expected_delivery_date date [note: 'Expected delivery date.']
  extended_amount decimal(18,2) [note: 'Extended line amount (qty x price).']
