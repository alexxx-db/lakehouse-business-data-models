    rdfs:range xsd:string .

ind:pressureDropKpa rdf:type rdf:Property ;
    rdfs:label 'Pressure Drop Kpa' ;
    rdfs:comment 'Measured pressure drop across the filter unit in kilopascals.' ;
    rdfs:domain ind:FilterUnit ;
    rdf:type owl:DatatypeProperty ;
