  country varchar [note: 'Country']
  created_timestamp timestamp [note: 'Record creation timestamp']
  cross_dock_enabled boolean [note: 'Whether cross-docking is supported']
  dc_code varchar [note: 'Unique DC code']
  distribution_center_name varchar [note: 'Name of the distribution center']
  distribution_center_status varchar [note: 'Operational status (active, closed, under_construction)']
  emergency_contact_phone varchar [note: 'Emergency contact phone number']
  facility_type varchar [note: 'Type (warehouse, cold_storage, cross_dock)']
  haccp_compliant boolean [note: 'Whether HACCP compliant']
  inspection_score decimal(5,2) [note: 'Last inspection score']
  last_inspection_date date [note: 'Date of last inspection']
  latitude decimal(9,6) [note: 'GPS latitude']
  longitude decimal(9,6) [note: 'GPS longitude']
