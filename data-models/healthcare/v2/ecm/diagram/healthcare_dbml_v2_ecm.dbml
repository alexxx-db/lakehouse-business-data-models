  vibe_structure_marker varchar [note: 'Structure enforcement marker for 22-domain/541-product superset.']

  Note: 'Job profile template defining competencies, education, licensure, and pay range for a role.'
}

Table workforce.employment_competency {
  employment_competency_id varchar [pk]
  job_profile_id varchar
  assessment_frequency_months varchar
  competency_category varchar
  competency_code varchar
  competency_name varchar
  created_timestamp timestamp
  effective_date date
  employment_competency_description varchar
  is_mandatory boolean
  regulatory_requirement_flag boolean
  required_proficiency_level varchar
  retirement_date date
  updated_timestamp timestamp
  vibe_structure_marker varchar [note: 'Structure enforcement marker for 22-domain/541-product superset.']

  Note: 'Master record for the full credentialing and privileging lifecycle of healthcare workforce members. Covers professional credentials (medical licenses, DEA registrations, board certifications, nursing licenses, allied health certifications, advanced practice credentials), clinical privileges (facility-specific procedure and clinical activity authorizations granted by Medical Staff), and credentialing/re-credentialing applications. For credentials: issuing authority, license number, issue/expiration dates, renewal status, primary source verification status. For privileges: privilege category, procedure/service type, facility, granting date, privilege status (active, provisional, suspended, revoked), Medical Staff committee approval. For applications: application type (initial, reappointment), submission date, verification steps, committee review dates, approval/denial decision, effective dates. Integrates with Symplr credentialing and Medical Staff Office workflows. SSOT for all workforce credentialing, privileging, and verification data.'
}

Table workforce.competency_assessment {
  competency_assessment_id varchar [pk]
  competency_assessor_employee_id varchar
  competency_employee_id varchar
  employment_competency_id varchar
  assessment_date date
  assessment_method varchar
  created_timestamp timestamp
  expiration_date date
  notes varchar
  pass_fail_status varchar
  proficiency_level varchar
  remediation_required_flag boolean
  score decimal(5,2)
  updated_timestamp timestamp
  vibe_structure_marker varchar [note: 'Structure enforcement marker for 22-domain/541-product superset.']

  Note: 'Records of competency evaluations, occupational health immunizations, and health screenings for clinical and non-clinical staff. Captures assessment type (competency, immunization, health screening), competency domain or vaccine/test type, assessment method (observation, written, simulation, administration), assessor, date, score/result, pass/fail outcome, remediation plan, and next-due date. For immunizations: vaccine type (influenza, hepatitis B, MMR, varicella, Tdap, COVID-19), lot number, administration date, declination reason. For health screenings: TB testing (PPD/IGRA), N95 fit testing, results. SSOT for all occupational health compliance and workforce competency data. Supports TJC and CMS staffing competency and infection control compliance standards.'
}

Table workforce.shift_schedule {
  shift_schedule_id varchar [pk, note: 'Unique identifier for the shift schedule record']
  care_site_id varchar [note: 'FK to the facility where the shift occurs']
  clinician_id varchar [note: 'FK to the clinician assigned to this shift']
  cost_center_id varchar [note: 'FK to the cost center for labor cost allocation']
  position_id varchar [note: 'FK to the position being staffed']
  primary_shift_employee_id varchar [note: 'FK to the employee assigned to this shift']
  shift_employee_id varchar
  shift_org_unit_id varchar
  shift_workforce_org_unit_id varchar [note: 'FK to the organizational unit owning this schedule']
  swap_source_schedule_id varchar [note: 'Self-referential FK to the original shift in a swap scenario']
  unit_id varchar [note: 'FK to the nursing/clinical unit for this shift']
  actual_end_datetime timestamp [note: 'Actual end datetime of the shift']
  actual_hours_worked decimal(5,2) [note: 'Total actual hours worked during the shift']
  actual_start_datetime timestamp [note: 'Actual start datetime of the shift']
  acuity_level varchar [note: 'Patient acuity level on the unit during this shift']
  agency_name varchar [note: 'Name of staffing agency if agency staff']
  approval_datetime timestamp [note: 'Datetime when the shift was approved by manager']
  assignment_status varchar [note: 'Status of the shift assignment (assigned, confirmed, no-show)']
  break_minutes varchar [note: 'Total break time in minutes during the shift']
  cancellation_reason varchar [note: 'Reason for shift cancellation if applicable']
  care_setting varchar [note: 'Clinical care setting (ICU, ED, med-surg, OR)']
  created_datetime timestamp [note: 'Timestamp when the shift record was created']
  created_timestamp timestamp
  floated_to_unit varchar
  fte_value decimal(5,4) [note: 'FTE value this shift represents']
  is_agency_staff boolean [note: 'Whether the shift is filled by agency/travel staff']
  is_charge_role boolean [note: 'Whether the employee is serving as charge nurse/lead']
  is_float boolean
  is_float_assignment boolean [note: 'Whether this is a float pool assignment to another unit']
  is_holiday boolean [note: 'Whether this shift falls on a recognized holiday']
  is_mandatory_overtime boolean [note: 'Whether this shift is mandatory overtime']
  is_on_call boolean
  is_overtime boolean
  last_updated_datetime timestamp [note: 'Timestamp of last modification to this shift record']
  mutator_applied_flag boolean [note: 'Flag set by mutator to indicate modification']
  nurse_to_patient_ratio decimal(5,2) [note: 'Nurse-to-patient staffing ratio during this shift']
  on_call_response_minutes varchar [note: 'Required response time in minutes for on-call shifts']
  overtime_hours decimal(5,2) [note: 'Number of overtime hours worked during this shift']
  patient_census varchar [note: 'Patient census count on the unit during this shift']
  pay_code varchar [note: 'Payroll pay code (regular, OT, holiday, callback)']
  published_datetime timestamp [note: 'Datetime when the schedule was published to staff']
  published_flag boolean
  required_fte_coverage decimal(5,2) [note: 'Required FTE coverage level for this shift period']
  schedule_notes varchar [note: 'Free-text notes about the shift assignment']
  schedule_number varchar [note: 'Business identifier for the schedule period']
  schedule_period_end_date date [note: 'End date of the scheduling period']
  schedule_period_start_date date [note: 'Start date of the scheduling period']
  schedule_status varchar [note: 'Status of the schedule (draft, published, finalized)']
  scheduled_end_datetime timestamp [note: 'Planned end datetime of the shift']
  scheduled_hours decimal(5,2) [note: 'Total planned hours for this shift']
  scheduled_start_datetime timestamp [note: 'Planned start datetime of the shift']
  shift_category varchar [note: 'Category of shift (regular, overtime, on-call, callback)']
  shift_date date [note: 'Calendar date of the shift']
  shift_end_timestamp timestamp
  shift_start_timestamp timestamp
  shift_status varchar
  shift_type varchar [note: 'Type of shift (day, evening, night, split)']
  skill_level_required varchar [note: 'Minimum skill/competency level required for this shift']
  source_system_code varchar [note: 'Identifier of the scheduling source system']
  source_system_record_code varchar [note: 'Record identifier in the source scheduling system']
  swap_approved_by varchar [note: 'Manager who approved the shift swap']
  swap_approved_datetime timestamp [note: 'Datetime when the shift swap was approved']
  swap_requested boolean
  updated_timestamp timestamp
  vibe_mutation_marker varchar [note: 'Added by VIBE mutator to ensure a change']
  vibe_structure_marker varchar [note: 'Structure enforcement marker for 22-domain/541-product superset.']

  Note: 'Planned work schedules and individual shift assignments for clinical and non-clinical staff across all care settings (inpatient units, ED, ICU, OR, outpatient clinics). Captures schedule period, unit/department, shift type (day, evening, night, on-call), required FTE coverage, and schedule status. Includes individual employee shift assignments: assigned employee, role, scheduled start/end datetime, assignment status (scheduled, confirmed, swapped, cancelled), float/agency designation, and actual vs. scheduled hours for variance analysis and overtime tracking. SSOT for all workforce scheduling data. Supports nurse-to-patient ratio compliance and operational staffing planning. Integrates with Workday HCM scheduling modules.'
}

Table workforce.time_attendance {
  time_attendance_id varchar [pk, note: 'Unique identifier for the time and attendance record']
  care_site_id varchar [note: 'FK to the facility where time was worked']
  chart_of_accounts_id varchar [note: 'FK to the GL account for labor cost posting']
  cost_center_id varchar [note: 'FK to the cost center for labor cost allocation']
  fiscal_period_id varchar [note: 'FK to the fiscal period for financial reporting']
  payroll_run_id varchar [note: 'FK to the payroll run that processed this time entry']
  position_id varchar [note: 'FK to the position the employee worked under']
  primary_time_employee_id varchar [note: 'FK to the employee who worked the time']
  shift_schedule_id varchar
  time_employee_id varchar
  workforce_org_unit_id varchar [note: 'FK to the organizational unit']
  approval_status varchar [note: 'Status of time entry approval (pending, approved, rejected)']
  approval_timestamp timestamp [note: 'Timestamp when the time entry was approved']
  approved_by varchar [note: 'Name of manager who approved the time entry']
  base_pay_rate decimal(12,4) [note: 'Base hourly pay rate for the employee']
  benefits_deduction decimal(10,2) [note: 'Benefits deduction amount for this pay period']
  bonus_amount decimal(10,2) [note: 'Bonus or incentive pay amount']
  callback_hours decimal(8,2) [note: 'Hours worked on callback from on-call status']
  clock_in_timestamp timestamp [note: 'Timestamp when employee clocked in']
  clock_out_timestamp timestamp [note: 'Timestamp when employee clocked out']
  correction_reason varchar [note: 'Reason for time entry correction if modified']
  created_timestamp timestamp [note: 'Timestamp when the record was created']
  differential_rate decimal(18,2)
  double_time_hours decimal(6,2)
  exception_flag boolean
  exception_reason varchar
  flsa_compliance_flag boolean [note: 'Whether this entry complies with FLSA regulations']
  flsa_exempt boolean [note: 'Whether the employee is FLSA exempt for this period']
  fte_percentage decimal(5,2) [note: 'FTE percentage for this pay period']
  garnishment_deduction decimal(10,2) [note: 'Court-ordered garnishment deduction amount']
  gl_account_code varchar [note: 'General ledger account code for labor posting']
  gross_pay_amount decimal(12,2) [note: 'Total gross pay amount before deductions']
  holiday_hours decimal(8,2) [note: 'Hours worked on recognized holidays']
  is_approved boolean
  last_updated_timestamp timestamp [note: 'Timestamp of last modification']
  leave_type varchar [note: 'Type of leave if applicable (PTO, sick, FMLA, bereavement)']
  meal_break_minutes varchar [note: 'Total meal break time in minutes']
  missed_punch_count varchar [note: 'Number of missed clock punches requiring correction']
  mutator_applied_flag boolean [note: 'Flag set by mutator to indicate modification']
  net_pay_amount decimal(12,2) [note: 'Net pay amount after all deductions']
  on_call_hours decimal(8,2) [note: 'Hours spent on-call during this period']
  osha_incident_related boolean [note: 'Whether time is related to an OSHA workplace incident']
  overtime_hours decimal(8,2) [note: 'Number of overtime hours worked']
  overtime_pay_amount decimal(10,2) [note: 'Total overtime pay amount']
  pay_period_end_date date [note: 'End date of the pay period']
  pay_period_start_date date [note: 'Start date of the pay period']
  pay_type varchar [note: 'Type of pay (regular, overtime, holiday, differential)']
  payment_method varchar [note: 'Method of payment (direct deposit, check)']
  payroll_run_date date [note: 'Date the payroll was processed']
  payroll_run_status varchar [note: 'Status of the payroll run (pending, processed, voided)']
  pto_hours decimal(6,2)
  regular_hours decimal(6,2)
  regular_hours_worked decimal(8,2) [note: 'Number of regular (non-overtime) hours worked']
  shift_date date [note: 'Calendar date of the shift worked']
  shift_differential_amount decimal(10,2) [note: 'Additional pay for evening/night/weekend shifts']
  shift_type varchar [note: 'Type of shift worked (day, evening, night)']
  source_system_code varchar [note: 'Identifier of the timekeeping source system']
  time_entry_type varchar [note: 'Type of time entry (clock, manual, system-generated)']
  timekeeper_corrected boolean [note: 'Whether the entry was corrected by a timekeeper']
  total_pay decimal(18,2)
  total_tax_deduction decimal(10,2) [note: 'Total tax withholding amount']
  updated_timestamp timestamp
  vibe_mutation_marker varchar [note: 'Added by VIBE mutator to ensure a change']
  vibe_structure_marker varchar [note: 'Structure enforcement marker for 22-domain/541-product superset.']
  work_date date
  worked_hours decimal(6,2)

  Note: 'Time, attendance, and payroll processing records for all employees. Captures clock-in/clock-out events, total hours worked, overtime hours, missed punches, meal break deductions, pay period totals, approval status, and timekeeper corrections. Includes complete payroll processing: gross pay, net pay, base salary/hourly rate, shift differentials, overtime pay, bonuses, deductions (taxes, benefits, garnishments), pay period dates, payroll run status, payment method (direct deposit, check), and GL cost center allocation. Tracks FLSA compliance flags and supports labor cost allocation by cost center and department. SSOT for all workforce time tracking and payroll data. Sourced from Workday HCM Time Tracking and Payroll modules.'
}

