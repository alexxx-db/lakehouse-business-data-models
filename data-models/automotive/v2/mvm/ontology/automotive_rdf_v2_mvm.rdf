    rdfs:comment 'Legal jurisdiction whose laws govern the contract.' ;
    rdfs:domain ind:SupplierContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isMasterAgreement rdf:type rdf:Property ;
    rdfs:label 'Is Master Agreement' ;
    rdfs:comment 'Flag indicating whether this contract serves as a framework (master) agreement for multiple release orders.' ;
    rdfs:domain ind:SupplierContract ;
