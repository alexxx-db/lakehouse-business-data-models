ind:itemListingId rdf:type rdf:Property ;
    rdfs:label 'Item Listing Id' ;
    rdfs:comment 'Primary key for the menu_item_listing association' ;
    rdfs:domain ind:ItemListing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:channelOverridePrice rdf:type rdf:Property ;
    rdfs:label 'Channel Override Price' ;
    rdfs:comment 'A menu-and-channel-specific price for this item that overrides the base_price on the menu_item record. Captures pricing variations such as delivery surcharges or promotional menu pricing.' ;
    rdfs:domain ind:ItemListing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:daypartOverride rdf:type rdf:Property ;
    rdfs:label 'Daypart Override' ;
    rdfs:comment 'A daypart restriction or override specific to this menu-item pairing, superseding the default daypart on either the menu or the item. For example, a burger available all-day on the dine-in menu but only at lunch on the drive-thru menu.' ;
    rdfs:domain ind:ItemListing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isFeaturedItem rdf:type rdf:Property ;
    rdfs:label 'Is Featured Item' ;
    rdfs:comment 'Indicates whether this menu item is featured or promoted on this specific menu. A featured flag is a property of the listing context, not of the item globally.' ;
    rdfs:domain ind:ItemListing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:comboComponentId rdf:type rdf:Property ;
    rdfs:label 'Combo Component Id' ;
    rdfs:comment 'Primary key for the combo_component association' ;
    rdfs:domain ind:ComboComponent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:componentType rdf:type rdf:Property ;
    rdfs:label 'Component Type' ;
    rdfs:comment 'The role this menu item plays within the combo meal (e.g., main entrée, side, beverage). Belongs to the pairing — the same menu item can be a SIDE in one combo and a MAIN in another.' ;
    rdfs:domain ind:ComboComponent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isComboEligible rdf:type rdf:Property ;
    rdfs:label 'Is Combo Eligible' ;
    rdfs:comment 'Eligible for combo meals [Moved from menu_item: This boolean flag on menu_item was a workaround to indicate combo participation. With the combo_component association table explicitly recording which items are in which combos, is_combo_eligible becomes derivable (any menu_item with at least one combo_component record is combo-eligible) and is therefore redundant on menu_item. It should be deprecated from menu_item once the association is populated.]' ;
    rdfs:domain ind:ComboComponent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isRequiredComponent rdf:type rdf:Property ;
    rdfs:label 'Is Required Component' ;
    rdfs:comment 'Indicates whether this component slot is mandatory in the combo or optional. A combo may have required items (e.g., the burger) and optional items (e.g., a dessert upgrade).' ;
    rdfs:domain ind:ComboComponent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:substitutionAllowed rdf:type rdf:Property ;
    rdfs:label 'Substitution Allowed' ;
    rdfs:comment 'Indicates whether the customer may substitute a different menu item for this component slot. Belongs to the combo-item pairing, not to either entity alone.' ;
    rdfs:domain ind:ComboComponent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:upchargeAmount rdf:type rdf:Property ;
    rdfs:label 'Upcharge Amount' ;
    rdfs:comment 'The additional price charged when this specific menu item is selected in this combo slot, above the base combo price. This is a pairing-level attribute — the same item may have different upcharges in different combos.' ;
    rdfs:domain ind:ComboComponent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:supplierIngredientCatalogId rdf:type rdf:Property ;
    rdfs:label 'Supplier Ingredient Catalog Id' ;
    rdfs:comment 'Primary key for the supplier_ingredient_catalog association' ;
    rdfs:domain ind:SupplierIngredientCatalog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:preferredSupplierFlag rdf:type rdf:Property ;
    rdfs:label 'Preferred Supplier Flag' ;
    rdfs:comment 'Indicates whether this supplier is the preferred (primary) source for this specific ingredient. Enables procurement systems to default to the preferred supplier during ordering.' ;
    rdfs:domain ind:SupplierIngredientCatalog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:contractLineItemId rdf:type rdf:Property ;
    rdfs:label 'Contract Line Item Id' ;
    rdfs:comment 'Primary key for the contract_line_item association' ;
    rdfs:domain ind:ContractLineItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:contractedUnitPrice rdf:type rdf:Property ;
    rdfs:label 'Contracted Unit Price' ;
    rdfs:comment 'The negotiated price per unit for this specific ingredient under this specific contract. Cannot live on supplier_contract (varies per ingredient) nor on ingredient (varies per contract).' ;
    rdfs:domain ind:ContractLineItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:defaultPrice rdf:type rdf:Property ;
    rdfs:label 'Default Price' ;
    rdfs:comment 'Default unit price in contract [Moved from supplier_contract: default_price on supplier_contract is ambiguous when a contract covers multiple ingredients — each ingredient has its own contracted price. This attribute is superseded by contracted_unit_price on the contract line item and should be removed from supplier_contract to avoid confusion.]' ;
    rdfs:domain ind:ContractLineItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:volumeDiscountPercentage rdf:type rdf:Property ;
    rdfs:label 'Volume Discount Percentage' ;
    rdfs:comment 'The volume-based discount percentage applicable to this ingredient under this contract. Varies by ingredient and contract combination.' ;
    rdfs:domain ind:ContractLineItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .
