    rdfs:comment 'Indicates whether the union currently holds membership-authorized strike or work-stoppage rights under the applicable agreement (relevant for essential-service continuity planning).' ;
    rdfs:domain ind:LaborUnion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:unionHallAddress rdf:type rdf:Property ;
    rdfs:label 'Union Hall Address' ;
    rdfs:comment 'Physical mailing address of the union hall / office of record for official correspondence.' ;
    rdfs:domain ind:LaborUnion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unionHallCity rdf:type rdf:Property ;
    rdfs:label 'Union Hall City' ;
    rdfs:comment 'City in which the union hall / office of record is located.' ;
    rdfs:domain ind:LaborUnion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unionHallPostalCode rdf:type rdf:Property ;
    rdfs:label 'Union Hall Postal Code' ;
    rdfs:comment 'Postal ZIP code of the union hall / office of record.' ;
    rdfs:domain ind:LaborUnion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unionLocalNumber rdf:type rdf:Property ;
    rdfs:label 'Union Local Number' ;
    rdfs:comment 'Externally-known local chapter number assigned to the union by its national/international parent body (e.g., IBEW Local 1245, AFSCME Local 3299).' ;
    rdfs:domain ind:LaborUnion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unionName rdf:type rdf:Property ;
    rdfs:label 'Union Name' ;
    rdfs:comment 'Official legal name of the labor union or bargaining unit representing water/wastewater operations employees.' ;
    rdfs:domain ind:LaborUnion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unionType rdf:type rdf:Property ;
    rdfs:label 'Union Type' ;
    rdfs:comment 'Classification of the union by organizing structure and representation model.' ;
    rdfs:domain ind:LaborUnion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wageScaleReference rdf:type rdf:Property ;
    rdfs:label 'Wage Scale Reference' ;
    rdfs:comment 'Reference identifier for the negotiated wage scale / pay grade schedule that applies to members under the CBA, maintained in SAP HR compensation module.' ;
    rdfs:domain ind:LaborUnion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:predecessorOutreachCampaignId rdf:type rdf:Property ;
    rdfs:label 'Predecessor Outreach Campaign Id' ;
    rdfs:comment 'Self-referencing FK on outreach_campaign (predecessor_outreach_campaign_id)' ;
    rdfs:domain ind:OutreachCampaign ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:OutreachCampaign .

ind:prerequisiteTreatmentTechnologyId rdf:type rdf:Property ;
    rdfs:label 'Prerequisite Treatment Technology Id' ;
