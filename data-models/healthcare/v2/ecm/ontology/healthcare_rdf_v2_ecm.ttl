ind:buildingId rdf:type rdf:Property ;
    rdfs:label 'Building Id' ;
    rdfs:comment 'building id for pharmacy pharmacy location.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Building .

ind:inventoryLocationId rdf:type rdf:Property ;
    rdfs:label 'Inventory Location Id' ;
    rdfs:comment 'Foreign key linking to supply.inventory_location. Business justification: Pharmacy locations are specialized inventory storage locations within enterprise supply chain systems. Linking pharmacy locations to supply chain inventory locations enables cross-domain inventory vis' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:InventoryLocation .

ind:pharmacyClinicianId rdf:type rdf:Property ;
    rdfs:label 'Pharmacy Clinician Id' ;
    rdfs:comment 'Reference to the individual clinician or organizational provider associated with this practice location. Links to the provider master record.' ;
    rdfs:domain ind:PharmacyLocation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:pharmacyManagerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Pharmacy Manager Employee Id' ;
    rdfs:comment 'manager employee id for pharmacy pharmacy location.' ;
    rdfs:domain ind:PharmacyLocation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:pharmacyPharmacistInChargeClinicianId rdf:type rdf:Property ;
    rdfs:label 'Pharmacy Pharmacist In Charge Clinician Id' ;
    rdfs:comment 'Foreign key linking to provider.clinician. Business justification: Pharmacist in charge is a licensed clinician. State pharmacy regulations require designated pharmacist in charge for each licensed pharmacy location. FK enables verification of PIC credentials, state ' ;
    rdfs:domain ind:PharmacyLocation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:pharmacyPharmacistInChargeEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Pharmacy Pharmacist In Charge Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: Every pharmacy location must have designated pharmacist-in-charge (PIC) who is credentialed employee; state board licensure requirement. Essential for regulatory compliance, accountability, and workfo' ;
    rdfs:domain ind:PharmacyLocation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:acceptingNewPatientsUpdatedDate rdf:type rdf:Property ;
    rdfs:label 'Accepting New Patients Updated Date' ;
    rdfs:comment 'Date on which the accepting new patients status was last verified or updated. CMS requires this field to be refreshed at least every 90 days for network adequacy compliance and provider directory accuracy.' ;
    rdfs:domain ind:PharmacyLocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:addressLine1 rdf:type rdf:Property ;
    rdfs:label 'Address Line 1' ;
    rdfs:comment 'Primary street address of the pharmacy location (street number, street name, suite/unit).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
