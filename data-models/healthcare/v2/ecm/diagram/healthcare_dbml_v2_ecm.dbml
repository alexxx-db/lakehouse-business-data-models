Table finance.recurring_schedule {
  recurring_schedule_id varchar [pk, note: 'Primary key for recurring_schedule']
  chart_of_accounts_id varchar [note: 'Reference to the general ledger account to which this recurring schedule posts transactions.']
  cost_center_id varchar [note: 'Reference to the cost center responsible for or associated with this recurring schedule.']
  financial_entity_id varchar
  fiscal_period_id varchar [note: 'Reference to the fiscal year this recurring schedule is associated with.']
  owner_employee_id varchar [note: 'Reference to the employee who owns and is accountable for this recurring schedule.']
  recurring_approved_by_user_employee_id varchar [note: 'Reference to the user who approved this recurring schedule. Null if not yet approved or approval is not required.']
  recurring_employee_id varchar [note: 'Reference to the user who created this recurring schedule record.']
  recurring_modified_by_user_employee_id varchar [note: 'Reference to the user who last modified this recurring schedule record.']
  superseded_recurring_schedule_id varchar [note: 'Self-referencing FK on recurring_schedule (superseded_recurring_schedule_id)']
  adjustment_factor decimal(10,6) [note: 'A multiplier applied to the scheduled amount for adjustments such as inflation, escalation, or volume changes. Default is 1.0 (no adjustment).']
  allocation_method varchar [note: 'The method used to allocate or distribute the scheduled amount across periods or cost centers (equal distribution, weighted, percentage-based, activity-based costing, or custom formula).']
  approval_required_flag boolean [note: 'Indicates whether generated activities from this schedule require approval before posting (true) or can be posted automatically (false).']
  approved_timestamp timestamp [note: 'The date and time when this recurring schedule was approved for activation. Null if not yet approved or approval is not required.']
  approver_role_code varchar [note: 'Reference to the role or user group responsible for approving activities generated by this schedule. Null if approval is not required.']
  auto_generate_flag boolean [note: 'Indicates whether scheduled activities are automatically generated by the system (true) or require manual creation (false).']
  business_justification varchar [note: 'Explanation of the business rationale and need for this recurring schedule, used for audit and governance purposes.']
  created_timestamp timestamp [note: 'The date and time when this recurring schedule record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code indicating the currency in which the scheduled amount is denominated.']
  day_of_month varchar [note: 'For monthly or less frequent schedules, the specific day of the month when the activity occurs (1-31). Null if not applicable.']
  day_of_week varchar [note: 'For weekly or biweekly schedules, the specific day of the week when the activity occurs. Null if not applicable.']
  effective_end_date date [note: 'The date when this recurring schedule ceases to be active. Null indicates an open-ended schedule.']
  effective_start_date date [note: 'The date when this recurring schedule becomes active and begins generating scheduled activities.']
  frequency varchar [note: 'The frequency at which the scheduled activity recurs (daily, weekly, biweekly, monthly, quarterly, semiannual, or annual).']
  is_active boolean [note: 'Indicates whether this recurring schedule is currently active and eligible for generating scheduled activities (true) or inactive (false).']
  last_generated_date date [note: 'The date when the most recent scheduled activity was generated from this recurring schedule. Null if no activities have been generated yet.']
  last_run_date date
  max_occurrences varchar [note: 'The maximum number of times this schedule should generate activities before automatically completing. Null indicates unlimited occurrences.']
  modified_timestamp timestamp [note: 'The date and time when this recurring schedule record was last modified.']
  month_of_quarter varchar [note: 'For quarterly schedules, the specific month within the quarter when the activity occurs (1-3). Null if not applicable.']
  next_run_date date [note: 'Next run date']
  next_scheduled_date date [note: 'The date when the next scheduled activity is due to be generated from this recurring schedule.']
  notes varchar [note: 'Additional free-form notes or comments about the recurring schedule for operational reference.']
  occurrence_count varchar [note: 'The total number of times activities have been generated from this recurring schedule since its inception.']
  occurrences_remaining varchar
  proration_rule varchar [note: 'The rule used to prorate amounts for partial periods (none, daily proration, monthly proration, actual days, or business days only).']
  quarter_of_year varchar [note: 'For annual schedules, the specific quarter of the year when the activity occurs (1-4). Null if not applicable.']
  recurrence_amount decimal(18,2)
  recurring_schedule_description varchar [note: 'Detailed textual description of the recurring schedule, including its purpose, scope, and any special instructions or business rules.']
  recurring_schedule_status varchar [note: 'Current lifecycle status of the recurring schedule indicating whether it is in draft, actively generating activities, temporarily suspended, completed, or cancelled.']
  schedule_amount decimal(18,2) [note: 'The standard monetary amount associated with each recurrence of this schedule. Used for budgeting, allocation, or accrual purposes.']
  schedule_category varchar [note: 'High-level categorization of the schedule based on the nature of financial activities it governs.']
  schedule_code varchar [note: 'Business identifier code for the recurring schedule, used for external reference and reporting.']
  schedule_name varchar [note: 'Human-readable name describing the purpose or nature of the recurring schedule.']
  schedule_status varchar [note: 'Status']
  schedule_type varchar [note: 'Classification of the recurring schedule indicating its financial purpose (budget cycle, forecast period, cost allocation, accrual recognition, depreciation schedule, or amortization schedule).']
  template_journal_entry_id varchar
  updated_timestamp timestamp
  version_number varchar [note: 'Version number of this recurring schedule record, incremented with each modification for change tracking and audit purposes.']
  vibe_mutation_added varchar [note: 'Added by VIBE mutation to satisfy target entity touch requirement']
  vibe_mutation_applied varchar
  vibe_mutation_extra varchar [note: 'Placeholder attribute added by VIBE mutation to ensure model change.']
  vibe_mutation_marker varchar [note: 'Marker added by VIBE mutator']
  vibe_mutation_test varchar [note: 'Added by VIBE mutation to ensure product is touched']
  vibe_structure_marker varchar [note: 'structure enforcement marker']

  Note: 'Master reference table for recurring_schedule. Referenced by recurring_schedule_id.'
}

Table finance.asset_book {
  asset_book_id varchar [pk, note: 'Primary key for asset_book']
  chart_of_accounts_id varchar
  cost_center_id varchar [note: 'Reference to the default cost center for assets tracked in this book, used for expense allocation and budgeting.']
  employee_id varchar [note: 'Reference to the user who created this asset book record.']
  financial_entity_id varchar
  fixed_asset_id varchar [note: 'FK to fixed asset']
  general_ledger_account_chart_of_accounts_id varchar [note: 'Reference to the general ledger account where asset values and depreciation expenses for this book are posted.']
  last_modified_by_user_employee_id varchar [note: 'Reference to the user who most recently modified this asset book record.']
  organization_id varchar [note: 'Reference to the legal entity or organizational unit that owns and maintains this asset book.']
  parent_asset_book_id varchar [note: 'Self-referencing FK on asset_book (parent_asset_book_id)']
  accounting_standard varchar [note: 'The accounting standard or framework governing depreciation and valuation rules for assets in this book.']
  accumulated_depreciation varchar
  allow_manual_depreciation boolean [note: 'Indicates whether manual depreciation adjustments are permitted for assets in this book, or if all depreciation must be system-calculated.']
  approval_required boolean [note: 'Indicates whether asset assignments or depreciation changes in this book require managerial or financial approval before posting.']
  approval_workflow_code varchar [note: 'Reference to the approval workflow process that governs changes to assets in this book. Null if no approval workflow is configured.']
  asset_book_description varchar [note: 'Detailed description of the asset book purpose, scope, and any special accounting rules or business context.']
  asset_book_status varchar [note: 'Current operational status of the asset book indicating whether it is actively used for asset tracking and depreciation calculations.']
  audit_trail_enabled boolean [note: 'Indicates whether detailed audit logging is enabled for all transactions and changes affecting assets in this book.']
  book_code varchar [note: 'Unique alphanumeric code identifying the asset book for external reference and reporting purposes.']
  book_name varchar [note: 'Full descriptive name of the asset book used for identification and reporting.']
  book_status varchar
  book_type varchar [note: 'Classification of the asset book based on its accounting purpose and regulatory framework.']
  consolidation_required boolean [note: 'Indicates whether asset values and depreciation from this book must be included in consolidated financial reporting.']
  created_timestamp timestamp [note: 'The date and time when this asset book record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code representing the functional currency for asset valuations and depreciation in this book.']
  default_depreciation_method varchar
  depreciation_method varchar [note: 'The default depreciation calculation method applied to assets assigned to this book.']
  effective_end_date date [note: 'The date when this asset book was closed or became inactive. Null for currently active books.']
  effective_start_date date [note: 'The date when this asset book became active and available for asset assignments and depreciation calculations.']
  fiscal_year_start_month varchar [note: 'The month number (1-12) when the fiscal year begins for this asset book, used for period-based depreciation calculations.']
  is_primary_book boolean
  is_tax_book boolean
  last_modified_timestamp timestamp [note: 'The date and time when this asset book record was most recently updated.']
  modified_timestamp timestamp
  net_book_value decimal(18,2)
  notes varchar [note: 'Free-form notes or comments providing additional context, special instructions, or historical information about this asset book.']
  parent_book_id varchar [note: 'Reference to a parent asset book if this book is a subsidiary or specialized book derived from a master book. Null for top-level books.']
  prorate_depreciation boolean [note: 'Indicates whether depreciation is prorated based on the asset acquisition date within the fiscal period.']
  regulatory_jurisdiction varchar [note: 'The geographic or regulatory jurisdiction governing the accounting rules for this asset book (e.g., federal, state, international).']
  salvage_value decimal(18,2) [note: 'Salvage value']
  salvage_value_required boolean [note: 'Indicates whether assets assigned to this book must have a salvage value specified for depreciation calculations.']
  tax_reporting_required boolean [note: 'Indicates whether assets in this book are subject to tax reporting requirements and must be included in tax filings.']
  useful_life_years decimal(5,2) [note: 'Useful life']
  vibe_mutation_added varchar [note: 'Added by VIBE mutation to satisfy target entity touch requirement']
  vibe_mutation_applied varchar
  vibe_mutation_extra varchar [note: 'Placeholder attribute added by VIBE mutation to ensure model change.']
  vibe_mutation_marker varchar [note: 'Marker added by VIBE mutator']
  vibe_mutation_test varchar [note: 'Added by VIBE mutation to ensure product is touched']
  vibe_structure_marker varchar [note: 'structure enforcement marker']

  Note: 'Master reference table for asset_book. Referenced by asset_book_id.'
}

Table finance.grant {
  grant_id varchar [pk, note: 'Primary key for grant']
  parent_grant_id varchar [note: 'Self-referencing FK on grant (parent_grant_id)']
  amount_expended decimal(18,2) [note: 'Cumulative funds spent against the award to date.']
  award_date date [note: 'Date the grant was officially awarded/executed by the sponsor.']
  awarded_amount decimal(18,2) [note: 'Total monetary amount awarded for the full grant period.']
  budget_period_end_date date [note: 'End date of the current budget period for the grant.']
  budget_period_start_date date [note: 'Start date of the current budget period for the grant.']
  cfda_number varchar [note: 'Federal assistance listing number identifying the federal program funding the grant.']
  closeout_date date [note: 'Date the grant was administratively and financially closed out.']
  compliance_status varchar [note: 'Current regulatory and reporting compliance state of the grant.']
  cost_center_code varchar [note: 'Internal cost center to which grant funds and expenditures are allocated.']
  cost_share_amount decimal(18,2) [note: 'Institutional matching or cost-share commitment amount required for the grant.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts on the grant.']
  direct_cost_amount decimal(18,2) [note: 'Portion of the award allocated to direct project costs.']
  federal_flag boolean [note: 'Indicates whether the grant is federally funded (subject to Uniform Guidance/Single Audit).']
  fund_code varchar [note: 'Restricted fund code used for fund accounting and segregation of grant monies.']
  funding_mechanism varchar [note: 'Instrument type through which funds are provided.']
  gl_account_code varchar [note: 'General ledger account code associated with the grant fund in the chart of accounts.']
  grant_description varchar [note: 'Detailed narrative description of the grant purpose and scope of funded work.']
  grant_number varchar [note: 'Externally-known award/reference number assigned by the sponsor or internal grants management system.']
  grant_status varchar [note: 'Current lifecycle state of the grant.']
  grant_type varchar [note: 'Categorical classification of the funding source or grant mechanism.']
  indirect_cost_amount decimal(18,2) [note: 'Facilities and Administrative (indirect) cost amount included in the award.']
  indirect_cost_rate_pct decimal(5,2) [note: 'Negotiated Facilities and Administrative (F&A) rate applied to direct costs, expressed as a percentage.']
  payment_method varchar [note: 'Mechanism by which the sponsor disburses funds to the institution.']
  principal_investigator_name varchar [note: 'Full name of the principal investigator responsible for the grant.']
  program_name varchar [note: 'Name of the specific sponsor program or funding opportunity under which the grant was awarded.']
  project_end_date date [note: 'Overall project period end date; nullable for open-ended awards.']
  project_start_date date [note: 'Overall project period start date across all budget periods.']
  reporting_frequency varchar [note: 'Required cadence of financial and progress reporting to the sponsor.']
  sponsor_award_number varchar [note: 'The award or contract number assigned by the external sponsor.']
  sponsor_name varchar [note: 'Name of the funding agency, sponsor, or grantor organization providing the award.']
  submission_date date [note: 'Date the grant proposal or application was submitted to the sponsor.']
  title varchar [note: 'Human-readable title of the grant or funded project.']

  Note: 'Master reference table for grant. Referenced by grant_id.'
}

Table insurance.payer {
  payer_id varchar [pk, note: 'Primary key for payer']
