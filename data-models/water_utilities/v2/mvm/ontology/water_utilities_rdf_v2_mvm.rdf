    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pfasPfhxsChain rdf:type rdf:Property ;
    rdfs:label 'Pfas Pfhxs Chain' ;
    rdfs:comment 'PFAS compound PFHxS classified as long-chain. Ref: Sensus AMI.' ;
    rdfs:domain ind:Contaminant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pfasPfnaChain rdf:type rdf:Property ;
    rdfs:label 'Pfas Pfna Chain' ;
    rdfs:comment 'PFAS compound PFNA classified as long-chain. Ref: Sensus AMI.' ;
    rdfs:domain ind:Contaminant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pfasPfoaChain rdf:type rdf:Property ;
    rdfs:label 'Pfas Pfoa Chain' ;
    rdfs:comment 'PFAS compound PFOA classified as long-chain. Ref: Sensus AMI.' ;
    rdfs:domain ind:Contaminant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pfasPfosChain rdf:type rdf:Property ;
    rdfs:label 'Pfas Pfos Chain' ;
    rdfs:comment 'PFAS compound PFOS classified as long-chain. Ref: Sensus AMI.' ;
    rdfs:domain ind:Contaminant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pfasSumOf20MemberFlag rdf:type rdf:Property ;
    rdfs:label 'Pfas Sum Of 20 Member Flag' ;
    rdfs:comment 'Indicates whether this PFAS compound is one of the 20 substances included in the EU DWD 2020/2184 sum-of-20 parametric value (0.10 ug/L). Ref: Sensus AMI.' ;
    rdfs:domain ind:Contaminant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:primaryTreatmentTechnology rdf:type rdf:Property ;
    rdfs:label 'Primary Treatment Technology' ;
    rdfs:comment 'Most effective treatment: GAC, ION_EXCHANGE, NANOFILTRATION, REVERSE_OSMOSIS, HIGH_PRESSURE_MEMBRANE. Ref: Sensus AMI.' ;
    rdfs:domain ind:Contaminant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:publicNotificationTier rdf:type rdf:Property ;
    rdfs:label 'Public Notification Tier' ;
    rdfs:comment 'The public notification tier value recorded for each contaminant in the quality domain.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reachRestrictedFlag rdf:type rdf:Property ;
    rdfs:label 'Reach Restricted Flag' ;
    rdfs:comment 'REACH PFAS restriction applicable. Ref: Sensus AMI.' ;
    rdfs:domain ind:Contaminant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reachRestrictionApplicable rdf:type rdf:Property ;
    rdfs:label 'Reach Restriction Applicable' ;
    rdfs:comment 'Subject to EU REACH PFAS restriction proposal. Ref: Sensus AMI.' ;
    rdfs:domain ind:Contaminant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reachRestrictionFlag rdf:type rdf:Property ;
    rdfs:label 'Reach Restriction Flag' ;
    rdfs:comment 'Subject to EU REACH PFAS restriction. Ref: Sensus AMI.' ;
    rdfs:domain ind:Contaminant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reachRestrictionStatus rdf:type rdf:Property ;
    rdfs:label 'Reach Restriction Status' ;
    rdfs:comment 'EU REACH PFAS restriction status: RESTRICTED, PROPOSED, NOT_RESTRICTED. Ref: Sensus AMI.' ;
    rdfs:domain ind:Contaminant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportingThresholdUnit rdf:type rdf:Property ;
    rdfs:label 'Reporting Threshold Unit' ;
    rdfs:comment 'The reporting threshold unit value recorded for each contaminant in the quality domain.' ;
    rdfs:domain ind:Contaminant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportingThresholdValue rdf:type rdf:Property ;
    rdfs:label 'Reporting Threshold Value' ;
    rdfs:comment 'The reporting threshold value value recorded for each contaminant in the quality domain.' ;
    rdfs:domain ind:Contaminant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:revisionDate rdf:type rdf:Property ;
    rdfs:label 'Revision Date' ;
    rdfs:comment 'The revision date associated with each contaminant record in the quality domain.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceCategory rdf:type rdf:Property ;
    rdfs:label 'Source Category' ;
    rdfs:comment 'The source category value recorded for each contaminant in the quality domain.' ;
    rdfs:domain ind:Contaminant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceDescription rdf:type rdf:Property ;
    rdfs:label 'Source Description' ;
    rdfs:comment 'Common sources. Ref: Sensus AMI.' ;
    rdfs:domain ind:Contaminant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subgroup rdf:type rdf:Property ;
    rdfs:label 'Subgroup' ;
    rdfs:comment 'The subgroup value recorded for each contaminant in the quality domain.' ;
    rdfs:domain ind:Contaminant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:treatmentTechniqueDescription rdf:type rdf:Property ;
    rdfs:label 'Treatment Technique Description' ;
    rdfs:comment 'The treatment technique description value recorded for each contaminant in the quality domain.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:treatmentTechniqueRequired rdf:type rdf:Property ;
    rdfs:label 'Treatment Technique Required' ;
    rdfs:comment 'The treatment technique required value recorded for each contaminant in the quality domain.' ;
    rdfs:domain ind:Contaminant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:usEpaHazardIndexMember rdf:type rdf:Property ;
    rdfs:label 'Us Epa Hazard Index Member' ;
    rdfs:comment 'Indicates if compound is part of US EPA Hazard Index group (PFNA, PFHxS, PFBS, HFPO-DA). Ref: Sensus AMI.' ;
    rdfs:domain ind:Contaminant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:usEpaHbwcNgL rdf:type rdf:Property ;
    rdfs:label 'Us Epa Hbwc Ng L' ;
    rdfs:comment 'US EPA Health-Based Water Concentration for Hazard Index calculation. Ref: Sensus AMI.' ;
    rdfs:domain ind:Contaminant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:usEpaMcl rdf:type rdf:Property ;
    rdfs:label 'Us Epa Mcl' ;
    rdfs:comment 'US EPA Maximum Contaminant Level. Ref: Sensus AMI.' ;
    rdfs:domain ind:Contaminant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:usEpaMclNgL rdf:type rdf:Property ;
    rdfs:label 'Us Epa Mcl Ng L' ;
    rdfs:comment 'US EPA Maximum Contaminant Level (MCL) for individual PFAS compounds in ng/L. Per EPA PFAS Rule 2024: PFOA = 4 ng/L, PFOS = 4 ng/L. Hazard index compounds (PFNA, PFHxS, PFBS, HFPO-DA) are regulated via hazard index MCL = 1.0. Ref: Sensus AMI.' ;
    rdfs:domain ind:Contaminant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:usEpaMclUnit rdf:type rdf:Property ;
    rdfs:label 'Us Epa Mcl Unit' ;
    rdfs:comment 'MCL unit (mg/L, ug/L, pCi/L, ppt). Ref: Sensus AMI.' ;
    rdfs:domain ind:Contaminant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:usEpaMclg rdf:type rdf:Property ;
    rdfs:label 'Us Epa Mclg' ;
    rdfs:comment 'US EPA MCL Goal. Ref: Sensus AMI.' ;
    rdfs:domain ind:Contaminant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:usHazardIndexHbwcNgL rdf:type rdf:Property ;
    rdfs:label 'Us Hazard Index Hbwc Ng L' ;
    rdfs:comment 'Health-Based Water Concentration for hazard index calculation per EPA 2024 NPDWR' ;
    rdfs:domain ind:Contaminant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:usHazardIndexMember rdf:type rdf:Property ;
    rdfs:label 'Us Hazard Index Member' ;
    rdfs:comment 'Boolean flag indicating whether this PFAS compound is included in the US EPA PFAS hazard index calculation (PFNA, PFHxS, PFBS, HFPO-DA/GenX). Hazard index MCL = 1.0 (unitless) per EPA PFAS Rule 2024. Ref: Sensus AMI.' ;
    rdfs:domain ind:Contaminant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:usHealthAdvisoryLevel rdf:type rdf:Property ;
    rdfs:label 'Us Health Advisory Level' ;
    rdfs:comment 'EPA health advisory level' ;
    rdfs:domain ind:Contaminant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:usIndividualMclNgL rdf:type rdf:Property ;
    rdfs:label 'Us Individual Mcl Ng L' ;
    rdfs:comment 'US EPA individual maximum contaminant level for this PFAS compound in nanograms per liter under the 2024 PFAS NPDWR.' ;
    rdfs:domain ind:Contaminant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:usMclNgL rdf:type rdf:Property ;
    rdfs:label 'Us Mcl Ng L' ;
    rdfs:comment 'US EPA MCL in ng/L for individual PFAS compound. Ref: Sensus AMI.' ;
    rdfs:domain ind:Contaminant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:usPerCompoundMclNgL rdf:type rdf:Property ;
    rdfs:label 'Us Per Compound Mcl Ng L' ;
    rdfs:comment 'US per-compound MCL in ng/L (PFOA 4.0, PFOS 4.0, PFNA/PFHxS/HFPO-DA 10.0; PFBS via hazard index). Ref: Sensus AMI.' ;
    rdfs:domain ind:Contaminant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:usRegulatedFlag rdf:type rdf:Property ;
    rdfs:label 'Us Regulated Flag' ;
    rdfs:comment 'US EPA regulated compound. Ref: Sensus AMI.' ;
    rdfs:domain ind:Contaminant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:violationTriggerLogic rdf:type rdf:Property ;
    rdfs:label 'Violation Trigger Logic' ;
    rdfs:comment 'The violation trigger logic value recorded for each contaminant in the quality domain.' ;
    rdfs:domain ind:Contaminant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wastewaterParameter rdf:type rdf:Property ;
    rdfs:label 'Wastewater Parameter' ;
    rdfs:comment 'The wastewater parameter value recorded for each contaminant in the quality domain.' ;
    rdfs:domain ind:Contaminant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:whoGuidelineValue rdf:type rdf:Property ;
    rdfs:label 'Who Guideline Value' ;
    rdfs:comment 'WHO drinking water guideline. Ref: Sensus AMI.' ;
    rdfs:domain ind:Contaminant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:analyticalMethodRequired rdf:type rdf:Property ;
    rdfs:label 'Analytical Method Required' ;
    rdfs:comment 'EPA-approved analytical method(s) required for measuring this contaminant. Examples: \'EPA Method 200.8\' (metals by ICP-MS), \'EPA Method 524.2\' (VOCs), \'EPA Method 537.1\' (PFAS), \'Standard Method 2320\' (alkalinity), \'EPA Method 1664A\' (oil and grease). Ref: Sensus AMI.' ;
    rdfs:domain ind:ContaminantLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:averagingPeriod rdf:type rdf:Property ;
    rdfs:label 'Averaging Period' ;
    rdfs:comment 'Time period over which the limit is calculated or averaged. Instantaneous = single sample, daily_max = maximum value in a day, monthly_avg = average over calendar month, quarterly_avg = average over quarter, annual_avg = average over calendar year, running_annual_avg = rolling 12-month average, locational_running_annual_avg = running annual average at specific sampling location (e.g., for DBPs under Stage 2 DBPR). [ENUM-REF-CANDIDATE: instantaneous|daily_max|monthly_avg|quarterly_avg|annual_avg|running_annual_avg|locational_running_annual_avg — 7 candidates stripped; promote to reference product]. Ref: Sensus AMI.' ;
    rdfs:domain ind:ContaminantLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contaminantLimitStatus rdf:type rdf:Property ;
    rdfs:label 'Contaminant Limit Status' ;
    rdfs:comment 'The contaminant limit status value recorded for each contaminant limit in the quality domain.' ;
    rdfs:domain ind:ContaminantLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:detectionLimitRequired rdf:type rdf:Property ;
    rdfs:label 'Detection Limit Required' ;
    rdfs:comment 'Minimum detection limit (MDL) or practical quantitation limit (PQL) required for the analytical method. Laboratory results must meet or exceed this sensitivity. Expressed in same unit_of_measure as limit_value. Ref: Sensus AMI.' ;
    rdfs:domain ind:ContaminantLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:exceedanceActionRequired rdf:type rdf:Property ;
    rdfs:label 'Exceedance Action Required' ;
    rdfs:comment 'Description of required actions when this limit is exceeded. Examples: \'Public notification within 24 hours\', \'Implement corrosion control treatment\', \'Increase monitoring frequency\', \'Submit corrective action plan within 30 days\', \'Immediate discharge cessation\'. Ref: Sensus AMI.' ;
    rdfs:domain ind:ContaminantLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jurisdictionAuthority rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction Authority' ;
    rdfs:comment 'Name of the regulatory authority or agency that issued this limit. Examples: \'U.S. EPA\', \'California State Water Resources Control Board\', \'Ohio EPA\', \'Local Municipal Authority\', or specific permit-issuing agency. Ref: Sensus AMI.' ;
    rdfs:domain ind:ContaminantLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:limitType rdf:type rdf:Property ;
    rdfs:label 'Limit Type' ;
    rdfs:comment 'Type of regulatory or operational limit. MCL = Maximum Contaminant Level (enforceable), MCLG = Maximum Contaminant Level Goal (non-enforceable health goal), action_level = threshold triggering corrective action (e.g., Lead and Copper Rule), treatment_technique = required treatment process standard, permit_limit = facility-specific NPDES or discharge permit limit. Ref: Sensus AMI.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:limitValue rdf:type rdf:Property ;
    rdfs:label 'Limit Value' ;
    rdfs:comment 'Numeric threshold value for the contaminant limit. For example, MCL for lead is 0.015 mg/L. Null if limit is qualitative (e.g., treatment technique with no numeric threshold). Ref: Sensus AMI.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:monitoringFrequencyRequired rdf:type rdf:Property ;
    rdfs:label 'Monitoring Frequency Required' ;
    rdfs:comment 'Required sampling and analysis frequency for this contaminant at this context. Examples: \'Quarterly\', \'Monthly\', \'Weekly\', \'Daily\', \'Continuous\', \'Every 3 years\', \'Per compliance schedule\'. May reference a compliance_schedule record for complex schedules. Ref: Sensus AMI.' ;
    rdfs:domain ind:ContaminantLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sampleLocationType rdf:type rdf:Property ;
    rdfs:label 'Sample Location Type' ;
    rdfs:comment 'Type of location where samples are collected for comparison against this limit. Entry_point = water entering distribution system, distribution_system = within distribution network, consumer_tap = at customer premise, source_water = raw water intake, effluent_discharge = treated wastewater discharge point, process_intermediate = within treatment process.' ;
    rdfs:domain ind:ContaminantLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supersededDate rdf:type rdf:Property ;
    rdfs:label 'Superseded Date' ;
    rdfs:comment 'Date when this limit was replaced by a newer regulation or permit condition. Null if the limit is currently active. Used for historical compliance analysis and regulatory change tracking. Ref: Sensus AMI.' ;
    rdfs:domain ind:ContaminantLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:varianceExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Variance Expiration Date' ;
    rdfs:comment 'Date when the variance or waiver expires and standard limit enforcement resumes. Null if no variance is in effect or if variance is indefinite (subject to periodic review). Ref: Sensus AMI.' ;
    rdfs:domain ind:ContaminantLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:varianceWaiverFlag rdf:type rdf:Property ;
    rdfs:label 'Variance Waiver Flag' ;
    rdfs:comment 'Indicates whether a variance or waiver has been granted for this limit at this monitoring context. True = variance/waiver in effect (limit may be temporarily relaxed or monitoring reduced), False = standard limit applies without exception. Ref: Sensus AMI.' ;
    rdfs:domain ind:ContaminantLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exceedanceId rdf:type rdf:Property ;
    rdfs:label 'Exceedance Id' ;
    rdfs:comment 'Primary key for exceedance. Ref: EPA SDWA.' ;
    rdfs:domain ind:Exceedance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ccrPeriodId rdf:type rdf:Property ;
    rdfs:label 'Ccr Period Id' ;
    rdfs:comment 'Foreign key linking to quality.ccr_period. Business justification: An exceedance detected during a reporting year must be disclosed in that year\'s Consumer Confidence Report (CCR). The ccr_period is the parent reporting period; exceedance is the child event that fall' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CcrPeriod .

ind:compliancePeriod rdf:type rdf:Property ;
    rdfs:label 'Compliance Period' ;
    rdfs:comment 'The compliance period value recorded for each exceedance in the quality domain.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:confirmationSampleRequired rdf:type rdf:Property ;
    rdfs:label 'Confirmation Sample Required' ;
    rdfs:comment 'Whether a confirmation sample must be collected. Ref: EPA SDWA.' ;
    rdfs:domain ind:Exceedance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:confirmedDate rdf:type rdf:Property ;
    rdfs:label 'Confirmed Date' ;
    rdfs:comment 'Date exceedance was confirmed by resampling. Ref: EPA SDWA.' ;
    rdfs:domain ind:Exceedance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:correctiveActionDeadline rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Deadline' ;
    rdfs:comment 'Deadline for completing corrective action. Ref: EPA SDWA.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:correctiveActionDescription rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Description' ;
    rdfs:comment 'Description of corrective action taken. Ref: EPA SDWA.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:correctiveActionInitiated rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Initiated' ;
    rdfs:comment 'Whether a corrective action has been initiated in response. Ref: EPA SDWA.' ;
    rdfs:domain ind:Exceedance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:correctiveActionRequired rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Required' ;
    rdfs:comment 'Whether corrective action is required. Ref: EPA SDWA.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:detectedDate rdf:type rdf:Property ;
    rdfs:label 'Detected Date' ;
    rdfs:comment 'The detected date associated with each exceedance record in the quality domain.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:detectedValue rdf:type rdf:Property ;
    rdfs:label 'Detected Value' ;
    rdfs:comment 'Detected concentration value. Ref: EPA SDWA.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:detectionDate rdf:type rdf:Property ;
    rdfs:label 'Detection Date' ;
    rdfs:comment 'Date exceedance was detected. Ref: EPA SDWA.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:exceedanceDate rdf:type rdf:Property ;
    rdfs:label 'Exceedance Date' ;
    rdfs:comment 'The exceedance date associated with each exceedance record in the quality domain.' ;
    rdfs:domain ind:Exceedance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:exceedanceNumber rdf:type rdf:Property ;
    rdfs:label 'Exceedance Number' ;
    rdfs:comment 'Unique exceedance reference number. Ref: EPA SDWA.' ;
    rdfs:domain ind:Exceedance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:exceedanceStatus rdf:type rdf:Property ;
    rdfs:label 'Exceedance Status' ;
    rdfs:comment 'Status (detected, confirmed, reported, resolved, under_review). Ref: EPA SDWA.' ;
    rdfs:domain ind:Exceedance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exceedanceType rdf:type rdf:Property ;
    rdfs:label 'Exceedance Type' ;
    rdfs:comment 'Type (MCL, MCLG, action_level, treatment_technique, secondary). Ref: EPA SDWA.' ;
    rdfs:domain ind:Exceedance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:factor rdf:type rdf:Property ;
    rdfs:label 'Factor' ;
    rdfs:comment 'Ratio of measured value to limit value. Ref: EPA SDWA.' ;
    rdfs:domain ind:Exceedance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isConfirmed rdf:type rdf:Property ;
    rdfs:label 'Is Confirmed' ;
    rdfs:comment 'Boolean flag indicating whether the is confirmed condition applies to the exceedance record.' ;
    rdfs:domain ind:Exceedance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:jurisdictionCode rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction Code' ;
    rdfs:comment 'Regulatory jurisdiction (US_EPA, EU_DWD, UK_DWI). Ref: EPA SDWA.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:kpiAddedFlag rdf:type rdf:Property ;
    rdfs:label 'Kpi Added Flag' ;
    rdfs:comment 'Flag indicating KPI metadata added. Ref: EPA SDWA.' ;
    rdfs:domain ind:Exceedance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:kpiNote rdf:type rdf:Property ;
    rdfs:label 'Kpi Note' ;
    rdfs:comment 'Placeholder attribute to ensure quality.exceedance is touched by KPI addition. Ref: EPA SDWA.' ;
    rdfs:domain ind:Exceedance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:magnitude rdf:type rdf:Property ;
    rdfs:label 'Magnitude' ;
    rdfs:comment 'Amount by which limit was exceeded. Ref: EPA SDWA.' ;
    rdfs:domain ind:Exceedance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:monitoringPeriod rdf:type rdf:Property ;
    rdfs:label 'Monitoring Period' ;
    rdfs:comment 'Monitoring period (monthly, quarterly, annual). Ref: EPA SDWA.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notificationDate rdf:type rdf:Property ;
    rdfs:label 'Notification Date' ;
    rdfs:comment 'The notification date associated with each exceedance record in the quality domain.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notificationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Notification Required Flag' ;
    rdfs:comment 'The notification required flag value recorded for each exceedance in the quality domain.' ;
    rdfs:domain ind:Exceedance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:parameter rdf:type rdf:Property ;
    rdfs:label 'Parameter' ;
    rdfs:comment 'Parameter that exceeded limit. Ref: EPA SDWA.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:parameterName rdf:type rdf:Property ;
    rdfs:label 'Parameter Name' ;
    rdfs:comment 'The parameter name used to identify each exceedance record in the quality domain.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:percentage rdf:type rdf:Property ;
    rdfs:label 'Percentage' ;
    rdfs:comment 'The percentage value recorded for each exceedance in the quality domain.' ;
    rdfs:domain ind:Exceedance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:publicNotificationDeadline rdf:type rdf:Property ;
    rdfs:label 'Public Notification Deadline' ;
    rdfs:comment 'Deadline for issuing public notification. Ref: EPA SDWA.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:publicNotificationDueDate rdf:type rdf:Property ;
    rdfs:label 'Public Notification Due Date' ;
    rdfs:comment 'Date by which public must be notified. Ref: EPA SDWA.' ;
    rdfs:domain ind:Exceedance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:publicNotificationIssued rdf:type rdf:Property ;
    rdfs:label 'Public Notification Issued' ;
    rdfs:comment 'Whether public notification was issued. Ref: EPA SDWA.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:publicNotificationIssuedDate rdf:type rdf:Property ;
    rdfs:label 'Public Notification Issued Date' ;
    rdfs:comment 'Date public notification was issued. Ref: EPA SDWA.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:publicNotificationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Public Notification Required Flag' ;
    rdfs:comment 'The public notification required flag value recorded for each exceedance in the quality domain.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:publicNotifiedDate rdf:type rdf:Property ;
    rdfs:label 'Public Notified Date' ;
    rdfs:comment 'Date public was actually notified. Ref: EPA SDWA.' ;
    rdfs:domain ind:Exceedance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:ratio rdf:type rdf:Property ;
    rdfs:label 'Ratio' ;
    rdfs:comment 'Ratio of detected value to MCL. Ref: EPA SDWA.' ;
    rdfs:domain ind:Exceedance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatoryCitation rdf:type rdf:Property ;
    rdfs:label 'Regulatory Citation' ;
    rdfs:comment 'Regulatory citation (40 CFR part, EU DWD Annex). Ref: EPA SDWA.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryFramework rdf:type rdf:Property ;
    rdfs:label 'Regulatory Framework' ;
    rdfs:comment 'Regulatory framework (EPA NPDWR, EU DWD 2020/2184, state primacy).' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryLimit rdf:type rdf:Property ;
    rdfs:label 'Regulatory Limit' ;
    rdfs:comment 'Applicable regulatory limit value. Ref: EPA SDWA.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryNotificationDueDate rdf:type rdf:Property ;
    rdfs:label 'Regulatory Notification Due Date' ;
    rdfs:comment 'Date by which regulator must be notified. Ref: EPA SDWA.' ;
    rdfs:domain ind:Exceedance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:regulatoryNotifiedDate rdf:type rdf:Property ;
    rdfs:label 'Regulatory Notified Date' ;
    rdfs:comment 'Date regulator was actually notified. Ref: EPA SDWA.' ;
    rdfs:domain ind:Exceedance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:reportableFlag rdf:type rdf:Property ;
    rdfs:label 'Reportable Flag' ;
    rdfs:comment 'The reportable flag value recorded for each exceedance in the quality domain.' ;
    rdfs:domain ind:Exceedance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reportedToAgencyDate rdf:type rdf:Property ;
    rdfs:label 'Reported To Agency Date' ;
    rdfs:comment 'Date the exceedance was reported to the regulatory agency. Ref: EPA SDWA.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:reportingDate rdf:type rdf:Property ;
    rdfs:label 'Reporting Date' ;
    rdfs:comment 'Date reported to regulatory agency. Ref: EPA SDWA.' ;
    rdfs:domain ind:Exceedance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reportingDeadlineDate rdf:type rdf:Property ;
    rdfs:label 'Reporting Deadline Date' ;
    rdfs:comment 'Regulatory reporting deadline. Ref: EPA SDWA.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:severity rdf:type rdf:Property ;
    rdfs:label 'Severity' ;
    rdfs:comment 'The severity value recorded for each exceedance in the quality domain.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:treatmentResponseDescription rdf:type rdf:Property ;
    rdfs:label 'Treatment Response Description' ;
    rdfs:comment 'Description of treatment response actions. Ref: EPA SDWA.' ;
    rdfs:domain ind:Exceedance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:treatmentResponseRequired rdf:type rdf:Property ;
    rdfs:label 'Treatment Response Required' ;
    rdfs:comment 'Whether treatment response is required. Ref: EPA SDWA.' ;
    rdfs:domain ind:Exceedance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:value rdf:type rdf:Property ;
    rdfs:label 'Value' ;
    rdfs:comment 'The value value recorded for each exceedance in the quality domain.' ;
    rdfs:domain ind:Exceedance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:leadCopperResultId rdf:type rdf:Property ;
    rdfs:label 'Lead Copper Result Id' ;
    rdfs:comment 'Unique identifier for the lead and copper sampling result record. Ref: EPA SDWA.' ;
    rdfs:domain ind:LeadCopperResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:actionLevelExceededFlag rdf:type rdf:Property ;
    rdfs:label 'Action Level Exceeded Flag' ;
    rdfs:comment 'The action level exceeded flag value recorded for each lead copper result in the quality domain.' ;
    rdfs:domain ind:LeadCopperResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:copperActionLevelExceeded rdf:type rdf:Property ;
    rdfs:label 'Copper Action Level Exceeded' ;
    rdfs:comment 'Indicates whether the copper result exceeds the EPA action level of 1300 ppb (1.3 mg/L), triggering potential corrosion control treatment requirements. Ref: EPA SDWA.' ;
    rdfs:domain ind:LeadCopperResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:copperActionLevelMgL rdf:type rdf:Property ;
    rdfs:label 'Copper Action Level Mg L' ;
    rdfs:comment 'The copper action level mg l value recorded for each lead copper result in the quality domain.' ;
    rdfs:domain ind:LeadCopperResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:copperConcentrationMgL rdf:type rdf:Property ;
    rdfs:label 'Copper Concentration Mg L' ;
    rdfs:comment 'The copper concentration mg l value recorded for each lead copper result in the quality domain.' ;
    rdfs:domain ind:LeadCopperResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:copperResultPpb rdf:type rdf:Property ;
    rdfs:label 'Copper Result Ppb' ;
    rdfs:comment 'Measured concentration of copper in the water sample expressed in parts per billion (ppb or µg/L). Used for 90th percentile calculation and action level comparison.' ;
    rdfs:domain ind:LeadCopperResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:corrosionControlTreatmentStatus rdf:type rdf:Property ;
    rdfs:label 'Corrosion Control Treatment Status' ;
    rdfs:comment 'Status of corrosion control treatment optimization at the time of sampling, indicating whether the water system has optimized corrosion control per LCRR requirements.' ;
    rdfs:domain ind:LeadCopperResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:customerNotificationDate rdf:type rdf:Property ;
    rdfs:label 'Customer Notification Date' ;
    rdfs:comment 'Date when the customer was notified of their individual lead and copper sample result. Ref: EPA SDWA.' ;
    rdfs:domain ind:LeadCopperResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:customerNotificationSent rdf:type rdf:Property ;
    rdfs:label 'Customer Notification Sent' ;
    rdfs:comment 'Indicates whether the customer was notified of their individual sample result as required by LCRR within 30 days of receiving results.' ;
    rdfs:domain ind:LeadCopperResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:detectionLimitCopperPpb rdf:type rdf:Property ;
    rdfs:label 'Detection Limit Copper Ppb' ;
    rdfs:comment 'Minimum concentration of copper that the analytical method can reliably detect and quantify for this sample. Ref: EPA SDWA.' ;
    rdfs:domain ind:LeadCopperResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:detectionLimitLeadPpb rdf:type rdf:Property ;
    rdfs:label 'Detection Limit Lead Ppb' ;
    rdfs:comment 'Minimum concentration of lead that the analytical method can reliably detect and quantify for this sample. Ref: EPA SDWA.' ;
    rdfs:domain ind:LeadCopperResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:holdingTimeCompliant rdf:type rdf:Property ;
    rdfs:label 'Holding Time Compliant' ;
    rdfs:comment 'Indicates whether the sample was analyzed within the EPA-required holding time (6 months for metals) from collection to analysis. Ref: EPA SDWA.' ;
    rdfs:domain ind:LeadCopperResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:includedIn90thPercentile rdf:type rdf:Property ;
    rdfs:label 'Included In 90th Percentile' ;
    rdfs:comment 'Indicates whether this result was included in the 90th percentile calculation for LCRR compliance determination. Invalid or QC-failed samples are excluded.' ;
    rdfs:domain ind:LeadCopperResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:leadActionLevelExceeded rdf:type rdf:Property ;
    rdfs:label 'Lead Action Level Exceeded' ;
    rdfs:comment 'Indicates whether the lead result exceeds the EPA action level of 15 ppb, triggering potential corrosion control treatment requirements. Ref: EPA SDWA.' ;
    rdfs:domain ind:LeadCopperResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:leadActionLevelMgL rdf:type rdf:Property ;
    rdfs:label 'Lead Action Level Mg L' ;
    rdfs:comment 'The lead action level mg l value recorded for each lead copper result in the quality domain.' ;
    rdfs:domain ind:LeadCopperResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:leadConcentrationMgL rdf:type rdf:Property ;
    rdfs:label 'Lead Concentration Mg L' ;
    rdfs:comment 'The lead concentration mg l value recorded for each lead copper result in the quality domain.' ;
    rdfs:domain ind:LeadCopperResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:leadCopperResultStatus rdf:type rdf:Property ;
    rdfs:label 'Lead Copper Result Status' ;
    rdfs:comment 'The lead copper result status value recorded for each lead copper result in the quality domain.' ;
    rdfs:domain ind:LeadCopperResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:leadResultPpb rdf:type rdf:Property ;
    rdfs:label 'Lead Result Ppb' ;
    rdfs:comment 'Measured concentration of lead in the water sample expressed in parts per billion (ppb or µg/L). Used for 90th percentile calculation and action level comparison.' ;
    rdfs:domain ind:LeadCopperResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ninetiethPercentileFlag rdf:type rdf:Property ;
    rdfs:label 'Ninetieth Percentile Flag' ;
    rdfs:comment 'The ninetieth percentile flag value recorded for each lead copper result in the quality domain.' ;
    rdfs:domain ind:LeadCopperResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:qualityControlStatus rdf:type rdf:Property ;
    rdfs:label 'Quality Control Status' ;
    rdfs:comment 'Laboratory quality control status indicating whether the sample result passed all QC checks including blanks, duplicates, and spike recoveries. Ref: EPA SDWA.' ;
    rdfs:domain ind:LeadCopperResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryReportingStatus rdf:type rdf:Property ;
    rdfs:label 'Regulatory Reporting Status' ;
    rdfs:comment 'Status of this result in the regulatory reporting workflow to state primacy agency and EPA. Ref: EPA SDWA.' ;
    rdfs:domain ind:LeadCopperResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remarks rdf:type rdf:Property ;
    rdfs:label 'Remarks' ;
    rdfs:comment 'Free-text field for additional notes, observations, or special circumstances related to the sample collection or analysis. Ref: EPA SDWA.' ;
    rdfs:domain ind:LeadCopperResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sampleCollectionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Sample Collection Timestamp' ;
    rdfs:comment 'The sample collection timestamp associated with each lead copper result record in the quality domain.' ;
    rdfs:domain ind:LeadCopperResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:samplePh rdf:type rdf:Property ;
    rdfs:label 'Sample Ph' ;
    rdfs:comment 'pH measurement of the water sample at collection, relevant for corrosion control assessment. Ref: EPA SDWA.' ;
    rdfs:domain ind:LeadCopperResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:samplePreservationMethod rdf:type rdf:Property ;
    rdfs:label 'Sample Preservation Method' ;
    rdfs:comment 'Method used to preserve the sample for metals analysis, typically acidification with nitric acid to pH < 2. Ref: EPA SDWA.' ;
    rdfs:domain ind:LeadCopperResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sampleTemperatureC rdf:type rdf:Property ;
    rdfs:label 'Sample Temperature C' ;
    rdfs:comment 'Water temperature at the time of sample collection, recorded to document field conditions. Ref: EPA SDWA.' ;
    rdfs:domain ind:LeadCopperResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:siteTier rdf:type rdf:Property ;
    rdfs:label 'Site Tier' ;
    rdfs:comment 'LCRR-mandated tier classification of the sampling site based on service line material and building construction date (Tier 1: lead service lines, Tier 2: lead status unknown, Tier 3: non-lead).' ;
    rdfs:domain ind:LeadCopperResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stagnationTimeHours rdf:type rdf:Property ;
    rdfs:label 'Stagnation Time Hours' ;
    rdfs:comment 'Duration in hours that water remained stagnant in the service line prior to sample collection. LCRR requires minimum 6-hour stagnation for first-draw samples.' ;
    rdfs:domain ind:LeadCopperResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ccrPeriodStatus rdf:type rdf:Property ;
    rdfs:label 'Ccr Period Status' ;
    rdfs:comment 'The ccr period status value recorded for each ccr period in the quality domain.' ;
    rdfs:domain ind:CcrPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:certificationMethod rdf:type rdf:Property ;
    rdfs:label 'Certification Method' ;
    rdfs:comment 'Method used to submit the CCR certification to the primacy agency. Many states now require electronic submission through online portals. Ref: EPA SDWA.' ;
    rdfs:domain ind:CcrPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:certificationSubmissionDate rdf:type rdf:Property ;
    rdfs:label 'Certification Submission Date' ;
    rdfs:comment 'Date when the CCR certification was submitted to the primacy agency. Systems must certify delivery of the CCR to customers by October 1. Ref: EPA SDWA.' ;
    rdfs:domain ind:CcrPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:certifiedByName rdf:type rdf:Property ;
    rdfs:label 'Certified By Name' ;
    rdfs:comment 'Name of the authorized water system official who certified the CCR. Typically the system manager, superintendent, or designated compliance officer. Ref: EPA SDWA.' ;
    rdfs:domain ind:CcrPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:certifiedByTitle rdf:type rdf:Property ;
    rdfs:label 'Certified By Title' ;
    rdfs:comment 'Job title of the authorized official who certified the CCR. Ref: EPA SDWA.' ;
    rdfs:domain ind:CcrPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactEmail rdf:type rdf:Property ;
    rdfs:label 'Contact Email' ;
    rdfs:comment 'Email address for customer inquiries about the CCR. Increasingly included as an additional contact method. Ref: EPA SDWA.' ;
    rdfs:domain ind:CcrPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactName rdf:type rdf:Property ;
    rdfs:label 'Contact Name' ;
    rdfs:comment 'Name of the water system contact person for customer questions about the CCR. Required to be included in the published report. Ref: EPA SDWA.' ;
    rdfs:domain ind:CcrPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactPhone rdf:type rdf:Property ;
    rdfs:label 'Contact Phone' ;
    rdfs:comment 'Phone number for customer inquiries about the CCR. Required to be included in the published report. Ref: EPA SDWA.' ;
    rdfs:domain ind:CcrPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:customersServedCount rdf:type rdf:Property ;
    rdfs:label 'Customers Served Count' ;
    rdfs:comment 'Total number of customer accounts or service connections served by the water system during the report year. Used to determine CCR distribution requirements. Ref: EPA SDWA.' ;
    rdfs:domain ind:CcrPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:distributionMethod rdf:type rdf:Property ;
    rdfs:label 'Distribution Method' ;
    rdfs:comment 'Primary method used to deliver the Consumer Confidence Report to customers. EPA allows mail, electronic delivery, or posting with notification. Ref: EPA SDWA.' ;
    rdfs:domain ind:CcrPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:distributionStatus rdf:type rdf:Property ;
    rdfs:label 'Distribution Status' ;
    rdfs:comment 'The distribution status value recorded for each ccr period in the quality domain.' ;
    rdfs:domain ind:CcrPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentFilePath rdf:type rdf:Property ;
    rdfs:label 'Document File Path' ;
    rdfs:comment 'File system path or cloud storage location of the final published CCR document (typically PDF format). Ref: EPA SDWA.' ;
    rdfs:domain ind:CcrPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:euConsumerInformationReference rdf:type rdf:Property ;
    rdfs:label 'Eu Consumer Information Reference' ;
    rdfs:comment 'Reference to EU DWD 2020/2184 Article 17 consumer information requirements or national transposition equivalent. NULL for US CCRs. Ref: EPA SDWA.' ;
    rdfs:domain ind:CcrPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:euDirectiveReference rdf:type rdf:Property ;
    rdfs:label 'Eu Directive Reference' ;
    rdfs:comment 'EU directive reference (Drinking Water Directive 2020/2184, WFD 2000/60/EC, UWWTD 91/271/EEC, REACH PFAS restriction). Ref: EPA SDWA.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:euDwdArticle17Compliance rdf:type rdf:Property ;
    rdfs:label 'Eu Dwd Article 17 Compliance' ;
    rdfs:comment 'Compliance with EU Drinking Water Directive 2020/2184 Article 17 consumer information requirements. Ref: EPA SDWA.' ;
    rdfs:domain ind:CcrPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:euDwdArticle17ComplianceFlag rdf:type rdf:Property ;
    rdfs:label 'Eu Dwd Article 17 Compliance Flag' ;
    rdfs:comment 'Flag indicating compliance with EU Drinking Water Directive 2020/2184 Article 17 public information requirements. Null for non-EU jurisdictions. Ref: EPA SDWA.' ;
    rdfs:domain ind:CcrPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:euDwdArticle17Compliant rdf:type rdf:Property ;
    rdfs:label 'Eu Dwd Article 17 Compliant' ;
    rdfs:comment 'Indicates compliance with EU Drinking Water Directive 2020/2184 Article 17 consumer information requirements. Ref: EPA SDWA.' ;
    rdfs:domain ind:CcrPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:euDwdComplianceFlag rdf:type rdf:Property ;
    rdfs:label 'Eu Dwd Compliance Flag' ;
    rdfs:comment 'Indicates whether the reporting period meets EU Drinking Water Directive 2020/2184 requirements for public information disclosure, equivalent to US CCR but under Article 17 transparency obligations. Ref: EPA SDWA.' ;
    rdfs:domain ind:CcrPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:euDwdReference rdf:type rdf:Property ;
    rdfs:label 'Eu Dwd Reference' ;
    rdfs:comment 'EU Drinking Water Directive 2020/2184 consumer information reference. Ref: EPA SDWA.' ;
    rdfs:domain ind:CcrPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:euReportingDirectiveReference rdf:type rdf:Property ;
    rdfs:label 'Eu Reporting Directive Reference' ;
    rdfs:comment 'EU reporting basis under Drinking Water Directive 2020/2184 for EU-flavor CCR-equivalent reporting. Ref: EPA SDWA.' ;
    rdfs:domain ind:CcrPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:healthEffectsLanguageIncludedFlag rdf:type rdf:Property ;
    rdfs:label 'Health Effects Language Included Flag' ;
    rdfs:comment 'Indicates whether mandatory EPA health effects language was included for all detected contaminants. Required for CCR compliance. Ref: EPA SDWA.' ;
    rdfs:domain ind:CcrPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:internationalReportFormat rdf:type rdf:Property ;
    rdfs:label 'International Report Format' ;
    rdfs:comment 'Report format standard: US_CCR (EPA), EU_DWD_ANNEX_IV, UK_DWI_ANNUAL, DE_TRINKWV, FR_ARS. Ref: EPA SDWA.' ;
    rdfs:domain ind:CcrPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:issuingAuthorityName rdf:type rdf:Property ;
    rdfs:label 'Issuing Authority Name' ;
    rdfs:comment 'Name of the regulatory authority overseeing this CCR/public information report (US EPA, DWI, ANSES, UBA). Ref: EPA SDWA.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jurisdictionRegion rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction Region' ;
    rdfs:comment 'Sub-national or supra-national region qualifier, e.g. US state abbreviation, EU member state, UK nation (England/Wales/Scotland), German Bundesland. Supports multi-level regulatory hierarchy. Ref: EPA SDWA.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jurisdictionRegionCode rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction Region Code' ;
    rdfs:comment 'ISO region code for CCR jurisdiction (US, EU, FR, UK, DE). US CCRs follow EPA requirements; EU equivalents follow DWD 2020/2184 Article 17 consumer information provisions.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jurisdictionalReportType rdf:type rdf:Property ;
    rdfs:label 'Jurisdictional Report Type' ;
    rdfs:comment 'Report flavor: US CCR vs EU DWD Article 17 consumer information. Ref: EPA SDWA.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:languageAccessibilityProvidedFlag rdf:type rdf:Property ;
    rdfs:label 'Language Accessibility Provided Flag' ;
    rdfs:comment 'Indicates whether the CCR was made available in languages other than English to serve non-English speaking populations. Required for systems serving significant non-English speaking populations. Ref: EPA SDWA.' ;
    rdfs:domain ind:CcrPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:leadCopperEducationalInformationFlag rdf:type rdf:Property ;
    rdfs:label 'Lead Copper Educational Information Flag' ;
    rdfs:comment 'Indicates whether mandatory lead and copper educational information was included in the CCR. Required under Lead and Copper Rule Revisions (LCRR).' ;
    rdfs:domain ind:CcrPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mclViolationCount rdf:type rdf:Property ;
    rdfs:label 'Mcl Violation Count' ;
    rdfs:comment 'Number of Maximum Contaminant Level violations that occurred during the report year. Must be prominently disclosed in the CCR. Ref: EPA SDWA.' ;
    rdfs:domain ind:CcrPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:monitoringViolationCount rdf:type rdf:Property ;
    rdfs:label 'Monitoring Violation Count' ;
    rdfs:comment 'Number of monitoring and reporting violations that occurred during the report year. Includes failures to test or report as required. Ref: EPA SDWA.' ;
    rdfs:domain ind:CcrPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:onlineCcrUrl rdf:type rdf:Property ;
    rdfs:label 'Online Ccr Url' ;
    rdfs:comment 'Web address where the CCR is posted online. Required if using electronic delivery method. Ref: EPA SDWA.' ;
    rdfs:domain ind:CcrPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:populationServedCount rdf:type rdf:Property ;
    rdfs:label 'Population Served Count' ;
    rdfs:comment 'Estimated total population receiving water from the system during the report year. Used for regulatory classification and reporting. Ref: EPA SDWA.' ;
    rdfs:domain ind:CcrPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:preparationStartDate rdf:type rdf:Property ;
    rdfs:label 'Preparation Start Date' ;
    rdfs:comment 'Date when preparation of the Consumer Confidence Report began. Typically starts in January following the report year. Ref: EPA SDWA.' ;
    rdfs:domain ind:CcrPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:primacyAgency rdf:type rdf:Property ;
    rdfs:label 'Primacy Agency' ;
    rdfs:comment 'State or tribal agency with primary enforcement responsibility for public water systems under the Safe Drinking Water Act. Typically the state Department of Environmental Quality or Health. Ref: EPA SDWA.' ;
    rdfs:domain ind:CcrPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:publicationDate rdf:type rdf:Property ;
    rdfs:label 'Publication Date' ;
    rdfs:comment 'Date when the Consumer Confidence Report was published and made available to customers. Must be by July 1 following the report year per EPA regulations. Ref: EPA SDWA.' ;
    rdfs:domain ind:CcrPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:publishedFlag rdf:type rdf:Property ;
    rdfs:label 'Published Flag' ;
    rdfs:comment 'The published flag value recorded for each ccr period in the quality domain.' ;
    rdfs:domain ind:CcrPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryBodyName rdf:type rdf:Property ;
    rdfs:label 'Regulatory Body Name' ;
    rdfs:comment 'Name of the regulatory agency or body with oversight, e.g. US EPA, state primacy agency, European Commission DG Environment, French ANSES, UK DWI (Drinking Water Inspectorate), German UBA (Umweltbundesamt), Australian NHMRC. Ref: EPA SDWA.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryDirectiveReference rdf:type rdf:Property ;
    rdfs:label 'Regulatory Directive Reference' ;
    rdfs:comment 'Specific directive, rule, or regulation citation, e.g. 40 CFR 141 (US NPDWR), Directive 2020/2184/EU Article 13, Directive 91/271/EEC Annex I, REACH Annex XVII PFAS restriction, French Code de la sante publique R.1321.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryFrameworkReference rdf:type rdf:Property ;
    rdfs:label 'Regulatory Framework Reference' ;
    rdfs:comment 'Framework governing the consumer report, e.g. US SDWA CCR or EU DWD 2020/2184. Ref: EU Drinking Water Directive 2020/2184; REACH PFAS restriction; Water Framework Directive 2000/60/EC; Urban Wastewater Treatment Directive 91/271/EEC. Ref: EPA SDWA.' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryRegionCode rdf:type rdf:Property ;
    rdfs:label 'Regulatory Region Code' ;
    rdfs:comment 'ISO region code for CCR jurisdiction (US, EU, FR, UK, DE)' ;
    rdfs:domain ind:WaterUtilities ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportStatus rdf:type rdf:Property ;
    rdfs:label 'Report Status' ;
    rdfs:comment 'Current lifecycle status of the Consumer Confidence Report. Tracks progression from draft through publication and certification to primacy agency. Ref: EPA SDWA.' ;
    rdfs:domain ind:CcrPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportYear rdf:type rdf:Property ;
    rdfs:label 'Report Year' ;
    rdfs:comment 'Calendar year for which this Consumer Confidence Report is prepared. CCRs are annual reports covering the previous calendar year\'s water quality data. Ref: EPA SDWA.' ;
    rdfs:domain ind:CcrPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reportingYear rdf:type rdf:Property ;
    rdfs:label 'Reporting Year' ;
    rdfs:comment 'The reporting year value recorded for each ccr period in the quality domain.' ;
    rdfs:domain ind:CcrPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sourceWaterAssessmentSummary rdf:type rdf:Property ;
    rdfs:label 'Source Water Assessment Summary' ;
    rdfs:comment 'Summary of the source water assessment including susceptibility to contamination and availability information. Required CCR content element. Ref: EPA SDWA.' ;
    rdfs:domain ind:CcrPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:specialNoticesIncluded rdf:type rdf:Property ;
    rdfs:label 'Special Notices Included' ;
    rdfs:comment 'Description of any special notices included in the CCR such as boil water advisories, vulnerable population warnings, or emerging contaminant information.' ;
    rdfs:domain ind:CcrPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:treatmentTechniqueViolationCount rdf:type rdf:Property ;
    rdfs:label 'Treatment Technique Violation Count' ;
    rdfs:comment 'Number of treatment technique violations that occurred during the report year. Treatment techniques are required processes for contaminants without MCLs. Ref: EPA SDWA.' ;
    rdfs:domain ind:CcrPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:violationSummary rdf:type rdf:Property ;
    rdfs:label 'Violation Summary' ;
    rdfs:comment 'Narrative summary of all violations that occurred during the report year, including health effects language and corrective actions taken. Required CCR content element. Ref: EPA SDWA.' ;
    rdfs:domain ind:CcrPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waterSourceSummary rdf:type rdf:Property ;
    rdfs:label 'Water Source Summary' ;
    rdfs:comment 'Narrative description of the water system\'s sources including surface water, groundwater, purchased water, and source water protection information. Required CCR content element. Ref: EPA SDWA.' ;
    rdfs:domain ind:CcrPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wfdRiverBasinDistrict rdf:type rdf:Property ;
    rdfs:label 'Wfd River Basin District' ;
    rdfs:comment 'EU Water Framework Directive 2000/60/EC river basin district identifier for source water context in EU jurisdictions. Ref: EPA SDWA.' ;
    rdfs:domain ind:CcrPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceTreatmentPermitId rdf:type rdf:Property ;
    rdfs:label 'Compliance Treatment Permit Id' ;
    rdfs:comment 'treatment permit id for compliance_permit. Ref: EPA SDWA.' ;
    rdfs:domain ind:CompliancePermit ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TreatmentPermit .

ind:primaryComplianceIssuingRegulatoryAgencyId rdf:type rdf:Property ;
    rdfs:label 'Primary Compliance Issuing Regulatory Agency Id' ;
    rdfs:comment 'FK to the regulatory agency that issued this permit, supporting multi-jurisdictional agency tracking (US EPA, ANSES, DWI, UBA). Ref: EPA SDWA.' ;
    rdfs:domain ind:CompliancePermit ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RegulatoryAgency .

ind:administrativeExtensionFlag rdf:type rdf:Property ;
    rdfs:label 'Administrative Extension Flag' ;
    rdfs:comment 'administrative extension flag for compliance_permit. Ref: EPA SDWA.' ;
    rdfs:domain ind:CompliancePermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:annualFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Annual Fee Amount' ;
    rdfs:comment 'Annual permit fee. Ref: EPA SDWA.' ;
    rdfs:domain ind:CompliancePermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:annualFeeUsd rdf:type rdf:Property ;
    rdfs:label 'Annual Fee Usd' ;
    rdfs:comment 'The annual fee usd value recorded for each compliance permit in the compliance domain.' ;
    rdfs:domain ind:CompliancePermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:compliancePermitNumber rdf:type rdf:Property ;
    rdfs:label 'Compliance Permit Number' ;
    rdfs:comment 'The compliance permit number value recorded for each compliance permit in the compliance domain.' ;
    rdfs:domain ind:CompliancePermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:compliancePermitStatus rdf:type rdf:Property ;
    rdfs:label 'Compliance Permit Status' ;
    rdfs:comment 'Lifecycle status of the record. Ref: EPA SDWA.' ;
    rdfs:domain ind:CompliancePermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:compliancePermitType rdf:type rdf:Property ;
    rdfs:label 'Compliance Permit Type' ;
    rdfs:comment 'The compliance permit type value recorded for each compliance permit in the compliance domain.' ;
    rdfs:domain ind:CompliancePermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceScheduleFlag rdf:type rdf:Property ;
    rdfs:label 'Compliance Schedule Flag' ;
    rdfs:comment 'compliance schedule flag for compliance_permit. Ref: EPA SDWA.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:conditionsCount rdf:type rdf:Property ;
    rdfs:label 'Conditions Count' ;
    rdfs:comment 'The permit conditions count value recorded for each compliance permit in the compliance domain.' ;
    rdfs:domain ind:CompliancePermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:directiveReference rdf:type rdf:Property ;
    rdfs:label 'Directive Reference' ;
    rdfs:comment 'EU directive or international regulation reference (e.g. 2000/60/EC, 91/271/EEC) under which this permit obligation arises. Ref: EPA SDWA.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:euDirectiveBasis rdf:type rdf:Property ;
    rdfs:label 'Eu Directive Basis' ;
    rdfs:comment 'For EU permits: underlying directive such as Water Framework Directive 2000/60/EC, Urban Wastewater Treatment Directive 91/271/EEC, or Drinking Water Directive 2020/2184. Ref: EPA SDWA.' ;
    rdfs:domain ind:CompliancePermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:euIedPermitNumber rdf:type rdf:Property ;
    rdfs:label 'Eu Ied Permit Number' ;
    rdfs:comment 'EU Industrial Emissions Directive 2010/75/EU permit number, applicable to large wastewater treatment installations in EU jurisdictions. Ref: EPA SDWA.' ;
    rdfs:domain ind:CompliancePermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:euPermitDirectiveReference rdf:type rdf:Property ;
    rdfs:label 'Eu Permit Directive Reference' ;
    rdfs:comment 'EU directive reference (Water Framework Directive 2000/60/EC, Urban Wastewater Treatment Directive 91/271/EEC, Drinking Water Directive 2020/2184) where applicable. Ref: EPA SDWA.' ;
    rdfs:domain ind:CompliancePermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:euUwwtdAgglomerationSize rdf:type rdf:Property ;
    rdfs:label 'Eu Uwwtd Agglomeration Size' ;
    rdfs:comment 'EU Urban Wastewater Treatment Directive 91/271/EEC agglomeration population equivalent category. Ref: EPA SDWA.' ;
    rdfs:domain ind:CompliancePermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:euWfdWaterBodyStatus rdf:type rdf:Property ;
    rdfs:label 'Eu Wfd Water Body Status' ;
    rdfs:comment 'EU Water Framework Directive 2000/60/EC water body ecological/chemical status classification. Ref: EPA SDWA.' ;
    rdfs:domain ind:CompliancePermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feeAmount rdf:type rdf:Property ;
    rdfs:label 'Fee Amount' ;
    rdfs:comment 'The permit fee amount value recorded for each compliance permit in the compliance domain.' ;
    rdfs:domain ind:CompliancePermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isGeneralPermit rdf:type rdf:Property ;
    rdfs:label 'Is General Permit' ;
    rdfs:comment 'Whether this is a general permit. Ref: EPA SDWA.' ;
    rdfs:domain ind:CompliancePermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isMajorPermit rdf:type rdf:Property ;
    rdfs:label 'Is Major Permit' ;
    rdfs:comment 'Whether this is a major permit (EPA classification). Ref: EPA SDWA.' ;
    rdfs:domain ind:CompliancePermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:issuingAgencyName rdf:type rdf:Property ;
    rdfs:label 'Issuing Agency Name' ;
    rdfs:comment 'Name of the regulatory agency that issued the permit. Ref: EPA SDWA.' ;
    rdfs:domain ind:CompliancePermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:issuingAgencyRegion rdf:type rdf:Property ;
    rdfs:label 'Issuing Agency Region' ;
    rdfs:comment 'Issuing agency region: EPA (US), EU Commission, ANSES/DWI/UBA (national). Ref: EPA SDWA.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:issuingMemberState rdf:type rdf:Property ;
    rdfs:label 'Issuing Member State' ;
    rdfs:comment 'For EU permits: ISO country code of member state issuing the permit (DE, FR, UK, etc.)' ;
    rdfs:domain ind:CompliancePermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jurisdictionFramework rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction Framework' ;
    rdfs:comment 'Framework governing the permit: US SDWA/NPDWR/LCRR (EPA); EU Drinking Water Directive 2020/2184; REACH PFAS restriction (ECHA); Water Framework Directive 2000/60/EC; Urban Wastewater Treatment Directive 91/271/EEC; FR ANSES national implementation; UK DWI national implementation; DE UBA national implementation' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:majorMinorFlag rdf:type rdf:Property ;
    rdfs:label 'Major Minor Flag' ;
    rdfs:comment 'Major or minor permit classification. Ref: EPA SDWA.' ;
    rdfs:domain ind:CompliancePermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:monitoringRequirementsCount rdf:type rdf:Property ;
    rdfs:label 'Monitoring Requirements Count' ;
    rdfs:comment 'The monitoring requirements count value recorded for each compliance permit in the compliance domain.' ;
    rdfs:domain ind:CompliancePermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:nationalCompetentAuthority rdf:type rdf:Property ;
    rdfs:label 'National Competent Authority' ;
    rdfs:comment 'National agency issuing permit: EPA (US), ANSES (FR), DWI (UK), UBA (DE), or state/regional equivalent. Ref: EPA SDWA.' ;
    rdfs:domain ind:CompliancePermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextReportingDueDate rdf:type rdf:Property ;
    rdfs:label 'Next Reporting Due Date' ;
    rdfs:comment 'next reporting due date for compliance_permit. Ref: EPA SDWA.' ;
    rdfs:domain ind:CompliancePermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:outfallCount rdf:type rdf:Property ;
    rdfs:label 'Outfall Count' ;
    rdfs:comment 'outfall count for compliance_permit. Ref: EPA SDWA.' ;
    rdfs:domain ind:CompliancePermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:permitCategory rdf:type rdf:Property ;
    rdfs:label 'Permit Category' ;
    rdfs:comment 'permit category for compliance_permit. Ref: EPA SDWA.' ;
    rdfs:domain ind:CompliancePermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:permitDescription rdf:type rdf:Property ;
    rdfs:label 'Permit Description' ;
    rdfs:comment 'Description of permit scope and conditions. Ref: EPA SDWA.' ;
    rdfs:domain ind:CompliancePermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:permitName rdf:type rdf:Property ;
    rdfs:label 'Permit Name' ;
    rdfs:comment 'Descriptive name of the permit. Ref: EPA SDWA.' ;
    rdfs:domain ind:CompliancePermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:permittedFlowMgd rdf:type rdf:Property ;
    rdfs:label 'Permitted Flow Mgd' ;
    rdfs:comment 'Permitted flow in MGD. Ref: EPA SDWA.' ;
    rdfs:domain ind:CompliancePermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:program rdf:type rdf:Property ;
    rdfs:label 'Program' ;
    rdfs:comment 'permit program for compliance_permit. Ref: EPA SDWA.' ;
    rdfs:domain ind:CompliancePermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:publicNoticeDate rdf:type rdf:Property ;
    rdfs:label 'Public Notice Date' ;
    rdfs:comment 'Date of public notice for permit. Ref: EPA SDWA.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:renewalApplicationDate rdf:type rdf:Property ;
    rdfs:label 'Renewal Application Date' ;
    rdfs:comment 'Date renewal application was submitted. Ref: EPA SDWA.' ;
    rdfs:domain ind:CompliancePermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:renewalApplicationDueDate rdf:type rdf:Property ;
    rdfs:label 'Renewal Application Due Date' ;
    rdfs:comment 'The renewal application due date associated with each compliance permit record in the compliance domain.' ;
    rdfs:domain ind:CompliancePermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:renewalDeadlineDate rdf:type rdf:Property ;
    rdfs:label 'Renewal Deadline Date' ;
    rdfs:comment 'Deadline for renewal application. Ref: EPA SDWA.' ;
    rdfs:domain ind:CompliancePermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:renewalDueDate rdf:type rdf:Property ;
    rdfs:label 'Renewal Due Date' ;
    rdfs:comment 'The renewal due date associated with each compliance permit record in the compliance domain.' ;
    rdfs:domain ind:CompliancePermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:reportingFrequency rdf:type rdf:Property ;
    rdfs:label 'Reporting Frequency' ;
    rdfs:comment 'The reporting frequency value recorded for each compliance permit in the compliance domain.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:treatmentFacilityCode rdf:type rdf:Property ;
    rdfs:label 'Treatment Facility Code' ;
    rdfs:comment 'Facility code from treatment domain. Ref: EPA SDWA.' ;
    rdfs:domain ind:CompliancePermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:uwwtdComplianceRoute rdf:type rdf:Property ;
    rdfs:label 'Uwwtd Compliance Route' ;
    rdfs:comment 'Compliance pathway under EU Urban Wastewater Treatment Directive 91/271/EEC: normal_area, sensitive_area, less_sensitive_area. Determines permit emission limit stringency. Ref: EPA SDWA.' ;
    rdfs:domain ind:CompliancePermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:permitConditionId rdf:type rdf:Property ;
    rdfs:label 'Permit Condition Id' ;
    rdfs:comment 'Unique identifier for the permit condition record. Primary key. Ref: EPA SDWA.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PermitCondition .

ind:complianceEvaluationMethod rdf:type rdf:Property ;
    rdfs:label 'Compliance Evaluation Method' ;
    rdfs:comment 'The method used to determine compliance with this condition: single value comparison (each result compared to limit), rolling average (moving average over specified period), statistical analysis (percentile or confidence interval), narrative assessment (qualitative evaluation), or best professional judgment (case-by-case determination).' ;
    rdfs:domain ind:PermitCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceScheduleMilestone rdf:type rdf:Property ;
    rdfs:label 'Compliance Schedule Milestone' ;
    rdfs:comment 'Description of the compliance schedule milestone associated with this condition (e.g., \'Submit engineering plans by 2024-06-30\', \'Complete construction by 2025-12-31\', \'Achieve interim limit of 30 mg/L BOD by 2024-12-31\'). Null if no compliance schedule applies. Ref: EPA SDWA.' ;
    rdfs:domain ind:PermitCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conditionNumber rdf:type rdf:Property ;
    rdfs:label 'Condition Number' ;
    rdfs:comment 'The official condition number or identifier as stated in the permit document (e.g., \'I.A.1\', \'II.B.3\', \'Condition 5\'). Ref: EPA SDWA.' ;
    rdfs:domain ind:PermitCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conditionText rdf:type rdf:Property ;
    rdfs:label 'Condition Text' ;
    rdfs:comment 'The full verbatim text of the permit condition as written in the permit document. Includes all narrative requirements, qualifications, and regulatory language. Ref: EPA SDWA.' ;
    rdfs:domain ind:PermitCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conditionType rdf:type rdf:Property ;
    rdfs:label 'Condition Type' ;
    rdfs:comment 'Classification of the permit condition: effluent limit (numeric discharge limit), monitoring requirement (sampling frequency and method), reporting requirement (MOR/DMR submission), technology-based standard (treatment technology mandate), narrative condition (qualitative requirement), or best management practice (operational control). Ref: EPA SDWA.' ;
    rdfs:domain ind:PermitCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:detectionLimitRequirement rdf:type rdf:Property ;
    rdfs:label 'Detection Limit Requirement' ;
    rdfs:comment 'The minimum detection limit (MDL) or practical quantitation limit (PQL) required for the analytical method. Ensures that the laboratory can measure the parameter at levels sufficiently below the permit limit to demonstrate compliance. Null if no specific detection limit is mandated. Ref: EPA SDWA.' ;
    rdfs:domain ind:PermitCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:enforcementPriority rdf:type rdf:Property ;
    rdfs:label 'Enforcement Priority' ;
    rdfs:comment 'The priority level assigned by the regulatory agency for enforcement of this condition. Critical conditions (e.g., public health parameters like coliform, lead, PFAS) trigger immediate enforcement action upon violation. High priority conditions (e.g., BOD, TSS, pH) require prompt corrective action. Medium and low priority conditions may allow for compliance schedules. Ref: EPA SDWA.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:limitUnit rdf:type rdf:Property ;
    rdfs:label 'Limit Unit' ;
    rdfs:comment 'Limit unit. Ref: EPA SDWA.' ;
    rdfs:domain ind:PermitCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mixingZoneAllowedFlag rdf:type rdf:Property ;
    rdfs:label 'Mixing Zone Allowed Flag' ;
    rdfs:comment 'Indicates whether a mixing zone (limited area where discharge is allowed to exceed water quality standards before achieving full dilution and compliance) is authorized for this condition. True if mixing zone is allowed, False if end-of-pipe compliance is required. Ref: EPA SDWA.' ;
    rdfs:domain ind:PermitCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mixingZoneDescription rdf:type rdf:Property ;
    rdfs:label 'Mixing Zone Description' ;
    rdfs:comment 'Description of the authorized mixing zone including dimensions, boundaries, and compliance monitoring points (e.g., \'100 meters downstream of Outfall 001\', \'Within 50-foot radius of discharge point\', \'Compliance measured at edge of mixing zone\'). Null if no mixing zone is allowed. Ref: EPA SDWA.' ;
    rdfs:domain ind:PermitCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modificationDate rdf:type rdf:Property ;
    rdfs:label 'Modification Date' ;
    rdfs:comment 'The date on which this permit condition was last modified through permit amendment, administrative order, or consent decree. Null if the condition has never been modified since the original permit issuance. Ref: EPA SDWA.' ;
    rdfs:domain ind:PermitCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:modificationReason rdf:type rdf:Property ;
    rdfs:label 'Modification Reason' ;
    rdfs:comment 'The reason for the most recent modification to this condition (e.g., \'Updated water quality standards\', \'New analytical method approved\', \'Compliance schedule adjustment\', \'Facility upgrade completed\', \'Enforcement action settlement\', \'Anti-backsliding provision waiver\'). Null if never modified. Ref: EPA SDWA.' ;
    rdfs:domain ind:PermitCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:monitoringLocation rdf:type rdf:Property ;
    rdfs:label 'Monitoring Location' ;
    rdfs:comment 'The specific location where monitoring or sampling must occur (e.g., \'Outfall 001\', \'Effluent Discharge Point A\', \'Influent to Primary Treatment\', \'Final Effluent\'). May reference a specific outfall, sampling point, or monitoring station. Ref: EPA SDWA.' ;
    rdfs:domain ind:PermitCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:numericLimit rdf:type rdf:Property ;
    rdfs:label 'Numeric Limit' ;
    rdfs:comment 'The numeric threshold value for the effluent limit or monitoring requirement. Null for narrative conditions or qualitative requirements. Ref: EPA SDWA.' ;
    rdfs:domain ind:PermitCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:qualityAssuranceRequirement rdf:type rdf:Property ;
    rdfs:label 'Quality Assurance Requirement' ;
    rdfs:comment 'Specific quality assurance and quality control (QA/QC) requirements for monitoring and sampling (e.g., \'EPA Method 1664A for FOG\', \'Standard Methods 5210B for BOD\', \'EPA Method 200.8 for metals\', \'Chain of custody required\', \'Laboratory must be state-certified\', \'Duplicate samples required quarterly\'). Ref: EPA SDWA.' ;
    rdfs:domain ind:PermitCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recordRetentionPeriodDays rdf:type rdf:Property ;
    rdfs:label 'Record Retention Period Days' ;
    rdfs:comment 'The number of days that monitoring records, laboratory results, and compliance documentation for this condition must be retained by the permittee. Typically 3 years (1095 days) for NPDES permits, but may be longer for certain parameters or enforcement actions. Ref: EPA SDWA.' ;
    rdfs:domain ind:PermitCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:seasonalPeriod rdf:type rdf:Property ;
    rdfs:label 'Seasonal Period' ;
    rdfs:comment 'The time period during which seasonal variations apply (e.g., \'May 1 - September 30\', \'Winter: November 1 - March 31\', \'Low Flow Season: June - August\'). Null if no seasonal variation applies. Ref: EPA SDWA.' ;
    rdfs:domain ind:PermitCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:seasonalVariationFlag rdf:type rdf:Property ;
    rdfs:label 'Seasonal Variation Flag' ;
    rdfs:comment 'Indicates whether this condition has seasonal variations in limits or monitoring requirements (e.g., more stringent limits during low-flow summer months, reduced monitoring during winter). True if seasonal variations apply, False otherwise. Ref: EPA SDWA.' ;
    rdfs:domain ind:PermitCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:technologyRequirement rdf:type rdf:Property ;
    rdfs:label 'Technology Requirement' ;
    rdfs:comment 'Specific treatment technology or operational practice mandated by this condition (e.g., \'Secondary Treatment\', \'Ultraviolet (UV) Disinfection\', \'Granular Activated Carbon (GAC) Filtration\', \'Reverse Osmosis (RO)\', \'Microfiltration (MF)\', \'Ultrafiltration (UF)\', \'Fats Oils and Grease (FOG) Pretreatment\', \'Best Management Practice (BMP) for Stormwater\'). Null for non-technology-based conditions. Ref: EPA SDWA.' ;
    rdfs:domain ind:PermitCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:violationThreshold rdf:type rdf:Property ;
    rdfs:label 'Violation Threshold' ;
    rdfs:comment 'The numeric value at which a violation is triggered. May differ from the numeric limit if the permit allows for measurement uncertainty, rounding conventions, or compliance margins. Null for narrative conditions. Ref: EPA SDWA.' ;
    rdfs:domain ind:PermitCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:waterQualityStandardBasis rdf:type rdf:Property ;
    rdfs:label 'Water Quality Standard Basis' ;
    rdfs:comment 'The specific water quality standard or criterion that this condition is designed to protect (e.g., \'Aquatic Life Chronic Criterion\', \'Human Health - Fish Consumption\', \'Drinking Water Maximum Contaminant Level (MCL)\', \'Recreational Water Quality Standard\', \'Anti-Degradation Policy Tier II\'). Null for technology-based conditions. Ref: EPA SDWA.' ;
    rdfs:domain ind:PermitCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicableFacilityType rdf:type rdf:Property ;
    rdfs:label 'Applicable Facility Type' ;
    rdfs:comment 'Type of facility or system to which this requirement applies. WTP = Water Treatment Plant, WWTP = Wastewater Treatment Plant, STP = Sewage Treatment Plant. Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicableSystemSize rdf:type rdf:Property ;
    rdfs:label 'Applicable System Size' ;
    rdfs:comment 'System size classification to which this requirement applies (e.g., large system >50,000 population, medium system 3,301-50,000, small system <=3,300). Null if applies to all sizes. Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:citation rdf:type rdf:Property ;
    rdfs:label 'Citation' ;
    rdfs:comment 'Regulatory citation. Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceDeadline rdf:type rdf:Property ;
    rdfs:label 'Compliance Deadline' ;
    rdfs:comment 'Date by which the utility must achieve full compliance with the requirement. Null if no specific deadline or if compliance is ongoing. Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:euDirectiveArticle rdf:type rdf:Property ;
    rdfs:label 'Eu Directive Article' ;
    rdfs:comment 'Specific article/annex reference within EU directives (e.g. Annex I Part B of DWD 2020/2184, Article 5 of WFD 2000/60/EC). NULL for non-EU requirements. Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:euParametricValue rdf:type rdf:Property ;
    rdfs:label 'Eu Parametric Value' ;
    rdfs:comment 'EU Drinking Water Directive parametric value equivalent to US MCL. Stored separately to support dual-jurisdiction compliance for utilities operating under both US EPA and EU/national frameworks (ANSES, DWI, UBA). Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:euParametricValueUnit rdf:type rdf:Property ;
    rdfs:label 'Eu Parametric Value Unit' ;
    rdfs:comment 'Unit of measure for the EU parametric value (e.g. ug/L, mg/L, Bq/L). Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:internalPolicyReference rdf:type rdf:Property ;
    rdfs:label 'Internal Policy Reference' ;
    rdfs:comment 'Reference to the utility\'s internal policy, procedure, or standard operating procedure (SOP) that implements this regulatory requirement. Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:internationalStandardReference rdf:type rdf:Property ;
    rdfs:label 'International Standard Reference' ;
    rdfs:comment 'ISO or WHO guideline reference' ;
    rdfs:domain ind:RegulatoryRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:issuingBodyReference rdf:type rdf:Property ;
    rdfs:label 'Issuing Body Reference' ;
    rdfs:comment 'Issuing regulatory body per region: ANSES; DWI; ECHA; EPA; European Commission; UBA. Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastComplianceAssessmentDate rdf:type rdf:Property ;
    rdfs:label 'Last Compliance Assessment Date' ;
    rdfs:comment 'Date of the most recent internal or external compliance assessment or audit for this requirement. Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nationalRegulationReference rdf:type rdf:Property ;
    rdfs:label 'National Regulation Reference' ;
    rdfs:comment 'National-level (FR/UK/DE) regulation reference; e.g. ANSES, DWI, UBA guidance. Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nationalTranspositionReference rdf:type rdf:Property ;
    rdfs:label 'National Transposition Reference' ;
    rdfs:comment 'Reference to national law transposing EU directive or national-specific regulation (e.g., French Code de la sante publique, German TrinkwV, UK Water Supply Regulations). Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextComplianceReviewDate rdf:type rdf:Property ;
    rdfs:label 'Next Compliance Review Date' ;
    rdfs:comment 'Scheduled date for the next compliance review or assessment of this requirement. Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:parametricValueEu rdf:type rdf:Property ;
    rdfs:label 'Parametric Value Eu' ;
    rdfs:comment 'EU Drinking Water Directive parametric value equivalent to US MCL. Stored alongside mcl_value for cross-jurisdictional comparison.' ;
    rdfs:domain ind:RegulatoryRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:parametricValueEuUnit rdf:type rdf:Property ;
    rdfs:label 'Parametric Value Eu Unit' ;
    rdfs:comment 'Unit of measurement for the EU parametric value (e.g. ug/L, mg/L). Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:penaltyDescription rdf:type rdf:Property ;
    rdfs:label 'Penalty Description' ;
    rdfs:comment 'Description of penalties or enforcement actions that may result from non-compliance (e.g., fines, consent orders, public notification requirements). Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulationUrl rdf:type rdf:Property ;
    rdfs:label 'Regulation Url' ;
    rdfs:comment 'Web URL or hyperlink to the official regulatory text or guidance document. Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requirementCategory rdf:type rdf:Property ;
    rdfs:label 'Requirement Category' ;
    rdfs:comment 'Classification of the type of regulatory obligation. MCL = Maximum Contaminant Level, MCLG = Maximum Contaminant Level Goal. [ENUM-REF-CANDIDATE: monitoring|reporting|operational_standard|MCL|MCLG|treatment_technique|permit_condition|discharge_limit — 8 candidates stripped; promote to reference product]. Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requirementCode rdf:type rdf:Property ;
    rdfs:label 'Requirement Code' ;
    rdfs:comment 'Unique business identifier or citation code for the regulatory requirement (e.g., 40 CFR 141.80, LCRR-2021, NPDES-001).' ;
    rdfs:domain ind:RegulatoryRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requirementDescription rdf:type rdf:Property ;
    rdfs:label 'Requirement Description' ;
    rdfs:comment 'Detailed description of the regulatory requirement, including the specific obligation imposed on the utility (e.g., monitoring frequency, reporting format, operational standard). Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requirementName rdf:type rdf:Property ;
    rdfs:label 'Requirement Name' ;
    rdfs:comment 'Requirement name. Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requirementTitle rdf:type rdf:Property ;
    rdfs:label 'Requirement Title' ;
    rdfs:comment 'Official title or short name of the regulatory requirement (e.g., Lead and Copper Rule Revisions, Maximum Contaminant Level for Arsenic). Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supersededRequirementCode rdf:type rdf:Property ;
    rdfs:label 'Superseded Requirement Code' ;
    rdfs:comment 'Citation or code of the previous regulatory requirement that this requirement supersedes or replaces. Null if not applicable. Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:usCfrReference rdf:type rdf:Property ;
    rdfs:label 'Us Cfr Reference' ;
    rdfs:comment 'US Code of Federal Regulations reference. Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:usRegulationReference rdf:type rdf:Property ;
    rdfs:label 'Us Regulation Reference' ;
    rdfs:comment 'US federal/state regulation citation e.g. 40 CFR Part 141 (NPDWR), LCRR.' ;
    rdfs:domain ind:RegulatoryRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wfdEnvironmentalQualityStandard rdf:type rdf:Property ;
    rdfs:label 'Wfd Environmental Quality Standard' ;
    rdfs:comment 'Numeric Environmental Quality Standard (EQS) value as defined under EU WFD Annex V or Priority Substances Directive 2013/39/EU. EQS are expressed as annual average (AA-EQS) or maximum allowable concentration (MAC-EQS), differing from US water quality criteria which use CMC/CCC terminology. Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:wfdQualityElementCategory rdf:type rdf:Property ;
    rdfs:label 'Wfd Quality Element Category' ;
    rdfs:comment 'EU Water Framework Directive quality element category: biological (phytoplankton, macrophytes, benthic invertebrates, fish), hydromorphological, or physico-chemical. The WFD one-out-all-out principle means the worst-scoring element determines overall surface-water status, unlike US impairment listing which is parameter-specific. Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wfdSurfaceWaterStatusClass rdf:type rdf:Property ;
    rdfs:label 'Wfd Surface Water Status Class' ;
    rdfs:comment 'EU WFD ecological status classification: High, Good, Moderate, Poor, Bad. Under WFD Article 4, member states must achieve Good status for all water bodies. This five-class system differs from US CWA designated-use attainment which is binary (attaining/not attaining). Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dmrId rdf:type rdf:Property ;
    rdfs:label 'Dmr Id' ;
    rdfs:comment 'Unique identifier for the discharge monitoring report record. Ref: EPA SDWA.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Dmr .

ind:originalDmrId rdf:type rdf:Property ;
    rdfs:label 'Original Dmr Id' ;
    rdfs:comment 'Reference to the original discharge monitoring report record if this is a resubmission or correction. Ref: EPA SDWA.' ;
    rdfs:domain ind:Dmr ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Dmr .

ind:acknowledgmentDate rdf:type rdf:Property ;
    rdfs:label 'Acknowledgment Date' ;
    rdfs:comment 'The date on which the regulatory authority acknowledged receipt of this discharge monitoring report. Ref: EPA SDWA.' ;
    rdfs:domain ind:Dmr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:certificationDate rdf:type rdf:Property ;
    rdfs:label 'Certification Date' ;
    rdfs:comment 'The date on which the certifying official signed and certified this discharge monitoring report, attesting to its accuracy under penalty of law. Ref: EPA SDWA.' ;
    rdfs:domain ind:Dmr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:certificationStatement rdf:type rdf:Property ;
    rdfs:label 'Certification Statement' ;
    rdfs:comment 'The full text of the legal certification statement signed by the certifying official, typically stating that the report was prepared under their direction and supervision and that the information is true, accurate, and complete to the best of their knowledge. Ref: EPA SDWA.' ;
    rdfs:domain ind:Dmr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:certifyingOfficialName rdf:type rdf:Property ;
    rdfs:label 'Certifying Official Name' ;
    rdfs:comment 'The full name of the authorized signatory who certified the accuracy and completeness of this discharge monitoring report (typically a principal executive officer or ranking elected official). Ref: EPA SDWA.' ;
    rdfs:domain ind:Dmr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:certifyingOfficialTitle rdf:type rdf:Property ;
    rdfs:label 'Certifying Official Title' ;
    rdfs:comment 'The job title or position of the authorized signatory who certified this discharge monitoring report (e.g., General Manager, Mayor, Director of Public Works). Ref: EPA SDWA.' ;
    rdfs:domain ind:Dmr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dmrNumber rdf:type rdf:Property ;
    rdfs:label 'Dmr Number' ;
    rdfs:comment 'Externally-known unique identifier or tracking number for this discharge monitoring report, often assigned by the regulatory authority or internal tracking system. Ref: EPA SDWA.' ;
    rdfs:domain ind:Dmr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dmrStatus rdf:type rdf:Property ;
    rdfs:label 'Dmr Status' ;
    rdfs:comment 'DMR status. Ref: EPA SDWA.' ;
    rdfs:domain ind:Dmr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:euCompetentAuthorityCode rdf:type rdf:Property ;
    rdfs:label 'Eu Competent Authority Code' ;
    rdfs:comment 'Code of EU member state competent authority receiving the report (e.g., ANSES, DWI, UBA regional offices). Ref: EPA SDWA.' ;
    rdfs:domain ind:Dmr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:euDischargeDirectiveReference rdf:type rdf:Property ;
    rdfs:label 'Eu Discharge Directive Reference' ;
    rdfs:comment 'EU discharge framework (Urban Wastewater Treatment Directive 91/271/EEC, Water Framework Directive 2000/60/EC) for EU-flavor DMR-equivalent submissions. Ref: EPA SDWA.' ;
    rdfs:domain ind:Dmr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:euReportingDirective rdf:type rdf:Property ;
    rdfs:label 'Eu Reporting Directive' ;
    rdfs:comment 'EU directive under which this report is submitted (e.g. UWWTD 91/271/EEC Article 15, WFD 2000/60/EC Article 15). NULL for US DMRs. Ref: EPA SDWA.' ;
    rdfs:domain ind:Dmr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:euUwwtdReference rdf:type rdf:Property ;
    rdfs:label 'Eu Uwwtd Reference' ;
    rdfs:comment 'EU Urban Wastewater Treatment Directive 91/271/EEC / WFD 2000/60/EC reference. Ref: EPA SDWA.' ;
    rdfs:domain ind:Dmr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:euUwwtdReportingFlag rdf:type rdf:Property ;
    rdfs:label 'Eu Uwwtd Reporting Flag' ;
    rdfs:comment 'Indicates if report satisfies EU Urban Wastewater Treatment Directive 91/271/EEC Article 15 reporting requirements. Ref: EPA SDWA.' ;
    rdfs:domain ind:Dmr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exceedanceCount rdf:type rdf:Property ;
    rdfs:label 'Exceedance Count' ;
    rdfs:comment 'The total number of individual parameter measurements within this discharge monitoring report that exceeded their respective permit limits. Ref: EPA SDWA.' ;
    rdfs:domain ind:Dmr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isNoDischarge rdf:type rdf:Property ;
    rdfs:label 'Is No Discharge' ;
    rdfs:comment 'No discharge flag. Ref: EPA SDWA.' ;
    rdfs:domain ind:Dmr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lateSubmissionFlag rdf:type rdf:Property ;
    rdfs:label 'Late Submission Flag' ;
    rdfs:comment 'Indicates whether this discharge monitoring report was submitted after the regulatory deadline (True if late, False if on time). Ref: EPA SDWA.' ;
    rdfs:domain ind:Dmr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:noDischargeFlag rdf:type rdf:Property ;
    rdfs:label 'No Discharge Flag' ;
    rdfs:comment 'Indicates whether there was no discharge from the outfall during the reporting period (True if no discharge occurred, False if discharge occurred). Ref: EPA SDWA.' ;
    rdfs:domain ind:Dmr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:noDischargeReason rdf:type rdf:Property ;
    rdfs:label 'No Discharge Reason' ;
    rdfs:comment 'Explanation for why no discharge occurred during the reporting period (e.g., facility shutdown, seasonal operations, maintenance outage). Ref: EPA SDWA.' ;
    rdfs:domain ind:Dmr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:noncomplianceFlag rdf:type rdf:Property ;
    rdfs:label 'Noncompliance Flag' ;
    rdfs:comment 'Indicates whether this discharge monitoring report contains any parameter measurements that exceeded permitted limits, triggering a noncompliance event (True if noncompliance detected, False if all parameters within limits). Ref: EPA SDWA.' ;
    rdfs:domain ind:Dmr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:preparerEmail rdf:type rdf:Property ;
    rdfs:label 'Preparer Email' ;
    rdfs:comment 'The email address of the individual who prepared this discharge monitoring report. Ref: EPA SDWA.' ;
    rdfs:domain ind:Dmr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preparerName rdf:type rdf:Property ;
    rdfs:label 'Preparer Name' ;
    rdfs:comment 'The full name of the individual who prepared and compiled this discharge monitoring report. Ref: EPA SDWA.' ;
    rdfs:domain ind:Dmr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preparerPhone rdf:type rdf:Property ;
    rdfs:label 'Preparer Phone' ;
    rdfs:comment 'The contact phone number for the individual who prepared this discharge monitoring report. Ref: EPA SDWA.' ;
    rdfs:domain ind:Dmr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preparerTitle rdf:type rdf:Property ;
    rdfs:label 'Preparer Title' ;
    rdfs:comment 'The job title or position of the individual who prepared this discharge monitoring report (e.g., Environmental Compliance Manager, Laboratory Supervisor).' ;
    rdfs:domain ind:Dmr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryAuthority rdf:type rdf:Property ;
    rdfs:label 'Regulatory Authority' ;
    rdfs:comment 'The regulatory body to which this discharge monitoring report was submitted (EPA for direct federal permits or state primacy agency for delegated state programs). Ref: EPA SDWA.' ;
    rdfs:domain ind:Dmr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportingPeriodEnd rdf:type rdf:Property ;
    rdfs:label 'Reporting Period End' ;
    rdfs:comment 'Period end. Ref: EPA SDWA.' ;
    rdfs:domain ind:Dmr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reportingPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Reporting Period End Date' ;
    rdfs:comment 'The last day of the monitoring period covered by this discharge monitoring report (typically the last day of the month or quarter). Ref: EPA SDWA.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reportingPeriodStart rdf:type rdf:Property ;
    rdfs:label 'Reporting Period Start' ;
    rdfs:comment 'Period start. Ref: EPA SDWA.' ;
    rdfs:domain ind:Dmr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reportingPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Reporting Period Start Date' ;
    rdfs:comment 'The first day of the monitoring period covered by this discharge monitoring report (typically the first day of the month or quarter). Ref: EPA SDWA.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:resubmissionFlag rdf:type rdf:Property ;
    rdfs:label 'Resubmission Flag' ;
    rdfs:comment 'Indicates whether this discharge monitoring report is a resubmission of a previously rejected or corrected report (True if resubmission, False if original submission). Ref: EPA SDWA.' ;
    rdfs:domain ind:Dmr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:stateAgencyName rdf:type rdf:Property ;
    rdfs:label 'State Agency Name' ;
    rdfs:comment 'The name of the state environmental or water quality agency that received this discharge monitoring report if submitted under a state-delegated NPDES program. Ref: EPA SDWA.' ;
    rdfs:domain ind:Dmr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submissionDueDate rdf:type rdf:Property ;
    rdfs:label 'Submission Due Date' ;
    rdfs:comment 'The regulatory deadline by which this discharge monitoring report must be submitted (typically the 28th day of the month following the reporting period). Ref: EPA SDWA.' ;
    rdfs:domain ind:Dmr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:submissionMethod rdf:type rdf:Property ;
    rdfs:label 'Submission Method' ;
    rdfs:comment 'The method by which this discharge monitoring report was submitted to the regulatory authority (NetDMR electronic system, paper mail, email, state-specific portal, or other). Ref: EPA SDWA.' ;
    rdfs:domain ind:Dmr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submissionStatus rdf:type rdf:Property ;
    rdfs:label 'Submission Status' ;
    rdfs:comment 'The current status of this discharge monitoring report in the submission and review workflow (draft, submitted, accepted by authority, rejected, under review, or resubmitted after corrections). Ref: EPA SDWA.' ;
    rdfs:domain ind:Dmr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:uwwtdAgglomerationCode rdf:type rdf:Property ;
    rdfs:label 'Uwwtd Agglomeration Code' ;
    rdfs:comment 'EU Urban Wastewater Treatment Directive 91/271/EEC agglomeration identifier. Used for EU discharge monitoring reports submitted to the European Commission under Article 15. Ref: EPA SDWA.' ;
    rdfs:domain ind:Dmr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:uwwtdTreatmentLevel rdf:type rdf:Property ;
    rdfs:label 'Uwwtd Treatment Level' ;
    rdfs:comment 'Treatment level classification per UWWTD 91/271/EEC: primary, secondary, more_stringent (nutrient removal). Determines applicable emission limit values in EU jurisdictions. Ref: EPA SDWA.' ;
    rdfs:domain ind:Dmr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wfdWaterBodyCode rdf:type rdf:Property ;
    rdfs:label 'Wfd Water Body Code' ;
    rdfs:comment 'EU Water Framework Directive 2000/60/EC receiving water body identifier. Links discharge monitoring to WFD environmental quality standards and good ecological status objectives. Ref: EPA SDWA.' ;
    rdfs:domain ind:Dmr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wfdWaterBodyStatusImpact rdf:type rdf:Property ;
    rdfs:label 'Wfd Water Body Status Impact' ;
    rdfs:comment 'Impact assessment on receiving water body status per Water Framework Directive 2000/60/EC: GOOD, MODERATE, POOR, BAD. Ref: EPA SDWA.' ;
    rdfs:domain ind:Dmr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dmrResultId rdf:type rdf:Property ;
    rdfs:label 'Dmr Result Id' ;
    rdfs:comment 'Unique identifier for the individual parameter measurement result recorded on a Discharge Monitoring Report. Primary key for granular compliance tracking at the parameter level. Ref: EPA SDWA.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DmrResult .

ind:enforcementActionRequired rdf:type rdf:Property ;
    rdfs:label 'Enforcement Action Required' ;
    rdfs:comment 'Boolean indicator of whether this result triggers a mandatory enforcement action under the permit or regulatory framework. True initiates enforcement workflows. Ref: EPA SDWA.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exceedanceFlag rdf:type rdf:Property ;
    rdfs:label 'Exceedance Flag' ;
    rdfs:comment 'Boolean indicator of whether the measured value exceeded the permit limit. True indicates a violation requiring reporting and potential enforcement action. Ref: EPA SDWA.' ;
    rdfs:domain ind:DmrResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isViolation rdf:type rdf:Property ;
    rdfs:label 'Is Violation' ;
    rdfs:comment 'Violation flag. Ref: EPA SDWA.' ;
    rdfs:domain ind:DmrResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:measurementFrequency rdf:type rdf:Property ;
    rdfs:label 'Measurement Frequency' ;
    rdfs:comment 'The frequency at which this parameter is required to be monitored under the permit (daily, weekly, monthly, quarterly, annual, continuous). Determines sampling schedule and compliance evaluation periods. Ref: EPA SDWA.' ;
    rdfs:domain ind:DmrResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:measurementValue rdf:type rdf:Property ;
    rdfs:label 'Measurement Value' ;
    rdfs:comment 'The actual numeric value measured for this parameter during the monitoring period. Precision supports a wide range of parameter types from trace contaminants to high-volume flow measurements. Ref: EPA SDWA.' ;
    rdfs:domain ind:DmrResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:monitoringLocationCode rdf:type rdf:Property ;
    rdfs:label 'Monitoring Location Code' ;
    rdfs:comment 'The specific monitoring point or location code as designated in the NPDES permit. May differ from outfall_id for internal monitoring points or upstream/downstream reference locations. Ref: EPA SDWA.' ;
    rdfs:domain ind:DmrResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nodiCode rdf:type rdf:Property ;
    rdfs:label 'Nodi Code' ;
    rdfs:comment 'EPA code indicating why no measurement data is reported for a required parameter (e.g., 9 for no discharge, C for facility not operational, Q for quality assurance issue). Used when measurement_value is null. Ref: EPA SDWA.' ;
    rdfs:domain ind:DmrResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:numberOfExceedances rdf:type rdf:Property ;
    rdfs:label 'Number Of Exceedances' ;
    rdfs:comment 'The count of individual samples that exceeded the permit limit during the reporting period. Used for compliance tracking and violation severity assessment. Ref: EPA SDWA.' ;
    rdfs:domain ind:DmrResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:numberOfSamples rdf:type rdf:Property ;
    rdfs:label 'Number Of Samples' ;
    rdfs:comment 'The total number of individual samples collected and analyzed during the reporting period for this parameter. Used to calculate statistical bases like monthly averages. Ref: EPA SDWA.' ;
    rdfs:domain ind:DmrResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:parameterCode rdf:type rdf:Property ;
    rdfs:label 'Parameter Code' ;
    rdfs:comment 'Standardized code identifying the specific effluent parameter being measured (e.g., 00310 for BOD, 00340 for COD, 00530 for TSS, 00600 for TDS, 00400 for pH, 50050 for flow, 31616 for fecal coliform, 00620 for nitrate, 00665 for phosphorus). Uses EPA parameter codes from the STORET database. Ref: EPA SDWA.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qaQcNotes rdf:type rdf:Property ;
    rdfs:label 'Qa Qc Notes' ;
    rdfs:comment 'Free-text notes documenting quality assurance or quality control issues, corrective actions, or special circumstances affecting this measurement. Supports audit trails and regulatory inquiries. Ref: EPA SDWA.' ;
    rdfs:domain ind:DmrResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:quantificationLimit rdf:type rdf:Property ;
    rdfs:label 'Quantification Limit' ;
    rdfs:comment 'The minimum concentration that can be reliably quantified by the analytical method. Typically higher than the detection limit and used for regulatory compliance evaluation. Ref: EPA SDWA.' ;
    rdfs:domain ind:DmrResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:statisticalBase rdf:type rdf:Property ;
    rdfs:label 'Statistical Base' ;
    rdfs:comment 'The statistical qualifier or basis for the reported value (e.g., daily maximum, monthly average, weekly average, annual average, instantaneous, geometric mean). Determines how the measurement is compared against permit limits. [ENUM-REF-CANDIDATE: daily_maximum|daily_minimum|monthly_average|weekly_average|annual_average|instantaneous|geometric_mean — 7 candidates stripped; promote to reference product]. Ref: EPA SDWA.' ;
    rdfs:domain ind:DmrResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submittedToRegulatorFlag rdf:type rdf:Property ;
    rdfs:label 'Submitted To Regulator Flag' ;
    rdfs:comment 'Boolean indicator of whether this result has been officially submitted to the regulatory agency as part of the DMR. True indicates the data is part of the official compliance record. Ref: EPA SDWA.' ;
    rdfs:domain ind:DmrResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:violationCategory rdf:type rdf:Property ;
    rdfs:label 'Violation Category' ;
    rdfs:comment 'Classification of the type of violation if non-compliant (effluent limit exceedance, monitoring frequency violation, reporting violation, or none). Used for enforcement prioritization and trend analysis. Ref: EPA SDWA.' ;
    rdfs:domain ind:DmrResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:violationId rdf:type rdf:Property ;
    rdfs:label 'Violation Id' ;
    rdfs:comment 'Unique identifier for the compliance_violation data product (auto-inserted pre-linking). Ref: EPA SDWA.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Violation .

ind:beginDate rdf:type rdf:Property ;
    rdfs:label 'Begin Date' ;
    rdfs:comment 'Date violation period began. Ref: EPA SDWA.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:compliancePeriodBegin rdf:type rdf:Property ;
    rdfs:label 'Compliance Period Begin' ;
    rdfs:comment 'Start of compliance period. Ref: EPA SDWA.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:compliancePeriodBeginDate rdf:type rdf:Property ;
    rdfs:label 'Compliance Period Begin Date' ;
    rdfs:comment 'Start of compliance monitoring period. Ref: EPA SDWA.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:compliancePeriodEnd rdf:type rdf:Property ;
    rdfs:label 'Compliance Period End' ;
    rdfs:comment 'End of compliance period. Ref: EPA SDWA.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:compliancePeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Compliance Period End Date' ;
    rdfs:comment 'End of compliance monitoring period. Ref: EPA SDWA.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:compliancePeriodStart rdf:type rdf:Property ;
    rdfs:label 'Compliance Period Start' ;
    rdfs:comment 'Start of compliance period. Ref: EPA SDWA.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceViolationCategory rdf:type rdf:Property ;
    rdfs:label 'Compliance Violation Category' ;
    rdfs:comment 'The compliance violation category value recorded for each compliance violation in the compliance domain.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceViolationCode rdf:type rdf:Property ;
    rdfs:label 'Compliance Violation Code' ;
    rdfs:comment 'code for compliance_violation. Ref: EPA SDWA.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceViolationDescription rdf:type rdf:Property ;
    rdfs:label 'Compliance Violation Description' ;
    rdfs:comment 'The compliance violation description value recorded for each compliance violation in the compliance domain.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceViolationName rdf:type rdf:Property ;
    rdfs:label 'Compliance Violation Name' ;
    rdfs:comment 'name for compliance_violation. Ref: EPA SDWA.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceViolationNumber rdf:type rdf:Property ;
    rdfs:label 'Compliance Violation Number' ;
    rdfs:comment 'The compliance violation number value recorded for each compliance violation in the compliance domain.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceViolationStatus rdf:type rdf:Property ;
    rdfs:label 'Compliance Violation Status' ;
    rdfs:comment 'Lifecycle status of the record. Ref: EPA SDWA.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceViolationType rdf:type rdf:Property ;
    rdfs:label 'Compliance Violation Type' ;
    rdfs:comment 'The compliance violation type value recorded for each compliance violation in the compliance domain.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:correctiveActionCompletedDate rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Completed Date' ;
    rdfs:comment 'Date corrective action was completed. Ref: EPA SDWA.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:determinationDate rdf:type rdf:Property ;
    rdfs:label 'Determination Date' ;
    rdfs:comment 'determination date for compliance_violation. Ref: EPA SDWA.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:discoveredDate rdf:type rdf:Property ;
    rdfs:label 'Discovered Date' ;
    rdfs:comment 'The discovered date associated with each compliance violation record in the compliance domain.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:discoveryDate rdf:type rdf:Property ;
    rdfs:label 'Discovery Date' ;
    rdfs:comment 'The discovery date associated with each compliance violation record in the compliance domain.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:enforcementActionFlag rdf:type rdf:Property ;
    rdfs:label 'Enforcement Action Flag' ;
    rdfs:comment 'Indicates whether a formal enforcement action was issued. Ref: EPA SDWA.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:enforcementActionInitiated rdf:type rdf:Property ;
    rdfs:label 'Enforcement Action Initiated' ;
    rdfs:comment 'Whether enforcement action was initiated. Ref: EPA SDWA.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:enforcementActionPending rdf:type rdf:Property ;
    rdfs:label 'Enforcement Action Pending' ;
    rdfs:comment 'Flag indicating whether formal enforcement action is pending. Ref: EPA SDWA.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:healthBasedFlag rdf:type rdf:Property ;
    rdfs:label 'Health Based Flag' ;
    rdfs:comment 'Whether the violation is health-based (acute or chronic health risk). Ref: EPA SDWA.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isHealthBased rdf:type rdf:Property ;
    rdfs:label 'Is Health Based' ;
    rdfs:comment 'Whether the violation is health-based (acute or chronic). Ref: EPA SDWA.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isRepeatViolation rdf:type rdf:Property ;
    rdfs:label 'Is Repeat Violation' ;
    rdfs:comment 'Whether this is a repeat violation within the compliance period. Ref: EPA SDWA.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isResolved rdf:type rdf:Property ;
    rdfs:label 'Is Resolved' ;
    rdfs:comment 'Boolean flag indicating whether the is resolved condition applies to the compliance violation record.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isReturnToCompliance rdf:type rdf:Property ;
    rdfs:label 'Is Return To Compliance' ;
    rdfs:comment 'is return to compliance for compliance_violation. Ref: EPA SDWA.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isSignificantNoncompliance rdf:type rdf:Property ;
    rdfs:label 'Is Significant Noncompliance' ;
    rdfs:comment 'Flag indicating significant non-compliance (SNC) designation. Ref: EPA SDWA.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mclLimit rdf:type rdf:Property ;
    rdfs:label 'Mcl Limit' ;
    rdfs:comment 'Maximum Contaminant Level limit that was exceeded. Ref: EPA SDWA.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:measurementUnit rdf:type rdf:Property ;
    rdfs:label 'Measurement Unit' ;
    rdfs:comment 'Unit of measurement for measured and limit values. Ref: EPA SDWA.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:penaltyAmountUsd rdf:type rdf:Property ;
    rdfs:label 'Penalty Amount Usd' ;
    rdfs:comment 'The penalty amount usd value recorded for each compliance violation in the compliance domain.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:penaltyAssessed rdf:type rdf:Property ;
    rdfs:label 'Penalty Assessed' ;
    rdfs:comment 'penalty assessed for compliance_violation. Ref: EPA SDWA.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:populationAffected rdf:type rdf:Property ;
    rdfs:label 'Population Affected' ;
    rdfs:comment 'Estimated population affected by the violation. Ref: EPA SDWA.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:populationServedAffected rdf:type rdf:Property ;
    rdfs:label 'Population Served Affected' ;
    rdfs:comment 'Estimated population affected by the violation. Ref: EPA SDWA.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:publicNotificationDate rdf:type rdf:Property ;
    rdfs:label 'Public Notification Date' ;
    rdfs:comment 'The public notification date associated with each compliance violation record in the compliance domain.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:regulationCitation rdf:type rdf:Property ;
    rdfs:label 'Regulation Citation' ;
    rdfs:comment 'Cited regulation (NPDWR/SDWA/LCRR reference).' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportedFlag rdf:type rdf:Property ;
    rdfs:label 'Reported Flag' ;
    rdfs:comment 'The reported flag value recorded for each compliance violation in the compliance domain.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:returnToComplianceDate rdf:type rdf:Property ;
    rdfs:label 'Return To Compliance Date' ;
    rdfs:comment 'Date returned to compliance. Ref: EPA SDWA.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:rtcDate rdf:type rdf:Property ;
    rdfs:label 'Rtc Date' ;
    rdfs:comment 'Date system returned to compliance. Ref: EPA SDWA.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:rtcDeadlineDate rdf:type rdf:Property ;
    rdfs:label 'Rtc Deadline Date' ;
    rdfs:comment 'rtc deadline date for compliance_violation. Ref: EPA SDWA.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:ruleCitation rdf:type rdf:Property ;
    rdfs:label 'Rule Citation' ;
    rdfs:comment 'Regulatory rule citation (e.g., 40 CFR 141.63). Ref: EPA SDWA.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ruleCode rdf:type rdf:Property ;
    rdfs:label 'Rule Code' ;
    rdfs:comment 'Regulatory rule code (e.g., SWTR, LCR, TCR, Stage 2 DBPR). Ref: EPA SDWA.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ruleName rdf:type rdf:Property ;
    rdfs:label 'Rule Name' ;
    rdfs:comment 'Full name of the regulatory rule violated. Ref: EPA SDWA.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sdwisViolationCode rdf:type rdf:Property ;
    rdfs:label 'Sdwis Violation Code' ;
    rdfs:comment 'EPA SDWIS violation identifier for federal tracking. Ref: EPA SDWA.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:severityLevel rdf:type rdf:Property ;
    rdfs:label 'Severity Level' ;
    rdfs:comment 'Severity (minor, significant, serious, critical). Ref: EPA SDWA.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:severityScore rdf:type rdf:Property ;
    rdfs:label 'Severity Score' ;
    rdfs:comment 'Numeric severity score assigned to the violation for prioritization. Ref: EPA SDWA.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:violationDate rdf:type rdf:Property ;
    rdfs:label 'Violation Date' ;
    rdfs:comment 'The violation date associated with each compliance violation record in the compliance domain.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:violationNumber rdf:type rdf:Property ;
    rdfs:label 'Violation Number' ;
    rdfs:comment 'Unique violation reference number. Ref: EPA SDWA.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:violationStatus rdf:type rdf:Property ;
    rdfs:label 'Violation Status' ;
    rdfs:comment 'Status (open, under_review, resolved, closed, appealed). Ref: EPA SDWA.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:violationType rdf:type rdf:Property ;
    rdfs:label 'Violation Type' ;
    rdfs:comment 'Type (MCL, monitoring, reporting, treatment_technique, operational). Ref: EPA SDWA.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actionDate rdf:type rdf:Property ;
    rdfs:label 'Action Date' ;
    rdfs:comment 'Action date. Ref: EPA SDWA.' ;
    rdfs:domain ind:EnforcementAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:actionNumber rdf:type rdf:Property ;
    rdfs:label 'Action Number' ;
    rdfs:comment 'Official enforcement action number or case number assigned by the regulatory agency (EPA, state primacy agency, NPDES authority). This is the externally-known identifier used in all regulatory correspondence and legal documents. Ref: EPA SDWA.' ;
    rdfs:domain ind:EnforcementAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actionStatus rdf:type rdf:Property ;
    rdfs:label 'Action Status' ;
    rdfs:comment 'Current lifecycle status of the enforcement action. Tracks progression from issuance through utility response, negotiation, and final resolution. Ref: EPA SDWA.' ;
    rdfs:domain ind:EnforcementAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actionSummary rdf:type rdf:Property ;
    rdfs:label 'Action Summary' ;
    rdfs:comment 'Brief summary of the enforcement action, including the nature of the violation, regulatory basis, and key requirements. Provides context for reporting and management review. Ref: EPA SDWA.' ;
    rdfs:domain ind:EnforcementAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actionType rdf:type rdf:Property ;
    rdfs:label 'Action Type' ;
    rdfs:comment 'Type of formal enforcement action initiated by the regulatory agency. Includes Notice of Violation (NOV), Administrative Order (AO), Consent Order, Compliance Schedule, civil penalty assessment, or criminal referral. Ref: EPA SDWA.' ;
    rdfs:domain ind:EnforcementAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appealFiledFlag rdf:type rdf:Property ;
    rdfs:label 'Appeal Filed Flag' ;
    rdfs:comment 'Indicates whether the utility filed a formal appeal or contested the enforcement action through administrative or judicial proceedings. Ref: EPA SDWA.' ;
    rdfs:domain ind:EnforcementAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appealFilingDate rdf:type rdf:Property ;
    rdfs:label 'Appeal Filing Date' ;
    rdfs:comment 'Date the utility filed its appeal or petition for review. Null if no appeal was filed. Ref: EPA SDWA.' ;
    rdfs:domain ind:EnforcementAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:boardNotificationDate rdf:type rdf:Property ;
    rdfs:label 'Board Notification Date' ;
    rdfs:comment 'Date the utility\'s Board of Directors or governing body was notified of the enforcement action. Tracks governance and executive oversight requirements. Ref: EPA SDWA.' ;
    rdfs:domain ind:EnforcementAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:civilPenaltyAmount rdf:type rdf:Property ;
    rdfs:label 'Civil Penalty Amount' ;
    rdfs:comment 'Monetary penalty amount assessed by the regulatory agency in U.S. dollars. Null if no civil penalty was imposed. Ref: EPA SDWA.' ;
    rdfs:domain ind:EnforcementAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:complianceScheduleFinalDeadline rdf:type rdf:Property ;
    rdfs:label 'Compliance Schedule Final Deadline' ;
    rdfs:comment 'Final deadline by which all corrective actions and compliance milestones must be completed. Null if no compliance schedule is required. Ref: EPA SDWA.' ;
    rdfs:domain ind:EnforcementAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:complianceScheduleRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Compliance Schedule Required Flag' ;
    rdfs:comment 'Indicates whether the enforcement action includes a formal compliance schedule with milestones and deadlines for corrective actions. Ref: EPA SDWA.' ;
    rdfs:domain ind:EnforcementAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:documentReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Document Reference Number' ;
    rdfs:comment 'Internal document management system reference number for the enforcement action file. Links to stored correspondence, legal documents, and supporting materials. Ref: EPA SDWA.' ;
    rdfs:domain ind:EnforcementAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalCounselAssigned rdf:type rdf:Property ;
    rdfs:label 'Legal Counsel Assigned' ;
    rdfs:comment 'Name of the internal or external legal counsel assigned to manage the utility\'s response to the enforcement action. Business-confidential information. Ref: EPA SDWA.' ;
    rdfs:domain ind:EnforcementAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalFirmName rdf:type rdf:Property ;
    rdfs:label 'Legal Firm Name' ;
    rdfs:comment 'Name of the external law firm representing the utility, if external counsel is engaged. Null if handled internally. Ref: EPA SDWA.' ;
    rdfs:domain ind:EnforcementAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:penaltyPaidAmount rdf:type rdf:Property ;
    rdfs:label 'Penalty Paid Amount' ;
    rdfs:comment 'Actual amount paid by the utility toward the civil penalty. May differ from assessed amount due to negotiated settlements or payment plans. Ref: EPA SDWA.' ;
    rdfs:domain ind:EnforcementAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:penaltyPaymentDate rdf:type rdf:Property ;
    rdfs:label 'Penalty Payment Date' ;
    rdfs:comment 'Date the civil penalty payment was made to the regulatory agency. Tracks compliance with payment deadlines. Ref: EPA SDWA.' ;
    rdfs:domain ind:EnforcementAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:publicNoticeRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Public Notice Required Flag' ;
    rdfs:comment 'Indicates whether the enforcement action requires public notification under regulatory or consent order terms. Drives public communication and transparency obligations. Ref: EPA SDWA.' ;
    rdfs:domain ind:EnforcementAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:receivedDate rdf:type rdf:Property ;
    rdfs:label 'Received Date' ;
    rdfs:comment 'Date the utility officially received the enforcement action notice. Used to calculate response deadlines and compliance timelines. Ref: EPA SDWA.' ;
    rdfs:domain ind:EnforcementAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:resolutionOutcome rdf:type rdf:Property ;
    rdfs:label 'Resolution Outcome' ;
    rdfs:comment 'Final outcome of the enforcement action. Indicates how the action was resolved (compliance achieved, consent order executed, penalty paid, dismissed, or under appeal). Ref: EPA SDWA.' ;
    rdfs:domain ind:EnforcementAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responseDueDate rdf:type rdf:Property ;
    rdfs:label 'Response Due Date' ;
    rdfs:comment 'Deadline by which the utility must submit a formal response to the enforcement action. Typically specified in the enforcement notice or calculated based on regulatory timelines. Ref: EPA SDWA.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:responseSubmittedDate rdf:type rdf:Property ;
    rdfs:label 'Response Submitted Date' ;
    rdfs:comment 'Date the utility submitted its formal response to the enforcement action. Tracks compliance with response deadlines. Ref: EPA SDWA.' ;
    rdfs:domain ind:EnforcementAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sepDescription rdf:type rdf:Property ;
    rdfs:label 'Sep Description' ;
    rdfs:comment 'Description of the Supplemental Environmental Project (SEP) agreed to as part of the enforcement settlement. Null if no SEP is included. Ref: EPA SDWA.' ;
    rdfs:domain ind:EnforcementAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sepEstimatedCost rdf:type rdf:Property ;
    rdfs:label 'Sep Estimated Cost' ;
    rdfs:comment 'Estimated cost of the Supplemental Environmental Project (SEP) in U.S. dollars. Used to calculate penalty offsets and track SEP investment. Ref: EPA SDWA.' ;
    rdfs:domain ind:EnforcementAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:supplementalEnvironmentalProjectFlag rdf:type rdf:Property ;
    rdfs:label 'Supplemental Environmental Project Flag' ;
    rdfs:comment 'Indicates whether the enforcement action includes a Supplemental Environmental Project (SEP) as part of the settlement. SEPs are environmentally beneficial projects that go beyond compliance requirements and may offset civil penalties. Ref: EPA SDWA.' ;
    rdfs:domain ind:EnforcementAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryInspectionId rdf:type rdf:Property ;
    rdfs:label 'Regulatory Inspection Id' ;
    rdfs:comment 'Unique identifier for the regulatory inspection record. Primary key. Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:correctiveActionSummary rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Summary' ;
    rdfs:comment 'Summary of the corrective actions required to address deficiencies and achieve compliance. Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deficiencyCount rdf:type rdf:Property ;
    rdfs:label 'Deficiency Count' ;
    rdfs:comment 'Total number of deficiencies or non-compliance items identified during the inspection. Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:findingsSummary rdf:type rdf:Property ;
    rdfs:label 'Findings Summary' ;
    rdfs:comment 'High-level summary of the inspection findings, deficiencies identified, and overall compliance status. Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:followUpInspectionRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Follow Up Inspection Required Flag' ;
    rdfs:comment 'Indicates whether a follow-up inspection by the regulatory agency is required to verify corrective action completion. Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:followUpInspectionScheduledDate rdf:type rdf:Property ;
    rdfs:label 'Follow Up Inspection Scheduled Date' ;
    rdfs:comment 'Scheduled date for the follow-up inspection if required. Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:inspectingAgency rdf:type rdf:Property ;
    rdfs:label 'Inspecting Agency' ;
    rdfs:comment 'Name of the regulatory body or agency that conducted the inspection (EPA, state primacy agency, local health department, etc.). Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectionNumber rdf:type rdf:Property ;
    rdfs:label 'Inspection Number' ;
    rdfs:comment 'Externally-known unique identifier or reference number assigned by the regulatory agency for this inspection. Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectionReportReceivedDate rdf:type rdf:Property ;
    rdfs:label 'Inspection Report Received Date' ;
    rdfs:comment 'Date on which the utility received the official inspection report from the regulatory agency. Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:inspectionReportStatus rdf:type rdf:Property ;
    rdfs:label 'Inspection Report Status' ;
    rdfs:comment 'Current status of the official inspection report (draft, final, under review, accepted, disputed). Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectionResult rdf:type rdf:Property ;
    rdfs:label 'Inspection Result' ;
    rdfs:comment 'Result. Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectionScope rdf:type rdf:Property ;
    rdfs:label 'Inspection Scope' ;
    rdfs:comment 'Description of the areas, processes, or systems covered during the inspection (e.g., treatment processes, discharge monitoring, pretreatment program, laboratory practices). Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectorContactEmail rdf:type rdf:Property ;
    rdfs:label 'Inspector Contact Email' ;
    rdfs:comment 'Email address of the lead inspector for official correspondence. Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectorContactPhone rdf:type rdf:Property ;
    rdfs:label 'Inspector Contact Phone' ;
    rdfs:comment 'Phone number of the lead inspector for follow-up communication. Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectorTitle rdf:type rdf:Property ;
    rdfs:label 'Inspector Title' ;
    rdfs:comment 'Job title or role of the lead inspector (e.g., Environmental Compliance Officer, Sanitary Survey Specialist). Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:significantDeficiencyClassification rdf:type rdf:Property ;
    rdfs:label 'Significant Deficiency Classification' ;
    rdfs:comment 'Classification or category of the significant deficiency if identified (e.g., treatment process failure, monitoring inadequacy, operational deficiency). Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:significantDeficiencyFlag rdf:type rdf:Property ;
    rdfs:label 'Significant Deficiency Flag' ;
    rdfs:comment 'Indicates whether any significant deficiencies (as defined by SDWA) were identified that could affect water quality or public health. Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:utilityRepresentativeTitle rdf:type rdf:Property ;
    rdfs:label 'Utility Representative Title' ;
    rdfs:comment 'Job title of the utility representative who coordinated the inspection (e.g., Compliance Manager, Plant Superintendent). Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:violationIdentifiedFlag rdf:type rdf:Property ;
    rdfs:label 'Violation Identified Flag' ;
    rdfs:comment 'Indicates whether any regulatory violations (SDWA, CWA, NPDES permit) were formally identified during the inspection. Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:parentRegulatoryAgencyId rdf:type rdf:Property ;
    rdfs:label 'Parent Regulatory Agency Id' ;
    rdfs:comment 'Self-referencing FK on regulatory_agency (parent_regulatory_agency_id). Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RegulatoryAgency .

ind:parentRegulatoryAgencyRegulatoryAgencyId rdf:type rdf:Property ;
    rdfs:label 'Parent Regulatory Agency Regulatory Agency Id' ;
    rdfs:comment 'Reference to the parent or umbrella agency if this agency is a regional office, division, or sub-agency (e.g., EPA Region 5 parent is EPA). Null if this is a top-level agency. Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RegulatoryAgency .

ind:agencyCode rdf:type rdf:Property ;
    rdfs:label 'Agency Code' ;
    rdfs:comment 'Short alphanumeric code uniquely identifying the regulatory agency within the utility\'s systems (e.g., EPA_R5, STATE_DNR, PUC_WI). Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agencyLevel rdf:type rdf:Property ;
    rdfs:label 'Agency Level' ;
    rdfs:comment 'The agency level value recorded for each regulatory agency in the compliance domain.' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agencyMainEmail rdf:type rdf:Property ;
    rdfs:label 'Agency Main Email' ;
    rdfs:comment 'General inquiry or main email address for the regulatory agency. Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agencyMainPhone rdf:type rdf:Property ;
    rdfs:label 'Agency Main Phone' ;
    rdfs:comment 'Main switchboard or general inquiry phone number for the regulatory agency. Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agencyName rdf:type rdf:Property ;
    rdfs:label 'Agency Name' ;
    rdfs:comment 'Full legal name of the regulatory agency or governing body (e.g., U.S. Environmental Protection Agency Region 5, Wisconsin Department of Natural Resources). Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agencyShortName rdf:type rdf:Property ;
    rdfs:label 'Agency Short Name' ;
    rdfs:comment 'Abbreviated or commonly used name for the agency (e.g., EPA Region 5, WI DNR, OSHA).' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agencyStatus rdf:type rdf:Property ;
    rdfs:label 'Agency Status' ;
    rdfs:comment 'Current operational status of the regulatory agency (active, inactive, merged, dissolved). Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agencyType rdf:type rdf:Property ;
    rdfs:label 'Agency Type' ;
    rdfs:comment 'Classification of the regulatory agency by its primary regulatory focus (environmental, health, safety, rate regulatory, labor, quality standards, other). [ENUM-REF-CANDIDATE: environmental|health|safety|rate_regulatory|labor|quality_standards|other — 7 candidates stripped; promote to reference product]. Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agencyWebsiteUrl rdf:type rdf:Property ;
    rdfs:label 'Agency Website Url' ;
    rdfs:comment 'Official website URL for the regulatory agency. Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:businessHours rdf:type rdf:Property ;
    rdfs:label 'Business Hours' ;
    rdfs:comment 'Standard business hours of operation for the regulatory agency office (e.g., Monday-Friday 8:00 AM - 5:00 PM PST). Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:directiveTranspositionStatus rdf:type rdf:Property ;
    rdfs:label 'Directive Transposition Status' ;
    rdfs:comment 'For EU member state agencies, status of EU directive transposition into national law (transposed, pending, partial). Relevant for DWD 2020/2184 and WFD 2000/60/EC implementation tracking. Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:enforcementAuthorityLevel rdf:type rdf:Property ;
    rdfs:label 'Enforcement Authority Level' ;
    rdfs:comment 'Level of enforcement authority this agency holds over the utility (primary, delegated, advisory, none). Primary indicates direct enforcement power; delegated indicates authority granted by a higher-level agency; advisory indicates no direct enforcement.' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:euAgencyFlag rdf:type rdf:Property ;
    rdfs:label 'Eu Agency Flag' ;
    rdfs:comment 'Whether agency operates under EU framework. Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:euAgencyType rdf:type rdf:Property ;
    rdfs:label 'Eu Agency Type' ;
    rdfs:comment 'For EU/EEA agencies: SUPRANATIONAL (European Commission, ECHA), NATIONAL_COMPETENT_AUTHORITY (ANSES, DWI, UBA), or REGIONAL. Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:euMemberStateCode rdf:type rdf:Property ;
    rdfs:label 'Eu Member State Code' ;
    rdfs:comment 'ISO 3166-1 alpha-2 code for EU/EEA member state where agency operates (e.g. FR for ANSES, DE for UBA, GB for DWI pre-Brexit). NULL for non-EU agencies.' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:euMemberStateFlag rdf:type rdf:Property ;
    rdfs:label 'Eu Member State Flag' ;
    rdfs:comment 'Indicates whether this agency operates within an EU member state, relevant for DWD 2020/2184 national transposition requirements. Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:faxNumber rdf:type rdf:Property ;
    rdfs:label 'Fax Number' ;
    rdfs:comment 'Fax number for document submission to the regulatory agency, if applicable. Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:governingFrameworkReference rdf:type rdf:Property ;
    rdfs:label 'Governing Framework Reference' ;
    rdfs:comment 'Framework the agency administers: US SDWA/NPDWR/LCRR (EPA); EU Drinking Water Directive 2020/2184; REACH PFAS restriction (ECHA); Water Framework Directive 2000/60/EC; Urban Wastewater Treatment Directive 91/271/EEC; FR ANSES national implementation; UK DWI national implementation; DE UBA national implementation' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectionFrequencyMonths rdf:type rdf:Property ;
    rdfs:label 'Inspection Frequency Months' ;
    rdfs:comment 'Typical frequency in months at which this regulatory agency conducts inspections of utility facilities under its jurisdiction. Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:inspectionFrequencyTypical rdf:type rdf:Property ;
    rdfs:label 'Inspection Frequency Typical' ;
    rdfs:comment 'Typical frequency at which this agency conducts inspections or audits of utility facilities (annual, biennial, triennial, as-needed, risk-based). Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:internationalAgencyRole rdf:type rdf:Property ;
    rdfs:label 'International Agency Role' ;
    rdfs:comment 'Role of agency: EPA (US), EU Commission, ECHA, ANSES (FR), DWI (UK), UBA (DE). Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:internationalBodyName rdf:type rdf:Property ;
    rdfs:label 'International Body Name' ;
    rdfs:comment 'Named international/EU regulatory body, e.g. French ANSES; UK DWI; German UBA. Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:internationalBodyType rdf:type rdf:Property ;
    rdfs:label 'International Body Type' ;
    rdfs:comment 'Body type by region: US EPA / EU European Commission / EU ECHA / FR ANSES / UK DWI / DE UBA. Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:internationalCooperationBody rdf:type rdf:Property ;
    rdfs:label 'International Cooperation Body' ;
    rdfs:comment 'International body this agency cooperates with (e.g. WHO, OECD, ECHA) for cross-border regulatory alignment. Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:internationalFramework rdf:type rdf:Property ;
    rdfs:label 'International Framework' ;
    rdfs:comment 'Primary international regulatory framework administered: SDWA/NPDWR (US), DWD 2020/2184 (EU), WFD 2000/60/EC (EU), UWWTD 91/271/EEC (EU), REACH (EU), or national equivalent' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isoCountryCode rdf:type rdf:Property ;
    rdfs:label 'Iso Country Code' ;
    rdfs:comment 'ISO 3166-1 alpha-2 country code for the agency jurisdiction (US, FR, GB, DE, etc.). Enables international regulatory body identification for ANSES (FR), DWI (GB), UBA (DE).' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jurisdictionGeographicArea rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction Geographic Area' ;
    rdfs:comment 'Geographic area or service territory over which the agency has regulatory authority (e.g., EPA Region 5 covers IL, IN, MI, MN, OH, WI; or specific county/municipality names). Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jurisdictionLevel rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction Level' ;
    rdfs:comment 'The governmental level at which the agency operates (federal, state, regional, local, international). Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mainEmail rdf:type rdf:Property ;
    rdfs:label 'Main Email' ;
    rdfs:comment 'The main email value recorded for each regulatory agency in the compliance domain.' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mainPhone rdf:type rdf:Property ;
    rdfs:label 'Main Phone' ;
    rdfs:comment 'The main phone value recorded for each regulatory agency in the compliance domain.' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mutualRecognitionAgreements rdf:type rdf:Property ;
    rdfs:label 'Mutual Recognition Agreements' ;
    rdfs:comment 'Comma-separated list of mutual recognition or equivalence agreements with other jurisdictions for lab accreditation, monitoring data, or compliance determinations. Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notificationDeadlineHours rdf:type rdf:Property ;
    rdfs:label 'Notification Deadline Hours' ;
    rdfs:comment 'Standard number of hours within which the utility must notify this agency of reportable incidents or violations (e.g., 24 hours for SSO events). Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:npdesAuthorityFlag rdf:type rdf:Property ;
    rdfs:label 'Npdes Authority Flag' ;
    rdfs:comment 'Indicates whether this agency has authority to issue and enforce NPDES permits under the Clean Water Act. True if authorized, False otherwise. Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pretreatmentAuthorityFlag rdf:type rdf:Property ;
    rdfs:label 'Pretreatment Authority Flag' ;
    rdfs:comment 'Indicates whether this agency has authority to oversee industrial pretreatment programs. True if authorized, False otherwise. Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:primacyAgencyFlag rdf:type rdf:Property ;
    rdfs:label 'Primacy Agency Flag' ;
    rdfs:comment 'Indicates whether this agency has primacy authority for Safe Drinking Water Act (SDWA) enforcement in its jurisdiction. True if primacy agency, False otherwise. Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:primacyStatus rdf:type rdf:Property ;
    rdfs:label 'Primacy Status' ;
    rdfs:comment 'Indicates whether this agency is a primacy agency under the Safe Drinking Water Act (SDWA) or Clean Water Act (CWA), meaning it has been delegated primary enforcement authority by EPA (primacy_agency, non_primacy, not_applicable). Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryProgram rdf:type rdf:Property ;
    rdfs:label 'Primary Program' ;
    rdfs:comment 'The primary program value recorded for each regulatory agency in the compliance domain.' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryRegulatoryProgram rdf:type rdf:Property ;
    rdfs:label 'Primary Regulatory Program' ;
    rdfs:comment 'The main regulatory program or statute administered by this agency relevant to water utilities (e.g., SDWA, CWA, NPDES, OSHA, Rate Regulation).' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryFrameworkAdministered rdf:type rdf:Property ;
    rdfs:label 'Regulatory Framework Administered' ;
    rdfs:comment 'Framework administered by this agency across US/EU jurisdictions. Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportingFrequencyDefault rdf:type rdf:Property ;
    rdfs:label 'Reporting Frequency Default' ;
    rdfs:comment 'Default or most common reporting frequency required by this agency for compliance reports (monthly, quarterly, semi-annual, annual, event-driven, as-required). Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportingSystemName rdf:type rdf:Property ;
    rdfs:label 'Reporting System Name' ;
    rdfs:comment 'Name of the electronic reporting system used by the agency (e.g., NetDMR, SDWIS, state-specific portal). Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:state rdf:type rdf:Property ;
    rdfs:label 'State' ;
    rdfs:comment 'Two-letter state or province code where the regulatory agency office is located. Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submissionCredentialsReference rdf:type rdf:Property ;
    rdfs:label 'Submission Credentials Reference' ;
    rdfs:comment 'Reference identifier or location for stored login credentials or API keys used to access the agency\'s submission portal. Should reference a secure credential vault, not store actual credentials. Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submissionPortalName rdf:type rdf:Property ;
    rdfs:label 'Submission Portal Name' ;
    rdfs:comment 'Name of the online submission portal or system (e.g., NetDMR, State Environmental Portal, OSHA Injury Tracking Application).' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submissionPortalUrl rdf:type rdf:Property ;
    rdfs:label 'Submission Portal Url' ;
    rdfs:comment 'URL for the online portal or system used to submit compliance reports, permits, or other regulatory documents to this agency (e.g., NetDMR, state e-reporting system). Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supranationalBodyFlag rdf:type rdf:Property ;
    rdfs:label 'Supranational Body Flag' ;
    rdfs:comment 'Indicates whether this agency is a supranational body (e.g. European Commission, ECHA) as opposed to a national or sub-national regulator. Ref: EPA SDWA.' ;
    rdfs:domain ind:RegulatoryAgency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ccrContaminantDisclosureId rdf:type rdf:Property ;
    rdfs:label 'Ccr Contaminant Disclosure Id' ;
    rdfs:comment 'Primary key for the ccr_contaminant_disclosure association' ;
    rdfs:domain ind:CcrContaminantDisclosure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:detectedContaminantCount rdf:type rdf:Property ;
    rdfs:label 'Detected Contaminant Count' ;
    rdfs:comment 'Total number of regulated contaminants detected in the water system during the report year. Includes contaminants above and below Maximum Contaminant Levels (MCL). Ref: EPA SDWA. [Moved from ccr_period: This is a derived summary count of how many contaminants were detected in the period. It is derivable by COUNT(*) over ccr_contaminant_disclosure records for the period and should not be stored redundantly on ccr_period. If retained on ccr_period it must be treated as a denormalized cache, not a source of truth.]' ;
    rdfs:domain ind:CcrContaminantDisclosure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:healthEffectsLanguage rdf:type rdf:Property ;
    rdfs:label 'Health Effects Language' ;
    rdfs:comment 'The mandatory EPA health effects language included in the CCR for this contaminant in this period. Text may vary by reporting year as EPA updates required language; captured here rather than on the contaminant master to preserve the exact language used in each published report.' ;
    rdfs:domain ind:CcrContaminantDisclosure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mclValueAtReporting rdf:type rdf:Property ;
    rdfs:label 'Mcl Value At Reporting' ;
    rdfs:comment 'The Maximum Contaminant Level (MCL) in effect at the time this CCR period was published. Captured here because MCLs can change between reporting years, and the contaminant master reflects only the current MCL.' ;
    rdfs:domain ind:CcrContaminantDisclosure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reportingUnitOfMeasure rdf:type rdf:Property ;
    rdfs:label 'Reporting Unit Of Measure' ;
    rdfs:comment 'The unit of measure used to express the detected value in the published CCR (e.g., mg/L, ng/L, pCi/L). May vary by contaminant and reporting year.' ;
    rdfs:domain ind:CcrContaminantDisclosure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .
