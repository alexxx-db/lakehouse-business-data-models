    rdfs:comment 'Target timestamp for acknowledgment of the service request.' ;
    rdfs:domain ind:Entitlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:businessHoursCoverage rdf:type rdf:Property ;
    rdfs:label 'Business Hours Coverage' ;
    rdfs:comment 'True if SLA applies only during standard business hours; false if 24/7.' ;
    rdfs:domain ind:Entitlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:coverageLevel rdf:type rdf:Property ;
    rdfs:label 'Coverage Level' ;
    rdfs:comment 'Level of service coverage associated with the entitlement.' ;
    rdfs:domain ind:Entitlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:entitlementType rdf:type rdf:Property ;
    rdfs:label 'Entitlement Type' ;
    rdfs:comment 'Category of entitlement such as warranty, contract, complimentary, or service plan.' ;
    rdfs:domain ind:Entitlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:firstResponseActualTimestamp rdf:type rdf:Property ;
    rdfs:label 'First Response Actual Timestamp' ;
    rdfs:comment 'Actual timestamp when the first response was delivered.' ;
    rdfs:domain ind:Entitlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:firstResponseBreachFlag rdf:type rdf:Property ;
    rdfs:label 'First Response Breach Flag' ;
    rdfs:comment 'True if the first response missed the SLA target.' ;
    rdfs:domain ind:Entitlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:firstResponseBreachReason rdf:type rdf:Property ;
    rdfs:label 'First Response Breach Reason' ;
    rdfs:comment 'Reason why the first response SLA was breached, if applicable.' ;
    rdfs:domain ind:Entitlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:firstResponseElapsedMinutes rdf:type rdf:Property ;
    rdfs:label 'First Response Elapsed Minutes' ;
    rdfs:comment 'Actual minutes elapsed between request creation and first response.' ;
    rdfs:domain ind:Entitlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:firstResponseTargetTimestamp rdf:type rdf:Property ;
    rdfs:label 'First Response Target Timestamp' ;
    rdfs:comment 'Target timestamp by which the first response must be provided.' ;
    rdfs:domain ind:Entitlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:resolutionActualTimestamp rdf:type rdf:Property ;
    rdfs:label 'Resolution Actual Timestamp' ;
    rdfs:comment 'Actual timestamp when the service request was resolved.' ;
    rdfs:domain ind:Entitlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:resolutionBreachFlag rdf:type rdf:Property ;
    rdfs:label 'Resolution Breach Flag' ;
    rdfs:comment 'True if the resolution missed the SLA target.' ;
    rdfs:domain ind:Entitlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:resolutionBreachReason rdf:type rdf:Property ;
    rdfs:label 'Resolution Breach Reason' ;
    rdfs:comment 'Reason why the resolution SLA was breached, if applicable.' ;
    rdfs:domain ind:Entitlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resolutionElapsedMinutes rdf:type rdf:Property ;
    rdfs:label 'Resolution Elapsed Minutes' ;
    rdfs:comment 'Minutes elapsed between request creation and resolution.' ;
    rdfs:domain ind:Entitlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:resolutionTargetTimestamp rdf:type rdf:Property ;
    rdfs:label 'Resolution Target Timestamp' ;
    rdfs:comment 'Target timestamp by which the service request must be resolved.' ;
    rdfs:domain ind:Entitlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:serviceChannel rdf:type rdf:Property ;
    rdfs:label 'Service Channel' ;
    rdfs:comment 'Delivery channel for the service (e.g., phone, email, on-site, remote).' ;
    rdfs:domain ind:Entitlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceEntitlementDescription rdf:type rdf:Property ;
    rdfs:label 'Service Entitlement Description' ;
    rdfs:comment 'Free-form description of the entitlement, including any special conditions.' ;
    rdfs:domain ind:Entitlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceEntitlementStatus rdf:type rdf:Property ;
    rdfs:label 'Service Entitlement Status' ;
    rdfs:comment 'Current lifecycle status of the entitlement.' ;
    rdfs:domain ind:Entitlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:slaResolutionTimeTarget rdf:type rdf:Property ;
    rdfs:label 'Sla Resolution Time Target' ;
    rdfs:comment 'Target time in minutes to fully resolve a service request.' ;
    rdfs:domain ind:Entitlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:slaResponseTimeTarget rdf:type rdf:Property ;
    rdfs:label 'Sla Response Time Target' ;
    rdfs:comment 'Target time in minutes for initial response to a service request.' ;
    rdfs:domain ind:Entitlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:engineerId rdf:type rdf:Property ;
    rdfs:label 'Engineer Id' ;
    rdfs:comment 'Primary key for engineer' ;
    rdfs:domain ind:Engineer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:activeAssignmentCount rdf:type rdf:Property ;
    rdfs:label 'Active Assignment Count' ;
    rdfs:comment 'Number of service assignments currently active for the engineer.' ;
    rdfs:domain ind:Engineer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:certificationDriveExpiry rdf:type rdf:Property ;
    rdfs:label 'Certification Drive Expiry' ;
    rdfs:comment 'Expiration date of the drive-systems certification.' ;
