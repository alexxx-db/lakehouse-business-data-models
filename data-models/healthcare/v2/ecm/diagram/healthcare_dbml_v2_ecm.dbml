Table consent.form_template {
  form_template_id varchar [pk, note: 'Unique identifier for the consent form template record. Primary key.']
  care_site_id varchar
  compliance_policy_id varchar [note: 'Foreign key linking to compliance.policy. Business justification: Templates are governed by compliance policies defining required elements, approval workflows, and regulatory requirements. Essential for policy enforcement, version control, and demonstrating that con']
  exchange_standard_id varchar [note: 'Foreign key linking to interoperability.exchange_standard. Business justification: Consent form templates must conform to specific exchange standards (C-CDA Consent Directive template 2.16.840.1.113883.10.20.22.2.64, FHIR Consent resource profiles). Required for interoperability des']
  mpi_record_id varchar
  primary_superseded_by_form_template_id varchar [note: 'Reference to the consent_form_template_id of the newer version that supersedes this template. Null if this is the current active version.']
  applicable_facility_types varchar [note: 'Comma-separated list or description of facility types where this consent form template is applicable (e.g., inpatient hospital, outpatient clinic, emergency department, ambulatory surgery center, telehealth platform).']
  applicable_service_lines varchar [note: 'Comma-separated list or description of clinical service lines or departments where this consent form template is used (e.g., cardiology, oncology, behavioral health, radiology, laboratory).']
  approval_authority varchar [note: 'Name or title of the individual, committee, or department that approved this consent form template for use (e.g., Chief Compliance Officer, Legal Department, Privacy Officer, IRB Chair).']
  approval_date date [note: 'Date when the consent form template was officially approved by the designated authority for deployment and use.']
  consent_category varchar [note: 'Primary category of consent this form template addresses: treatment (general medical treatment), surgical (procedure-specific), research (clinical trials and studies), hipaa_authorization (PHI disclosure), hie_opt_in_out (Health Information Exchange participation), telehealth (virtual care consent), data_sharing (third-party data use). [ENUM-REF-CANDIDATE: treatment|surgical|research|hipaa_authorization|hie_opt_in_out|telehealth|data_sharing — 7 candidates stripped; promote to reference product]']
  consent_status varchar
  consent_subcategory varchar [note: 'Optional subcategory or specialization within the primary consent category (e.g., anesthesia, blood transfusion, genetic testing, marketing communications).']
  created_by_user varchar [note: 'Username or identifier of the system user who created this consent form template record.']
  created_timestamp timestamp [note: 'Timestamp when this consent form template record was first created in the system.']
  effective_date date [note: 'Date when this consent form template version becomes valid and available for use in patient consent workflows.']
  electronic_signature_enabled_flag boolean [note: 'Indicates whether this consent form template supports electronic signature capture in compliance with ESIGN Act and state electronic signature laws. True if electronic signature is enabled, False if wet signature is required.']
  expiration_date date [note: 'Date when this consent form template version is no longer valid for new consent collection. Nullable for forms without predetermined expiration.']
  form_checksum varchar [note: 'Cryptographic hash (e.g., SHA-256) of the form document file to ensure integrity and detect unauthorized modifications. Used for audit and compliance verification.']
  form_code varchar [note: 'Unique business identifier code for the consent form template used for reference across systems (e.g., HIPAA_AUTH_2024, SURG_CONSENT_V3).']
  form_document_url varchar [note: 'URL or file path to the digital master copy of the consent form template document (PDF, Word, or other format) stored in the document management system.']
  form_name varchar [note: 'Full descriptive name of the consent form template (e.g., General Surgical Consent Form, HIPAA Authorization for Release of Information).']
  form_purpose varchar [note: 'Detailed description of the business and clinical purpose of this consent form template, including what actions or disclosures it authorizes and what patient rights it addresses.']
  form_status varchar [note: 'Current lifecycle status of the consent form template: draft (under development), pending_approval (awaiting review), active (approved for use), superseded (replaced by newer version), retired (no longer in use), withdrawn (removed from circulation).']
  interpreter_required_flag boolean [note: 'Indicates whether an interpreter signature or attestation is required when the form is presented in a language different from the patients primary language. True if interpreter attestation is required, False otherwise.']
  irb_approval_date date [note: 'Date when the IRB approved this research consent form template. Applicable only to research consent forms.']
  irb_approval_number varchar [note: 'IRB protocol or approval reference number for research consent forms. Required for research studies involving human subjects under 45 CFR Part 46. Null for non-research consent forms.']
  irb_expiration_date date [note: 'Date when the IRB approval for this research consent form expires and requires renewal. Applicable only to research consent forms.']
  language_code varchar [note: 'ISO 639-1 two-letter language code (with optional ISO 3166-1 country code) indicating the language of the consent form template (e.g., en, es, zh-CN, fr-CA).']
  last_modified_timestamp timestamp
  legal_representative_allowed_flag boolean [note: 'Indicates whether a legal representative (guardian, power of attorney, parent) may sign this consent form on behalf of the patient. True if representative signature is permitted, False if patient signature is strictly required.']
  minimum_age_requirement varchar [note: 'Minimum age (in years) at which a patient may provide consent under this form template without parental or guardian involvement. Null if no age restriction applies or if form is not age-dependent.']
  minor_assent_required_flag boolean [note: 'Indicates whether assent from a minor patient (in addition to parental consent) is required for this consent form. Applicable primarily to research and certain treatment contexts. True if minor assent is required, False otherwise.']
  modified_by_user varchar [note: 'Username or identifier of the system user who last modified this consent form template record.']
  modified_timestamp timestamp [note: 'Timestamp when this consent form template record was last modified.']
  reading_level varchar [note: 'Assessed reading comprehension level required to understand the consent form content, typically expressed as grade level (e.g., 6th grade, 8th grade) or readability score (Flesch-Kincaid). Important for health literacy compliance.']
  record_number varchar
  regulatory_basis varchar [note: 'Primary legal or regulatory framework that mandates or governs this consent form (e.g., HIPAA Privacy Rule 45 CFR 164.508, 45 CFR Part 46 Common Rule, California CMIA, State-specific informed consent statute).']
  retention_period_years varchar [note: 'Number of years that signed instances of this consent form must be retained per regulatory and legal requirements (e.g., 6 years per HIPAA, 7 years per state law, indefinitely for certain research consents).']
  revocation_allowed_flag boolean [note: 'Indicates whether the patient has the right to revoke consent given under this form template. True if revocation is permitted, False if consent is irrevocable (rare, typically only in certain research contexts).']
  revocation_instructions varchar [note: 'Instructions provided to patients on how to revoke consent if revocation is allowed (e.g., written notice to Privacy Officer, submission of revocation form).']
  scope_of_consent varchar [note: 'Textual description of what the patient is consenting to, including specific procedures, data uses, disclosures, or participation activities covered by this form.']
  template_name varchar
  template_status varchar
  template_type varchar
  version_number varchar [note: 'Version identifier for the consent form template following semantic versioning (e.g., 1.0, 2.1, 3.0.1). Incremented when form content or structure changes.']
  vibe_mutation_added varchar [note: 'Added by VIBE mutation to satisfy target entity touch requirement']
  vibe_mutation_marker varchar [note: 'Generic mutation marker']
  vibe_structure_marker varchar [note: 'structure enforcement marker']
  witness_required_flag boolean [note: 'Indicates whether a witness signature is required on this consent form in addition to the patient signature. True if witness is required, False otherwise.']

  Note: 'Master catalog of all approved consent form templates used across clinical, research, and administrative contexts. Captures form name, form code, consent category (treatment, surgical, research, HIPAA, HIE, telehealth, data sharing), version number, effective date, expiration date, regulatory basis (HIPAA, 45 CFR 46, state law), language, reading level, approval authority, and IRB approval reference where applicable. Serves as the authoritative reference for which form version was presented to a patient at time of consent.'
}

Table consent.hipaa_authorization {
  hipaa_authorization_id varchar [pk, note: 'Unique identifier for the HIPAA authorization record. Primary key for the authorization entity.']
  care_site_id varchar [note: 'Reference to the healthcare facility where the authorization was obtained.']
  compliance_policy_id varchar [note: 'Foreign key linking to compliance.policy. Business justification: HIPAA authorizations must comply with organizational policies implementing HIPAA Privacy Rule requirements. Links authorization instances to governing policy for audit trails, policy version tracking,']
  demographics_id varchar [note: 'Reference to the patient who is granting the HIPAA authorization for use or disclosure of their Protected Health Information (PHI).']
  employee_id varchar [note: 'Reference to the staff member who obtained and witnessed the patient signature on the authorization.']
  form_template_id varchar
  mpi_record_id varchar
  research_study_id varchar [note: 'Identifier of the research study for which this authorization permits PHI disclosure, if the authorization purpose is research.']
  superseded_hipaa_authorization_id varchar [note: 'Self-referencing FK on hipaa_authorization (superseded_hipaa_authorization_id)']
  visit_id varchar [note: 'Reference to the clinical encounter during which the authorization was obtained, if applicable. Used for linking authorization to the clinical context.']
  authorization_purpose varchar [note: 'The specific purpose for which the patient is authorizing the use or disclosure of PHI beyond treatment, payment, and operations (TPO). Must be one of the purposes requiring explicit HIPAA authorization under 45 CFR 164.508.']
  authorization_purpose_description varchar [note: 'Detailed free-text description of the specific purpose for the authorization, providing additional context beyond the categorical purpose code.']
  authorization_status varchar
  behavioral_health_protected_flag boolean
  compensation_disclosure_flag boolean [note: 'Indicates whether the authorization includes disclosure that the covered entity will receive direct or indirect remuneration from a third party in exchange for using or disclosing PHI. Required for authorizations involving sale of PHI.']
  consent_status varchar
  created_timestamp timestamp [note: 'Timestamp when the authorization record was first created in the system. Used for audit trail and compliance tracking.']
  disclosing_party_name varchar [note: 'Name of the covered entity or individual authorized to make the disclosure of PHI (typically the healthcare organization or provider).']
  disclosing_party_npi varchar [note: 'National Provider Identifier of the disclosing party, if applicable. Used for provider identification and compliance tracking.']
  document_reference varchar [note: 'Reference identifier or URI to the scanned or electronically stored copy of the signed authorization form in the document management system.']
  effective_date date
  expiration_date date
  expiration_event varchar [note: 'Description of the event that will cause the authorization to expire (e.g., end of research study, completion of legal proceeding). Used when expiration is event-based rather than date-based.']
  form_version varchar [note: 'Version identifier of the HIPAA authorization form template used. Used for tracking form updates and ensuring compliance with current regulatory requirements.']
  irb_approval_number varchar [note: 'IRB approval number for the research study, if applicable. Required for research authorizations to demonstrate ethical oversight.']
  language_code varchar [note: 'Two-letter ISO 639-1 language code indicating the language in which the authorization form was presented to and signed by the patient.']
  last_modified_timestamp timestamp
  last_updated_by varchar [note: 'User identifier or name of the system user who last modified the authorization record. Used for audit trail and accountability.']
  last_updated_timestamp timestamp [note: 'Timestamp when the authorization record was last modified. Used for audit trail and version control.']
  mrn varchar [note: 'The patient\'s medical record number associated with this authorization. Used for cross-referencing and audit purposes.']
  notes varchar [note: 'Free-text notes or comments regarding the authorization, including any special circumstances, clarifications, or administrative details.']
  personal_representative_flag boolean [note: 'Indicates whether the authorization was signed by a personal representative on behalf of the patient (e.g., parent, guardian, power of attorney).']
  personal_representative_name varchar [note: 'Name of the personal representative who signed the authorization on behalf of the patient, if applicable.']
  personal_representative_relationship varchar [note: 'Relationship of the personal representative to the patient (e.g., parent, legal guardian, power of attorney).']
  phi_category varchar [note: 'High-level categorization of the type of PHI covered by this authorization. Used for reporting and compliance tracking. [ENUM-REF-CANDIDATE: complete_medical_record|specific_encounter|lab_results|radiology_images|psychotherapy_notes|substance_abuse_records|hiv_aids_records|mental_health_records|genetic_information|other — 10 candidates stripped; promote to reference product]']
  phi_description varchar [note: 'Detailed description of the specific PHI elements or categories authorized for disclosure (e.g., medical records from specific dates, lab results, psychotherapy notes, HIV status, substance abuse treatment records).']
  recipient_address varchar [note: 'Mailing address of the recipient authorized to receive the PHI disclosure.']
  recipient_name varchar [note: 'Name of the person or entity authorized to receive the disclosed PHI (e.g., research institution, attorney, insurance company, marketing firm).']
  recipient_organization varchar [note: 'Organization name of the recipient entity, if the recipient is an organization rather than an individual.']
  record_number varchar [note: 'Foreign key linking to consent.record. Business justification: HIPAA authorizations are a type of consent record. Linking to the core record table enables unified consent management and reporting across all consent types. Core consent lifecycle attributes (status']
  redisclosure_statement varchar [note: 'Statement informing the patient that information disclosed pursuant to the authorization may be subject to redisclosure by the recipient and may no longer be protected by HIPAA.']
  right_to_revoke_statement varchar [note: 'Statement informing the patient of their right to revoke the authorization and any exceptions to that right (e.g., if action has already been taken in reliance on the authorization).']
  signature_date date [note: 'Date on which the patient signed the HIPAA authorization form.']
  signature_method varchar [note: 'Method by which the patient signature was captured (e.g., wet signature on paper, electronic signature pad, digital signature via patient portal).']
  signature_obtained_flag boolean [note: 'Indicates whether the required patient signature has been obtained on the authorization form. HIPAA requires a valid signature for the authorization to be effective.']
  signed_date date
  vibe_mutation_added varchar [note: 'Added by VIBE mutation to satisfy target entity touch requirement']
  vibe_mutation_marker varchar [note: 'Generic mutation marker']
  vibe_structure_marker varchar [note: 'structure enforcement marker']
  witness_name varchar [note: 'Name of the witness who observed the patient signing the authorization, if applicable. Some organizations require witness signatures for certain types of authorizations.']
  witness_signature_date date [note: 'Date on which the witness signed the authorization form, if applicable.']
  created_by varchar [note: 'User identifier or name of the system user who created the authorization record. Used for audit trail and accountability.']

  Note: 'Master record for HIPAA-specific authorizations permitting use or disclosure of PHI for purposes beyond treatment, payment, and operations (TPO). Captures authorization purpose (marketing, research, psychotherapy notes, sale of PHI), specific PHI elements authorized for disclosure, recipient of disclosure, expiration date or expiration event, right to revoke statement, and patient signature. Distinct from general treatment consent — governed specifically by 45 CFR 164.508 and requires stricter documentation standards.'
}

Table consent.hie_directive {
  hie_directive_id varchar [pk, note: 'Unique identifier for the HIE directive record. Primary key.']
  care_site_id varchar [note: 'Identifier of the healthcare facility where this HIE directive was captured.']
  clinician_id varchar [note: 'Identifier of the healthcare provider or staff member who captured this HIE directive.']
  demographics_id varchar [note: 'Identifier of the patient who issued this HIE directive.']
  hie_participation_id varchar [note: 'Foreign key linking to interoperability.hie_participation. Business justification: HIE directives are scoped to specific organizational HIE participation agreements. Business needs to enforce which HIE network participation governs each patient directive, especially when organizatio']
  mpi_record_id varchar
  superseded_hie_directive_id varchar [note: 'Self-referencing FK on hie_directive (superseded_hie_directive_id)']
  trading_partner_id varchar [note: 'Foreign key linking to interoperability.trading_partner. Business justification: HIE directives specify which trading partners (specific hospitals, health systems, HIEs) can access patient data. Required for operational enforcement of patient restrictions—when patient opts out of ']
  visit_id varchar [note: 'Identifier of the clinical encounter during which this HIE directive was captured, if applicable.']
  audit_log_reference varchar [note: 'Reference identifier linking this directive to detailed audit logs of HIE access events.']
  break_glass_events_count varchar [note: 'Number of times emergency break-glass access has been invoked to override this directive.']
  consent_form_version varchar [note: 'Version identifier of the consent form or template used to capture this directive.']
  consent_method varchar [note: 'Method by which the patient provided this HIE directive: written form, verbal communication, electronic signature, or implied consent.']
  consent_status varchar
  created_timestamp timestamp [note: 'Timestamp when this HIE directive record was first created in the system.']
  data_type_restrictions varchar [note: 'Comma-separated list of specific data types or categories the patient has restricted from sharing (e.g., mental health, substance abuse, HIV status, genetic information).']
  directive_status varchar
  directive_type varchar [note: 'Type of HIE directive: opt-in (patient consents to share), opt-out (patient declines to share), opt-out with exceptions (patient declines except for specified cases), or conditional (patient sets specific conditions).']
  effective_date date
  emergency_access_override boolean [note: 'Indicates whether emergency access provisions allow providers to override this directive in life-threatening situations.']
  expiration_date date
  federal_override_applicable boolean [note: 'Indicates whether federal regulations (e.g., 42 CFR Part 2 for substance abuse) override state HIE consent laws for this directive.']
  interpreter_used boolean [note: 'Indicates whether a medical interpreter was used to explain the HIE directive to the patient.']
  language_code varchar [note: 'ISO 639-1 two-letter language code indicating the language in which the directive was presented to and understood by the patient.']
  last_break_glass_date timestamp [note: 'Timestamp of the most recent emergency break-glass access event.']
  last_modified_timestamp timestamp
  last_updated_timestamp timestamp [note: 'Timestamp when this HIE directive record was last modified.']
  last_verified_timestamp timestamp [note: 'Timestamp when the directive was last verified with the patient or confirmed as still valid.']
  legal_representative_name varchar [note: 'Name of the legal representative (guardian, power of attorney) who provided consent on behalf of the patient, if applicable.']
  legal_representative_relationship varchar [note: 'Relationship of the legal representative to the patient (e.g., parent, guardian, healthcare proxy, power of attorney).']
  mrn varchar [note: 'The patient\'s medical record number associated with this directive.']
  next_review_date date [note: 'Scheduled date for the next review or reconfirmation of this HIE directive with the patient.']
  notes varchar [note: 'Additional free-text notes or comments about this HIE directive, including any special circumstances or clarifications.']
  patient_education_provided boolean [note: 'Indicates whether educational materials about HIE participation were provided to the patient.']
  patient_instructions varchar [note: 'Free-text field capturing any additional instructions or conditions specified by the patient regarding HIE participation.']
  provider_restrictions varchar [note: 'Comma-separated list of specific provider organizations or individuals the patient has restricted from accessing their data via HIE.']
  purpose_of_use_restrictions varchar [note: 'Comma-separated list of purposes for which data sharing is restricted or permitted (e.g., treatment, payment, operations, research, public health).']
  record_number varchar [note: 'Foreign key linking to consent.record. Business justification: HIE directives are a type of consent record governing health information exchange. Linking to the core record table enables unified consent management and reporting. Core consent lifecycle attributes ']
  scope_of_sharing varchar [note: 'Defines the breadth of data sharing permitted: all records, specific data types only, specific providers only, emergency situations only, or treatment purposes only.']
  source_system_code varchar [note: 'Unique identifier of this directive in the source system.']
  state_jurisdiction varchar [note: 'Two-letter state code indicating the jurisdiction whose HIE consent laws govern this directive.']
  vibe_mutation_added varchar [note: 'Added by VIBE mutation to satisfy target entity touch requirement']
  vibe_mutation_marker varchar [note: 'Generic mutation marker']
  vibe_structure_marker varchar [note: 'structure enforcement marker']
  witness_name varchar [note: 'Name of the witness who observed the patient signing the HIE directive, if applicable.']
  witness_signature_date date [note: 'Date when the witness signed the HIE directive form.']

  Note: 'Master record for patient Health Information Exchange (HIE) opt-in and opt-out directives governing participation in regional and statewide HIE networks. Captures HIE network name, directive type (opt-in, opt-out, opt-out with exceptions), effective date, expiration date, scope of data sharing (all records, specific data types, specific providers), patient-specified restrictions, and directive status. Supports compliance with state HIE consent laws and CommonWell/Carequality participation rules.'
}

Table consent.treatment_consent {
  treatment_consent_id varchar [pk, note: 'Unique identifier for the treatment consent record. Primary key.']
  care_site_id varchar [note: 'Reference to the healthcare facility where this treatment consent was obtained.']
  compliance_policy_id varchar [note: 'Foreign key linking to compliance.policy. Business justification: Treatment consent forms are governed by policies defining informed consent requirements, documentation standards, and regulatory compliance. Essential for demonstrating that consent practices meet org']
  cpt_code_id varchar [note: 'The CPT or ICD-10-PCS code identifying the specific procedure or treatment being consented to. Applicable for procedure-specific consent types.']
  form_template_id varchar
  mpi_record_id varchar [note: 'Reference to the patient who is the subject of this treatment consent.']
  payer_id varchar [note: 'Foreign key linking to insurance.payer. Business justification: Treatment consents often require payer-specific authorization and documentation. Some procedures require payer pre-authorization before consent can be finalized. Links consent management to insurance ']
  primary_treatment_clinician_id varchar [note: 'Reference to the provider who performed the clinical assessment of the patient\'s decision-making capacity.']
  primary_treatment_employee_id varchar [note: 'Identifier of the system user who created this treatment consent record.']
  superseded_treatment_consent_id varchar [note: 'Self-referencing FK on treatment_consent (superseded_treatment_consent_id)']
  tertiary_treatment_performing_provider_clinician_id varchar [note: 'Reference to the provider who will perform the procedure or treatment for which consent was obtained.']
  visit_id varchar [note: 'Reference to the clinical encounter during which this consent was obtained.']
  alternatives_documented varchar [note: 'Narrative documentation of alternative treatment options that were disclosed to and discussed with the patient or authorized representative.']
  behavioral_health_protected_flag boolean
  benefits_documented varchar [note: 'Narrative documentation of the expected benefits of the procedure or treatment that were disclosed to and discussed with the patient or authorized representative.']
  capacity_determination varchar [note: 'Clinical determination of whether the patient has decision-making capacity to provide informed consent for the treatment or procedure.']
  consent_document_location varchar [note: 'Reference to the location or system where the signed consent document is stored (e.g., EMR document ID, scanned document repository path).']
  consent_form_number varchar [note: 'The externally-known unique identifier or form number for this treatment consent document.']
  consent_method varchar [note: 'The method by which consent was obtained and documented (written signature, verbal consent documented by provider, electronic signature, telephonic consent with witness).']
  consent_status varchar
  consent_version varchar [note: 'Version identifier of the consent form template used, for tracking form revisions and ensuring compliance with current organizational policies.']
  created_datetime timestamp [note: 'The date and time when this treatment consent record was first created in the system.']
  created_timestamp timestamp
  effective_date date
  emergency_exception_flag boolean [note: 'Indicates whether treatment was provided under emergency exception provisions when informed consent could not be obtained due to the patient\'s condition and no authorized representative was available.']
  emergency_exception_justification varchar [note: 'Clinical documentation justifying why treatment was provided without informed consent under emergency exception provisions.']
  expiration_date date
  interpreter_language varchar [note: 'The language in which interpretation services were provided during the consent process.']
  interpreter_name varchar [note: 'Full name of the medical interpreter who facilitated the consent discussion.']
  interpreter_required_flag boolean [note: 'Indicates whether a medical interpreter was required to facilitate the consent discussion due to language barriers or communication needs.']
  last_modified_timestamp timestamp
  last_updated_datetime timestamp [note: 'The date and time when this treatment consent record was last modified in the system.']
  legal_representative_name varchar [note: 'Full name of the legal representative or authorized decision-maker who provided consent on behalf of the patient.']
  legal_representative_phone varchar [note: 'Contact phone number for the legal representative or authorized decision-maker.']
  legal_representative_relationship varchar [note: 'The legal or familial relationship of the representative to the patient (e.g., parent, legal guardian, healthcare proxy, durable power of attorney for healthcare, spouse, next of kin).']
  legal_representative_required_flag boolean [note: 'Indicates whether a legal representative or authorized decision-maker was required to provide consent on behalf of the patient due to lack of capacity.']
  patient_questions_addressed_flag boolean [note: 'Indicates whether the patient or authorized representative had the opportunity to ask questions and all questions were addressed prior to obtaining consent.']
  patient_questions_notes varchar [note: 'Free-text documentation of specific questions asked by the patient or authorized representative and the responses provided.']
  record_number varchar [note: 'Foreign key linking to consent.record. Business justification: Treatment consent is a specialized type of consent record for medical procedures. Linking to the core record table enables unified consent management and reporting. Core consent lifecycle attributes (']
  revoked_by_name varchar [note: 'Name of the individual (patient or authorized representative) who revoked the consent.']
  risks_documented varchar [note: 'Narrative documentation of the material risks of the procedure or treatment that were disclosed to and discussed with the patient or authorized representative.']
  signed_date date
  special_instructions varchar [note: 'Any special instructions, limitations, or conditions specified by the patient or authorized representative as part of the consent (e.g., no blood products, specific anesthesia preferences).']
  vibe_mutation_added varchar [note: 'Added by VIBE mutation to satisfy target entity touch requirement']
  vibe_mutation_marker varchar [note: 'Generic mutation marker']
  vibe_structure_marker varchar [note: 'structure enforcement marker']
  witness_name varchar [note: 'Full name of the witness who observed the consent process and signed the consent form.']
  witness_required_flag boolean [note: 'Indicates whether a witness signature was required on the consent form per organizational policy or regulatory requirement.']
  witness_role varchar [note: 'The role or title of the witness (e.g., registered nurse, social worker, patient advocate).']

  Note: 'Master record for general and procedure-specific treatment consent obtained from patients or their authorized representatives prior to clinical care. Captures consent type (general treatment, surgical, anesthesia, blood transfusion, chemotherapy, ECT, restraint), procedure or treatment being consented to, risks and benefits documented, alternatives discussed, patient questions addressed, capacity determination, and legal representative details when patient lacks decision-making capacity. Distinct from HIPAA authorization — governs clinical care delivery.'
}

Table consent.research_consent {
  research_consent_id varchar [pk, note: 'Unique identifier for the research consent record. Primary key.']
  care_site_id varchar
  clinician_id varchar [note: 'Identifier of the healthcare provider or research coordinator who obtained informed consent from the subject.']
  compliance_policy_id varchar [note: 'Foreign key linking to compliance.policy. Business justification: Research consents must comply with IRB-approved policies and organizational research governance policies. Links consent instances to governing policies for audit trails, regulatory compliance verifica']
  mpi_record_id varchar [note: 'Identifier of the patient or research subject who provided consent.']
  research_study_id varchar [note: 'Identifier of the clinical trial or research study for which consent was obtained.']
  superseded_research_consent_id varchar [note: 'Self-referencing FK on research_consent (superseded_research_consent_id)']
  transmitted_cda_document_id varchar [note: 'Foreign key linking to interoperability.cda_document. Business justification: Research consents are transmitted via CDA when sharing research participant data across institutions in multi-site trials. Required for IRB audits to prove consent was properly communicated to data-re']
  biospecimen_collection_authorized boolean [note: 'Indicates whether the subject authorized collection and storage of biospecimens (blood, tissue, DNA) for research purposes.']
  comprehension_assessment_method varchar [note: 'Method used to assess subject comprehension (e.g., teach-back, quiz, verbal confirmation).']
  comprehension_assessment_result varchar [note: 'Result of the comprehension assessment indicating whether the subject demonstrated adequate understanding of the study.']
  consent_discussion_duration_minutes varchar [note: 'Duration in minutes of the informed consent discussion between the consenting provider and the research subject.']
  consent_document_url varchar [note: 'URL or file path to the signed consent document stored in the document management system.']
  consent_form_version varchar [note: 'Version identifier of the IRB-approved informed consent form used for this consent event.']
  consent_language varchar [note: 'Language in which the informed consent form was presented and discussed with the subject (e.g., English, Spanish, Mandarin).']
  consent_location varchar [note: 'Physical location or facility where the consent process took place (e.g., clinic name, hospital unit, research center).']
  consent_method varchar [note: 'Method by which consent was obtained (e.g., in-person, telehealth, electronic signature, written signature).']
  consent_status varchar
  consenting_provider_npi varchar [note: 'National Provider Identifier of the provider who obtained consent. 10-digit unique identifier.']
  contact_for_future_studies_authorized boolean [note: 'Indicates whether the subject authorized being contacted for participation in future research studies.']
  created_timestamp timestamp [note: 'Timestamp when this research consent record was first created in the system.']
  data_sharing_authorized boolean [note: 'Indicates whether the subject authorized sharing of their de-identified research data with external researchers or repositories.']
  effective_date date
  electronic_signature_code varchar [note: 'Unique identifier of the electronic signature captured during the consent process, if applicable.']
  expiration_date date
  future_research_authorized boolean [note: 'Indicates whether the subject authorized use of their data and biospecimens for future unspecified research studies.']
  genetic_testing_authorized boolean [note: 'Indicates whether the subject authorized genetic testing and analysis of their biospecimens.']
  hipaa_authorization_included boolean [note: 'Indicates whether HIPAA authorization for use and disclosure of protected health information was included in the research consent.']
  interpreter_used boolean [note: 'Indicates whether a medical interpreter was used during the consent process to facilitate communication with the subject.']
  irb_protocol_number varchar [note: 'IRB protocol number under which this consent was obtained. Links consent to the approved research protocol.']
  lar_contact_phone varchar [note: 'Contact phone number of the legally authorized representative.']
  lar_name varchar [note: 'Full name of the legally authorized representative who provided consent on behalf of the subject.']
  lar_relationship varchar [note: 'Relationship of the LAR to the research subject (e.g., parent, guardian, healthcare proxy, power of attorney).']
  lar_used boolean [note: 'Indicates whether a legally authorized representative provided consent on behalf of an incapacitated or minor subject.']
  last_modified_timestamp timestamp
  last_updated_timestamp timestamp [note: 'Timestamp when this research consent record was last modified in the system.']
  minor_assent_date date [note: 'Date on which assent was obtained from the minor subject.']
  minor_assent_obtained boolean [note: 'Indicates whether assent was obtained from a minor subject in addition to parental consent, as required by IRB protocol.']
  mrn varchar [note: 'Medical record number of the research subject. Unique patient identifier within the healthcare system.']
  reconsent_date date [note: 'Date on which reconsent was obtained following a protocol amendment or other triggering event.']
  reconsent_reason varchar [note: 'Reason for requiring reconsent (e.g., protocol amendment, new safety information, change in study procedures).']
  reconsent_required boolean [note: 'Indicates whether reconsent is required due to protocol amendment, new risks identified, or other changes to the study.']
  record_number varchar [note: 'Foreign key linking to consent.record. Business justification: Research consent is a specialized type of consent record for clinical research. Linking to the core record table enables unified consent management and reporting. Core consent lifecycle attributes (st']
  return_of_results_requested boolean [note: 'Indicates whether the subject requested to receive individual research results or incidental findings from the study.']
  signed_date date
  study_arm varchar [note: 'The specific arm or cohort of the study to which the subject was assigned (e.g., treatment, control, placebo).']
  subject_comprehension_assessed boolean [note: 'Indicates whether the research subjects comprehension of the study risks, benefits, and procedures was formally assessed during the consent process.']
  vibe_mutation_added varchar [note: 'Added by VIBE mutation to satisfy target entity touch requirement']
  vibe_mutation_marker varchar [note: 'Generic mutation marker']
  vibe_structure_marker varchar [note: 'structure enforcement marker']
  witness_name varchar [note: 'Full name of the witness who observed the consent process and signed the consent form.']
  witness_required boolean [note: 'Indicates whether a witness signature was required for the consent process (e.g., for illiterate subjects or per IRB protocol).']

  Note: 'Master record for informed consent obtained from research subjects prior to enrollment in clinical trials and research studies. Captures IRB-approved consent form version, study arm, consent process details (who obtained consent, where, how long discussion lasted), subject comprehension assessment, legally authorized representative (LAR) details for incapacitated subjects, assent documentation for minors, re-consent events for protocol amendments, and withdrawal of consent. Governed by 45 CFR 46 (Common Rule) and 21 CFR 50 (FDA). Complements research.informed_consent with enterprise consent SSOT linkage.'
}

Table consent.telehealth_consent {
  telehealth_consent_id varchar [pk, note: 'Unique identifier for the telehealth consent record. Primary key.']
  care_site_id varchar
  clinician_id varchar [note: 'Unique identifier for the healthcare provider who will deliver telehealth services under this consent.']
  mpi_record_id varchar [note: 'Unique identifier for the patient providing telehealth consent. Links to the patient master record.']
  superseded_telehealth_consent_id varchar [note: 'Self-referencing FK on telehealth_consent (superseded_telehealth_consent_id)']
  visit_id varchar [note: 'Identifier for the clinical encounter or visit associated with this telehealth consent, if applicable.']
  cms_condition_met boolean [note: 'Indicates whether this telehealth consent satisfies CMS Conditions of Participation for telehealth service delivery and reimbursement.']
  consent_document_code varchar [note: 'Unique identifier or reference to the scanned or electronically signed consent document stored in the document management system.']
  consent_form_version varchar [note: 'Version identifier of the telehealth consent form template used. Enables tracking of consent language changes over time.']
  consent_language varchar [note: 'Two-letter ISO 639-1 language code indicating the language in which the telehealth consent was presented to the patient.']
  consent_method varchar
  consent_obtained_by varchar [note: 'Name or identifier of the staff member, provider, or system that obtained and documented the telehealth consent.']
  consent_obtained_method varchar [note: 'The method by which the patient\'s telehealth consent was captured (e.g., signed paper form, electronic signature, verbal consent documented in EHR).']
  consent_status varchar
  created_timestamp timestamp [note: 'Timestamp when this telehealth consent record was first created in the system. Audit trail for record creation.']
  data_retention_period_days varchar [note: 'Number of days that telehealth session recordings and data will be retained, as disclosed to and consented by the patient.']
  effective_date date
  emergency_override_applicable boolean [note: 'Indicates whether this telehealth consent was obtained under emergency circumstances where standard consent procedures were modified per EMTALA or state emergency laws.']
  expiration_date date
  hipaa_authorization_included boolean [note: 'Indicates whether this telehealth consent includes a HIPAA authorization for use and disclosure of Protected Health Information (PHI) during virtual care.']
  interpreter_used boolean [note: 'Indicates whether a medical interpreter was used during the telehealth consent process to ensure patient understanding.']
  interstate_compact_applicable boolean [note: 'Indicates whether an interstate medical licensure compact (e.g., IMLC) applies to this telehealth consent, allowing cross-state practice.']
  last_modified_timestamp timestamp
  legal_guardian_name varchar [note: 'Name of the legal guardian who provided consent on behalf of a minor or incapacitated patient.']
  legal_guardian_relationship varchar [note: 'The relationship of the legal guardian to the patient (e.g., parent, court-appointed guardian, healthcare proxy).']
  minor_consent_applicable boolean [note: 'Indicates whether this consent involves a minor patient and requires parental or guardian authorization.']
  mrn varchar [note: 'The patient\'s medical record number as assigned by the healthcare organization. Used for clinical identification and consent tracking.']
  notes varchar [note: 'Free-text field for additional notes, comments, or special circumstances related to this telehealth consent.']
  patient_location_state varchar [note: 'Two-letter state code where the patient will be physically located during telehealth services. Determines applicable state telehealth laws.']
  provider_licensure_state varchar [note: 'Two-letter state code where the provider holds active medical licensure. Critical for interstate telehealth compliance.']
  provider_npi varchar [note: 'The 10-digit National Provider Identifier of the provider delivering telehealth services. Required for billing and licensure verification.']
  record_number varchar [note: 'Foreign key linking to consent.record. Business justification: Telehealth consent is a specialized type of consent record for virtual care. Linking to the core record table enables unified consent management and reporting. Core consent lifecycle attributes (statu']
  recording_consent_provided boolean [note: 'Indicates whether the patient consented to audio or video recording of telehealth sessions for quality, training, or medical record purposes.']
  right_to_refuse_disclosed boolean [note: 'Indicates whether the patient was informed of their right to refuse telehealth services and receive in-person care instead.']
  scope_of_services varchar [note: 'Description of the types of clinical services covered under this telehealth consent (e.g., primary care visits, behavioral health, chronic disease management).']
  signed_date date
  state_specific_requirements_met boolean [note: 'Flag indicating whether all state-specific telehealth consent requirements have been satisfied (e.g., informed consent elements, parental consent for minors).']
  technology_risks_disclosed boolean [note: 'Indicates whether the patient was informed of technology risks including potential for technical failure, privacy breaches, and limitations of virtual examination.']
  telehealth_modality varchar [note: 'The type of telehealth technology and interaction method the patient consents to use. Determines the mode of virtual care delivery.']
  telehealth_platform varchar [note: 'Name or identifier of the telehealth technology platform the patient will use for virtual visits (e.g., Epic MyChart Video, Zoom for Healthcare, Doxy.me).']
  third_party_disclosure_authorized boolean [note: 'Indicates whether the patient authorized disclosure of telehealth session information to third parties such as family members, caregivers, or other providers.']
  updated_timestamp timestamp [note: 'Timestamp when this telehealth consent record was last modified. Audit trail for record changes.']
  vibe_mutation_added varchar [note: 'Added by VIBE mutation to satisfy target entity touch requirement']
  vibe_mutation_marker varchar [note: 'Generic mutation marker']
  vibe_structure_marker varchar [note: 'structure enforcement marker']
  witness_name varchar [note: 'Name of the witness present during consent signing, if required by state law or organizational policy.']

  Note: 'Master record for patient consent to receive care via telehealth and virtual care modalities. Captures telehealth platform, modality type (video, audio-only, asynchronous), state-specific consent requirements met, technology risks disclosed, patient right to refuse telehealth and receive in-person care, provider licensure state, and interstate compact applicability. Required by CMS and most state telehealth laws as a condition of telehealth service delivery.'
}

Table consent.minor_consent {
  minor_consent_id varchar [pk, note: 'Unique identifier for the minor consent record. Primary key.']
  care_site_id varchar
  clinician_id varchar [note: 'Reference to the healthcare provider who obtained and documented the consent.']
  delegation_id varchar [note: 'Reference to the parent or legal guardian providing consent on behalf of the minor, if applicable.']
  employee_id varchar [note: 'Identifier of the system user who last updated this consent record, for audit trail purposes.']
  mpi_record_id varchar [note: 'Reference to the minor patient for whom this consent record applies.']
  part2_consent_id varchar
  superseded_minor_consent_id varchar [note: 'Self-referencing FK on minor_consent (superseded_minor_consent_id)']
  visit_id varchar [note: 'Reference to the clinical encounter during which this consent was obtained, if applicable.']
  basis varchar [note: 'The legal basis under which consent is being obtained or documented: mature minor doctrine, emancipated minor status, state-specific minor consent laws (e.g., STI treatment, substance abuse, mental health, reproductive health), parental/guardian consent, or court-ordered consent.']
  behavioral_health_protected_flag boolean
  confidentiality_obligation_to_minor_flag boolean [note: 'Indicates whether the healthcare provider has a legal or ethical obligation to maintain confidentiality of the minor\'s health information from parents/guardians (e.g., when minor consents independently under state law for sensitive services).']
  consent_document_reference varchar [note: 'Reference identifier or storage location of the signed consent document in the document management system.']
  consent_form_version varchar [note: 'Version identifier of the consent form or template used to obtain consent, for audit and compliance tracking.']
  consent_language varchar [note: 'ISO 639-3 three-letter language code indicating the language in which consent was obtained and documented.']
  consent_method varchar [note: 'The method by which consent was obtained: written signature, verbal consent (documented), electronic signature, or implied consent.']
  consent_scope_description varchar [note: 'Detailed description of what the consent covers, including specific treatments, procedures, data sharing purposes, or research protocols.']
  consent_status varchar
  court_order_reference_number varchar [note: 'Reference number or case number of the court order governing consent authority or restrictions, if applicable.']
  court_ordered_consent_restriction_flag boolean [note: 'Indicates whether there are court-ordered restrictions on who may provide consent for the minor (e.g., one parent prohibited from consenting due to custody order).']
  created_timestamp timestamp [note: 'Timestamp when this consent record was first created in the system.']
  custodial_parent_verified_flag boolean [note: 'Indicates whether the consenting parent has been verified as having legal custody and authority to consent on behalf of the minor, particularly important in cases of divorce or separation.']
  custody_documentation_type varchar [note: 'The type of documentation reviewed to verify custodial parent or guardian status.']
  data_sharing_scope varchar [note: 'Description of the scope and purpose of data sharing authorized by this consent (e.g., specific recipients, purposes, data elements).']
  effective_date date
  emancipated_minor_flag boolean [note: 'Indicates whether the minor has been legally emancipated and therefore has full consent rights as an adult.']
  emancipation_documentation_type varchar [note: 'The type of documentation provided to verify emancipated minor status, if applicable.']
  expiration_date date
  guardian_name varchar
  hie_participation_status varchar [note: 'Indicates whether the minor (or parent/guardian on their behalf) has opted in or out of Health Information Exchange participation.']
  hipaa_authorization_flag boolean [note: 'Indicates whether this consent includes a HIPAA authorization for use and disclosure of Protected Health Information (PHI) beyond treatment, payment, and healthcare operations.']
  interpreter_used_flag boolean [note: 'Indicates whether a medical interpreter was used during the consent process to ensure understanding.']
  irb_protocol_number varchar [note: 'The IRB protocol number associated with research consent, if applicable.']
  last_modified_timestamp timestamp
  last_updated_timestamp timestamp [note: 'Timestamp when this consent record was last modified.']
  minor_age_at_consent varchar [note: 'The age of the minor patient at the time consent was obtained, used to determine applicability of age-based consent rules.']
  minor_assent_obtained_flag boolean [note: 'Indicates whether the minor\'s assent (agreement) was obtained in addition to parental consent, particularly relevant for research participation and certain clinical procedures.']
  minor_consenting_independently_flag boolean [note: 'Indicates whether the minor is providing consent independently without parental/guardian involvement, based on mature minor doctrine, emancipation, or state-specific minor consent rights.']
  parent_guardian_name varchar [note: 'Full name of the parent or legal guardian providing consent, if applicable.']
  parental_consent_required_flag boolean [note: 'Indicates whether parental or guardian consent is required for the treatment or service being provided.']
  parental_notification_permitted_flag boolean [note: 'Indicates whether parental notification of the minor\'s care is permitted under applicable law and the minor\'s consent preferences.']
  record_number varchar [note: 'Foreign key linking to consent.record. Business justification: Minor consent is a specialized type of consent record with additional legal requirements for minors. Linking to the core record table enables unified consent management. Core consent lifecycle attribu']
  research_consent_flag boolean [note: 'Indicates whether this consent is for participation in research and is subject to Common Rule and IRB oversight.']
  revocation_reason varchar [note: 'Free-text explanation of why the consent was revoked, if provided.']
  revoked_by varchar [note: 'Identifies who revoked the consent: the minor themselves, parent, guardian, court order, or system (e.g., automatic expiration).']
  signed_date date
  state_specific_minor_consent_category varchar [note: 'The specific category of care for which state law permits minors to consent independently without parental involvement (e.g., sexually transmitted infection treatment, reproductive health services, substance abuse treatment, mental health services). [ENUM-REF-CANDIDATE: sti_treatment|reproductive_health|substance_abuse|mental_health|prenatal_care|sexual_assault|not_applicable — 7 candidates stripped; promote to reference product]']
  vibe_mutation_added varchar [note: 'Added by VIBE mutation to satisfy target entity touch requirement']
  vibe_mutation_marker varchar [note: 'Generic mutation marker']
  vibe_structure_marker varchar [note: 'structure enforcement marker']
  witness_name varchar [note: 'Full name of the witness who observed the consent process, if applicable.']
  witness_required_flag boolean [note: 'Indicates whether a witness signature was required for this consent per organizational policy or legal requirement.']

  Note: 'Master record for consent situations involving minor patients, capturing the complex legal landscape of minor consent rights. Tracks whether the minor is consenting independently (mature minor doctrine, emancipated minor, state-specific minor consent for STI/reproductive health/substance use/mental health), parental/guardian consent details, custodial parent verification, court-ordered consent restrictions, and confidentiality obligations to the minor. Critical for compliance with state minor consent statutes and HIPAA minor exception rules.'
}

Table consent.delegation {
  delegation_id varchar [pk, note: 'Unique identifier for the consent delegation record. Primary key for the consent delegation entity.']
  care_site_id varchar
  delegation_delegate_person_mpi_record_id varchar [note: 'Identifier of the individual authorized to provide consent on behalf of the patient. May link to person or contact master record.']
  delegation_mpi_record_id varchar [note: 'Identifier of the patient for whom consent delegation authority is being granted. Links to the patient master record.']
  primary_delegation_created_by_user_employee_id varchar [note: 'Identifier of the user or staff member who created the consent delegation record.']
  quaternary_delegation_revoked_by_user_employee_id varchar [note: 'Identifier of the staff member or user who processed the revocation of the delegation authority.']
  superseded_delegation_id varchar [note: 'Self-referencing FK on delegation (superseded_delegation_id)']
  tertiary_delegation_last_updated_by_user_employee_id varchar [note: 'Identifier of the user or staff member who last modified the consent delegation record.']
  applies_to_minor boolean [note: 'Boolean flag indicating whether this delegation applies to a minor patient. True if the patient is a minor and the delegate has parental or guardian authority.']
  consent_status varchar
  created_timestamp timestamp [note: 'Timestamp when the consent delegation record was first created in the system. Used for audit trail and data lineage.']
  delegate_address_line1 varchar [note: 'First line of the delegates mailing address (street address, PO Box).']
  delegate_address_line2 varchar [note: 'Second line of the delegates mailing address (apartment, suite, unit number). Nullable if not applicable.']
  delegate_city varchar [note: 'City of the delegates mailing address.']
  delegate_contact_email varchar [note: 'Primary email address for the delegate. Used for electronic communication regarding consent matters.']
  delegate_contact_phone varchar [note: 'Primary contact phone number for the delegate. Used to reach the authorized representative for consent decisions.']
  delegate_country varchar [note: 'Country of the delegates mailing address. Three-letter ISO 3166-1 alpha-3 country code.']
  delegate_name varchar [note: 'Full legal name of the authorized representative or surrogate decision-maker.']
  delegate_postal_code varchar [note: 'Postal code or ZIP code of the delegates mailing address.']
  delegate_relationship varchar [note: 'Relationship of the delegate to the patient (e.g., spouse, parent, legal guardian, healthcare proxy). [ENUM-REF-CANDIDATE: spouse|parent|adult_child|sibling|legal_guardian|healthcare_proxy|power_of_attorney|court_appointed_guardian|next_of_kin|other — 10 candidates stripped; promote to reference product]']
  delegate_state varchar [note: 'State or province of the delegates mailing address. Two-letter state code for US addresses.']
  delegation_status varchar [note: 'Current lifecycle status of the delegation authority. Indicates whether the delegation is currently in effect, has been revoked, has expired, or is pending verification.']
  delegation_type varchar [note: 'Type of legal authority granted to the delegate. Distinguishes between healthcare proxy, durable power of attorney for healthcare (DPOA-HC), legal guardianship, court-appointed guardianship, next-of-kin surrogate per state law, and parental authority for minors.']
  effective_date date
  effective_end_date date [note: 'Date when the delegation authority expires or terminates. Nullable for open-ended delegations. The delegate is no longer authorized to provide consent after this date.']
  effective_start_date date [note: 'Date when the delegation authority becomes effective. The delegate is authorized to provide consent on or after this date.']
  emergency_contact_flag boolean [note: 'Boolean flag indicating whether the delegate should also be contacted in medical emergencies. True if the delegate is designated as an emergency contact.']
  expiration_date date
  last_modified_timestamp timestamp
  last_updated_timestamp timestamp [note: 'Timestamp when the consent delegation record was last modified. Used for audit trail and change tracking.']
  legal_document_date date [note: 'Date the legal document was executed, signed, or issued by the court. Establishes the legal validity timeline.']
  legal_document_reference varchar [note: 'Reference identifier or location of the supporting legal documentation (e.g., document ID in document management system, court case number, file path). Used to retrieve the original legal instrument.']
  legal_document_type varchar [note: 'Type of legal documentation supporting the delegation authority (e.g., advance directive, healthcare proxy form, durable power of attorney document, guardianship court order, birth certificate for parental authority). [ENUM-REF-CANDIDATE: advance_directive|healthcare_proxy_form|power_of_attorney_document|guardianship_order|court_order|birth_certificate|other — 7 candidates stripped; promote to reference product]']
  limitations_description varchar [note: 'Free-text description of any limitations or restrictions on the delegates authority (e.g., cannot consent to experimental treatments, cannot authorize organ donation, specific procedures excluded).']
  notes varchar [note: 'Additional free-text notes or comments about the delegation authority, verification process, or special circumstances.']
  priority_order varchar [note: 'Priority ranking when multiple delegates exist for the same patient. Lower numbers indicate higher priority. Used to determine which delegate has primary authority when conflicts arise.']
  record_number varchar
  revocation_date date [note: 'Date when the delegation authority was revoked by the patient, delegate, or legal authority. Nullable if delegation has not been revoked.']
  revocation_reason varchar [note: 'Free-text explanation of why the delegation authority was revoked (e.g., patient request, delegate resignation, legal change, death of delegate).']
  scope varchar [note: 'Scope of authority granted to the delegate. Defines what types of consent decisions the delegate is authorized to make (e.g., full medical decisions, treatment consent only, research consent, data sharing, financial decisions, emergency-only). [ENUM-REF-CANDIDATE: full_medical_decisions|treatment_consent_only|research_consent_only|data_sharing_authorization|financial_decisions|limited_scope|emergency_only — 7 candidates stripped; promote to reference product]']
  source_system_code varchar [note: 'Unique identifier of the delegation record in the source system. Used for data lineage and reconciliation.']
  verification_date date [note: 'Date when the delegation authority was verified by authorized staff. Used for audit and compliance tracking.']
  verification_status varchar [note: 'Status of verification of the delegation authority and supporting documentation. Indicates whether the legal authority has been confirmed by appropriate staff or legal review.']
  vibe_mutation_added varchar [note: 'Added by VIBE mutation to satisfy target entity touch requirement']
  vibe_mutation_marker varchar [note: 'Generic mutation marker']
  vibe_structure_marker varchar [note: 'structure enforcement marker']

  Note: 'Master record for authorized representatives, legal surrogates, and healthcare proxies who have legal authority to provide consent on behalf of a patient. Captures delegate type (healthcare proxy, durable power of attorney for healthcare, legal guardian, court-appointed guardian, next-of-kin surrogate per state law), delegation scope, effective period, supporting legal documentation reference, and priority order when multiple delegates exist. Distinct from patient.proxy_access which governs portal access — this governs clinical consent authority.'
}

Table consent.revocation {
  revocation_id varchar [pk, note: 'Unique identifier for the consent revocation record. Primary key for the consent revocation entity.']
  care_site_id varchar
  delegation_id varchar [note: 'Reference to the authorized representative who submitted the revocation on behalf of the patient, if applicable. Null if patient revoked directly.']
  mpi_record_id varchar [note: 'Reference to the patient who is revoking consent or on whose behalf consent is being revoked.']
  part2_consent_id varchar
  primary_revocation_employee_id varchar [note: 'Reference to the staff member or system user who received and recorded the consent revocation.']
  prior_revocation_id varchar [note: 'Self-referencing FK on revocation (prior_revocation_id)']
  audit_trail_reference varchar [note: 'Reference identifier linking to detailed audit trail records for all actions taken in response to this revocation, maintained for regulatory compliance.']
  behavioral_health_protected_flag boolean
  compliance_notes varchar [note: 'Internal notes regarding compliance considerations, special handling requirements, or regulatory reporting obligations related to this revocation.']
  consent_status varchar
  created_timestamp timestamp
  data_access_restricted_flag boolean [note: 'Indicates whether data access controls have been updated to restrict access based on the revoked consent.']
  data_access_restricted_timestamp timestamp [note: 'The date and time when data access restrictions were implemented in response to the consent revocation.']
  disclosures_halted_flag boolean [note: 'Indicates whether ongoing or future disclosures of Protected Health Information (PHI) have been halted as a result of this revocation.']
  disclosures_halted_timestamp timestamp [note: 'The date and time when disclosure processes were halted in response to the consent revocation.']
  document_reference varchar [note: 'Reference identifier or file path to the scanned or electronic copy of the signed revocation document, if applicable.']
  effective_date date
  effective_timestamp timestamp [note: 'The date and time when the revocation became legally effective and operational systems began enforcing the withdrawal of consent. May differ from revocation_timestamp due to processing delays.']
  expiration_date date
  irrevocable_actions_description varchar [note: 'Free-text description of any actions taken under the original consent that cannot be reversed or undone despite the revocation (e.g., data already shared with third parties, research already conducted).']
  last_modified_timestamp timestamp
  legal_review_completed_flag boolean [note: 'Indicates whether required legal review has been completed for this revocation.']
  legal_review_required_flag boolean [note: 'Indicates whether this revocation requires legal review before being processed (e.g., complex partial revocations, disputes, or high-risk scenarios).']
  legal_review_timestamp timestamp [note: 'The date and time when legal review of the revocation was completed.']
  legal_reviewer_notes varchar [note: 'Confidential notes from legal counsel regarding the revocation review, including any special handling instructions or risk assessments.']
  method varchar [note: 'The method or channel through which the patient submitted the consent revocation (e.g., written form, verbal communication, patient portal, email, fax, in-person). [ENUM-REF-CANDIDATE: written|verbal|electronic|portal|email|fax|in_person — 7 candidates stripped; promote to reference product]']
  notification_sent_flag boolean [note: 'Indicates whether notification of the revocation was sent to relevant parties (providers, research teams, business associates, etc.).']
  notification_sent_timestamp timestamp [note: 'The date and time when notifications regarding the consent revocation were sent to affected parties.']
  partial_revocation_details varchar [note: 'Free-text description of which specific portions of the consent are being revoked when revocation_scope is partial. Null when revocation is full.']
  patient_notification_sent_flag boolean [note: 'Indicates whether confirmation notification was sent to the patient acknowledging receipt and processing of their revocation.']
  patient_notification_timestamp timestamp [note: 'The date and time when confirmation notification was sent to the patient regarding their consent revocation.']
  prior_disclosures_count varchar [note: 'The number of disclosures that occurred under the original consent prior to revocation and that cannot be undone or recalled.']
  prior_disclosures_summary varchar [note: 'Summary description of disclosures that occurred prior to revocation and cannot be undone, maintained for legal audit trail and patient notification.']
  reason varchar [note: 'Optional free-text explanation provided by the patient describing why they are revoking consent. May be blank if patient chose not to provide a reason.']
  reason_code varchar [note: 'Standardized categorical code representing the reason for consent revocation, used for reporting and analytics.']
  record_created_timestamp timestamp [note: 'The date and time when this consent revocation record was first created in the data warehouse or lakehouse.']
  record_number varchar [note: 'Reference to the original consent record being revoked. Links to the parent consent that this revocation applies to.']
  record_updated_timestamp timestamp [note: 'The date and time when this consent revocation record was last updated in the data warehouse or lakehouse.']
  rejection_reason varchar [note: 'Explanation of why the revocation was rejected, if applicable (e.g., invalid signature, unauthorized submitter, incomplete documentation).']
  revocation_date date [note: 'The calendar date on which the patient submitted the consent revocation. This is the effective date from which the consent is considered withdrawn.']
  revocation_number varchar [note: 'Business-facing unique identifier or tracking number assigned to this consent revocation for reference and audit purposes.']
  revocation_reason varchar
  revocation_status varchar [note: 'Current processing status of the consent revocation within the organization\'s workflow (e.g., pending review, processed and effective, rejected due to invalid submission).']
  revocation_timestamp timestamp [note: 'The precise date and time when the consent revocation was submitted or recorded in the system. Provides exact temporal audit trail for legal compliance.']
  scope varchar [note: 'Indicates whether the revocation applies to the entire consent (full) or only specific portions of the consent (partial).']
  source_system_code varchar [note: 'The unique identifier for this revocation record in the source operational system.']
  vibe_mutation_added varchar [note: 'Added by VIBE mutation to satisfy target entity touch requirement']
  vibe_mutation_marker varchar [note: 'Generic mutation marker']
  vibe_structure_marker varchar [note: 'structure enforcement marker']
  witness_name varchar [note: 'Name of the witness who was present when the revocation was submitted, if applicable (e.g., for verbal revocations or in-person submissions).']
  witness_signature_flag boolean [note: 'Indicates whether a witness signature was obtained on the revocation document.']

  Note: 'Transactional record of every consent revocation submitted by a patient or their authorized representative. Captures revocation date and time, revocation method (written, verbal, electronic), reason for revocation (if provided), scope of revocation (full or partial), actions taken in response (notifications sent, data access restricted, disclosures halted), and any disclosures that occurred prior to revocation that cannot be undone. Provides the legal audit trail required by HIPAA and state law for consent withdrawal.'
}

Table consent.npp_acknowledgment {
  npp_acknowledgment_id varchar [pk, note: 'Unique identifier for the NPP acknowledgment transaction. Primary key.']
  care_site_id varchar [note: 'Identifier of the healthcare facility where the NPP acknowledgment was obtained.']
  mpi_record_id varchar [note: 'Identifier of the patient who acknowledged or was presented with the NPP.']
  notice_of_privacy_practices_id varchar [note: 'Foreign key linking to compliance.notice_of_privacy_practices. Business justification: Direct relationship - NPP acknowledgments in consent domain track patient acknowledgment of the NPP document managed in compliance domain. Essential for HIPAA compliance, demonstrating good faith effo']
  org_unit_id varchar [note: 'Identifier of the department within the facility where the NPP acknowledgment was obtained (e.g., registration, emergency department, outpatient clinic).']
  primary_npp_employee_id varchar [note: 'Identifier of the staff member or system user who obtained or recorded the NPP acknowledgment.']
  primary_previous_npp_acknowledgment_id varchar [note: 'Identifier of the previous NPP acknowledgment record for this patient, if this is a re-acknowledgment following a material change.']
  visit_id varchar [note: 'Identifier of the clinical encounter during which the NPP acknowledgment was obtained, if applicable.']
  accessibility_accommodation varchar [note: 'Description of any accessibility accommodations provided (e.g., large print, Braille, audio recording, sign language interpreter).']
  acknowledgment_date date [note: 'Date on which the patient acknowledged receipt of the NPP.']
  acknowledgment_location varchar [note: 'Physical or virtual location where the acknowledgment was obtained. [ENUM-REF-CANDIDATE: registration_desk|patient_room|emergency_department|outpatient_clinic|patient_portal|home|other — 7 candidates stripped; promote to reference product]']
  acknowledgment_method varchar [note: 'Method by which the patient provided acknowledgment (paper signature, electronic signature, patient portal click-through, email confirmation, kiosk acceptance, verbal acknowledgment documented by staff).']
  acknowledgment_status varchar [note: 'Current status of the NPP acknowledgment transaction. Acknowledged indicates patient signed or electronically accepted; unable_to_obtain indicates good-faith effort was made but acknowledgment could not be secured per regulatory allowance.']
  acknowledgment_timestamp timestamp [note: 'Precise date and time when the patient acknowledged receipt of the NPP, particularly important for electronic acknowledgments.']
  consent_status varchar
  created_timestamp timestamp [note: 'Date and time when this acknowledgment record was first created in the system.']
  delivery_method varchar [note: 'Method by which the NPP was delivered to the patient (paper handout, electronic via patient portal, email, kiosk, verbal explanation).']
  device_type varchar [note: 'Type of device used for electronic acknowledgment (desktop computer, mobile phone, tablet, kiosk).']
  effective_date date
  expiration_date date
  good_faith_effort_documentation varchar [note: 'Free-text documentation of the good-faith effort made to obtain acknowledgment when it could not be secured.']
  good_faith_effort_reason varchar [note: 'Reason why acknowledgment could not be obtained despite good-faith effort, as permitted under 45 CFR 164.520(c)(2)(ii).']
  interpreter_used boolean [note: 'Indicates whether an interpreter was used to explain the NPP to the patient.']
  ip_address varchar [note: 'IP address from which the electronic acknowledgment was submitted, for audit trail purposes.']
  is_first_service_acknowledgment boolean [note: 'Indicates whether this acknowledgment was obtained at the first service delivery as required by 45 CFR 164.520(c)(1).']
  language_code varchar [note: 'ISO 639-2 three-letter language code indicating the language in which the NPP was provided to the patient.']
  last_modified_timestamp timestamp
  last_updated_timestamp timestamp [note: 'Date and time when this acknowledgment record was last modified.']
  material_change_acknowledgment boolean [note: 'Indicates whether this acknowledgment was obtained following a material change to the NPP, requiring re-acknowledgment.']
  notes varchar [note: 'Additional free-text notes or comments regarding the NPP acknowledgment transaction.']
  patient_portal_session_code varchar [note: 'Session identifier from the patient portal if the acknowledgment was obtained electronically via the portal.']
  record_number varchar
  representative_authority_documented boolean [note: 'Indicates whether the authority of a personal representative to act on behalf of the patient was documented and verified.']
  retention_expiration_date date [note: 'Date after which this acknowledgment record may be destroyed per retention policy.']
  retention_period_years varchar [note: 'Number of years this acknowledgment record must be retained per HIPAA record retention requirements (minimum 6 years from creation or last effective date).']
  revocation_date date [note: 'Date on which the acknowledgment was revoked or voided, if applicable.']
  revocation_reason varchar [note: 'Reason why the acknowledgment was revoked or voided (e.g., administrative error, duplicate entry, patient request).']
  signature_captured boolean [note: 'Indicates whether a patient or representative signature was captured as part of the acknowledgment.']
  signature_type varchar [note: 'Type of signature captured (wet ink on paper, electronic stylus, digital certificate-based, biometric, or none if acknowledgment was obtained without signature).']
  signer_name varchar [note: 'Full name of the individual who signed the acknowledgment (patient or authorized representative).']
  signer_relationship varchar [note: 'Relationship of the signer to the patient (self if patient signed, or representative role). [ENUM-REF-CANDIDATE: self|parent|legal_guardian|power_of_attorney|healthcare_proxy|personal_representative|other — 7 candidates stripped; promote to reference product]']
  source_system_code varchar [note: 'Unique identifier of this acknowledgment record in the source system.']
  vibe_mutation_added varchar [note: 'Added by VIBE mutation to satisfy target entity touch requirement']
  vibe_mutation_marker varchar [note: 'Generic mutation marker']
  vibe_structure_marker varchar [note: 'structure enforcement marker']

  Note: 'Transactional record of patient acknowledgment of receipt of the organization\'s HIPAA Notice of Privacy Practices (NPP). Captures acknowledgment date, delivery method (paper, electronic, patient portal), NPP version acknowledged, patient or representative signature, and documentation of good-faith efforts when acknowledgment could not be obtained. Distinct from compliance.notice_of_privacy_practices which tracks the NPP document itself — this tracks the patient-level acknowledgment transaction required by 45 CFR 164.520.'
}

Table consent.restriction_request {
  restriction_request_id varchar [pk, note: 'Unique identifier for the patient consent restriction request record. Primary key.']
  blocked_hie_query_id varchar [note: 'Foreign key linking to interoperability.hie_query. Business justification: Patient restriction requests may block specific HIE queries in real-time. When patient restricts disclosure to certain recipients, system must log which HIE queries were denied due to restriction. Req']
  care_site_id varchar [note: 'The healthcare facility where the restriction request was received and processed. Links to the facility master record.']
  compliance_policy_id varchar [note: 'Foreign key linking to compliance.policy. Business justification: Restriction requests are evaluated against organizational policies defining when restrictions must be honored vs. can be denied. Links requests to governing policies for decision documentation, audit ']
  employee_id varchar [note: 'The identifier of the privacy officer or Health Information Management (HIM) professional responsible for processing and overseeing the restriction request. Links to the workforce/provider master record.']
  insurance_coverage_id varchar [note: 'Foreign key linking to patient.insurance_coverage. Business justification: HIPAA permits patients paying out-of-pocket to request disclosure restrictions to their health plan. Attribute out_of_pocket_payment_verified documents this business requirement. Link enables verifica']
  mpi_record_id varchar [note: 'Unique identifier for the patient who submitted the restriction request. Links to the patient master record.']
  part2_consent_id varchar
  superseded_restriction_request_id varchar [note: 'Self-referencing FK on restriction_request (superseded_restriction_request_id)']
  visit_id varchar [note: 'The encounter during which the restriction request was submitted, if applicable. Links to the encounter master record.']
  audit_trail_reference varchar [note: 'Reference identifier to the detailed audit trail of all actions taken on this restriction request, including reviews, decisions, notifications, and enforcement activities.']
  behavioral_health_protected_flag boolean
  compliance_review_date date [note: 'The date of the most recent compliance review of this restriction request to ensure ongoing adherence to HIPAA and HITECH requirements.']
  consent_status varchar
  created_timestamp timestamp [note: 'The timestamp when this restriction request record was first created in the system. Used for audit and data lineage purposes.']
  decision_date date [note: 'The date the covered entity made the decision to accept or deny the restriction request.']
  decision_made_by varchar [note: 'The name or role of the individual or committee who made the decision on the restriction request (e.g., Privacy Officer, HIM Director).']
  decision_rationale varchar [note: 'The business and regulatory rationale for the organization\'s decision to accept or deny the restriction request. Required for audit and patient communication.']
  effective_date date [note: 'The date from which the restriction becomes effective and must be honored by the covered entity.']
  expiration_date date [note: 'The date on which the restriction expires, if applicable. Null indicates an indefinite restriction until revoked by the patient or terminated by the organization per regulatory provisions.']
  last_modified_timestamp timestamp
  last_updated_timestamp timestamp [note: 'The timestamp when this restriction request record was last modified. Used for audit and data lineage purposes.']
  mrn varchar [note: 'The patient\'s medical record number as recorded at the time of the restriction request. Provides business-level traceability.']
  notes varchar [note: 'Additional free-text notes or comments related to the restriction request, including patient concerns, special handling instructions, or escalation details.']
  operational_instructions varchar [note: 'Detailed operational instructions for clinical, billing, and administrative staff on how to honor the restriction across Electronic Health Record (EHR), Revenue Cycle Management (RCM), Health Information Exchange (HIE), and other systems.']
  organization_decision varchar [note: 'The covered entity\'s decision on whether to accept or deny the restriction request. HITECH out-of-pocket restrictions must be accepted; other restrictions are discretionary.']
  out_of_pocket_payment_verified boolean [note: 'Indicates whether the patient\'s claim of out-of-pocket payment has been verified for HITECH mandatory restrictions. True if verified, False if not applicable or not verified.']
  patient_notification_date date [note: 'The date the patient was notified of the organization\'s decision on the restriction request or any subsequent changes to the restriction status.']
  patient_notification_method varchar [note: 'The method used to notify the patient of the decision or status change. [ENUM-REF-CANDIDATE: mail|email|patient_portal|phone|in_person|secure_message|other — 7 candidates stripped; promote to reference product]']
  payment_verification_date date [note: 'The date the out-of-pocket payment was verified for HITECH mandatory restrictions, if applicable.']
  record_number varchar [note: 'Foreign key linking to consent.consent_record. Business justification: Consent restriction requests are patient requests to restrict PHI use beyond standard consent. While some restriction requests are general (not tied to specific consent), many relate to a specific con']
  request_date date [note: 'The date the patient submitted the restriction request to the covered entity.']
  request_method varchar [note: 'The method by which the patient submitted the restriction request. [ENUM-REF-CANDIDATE: written_form|verbal|patient_portal|email|fax|mail|in_person|other — 8 candidates stripped; promote to reference product]']
  request_number varchar [note: 'Business-assigned unique identifier for the restriction request, used for tracking and reference in correspondence and workflows.']
  request_status varchar
  request_timestamp timestamp [note: 'The precise date and time the restriction request was received and recorded in the system.']
  request_type varchar
  requesting_party_relationship varchar [note: 'The relationship of the individual submitting the restriction request to the patient, if not the patient themselves.']
  restricted_phi_category varchar [note: 'The category of Protected Health Information (PHI) the patient is requesting to restrict. Used for operational filtering and enforcement. [ENUM-REF-CANDIDATE: all_phi|diagnosis_codes|procedure_codes|lab_results|radiology_reports|medication_records|mental_health_records|substance_abuse_records|genetic_information|other — 10 candidates stripped; promote to reference product]']
  restricted_purpose varchar [note: 'The purpose of use or disclosure that the patient is requesting to restrict (e.g., restrict disclosure for payment purposes to a specific payer). [ENUM-REF-CANDIDATE: treatment|payment|healthcare_operations|research|public_health|all_purposes|other — 7 candidates stripped; promote to reference product]']
  restricted_recipient_name varchar [note: 'The specific name of the individual, organization, or health plan to whom the restriction applies, if identified by the patient.']
  restricted_recipient_type varchar [note: 'The type of recipient or entity to whom the patient is requesting disclosure restrictions apply. [ENUM-REF-CANDIDATE: health_plan|family_member|employer|specific_provider|health_information_exchange|research_entity|public_health_authority|other — 8 candidates stripped; promote to reference product]']
  restriction_scope varchar [note: 'Detailed narrative describing the scope of the requested restriction, including specific Protected Health Information (PHI) data elements, recipients, purposes, or time periods the patient wishes to restrict.']
  restriction_status varchar [note: 'The current lifecycle status of the restriction. Active restrictions must be enforced across all clinical and administrative systems.']
  restriction_type varchar [note: 'The category of restriction requested by the patient. HITECH out-of-pocket payer restriction is mandatory per 45 CFR 164.522(a)(1)(vi); other types are discretionary.']
  revocation_date date [note: 'The date the patient revoked the restriction request, if applicable. Patients may revoke restrictions at any time per HIPAA.']
  revocation_method varchar [note: 'The method by which the patient revoked the restriction, if applicable. [ENUM-REF-CANDIDATE: written_form|verbal|patient_portal|email|fax|mail|in_person|other — 8 candidates stripped; promote to reference product]']
  supporting_documentation_reference varchar [note: 'Reference identifier or location of supporting documentation submitted with the restriction request (e.g., signed forms, proof of out-of-pocket payment for HITECH restrictions).']
  system_enforcement_flag boolean [note: 'Indicates whether the restriction is actively enforced through automated system controls (True) or requires manual staff intervention (False).']
  termination_date date [note: 'The date the covered entity terminated the restriction, if applicable. Organizations may terminate restrictions under specific circumstances per HIPAA.']
  termination_reason varchar [note: 'The reason the covered entity terminated the restriction, including regulatory justification and patient notification details.']
  vibe_mutation_added varchar [note: 'Added by VIBE mutation to satisfy target entity touch requirement']
  vibe_mutation_marker varchar [note: 'Generic mutation marker']
  vibe_structure_marker varchar [note: 'structure enforcement marker']

  Note: 'Master record for patient requests to restrict uses and disclosures of their PHI beyond HIPAA\'s standard permissions. Captures restriction type (restrict disclosure to specific payer when patient paid out-of-pocket per HITECH, restrict sharing with family members, restrict specific data types), requested restriction scope, organization\'s decision to accept or deny the restriction, effective date, and operational instructions for honoring the restriction across clinical systems. Governed by HITECH Act amendment to HIPAA 45 CFR 164.522.'
}

Table consent.disclosure_log {
  disclosure_log_id varchar [pk, note: 'Unique identifier for the consent disclosure log entry. Primary key for the consent disclosure log product.']
  care_site_id varchar [note: 'Reference to the healthcare facility or location where the disclosure was made. Links to the facility product.']
  hipaa_authorization_id varchar [note: 'Foreign key linking to consent.hipaa_authorization. Business justification: PHI disclosures are frequently made under specific HIPAA authorizations. The disclosure_log currently has authorization_reference (STRING) which should be replaced with a proper FK to hipaa_authorizat']
  message_log_id varchar [note: 'Foreign key linking to interoperability.message_log. Business justification: HIPAA accounting of disclosures requires linking each disclosure log entry to the actual message transmission event. When PHI is disclosed via HL7/FHIR/Direct, the message_log provides technical proof']
  mpi_record_id varchar [note: 'Reference to the patient whose Protected Health Information (PHI) was disclosed. Links to the patient master product.']
  parent_disclosure_log_id varchar [note: 'Self-referencing FK on disclosure_log (related_disclosure_log_id)']
  phi_access_log_id varchar [note: 'Foreign key linking to compliance.phi_access_log. Business justification: Disclosures based on consent should be traceable to access logs for complete audit trail of PHI movement. Essential for accounting of disclosures, breach investigation, and demonstrating that disclosu']
  visit_id varchar [note: 'Reference to the clinical encounter or visit associated with this disclosure, if applicable. Links to the encounter product.']
  behavioral_health_protected_flag boolean
  consent_status varchar
  created_timestamp timestamp [note: 'The date and time when this disclosure log record was first created in the system. Supports audit trail and data lineage.']
  department_code varchar [note: 'The code or identifier of the department or unit within the facility that made the disclosure. Supports departmental accountability and reporting.']
  disclosure_date date [note: 'The date on which the Protected Health Information (PHI) disclosure occurred. Required for HIPAA Accounting of Disclosures per 45 CFR 164.528.']
  disclosure_initiated_by varchar [note: 'The name or identifier of the individual or system that initiated the disclosure. Supports audit trail and accountability.']
  disclosure_initiated_by_role varchar [note: 'The role or job title of the individual who initiated the disclosure, such as physician, nurse, HIM specialist, or system administrator. Supports role-based access auditing.']
  disclosure_method varchar [note: 'The method or channel by which the Protected Health Information (PHI) was disclosed. Supports security analysis and breach risk assessment. [ENUM-REF-CANDIDATE: electronic|paper|verbal|fax|secure_email|hie|api|other — 8 candidates stripped; promote to reference product]']
  disclosure_notes varchar [note: 'Additional notes, comments, or context regarding the disclosure. Provides supplementary information for audit and compliance review.']
  disclosure_purpose varchar [note: 'The stated purpose or reason for the Protected Health Information (PHI) disclosure. Required for HIPAA Accounting of Disclosures per 45 CFR 164.528.']
  disclosure_purpose_category varchar [note: 'The standardized category of the disclosure purpose. Enables aggregation and reporting of disclosures by purpose type for compliance and analytics. [ENUM-REF-CANDIDATE: treatment|payment|operations|research|public_health|legal|patient_request|court_order|law_enforcement|other — 10 candidates stripped; promote to reference product]']
  disclosure_status varchar [note: 'The current status of the disclosure transaction. Tracks the lifecycle state of the disclosure event.']
  disclosure_timestamp timestamp [note: 'The precise date and time when the Protected Health Information (PHI) disclosure occurred. Provides granular audit trail for compliance and security investigations.']
  effective_date date
  expiration_date date
  is_accounting_required boolean [note: 'Indicates whether this disclosure must be included in the HIPAA Accounting of Disclosures report provided to patients upon request. Non-TPO disclosures are subject to accounting per 45 CFR 164.528.']
  is_tpo_disclosure boolean [note: 'Indicates whether the disclosure was made for Treatment, Payment, or Operations (TPO) purposes. TPO disclosures are exempt from HIPAA Accounting of Disclosures requirements per 45 CFR 164.528.']
  last_modified_timestamp timestamp
  legal_basis varchar [note: 'The legal or regulatory basis that permitted or required the disclosure, such as court order, subpoena, public health reporting requirement, or patient authorization.']
  minimum_necessary_applied boolean [note: 'Indicates whether the minimum necessary standard was applied to limit the Protected Health Information (PHI) disclosed to only what was reasonably necessary for the stated purpose, as required by 45 CFR 164.502(b).']
  modified_by varchar [note: 'The user ID or system identifier that last modified this disclosure log record. Supports audit trail and accountability.']
  modified_timestamp timestamp [note: 'The date and time when this disclosure log record was last modified. Supports audit trail and change tracking.']
  patient_notification_date date [note: 'The date on which the patient was notified of the disclosure, if notification was required. Supports compliance tracking.']
  patient_notification_required boolean [note: 'Indicates whether the patient must be notified of this disclosure under HIPAA or organizational policy. Certain disclosures require patient notification.']
  phi_elements_disclosed varchar [note: 'Description of the specific Protected Health Information (PHI) elements or data categories that were disclosed. Required for HIPAA Accounting of Disclosures.']
  recipient_address varchar [note: 'The mailing or physical address of the recipient to whom the Protected Health Information (PHI) was disclosed. Required for HIPAA Accounting of Disclosures.']
  recipient_identifier varchar [note: 'The unique identifier for the recipient, such as National Provider Identifier (NPI), Tax ID, or organizational identifier. Enables precise tracking of disclosure recipients.']
  recipient_name varchar [note: 'The name of the individual, organization, or entity to whom the Protected Health Information (PHI) was disclosed. Required for HIPAA Accounting of Disclosures.']
  recipient_type varchar [note: 'The category of recipient to whom the Protected Health Information (PHI) was disclosed. Supports classification and reporting of disclosure patterns. [ENUM-REF-CANDIDATE: individual|organization|government_agency|health_plan|clearinghouse|business_associate|research_institution|public_health_authority|law_enforcement|other — 10 candidates stripped; promote to reference product]']
  record_number varchar [note: 'Reference to the consent or authorization record under which this disclosure was made. Links to the consent product.']
  system_source varchar [note: 'The name or identifier of the source system or application that recorded the disclosure event, such as Epic EHR, Cerner Millennium, or HIE platform.']
  vibe_mutation_added varchar [note: 'Added by VIBE mutation to satisfy target entity touch requirement']
  vibe_mutation_marker varchar [note: 'Generic mutation marker']
  vibe_structure_marker varchar [note: 'structure enforcement marker']
  created_by varchar [note: 'The user ID or system identifier that created this disclosure log record. Supports audit trail and accountability.']

  Note: 'Transactional record of every PHI disclosure made under a patient consent or authorization, providing the accounting of disclosures required by HIPAA. Captures disclosure date, recipient identity and type, purpose of disclosure, PHI elements disclosed, consent or authorization reference, and whether the disclosure was for TPO (exempt from accounting) or non-TPO (subject to accounting). Enables generation of the HIPAA Accounting of Disclosures report provided to patients upon request per 45 CFR 164.528.'
}

Table consent.capacity_assessment {
  capacity_assessment_id varchar [pk, note: 'Primary key']
  care_site_id varchar
  clinician_id varchar [note: 'Assessing clinician']
  mpi_record_id varchar [note: 'FK to patient']
  visit_id varchar [note: 'FK to encounter']
  appreciation_score varchar [note: 'Appreciation component score']
  assessment_date date [note: 'Date of assessment']
  assessment_result varchar
  assessment_tool_used varchar [note: 'Assessment tool/instrument']
  assessment_type varchar [note: 'Type of capacity assessment']
  assessor_name varchar
  capacity_determination varchar [note: 'Capacity determination result']
  clinical_findings varchar [note: 'Clinical findings summary']
  consent_status varchar
  created_timestamp timestamp [note: 'Record creation timestamp']
  effective_date date
  expiration_date date
  expression_score varchar [note: 'Expression component score']
  last_modified_timestamp timestamp
  overall_score varchar [note: 'Overall capacity score']
  reasoning_score varchar [note: 'Reasoning component score']
  reassessment_date date [note: 'Recommended reassessment date']
  reassessment_recommended boolean [note: 'Reassessment recommended']
  record_number varchar [note: 'FK to consent record']
  surrogate_required boolean [note: 'Surrogate decision maker needed']
  understanding_score varchar [note: 'Understanding component score']
  updated_timestamp timestamp [note: 'Last update timestamp']
  vibe_structure_marker varchar [note: 'structure enforcement marker']

  Note: 'Transactional record of formal clinical assessments of a patient\'s decision-making capacity to provide informed consent. Captures assessment date, assessing clinician, assessment tool used (MacCAT-T, Aid to Capacity Evaluation), capacity determination (full capacity, diminished capacity, lacks capacity), specific deficits identified, clinical basis for determination, and whether a surrogate decision-maker was engaged. Required when capacity is in question and critical for legal defensibility of consent obtained from vulnerable populations.'
}

Table consent.consent_policy {
  consent_policy_id varchar [pk, note: 'Unique identifier for the consent policy record. Primary key.']
  care_site_id varchar
  exchange_standard_id varchar [note: 'Foreign key linking to interoperability.exchange_standard. Business justification: Consent policies define which exchange standards are used for consent transmission (HL7 v2.5.1 CON segment, C-CDA Consent Directive, FHIR Consent). Governance requirement to ensure organizational cons']
  mpi_record_id varchar
  parent_compliance_policy_id varchar [note: 'Foreign key linking to compliance.policy. Business justification: Consent-specific policies are often subordinate to or reference broader organizational compliance policies. Establishes policy hierarchy for governance, ensures consent policies align with enterprise ']
  primary_consent_employee_id varchar [note: 'Identifier of the user or role responsible for maintaining and updating this consent policy.']
  primary_superseded_by_consent_policy_id varchar [note: 'Reference to the consent policy that supersedes this policy. Populated when policy status is \'superseded\'. Null for active policies.']
  tertiary_consent_last_updated_by_user_employee_id varchar [note: 'Identifier of the user who last modified this consent policy record.']
  applicable_facility_types varchar [note: 'Comma-separated list of facility types where this consent policy applies (e.g., hospital, clinic, outpatient center, research facility, telehealth platform).']
  applicable_service_lines varchar [note: 'Comma-separated list of clinical service lines or departments where this consent policy applies (e.g., surgery, oncology, cardiology, behavioral health, radiology).']
  approval_authority varchar [note: 'Name of the organizational body, committee, or individual who approved this consent policy (e.g., Institutional Review Board, Legal Department, Chief Medical Officer, Compliance Committee).']
  approval_date date [note: 'Date when the consent policy was formally approved by the designated approval authority.']
  behavioral_health_protected_flag boolean
  capacity_assessment_required_flag boolean [note: 'Indicates whether a formal capacity assessment is required before obtaining consent under this policy. True if capacity assessment is mandatory, False otherwise.']
  capacity_assessment_triggers varchar [note: 'Specific conditions or circumstances that trigger the requirement for a capacity assessment (e.g., cognitive impairment, altered mental status, high-risk procedure). Multiple triggers separated by semicolons.']
  consent_category varchar [note: 'Primary category of consent governed by this policy: treatment consent, research consent, data sharing authorization, HIPAA authorization, Health Information Exchange (HIE) opt-in/opt-out, or telehealth consent.']
  consent_status varchar
  consent_subcategory varchar [note: 'Specific subcategory or type within the primary consent category, providing additional classification granularity (e.g., surgical consent, clinical trial consent, genetic data sharing).']
  created_timestamp timestamp [note: 'Timestamp when this consent policy record was first created in the system.']
  documentation_requirements varchar [note: 'Detailed description of documentation requirements for consent obtained under this policy, including required forms, signatures, attestations, and supporting materials.']
  effective_date date [note: 'Date when the consent policy becomes active and enforceable across the organization.']
  electronic_signature_enabled_flag boolean [note: 'Indicates whether electronic signatures are permitted for consent obtained under this policy. True if electronic signatures are allowed, False if only wet signatures are accepted.']
  expiration_date date [note: 'Date when the consent policy expires and is no longer valid. Null for policies without a defined end date.']
  interpreter_required_flag boolean [note: 'Indicates whether a qualified interpreter must be provided when the patient\'s primary language differs from the consent form language. True if interpreter is mandatory, False otherwise.']
  irb_approval_date date [note: 'Date when the IRB approved this research consent policy. Null for non-research consent policies.']
  irb_approval_number varchar [note: 'IRB approval number for research consent policies. Null for non-research consent policies.']
  irb_expiration_date date [note: 'Date when the IRB approval for this research consent policy expires and requires renewal. Null for non-research consent policies.']
  last_modified_timestamp timestamp
  last_updated_timestamp timestamp [note: 'Timestamp when this consent policy record was last modified.']
  legal_representative_allowed_flag boolean [note: 'Indicates whether a legally authorized representative (LAR) may provide consent on behalf of the patient under this policy. True if LAR consent is permitted, False otherwise.']
  minimum_age_requirement varchar [note: 'Minimum age (in years) at which an individual can provide independent consent under this policy without parental or guardian authorization. Null if no age restriction applies.']
  minor_assent_required_flag boolean [note: 'Indicates whether assent from a minor patient is required in addition to parental consent under this policy. True if minor assent is mandatory, False otherwise.']
  modified_timestamp timestamp
  policy_code varchar [note: 'Unique business identifier code for the consent policy, used for external reference and system integration.']
  policy_description varchar [note: 'Detailed description of the consent policy purpose, scope, and business context.']
  policy_name varchar [note: 'Human-readable name of the consent policy, used in user interfaces and documentation.']
  policy_status varchar [note: 'Current lifecycle status of the consent policy: draft (under development), active (in use), suspended (temporarily inactive), retired (no longer used), or superseded (replaced by newer policy).']
  policy_type varchar
  reconsent_interval_months varchar [note: 'Number of months after which consent must be renewed if time-based re-consent is required. Null if time-based re-consent does not apply.']
  reconsent_trigger_new_risk boolean [note: 'Indicates whether the discovery of significant new risks triggers the requirement for re-consent under this policy. True if new risk requires re-consent, False otherwise.']
  reconsent_trigger_protocol_amendment boolean [note: 'Indicates whether a protocol amendment triggers the requirement for re-consent under this policy (primarily applicable to research consent). True if protocol amendment requires re-consent, False otherwise.']
  reconsent_trigger_time_based boolean [note: 'Indicates whether consent expires after a defined time period and requires renewal under this policy. True if time-based re-consent is required, False otherwise.']
  record_number varchar
  regulatory_basis varchar [note: 'Primary regulatory framework or legal requirement that mandates or governs this consent policy (e.g., HIPAA Privacy Rule, FDA 21 CFR Part 50, state-specific consent laws).']
  regulatory_citations varchar [note: 'Specific regulatory citations, statutes, or code sections that apply to this consent policy (e.g., 45 CFR 164.508, 21 CFR 50.25). Multiple citations separated by semicolons.']
  required_consent_elements varchar [note: 'Comma-separated list of mandatory elements that must be included in consent documentation governed by this policy (e.g., purpose, risks, benefits, alternatives, right to refuse, right to revoke).']
  retention_period_years varchar [note: 'Number of years that consent documentation governed by this policy must be retained to meet regulatory and legal requirements.']
  revocation_allowed_flag boolean [note: 'Indicates whether patients have the right to revoke consent obtained under this policy. True if revocation is permitted, False otherwise.']
  revocation_instructions varchar [note: 'Instructions and procedures that patients must follow to revoke consent obtained under this policy, including contact information and required documentation.']
  version_number varchar [note: 'Version identifier for the consent policy, following semantic versioning convention (e.g., 1.0, 2.1, 3.0.1).']
  vibe_mutation_added varchar [note: 'Added by VIBE mutation to satisfy target entity touch requirement']
  vibe_mutation_marker varchar [note: 'Generic mutation marker']
  vibe_structure_marker varchar [note: 'structure enforcement marker']
  witness_required_flag boolean [note: 'Indicates whether a witness signature is required for consent obtained under this policy. True if witness is mandatory, False otherwise.']

  Note: 'Reference master defining the organization\'s enterprise consent policies, rules, and requirements governing each consent type. Captures policy name, consent category governed, required consent elements, minimum age for independent consent, capacity assessment triggers, re-consent triggers (protocol amendment, significant new risk, time-based expiration), documentation requirements, and applicable regulatory citations. Drives consent workflow configuration and ensures consistent consent practice across all care settings and facilities.'
}

Table consent.deficiency {
  deficiency_id varchar [pk, note: 'Primary key']
  care_site_id varchar
  mpi_record_id varchar [note: 'FK to patient']
  visit_id varchar [note: 'FK to encounter']
  consent_status varchar
  created_timestamp timestamp [note: 'Record creation timestamp']
  deficiency_description varchar [note: 'Description of deficiency']
  deficiency_status varchar
  deficiency_type varchar [note: 'Type of consent deficiency']
  due_date date [note: 'Resolution due date']
  effective_date date
  escalation_flag boolean [note: 'Escalation required']
  expiration_date date
  identified_by varchar [note: 'Who identified deficiency']
  identified_date date [note: 'Date deficiency identified']
  last_modified_timestamp timestamp
  priority_level varchar [note: 'Priority level']
  record_number varchar [note: 'FK to consent record']
  resolution_date date [note: 'Date resolved']
  resolution_notes varchar [note: 'Resolution notes']
  resolution_status varchar [note: 'Current resolution status']
  resolved_by varchar [note: 'Who resolved deficiency']
  resolved_date date
  updated_timestamp timestamp [note: 'Last update timestamp']
  vibe_structure_marker varchar [note: 'structure enforcement marker']

  Note: 'Transactional record of identified consent deficiencies — instances where required consent was not obtained, was improperly documented, expired, or is otherwise incomplete at the time of care delivery or audit. Captures deficiency type, discovery method (pre-procedure checklist, HIM audit, accreditation survey, patient complaint), responsible provider or department, deficiency status (open, remediated, waived), remediation action taken, and resolution date. Supports HIM, compliance, and quality improvement workflows for consent management.'
}

Table consent.substance_use_consent {
  substance_use_consent_id varchar [pk, note: 'Primary key']
  care_site_id varchar [note: 'Treatment facility']
  clinician_id varchar [note: 'Treating clinician']
  mpi_record_id varchar [note: 'FK to patient']
  part2_consent_id varchar
  part2_consent_workflow_part2_consent_id varchar
  authorized_recipients varchar [note: 'Authorized recipients']
  behavioral_health_protected_flag boolean
  cfr_42_part2_consent boolean [note: '42 CFR Part 2 consent']
  consent_status varchar [note: 'Current consent status']
  created_timestamp timestamp [note: 'Record creation timestamp']
  disclosure_purpose varchar [note: 'Purpose of disclosure']
  effective_date date [note: 'Consent effective date']
  expiration_condition varchar [note: 'Expiration condition']
  expiration_date date [note: 'Consent expiration date']
  information_to_disclose varchar [note: 'Information authorized']
  last_modified_timestamp timestamp
  part2_covered_flag boolean
  record_number varchar [note: 'FK to consent record']
  redisclosure_notice_provided boolean [note: 'Redisclosure notice given']
  revocation_date date [note: 'Date revoked']
  signed_date date
  updated_timestamp timestamp [note: 'Last update timestamp']
  vibe_structure_marker varchar [note: 'structure enforcement marker']

  Note: 'Specialized master record for consent and authorization governing disclosure of substance use disorder (SUD) treatment records, which carry heightened federal confidentiality protections beyond standard HIPAA. Captures consent elements required by 42 CFR Part 2 including specific program name, patient name, specific information to be disclosed, purpose of disclosure, recipient, expiration, and right to revoke. Tracks re-disclosure prohibition notices and patient-permitted disclosures for treatment, payment, and operations under the 2020 CARES Act amendments.'
}

Table consent.behavioral_health_consent {
  behavioral_health_consent_id varchar [pk, note: 'Primary key']
  care_site_id varchar [note: 'Treatment facility']
  clinician_id varchar [note: 'Treating clinician']
  mpi_record_id varchar [note: 'FK to patient']
  part2_consent_id varchar
  part2_consent_workflow_part2_consent_id varchar
  authorized_recipients varchar [note: 'Authorized recipients']
  behavioral_health_protected_flag boolean
  cfr_42_part2_applicable boolean [note: '42 CFR Part 2 applies']
  consent_scope varchar
  consent_status varchar [note: 'Current status']
  consent_type varchar [note: 'Type of BH consent']
  created_timestamp timestamp [note: 'Record creation timestamp']
  disclosure_purpose varchar [note: 'Purpose of disclosure']
  effective_date date [note: 'Consent effective date']
  expiration_date date [note: 'Consent expiration date']
  last_modified_timestamp timestamp
  mental_health_disclosure_authorized boolean [note: 'MH disclosure authorized']
  part2_applicable_flag boolean
  psychotherapy_notes_included boolean [note: 'Psychotherapy notes included']
  record_number varchar [note: 'FK to consent record']
  revocation_date date [note: 'Date revoked if applicable']
  signed_date date
  sud_disclosure_authorized boolean [note: 'SUD disclosure authorized']
  updated_timestamp timestamp [note: 'Last update timestamp']
  vibe_structure_marker varchar [note: 'structure enforcement marker']
  witness_name varchar [note: 'Witness name']

  Note: 'Specialized master record for consent governing disclosure of behavioral health, mental health, and psychiatric treatment records, which are subject to state-specific heightened confidentiality protections beyond standard HIPAA. Captures state law basis, specific mental health data elements covered (psychotherapy notes, psychiatric hospitalization, medication for mental illness), authorized recipients, purpose, expiration, and patient-imposed restrictions. Manages the complex intersection of HIPAA psychotherapy note protections and state mental health confidentiality statutes.'
}

Table consent.expiration_alert {
  expiration_alert_id varchar [pk, note: 'Primary key']
  care_site_id varchar
  mpi_record_id varchar [note: 'FK to patient']
  alert_date date
  alert_status varchar [note: 'Alert status']
  alert_trigger_date date [note: 'When alert was triggered']
  alert_type varchar [note: 'Type of expiration alert']
  consent_expiration_date date [note: 'Consent expiration date']
  consent_status varchar
  created_timestamp timestamp [note: 'Record creation timestamp']
  days_until_expiration varchar [note: 'Days until expiration']
  effective_date date
  expiration_date date
  last_modified_timestamp timestamp
  notification_method varchar [note: 'Method of notification']
  notification_sent_date date [note: 'Date notification sent']
  recipient_contact varchar [note: 'Recipient contact info']
  recipient_type varchar [note: 'Type of recipient']
  record_number varchar [note: 'FK to consent record']
  renewal_date date [note: 'Date renewed']
  renewal_initiated boolean [note: 'Renewal process started']
  updated_timestamp timestamp [note: 'Last update timestamp']
  vibe_structure_marker varchar [note: 'structure enforcement marker']

  Note: 'Operational record tracking consent records approaching or past their expiration date that require patient re-consent or renewal action. Captures consent reference, expiration date, alert generation date, alert type (approaching expiration, expired, renewal required), notification channel used (patient portal, staff worklist, EHR alert), responsible staff member, and resolution status. Drives proactive consent renewal workflows to prevent care delays and compliance gaps from expired consents.'
}

Table consent.genetic_testing_consent {
  genetic_testing_consent_id varchar [pk, note: 'Primary key']
  care_site_id varchar
  clinician_id varchar [note: 'Ordering clinician']
  mpi_record_id varchar [note: 'FK to patient']
  biobank_storage_authorized boolean [note: 'Biobank storage authorized']
  consent_date date [note: 'Date consent obtained']
  consent_status varchar [note: 'Current consent status']
  counseling_date date [note: 'Date of genetic counseling']
  created_timestamp timestamp [note: 'Record creation timestamp']
  effective_date date
  expiration_date date
  family_disclosure_authorized boolean [note: 'Family disclosure authorized']
  genetic_counseling_completed boolean [note: 'Genetic counseling completed']
  gina_disclosure_acknowledged boolean [note: 'GINA disclosure acknowledged']
  incidental_findings_preference varchar [note: 'Incidental findings preference']
  last_modified_timestamp timestamp
  record_number varchar [note: 'FK to consent record']
  research_use_authorized boolean [note: 'Research use authorized']
  signed_date date
  test_purpose varchar [note: 'Purpose of testing']
  test_type varchar [note: 'Type of genetic test']
  updated_timestamp timestamp [note: 'Last update timestamp']
  vibe_structure_marker varchar [note: 'structure enforcement marker']

  Note: 'Specialized master record for informed consent governing genetic testing, genomic sequencing, and biobanking. Captures test type (diagnostic, predictive, carrier, pharmacogenomic, whole genome sequencing), scope of consent (specific test only, future research use, biobank storage, return of incidental findings), family member implications disclosure, insurance discrimination risk disclosure per GINA, data sharing permissions for research registries, and consent for re-contact as new findings emerge. Governed by GINA, state genetic privacy laws, and ACMG guidelines.'
}

Table consent.photography_media_consent {
  photography_media_consent_id varchar [pk, note: 'Primary key']
  care_site_id varchar
  clinician_id varchar
  mpi_record_id varchar [note: 'FK to patient']
  visit_id varchar [note: 'FK to encounter']
  capture_date date
  clinical_use_authorized boolean [note: 'Clinical use authorized']
  compensation_provided boolean [note: 'Compensation provided']
  consent_date date [note: 'Date consent obtained']
  consent_status varchar [note: 'Current consent status']
  created_timestamp timestamp [note: 'Record creation timestamp']
  education_use_authorized boolean
  educational_use_authorized boolean [note: 'Educational use authorized']
  effective_date date
  expiration_date date [note: 'Consent expiration date']
  identifiable_flag boolean [note: 'Patient identifiable in media']
  identity_disclosure_authorized boolean
  last_modified_timestamp timestamp
  marketing_use_authorized boolean [note: 'Marketing use authorized']
  media_type varchar [note: 'Type of media']
  photographer_name varchar
  publication_authorized varchar
  publication_use_authorized boolean [note: 'Publication use authorized']
  purpose varchar [note: 'Purpose of media capture']
  record_number varchar [note: 'FK to consent record']
  research_use_authorized boolean [note: 'Research use authorized']
  revocation_date date
  signed_date date
  social_media_authorized boolean
  updated_timestamp timestamp [note: 'Last update timestamp']
  usage_purpose varchar
  vibe_structure_marker varchar [note: 'structure enforcement marker']
  witness_name varchar

  Note: 'Master record for patient consent to photography, video recording, audio recording, and use of patient images or likeness for clinical, educational, marketing, or research purposes. Captures media type, intended use (clinical documentation, medical education, publication, marketing, social media), scope of consent (identifiable vs. de-identified), distribution channels authorized, expiration, and right to withdraw. Required by HIPAA for any use of patient images beyond direct treatment and by institutional policies governing patient privacy.'
}

Table consent.amendment_request {
  amendment_request_id varchar [pk, note: 'Primary key for amendment request']
  care_site_id varchar
  clinician_id varchar [note: 'Reviewing clinician']
  demographics_id varchar
  mpi_record_id varchar [note: 'FK to patient']
  visit_id varchar
  accepted_flag boolean
  amendment_status varchar
  amendment_type varchar
  consent_status varchar
  created_timestamp timestamp [note: 'Record creation timestamp']
  decision varchar [note: 'Approval decision']
  decision_date date
  decision_made_by varchar
  decision_rationale varchar
  decision_reason varchar [note: 'Reason for decision']
  effective_date date [note: 'When amendment takes effect']
  expiration_date date
  hipaa_amendment_flag boolean [note: 'HIPAA amendment indicator']
  last_modified_timestamp timestamp
  original_content varchar [note: 'Original consent content']
  proposed_content varchar [note: 'Proposed amended content']
  record_element_to_amend varchar
  record_number varchar [note: 'FK to consent record being amended']
  request_date date [note: 'Date amendment requested']
  request_number varchar
  request_reason varchar [note: 'Reason for amendment']
  request_status varchar
  request_type varchar [note: 'Type of amendment requested']
  requested_amendment_description varchar
  requested_by varchar
  requested_change varchar
  requested_change_description varchar
  review_date date [note: 'Date reviewed']
  review_status varchar [note: 'Status of review']
  updated_timestamp timestamp [note: 'Last update timestamp']
  vibe_structure_marker varchar [note: 'structure enforcement marker']

  Note: 'Transactional record of patient requests to amend their consent records or associated PHI documentation. Captures amendment request date, specific consent record targeted, nature of requested amendment, organization\'s decision (accepted, denied with reason), amendment effective date, and notification to third parties who received the original consent-based disclosure. Supports HIPAA right to amend under 45 CFR 164.526 and maintains the integrity of the consent audit trail.'
}

Table consent.consent_session {
  consent_session_id varchar [pk, note: 'Primary key']
  care_site_id varchar
  clinician_id varchar [note: 'Consenting clinician']
  form_template_id varchar
  mpi_record_id varchar [note: 'FK to patient']
  part2_consent_id varchar
  visit_id varchar [note: 'FK to encounter']
  behavioral_health_protected_flag boolean
  consent_status varchar
  created_timestamp timestamp [note: 'Record creation timestamp']
  device_type varchar
  education_provided varchar [note: 'Education materials provided']
  effective_date date
  expiration_date date
  interpreter_language varchar [note: 'Interpreter language']
  interpreter_used boolean [note: 'Interpreter was used']
  ip_address varchar
  language_code varchar
  last_modified_timestamp timestamp
  patient_understanding_confirmed boolean [note: 'Understanding confirmed']
  questions_asked varchar [note: 'Patient questions documented']
  record_number varchar [note: 'FK to consent record']
  session_channel varchar
  session_date timestamp
  session_end_timestamp timestamp [note: 'Session end time']
  session_mode varchar [note: 'In-person, telehealth, etc']
  session_outcome varchar [note: 'Outcome of session']
  session_start_timestamp timestamp [note: 'Session start time']
  session_status varchar
  session_type varchar [note: 'Type of consent session']
  signature_captured boolean
  updated_timestamp timestamp [note: 'Last update timestamp']
  vibe_structure_marker varchar [note: 'structure enforcement marker']
  witness_name varchar [note: 'Witness name']
  witness_present boolean [note: 'Witness was present']

  Note: 'Master reference table for consent_session. Referenced by session_id.'
}

Table interoperability.exchange_standard {
  exchange_standard_id varchar [pk, note: 'Unique identifier for the exchange standard record.']
  superseded_exchange_standard_id varchar [note: 'Reference to the prior version that this standard supersedes.']
  backward_compatibility boolean [note: 'Indicates if this version is backward compatible with prior versions.']
  certification_date date [note: 'Date the standard version was certified by the governing body.']
  certification_status varchar [note: 'Current certification status (Certified, Pending, Expired).']
  character_set varchar [note: 'Character encoding used (UTF-8, ASCII, ISO-8859-1).']
  conformance_profile varchar [note: 'Specific conformance profile or implementation guide (e.g., US Core, C-CDA 2.1).']
  contact_email varchar [note: 'Email address of the standard maintainer or contact person.']
  contact_person varchar [note: 'Name of the person responsible for the standard within the organization.']
  created_timestamp timestamp [note: 'Timestamp when the record was created.']
  documentation_url varchar [note: 'URL to the official documentation or specification.']
  effective_date date [note: 'Date when the standard version became effective.']
  encoding_format varchar [note: 'Message encoding format (XML, JSON, pipe-delimited).']
  end_date date [note: 'Date when the standard version was deprecated or retired.']
  exchange_standard_status varchar [note: 'Lifecycle status (Active, Deprecated, Retired).']
  governing_body varchar [note: 'Organization that governs the standard (HL7, NCPDP, X12).']
  hie_participation varchar [note: 'HIE networks that require or support this standard.']
  interface_engine_support varchar [note: 'Interface engines that support this standard version.']
  is_mandatory boolean [note: 'Indicates if the standard is mandatory for regulatory compliance.']
  message_types_supported varchar [note: 'Comma-separated list of message types (ADT, ORM, ORU, etc.).']
  migration_path varchar [note: 'Recommended migration path to newer versions.']
  modified_timestamp timestamp
  notes varchar [note: 'Additional notes or comments.']
  publication_date date [note: 'Date the standard version was officially published.']
  regulatory_requirement varchar [note: 'Regulatory programs that require this standard (ONC, CMS, Meaningful Use).']
  resource_types_supported varchar [note: 'FHIR resource types supported (Patient, Observation, Condition).']
  security_profile varchar [note: 'Security profile or authentication method (SMART on FHIR, OAuth 2.0).']
  specification_url varchar [note: 'URL to the formal specification document.']
  standard_code varchar [note: 'Short code for the standard (HL7V2, FHIR, CDA, X12).']
  standard_name varchar [note: 'Full name of the standard (e.g., HL7 Version 2.5.1).']
  standard_type varchar [note: 'Type of standard (Messaging, Document, Terminology, Transport).']
  standard_version varchar [note: 'Version']
  terminology_binding varchar [note: 'Required terminology bindings (SNOMED CT, LOINC, RxNorm).']
  testing_tool varchar [note: 'Recommended testing or validation tool.']
  transport_protocol varchar [note: 'Transport protocol (MLLP, HTTPS, SFTP, Direct).']
  updated_timestamp timestamp [note: 'Timestamp when the record was last updated.']
  use_case_description varchar [note: 'Description of primary use cases for this standard.']
  validation_rules varchar [note: 'Validation rules or schematron files.']
  version varchar [note: 'Version number of the standard (e.g., 2.5.1, R4, 2.1).']
  vibe_interop_domain_marker varchar [note: 'Marker attribute confirming interoperability domain product set.']
  vibe_mutation_added varchar [note: 'Added by VIBE mutation to satisfy target entity touch requirement']
  vibe_mutation_marker varchar [note: 'Marker added by VIBE mutator']
  vibe_structure_marker varchar [note: 'structure enforcement marker']

  Note: 'Registry of healthcare data exchange standards (HL7 v2, FHIR, CDA, X12) with version tracking, certification status, and conformance profiles.'
}

Table interoperability.trading_partner {
  trading_partner_id varchar [pk, note: 'Unique identifier for the trading partner.']
  interface_engine_id varchar [note: 'Interface engine used for connectivity.']
  org_provider_id varchar [note: 'Link to the provider organization if the partner is a provider.']
  parent_trading_partner_id varchar [note: 'Reference to the parent trading partner for hierarchical relationships.']
  active_flag boolean [note: 'Indicates if the trading partner relationship is currently active.']
  address_line_1 varchar [note: 'Street address line 1.']
  address_line_2 varchar [note: 'Street address line 2.']
  cda_endpoint_url varchar [note: 'URL for CDA document exchange.']
  certification_expiration_date date [note: 'Date when the partner\'s certification expires.']
  certification_status varchar [note: 'Certification status (Certified, Pending, Expired).']
  city varchar [note: 'City.']
  country_code varchar [note: 'ISO country code.']
  created_timestamp timestamp [note: 'Timestamp when the record was created.']
  data_sharing_agreement_reference varchar [note: 'Reference to the executed data sharing agreement.']
  data_transformation_mapping_reference varchar [note: 'Reference to the data transformation mapping document.']
  direct_address varchar [note: 'Direct messaging address.']
  effective_end_date date [note: 'Date when the trading partner relationship ended.']
  effective_start_date date [note: 'Date when the trading partner relationship began.']
  exchange_volume_last_30_days varchar [note: 'Number of messages exchanged in the last 30 days.']
  fhir_endpoint_url varchar [note: 'URL for FHIR API endpoint.']
  hie_network_name varchar [note: 'Name of the HIE network the partner participates in.']
  hie_participation_flag boolean [note: 'Indicates if the partner participates in an HIE.']
  hl7v2_endpoint_url varchar [note: 'URL or IP address for HL7 v2 messaging.']
  last_successful_exchange_timestamp timestamp [note: 'Timestamp of the last successful message exchange.']
  last_updated_timestamp timestamp [note: 'Timestamp when the record was last updated.']
  message_tracking_enabled_flag boolean [note: 'Indicates if message tracking is enabled for this partner.']
  modified_timestamp timestamp
  notes varchar [note: 'Additional notes or comments.']
  npi varchar [note: 'National Provider Identifier.']
  oid varchar [note: 'Object Identifier for the trading partner.']
  onboarding_status varchar [note: 'Current onboarding status (Planning, Testing, Live).']
  operational_contact_email varchar [note: 'Email address of the operational contact.']
  operational_contact_name varchar [note: 'Name of the operational contact.']
  operational_contact_phone varchar [note: 'Phone number of the operational contact.']
  partner_name varchar [note: 'Name of the trading partner organization.']
  partner_type varchar [note: 'Type of partner (HIE, Payer, Lab, Referring Provider, Pharmacy).']
  postal_code varchar [note: 'Postal code.']
  sla_response_time_hours decimal(5,2) [note: 'SLA response time in hours.']
  state_province varchar [note: 'State or province.']
  supported_standards varchar [note: 'Comma-separated list of supported standards.']
  technical_contact_email varchar [note: 'Email address of the technical contact.']
  technical_contact_name varchar [note: 'Name of the technical contact.']
  technical_contact_phone varchar [note: 'Phone number of the technical contact.']
  trading_partner_status varchar
  updated_timestamp timestamp
  vibe_interop_domain_marker varchar [note: 'Marker attribute confirming interoperability domain product set.']
  vibe_mutation_added varchar [note: 'Added by VIBE mutation to satisfy target entity touch requirement']
  vibe_mutation_marker varchar
  vibe_structure_marker varchar [note: 'structure enforcement marker']

  Note: 'Registry of external organizations that exchange data with the health system, including HIE participants, payers, labs, and referring providers.'
}

Table interoperability.interface_engine {
  interface_engine_id varchar [pk, note: 'Unique identifier for the interface engine.']
  care_site_id varchar [note: 'Care site where the engine is deployed.']
  replaced_interface_engine_id varchar [note: 'Reference to the engine that this engine replaced.']
  admin_url varchar [note: 'URL to the administrative console.']
  audit_logging_enabled boolean [note: 'Indicates if audit logging is enabled.']
  cloud_provider varchar [note: 'Cloud provider if hosted in the cloud (AWS, Azure, GCP).']
  created_timestamp timestamp [note: 'Timestamp when the record was created.']
  decommission_date date [note: 'Date when the engine was decommissioned.']
  deployment_environment varchar [note: 'Environment (Production, Test, Development).']
  disaster_recovery_enabled boolean [note: 'Indicates if disaster recovery is enabled.']
  encryption_enabled boolean [note: 'Indicates if encryption is enabled.']
  engine_code varchar [note: 'Short code for the engine.']
  engine_name varchar [note: 'Name of the interface engine.']
  fhir_version_support varchar [note: 'FHIR versions supported (R4, STU3).']
  go_live_date date [note: 'Date when the engine went live.']
  high_availability_enabled boolean [note: 'Indicates if high availability is enabled.']
  hipaa_compliant boolean [note: 'Indicates if the engine is HIPAA compliant.']
  hitrust_certified boolean [note: 'Indicates if the engine is HITRUST certified.']
  hl7_version_support varchar [note: 'HL7 v2 versions supported (2.3, 2.5.1).']
  hosting_model varchar [note: 'Hosting model (On-Premise, Cloud, Hybrid).']
  installation_date date [note: 'Date when the engine was installed.']
  interface_engine_status varchar
  last_maintenance_date date [note: 'Date of the last maintenance activity.']
  last_updated_timestamp timestamp [note: 'Timestamp when the record was last updated.']
  license_expiration_date date [note: 'Date when the license expires.']
  license_type varchar [note: 'Type of license (Perpetual, Subscription).']
  max_concurrent_connections varchar [note: 'Maximum number of concurrent connections.']
  message_throughput_capacity varchar [note: 'Maximum message throughput per hour.']
  modified_timestamp timestamp
  next_scheduled_maintenance_date date [note: 'Date of the next scheduled maintenance.']
  notes varchar [note: 'Additional notes or comments.']
  operational_status varchar [note: 'Current operational status (Active, Inactive, Maintenance).']
  primary_contact_email varchar [note: 'Email address of the primary contact.']
  primary_contact_name varchar [note: 'Name of the primary contact.']
  primary_contact_phone varchar [note: 'Phone number of the primary contact.']
  primary_hostname varchar [note: 'Primary hostname or FQDN.']
  primary_ip_address varchar [note: 'Primary IP address.']
  product_name varchar [note: 'Product name (Rhapsody, Mirth, Cloverleaf, Ensemble).']
  responsible_team varchar [note: 'Team responsible for the engine.']
  support_contract_expiration_date date [note: 'Date when the support contract expires.']
  support_contract_status varchar [note: 'Status of the support contract (Active, Expired).']
  supported_protocols varchar [note: 'Comma-separated list of supported protocols (MLLP, HTTPS, SFTP).']
  updated_timestamp timestamp
  vendor_name varchar [note: 'Vendor name.']
  version varchar [note: 'Version number of the engine.']
  vibe_interop_domain_marker varchar [note: 'Marker attribute confirming interoperability domain product set.']
  vibe_mutation_added varchar [note: 'Added by VIBE mutation to satisfy target entity touch requirement']
  vibe_mutation_marker varchar [note: 'Marker added by VIBE mutator']
  vibe_structure_marker varchar [note: 'structure enforcement marker']

  Note: 'Registry of interface engines (middleware platforms) that route, transform, and monitor healthcare data exchanges.'
}

Table interoperability.interface_channel {
  interface_channel_id varchar [pk, note: 'Unique identifier for the interface channel configuration. Primary key for the interface channel master record.']
  exchange_standard_id varchar [note: 'Foreign key linking to interoperability.exchange_standard. Business justification: Interface channels implement specific exchange standards (HL7v2, FHIR, CDA, X12, etc.). Currently this is captured as STRING columns message_standard and message_version. Adding exchange_standard_id F']
  interface_engine_id varchar [note: 'FK to interface engine']
  replaced_interface_channel_id varchar [note: 'Self-referencing FK on interface_channel (replaced_interface_channel_id)']
  acknowledgment_required boolean [note: 'Indicates whether the interface channel requires acknowledgment messages (ACK/NACK) from the receiving system to confirm successful message receipt and processing per HL7 protocol.']
  acknowledgment_timeout_seconds varchar [note: 'Maximum time in seconds the interface engine will wait for an acknowledgment message before treating the transmission as failed.']
  audit_logging_enabled boolean [note: 'Indicates whether detailed audit logging is enabled for all messages transmitted through this channel to support HIPAA compliance, troubleshooting, and security monitoring.']
  authentication_method varchar [note: 'Security authentication mechanism used to verify identity when establishing connection through this interface channel.']
  business_owner_name varchar [note: 'Name of the business stakeholder or department responsible for the functional requirements and operational oversight of this interface channel.']
  channel_code varchar [note: 'Unique business identifier or code for the interface channel, often used in operational monitoring and troubleshooting.']
  channel_name varchar [note: 'Human-readable name assigned to this interface channel for identification and management purposes within the interface engine.']
  channel_status varchar [note: 'Current operational status of the interface channel indicating whether it is actively processing messages, temporarily disabled, under testing, or in an error state.']
  channel_type varchar [note: 'Directional classification of the interface channel indicating whether it receives data (inbound), sends data (outbound), or supports both directions (bidirectional).']
  connection_host varchar [note: 'Network host address (IP address or hostname) used to establish connection with the remote system for message transmission.']
  connection_port varchar [note: 'Network port number used for establishing connection with the remote system. Standard MLLP ports are typically in the range 5000-6000.']
  created_timestamp timestamp [note: 'Timestamp when this interface channel record was first created in the system.']
  decommission_date date [note: 'Date when this interface channel was or is planned to be deactivated and removed from production service.']
  destination_facility_identifier varchar [note: 'Identifier of the destination facility or organization receiving messages, often corresponding to the MSH-6 receiving facility field in HL7v2 messages.']
  destination_system_identifier varchar [note: 'Technical identifier or code for the destination system as configured in the interface engine, often corresponding to the MSH-5 receiving application field in HL7v2 messages.']
  destination_system_name varchar [note: 'Name of the receiving system or application that consumes messages from this interface channel (e.g., laboratory information system, radiology information system, health information exchange).']
  encryption_enabled boolean [note: 'Indicates whether data transmitted through this interface channel is encrypted in transit to protect Protected Health Information (PHI) per HIPAA requirements.']
  encryption_protocol varchar [note: 'Specific encryption protocol or cipher suite used for securing data transmission (e.g., TLS 1.2, TLS 1.3, AES-256).']
  go_live_date date [note: 'Date when this interface channel was first activated and began processing production messages.']
  hie_network_name varchar [note: 'Name of the Health Information Exchange network or community this channel connects to (e.g., state HIE, CommonWell, Carequality).']
  hie_participant_flag boolean [note: 'Indicates whether this interface channel is used for participation in a regional or national Health Information Exchange network for sharing patient data across organizations.']
  interface_channel_status varchar
  last_tested_date date [note: 'Most recent date when this interface channel underwent testing or validation to ensure continued operational integrity.']
  max_message_size_kb varchar [note: 'Maximum allowed size in kilobytes for a single message transmitted through this channel. Large messages (e.g., CDA documents with embedded images) may require higher limits.']
  message_archival_days varchar [note: 'Number of days that transmitted messages are retained in the interface engine archive for audit, troubleshooting, and compliance purposes before purging.']
  message_encoding varchar [note: 'Data encoding format used for message serialization. ER7 (pipe-delimited) is standard for HL7v2, XML for CDA and some HL7v2, JSON for FHIR REST APIs.']
  message_event_type varchar [note: 'Specific message event or trigger type handled by this channel (e.g., ADT^A01 for patient admission, ORU^R01 for lab results, SIU^S12 for appointment notification). Defines the business transaction supported.']
  message_retry_count varchar [note: 'Number of automatic retry attempts the interface engine will make if message transmission fails before escalating to error handling.']
  modified_timestamp timestamp
  next_review_date date [note: 'Scheduled date for the next periodic review of this interface channel configuration, performance, and business requirements.']
  notes varchar [note: 'Free-text field for additional operational notes, special configuration details, known issues, or business context related to this interface channel.']
  phi_transmitted_flag boolean [note: 'Indicates whether this interface channel transmits Protected Health Information subject to HIPAA privacy and security regulations, requiring enhanced monitoring and audit controls.']
  retry_interval_seconds varchar [note: 'Time interval in seconds between automatic retry attempts for failed message transmissions.']
  sla_tier varchar [note: 'Priority tier assigned to this interface channel defining expected uptime, response time, and support escalation procedures. Critical tier for life-safety interfaces (e.g., ED admissions), standard for routine reporting.']
  sla_uptime_target_percent decimal(5,2) [note: 'Target uptime percentage defined in the service level agreement for this interface channel (e.g., 99.9% for critical interfaces, 99.0% for standard).']
  source_facility_identifier varchar [note: 'Identifier of the source facility or organization sending messages, often corresponding to the MSH-4 sending facility field in HL7v2 messages.']
  source_system_identifier varchar [note: 'Technical identifier or code for the source system as configured in the interface engine, often corresponding to the MSH-3 sending application field in HL7v2 messages.']
  source_system_name varchar [note: 'Name of the originating system or application that sends messages through this interface channel (e.g., Epic EHR, Cerner Millennium, MEDITECH, PACS).']
  support_contact_email varchar [note: 'Primary email address for technical support escalation and incident notification related to this interface channel.']
  support_contact_phone varchar [note: 'Primary phone number for technical support escalation and incident notification related to this interface channel.']
  technical_owner_name varchar [note: 'Name of the technical team or individual responsible for configuration, maintenance, and troubleshooting of this interface channel.']
  transformation_map_name varchar [note: 'Name of the data transformation or mapping configuration applied to messages passing through this channel to convert between different formats, vocabularies, or data structures.']
  transport_protocol varchar [note: 'Network transport protocol used by the interface channel to transmit messages between source and destination systems. MLLP (Minimal Lower Layer Protocol) is standard for HL7v2, while HTTP/HTTPS/REST are common for FHIR. [ENUM-REF-CANDIDATE: MLLP|HTTP|HTTPS|SFTP|FTP|SOAP|REST|TCP|DICOM — 9 candidates stripped; promote to reference product]']
  updated_timestamp timestamp [note: 'Timestamp when this interface channel record was last modified.']
  vibe_interop_domain_marker varchar [note: 'Marker attribute confirming interoperability domain product set.']
  vibe_mutation_added varchar [note: 'Added by VIBE mutation to satisfy target entity touch requirement']
  vibe_mutation_marker varchar [note: 'Marker added by VIBE mutator']
  vibe_structure_marker varchar [note: 'structure enforcement marker']

  Note: 'Master record for every configured interface channel (connection) within an interface engine, representing a discrete data flow between a source system and a destination system. Captures channel name, channel type (inbound/outbound/bidirectional), transport protocol (MLLP, HTTP/S, SFTP, SOAP, REST), source system, destination system, message standard, message event type, encoding (ER7/XML/JSON), channel status (active/inactive/testing), and SLA tier. Each channel is the atomic unit of interface management.'
}

Table interoperability.message_log {
  message_log_id varchar [pk, note: 'Unique identifier for each healthcare message transaction processed through the interface engine. Primary key for the message log.']
  interface_channel_id varchar [note: 'Foreign key linking to interoperability.interface_channel. Business justification: Message logs must link to the interface channel that processed them. Currently only interface_name (STRING) exists. FK to interface_channel enables proper channel tracking, monitoring channel-specific']
  mapping_rule_id varchar [note: 'Identifier of the transformation rule set or mapping configuration applied to this message. Used for transformation audit trails and troubleshooting data mapping issues.']
  mpi_record_id varchar [note: 'Foreign key linking to patient.mpi_record. Business justification: HL7 ADT and clinical messages reference patient identity for routing, processing, and reconciliation. Message audit trails require authoritative patient linkage for safety investigations, duplicate me']
  original_message_log_id varchar [note: 'Reference to the message_log_id of the original message if this is a duplicate or retry. Used for linking duplicate messages and retry attempts back to the original transaction for audit trail completeness.']
  primary_message_care_site_id varchar [note: 'Identifier of the healthcare facility or system that originated and sent the message. Corresponds to MSH-4 in HL7 v2.x. Used for routing and source system identification.']
  receiving_facility_care_site_id varchar [note: 'Identifier of the healthcare facility or system that is the intended recipient of the message. Corresponds to MSH-6 in HL7 v2.x. Used for routing and destination system identification.']
  visit_id varchar [note: 'The unique identifier for the patient encounter or visit associated with this message, extracted from PV1-19 in HL7 v2.x ADT messages. Used for encounter-level message correlation and clinical workflow tracking.']
  ack_code varchar [note: 'The acknowledgment code returned by the receiving system indicating message acceptance status. AA=Application Accept, AE=Application Error, AR=Application Reject, CA=Commit Accept, CE=Commit Error, CR=Commit Reject. Corresponds to MSA-1 in HL7 v2.x ACK messages.']
  ack_timestamp timestamp [note: 'The date and time when the acknowledgment (ACK) message was received from the destination system. Used for round-trip latency measurement and SLA compliance verification.']
  business_event_type varchar [note: 'High-level business event classification derived from the message type (e.g., Patient Admission, Lab Result, Medication Order, Appointment Scheduling, Charge Posting). Used for business-level reporting and analytics independent of technical message type codes.']
  created_timestamp timestamp [note: 'The date and time when this message log record was first created in the data warehouse. Used for data lineage tracking and audit trail purposes.']
  destination_ip_address varchar [note: 'IP address of the receiving system that accepted the message. Used for routing verification, network troubleshooting, and security audit trails.']
  duplicate_check_performed boolean [note: 'Indicates whether the interface engine performed duplicate message detection based on message_control_id or other unique identifiers. True if duplicate check was performed, False otherwise. Used for idempotency verification.']
  encryption_applied boolean [note: 'Indicates whether the message was encrypted during transmission (e.g., TLS/SSL for transport encryption, message-level encryption). True if encryption was applied, False otherwise. Critical for HIPAA Security Rule compliance verification.']
  error_code varchar [note: 'Standardized error code assigned when message processing fails. May correspond to HL7 v2.x error codes (ERR segment) or interface engine-specific error classification codes. Used for error categorization and root cause analysis.']
  error_description varchar [note: 'Detailed human-readable description of the error or rejection reason. Includes validation failures, parsing errors, business rule violations, or system connectivity issues. Critical for troubleshooting and resolution.']
  error_severity varchar [note: 'Severity classification of the error or issue encountered during message processing. Information=informational only, Warning=non-blocking issue, Error=processing failed but recoverable, Fatal=unrecoverable failure requiring manual intervention.']
  hie_transaction_code varchar [note: 'Unique transaction identifier assigned by the Health Information Exchange when the message is part of an HIE data exchange. Used for cross-organizational message tracking and HIE audit compliance.']
  is_duplicate boolean [note: 'Indicates whether this message was identified as a duplicate of a previously processed message. True if duplicate detected, False otherwise. Duplicate messages may be rejected or logged depending on interface configuration.']
  message_control_number varchar [note: 'Unique message control identifier assigned by the sending system, corresponding to MSH-10 segment in HL7 v2.x messages. Used for message tracking and acknowledgment correlation.']
  message_log_status varchar
  message_priority varchar [note: 'Priority level assigned to the message for processing queue management. STAT=immediate life-threatening, ASAP=as soon as possible, Urgent=expedited processing, Routine=normal processing. May be derived from ORC-7 or OBR-5 in HL7 v2.x order messages.']
  message_sequence_number varchar [note: 'Sequential number assigned by the interface engine for message ordering and gap detection. Used to identify missing messages in a sequence and ensure proper message ordering for dependent transactions.']
  message_standard varchar [note: 'The interoperability standard protocol used for the message transmission (HL7v2 for traditional interface messages, FHIR for modern RESTful API exchanges, CDA for clinical document architecture, X12 for claims and eligibility, NCPDP for pharmacy transactions, DICOM for imaging).']
  message_status varchar
  message_timestamp timestamp [note: 'The date and time when the message was originally created by the sending system. Corresponds to MSH-7 in HL7 v2.x. This is the business event timestamp, distinct from processing timestamps.']
  message_type varchar [note: 'The type and trigger event of the healthcare message in standard format (e.g., ADT^A01 for patient admission, ORU^R01 for observation result, DFT^P03 for charge posting, SIU^S12 for appointment notification). Corresponds to MSH-9 in HL7 v2.x.']
  message_version varchar [note: 'Version of the messaging standard used (e.g., 2.3, 2.5.1, 2.7 for HL7 v2.x; R4, STU3 for FHIR; Release 2 for CDA). Corresponds to MSH-12 in HL7 v2.x.']
  modified_timestamp timestamp
  patient_mrn varchar [note: 'The Medical Record Number of the patient referenced in the message, extracted from PID-3 in HL7 v2.x messages. Used for patient-centric message tracking and audit trails. Protected Health Information (PHI) under HIPAA.']
  payload_size_bytes varchar [note: 'Size of the message payload in bytes. Used for capacity planning, bandwidth analysis, and identifying unusually large messages that may impact performance.']
  phi_present boolean [note: 'Indicates whether the message contains Protected Health Information as defined by HIPAA Privacy Rule. True if PHI is present, False otherwise. Used for security classification, audit logging, and breach notification workflows.']
  processing_end_timestamp timestamp [note: 'The date and time when the interface engine completed processing the message (successfully or with error). Used for latency calculation and throughput analysis.']
  processing_latency_ms varchar [note: 'Total time in milliseconds from message receipt to processing completion. Calculated as the difference between processing_end_timestamp and received_timestamp. Key metric for SLA monitoring and performance optimization.']
  processing_start_timestamp timestamp [note: 'The date and time when the interface engine began processing the message (parsing, validation, transformation). Used for performance monitoring and bottleneck identification.']
  processing_status varchar [note: 'Current processing state of the message in the interface engine workflow. Tracks the message lifecycle from receipt through final disposition. Critical for operational monitoring and error investigation. [ENUM-REF-CANDIDATE: received|processing|processed|acknowledged|errored|rejected|retrying|failed — 8 candidates stripped; promote to reference product]']
  received_timestamp timestamp [note: 'The date and time when the message was received by the interface engine infrastructure. Used for latency calculation and SLA monitoring.']
  receiving_application varchar [note: 'Name or identifier of the destination application system that should receive and process the message. Corresponds to MSH-5 in HL7 v2.x.']
  retry_count varchar [note: 'Number of times the interface engine has attempted to reprocess this message after initial failure. Used for identifying chronic failures and triggering escalation workflows.']
  sending_application varchar [note: 'Name or identifier of the source application system that generated the message (e.g., Epic, Cerner, MEDITECH module name). Corresponds to MSH-3 in HL7 v2.x.']
  sla_met boolean [note: 'Indicates whether the message processing met the defined SLA threshold. True if processing_latency_ms is less than or equal to sla_threshold_ms, False otherwise. Key metric for operational performance reporting and vendor accountability.']
  sla_threshold_ms varchar [note: 'The maximum allowed processing latency in milliseconds for this message type as defined by the interface SLA. Used for automated SLA compliance monitoring and alerting when processing_latency_ms exceeds this threshold.']
  source_ip_address varchar [note: 'IP address of the sending system that transmitted the message. Used for security auditing, network troubleshooting, and access control verification.']
  transformation_applied boolean [note: 'Indicates whether data transformation or mapping rules were applied to the message during processing (e.g., code set translation, field mapping, data enrichment). True if transformations were applied, False if message was passed through unchanged.']
  transport_protocol varchar [note: 'The network transport protocol used to transmit the message. MLLP=Minimal Lower Layer Protocol (standard for HL7 v2.x), HTTP/HTTPS for FHIR REST APIs, SFTP/FTP for batch file transfers, SOAP for legacy web services. [ENUM-REF-CANDIDATE: MLLP|HTTP|HTTPS|SFTP|FTP|REST|SOAP — 7 candidates stripped; promote to reference product]']
  updated_timestamp timestamp [note: 'The date and time when this message log record was last modified in the data warehouse. Updated when message status changes (e.g., from processing to processed, or when retry attempts occur).']
  validation_errors varchar [note: 'Detailed list of validation errors or warnings encountered during message validation. Includes schema violations, missing required fields, invalid code values, and business rule failures. Used for data quality monitoring and sender feedback.']
  validation_status varchar [note: 'Result of message validation against the applicable standard schema and business rules. Passed=all validations successful, Failed=validation errors prevent processing, Warning=non-critical validation issues, Not_Validated=validation was skipped.']
  vibe_interop_domain_marker varchar [note: 'Marker attribute confirming interoperability domain product set.']
  vibe_mutation_added varchar [note: 'Added by VIBE mutation to satisfy target entity touch requirement']
  vibe_mutation_marker varchar
  vibe_structure_marker varchar [note: 'structure enforcement marker']

  Note: 'Transactional log of every healthcare message processed through the interface engine infrastructure. Captures message control ID, message type (ADT^A01, ORU^R01, etc.), sending facility, receiving facility, message timestamp, processing status (received/processed/acknowledged/errored/rejected), ACK code, error description, payload size, and processing latency. Serves as the operational audit trail for all HL7v2, FHIR, CDA, and X12 message traffic. Critical for SLA monitoring, error investigation, and compliance.'
}

Table interoperability.message_error {
  message_error_id varchar [pk, note: 'Unique identifier for the message error record. Primary key.']
  employee_id varchar [note: 'Reference to the interface analyst, support engineer, or team member assigned to investigate and resolve the error.']
  interface_channel_id varchar [note: 'Reference to the interface engine channel or route where the error occurred.']
  message_log_id varchar [note: 'Foreign key linking to interoperability.message_log. Business justification: Every message error is associated with a specific message log entry. Currently message_error uses message_control_id (STRING) to reference the message, but this is a weak reference. Adding message_log']
  mpi_record_id varchar [note: 'Foreign key linking to patient.mpi_record. Business justification: Interface error resolution workflows require patient context to assess clinical impact and prioritize remediation. Patient safety investigations trace errors to affected patients. message_error has pa']
  parent_message_error_id varchar [note: 'Self-referencing FK on message_error (related_message_error_id)']
  visit_id varchar [note: 'The encounter or visit identifier associated with the failed message, if applicable.']
  acknowledgment_code varchar [note: 'The HL7 acknowledgment code returned or expected: AA (Application Accept), AE (Application Error), AR (Application Reject), CA (Commit Accept), CE (Commit Error), CR (Commit Reject).']
  actual_resolution_minutes varchar [note: 'The actual time in minutes from error detection to resolution, used for SLA compliance tracking and performance measurement.']
  business_impact_description varchar [note: 'Description of the operational or clinical impact of the error, such as delayed lab results, missed patient admissions, billing delays, or care coordination disruptions.']
  created_timestamp timestamp [note: 'The timestamp when this error record was first created in the system.']
  error_category varchar [note: 'The high-level classification of the error type: parsing (message structure issues), validation (business rule violations), routing (destination resolution failures), transformation (mapping errors), delivery (transmission failures), authentication, authorization, timeout, or system errors. [ENUM-REF-CANDIDATE: parsing|validation|routing|transformation|delivery|authentication|authorization|timeout|system — 9 candidates stripped; promote to reference product]']
  error_code varchar [note: 'The system-generated error code or exception identifier assigned by the interface engine or application.']
  error_description varchar [note: 'Detailed human-readable description of the error, including technical details, affected segments or resources, and contextual information for troubleshooting.']
  error_severity varchar [note: 'The severity level of the error indicating business impact: critical (patient safety or operational halt), high (significant workflow disruption), medium (degraded functionality), low (minor issue), or informational (warning only).']
  error_stack_trace varchar [note: 'The technical stack trace or detailed exception log captured at the point of failure, used for root cause analysis and debugging.']
  error_timestamp timestamp [note: 'The precise date and time when the message processing error was detected by the interface engine.']
  error_type varchar
  escalation_flag boolean [note: 'Indicates whether the error was escalated to higher-level support, management, or vendor due to complexity, severity, or SLA breach.']
  escalation_timestamp timestamp [note: 'The date and time when the error was escalated for additional support or management attention.']
  field_position_error varchar [note: 'The specific field position or element path within the segment or resource where the error occurred (e.g., PID-5 for patient name, Patient.name.family).']
  interface_engine_version varchar [note: 'The version of the interface engine software (e.g., Rhapsody, Mirth Connect, Cloverleaf, Ensemble) that processed the message when the error occurred.']
  message_error_status varchar
  message_segment_error varchar [note: 'The specific HL7 segment (e.g., PID, OBR, DG1) or FHIR resource element path where the error was detected.']
  modified_timestamp timestamp [note: 'The timestamp when this error record was last updated, reflecting status changes, resolution updates, or additional investigation notes.']
  notification_sent_flag boolean [note: 'Indicates whether automated notifications (email, SMS, dashboard alert) were sent to stakeholders about this error.']
  patient_mrn varchar [note: 'The Medical Record Number of the patient associated with the failed message, if applicable and extractable from the message content.']
  raw_message_payload varchar [note: 'The complete raw message content (HL7 pipe-delimited text, FHIR JSON/XML, CDA document) that failed processing, stored for forensic analysis and replay. Contains Protected Health Information (PHI).']
  resolution_notes varchar [note: 'Detailed notes documenting the investigation, root cause findings, corrective actions taken, and resolution approach.']
  resolution_status varchar [note: 'The current status of error resolution workflow: new (unassigned), assigned (allocated to resolver), in_progress (actively being worked), resolved (fix applied), closed (verified and completed), reopened (recurred after resolution), or cancelled (no action needed). [ENUM-REF-CANDIDATE: new|assigned|in_progress|resolved|closed|reopened|cancelled — 7 candidates stripped; promote to reference product]']
  resolution_timestamp timestamp [note: 'The date and time when the error was marked as resolved or closed.']
  retry_count varchar [note: 'The number of automatic retry attempts made by the interface engine before the error was logged or escalated.']
  retry_eligible_flag boolean [note: 'Indicates whether the message is eligible for automatic or manual retry based on error type and business rules.']
  root_cause_category varchar [note: 'The classified root cause of the error: data_quality (source data issues), configuration (interface setup problems), mapping (transformation logic errors), network (connectivity failures), system_outage (application downtime), third_party (external system issues), user_error (manual process mistakes), or unknown (cause not determined). [ENUM-REF-CANDIDATE: data_quality|configuration|mapping|network|system_outage|third_party|user_error|unknown — 8 candidates stripped; promote to reference product]']
  sla_breach_flag boolean [note: 'Indicates whether the error resolution exceeded the defined SLA threshold for the interface channel or message type.']
  sla_target_resolution_minutes varchar [note: 'The target resolution time in minutes defined by the SLA for this error category and severity level.']
  updated_timestamp timestamp
  validation_rule_violated varchar [note: 'The specific business or technical validation rule that was violated, causing the error (e.g., required field missing, invalid code value, referential integrity failure).']
  vibe_interop_domain_marker varchar [note: 'Marker attribute confirming interoperability domain product set.']
  vibe_mutation_added varchar [note: 'Added by VIBE mutation to satisfy target entity touch requirement']
  vibe_mutation_marker varchar [note: 'Marker added by VIBE mutator']
  vibe_structure_marker varchar [note: 'structure enforcement marker']

  Note: 'Transactional record of every message processing error, rejection, or exception encountered during interface engine processing. Captures error timestamp, error code, error category (parsing/validation/routing/transformation/delivery), error description, affected message control ID, channel reference, error severity, resolution status, assigned resolver, resolution timestamp, and root cause classification. Enables systematic error management, SLA breach tracking, and interface reliability improvement.'
}

Table interoperability.fhir_endpoint {
  fhir_endpoint_id varchar [pk, note: 'Unique identifier for the FHIR API endpoint record. Primary key for the FHIR endpoint registry.']
  data_sharing_agreement_id varchar [note: 'Identifier of the legal data sharing agreement or Business Associate Agreement (BAA) governing data exchange through this endpoint. Links to compliance and legal documentation.']
  org_provider_id varchar [note: 'Identifier of the organization responsible for managing and maintaining this FHIR endpoint. Links to the organization master data.']
  superseded_fhir_endpoint_id varchar [note: 'Self-referencing FK on fhir_endpoint (superseded_fhir_endpoint_id)']
  trading_partner_id varchar [note: 'Foreign key linking to interoperability.trading_partner. Business justification: Many FHIR endpoints are partner-specific (payer APIs, HIE endpoints, provider directories). Link to trading_partner enables tracking which partner owns/operates each endpoint, managing partner-specifi']
  authentication_method varchar [note: 'The authentication and authorization mechanism required to access this FHIR endpoint (e.g., OAuth2, SMART on FHIR, API key, basic authentication, mutual TLS, or none for public endpoints).']
  average_response_time_ms varchar [note: 'Average response time in milliseconds for API requests to this endpoint over a defined measurement period. Used for performance monitoring and optimization.']
  bulk_data_export_support_flag boolean [note: 'Indicates whether this endpoint supports FHIR Bulk Data Access (Flat FHIR) for large-scale data export operations. True if bulk export is supported, False otherwise.']
  capability_statement_url varchar [note: 'URL to the FHIR CapabilityStatement resource that describes the functionality and supported operations of this endpoint. Typically accessed via [base_url]/metadata.']
  cms_compliance_flag boolean [note: 'Indicates whether this endpoint is compliant with CMS Interoperability and Patient Access Final Rule requirements (21st Century Cures Act). True if compliant, False otherwise.']
  connection_type varchar [note: 'The protocol or connection type used by this endpoint (e.g., HL7 FHIR REST, HL7 FHIR Messaging, Direct messaging, IHE XDS, HL7 v2, custom integration).']
  contact_email varchar [note: 'Email address of the technical contact for this endpoint. Used for notifications, alerts, and support communications.']
  contact_name varchar [note: 'Name of the technical contact person responsible for this endpoint. Used for operational support and issue resolution.']
  contact_phone varchar [note: 'Phone number of the technical contact for this endpoint. Used for urgent operational issues and escalations.']
  created_timestamp timestamp [note: 'Timestamp when this endpoint record was first created in the system. Used for audit trail and data lineage.']
  deprecation_date date [note: 'Date when this endpoint was marked as deprecated and scheduled for retirement. Used for migration planning and stakeholder communication.']
  documentation_url varchar [note: 'URL to the technical documentation, developer guide, or API reference for this FHIR endpoint. Used by developers and integration partners.']
  endpoint_name varchar [note: 'Human-readable name or label for the FHIR endpoint, used for identification and management purposes.']
  endpoint_type varchar [note: 'Classification of the FHIR endpoint based on its primary use case and audience (e.g., patient-facing SMART on FHIR apps, payer FHIR APIs for CMS Interoperability Rule, provider directory endpoints, internal FHIR server instances, HIE gateways).']
  endpoint_url varchar [note: 'The full URL of the FHIR API endpoint, including protocol, domain, and base path. This is the technical address where FHIR requests are sent.']
  environment varchar [note: 'The deployment environment of this FHIR endpoint (e.g., production, staging, testing, development, sandbox). Used to distinguish live endpoints from test environments.']
  fhir_endpoint_status varchar
  fhir_version varchar [note: 'The version of the FHIR specification that this endpoint implements (e.g., R4, STU3, DSTU2, R5).']
  hie_network_name varchar [note: 'Name of the Health Information Exchange network that this endpoint participates in, if applicable. Used for tracking HIE partnerships and data sharing agreements.']
  hie_participant_flag boolean [note: 'Indicates whether this endpoint participates in a Health Information Exchange network. True if the endpoint is registered with an HIE, False otherwise.']
  last_availability_check_timestamp timestamp [note: 'Timestamp of the most recent automated availability or health check performed on this endpoint. Used for monitoring and alerting.']
  last_availability_status varchar [note: 'Result of the most recent availability check (e.g., available, unavailable, degraded, timeout, error). Used for operational monitoring and incident response.']
  last_updated_timestamp timestamp [note: 'Timestamp when this endpoint record was last modified. Used for change tracking and audit purposes.']
  modified_timestamp timestamp
  notes varchar [note: 'Free-text field for additional notes, comments, or special instructions related to this FHIR endpoint. Used for operational context and knowledge transfer.']
  oauth_authorization_url varchar [note: 'The OAuth 2.0 authorization endpoint URL used for user authorization flows when authentication_method is OAuth2 or SMART on FHIR.']
  oauth_token_url varchar [note: 'The OAuth 2.0 token endpoint URL used for obtaining access tokens when authentication_method is OAuth2 or SMART on FHIR.']
  onc_certification_flag boolean [note: 'Indicates whether this endpoint is part of an ONC-certified Health IT Module under the 21st Century Cures Act certification criteria.']
  operational_status varchar [note: 'Current operational state of the FHIR endpoint. Active indicates the endpoint is live and available for production use. Testing indicates the endpoint is in a test or sandbox environment. Maintenance indicates temporary unavailability. Deprecated indicates the endpoint is scheduled for retirement. Retired indicates the endpoint is no longer available.']
  patient_access_api_flag boolean [note: 'Indicates whether this endpoint is designated as a Patient Access API under CMS Interoperability Rule requirements. True if it provides patient-facing access to health data, False otherwise.']
  payer_to_payer_api_flag boolean [note: 'Indicates whether this endpoint is designated as a Payer-to-Payer API under CMS Interoperability Rule requirements. True if it supports payer-to-payer data exchange, False otherwise.']
  provider_access_api_flag boolean [note: 'Indicates whether this endpoint is designated as a Provider Access API under CMS Interoperability Rule requirements. True if it provides provider-to-provider data exchange, False otherwise.']
  public_endpoint_flag boolean [note: 'Indicates whether this endpoint is publicly accessible without authentication (e.g., for provider directory lookups). True if public, False if authentication is required.']
  rate_limit_requests_per_day varchar [note: 'Maximum number of API requests allowed per day for this endpoint. Used for capacity planning and fair use enforcement.']
  rate_limit_requests_per_minute varchar [note: 'Maximum number of API requests allowed per minute for this endpoint. Used for throttling and capacity management.']
  registration_date date [note: 'Date when this FHIR endpoint was first registered in the organization\'s endpoint inventory. Used for tracking endpoint lifecycle and governance.']
  retirement_date date [note: 'Date when this endpoint was or will be retired and decommissioned. Used for lifecycle management and historical tracking.']
  security_certificate_expiry_date date [note: 'Expiration date of the SSL/TLS security certificate used by this endpoint. Critical for maintaining secure communications and avoiding service disruptions.']
  smart_app_launch_support_flag boolean [note: 'Indicates whether this endpoint supports the SMART App Launch Framework for third-party application integration. True if SMART launch is supported, False otherwise.']
  supported_resource_types varchar [note: 'Comma-separated list of FHIR resource types supported by this endpoint (e.g., Patient, Observation, Condition, MedicationRequest, Encounter, Coverage, ExplanationOfBenefit). Derived from the CapabilityStatement.']
  total_requests_last_30_days varchar [note: 'Total number of API requests received by this endpoint in the last 30 days. Used for usage analytics and capacity planning.']
  updated_timestamp timestamp
  uptime_percentage decimal(5,2) [note: 'Calculated uptime percentage for this endpoint over a defined measurement period (typically 30 days). Used for Service Level Agreement (SLA) tracking and performance reporting.']
  vibe_interop_domain_marker varchar [note: 'Marker attribute confirming interoperability domain product set.']
  vibe_mutation_added varchar [note: 'Added by VIBE mutation to satisfy target entity touch requirement']
  vibe_mutation_marker varchar [note: 'Marker added by VIBE mutator']
  vibe_structure_marker varchar [note: 'structure enforcement marker']

  Note: 'Master record for every FHIR API endpoint registered and managed by the organization, including patient-facing SMART on FHIR apps, payer FHIR APIs (CMS Interoperability Rule), provider directory endpoints, and internal FHIR server instances. Captures endpoint URL, FHIR version (R4/STU3), capability statement URL, supported resource types, authentication method (OAuth2/SMART/API key), rate limits, CMS compliance flag (21st Century Cures Act), and operational status. SSOT for FHIR API inventory.'
}

Table interoperability.fhir_resource_log {
  fhir_resource_log_id varchar [pk, note: 'Unique identifier for each FHIR resource operation log entry. Primary key for the FHIR resource log.']
  demographics_id varchar [note: 'The Medical Record Number (MRN) or FHIR Patient resource ID representing the patient whose data is the subject of the API operation. Empty for non-patient-specific operations (e.g., Practitioner lookup). Required for Protected Health Information (PHI) access auditing per HIPAA.']
  employee_id varchar [note: 'Identifier of the end user or practitioner who initiated the FHIR API request through the client application. May be a National Provider Identifier (NPI), employee ID, or patient portal user ID. Critical for HIPAA audit trail and access accountability.']
  fhir_endpoint_id varchar [note: 'Foreign key linking to interoperability.fhir_endpoint. Business justification: FHIR resource operations are executed against specific FHIR endpoints. Linking fhir_resource_log to fhir_endpoint enables tracking which endpoint served each request, monitoring endpoint-specific perf']
  parent_fhir_resource_log_id varchar [note: 'Self-referencing FK on fhir_resource_log (related_fhir_resource_log_id)']
  visit_id varchar [note: 'The FHIR Encounter resource ID representing the clinical encounter context in which the API operation occurred. Used to link API access to specific episodes of care for clinical workflow analysis.']
  access_decision varchar [note: 'The access control decision made by the authorization engine (granted, denied, conditional). Supports security audit and access policy effectiveness analysis.']
  authorization_scope varchar [note: 'The OAuth 2.0 scopes granted to the requesting client for this operation (e.g., patient/*.read, user/Observation.write). Defines the access permissions under which the operation was performed.']
  conformance_validation_result varchar [note: 'Indicates whether the FHIR resource in the request or response passed conformance validation against the applicable FHIR profile or implementation guide (passed, failed, not_validated). Supports data quality monitoring and interoperability compliance.']
  consent_policy_applied varchar [note: 'Identifier or reference to the patient consent policy that was evaluated and applied during this operation. Supports consent-based access control and HIPAA minimum necessary compliance.']
  created_timestamp timestamp [note: 'The date and time when this log record was created in the data warehouse. Used for data lineage and audit trail purposes.']
  cures_act_exception_flag boolean [note: 'Indicates whether this operation involved an exception to the information blocking prohibition under the 21st Century Cures Act (e.g., privacy exception, security exception). True if an exception was invoked, False otherwise.']
  data_segmentation_applied boolean [note: 'Indicates whether data segmentation for privacy (DS4P) was applied to filter sensitive data elements from the response based on patient consent or policy. True if segmentation occurred, False otherwise.']
  denial_reason varchar [note: 'The reason code or message explaining why access was denied or the operation failed. Used for troubleshooting and identifying access control issues.']
  exception_reason varchar [note: 'The specific exception category or reason code under the 21st Century Cures Act that justified restricting access or blocking information (e.g., privacy, security, infeasibility). Required when cures_act_exception_flag is True.']
  fhir_profile_url varchar [note: 'The canonical URL of the FHIR profile or implementation guide against which the resource was validated (e.g., US Core, IPS). Identifies the conformance standard applied.']
  fhir_resource_identifier varchar [note: 'The logical identifier of the specific FHIR resource instance being accessed (e.g., Patient/12345, Observation/67890). Empty for search or create operations that do not target a specific resource instance.']
  fhir_resource_log_status varchar
  fhir_resource_type varchar [note: 'The type of FHIR resource being accessed or manipulated (e.g., Patient, Observation, Condition, MedicationRequest). Defines the clinical or administrative entity subject to the operation. [ENUM-REF-CANDIDATE: Patient|Observation|Condition|MedicationRequest|Procedure|Encounter|AllergyIntolerance|DiagnosticReport|Immunization|CarePlan|DocumentReference|Practitioner|Organization|Location|Device|Appointment|ServiceRequest|Coverage|Claim|ExplanationOfBenefit|CareTeam|Goal|Medication|Substance|Specimen|Task|Communication|Consent|Provenance|AuditEvent|Bundle — promote to reference product]']
  fhir_version_code varchar [note: 'The version identifier of the FHIR resource instance accessed via vread or returned in response. Supports resource versioning and history tracking per FHIR specification.']
  hie_transaction_code varchar [note: 'Correlation identifier linking this FHIR operation to a broader Health Information Exchange (HIE) transaction or query. Used to trace data flows across organizational boundaries.']
  http_status_code varchar [note: 'The HTTP response status code returned by the FHIR server (e.g., 200 for success, 404 for not found, 401 for unauthorized, 500 for server error). Indicates the outcome of the API operation.']
  modified_timestamp timestamp [note: 'The date and time when this log record was last modified or updated in the data warehouse. Supports change tracking and data quality monitoring.']
  operation_outcome varchar [note: 'High-level categorization of the operation result (success, client_error, server_error, not_found, unauthorized, forbidden, validation_error). Derived from HTTP status code for simplified reporting and alerting. [ENUM-REF-CANDIDATE: success|client_error|server_error|not_found|unauthorized|forbidden|validation_error — 7 candidates stripped; promote to reference product]']
  operation_type varchar [note: 'The RESTful interaction type performed on the FHIR resource (read, vread, update, patch, delete, create, search-type, history-instance, history-type, or custom $operation). Aligns with FHIR RESTful API interaction definitions. [ENUM-REF-CANDIDATE: read|vread|update|patch|delete|create|search-type|history-instance|history-type|operation — 10 candidates stripped; promote to reference product]']
  request_body_size_bytes varchar [note: 'The size of the HTTP request body payload in bytes. Used for bandwidth monitoring and identifying large resource submissions.']
  request_method varchar [note: 'The HTTP method used for the FHIR API request (GET, POST, PUT, PATCH, DELETE). Indicates the type of RESTful operation performed.']
  request_timestamp timestamp [note: 'The date and time when the FHIR API request was received by the server. Represents the business event time for the operation and is used for audit trail and performance analysis.']
  request_url varchar [note: 'The full URL path of the FHIR API request, including query parameters for search operations. Captures the exact API endpoint and parameters used for detailed audit and debugging.']
  requesting_application_code varchar [note: 'Identifier of the client application or system that initiated the FHIR API request (e.g., mobile app, EHR module, third-party application). Used for access tracking and application-level analytics.']
  requesting_client_code varchar [note: 'OAuth 2.0 client identifier or API key associated with the requesting application. Supports authentication audit and client-level access control.']
  resource_type varchar
  response_body_size_bytes varchar [note: 'The size of the HTTP response body payload in bytes. Used for bandwidth monitoring and identifying large resource retrievals.']
  response_time_ms varchar [note: 'The elapsed time in milliseconds between request receipt and response transmission. Key performance indicator for FHIR API latency and service level agreement (SLA) monitoring.']
  response_timestamp timestamp [note: 'The date and time when the FHIR API response was sent back to the client. Used to calculate response time and monitor API performance.']
  search_parameters varchar [note: 'The query string parameters used in FHIR search operations (e.g., _id, _lastUpdated, patient, code). Captured for search pattern analysis and optimization.']
  search_result_count varchar [note: 'The number of FHIR resources returned in response to a search operation. Used to analyze search effectiveness and identify overly broad queries.']
  source_ip_address varchar [note: 'The IP address of the client that originated the FHIR API request. Used for security monitoring, access control, and geographic analysis. May be considered personally identifiable information (PII) in some jurisdictions.']
  updated_timestamp timestamp
  user_agent varchar [note: 'The HTTP User-Agent header value identifying the client software, operating system, and device type. Used for client compatibility analysis and troubleshooting.']
  validation_errors varchar [note: 'Detailed error messages or codes returned by the FHIR validator when conformance validation fails. Used for troubleshooting and data quality improvement.']
  vibe_interop_domain_marker varchar [note: 'Marker attribute confirming interoperability domain product set.']
  vibe_mutation_added varchar [note: 'Added by VIBE mutation to satisfy target entity touch requirement']
  vibe_mutation_marker varchar [note: 'Marker added by VIBE mutator']
  vibe_structure_marker varchar [note: 'structure enforcement marker']

  Note: 'Transactional log of every FHIR resource operation (read, search, create, update, delete, $operation) processed through FHIR API endpoints. Captures FHIR resource type (Patient, Observation, Condition, MedicationRequest, etc.), operation type, request timestamp, response HTTP status, FHIR resource ID, requesting application/client ID, patient context, response time, and conformance validation result. Supports 21st Century Cures Act audit requirements and FHIR API performance monitoring.'
}

Table interoperability.mapping_rule {
  mapping_rule_id varchar [pk, note: 'Unique identifier for the individual transformation rule within a data mapping definition. Primary key for the mapping rule record.']
  fallback_mapping_rule_id varchar [note: 'Self-referencing FK on mapping_rule (fallback_mapping_rule_id)']
  mapping_definition_id varchar [note: 'Reference to the parent mapping definition container that groups related transformation rules. Links this atomic rule to its parent mapping context.']
  source_crosswalk_id varchar [note: 'Foreign key linking to reference.crosswalk. Business justification: Interface transformation rules reference crosswalk tables for code-to-code mappings. Real-world: mapping rules execute crosswalk lookups during message transformation to translate between code systems']
  source_exchange_standard_id varchar [note: 'Foreign key linking to interoperability.exchange_standard. Business justification: Mapping rules transform data FROM a source exchange standard. Adding this FK provides authoritative linkage to the standard definition (HL7v2, FHIR, CDA, etc.) and enables validation that the source_e']
  approved_by varchar [note: 'Identifier of the user or authority who approved this transformation rule for production use. Supports governance and change control processes for interface engine configurations.']
  approved_timestamp timestamp [note: 'The date and time when this transformation rule was approved for production use. Supports governance and change control processes for interface engine configurations.']
  condition_expression varchar [note: 'Boolean expression or predicate that determines when this rule should be applied. If empty or null, the rule applies unconditionally. Supports conditional transformation logic.']
  created_timestamp timestamp [note: 'The date and time when this transformation rule record was first created in the system. Supports audit trail and change tracking for interface configurations.']
  data_type_conversion varchar [note: 'Specific instructions or function calls for converting the source data type to the target data type. May include format strings, parsing rules, or precision handling.']
  default_value decimal(18,2) [note: 'The value to assign to the target field when the source value is missing, null, or does not meet the condition expression. Supports fallback behavior in transformation logic.']
  effective_end_date date [note: 'The date when this transformation rule is no longer active and should not be applied. Nullable for rules with indefinite validity. Supports rule retirement and deprecation.']
  effective_start_date date [note: 'The date when this transformation rule becomes active and should be applied by the interface engine. Supports time-based rule activation for regulatory or business changes.']
  equivalence_type varchar [note: 'Describes the semantic relationship between the source and target concepts in terminology mapping. Follows HL7 FHIR ConceptMapEquivalence value set for interoperability standards. [ENUM-REF-CANDIDATE: equivalent|equal|wider|subsumes|narrower|specializes|inexact|unmatched|disjoint — 9 candidates stripped; promote to reference product]']
  error_handling_action varchar [note: 'Defines the action to take when this rule encounters an error during execution. Options: abort (stop processing), log (record error and continue), skip (ignore rule), retry (attempt again), default (use default_value).']
  is_mandatory boolean [note: 'Indicates whether this transformation rule must successfully execute for the overall mapping to be considered valid. If true, rule failure causes message rejection or error.']
  mapping_rule_status varchar
  modified_by varchar [note: 'Identifier of the user, system, or interface analyst who last modified this transformation rule. Used for accountability and audit trail in interface engine governance.']
  modified_timestamp timestamp [note: 'The date and time when this transformation rule record was last modified. Supports audit trail and change tracking for interface configurations.']
  notes varchar [note: 'Free-text field for additional comments, implementation notes, known issues, or special considerations related to this transformation rule. Supports knowledge transfer and maintenance.']
  null_handling_strategy varchar [note: 'Defines how the transformation engine should handle null or missing source values. Options: skip (do not write target), default (use default_value), error (raise exception), empty_string (write empty string), preserve_null (write null to target).']
  rule_description varchar [note: 'Detailed explanation of the transformation logic, business rationale, and expected behavior of this mapping rule. Documents the purpose and context for future maintenance.']
  rule_name varchar [note: 'Human-readable name or label for the transformation rule. Used for identification and documentation purposes in interface engine configurations.']
  rule_priority varchar [note: 'Priority level for rule execution when multiple rules could apply to the same source-target pair. Higher values indicate higher priority. Used for conflict resolution.']
  rule_sequence varchar [note: 'Ordinal position of this transformation rule within the parent mapping definition. Determines execution order when multiple rules apply to the same source-target pair.']
  rule_status varchar [note: 'Current lifecycle status of the transformation rule. Determines whether the rule is executed by the interface engine during message processing.']
  rule_version varchar [note: 'Version identifier for this transformation rule. Supports granular versioning and change tracking of individual rules independent of the parent mapping definition.']
  source_data_type varchar [note: 'The data type of the source field as defined in the source system schema or message specification. Used for type validation and conversion planning.']
  source_expression varchar [note: 'The source field path, XPath, JSONPath, or HL7 segment/field reference that identifies the input data element to be transformed. May include extraction logic or functions.']
  target_code_system varchar [note: 'The terminology or code system used in the target field. Examples: ICD-10, SNOMED CT, LOINC, NDC, CPT. Used for terminology mapping and value set translation.']
  target_data_type varchar [note: 'The data type of the target field as defined in the target system schema or message specification. Used for type conversion and validation.']
  target_expression varchar [note: 'The target field path, XPath, JSONPath, or HL7 segment/field reference that identifies where the transformed value should be written. May include assignment logic or functions.']
  test_case_reference varchar [note: 'Reference to the test case or test suite that validates this transformation rule. Links rule to quality assurance artifacts for regression testing and validation.']
  transformation_function varchar [note: 'The function, method, or algorithm applied to convert the source value to the target format. May reference built-in interface engine functions, custom scripts, or standard conversion routines.']
  updated_timestamp timestamp
  validation_rule varchar [note: 'Post-transformation validation expression or constraint that the target value must satisfy. Used to ensure data quality and conformance to target system requirements.']
  vibe_interop_domain_marker varchar [note: 'Marker attribute confirming interoperability domain product set.']
  vibe_mutation_added varchar [note: 'Added by VIBE mutation to satisfy target entity touch requirement']
  vibe_mutation_marker varchar [note: 'Marker added by VIBE mutator']
  vibe_structure_marker varchar [note: 'structure enforcement marker']
  created_by varchar [note: 'Identifier of the user, system, or interface analyst who created this transformation rule. Used for accountability and audit trail in interface engine governance.']

  Note: 'Individual transformation rule record within a data mapping definition, representing the atomic unit of field-level or value-level translation logic. Captures rule sequence, source expression, target expression, condition expression, default value, null handling behavior, data type conversion, and test case reference. Enables granular versioning, testing, and governance of transformation logic separate from the parent mapping container.'
}

Table interoperability.hie_participation {
  hie_participation_id varchar [pk, note: 'Unique identifier for the HIE participation record. Primary key for the HIE participation entity.']
  business_associate_agreement_id varchar [note: 'Reference to the Business Associate Agreement governing the HIE relationship, if the HIE is acting as a business associate.']
  care_site_id varchar [note: 'Reference to the specific facility participating in the HIE, if participation is facility-level rather than organization-wide.']
  employee_id varchar [note: 'Identifier of the user who last updated this HIE participation record.']
  financial_entity_id varchar [note: 'Reference to the healthcare organization participating in the HIE. Links to the organization master data.']
  hie_organization_id varchar [note: 'Unique identifier assigned by the HIE network to this participating organization. Used for routing and identification within the HIE.']
  interface_engine_id varchar [note: 'Foreign key linking to interoperability.interface_engine. Business justification: HIE participation uses specific interface engine endpoints for connectivity. Currently interface_engine_endpoint (STRING) exists. FK to interface_engine enables tracking which engine instance handles ']
  org_provider_id varchar [note: 'Foreign key linking to provider.org_provider. Business justification: HIE participation tracks which provider organizations participate in health information exchanges. Care_site_id exists but doesn\'t identify the legal NPI holder. Credentialing, regulatory reporting, a']
  renewed_hie_participation_id varchar [note: 'Self-referencing FK on hie_participation (renewed_hie_participation_id)']
  annual_participation_fee decimal(15,2) [note: 'Annual fee charged by the HIE network for participation, if applicable.']
  compliance_attestation_date date [note: 'Date when the organization attested to compliance with HIE policies, HIPAA requirements, and technical standards.']
  compliance_attestation_expiration_date date [note: 'Date when the current compliance attestation expires and must be renewed.']
  contribution_volume_monthly_avg varchar [note: 'Average number of clinical documents or messages contributed to the HIE per month by this organization.']
  created_timestamp timestamp [note: 'Timestamp when this HIE participation record was first created in the system.']
  data_sharing_scope varchar [note: 'Description of the types of clinical data shared through the HIE (e.g., ADT, lab results, radiology reports, medication history, immunizations, clinical summaries).']
  data_use_agreement_expiration_date date [note: 'Date when the current Data Use Agreement expires and must be renewed.']
  data_use_agreement_signed_date date [note: 'Date when the organization signed the Data Use Agreement or Participation Agreement with the HIE.']
  go_live_date date [note: 'Date when the organization began actively exchanging data through the HIE network in production.']
  hie_network_name varchar [note: 'Official name of the HIE network (e.g., CommonWell Health Alliance, Carequality, eHealth Exchange, state-specific HIE name).']
  hie_network_type varchar [note: 'Classification of the HIE network by geographic or organizational scope: state HIE, regional HIE, national network, private exchange, or vendor-specific network.']
  hie_participation_status varchar
  interface_engine_endpoint varchar [note: 'Technical endpoint URL or address configured in the interface engine for HIE connectivity (e.g., FHIR base URL, Direct address, HL7 MLLP endpoint).']
  last_audit_date date [note: 'Date of the most recent compliance or security audit conducted by the HIE network.']
  modified_timestamp timestamp
  next_audit_date date [note: 'Scheduled date for the next compliance or security audit by the HIE network.']
  notes varchar [note: 'Additional notes or comments regarding the HIE participation, including special configurations, exceptions, or historical context.']
  npi varchar [note: 'National Provider Identifier for the organization participating in the HIE, used for provider directory and routing purposes.']
  onboarding_date date [note: 'Date when the organization formally joined the HIE network and completed technical onboarding.']
  participation_status varchar [note: 'Current status of the organizations participation in the HIE network: active (exchanging data), inactive (not exchanging), suspended (temporarily halted), pending onboarding (in setup), or terminated (ended).']
  participation_tier varchar [note: 'Level of participation in the HIE: query-only (read access), contribute-only (write access), query-and-contribute (bidirectional), or full bidirectional with advanced services.']
  patient_consent_model varchar [note: 'Consent framework governing patient data sharing: opt-in (explicit consent required), opt-out (default sharing unless patient objects), no consent required (permitted by law), or emergency-only access.']
  primary_contact_email varchar [note: 'Email address of the primary organizational contact for HIE participation.']
  primary_contact_name varchar [note: 'Name of the primary organizational contact responsible for HIE participation and coordination.']
  primary_contact_phone varchar [note: 'Phone number of the primary organizational contact for HIE participation.']
  query_volume_monthly_avg varchar [note: 'Average number of queries sent to the HIE per month by this organization.']
  supported_standards varchar [note: 'List of interoperability standards supported for this HIE participation (e.g., HL7 v2.5.1, FHIR R4, CDA R2, Direct 1.1, IHE XDS).']
  suspension_reason varchar [note: 'Reason for suspension or termination of HIE participation (e.g., compliance violation, technical issues, voluntary withdrawal, contract expiration).']
  technical_connection_type varchar [note: 'Technical method used to connect to the HIE: Direct Messaging (SMTP/S-MIME), FHIR API, HL7v2 interface, CDA document exchange, or proprietary protocol.']
  technical_contact_email varchar [note: 'Email address of the technical contact for HIE interface support.']
  technical_contact_name varchar [note: 'Name of the technical contact responsible for interface configuration and troubleshooting.']
  technical_contact_phone varchar [note: 'Phone number of the technical contact for HIE interface support.']
  termination_date date [note: 'Date when the organization formally ended participation in the HIE network.']
  transaction_fee_model varchar [note: 'Pricing model for HIE transactions: flat rate, per-transaction fee, tiered pricing based on volume, or no fee.']
  updated_timestamp timestamp [note: 'Timestamp when this HIE participation record was last updated in the system.']
  vibe_interop_domain_marker varchar [note: 'Marker attribute confirming interoperability domain product set.']
  vibe_mutation_added varchar [note: 'Added by VIBE mutation to satisfy target entity touch requirement']
  vibe_mutation_marker varchar [note: 'Marker added by VIBE mutator']
  vibe_structure_marker varchar [note: 'structure enforcement marker']

  Note: 'Master record documenting the healthcare organizations formal participation in Health Information Exchanges (HIEs), including state HIEs, regional HIEs (CommonWell, Carequality, eHealth Exchange), and national networks. Captures HIE name, network type, participation tier (query/contribute/both), onboarding date, data sharing scope, patient consent model (opt-in/opt-out), technical connection type, compliance attestation date, and participation status. SSOT for HIE network membership.'
}

